# vvaharness/backends/llm/registry.py

Route selection. Stage code calls `prompt()` and `agentic()` here, never a backend directly. A model configuration node is resolved to a model id, a `via` route and extra settings; the route's backend module is imported lazily; the output-token request is clamped to the model's own cap; settings the `claude` binary cannot send are dropped with a warning.

Source: `vvaharness/backends/llm/registry.py` (lines 1-265)
Executor: code
Called from: stage files (for example `pipeline/stages/s2/session.py`, `s6/session.py`, `s8/session.py`, `s6_verify.py`), `orchestrator/scan.py` (`resolve_model`), `orchestrator/preflight.py`; `deepagents.py` dispatches the `deepagents` route and the bridged `cli` leg itself

// src: vvaharness/backends/llm/registry.py:40-55
DEEPAGENTS_ROLES = { "remediate", "validate", "preprocess", "autoexclude", "threatmodel", "decompose", "deepdive", "verify", "dedup", "chain", "graph_annotate", "exploit_verification.classify", "exploit_verification.mapper", "exploit_verification.judge", "exploit_verification.attacker" }
// `via: deepagents` is deliberately NOT a registered backend: get_backend() fails loudly for it; these roles branch to the harness inside their stage, and preflight.py/environment.py enforce this
POST_SCAN_ROLES = { "remediate", "validate" }   // Stage 10 and 11: a probe failure only warns; detection roles stay fatal

// src: vvaharness/backends/llm/registry.py:129-137
_BACKENDS = { cli: "vvaharness.backends.llm.cli", sdk: "vvaharness.backends.llm.sdk", openai: "vvaharness.backends.llm.openai" }   // named by import path; selecting one never imports another's SDK
DEFAULT_LLM_VIA = "cli"   // used when a model configuration names no backend

// src: vvaharness/backends/llm/registry.py:208-236
fn prompt(user_prompt, model, ...kw):executor=code {
  [model_id, via, extras] = resolve(model)
  backend = get_backend(via, model_id)
  if (kw.max_tokens != null) kw.max_tokens = clamp_output_tokens(kw.max_tokens, model, tag=kw.tag)
  if (via == "openai") kw.output_cap = output_cap_of(model)   // openai's truncation retry is bounded only by a declared cap; sdk and cli use "64k" (source comment)
  if (an active scan tracker exists) record the payload (phase, backend, model id, tag, cache_prefix + flattened prompt, system prompt)   // abstracted: progress logging; no decisions
  if (via == DEFAULT_LLM_VIA) {
    warn_cli_dropped_knobs(model_id, extras)
    user_prompt = _fold_for_cli(user_prompt, kw)
  } else {
    for each [k, v] in extras, kw[k] = kw[k] if already set else v   // temperature, thinking_budget, betas reach sdk and openai
  }
  return backend.prompt(user_prompt, model=model_id, ...kw)   // cli: cli/oneshot.sudo prompt; sdk and openai are outside this batch
}

// src: vvaharness/backends/llm/registry.py:239-265
fn agentic(user_prompt, model, ...kw):executor=code {
  [model_id, via, extras] = resolve(model)
  backend = get_backend(via, model_id)
  if (via == DEFAULT_LLM_VIA) warn_cli_dropped_knobs(model_id, extras)
  if (kw.max_output_tokens != null) kw.max_output_tokens = clamp_output_tokens(kw.max_output_tokens, model, tag=kw.tag)   // only sdk and openai carry this key; the cli legs are clamped earlier in dispatch_agentic
  if (via == "openai") { kw.output_cap = output_cap_of(model); kw.use_responses_api = use_responses_api_of(model) }
  cache_prefix = remove kw.cache_prefix
  if (cache_prefix) user_prompt = cache_prefix + user_prompt   // folded for parity only; no agentic backend accepts it
  if (via != DEFAULT_LLM_VIA) remove kw.stream_cb   // cli only
  // preserved: unlike prompt(), agentic() does not copy extras (temperature, thinking_budget, betas) into kw for sdk or openai
  text = backend.agentic(user_prompt, model=model_id, ...kw)   // cli: cli/session.sudo agentic
  check_response_quality(text, stage=kw.tag || "")   // external to this batch: util/response_quality (VVAH-E003 gate); no output_tokens: TOKENS holds the multi-turn aggregate
  return text
}

// src: vvaharness/backends/llm/registry.py:105-126
fn resolve(model_cfg):executor=code {
  if (model_cfg is a string) return ResolvedModel(model_cfg, DEFAULT_LLM_VIA, {})
  require model_cfg.id != null => throw ValueError("Model config must be a string or have an `id` field: ...")
  via = model_cfg.via || DEFAULT_LLM_VIA
  extras = {}
  if (model_cfg.temperature != null) extras.temperature = float(temperature)
  if (model_cfg.thinking_budget) extras.thinking_budget = integer(thinking_budget)
  if (model_cfg.betas) extras.betas = list(betas)
  return ResolvedModel(model_cfg.id, via, extras)
}

// src: vvaharness/backends/llm/registry.py:150-159
fn get_backend(via, model_id):executor=code {
  path = _BACKENDS[via]
  require path != null => throw ValueError("Unknown backend `via: $via` for model $model_id")   // includes "deepagents"
  module = import path
  require module provides prompt() and agentic() => throw TypeError("backend module ... does not provide prompt() and agentic()")
  return module
}

// src: vvaharness/backends/llm/registry.py:58-87
fn provider_of(model_cfg):executor=code { return model_cfg.provider if a string else null }
fn use_responses_api_of(model_cfg):executor=code { return model_cfg.use_responses_api if a boolean else null }
fn output_cap_of(model_cfg):executor=code { return integer(model_cfg.max_tokens) if a positive number else null }   // deliberately not read from ModelExtras
fn clamp_output_tokens(requested, model_cfg, tag?):executor=code {
  cap = output_cap_of(model_cfg)
  if (cap == null || requested <= cap) return requested
  warn OUTPUT_TOKENS_CLAMPED
  return cap   // only ever lowers: a cap below the request would be rejected on the first send
}

// src: vvaharness/backends/llm/registry.py:90-102
KNOWN_MODEL_NODE_KEYS = { "id", "via", "provider", "temperature", "thinking_budget", "betas", "use_responses_api", "max_tokens" }
fn unrecognized_model_keys(model_cfg):executor=code { return sorted raw keys of a dict-backed node not in KNOWN_MODEL_NODE_KEYS }   // preflight and doctor warn on these

// src: vvaharness/backends/llm/registry.py:172-205
_CLI_UNSUPPORTED_KEYS = ("temperature", "thinking_budget", "betas")
fn warn_cli_dropped_knobs(model_id, extras):executor=code {
  dropped = keys of _CLI_UNSUPPORTED_KEYS present in extras
  if (dropped) warn once per model and key set "WARN [cli]: models entry ... sets ..., which the `claude` CLI has no flag for — ignored on this route. ... route this role via: sdk or via: openai. ..."
}
fn _fold_for_cli(user_prompt, kw):executor=code {
  remove kw.temperature, kw.thinking_budget, kw.betas   // dropping temperature is not determinism, only the CLI default
  cache_prefix = remove kw.cache_prefix
  if (!cache_prefix) return user_prompt
  return if (user_prompt is a list) [{ type: "text", text: cache_prefix }, ...user_prompt] else cache_prefix + user_prompt   // folded into the user turn
}

