// file: vulnhunter-fix/references/fix-completeness-rubric.md
// Rule book (REQ-HON-001..004): FULL / MITIGATION / WORKAROUND signal catalog, walked conservative-first.
// Consumed by scripts/compute-completeness-tier.py (deterministic classifier, Phase 4 verify); LLM_REVIEW routes to
// prompts/tier_judgment.md, which also reads this rubric as guidance.

@executedBy(MODEL) @role(types)
enum CompletenessTier { FULL, MITIGATION, WORKAROUND, LLM_REVIEW }                                          // src: vulnhunter-fix/references/fix-completeness-rubric.md:14

@executedBy(MIXED) @role(rule_set) @stage("fix.verify")
class FixCompletenessRubric {

    // Entry: classify a fix diff; LLM_REVIEW is resolved by the tier-judgment prompt, never written.
    String run(Diff d, Finding f, PlanArtifact plan, Result result, Theta θ) {
        String tier = classify(d, f, plan, result, θ);
        if (tier == "LLM_REVIEW") {
            if (θ["p.fix-completeness-rubric.llm_review_never_written"]) {                                 // src: vulnhunter-fix/references/fix-completeness-rubric.md:59
                tier = TierJudgment.run(d, f, θ);                                                          // src: vulnhunter-fix/references/fix-completeness-rubric.md:60
                assert θ["p.fix-completeness-rubric.tier_judgment_output_set"].contains(tier);             // src: vulnhunter-fix/references/fix-completeness-rubric.md:61
            }
        }
        result.completenessTier = tier;
        return tier;
    }

    @executedBy(CODE)
    String classify(Diff d, Finding f, PlanArtifact plan, Result result, Theta θ) {
        assert θ["p.fix-completeness-rubric.tier_llm_review_intermediate"];                               // src: vulnhunter-fix/references/fix-completeness-rubric.md:19
        int wHits = 0;
        int mHits = 0;
        for (String stage : θ["p.fix-completeness-rubric.conservative_first_order"]) {                    // src: vulnhunter-fix/references/fix-completeness-rubric.md:8
            if (stage == "WORKAROUND") {
                wHits = workaroundSignals(d, θ);
                if (wHits >= θ["p.fix-completeness-rubric.workaround_any_single_match"]) return "WORKAROUND";  // src: vulnhunter-fix/references/fix-completeness-rubric.md:23
            } else if (stage == "MITIGATION") {
                mHits = mitigationSignals(d, f, plan, θ);
                if (mHits >= θ["p.fix-completeness-rubric.mitigation_any_single_match"]) return "MITIGATION"; // src: vulnhunter-fix/references/fix-completeness-rubric.md:33
            } else if (stage == "FULL") {
                String full = fullSignals(d, plan, result, wHits + mHits, θ);
                if (full != null) return full;
            }
        }
        if (θ["p.fix-completeness-rubric.llm_review_when_no_signal"]) {                                   // src: vulnhunter-fix/references/fix-completeness-rubric.md:54
            return θ["p.fix-completeness-rubric.no_match_never_full"];                                    // src: vulnhunter-fix/references/fix-completeness-rubric.md:10
        }
        return θ["p.fix-completeness-rubric.no_match_never_full"];
    }

    int workaroundSignals(Diff d, Theta θ) {
        // WORKAROUND: adjacent risk reduced, stated vector still open (compensating control only)
        assert θ["p.fix-completeness-rubric.tier_workaround_definition"];                                 // src: vulnhunter-fix/references/fix-completeness-rubric.md:18
        int n = 0;
        if (θ["p.fix-completeness-rubric.workaround_rate_limiter_upstream"] && d.addsRateLimiterOrBackoff() && !d.changesSinkSignature()) n++; // src: vulnhunter-fix/references/fix-completeness-rubric.md:25
        if (θ["p.fix-completeness-rubric.workaround_feature_flag_off"] && d.togglesConfigBool() && d.sinkBodyUnchanged()) n++;              // src: vulnhunter-fix/references/fix-completeness-rubric.md:26
        if (θ["p.fix-completeness-rubric.workaround_docs_only"] && d.onlyDocsOrDocstrings()) n++;                                           // src: vulnhunter-fix/references/fix-completeness-rubric.md:27
        if (θ["p.fix-completeness-rubric.workaround_header_log_deterrent"] && d.addsLogOrWarningHeader() && !d.addsEarlyRejectAtSink()) n++; // src: vulnhunter-fix/references/fix-completeness-rubric.md:28
        if (θ["p.fix-completeness-rubric.workaround_alerting_not_blocking"] && llmReviewSees(d, "monitoring hook without control-flow change")) n++; // src: vulnhunter-fix/references/fix-completeness-rubric.md:29  (LLM_REVIEW guidance only)
        return n;
    }

    int mitigationSignals(Diff d, Finding f, PlanArtifact plan, Theta θ) {
        // MITIGATION: stated vector partially blocked; residual exposure enumerated
        assert θ["p.fix-completeness-rubric.tier_mitigation_definition"];                                 // src: vulnhunter-fix/references/fix-completeness-rubric.md:17
        int n = 0;
        if (θ["p.fix-completeness-rubric.mitigation_partial_sanitization"] && d.partialWhitelistValidator()) n++;                    // src: vulnhunter-fix/references/fix-completeness-rubric.md:35
        if (θ["p.fix-completeness-rubric.mitigation_length_cap"] && d.addsLengthGuardPassThrough()) n++;                           // src: vulnhunter-fix/references/fix-completeness-rubric.md:36
        if (θ["p.fix-completeness-rubric.mitigation_post_hoc_audit"] && llmReviewSees(d, "audit sink downstream")) n++;           // src: vulnhunter-fix/references/fix-completeness-rubric.md:37  (LLM_REVIEW guidance only)
        if (θ["p.fix-completeness-rubric.mitigation_different_path_control"] && llmReviewSees(d, "modified files exclude finding.location")) n++; // src: vulnhunter-fix/references/fix-completeness-rubric.md:38  (LLM_REVIEW guidance only)
        if (θ["p.fix-completeness-rubric.mitigation_rate_limit_on_sink"] && llmReviewSees(d, "rate limiter on exact sink")) n++;  // src: vulnhunter-fix/references/fix-completeness-rubric.md:39  (LLM_REVIEW guidance only)
        if (θ["p.fix-completeness-rubric.mitigation_crypto_chain_incomplete"] && f.isCryptoCwe() && plan.cryptoTrustChain.anyFalse()) n++; // src: vulnhunter-fix/references/fix-completeness-rubric.md:40
        return n;
    }

    // Returns FULL when all FULL signals match cumulatively, LLM_REVIEW when partial, null when none.
    String fullSignals(Diff d, PlanArtifact plan, Result result, int lowerHits, Theta θ) {
        assert θ["p.fix-completeness-rubric.tier_full_definition"];                                       // src: vulnhunter-fix/references/fix-completeness-rubric.md:16
        List<Boolean> s = new List();
        if (θ["p.fix-completeness-rubric.full_sink_signature_changed"]) s.add(d.changesSinkSignature() || d.removesSink());       // src: vulnhunter-fix/references/fix-completeness-rubric.md:46
        s.add(plan.callersRoutedCoverage == θ["p.fix-completeness-rubric.full_callers_superset"]);                                // src: vulnhunter-fix/references/fix-completeness-rubric.md:47
        if (θ["p.fix-completeness-rubric.full_test_discriminates"] == "pre fail AND post pass") {                                // src: vulnhunter-fix/references/fix-completeness-rubric.md:48
            DiscriminationEvidence e = result.discriminationEvidence;
            s.add(e.preFixResult == "fail" && e.postFixResult == "pass" && e.payloadMatchesScan);
        }
        if (θ["p.fix-completeness-rubric.full_no_blocking_lower_signal"]) s.add(lowerHits == 0);                                  // src: vulnhunter-fix/references/fix-completeness-rubric.md:49
        if (θ["p.fix-completeness-rubric.full_signals_cumulative"] == "all" && s.allTrue()) return "FULL";                        // src: vulnhunter-fix/references/fix-completeness-rubric.md:44
        if (s.anyTrue() && θ["p.fix-completeness-rubric.llm_review_when_inconsistent"]) return "LLM_REVIEW";                      // src: vulnhunter-fix/references/fix-completeness-rubric.md:56
        return null;
    }

    @executedBy(MODEL)
    boolean llmReviewSees(Diff d, String pattern) {
        // guidance-only signals: not detected by the deterministic classifier; applied by the tier_judgment.md reviewer
        return false;
    }
}
