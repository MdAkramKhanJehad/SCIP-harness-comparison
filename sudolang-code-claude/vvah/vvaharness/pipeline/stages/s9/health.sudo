# vvaharness/pipeline/stages/s9/health.py

Builds the scan-health facts that the SARIF emitter stamps onto the run's invocation and properties.

Source: `vvaharness/pipeline/stages/s9/health.py` (lines 1-51)
Executor: code
Called from: `vvaharness/pipeline/stages/s9/typed_sarif.py` build_sarif

// src: vvaharness/pipeline/stages/s9/health.py:22-51
fn scan_health(report):executor=code {
  m = report.metrics
  empty_scope = m != null && !m.total_files_in_scope
  coverage_degraded_reasons = report.coverage_degraded()
  return {
    executionSuccessful: !empty_scope,   // false only for an empty scope; a death before Stage 9 emits no SARIF
    hollow: report.is_hollow(),          // shared with the Markdown renderer
    degraded: report.degraded,
    degraded_reason: report.degraded_reason,
    enrichment_unavailable: report.enrichment_unavailable,
    coverage_degraded: bool(coverage_degraded_reasons),
    coverage_degraded_reasons: list(coverage_degraded_reasons),
    chunks_failed: if (m) m.chunks_failed else 0,
    deepdive_skipped: if (m) m.deepdive_skipped else false,
    errors_by_stage: if (m) m.errors_by_stage else {},
    threats_total: if (report.threat_model) length(report.threat_model.threats) else 0,
    threats_without_unit: if (report.threats_without_unit == null) null else list(report.threats_without_unit),   // null = payload predates the field
    threats_before_cap: if (m) m.s2_threats_raw else 0,
    threats_truncated: if (m) m.s2_threats_truncated else 0,
    threats_promoted: if (m) m.s2_threats_promoted else 0
  }
}
