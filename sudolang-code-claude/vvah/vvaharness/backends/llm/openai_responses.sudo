## Reply side (Responses reply to Chat-like reply)

// src: vvaharness/backends/llm/openai_responses.py:387-408
fn from_response(resp):executor=code {
  _raise_for_error(resp)
  text_parts = []; refusal_text = null; tool_calls = []
  for each item in resp.output {
    match (item.type) {
      case "message" => {
        for each block in item.content {
          if (block.type == "output_text") text_parts.append(block.text)
          else if (block.type == "refusal" && no refusal yet in this item) item_refusal = block.refusal
        }
        if (refusal_text == null) refusal_text = item_refusal   // the first refusal is kept
      }
      case "function_call" => tool_calls.append(_ToolCall(item.call_id, item.name, item.arguments, item_id=item.id))
      default => ignored
    }
  }
  content = if (text_parts) join(text_parts) else null
  reasoning_items = for each output item of type "reasoning" with encrypted_content, only its _REASONING_INPUT_FIELDS that are not null
  message = { content, tool_calls, refusal: refusal_text, reasoning_items }
  return { choices: [{ message, finish_reason: finish_of(resp, has_tool_calls = tool_calls not empty) }], usage: usage_as_chat(resp.usage) }
}

// src: vvaharness/backends/llm/openai_responses.py:344-355
fn _raise_for_error(resp):executor=code {
  if (!resp.error && resp.status != "failed") return
  message = if (resp.error) (resp.error as text or resp.error.message) else "Responses call ended with status=<status> and no error body"
  throw RuntimeError(message)   // a failed call is never read as an empty "stop"
  // preserved: this is a plain RuntimeError, not an openai.* error, so it passes through every retry arm of openai.agentic()'s turn loop and forced final (they catch only openai.* errors) and ends the call
}

// src: vvaharness/backends/llm/openai_responses.py:276-285
fn finish_of(resp, has_tool_calls):executor=code {
  reason = resp.incomplete_details.reason (null when absent)
  if (resp.status == "incomplete" && reason == "max_output_tokens") return "length"   // openai.py then runs its one doubled-budget truncation retry
  if (reason == "content_filter") return "content_filter"   // openai.py raises a typed refusal
  return if (has_tool_calls) "tool_calls" else "stop"
}

// src: vvaharness/backends/llm/openai_responses.py:250-273
fn usage_as_chat(usage):executor=code {
  if (usage == null) return null
  input = usage.input_tokens || 0; output = usage.output_tokens || 0
  return {
    prompt_tokens: input, completion_tokens: output, total_tokens: usage.total_tokens or, when absent, input + output,
    prompt_tokens_details: usage.input_tokens_details with defaults { cached_tokens: 0, cache_write_tokens: 0 },
    completion_tokens_details: usage.output_tokens_details with default { reasoning_tokens: 0 }
  }
  // preserved: cache_write_tokens is defaulted to 0 when absent, so openai._normalise_usage always records a cache-write count (0) for a Responses turn
}

// abstracted: openai_responses.py:62-77, 288-341 — `_get`/`_as_dict` read a field from a dict, a namespace or an SDK model alike; `_Function`, `_ToolCall` (its model_dump re-adds ITEM_ID_KEY when set), `_Message`, `_Choice` and `_ResponsesReply` are plain holders shaped like the Chat Completions reply objects openai.py reads. No decision depends on them.
