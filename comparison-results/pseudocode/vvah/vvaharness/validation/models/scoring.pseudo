// file: vvaharness/validation/models/scoring.py
// Value types shared by the scoring engine: raw criteria, verdict bands, score results and ScoringConfig,
// which converts to/from the host ScoringPolicy (policy thresholds become decision bands).

@executedBy(CODE) @role(types) @stage("S11")
record RawCriterion(String name, String status, String summary, String details, List<EvidenceAnchor> evidence, String confidence) { }

@executedBy(CODE) @role(types) @stage("S11")
record VerdictRule(double minScore, Decision decision) { }

@executedBy(CODE) @role(types) @stage("S11")
record ScoreResult(double rawScore, Decision decision, String justification) { }

@executedBy(CODE) @role(types) @stage("S11")
record ValidationScore(double rawScore, Decision decision, String justification, List<GateAssessment> gates, boolean hasCriticalFailure) { }

@executedBy(CODE) @role(types) @stage("S11")
record ScoringConfig(String name, String criterionNameField, Map<String, Double> weights, Map<String, Double> statusMultiplier,
                     List<VerdictRule> verdicts, Function justify, Set<String> expectedCriteria, Set<String> criticalCriteria) { }

@executedBy(CODE) @role(config) @stage("S11")
class Scoring {

    ScoringConfig fromPolicy(ScoringPolicy policy, String name, String criterionNameField, Map<String, Double> statusMultiplier, Function justify) {
        List<VerdictRule> bands = List.of(
            new VerdictRule(policy.readyAt, Decision.FIXED),                                         // src: vvaharness/validation/models/scoring.py:103
            new VerdictRule(policy.conditionalAt, Decision.PARTIALLY_FIXED),                         // src: vvaharness/validation/models/scoring.py:104
            new VerdictRule(0.0, Decision.NOT_FIXED));                                               // floor band  // src: vvaharness/validation/models/scoring.py:105
        return new ScoringConfig(name, criterionNameField, policy.weights, statusMultiplier, bands, justify,
                                 policy.requiredGates, policy.critical);                             // src: vvaharness/validation/models/scoring.py:96
    }

    ScoringPolicy toPolicy(ScoringConfig c) {
        double readyAt = c.verdicts.isEmpty() ? 0.0 : c.verdicts.get(0).minScore;                    // src: vvaharness/validation/models/scoring.py:117
        double conditionalAt = c.verdicts.size() > 1 ? c.verdicts.get(1).minScore : 0.0;             // src: vvaharness/validation/models/scoring.py:118
        return new ScoringPolicy(c.expectedCriteria.sorted(), c.weights, c.criticalCriteria, readyAt, conditionalAt); // src: vvaharness/validation/models/scoring.py:113
    }
}
