# ─────────────────────────────────────────────────────────────────────────
#  vvaharness .gitignore — hardened for a public repo.
#  Goal: secrets, internal data, and runtime artifacts can never be committed.
#  Template files (*.example) are explicitly re-included.
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets & credentials ─────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.exploit.example
# Scoped secret/credential text dumps only — NOT a blanket *.txt (which would
# swallow LICENSEs, fixtures, and any tracked text file tree-wide).
*secret*.txt
*secrets*.txt
*token*.txt
*credentials*.txt
.claude
*.pem
*.key
*.p12
*.pfx
*.jks
*.der
*.crt
*.xlsx
# Local config override (machine-specific keys / endpoints; never published)
config.local.yaml

# Local agent instruction overrides — never published
CLAUDE.local.md

# CMDB export (your organisation's app data: exposure, PCI, PAN, PII flags
# and app ids). Ignore the real file, keep the *.example.csv template.
inputs/cmdb*.csv
!inputs/cmdb*.example.csv
# Batch repo list (your clone URLs, hosts and app ids).
inputs/repos*.csv
!inputs/repos*.example.csv
# Design-controls file (your security architecture notes).
inputs/design_controls*.yaml
!inputs/design_controls*.example.yaml
# Live CVE feeds — keep only the *.example.json templates.
inputs/known_cves*.json
!inputs/known_cves*.example.json

# ── Scan outputs & generated reports ──────────────────────────────────────
scans*/
security-scan/
security-remediation/
batch-workspace/
out/
*.sarif
*_report.md
*_report.md.bak

# ── Runtime state & caches ────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
build/
dist/
.venv/
# Also match a bare `.venv` (a symlink to a venv has no trailing slash, so `.venv/` alone misses it).
.venv
.venv.*
venv/
# uv lockfile: not shipped; installs resolve dependency versions fresh.
uv.lock
*.log
*.jsonl
*.bak
run_manifest.json
run_manifest_*.json
# S8's raw model reply, kept so a parse failure is salvageable offline without
# re-spending the call. It normally lands in <repo>/security-scan/ (ignored
# above), but when the per-scan error log was never configured — a standalone
# remediate/validate, a test, or a direct stage call — errlog falls back to
# `pipeline-errors.jsonl` in the CWD and the dump becomes
# `pipeline-errors_s8_raw.txt` at the repo root. A precise suffix, deliberately
# NOT a blanket *.txt (see the note in the secrets section above).
*_s8_raw.txt

# ── Editor / OS cruft ─────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
node_modules/
# …except inside the test fixture trees, which deliberately vendor a manifest to
# prove the scanner skips vendored dependencies. Without this exception the
# fixture is silently dropped by `git add` and missing from every fresh clone.
# Git cannot re-include a file whose parent directory is excluded, so the
# directory itself has to be un-ignored (first line) before its contents
# (second line). Real dependency trees anywhere else stay ignored.
!tests/fixtures/**/node_modules/
!tests/fixtures/**/node_modules/**



# user-local config override (copied from a profile) — never commit
config.yaml
# Local code-intelligence tool config — machine-local, never commit
.serena/

# Local scratch directory for manual test runs — never commit.
livetest/

# ── Local service logs
log/
analysis-out/
