# vvaharness/cli/_commands.py

Handlers for the non-scan subcommands: `doctor` (readiness checks and live probes), `estimate` (offline scope and token preview), `gc` (prune state), `validate`, `remediate` and `ev-replay` (forwarders with the configuration trust gate).

Source: `vvaharness/cli/_commands.py` (lines 1-254)
Executor: code (probes and forwarded commands contain model calls)
Called from: `vvaharness/cli/__init__.py` `_dispatch`

// src: vvaharness/cli/_commands.py:36-87
fn _doctor(rest):executor=code {
  if ("--help" or "-h" in rest) { print usage; return 0 }   // otherwise asking for help would run live probes
  cfg_path = _paths._config_path_from(rest)   // no trust gate: doctor takes no --repo
  require cfg_path exists => return 2
  cfg = _paths._load_and_configure(cfg_path, "doctor"); require cfg => return 2
  checks = environment.run_checks(cfg_path)
  [n_ok, n_warn, n_blocking] = environment.summarize(checks)
  if (n_blocking) return 1   // "[probe] skipped — fix the blocking item(s) above first"
  rc = if (preflight.probe_backends(cfg)) 0 else 1   // all configured roles; no skip list
  // abstracted: _commands.py:74-79 — a TLS / CA cert warning is followed by an explanatory note when the live probe succeeded; display only
  if ("--cache-probe" in rest) {
    if (rc != 0) return rc   // cache probe skipped after a probe failure
    rc = if (preflight.run_cache_probe(cfg)) 0 else 1   // spends real tokens
  }
  return rc
}

// src: vvaharness/cli/_commands.py:89-148
fn _estimate(rest):executor=code {
  repo = _paths._repo_from(rest); require repo => return 2
  require repo is a directory => return 1 (or 2 for an invalid or too-long path)
  [cfg_path, explicit] = _paths._config_path_from_explicit(rest)
  try { cfg_path = config_paths.trusted_config(cfg_path, repo, explicit); cfg = config.load(cfg_path); inventory = scope._walk_repo(repo, cfg) }
  catch (OSError | ValueError | ConfigPolicyError) => return 2
  bytes = total size of in-scope files; approx_tokens = floor(bytes / 4)
  lower = if (files) 250000 + 5 * approx_tokens else 0
  upper = if (files) 1000000 + 20 * approx_tokens else 0
  print "S1-S9 input budget: <lower>-<upper> tokens (heuristic)"   // no model calls; Stages 10 and 11 and exploit verification are extra
  return 0
}

// src: vvaharness/cli/_commands.py:150-206
fn _gc(rest):executor=code {
  options: --keep-runs (default 100), --max-age-days (default 5), --run PATH, --dry-run
  if (run) {
    rid = checkpoints.run_id_for(run)
    if (dry_run) { try exists = store.run_exists(rid); catch StoreError => return 2; print; return 0 }
    try store.delete_run(rid); catch StoreError => return 2
    return 0
  }
  try r = checkpoints.prune_checkpoints(keep_runs, max_age_days, dry_run); catch StoreError => return 2
  return 0   // reports under security-scan/ are never touched
}

// src: vvaharness/cli/_commands.py:208-211
fn _validate(rest):executor=code { return validation.cli.main(rest) }   // trust handling is inside the validation package
// src: vvaharness/cli/_commands.py:213-234
fn _remediate(rest):executor=code {
  repo = _paths._repo_from(rest); require repo => return 2
  [cfg_path, explicit] = _paths._config_path_from_explicit(rest)
  try cfg_path = config_paths.trusted_config(cfg_path, repo, explicit); catch ConfigPolicyError => return 2
  require cfg_path exists => return 2
  cfg = _paths._load_and_configure(cfg_path, "remediate"); require cfg => return 2
  return remediation_agent.remediate(repo, rest, cfg)
}
// src: vvaharness/cli/_commands.py:236-254
fn _ev_replay(rest):executor=code {
  repo = _paths._repo_from(rest); require repo => return 2
  [cfg_path, explicit] = _paths._config_path_from_explicit(rest)
  try cfg_path = config_paths.trusted_config(cfg_path, repo, explicit); catch ConfigPolicyError => return 2
  cfg = _paths._load_and_configure(cfg_path, "ev-replay"); require cfg => return 2   // preserved: unlike _remediate, no separate config-exists check here
  return exploit_verification.replay.run.replay_run(repo, rest, cfg)   // external: exploit verification package
}
