# vvaharness/remediation_agent/options.py

Parses the raw argument list of the `remediate` command into a frozen options record.

Source: `vvaharness/remediation_agent/options.py` (lines 1-56)
Executor: code
Called from: `vvaharness/remediation_agent/remediate.py` remediate

// src: vvaharness/remediation_agent/options.py:22
VALID_MODES = ["fix", "report-only"]

// src: vvaharness/remediation_agent/options.py:25-32
RemediateOptions {
  resume: Boolean = false
  interactive: Boolean = false
  verbose: Boolean = false
  mode: String = "fix"
  top: Number | "all" | null = null
}

// src: vvaharness/remediation_agent/options.py:35-46
fn parse_options(args):executor=code {
  mode = _mode_from(args)
  require mode in VALID_MODES => throw ValueError("invalid --mode $mode; choose one of $VALID_MODES.")
  return RemediateOptions(
    resume = "--resume" in args,
    interactive = "--interactive" in args || "-i" in args,
    verbose = "--verbose" in args || "-v" in args,
    mode,
    top = select.parse_top_arg(args)   // may raise ValueError; see select/topspec.sudo
  )
}

// src: vvaharness/remediation_agent/options.py:49-56
fn _mode_from(args):executor=code {
  for each [i, a] in args {
    if (a == "--mode" && i + 1 < length(args)) return args[i + 1]
    if (a starts with "--mode=") return text after the first "="
  }
  return "fix"
}
