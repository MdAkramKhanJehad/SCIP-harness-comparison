# vvaharness/orchestrator/cmdb.py

Optional configuration-management database lookup. An application id is looked up in a CSV file to build the `AppProfile` threaded into Stages 1 to 8 and the raw `AppInfo` used for contextual severity scoring after Stage 7.

Source: `vvaharness/orchestrator/cmdb.py` (lines 1-63)
Executor: code
Called from: `vvaharness/orchestrator/entry.py` (`_set_cmdb_path`, `_cmdb_path`), `vvaharness/orchestrator/scan.py` (`_load_app_profile`), `vvaharness/orchestrator/batch.py` (`_app_module_name`)

// src: vvaharness/orchestrator/cmdb.py:26-37
_CMDB_CSV = ""   // process-global path
fn _cmdb_path():executor=code { return _CMDB_CSV }
fn _set_cmdb_path(cfg, cfg_dir):executor=code {
  p = knob("inject.cmdb_file", default=null)
  _CMDB_CSV = if (p) config_paths._resolve_against(cfg_dir, p) else ""   // relative paths anchor at the profile directory
}

// src: vvaharness/orchestrator/cmdb.py:40-63
fn _load_app_profile(application_id):executor=code {
  if (!application_id) return [null, null]
  try { cmdb = report.appcontext.load_cmdb_csv(_cmdb_path()); info = report.appcontext.lookup_app(application_id, cmdb, {}) }
  catch any error => return [null, null]   // "lookup failed" is printed; the scan continues without a profile
  if (info == null) return [null, null]    // "application_id ... not found"
  profile = AppProfile { application_id, name, externally_facing, pci_scoped, processes_pan, pii, source } from info
  return [profile, info]
}
