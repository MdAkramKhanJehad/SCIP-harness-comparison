// file: vvaharness/rules/cwe.py
// CWE id normalisation, weakness-class equivalence (used by S4 fan-out, S5/S7 collapse and S5 re-anchor),
// and the OWASP-2025 label map per sink family.

@executedBy(CODE) @role(rule_set) @stage("global")
class RulesCwe {

    /** OWASP_2025_BY_SEMANTIC: sink family -> OWASP 2025 labels (families absent fall back to Injection in detect/patterns). */
    Map<String, List<String>> owasp2025BySemantic(Theta θ) {
        return θ["code.rules.cwe.owasp_2025_by_semantic"];                                        // src: vvaharness/rules/cwe.py:22
    }

    /** Canonicalise a CWE reference: cwe_089, CWE-0089, 89 -> CWE-89; null when no match. */
    String normCwe(Object value, Theta θ) {
        Match m = Regex.searchIgnoreCase(θ["code.rules.cwe.cwe_id_rx"], String.valueOf(value == null ? "" : value)); // src: vvaharness/rules/cwe.py:39
        return (m != null) ? "CWE-" + toInt(m.group(1)) : null;                                   // src: vvaharness/rules/cwe.py:40
    }

    /** Disjoint clusters; the first id of each names the survivor. */
    Map<String, String> weaknessKeyMap(Theta θ) {
        Map<String, String> key = new Map();
        for (List<String> cluster : θ["code.rules.cwe.weakness_clusters"]) {                     // src: vvaharness/rules/cwe.py:44
            for (String c : cluster) key.put(c, cluster.get(0));                                  // src: vvaharness/rules/cwe.py:57
        }
        return key;
    }

    /** normCwe(value) with cluster siblings folded onto one id; null when unparseable. */
    String weaknessKey(Object value, Theta θ) {
        String cwe = normCwe(value, θ);                                                           // src: vvaharness/rules/cwe.py:65
        return (cwe != null) ? weaknessKeyMap(θ).getOrDefault(cwe, cwe) : null;                   // src: vvaharness/rules/cwe.py:66
    }

    /** True when a and b name the same weakness. A generic parent (CWE-20/74) matches anything specific. */
    boolean sameWeakness(Object cweA, Object cweB, Theta θ) {
        String a = normCwe(cweA, θ); String b = normCwe(cweB, θ);                                 // src: vvaharness/rules/cwe.py:72
        if (a == null || b == null) return false;                                                 // cannot tell is never a match. src: vvaharness/rules/cwe.py:74
        if (a == b) return true;                                                                  // src: vvaharness/rules/cwe.py:76
        Set<String> generic = θ["code.rules.cwe.generic_parent_cwes"];                            // src: vvaharness/rules/cwe.py:60
        boolean aGeneric = generic.contains(a); boolean bGeneric = generic.contains(b);           // src: vvaharness/rules/cwe.py:78
        if (aGeneric != bGeneric) return true;                                                    // src: vvaharness/rules/cwe.py:80
        if (aGeneric && bGeneric) return false;                                                   // 20 vs 74 deliberately not folded. src: vvaharness/rules/cwe.py:82
        return weaknessKey(a, θ) == weaknessKey(b, θ);                                            // src: vvaharness/rules/cwe.py:84
    }
}
