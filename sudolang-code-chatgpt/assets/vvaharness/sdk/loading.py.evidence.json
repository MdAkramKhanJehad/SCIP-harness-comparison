  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Resolves a profile's ``sdk.plugins`` block into the one PluginSet a scan installs.\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom importlib import import_module\n\nfrom vvaharness.sdk.plugins import PluginSet, VvahPlugin\nfrom vvaharness.util import logs\nfrom vvaharness.util.config import knob\n\nlog = logs.get_logger(__name__)\n\n#: Only these names are loadable; a profile naming an arbitrary module is deliberately refused,\n#: since that would make config a code-execution surface. The targets are resolved lazily so that\n#: importing the SDK does not import every plugin, and so a plugin may import the SDK back.\nBUILTIN_PLUGINS: dict[str, str] = {\n    \"semgrep\": \"vvaharness.plugins.semgrep:SemgrepPlugin\",\n}\n\n\ndef _plugin_specs(cfg: object) -> tuple[dict, ...]:\n    \"\"\"The profile's ``sdk.plugins`` entries, each a mapping with at least a ``name``.\"\"\"\n    raw = knob(cfg, \"sdk.plugins\", []) or []\n    if not isinstance(raw, (list, tuple)):\n        raise TypeError(\"sdk.plugins must be a list of mappings\")\n    specs = []\n    for entry in raw:\n        if not isinstance(entry, dict) or not entry.get(\"name\"):\n            raise TypeError(f\"each sdk.plugins entry needs a name: {entry!r}\")\n        specs.append(dict(entry))\n    return tuple(specs)\n\n\ndef _built(spec: dict) -> VvahPlugin:\n    \"\"\"One plugin built from its profile entry, with ``name`` consumed as the lookup key.\"\"\"\n    options = dict(spec)\n    name = options.pop(\"name\")\n    target = BUILTIN_PLUGINS.get(name)\n    if target is None:\n        raise ValueError(f\"unknown sdk plugin {name!r}; known: {sorted(BUILTIN_PLUGINS)}\")\n    factory = _resolve(target)\n    for key in (\"configs\", \"rulesets\"):\n        if key in options:\n            options[key] = tuple(options[key] or ())\n    return factory(**options)\n\n\ndef _resolve(target: str) -> Callable[..., VvahPlugin]:\n    \"\"\"The class behind one BUILTIN_PLUGINS entry, imported only when that plugin is configured.\"\"\"\n    module_name, _, attr = target.partition(\":\")\n    return getattr(import_module(module_name), attr)\n\n\ndef load_plugin_set(cfg: object) -> PluginSet:\n    \"\"\"The configured plugins, already validated and ordered; empty when none are configured.\"\"\"\n    specs = _plugin_specs(cfg)\n    if not specs:\n        return PluginSet()\n    plugins = PluginSet([_built(spec) for spec in specs])\n    log.info(\"sdk plugins loaded: %s\", \", \".join(plugins.names))\n    return plugins\n\n\n__all__ = [\"BUILTIN_PLUGINS\", \"load_plugin_set\"]\n",
