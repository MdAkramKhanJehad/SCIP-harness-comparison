// file: vvaharness/backends/harness/claude/options.py
// Translate harness option dataclasses into ClaudeAgentOptions: env pins, verbatim prompts, tool policy,
// permission callback, structured-output schema, the in-process fact MCP server, subagents and the
// foreground-dispatch hook that keeps persona subagents blocking.

@executedBy(CODE) @role(config)
class ClaudeOptions {

    String factServerName(Theta θ) {
        return θ["code.backends.harness.claude.options.fact_server_name"];    // "facts" (tool prefix mcp__facts__) // src: vvaharness/backends/harness/claude/options.py:44
    }

    List<String> subagentDispatchTools(Theta θ) {
        return θ["code.backends.harness.claude.options.subagent_dispatch_tools"]; // Agent, Task         // src: vvaharness/backends/harness/claude/options.py:46
    }

    String toEffort(String effort) {
        EffortLevel parsed = EffortLevelParse.parse(effort);              // invalid -> null (SDK default) // src: vvaharness/backends/harness/claude/options.py:53
        return parsed != null ? parsed.value : null;                                                     // src: vvaharness/backends/harness/claude/options.py:54
    }

    List<String> toSettingSources(List<String> sources) {
        List<String> out = new List();
        for (String s : sources) {                                                                       // src: vvaharness/backends/harness/claude/options.py:60
            if (!List.of("user", "project", "local").contains(s)) throw new ValueError("invalid setting_source"); // src: vvaharness/backends/harness/claude/options.py:64
            out.add(s);
        }
        return out;
    }

    // Wrap a PermissionsPolicy as the SDK can_use_tool callback (deny carries reason + interrupt).
    CanUseTool permissionsCallback(Permissions policy, Theta θ) {
        return (toolName, inputData, ctx) -> {
            PermissionDecision d = policy.evaluate(toolName, inputData, θ);                              // src: vvaharness/backends/harness/claude/options.py:76
            if (d.allow) return new PermissionResultAllow(inputData);                                    // src: vvaharness/backends/harness/claude/options.py:78
            return new PermissionResultDeny(d.reason, d.interrupt);                                      // src: vvaharness/backends/harness/claude/options.py:79
        };
    }

    AgentDefinition toAgentDefinition(SubagentDefinition subagent, List<String> bridgedTools) {
        List<String> tools = ClaudeFacts.rewriteToolNames(subagent.tools, bridgedTools);                 // src: vvaharness/backends/harness/claude/options.py:95
        // the submit tool is always granted to a persona whose tool list is explicit
        if (tools != null && bridgedTools.contains(SUBMIT_TOOL)) {                                       // src: vvaharness/backends/harness/claude/options.py:98
            String submitName = ClaudeFacts.mcpName(SUBMIT_TOOL);                                        // src: vvaharness/backends/harness/claude/options.py:99
            if (!tools.contains(submitName)) tools = tools.plus(submitName);                             // src: vvaharness/backends/harness/claude/options.py:101
        }
        return new AgentDefinition(subagent.description, subagent.prompt, tools, subagent.disallowedTools, subagent.model, subagent.skills); // src: vvaharness/backends/harness/claude/options.py:103
    }

    // PreToolUse hook: dispatches of the named subagents are forced to run in the foreground.
    Map<String, Object> foregroundSubagentHook(Set<String> agentNames, Map<String, Object> inputData, Theta θ) {
        Map<String, Object> toolInput = inputData.getOrDefault("tool_input", Map.of());                  // src: vvaharness/backends/harness/claude/options.py:120
        if (!subagentDispatchTools(θ).contains(inputData.get("tool_name"))                               // src: vvaharness/backends/harness/claude/options.py:121
                || !agentNames.contains(toolInput.get("subagent_type"))                                  // src: vvaharness/backends/harness/claude/options.py:122
                || toolInput.get("run_in_background") == false) {                                        // src: vvaharness/backends/harness/claude/options.py:123
            return Map.of();                                                                             // src: vvaharness/backends/harness/claude/options.py:124
        }
        return Map.of("hookEventName", "PreToolUse", "permissionDecision", "allow", "updatedInput", toolInput.with("run_in_background", false)); // src: vvaharness/backends/harness/claude/options.py:125
    }

    // Keep persona dispatches blocking when personas report through the submit tool.
    void applyForegroundSubagents(ClaudeAgentOptions opts, StreamingOptions options, List<String> factToolNames, Theta θ) {
        if (options.agents.isEmpty() || !factToolNames.contains(ClaudeFacts.mcpName(SUBMIT_TOOL))) return; // src: vvaharness/backends/harness/claude/options.py:142
        opts.hooks.get("PreToolUse").add(new HookMatcher(String.join("|", subagentDispatchTools(θ)), foregroundSubagentHook(options.agents.keySet()))); // src: vvaharness/backends/harness/claude/options.py:145
    }

    Map<String, Object> buildOutputFormat(Map<String, Object> schema) {
        return Map.of("type", "json_schema", "schema", schema);                                          // src: vvaharness/backends/harness/claude/options.py:155
    }

    Map<String, Object> sanitizeSchema(Map<String, Object> schema) {
        return schema.withoutKey("$schema");                            // drop the dialect declaration   // src: vvaharness/backends/harness/claude/options.py:160
    }

    Map<String, Object> resolveOutputSchema(Object options) {
        if (options.outputSchema != null) return sanitizeSchema(options.outputSchema);                   // src: vvaharness/backends/harness/claude/options.py:167
        if (options.base.responseModel == null || !options.base.responseModel.hasJsonSchema()) return null; // src: vvaharness/backends/harness/claude/options.py:170
        Object schema = options.base.responseModel.modelJsonSchema();                                    // src: vvaharness/backends/harness/claude/options.py:173
        return schema instanceof Map ? sanitizeSchema(schema) : null;                                    // src: vvaharness/backends/harness/claude/options.py:174
    }

    ClaudeAgentOptions baseOpts(SessionOptions options, Theta θ) {
        ClaudeAgentOptions opts = new ClaudeAgentOptions();
        opts.model = options.model;                                                                      // src: vvaharness/backends/harness/claude/options.py:180
        opts.cwd = options.cwd;
        // the SDK spreads os.environ beneath this env, so the no-refusal-resend pins override an ambient value
        opts.env = options.env.plus(NO_REFUSAL_RESEND_ENV);               // backends/llm/cli constant   // src: vvaharness/backends/harness/claude/options.py:183
        opts.effort = toEffort(options.effort);                                                          // src: vvaharness/backends/harness/claude/options.py:184
        // scanned-repo text reaches the prompt: verbatim keeps it from being read as @path or a slash command
        opts.verbatimPrompts = θ["code.backends.harness.claude.options.verbatim_prompts"];               // src: vvaharness/backends/harness/claude/options.py:187
        if (options.cliPath != null) opts.cliPath = options.cliPath;     // absolute pin (CWE-426/427)    // src: vvaharness/backends/harness/claude/options.py:190
        if (options.systemPrompt != null) opts.systemPrompt = options.systemPrompt;                      // src: vvaharness/backends/harness/claude/options.py:192
        if (options.toolPolicy != null) {                                                                // src: vvaharness/backends/harness/claude/options.py:194
            opts.allowedTools = options.toolPolicy.allowedTools;                                         // src: vvaharness/backends/harness/claude/options.py:195
            opts.disallowedTools = options.toolPolicy.disallowedTools;                                   // src: vvaharness/backends/harness/claude/options.py:196
        }
        return opts;
    }

    void applyAgents(ClaudeAgentOptions opts, StreamingOptions options, List<String> bridgedTools) {
        if (!options.agents.isEmpty()) {                                                                 // src: vvaharness/backends/harness/claude/options.py:203
            for (String name : options.agents.keySet()) opts.agents.put(name, toAgentDefinition(options.agents.get(name), bridgedTools)); // src: vvaharness/backends/harness/claude/options.py:204
        }
    }

    // The in-process fact MCP server is the session's ONLY MCP server; its tools are added to allowed_tools.
    void applyFactServer(ClaudeAgentOptions opts, Object factServer, List<String> factToolNames, Theta θ) {
        if (factServer == null) return;                                                                  // src: vvaharness/backends/harness/claude/options.py:213
        opts.mcpServers = Map.of(factServerName(θ), factServer);                                         // src: vvaharness/backends/harness/claude/options.py:215
        opts.strictMcpConfig = θ["code.backends.harness.claude.options.strict_mcp_config"];              // src: vvaharness/backends/harness/claude/options.py:216
        opts.allowedTools = opts.allowedTools.plus(factToolNames);                                       // src: vvaharness/backends/harness/claude/options.py:217
    }

    ClaudeAgentOptions buildOneshotSdkOptions(OneShotOptions options, Theta θ) {
        ClaudeAgentOptions opts = baseOpts(options.base, θ);                                             // src: vvaharness/backends/harness/claude/options.py:222
        opts.maxTurns = options.maxTurns;                                                                // src: vvaharness/backends/harness/claude/options.py:223
        opts.permissionMode = θ["code.backends.harness.claude.options.oneshot_permission_mode"];         // src: vvaharness/backends/harness/claude/options.py:224
        opts.settingSources = null;                         // one-shot loads no settings layers          // src: vvaharness/backends/harness/claude/options.py:225
        Map<String, Object> schema = resolveOutputSchema(options);                                       // src: vvaharness/backends/harness/claude/options.py:226
        if (schema != null) opts.outputFormat = buildOutputFormat(schema);                               // src: vvaharness/backends/harness/claude/options.py:228
        return opts;
    }

    ClaudeAgentOptions buildStreamingSdkOptions(StreamingOptions options, Object factServer, List<String> factToolNames, Theta θ) {
        ClaudeAgentOptions opts = baseOpts(options.base, θ);                                             // src: vvaharness/backends/harness/claude/options.py:238
        if (options.maxTurns != null) opts.maxTurns = options.maxTurns;                                  // src: vvaharness/backends/harness/claude/options.py:240
        if (options.maxBudgetUsd != null) opts.maxBudgetUsd = options.maxBudgetUsd;                      // src: vvaharness/backends/harness/claude/options.py:242
        if (options.settingSources != null) opts.settingSources = toSettingSources(options.settingSources); // src: vvaharness/backends/harness/claude/options.py:244
        if (options.permissions != null) opts.canUseTool = permissionsCallback(options.permissions, θ);  // src: vvaharness/backends/harness/claude/options.py:246
        // served via a synthetic StructuredOutput tool that bypasses can_use_tool
        Map<String, Object> schema = resolveOutputSchema(options);                                       // src: vvaharness/backends/harness/claude/options.py:248
        if (schema != null) opts.outputFormat = buildOutputFormat(schema);                               // src: vvaharness/backends/harness/claude/options.py:250
        applyFactServer(opts, factServer, factToolNames, θ);                                             // src: vvaharness/backends/harness/claude/options.py:251
        applyAgents(opts, options, factToolNames.map(n -> n.removePrefix("mcp__" + factServerName(θ) + "__"))); // src: vvaharness/backends/harness/claude/options.py:252
        applyForegroundSubagents(opts, options, factToolNames, θ);                                       // src: vvaharness/backends/harness/claude/options.py:255
        return opts;
    }
}
