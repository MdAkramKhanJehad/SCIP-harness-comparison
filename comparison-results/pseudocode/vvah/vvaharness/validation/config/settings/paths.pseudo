// file: vvaharness/validation/config/settings/paths.py
// Filesystem layout for a validation run (targets/, outputs/ under the project root; prompts/ from the package).

@executedBy(CODE) @role(config) @stage("S11")
class SettingsPaths {

    Path ASSETS_ROOT = Path.of(__file__).parent(3);                                                  // validation package dir  // src: vvaharness/validation/config/settings/paths.py:29

    PathsConfig buildPaths(Path projectRoot) {
        return new PathsConfig(projectRoot,                                                          // src: vvaharness/validation/config/settings/paths.py:45
            projectRoot.resolve("targets"),                                                          // src: vvaharness/validation/config/settings/paths.py:47
            projectRoot.resolve("outputs"),                                                          // src: vvaharness/validation/config/settings/paths.py:48
            ASSETS_ROOT.resolve("prompts"));                                                         // system prompt location  // src: vvaharness/validation/config/settings/paths.py:49
    }
}

@executedBy(CODE) @role(types)
record PathsConfig(Path projectRoot, Path targetsDir, Path outputsDir, Path promptsDir) { }
