// src: vvaharness/backends/harness/harness.py:33-46
Harness {
  fn run_oneshot(prompt, options: OneShotOptions) => OneShotResult;   // single-turn parser-only invocation; raises HarnessError on failure
  fn run_streaming(prompt, options: StreamingOptions) => async stream of HarnessMessage;   // full streaming session
}
