// file: vvaharness/backends/harness/deepagents/client.py, vvaharness/backends/harness/deepagents/options/streaming.py, vvaharness/backends/harness/deepagents/options/graph_builder.py
// DeepAgentHarness: the deepagents/LangGraph agent loop an S4 session runs on. Shows how the session's graph is
// built (model, system prompt + suffixes, tools, skills, middleware stack, recursion limit) and how the stream is
// bounded by the session timeout and the recursion limit. Full client.py: module helpers (effort step-down, lower-tier
// probe on persistent 5xx, Responses to Chat Completions fallback, forced tool_choice learning) and the three harness
// entry points. The streaming/graph-builder functions are rendered in options/streaming.pseudo and
// options/graph_builder.pseudo; buildStreamingAgent and createAgent here are the pass-1 summaries and are kept.

@executedBy(CODE) @role(backend)
class Client {

    // DeepAgentHarness.run_streaming. spec stands for StreamingOptions (prompt = spec.user). Returns the generator gen().
    // Entry used by S4Session.agentic (via backends/llm/deepagents.dispatch_agentic -> drain_streaming).
    Transcript runStreaming(AgentSpec spec, List<Middleware> parentMiddleware, String sessionId, Theta θ) {  // src: vvaharness/backends/harness/deepagents/client.py:552
        String sentTier = sentEffortTier(spec);                                                          // src: vvaharness/backends/harness/deepagents/client.py:556
        CompiledGraph g = buildStreamingAgent(spec, parentMiddleware, sessionId, θ);                     // src: vvaharness/backends/harness/deepagents/client.py:557
        return gen(spec, g, sentTier, sessionId, θ);                                                     // src: vvaharness/backends/harness/deepagents/client.py:662
    }

    // run_streaming's nested _gen: captured prompt, options, graph, config and sentTier are explicit parameters.
    Transcript gen(AgentSpec options, CompiledGraph graph, String sentTier, String optSessionId, Theta θ) { // src: vvaharness/backends/harness/deepagents/client.py:560
        // the caller's id when pinned: the id a stage reports must BE the resumable thread
        String sessionId = optSessionId != null && optSessionId != "" ? optSessionId : uuid4Hex();       // src: vvaharness/backends/harness/deepagents/client.py:562
        Set<String> seenToolIds = new Set();
        Map<List<String>, String> nsToAgent = new Map();     // subgraph namespace -> persona name, so subagent steps are tagged
        UsageAccumulator usageAcc = new UsageAccumulator();  // usage lives on streamed AIMessages, not graph state
        boolean responsesActive = responsesActive(options);                                              // src: vvaharness/backends/harness/deepagents/client.py:568
        try {
            yield new HarnessSessionInit(sessionId);                                                     // src: vvaharness/backends/harness/deepagents/client.py:570
            // subgraphs=True surfaces each persona's steps as (namespace, payload) tuples
            stream = graph.astream(markedContent(options.user, options.cachePrefix), "updates", true);   // src: vvaharness/backends/harness/deepagents/client.py:572
            bounded = boundedAstreamEvents(stream, options.timeout, options.graphName, options.effort);  // src: vvaharness/backends/harness/deepagents/client.py:579
            for (event : bounded) {
                usageAcc.add_event(event);
                for (message : DeepagentsTranslate.translateStreamEvents(event, seenToolIds, nsToAgent)) yield message; // src: vvaharness/backends/harness/deepagents/client.py:584
            }
            if (responsesActive) RESPONSES_PROVEN_MODELS.add(options.model);                             // src: vvaharness/backends/harness/deepagents/client.py:588
            state = finalState(graph);                                                                   // src: vvaharness/backends/harness/deepagents/client.py:590
            yield DeepagentsTranslate.makeTerminalResult(state, sessionId, usageAcc.snapshot());                   // src: vvaharness/backends/harness/deepagents/client.py:591
        } catch (HarnessError e) {
            throw e;                                                                                     // src: vvaharness/backends/harness/deepagents/client.py:594
        } catch (Exception error) {                                                                      // src: vvaharness/backends/harness/deepagents/client.py:596
            // arm 1: a learned tool_choice or effort rejection -> bank usage, re-run once from scratch
            if (relearnedForRerun(error, options, sentTier, usageAcc)) {                                 // src: vvaharness/backends/harness/deepagents/client.py:597
                bankPartialUsage(usageAcc);
                for (message : runStreaming(options, null, options.sessionId, θ)) yield message;         // src: vvaharness/backends/harness/deepagents/client.py:599
                return;
            }
            // arm 2: persistent 5xx -> one direct resend at the next lower reasoning tier
            String probed = (sentTier != null && isPersistentServerError(error)) ? probeLowerTierOnce(options.model, sentTier) : null; // src: vvaharness/backends/harness/deepagents/client.py:602
            if (probed != null && sentTier != null) {                                                    // src: vvaharness/backends/harness/deepagents/client.py:605
                bankPartialUsage(usageAcc);
                StreamProbeContext ctx = new StreamProbeContext(sentTier, error, sessionId, seenToolIds, nsToAgent); // src: vvaharness/backends/harness/deepagents/client.py:607
                for (message : probeServerErrorStreaming(options.user, options, probed, ctx)) yield message; // src: vvaharness/backends/harness/deepagents/client.py:609
                return;
            }
            // arm 3: Responses API failure -> learn chat-completions-only and re-delegate once
            if (shouldFallBack(error, options)) {                                                        // src: vvaharness/backends/harness/deepagents/client.py:614
                learnChatCompletionsOnly(options.model);                                                 // src: vvaharness/backends/harness/deepagents/client.py:616
                bankPartialUsage(usageAcc);
                try {
                    for (message : runStreaming(options, null, options.sessionId, θ)) yield message;     // src: vvaharness/backends/harness/deepagents/client.py:619
                } catch (Exception secondError) {                                                        // src: vvaharness/backends/harness/deepagents/client.py:621
                    CHAT_COMPLETIONS_ONLY_MODELS.discard(options.model);                                 // unlearn: an outage must not mislabel // src: vvaharness/backends/harness/deepagents/client.py:623
                    if (isMissingThoughtSignature(secondError)) {                                        // src: vvaharness/backends/harness/deepagents/client.py:624
                        // a HarnessProcessError body is in stderr, not str()
                        String detail = secondError.stderr != null && secondError.stderr != "" ? secondError.stderr : str(secondError); // src: vvaharness/backends/harness/deepagents/client.py:626
                        throw new HarnessProcessError("DeepAgents stream failed: " + typeName(secondError), 1, detail, secondError instanceof GraphRecursionError); // src: vvaharness/backends/harness/deepagents/client.py:629
                    }
                    // otherwise raise the ORIGINAL error, not the second
                    throw new HarnessProcessError("DeepAgents stream failed: " + typeName(error), 1, str(error), error instanceof GraphRecursionError); // src: vvaharness/backends/harness/deepagents/client.py:637
                }
                return;                                                                                  // src: vvaharness/backends/harness/deepagents/client.py:643
            }
            // arm 4: terminal. On recursion-limit errors snapshot state so consumers can retry extraction
            boolean recursionLimited = error instanceof GraphRecursionError;                             // src: vvaharness/backends/harness/deepagents/client.py:645
            if (recursionLimited) {
                state = finalState(graph);                                                               // src: vvaharness/backends/harness/deepagents/client.py:647
                yield DeepagentsTranslate.makeTerminalResult(state, sessionId, usageAcc.snapshot());               // src: vvaharness/backends/harness/deepagents/client.py:648
            } else {
                bankPartialUsage(usageAcc);   // the one arm reaching neither a retry nor makeTerminalResult // src: vvaharness/backends/harness/deepagents/client.py:653
            }
            // class name is only a fallback signal: consumers check recursion_limited FIRST
            throw new HarnessProcessError("DeepAgents stream failed: " + typeName(error), 1, str(error), recursionLimited); // src: vvaharness/backends/harness/deepagents/client.py:655
        }
    }

    // DeepAgentHarness.run_oneshot: single-turn parser-only invocation.
    OneShotResult runOneshot(String prompt, OneShotOptions options) {                                    // src: vvaharness/backends/harness/deepagents/client.py:483
        // the field actually sent: bounds the effort retry to one re-entry per rejection
        String sentTier = sentEffortTier(options);                                                       // src: vvaharness/backends/harness/deepagents/client.py:488
        graph, config = Oneshot.buildOneshotOptions(options);                                            // src: vvaharness/backends/harness/deepagents/client.py:489
        content = markedContent(prompt, options.cachePrefix);                                            // src: vvaharness/backends/harness/deepagents/client.py:490
        boolean responsesActive = responsesActive(options);                                              // src: vvaharness/backends/harness/deepagents/client.py:491
        try {
            state = graph.ainvoke(content, config);                                                      // src: vvaharness/backends/harness/deepagents/client.py:493
        } catch (Exception exc) {                                                                        // src: vvaharness/backends/harness/deepagents/client.py:497
            if (sentTier != null && classifyEffortRejection(exc) != null) {                              // src: vvaharness/backends/harness/deepagents/client.py:498
                effortCls = classifyEffortRejection(exc);
                if (toolsOffExhausted(options.model, sentTier, effortCls)) {                             // src: vvaharness/backends/harness/deepagents/client.py:500
                    EFFORT_REJECTIONS.tiers.add(tiersKey(options.model, REASONING_OFF, effortTransport(options))); // src: vvaharness/backends/harness/deepagents/client.py:501
                    throw new RuntimeError("DeepAgents call failed: model rejects reasoning_effort alongside tools at every value, including none"); // src: vvaharness/backends/harness/deepagents/client.py:503
                }
                stepDownReasoningEffort(options.model, sentTier, effortCls, exc, effortTransport(options)); // src: vvaharness/backends/harness/deepagents/client.py:508
                return runOneshot(prompt, options);   // bounded: the step-down is now remembered         // src: vvaharness/backends/harness/deepagents/client.py:511
            }
            return recoverOneshotException(prompt, options, sentTier, exc);                              // src: vvaharness/backends/harness/deepagents/client.py:512
        }
        if (responsesActive) RESPONSES_PROVEN_MODELS.add(options.model);                                 // src: vvaharness/backends/harness/deepagents/client.py:513
        return DeepagentsTranslate.translateFinalState(state, true);                                               // src: vvaharness/backends/harness/deepagents/client.py:515
    }

    // Continue the same checkpointed conversation (deadline resume): one more user turn, tools withdrawn by the caller.
    // LangGraph loads the checkpointed messages for this thread id and appends: every prior turn is still in context and cached.
    Transcript resumeStreaming(String instruction, String sessionId) {                                   // src: vvaharness/backends/harness/deepagents/client.py:517
        CompiledGraph held = Streaming.resumable(sessionId);                                             // src: vvaharness/backends/harness/deepagents/client.py:524
        if (held == null) throw new SessionNotResumableError(sessionId);                                 // src: vvaharness/backends/harness/deepagents/client.py:526
        // nested _gen of resume_streaming: no sent-tier probing, no fallback arms, no timeout bound
        Set<String> seenToolIds = new Set();
        Map<List<String>, String> nsToAgent = new Map();
        UsageAccumulator usageAcc = new UsageAccumulator();
        for (event : held.astream(instruction, "updates", true)) {                                       // src: vvaharness/backends/harness/deepagents/client.py:536
            usageAcc.add_event(event);
            for (message : DeepagentsTranslate.translateStreamEvents(event, seenToolIds, nsToAgent)) yield message; // src: vvaharness/backends/harness/deepagents/client.py:543
        }
        state = finalState(held);                                                                        // src: vvaharness/backends/harness/deepagents/client.py:545
        yield DeepagentsTranslate.makeTerminalResult(state, sessionId, usageAcc.snapshot());                       // src: vvaharness/backends/harness/deepagents/client.py:546
    }

    CompiledGraph buildStreamingAgent(AgentSpec spec, List<Middleware> parentMiddleware, String sessionId, Theta θ) {
        Graph graph = createAgent(spec, parentMiddleware, θ);                                            // src: vvaharness/backends/harness/deepagents/options/streaming.py:136
        // max_turns is a floor: LangGraph counts supersteps (graph nodes), not turns
        int recursionLimit = DeepagentsLimits.recursionLimit(spec.bounds.maxTurns, θ);                   // src: vvaharness/backends/harness/deepagents/options/streaming.py:141
        CompiledGraph g = new CompiledGraph(graph, sessionId, recursionLimit);                           // src: vvaharness/backends/harness/deepagents/options/streaming.py:136
        if (sessionId != null) SESSIONS.put(sessionId, g);    // held so a deadline resume reaches the same MemorySaver // src: vvaharness/backends/harness/deepagents/options/streaming.py:148
        return g;
    }

    // graph_builder._create_agent: model, system prompt, tools, skills, middleware order.
    Graph createAgent(AgentSpec spec, List<Middleware> parentMiddleware, Theta θ) {
        ChatModel model = ModelBuilding.buildModel(spec.model.model, env(), spec.model.provider, spec.model.effort, null, false, θ); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:396
        Object responseFormat = ResponseFormat.responseFormat(spec.outputSchema, spec.model.model, spec.model.provider); // src: vvaharness/backends/harness/deepagents/options/streaming.py:111
        Prompt system = ResponseFormat.submitInstructedPrompt(spec.system, model, spec.outputSchema, responseFormat, θ); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:400
        DeepagentsProfiles.registerVvahHarnessProfiles(θ);   // openai: investigation-floor suffix        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:401
        // think_in_prompt is false on the S4 path (dispatch_agentic does not set it)
        List<Middleware> mw = new List();
        mw.addAll(readOnlyMiddleware());                     // redact reads + exclude unpermitted natives   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:428
        // S4 parent middleware in order: graph ToolBudget, CweGuidance ToolBudget, TodoListMiddleware (planning),
        // EvidenceGate, ModelCallBudget, RecordTranscript. ForceVerdictOnly is NOT added (force_verdict_only false).
        mw.addAll(parentMiddleware);                                                                     // src: vvaharness/backends/harness/deepagents/options/streaming.py:121
        mw.add(new RepairInvalidToolArgs());                                                             // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:435
        if (spec.model.maxTokens > 0) mw.add(new CapOutputTokens(spec.model.maxTokens));   // step4.max_tokens; truncated call retried once at double budget // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:439
        mw.add(new PermitTools(spec.tools));                 // executor gate: unpermitted calls refused   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:442
        mw.add(new BlockMarkerPromptCaching());              // cache the shared context prefix            // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:445
        mw.add(new LogToolCalls());                                                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:449
        mw.add(CONNECTION_RETRY_MIDDLEWARE);                                                             // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:454
        // skills: SkillsMiddleware mounted only when skill_root is given (step4.skills)
        return createDeepAgent(model, system, spec.tools, spec.skills, mw, responseFormat);              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:458
    }

    // Bound the event stream by one deadline instant; falsy timeout = unbounded (original code path).
    // A fresh timeout_at cm per anext shares one deadline instant but bounds only the await, never a yield to the caller.
    // No subprocess, so cancelling from outside is safe: raise straight away, no interrupt/grace drain.
    Transcript boundedStream(Transcript stream, Duration timeout) {
        return boundedAstreamEvents(stream, timeout, null, null);
    }

    Transcript boundedAstreamEvents(Transcript stream, Duration timeout, String graphName, String effort) { // src: vvaharness/backends/harness/deepagents/client.py:116
        if (timeout == null || timeout.isZero() || timeout.seconds <= 0) {                               // src: vvaharness/backends/harness/deepagents/client.py:126
            for (event : stream) yield event;
            return;
        }
        double deadline = loopTime() + timeout.seconds;                                                  // src: vvaharness/backends/harness/deepagents/client.py:131
        iterator = stream.iterator();
        while (true) {
            cm = timeoutAt(deadline);
            try {
                event = cm.within(() -> iterator.next());                                                // src: vvaharness/backends/harness/deepagents/client.py:136
            } catch (StopAsyncIteration e) {
                return;                                                                                  // src: vvaharness/backends/harness/deepagents/client.py:138
            } catch (TimeoutError e) {                                                                   // src: vvaharness/backends/harness/deepagents/client.py:140
                // expired() tells OUR deadline apart from a TimeoutError raised inside the session
                if (!cm.expired()) throw e;                                                              // src: vvaharness/backends/harness/deepagents/client.py:142
                throw LlmModels.callTimeoutError(graphName, "deepagents", timeout.seconds, effort, "deepagents session exceeded timeout seconds"); // src: vvaharness/backends/harness/deepagents/client.py:144
            }
            yield event;                                                                                 // src: vvaharness/backends/harness/deepagents/client.py:148
        }
    }

    // True when exc is the gateway rejecting the effort field or tier.
    boolean isReasoningEffortRejection(Exception exc) {                                                  // src: vvaharness/backends/harness/deepagents/client.py:111
        return LlmModels.classifyEffortRejection(exc) != null;                                           // src: vvaharness/backends/harness/deepagents/client.py:113
    }

    // The reasoning_effort value this call actually sends, or null. null on the Anthropic route: that leg sends its own
    // effort field through the anthropic thinking kwargs, which never reads EFFORT_REJECTIONS.
    String sentEffortTier(SessionOptions options) {                                                      // src: vvaharness/backends/harness/deepagents/client.py:151
        if (ProviderRouting.routesToAnthropic(options.model, options.modelProvider)) return null;        // src: vvaharness/backends/harness/deepagents/client.py:157
        resolvedTransport = ModelBuilding.resolveUseResponsesApi(options.model, options.modelProvider, options.useResponsesApi); // src: vvaharness/backends/harness/deepagents/client.py:159
        kw = ModelBuilding.openaiEffortKwargs(options.model, options.effort, options.thinkInPrompt, resolvedTransport == true); // src: vvaharness/backends/harness/deepagents/client.py:161
        return kw.get("reasoning_effort");                                                               // src: vvaharness/backends/harness/deepagents/client.py:164
    }

    // True once a model already forced to reasoning_effort none is rejected again (fail-fast, mirrors the openai route).
    boolean toolsOffExhausted(String modelId, String sentTier, String cls) {                             // src: vvaharness/backends/harness/deepagents/client.py:167
        return EFFORT_REJECTIONS.toolsOff.contains(modelId) && (cls == "tools_conflict" || sentTier == REASONING_OFF); // src: vvaharness/backends/harness/deepagents/client.py:173
    }

    // Remember the model's rejection by cls and warn once, naming the value sent next. The tier arm uses the shared
    // stepDown keyed per transport: a value rejected on Responses must not retire it on Chat.
    void stepDownReasoningEffort(String modelId, String sentTier, String cls, Exception exc, String transport) { // src: vvaharness/backends/harness/deepagents/client.py:177
        String nextValue;
        if (cls == "field") {                                                                            // src: vvaharness/backends/harness/deepagents/client.py:185
            EFFORT_REJECTIONS.field.add(modelId);
            Counters.bump("llm_effort_field_dropped");
            nextValue = "no field";
        } else if (cls == "tools_conflict") {                                                            // src: vvaharness/backends/harness/deepagents/client.py:189
            EFFORT_REJECTIONS.toolsOff.add(modelId);
            Counters.bump("llm_effort_tools_off");
            nextValue = REASONING_OFF;
        } else {
            stepped = LlmModels.stepDown(modelId, sentTier, exc, transport);                             // src: vvaharness/backends/harness/deepagents/client.py:194
            Counters.bump("llm_effort_tier_stepped_down");
            nextValue = stepped != null ? str(stepped) : "no field";                                     // src: vvaharness/backends/harness/deepagents/client.py:196
        }
        WarnOnce.warnOnce(EFFORT_UNSUPPORTED_WARNED, modelId + ":" + sentTier, "model rejected reasoning_effort - retrying at next value"); // src: vvaharness/backends/harness/deepagents/client.py:197
    }

    // A persistent 5xx status anywhere on the exception chain (the client own retries exhausted). 429 is a rate limit, not a
    // server fault: the probe is scoped to SERVER_ERROR_STATUS, not the wider RETRYABLE_STATUS.
    boolean isPersistentServerError(Exception exc) {                                                     // src: vvaharness/backends/harness/deepagents/client.py:205
        return exceptionChain(exc).anyMatch(link -> SERVER_ERROR_STATUS.contains(link.statusCode));      // src: vvaharness/backends/harness/deepagents/client.py:211
    }

    // The active transport: Responses or Chat Completions. Deliberately NOT responsesActive: that reads false for a PINNED
    // Responses call, which would mislabel a tier this call sent on Responses as a Chat rejection.
    String effortTransport(SessionOptions options) {                                                     // src: vvaharness/backends/harness/deepagents/client.py:215
        resolved = ModelBuilding.resolveUseResponsesApi(options.model, options.modelProvider, options.useResponsesApi); // src: vvaharness/backends/harness/deepagents/client.py:221
        return resolved ? TRANSPORT_RESPONSES : TRANSPORT_CHAT_COMPLETIONS;                              // src: vvaharness/backends/harness/deepagents/client.py:223
    }

    // Mark (model, sentTier) probed and return the next rung, or null if ineligible.
    String probeLowerTierOnce(String modelId, String sentTier) {                                         // src: vvaharness/backends/harness/deepagents/client.py:226
        // REASONING_OFF has no lower rung; the none to low entry of nextEffortTier exists only for the 400 ladder
        if (sentTier == REASONING_OFF) return null;                                                      // src: vvaharness/backends/harness/deepagents/client.py:230
        String nxt = LlmModels.nextEffortTier(sentTier);                                                 // src: vvaharness/backends/harness/deepagents/client.py:232
        if (nxt == null || !EFFORT_REJECTIONS.probeOnce(modelId, sentTier)) return null;                 // src: vvaharness/backends/harness/deepagents/client.py:233
        return nxt;
    }

    // Whether this call resolved to the Responses API by DEFAULT, not by config pin.
    boolean responsesActive(SessionOptions options) {                                                    // src: vvaharness/backends/harness/deepagents/client.py:238
        resolved = ModelBuilding.resolveUseResponsesApi(options.model, options.modelProvider, options.useResponsesApi); // src: vvaharness/backends/harness/deepagents/client.py:240
        return resolved == true && options.useResponsesApi == null;                                      // src: vvaharness/backends/harness/deepagents/client.py:243
    }

    // Bookkeeping after a lower-tier resend recovered a persistent server error.
    void recordServerErrorRecovery(SessionOptions options, String sentTier, String probed, SessionOptions probedOptions) { // src: vvaharness/backends/harness/deepagents/client.py:246
        learned = EFFORT_REJECTIONS.recoveredTwice(options.model, sentTier);                             // src: vvaharness/backends/harness/deepagents/client.py:250
        if (learned) EFFORT_REJECTIONS.tiers.add(tiersKey(options.model, sentTier, effortTransport(options))); // src: vvaharness/backends/harness/deepagents/client.py:251
        Counters.bump("llm_effort_tier_stepped_down_on_server_error");                                   // src: vvaharness/backends/harness/deepagents/client.py:253
        WarnOnce.warnOnce(EFFORT_UNSUPPORTED_WARNED, "server_error:" + options.model + ":" + sentTier + ":" + learned, "resent at lower tier for this run or this session"); // src: vvaharness/backends/harness/deepagents/client.py:254
        if (responsesActive(probedOptions)) RESPONSES_PROVEN_MODELS.add(options.model);                  // src: vvaharness/backends/harness/deepagents/client.py:259
    }

    // One direct resend at the next tier after a persistent server error, or null if ineligible. A direct resend, not a
    // recursive runOneshot: the retry decision must not re-enter and probe a second rung if this one also fails.
    OneShotResult probeServerErrorOneshot(OneShotOptions options, Object content, String sentTier, Exception exc) { // src: vvaharness/backends/harness/deepagents/client.py:263
        String probed = probeLowerTierOnce(options.model, sentTier);                                     // src: vvaharness/backends/harness/deepagents/client.py:272
        if (probed == null) return null;                                                                 // src: vvaharness/backends/harness/deepagents/client.py:273
        probedOptions = options.withEffort(probed);                                                      // src: vvaharness/backends/harness/deepagents/client.py:275
        probedGraph, probedConfig = Oneshot.buildOneshotOptions(probedOptions);                          // src: vvaharness/backends/harness/deepagents/client.py:276
        try {
            probedState = probedGraph.ainvoke(content, probedConfig);                                    // src: vvaharness/backends/harness/deepagents/client.py:278
        } catch (Exception e) {
