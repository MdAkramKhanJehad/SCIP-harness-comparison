// file: vulnhunter-fix/scripts/check-committed-test-naming.py
// Gate 7, committed-test naming (REQ-GAT-013): fails if any file added on the branch is a leaked
// verify_VULN / exploit_VULN scaffold instead of a repo-convention test name.

@executedBy(CODE) @role(evaluation) @stage("fix")
class CheckCommittedTestNaming {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    List<String> offendingFiles(List<String> paths, Theta θ) {
        List<String> hits = List.of();
        for (String p : paths) {
            String base = Path.basename(p.strip());                                                       // src: vulnhunter-fix/scripts/check-committed-test-naming.py:43
            if (!base.isEmpty() && Regex.matchIgnoreCase(θ["code.fix.scripts.check_committed_test_naming.scaffold_regex"], base)) hits.add(p.strip()); // src: vulnhunter-fix/scripts/check-committed-test-naming.py:44
        }
        return hits;
    }

    Proc git(String repoRoot, List<String> args, Theta θ) {
        try {
            return Subprocess.run(List.of("git", "-C", repoRoot).plus(args), θ["code.fix.scripts.check_committed_test_naming.git_timeout_s"]); // src: vulnhunter-fix/scripts/check-committed-test-naming.py:55
        } catch (TimeoutExpired | OSError e) {
            return new Proc(2, "", e);                                                                    // src: vulnhunter-fix/scripts/check-committed-test-naming.py:60
        }
    }

    String resolveBase(String repoRoot, String base, Theta θ) {
        List<String> candidates = List.of();
        if (!base.isEmpty()) candidates.addAll(base, "origin/" + base);                                   // src: vulnhunter-fix/scripts/check-committed-test-naming.py:74
        Proc sym = git(repoRoot, List.of("symbolic-ref", "--short", "refs/remotes/origin/HEAD"), θ);      // src: vulnhunter-fix/scripts/check-committed-test-naming.py:75
        if (sym.rc == 0 && !sym.stdout.strip().isEmpty()) candidates.add(sym.stdout.strip());             // src: vulnhunter-fix/scripts/check-committed-test-naming.py:76
        candidates.addAll(θ["code.fix.scripts.check_committed_test_naming.fallback_base_refs"]);          // src: vulnhunter-fix/scripts/check-committed-test-naming.py:78
        for (String cand : candidates) {
            if (git(repoRoot, List.of("rev-parse", "--verify", "--quiet", cand), θ).rc == 0) return cand; // src: vulnhunter-fix/scripts/check-committed-test-naming.py:80
        }
        return null;
    }

    Pair<List<String>, String> addedFiles(String repoRoot, String base, Theta θ) {
        String ref = resolveBase(repoRoot, base, θ);                                                      // src: vulnhunter-fix/scripts/check-committed-test-naming.py:87
        if (ref == null) {
            // degraded mode: only files added by HEAD are scanned; warns but does not block delivery
            Proc proc = git(repoRoot, List.of("show", "--name-only", "--diff-filter=A", "--pretty=format:", "HEAD"), θ); // src: vulnhunter-fix/scripts/check-committed-test-naming.py:100
            if (proc.rc != 0) return Pair.of(List.of(), "git show failed");                               // src: vulnhunter-fix/scripts/check-committed-test-naming.py:103
            Stderr.print("WARNING: could not resolve a base ref; scanned only files added by HEAD");      // src: vulnhunter-fix/scripts/check-committed-test-naming.py:104
            return Pair.of(proc.stdout.nonEmptyLines(), null);                                            // src: vulnhunter-fix/scripts/check-committed-test-naming.py:111
        }
        // three-dot diff: merge-base relative, every file added across the branch
        Proc proc = git(repoRoot, List.of("diff", "--name-only", "--diff-filter=A", ref + "...HEAD"), θ); // src: vulnhunter-fix/scripts/check-committed-test-naming.py:117
        if (proc.rc != 0) return Pair.of(List.of(), "git diff failed");                                   // src: vulnhunter-fix/scripts/check-committed-test-naming.py:119
        return Pair.of(proc.stdout.nonEmptyLines(), null);
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/check-committed-test-naming.py:124
        String base = args.base != null ? args.base : "main";                                             // src: vulnhunter-fix/scripts/check-committed-test-naming.py:126
        Pair<List<String>, String> r = addedFiles(args.repoRoot, base, θ);                                // src: vulnhunter-fix/scripts/check-committed-test-naming.py:133
        if (r.second != null) return 2;                                                                   // src: vulnhunter-fix/scripts/check-committed-test-naming.py:136
        List<String> hits = offendingFiles(r.first, θ);                                                   // src: vulnhunter-fix/scripts/check-committed-test-naming.py:138
        if (!hits.isEmpty()) return 1;                                                                    // src: vulnhunter-fix/scripts/check-committed-test-naming.py:151
        return 0;
    }
}
