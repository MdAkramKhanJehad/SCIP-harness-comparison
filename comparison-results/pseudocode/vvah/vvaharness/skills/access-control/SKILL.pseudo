// file: vvaharness/skills/access-control/SKILL.md
// S4 skill playbook "access-control": IDOR/BOLA, missing authorization, privilege escalation, tenant isolation.
// The bug is usually an ABSENT check; hard gate = entry point + identity, and the object's ownership check.

@executedBy(MODEL) @role(skill) @stage("S4")
class AccessControlSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_access-control.trigger"])) return List.of();                     // src: vvaharness/skills/access-control/SKILL.md:3
        AccessControlPrompt.playbook(θ);
        List<Finding> out = new List();
        // where to look is a starting point; reason beyond it
        List<Candidate> cands = lookFirst(repo, θ);                                                         // src: vvaharness/skills/access-control/SKILL.md:41
        for (Candidate c : cands) {
            if (θ["p.skill_access-control.in_depth_confirm_first"] && !c.analysedInDepth()) c.analyseInDepth(); // src: vvaharness/skills/access-control/SKILL.md:39
            if (!hardGate(c, θ)) continue;
            out.add(c.toFinding());
        }
        return out;
    }

    boolean hardGate(Candidate c, Theta θ) {
        // (a) entry point and the identity it authenticates as
        if (θ["p.skill_access-control.gate_entry_point_and_identity"] && (c.entryPoint == null || c.identity == null)) return false; // src: vvaharness/skills/access-control/SKILL.md:30
        // (b) the object acted on and WHERE ownership/tenant/role is verified for THAT object
        if (θ["p.skill_access-control.gate_object_and_ownership_check"] && c.object == null) return false; // src: vvaharness/skills/access-control/SKILL.md:32
        // "endpoint requires login" is NOT authorization
        boolean checked = c.objectCheck != null && !(θ["p.skill_access-control.login_is_not_authorization"] && c.objectCheck.isLoginOnly()); // src: vvaharness/skills/access-control/SKILL.md:34
        if (checked && c.objectCheck.correct && θ["p.skill_access-control.drop_if_check_correct"]) return false; // DROP // src: vvaharness/skills/access-control/SKILL.md:34
        // fixed/hardcoded target: at most a bounded single-record issue, never IDOR/BOLA
        if (θ["p.skill_access-control.fixed_target_not_idor"] && c.targetIsConstant()) c.relabel("single-record, bounded blast radius"); // src: vvaharness/skills/access-control/SKILL.md:36
        return true;
    }

    List<Candidate> lookFirst(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (θ["p.skill_access-control.enumerate_reachable_handlers"]) {                                     // src: vvaharness/skills/access-control/SKILL.md:42
            for (Handler h : repo.externallyReachableHandlers()) {
                if (h.requestObjectId() != null && !h.checksIdAgainstCaller()) out.add(new Candidate(h));
            }
        }
        if (θ["p.skill_access-control.look_direct_object_refs"]) out.addAll(repo.grep("findById(request.id), getOne(id), paths/S3 keys from request")); // src: vvaharness/skills/access-control/SKILL.md:46
        if (θ["p.skill_access-control.look_missing_sibling_guards"]) out.addAll(repo.methodsMissingGuardSiblingsHave()); // src: vvaharness/skills/access-control/SKILL.md:48
        if (θ["p.skill_access-control.look_vertical_escalation"]) out.addAll(repo.grep("admin ops on non-admin routes, case-sensitive role compare, unverified role claim")); // src: vvaharness/skills/access-control/SKILL.md:51
        if (θ["p.skill_access-control.look_mass_assignment"]) out.addAll(repo.grep("request DTO bound to entity: owner_id/role/isAdmin/tenantId/price")); // src: vvaharness/skills/access-control/SKILL.md:54
        if (θ["p.skill_access-control.look_multi_tenant_leakage"]) out.addAll(repo.grep("query by id without tenant_id; cache keyed only by object id")); // src: vvaharness/skills/access-control/SKILL.md:57
        if (θ["p.skill_access-control.look_destructive_bulk_ops"]) {                                        // src: vvaharness/skills/access-control/SKILL.md:59
            for (Candidate c : repo.grep("deleteAll/truncate/DELETE FROM t/bulk UPDATE without scope")) {
                c.severityFloor = θ["p.skill_access-control.bulk_op_first_class_severity"];                 // src: vvaharness/skills/access-control/SKILL.md:62
                out.add(c);
            }
        }
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class AccessControlPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_access-control.persona"]);                                                     // "You are an Authorization / access-control expert." // src: vvaharness/skills/access-control/SKILL.md:24
        p.rule(θ["p.skill_access-control.hunt_for_absence"]);                                               // "you are looking for what is NOT there" // src: vvaharness/skills/access-control/SKILL.md:27
        p.evidence(θ["p.skill_access-control.gate_entry_point_and_identity"]);                              // src: vvaharness/skills/access-control/SKILL.md:30
        p.evidence(θ["p.skill_access-control.gate_object_and_ownership_check"]);                            // src: vvaharness/skills/access-control/SKILL.md:32
        p.forbid(θ["p.skill_access-control.drop_if_check_correct"]);                                        // src: vvaharness/skills/access-control/SKILL.md:34
        p.rule(θ["p.skill_access-control.login_is_not_authorization"]);                                     // src: vvaharness/skills/access-control/SKILL.md:34
        p.exemption(θ["p.skill_access-control.fixed_target_not_idor"]);                                     // src: vvaharness/skills/access-control/SKILL.md:36
        p.must(θ["p.skill_access-control.in_depth_confirm_first"]);                                         // "Do in depth analysis to confirm first." // src: vvaharness/skills/access-control/SKILL.md:39
        p.rule(θ["p.skill_access-control.look_list_non_exhaustive"]);                                       // src: vvaharness/skills/access-control/SKILL.md:41
        p.checklist(θ["p.skill_access-control.enumerate_reachable_handlers"]);                              // src: vvaharness/skills/access-control/SKILL.md:42
        p.checklist(θ["p.skill_access-control.look_direct_object_refs"]);                                   // src: vvaharness/skills/access-control/SKILL.md:46
        p.checklist(θ["p.skill_access-control.look_missing_sibling_guards"]);                               // src: vvaharness/skills/access-control/SKILL.md:48
        p.checklist(θ["p.skill_access-control.look_vertical_escalation"]);                                  // src: vvaharness/skills/access-control/SKILL.md:51
        p.checklist(θ["p.skill_access-control.look_mass_assignment"]);                                      // src: vvaharness/skills/access-control/SKILL.md:54
        p.checklist(θ["p.skill_access-control.look_multi_tenant_leakage"]);                                 // src: vvaharness/skills/access-control/SKILL.md:57
        p.checklist(θ["p.skill_access-control.look_destructive_bulk_ops"]);                                 // src: vvaharness/skills/access-control/SKILL.md:59
        p.threshold(θ["p.skill_access-control.bulk_op_first_class_severity"]);                              // src: vvaharness/skills/access-control/SKILL.md:62
        return p;
    }
}
