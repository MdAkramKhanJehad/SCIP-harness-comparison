// file: vvaharness/skills/batch-etl/SKILL.md
// S4 skill playbook "batch-etl": file-in -> transform -> file-out jobs; attacker is an upstream producer,
// scheduler parameter or shared landing directory. Hard gate = external value + unvalidated reach file:line.

@executedBy(MODEL) @role(skill) @stage("S4")
class BatchEtlSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_batch-etl.trigger"])) return List.of();                          // src: vvaharness/skills/batch-etl/SKILL.md:3
        BatchEtlPrompt.playbook(θ);
        List<String> attackers = θ["p.skill_batch-etl.attacker_model"];                                     // NOT an interactive web user // src: vvaharness/skills/batch-etl/SKILL.md:26
        List<Finding> out = new List();
        for (Candidate c : lookFirst(repo, θ)) {
            if (!attackers.contains(c.attacker)) continue;
            if (θ["p.skill_batch-etl.gate_external_value"] && c.externalValue == null) continue;            // src: vvaharness/skills/batch-etl/SKILL.md:29
            if (θ["p.skill_batch-etl.gate_unvalidated_reach_file_line"] && c.unvalidatedReach == null) continue; // src: vvaharness/skills/batch-etl/SKILL.md:31
            if (θ["p.skill_batch-etl.drop_same_trust_domain"] && c.sameTrustDomain && !c.settableByLowerPrivilege) continue; // DROP // src: vvaharness/skills/batch-etl/SKILL.md:32
            out.add(c.toFinding());
        }
        return out;
    }

    List<Candidate> lookFirst(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (θ["p.skill_batch-etl.look_job_params_to_paths"]) out.addAll(repo.grep("sys.argv/os.environ/JCL PARM into open/Path/shutil without base dir + realpath")); // src: vvaharness/skills/batch-etl/SKILL.md:37
        if (θ["p.skill_batch-etl.look_record_derived_filenames"]) out.addAll(repo.grep("output filenames from record fields")); // src: vvaharness/skills/batch-etl/SKILL.md:41
        if (θ["p.skill_batch-etl.look_shared_landing_dirs"]) out.addAll(repo.grep("glob *.dat / pick newest by mtime")); // src: vvaharness/skills/batch-etl/SKILL.md:43
        if (θ["p.skill_batch-etl.look_fixed_width_parsing"]) out.addAll(repo.grep("header length uncapped, sign/zone nibble, 1-based vs 0-based")); // src: vvaharness/skills/batch-etl/SKILL.md:46
        if (θ["p.skill_batch-etl.look_trailer_verification"]) out.addAll(repo.grep("record-count/hash-total trailer not verified")); // src: vvaharness/skills/batch-etl/SKILL.md:51
        if (θ["p.skill_batch-etl.look_csv_formula_injection"]) out.addAll(repo.grep("CSV cells without stripping = + - @")); // src: vvaharness/skills/batch-etl/SKILL.md:53
        if (θ["p.skill_batch-etl.look_subprocess_args"]) out.addAll(repo.grep("subprocess/os.system args from params or records")); // src: vvaharness/skills/batch-etl/SKILL.md:56
        if (θ["p.skill_batch-etl.look_idempotency_restart"]) out.addAll(repo.grep("checkpoint markers in world-writable dir; double-post on rerun")); // src: vvaharness/skills/batch-etl/SKILL.md:58
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class BatchEtlPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_batch-etl.persona"]);                                                          // src: vvaharness/skills/batch-etl/SKILL.md:24
        p.rule(θ["p.skill_batch-etl.attacker_model"]);                                                      // src: vvaharness/skills/batch-etl/SKILL.md:26
        p.evidence(θ["p.skill_batch-etl.gate_external_value"]);                                             // src: vvaharness/skills/batch-etl/SKILL.md:29
        p.evidence(θ["p.skill_batch-etl.gate_unvalidated_reach_file_line"]);                                // src: vvaharness/skills/batch-etl/SKILL.md:31
        p.forbid(θ["p.skill_batch-etl.drop_same_trust_domain"]);                                            // src: vvaharness/skills/batch-etl/SKILL.md:32
        p.rule(θ["p.skill_batch-etl.look_list_non_exhaustive"]);                                            // src: vvaharness/skills/batch-etl/SKILL.md:36
        p.checklist(θ["p.skill_batch-etl.look_job_params_to_paths"]);                                       // src: vvaharness/skills/batch-etl/SKILL.md:37
        p.checklist(θ["p.skill_batch-etl.look_record_derived_filenames"]);                                  // src: vvaharness/skills/batch-etl/SKILL.md:41
        p.checklist(θ["p.skill_batch-etl.look_shared_landing_dirs"]);                                       // src: vvaharness/skills/batch-etl/SKILL.md:43
        p.checklist(θ["p.skill_batch-etl.look_fixed_width_parsing"]);                                       // src: vvaharness/skills/batch-etl/SKILL.md:46
        p.checklist(θ["p.skill_batch-etl.look_trailer_verification"]);                                      // src: vvaharness/skills/batch-etl/SKILL.md:51
        p.checklist(θ["p.skill_batch-etl.look_csv_formula_injection"]);                                     // src: vvaharness/skills/batch-etl/SKILL.md:53
        p.checklist(θ["p.skill_batch-etl.look_subprocess_args"]);                                           // src: vvaharness/skills/batch-etl/SKILL.md:56
        p.checklist(θ["p.skill_batch-etl.look_idempotency_restart"]);                                       // src: vvaharness/skills/batch-etl/SKILL.md:58
        return p;
    }
}
