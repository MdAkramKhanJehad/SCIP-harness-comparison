# vvaharness/validation/tools/_scope.py

Shared in-scope file iteration for the fact tools, mirroring Stage 1's production exclusions and refusing symlinks whose targets escape the workspace.

Source: `vvaharness/validation/tools/_scope.py` (lines 1-96)
Executor: code
Called from: `vvaharness/validation/tools/pattern_scanner.sudo`, `vvaharness/validation/tools/test_inventory.sudo`

// src: vvaharness/validation/tools/_scope.py:33-47
_TEST_DIRS = { "test", "tests", "__tests__", "__test__", "e2e", "testdata", "fixtures", "__fixtures__", "mocks", "__mocks__", "stubs" }
_INFRA_DIRS = lowercase(_DEFAULT_EXCLUDE_DIRS) minus _TEST_DIRS   // external: vvaharness/scope.py
require _TEST_DIRS is a subset of lowercase(_DEFAULT_EXCLUDE_DIRS) => throw RuntimeError("validation _TEST_DIRS drifted from s1_preprocess._DEFAULT_EXCLUDE_DIRS: ...")   // at import time

// src: vvaharness/validation/tools/_scope.py:74-96
fn iter_in_scope_files(workspace, include_tests):executor=code {
  root = resolved workspace
  excluded_dirs = if (include_tests) _INFRA_DIRS else (_INFRA_DIRS union _TEST_DIRS)
  walk workspace without following directory links, in sorted order {
    descend only into directories not in excluded_dirs, or named "target" without a build marker beside it   // mirrors s1_preprocess
    for each file {
      skip if its extension is in _DEFAULT_EXCLUDE_EXTS
      skip if !include_tests && its relative path matches _DEFAULT_EXCLUDE_GLOBS
      skip if it is a symlink resolving outside root   // "a host-file-disclosure guard"
      skip if it is not a regular file
      yield it
    }
  }
}
