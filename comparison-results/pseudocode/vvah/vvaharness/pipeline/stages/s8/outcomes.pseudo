    }
}

/** One entry of the model's ranked_findings. Field descriptions are rendered by S8Outcomes.rankedEntry. Each validator coerces per field, so one malformed scalar costs that entry alone, not the whole reply. */
@executedBy(CODE) @role(types) @stage("S8")
record RankedEntry(String findingId, String severity, String exploitabilityNotes, List<String> feeds) {

    /** Validator (before) for finding_id, severity, exploitability_notes: shared text coercion. */
    @src("vvaharness/pipeline/stages/s8/outcomes.py:93")
    Object coerceStr(Object v) {
        return ScanCoerce.text(v);                                                              // src: vvaharness/pipeline/stages/s8/outcomes.py:94
    }

    /** Validator (before) for feeds: strList coercion. */
    @src("vvaharness/pipeline/stages/s8/outcomes.py:98")
    Object coerceFeeds(Object v) {
        return S8Outcomes.strList(v);                                                           // src: vvaharness/pipeline/stages/s8/outcomes.py:99
    }
}

/** One chain the model reports. Lax mode coerces neither int to str nor str to list, so the before-validators do it. */
@executedBy(CODE) @role(types) @stage("S8")
record ChainEntry(String title, List<String> steps, String severity, List<String> blockedByControls, String narrative, List<LinkEvidence> linkEvidence, String entryReachability, List<String> preconditions) {

    /** Validator (before) for title, severity, narrative, entry_reachability. */
    @src("vvaharness/pipeline/stages/s8/outcomes.py:133")
    Object coerceStr(Object v) {
        return ScanCoerce.text(v);                                                              // src: vvaharness/pipeline/stages/s8/outcomes.py:134
    }

    /** Validator (before) for steps, blocked_by_controls, preconditions. */
    @src("vvaharness/pipeline/stages/s8/outcomes.py:139")
    Object coerceStrList(Object v) {
        return S8Outcomes.strList(v);                                                           // src: vvaharness/pipeline/stages/s8/outcomes.py:140
    }

    /** Validator (before) for link_evidence: a non-list becomes []; entries that are neither a mapping nor a LinkEvidence are dropped and counted (a bare-string cli entry is unplaceable). Dropping to nothing leaves the chain unevidenced (annotated), not invalid. */
    @src("vvaharness/pipeline/stages/s8/outcomes.py:144")
    Object coerceLinks(Object v) {
        if (!(v is List)) return List.of();                                                     // src: vvaharness/pipeline/stages/s8/outcomes.py:148
        List kept = v.filter(x -> x is Map || x is LinkEvidence);                               // src: vvaharness/pipeline/stages/s8/outcomes.py:149
        if (kept.size() < v.size()) Counters.bump("s8_link_evidence_entry_invalid", v.size() - kept.size()); // src: vvaharness/pipeline/stages/s8/outcomes.py:151
        return kept;                                                                            // src: vvaharness/pipeline/stages/s8/outcomes.py:152
    }
}
