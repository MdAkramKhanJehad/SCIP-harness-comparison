// file: vvaharness/cli/__init__.py
// vvaharness CLI entry point: loads .env, strips logging flags, prints help, and dispatches to the subcommands
// (setup, doctor, estimate, gc, remediate, ev-replay, validate) or to scan under the run manifest.

@executedBy(CODE) @role(pipeline)
class VvaharnessCli {

    // _COMMAND_HELP and _NOTES: help text only                                                      // src: vvaharness/cli/__init__.py:96

    /** Command table and stage/config notes to stdout. */
    void printHelp() {
        if (!Console.banner(false, false)) Console.write("vvaharness <version> - agentic SAST pipeline"); // src: vvaharness/cli/__init__.py:143
        Table t = Console.statusTable("Commands:", List.of("", "command", "what it does"));             // src: vvaharness/cli/__init__.py:146
        Console.write(t);                                                                              // src: vvaharness/cli/__init__.py:150
    }

    /** Honour --log-level / --log-file (both forms) and strip them from args. */
    List<String> configureLogging(List<String> args) {
        String level = null; String path = null; List<String> rest = new List(); int skip = -1;
        for (int i = 0; i < args.size(); i++) {                                                        // src: vvaharness/cli/__init__.py:162
            if (i <= skip) continue;                                                                   // src: vvaharness/cli/__init__.py:163
            String arg = args.get(i);
            if ((arg == "--log-level" || arg == "--log-file") && i + 1 < args.size()) {                // src: vvaharness/cli/__init__.py:167
                if (arg == "--log-level") level = args.get(i + 1); else path = args.get(i + 1);
                skip = i + 1;                                                                          // src: vvaharness/cli/__init__.py:168
            } else if (arg.startsWith("--log-level=")) level = arg.after("=");                        // src: vvaharness/cli/__init__.py:170
            else if (arg.startsWith("--log-file=")) path = arg.after("=");
            else rest.add(arg);                                                                        // src: vvaharness/cli/__init__.py:174
        }
        Logs.configure(level, path);                                                                   // src: vvaharness/cli/__init__.py:180
        return rest;
    }

    /** Implicit scan when the first token names no command (vvaharness --repo X). */
    List<String> withCommand(List<String> args) {
        return App.COMMANDS.contains(args.get(0)) ? args : List.of("scan").plus(args);                // src: vvaharness/cli/__init__.py:185
    }

    int version() {
        Console.write("Visa Vulnerability Agentic Harness <version>");                                 // src: vvaharness/cli/__init__.py:192
        return 0;
    }

    /** Run the subcommand named by args[0]; scan runs under SIGTERM handling and the run manifest. */
    int dispatch(List<String> args, Theta θ) {
        String cmd = args.get(0);                                                                      // src: vvaharness/cli/__init__.py:197
        if (cmd == "setup" || cmd == "init") return Setup.setup(args.tail());                          // src: vvaharness/cli/__init__.py:198
        if (cmd == "doctor") return Commands.doctor(args.tail());                                      // src: vvaharness/cli/__init__.py:200
        if (cmd == "estimate") return Commands.estimate(args.tail());                                  // src: vvaharness/cli/__init__.py:202
        if (cmd == "gc") return Commands.gc(args.tail());                                              // src: vvaharness/cli/__init__.py:204
        if (cmd == "remediate") return Commands.remediate(args.tail());                                // src: vvaharness/cli/__init__.py:206
        if (cmd == "ev-replay") return Commands.evReplay(args.tail());                                 // src: vvaharness/cli/__init__.py:208
        if (List.of("validate", "s11").contains(cmd)) return Commands.validate(args.tail());           // VALIDATE_COMMANDS // src: vvaharness/cli/__init__.py:210
        if (cmd == "scan") args = args.tail();                                                         // src: vvaharness/cli/__init__.py:212
        try { OrchestratorEntry.buildParser(args, θ); }                                                // src: vvaharness/cli/__init__.py:220
        catch (SystemExit r) { return r.code; }                                                        // src: vvaharness/cli/__init__.py:222
        Pair<String, Boolean> cp = Paths.configPathFromExplicit(args);                                 // src: vvaharness/cli/__init__.py:223
        String cfgPath;
        try {
            cfgPath = ConfigPaths.trustedConfig(cp.first, Paths.configTrustBoundary(args), cp.second, true, θ); // quiet: feeds the manifest record // src: vvaharness/cli/__init__.py:226
            Config.readPrimary(cfgPath);                                                               // src: vvaharness/cli/__init__.py:228
        } catch (ConfigPolicyError e) {
            Log.error("CONFIG_POLICY_REFUSED"); return 2;                                              // src: vvaharness/cli/__init__.py:230
        }
        boolean installSigterm = Threads.isMain() && Signal.get(SIGTERM) == SIG_DFL;                   // operator's own handler is kept // src: vvaharness/cli/__init__.py:238
        if (installSigterm) Signal.set(SIGTERM, () -> { throw new Terminated(143); });                // src: vvaharness/cli/__init__.py:240
        try {
            Map m = Manifest.capture(Path.of(cfgPath), args, null, null);                              // src: vvaharness/cli/__init__.py:244
            int rc = OrchestratorEntry.main(args, θ);                                                  // src: vvaharness/cli/__init__.py:245
            m.put("exit_code", rc);                                                                    // src: vvaharness/cli/__init__.py:246
            return rc;
        } finally {
            if (installSigterm) Signal.restore(SIGTERM);                                               // src: vvaharness/cli/__init__.py:250
        }
    }

    /** Console entry: python check, --version, .env, logging flags, help, then the Typer app. */
    int main(List<String> argv, Theta θ) {
        try {
            String err = Paths.checkPython();                                                          // src: vvaharness/cli/__init__.py:255
            if (err != null) { Log.error("PYTHON_UNSUPPORTED"); return 2; }                            // src: vvaharness/cli/__init__.py:256
            List<String> args = argv != null ? argv : Sys.argv().tail();                               // src: vvaharness/cli/__init__.py:260
            if (args == List.of("--version")) return version();                                        // src: vvaharness/cli/__init__.py:261
            Dotenv.loadDotenv(Paths.repoFrom(args), θ);                                                // src: vvaharness/cli/__init__.py:263
            args = configureLogging(args);                                                             // src: vvaharness/cli/__init__.py:265
            if (args.isEmpty()) { printHelp(); return 0; }                                             // never silently default to scan // src: vvaharness/cli/__init__.py:267
            if (List.of("-h", "--help", "help").contains(args.get(0))) { printHelp(); return 0; }      // src: vvaharness/cli/__init__.py:270
            try { return App.run(withCommand(args)); }                                                 // src: vvaharness/cli/__init__.py:277
            catch (StoreError e) { Log.error("STORE_UNUSABLE"); return 2; }                            // symlinked state dir: operator fix // src: vvaharness/cli/__init__.py:278
        } catch (KeyboardInterrupt e) {
            Console.mark("fail", "command aborted by user (Ctrl-C).", 2, "\n", false);                 // src: vvaharness/cli/__init__.py:283
            return 130;                                                                                // src: vvaharness/cli/__init__.py:284
        }
    }
}
