// file: vvaharness/skills/templates/SKILL.md
// S4 skill playbook "templates": template/view-layer lens. A template file is a finding LOCATION;
// judge each interpolation by its output context; trace stored paths; info disclosure and CSRF at the same lines.

@executedBy(MODEL) @role(skill) @stage("S4")
class TemplatesSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        if (!repo.hasPathsMatching(θ["p.skill_templates.trigger"])) return List.of();              // src: vvaharness/skills/templates/SKILL.md:3
        ProbeOutput po = firstMove(repo, θ);
        List<String> order = new List<String>();
        // layouts / partials first: highest multiplier
        if (θ["p.skill_templates.read_layouts_before_leaf_pages"]) order.addAll(po.section("LAYOUTS / PARTIALS / FRAGMENTS")); // src: vvaharness/skills/templates/SKILL.md:36
        // open every template in the inventory, partials included; do not sample
        if (θ["p.skill_templates.open_every_template_no_sampling"]) order.addAll(po.templateInventory()); // src: vvaharness/skills/templates/SKILL.md:118
        else order.addAll(po.candidateFiles());
        List<Finding> out = new List<Finding>();
        Sweep sweep = new Sweep();
        for (String tpl : order.distinct()) {
            Page src = Tools.Read(tpl);
            for (Interpolation ip : src.interpolations()) {
                sweep.judged++;
                Candidate xss = judgeXss(ip, repo, po, θ);
                if (xss != null) out.addAll(enumerate(xss, θ)); else if (ip.autoescapeRefuted) sweep.autoescapeRefuted++;
                out.addAll(moreClassesAtLine(ip, repo, po, θ));
            }
            out.addAll(csrfForms(tpl, src, po, θ));
        }
        sweep.confirmed = out.size();
        stateSweep(sweep, θ);
        return out;
    }

    ProbeOutput firstMove(Repo repo, Theta θ) {
        if (!θ["p.skill_templates.run_probe_first"]) return ProbeOutput.empty();                    // src: vvaharness/skills/templates/SKILL.md:32
        ProbeOutput po = Tools.Bash("sh .vvaharness/skills/templates/probe.sh");                   // src: vvaharness/skills/templates/SKILL.md:32
        // calls TemplatesProbe.run(...); probe gives candidates, judgement is not greppable
        assert θ["p.skill_templates.probe_gives_candidates_only"];                                  // src: vvaharness/skills/templates/SKILL.md:38
        return po;
    }

    Candidate judgeXss(Interpolation ip, Repo repo, ProbeOutput po, Theta θ) {
        // Gate 1: a template sink (safe/raw marker, autoescape off, macro kwarg marking a column safe, or a context escaping misses)
        Context ctx = θ["p.skill_templates.judge_by_surrounding_bytes"] ? ip.contextFromSurroundingBytes() : ip.filterContext(); // src: vvaharness/skills/templates/SKILL.md:54
        boolean sink = ip.matchesAny(θ["p.skill_templates.gate_template_sink"]) || contextMissedByHtmlEscape(ctx, ip, θ); // src: vvaharness/skills/templates/SKILL.md:43
        if (!sink) {
            if (θ["p.skill_templates.fp_autoescape_on_no_marker"] && (ctx == Context.HTML_BODY || ctx == Context.QUOTED_ATTR)) { ip.autoescapeRefuted = true; return null; } // src: vvaharness/skills/templates/SKILL.md:102
            return null;
        }
        // Gate 2: value not a template-local constant (read Emptied expressions before refuting)
        if (θ["p.skill_templates.gate_non_constant_value"] && ip.isTemplateLocalConstant()) {       // src: vvaharness/skills/templates/SKILL.md:45
            boolean emptiedButLive = θ["p.skill_templates.read_emptied_expressions_before_refuting"] && emptiedExpressionStillSink(ip, repo, θ); // src: vvaharness/skills/templates/SKILL.md:46
            if (!emptiedButLive) return null;
        }
        if (θ["p.skill_templates.fp_helper_or_bounded_expression"] != null && ip.isAny(θ["p.skill_templates.fp_helper_or_bounded_expression"])) { // src: vvaharness/skills/templates/SKILL.md:104
            if (!(θ["p.skill_templates.fp_bounded_excludes_stub_with_live_column"] && ip.isStubBackedByLiveColumn())) return null; // src: vvaharness/skills/templates/SKILL.md:105
        }
        // Gate 3: a named path from an external actor
        Path path = ip.isStored() ? storedPath(ip, repo, θ) : ip.reflectedPath();
        if (θ["p.skill_templates.gate_named_external_path"] && path == null) return null;           // src: vvaharness/skills/templates/SKILL.md:47
        // Gate 4: no context-correct escaper between them
        if (path.hasAny(θ["p.skill_templates.gate_no_context_correct_escaper"])) return null;       // src: vvaharness/skills/templates/SKILL.md:49
        // FP checks
        if (θ["p.skill_templates.fp_reescaped_outer_xss_not_ssti"] && ip.reescapedAtOuterInterpolation()) return Candidate.ssti(ip, "CWE-1336"); // src: vvaharness/skills/templates/SKILL.md:106
        if (θ["p.skill_templates.fp_sanitizer_on_write_path"] && path.sanitizerOnWritePath() != null) { // src: vvaharness/skills/templates/SKILL.md:108
            if (!(θ["p.skill_templates.rich_text_editor_not_sanitizer"] && path.sanitizerOnWritePath().isBrowserRichTextEditor())) return null; // src: vvaharness/skills/templates/SKILL.md:109
        }
        Candidate c = Candidate.xss(ip, path);
        if (θ["p.skill_templates.csp_lowers_severity_not_refute"] && po.cspWithoutUnsafeInlineWithNonce()) c.lowerSeverityStatingWhatCspBlocks(); // src: vvaharness/skills/templates/SKILL.md:110
        if (θ["p.skill_templates.fp_not_rendered"] && (ip.underStatic() || ip.isFixture() || !po.renderCallSites().names(ip.file))) return null; // src: vvaharness/skills/templates/SKILL.md:112
        // anchor on the template line that emits the value, not the handler that renders it
        if (θ["p.skill_templates.anchor_on_template_line"]) c.anchor(ip.file, ip.line);             // src: vvaharness/skills/templates/SKILL.md:26
        return c;
    }

    boolean contextMissedByHtmlEscape(Context ctx, Interpolation ip, Theta θ) {
        if (ctx == Context.URL && θ["p.skill_templates.context_url_needs_scheme_allowlist"]) return !ip.hasSchemeAllowList(); // src: vvaharness/skills/templates/SKILL.md:57
        if (ctx == Context.EVENT_HANDLER && θ["p.skill_templates.context_event_handler"]) return true; // src: vvaharness/skills/templates/SKILL.md:60
        if (ctx == Context.SCRIPT) return !ip.usesAny(θ["p.skill_templates.context_script_needs_tojson"]); // src: vvaharness/skills/templates/SKILL.md:62
        if ((ctx == Context.UNQUOTED_ATTR || ctx == Context.CSS) && θ["p.skill_templates.context_unquoted_attr_and_css"]) return true; // src: vvaharness/skills/templates/SKILL.md:64
        return false;
    }

    boolean emptiedExpressionStillSink(Interpolation ip, Repo repo, Theta θ) {
        // stubbed helper returning "" still sits in live markup fed by a live column
        if (θ["p.skill_templates.emptied_expressions_still_sinks"] && ip.markupLive() && ip.backingColumn() != null && repo.writerOf(ip.backingColumn()) != null) { // src: vvaharness/skills/templates/SKILL.md:69
            if (θ["p.skill_templates.name_column_stub_stands_for"]) ip.note("stub stands in for " + ip.backingColumn()); // src: vvaharness/skills/templates/SKILL.md:72
            return true;
        }
        return false;
    }

    Path storedPath(Interpolation ip, Repo repo, Theta θ) {
        Path p = new Path();
        if (θ["p.skill_templates.stored_step1_take_expression"]) p.expr = ip.expression();         // src: vvaharness/skills/templates/SKILL.md:78
        if (θ["p.skill_templates.stored_step2_grep_view_kwarg"]) { p.route = Tools.Grep("render_template('" + ip.file); p.query = p.route.kwargQuery(p.expr); } // src: vvaharness/skills/templates/SKILL.md:79
        if (θ["p.skill_templates.stored_step3_grep_model_writes"]) p.writers = Tools.Grep(p.query.modelAttr()).writes().plus(Tools.GraphImporters(p.query.modelModule())); // src: vvaharness/skills/templates/SKILL.md:80
        if (p.writers.isEmpty()) return null;
        // who reads it back: other users' rows -> cross-account stored XSS, not self-XSS. Say which.
        if (θ["p.skill_templates.stored_step4_who_reads_back"]) p.crossAccount = p.query.rendersOtherUsersRows(); // src: vvaharness/skills/templates/SKILL.md:82
        if (θ["p.skill_templates.stored_step5_report_at_template_line"]) p.citeWriter(p.writers.first()); // src: vvaharness/skills/templates/SKILL.md:84
        return p;
    }

    List<Finding> moreClassesAtLine(Interpolation ip, Repo repo, ProbeOutput po, Theta θ) {
        List<Finding> out = new List<Finding>();
        // info disclosure, separate from any XSS on the line
        if (ip.rendersExceptionOrDebugObject()) out.add(new Finding(ip, θ["p.skill_templates.info_disclosure_cwe209"])); // src: vvaharness/skills/templates/SKILL.md:88
        if (ip.rendersConfigSecretPasswordPathSqlBanner()) out.add(new Finding(ip, θ["p.skill_templates.info_disclosure_cwe200_540"])); // src: vvaharness/skills/templates/SKILL.md:90
        if (θ["p.skill_templates.hidden_is_not_secret"] && (ip.inHiddenOrPasswordInputValue() || ip.inDataAttribute() || ip.inHtmlComment())) out.add(new Finding(ip, "CWE-200")); // src: vvaharness/skills/templates/SKILL.md:91
        // one line can carry two classes; split reflected from stored at one sink
        if (θ["p.skill_templates.enum_two_classes_one_line"]) out.addAll(ip.secondClassFindings()); // src: vvaharness/skills/templates/SKILL.md:122
        return out;
    }

    List<Finding> csrfForms(String tpl, Page src, ProbeOutput po, Theta θ) {
        List<Finding> out = new List<Finding>();
        boolean noMachinery = po.section("CSRF MACHINERY PRESENT REPO-WIDE").isEmpty() && po.formsSubclassWtformsForm();
        for (Form f : src.forms()) {
            if (!f.isStateChanging()) continue;
            boolean missing = po.formVerdict(f) == "NO-TOKEN";
            // zero CSRF machinery + wtforms.Form base -> every state-changing form; unused Flask-WTF is not a defence
            if (θ["p.skill_templates.zero_csrf_machinery_every_form"] && noMachinery) missing = true;  // src: vvaharness/skills/templates/SKILL.md:95
            if (θ["p.skill_templates.unused_flask_wtf_not_defence"] && po.flaskWtfOnlyInRequirements()) missing = missing || !f.hasToken(); // src: vvaharness/skills/templates/SKILL.md:96
            if (missing) out.add(new Finding(f.openTag(), θ["p.skill_templates.missing_csrf_token_at_form_tag"])); // src: vvaharness/skills/templates/SKILL.md:93
        }
        // fetch / axios / $.ajax POSTs in script blocks: cover yourself
        if (θ["p.skill_templates.cover_script_posts_yourself"]) for (ScriptPost sp : src.scriptPosts()) if (!sp.sendsCsrfToken()) out.add(new Finding(sp, "CWE-352")); // src: vvaharness/skills/templates/SKILL.md:94
        // handler-side judgement deferred to the csrf lens / CweGuidance
        Tools.call(θ["p.skill_templates.csrf_handler_side_deferred"]);                              // src: vvaharness/skills/templates/SKILL.md:98
        return out;
    }

    List<Finding> enumerate(Candidate c, Theta θ) {
        List<Finding> out = new List<Finding>();
        // every interpolation its own finding; never one omnibus
        if (θ["p.skill_templates.enum_every_interpolation"]) {                                      // src: vvaharness/skills/templates/SKILL.md:116
            if (θ["p.skill_templates.enum_per_file_and_span"]) for (Site s : c.sitesPerFileAndSpan()) out.add(new Finding(s.file, s.lineStart, s.lineEnd, c.cwe)); // src: vvaharness/skills/templates/SKILL.md:119
            else out.add(c.asFinding());
        } else {
            out.add(c.asOmnibus());
        }
        if (θ["p.skill_templates.split_reflected_from_stored"] && c.hasBothReflectedAndStoredPaths()) out.add(c.secondPathFinding()); // src: vvaharness/skills/templates/SKILL.md:123
        return out;
    }

    void stateSweep(Sweep sweep, Theta θ) {
        Report.format(θ["p.skill_templates.state_the_sweep"], sweep.globbed, sweep.judged, sweep.confirmed, sweep.autoescapeRefuted); // src: vvaharness/skills/templates/SKILL.md:125
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_templates.trigger"]);                                                     // src: vvaharness/skills/templates/SKILL.md:3
        p.must(θ["p.skill_templates.anchor_on_template_line"]);                                     // src: vvaharness/skills/templates/SKILL.md:26
        return p;
    }

    Prompt firstMoveSection(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.skill_templates.run_probe_first"]);                                         // src: vvaharness/skills/templates/SKILL.md:32
        p.step(2, θ["p.skill_templates.read_layouts_before_leaf_pages"]);                          // src: vvaharness/skills/templates/SKILL.md:36
        p.rule(θ["p.skill_templates.probe_gives_candidates_only"]);                                 // src: vvaharness/skills/templates/SKILL.md:38
        return p;
    }

    Prompt hardGateSection(Theta θ) {
        Prompt p = new Prompt();
        p.evidence(θ["p.skill_templates.gate_template_sink"]);                                      // src: vvaharness/skills/templates/SKILL.md:43
        p.evidence(θ["p.skill_templates.gate_non_constant_value"]);                                 // src: vvaharness/skills/templates/SKILL.md:45
        p.must(θ["p.skill_templates.read_emptied_expressions_before_refuting"]);                    // src: vvaharness/skills/templates/SKILL.md:46
        p.evidence(θ["p.skill_templates.gate_named_external_path"]);                                // src: vvaharness/skills/templates/SKILL.md:47
        p.evidence(θ["p.skill_templates.gate_no_context_correct_escaper"]);                         // src: vvaharness/skills/templates/SKILL.md:49
        return p;
    }

    Prompt contextSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_templates.judge_by_surrounding_bytes"]);                                  // src: vvaharness/skills/templates/SKILL.md:54
        p.rule(θ["p.skill_templates.context_url_needs_scheme_allowlist"]);                          // src: vvaharness/skills/templates/SKILL.md:57
        p.rule(θ["p.skill_templates.context_event_handler"]);                                       // src: vvaharness/skills/templates/SKILL.md:60
        p.rule(θ["p.skill_templates.context_script_needs_tojson"]);                                 // src: vvaharness/skills/templates/SKILL.md:62
        p.rule(θ["p.skill_templates.context_unquoted_attr_and_css"]);                               // src: vvaharness/skills/templates/SKILL.md:64
        return p;
    }

    Prompt emptiedExpressionsSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_templates.emptied_expressions_still_sinks"]);                             // src: vvaharness/skills/templates/SKILL.md:69
        p.must(θ["p.skill_templates.name_column_stub_stands_for"]);                                 // src: vvaharness/skills/templates/SKILL.md:72
        return p;
    }

    Prompt storedPathSection(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.skill_templates.stored_step1_take_expression"]);                            // src: vvaharness/skills/templates/SKILL.md:78
        p.step(2, θ["p.skill_templates.stored_step2_grep_view_kwarg"]);                            // src: vvaharness/skills/templates/SKILL.md:79
        p.step(3, θ["p.skill_templates.stored_step3_grep_model_writes"]);                          // src: vvaharness/skills/templates/SKILL.md:80
        p.step(4, θ["p.skill_templates.stored_step4_who_reads_back"]);                             // src: vvaharness/skills/templates/SKILL.md:82
        p.step(5, θ["p.skill_templates.stored_step5_report_at_template_line"]);                    // src: vvaharness/skills/templates/SKILL.md:84
        return p;
    }

    Prompt moreClassesSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_templates.info_disclosure_cwe209"]);                                      // src: vvaharness/skills/templates/SKILL.md:88
        p.rule(θ["p.skill_templates.info_disclosure_cwe200_540"]);                                  // src: vvaharness/skills/templates/SKILL.md:90
        p.rule(θ["p.skill_templates.hidden_is_not_secret"]);                                        // src: vvaharness/skills/templates/SKILL.md:91
        p.rule(θ["p.skill_templates.missing_csrf_token_at_form_tag"]);                              // src: vvaharness/skills/templates/SKILL.md:93
        p.must(θ["p.skill_templates.cover_script_posts_yourself"]);                                 // src: vvaharness/skills/templates/SKILL.md:94
        p.rule(θ["p.skill_templates.zero_csrf_machinery_every_form"]);                              // src: vvaharness/skills/templates/SKILL.md:95
        p.rule(θ["p.skill_templates.unused_flask_wtf_not_defence"]);                                // src: vvaharness/skills/templates/SKILL.md:96
        p.rule(θ["p.skill_templates.csrf_handler_side_deferred"]);                                  // src: vvaharness/skills/templates/SKILL.md:98
        return p;
    }

    Prompt fpSection(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.skill_templates.fp_autoescape_on_no_marker"]);                             // src: vvaharness/skills/templates/SKILL.md:102
        p.exemption(θ["p.skill_templates.fp_helper_or_bounded_expression"]);                        // src: vvaharness/skills/templates/SKILL.md:104
        p.rule(θ["p.skill_templates.fp_bounded_excludes_stub_with_live_column"]);                   // src: vvaharness/skills/templates/SKILL.md:105
        p.exemption(θ["p.skill_templates.fp_reescaped_outer_xss_not_ssti"]);                        // src: vvaharness/skills/templates/SKILL.md:106
        p.exemption(θ["p.skill_templates.fp_sanitizer_on_write_path"]);                             // src: vvaharness/skills/templates/SKILL.md:108
        p.rule(θ["p.skill_templates.rich_text_editor_not_sanitizer"]);                              // src: vvaharness/skills/templates/SKILL.md:109
        p.rule(θ["p.skill_templates.csp_lowers_severity_not_refute"]);                              // src: vvaharness/skills/templates/SKILL.md:110
        p.exemption(θ["p.skill_templates.fp_not_rendered"]);                                        // src: vvaharness/skills/templates/SKILL.md:112
        return p;
    }

    Prompt enumerationSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_templates.enum_every_interpolation"]);                                    // src: vvaharness/skills/templates/SKILL.md:116
        p.forbid(θ["p.skill_templates.open_every_template_no_sampling"]);                           // src: vvaharness/skills/templates/SKILL.md:118
        p.must(θ["p.skill_templates.enum_per_file_and_span"]);                                      // src: vvaharness/skills/templates/SKILL.md:119
        p.rule(θ["p.skill_templates.enum_two_classes_one_line"]);                                   // src: vvaharness/skills/templates/SKILL.md:122
        p.rule(θ["p.skill_templates.split_reflected_from_stored"]);                                 // src: vvaharness/skills/templates/SKILL.md:123
        p.format(θ["p.skill_templates.state_the_sweep"]);                                           // src: vvaharness/skills/templates/SKILL.md:125
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(firstMoveSection(θ));
        p.include(hardGateSection(θ));
        p.include(contextSection(θ));
        p.include(emptiedExpressionsSection(θ));
        p.include(storedPathSection(θ));
        p.include(moreClassesSection(θ));
        p.include(fpSection(θ));
        p.include(enumerationSection(θ));
        return p;
    }
}

@executedBy(CODE) @role(types)
enum Context { HTML_BODY, QUOTED_ATTR, UNQUOTED_ATTR, URL, EVENT_HANDLER, SCRIPT, CSS }
