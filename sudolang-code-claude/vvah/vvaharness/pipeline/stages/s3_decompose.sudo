# vvaharness/pipeline/stages/s3_decompose.py

Stage 3 (decompose, no model call). Builds the risk-ranked `TaskManifest` deterministically from the Stage 2 threat model: one `InvestigationUnit` per threat that has at least one validated surface file, carrying that threat's whole surface uncut. Threats without a surface get no unit; files named by no unit are reported as unreachable.

Source: `vvaharness/pipeline/stages/s3_decompose.py` (lines 1-201)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (Stage 3)

// src: vvaharness/pipeline/stages/s3_decompose.py:29-41
Constants {
  _LOC_KILO = 1_000; _P90_FRACTION = 0.9   // report formatting only
  _SMALL_UNIT_LOC_MAX = 2_000
  _MEDIUM_UNIT_LOC_MAX = 8_000
  _IMPACT_ORDINAL = { low: 1, medium: 2, high: 3, critical: 4, existential: 5 }
  _LIKELIHOOD_ORDINAL = { very_rare: 1, rare: 2, possible: 3, likely: 4, almost_certain: 5 }
  _DEFAULT_IMPACT_ORDINAL = 2       // "medium", for an unknown impact
  _DEFAULT_LIKELIHOOD_ORDINAL = 3   // "possible", for an unknown likelihood
  _MAX_RISK_SCORE = 25              // 5 * 5
}

// src: vvaharness/pipeline/stages/s3_decompose.py:44-71
fn run(ctx, cfg):executor=code {
  manifest = TaskManifest(units=[])
  n_threat = _investigation_units(manifest, ctx)
  for each u in manifest.units, u.languages = lang.detect.detect_languages(u.files, repo_root=ctx.repo_root)
  manifest.unreachable_files = _coverage_report(manifest, ctx)
  _report_unit_loc(manifest, ctx.repo_root)   // abstracted: prints unit line-count distribution (min, p50, p90, max); no decision
  return manifest
  // Stage 4 consumes manifest.sorted_units(): units sorted by risk_rank ascending (models/scan/work.py:108-109)
  // preserved: cfg is read only for the progress tracker; no step3 setting is read. No cap on the number of units or on files per unit exists in this stage
}

// src: vvaharness/pipeline/stages/s3_decompose.py:90-150
fn _investigation_units(manifest, ctx):executor=code {
  tm = ctx.threat_model
  if (!tm || !tm.threats) return 0   // no threat model: no units at all
  all_files = set(ctx.all_files)
  file_community = _file_module_index(ctx)
  base_rank = max risk_rank of existing units, or 0
  used_ids = ids of existing units

  for each [threat_id, t] in zip(tm.threat_ids(), tm.threats) {   // threat_ids: t.id, or positional "T<n>" when blank
    files = unique t.surface_files, first-seen order, that are in all_files
    if (!files) {
      manifest.threats_without_unit += threat_id   // "no validated surface file — never reviewed"
      continue
    }
    // src: s3_decompose.py:113-119 — collision-safe unit id
    cid = "threat-" + lowercase(threat_id)   // models.scan.work.threat_unit_id
    if (cid in used_ids) { n = 2; while ("$cid-$n" in used_ids) n += 1; cid = "$cid-$n" }
    used_ids += cid

    // src: s3_decompose.py:121-144
    sinks = ctx.unsafe_sinks whose file is in files
    loc = sum of _count_loc(file) over files
    manifest.units += InvestigationUnit({
      id: cid, threat, surface, actor, asset, impact, likelihood, controls, evidence (all copied from t),
      file_ids: files,   // the whole validated surface, never split or truncated
      sinks,
      entry_points: ctx.entry_points whose file is in files,
      related_cves: ids of ctx.known_cves whose affected_files intersect files,
      communities: sorted unique (file_community[f] or "file:$f") over files,   // annotation only; nothing groups or splits by it
      cwes: sorted unique CWEs of those sinks,
      risk_rank: base_rank + _threat_risk_rank(t),
      size: _size_for(loc)
    })
  }
  return number of units added
}

// src: vvaharness/pipeline/stages/s3_decompose.py:74-78
fn _threat_risk_rank(t):executor=code {
  score = (_IMPACT_ORDINAL[t.impact] or 2) * (_LIKELIHOOD_ORDINAL[t.likelihood] or 3)
  return _MAX_RISK_SCORE + 1 - score   // 1 is most urgent, 25 least; equal scores tie and keep manifest order under the stable sort
}

// src: vvaharness/pipeline/stages/s3_decompose.py:153-158
fn _size_for(loc):executor=code {
  match (loc) {
    case loc < _SMALL_UNIT_LOC_MAX => UnitSize.SMALL     // under 2,000 lines
    case loc < _MEDIUM_UNIT_LOC_MAX => UnitSize.MEDIUM   // under 8,000 lines
    default => UnitSize.LARGE
  }
  // a label only: no unit is cut, split or skipped by size here
}

// src: vvaharness/pipeline/stages/s3_decompose.py:81-87
fn _file_module_index(ctx):executor=code = file => first module name in ctx.modules that lists it

// src: vvaharness/pipeline/stages/s3_decompose.py:161-171
fn _coverage_report(manifest, ctx):executor=code {
  unreachable = sorted(ctx.all_files minus every unit's files)   // "named by no threat's surface — never reviewed"
  return unreachable   // no counter: metrics read manifest.unreachable_files, which survives --resume
}

