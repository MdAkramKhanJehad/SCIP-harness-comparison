// file: vvaharness/validation/ingest/manifest_builder.py
// Builds the agent-facing single-finding manifest for one case.

@executedBy(CODE) @role(io) @stage("S11")
class ManifestBuilder {
    Manifest buildManifest(FindingCase c, String sessionId) {
        Attempt latest = c.attempts.isEmpty() ? null : c.attempts.last();                            // src: vvaharness/validation/ingest/manifest_builder.py:27
        return new Manifest(c.caseId, sessionId, c.finding,                                          // finding carried whole  // src: vvaharness/validation/ingest/manifest_builder.py:28
            latest != null ? latest.remediation.filesTouched : List.of(),                            // src: vvaharness/validation/ingest/manifest_builder.py:32
            false);                                                                                  // post_results always false  // src: vvaharness/validation/ingest/manifest_builder.py:33
    }
}
