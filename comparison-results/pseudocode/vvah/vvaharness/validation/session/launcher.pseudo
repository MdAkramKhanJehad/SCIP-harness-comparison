            if (!directory.isAbsolute() || directory.resolve().isRelativeTo(cwd)) continue; // src: vvaharness/validation/session/launcher.py:202
            String found = which(str(directory.resolveChild(binary))); // src: vvaharness/validation/session/launcher.py:204
            if (truthy(found) && Path.of(found).isAbsolute() && !Path.of(found).resolve().isRelativeTo(cwd)) return str(Path.of(found).resolve()); // src: vvaharness/validation/session/launcher.py:207
