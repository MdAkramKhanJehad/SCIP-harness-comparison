    // Base for all harness failures. Subclasses: SessionNotResumableError, HarnessCLINotFoundError (fatal for batch),
    // HarnessConnectionError (-> ProxyError), HarnessProcessError, HarnessJSONDecodeError, HarnessMessageParseError,
    // AuthenticationError, DegenerateResponseError, OversizePromptError, TruncatedResponseError,
    // ToolStateNotRoundTrippedError, ModelCallBudgetExhaustedError, CallTimeoutError, RepeatedToolCallError.
    String message() {
        return "";
    }
}

