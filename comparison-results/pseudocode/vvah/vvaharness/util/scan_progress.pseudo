// file: vvaharness/util/scan_progress.py
// Per-file / per-unit scan observability on stderr, gated on scan_progress.enabled, in one of six styles
// (compact, verbose, summary_only, stage_only, llm_debug, live). Never changes what a scan finds.

@executedBy(CODE) @role(types)
enum ProgressStyle { COMPACT, VERBOSE, SUMMARY_ONLY, STAGE_ONLY, LLM_DEBUG, LIVE }

@executedBy(CODE) @role(types)
record UnitProgress(String unitId, List<String> files, int rank, String lens, String threat, String state, String outcome, int findings, double startedAt, double elapsed) { }

@executedBy(CODE) @role(io)
class ScanProgress {

    static final List<String> STYLES = List.of("compact", "verbose", "summary_only", "stage_only", "llm_debug", "live"); // src: vvaharness/util/scan_progress.py:30
    static final List<String> STAGE_ORDER = List.of("s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10"); // src: vvaharness/util/scan_progress.py:59
    static final int LIVE_REFRESH_HZ = 8;                                      // src: vvaharness/util/scan_progress.py:40
    static ScanProgress ACTIVE_TRACKER = null;                                 // process-wide, for backend hooks // src: vvaharness/util/scan_progress.py:63

    boolean enabled; String style; String repoName; int llmMaxChars;
    Lock lock; int totalFiles; Map<String, UnitProgress> units; Map<String, Map> stages;
    int nScanning; int nScanned; double start; Object live; int findings;

    String clock(double seconds) {
        if (seconds < 60) return format("%.1fs", seconds);                     // src: vvaharness/util/scan_progress.py:55
        return (int) seconds / 60 + "m" + pad2((int) seconds % 60) + "s";      // src: vvaharness/util/scan_progress.py:57
    }

    boolean stderrIsATerminal() {
        return stderr.isatty();                                                // src: vvaharness/util/scan_progress.py:71
    }

    void setActiveTracker(ScanProgress t) { ACTIVE_TRACKER = t; }               // src: vvaharness/util/scan_progress.py:77

    ScanProgress getActiveTracker() { return ACTIVE_TRACKER; }                  // src: vvaharness/util/scan_progress.py:82

    boolean isStageOnly() {
        ScanProgress t = getActiveTracker();
        return t != null && t.enabled && t.style == "stage_only";              // src: vvaharness/util/scan_progress.py:88
    }

    ScanProgress init(boolean enabled, String style, String repoName) {
        this.enabled = enabled; this.style = style; this.repoName = repoName;
        try { llmMaxChars = Integer.parse(env("VVAHARNESS_SCAN_PROGRESS_LLM_MAX_CHARS", "12000")); } // llm_debug prompt dump cap // src: vvaharness/util/scan_progress.py:115
        catch (ValueError e) { llmMaxChars = 12000; }                          // src: vvaharness/util/scan_progress.py:119
        start = monotonic();
        return this;
    }

    ScanProgress fromCfg(Config cfg, String repoName, Theta θ) {
        boolean en = θ["scan_progress.enabled"];                               // missing section -> false // src: vvaharness/util/scan_progress.py:135
        if (List.of("1", "true", "yes").contains(env("VVAHARNESS_SCAN_PROGRESS_ENABLED", "").lower())) en = true; // env forces on // src: vvaharness/util/scan_progress.py:137
        String st = θ["scan_progress.style"];                                  // default compact // src: vvaharness/util/scan_progress.py:139
        if (!STYLES.contains(st)) st = "compact";                              // src: vvaharness/util/scan_progress.py:140
        if (st == "live" && !stderrIsATerminal()) st = "compact";              // no cursor escapes into a captured log // src: vvaharness/util/scan_progress.py:142
        return new ScanProgress().init(en, st, repoName);
    }

    void stageStarted(String stageId, String label) {
        if (!enabled) return;                                                  // src: vvaharness/util/scan_progress.py:149
        startLive();
        synchronized (lock) {
            stages.put(stageId, Map.of("state", "started", "start", monotonic(), "label", label)); // src: vvaharness/util/scan_progress.py:153
            if (style == "summary_only") return;
            if (style == "stage_only") emit("[progress] ▶ [" + stageNumber(stageId) + "] " + stageId.upper() + " " + label); // src: vvaharness/util/scan_progress.py:159
            else emit("[progress] stage-start " + stageId + " " + label);       // src: vvaharness/util/scan_progress.py:163
        }
    }

    void stageDone(String stageId, String outcome, String detail) {
        if (!enabled) return;                                                  // src: vvaharness/util/scan_progress.py:168
        synchronized (lock) {
            Map rec = stages.getOrDefault(stageId, Map.of("start", monotonic()));
            double elapsed = max(0.0, monotonic() - rec.get("start"));         // src: vvaharness/util/scan_progress.py:172
            rec.put("state", outcome); rec.put("elapsed", elapsed); stages.put(stageId, rec);
            if (style == "summary_only") return;                               // src: vvaharness/util/scan_progress.py:176
            if (style == "stage_only") { emit("[progress] ✓ [" + stageNumber(stageId) + "] " + stageId.upper() + " (" + elapsed + "s)"); emit(""); return; } // src: vvaharness/util/scan_progress.py:178
            emit("[progress] stage-done  " + stageId + " outcome=" + outcome + "  " + elapsed + "s" + (detail.isEmpty() ? "" : "  " + detail)); // src: vvaharness/util/scan_progress.py:184
        }
    }

    void stageNote(String stageId, String detail) {
        if (!enabled || detail.isEmpty()) return;                              // src: vvaharness/util/scan_progress.py:191
        synchronized (lock) {
            if (List.of("summary_only", "stage_only").contains(style)) return;
            emit("[progress] stage-note  " + stageId + " " + detail);          // src: vvaharness/util/scan_progress.py:196
        }
    }

    void discovered(List<String> allFiles) {
        if (!enabled) return;
        synchronized (lock) {
            totalFiles = allFiles.size();                                      // src: vvaharness/util/scan_progress.py:203
            if (List.of("summary_only", "stage_only").contains(style)) return;
            emit("[progress] discovered  " + allFiles.size() + " files");      // src: vvaharness/util/scan_progress.py:207
        }
    }

    void queued(InvestigationUnit unit) {
        if (!enabled) return;
        String lens = unit.languages.head(3).join("+");                        // first three languages, else generic // src: vvaharness/util/scan_progress.py:215
        if (lens.isEmpty()) lens = "generic";
        UnitProgress cp = new UnitProgress(unit.id, unit.files, unit.riskRank, lens, unit.threat.head(80), "queued", null, 0, monotonic(), 0.0); // src: vvaharness/util/scan_progress.py:216
        synchronized (lock) {
            units.put(unit.id, cp);                                            // src: vvaharness/util/scan_progress.py:224
            if (List.of("summary_only", "stage_only").contains(style)) return;
            emit("[progress] queued      " + unit.id + " (rank=" + cp.rank + ", lens=" + lens + ")"); // src: vvaharness/util/scan_progress.py:228
            if (List.of("verbose", "llm_debug").contains(style)) for (String f : cp.files) emit("           →  " + f); // src: vvaharness/util/scan_progress.py:232
        }
    }

    void scanning(InvestigationUnit unit) {
        if (!enabled) return;
        synchronized (lock) {
            UnitProgress cp = units.get(unit.id);
            if (cp != null) { cp.state = "scanning"; cp.startedAt = monotonic(); } // src: vvaharness/util/scan_progress.py:242
            nScanning += 1;
            if (style == "summary_only") return;                               // src: vvaharness/util/scan_progress.py:248
            emit("[progress] scanning    " + unit.id + "  (" + (nScanned + nScanning) + " / " + units.size() + " units)"); // src: vvaharness/util/scan_progress.py:251
            if (List.of("verbose", "llm_debug").contains(style)) for (String f : unit.files) emit("           ▶  " + f); // src: vvaharness/util/scan_progress.py:256
        }
    }

    void scanned(InvestigationUnit unit, String outcome, int nFindings) {
        if (!enabled) return;
        synchronized (lock) {
            UnitProgress cp = units.get(unit.id);
            boolean first = cp == null || cp.outcome == null;                  // counted once even if called twice // src: vvaharness/util/scan_progress.py:267
            if (cp != null) { cp.state = "scanned"; cp.outcome = outcome; cp.findings = nFindings; cp.elapsed = monotonic() - cp.startedAt; }
            nScanning = max(0, nScanning - 1);                                 // src: vvaharness/util/scan_progress.py:273
            if (first) { nScanned += 1; findings += max(0, nFindings); }       // src: vvaharness/util/scan_progress.py:274
            if (style == "summary_only") return;
            String icon = Map.of("completed", "✓", "error", "✗", "guardrail", "⊘", "uninvestigated", "∅", "failed", "⚠").getOrDefault(outcome, "?"); // src: vvaharness/util/scan_progress.py:280
            emit("[progress] scanned     " + unit.id + "  outcome=" + outcome + (nFindings > 0 ? "  findings=" + nFindings : "") + "  " + icon); // src: vvaharness/util/scan_progress.py:283
            boolean showFiles = List.of("verbose", "llm_debug").contains(style) || (style == "compact" && (nFindings > 0 || outcome != "completed")); // src: vvaharness/util/scan_progress.py:288
            if (showFiles) for (String f : unit.files) emit("           " + icon + "  " + f);
        }
    }

    void printSummary() {
        if (!enabled || style == "stage_only") return;                         // src: vvaharness/util/scan_progress.py:297
        synchronized (lock) {
            int total = units.size();
            Map<String, Integer> outcomes = Map.of(); Set<String> scannedFiles = Set.of();
            for (UnitProgress cp : units.values()) {                           // src: vvaharness/util/scan_progress.py:303
                outcomes.inc(cp.outcome != null ? cp.outcome : "pending");
                if (cp.state == "scanned") scannedFiles.addAll(cp.files);
            }
            int remaining = total - nScanned;                                  // src: vvaharness/util/scan_progress.py:308
            Double s4Start = stages.getOrDefault("s4", Map.of()).get("start");
            double elapsed = s4Start != null ? max(0.0, monotonic() - s4Start) : 0.0; // s4's own elapsed // src: vvaharness/util/scan_progress.py:311
            emit("[progress] summary     " + nScanned + " / " + total + " units done  |  scanned=" + scannedFiles.size() + " files  elapsed=" + elapsed + "s"); // src: vvaharness/util/scan_progress.py:316
            if (!outcomes.isEmpty()) emit("           outcomes:  " + sorted(outcomes).join("  ")); // src: vvaharness/util/scan_progress.py:320
            if (remaining > 0) emit("           WARNING: " + remaining + " unit(s) not scanned (see error log)"); // src: vvaharness/util/scan_progress.py:322
            if (total > 1)                                                     // per-unit lines when more than one ran // src: vvaharness/util/scan_progress.py:328
                for (UnitProgress cp : sortedBy(units.values(), c -> c.unitId)) {
                    if (cp.state != "scanned") continue;
                    emit("           unit=" + cp.unitId + "  outcome=" + cp.outcome + "  " + cp.elapsed + "s"); // src: vvaharness/util/scan_progress.py:333
                }
        }
    }

    void llmPayload(String phase, String backend, String modelId, String tag, String userPrompt, String systemPrompt) {
        if (!enabled || style != "llm_debug") return;                          // src: vvaharness/util/scan_progress.py:342
        synchronized (lock) {
            emit("[progress] llm-call    phase=" + phase + " backend=" + backend + " model=" + modelId); // src: vvaharness/util/scan_progress.py:346
            if (!systemPrompt.isEmpty()) emitPromptBlock("system", systemPrompt); // src: vvaharness/util/scan_progress.py:350
            emitPromptBlock("user", userPrompt);
        }
    }

    void emitPromptBlock(String label, String text) {
        String payload = text != null ? text : "";
        try { payload = Redact.redact(payload); } catch (Exception e) { }      // must never fail a scan // src: vvaharness/util/scan_progress.py:359
        String shown = payload.head(llmMaxChars);                              // src: vvaharness/util/scan_progress.py:364
        emit("[progress] llm-" + label + "-prompt chars=" + payload.length() + " shown=" + shown.length());
        for (String ln : shown.splitlines()) emit("           | " + ln);       // src: vvaharness/util/scan_progress.py:369
        if (payload.length() > shown.length()) emit("           | ... truncated " + (payload.length() - shown.length()) + " chars"); // src: vvaharness/util/scan_progress.py:371
        emit("[progress] llm-" + label + "-end");
    }

    String stageNumber(String stageId) {
        int index = STAGE_ORDER.indexOf(stageId);                              // src: vvaharness/util/scan_progress.py:382
        if (index < 0) return "?/" + STAGE_ORDER.size();
        return (index + 1) + "/" + STAGE_ORDER.size();                         // src: vvaharness/util/scan_progress.py:385
    }

    void emit(String line) {
        if (live != null) return;                                              // live display owns the terminal // src: vvaharness/util/scan_progress.py:389
        Console.write(line);                                                   // src: vvaharness/util/scan_progress.py:391
    }

    void startLive() {
        if (live != null || style != "live" || !enabled) return;               // src: vvaharness/util/scan_progress.py:395
        if (!stderrIsATerminal()) { style = "compact"; return; }               // src: vvaharness/util/scan_progress.py:397
        try { live = new RichLive(this::render, LIVE_REFRESH_HZ); live.start(); } // src: vvaharness/util/scan_progress.py:403
        catch (ImportError | OSError | ValueError e) { style = "compact"; return; } // degrade to compact // src: vvaharness/util/scan_progress.py:406
        atexit(this::stopLive);                                                // src: vvaharness/util/scan_progress.py:410
    }

    void stopLive() {
        Object l = live; live = null;
        if (l == null) return;                                                 // src: vvaharness/util/scan_progress.py:415
        try { l.stop(); } catch (OSError e) { style = "compact"; }             // src: vvaharness/util/scan_progress.py:418
    }

    Object render() {
        try { return stageTable(); } catch (Exception e) { return ""; }        // never raise into the refresh thread // src: vvaharness/util/scan_progress.py:425
    }

    Object stageTable() {
        Table table = new Table(List.of("", "stage", "what", "status", "time")); // src: vvaharness/util/scan_progress.py:436
        Map snap; synchronized (lock) { snap = copy(stages); }                 // src: vvaharness/util/scan_progress.py:439
        for (int i = 0; i < STAGE_ORDER.size(); i++) {                         // src: vvaharness/util/scan_progress.py:443
            Map record = snap.get(STAGE_ORDER[i]);
            String state = record != null ? record.get("state") : "";
            if (state == "started") table.addRow(i, STAGE_ORDER[i], record.label, SPINNER, clock(monotonic() - record.get("start"))); // src: vvaharness/util/scan_progress.py:447
            else if (record != null) table.addRow(i, STAGE_ORDER[i], record.label, outcomeGlyph(state), clock(record.get("elapsed"))); // src: vvaharness/util/scan_progress.py:450
            else table.addRow(i, STAGE_ORDER[i], stageLabel(STAGE_ORDER[i]), "·", "");
        }
        String header = repoName + "   " + clock(monotonic() - start) + " elapsed" + (units.isEmpty() ? "" : "   units " + nScanned + "/" + units.size()) + (findings > 0 ? "   findings " + findings : ""); // src: vvaharness/util/scan_progress.py:458
        return group(header, table);
    }
}
