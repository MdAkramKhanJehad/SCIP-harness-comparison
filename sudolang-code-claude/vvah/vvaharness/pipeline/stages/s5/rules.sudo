CONTROL_ABSENCE_CWES = ["CWE-352", "CWE-1004", "CWE-614", "CWE-307", "CWE-778", "CWE-311", "CWE-312", "CWE-532", "CWE-209"]

// src: vvaharness/pipeline/stages/s5/rules.py:38-50
SECRET_TEXT_RX = case-insensitive word match on: hard-coded / hardcoded, password, passwd, api_key, access_key, secret_key, auth_token, bearer token, jwt, private_key, client_secret, credential;
  or "-----BEGIN ... PRIVATE KEY-----", or an AWS key id /\bAKIA[0-9A-Z]{16}\b/, or a GitHub token /\bgh[pousr]_[0-9A-Za-z]{36,}\b/, or a Slack token /\bxox[baprs]-[0-9A-Za-z-]{10,}\b/
  // abstracted: the separators [\s-]? / [_-]? between word parts are as in the source lines 40-44

// src: vvaharness/pipeline/stages/s5/rules.py:53-60
fn is_secret_class(f):executor=code {
  if (f.vuln_class == VulnClass.INFO_LEAK) return true
  if (f.cwe && (f.cwe in HARDCODED_CWES || f.cwe in CONTROL_ABSENCE_CWES)) return true
  return SECRET_TEXT_RX matches (title + " " + description + " " + code_snippet)
  // preserved: control-absence CWEs (for example CSRF, missing HttpOnly) also bypass the test-path exclusion, although the docstring describes "point-of-occurrence"
}
