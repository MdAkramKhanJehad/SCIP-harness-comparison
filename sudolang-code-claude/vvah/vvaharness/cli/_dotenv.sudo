# vvaharness/cli/_dotenv.py

Selection and loading of a trusted `.env` file from exactly the working directory or the home directory. A file with unsafe ownership or permissions, or one inside the scan target, is rejected.

Source: `vvaharness/cli/_dotenv.py` (lines 1-102)
Executor: code
Called from: `vvaharness/cli/__init__.py` main (`_load_dotenv`)

// src: vvaharness/cli/_dotenv.py:91-102
fn _load_dotenv(repo?):executor=code {
  if (python-dotenv is not installed) return
  path = _dotenv_path(repo, warn=true)
  if (path == null) return
  load path with override=false   // variables already in the environment win
}

// src: vvaharness/cli/_dotenv.py:46-89
fn _dotenv_selection(repo?, warn=false):executor=code {
  for each [source, root] in [["cwd", resolved working directory], ["home", resolved home directory]] (each root once) {
    candidate = "$root/.env"; if (not a file) continue
    path = candidate resolved strictly
    if (path's parent != root || !_dotenv_path_is_trusted(path)) { rejected += candidate; if (warn) warn DOTENV_UNTRUSTED; continue }   // a symlink pointing elsewhere is rejected
    if (repo && environment VVAHARNESS_ALLOW_CWD_CONFIG is not set && config_paths._path_within(path, repo)) {
      rejected += candidate; if (warn) warn DOTENV_INSIDE_TARGET; continue   // a .env inside the scan target is attacker-influenced
    }
    return [path, source, rejected]   // first accepted wins: the working directory before home
  }
  return [null, null, rejected]
}

// src: vvaharness/cli/_dotenv.py:29-44
fn _dotenv_path_is_trusted(path):executor=code {
  if (stat of path or its directory fails) return false
  if (no effective user id is available, for example Windows) return true
  return both path and its directory are owned by the effective user && neither is group- or other-writable
}
