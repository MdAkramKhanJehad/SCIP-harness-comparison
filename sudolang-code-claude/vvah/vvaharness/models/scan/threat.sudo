// src: vvaharness/models/scan/threat.py:209-213
_IMPACT_RANK = { existential: 5, critical: 4, high: 3, medium: 2, low: 1 }
_LIKELIHOOD_RANK = { almost_certain: 5, likely: 4, possible: 3, rare: 2, very_rare: 1 }
_SENSITIVITY_RANK = { critical: 4, high: 3, medium: 2, low: 1 }
_ACTOR_RANK = { remote_unauth: 6, remote_auth: 5, adjacent_network: 4, local_admin: 3, local_user: 2, supply_chain: 1, insider: 1 }

// src: vvaharness/models/scan/threat.py:216-240
fn _sensitivity_of(t, tm):executor=code {
  asset = first of tm.assets whose name (stripped, lowercased) equals t.asset (stripped, lowercased)
  return if (asset) _SENSITIVITY_RANK[asset.sensitivity] || 0 else 0
}
fn _rank_key(t, tm):executor=code {
  // ascending sort key = most severe first; total and deterministic
  // no "evidence is non-empty" term: baseline threats carry evidence too, so it would boost them
  return [ -_IMPACT_RANK[t.impact], -_sensitivity_of(t, tm), -_LIKELIHOOD_RANK[t.likelihood], -_ACTOR_RANK[t.actor],
           if (t.controls is empty || t.controls == "none") 0 else 1,   // uncontrolled threats first
           _id_ordinal(t.id), t.id ]
}
fn _id_ordinal(threat_id):executor=code {
  try return integer(threat_id without its first character);   // "T7" => 7
  catch => return 1000000
}

// src: vvaharness/models/scan/threat.py:243-275
fn _covered_boundaries(threats, pool, boundaries):executor=code {
  // positions, not ids: models reuse one id across threats
  return { b.entry_point for each b where some position i in pool has casefold(strip(threats[i].surface)) == casefold(strip(b.entry_point)) }
}
fn _next_covering_candidate(threats, kept, evicted_idx, boundary):executor=code {
  return first i in evicted_idx (rank order) with i not in kept and threats[i].surface matching boundary (stripped, casefolded); else null
}
fn _best_evictable(threats, kept, kept_order, boundaries):executor=code {
  current = _covered_boundaries(threats, kept, boundaries)
  for each i in reverse(kept_order) {   // worst-ranked survivor first
    if (length(_covered_boundaries(threats, kept - {i}, boundaries)) >= length(current)) return i
  }
  return null
}

// src: vvaharness/models/scan/threat.py:278-303
fn _promote_for_coverage(threats, kept, evicted_idx, boundaries):executor=code {
  uncovered = { all boundary entry_point names } - _covered_boundaries(threats, kept, boundaries)
  kept_order = sorted(kept); promoted = 0; progressed = true
  while (uncovered is not empty && progressed) {
    progressed = false
    for each boundary in copy of uncovered {
      candidate = _next_covering_candidate(threats, kept, evicted_idx, boundary)
      if (candidate == null) continue
      evict_at = _best_evictable(threats, kept, kept_order, boundaries)
      if (evict_at == null) continue
      swap evict_at out of kept and kept_order, add candidate to both
      promoted += 1; remove boundary from uncovered; progressed = true
    }
  }
  return [kept, promoted]
}

// src: vvaharness/models/scan/threat.py:306-330
fn _cap_threats(tm, max_threats):executor=code {
  threats = sort tm.threats by _rank_key   // permutes only; ids never rewritten; no deduplication (a similarity pass lost coverage)
  COUNTERS.bump("s2_threats_raw", length(threats))
  if (length(threats) <= max_threats) return tm with threats
  kept = positions 0..min(max_threats, length)-1   // addressed by POSITION, never id (repeated ids would cut a cap of twenty to one)
  evicted_idx = remaining positions, best first
  [kept, promoted] = _promote_for_coverage(threats, kept, evicted_idx, tm.trust_boundaries)
  COUNTERS.bump("s2_threats_truncated", length(evicted_idx)); COUNTERS.bump("s2_threats_promoted", promoted)
  evicted = ids (or "T<position+1>") of positions not in kept   // read off kept: promotion made evicted_idx stale
  if (evicted) COUNTERS.note("s2_threats_evicted_ids", join(evicted, ","))
  return tm with threats = threats at sorted(kept)
}

// src: vvaharness/models/scan/threat.py:333-346
fn _cap_assets(tm, max_assets):executor=code {
  if (length(tm.assets) <= max_assets) return tm   // unchanged order
  return tm with assets = first max_assets of (assets sorted by [-_SENSITIVITY_RANK[sensitivity], name])
}
fn _cap_boundaries(tm, max_boundaries):executor=code {
  if (length(tm.trust_boundaries) <= max_boundaries) return tm
  return tm with trust_boundaries = first max_boundaries of (trust_boundaries sorted by [-length(reachable_assets), entry_point])
}
