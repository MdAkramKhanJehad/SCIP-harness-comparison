# vvaharness/remediation_agent/report_augment/summary.py

The report-level `## Remediation Summary` section with its counts and success rate.

Source: `vvaharness/remediation_agent/report_augment/summary.py` (lines 1-48)
Executor: code
Called from: `report_augment/markdown.sudo` _augment_md

// src: vvaharness/remediation_agent/report_augment/summary.py:21-30
fn _summary_counts(records):executor=code {
  return { true_positive: length(records) - count(false_positive), in_scope: length(records), remediated: count(bucket == REMEDIATED) }
}

// src: vvaharness/remediation_agent/report_augment/summary.py:33-48
fn _md_summary_section(records):executor=code {
  c = _summary_counts(records)
  rate = if (c.true_positive > 0) "${round(c.remediated / c.true_positive * 100)}%" else "n/a"   // divided by true positives, as the label says
  return "## Remediation Summary\n- Total findings (true positive): <true_positive>\n- Findings in scope for remediation: <in_scope>\n- Remediated: <remediated>\n- Success Rate(remediated/true positive): <rate>\n"
  // preserved: the counts are over the case files present, not over the report's findings; findings never processed (no case file) are not counted, and "true positive" means only "not marked false positive by the remediation model"
}
