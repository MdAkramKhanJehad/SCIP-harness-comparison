            if (!gates.isEmpty()) out.add(Map.of("tracking_id", id, "gates", gates.map(g -> g.modelDump()))); // src: vvaharness/validation/session/launcher.py:256
        }
        return out; // src: vvaharness/validation/session/launcher.py:261
    }
