// file: vvaharness/util/errlog.py
// Structured error log shared across pipeline stages; one redacted JSON line per record.
// The orchestrator calls configure() once per scan; readers tally records per stage for reports/telemetry.

@executedBy(CODE) @role(io)
class Errlog {

    Path path = Path.of("pipeline-errors.jsonl");                              // default lands in cwd // src: vvaharness/util/errlog.py:33
    Lock lock;
    static final String LOGGED_ATTR = "_vvah_errlog_recorded";                 // stamp suppressing a duplicate outer record // src: vvaharness/util/errlog.py:37

    void configure(Path p) {
        path = p;                                                              // src: vvaharness/util/errlog.py:42
        p.parent.mkdirs();                                                     // src: vvaharness/util/errlog.py:43
    }

    Path currentPath() {
        return path;                                                           // src: vvaharness/util/errlog.py:48
    }

    Map<String, Integer> countsByStage(Path p, boolean includeRecovered) {
        // best effort, never raises, no lock
        Map<String, Integer> counts = Map.of();
        try {
            for (String ln : readLines(p != null ? p : path)) {                // src: vvaharness/util/errlog.py:59
                if (ln.strip().isEmpty()) continue;
                Record rec;
                try { rec = Json.parse(ln); } catch (JsonDecodeError e) { continue; } // src: vvaharness/util/errlog.py:65
                if (!includeRecovered && rec.recovered == true) continue;      // src: vvaharness/util/errlog.py:67
                if (rec.stage instanceof String) counts.inc(rec.stage);        // src: vvaharness/util/errlog.py:70
            }
        } catch (OSError e) { return counts; }                                 // src: vvaharness/util/errlog.py:72
        return counts;
    }

    boolean labelMatches(String label, String stageId) {
        // boundary-aware: "s1" claims "s1.autoexclude" but never "s10"
        return label == stageId || (label.startsWith(stageId) && !isAlnum(label.charAt(stageId.length()))); // src: vvaharness/util/errlog.py:84
    }

    int countForStage(String stageId, Path p, boolean includeRecovered) {
        int total = 0;
        for (Entry<String, Integer> e : countsByStage(p, includeRecovered))    // src: vvaharness/util/errlog.py:82
            if (labelMatches(e.key, stageId)) total += e.value;                // src: vvaharness/util/errlog.py:84
        return total;
    }

    String lastMessageForStage(String stageId, Path p) {
        String last = null;
        try {
            for (String ln : readLines(p != null ? p : path)) {                // src: vvaharness/util/errlog.py:97
                if (ln.strip().isEmpty()) continue;
                Record rec;
                try { rec = Json.parse(ln); } catch (JsonDecodeError e) { continue; }
                if (rec.recovered == true) continue;                           // unrecovered only // src: vvaharness/util/errlog.py:105
                if (!(rec.stage instanceof String)) continue;
                if (labelMatches(rec.stage, stageId) && rec.error instanceof String) last = rec.error; // src: vvaharness/util/errlog.py:110
            }
        } catch (OSError e) { return null; }                                   // src: vvaharness/util/errlog.py:115
        return last;
    }

    boolean alreadyLogged(Throwable error) {
        for (Throwable err : Exceptions.exceptionChain(error))                 // src: vvaharness/util/errlog.py:123
            if (getattr(err, LOGGED_ATTR, false)) return true;                 // src: vvaharness/util/errlog.py:124
        return false;
    }

    String providerExcerpt(Throwable error) {
        for (Throwable err : Exceptions.exceptionChain(error)) {               // src: vvaharness/util/errlog.py:132
            Object stderr = getattr(err, "stderr", null);
            if (stderr instanceof String && !stderr.strip().isEmpty()) return Redact.redact(stderr).tail(2000); // log excerpt cap (record text only) // src: vvaharness/util/errlog.py:135
        }
        return null;
    }

    void log(String stage, String unit, Object error, boolean recovered, Map<String, Object> extra) {
        String msg; String tb;
        if (error instanceof Throwable) {                                      // src: vvaharness/util/errlog.py:142
            msg = typeName(error) + ": " + error;
            String code = Exceptions.exceptionChain(error).map(l -> getattr(l, "error_code", null)).firstString(); // src: vvaharness/util/errlog.py:145
            if (code != null && !extra.has("error_code")) extra.put("error_code", code); // src: vvaharness/util/errlog.py:150
            String category = Exceptions.exceptionChain(error).map(l -> getattr(l, "category", null)).firstString(); // ModelRefusal.category // src: vvaharness/util/errlog.py:153
            if (category != null && !extra.has("category")) extra.put("category", category); // src: vvaharness/util/errlog.py:156
            if (!extra.has("stderr")) {
                String excerpt = providerExcerpt(error);                       // src: vvaharness/util/errlog.py:159
                if (excerpt != null) extra.put("stderr", excerpt);
            }
            tb = Redact.redact(formatTraceback(error)).tail(4000);             // redact BEFORE slicing // src: vvaharness/util/errlog.py:163
        } else {
            msg = str(error); tb = null;                                       // src: vvaharness/util/errlog.py:166
        }
        msg = Redact.redact(msg);                                              // src: vvaharness/util/errlog.py:168
        Map<String, Object> safeExtra = extra.mapValues(v -> v instanceof String ? Redact.redact(v) : v); // src: vvaharness/util/errlog.py:169
        Record rec = new Record(nowUtc(), stage, unit instanceof String ? Redact.redact(unit) : unit, msg, safeExtra); // unit is repo-derived // src: vvaharness/util/errlog.py:171
        if (recovered) rec.recovered = true;                                   // src: vvaharness/util/errlog.py:179
        if (tb != null) rec.traceback = tb;                                    // src: vvaharness/util/errlog.py:182
        try {
            synchronized (lock) { appendLine(path, Json.dump(rec), 0600); }    // src: vvaharness/util/errlog.py:186
        } catch (Exception e) {
            Logs.getLogger("errlog").warning(Events.ERRLOG_WRITE_FAILED, stage, unit, str(e)); // never raises // src: vvaharness/util/errlog.py:190
            return;
        }
        if (error instanceof Throwable && !recovered) {
            try { setattr(error, LOGGED_ATTR, true); } catch (AttributeError e) { } // stamp after a successful write // src: vvaharness/util/errlog.py:196
        }
    }
}
