// ScanMetrics: coverage, verification and token/cost stats plus the snapshot of every stage counter the report renders;
// ScopeEntry: one analysis unit (chunk) in the scope appendix. All counters default 0 so old payloads validate.

@executedBy(CODE) @role(types)
record ScopeEntry(String name, String kind, List<String> files) {
    // kind in risk | catchall | specialist | taint | threat | other                                // src: vvaharness/models/scan/metrics.py:28
}

@executedBy(CODE) @role(types)
record ScanMetrics(String scanId, String moduleName, String startTs, String endTs, double durationSec,
                   int totalFilesInScope, int analyzedFilesUnique, int chunksTotal, int chunksRisk, int chunksCatchall,
                   int chunksSpecialist, int chunksAttempted, int chunksFailed, boolean deepdiveSkipped,
                   Map<String, Integer> errorsByStage, String errorsLogPath, Map<String, Integer> locInScopeByLanguage,
                   Map<String, Integer> locScannedByLanguage, int rawFindingsCount, int truePositiveCount,
                   int falsePositiveCount, int duplicateCount, int discoveredTruePositiveCount,
                   int repeatCloneTruePositiveCount, int evRescuedCount, Integer promptTokens, Integer completionTokens,
                   Integer totalTokens, Map tokensByPhase, Double reportedCostUsd, Double pricedCostUsd,
                   List<String> foldersScanned, List<ScopeEntry> scope, Map excluded, Map<String, Integer> chunksByKind,
                   CounterSnapshot counters) {
    // tokens null renders "unavailable"; cost null, never 0 (reported = backend billing, priced = tokens x list)  // src: vvaharness/models/scan/metrics.py:63
    // counters (flattened in the real model), grouped:                                            // src: vvaharness/models/scan/metrics.py:74
    //   S2: s2_degraded, s2_threats_raw/truncated/promoted, s2_frontier_*_excluded, s2_assets/trust_boundaries_truncated,
    //       s2_prompt_*_truncated, s2_inventory_files_truncated, s2_baseline_undisposed(_recovered), s2_repo_kinds,
    //       s2_surface_files_dropped, s2_evidence_gate_rejected(_relented)                        // src: vvaharness/models/scan/metrics.py:75
    //   S3: s3_unknown_file_ids, s3_dropped_paths, s3_relocated_paths, s3_unreachable_files, s3_threats_without_unit // src: vvaharness/models/scan/metrics.py:99
    //   S4: s4_findings_truncated, s4_finding_extra_cwe_collapsed, s4_unit_key_deduped, s4_unit_no_outcome,
    //       s4_batch_member_uninvestigated/failed/resubmitted/recovered, s4_evidence_gate_rejected(_relented) // src: vvaharness/models/scan/metrics.py:106
    //   routes: deepagents_oversize_prompts (E004), deepagents_tool_state_not_roundtripped (E006), deepagents_path_jail_refused,
    //       llm_truncated_replies (E005), llm_truncated_below_budget, llm_adapter/cli_mcp_evidence_gate_unenforced,
    //       evidence_gate_stood_down_degenerate_graph, llm_turn_cap_exhausted, llm_model_refusals, llm_refusal_retry_*,
    //       llm_truncated_retry_*                                                                 // src: vvaharness/models/scan/metrics.py:123
    //   S6: s6_evidence_gate_*, s6_confirmed_without_vector, s6_cvss_zero_impact_on_tp, s6_confidence_clamped,
    //       s6_confidence_uniform, s6_finding_line_correction_reverted_reanchor, s6_batch_*_split, s6_*_retry_*,
    //       s6_replayed_fp_held, s6_fp_premise_contradicted, s6_replayed_tp_shipped, s6_outcome_members_*  // src: vvaharness/models/scan/metrics.py:138
    //   orphans: s2/s4/s6/s8_orphan_settled; structured: llm_structured_submit_rejected, llm_structured_prose_reask // src: vvaharness/models/scan/metrics.py:182
    //   retries: s1..s8 / ev_classify structured/truncated retry attempted/recovered, llm_structured_retry_truncated,
    //       s2_empty_retry_*, s2_parse_repair_*, s4/s6 outcome/batch repaired; llm_call_timeouts (E008), llm_call_budget_near // src: vvaharness/models/scan/metrics.py:200

    double coveragePct() {
        if (totalFilesInScope == 0) return 0.0;                                                     // src: vvaharness/models/scan/metrics.py:245
        return analyzedFilesUnique * 100.0 / totalFilesInScope;                                     // src: vvaharness/models/scan/metrics.py:247
    }
}

