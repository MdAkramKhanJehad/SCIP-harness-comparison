# vvaharness/validation/models/output.py

The structured output schema the orchestrator must return (`ValidationOutput`), the persisted report shape (`ValidationReport`, redacted on parse), and an adapter from the retired agent verdict labels to the shared decision vocabulary.

Source: `vvaharness/validation/models/output.py` (lines 1-252)
Executor: code (schema the backend validates the model's response against)
Called from: `vvaharness/validation/session/launcher.sudo` (response_model), `vvaharness/validation/io/*`

// src: vvaharness/validation/models/output.py:56-75
// "The retired verdict vocabulary; values (not keys) are load-bearing as schema defaults below."
FIX_STATUS_LABELS = { "Fixed": FIXED, "Partially Fixed": PARTIALLY_FIXED, "Not Fixed": NOT_FIXED, "UNVERIFIABLE": INCONCLUSIVE }
_MERGE_READINESS_NOT_READY = "Not Ready"   // "readiness itself is a host policy call, never read back"
_CSV_MAX_CHARS = 4096; _TRUNCATION_MARKER = "...[truncated]"

// src: vvaharness/validation/models/output.py:78-89
GateEntry {
  gate_name: String
  status: "pass" | "partial" | "fail" | "skip"   // "skip is legal: narrowing forces the model to invent pass/fail for gates nobody assessed"
  summary: String = ""
  evidence: [EvidenceAnchor] = []
  details: String = ""
  // extra keys ignored
}

// src: vvaharness/validation/models/output.py:92-98
SynthesizedGatesEntry { tracking_id: String; gates: [GateEntry] }

// src: vvaharness/validation/models/output.py:101-156
OutputFinding {
  tracking_id: String
  finding_title: String
  finding_description: String
  affected_files: String
  severity: String = "Medium"
  fix_status: String = "UNVERIFIABLE"
  raw_score: Number = 0.0   // 0.0..1.0
  justification: String = ""
  merge_readiness: String = "Not Ready"
  gate_scores: {} = {}
  conditions_for_full_fix: [String] = []
  recommendations: [String] = []
  files_needing_fixes: String = ""

  // src: vvaharness/validation/models/output.py:120-138 — field validator run by the code while parsing the model's response
  fn _coerce_csv(v):executor=code {   // for affected_files and files_needing_fixes
    if (v is a list) v = join(items as strings, ",")   // "Schema hint says CSV, but gpt-5.5 (and peers) often emit a JSON list; join it here."
    if (v is not a string) return v
    safe = redact(v)   // redaction happens before truncation; external: vvaharness/report/redact.py
    if (length(safe) <= _CSV_MAX_CHARS) return safe
    warn "validation output field <name> exceeded 4096 characters; truncating"
    return first (4096 - length("...[truncated]")) characters of safe + "...[truncated]"
  }

  // src: vvaharness/validation/models/output.py:140-156
  fn _clamp_raw_score(v):executor=code {
    if (v is a boolean || v is not a number) return v   // left to schema validation (0.0..1.0)
    clamped = min(1.0, max(0.0, v))   // "Clamp an out-of-range score instead of rejecting; raising drops it from the report."
    if (clamped != v) warn "validation output raw_score=<v> is outside [0.0, 1.0]; clamped to <clamped>"   // logs only the number
    return clamped
  }
}

// src: vvaharness/validation/models/output.py:159-170
ValidationOutput {
  target_jira_status: String
  findings: [OutputFinding]
  synthesized_gates: [SynthesizedGatesEntry]
  // "The host (not the agent) writes validation_report.json and synthesized_gates.json from this payload."
}

// src: vvaharness/validation/models/output.py:183-212
ValidationReport {
  findings: [OutputFinding] = []
  // src: vvaharness/validation/models/output.py:173-198 — model validator run by the code after parsing
  fn _redact_narrative():executor=code {
    for each finding in findings {
      redact finding_description, affected_files, files_needing_fixes, justification   // tracking_id and finding_title are excluded "to protect headings"
      redact every item of conditions_for_full_fix and recommendations
    }
    // external: vvaharness/report/redact.py
  }
  fn from_file(path) {
    require text of path parses as JSON => throw ValueError("malformed JSON in validation report <path>: ...")
  }
}

// src: vvaharness/validation/models/output.py:215-252
fn decision_for(fix_status):executor=code = matching label in FIX_STATUS_LABELS after trimming and casefolding, else INCONCLUSIVE
fn to_verdict(output_finding, synthesized_gates?, provenance):executor=code {
  decision = decision_for(output_finding.fix_status)
  return Verdict { decision, rationale: output_finding.justification, score: if (decision == INCONCLUSIVE) null else output_finding.raw_score, gates, conditions, recommendations, produced_by: provenance }
}
// preserved: to_verdict trusts the agent's fix_status and raw_score; it is exported but no module in this batch calls it. The live path uses io/_host_score.sudo verdict_for, which ignores both.
