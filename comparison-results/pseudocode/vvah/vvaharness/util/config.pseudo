// file: vvaharness/util/config.py
// One fail-safe reader for a dotted config knob, shared by every stage.
// Missing config, missing key and explicit null all read as the caller's default.

@executedBy(CODE) @role(config)
class UtilConfig {

    Object knob(Config cfg, String path, Object dflt) {
        Object node = cfg;                                                     // src: vvaharness/util/config.py:22
        for (String part : path.split(".")) {                                 // src: vvaharness/util/config.py:23
            node = getattr(node, part, null);                                  // src: vvaharness/util/config.py:24
            if (node == null) return dflt;                                     // silent fallback by design // src: vvaharness/util/config.py:25
        }
        return node;                                                           // src: vvaharness/util/config.py:27
    }
}
