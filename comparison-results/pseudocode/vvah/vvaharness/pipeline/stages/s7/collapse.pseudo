// file: vvaharness/pipeline/stages/s7/collapse.py
// The deterministic half of step 7: collapse same-site duplicates with no model call,
// and attach collapsed members onto their canonical as extra call sites.

@executedBy(CODE) @role(rule_set) @stage("S7")
class S7Collapse {

    // TRIVIAL_REASON = "trivial: same site, shared weakness within line tolerance"
    // STRICT_CWE_CLASS = { LOGIC }; CATCH_ALL_VULN_CLASS = { OTHER, LOGIC }
    // MIN_TITLE_OVERLAP = 0.15 (code constant): below it a pair is not TRIVIALLY one weakness.

    Set<String> titleTokens(String title) {
        return Regex.findAll("[a-z0-9]+", title.lower()).filter(w -> w.length() > 2 && !STOPWORDS.contains(w)); // src: vvaharness/pipeline/stages/s7/collapse.py:43
    }

    double titleOverlap(Finding a, Finding b) {
        Set ta = titleTokens(a.title); Set tb = titleTokens(b.title);
        if (ta.isEmpty() || tb.isEmpty()) return 1.0;                                           // src: vvaharness/pipeline/stages/s7/collapse.py:50
        return ta.intersect(tb).size() / ta.union(tb).size();                                   // src: vvaharness/pipeline/stages/s7/collapse.py:52
    }

    boolean cweConflict(Finding a, Finding b) {
        // A semantic collapse across CWEs merges distinct defects.
        if (a.cwe == null || b.cwe == null) return false;                                       // src: vvaharness/pipeline/stages/s7/collapse.py:58
        String ka = RulesCwe.weaknessKey(a.cwe); String kb = RulesCwe.weaknessKey(b.cwe);
        return ka == null || ka != kb;                                                          // src: vvaharness/pipeline/stages/s7/collapse.py:62
    }

    List<DupLocation> dedupLocations(List<DupLocation> locs) {
        return locs.distinctBy(d -> Triple.of(d.file, d.lineStart, d.lineEnd));                 // src: vvaharness/pipeline/stages/s7/collapse.py:85
    }

    void inheritMainChannel(Finding dup, Finding canonical) {
        if (dup.channel == "main" && canonical.channel != "main") canonical.channel = "main";   // src: vvaharness/pipeline/stages/s7/collapse.py:95
    }

    void inheritClusterCwe(Finding dup, Finding canonical) {
        String key = RulesCwe.weaknessKey(canonical.cwe);
        if (key != null && key == Cwe.norm(dup.cwe) && key != Cwe.norm(canonical.cwe)) canonical.cwe = key; // src: vvaharness/pipeline/stages/s7/collapse.py:104
    }

    void inheritVulnClass(Finding dup, Finding canonical) {
        if (CATCH_ALL.contains(canonical.vulnClass) && !CATCH_ALL.contains(dup.vulnClass)) canonical.vulnClass = dup.vulnClass; // src: vvaharness/pipeline/stages/s7/collapse.py:112
    }

    void attachDuplicates(List<Finding> findings, Map<Integer, Integer> canonicalOf, Map<Integer, String> reasoning, Set<Integer> keepSameSite) {
        Set<Integer> roots = new Set();
        for (Entry e : canonicalOf.entries()) {                                                 // src: vvaharness/pipeline/stages/s7/collapse.py:128
            int r = rootOf(canonicalOf, e.value);
            roots.add(r);
            Finding dj = findings[e.key]; Finding rf = findings[r];
            inheritMainChannel(dj, rf);                                                         // src: vvaharness/pipeline/stages/s7/collapse.py:132
            inheritClusterCwe(dj, rf);
            inheritVulnClass(dj, rf);
            boolean sameSite = dj.file == rf.file && dj.lineStart <= rf.lineEnd && rf.lineStart <= dj.lineEnd; // src: vvaharness/pipeline/stages/s7/collapse.py:135
            if (!sameSite) {
                rf.duplicates.add(dupLocation(dj, reasoning.getOrDefault(e.key, "duplicate"))); // src: vvaharness/pipeline/stages/s7/collapse.py:139
            } else if (keepSameSite != null) {
                // keep_same_site was ruled "independent sites": each sink line is its own operation.
                if (keepSameSite.contains(e.key) && dj.lineStart != rf.lineStart) {             // src: vvaharness/pipeline/stages/s7/collapse.py:144
                    rf.duplicates.add(dupLocation(dj, reasoning.getOrDefault(e.key, "duplicate")));
                    Counters.bump("s7_dedup_same_site_kept");
                } else {
                    Counters.bump("s7_dedup_same_site_discarded");                              // src: vvaharness/pipeline/stages/s7/collapse.py:150
                }
            }
            if (!dj.duplicates.isEmpty()) { rf.duplicates.addAll(dj.duplicates); dj.duplicates = List.of(); } // src: vvaharness/pipeline/stages/s7/collapse.py:151
        }
        for (int r : roots) findings[r].duplicates = dedupLocations(findings[r].duplicates);   // src: vvaharness/pipeline/stages/s7/collapse.py:155
    }

    Map<Integer, Integer> collapseTrivial(List<Finding> findings, int lineTol, List<Integer> groupLines) {
        // groupLines holds pre-re-anchor anchors; spans are shifted onto the group line.
        Map<Integer, Integer> canonicalOf = new Map();
        for (int j : range(findings.size())) {                                                  // src: vvaharness/pipeline/stages/s7/collapse.py:178
            if (canonicalOf.containsKey(j)) continue;
            Finding b = findings[j];
            for (int i : range(j)) {                                                            // src: vvaharness/pipeline/stages/s7/collapse.py:182
                if (canonicalOf.containsKey(i)) continue;
                Finding a = findings[i];
                if (a.file != b.file) continue;                                                 // src: vvaharness/pipeline/stages/s7/collapse.py:186
                boolean crossClass = a.vulnClass != b.vulnClass;
                boolean sharedWeakness = a.cwe != null && b.cwe != null && RulesCwe.weaknessKey(a.cwe) != null
                    && RulesCwe.weaknessKey(a.cwe) == RulesCwe.weaknessKey(b.cwe) && !Cwe.GENERIC_PARENTS.contains(RulesCwe.weaknessKey(a.cwe)); // src: vvaharness/pipeline/stages/s7/collapse.py:192
                // A class mismatch merges only across one shared, non-generic weakness.
                if (crossClass && !sharedWeakness) continue;                                    // src: vvaharness/pipeline/stages/s7/collapse.py:195
                if (a.cwe != null && b.cwe != null) {
                    if (cweConflict(a, b)) continue;                                            // src: vvaharness/pipeline/stages/s7/collapse.py:199
                } else if (STRICT_CWE_CLASS.contains(a.vulnClass)) {
                    continue;                                                                   // src: vvaharness/pipeline/stages/s7/collapse.py:201
                }
                // Titles sharing almost no vocabulary are not trivially one weakness: keep both.
                if (titleOverlap(a, b) < 0.15) {                                                // src: vvaharness/pipeline/stages/s7/collapse.py:212
                    Counters.bump("s7_trivial_collapse_deferred_unlike_titles");
                    continue;
                }
                boolean close = abs(groupLines[i] - groupLines[j]) <= lineTol;                  // src: vvaharness/pipeline/stages/s7/collapse.py:215
                boolean overlap = spans[i].start <= spans[j].end && spans[j].start <= spans[i].end; // src: vvaharness/pipeline/stages/s7/collapse.py:216
                if (close || overlap) {
                    canonicalOf.put(j, i);                                                      // src: vvaharness/pipeline/stages/s7/collapse.py:220
                    break;
                }
            }
        }
        return canonicalOf;
    }

    DupLocation dupLocation(Finding f, String reasoning) {
        return new DupLocation(f.file, f.lineStart, f.lineEnd, f.vulnClass, f.title, f.chunkId, f.sourceRef, f.sinkRef, reasoning); // src: vvaharness/pipeline/stages/s7/collapse.py:67
    }

    int rootOf(Map<Integer, Integer> canonicalOf, int i) {
        Set seen = new Set();
        while (canonicalOf.containsKey(i) && !seen.contains(i)) { seen.add(i); i = canonicalOf.get(i); } // src: vvaharness/pipeline/stages/s7/collapse.py:123
        return i;
    }
}
