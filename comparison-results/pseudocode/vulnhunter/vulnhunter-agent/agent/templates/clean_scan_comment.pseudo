// file: vulnhunter-agent/agent/templates/clean_scan_comment.md
// Per-scan receipt comment appended to an already-open clean-scan issue. Filled by
// IssuesRender.renderCleanScanComment; read by humans, not by a model.

@executedBy(CODE) @role(io) @stage("issues")
class CleanScanComment {

    String run(Map<String, String> fields) {
        String heading = "Additional clean scan — " + fields.get("SCAN_COMPLETED_AT");           // src: vulnhunter-agent/agent/templates/clean_scan_comment.md:1
        String rows = table(List.of("SCAN_ID", "COMMIT_SHA", "DURATION", "MODEL_VERSION", "SKILL_VERSION"), fields); // src: vulnhunter-agent/agent/templates/clean_scan_comment.md:3
        return heading + rows + fields.get("REPORT_URL_LINE");                                    // src: vulnhunter-agent/agent/templates/clean_scan_comment.md:11
    }
}
