// file: vvaharness/pipeline/stages/s5/detectors.py
// S5's zero-LLM detector pass: run the shared detect/ rule corpus over every in-scope file,
// mint Findings from hits, dedupe against S4's kept findings, and cap the row count.

@executedBy(CODE) @role(step) @stage("S5")
class S5Detectors {

    List<String> detectorLangs() {
        return List.of("python", "javascript", "typescript", "web-template");                    // src: vvaharness/pipeline/stages/s5/detectors.py:31
    }

    boolean inScope(String rel, String lang, Theta θ) {
        if (!detectorLangs().contains(lang)) return false;                                      // src: vvaharness/pipeline/stages/s5/detectors.py:41
        // Not test/mock noise, not minified.
        return !(S5Rules.excludePath(rel, θ) || rel.name().lower().contains(".min."));          // src: vvaharness/pipeline/stages/s5/detectors.py:44
    }

    Finding mint(Hit hit) {
        boolean xss = hit.spec.cwe == "CWE-79";                                                 // src: vvaharness/pipeline/stages/s5/detectors.py:50
        return new Finding(title = hit.spec.title, file = hit.file, lineStart = hit.line, lineEnd = hit.lineEnd,
                           vulnClass = xss ? VulnClass.INJECTION : VulnClass.OTHER,
                           cwe = hit.spec.cwe, origin = "detector", chunkId = hit.spec.ruleId,
                           description = "Deterministic detector match (" + hit.spec.ruleId + "). " + hit.spec.citation); // src: vvaharness/pipeline/stages/s5/detectors.py:51
    }

    List<Finding> dedup(List<Finding> rows, List<Finding> kept, int tol) {
        // Self-dedup per rule (proximity), span overlap within a rule family, then suppress rows at an already-kept (file, weakness).
        Map keptLines = kept.groupBy(f -> Pair.of(f.file, RulesCwe.weaknessKey(f.cwe)), f -> f.lineStart); // src: vvaharness/pipeline/stages/s5/detectors.py:78
        List<Finding> out = new List();
        for (Finding row : rows) {                                                              // src: vvaharness/pipeline/stages/s5/detectors.py:86
            int line = row.lineStart;
            int end = max(line, row.lineEnd);
            if (byRule.get(ruleKey(row)).any(n -> abs(line - n) <= tol)                         // src: vvaharness/pipeline/stages/s5/detectors.py:94
                || bySpan.get(spanKey(row)).any(se -> se.s <= end && line <= se.e)              // src: vvaharness/pipeline/stages/s5/detectors.py:95
                || keptLines.get(siteKey(row)).any(n -> abs(line - n) <= tol || (line <= n && n <= end))) { // src: vvaharness/pipeline/stages/s5/detectors.py:96
                Counters.bump("s5_det_dup_suppressed");
                continue;
            }
            byRule.append(ruleKey(row), line);
            bySpan.append(spanKey(row), Pair.of(line, end));
            out.add(row);
        }
        return out;
    }

    List<Finding> cap(List<Finding> survivors, List<Detector> compiled, int maxRows, Theta θ) {
        // <= 0 removes the cap; otherwise keep the highest-priority (corpus order) rows in stable order.
        if (θ["step5_detectors.max_rows"] <= 0 || survivors.size() <= maxRows) return survivors; // src: vvaharness/pipeline/stages/s5/detectors.py:108
        List<Integer> ranked = indices(survivors).sortedBy(i -> Pair.of(priority(compiled, survivors[i].chunkId), i)); // src: vvaharness/pipeline/stages/s5/detectors.py:111
        Counters.bump("s5_det_overflow_suppressed", survivors.size() - maxRows);                // src: vvaharness/pipeline/stages/s5/detectors.py:115
        return survivors.keepIndices(ranked.first(maxRows));                                    // src: vvaharness/pipeline/stages/s5/detectors.py:116
    }

    List<Finding> run(List<Finding> kept, ContextPackage ctx, FileCache cache, int lineTol, int maxRows, Theta θ) {
        if (!θ["step5_detectors.enabled"]) return List.of();                                    // src: vvaharness/pipeline/stages/s5/__init__.py:101
        List<Detector> compiled = Matcher.compileDetectors(Patterns.detectorCorpus());          // src: vvaharness/pipeline/stages/s5/detectors.py:122
        if (compiled.isEmpty()) return List.of();                                               // src: vvaharness/pipeline/stages/s5/detectors.py:123
        Map byLang = detectorLangs().toMap(lang -> compiled.filter(d -> d.spec.languages.contains(lang))); // src: vvaharness/pipeline/stages/s5/detectors.py:125
        List<Finding> rows = new List();
        for (String rel : sorted(Set.of(ctx.allFiles))) {                                       // src: vvaharness/pipeline/stages/s5/detectors.py:128
            String lang = Lang.extToLang(rel.suffix());
            if (!inScope(rel, lang, θ)) continue;                                               // src: vvaharness/pipeline/stages/s5/detectors.py:130
            List<Detector> live = byLang.get(lang);
            if (live.isEmpty()) continue;
            List<String> lines = cache.lines(rel);
            if (lines == null) continue;
            for (Hit hit : Matcher.detectorHits(rel, lines, live)) rows.add(mint(hit));         // src: vvaharness/pipeline/stages/s5/detectors.py:138
        }
        List<Finding> survivors = cap(dedup(rows, kept, lineTol), compiled, maxRows, θ);        // src: vvaharness/pipeline/stages/s5/detectors.py:140
        for (Finding row : survivors) Counters.bump("s5_det_rule_" + row.chunkId);              // src: vvaharness/pipeline/stages/s5/detectors.py:144
        return survivors;
    }
}
