// file: vvaharness/backends/llm/cli/envelope.py
// Reading the `claude --output-format json` envelope (one dict, a list, or NDJSON): canned-guardrail
// detection, typed refusals, usage/spend/telemetry, structured_output, and split-reply stitching.

@executedBy(CODE) @role(types)
record EnvelopeResult(String text, Map usage, Integer turns, Double usd, String stopReason, Map modelUsage) { }

@executedBy(CODE) @role(backend)
class Envelope {

    // Known canned-refusal strings from the content classifier; exact match only
    Set<String> GUARDRAIL_REFUSALS = θ["code.backends.llm.cli.envelope.guardrail_refusals"];                 // src: vvaharness/backends/llm/cli/envelope.py:44
    Set<String> PARSED_USAGE_CACHE_KEYS = Cache.ANTHROPIC_PARSED_CACHE_KEYS;                                // src: vvaharness/backends/llm/cli/envelope.py:242

    /** A canned refusal on a single, non-error turn is a content-guardrail block, not a pipeline bug. */
    @src("vvaharness/backends/llm/cli/envelope.py:49")
    void checkGuardrail(Map env) {
        Object text = env.get("result");                                                                    // src: vvaharness/backends/llm/cli/envelope.py:50
        int numTurns = env.get("num_turns") != null ? env.get("num_turns") : 1;
        if (text instanceof String && GUARDRAIL_REFUSALS.contains(text.strip()) && numTurns <= 1 && !env.get("is_error")) { // src: vvaharness/backends/llm/cli/envelope.py:51
            throw new GuardrailBlocked("content-guardrail blocked this prompt");                            // src: vvaharness/backends/llm/cli/envelope.py:56
        }
    }

    /** (turns, usd) off a result event, or nulls. */
    @src("vvaharness/backends/llm/cli/envelope.py:63")
    Pair spendOf(Map event) {
        Object turns = event == null ? null : event.get("num_turns");                                       // src: vvaharness/backends/llm/cli/envelope.py:65
        Object usd = event == null ? null : event.get("total_cost_usd");                                    // src: vvaharness/backends/llm/cli/envelope.py:66
        return Pair.of(turns instanceof Integer ? turns : null, usd instanceof Number ? usd : null);         // src: vvaharness/backends/llm/cli/envelope.py:67
    }

    /** Serialized structured_output off a result event, when it carries one. */
    @src("vvaharness/backends/llm/cli/envelope.py:71")
    String structuredText(Map event) {
        Object payload = event == null ? null : event.get("structured_output");                             // src: vvaharness/backends/llm/cli/envelope.py:73
        if (!(payload instanceof Map || payload instanceof List)) return null;                              // src: vvaharness/backends/llm/cli/envelope.py:74
        try { return Json.dumps(payload); } catch (Exception e) { return null; }                            // non-serializable: fall back to result // src: vvaharness/backends/llm/cli/envelope.py:77
    }

    /** (stop_reason, modelUsage) off the TERMINAL result event (streamed ones say stop_reason null). */
    @src("vvaharness/backends/llm/cli/envelope.py:82")
    Pair telemetryOf(Map event) {
        Object stop = event == null ? null : event.get("stop_reason");                                      // src: vvaharness/backends/llm/cli/envelope.py:85
        Object usage = event == null ? null : event.get("modelUsage");                                      // src: vvaharness/backends/llm/cli/envelope.py:86
        return Pair.of(stop instanceof String ? stop : null, usage instanceof Map ? usage : null);
    }

    /** stdout as one JSON document, else the list of its parsed NDJSON lines; null if none. */
    @src("vvaharness/backends/llm/cli/envelope.py:91")
    Object decodeStream(String stdout) {
        try { return Json.loads(stdout); } catch (JsonError e) { }                                          // src: vvaharness/backends/llm/cli/envelope.py:94
        List objs = new List();
        for (String ln : stdout.splitLines()) {                                                             // src: vvaharness/backends/llm/cli/envelope.py:98
            ln = ln.strip();
            if (ln.isEmpty()) continue;
            try { objs.add(Json.loads(ln)); } catch (JsonError e) { continue; }                             // src: vvaharness/backends/llm/cli/envelope.py:103
        }
        return objs.isEmpty() ? null : objs;                                                                // src: vvaharness/backends/llm/cli/envelope.py:106
    }

    @src("vvaharness/backends/llm/cli/envelope.py:109")
    List<Map> streamEvents(String stdout) {
        Object doc = decodeStream(stdout);                                                                  // src: vvaharness/backends/llm/cli/envelope.py:111
        List items = doc instanceof List ? doc : List.of(doc);
        return items.flatten().filter(e -> e instanceof Map);                                               // src: vvaharness/backends/llm/cli/envelope.py:113
    }

    /** Refusal category from the stream's structured keys only, never the wording. */
    @src("vvaharness/backends/llm/cli/envelope.py:117")
    String refusalCategoryOf(String stdout) {
        List<Map> events = streamEvents(stdout);                                                            // src: vvaharness/backends/llm/cli/envelope.py:121
        List<Map> refused = events.filter(e -> e.type == "assistant" && e.message.stopReason == LlmModels.ANTHROPIC_STOP_REFUSAL).map(e -> e.message); // src: vvaharness/backends/llm/cli/envelope.py:122
        String category = refused.isEmpty() ? null : LlmModels.refusalCategory(refused.last());             // src: vvaharness/backends/llm/cli/envelope.py:125
        if (category != null) return category;                                                              // src: vvaharness/backends/llm/cli/envelope.py:127
        Object api = events.reversed().firstWhere(e -> e.type == "system" && e.subtype == "model_refusal_no_fallback").apiRefusalCategory; // src: vvaharness/backends/llm/cli/envelope.py:128
        return api instanceof String ? api : null;                                                          // src: vvaharness/backends/llm/cli/envelope.py:131
    }

    /** Raise the typed refusal for a refused reply; callers bank its usage first. */
    @src("vvaharness/backends/llm/cli/envelope.py:134")
    void raiseIfRefused(String stopReason, String tag, String stdout) {
        if (stopReason == LlmModels.ANTHROPIC_STOP_REFUSAL) {                                               // src: vvaharness/backends/llm/cli/envelope.py:138
            throw LlmModels.modelRefusal("cli", tag != null ? tag : "", refusalCategoryOf(stdout));          // src: vvaharness/backends/llm/cli/envelope.py:139
        }
    }

    /** Bank and raise the typed refusal when a non-zero exit's envelope reports one. */
    @src("vvaharness/backends/llm/cli/envelope.py:143")
    void raiseIfRefusedExit(String stdout, String tag) {
        // limitation: assumes a refused non-zero exit still emits a refusal envelope
        EnvelopeResult envRes;
        try { envRes = parse(stdout, false, null); } catch (Exception e) { return; }                        // best effort // src: vvaharness/backends/llm/cli/envelope.py:148
        if (envRes.stopReason != LlmModels.ANTHROPIC_STOP_REFUSAL) return;                                  // src: vvaharness/backends/llm/cli/envelope.py:151
        noteUnparsedCacheKeys(envRes.usage);                                                                // src: vvaharness/backends/llm/cli/envelope.py:153
        Tokens.TOKENS.add(envRes.usage, envRes.usd, envRes.turns);                                          // src: vvaharness/backends/llm/cli/envelope.py:154
        raiseIfRefused(envRes.stopReason, tag, stdout);                                                     // src: vvaharness/backends/llm/cli/envelope.py:155
    }

    /** Every assistant text block in a list envelope, in order, concatenated. */
    @src("vvaharness/backends/llm/cli/envelope.py:158")
    String assistantText(List events) {
        StringBuilder parts = new StringBuilder();
        for (Map evt : events) {                                                                            // src: vvaharness/backends/llm/cli/envelope.py:161
            if (evt.type != "assistant") continue;
            for (Map blk : evt.message.content) if (blk.type == "text") parts.append(blk.text);             // src: vvaharness/backends/llm/cli/envelope.py:164
        }
        return parts.toString();
    }

    /** Rebuild a prompt-mode reply the CLI split across turns (result holds only the LAST turn). */
    @src("vvaharness/backends/llm/cli/envelope.py:170")
    String stitchContinuation(List events, String resultText, Integer turns, String tag) {
        if (turns == null || turns <= 1) return resultText;                                                 // src: vvaharness/backends/llm/cli/envelope.py:174
        String stitched = assistantText(events).strip();                                                    // src: vvaharness/backends/llm/cli/envelope.py:176
        String body = resultText.strip();
        if (stitched.isEmpty() || body.isEmpty() || stitched == body || !stitched.endsWith(body)) return resultText; // not a continuation tail // src: vvaharness/backends/llm/cli/envelope.py:178
        Counters.bump(LlmModels.CLI_CONTINUED_REPLIES_COUNTER);                                             // src: vvaharness/backends/llm/cli/envelope.py:181
        Log.warning(Event.CLI_REPLY_SPLIT_ACROSS_TURNS, turns, tag);
        return stitched;                                                                                    // src: vvaharness/backends/llm/cli/envelope.py:184
    }

    /** Parse the envelope (dict or list) into text, usage, turns, usd, stop_reason, modelUsage. The source name is _parse_envelope (parseEnvelope); callers use parse. */
    @src("vvaharness/backends/llm/cli/envelope.py:187")
    EnvelopeResult parse(String stdout, boolean stitchContinuations, String tag) {
        Object env = decodeStream(stdout);                                                                  // src: vvaharness/backends/llm/cli/envelope.py:190
        if (env == null) return new EnvelopeResult(stdout.strip(), null);                                   // src: vvaharness/backends/llm/cli/envelope.py:192
        if (env instanceof List) {                                                                          // src: vvaharness/backends/llm/cli/envelope.py:194
            Map resultEvt = env.reversed().firstWhere(e -> e.type == "result");                             // src: vvaharness/backends/llm/cli/envelope.py:195
            if (resultEvt != null) checkGuardrail(resultEvt);                                               // src: vvaharness/backends/llm/cli/envelope.py:199
            Map usage = resultEvt == null ? null : resultEvt.get("usage");
            String text = structuredText(resultEvt);                                                        // structured_output preferred over result // src: vvaharness/backends/llm/cli/envelope.py:201
            if (text == null) text = resultEvt == null ? null : resultEvt.get("result");
            if (text == null || text.strip().isEmpty()) {                                                   // src: vvaharness/backends/llm/cli/envelope.py:202
                Map lastAsst = env.reversed().firstWhere(e -> e.type == "assistant");                       // src: vvaharness/backends/llm/cli/envelope.py:203
                text = lastAsst == null ? "" : assistantText(List.of(lastAsst));                            // "" not the raw envelope // src: vvaharness/backends/llm/cli/envelope.py:214
            }
            Pair spend = spendOf(resultEvt);                                                                // src: vvaharness/backends/llm/cli/envelope.py:215
            Pair tele = telemetryOf(resultEvt);                                                             // src: vvaharness/backends/llm/cli/envelope.py:216
            text = text.strip();
            if (stitchContinuations) text = stitchContinuation(env, text, spend.first, tag);                // prompt mode only // src: vvaharness/backends/llm/cli/envelope.py:219
            return new EnvelopeResult(text, usage, spend.first, spend.second, tele.first, tele.second);      // src: vvaharness/backends/llm/cli/envelope.py:220
        }
        if (!(env instanceof Map)) return new EnvelopeResult(stdout.strip(), null);                         // src: vvaharness/backends/llm/cli/envelope.py:226
        checkGuardrail(env);                                                                                // src: vvaharness/backends/llm/cli/envelope.py:227
        Object result = structuredText(env) != null ? structuredText(env) : env.get("result");              // src: vvaharness/backends/llm/cli/envelope.py:228
        if (!(result instanceof String)) result = "";                                                       // src: vvaharness/backends/llm/cli/envelope.py:231
        Pair spend = spendOf(env);
        Pair tele = telemetryOf(env);
        // no stitching on the single-dict shape: no per-turn events to stitch from
        return new EnvelopeResult(result.strip(), env.get("usage"), spend.first, spend.second, tele.first, tele.second); // src: vvaharness/backends/llm/cli/envelope.py:236
    }

    @src("vvaharness/backends/llm/cli/envelope.py:245")
    void noteUnparsedCacheKeys(Map usage) {
        Cache.noteUnparsedCacheKeys(usage, "cli");                                                          // src: vvaharness/backends/llm/cli/envelope.py:247
    }

    /** The JSON content of a --output-format json wrapped response, else a best-effort extraction. */
    @src("vvaharness/backends/llm/cli/envelope.py:252")
    Object parseJsonResponse(String text) {
        try {
            Object envelope = Json.loads(text);                                                             // src: vvaharness/backends/llm/cli/envelope.py:255
            if (envelope instanceof Map && envelope.containsKey("result")) {                                // src: vvaharness/backends/llm/cli/envelope.py:256
                Object content = envelope.get("result");
                return content instanceof String ? Json.loads(content) : content;                           // src: vvaharness/backends/llm/cli/envelope.py:259
            }
            return envelope;
        } catch (JsonError e) { }
        return JsonExtract.extractJson(text);                                                               // src: vvaharness/backends/llm/cli/envelope.py:265
    }
}
