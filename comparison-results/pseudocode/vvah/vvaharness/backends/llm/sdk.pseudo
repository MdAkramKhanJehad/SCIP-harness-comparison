                        String holdText = submitGuard.get();                                                // src: vvaharness/backends/llm/sdk.py:1526
                        if (holdText != null) {
                            Console.write("structured tool accepted but evidence-gated - re-asking");       // src: vvaharness/backends/llm/sdk.py:1528
                            results.add(Map.of("type", "tool_result", "tool_use_id", b.id, "content", holdText)); // src: vvaharness/backends/llm/sdk.py:1530
                            continue;                                                                       // src: vvaharness/backends/llm/sdk.py:1534
                        }
                    }
                    return validated.modelDumpJson();                                                       // accepted as the final answer // src: vvaharness/backends/llm/sdk.py:1538
                }
                toolCallsTotal += 1;                                                                        // src: vvaharness/backends/llm/sdk.py:1540
                Map args = b.input != null ? b.input : Map.of();                                            // src: vvaharness/backends/llm/sdk.py:1541
                // a caller-supplied tool goes to extra_dispatch (the caller logs and caps it); a localtools name returns None from it and is executed and logged here
                String out = extraDispatch != null ? extraDispatch.apply(b.name, args) : null;              // src: vvaharness/backends/llm/sdk.py:1546
                if (out == null && !ok.contains(b.name)) out = LlmTools.UNGRANTED_TOOL_ERROR;               // an ungranted localtool never runs, whatever name the model emits // src: vvaharness/backends/llm/sdk.py:1547
                if (out == null) {
