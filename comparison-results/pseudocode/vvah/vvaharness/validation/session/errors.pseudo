// file: vvaharness/validation/session/errors.py
// Per-session failure that drives a case INCONCLUSIVE; wraps the harness error and renders a diagnostic.

// Renders ValidationSessionError: the per-session failure that drives the case INCONCLUSIVE; wraps the harness error with the cause exposed.
@executedBy(CODE) @role(types) @stage("S11")
class SessionErrors {

    String message;                                                                                  // src: vvaharness/validation/session/errors.py:24
    Exception cause;                                                                                 // src: vvaharness/validation/session/errors.py:32  (optional, default null)
    Integer exitCode;                                                                                // src: vvaharness/validation/session/errors.py:33  (optional, default null)

    String reasonString() {
        List<String> parts = List.of(message);                                                       // src: vvaharness/validation/session/errors.py:37
        if (exitCode != null) parts.add("exit_code=" + exitCode);                                    // src: vvaharness/validation/session/errors.py:38
        if (cause instanceof HarnessProcessError && cause.stderr != null) {                          // src: vvaharness/validation/session/errors.py:40
            parts.add("stderr: " + String.join(" | ", cause.stderr.splitlines().lastN(3)));          // STDERR_TAIL_LINES  // src: vvaharness/validation/session/errors.py:41
        } else if (cause != null) {
            parts.add("cause=" + cause.typeName() + ": " + cause);                                   // src: vvaharness/validation/session/errors.py:44
        }
        return String.join(" -- ", parts);                                                           // src: vvaharness/validation/session/errors.py:45
    }
}
