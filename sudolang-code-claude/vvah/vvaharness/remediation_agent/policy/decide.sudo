# vvaharness/remediation_agent/policy/decide.py

The policy pre-gate, run before any model call: asks the gate whether the finding may be patched and, only if so, resolves the playbook strategy for it. Also builds the plain "Denied" verdict for a refused finding.

Source: `vvaharness/remediation_agent/policy/decide.py` (lines 1-64)
Executor: code
Called from: `plugin_runner/run.sudo` call_with_guards (pre_decision), _denied (guidance_verdict)

// src: vvaharness/remediation_agent/policy/decide.py:28-37
PreResult {
  decision: Decision   // policy_gate/action.sudo
  cwe: String | null
  strategy: Strategy | null
  allowed = decision.may_generate_patch   // the agent may run if and only if this is true
}

// src: vvaharness/remediation_agent/policy/decide.py:40-50
fn pre_decision(ctx, target):executor=code {
  cwe = target.finding.cwe; file_path = target.finding.file
  decision = ctx.gate.decide(cwe, file_path)   // policy_gate/gate.sudo
  strategy = null
  if (decision.may_generate_patch) {
    lang = frameworks.language_for(file_path)
    // the playbook is SUPPLEMENTARY context, not a second gate: a missing strategy does not deny the finding
    strategy = ctx.playbook.resolve(cwe, lang, ctx.frameworks)
  }
  return PreResult(decision, cwe, strategy)
  // preserved: the playbook's own "confidence: guidance" entries (for example CWE-916, CWE-284) and its policy.never_autofix_cwes list are not consulted here; whether such a CWE is patched depends only on the policy file
}

// src: vvaharness/remediation_agent/policy/decide.py:53-64
fn guidance_verdict(ctx, target, pre):executor=code {
  return RemediationVerdict(finding_index=target.index, verdict="Denied", root_cause="", changes=[], recommendations=[], summary="Denied by policy (${pre.decision.reason}). No patch generated.")
  // ctx is unused; no playbook guidance text is attached (Playbook.guidance_for is never called)
}
