// file: vvaharness/remediation_agent/policy_gate/gate.py
// The gate itself: patch eligibility for a finding (kill switch, deny list, sensitive paths, allow list, default) and which changed files must be reverted.

@executedBy(CODE) @role(rule_set) @stage("S10")
class Gate {

    String defaultPolicyPath(Theta θ) {
        // Locate remediation_policy.yaml in a source checkout or an installed wheel; module constants DEFAULT_POLICY_PATH and RULES_DIR (its parent) come from it.
        return RulePaths.locateRule("remediation_policy.yaml", "policy_gate/gate.py", θ);           // src: vvaharness/remediation_agent/policy_gate/gate.py:35
    }

    RemediationGate init(String policyPath, Theta θ) {
        // RemediationGate.__init__: a missing path means the default; a failed parse leaves data null and loaded false (fail closed on every decide).
        PolicyData data = RemediationAgentPolicyGate.parsePolicy(policyPath != null ? policyPath : defaultPolicyPath(θ)); // src: vvaharness/remediation_agent/policy_gate/gate.py:47
        return new RemediationGate(data, data != null);                                             // src: vvaharness/remediation_agent/policy_gate/gate.py:49
    }

    List<String> denyPaths(RemediationGate g) {
        return g.data != null ? List.copyOf(g.data.denyPaths) : List.of();                          // src: vvaharness/remediation_agent/policy_gate/gate.py:54
    }

    List<String> forbidPatchPaths(RemediationGate g) {
        return g.data != null ? List.copyOf(g.data.forbidPatchPaths) : List.of();                   // src: vvaharness/remediation_agent/policy_gate/gate.py:58
    }

    PolicyDecision decide(RemediationGate g, String cweId, String filePath, Theta θ) {
        // Return the maximum action permitted for this finding. Order: kill switch, deny list, sensitive paths, allow list, default.
        PolicyData d = g.data;                                                                      // src: vvaharness/remediation_agent/policy_gate/gate.py:63
        if (!g.loaded || d == null) return Action.failClosed();                                     // src: vvaharness/remediation_agent/policy_gate/gate.py:64
        // 0. kill switch, checked on EVERY call
        List<String> truthy = θ["code.remediation_agent.policy_gate.gate.kill_switch_truthy_values"]; // src: vvaharness/remediation_agent/policy_gate/gate.py:41
        if (d.killEnv != null && truthy.contains(Os.getenv(d.killEnv, "").strip().lower())) return new PolicyDecision(GUIDANCE_ONLY, "kill_switch_env", null); // src: vvaharness/remediation_agent/policy_gate/gate.py:68
        if (d.killFile != null && Path.exists(d.killFile)) return new PolicyDecision(GUIDANCE_ONLY, "kill_switch_file", null); // src: vvaharness/remediation_agent/policy_gate/gate.py:70
        String cwe = RemediationAgentPolicyGate.normCwe(cweId);                                     // src: vvaharness/remediation_agent/policy_gate/gate.py:72
        if (cwe == null) return new PolicyDecision(GUIDANCE_ONLY, "unmapped_cwe", null);            // src: vvaharness/remediation_agent/policy_gate/gate.py:74
        // 1. deny list, including descendants: absolute, wins over everything
        if (d.deny.containsKey(cwe)) return new PolicyDecision(GUIDANCE_ONLY, d.deny.get(cwe), "deny:" + cwe); // src: vvaharness/remediation_agent/policy_gate/gate.py:78
        // 2. sensitive-path guard: blocks even allowed CWEs
        String normPath = (filePath != null ? filePath : "").replace("\\", "/");                    // src: vvaharness/remediation_agent/policy_gate/gate.py:83
        for (String pat : d.denyPaths) {                                                            // src: vvaharness/remediation_agent/policy_gate/gate.py:84
            if (Matching.globMatch(normPath, pat)) return new PolicyDecision(GUIDANCE_ONLY, "sensitive_path:" + pat, "deny_path:" + pat); // src: vvaharness/remediation_agent/policy_gate/gate.py:85
        }
        // 3. allow list: explicit patch eligibility
        if (d.allow.contains(cwe)) return new PolicyDecision(PATCH, "allow_list", "allow:" + cwe);  // src: vvaharness/remediation_agent/policy_gate/gate.py:91
        // 4. default
        return new PolicyDecision(d.defaultAction, "default_action", null);                         // src: vvaharness/remediation_agent/policy_gate/gate.py:96
    }

    String patchTouchesForbidden(RemediationGate g, List<String> changedFiles) {
        // The matching glob if any file in the diff hits forbid_patch_paths (build, test, CI infrastructure); null otherwise.
        return Matching.firstMatch(changedFiles, forbidPatchPaths(g));                              // src: vvaharness/remediation_agent/policy_gate/gate.py:101
    }

    String changedPathsHitDeny(RemediationGate g, List<String> changedFiles) {
        // The matching glob if any file in the diff hits deny_paths (sensitive subsystem); null otherwise.
        return Matching.firstMatch(changedFiles, denyPaths(g));                                     // src: vvaharness/remediation_agent/policy_gate/gate.py:105
    }

    List<String> forbiddenFiles(RemediationGate g, List<String> changedFiles) {
        // The subset of changed_files that hit forbid_patch_paths or deny_paths; original spelling kept, empty entries skipped.
        List<String> bad = new List();                                                              // src: vvaharness/remediation_agent/policy_gate/gate.py:109
        for (String f : changedFiles != null ? changedFiles : List.of()) {                          // src: vvaharness/remediation_agent/policy_gate/gate.py:110
            String nf = (f != null ? f : "").replace("\\", "/");                                    // src: vvaharness/remediation_agent/policy_gate/gate.py:111
            if (nf.isEmpty()) continue;                                                             // src: vvaharness/remediation_agent/policy_gate/gate.py:112
            if (Matching.firstMatch(List.of(nf), forbidPatchPaths(g)) != null || Matching.firstMatch(List.of(nf), denyPaths(g)) != null) { // src: vvaharness/remediation_agent/policy_gate/gate.py:114
                bad.add(f);                                                                         // src: vvaharness/remediation_agent/policy_gate/gate.py:116
            }
        }
        return bad;                                                                                 // src: vvaharness/remediation_agent/policy_gate/gate.py:117
    }
}
