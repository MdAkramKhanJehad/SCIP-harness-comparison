# vvaharness/validation/synthesis/_consensus.py

Host-side, deterministic consensus over the three persona reports for one finding. Produces one synthesized gate per gate name: a strict majority of at least two evaluated votes wins with HIGH confidence; otherwise the most conservative of the tied top statuses wins with FLAGGED confidence. Required gates no persona answered are added as INVALID and FLAGGED. A FLAGGED gate later makes the scoring engine return INCONCLUSIVE (scoring/_engine.sudo _consensus_error).

Source: `vvaharness/validation/synthesis/_consensus.py` (lines 1-189)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` _synthesize_gates

// src: vvaharness/validation/synthesis/_consensus.py:36-43
// "Most-severe-first ordering for persona synthesis; this panel's tie-break policy, not vocabulary."
_STATUS_CONSERVATIVE_RANK = [FAIL, PARTIAL, PASS, SKIP, INVALID]
// preserved: INVALID ranks last (least conservative) here, although the scoring engine treats invalid like a failure.

// src: vvaharness/validation/synthesis/_consensus.py:46-65
SynthesizedEvidence { persona; file; line?; snippet }
SynthesizedGate { tracking_id; gate_name; status: GateStatus; confidence: "HIGH" | "FLAGGED"; summary; details; evidence: [SynthesizedEvidence]; persona_votes: { persona: GateStatus } }

// src: vvaharness/validation/synthesis/_consensus.py:129-189
fn synthesize_gates_for_finding(reports, tracking_id, required_gates=FIX_VALIDATION_GATES):executor=code {
  by_gate = {}
  for each report in reports {
    if (report.tracking_id != tracking_id) skip it
    for each gate in report.gates, append [report.persona, gate] to by_gate[gate.gate_name]
    // grouped by the raw gate_name string, not the normalised name
  }
  synthesized = []
  for each [gate_name, entries] in by_gate sorted by gate_name {
    votes = _persona_votes(entries, gate_name, tracking_id)
    evaluated = votes values where status != SKIP
    if (evaluated is empty) {
      [chosen_status, confidence] = [SKIP, FLAGGED]
    } else {
      counter = count of each status in evaluated
      top_frequency = max count
      top_statuses = statuses with count == top_frequency
      if (length(top_statuses) == 1 && top_frequency >= MIN_CONSENSUS_VOTES) {   // MIN_CONSENSUS_VOTES = 2
        [chosen_status, confidence] = [top_statuses[0], HIGH]
      } else {
        chosen_status = _most_conservative_status(top_statuses); confidence = FLAGGED
        // covers a single evaluating persona and any tie
      }
    }
    for each [persona, gate] in entries sorted by persona {
      if (gate.summary) collect "$persona: ${ gate.summary }"
      if (gate.details) collect "$persona: ${ gate.details }"
      collect each gate.evidence item as SynthesizedEvidence(persona, file, line, snippet)
    }
    append SynthesizedGate {
      tracking_id, gate_name, status: chosen_status, confidence,
      summary: summaries joined by " | ", details: details joined by " | ",
      evidence: sorted by (file, line), persona_votes: votes sorted by persona
    }
  }
  synthesized += _missing_required_gates(by_gate, tracking_id, required_gates)
  return synthesized
}

// src: vvaharness/validation/synthesis/_consensus.py:77-100
fn _persona_votes(entries, gate_name, tracking_id):executor=code {
  votes = {}
  for each [persona, gate] in entries {
    prior = votes[persona]
    if (prior) warn "duplicate gate vote for persona=... gate=...; merging to most conservative status"   // "logged as agent instability"
    votes[persona] = if (prior) _most_conservative_status([prior, gate.status]) else gate.status
  }
  return votes   // one vote per persona
}

// src: vvaharness/validation/synthesis/_consensus.py:103-126
fn _missing_required_gates(by_gate, tracking_id, required_gates):executor=code {
  // "Zero gates means never examined; partial coverage must not read as a clean consensus"
  if (by_gate is empty) return []
  answered = { normalise_gate_name(name) for each name in by_gate }   // casefolded, "-" and " " become "_"
  return for each gate_name in required_gates where normalise_gate_name(gate_name) not in answered:
    SynthesizedGate { tracking_id, gate_name, status: INVALID, confidence: FLAGGED, summary: "",
      details: "required gate '$gate_name' was not answered by any persona", evidence: [], persona_votes: {} }
}

// src: vvaharness/validation/synthesis/_consensus.py:68-74
fn _most_conservative_status(statuses):executor=code {
  return first status in _STATUS_CONSERVATIVE_RANK that is present in statuses, else INVALID
}
