// file: vvaharness/remediation_agent/report_augment/mdsafe.py
// Escape untrusted (model or plugin controlled) text before interpolating it into Markdown (CWE-79).

@executedBy(CODE) @role(rule_set) @stage("S10")
class Mdsafe {

    // Metacharacters forging emphasis, links, HTML or table cells; newlines are collapsed to spaces first.
    Map<String, String> MD_ESCAPE = θ["code.remediation_agent.report_augment.mdsafe.md_escape"];     // src: vvaharness/remediation_agent/report_augment/mdsafe.py:22

    // MD_LINEBREAK_RX folds every splitlines separator (U+2028/9); MD_INVISIBLE_RX strips bidi and zero-width chars. Both imported from models.

    String mdEscape(Object value, Theta θ) {
        String text = Models.MD_LINEBREAK_RX.sub(" ", String.valueOf(value));                        // src: vvaharness/remediation_agent/report_augment/mdsafe.py:29
        text = Models.MD_INVISIBLE_RX.sub("", text);                                                 // src: vvaharness/remediation_agent/report_augment/mdsafe.py:31
        return text.chars().map(ch -> θ["code.remediation_agent.report_augment.mdsafe.md_escape"].getOrDefault(ch, ch)).join(""); // per-character table lookup // src: vvaharness/remediation_agent/report_augment/mdsafe.py:33
    }

    // Render untrusted text as a safe inline code span: only backticks and controls break out of a span; angle brackets and ampersand are still entity-escaped.
    String mdCodeSpan(Object value) {
        String text = Models.MD_LINEBREAK_RX.sub(" ", String.valueOf(value));                        // src: vvaharness/remediation_agent/report_augment/mdsafe.py:36
        text = Models.MD_INVISIBLE_RX.sub("", text);                                                 // src: vvaharness/remediation_agent/report_augment/mdsafe.py:38
        text = text.replace("`", "");                                                                // backticks removed, not escaped // src: vvaharness/remediation_agent/report_augment/mdsafe.py:40
        text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");                 // src: vvaharness/remediation_agent/report_augment/mdsafe.py:41
        return "`" + text + "`";                                                                     // src: vvaharness/remediation_agent/report_augment/mdsafe.py:43
    }
}
