// file: vulnhunter-fix/templates/pr_body.md
// PR description body, fork mode (one finding per PR). Filled by the deliver prompt; placeholders written as <NAME>.
// Humans read it. Gate 2 checks its H2 headings, Gate 6 parses the verification table, Gate 4 and the intake parser read the footer key comment.

@executedBy(CODE) @role(io) @stage("fix")
class PrBody {

    String run(Map<String, String> fields) {
        StringBuilder b = new StringBuilder();
        b.append("## Security Fix: " + fields.get("VULN_ID") + " — " + fields.get("TITLE"));       // src: vulnhunter-fix/templates/pr_body.md:1
        b.append("Closes #" + fields.get("ISSUE_NUMBER"));                                        // src: vulnhunter-fix/templates/pr_body.md:3
        b.append(findingSummary(fields));
        b.append(attackerCapability(fields));
        b.append(securityTest(fields));
        b.append(fixDescription(fields));
        if (fields.has("SETUP_STEPS")) b.append(setupRequired(fields));                           // draft-PR only
        if (fields.get("STATUS") == "BREAKING_CHANGE") b.append(breakingChange(fields));          // conditional
        b.append(verificationResults());
        b.append(verificationTable(fields));
        if (fields.get("COMPLETENESS_TIER") != "FULL") b.append(residualRisk(fields));            // conditional on tier
        if (fields.get("SWEEP_RAN") == "true") b.append(sweepSummary(fields));                    // conditional on sweep
        b.append(footer(fields));
        return b.toString();
    }

    // "## Finding Summary": ID, CWE (id: name), Severity, Location in backticks, Root Cause (no Data Flow row, unlike the issue body).
    String findingSummary(Map<String, String> fields) {
        return table(List.of("VULN_ID", "CWE: CWE_NAME", "SEVERITY", "LOCATION", "ROOT_CAUSE"), fields); // src: vulnhunter-fix/templates/pr_body.md:7
    }

    // "## Attacker Capability": what an attacker can do, and what the exploit demonstration proves.
    String attackerCapability(Map<String, String> fields) {
        return "What an attacker can do: " + fields.get("EXPLOIT_DESCRIPTION") + " What this proves: " + fields.get("EXPLOIT_PROOF_STATEMENT"); // src: vulnhunter-fix/templates/pr_body.md:17
    }

    // "## Security Test": claims the test failed before the fix and passes after; code block plus a fixed two-row table (Before fix FAIL vulnerable, After fix PASS secure).
    String securityTest(Map<String, String> fields) {
        return fenced(fields.get("LANG"), fields.get("TEST_CODE")) + "Before fix: FAIL (vulnerable); After fix: PASS (secure)"; // src: vulnhunter-fix/templates/pr_body.md:23
    }

    // "## Fix Description": strategy, file changes, why it works.
    String fixDescription(Map<String, String> fields) {
        return "Strategy: " + fields.get("FIX_STRATEGY") + " Changes: " + fields.get("FILE_CHANGES") + " Why this works: " + fields.get("FIX_WHY"); // src: vulnhunter-fix/templates/pr_body.md:36
    }

    // "## Setup Required (Draft PR)": non-breaking in code but ineffective until the listed steps are done; the PR must not be marked ready before every step is done.
    // Opened as Draft when the tier is WORKAROUND (Delivery.prDraftStateForTier) or setup steps exist.
    String setupRequired(Map<String, String> fields) {
        return fields.get("SETUP_STEPS");                                                         // src: vulnhunter-fix/templates/pr_body.md:46
    }

    // "## Breaking Change" (bare heading; Gate 2 rejects the em-dash form): backward-compatible but incomplete; legacy path logged until callers migrate.
    String breakingChange(Map<String, String> fields) {
        return "Interface change: " + fields.get("INTERFACE_CHANGE_DESCRIPTION") + " What callers must do: " + fields.get("CALLER_ACTION_REQUIRED")
             + " Known callers (best-effort search): " + fields.get("KNOWN_CALLERS")
             + " Once callers have migrated: remove the legacy fallback path, hard-enforce the secure interface, " + fields.get("REGISTRATION_ACTIONS")
             + " Pending finalization issue: #" + fields.get("FINALIZATION_ISSUE_NUMBER");        // src: vulnhunter-fix/templates/pr_body.md:52
    }

    // "## Verification Results": fixed two bullets (security test PASS, RED before and GREEN after; existing tests no regressions).
    String verificationResults() {
        return "Security test: PASS (RED before fix, GREEN after); Existing tests: no regressions";  // src: vulnhunter-fix/templates/pr_body.md:68
    }

    // "## Verification Table": nine-column table from Delivery.renderVerificationTable (PR only; the issue body also carries it).
    String verificationTable(Map<String, String> fields) {
        return fields.get("VERIFICATION_TABLE");                                                  // src: vulnhunter-fix/templates/pr_body.md:74
    }

    // "## Residual Risk": rendered by Delivery.renderResidualRiskSection (empty for FULL).
    String residualRisk(Map<String, String> fields) {
        return fields.get("RESIDUAL_RISK_SECTION");                                               // src: vulnhunter-fix/templates/pr_body.md:78
    }

    // "## Sweep Summary": header Root cause, Pattern, Found, Captured, Mitigated, Remaining, then SWEEP_ROWS.
    String sweepSummary(Map<String, String> fields) {
        return fields.get("SWEEP_ROWS");                                                          // src: vulnhunter-fix/templates/pr_body.md:86
    }

    // Footer: attribution lines and the machine marker (HTML comment, vulnfix-key, 16 lowercase hex), matched anywhere in the body.
    String footer(Map<String, String> fields) {
        return "VulnHunter-Finding: " + fields.get("VULN_ID") + " Co-Authored-By: Claude Code (VulnFix)"  // src: vulnhunter-fix/templates/pr_body.md:89
             + "<!-- vulnfix-key: " + fields.get("IDEMPOTENCY_KEY") + " -->";                     // src: vulnhunter-fix/templates/pr_body.md:91
    }
}
