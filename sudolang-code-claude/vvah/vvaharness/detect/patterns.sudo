# vvaharness/detect/patterns.py

The default source and sink corpus Stage 0 matches line by line, and the declarative detector rules Stage 5 applies with span and gate checks. Every callee is meant to be a public, documented API defensible from CWE semantics, never benchmark-led (source comment, line 21).

Source: `vvaharness/detect/patterns.py` (lines 1-398)
Executor: code
Called from: `vvaharness/detect/__init__.py` (default_corpus, Stage 0); detector_corpus from the Stage 5 detector pass (`pipeline/stages/s5/detectors.py`) and from `pipeline/stages/s1_autoexclude.py` (detector-docwrite-location only)

// src: vvaharness/detect/patterns.py:24-37
fn _owasp(family):executor=code { return rules.cwe.OWASP_2025_BY_SEMANTIC[family] || ["A03:2025-Injection"] }
fn _bare_call(name) = "(?<![\w.])${name}\s*\("        // not preceded by a word character or dot: rejects dot-qualified receivers by design
fn _method_call(name) = "\.${name}\s*\("
fn _qualified_call(module, name) = "\b${module}\.${name}\s*\("

// src: vvaharness/detect/patterns.py:40-57
// _HTML_ELEMENTS: the WHATWG element names (a, abbr, ... wbr), each in lower case and in ALL CAPS only (a blanket (?i) would reopen the "<Data %s>" repr idiom)
// abstracted: patterns.py:42-56 lists 114 element names (228 alternatives with the upper-case forms); the list is data for detector-html-string-concat only

// src: vvaharness/detect/patterns.py:59-94
_COMMAND_METHODS = ["system", "popen", "spawn", "exec", "eval"]
_COMMAND_QUALIFIED = { os: ["system"], subprocess: ["run", "call", "check_output", "check_call", "Popen"] }
_SQL_METHODS = ["execute", "executemany", "raw", "query"]
_DESERIALIZE_METHODS = ["loads", "load", "deserialize", "unmarshal"]
_DESERIALIZE_MODULE_METHODS = { pickle: ["loads", "load"], yaml: ["load"] }
_SOURCE_ACCESSORS = {
  // Flask
  "request.args", "request.form", "request.json", "request.data", "request.headers", "request.cookies", "request.get_json": "network",
  // Django HttpRequest (upper case, plus body)
  "request.GET", "request.POST", "request.META", "request.FILES", "request.COOKIES", "request.body": "network",
  "os.environ", "os.getenv": "file",
  "sys.argv", "sys.stdin": "cli",
  // base class names, not self.path / self.headers
  "BaseHTTPRequestHandler", "SimpleHTTPRequestHandler": "network"
}

// src: vvaharness/detect/patterns.py:97-216 — the Stage 0 line corpus
fn default_corpus():executor=code {
  return [
    // _command_specs (:97-123)
    for each name in _COMMAND_METHODS: { rule_id: "detect-sink-command-$name", role: "sink", pattern: _bare_call(name), cwe: "CWE-78", kind: "command_injection", semantic_family: "command-exec" },
    for each (module, name) in _COMMAND_QUALIFIED: { rule_id: "detect-sink-command-$module-$name", pattern: _qualified_call(module, name), same cwe/kind/family },
    // _sql_specs (:154-166)
    for each name in _SQL_METHODS: { rule_id: "detect-sink-sql-$name", role: "sink", pattern: _method_call(name), cwe: "CWE-89", kind: "sql_injection", semantic_family: "sql-exec" },
    // _deserialize_specs (:169-195)
    for each name in _DESERIALIZE_METHODS: { rule_id: "detect-sink-deser-$name", role: "sink", pattern: _bare_call(name), cwe: "CWE-502", kind: "unsafe_deserialization", semantic_family: "deserialization" },
    for each (module, name) in _DESERIALIZE_MODULE_METHODS: { rule_id: "detect-sink-deser-$module-$name", pattern: _qualified_call(module, name), same cwe/kind/family },
    // _template_specs (:126-137)
    { rule_id: "detect-sink-template-render_template_string", role: "sink", pattern: _bare_call("render_template_string"), cwe: "CWE-79", kind: "xss", semantic_family: "html-response" },
    // _cookie_specs (:140-151) — two specs because a MatchSpec holds one CWE; both ids share the trailing segment "set_cookie" (Stage 0 relies on it)
    { rule_id: "detect-sink-cookie-httponly-set_cookie", role: "sink", pattern: _method_call("set_cookie"), cwe: "CWE-1004", kind: "cookie_flag" },
    { rule_id: "detect-sink-cookie-secure-set_cookie",   role: "sink", pattern: _method_call("set_cookie"), cwe: "CWE-614",  kind: "cookie_flag" },
    // _source_specs (:198-210)
    for each (accessor, kind) in _SOURCE_ACCESSORS: { rule_id: "detect-source-$accessor", role: "source", pattern: "\b$accessor\b", cwe: "CWE-20", kind, semantic_family: "untrusted-input" }
  ]
  // every spec's owasp_top10_2025 = _owasp(semantic_family); the cookie specs have no family (empty set)
  // preserved: the accessor is interpolated into the regular expression unescaped, so "." matches any character
}

// src: vvaharness/detect/patterns.py:219-398 — Stage 5 detector rules; role "detector" keeps them out of Stage 0's view; every hit still goes through Stage 6 verification
fn detector_corpus():executor=code {
  return [
    { rule_id: "detector-cookie-httponly", pattern: "\.set_cookie\s*\(", cwe: "CWE-1004", kind: "cookie-flag", languages: [python],
      title: "Cookie set without the HttpOnly flag", span: "call", span_max_lines: 20,
      absent_re: "(?i)\bhttponly\s*=\s*(?!false\b|none\b|0\b)" },   // truthy only; httponly=flag is a deliberate false negative
    { rule_id: "detector-cookie-secure", pattern: "\.set_cookie\s*\(", cwe: "CWE-614", kind: "cookie-flag", languages: [python],
      title: "Cookie set without the Secure flag", span: "call", span_max_lines: 20,
      absent_re: "(?i)\bsecure\s*=\s*(?!false\b|none\b|0\b)" },      // not a bare word: that matched path="/secure/area"
    { rule_id: "detector-autoescape-off-code", pattern: "\bautoescape\s*=\s*False\b", cwe: "CWE-79", kind: "xss", languages: [python],
      title: "Template auto-escaping explicitly disabled" },
    { rule_id: "detector-autoescape-off-template", pattern: "\{%-?\s*autoescape\s+(?:false|off)\b", cwe: "CWE-79", kind: "xss", languages: [web-template],
      title: "Template block disables auto-escaping" },
    { rule_id: "detector-jinja-env-noescape", pattern: "\bEnvironment\s*\(", cwe: "CWE-79", kind: "xss", languages: [python],
      title: "Jinja2 Environment constructed without autoescape", span: "call", span_max_lines: 20, absent_re: "autoescape",
      file_re: "(?m)^[^\S\n]*(?:import\s+jinja2\b|from\s+jinja2(?:\.\w+)*\s+import\b)" },   // file must import jinja2
    { rule_id: "detector-template-safe", pattern: "\{\{[^{}]*\|\s*safe\b", cwe: "CWE-79", kind: "xss", languages: [web-template],
      title: "Template output piped through |safe" },
    { rule_id: "detector-docwrite-location", pattern: "document\.write(?:ln)?\s*\(", cwe: "CWE-79", kind: "xss", languages: [javascript, typescript, web-template],
      title: "document.write near a URL-derived value",
      near_re: "(?:\blocation\.|\bdocument\.URL\b|\bdecodeURIComponent\s*\()", near_window: 3 },   // a bare document.write("static") is not a finding
    { rule_id: "detector-form-no-csrf-post", enabled: false,   // default OFF: low precision, blind to global CSRF middleware
      pattern: "<form\b", cwe: "CWE-352", kind: "csrf", languages: [web-template], title: "POST form without a CSRF token",
      span: "block", span_end: "</form", span_max_lines: 120, present_re: "(?is)method\s*=\s*[\"']?post",
      absent_re: "(?i)csrf|hidden_tag\s*\(|authenticity_token|__RequestVerificationToken" },
    { rule_id: "detector-form-get-password", enabled: false,   // default OFF: precision not established
      pattern: "<form\b", cwe: "CWE-598", kind: "sensitive-data", languages: [web-template], title: "Password form submits with GET",
      span: "block", span_end: "</form", span_max_lines: 120, present_re: "(?is)type\s*=\s*[\"']?password", absent_re: "(?i)method\s*=\s*[\"']?post" },
    { rule_id: "detector-httpresponse-concat", pattern: "\bHttpResponse\s*\(", cwe: "CWE-79", kind: "xss", languages: [python],
      title: "HttpResponse built from string interpolation", span: "call", span_max_lines: 20,
      present_re: "(?:[\"']\s*\+|\+\s*[\"']|[\"'\s]%[\s_a-zA-Z(\"']|%\s*\(|\.format\s*\(|\bf[\"'])" },   // "+" needs a string-ish operand; "%20" excluded
    { rule_id: "detector-html-string-concat", pattern: "[\"']<(?:!--|/?(?:<_HTML_ELEMENTS>)\b[^<>]{0,160}?>)", cwe: "CWE-79", kind: "xss", languages: [python],
      title: "HTML assembled by string concatenation",
      present_re: "(?:\+\s*[A-Za-z_(]|[\"'\s]%[\s_a-zA-Z(\"']|%\s*\(|\.format\s*\(|\bf[\"']<[^\n]{0,200}\{)",
      absent_re: "(?:\b(?:escape|quote|quoteattr|sanitize|bleach|Markup)\s*\(|\bstruct\.\w+\s*\(|\b__repr__\b)",   // already-encoded output is not this defect
      absent_window: 2 }   // a line-wrapped escape(...) is also seen by the guard
  ]
  // every rule: role "detector"; xss rules carry semantic_family "html-response"; each has a one-line CWE/OWASP citation (abstracted: patterns.py:232-388 citation strings)
}
