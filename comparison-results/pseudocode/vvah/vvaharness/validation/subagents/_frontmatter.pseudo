// file: vvaharness/validation/subagents/_frontmatter.py
// Strict mini-YAML frontmatter parser for subagent .md files: only known scalar keys and block-list keys;
// any other key or a malformed line is a hard error.

@executedBy(CODE) @role(config) @stage("S11")
class Frontmatter {

    Set<String> SCALAR_KEYS = Set.of("name", "model", "description");                                // src: vvaharness/validation/subagents/_frontmatter.py:25
    Set<String> LIST_KEYS = Set.of("allowedTools", "deniedTools", "skills");                         // src: vvaharness/validation/subagents/_frontmatter.py:26

    void appendListItem(Map meta, String currentListKey, String rawLine) {
        if (currentListKey == null) throw new ValueError("list item without parent key");            // src: vvaharness/validation/subagents/_frontmatter.py:35
        String value = rawLine.rstrip().split("- ", 1)[1].strip();                                   // src: vvaharness/validation/subagents/_frontmatter.py:37
        Object bucket = meta.get(currentListKey);                                                    // src: vvaharness/validation/subagents/_frontmatter.py:38
        if (!(bucket instanceof List)) throw new TypeError("expected list for key");                 // src: vvaharness/validation/subagents/_frontmatter.py:39
        bucket.add(value);                                                                           // src: vvaharness/validation/subagents/_frontmatter.py:41
    }

    String applyKeyLine(Map meta, String rawLine) {
        Triple kv = rawLine.rstrip().partition(":");                                                 // src: vvaharness/validation/subagents/_frontmatter.py:46
        if (kv.separator.isEmpty()) throw new ValueError("malformed frontmatter line");              // src: vvaharness/validation/subagents/_frontmatter.py:47
        String key = kv.key.strip();
        String value = kv.value.strip();
        if (SCALAR_KEYS.contains(key)) {                                                             // src: vvaharness/validation/subagents/_frontmatter.py:50
            meta.put(key, value);
            return null;
        }
        if (LIST_KEYS.contains(key)) {                                                               // src: vvaharness/validation/subagents/_frontmatter.py:53
            if (!value.isEmpty()) throw new ValueError(key + " must be a block list");               // src: vvaharness/validation/subagents/_frontmatter.py:54
            meta.put(key, new List());
            return key;                                                                              // src: vvaharness/validation/subagents/_frontmatter.py:57
        }
        throw new ValueError("unknown frontmatter key: " + key);                                     // src: vvaharness/validation/subagents/_frontmatter.py:58
    }

    String classifyLine(Map meta, String currentListKey, String rawLine) {
        String line = rawLine.rstrip();                                                              // src: vvaharness/validation/subagents/_frontmatter.py:65
        if (line.strip().isEmpty()) return null;                                                     // blank line ends list context  // src: vvaharness/validation/subagents/_frontmatter.py:66
        if (line.startsWith("  - ") || line.startsWith("\t- ")) {                                    // src: vvaharness/validation/subagents/_frontmatter.py:68
            appendListItem(meta, currentListKey, rawLine);                                           // src: vvaharness/validation/subagents/_frontmatter.py:69
            return currentListKey;
        }
        return applyKeyLine(meta, rawLine);                                                          // src: vvaharness/validation/subagents/_frontmatter.py:71
    }

    // real name: parse_frontmatter
    ParsedFrontmatter parse(String text) {
        Match m = Regex.matchDotall("^---ws NL (head) NL ---ws NL (body)END", text);                 // src: vvaharness/validation/subagents/_frontmatter.py:76
        if (m == null) throw new ValueError("subagent file missing YAML frontmatter");               // src: vvaharness/validation/subagents/_frontmatter.py:78
        Map meta = new Map();
        String currentListKey = null;
        for (String raw : m.group(1).splitlines()) currentListKey = classifyLine(meta, currentListKey, raw); // src: vvaharness/validation/subagents/_frontmatter.py:82
        return new ParsedFrontmatter(meta, m.group(2).strip());                                      // src: vvaharness/validation/subagents/_frontmatter.py:84
    }
}
