# vvaharness/validation/subagents/_loader.py

Loads the bundled reviewer-persona definitions (`*.md` in this package) as subagent definitions, with optional name filter, per-persona model overrides, a tool-narrowing override that always keeps the fact tools, a prompt suffix and a model-call cap.

Source: `vvaharness/validation/subagents/_loader.py` (lines 1-120)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo`

// src: vvaharness/validation/subagents/_loader.py:68-111
fn load_agents(names?, model_overrides?, tools_override?, prompt_suffix?, max_model_calls?):executor=code {
  wanted = if (names != null) set(names) else null
  for each path in bundled .md files of vvaharness.validation.subagents {   // directory order
    [meta, prompt] = _frontmatter.parse_frontmatter(text of path)
    subagent = _build_subagent_definition(meta, prompt)
    if (wanted != null && subagent.name not in wanted) continue
    if (subagent.name in model_overrides) subagent.model = model_overrides[subagent.name]
    if (tools_override != null) {
      // narrows only: a tool the persona does not declare is never added; FACT_TOOLS are never dropped
      subagent.tools = [t for each t in (subagent.tools || []) if t in tools_override || t in FACT_TOOLS]
    }
    if (prompt_suffix) subagent.prompt = rstrip(subagent.prompt) + "\n\n" + prompt_suffix
    subagent.max_model_calls = max_model_calls || null   // "0 and None both leave the persona unmetered"
    result[subagent.name] = subagent
  }
  // src: _loader.py:114-120
  require wanted is null or every wanted name was loaded => throw ValueError("requested subagents not found: <sorted missing>")
  return result
}

// src: vvaharness/validation/subagents/_loader.py:31-57
fn _build_subagent_definition(meta, prompt):executor=code {
  require meta.name is a non-empty string => throw ValueError("subagent frontmatter missing 'name'")
  require meta.description is a non-empty string => throw ValueError("subagent <name> missing 'description'")
  return SubagentDefinition {
    name, description, prompt,
    tools: meta.allowedTools as tuple or null when empty,
    disallowed_tools: meta.deniedTools as tuple or null when empty,
    model: meta.model if a string else null,
    skills: meta.skills as tuple or null when empty,
    response_model: PersonaReport   // structured persona output
  }
}
