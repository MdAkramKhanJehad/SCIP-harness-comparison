// ---------------------------------------------------------------------------
// Entry: load
// ---------------------------------------------------------------------------

// src: vvaharness/config/__init__.py:868-900
fn load(path = "config.yaml"):executor=code {
  p = Path(path)
  raw = read_primary(p)
  raw = _deep_merge(_STEP_DEFAULTS, raw)         // profile values win; the table only fills gaps
  local = sibling of p named LOCAL_OVERLAY_NAME  // "config.local.yaml" next to the --config path, never the scanned target
  [over, log_overlay] = _local_overlay(local)
  if (over != null) raw = _deep_merge(raw, over) // overlay wins over the profile
  data = _expand_tree(raw)
  _check_refusal_retries(data.refusal_retries, p)
  if (over != null && log_overlay) {
    // banner printed after expansion so endpoint and TLS entries show resolved values
    console "config overlay: $local applied (overrides: ${ _overlay_override_entries(_leaf_paths(over), data) joined by \", \" or \"(empty)\" })"
  }
  cfg = Config(data)
  cfg._data._config_dir = absolute parent directory of p   // anchor for input-style relative paths (policy_file, TLS certs, inject.*)
  return cfg
}

// src: vvaharness/config/__init__.py:839-865
fn read_primary(path):executor=code {
  p = Path(path)
  require p exists => throw ConfigPathError("config not found: $p" + _path_context(p))
  require p is a file => throw ConfigPathError("config path is not a file: ...")
  require p is readable => throw ConfigPathError("config is not readable: ...")
  try raw = yaml.safe_load(read p as UTF-8) || {};   // empty or all-comment file reads as {}
  catch yaml.YAMLError => throw ConfigPathError("config at $p is not valid YAML: ...")
  catch UnicodeDecodeError => throw ConfigPathError("config at $p is not valid UTF-8: ...")
  require raw is a mapping => throw ConfigPathError("config $p must be a YAML mapping, got <type>")
  return raw   // no overlay, no environment expansion
}

// src: vvaharness/config/__init__.py:832-836
fn _path_context(p):executor=code {
  return if (p is absolute) "" else " (resolved: <absolute p>, cwd: <current directory>)"
}

// src: vvaharness/config/__init__.py:121-128
fn _deep_merge(base, over):executor=code {
  out = shallow copy of base
  for each (k, v) in over {
    out[k] = if (v is a dict && out[k] is a dict) _deep_merge(out[k], v) else v   // lists and scalars replace
  }
  return out
}
// src: vvaharness/config/__init__.py:121-128
// preserved: only the top level is copied; a nested _STEP_DEFAULTS block that the profile does not touch (for example step3, step9, pricing)
//   is the same object in every loaded config. The table's own comment (lines 259-263) makes allowed_tools a tuple for this aliasing reason.

// ---------------------------------------------------------------------------
// Local overlay (config.local.yaml): trust gate and visible banner
// ---------------------------------------------------------------------------

// src: vvaharness/config/__init__.py:746-764
fn _local_overlay(local):executor=code {
  if (!local exists) return [null, false]
  key = resolved local path
  log_overlay = key not in _logged_overlays
  _logged_overlays.add(key)
  if (environment variable NO_LOCAL_CONFIG_ENV is set to any non-empty value) {
    if (log_overlay) console "config overlay: $local present but SKIPPED (VVAHARNESS_NO_LOCAL_CONFIG set)"
    return [null, log_overlay]
  }
  _require_overlay_trust(local, log_overlay)
  over = yaml.safe_load(read local) || {}
  require over is a mapping => throw ValueError("config $local must be a YAML mapping, got <type>")
  return [over, log_overlay]
}

// src: vvaharness/config/__init__.py:730-743
fn _require_overlay_trust(local, log_overlay):executor=code {
  if (platform has no geteuid) {   // non-POSIX
    if (log_overlay) console "config overlay: $local ownership unverified (non-POSIX platform)"
    return
  }
  require _local_overlay_trusted(local) => throw ConfigPolicyError("config overlay $local is not trusted: it must be owned by the invoking user (or root) and not group/world-writable. ...")
}

// src: vvaharness/config/__init__.py:716-727
fn _local_overlay_trusted(path):executor=code {
  try st = stat(path); catch OSError => return false
  if (geteuid exists && st.owner not in [effective user id, 0]) return false
  return geteuid is absent || !(st.mode has group-write or world-write)
  // file-only check: a file swapped in through a writable parent is attacker-owned and fails the owner check
}

// src: vvaharness/config/__init__.py:767-776
fn _leaf_paths(tree, prefix = ()):executor=code {
  // dotted key path of every leaf; an empty dict counts as a leaf
  return for each (k, v) in tree: if (v is a non-empty dict) _leaf_paths(v, prefix + k) else "prefix.k"
}

// src: vvaharness/config/__init__.py:779-785
fn _resolved_leaf(data, path):executor=code {
  walk data by the dotted segments of path; return null when a non-dict is met
}

// src: vvaharness/config/__init__.py:827-829
fn _overlay_override_entries(leaves, resolved):executor=code {
  return for each path in sorted(leaves): _override_entry(path, resolved)
}

// src: vvaharness/config/__init__.py:812-824
fn _override_entry(path, resolved):executor=code {
  value = _resolved_leaf(resolved, path)
  match (path) {
    case in CREDENTIAL_DESTINATIONS => "$path (set)" or "$path (unset)"   // a credential value is never printed
    case in ENDPOINT_KEYS => "$path -> ${ _endpoint_display(value) }"     // host or host:port only
    case in TLS_ROUTING_KEYS || last segment of path in TLS_ROUTING_KEYS => "$path=$value"
    default => path                                                      // key name only
  }
}

// src: vvaharness/config/__init__.py:788-809
fn _endpoint_display(value):executor=code {
  raw = trimmed string of value
  if (raw is empty) return "(unset)"
  try { parts = urlsplit(if (raw contains "//") raw else "//$raw") }   // scheme-less values parsed as an authority
  catch ValueError => return "(unparseable)"
  if (parts.hostname is empty) return "(unparseable)"
  return if (parts.port) "${parts.hostname}:${parts.port}" else parts.hostname   // never userinfo, never path
}

// ---------------------------------------------------------------------------
// Environment expansion and the secret-name policy
// ---------------------------------------------------------------------------

// src: vvaharness/config/__init__.py:91-93
fn _expand_tree(tree, path = ()):executor=code {
  return for each (k, v) in tree: k => _expand(v, path + k)
}

// src: vvaharness/config/__init__.py:81-88
fn _expand(val, path):executor=code {
  match (val) {
    case String => replace every _ENV_PAT match m with _expand_env(m, path)
    case dict => for each (k, v): k => _expand(v, path + k)
    case list => for each v: _expand(v, path)   // list items keep the parent key path
    default => val
  }
}

// src: vvaharness/config/__init__.py:61-78
fn _expand_env(m, path):executor=code {
  [name, default] = [m.group(1), m.group(2)]
  key_path = path joined by "."
  // refused on the variable NAME alone, whether set or unset
  require !(constants.is_secret_var_name(name) && key_path not in CREDENTIAL_DESTINATIONS)
    => throw ConfigPolicyError("config key '$key_path' interpolates environment variable '$name', whose name matches a secret pattern; secret-named variables may expand only into: <sorted CREDENTIAL_DESTINATIONS>. ...")
  val = environment[name]
  if (val is non-empty) return val
  return default or, when absent, ""   // POSIX ${VAR:-default}: default used when unset OR set-but-empty
}

// src: vvaharness/config/__init__.py:903-915
_REFUSAL_RETRIES_MAX = 1
fn _check_refusal_retries(value, p):executor=code {
  // bool is excluded: `true` must not read as 1
  require value == null || (value is an int && value is not a bool && 0 <= value <= _REFUSAL_RETRIES_MAX)
    => throw ConfigPolicyError("config $p: refusal_retries must be an integer from 0 to 1 (got <value>); each extra resend repeats a prompt the model already refused")
}

// ---------------------------------------------------------------------------
// Attribute wrapper
// ---------------------------------------------------------------------------

// src: vvaharness/config/__init__.py:96-118
Config {
  _data: dict
  // cfg.a.b: attribute access returns a nested Config for a dict value, the raw value otherwise
  // missing key -> AttributeError (so getattr(cfg.x, key, fallback) falls back); dunder names and "_data" never re-enter _data
  // cfg[k] -> _data[k]
}

// ---------------------------------------------------------------------------
// Per-scan Stage 1 overlay
// ---------------------------------------------------------------------------

// src: vvaharness/config/__init__.py:966-966
_MAX_STEP1_OVERLAY_BYTES = 1 * 1024 * 1024

// src: vvaharness/config/__init__.py:969-1008
fn apply_step1_overlay(cfg, path, expand = true):executor=code {
  p = Path(path)
  require !is_network_path(p) => throw ValueError("step1 overlay must be a local path; refusing network/UNC path ... (reading it could leak credentials over SMB)")
    // checked before the first filesystem touch
  if (!p is a file) return [cfg, false]
  require size(p) <= _MAX_STEP1_OVERLAY_BYTES => throw ValueError("step1 overlay $p is <size> bytes, exceeding the 1048576-byte limit; ...")
  try text = read p as UTF-8; catch UnicodeDecodeError => throw ValueError("step1 overlay $p is not valid UTF-8 text ...")
  try over = yaml.safe_load(text) || {}; catch yaml.YAMLError => throw ValueError("step1 overlay $p is not valid YAML: ...")
  require over is a mapping => throw ValueError("step1 overlay $p must be a YAML mapping")
  if (keys(over) == {"step1"} && over.step1 is a dict) over = over.step1   // bare-key file or a file wrapped in `step1:`
  if (expand) over = _expand_tree(over, ("step1",))
  // expand=false keeps ${...} literal: used for the model-written auto overlay, which must never reach the operator's environment
  cfg._data.step1 = _append_merge(cfg._data.step1 || {}, over)
  return [cfg, true]
}

// src: vvaharness/config/__init__.py:932-946
fn _append_merge(base, over):executor=code {
  out = shallow copy of base
  for each (k, v) in over {
    cur = out[k]
    match {
      case v is a dict && cur is a dict => out[k] = _replace_merge(cur, v)        // for example config_dedup: latest overlay wins
      case v is a list && cur is a list => out[k] = cur + [x in v where x not in cur]   // exclude_dirs / exts / globs append, de-duplicated
      default => out[k] = v                                                          // scalars replace
    }
  }
  return out
}

// src: vvaharness/config/__init__.py:918-929
fn _replace_merge(base, over):executor=code {
  out = shallow copy of base
  for each (k, v) in over {
    out[k] = if (v is a dict && out[k] is a dict) _replace_merge(out[k], v) else v   // lists replace outright
  }
  return out
}

// src: vvaharness/config/__init__.py:949-960
fn is_network_path(path):executor=code {
  s = trimmed string of path
  if (s starts with "\\\\" || s starts with "//") return true
  return PureWindowsPath(s).drive starts with "\\\\"   // evaluated with Windows rules on every operating system
}
