// file: vvaharness/validation/cli/_run.py
// Sequential validation, state-store provenance and resume, case writeback and report augmentation.
// A refusal/session failure outranks verdicts when choosing the process exit code.

@executedBy(CODE) @role(types)
record ValidationSelection(List<String> caseIds = null, Integer maxFindings = null, boolean resume = false) { }

// Real name ValidationRun (frozen dataclass): the shared state of one validation run, threaded through the per-case loop.
@executedBy(CODE) @role(types)
record ValidationRunState(Path repo, Path workspaceRoot, Config config, String runId, Provenance provenance, ScoringPolicy policy, boolean resume = false) { }

@executedBy(CODE) @role(types)
record ValidationRunResult(int exitCode, List<Verdict> verdicts, RunMetadata metadata) { }

@executedBy(CODE) @role(types)
record ValidationCompletedCase(LoadedValidationCase loaded, Verdict verdict, ValidationResult row, boolean sessionFailed) { }

// Real name SessionLogPaths (NamedTuple): where to read a session log from, and where its redacted copy will be written.
@executedBy(CODE) @role(types)
record ValidationSessionLogPaths(Path source, Path destination) { }

@executedBy(CODE) @role(pipeline) @stage("S11")
class ValidationCliRun {
    @src("vvaharness/validation/cli/_run.py:95")
    String safe(String id) {
        return replaceRegex(id, "[^\\w\\-]", "_").head(80);
    }
    @src("vvaharness/validation/cli/_run.py:100")
    Pair<String, String> engineIdentity(Config config) {
        return new Pair(str(config.agent.model), HARNESS_REGISTRY + ":" + config.agent.via);
    }
    @src("vvaharness/validation/cli/_run.py:105")
    String stepKey(String id, String model, String backend) {
        return stepKeyFor(VALIDATE_PREFIX, "vvaharness.validation", harnessVersion(), id, model, backend);
    }
    @src("vvaharness/validation/cli/_run.py:113")
    ValidationSessionLogPaths sessionLogDest(Path workspace, LoadedValidationCase loaded) {
        Path src = workspace.resolve("logging/orchestrator/session.jsonl"); if (!src.exists()) return null;
        return new ValidationSessionLogPaths(src, loaded.path.parent.resolve("validation_session_" + safe(ValidationCaseLoader.caseId(loaded)) + ".jsonl"));
    }
    @src("vvaharness/validation/cli/_run.py:122")
    Path persistSessionLog(Path workspace, LoadedValidationCase loaded) {
        ValidationSessionLogPaths paths = sessionLogDest(workspace, loaded); if (paths == null) return null;
        try { paths.destination.writeText(redact(paths.source.readText("utf-8", errors="replace")), "utf-8"); }
        catch (OSError | ValueError e) { paths.destination.unlink(missingOk=true); return null; }
        return paths.destination;
    }
    @src("vvaharness/validation/cli/_run.py:138")
    void printResult(ValidationResult row) {
        print(row.trackingId, row.reasonForDecision, row.fixConfidence); if (truthy(row.justification)) print(row.justification);
    }
    @src("vvaharness/validation/cli/_run.py:178")
    Provenance measured(Provenance base, Instant started, Spend before) {
        Pair spend = reportedBetween(before, tokenSpend()); return base.copyWith("started", started, "ended", utcNow(), "usd", spend.first, "turns", spend.second);
    }
    @src("vvaharness/validation/cli/_run.py:185")
    void record(LoadedValidationCase loaded, Verdict verdict, Path workspace) {
        Path log = persistSessionLog(workspace, loaded); if (log != null) logInfo("session log", log);
        Object judged = writeBackVerdict(loaded.caseValue, verdict, loaded.path); if (judged != null) logInfo("case updated", judged.state);
    }
    @src("vvaharness/validation/cli/_run.py:145")
    ValidationCompletedCase runPlan(LoadedValidationCase loaded, ValidationRunState run, Path workspace, Theta θ) {
        Instant started = utcNow(); Spend before = tokenSpend(); String sid = uuidHex();
        Object latest = loaded.caseValue.attempts.last(); stageWorkspace(run.repo, workspace, latest.remediation.diff);
        FixValidationPlan plan = new FixValidationPlan(ValidationCaseLoader.caseId(loaded), sid, buildManifest(loaded.caseValue, sid), workspace, workspace, run.provenance, run.policy);
        ValidationPlanOutcome outcome = runAsync(() -> ValidationExecutionPipeline.executePlan(plan, run.config, false, new RunMetadata(totalFindings=1), θ));
        Object collected = outcome.findings.get(0);
        Verdict verdict = buildVerdict(loaded.caseValue, workspace, measured(run.provenance, started, before), run.policy, outcome.sessionFailed);
        record(loaded, verdict, workspace); return new ValidationCompletedCase(loaded, verdict, collected.row, outcome.sessionFailed);
    }
    @src("vvaharness/validation/cli/_run.py:198")
    ValidationCompletedCase validateOne(LoadedValidationCase loaded, ValidationRunState run, Theta θ) {
        if (loaded.caseValue.attempts.isEmpty()) { logWarning("no remediation attempt"); return null; }
        Path workspace = run.workspaceRoot.resolve(safe(ValidationCaseLoader.caseId(loaded)));
        try { assertRemediationApplied(run.repo, loaded.caseValue.attempts.last().remediation.filesTouched); }
        catch (IngestError e) { logWarning(e); return null; }
        try { return runPlan(loaded, run, workspace, θ); } finally { removeTree(workspace, ignoreErrors=true); }
    }
    @src("vvaharness/validation/cli/_run.py:215")
    ValidationResult resumeHit(ValidationRunState run, String step) {
        return loadCheckpoint(run.workspaceRoot, run.runId, step);
    }
    @src("vvaharness/validation/cli/_run.py:249")
    Verdict noVerdict() {
        return new Verdict(INCONCLUSIVE, "checkpoint exists but case records no verdict", null, new Provenance("vvaharness.validation", harnessVersion()));
    }
    @src("vvaharness/validation/cli/_run.py:240")
    ValidationCompletedCase resumed(LoadedValidationCase loaded, ValidationResult cached) {
        Object latest = loaded.caseValue.attempts.isEmpty() ? null : loaded.caseValue.attempts.last(); Object verdict = latest == null ? null : latest.verdict;
        return new ValidationCompletedCase(loaded, verdict == null ? noVerdict() : verdict, cached, verdict == null);
    }
    @src("vvaharness/validation/cli/_run.py:221")
    ValidationCompletedCase processCase(LoadedValidationCase loaded, ValidationRunState run, Theta θ) {
        Pair engine = engineIdentity(run.config); String step = stepKey(ValidationCaseLoader.caseId(loaded), engine.first, engine.second);
        if (run.resume) { ValidationResult cached = resumeHit(run, step); if (cached != null && cached.trackingId == ValidationCaseLoader.caseId(loaded)) return resumed(loaded, cached); }
        ValidationCompletedCase result = validateOne(loaded, run, θ); if (result != null) saveCheckpoint(run.workspaceRoot, run.runId, step, result.row);
        return result;
    }
    @src("vvaharness/validation/cli/_run.py:261")
    Pair runCases(List<LoadedValidationCase> cases, ValidationRunState run, Theta θ) {
        int failures = 0; List validated = new List();
        for (LoadedValidationCase loaded : cases) {
            ValidationCompletedCase result = processCase(loaded, run, θ);
            if (result == null) { failures++; continue; }
            if (result.sessionFailed) { logWarning("FAILED", result.row.reasonForDecision); failures++; } else printResult(result.row);
            validated.add(result);
        }
        return new Pair(failures, validated);
    }
    @src("vvaharness/validation/cli/_run.py:302")
    void cleanupWorkspace(Path root) {
        try { removeTree(root); } catch (FileNotFoundError e) { } catch (OSError e) { logWarning("could not remove workspace", e); }
    }
    @src("vvaharness/validation/cli/_run.py:314")
    boolean anyOwned(List<Path> paths, Set owned) {
        for (Path path : paths) {
            String id;
            try { id = ValidationCaseLoader.caseId(ValidationCaseLoader.loadCase(path)); } catch (OSError | ValueError | ValidationError e) { continue; }
            if (owned.contains(new Pair(id, path.parent.resolve()))) return true;
        }
        return false;
    }
    @src("vvaharness/validation/cli/_run.py:326")
    int emptySelectionRc(Path repo, Set owned) {
        List paths = ValidationCaseLoader.discoverCases(repo);
        if (paths.isEmpty() || (owned != null && !anyOwned(paths, owned))) { logWarning("no owned validatable cases"); return 1; }
        logInfo("nothing to validate; cases already terminal"); return 0;
    }
    @src("vvaharness/validation/cli/_run.py:352")
    void pruneOrphans(Path repo, String runId, String model, String backend) {
        List<String> ids = ValidationCaseLoader.allCaseIds(repo); if (ids == null) return;
        pruneStaleSteps(runId, VALIDATE_PREFIX, ids.map(id -> stepKey(id, model, backend)));
    }
    @src("vvaharness/validation/cli/_run.py:363")
    Provenance provenanceFor(Config config) {
        Pair engine = engineIdentity(config); return new Provenance("vvaharness.validation", harnessVersion(), engine.first, engine.second);
    }
    @src("vvaharness/validation/cli/_run.py:375")
    ValidationRunResult runValidation(Path repo, ValidationSelection selection, Path workspaceRoot, Config config, Path reportMd, Theta θ) {
        RunMetadata meta = new RunMetadata(); String runId = runIdFor(repo); registerRun(runId, str(repo.resolve())); Set owned = ownedCases(runId);
        List cases;
        try { cases = ValidationCaseLoader.selectCases(repo, selection.caseIds, selection.maxFindings, owned, θ); }
        catch (IngestError | UnsafeArtifactDir e) { meta.errors.add(str(e)); return new ValidationRunResult(1, List.of(), meta); }
        if (cases.isEmpty()) return new ValidationRunResult(emptySelectionRc(repo, owned), List.of(), meta);
        Pair engine = engineIdentity(config); pruneOrphans(repo, runId, engine.first, engine.second);
        ValidationRunState run = new ValidationRunState(repo, workspaceRoot, config, runId, provenanceFor(config), ValidationScoringConstants.policy(θ), selection.resume);
        Pair result = runCases(cases, run, θ);
        meta.totalFindings = cases.size(); meta.findingsProcessed = result.second.size(); meta.findingsFailed = result.first;
        augmentReports(repo, result.second.map(item -> new ValidatedFinding(item.loaded.caseValue.finding, item.row, item.sessionFailed)), reportMd);
        cleanupWorkspace(workspaceRoot);
        List verdicts = result.second.map(item -> item.verdict); return new ValidationRunResult(result.first > 0 ? 1 : rcForVerdicts(verdicts), verdicts, meta);
    }
}
