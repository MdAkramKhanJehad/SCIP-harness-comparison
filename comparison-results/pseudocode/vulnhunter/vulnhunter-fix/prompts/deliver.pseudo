// file: vulnhunter-fix/prompts/deliver.md
// Phase 5 (Deliver) prompt for the vulnhunter-fix orchestrating session: fork-mode delivery into a private fork
// (setup, dedup, triage, issues, PRs, tracking issue, cleanup) or in-place delivery (one PR per cluster on origin),
// both behind mandatory pre-delivery gates (honesty guards, completeness checklist, run-gates.py).

@executedBy(MODEL) @role(prompt) @stage("Phase5")
class PromptsDeliver {

    // ---------------------------------------------------------------- entry
    // Called by VulnhunterFixSkill.run after PromptsVerify.run returned its summary.
    @executedBy(MIXED)
    Report run(Mode mode, Summary verified, Theta θ) {
        Prompt p = modeDependentDelivery(θ);
        if (mode == Mode.FORK) {
            assert θ["p.deliver.fork_delivery_target_private_fork"];                                // src: vulnhunter-fix/prompts/deliver.md:7
            return forkDelivery(verified, θ);
        }
        assert θ["p.deliver.in_place_delivery_target_origin"];                                      // src: vulnhunter-fix/prompts/deliver.md:8
        return inPlaceDelivery(verified, θ);
    }

    Prompt modeDependentDelivery(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.deliver.fork_delivery_target_private_fork"]);                                   // src: vulnhunter-fix/prompts/deliver.md:7
        p.rule(θ["p.deliver.in_place_delivery_target_origin"]);                                     // src: vulnhunter-fix/prompts/deliver.md:8
        p.must(θ["p.deliver.deliver_git_gh_failure_stop"]);                                         // STOP on tls / OSStatus / sandbox denial / unexpected non-zero; no retry, no substitution  // src: vulnhunter-fix/prompts/deliver.md:10
        p.forbid(θ["p.deliver.no_upstream_until_user_decides"]);                                    // src: vulnhunter-fix/prompts/deliver.md:14
        return p;
    }

    // Wraps every gh / git call in this phase (both modes).
    @executedBy(MODEL)
    Result ghOrGit(String cmd, Theta θ) {
        Result r = Shell.run(cmd);
        if (r.failed() && θ["p.deliver.deliver_git_gh_failure_stop"]) {                            // src: vulnhunter-fix/prompts/deliver.md:10
            askUserToRunInOwnTerminal(cmd);                                                          // no retry, no curl/git push substitution, no batching  // src: vulnhunter-fix/prompts/deliver.md:313
            r = waitForUserPaste();
        }
        return r;
    }

    // ================================================================ FORK MODE
    @executedBy(MODEL)
    Report forkDelivery(Summary s, Theta θ) {
        forkSetup(θ);
        boolean rerun = detectRerun(s, θ);
        Map<Finding, Bucket> buckets = new Map();
        for (Finding f : s.allFindings()) buckets.put(f, triage(f, θ));
        List<Delivered> out = new List();
        for (Finding f : s.findingsOf("VERIFIED", "NEEDS_MANUAL_REVIEW", "CANNOT_AUTO_FIX")) {
            int issue = createFindingIssue(f, θ);                                                    // Step 1
            Integer pr = null;
            if (buckets.get(f) != Bucket.ISSUE_ONLY && θ["p.deliver.pr_only_for_verified_or_review"].contains(f.status)) { // src: vulnhunter-fix/prompts/deliver.md:138
                pr = createForkPr(f, issue, buckets.get(f), θ);                                      // Step 2
                linkPrBackToIssue(f, issue, pr, θ);                                                  // Step 3
                finalizationIssue(f, pr, θ);                                                         // Step 4
            }
            out.add(new Delivered(f, issue, pr, buckets.get(f)));
        }
        int tracking = trackingIssue(s, out, θ);                                                     // Step 5
        labelHumanReviewPrs(tracking, θ);                                                            // Step 5b
        deleteNotNeededBranches(s, tracking, θ);                                                     // Step 5c
        Report r = forkReport(out, tracking, θ);                                                     // Step 6
        forkCleanup(θ);
        return r;
    }

    // Step 0: configure fork privacy and access.
    @executedBy(MODEL)
    void forkSetup(Theta θ) {
        ghOrGit("gh repo edit <fork_org>/<fork_repo> --visibility " + θ["p.deliver.fork_set_private"] + " --accept-visibility-change-consequences", θ); // src: vulnhunter-fix/prompts/deliver.md:26
        if (θ["p.deliver.fork_enable_issues"]) ghOrGit("gh repo edit <fork_org>/<fork_repo> --enable-issues", θ); // src: vulnhunter-fix/prompts/deliver.md:31
        for (Collaborator c : readJson("${SKILL_DIR}/collaborators.json").collaborators) {           // src: vulnhunter-fix/prompts/deliver.md:40
            assert θ["p.deliver.fork_add_collaborators"].contains(c.role);                         // admin | write | read  // src: vulnhunter-fix/prompts/deliver.md:34
            ghOrGit("gh api repos/<fork_org>/<fork_repo>/collaborators/" + c.username + " -X PUT -f permission=" + c.role, θ); // src: vulnhunter-fix/prompts/deliver.md:37
        }
    }

    // Deduplication: two-tier lookup before creating any issue or PR.
    @executedBy(MODEL)
    Artifact dedupOrCreate(Finding f, String kind, Body body, Theta θ) {
        List<String> tiers = θ["p.deliver.dedup_before_create"];                                    // idempotency key, then VULN ID  // src: vulnhunter-fix/prompts/deliver.md:51
        String marker = θ["p.deliver.dedup_key_marker"];                                            // vulnfix-key = SHA-256(location | primary_cwe | root_cause)[:16]  // src: vulnhunter-fix/prompts/deliver.md:53
        String state = θ["p.deliver.dedup_search_state_all"];                                       // open AND closed  // src: vulnhunter-fix/prompts/deliver.md:58
        Artifact m = searchBodies(kind, marker.with(f.vulnfixKey), state);
        if (m == null && θ["p.deliver.dedup_fallback_vuln_id_title"]) {                            // src: vulnhunter-fix/prompts/deliver.md:54
            m = ghOrGit("gh " + kind + " list --repo <fork_org>/<fork_repo> --state all --search VULN-NNN --json number,title,state,url", θ).first(); // src: vulnhunter-fix/prompts/deliver.md:58
        }
        if (m == null) {
            if (θ["p.deliver.dedup_no_match_create"]) return create(kind, body.embed(marker));      // src: vulnhunter-fix/prompts/deliver.md:64
        } else if (m.state == "open") {
            if (θ["p.deliver.dedup_open_match_update"]) { m.updateBodyPreservingMarker(body); return m; } // skip creation  // src: vulnhunter-fix/prompts/deliver.md:65
        } else if (m.state == "closed") {
            if (θ["p.deliver.dedup_closed_match_reopen"]) {                                        // src: vulnhunter-fix/prompts/deliver.md:66
                ghOrGit("gh " + kind + " reopen " + m.number + " --repo <fork_org>/<fork_repo>", θ); // src: vulnhunter-fix/prompts/deliver.md:70
                m.updateBodyPreservingMarker(body);                                                  // src: vulnhunter-fix/prompts/deliver.md:71
                return m;
            }
        }
        return m;
    }

    // Re-run vs new-report detection.
    @executedBy(MODEL)
    boolean detectRerun(Summary s, Theta θ) {
        String prior = latestTrackingIssueBody().extract(θ["p.deliver.rerun_detection_marker"]);    // vulnfix-report-id: <results-dir-name>  // src: vulnhunter-fix/prompts/deliver.md:83
        boolean rerun = (prior != null && prior == s.reportId);
        if (rerun && θ["p.deliver.rerun_close_orphans"]) {                                          // src: vulnhunter-fix/prompts/deliver.md:84
            for (Pr pr : openPrs("vulnfix/*")) if (!s.contains(pr.vulnfixKey, pr.vulnId)) ghOrGit("gh pr close " + pr.number, θ);
        }
        if (!rerun && θ["p.deliver.new_report_preserve_prs"]) {                                    // only exact-match dupes updated via dedup  // src: vulnhunter-fix/prompts/deliver.md:85
            // preserve existing PRs
        }
        return rerun;
    }

    // Delivery triage (fork only): exactly one of three buckets.
    @executedBy(MODEL)
    Bucket triage(Finding f, Theta θ) {
        List<String> buckets = θ["p.deliver.triage_exactly_one_bucket"];                            // Ready PR | Draft PR | Issue only  // src: vulnhunter-fix/prompts/deliver.md:93
        if (f.status == "FIX_NOT_NEEDED") return choose(θ["p.deliver.status_to_bucket_fix_not_needed"]); // no artifact, branch deleted  // src: vulnhunter-fix/prompts/deliver.md:105
        if (f.status == "CANNOT_AUTO_FIX") return choose(θ["p.deliver.status_to_bucket_cannot_auto_fix"]); // Issue only  // src: vulnhunter-fix/prompts/deliver.md:104
        if (f.status == "NEEDS_MANUAL_REVIEW") return choose(θ["p.deliver.status_to_bucket_manual_review"]); // Draft PR  // src: vulnhunter-fix/prompts/deliver.md:103
        if (f.status == "VERIFIED" && θ["p.deliver.status_to_bucket_verified"]) {                  // src: vulnhunter-fix/prompts/deliver.md:102
            if (θ["p.deliver.issue_only_criteria"] && (f.designOutstanding() || f.setupNonTrivial())) return Bucket.ISSUE_ONLY; // src: vulnhunter-fix/prompts/deliver.md:99
            if (θ["p.deliver.draft_pr_criteria"] && f.needsSmallWellDefinedSetup()) {              // src: vulnhunter-fix/prompts/deliver.md:98
                if (unsureVsIssueOnly(f)) return choose(θ["p.deliver.triage_tiebreak_issue_only"]); // prefer Issue only  // src: vulnhunter-fix/prompts/deliver.md:107
                return Bucket.DRAFT_PR;
            }
            if (θ["p.deliver.ready_pr_criteria"] && f.fullyNonBreaking()) return Bucket.READY_PR;  // src: vulnhunter-fix/prompts/deliver.md:97
        }
        return Bucket.ISSUE_ONLY;                                                                    // unclear: fallback not stated
    }

    // Step 1: create the per-finding issue (before any PR).
    @executedBy(MODEL)
    int createFindingIssue(Finding f, Theta θ) {
        assert θ["p.deliver.issue_per_finding_first"];                                              // src: vulnhunter-fix/prompts/deliver.md:115
        Prompt body = new Prompt();
        body.checklist(θ["p.deliver.issue_body_standalone"]);                                       // what, how proven, proposed fix, current status  // src: vulnhunter-fix/prompts/deliver.md:125
        body.forbid(θ["p.deliver.issue_no_exploit_code"]);                                          // src: vulnhunter-fix/prompts/deliver.md:127
        body.choose(θ["p.deliver.issue_status_values"]);                                            // src: vulnhunter-fix/prompts/deliver.md:129
        if (f.status == "CANNOT_AUTO_FIX") body.rule(θ["p.deliver.cannot_auto_fix_issue_extras"]); // src: vulnhunter-fix/prompts/deliver.md:131
        descriptionCompletenessIssue(body, f, θ);
        predeliveryGates(f, θ);                                                                      // before any gh issue create
        Artifact a = dedupOrCreate(f, "issue", body.withTitle(θ["p.deliver.issue_title_format"]).withLabels(θ["p.deliver.issue_labels"]), θ); // src: vulnhunter-fix/prompts/deliver.md:120
        return a.number;                                                                             // src: vulnhunter-fix/prompts/deliver.md:136
    }

    // Step 2: create PR (VERIFIED / NEEDS_MANUAL_REVIEW only).
    @executedBy(MODEL)
    int createForkPr(Finding f, int issue, Bucket b, Theta θ) {
        if (θ["p.deliver.predelivery_gates_first_fork"]) predeliveryGates(f, θ);                   // src: vulnhunter-fix/prompts/deliver.md:140
        String base = θ["p.deliver.fork_pr_base_main_in_fork"];                                     // main within the fork, NOT upstream  // src: vulnhunter-fix/prompts/deliver.md:144
        Prompt body = new Prompt();
        body.format(θ["p.deliver.pr_body_required_items_fork"]);                                    // Closes #N first line, summary table, exploit desc, test code, fix, RED->GREEN  // src: vulnhunter-fix/prompts/deliver.md:164
        if (b == Bucket.DRAFT_PR) body.must(θ["p.deliver.draft_pr_setup_required_section"]);       // src: vulnhunter-fix/prompts/deliver.md:171
        descriptionCompletenessPr(body, f, b, θ);
        String draft = (b == Bucket.DRAFT_PR && θ["p.deliver.draft_flag_only_draft_bucket"]) ? "--draft" : ""; // src: vulnhunter-fix/prompts/deliver.md:144
        if (θ["p.deliver.never_deliver_upstream"]) assert repo == "<fork_org>/<fork_repo>";         // src: vulnhunter-fix/prompts/deliver.md:289
        Artifact a = dedupOrCreate(f, "pr", body.withTitle(θ["p.deliver.pr_title_format_fork"]).withArgs("--head", f.branch, "--base", base, draft), θ); // src: vulnhunter-fix/prompts/deliver.md:151
        return a.number;
    }

    // Step 3
    @executedBy(MODEL)
    void linkPrBackToIssue(Finding f, int issue, int pr, Theta θ) {
        if (!θ["p.deliver.link_pr_back_to_issue"]) return;                                          // src: vulnhunter-fix/prompts/deliver.md:177
        String url = ghOrGit("gh pr view --repo <fork_org>/<fork_repo> " + f.branch + " --json url -q .url", θ).out; // src: vulnhunter-fix/prompts/deliver.md:179
        ghOrGit("gh issue comment " + issue + " --repo <fork_org>/<fork_repo> --body 'Automated fix submitted: " + url + "'", θ); // src: vulnhunter-fix/prompts/deliver.md:180
    }

    // Step 4: finalization issues for backward-compatible breaking-change fixes.
    @executedBy(MODEL)
    void finalizationIssue(Finding f, int pr, Theta θ) {
        if (!f.isBackwardCompatibleBreakingChange()) return;
        Prompt body = new Prompt().checklist(θ["p.deliver.finalization_issue_fields"]);             // introducing PR, condition, code to remove, final interface, registrations  // src: vulnhunter-fix/prompts/deliver.md:196
        ghOrGit("gh issue create --repo <fork_org>/<fork_repo> --title 'Pending Finalization: VULN-NNN — Remove legacy fallback' --body-file .work/delivery/finalize-body.md --label " + θ["p.deliver.finalization_issue_for_compat_fix"], θ); // src: vulnhunter-fix/prompts/deliver.md:187
    }

    // Step 5: single tracking issue.
    @executedBy(MODEL)
    int trackingIssue(Summary s, List<Delivered> out, Theta θ) {
        assert θ["p.deliver.tracking_issue_single"];                                                // src: vulnhunter-fix/prompts/deliver.md:205
        Prompt body = new Prompt();
        body.format(θ["p.deliver.tracking_issue_sections"]);                                        // PR table, Needs Human Review, Cannot Auto-Fix, Already Fixed Upstream, merge order, CWE list  // src: vulnhunter-fix/prompts/deliver.md:213
        body.context(θ["p.deliver.rerun_detection_marker"]);                                        // embeds report-id marker for later runs  // src: vulnhunter-fix/prompts/deliver.md:83
        return ghOrGit("gh issue create --repo <fork_org>/<fork_repo> --title 'Security Remediation: VulnHunter Findings (N vulnerabilities, M PRs)' --body-file .work/delivery/issue-body.md", θ).number; // src: vulnhunter-fix/prompts/deliver.md:207
    }

    // Step 5b
    @executedBy(MODEL)
    void labelHumanReviewPrs(int tracking, Theta θ) {
        if (!θ["p.deliver.needs_human_review_fork_only"]) return;                                   // src: vulnhunter-fix/prompts/deliver.md:448
        for (PendingReview r : readJson(".work/delivery/pending-human-reviews.json")) {               // src: vulnhunter-fix/prompts/deliver.md:223
            ghOrGit("gh pr edit " + r.pr + " --repo <fork_org>/<fork_repo> --add-label " + θ["p.deliver.label_human_review_prs"], θ); // src: vulnhunter-fix/prompts/deliver.md:226
            ghOrGit("gh issue comment " + tracking + " --repo <fork_org>/<fork_repo> --body-file .work/delivery/human-review-VULN-NNN.md", θ); // src: vulnhunter-fix/prompts/deliver.md:234
        }
    }

    // Step 5c
    @executedBy(MODEL)
    void deleteNotNeededBranches(Summary s, int tracking, Theta θ) {
        if (!θ["p.deliver.delete_branch_fix_not_needed"]) return;                                   // src: vulnhunter-fix/prompts/deliver.md:239
        for (Finding f : s.findingsOf("FIX_NOT_NEEDED")) {
            ghOrGit("git push origin --delete " + f.branch + " 2>/dev/null || true", θ);              // src: vulnhunter-fix/prompts/deliver.md:242
            ghOrGit("gh issue comment " + tracking + " --repo <fork_org>/<fork_repo> --body '<info: fix not needed, branch deleted>'", θ); // src: vulnhunter-fix/prompts/deliver.md:248
        }
    }

    // Step 6
    @executedBy(MODEL)
    Report forkReport(List<Delivered> out, int tracking, Theta θ) {
        Report r = new Report();
        r.table(θ["p.deliver.fork_report_table_columns"], out);                                     // VULN ID | Severity | Issue | Delivery | URL  // src: vulnhunter-fix/prompts/deliver.md:257
        r.add(trackingUrl(tracking));
        if (θ["p.deliver.fork_reminder_private"]) r.add("All PRs and issues are in your private fork; re-create PRs against <target_org>/<target_repo> when ready."); // src: vulnhunter-fix/prompts/deliver.md:265
        return r;
    }

    // Description Completeness Checklist (applies before finalizing any PR or issue).
    @executedBy(MODEL)
    void descriptionCompletenessPr(Prompt body, Finding f, Bucket b, Theta θ) {
        body.must(θ["p.deliver.no_placeholder_text_in_descriptions"]);                              // src: vulnhunter-fix/prompts/deliver.md:269
        body.checklist(θ["p.deliver.pr_checklist_items"]);                                          // src: vulnhunter-fix/prompts/deliver.md:272
        body.format(θ["p.deliver.finding_summary_sentence_len"]);                                   // 1-2 sentences each  // src: vulnhunter-fix/prompts/deliver.md:273
    }

    @executedBy(MODEL)
    void descriptionCompletenessIssue(Prompt body, Finding f, Theta θ) {
        body.must(θ["p.deliver.no_placeholder_text_in_descriptions"]);                              // src: vulnhunter-fix/prompts/deliver.md:269
        body.checklist(θ["p.deliver.issue_checklist_items"]);                                       // incl. Open Design Questions + Plan to Resolve for issue-only  // src: vulnhunter-fix/prompts/deliver.md:282
    }

    // Cleanup (fork mode)
    @executedBy(MODEL)
    void forkCleanup(Theta θ) {
        if (env("VULNFIX_KEEP_WORKDIR") == "1") return;                                              // src: vulnhunter-fix/prompts/deliver.md:305
        if (allDeliveredSuccessfully()) Shell.run("rm -rf ./work");                                  // θ default: delete ./work  // src: vulnhunter-fix/prompts/deliver.md:300
        String policy = θ["p.deliver.fork_cleanup_workdir"];                                        // src: vulnhunter-fix/prompts/deliver.md:305
    }

    // ================================================================ IN-PLACE MODE
    @executedBy(MODEL)
    Report inPlaceDelivery(Summary s, Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.deliver.in_place_one_pr_per_cluster"]);                                         // src: vulnhunter-fix/prompts/deliver.md:317
        p.rule(θ["p.deliver.in_place_pr_base_default_branch"]);                                     // src: vulnhunter-fix/prompts/deliver.md:318
        p.forbid(θ["p.deliver.never_gh_issue_close"]);                                              // src: vulnhunter-fix/prompts/deliver.md:319
        p.forbid(θ["p.deliver.no_parallel_or_tracking_issue_in_place"]);                            // src: vulnhunter-fix/prompts/deliver.md:320
        List<Delivered> out = new List();
        for (Cluster c : s.selectedClusters()) {
            if (θ["p.deliver.deliver_after_green"] && !c.verifiedGreenEndToEnd()) continue;          // src: vulnhunter-fix/prompts/deliver.md:325
            pushClusterBranch(c, θ);                                                                 // Step 1
            Bucket b = inPlaceTriage(c, θ);                                                          // Step 2
            Pr existing = inPlaceDedup(c, θ);                                                        // Step 3
            Pr pr = createClusterPr(c, b, existing, θ);                                              // Step 4
            commentSourceIssues(c, pr, θ);                                                           // Step 5
            doNotCloseSourceIssues(c, θ);                                                            // Step 6
            out.add(new Delivered(c, pr, b));
        }
        noIssueOnlyBucket(θ);                                                                        // Step 7
        return inPlaceReport(out, θ);
    }

    // Step 1
    @executedBy(MODEL)
    void pushClusterBranch(Cluster c, Theta θ) {
        Result r = ghOrGit("git -C $WT_PATH push -u origin $BRANCH 2>&1", θ);                      // src: vulnhunter-fix/prompts/deliver.md:332
        if (r.permissionDenied() && θ["p.deliver.push_denied_personal_fork_fallback"]) {           // src: vulnhunter-fix/prompts/deliver.md:335
            pushToPersonalForkAndOpenCrossForkPr(c);                                                 // same fallback as scripts/check_repo_access.sh
        }
    }

    // Step 2 (two buckets only)
    @executedBy(MODEL)
    Bucket inPlaceTriage(Cluster c, Theta θ) {
        List<String> buckets = θ["p.deliver.in_place_two_buckets"];                                 // Ready PR | Draft PR  // src: vulnhunter-fix/prompts/deliver.md:91
        if (c.members.anyMatch(m -> m.requiredOperatorSetup()) && θ["p.deliver.cluster_draft_if_any_member_setup"] == "any") return Bucket.DRAFT_PR; // src: vulnhunter-fix/prompts/deliver.md:339
        return Bucket.READY_PR;
    }

    // Step 3
    @executedBy(MODEL)
    Pr inPlaceDedup(Cluster c, Theta θ) {
        if (!θ["p.deliver.in_place_dedup_by_key_in_body"]) return null;                             // src: vulnhunter-fix/prompts/deliver.md:347
        Map<String, Pr> hits = new Map();
        for (String key : c.vulnfixKeys()) {
            hits.put(key, ghOrGit("gh pr list --repo $OWNER_REPO --state all --search '" + key + " in:body' --json number,title,state,url", θ).first()); // src: vulnhunter-fix/prompts/deliver.md:347
        }
        Pr prior = hits.singleCommonPr();
        if (prior != null && hits.allIn(prior)) {
            if (prior.state == "closed" && θ["p.deliver.dedup_closed_prior_reopen"]) ghOrGit("gh pr reopen " + prior.number, θ); // src: vulnhunter-fix/prompts/deliver.md:354
            if (θ["p.deliver.dedup_all_members_update"]) return prior;                              // update its body instead of creating  // src: vulnhunter-fix/prompts/deliver.md:352
        }
        if (hits.someInExistingPr()) {
            String answer = askUser(θ["p.deliver.dedup_some_members_ask"]);                         // (a) close prior and unify | (b) keep split  // src: vulnhunter-fix/prompts/deliver.md:353
            // unclear: prompt does not say how "keep split" proceeds for the remaining members
        }
        return null;
    }

    // Step 4: create the cluster PR.
    @executedBy(MIXED)
    Pr createClusterPr(Cluster c, Bucket b, Pr existing, Theta θ) {
        if (θ["p.deliver.predelivery_gates_first_in_place"]) predeliveryGates(c, θ);               // src: vulnhunter-fix/prompts/deliver.md:358
        String defaultBranch = Shell.run("jq -r .default_branch .vulnhunter-fix/intake.json").out;   // src: vulnhunter-fix/prompts/deliver.md:365
        boolean noSourceIssues = Shell.run("jq -r '.no_source_issues // false' .vulnhunter-fix/work.json").out == "true"; // src: vulnhunter-fix/prompts/deliver.md:396
        String variant = choose(θ["p.deliver.branch_on_no_source_issues"], noSourceIssues ? "Local-report" : "Standard"); // src: vulnhunter-fix/prompts/deliver.md:388
        Prompt body = clusterBody(c, b, noSourceIssues, θ);
        // Validation before submit
        if (!noSourceIssues) {
            if (θ["p.deliver.validate_pr_body_closes_count"]) {                                    // src: vulnhunter-fix/prompts/deliver.md:373
                ValidatePrBody.main(".vulnhunter-fix/delivery/pr-body-<CLUSTER_KEY>.md", "--expected-issues", c.issueNumbersCsv());
            }
            if (θ["p.deliver.closes_count_equals_members"]) assert body.count("Closes #") == c.members.size(); // fix the body otherwise  // src: vulnhunter-fix/prompts/deliver.md:412
        } else {
            if (θ["p.deliver.local_report_no_closes"]) {                                           // src: vulnhunter-fix/prompts/deliver.md:414
                assert body.firstLine().count("VULN-") == c.members.size();
                assert !body.contains("Closes #");
            }
        }
        if (existing != null) { existing.updateBody(body); return existing; }
        String draftFlag = (b == Bucket.DRAFT_PR) ? "--draft" : "";
        return ghOrGit("gh pr create --repo $OWNER_REPO --head $BRANCH --base " + defaultBranch + " --title '" + θ["p.deliver.cluster_pr_title_format"] + "' --body-file .vulnhunter-fix/delivery/pr-body-<CLUSTER_KEY>.md " + draftFlag, θ).pr(); // src: vulnhunter-fix/prompts/deliver.md:381
    }

    // Cluster PR body (templates/pr_body_cluster.md), required content items 1-6.
    @executedBy(MODEL)
    Prompt clusterBody(Cluster c, Bucket b, boolean noSourceIssues, Theta θ) {
        Prompt p = new Prompt().include(Template.load(θ["p.deliver.cluster_body_template"]));       // not single-finding pr_body.md  // src: vulnhunter-fix/prompts/deliver.md:386
        if (!noSourceIssues) {
            p.must(θ["p.deliver.closes_first_line_inline"]);                                        // Closes #n1, #n2, ... inline; bullets do not auto-close  // src: vulnhunter-fix/prompts/deliver.md:403
        } else {
            p.must(θ["p.deliver.addresses_first_line_local_report"]);                               // Addresses VULN-n1, ... per <results_path>  // src: vulnhunter-fix/prompts/deliver.md:404
        }
        p.format(θ["p.deliver.per_finding_h4_headings"]);                                           // #### VULN-NNN — ... (Closes #N) standard only  // src: vulnhunter-fix/prompts/deliver.md:405
        p.must(θ["p.deliver.three_markers_per_finding"]);                                           // vulnfix-key, vulnhunt-finding-id, vulnhunt-results-dir  // src: vulnhunter-fix/prompts/deliver.md:406
        p.format(θ["p.deliver.cluster_summary_member_table"]);                                      // VULN | CWE | Severity | File | Source issue  // src: vulnhunter-fix/prompts/deliver.md:407
        p.checklist(θ["p.deliver.per_finding_completeness_fields"]);                                // src: vulnhunter-fix/prompts/deliver.md:408
        p.format(θ["p.deliver.cluster_h2_sections"]);                                               // src: vulnhunter-fix/prompts/deliver.md:409
        p.forbid(θ["p.deliver.no_empty_or_tbd_sections"]);                                          // Gate 2 rejects  // src: vulnhunter-fix/prompts/deliver.md:409
        if (b == Bucket.DRAFT_PR) p.must(θ["p.deliver.setup_required_tagged_by_vuln"]);             // src: vulnhunter-fix/prompts/deliver.md:410
        return p;
    }

    // Step 5 (standard mode only)
    @executedBy(MODEL)
    void commentSourceIssues(Cluster c, Pr pr, Theta θ) {
        if (c.noSourceIssues && θ["p.deliver.local_report_skip_issue_comment"]) return;            // src: vulnhunter-fix/prompts/deliver.md:391
        if (!θ["p.deliver.comment_source_issues_no_close"]) return;                                 // src: vulnhunter-fix/prompts/deliver.md:418
        for (Item it : c.workItems()) {
            ghOrGit("gh issue comment " + it.issue.number + " --repo $OWNER_REPO --body 'Bundled into cluster PR: " + pr.url + " ... auto-close when the PR merges.'", θ); // src: vulnhunter-fix/prompts/deliver.md:424
        }
    }

    // Step 6
    @executedBy(MODEL)
    void doNotCloseSourceIssues(Cluster c, Theta θ) {
        if (θ["p.deliver.no_close_at_delivery"]) {                                                 // merge auto-close is the only legitimate closure  // src: vulnhunter-fix/prompts/deliver.md:431
            // never gh issue close; verify keys on closure
        }
        Object closeFlag = θ["p.deliver.close_issue_on_deliver_ignored"];                           // close_issue_on_deliver ignored in in-place  // src: vulnhunter-fix/prompts/deliver.md:437
    }

    // Step 7: no Issue-only bucket; walk-away leaves state as-is.
    @executedBy(MODEL)
    void noIssueOnlyBucket(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.deliver.in_place_no_out_of_scope_or_deferred"]);                              // go back to collaboration loop  // src: vulnhunter-fix/prompts/deliver.md:91
        p.forbid(θ["p.deliver.no_synth_human_review_on_walkaway"]);                                 // src: vulnhunter-fix/prompts/deliver.md:446
        p.rule(θ["p.deliver.needs_human_review_fork_only"]);                                        // src: vulnhunter-fix/prompts/deliver.md:448
    }

    @executedBy(MODEL)
    Report inPlaceReport(List<Delivered> out, Theta θ) {
        Report r = new Report();
        r.table(θ["p.deliver.in_place_report_columns"], out);                                       // VULN ID | CWE | Severity | Issue | Delivery | URL  // src: vulnhunter-fix/prompts/deliver.md:454
        if (θ["p.deliver.in_place_no_auto_cleanup"]) { /* leave .vulnhunter-fix in place */ }        // src: vulnhunter-fix/prompts/deliver.md:460
        return r;
    }

    // ================================================================ Pre-delivery gates (both modes)
    @executedBy(MIXED)
    void predeliveryGates(Object subject, Theta θ) {
        if (!θ["p.deliver.predelivery_gates_hard"]) return;                                        // src: vulnhunter-fix/prompts/deliver.md:466
        honestyGuards(subject, θ);                                                                   // 1
        completenessHeadings(subject, θ);                                                            // 2
        GateResult g = RunGates.run(subject, θ);                                                       // 3: invocation in PromptsVerify Step 8
        if (g.passCount() < θ["p.deliver.all_seven_gates_pass"]) halt();                           // src: vulnhunter-fix/prompts/deliver.md:485
        for (String criterion : θ["p.deliver.deliver_exit_checklist"]) {                            // src: vulnhunter-fix/prompts/deliver.md:487
            if (!holds(criterion, subject)) halt();                                                  // no gh pr create / gh issue create
        }
    }

    // 1. Honesty guards (vulnhunter_fix.delivery renderer).
    @executedBy(CODE)
    void honestyGuards(Object subject, Theta θ) {
        Tier tier = subject.tier;
        List<String> res = subject.residualVectors;
        if (θ["p.deliver.honesty_guard_empty_residual"] && tier != Tier.FULL && res.isEmpty()) throw new EmptyResidualError(); // src: vulnhunter-fix/prompts/deliver.md:481
        if (θ["p.deliver.honesty_guard_full_with_residuals"] && tier == Tier.FULL && !res.isEmpty()) throw new FullTierWithResidualsError(); // src: vulnhunter-fix/prompts/deliver.md:481
        if (θ["p.deliver.honesty_guard_hand_wave"] && res.anyMatch(handWaveRegex())) throw new HandWaveResidualError(); // src: vulnhunter-fix/prompts/deliver.md:481
        subject.draft = DeliveryPrDraftStateForTier.apply(tier, θ["p.deliver.draft_state_by_tier"]); // WORKAROUND Draft; FULL, MITIGATION Ready  // src: vulnhunter-fix/prompts/deliver.md:481
    }

    // 2. Description Completeness Checklist (Gate 2: scripts/check-body-completeness.py).
    @executedBy(MIXED)
    void completenessHeadings(Object subject, Theta θ) {
        List<String> req = θ["p.deliver.required_h2_headings"];                                     // src: vulnhunter-fix/prompts/deliver.md:483
        List<String> cond = θ["p.deliver.conditional_h2_headings"];                                 // Verification Table (PRs), Residual Risk (non-FULL), Breaking Change, Sweep Summary  // src: vulnhunter-fix/prompts/deliver.md:483
        if (subject.isBreakingChange() && θ["p.deliver.breaking_change_heading_bare"]) assert subject.body.matches("^## Breaking Change\\s*(?:$|:)"); // src: vulnhunter-fix/prompts/deliver.md:483
        CheckBodyCompleteness.main(subject.body, req, cond);
    }
}
