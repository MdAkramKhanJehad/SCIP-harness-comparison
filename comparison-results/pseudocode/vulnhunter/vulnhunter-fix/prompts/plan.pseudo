// file: vulnhunter-fix/prompts/plan.md
// Phase 2 remediation plan, mode-aware: in-place sequences a developer-picked cluster on one branch;
// fork delegates to plan_fork.md. Both modes then run seven mandatory rigor actions (graph, sidecars, tier, gates).

@executedBy(MIXED) @role(prompt) @stage("fix.plan")
class PromptsPlan {

    Plan run(Context ctx, Theta θ) {
        Prompt p = prompt(θ);
        String mode = detectMode(ctx, θ);
        Plan plan;
        if (mode == "in-place") {
            plan = inPlace(ctx, θ);
        } else {
            // fork: strict per-finding grouping in plan_fork.md
            if (θ["p.plan.fork_strict_grouping"]) plan = PlanFork.run(ctx.findings, ctx.targetRepo, θ); // src: vulnhunter-fix/prompts/plan.md:8
        }
        rigorActions(plan, ctx, mode, θ);
        stoppingRules(plan, mode, θ);
        return plan;
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.plan.in_place_clusters_not_split"]);                                            // src: vulnhunter-fix/prompts/plan.md:7
        p.rule(θ["p.plan.fork_strict_grouping"]);                                                   // src: vulnhunter-fix/prompts/plan.md:8
        p.rule(θ["p.plan.mode_signals"]);                                                           // src: vulnhunter-fix/prompts/plan.md:10
        p.include(inPlacePrompt(θ));
        p.include(rigorPrompt(θ));
        p.include(stoppingPrompt(θ));
        return p;
    }

    Prompt inPlacePrompt(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.plan.no_carve_out_categories"]);                                              // src: vulnhunter-fix/prompts/plan.md:21
        p.step(1, θ["p.plan.all_work_items_in_scope"]);                                             // src: vulnhunter-fix/prompts/plan.md:23
        p.step(2, θ["p.plan.ip_live_precheck"]);                                                    // src: vulnhunter-fix/prompts/plan.md:25
        p.rule(θ["p.plan.ip_already_fixed_drop"]);                                                  // src: vulnhunter-fix/prompts/plan.md:31
        p.rule(θ["p.plan.ip_empty_cluster_skip"]);                                                  // src: vulnhunter-fix/prompts/plan.md:31
        p.step(3, θ["p.plan.seq_same_file_consecutive"]);                                           // src: vulnhunter-fix/prompts/plan.md:35
        p.rule(θ["p.plan.seq_shared_helper_first"]);                                                // src: vulnhunter-fix/prompts/plan.md:36
        p.rule(θ["p.plan.seq_lower_lines_first"]);                                                  // src: vulnhunter-fix/prompts/plan.md:37
        p.forbid(θ["p.plan.no_cluster_split_proposal"]);                                            // src: vulnhunter-fix/prompts/plan.md:39
        p.step(4, θ["p.plan.ip_assess_items"]);                                                     // src: vulnhunter-fix/prompts/plan.md:41
        p.forbid(θ["p.plan.ip_non_patchable_not_split"]);                                           // src: vulnhunter-fix/prompts/plan.md:48
        p.step(5, θ["p.plan.ip_plan_table_columns"]);                                               // src: vulnhunter-fix/prompts/plan.md:52
        p.rule(θ["p.plan.ip_no_confirmation_gate"]);                                                // src: vulnhunter-fix/prompts/plan.md:55
        return p;
    }

    Prompt rigorPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.plan.rigor_actions_mandatory"]);                                                // src: vulnhunter-fix/prompts/plan.md:65
        p.step(1, θ["p.plan.build_graph_once"]);                                                    // src: vulnhunter-fix/prompts/plan.md:67
        p.step(2, θ["p.plan.crypto_sidecar_enrichment"]);                                           // src: vulnhunter-fix/prompts/plan.md:78
        p.step(3, θ["p.plan.validate_triage_sidecar"]);                                             // src: vulnhunter-fix/prompts/plan.md:87
        p.step(4, θ["p.plan.preclassify_tier"]);                                                    // src: vulnhunter-fix/prompts/plan.md:96
        p.rule(θ["p.plan.tier_output_actions"]);                                                    // src: vulnhunter-fix/prompts/plan.md:105
        p.choose(θ["p.plan.callers_routed_coverage_enum"]);                                         // src: vulnhunter-fix/prompts/plan.md:105
        p.step(5, θ["p.plan.language_detect_and_route"]);                                           // src: vulnhunter-fix/prompts/plan.md:113
        p.step(6, θ["p.plan.anti_merge_check"]);                                                    // src: vulnhunter-fix/prompts/plan.md:115
        p.step(7, θ["p.plan.validate_fix_plan"]);                                                   // src: vulnhunter-fix/prompts/plan.md:123
        p.checklist(θ["p.plan.plan_exit_checklist"]);                                               // src: vulnhunter-fix/prompts/plan.md:125
        return p;
    }

    Prompt stoppingPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.plan.flag_missing_library"]);                                                   // src: vulnhunter-fix/prompts/plan.md:135
        p.rule(θ["p.plan.flag_contradictory_fixes"]);                                               // src: vulnhunter-fix/prompts/plan.md:136
        p.must(θ["p.plan.fork_confirm_in_place_auto"]);                                             // src: vulnhunter-fix/prompts/plan.md:137
        return p;
    }

    @executedBy(MODEL)
    String detectMode(Context ctx, Theta θ) {
        // OWNER_REPO + .vulnhunter-fix/work.json => in-place; explicit TARGET_REPO/RESULTS_PATH => fork
        if (θ["p.plan.mode_signals"] && ctx.ownerRepo != null && exists(".vulnhunter-fix/work.json")) return "in-place"; // src: vulnhunter-fix/prompts/plan.md:10
        return "fork";
    }

    @executedBy(MODEL)
    Plan inPlace(Context ctx, Theta θ) {
        // IP-1: every item in work.json is in scope (implicit cluster)
        List<Finding> cluster = θ["p.plan.all_work_items_in_scope"] ? readWorkJson(".vulnhunter-fix/work.json") : null; // src: vulnhunter-fix/prompts/plan.md:23
        // never carve findings into scaffolding / follow-up / out-of-scope / deferred / Issue only
        for (String bucket : θ["p.plan.no_carve_out_categories"]) assert !cluster.anyIn(bucket);    // src: vulnhunter-fix/prompts/plan.md:21
        // IP-2: live code pre-check in CWD
        if (θ["p.plan.ip_live_precheck"]) {                                                         // src: vulnhunter-fix/prompts/plan.md:25
            for (Finding f : cluster.copy()) {
                boolean present = bash("grep -n <vulnerable_pattern> <target_file>").found;        // src: vulnhunter-fix/prompts/plan.md:28
                if (!present || substantiallyRewritten(f)) {
                    f.status = θ["p.plan.ip_already_fixed_drop"];                                   // src: vulnhunter-fix/prompts/plan.md:31
                    cluster.remove(f);
                }
            }
        }
        if (cluster.isEmpty() && θ["p.plan.ip_empty_cluster_skip"]) {                               // src: vulnhunter-fix/prompts/plan.md:31
            tellDeveloper("cluster empty after pre-check");
            return Plan.skipToPhase5();
        }
        // IP-3: sequence within the cluster (one branch vulnfix/<cluster-slug>)
        if (θ["p.plan.seq_same_file_consecutive"]) cluster.groupConsecutiveBy(f -> f.location.file); // src: vulnhunter-fix/prompts/plan.md:35
        if (θ["p.plan.seq_shared_helper_first"]) cluster.moveFirst(f -> f.touchesSharedHelper);    // src: vulnhunter-fix/prompts/plan.md:36
        if (θ["p.plan.seq_lower_lines_first"]) cluster.sortWithinFileBy(f -> f.location.line);     // src: vulnhunter-fix/prompts/plan.md:37
        Plan plan = Plan.oneBranch("vulnfix/<cluster-slug>", cluster);                              // src: vulnhunter-fix/prompts/plan.md:39
        if (θ["p.plan.in_place_clusters_not_split"] && θ["p.plan.no_cluster_split_proposal"]) plan.branches = 1; // src: vulnhunter-fix/prompts/plan.md:39
        // IP-4: assess fix approach
        for (Finding f : cluster) {
            f.assessment = assess(f, θ["p.plan.ip_assess_items"]);                                  // src: vulnhunter-fix/prompts/plan.md:41
            // not auto-patchable: keep on the same branch; implement.md collaboration loop handles it
            if (!f.assessment.autoPatchable && θ["p.plan.ip_non_patchable_not_split"]) f.keepInCluster = true; // src: vulnhunter-fix/prompts/plan.md:48
        }
        // IP-5: present cluster plan, then proceed without confirmation
        presentTable(cluster, θ["p.plan.ip_plan_table_columns"]);                                   // src: vulnhunter-fix/prompts/plan.md:52
        if (θ["p.plan.ip_no_confirmation_gate"]) plan.confirmed = true;                             // src: vulnhunter-fix/prompts/plan.md:55
        return plan;
    }

    @executedBy(MIXED)
    void rigorActions(Plan plan, Context ctx, String mode, Theta θ) {
        // all seven actions are mandatory exit criteria
        int n = θ["p.plan.rigor_actions_mandatory"];                                                // src: vulnhunter-fix/prompts/plan.md:65
        if (θ["p.plan.build_graph_once"]) BuildGraph.run(ctx.repoRoot, mode == "in-place" ? "<repo>/.vulnhunter-fix/" : ".work/<repo-name>/", ctx.findingsJson); // src: vulnhunter-fix/prompts/plan.md:72
        for (Finding f : plan.findings) {
            if (θ["p.plan.crypto_sidecar_enrichment"] && f.isCrypto()) f.sidecar.cryptoTrustChain = CryptoTrustChainCheckers.run(f.plannedDiff, f.id); // src: vulnhunter-fix/prompts/plan.md:81
            if (θ["p.plan.validate_triage_sidecar"]) {                                              // src: vulnhunter-fix/prompts/plan.md:87
                if (!ValidateTriage.run("<work-dir>/graph_context/" + f.id + ".json").ok) schemaRepairLoop(f); // src: vulnhunter-fix/prompts/plan.md:94
            }
            if (θ["p.plan.preclassify_tier"]) {                                                     // src: vulnhunter-fix/prompts/plan.md:96
                Tier t = ComputeCompletenessTier.run(f.plannedDiff, f.fixPlan, "plan");             // src: vulnhunter-fix/prompts/plan.md:99
                // FULL/MITIGATION/WORKAROUND -> record; LLM_REVIEW -> tier_judgment.md
                if (θ["p.plan.tier_output_actions"] && t == "LLM_REVIEW") t = TierJudgment.run(f, "plan", θ).finalTier; // src: vulnhunter-fix/prompts/plan.md:105
                f.fixPlan.tier = t;
                f.fixPlan.callersRoutedCoverage = chooseOne(θ["p.plan.callers_routed_coverage_enum"], f); // src: vulnhunter-fix/prompts/plan.md:105
                if (f.fixPlan.callersRoutedCoverage != "superset" && t == "FULL") f.fixPlan.tier = notFull(); // only superset permits FULL projection
            }
        }
        if (θ["p.plan.language_detect_and_route"]) {                                                // src: vulnhunter-fix/prompts/plan.md:113
            String lang = LanguageDetect.run(ctx.repoRoot);                                         // src: vulnhunter-fix/prompts/plan.md:110
            for (Finding f : plan.findings) f.workerPrompt = routeByCweClass(f.cwe, lang);          // workers extend worker_agent_common.md
        }
        if (θ["p.plan.anti_merge_check"]) {                                                         // src: vulnhunter-fix/prompts/plan.md:115
            for (Group g : plan.groups.filter(x -> x.size() > 1)) {
                if (!AntiMergeCheck.run(g.filesGrouped, g.filesSplit, g.testFilesGrouped, g.testFilesSplit).allowed) plan.splitIntoIndividualPrs(g); // src: vulnhunter-fix/prompts/plan.md:118
            }
        }
        if (θ["p.plan.validate_fix_plan"]) {                                                        // src: vulnhunter-fix/prompts/plan.md:123
            for (Finding f : plan.findings) if (!ValidateFixPlan.run(f.fixPlanPath).ok) schemaRepairLoop(f);
        }
        // phase-exit criteria: do not proceed to Phase 3 until ALL hold
        for (String item : θ["p.plan.plan_exit_checklist"]) if (!holds(item)) blockPhase3();        // src: vulnhunter-fix/prompts/plan.md:125
    }

    @executedBy(MODEL)
    void stoppingRules(Plan plan, String mode, Theta θ) {
        for (Finding f : plan.findings) {
            if (θ["p.plan.flag_missing_library"] && !repoHas(f.fixStrategy.library)) flag(f);      // src: vulnhunter-fix/prompts/plan.md:135
        }
        if (θ["p.plan.flag_contradictory_fixes"] && plan.hasContradictoryFixes()) flagForUserDecision(); // src: vulnhunter-fix/prompts/plan.md:136
        // fork: explicit user confirmation before Phase 3; in-place: proceed automatically
        String gate = θ["p.plan.fork_confirm_in_place_auto"];                                       // src: vulnhunter-fix/prompts/plan.md:137
        if (mode == "fork" && !askUserConfirm()) stop();
    }
}
