// file: vvaharness/skills/deserialization/SKILL.md
// S4 skill playbook "deserialization": attacker-influenced bytes into code-invoking deserializers (JVM-centred).
// Hard gate = deserializer call site AND a path from untrusted input; both file:line points cited or drop.

@executedBy(MODEL) @role(skill) @stage("S4")
class DeserializationSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_deserialization.trigger"])) return List.of();                    // src: vvaharness/skills/deserialization/SKILL.md:3
        DeserializationPrompt.playbook(θ);
        List<Finding> out = new List();
        for (Candidate c : lookFirst(repo, θ)) {
            if (θ["p.skill_deserialization.gate_deserializer_call_site"] && c.sink == null) continue;      // src: vvaharness/skills/deserialization/SKILL.md:29
            if (!θ["p.skill_deserialization.gate_untrusted_input_path"].contains(c.sourceKind)) continue;    // src: vvaharness/skills/deserialization/SKILL.md:30
            if (θ["p.skill_deserialization.exempt_own_or_signed_data"] && (c.ownFreshData || c.signedBeforeSerializeVerifiedBefore)) continue; // src: vvaharness/skills/deserialization/SKILL.md:32
            if (θ["p.skill_deserialization.cite_both_file_lines_or_drop"] && (c.sourceLine == null || c.sinkLine == null)) continue; // src: vvaharness/skills/deserialization/SKILL.md:33
            if (!mitigationHolds(c, θ)) out.add(c.toFinding());
        }
        return out;
    }

    /** Mitigation check: a filter/allow-list applied BEFORE readObject, unless it admits a known gadget. */
    boolean mitigationHolds(Candidate c, Theta θ) {
        if (!θ["p.skill_deserialization.mitigation_filter_check"] || c.filterBeforeRead == null) return false; // src: vvaharness/skills/deserialization/SKILL.md:49
        if (θ["p.skill_deserialization.evaluate_allow_list_for_gadgets"] && c.filterBeforeRead.admitsKnownGadget()) return false; // e.g. java.util.*, org.apache.commons.* // src: vvaharness/skills/deserialization/SKILL.md:50
        return true;
    }

    List<Candidate> lookFirst(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (θ["p.skill_deserialization.look_java_native"]) out.addAll(repo.grep("ObjectInputStream.readObject, readResolve, RMI/JMX/JNDI, SerializationUtils")); // src: vvaharness/skills/deserialization/SKILL.md:37
        if (θ["p.skill_deserialization.look_jackson_default_typing"]) out.addAll(repo.grep("enableDefaultTyping, Id.CLASS, LaissezFaire, Object-typed fields")); // src: vvaharness/skills/deserialization/SKILL.md:40
        if (θ["p.skill_deserialization.look_xml_decoders"]) out.addAll(repo.grep("XMLDecoder, XStream fromXML, JAXB XmlAdapter by class name")); // src: vvaharness/skills/deserialization/SKILL.md:43
        if (θ["p.skill_deserialization.look_snakeyaml"]) {                                                  // src: vvaharness/skills/deserialization/SKILL.md:45
            for (Candidate c : repo.grep("new Yaml() / Yaml(new Constructor())")) {
                if (θ["p.skill_deserialization.only_safeconstructor_is_safe"] && c.usesSafeConstructor()) continue; // src: vvaharness/skills/deserialization/SKILL.md:46
                out.add(c);
            }
        }
        if (θ["p.skill_deserialization.look_other_serializers"]) out.addAll(repo.grep("Kryo, Hessian/Burlap, FST, DefaultDeserializer, JDK RedisTemplate on shared Redis")); // src: vvaharness/skills/deserialization/SKILL.md:47
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class DeserializationPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_deserialization.persona"]);                                                    // src: vvaharness/skills/deserialization/SKILL.md:24
        p.evidence(θ["p.skill_deserialization.gate_deserializer_call_site"]);                               // src: vvaharness/skills/deserialization/SKILL.md:29
        p.evidence(θ["p.skill_deserialization.gate_untrusted_input_path"]);                                 // src: vvaharness/skills/deserialization/SKILL.md:30
        p.exemption(θ["p.skill_deserialization.exempt_own_or_signed_data"]);                               // src: vvaharness/skills/deserialization/SKILL.md:32
        p.must(θ["p.skill_deserialization.cite_both_file_lines_or_drop"]);                                  // src: vvaharness/skills/deserialization/SKILL.md:33
        p.rule(θ["p.skill_deserialization.look_list_non_exhaustive"]);                                      // src: vvaharness/skills/deserialization/SKILL.md:36
        p.checklist(θ["p.skill_deserialization.look_java_native"]);                                         // src: vvaharness/skills/deserialization/SKILL.md:37
        p.checklist(θ["p.skill_deserialization.look_jackson_default_typing"]);                              // src: vvaharness/skills/deserialization/SKILL.md:40
        p.checklist(θ["p.skill_deserialization.look_xml_decoders"]);                                        // src: vvaharness/skills/deserialization/SKILL.md:43
        p.checklist(θ["p.skill_deserialization.look_snakeyaml"]);                                           // src: vvaharness/skills/deserialization/SKILL.md:45
        p.rule(θ["p.skill_deserialization.only_safeconstructor_is_safe"]);                                  // src: vvaharness/skills/deserialization/SKILL.md:46
        p.checklist(θ["p.skill_deserialization.look_other_serializers"]);                                   // src: vvaharness/skills/deserialization/SKILL.md:47
        p.rule(θ["p.skill_deserialization.mitigation_filter_check"]);                                       // src: vvaharness/skills/deserialization/SKILL.md:49
        p.rule(θ["p.skill_deserialization.evaluate_allow_list_for_gadgets"]);                               // src: vvaharness/skills/deserialization/SKILL.md:50
        return p;
    }
}
