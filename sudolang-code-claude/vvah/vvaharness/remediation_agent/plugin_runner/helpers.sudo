// src: vvaharness/remediation_agent/plugin_runner/helpers.py:27-33
_DEFAULT_TOOLS = ["Read", "Glob", "Grep"]
fn _tools(cfg) = knob("step_remediate.allowed_tools", default=_DEFAULT_TOOLS) as a list   // an empty or absent list also yields the default

// src: vvaharness/remediation_agent/plugin_runner/helpers.py:36-45
fn _build_user(target, repo, mode, pre?, ctx?):executor=code {
  if (pre != null && ctx != null && pre.strategy != null) {
    return prompts.build_user(target, repo, mode, strategy_block=pre.strategy.as_prompt_block(), deny_paths=ctx.gate.deny_paths, forbid_paths=ctx.gate.forbid_patch_paths)
  }
  return prompts.build_user(target, repo, mode)
  // preserved: when the policy allows the finding but the playbook resolves no strategy, the "Remediation policy" glob section is omitted too, although the post-gate still reverts edits to those globs
}

// src: vvaharness/remediation_agent/plugin_runner/helpers.py:48-63
fn _coerce_verdict(raw, target):executor=code {
  // salvage a near-complete reply rather than discard it; finding_index always comes from the code
  match (raw) {
    case RemediationVerdict => { raw.finding_index = target.index; return raw }
    case a dict => return RemediationVerdict.coerce(raw, finding_index=target.index)
    default => {
      try data = extract_json(raw);   // external: vvaharness/util/json_extract.py
      catch error => return RemediationVerdict(finding_index=target.index, verdict="Needs Review", summary="could not parse agent response as JSON: <error>")
      return RemediationVerdict.coerce(data, finding_index=target.index)   // see models/verdict.sudo
    }
  }
}
