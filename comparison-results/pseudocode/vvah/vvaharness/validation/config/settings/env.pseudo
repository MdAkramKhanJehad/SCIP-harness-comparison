// file: vvaharness/validation/config/settings/env.py
// The flat VVAHARNESS_* environment surface: only the claude binary and the GHE tokens are read.

@executedBy(CODE) @role(config) @stage("S11")
class SettingsEnv {
    EnvScalars read(Env env) {
        EnvScalars e = new EnvScalars();
        e.binary = env.getOrDefault("VVAHARNESS_CLAUDE_BINARY", "claude");                          // src: vvaharness/validation/config/settings/env.py:39
        e.gheToken = env.getOrDefault("VVAHARNESS_GHE_TOKEN", "");                                   // src: vvaharness/validation/config/settings/env.py:40
        e.gheArchivedToken = env.getOrDefault("VVAHARNESS_GHE_ARCHIVED_TOKEN", "");                  // src: vvaharness/validation/config/settings/env.py:41
        return e;                                                                                    // extra env keys ignored  // src: vvaharness/validation/config/settings/env.py:37
    }
}

@executedBy(CODE) @role(types)
record EnvScalars(String binary, String gheToken, String gheArchivedToken) { }
