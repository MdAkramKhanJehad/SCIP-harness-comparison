# vvaharness/pipeline/stages/s8/window.py

Limits the Stage 8 model call to a deterministic rank prefix of findings plus a one-pass same-file pull-in, when the prompt token budget or the output budget would otherwise be exceeded.

Source: `vvaharness/pipeline/stages/s8/window.py` (lines 1-143)
Executor: code
Called from: `vvaharness/pipeline/stages/s8_chain.py` run (select_window) and _chain_call_with_half_window_retry (half_window)

// src: vvaharness/pipeline/stages/s8/window.py:45-53
_OUT_RESERVE = 1500
_TOKENS_PER_ENTRY = 100   // over-prices a typical ranking entry, against mid-JSON truncation
_SCHEMA_TOKENS = estimate_tokens(json(ChainReport JSON schema)) + 250   // schema is outside build_prompt; +250 for provider wrapping
_PULLIN_CEILING = 1.25
_PULLIN_BANDS = [Severity.MEDIUM, Severity.LOW, Severity.INFO]

// src: vvaharness/pipeline/stages/s8/window.py:74-143
fn select_window(findings, ctx, cfg):executor=code {
  n = length(findings)
  budget = int(knob("step8.prompt_token_budget", default=100000) or 100000)
  max_out = int(knob("step8.max_tokens", default=64000) or 64000)
  k_out = max((max_out - _OUT_RESERVE) integer-divided by _TOKENS_PER_ENTRY, 1)   // 625 at the defaults

  // src: window.py:83-94 — priced exactly as build_prompt renders it
  facts_on = s8.prompts.facts_enabled(cfg); hop_text = s8.prompts.hop_text_enabled(cfg)
  block_costs = for each i: estimate_tokens(s8.prompts.finding_block("f$i", findings[i], ctx, facts_on, hop_text))
  scaffold = s8.prompts.build_prompt([], ctx, labels=[], cfg=cfg)
  repo_facts = s8.prompts.repo_fact_blocks(findings, ctx, ["f0".."f(n-1)"], facts_on)   // priced over all n on purpose
  fixed = estimate_tokens(SYSTEM) + estimate_tokens(scaffold) + estimate_tokens(repo_facts) + _SCHEMA_TOKENS

  // src: window.py:96-97
  if (fixed + sum(block_costs) <= budget && n <= k_out) return [0..n-1]

  // src: window.py:99-107 — strict rank prefix: stop at the first finding that does not fit
  order = _floor_order(findings)
  included = []; total = fixed
  for each i in order {
    if (length(included) >= k_out || total + block_costs[i] > budget) break   // break, not skip, so chains cite in-window ids
    append i to included; total += block_costs[i]
  }

  // src: window.py:109-123 — one pass, no transitive closure
  seed_files = { findings[i].file for each i in included }
  pullins = 0
  for each i in order {
    if (i in included || length(included) >= k_out) continue
    f = findings[i]
    if (s8.outcomes.final_severity(f, f.severity) in _PULLIN_BANDS && f.file in seed_files
        && total + block_costs[i] <= budget * _PULLIN_CEILING) {
      append i to included; total += block_costs[i]; pullins += 1
    }
  }

  // src: window.py:125-143
  excluded = n - length(included)
  if (excluded == 0) return sorted(included)   // the model sees the full report: no windowing event
  COUNTERS.bump("s8_findings_windowed", excluded)
  if (pullins) COUNTERS.bump("s8_windowed_pullins", pullins)
  warn S8_ENRICHMENT_WINDOWED   // abstracted: per-band included/total counts in the log line
  return sorted(included)   // original indices, original order
}

// src: vvaharness/pipeline/stages/s8/window.py:56-62
fn _floor_order(findings):executor=code {
  // severity band (final_severity, falling back to the carried Stage 4 severity), then OffensivePriority; findings not mutated
  return indices sorted by (SEV_RANK[s8.outcomes.final_severity(findings[i], findings[i].severity)], s8.outcomes.offensive_rank(findings[i]))
}

// src: vvaharness/pipeline/stages/s8/window.py:65-71
fn half_window(findings, window):executor=code {
  // used for the one resend after an at-cap clip: a smaller input, not a dropped tier
  order = _floor_order(findings at window)
  half_n = max(1, length(order) integer-divided by 2)
  return sorted(window[k] for each k in first half_n of order)
}
