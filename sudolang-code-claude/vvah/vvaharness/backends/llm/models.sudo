ModelExtras { temperature: Number; thinking_budget: Number; betas: [String] }   // only `sdk` reads all three
ResolvedModel { model_id; via; extras: ModelExtras }
EnvelopeResult { text; usage; turns = null; usd = null; stop_reason = null; model_usage = null }   // one `claude -p` JSON envelope
CliConfig { verify_ssl; ca_cert; client_cert; no_proxy; effort; restricted: Boolean }   // `--restricted` is the `cli` route's only read jail
SdkConfig { api_key; base_url; verify_ssl; ca_cert; client_cert; no_proxy; allow_api_key_fallback; cache_min_block_tokens; cache_route; cache_markers }
OpenAiConfig { api_key; base_url; verify_ssl; ca_cert; organization; no_proxy; cache_markers }   // organization header is sent only on `via: openai`

## Refusals and guardrail blocks

// src: vvaharness/backends/llm/models.py:478-499
GuardrailBlocked   // a provider guardrail declined the request; retrying the same prompt cannot help
ModelRefusal { message; route; category }   // a subtype of GuardrailBlocked
fn guardrail_gate_hit(e, hits, gate):executor=code {
  // for the s4/s6 abort gate: only guardrail blocks count, refusals do not
  if (e is ModelRefusal) return [hits, "model refusal, not gated"]
  return [hits + 1, "${hits + 1}/$gate"]
}

// src: vvaharness/backends/llm/models.py:502-523
LLM_MODEL_REFUSALS_COUNTER = "llm_model_refusals"
REFUSAL_RETRY_ATTEMPTED_COUNTER = "llm_refusal_retry_attempted"; REFUSAL_RETRY_RECOVERED_COUNTER = "llm_refusal_retry_recovered"
fn refusal_resend_allowed(cfg, model_cfg):executor=code {
  if (int(knob(cfg, "refusal_retries", 1)) <= 0) return false
  [model_id, via] = registry.resolve(model_cfg)
  return manifest._resolved_route(via, model_id, registry.provider_of(model_cfg)) == "anthropic"
  // Anthropic only: an OpenAI-compatible gateway's cyber filter can revoke the whole organization's access, so flagged content is never re-sent there
}

// src: vvaharness/backends/llm/models.py:526-543
_CYBER_POLICY_REJECTION_RX = /\bcyber_policy\b|flagged for possible cybersecurity risk/i   // category "cyber"
fn model_refusal(route, stage, category, detail = ""):executor=code {
  COUNTERS.bump(LLM_MODEL_REFUSALS_COUNTER)
  return ModelRefusal("model refused the request (route=$route, category=${category || \"unspecified\"}, stage=$stage): <redact(detail) first 200 characters>", route, category)
  // redact runs before truncation so a credential is not bisected past its pattern
}

// src: vvaharness/backends/llm/models.py:551-603
fn ai_message_refused(message):executor=code {
  if (message.response_metadata.stop_reason == "refusal") return [true, message.response_metadata.stop_details.category]
  return [message.additional_kwargs.refusal is set || any content block has type "refusal", null]   // the two OpenAI refusal shapes
}
fn _refusal_link(exc):executor=code {
  for each link in exception_chain(exc) {
    if ((link has status_code or body) && _CYBER_POLICY_REJECTION_RX matches rejection_text(link)) return [link, "cyber"]
    // API error links only: scanned code echoed in an output failure may contain the marker
    [refused, category] = ai_message_refused(link.ai_message)
    if (refused) return [link, category]
  }
  return null
}
fn is_model_refusal_rejection(exc):executor=code { return _refusal_link(exc) != null }
fn model_refusal_from(exc, route, stage):executor=code {
  found = _refusal_link(exc); if (found == null) return null
  return model_refusal(route, stage, category=found.category, detail=rejection_text(found.link))
}

## Reasoning-effort rejections

// src: vvaharness/backends/llm/models.py:606-644
_REASONING_EFFORT_RX = /reasoning[\s_.\-]?effort/
_REASONING_CONTAINER_MARKERS = ["unsupported parameter: 'reasoning'", "unknown parameter: 'reasoning'"]
_FIELD_UNSUPPORTED_MARKERS = ["unknown parameter", "unsupported parameter", "unrecognized request argument"]
_TIER_VALUE_RX = /['"](?:none|low|medium|high|xhigh|max)['"]/

// src: vvaharness/backends/llm/models.py:630-639
fn _effort_rejection_text(exc):executor=code {
  for each link in exception_chain(exc) {
    if (link.status_code not in PARAM_REJECTION_STATUS && !is_gateway_wrapped_param_rejection(link)) continue
    text = lowercase(rejection_text(link))
    if (_REASONING_EFFORT_RX matches text || text contains one of _REASONING_CONTAINER_MARKERS) return text
  }
  return null
}

// src: vvaharness/backends/llm/models.py:658-681
fn _effort_rejection_class(text):executor=code {
  // order matters
  if (text contains "supported values" || "invalid value" || "unsupported value") return "tier"   // the endpoint supports reasoning, only this value was rejected
  if (text matches /\btools?\b/) return "tools_conflict"
  is_field = !(_TIER_VALUE_RX matches text) && (text contains one of _FIELD_UNSUPPORTED_MARKERS || "not supported")
  return if (is_field) "field" else "tier"   // ambiguous text defaults to the tier ladder, never a field-wide drop
}

// src: vvaharness/backends/llm/models.py:684-698
fn classify_effort_rejection(exc):executor=code {
  if (is_model_refusal_rejection(exc)) return null   // a refusal never earns a resend
  text = _effort_rejection_text(exc)
  return if (text == null) null else _effort_rejection_class(text)
}
fn is_reasoning_effort_rejection(exc):executor=code { return classify_effort_rejection(exc) != null }

// src: vvaharness/backends/llm/models.py:701-711
REASONING_EFFORT_LADDER = ("max", "high", "low")
_LADDER_NEXT = { max: "high", xhigh: "high", high: "low", medium: "low", none: "low", low: null }
fn next_effort_tier(tier):executor=code { return if (tier == null) null else _LADDER_NEXT[tier] }

// src: vvaharness/backends/llm/models.py:714-757
TRANSPORT_CHAT = TRANSPORT_CHAT_COMPLETIONS
_TIER_RANK = { none: 0, minimal: 1, low: 2, medium: 3, high: 4, xhigh: 5, max: 6 }
fn _listed_tiers(text):executor=code {
  // quoted tier names in the body; a truncated quoted prefix (for example "'me...") counts only when the text enumerates a value list, and only when it uniquely prefixes one tier
}
fn _tiers_key(model, tier, transport):executor=code { return if (transport == TRANSPORT_CHAT) (model, tier) else (model, tier, transport) }

// src: vvaharness/backends/llm/models.py:760-780
fn step_down(model, sent, exc, transport = TRANSPORT_CHAT):executor=code {
  EFFORT_REJECTIONS.tiers.add(_tiers_key(model, sent, transport))
  listed_below = _listed_tiers(_effort_rejection_text(exc)) where rank < rank(sent)
  if (transport != TRANSPORT_CHAT) { remove REASONING_OFF from listed_below }   // a gateway reasoning on Responses must stay silenced-off, so "none" never reaches that leg
  nxt = if (listed_below) highest-ranked of listed_below else next_effort_tier(sent)
  if (nxt != null) { EFFORT_REJECTIONS.step_to[(model, transport, sent)] = nxt }
  return nxt
}

// src: vvaharness/backends/llm/models.py:783-799
fn effort_after_rejections(model, tier, transport = TRANSPORT_CHAT):executor=code {
  while (tier != null) {
    learned = EFFORT_REJECTIONS.step_to[(model, transport, tier)]
    if (learned != null) { tier = learned; continue }   // one hop to the highest listed value
    if (_tiers_key(model, tier, transport) not in EFFORT_REJECTIONS.tiers) break
    tier = next_effort_tier(tier)
  }
  return tier
}

// src: vvaharness/backends/llm/models.py:802-857
REASONING_OFF = "none"
EFFORT_REJECTIONS {
  // process memory shared by the `openai` route and the `deepagents` client
  tiers: set of (model, tier) for Chat, (model, tier, transport) otherwise
  field: set of models whose endpoint rejects the effort field outright
  tools_off: set of models that need reasoning_effort "none" on tool-carrying calls
  step_to: map (model, transport, sent tier) -> highest listed tier below it
  server_error_probed: keys already given one extra send after a persistent server error
  server_error_recovered: keys already recovered once at the lower tier
  _probe_lock   // s4/s6 worker threads: two threads on the same key must not both claim the one extra send

  probe_once(key) { with _probe_lock: if (key in server_error_probed) return false; add key; return true }
  recovered_twice(key) {
    with _probe_lock:
    if (key in server_error_recovered) return true   // the second recovery learns the lower tier
    add key to server_error_recovered; remove key from server_error_probed; return false   // a first recovery frees the claim
  }
}

// src: vvaharness/backends/llm/models.py:860-881
TRANSPORT_MEMORY {
  // shared by the `openai` route and the `deepagents` client
  chat_only: models learned Chat-only (a Responses call failed, or pinned or measured broken)
  responses_proven: models that completed at least one Responses call this process
  no_include: models whose gateway rejected the `include` parameter
}

// src: vvaharness/backends/llm/models.py:920-936
fn is_responses_shape_rejection(exc):executor=code {
  if (any link in exception_chain(exc) has status_code 404) return true   // no /v1/responses route
  if (classify_effort_rejection(exc) != null) return false
  return is_param_rejection(exc, "unsupported parameter", "unknown parameter")
}

