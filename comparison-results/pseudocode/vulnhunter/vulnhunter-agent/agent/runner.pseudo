        Wait wait = waits.isEmpty() ? Wait.none() : Wait.chain(waits);                           // src: vulnhunter-agent/agent/runner.py:904
        return new Retrying(RateLimitError.class, wait, 1 + waits.size(), true);                 // src: vulnhunter-agent/agent/runner.py:908
    }

    // _model_tag: opus48, sonnet5, ..., with _1m kept for 1M-context variants.
    String modelTag(String model) {
        String lowered = model.lower().replace("claude-", "");                                   // src: vulnhunter-agent/agent/runner.py:120
        boolean longContext = LONG_CONTEXT_RE.search(lowered);                                   // src: vulnhunter-agent/agent/runner.py:121
        String cleaned = LONG_CONTEXT_RE.sub("", lowered);
        String family = firstMatch(List.of("opus", "sonnet", "haiku", "gpt", "o3", "o1"), cleaned, "model"); // src: vulnhunter-agent/agent/runner.py:125
        String version = digits(cleaned).take(2);                                                // src: vulnhunter-agent/agent/runner.py:127
        String base = version.isEmpty() ? family : family + version;
        return longContext ? base + "_1m" : base;                                                // src: vulnhunter-agent/agent/runner.py:129
    }

    Path vulnhuntSkillPath() {
