// file: vvaharness/validation/models/manifest.py
// Per-finding workspace manifest for the agent session (extra keys ignored); carries the Finding whole.

@executedBy(CODE) @role(types) @stage("S11")
record ValidationManifest(String caseId, String sessionId, Finding finding, List<String> affectedFiles, boolean postResults) { }

@executedBy(CODE) @role(io) @stage("S11")
class ModelsManifest {
    Map toDict(ValidationManifest m) {
        return m.modelDump();                                                                        // src: vvaharness/validation/models/manifest.py:43
    }

    void write(ValidationManifest m, Path path) {
        path.writeText(Json.dumps(toDict(m), 2) + "\n");                                             // src: vvaharness/validation/models/manifest.py:47
    }

    ValidationManifest fromFile(Path path) {
        return Pydantic.modelValidate(ValidationManifest, Json.loads(path.readText()));                                  // tolerant of extra keys  // src: vvaharness/validation/models/manifest.py:52
    }
}
