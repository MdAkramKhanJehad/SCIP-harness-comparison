// file: harness/local_harness/benchmark/analyze_misses.py
// Miss analysis for the local benchmark: for each false negative, heuristically locate the losing phase
// from scan artifacts, then run an agentic Claude diagnosis that suggests a minimal prompt edit.

@executedBy(CODE) @role(evaluation)
class AnalyzeMisses {

    // PHASE_TO_PROMPT: phase1 -> phase1_recon.md; phase2_inj/nav/log -> phase2_shared.md + phase2_class_<x>.md;
    // phase2b -> phase2b_verify.md; unknown -> phase2_hunt.md                                   // src: harness/local_harness/benchmark/analyze_misses.py:31

    List<String> extractIdentifiers(String description) {
        Set<String> ids = new Set();
        for (String c : description.findAll("[\\w/.-]+\\.\\w<1,4>")) {                          // src: harness/local_harness/benchmark/analyze_misses.py:86
            if (c.contains("/") || CODE_EXTS.contains(c.ext())) ids.add(c);
        }
        for (String n : description.functionNames()) if (n.length() > 3) ids.add(n);            // src: harness/local_harness/benchmark/analyze_misses.py:94
        ids.addAll(description.routePatterns());                                                // src: harness/local_harness/benchmark/analyze_misses.py:97
        ids.addAll(description.apiPatterns());                                                  // src: harness/local_harness/benchmark/analyze_misses.py:100
        ids.addAll(description.camelNames().filter(n -> n.length() > 5));                       // src: harness/local_harness/benchmark/analyze_misses.py:104
        return ids.toList();
    }

    List<Match> searchFileForIdentifiers(String path, List<String> ids) {
        if (!Fs.isfile(path)) return List.of();
        List<Match> out = new List();
        for (String id : ids) {
            // word-boundary match for plain words, substring for paths/routes; first hit per identifier, 3 lines context
            Match m = Fs.readLines(path).firstMatch(id, 3);                                     // src: harness/local_harness/benchmark/analyze_misses.py:122
            if (m != null) out.add(m);
        }
        return out;
    }

    Pair locateLossPhase(String resultsDir, Finding f) {
        List<String> ids = extractIdentifiers(f.description);
        if (ids.isEmpty()) return new Pair("unknown", "Could not extract identifiers from finding description"); // src: harness/local_harness/benchmark/analyze_misses.py:149
        List<Match> p2b = searchFileForIdentifiers(resultsDir + "/phase2b_output.md", ids);    // src: harness/local_harness/benchmark/analyze_misses.py:153
        List<String> reject = List.of("REJECTED", "FALSE POSITIVE", "false positive", "rejected");
        for (Match m : p2b) if (reject.any(r -> m.context.toLowerCase().contains(r.toLowerCase()))) return new Pair("phase2b", m.context); // src: harness/local_harness/benchmark/analyze_misses.py:161
        if (Fs.isdir(resultsDir + "/results")) {
            for (String rf : Fs.listdir(resultsDir + "/results").sorted()) {                    // src: harness/local_harness/benchmark/analyze_misses.py:167
                for (Match m : searchFileForIdentifiers(resultsDir + "/results/" + rf, ids)) {
                    if (List.of("SAFE", "NO-MATCH", "NO MATCH", "DESIGN-INTENT", "DESIGN INTENT").any(d -> m.context.toLowerCase().contains(d.toLowerCase()))) // src: harness/local_harness/benchmark/analyze_misses.py:171
                        return new Pair("phase2_" + inferClassFromFilename(rf), m.context);
                }
            }
        }
        List<Match> p1 = searchFileForIdentifiers(resultsDir + "/phase1_output.md", ids);      // src: harness/local_harness/benchmark/analyze_misses.py:180
        if (p1.isEmpty()) return new Pair("phase1", "None of these identifiers found in phase1: " + ids.take(5)); // src: harness/local_harness/benchmark/analyze_misses.py:182
        String cls = typeToClass(f.type);
        return new Pair("phase2_" + cls, "Input enumerated in phase1 but not traced to a candidate in phase2. Expected class agent: " + cls); // src: harness/local_harness/benchmark/analyze_misses.py:195
    }

    String inferClassFromFilename(String fn) {
        if (fn.contains("_inj_")) return "inj";                                                 // src: harness/local_harness/benchmark/analyze_misses.py:200
        if (fn.contains("_nav_")) return "nav";
        if (fn.contains("_log_")) return "log";
        if (fn.contains("sink_driven")) return "inj";
        return "nav";
    }

    String typeToClass(String type) {
        // SQLi/PathTraversal/SSRF/CommandInjection/XXE/CodeEval/XSS/OpenRedirect -> inj;
        // CSRF/IDOR/AuthBypass/MissingAuth/AuditSpoofing/IPSpoofing/MassAssignment -> nav;
        // RaceCondition/DoS/CryptoWeakness -> log; default nav
        return TYPE_MAP.getOrDefault(type, "nav");                                              // src: harness/local_harness/benchmark/analyze_misses.py:222
    }

    @executedBy(MODEL) @role(prompt)
    Prompt diagnosticSystemPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.analyze_misses.diagnostic_persona"]);                                    // src: harness/local_harness/benchmark/analyze_misses.py:43
        if (θ["p.analyze_misses.step1_ground_truth_first"]) p.step(1, "start with the ground truth vulnerability definition"); // src: harness/local_harness/benchmark/analyze_misses.py:46
        if (θ["p.analyze_misses.step2_read_scanner_results"]) p.step(2, "read the scanner results in the VULNHUNT_RESULTS directory"); // src: harness/local_harness/benchmark/analyze_misses.py:47
        if (θ["p.analyze_misses.step3_trace_scan_log"]) p.step(3, "dive into benchmark_scan.log (JSONL) to trace where reasoning went wrong"); // src: harness/local_harness/benchmark/analyze_misses.py:48
        if (θ["p.analyze_misses.grep_log_not_read_whole"]) p.rule("use grep to find relevant log sections rather than reading the whole file"); // src: harness/local_harness/benchmark/analyze_misses.py:48
        if (θ["p.analyze_misses.step4_read_prompt_files"]) p.step(4, "read the relevant prompt file(s) in skill/phases/ to find the instruction gap"); // src: harness/local_harness/benchmark/analyze_misses.py:49
        if (θ["p.analyze_misses.root_cause_in_prompts"]) p.must("identify the ROOT CAUSE in the scanner's prompts/instructions"); // src: harness/local_harness/benchmark/analyze_misses.py:52
        p.rule(θ["p.analyze_misses.minimal_fix"]);                                              // src: harness/local_harness/benchmark/analyze_misses.py:53
        if (θ["p.analyze_misses.general_fix"]) p.must("be GENERAL: catch an entire CLASS of similar misses"); // src: harness/local_harness/benchmark/analyze_misses.py:54
        if (θ["p.analyze_misses.prefer_list_addition"]) p.tiebreak("prefer adding to an existing list over restructuring sections"); // src: harness/local_harness/benchmark/analyze_misses.py:55
        if (θ["p.analyze_misses.deletions_allowed_for_restrictive_gates"]) p.exemption("deletions/edits acceptable if they remove an overly restrictive gate"); // src: harness/local_harness/benchmark/analyze_misses.py:56
        if (θ["p.analyze_misses.conciseness_paramount"]) p.must("conciseness is paramount; prompts must stay small"); // src: harness/local_harness/benchmark/analyze_misses.py:57
        if (θ["p.analyze_misses.output_json_only"]) p.format("output ONLY valid JSON");         // src: harness/local_harness/benchmark/analyze_misses.py:59
        p.format(θ["p.analyze_misses.output_fields"]);                                          // src: harness/local_harness/benchmark/analyze_misses.py:61
        if (θ["p.analyze_misses.prompt_file_single_primary"]) p.format("prompt_file: the primary prompt file to change, relative path"); // src: harness/local_harness/benchmark/analyze_misses.py:62
        if (θ["p.analyze_misses.suggested_change_short_general"]) p.format("suggested_change: as short and general as possible"); // src: harness/local_harness/benchmark/analyze_misses.py:64
        p.choose(θ["p.analyze_misses.change_type_values"]);                                     // src: harness/local_harness/benchmark/analyze_misses.py:65
        p.choose(θ["p.analyze_misses.false_positive_risk_values"]);                             // src: harness/local_harness/benchmark/analyze_misses.py:66
        if (θ["p.analyze_misses.risk_explanation_required"]) p.format("risk_explanation: why the change might or might not introduce false positives"); // src: harness/local_harness/benchmark/analyze_misses.py:67
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt buildDiagnosticPrompt(Finding f, String phaseKey, String evidence, String resultsDir, String repoDir) {
        Prompt p = new Prompt();
        p.context("Finding " + f.findingId + " was NOT detected. Figure out where the scanner went amiss."); // src: harness/local_harness/benchmark/analyze_misses.py:233
        p.context("Ground Truth Finding: ID, Type, Description");                               // src: harness/local_harness/benchmark/analyze_misses.py:235
        p.context("Investigation Paths: ground truth file, results dir, scan log (JSONL, use grep), relevant prompt files, all prompt files"); // src: harness/local_harness/benchmark/analyze_misses.py:240
        p.context("Pre-analysis Hint (may be wrong — verify): lost at " + phaseKey + ". Evidence: " + evidence.take(500)); // src: harness/local_harness/benchmark/analyze_misses.py:247
        p.rule("plan the minimal, concise, generalized prompt changes; deletions/edits/additions acceptable"); // src: harness/local_harness/benchmark/analyze_misses.py:250
        p.format("Output ONLY valid JSON as specified in your system prompt.");                 // src: harness/local_harness/benchmark/analyze_misses.py:252
        return p;
    }

    @executedBy(MIXED)
    Map invokeDiagnostic(Finding f, String phaseKey, String evidence, String resultsDir, String repoDir, Theta θ) {
        String mode = θ["harness.miss_diagnostic"];                                             // src: harness/local_harness/benchmark/analyze_misses.py:43
        AgentSpec spec = new AgentSpec(new ModelSpec(θ["harness.MODEL"], "claude-cli", "anthropic", null, 0), // src: harness/local_harness/benchmark/analyze_misses.py:270
            List.of("Read", "Grep", "Glob"), null, diagnosticSystemPrompt(θ), buildDiagnosticPrompt(f, phaseKey, evidence, resultsDir, repoDir), // src: harness/local_harness/benchmark/analyze_misses.py:272
            new Bounds(0, 0, 1200, null), null, false);  // timeout literal 1200 s; --permission-mode default, --setting-sources user, --strict-mcp-config // src: harness/local_harness/benchmark/analyze_misses.py:285
        Transcript t = Runtime.agent(spec);
        if (t.timedOut()) return Map.of("root_cause", "diagnostic timed out", "false_positive_risk", "unknown"); // src: harness/local_harness/benchmark/analyze_misses.py:290
        if (t.returncode != 0) return Map.of("root_cause", "diagnostic failed: exit " + t.returncode, "false_positive_risk", "unknown"); // src: harness/local_harness/benchmark/analyze_misses.py:300
        return parseDiagnosticOutput(t.stdout);
    }

    Map parseDiagnosticOutput(String raw) {
        String text = raw.trim();
        int s = text.indexOf("{"), e = text.lastIndexOf("}");                                   // src: harness/local_harness/benchmark/analyze_misses.py:312
        if (s != -1 && e != -1) {
            Map m = Json.tryParse(text.substring(s, e + 1));
            if (m != null) return m;
        }
        return Map.of("root_cause", "failed to parse diagnostic output", "section_to_change", text.take(500)); // src: harness/local_harness/benchmark/analyze_misses.py:319
    }

    void main(Args args, Theta θ) {
        if (!Fs.isfile(args.stateFile)) System.exit(1);                                         // src: harness/local_harness/benchmark/analyze_misses.py:370
        State state = Json.parse(Fs.read(args.stateFile));
        List<Miss> misses = new List();
        for (Entry e : state.judgments) {
            if (e.judgment.detected == false && (args.finding == null || e.fid == args.finding)) misses.add(Miss.of(e, state)); // src: harness/local_harness/benchmark/analyze_misses.py:381
        }
        if (misses.isEmpty()) System.exit(0);                                                   // src: harness/local_harness/benchmark/analyze_misses.py:394
        List<Map> analyses = Runtime.parallel(3, misses, m -> analyzeOne(m, θ));  // literal 3 workers // src: harness/local_harness/benchmark/analyze_misses.py:435
        LocalHarnessConfig.atomicWriteJson(RESULTS_DIR + "/miss_analysis.json", analyses);      // src: harness/local_harness/benchmark/analyze_misses.py:327
        Fs.write(RESULTS_DIR + "/MISS_ANALYSIS.md", analyses.renderReport());                   // src: harness/local_harness/benchmark/analyze_misses.py:331
    }

    Map analyzeOne(Miss m, Theta θ) {
        try {
            if (m.resultsDir == null || !Fs.isdir(m.resultsDir)) return m.with("loss_phase", "no_results"); // src: harness/local_harness/benchmark/analyze_misses.py:411
            Pair loss = locateLossPhase(m.resultsDir, m);                                       // src: harness/local_harness/benchmark/analyze_misses.py:416
            Map diag = invokeDiagnostic(m, loss.a, loss.b, m.resultsDir, dirname(m.resultsDir), θ); // src: harness/local_harness/benchmark/analyze_misses.py:424
            return m.with("loss_phase", loss.a, "evidence", loss.b, "diagnostic", diag);
        } catch (Exception e) {
            return m.with("loss_phase", "error");                                               // src: harness/local_harness/benchmark/analyze_misses.py:431
        }
    }
}
