// file: vvaharness/skills/missing-controls/SKILL.md
// S4 skill playbook "missing-controls": absent-control lens. Inverted method: enumerate every site a control
// belongs to, then judge site by site whether the control is on THIS path. One finding per absent site.

@executedBy(MODEL) @role(skill) @stage("S4")
class MissingControlsSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        if (!repo.taskMatches(θ["p.skill_missing-controls.trigger"])) return List.of();             // src: vvaharness/skills/missing-controls/SKILL.md:3
        // hunt for a hole, not a construct; nothing upstream points at these
        assert θ["p.skill_missing-controls.hunt_for_hole_not_construct"];                           // src: vvaharness/skills/missing-controls/SKILL.md:25
        String question = θ["p.skill_missing-controls.inverted_method"];                            // src: vvaharness/skills/missing-controls/SKILL.md:30
        List<Finding> out = new List<Finding>();
        for (Control ctl : controls(θ)) {
            // enumerate before you conclude: grep the whole repo for every site of the kind this control protects
            List<Site> sites = θ["p.skill_missing-controls.grep_whole_repo_per_control"] ? Tools.Grep(ctl.siteRegex()).sites() : ctl.sitesShown(); // src: vvaharness/skills/missing-controls/SKILL.md:53
            int present = 0;
            for (Site s : sites) {
                MissingControlsVerdict v = judgeSite(s, ctl, repo, question, θ);
                if (v == MissingControlsVerdict.ABSENT) out.add(finding(s, ctl, θ));
                else if (v == MissingControlsVerdict.PRESENT) present++;
            }
            // present everywhere -> refute and say how many sites were checked
            if (θ["p.skill_missing-controls.refute_with_site_count"] && present == sites.size()) ctl.refute("present at " + present + " of " + sites.size() + " sites"); // src: vvaharness/skills/missing-controls/SKILL.md:55
        }
        return out;
    }

    List<Control> controls(Theta θ) {
        List<Control> cs = new List<Control>();
        // Anti-automation on credential and cost endpoints
        cs.add(new Control(θ["p.skill_missing-controls.control_anti_automation_cwes"], θ["p.skill_missing-controls.anti_automation_sites"], θ["p.skill_missing-controls.anti_automation_present_markers"])); // src: vvaharness/skills/missing-controls/SKILL.md:60
        // Session termination
        cs.add(new Control(θ["p.skill_missing-controls.control_session_termination_cwes"], θ["p.skill_missing-controls.session_termination_sites"], θ["p.skill_missing-controls.session_termination_present_markers"])); // src: vvaharness/skills/missing-controls/SKILL.md:71
        // Cookie and transport flags (sites = every set_cookie AND every session config key)
        cs.add(new Control(θ["p.skill_missing-controls.control_cookie_transport_cwes"], θ["p.skill_missing-controls.cookie_sites_grep_all"] ? "set_cookie|Set-Cookie|SESSION_* config" : "set_cookie", θ["p.skill_missing-controls.cookie_present_markers"])); // src: vvaharness/skills/missing-controls/SKILL.md:81
        // Deployment and debug posture
        cs.add(new Control(θ["p.skill_missing-controls.control_debug_posture_cwes"], θ["p.skill_missing-controls.debug_posture_sites"], θ["p.skill_missing-controls.debug_posture_holes"])); // src: vvaharness/skills/missing-controls/SKILL.md:90
        // Data at rest and in transit
        cs.add(new Control(θ["p.skill_missing-controls.control_data_at_rest_cwes"], θ["p.skill_missing-controls.data_sites"], "encryption / TLS verify")); // src: vvaharness/skills/missing-controls/SKILL.md:101
        // Request forgery and origin trust (csrf lens); enumerate every state-changing handler
        cs.add(new Control(θ["p.skill_missing-controls.control_request_forgery_cwes"], θ["p.skill_missing-controls.enumerate_every_state_changing_handler"] ? "every state-changing handler" : "pointed handler", "csrf token / origin check")); // src: vvaharness/skills/missing-controls/SKILL.md:112
        // Authorization: access-control lens; translate its Spring/JAX-RS examples to this framework
        if (θ["p.skill_missing-controls.authorization_deferred_translate_framework"]) cs.add(Control.authorizationTranslatedToFramework()); // src: vvaharness/skills/missing-controls/SKILL.md:119
        return cs;
    }

    MissingControlsVerdict judgeSite(Site s, Control ctl, Repo repo, String question, Theta θ) {
        // Gate 1: real and reachable
        if (θ["p.skill_missing-controls.gate_site_real_and_reachable"] && !s.reachableByExternalActor()) return MissingControlsVerdict.SKIP; // src: vvaharness/skills/missing-controls/SKILL.md:35
        // Gate 2: control genuinely belongs: name the asset and the actor
        if (θ["p.skill_missing-controls.gate_control_belongs"] && !(ctl.namedAsset(s) != null && ctl.namedActor(s) != null)) return MissingControlsVerdict.SKIP; // src: vvaharness/skills/missing-controls/SKILL.md:37
        if (θ["p.skill_missing-controls.fp_public_by_design"] && s.publicByDesign() && !s.holdsScarceResource()) return MissingControlsVerdict.REFUTED; // src: vvaharness/skills/missing-controls/SKILL.md:130
        // Gate 3: absent on THIS path, checked (middleware, base class, decorator factory, proxy config, framework default)
        Location where = θ["p.skill_missing-controls.gate_absent_on_this_path_checked"] ? repo.searchControlOnPath(s, ctl) : s.file.find(ctl); // src: vvaharness/skills/missing-controls/SKILL.md:40
        if (where != null) {
            if (θ["p.skill_missing-controls.refute_if_control_anywhere_on_path"]) { s.refuteAt(where); return MissingControlsVerdict.PRESENT; } // src: vvaharness/skills/missing-controls/SKILL.md:44
        }
        if (θ["p.skill_missing-controls.fp_control_present_on_path"] && repo.controlInMiddlewareBaseDependencyRouterOrDefault(s, ctl)) return MissingControlsVerdict.PRESENT; // src: vvaharness/skills/missing-controls/SKILL.md:127
        // control-specific judgement
        if (ctl.isAntiAutomation()) {
            if (θ["p.skill_missing-controls.waf_only_if_visible_in_repo"] && s.onlyUpstreamWafClaimed() && !repo.wafRuleVisible()) return MissingControlsVerdict.ABSENT; // src: vvaharness/skills/missing-controls/SKILL.md:67
            // a LoginAttempt model / failed_count column is a decoy: find code that reads it and refuses
            if (θ["p.skill_missing-controls.storage_without_enforcement_is_decoy"] && s.hasAttemptStorage() && !s.hasCodeThatReadsAndRefuses()) return MissingControlsVerdict.ABSENT; // src: vvaharness/skills/missing-controls/SKILL.md:68
        }
        if (ctl.isSessionTermination()) {
            if (θ["p.skill_missing-controls.logout_without_revocation_hole"] && s.isLogout() && s.onlyReturnsMessage() && s.jwtStillValid()) return MissingControlsVerdict.ABSENT; // src: vvaharness/skills/missing-controls/SKILL.md:76
            if (θ["p.skill_missing-controls.session_other_holes"] && (s.passwordChangeKeepsOtherSessions() || s.sessionNoAbsoluteOrIdleLifetime())) return MissingControlsVerdict.ABSENT; // src: vvaharness/skills/missing-controls/SKILL.md:78
        }
        if (ctl.isCookie() && θ["p.skill_missing-controls.cookie_report_per_site"] && s.isExplicitSetCookieOverridingConfig()) return s.hasAllFlags() ? MissingControlsVerdict.PRESENT : MissingControlsVerdict.ABSENT; // src: vvaharness/skills/missing-controls/SKILL.md:87
        if (ctl.isData()) {
            if (θ["p.skill_missing-controls.data_holes"] && (s.piiPlainColumn() || s.realLookingSeed() || s.secretInCacheOrQueue() || s.tlsVerifyDisabled())) { // src: vvaharness/skills/missing-controls/SKILL.md:104
                if (θ["p.skill_missing-controls.fp_synthetic_fixture_not_seeded"] && s.syntheticFixture() && !s.seededIntoRunningEnv()) return MissingControlsVerdict.REFUTED; // src: vvaharness/skills/missing-controls/SKILL.md:133
                return MissingControlsVerdict.ABSENT;
            }
        }
        if (θ["p.skill_missing-controls.fp_fixed_constant_target"] && s.targetIsFixedConstant()) return MissingControlsVerdict.REFUTED; // src: vvaharness/skills/missing-controls/SKILL.md:135
        if (θ["p.skill_missing-controls.state_which_fp_checked"]) s.recordFpChecksAndSearches();   // src: vvaharness/skills/missing-controls/SKILL.md:138
        return ctl.presentMarkersAt(s) ? MissingControlsVerdict.PRESENT : MissingControlsVerdict.ABSENT;
    }

    Finding finding(Site s, Control ctl, Theta θ) {
        // one finding per absent site, own file and line
        Finding f = θ["p.skill_missing-controls.one_finding_per_absent_site"] ? new Finding(s.file, s.line) : ctl.aggregateFinding(); // src: vvaharness/skills/missing-controls/SKILL.md:54
        // anchor on the line the fix edits: handler/decorator line, set_cookie call, settings line
        if (θ["p.skill_missing-controls.anchor_on_line_fix_edits"]) f.anchor(s.lineFixMustEdit()); // src: vvaharness/skills/missing-controls/SKILL.md:143
        // CWE choice follows the evidence (debug -> RCE if that is what it yields; name the misconfig as cause)
        f.cwe = θ["p.skill_missing-controls.cwe_choice_follows_evidence"] ? s.cweEvidenceSupports(ctl.cwes) : ctl.cwes.first(); // src: vvaharness/skills/missing-controls/SKILL.md:97
        // stored-in-cleartext (312) and returned-in-response (359/200) are separate findings
        if (θ["p.skill_missing-controls.stored_vs_returned_separate_findings"] && s.bothStoredAndReturned()) f.splitStoredAndReturned(); // src: vvaharness/skills/missing-controls/SKILL.md:108
        if (θ["p.skill_missing-controls.rationale_enumeration_counts"]) f.rationale = ctl.enumerationSummary(); // src: vvaharness/skills/missing-controls/SKILL.md:145
        return f;
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_missing-controls.trigger"]);                                              // src: vvaharness/skills/missing-controls/SKILL.md:3
        p.persona(θ["p.skill_missing-controls.hunt_for_hole_not_construct"]);                       // src: vvaharness/skills/missing-controls/SKILL.md:25
        p.rule(θ["p.skill_missing-controls.inverted_method"]);                                      // src: vvaharness/skills/missing-controls/SKILL.md:30
        return p;
    }

    Prompt hardGateSection(Theta θ) {
        Prompt p = new Prompt();
        p.evidence(θ["p.skill_missing-controls.gate_site_real_and_reachable"]);                     // src: vvaharness/skills/missing-controls/SKILL.md:35
        p.evidence(θ["p.skill_missing-controls.gate_control_belongs"]);                             // src: vvaharness/skills/missing-controls/SKILL.md:37
        p.evidence(θ["p.skill_missing-controls.gate_absent_on_this_path_checked"]);                 // src: vvaharness/skills/missing-controls/SKILL.md:40
        p.must(θ["p.skill_missing-controls.refute_if_control_anywhere_on_path"]);                   // src: vvaharness/skills/missing-controls/SKILL.md:44
        return p;
    }

    Prompt enumerateSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_missing-controls.grep_whole_repo_per_control"]);                          // src: vvaharness/skills/missing-controls/SKILL.md:53
        p.must(θ["p.skill_missing-controls.one_finding_per_absent_site"]);                          // src: vvaharness/skills/missing-controls/SKILL.md:54
        p.rule(θ["p.skill_missing-controls.refute_with_site_count"]);                               // src: vvaharness/skills/missing-controls/SKILL.md:55
        return p;
    }

    Prompt controlsSection(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.skill_missing-controls.control_anti_automation_cwes"]);                       // src: vvaharness/skills/missing-controls/SKILL.md:60
        p.checklist(θ["p.skill_missing-controls.anti_automation_sites"]);                           // src: vvaharness/skills/missing-controls/SKILL.md:61
        p.checklist(θ["p.skill_missing-controls.anti_automation_present_markers"]);                 // src: vvaharness/skills/missing-controls/SKILL.md:64
        p.rule(θ["p.skill_missing-controls.waf_only_if_visible_in_repo"]);                          // src: vvaharness/skills/missing-controls/SKILL.md:67
        p.rule(θ["p.skill_missing-controls.storage_without_enforcement_is_decoy"]);                 // src: vvaharness/skills/missing-controls/SKILL.md:68
        p.choose(θ["p.skill_missing-controls.control_session_termination_cwes"]);                   // src: vvaharness/skills/missing-controls/SKILL.md:71
        p.checklist(θ["p.skill_missing-controls.session_termination_sites"]);                       // src: vvaharness/skills/missing-controls/SKILL.md:72
        p.checklist(θ["p.skill_missing-controls.session_termination_present_markers"]);             // src: vvaharness/skills/missing-controls/SKILL.md:73
        p.rule(θ["p.skill_missing-controls.logout_without_revocation_hole"]);                       // src: vvaharness/skills/missing-controls/SKILL.md:76
        p.rule(θ["p.skill_missing-controls.session_other_holes"]);                                  // src: vvaharness/skills/missing-controls/SKILL.md:78
        p.choose(θ["p.skill_missing-controls.control_cookie_transport_cwes"]);                      // src: vvaharness/skills/missing-controls/SKILL.md:81
        p.must(θ["p.skill_missing-controls.cookie_sites_grep_all"]);                                // src: vvaharness/skills/missing-controls/SKILL.md:82
        p.checklist(θ["p.skill_missing-controls.cookie_present_markers"]);                          // src: vvaharness/skills/missing-controls/SKILL.md:84
        p.must(θ["p.skill_missing-controls.cookie_report_per_site"]);                               // src: vvaharness/skills/missing-controls/SKILL.md:87
        p.choose(θ["p.skill_missing-controls.control_debug_posture_cwes"]);                         // src: vvaharness/skills/missing-controls/SKILL.md:90
        p.checklist(θ["p.skill_missing-controls.debug_posture_sites"]);                             // src: vvaharness/skills/missing-controls/SKILL.md:91
        p.checklist(θ["p.skill_missing-controls.debug_posture_holes"]);                             // src: vvaharness/skills/missing-controls/SKILL.md:92
        p.tiebreak(θ["p.skill_missing-controls.cwe_choice_follows_evidence"]);                      // src: vvaharness/skills/missing-controls/SKILL.md:97
        p.choose(θ["p.skill_missing-controls.control_data_at_rest_cwes"]);                          // src: vvaharness/skills/missing-controls/SKILL.md:101
        p.checklist(θ["p.skill_missing-controls.data_sites"]);                                      // src: vvaharness/skills/missing-controls/SKILL.md:102
        p.rule(θ["p.skill_missing-controls.data_holes"]);                                           // src: vvaharness/skills/missing-controls/SKILL.md:104
        p.rule(θ["p.skill_missing-controls.stored_vs_returned_separate_findings"]);                 // src: vvaharness/skills/missing-controls/SKILL.md:108
        p.choose(θ["p.skill_missing-controls.control_request_forgery_cwes"]);                       // src: vvaharness/skills/missing-controls/SKILL.md:112
        p.must(θ["p.skill_missing-controls.enumerate_every_state_changing_handler"]);               // src: vvaharness/skills/missing-controls/SKILL.md:114
        p.rule(θ["p.skill_missing-controls.authorization_deferred_translate_framework"]);           // src: vvaharness/skills/missing-controls/SKILL.md:119
        return p;
    }

    Prompt fpSection(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.skill_missing-controls.fp_control_present_on_path"]);                      // src: vvaharness/skills/missing-controls/SKILL.md:127
        p.exemption(θ["p.skill_missing-controls.fp_public_by_design"]);                             // src: vvaharness/skills/missing-controls/SKILL.md:130
        p.exemption(θ["p.skill_missing-controls.fp_synthetic_fixture_not_seeded"]);                 // src: vvaharness/skills/missing-controls/SKILL.md:133
        p.exemption(θ["p.skill_missing-controls.fp_fixed_constant_target"]);                        // src: vvaharness/skills/missing-controls/SKILL.md:135
        p.must(θ["p.skill_missing-controls.state_which_fp_checked"]);                               // src: vvaharness/skills/missing-controls/SKILL.md:138
        return p;
    }

    Prompt goodOutputSection(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.skill_missing-controls.anchor_on_line_fix_edits"]);                           // src: vvaharness/skills/missing-controls/SKILL.md:143
        p.format(θ["p.skill_missing-controls.rationale_enumeration_counts"]);                       // src: vvaharness/skills/missing-controls/SKILL.md:145
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(hardGateSection(θ));
        p.include(enumerateSection(θ));
        p.include(controlsSection(θ));
        p.include(fpSection(θ));
        p.include(goodOutputSection(θ));
        return p;
    }
}

@executedBy(MODEL) @role(types)
enum MissingControlsVerdict { ABSENT, PRESENT, REFUTED, SKIP }
