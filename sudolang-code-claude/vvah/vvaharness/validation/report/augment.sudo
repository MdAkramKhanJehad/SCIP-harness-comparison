# vvaharness/validation/report/augment.py

Writes Stage 11 validation results into the combined report (SARIF and Markdown twins) under `security-remediation/`. Best effort: any failure is logged and never fails the validation run. SARIF results are matched to findings by fingerprint first, then by exact location, then by a unique title prefix; Markdown finding sections are matched by title and fail closed on ambiguity.

Source: `vvaharness/validation/report/augment.py` (lines 1-375)
Executor: code
Called from: `vvaharness/validation/cli/_run.sudo` (after all cases are validated)

// src: vvaharness/validation/report/augment.py:53-62
_FINDING_RE = /(?m)^### \d+\. \[[^\]]*\]\s*(.+?)\s*$/   // finding heading, for example "### 1. [HIGH] Some title"
_EXISTING_VALIDATION_RE = /(?s)\n+### Validation\n.*\Z/   // a previously appended block at the end of a finding segment
_LEVEL2_HEADING_RE = /(?m)^## /   // "## " ends a finding segment
BLOCK_KEY = "validation"; ALIAS_BLOCK_KEY = "validationAliases"   // written under SARIF result properties

// src: vvaharness/validation/report/augment.py:65-75
fn augment_reports(repo, pairs: [ValidatedFinding], report_md?):executor=code {
  try _augment(repo, pairs, report_md)
  catch any error => warn "report augmentation skipped (results not written to combined report): <type>: <error>"
  // "report augmentation must never fail the validation run"
}

// src: vvaharness/validation/report/augment.py:78-88
fn _augment(repo, pairs, report_md?):executor=code {
  located = _locate_combined_report(repo, report_md)
  require located != null => { warn "no combined report under <repo>/security-remediation — skipping report augmentation"; return }
  [sarif_dst, md_dst] = located
  _augment_sarif(sarif_dst, pairs)
  _augment_md(md_dst, pairs)
}

// src: vvaharness/validation/report/augment.py:91-104
fn _locate_combined_report(repo, report_md?):executor=code {
  if (report_md != null) {
    // explicit report wins: same file name with .md, looked up under security-remediation/
    md = "$repo/security-remediation/${ name of report_md with suffix .md }"; sarif = md with suffix ".sarif"
    return if (md exists && sarif exists) CombinedReportPaths(sarif, md) else null
  }
  sarifs = sorted("$repo/security-remediation" glob SCAN_REPORT_GLOB)   // SCAN_REPORT_GLOB = "*_report.sarif"
  if (sarifs is empty) return null
  sarif = last of sarifs   // newest by sorted name
  md = sarif with suffix ".md"
  return if (md exists) CombinedReportPaths(sarif, md) else null
}

// ---------- value helpers ----------

// src: vvaharness/validation/report/augment.py:110-120
fn _status_label(result, session_failed=false):executor=code {
  if (session_failed) return "inconclusive"
  if (result.fixed == "Yes") return "fixed"
  if (result.partially_fixed == "Yes") return "partially_fixed"
  if (result.not_fixed == "Yes") return "not_fixed"
  return "inconclusive"
}

// src: vvaharness/validation/report/augment.py:123-127
fn _status_word(result, session_failed=false):executor=code = match (_status_label(result, session_failed)) {
  case "fixed" => "Fixed"; case "partially_fixed" => "Partially Fixed"; case "not_fixed" => "Not Fixed"; case "inconclusive" => "Inconclusive"
}

// src: vvaharness/validation/report/augment.py:130-138
fn _parse_gates(raw_json):executor=code = parsed JSON object, or {} when empty, unparsable or not an object

// src: vvaharness/validation/report/augment.py:141-153
fn _validation_block(result, session_failed=false):executor=code {
  reason = trim(result.reason_for_decision || result.justification || "")
  if (session_failed && !reason) reason = "validation session failed; no verdict was reached"
  return SarifValidationBlock {
    validationStatus: _status_label(result, session_failed),
    validationReason: first 2000 characters of reason,
    weightedScore: result.fix_confidence,
    mergeReadiness: result.pr_merge_readiness,
    gateScores: _parse_gates(result.gate_results_json)
  }
}

// ---------- SARIF augmentation ----------

// src: vvaharness/validation/report/augment.py:159-176
fn _result_loc(sarif_result):executor=code {
  // first location's physicalLocation artifactLocation.uri (backslashes folded to "/") and region.startLine
  return SarifLocation(uri, start_line), or null when any field is missing or malformed
}

// src: vvaharness/validation/report/augment.py:179-207
fn _match_by_loc(results, file, line):executor=code = first result with _result_loc(result) == SarifLocation(file with "\\" folded to "/", line)
fn _match_by_title(results, title):executor=code = the result whose message.text starts with title, only when exactly one does; else null
fn _match_by_fingerprint(results, case_id):executor=code = if (!case_id) null else first result where s9.typed_sarif.result_identifies(result, case_id)

// src: vvaharness/validation/report/augment.py:210-225
fn _match_sarif(results, finding, case_id=""):executor=code {
  // "Fingerprint wins (survives multi-CWE pileups); loc/title exclude foreign fingerprints"
  hit = _match_by_fingerprint(results, case_id)
  if (hit) return hit
  candidates = results where (!case_id || result has no fingerprint || result_identifies(result, case_id))
  by_loc = if (finding.file) _match_by_loc(candidates, finding.file, finding.line_start) else null
  if (by_loc) return by_loc
  title = trim(finding.title || "")
  return if (title) _match_by_title(candidates, title) else null
}

// src: vvaharness/validation/report/augment.py:228-251
fn _augment_sarif(path, pairs):executor=code {
  document = parse JSON of path
  results = document.runs[0].results (or [])   // only the first run is augmented
  for each [finding, row, session_failed] in pairs {
    case_id = string(finding.case_id || row.tracking_id || "")   // harness id first: "tracking_id is model output, a hallucination poisons the exclusion"
    match = _match_sarif(results, finding, case_id)
    if (match == null) continue
    count matched; if (case_id && result_identifies(match, case_id)) count matched by fingerprint
    block = _validation_block(row, session_failed)
    if (!s9.typed_sarif.record_result_block(match, case_id, block, key=BLOCK_KEY, alias_key=ALIAS_BLOCK_KEY)) count aliased
    // external: vvaharness/pipeline/stages/s9/typed_sarif.py decides whether the block lands under "validation" or under "validationAliases"
  }
  console: "  [s11] SARIF augment: matched <matched>/<pairs> finding(s), <by_print> by <FINGERPRINT_KEY>" (+ ", <aliased> recorded under validationAliases" when any)
  write document back to path as indented JSON
}

// ---------- Markdown augmentation ----------

// src: vvaharness/validation/report/augment.py:257-262
_MD_ESCAPE = per-character escapes for \\ ` * _ [ ] | # (backslash-escaped) and < > & (HTML entities)   // mirrors remediation_agent mdsafe.py

// src: vvaharness/validation/report/augment.py:265-288
fn _md_escape(text, limit=2000):executor=code {
  if (text == null) return ""
  // line breaks become spaces, invisible characters are removed, then each character is escaped
  cleaned = escape(remove invisible characters(replace line breaks with " " in string(text)))
  return _trim_dangling_escape(first limit characters of cleaned)   // drops a trailing lone backslash left by truncation (odd run)
}
_WEIGHTED_SCORE_KEY = "weighted_score"
fn _md_cell(text):executor=code = _md_escape(text, limit=200)

// src: vvaharness/validation/report/augment.py:291-303
fn _gate_rows(gates):executor=code {
  for each [name, entry] in gates {
    if (entry is an object) "  | name | entry.status | entry.weight | entry.weighted_score |"   // each cell through _md_cell
    else "  | name | entry | | |"
  }
}

// src: vvaharness/validation/report/augment.py:306-324
fn _md_validation_section(result, session_failed=false):executor=code {
  "### Validation"
  "- **Status:** ${ _status_word(result, session_failed) }"
  "- **Weighted score:** ${ result.fix_confidence }  (merge readiness: ${ result.pr_merge_readiness || "n/a" })"
  summary = trim(result.justification || result.reason_for_decision || "")
  // preserved: the Markdown summary prefers justification, while the SARIF validationReason prefers reason_for_decision
  if (!summary && session_failed) summary = "validation session failed; no verdict was reached"
  if (summary) "- **Summary:** ${ _md_escape(summary) }"
  rows = _gate_rows(_parse_gates(result.gate_results_json))
  if (rows) { "- **Gate scores:**"; ""; "  | gate | status | weight | weighted |"; "  |---|---|---|---|"; ...rows }
}

// src: vvaharness/validation/report/augment.py:327-348
fn _best_md_match(title, pairs):executor=code {
  // "failing closed to None on ambiguity (CWE-345)"
  norm = lowercase(trim(title))
  if (!norm) return null
  ftitle(pair) = lowercase(trim(pair.finding.title || pair.row.finding_title || ""))
  exact = pairs where ftitle(pair) == norm
  if (exact) return exact[0] if exactly one else null
  partial = pairs where ftitle(pair) is non-empty && (ftitle(pair) in norm || norm in ftitle(pair))
  return partial[0] if exactly one else null
}

// src: vvaharness/validation/report/augment.py:351-366
fn _augment_md(path, pairs):executor=code {
  text = read path
  headings = all _FINDING_RE matches in text
  if (headings is empty) return   // file untouched
  for each heading {
    segment ends at the next finding heading, or earlier at the first "## " heading after it   // "## " material stays below the block
    pair = _best_md_match(heading title, pairs)
    replace the segment with _augment_segment(segment, pair)
  }
  write the rebuilt text to path
}

// src: vvaharness/validation/report/augment.py:369-375
fn _augment_segment(segment, pair?):executor=code {
  if (pair == null) return segment   // unmatched finding left as is
  stripped = remove any prior "### Validation" block at the end of segment
  return rstrip(stripped) + "\n\n" + _md_validation_section(pair.row, pair.session_failed) + "\n"
}
