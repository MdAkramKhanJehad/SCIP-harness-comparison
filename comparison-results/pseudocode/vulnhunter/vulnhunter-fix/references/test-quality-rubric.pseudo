// file: vulnhunter-fix/references/test-quality-rubric.md
// Rule book (REQ-GRA-016): R1-R5 quality rules for generated security tests and the GOOD/WEAK/WRONG verdict matrix.
// Enforced by the reviewer-test agent (prompts/reviewer_test.md) during Phase 4 verify (prompts/verify.md);
// also cited by prompts/worker_agent_common.md when workers write tests in Phase 3.

@executedBy(MODEL) @role(types)
enum TestVerdict { GOOD, WEAK, WRONG }                                                               // src: vulnhunter-fix/references/test-quality-rubric.md:64

@executedBy(MODEL) @role(rule_set) @stage("fix.verify")
class TestQualityRubric {

    // Entry: grade one generated test, then act on the verdict.
    String run(SecurityTest t, Finding f, PlanArtifact plan, Theta θ) {
        Map<String, Boolean> pass = new Map();
        pass.put("R1", r1ImportsProductionFunction(t, f, θ));
        pass.put("R2", r2DiscriminatingPayload(t, f, θ));
        pass.put("R3", r3FailClosedAssertion(t, θ));
        pass.put("R4", r4NotStandaloneDemo(plan, θ));
        pass.put("R5", r5MirrorsScanVector(t, f, θ));
        String v = verdict(pass, plan, θ);
        act(v, t, f, θ);
        return v;
    }

    boolean r1ImportsProductionFunction(SecurityTest t, Finding f, Theta θ) {
        if (!θ["p.test-quality-rubric.r1_imports_production_function"]) return true;              // src: vulnhunter-fix/references/test-quality-rubric.md:12
        if (t.reimplements(f.productionSymbol)) return false;                                        // reimplementing in-test is WRONG
        for (String signal : θ["p.test-quality-rubric.r1_detection_per_language"]) {               // src: vulnhunter-fix/references/test-quality-rubric.md:15
            if (signal.appliesTo(t.language) && t.matches(signal, f.productionSymbol)) return true;
        }
        return false;
    }

    boolean r2DiscriminatingPayload(SecurityTest t, Finding f, Theta θ) {
        if (!θ["p.test-quality-rubric.r2_discriminating_payload"]) return true;                    // src: vulnhunter-fix/references/test-quality-rubric.md:24
        if (θ["p.test-quality-rubric.r2_exact_string"]) {                                            // src: vulnhunter-fix/references/test-quality-rubric.md:28
            return t.payload == f.pocPayload;                                                        // e.g. "' OR 1=1--", not test_input
        }
        return t.payload.equivalentShape(f.pocPayload);
    }

    boolean r3FailClosedAssertion(SecurityTest t, Theta θ) {
        if (!θ["p.test-quality-rubric.r3_fail_closed_assertion"]) return true;                     // src: vulnhunter-fix/references/test-quality-rubric.md:34
        if (θ["p.test-quality-rubric.r3_assert_equality_not_inequality"] && t.assertsInequalityToInsecure()) return false; // src: vulnhunter-fix/references/test-quality-rubric.md:37
        if (θ["p.test-quality-rubric.r3_specific_exception_type"] && t.raisesBaseClassOnly()) return false;                 // src: vulnhunter-fix/references/test-quality-rubric.md:39
        if (t.acceptsSuccessOrSafe()) return false;                                                  // e.g. status_code in (200, 401, 403)
        if (θ["p.test-quality-rubric.r5_config_checks_violate"] && t.assertsOnConfigOnly()) return false; // src: vulnhunter-fix/references/test-quality-rubric.md:60
        return true;
    }

    boolean r4NotStandaloneDemo(PlanArtifact plan, Theta θ) {
        if (!θ["p.test-quality-rubric.r4_not_standalone_demo"]) return true;                       // src: vulnhunter-fix/references/test-quality-rubric.md:45
        DiscriminationEvidence e = plan.discriminationEvidence;                                      // Step E.5 (REQ-GRA-017)
        return e != null && e.preFixResult == "fail" && e.postFixResult == "pass";                  // src: vulnhunter-fix/references/test-quality-rubric.md:48
    }

    boolean r5MirrorsScanVector(SecurityTest t, Finding f, Theta θ) {
        if (!θ["p.test-quality-rubric.r5_mirrors_scan_vector"]) return true;                       // src: vulnhunter-fix/references/test-quality-rubric.md:54
        if (θ["p.test-quality-rubric.r5_config_checks_violate"] && t.assertsOnConfigOnly()) return false; // src: vulnhunter-fix/references/test-quality-rubric.md:60
        return t.attackShape == f.statedVector;                                                      // SSRF http://internal/ not file:///etc/passwd
    }

    String verdict(Map<String, Boolean> pass, PlanArtifact plan, Theta θ) {
        List<String> verdicts = θ["p.test-quality-rubric.verdict_set"];                             // src: vulnhunter-fix/references/test-quality-rubric.md:64
        int required = θ["p.test-quality-rubric.all_five_rules_required"];                          // src: vulnhunter-fix/references/test-quality-rubric.md:6
        if (θ["p.test-quality-rubric.verdict_good_condition"] == "R1..R5 all pass" && pass.countTrue() >= required) { // src: vulnhunter-fix/references/test-quality-rubric.md:68
            return "GOOD";
        }
        for (String r : θ["p.test-quality-rubric.verdict_wrong_condition"]) {                       // src: vulnhunter-fix/references/test-quality-rubric.md:70
            if (!pass.get(r)) return "WRONG";
        }
        if (pass.get("R4") == false) return θ["p.test-quality-rubric.r4_missing_evidence_is_wrong"]; // src: vulnhunter-fix/references/test-quality-rubric.md:48
        if (θ["p.test-quality-rubric.verdict_weak_condition"] && stillDiscriminates(plan) && fixableGap(pass)) { // src: vulnhunter-fix/references/test-quality-rubric.md:69
            return "WEAK";
        }
        return "WRONG";                                                                              // "WEAK at best and typically WRONG"
    }

    void act(String v, SecurityTest t, Finding f, Theta θ) {
        if (v == "GOOD") return;
        if (θ["p.test-quality-rubric.failing_test_enters_repair_loop"]) {                           // src: vulnhunter-fix/references/test-quality-rubric.md:8
            RepairLoop.enter(t);
        }
        if (v == "WEAK") {
            FixBrief brief = VerificationAgent.writeFixBrief(t);                                     // src: vulnhunter-fix/references/test-quality-rubric.md:69
            if (θ["p.test-quality-rubric.weak_adjust_with_approval"]) FixAgent.adjustTest(t, brief, VerificationAgent.approval()); // src: vulnhunter-fix/references/test-quality-rubric.md:72
        } else if (v == "WRONG") {
            if (θ["p.test-quality-rubric.wrong_rewrite_from_poc"]) {                                // src: vulnhunter-fix/references/test-quality-rubric.md:72
                t.discard();
                FixAgent.rewriteTestFromPoc(f);
            }
        }
    }
}
