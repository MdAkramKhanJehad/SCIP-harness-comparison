// file: vvaharness/backends/harness/deepagents/options/filesystem.py
// Filesystem permissioning, backend selection and skill sources for deepagents sessions: write-deny globs,
// a no-write backend, a path jail, a scan-scope-confined read backend (read/grep/glob/ls filtered to the S1
// inventory), an optional executing shell backend, a .git-guarded stock backend, and grep/glob timeout patching.

@executedBy(CODE) @role(backend)
class Filesystem {

    // Deny all writes for a read-only session; a write session may only target paths under cwd, and .git stays denied.
    List<FilesystemPermission> filesystemPermissions(Object options, Theta θ) {
        if (options.base.allowWrites) {                                                                  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:60
            Path root = options.base.cwd.resolve();
            for (String raw : options.base.writablePaths) {                                              // src: vvaharness/backends/harness/deepagents/options/filesystem.py:63
                Path candidate = Path.of(raw).resolve();
                if (!candidate.equals(root) && !candidate.parents().contains(root)) throw new ValueError("writable path escapes harness cwd"); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:65
            }
            return DeepagentsModels.gitInternalsDeny();                                                  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:67
        }
        return DeepagentsModels.readOnlyPermissions(θ);                                                  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:68
    }

    // Every ancestor dir of an in-scope file (ls shows only these, so an excluded file's NAME never leaks).
    Set<String> inScopeDirs(Set<String> scope) {
        Set<String> dirs = new Set();
        for (String rel : scope) {                                                                       // src: vvaharness/backends/harness/deepagents/options/filesystem.py:76
            List<String> parts = rel.split("/").dropLast();
            for (int depth = 1; depth <= parts.size(); depth++) dirs.add(String.join("/", parts.subList(0, depth))); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:79
        }
        return dirs;
    }

    boolean dirExcluded(String rel, Set<String> scope) {
        if (rel.split("/").anyMatch(p -> ALWAYS_EXCLUDED_DIRS.contains(p.toLowerCase()))) return true;   // backends/llm/tools // src: vvaharness/backends/harness/deepagents/options/filesystem.py:223
        // .vvaharness/skills post-dates s1's walk; without this exemption every scan loads zero skills
        if (alwaysAllowed(rel + "/")) return false;                          // backends/llm/tools        // src: vvaharness/backends/harness/deepagents/options/filesystem.py:226
        return !rel.isEmpty() && scope != null && !inScopeDirs(scope).contains(rel);                     // src: vvaharness/backends/harness/deepagents/options/filesystem.py:228
    }

    // execute ignores routing; a non-empty routes map is the only way past NotImplementedError.
    CompositeBackend shellComposite(Path cwd, Theta θ) {
        ShellScopedReadBackend shell = new ShellScopedReadBackend(cwd, true, θ["code.backends.harness.deepagents.options.filesystem.shell_inherit_env"]); // virtual_mode, inherit_env // src: vvaharness/backends/harness/deepagents/options/filesystem.py:238
        return new CompositeBackend(shell, Map.of("/", shell));                                          // src: vvaharness/backends/harness/deepagents/options/filesystem.py:239
    }

    BackendProtocol scopedBackend(StreamingOptions options, Theta θ) {
        if (options.allowShell) return shellComposite(options.base.cwd, θ);                              // src: vvaharness/backends/harness/deepagents/options/filesystem.py:244
        return new ScopedReadBackend(options.base.cwd, true);                                            // src: vvaharness/backends/harness/deepagents/options/filesystem.py:246
    }

    // Backend choice: scoped (when a PermitTools gate is set), no-write (one-shot parsers), stock+jail (frozen S10/S11).
    BackendProtocol sessionBackend(Object options, Theta θ) {
        filesystemPermissions(options, θ);                                   // validates writable_paths   // src: vvaharness/backends/harness/deepagents/options/filesystem.py:295
        // keyed off the SAME permitted_tool_calls as the gate, so the two cannot drift
        if (options.permittedToolCalls != null) return scopedBackend(options, θ);                        // src: vvaharness/backends/harness/deepagents/options/filesystem.py:297
        // one-shot = detection parser: fail closed (a tool-less turn cannot recover an eviction)
        if (options instanceof OneShotOptions) return new NoWriteBackend(options.base.cwd, true);        // src: vvaharness/backends/harness/deepagents/options/filesystem.py:300
        return new StockReadBackend(options.base.cwd, true);                                             // src: vvaharness/backends/harness/deepagents/options/filesystem.py:303
    }

    // Temporarily raise deepagents' hard-coded 5s glob / 15s grep timeouts (module-global; null is a no-op).
    TimeoutOverride patchedReadTimeouts(Double seconds, Theta θ) {
        if (seconds == null) return null;                                                                // src: vvaharness/backends/harness/deepagents/options/filesystem.py:309
        int grepTimeout = (int) seconds;                                                                 // src: vvaharness/backends/harness/deepagents/options/filesystem.py:313
        int asyncGrepTimeout = θ["code.backends.harness.deepagents.options.filesystem.async_grep_timeout_factor"] * grepTimeout
                             + θ["code.backends.harness.deepagents.options.filesystem.async_grep_timeout_pad_s"]; // src: vvaharness/backends/harness/deepagents/options/filesystem.py:314
        Object originals = Tuple.of(DEFAULT_GLOB_TIMEOUT, DEFAULT_GREP_TIMEOUT, ASYNC_GREP_TIMEOUT, PYTHON_SEARCH_TIMEOUT); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:316
        DEFAULT_GLOB_TIMEOUT = seconds;                                                                  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:323
        DEFAULT_GREP_TIMEOUT = grepTimeout;                                                              // src: vvaharness/backends/harness/deepagents/options/filesystem.py:324
        ASYNC_GREP_TIMEOUT = asyncGrepTimeout;                                                           // src: vvaharness/backends/harness/deepagents/options/filesystem.py:325
        PYTHON_SEARCH_TIMEOUT = grepTimeout;                                                             // src: vvaharness/backends/harness/deepagents/options/filesystem.py:326
        return new TimeoutOverride(originals);                      // restored on exit (finally)         // src: vvaharness/backends/harness/deepagents/options/filesystem.py:329
    }

    // skill_root as a virtual-path skill source under the session cwd; outside cwd is an error.
    List<String> skillSources(Path skillRoot, Path cwd) {
        if (skillRoot == null || !skillRoot.isDir()) return List.of();                                   // src: vvaharness/backends/harness/deepagents/options/filesystem.py:339
        Path root = skillRoot.resolve();
        Path base = cwd.resolve();
        if (!root.isRelativeTo(base)) throw new ValueError("skill_root must live under the session cwd"); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:342
        String relative = root.relativeTo(base).asPosix();
        return List.of(relative.equals(".") ? "/" : "/" + relative);                                     // src: vvaharness/backends/harness/deepagents/options/filesystem.py:346
    }
}

// Write surface fails closed without touching disk (middleware eviction/offload writes would otherwise reach the repo).
@executedBy(CODE) @role(backend)
class NoWriteBackend {
    WriteResult write(String filePath, String content) {
        return new WriteResult("write operations are disabled on detection sessions: " + filePath);      // src: vvaharness/backends/harness/deepagents/options/filesystem.py:92
    }
    EditResult edit(String filePath, String oldString, String newString, boolean replaceAll) {
        return new EditResult("write operations are disabled on detection sessions: " + filePath);       // src: vvaharness/backends/harness/deepagents/options/filesystem.py:101
    }
    DeleteResult delete(String filePath) {
        return new DeleteResult("write operations are disabled on detection sessions: " + filePath);     // src: vvaharness/backends/harness/deepagents/options/filesystem.py:104
    }
    List<FileUploadResponse> uploadFiles(List<Pair> files) {
        return files.map(f -> new FileUploadResponse(f.first, "write operations are disabled on detection sessions")); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:109
    }
}

// Crash-proof path jail: traversal, ~ and escapes return a PermissionError (an OSError the tool reports), not a crash.
@executedBy(CODE) @role(backend)
class PathJail {
    Path resolvePath(String key) {
        if (!virtualMode) return superResolvePath(key);                                                  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:119
        String vpath = key.startsWith("/") ? key : "/" + key;                                            // src: vvaharness/backends/harness/deepagents/options/filesystem.py:121
        if (vpath.parts().contains("..") || key.startsWith("~")) {                                       // src: vvaharness/backends/harness/deepagents/options/filesystem.py:124
            COUNTERS.bump("deepagents_path_jail_refused");                                               // src: vvaharness/backends/harness/deepagents/options/filesystem.py:125
            throw new PermissionError("ERROR: path is outside the scan root; use a repo-relative path");  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:126
        }
        Path full = cwd.resolve(vpath.lstrip("/")).resolve();                                            // src: vvaharness/backends/harness/deepagents/options/filesystem.py:127
        if (!full.isRelativeTo(cwd)) {                                                                   // src: vvaharness/backends/harness/deepagents/options/filesystem.py:129
            COUNTERS.bump("deepagents_path_jail_refused");                                               // src: vvaharness/backends/harness/deepagents/options/filesystem.py:131
            throw new PermissionError("ERROR: path is outside the scan root; use a repo-relative path");  // src: vvaharness/backends/harness/deepagents/options/filesystem.py:132
        }
        raiseIfSymlinkLoop(full);                                                                        // src: vvaharness/backends/harness/deepagents/options/filesystem.py:133
        return full;
    }
}

// Read surface confined to the S1 scan-scope inventory (shared registry with the sdk/openai routes); writes refused.
@executedBy(CODE) @role(backend)
class ScopedReadBackend {

    Set<String> scope() {
        return scopeFor(cwd);                       // backends/llm/tools; null before s1 has run        // src: vvaharness/backends/harness/deepagents/options/filesystem.py:143
    }

    String relOf(String filePath) {
        try {
            return PathJail.resolvePath(filePath).relativeTo(cwd).asPosix();                             // src: vvaharness/backends/harness/deepagents/options/filesystem.py:149
        } catch (OSError e) {
            return null;                            // never replace the jail's own refusals             // src: vvaharness/backends/harness/deepagents/options/filesystem.py:151
        }
    }

    ReadResult read(String filePath, int offset, int limit, Theta θ) {
        // limit default: θ["code.backends.harness.deepagents.options.filesystem.read_default_limit"] lines
        if (limit <= 0) limit = θ["code.backends.harness.deepagents.options.filesystem.read_default_limit"]; // src: vvaharness/backends/harness/deepagents/options/filesystem.py:153
        String rel = relOf(filePath);
        // scope check BEFORE the existence check, so it is never an existence oracle
        if (rel != null && !rel.equals(".") && excludedRel(rel, scope())) return new ReadResult(SCOPE_ERROR); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:156
        return superRead(filePath, offset, limit);                                                       // src: vvaharness/backends/harness/deepagents/options/filesystem.py:158
    }

    GrepResult grep(String pattern, String path, String glob, Integer maxCount, int contextLines) {
        Set<String> scope = scope();
        if (path != null) {                                                                              // src: vvaharness/backends/harness/deepagents/options/filesystem.py:170
            String rel = relOf(path);
            // only a named excluded FILE is refused; directories fall through
            if (rel != null && !rel.equals(".") && cwd.resolve(rel).isFile() && excludedRel(rel, scope)) { // src: vvaharness/backends/harness/deepagents/options/filesystem.py:173
                return new GrepResult(SCOPE_ERROR, List.of());                                           // src: vvaharness/backends/harness/deepagents/options/filesystem.py:179
            }
        }
        GrepResult result = superGrep(pattern, path, glob, maxCount, contextLines);                      // src: vvaharness/backends/harness/deepagents/options/filesystem.py:182
        if (!result.matches.isEmpty()) result.matches = result.matches.filter(m -> !excludedRel(m.path.lstrip("/"), scope)); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:187
        return result;
    }

    GlobResult glob(String pattern, String path) {
        GlobResult result = superGlob(pattern, path);                                                    // src: vvaharness/backends/harness/deepagents/options/filesystem.py:195
        if (!result.matches.isEmpty()) result.matches = result.matches.filter(m -> !excludedRel(m.path.lstrip("/"), scope())); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:198
        return result;
    }

    boolean entryExcluded(FileInfo entry, Set<String> scope) {
        String rel = entry.path.strip("/");                                                              // src: vvaharness/backends/harness/deepagents/options/filesystem.py:206
        if (!entry.isDir) return !rel.isEmpty() && excludedRel(rel, scope);                              // src: vvaharness/backends/harness/deepagents/options/filesystem.py:208
        return Filesystem.dirExcluded(rel, scope);                                                       // src: vvaharness/backends/harness/deepagents/options/filesystem.py:209
    }

    LsResult ls(String path) {
        LsResult result = superLs(path);                                                                 // src: vvaharness/backends/harness/deepagents/options/filesystem.py:212
        if (!result.entries.isEmpty()) result.entries = result.entries.filter(e -> !entryExcluded(e, scope())); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:215
        return result;
    }
}

// Inventory-scoped file operations plus execute, used only when a stage sets allow_shell.
@executedBy(CODE) @role(backend)
class ShellScopedReadBackend {
    ExecuteResult execute(String command) {
        return localShellExecute(command);                                                               // src: vvaharness/backends/harness/deepagents/options/filesystem.py:231
    }
}

// Frozen S10/S11 backend: stock read reach and writes, but writes into .git metadata are refused.
@executedBy(CODE) @role(backend)
class StockReadBackend {
    WriteResult write(String filePath, String content) {
        if (GitPaths.isGitMetadata(filePath)) return new WriteResult("writes into version-control metadata (.git) are refused"); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:258
        return superWrite(filePath, content);                                                            // src: vvaharness/backends/harness/deepagents/options/filesystem.py:260
    }
    EditResult edit(String filePath, String oldString, String newString, boolean replaceAll) {
        if (GitPaths.isGitMetadata(filePath)) return new EditResult("writes into version-control metadata (.git) are refused"); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:269
        return superEdit(filePath, oldString, newString, replaceAll);                                    // src: vvaharness/backends/harness/deepagents/options/filesystem.py:271
    }
    DeleteResult delete(String filePath) {
        if (GitPaths.isGitMetadata(filePath)) return new DeleteResult("writes into version-control metadata (.git) are refused"); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:274
        return superDelete(filePath);                                                                    // src: vvaharness/backends/harness/deepagents/options/filesystem.py:276
    }
    List<FileUploadResponse> uploadFiles(List<Pair> files) {
        List<Pair> allowed = files.filter(f -> !GitPaths.isGitMetadata(f.first));                        // src: vvaharness/backends/harness/deepagents/options/filesystem.py:281
        return files.map(f -> GitPaths.isGitMetadata(f.first) ? new FileUploadResponse(f.first, "refused") : superUpload(f)); // src: vvaharness/backends/harness/deepagents/options/filesystem.py:283
    }
}
