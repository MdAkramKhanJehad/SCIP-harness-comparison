// file: vvaharness/validation/tools/test_inventory.py
// Deterministic TestInventory fact tool: lists test files in scope (tests included) and flags negative /
// adversarial test markers in each.

@executedBy(CODE) @role(tool) @stage("S11")
class ToolsTestInventory {

    List<Regex> markerPatterns(Theta θ) {
        return TestInventory.negativeTestMarkers(θ).map(m -> Regex.compileIgnoreCase("(?<!w)" + Regex.escape(m) + "(?!w)")); // word-bounded  // src: vvaharness/validation/tools/test_inventory.py:31
    }

    boolean isTestFile(String name, Theta θ) {
        TestNameRules py = TestInventory.pyTestNames(θ);
        if (py.exact.contains(name)) return true;                                                    // src: vvaharness/validation/tools/test_inventory.py:38
        if (name.endsWith(".py") && (name.startsWith(py.prefix) || name.endsWith(py.suffix))) return true; // src: vvaharness/validation/tools/test_inventory.py:40
        return TestInventory.jsTestSuffixes(θ).any(s -> name.endsWith(s));                           // src: vvaharness/validation/tools/test_inventory.py:44
    }

    List<String> negativeMarkers(String text, Theta θ) {
        return TestInventory.negativeTestMarkers(θ).filter(m -> markerPatternFor(m).search(text)).distinct().sorted(); // src: vvaharness/validation/tools/test_inventory.py:48
    }

    Regex markerPatternFor(String marker) {
        return Regex.compileIgnoreCase("(?<!w)" + Regex.escape(marker) + "(?!w)");                   // src: vvaharness/validation/tools/test_inventory.py:32
    }

    Map testInventory(Path workspace, Theta θ) {
        List<Map> testFiles = new List();
        for (Path filePath : ToolsScope.iterInScopeFiles(workspace, true, θ)) {                      // src: vvaharness/validation/tools/test_inventory.py:54
            if (!isTestFile(filePath.name(), θ)) continue;                                           // src: vvaharness/validation/tools/test_inventory.py:55
            String text;
            try {
                text = filePath.readText("replace");                                                 // src: vvaharness/validation/tools/test_inventory.py:58
            } catch (OSError e) {
                continue;                                                                            // src: vvaharness/validation/tools/test_inventory.py:60
            }
            List<String> markers = negativeMarkers(text, θ);                                         // src: vvaharness/validation/tools/test_inventory.py:61
            testFiles.add(Map.of("file", filePath.relativeTo(workspace), "lines", text.splitlines().size(), "negative_test_markers", markers, "has_negative_tests", !markers.isEmpty())); // src: vvaharness/validation/tools/test_inventory.py:62
        }
        testFiles.sortBy(i -> i.get("file"));                                                        // src: vvaharness/validation/tools/test_inventory.py:70
        return Map.of("test_files", testFiles, "total_test_files", testFiles.size(),                 // src: vvaharness/validation/tools/test_inventory.py:71
                      "files_with_negative_tests", testFiles.count(i -> i.get("has_negative_tests")));
    }
}
