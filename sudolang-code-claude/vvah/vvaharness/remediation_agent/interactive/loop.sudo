# vvaharness/remediation_agent/interactive/loop.py

The interactive remediation session for `vvaharness remediate -i`: an arrow-key menu on a real terminal, else a numbered prompt. Each chosen finding goes through the same `apply_plugin` path as the batch loop and is checkpointed, but nothing is skipped on resume.

Source: `vvaharness/remediation_agent/interactive/loop.py` (lines 1-159)
Executor: code (apply_plugin contains the model call)
Called from: `vvaharness/remediation_agent/remediate.sudo` remediate (when --interactive or -i)

// src: vvaharness/remediation_agent/interactive/loop.py:81-108
fn run_interactive(findings, report_path, rem_dir, ckpt_dir, run_id, cfg, mode, out?, verbose=false):executor=code {
  out = out or standard error
  policy_ctx = policy.context.build_context(cfg, parent of rem_dir)   // built once; the repository is taken as the parent of security-remediation
  // preserved: the comment at loop.py:86 says "no-op unless step_remediate.enforce_policy", but enforcement defaults to true (policy/context.py:36-38)
  if (policy_ctx.enabled) console "policy gate ENABLED (deny-list + playbook + diff post-gate)"
  interactive_tty = standard input and out are both terminals (false if the check raises)
  session = if (interactive_tty) _loop_tty(...) else _loop_prompt(...)
  console ok "exited — $session remediated this session (<done>/<total> total complete)"
  return 0   // always 0, whatever the outcomes
}

// src: vvaharness/remediation_agent/interactive/loop.py:111-138
fn _loop_tty(findings, ..., out, verbose, policy_ctx):executor=code {
  cursor = 0; session = 0
  loop {
    render._clear_and_draw(findings, cursor, out)
    try key = keys._read_key();
    catch RuntimeError => return session + _loop_prompt(...)   // lost the raw terminal: degrade to the prompt
    match (key) {
      case QUIT => return session
      case UP => cursor = (cursor - 1) modulo length(findings)
      case DOWN => cursor = (cursor + 1) modulo length(findings)
      case ENTER => { clear screen; if (_remediate_one(findings[cursor], ...)) session += 1 }
    }
  }
}

// src: vvaharness/remediation_agent/interactive/loop.py:141-159
fn _loop_prompt(findings, ..., verbose, policy_ctx):executor=code {
  session = 0
  loop {
    print render.render_rows(findings)
    try raw = input("  Select issues (e.g. 1,3-5 | all | pending | q): ");
    catch (EOFError | KeyboardInterrupt) => return session
    picks = render.parse_selection(raw, findings)
    if (picks == null) return session
    for each i in picks { if (_remediate_one(findings[i], ...)) session += 1 }   // sequential, in pick order
  }
}

// src: vvaharness/remediation_agent/interactive/loop.py:49-78
fn _remediate_one(target, report_path, rem_dir, ckpt_dir, run_id, cfg, mode, verbose=false, policy_ctx?):executor=code {
  step = runner.step_key_of(target, cfg); label = redact(target.label)
  try {
    out_dir = artifact_dir(rem_dir, target.slug)   // inside the try: a planted symlinked slug folder fails only this finding, not the session (unlike runner.remediate_one)
    remediation = plugin_runner.run.apply_plugin(target, out_dir, cfg, repo=parent of rem_dir, mode, verbose, policy_ctx)
    // the finding identity is bound into the row so Stage 11's provenance check (provenance.owned_cases) trusts this case like the other remediate paths
    record = plugin_runner.run.checkpoint_record(target, out_dir, remediation) + { finding_id: target.case_id }
    checkpoints.save_ckpt(ckpt_dir, run_id, step, record)
    // mirror discovery.completed_case_ids, so a declined attempt shows no done mark next session
    target.done = models.derive.state_of([Attempt(ordinal=1, remediation)]) in [REMEDIATED, VALIDATED]
    return true
  } catch error => {
    warn REMEDIATION_FINDING_FAILED(finding=target.index, detail=redact(error))
    return false   // never raises, so the menu keeps running
  }
  // preserved: "session" counts every attempt that did not raise, including policy denials and "Not Fixed" outcomes, although the exit line calls it "remediated this session"
  // a finding already marked done can be selected and remediated again; no checkpoint is read on this path; report_path is accepted but unused
}
