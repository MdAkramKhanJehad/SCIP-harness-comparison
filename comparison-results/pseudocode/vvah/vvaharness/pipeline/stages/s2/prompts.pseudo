// file: vvaharness/pipeline/stages/s2/prompts.py
// S2's prompt text: the SYSTEM brief, the agentic/graph/shell system lines, the baseline block,
// the evidence-bearing user prompt, and the JSON repair re-ask.

@executedBy(MODEL) @role(prompt) @stage("S2")
class S2Prompts {

    /** SYSTEM: STRIDE threat model from a structural snapshot. */
    Prompt run(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s2.method"]);                                                   // src: vvaharness/pipeline/stages/s2/prompts.py:35
        p.persona(θ["p.s2_prompts.role_threat_modeler"]);                                // src: vvaharness/pipeline/stages/s2/prompts.py:36
        p.context(θ["p.s2_prompts.structural_snapshot_only"]);                           // NOT the source code bodies  // src: vvaharness/pipeline/stages/s2/prompts.py:40
        p.rule(θ["p.s2_prompts.threat_not_vulnerability"]);                              // a threat survives a patch  // src: vvaharness/pipeline/stages/s2/prompts.py:44
        p.include(stages(θ));
        p.include(outputSchema(θ));
        p.include(coverageRules(θ));
        p.include(breadth(θ));
        p.include(breadthWithinFile(θ));
        p.include(selfCheck(θ));
        return p;
    }

    /** "Work through these stages:" 1..5 */
    Prompt stages(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s2_prompts.stage_order"]);                                           // src: vvaharness/pipeline/stages/s2/prompts.py:47
        p.step(1, θ["p.s2_prompts.stage1_system_context"]);                              // src: vvaharness/pipeline/stages/s2/prompts.py:49
        p.choose(θ["p.s2_prompts.deployment_shapes"]);                                   // service / CLI / library / batch job  // src: vvaharness/pipeline/stages/s2/prompts.py:50
        p.step(2, θ["p.s2_prompts.stage2_asset_kinds"]);                                 // src: vvaharness/pipeline/stages/s2/prompts.py:52
        p.choose(θ["p.s2_prompts.asset_sensitivity_scale"]);                             // src: vvaharness/pipeline/stages/s2/prompts.py:54
        p.step(3, θ["p.s2_prompts.stage3_trust_boundaries_every"]);                      // src: vvaharness/pipeline/stages/s2/prompts.py:56
        p.rule(θ["p.s2_prompts.boundary_sources"]);                                      // src: vvaharness/pipeline/stages/s2/prompts.py:57
        p.must(θ["p.s2_prompts.include_supply_chain_infra"]);                            // src: vvaharness/pipeline/stages/s2/prompts.py:58
        p.format(θ["p.s2_prompts.name_the_crossing"]);                                   // src: vvaharness/pipeline/stages/s2/prompts.py:58
        p.step(4, θ["p.s2_prompts.stride_per_boundary"]);                                // src: vvaharness/pipeline/stages/s2/prompts.py:61
        p.rule(θ["p.s2_prompts.cves_raise_controls_lower"]);                             // src: vvaharness/pipeline/stages/s2/prompts.py:63
        p.choose(θ["p.s2_prompts.impact_scale"]);                                        // src: vvaharness/pipeline/stages/s2/prompts.py:64
        p.choose(θ["p.s2_prompts.likelihood_scale"]);                                    // src: vvaharness/pipeline/stages/s2/prompts.py:65
        p.format(θ["p.s2_prompts.threat_id_scheme"]);                                    // T1, T2... caller ranks deterministically  // src: vvaharness/pipeline/stages/s2/prompts.py:66
        p.forbid(θ["p.s2_prompts.do_not_drop_unsure_threat"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:67
        p.step(5, θ["p.s2_prompts.stage5_open_questions"]);                              // src: vvaharness/pipeline/stages/s2/prompts.py:72
        return p;
    }

    /** "Respond with ONLY a JSON object" + schema. */
    Prompt outputSchema(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s2_prompts.json_only_output"]);                                    // src: vvaharness/pipeline/stages/s2/prompts.py:75
        p.format(θ["p.s2_prompts.system_context_length"]);                               // src: vvaharness/pipeline/stages/s2/prompts.py:77
        p.format(θ["p.s2_prompts.threat_fields"]);                                       // src: vvaharness/pipeline/stages/s2/prompts.py:80
        p.format(θ["p.s2_prompts.threat_one_sentence_outcome"]);                         // src: vvaharness/pipeline/stages/s2/prompts.py:80
        p.choose(θ["p.s2_prompts.actor_set"]);                                           // src: vvaharness/pipeline/stages/s2/prompts.py:81
        p.rule(θ["p.s2_prompts.surface_from_trust_boundaries"]);                         // src: vvaharness/pipeline/stages/s2/prompts.py:82
        p.format(θ["p.s2_prompts.controls_field_or_none"]);                              // src: vvaharness/pipeline/stages/s2/prompts.py:87
        p.evidence(θ["p.s2_prompts.evidence_field_cve_commit"]);                         // src: vvaharness/pipeline/stages/s2/prompts.py:88
        p.format(θ["p.s2_prompts.output_top_level_fields"]);                             // src: vvaharness/pipeline/stages/s2/prompts.py:89
        p.must(θ["p.s2_prompts.objects_never_bare_strings"]);                            // a bare string discards the ENTIRE response  // src: vvaharness/pipeline/stages/s2/prompts.py:92
        return p;
    }

    /** "Coverage rules:" */
    Prompt coverageRules(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s2_prompts.coverage_rule_boundary_has_threat"]);                     // >= 1 threat per boundary  // src: vvaharness/pipeline/stages/s2/prompts.py:98
        p.must(θ["p.s2_prompts.coverage_rule_surface_files_complete"]);                  // src: vvaharness/pipeline/stages/s2/prompts.py:99
        p.forbid(θ["p.s2_prompts.surface_files_exact_seen_paths"]);                      // never a path not seen there  // src: vvaharness/pipeline/stages/s2/prompts.py:101
        p.must(θ["p.s2_prompts.coverage_rule_baseline_disposition"]);                    // src: vvaharness/pipeline/stages/s2/prompts.py:104
        p.forbid(θ["p.s2_prompts.baseline_never_drop_without_trace"]);                   // src: vvaharness/pipeline/stages/s2/prompts.py:106
        return p;
    }

    /** "BREADTH — account for the WHOLE inventory" */
    Prompt breadth(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s2_prompts.breadth_whole_inventory"]);                               // src: vvaharness/pipeline/stages/s2/prompts.py:109
        p.rule(θ["p.s2_prompts.inventory_only_path_source"]);                            // src: vvaharness/pipeline/stages/s2/prompts.py:111
        p.persona(θ["p.s2_prompts.only_stage_deciding_scope"]);                          // a file in no surface_files is never opened  // src: vvaharness/pipeline/stages/s2/prompts.py:115
        p.rule(θ["p.s2_prompts.work_inventory_by_directory"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:120
        p.checklist(θ["p.s2_prompts.cover_templates_views"]);                            // src: vvaharness/pipeline/stages/s2/prompts.py:121
        p.checklist(θ["p.s2_prompts.cover_container_ci_infra"]);                         // src: vvaharness/pipeline/stages/s2/prompts.py:124
        p.checklist(θ["p.s2_prompts.cover_dependency_manifests"]);                       // src: vvaharness/pipeline/stages/s2/prompts.py:128
        p.checklist(θ["p.s2_prompts.cover_client_side_code"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:130
        p.checklist(θ["p.s2_prompts.cover_init_base_helpers"]);                          // src: vvaharness/pipeline/stages/s2/prompts.py:132
        p.forbid(θ["p.s2_prompts.no_catch_all_threat"]);                                 // src: vvaharness/pipeline/stages/s2/prompts.py:135
        p.rule(θ["p.s2_prompts.separate_threat_per_surface"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:137
        return p;
    }

    /** "BREADTH WITHIN A FILE — one file is not one threat" */
    Prompt breadthWithinFile(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s2_prompts.breadth_within_file"]);                                   // src: vvaharness/pipeline/stages/s2/prompts.py:142
        p.checklist(θ["p.s2_prompts.weakness_class_examples"]);                          // eleven classes in one handler  // src: vvaharness/pipeline/stages/s2/prompts.py:146
        p.step(1, θ["p.s2_prompts.second_pass_per_file"]);                               // src: vvaharness/pipeline/stages/s2/prompts.py:153
        p.rule(θ["p.s2_prompts.one_threat_per_weakness_class"]);                         // src: vvaharness/pipeline/stages/s2/prompts.py:154
        p.exemption(θ["p.s2_prompts.same_surface_files_allowed"]);                       // src: vvaharness/pipeline/stages/s2/prompts.py:157
        p.forbid(θ["p.s2_prompts.never_fold_classes"]);                                  // src: vvaharness/pipeline/stages/s2/prompts.py:159
        return p;
    }

    /** "Then check your own work before you answer" */
    Prompt selfCheck(Theta θ) {
        Prompt p = new Prompt();
        p.step(2, θ["p.s2_prompts.self_check_inventory_subtraction"]);                   // src: vvaharness/pipeline/stages/s2/prompts.py:162
        p.rule(θ["p.s2_prompts.leftover_file_rule"]);                                    // src: vvaharness/pipeline/stages/s2/prompts.py:164
        p.format(θ["p.s2_prompts.unreviewed_count_format"]);                             // "unreviewed: <n> file(s) — <reason>"  // src: vvaharness/pipeline/stages/s2/prompts.py:166
        return p;
    }

    /** _AGENTIC_SYSTEM_LINE: generic read-only file tools line (always appended). */
    Prompt agenticSystemLine(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s2_prompts.agentic_readonly_tools_line"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:169
        return p;
    }

    /** _GRAPH_TOOLS_SYSTEM_LINE: appended only when a non-degenerate graph and graph tools are mounted. */
    Prompt graphToolsSystemLine(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s2_prompts.graph_tools_line"]);                                   // 6 read-only graph tools  // src: vvaharness/pipeline/stages/s2/prompts.py:177
        p.rule(θ["p.s2_prompts.graph_prefer_context"]);                                  // prefer GraphContext over GraphNeighbors  // src: vvaharness/pipeline/stages/s2/prompts.py:179
        p.rule(θ["p.s2_prompts.graph_impact_empty_means_entry"]);                        // src: vvaharness/pipeline/stages/s2/prompts.py:182
        p.rule(θ["p.s2_prompts.graph_use_for_boundaries"]);                              // src: vvaharness/pipeline/stages/s2/prompts.py:187
        return p;
    }

    /** _SHELL_SYSTEM_LINE: only when step2.bash grants the shell. */
    Prompt shellSystemLine(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s2_prompts.shell_line"]);                                         // read-only POSIX shell; rg not installed  // src: vvaharness/pipeline/stages/s2/prompts.py:194
        p.rule(θ["p.s2_prompts.shell_use_for_wide_search"]);                             // src: vvaharness/pipeline/stages/s2/prompts.py:195
        p.rule(θ["p.s2_prompts.shell_output_resent_warning"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:202
        p.rule(θ["p.s2_prompts.shell_grep_exit1_is_answer"]);                            // src: vvaharness/pipeline/stages/s2/prompts.py:203
        p.forbid(θ["p.s2_prompts.shell_readonly_restrictions"]);                         // no writes, installs, network; stay in repo  // src: vvaharness/pipeline/stages/s2/prompts.py:204
        return p;
    }

    /** _baseline_block: (kinds, MINIMUM BASELINE text). mode comes from step2.baseline. */
    @executedBy(CODE)
    Pair<Set<String>, Prompt> baselineBlock(ThreatEvidence ev, ContextPackage ctx, String mode, Theta θ) {
        if (mode == "none") return new Pair(Set.of(), null);                             // src: vvaharness/pipeline/stages/s2/prompts.py:208
        Set<String> kinds = (mode == "owasp") ? Set.of("web-api") : RepoKinds.repoKind(ev, ctx, θ); // src: vvaharness/pipeline/stages/s2/prompts.py:210
        List<Pair<String, String>> items = new List();
        for (String k : sorted(kinds)) {                                                 // src: vvaharness/pipeline/stages/s2/prompts.py:213
            for (Pair<String, String> b : RepoKinds.baselines(k, θ)) {                   // src: vvaharness/pipeline/stages/s2/prompts.py:214
                if (!items.containsKey(b.first)) items.add(b);                           // dedup by id  // src: vvaharness/pipeline/stages/s2/prompts.py:215
            }
        }
        if (items.isEmpty()) return new Pair(kinds, null);                               // src: vvaharness/pipeline/stages/s2/prompts.py:218
        Prompt p = new Prompt();
        p.rule(θ["p.s2_prompts.baseline_is_floor"]);                                     // coverage floor, not a checklist to tick  // src: vvaharness/pipeline/stages/s2/prompts.py:223
        p.must(θ["p.s2_prompts.baseline_disposition_required"]);                         // silent omission is a contract violation  // src: vvaharness/pipeline/stages/s2/prompts.py:224
        p.choose(List.of("(a)", "(b)"));                                                 // exactly one per item  // src: vvaharness/pipeline/stages/s2/prompts.py:225
        p.rule(θ["p.s2_prompts.baseline_option_a_threat"]);                              // evidence starts "baseline: <ID>"  // src: vvaharness/pipeline/stages/s2/prompts.py:226
        p.exemption(θ["p.s2_prompts.baseline_rare_is_fine"]);                            // src: vvaharness/pipeline/stages/s2/prompts.py:228
        p.evidence(θ["p.s2_prompts.baseline_concrete_evidence"]);                        // src: vvaharness/pipeline/stages/s2/prompts.py:229
        p.rule(θ["p.s2_prompts.baseline_bare_id_only_if_nothing"]);                      // src: vvaharness/pipeline/stages/s2/prompts.py:232
        p.rule(θ["p.s2_prompts.baseline_option_b_open_question"]);                       // open_questions "<ID>: " + reason  // src: vvaharness/pipeline/stages/s2/prompts.py:235
        p.tiebreak(θ["p.s2_prompts.baseline_when_in_doubt_a"]);                          // src: vvaharness/pipeline/stages/s2/prompts.py:238
        p.checklist(items);                                                              // src: vvaharness/pipeline/stages/s2/prompts.py:239
        return new Pair(kinds, p);
    }

    /** What the baseline block asks the model to do per item. */
    @executedBy(MODEL)
    void disposeBaseline(List<Pair<String, String>> items, ThreatModel tm, Theta θ) {
        for (Pair<String, String> item : items) {
            if (snapshotOffersSurface(item) || cannotRuleOut(item)) {
                tm.threats.add(threat("baseline: " + item.first + "; <concrete evidence>", "rare")); // (a)  // src: vvaharness/pipeline/stages/s2/prompts.py:226
            } else {
                tm.openQuestions.add(item.first + ": <one-clause reason>");              // (b)  // src: vvaharness/pipeline/stages/s2/prompts.py:235
            }
        }
    }

    /** _build_user_prompt: blocks ordered by decreasing staticness for a stable cache prefix. */
    Prompt user(String repoName, ThreatEvidence ev, List<CVE> cves, List<Control> controls, AppProfile app, Prompt baselineBlock, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s2_prompts.user_block_order"]);                                    // src: vvaharness/pipeline/stages/s2/prompts.py:277
        if (baselineBlock != null) p.include(baselineBlock);                             // src: vvaharness/pipeline/stages/s2/prompts.py:277
        if (app != null) {                                                               // src: vvaharness/pipeline/stages/s2/prompts.py:265
            p.context(app.toPromptBlock());                                              // src: vvaharness/pipeline/stages/s2/prompts.py:266
            p.rule(θ["p.s2_prompts.cmdb_externally_facing_actor"]);                      // remote_unauth only if YES  // src: vvaharness/pipeline/stages/s2/prompts.py:267
            p.rule(θ["p.s2_prompts.cmdb_pci_pii_critical"]);                             // src: vvaharness/pipeline/stages/s2/prompts.py:269
        }
        p.context(Evidence.renderLanguageBlock(ev));                                     // LANGUAGE BREAKDOWN  // src: vvaharness/pipeline/stages/s2/prompts.py:278
        if (θ["p.s2_prompts.components_block"]) p.context(Evidence.renderComponentsBlock(ev)); // src: vvaharness/pipeline/stages/s2/prompts.py:280
        p.rule(θ["p.s2_prompts.inventory_block_rule"]);                                  // COMPLETE list; surface_files only from here  // src: vvaharness/pipeline/stages/s2/prompts.py:283
        p.context(Evidence.renderInventoryBlock(ev));                                    // src: vvaharness/pipeline/stages/s2/prompts.py:287
        p.context(θ["p.s2_prompts.config_block"]);                                       // src: vvaharness/pipeline/stages/s2/prompts.py:289
        p.context(Evidence.renderConfigRepsBlock(ev));                                   // src: vvaharness/pipeline/stages/s2/prompts.py:293
        p.context(θ["p.s2_prompts.api_artefacts_block"]);                                // src: vvaharness/pipeline/stages/s2/prompts.py:295
        p.context(Evidence.renderApiArtefactsBlock(ev));                                 // src: vvaharness/pipeline/stages/s2/prompts.py:297
        p.context(Evidence.renderDocsBlock(ev));                                         // DOCUMENTATION  // src: vvaharness/pipeline/stages/s2/prompts.py:300
        p.context(Evidence.renderManifestsBlock(ev));                                    // BUILD / DEPENDENCY MANIFESTS  // src: vvaharness/pipeline/stages/s2/prompts.py:303
        if (θ["p.s2_prompts.prior_cves_block"]) p.context(cves);                         // use as evidence; raises likelihood  // src: vvaharness/pipeline/stages/s2/prompts.py:305
        if (θ["p.s2_prompts.design_controls_block"]) p.context(controls);                // lower likelihood where they apply  // src: vvaharness/pipeline/stages/s2/prompts.py:308
        p.context(List.of(repoName, ev.primaryLanguage, ev.fileCount, ev.originalFileCount)); // src: vvaharness/pipeline/stages/s2/prompts.py:311
        p.rule(θ["p.s2_prompts.modules_as_asset_candidates"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:315
        p.context(Evidence.renderModulesBlock(ev));                                      // src: vvaharness/pipeline/stages/s2/prompts.py:316
        p.rule(θ["p.s2_prompts.entry_points_are_boundaries"]);                           // src: vvaharness/pipeline/stages/s2/prompts.py:318
        p.context(Evidence.renderEntryPointsBlock(ev, RepoKinds.strideByKind(θ)));       // src: vvaharness/pipeline/stages/s2/prompts.py:319
        if (ev.s1Notes != null && !ev.s1Notes.isEmpty() && θ["p.s2_prompts.mapper_observations_block"]) p.context(ev.s1Notes); // MAPPER OBSERVATIONS  // src: vvaharness/pipeline/stages/s2/prompts.py:273
        p.rule(θ["p.s2_prompts.anchor_boundary_to_entry_point"]);                        // src: vvaharness/pipeline/stages/s2/prompts.py:321
        p.rule(θ["p.s2_prompts.stride_hint_seeds_threats"]);                             // src: vvaharness/pipeline/stages/s2/prompts.py:322
        return p;
    }

    /** _repair_json_prompt: one-shot restructure of a reply that failed to parse. */
    Prompt repairJson(String raw, Exception err, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s2_prompts.repair_json_only"]);                                    // src: vvaharness/pipeline/stages/s2/prompts.py:328
        p.forbid(θ["p.s2_prompts.repair_preserve_content"]);                             // do not add, remove or reword  // src: vvaharness/pipeline/stages/s2/prompts.py:331
        p.context(err);                                                                  // src: vvaharness/pipeline/stages/s2/prompts.py:336
        p.context(raw);                                                                  // src: vvaharness/pipeline/stages/s2/prompts.py:339
        return p;
    }

    /** The procedure SYSTEM asks the model to carry out. */
    @executedBy(MODEL)
    ThreatModel modelThreats(Snapshot snap, Theta θ) {
        ThreatModel tm = new ThreatModel();
        tm.systemContext = describeSystem(snap);                                         // stage 1  // src: vvaharness/pipeline/stages/s2/prompts.py:49
        tm.assets = identifyAssets(snap);                                                // stage 2  // src: vvaharness/pipeline/stages/s2/prompts.py:52
        tm.trustBoundaries = findBoundaries(snap);                                       // stage 3  // src: vvaharness/pipeline/stages/s2/prompts.py:56
        for (TrustBoundary b : tm.trustBoundaries) {                                     // stage 4  // src: vvaharness/pipeline/stages/s2/prompts.py:61
            for (String s : θ["p.s2_prompts.stride_per_boundary"]) {
                if (plausible(b, s)) tm.threats.add(scoreThreat(b, s, snap.cves, snap.controls)); // never drop because unsure  // src: vvaharness/pipeline/stages/s2/prompts.py:67
            }
        }
        for (String dir : snap.inventory.directories()) coverDirectory(dir, tm);         // BREADTH  // src: vvaharness/pipeline/stages/s2/prompts.py:120
        for (String f : namedFiles(tm)) {                                                // BREADTH WITHIN A FILE  // src: vvaharness/pipeline/stages/s2/prompts.py:153
            for (String cls : weaknessClassesWithEvidence(f)) tm.threats.add(threatFor(f, cls)); // one per class  // src: vvaharness/pipeline/stages/s2/prompts.py:154
        }
        List<String> left = snap.inventory.minus(namedFiles(tm));                        // self-check  // src: vvaharness/pipeline/stages/s2/prompts.py:162
        for (String f : left) if (canCarryWeakness(f)) tm.threats.add(threatFor(f, null)); // src: vvaharness/pipeline/stages/s2/prompts.py:164
        if (!left.isEmpty()) tm.openQuestions.add("unreviewed: <n> file(s) — <reason>"); // src: vvaharness/pipeline/stages/s2/prompts.py:166
        tm.openQuestions.addAll(unknowns(snap));                                         // stage 5  // src: vvaharness/pipeline/stages/s2/prompts.py:72
        return tm;
    }
}
