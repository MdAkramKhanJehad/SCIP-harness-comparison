# vvaharness/backends/harness/claude/translate.py

Translates Claude Agent SDK messages into the harness message variants, validates structured output against the requested schema, and feeds the process-wide token counter once per streaming session.

Source: `vvaharness/backends/harness/claude/translate.py` (lines 1-132)
Executor: code
Called from: `vvaharness/backends/harness/claude/client.py` run_oneshot (validate_structured), run_streaming (translate)

// src: vvaharness/backends/harness/claude/translate.py:108-132 (dispatch table _TRANSLATORS 118-122)
fn translate(message, response_model = null):executor=code {
  match (message) {
    case ResultMessage => translate_result(message, response_model)
    case SystemMessage => if (message.subtype == "init") translate_init(message) else []
    case AssistantMessage => translate_assistant(message)
    case UserMessage => if (message.tool_use_result != null) translate_tool_result(message) else []
    default => []   // other message types are dropped
  }
}

// src: vvaharness/backends/harness/claude/translate.py:90-105
fn translate_result(message, response_model = null):executor=code {
  TOKENS.add(message.usage, usd=message.total_cost_usd)   // exactly once per session, using the SDK's measured cost
  return [HarnessResult({ subtype, is_error, session_id, result_text: message.result,
    structured: validate_structured(message.structured_output, response_model),
    errors, usage, total_cost_usd })]
}

// src: vvaharness/backends/harness/claude/translate.py:43-51
fn validate_structured(raw, response_model):executor=code {
  if (response_model == null) return null
  if (raw is a Mapping) return response_model.model_validate(raw)   // a validation failure raises
  return if (raw is a response_model instance) raw else null
}

// src: vvaharness/backends/harness/claude/translate.py:54-87
fn translate_init(message):executor=code { return [HarnessSessionInit({ session_id: data.session_id if a string else "", raw: data })] }
fn translate_assistant(message):executor=code {
  for each block in message.content {
    match (block) {
      case ToolUseBlock => HarnessToolUse({ tool_id: block.id or "", name: block.name, input: block.input if a Mapping else {} })
      case TextBlock => HarnessAssistantText({ text: block.text })
    }
  }
}
fn translate_tool_result(message):executor=code {
  for each item in message.tool_use_result (a single value is treated as a one-item list) {
    if (item is a Mapping) HarnessToolResult({ is_error: item.is_error or false, content: item })
    else HarnessToolResult({ is_error: false, content: item })
  }
}
