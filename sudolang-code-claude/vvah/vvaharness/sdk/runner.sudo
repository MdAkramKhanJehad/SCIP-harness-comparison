# vvaharness/sdk/runner.py

Running a scan from Python through the same entry point and configuration trust gate as the command line. Options become a `vvaharness scan` argument list, which is checked against the command-line parser before anything runs.

Source: `vvaharness/sdk/runner.py` (lines 1-96)
Executor: code
Called from: library callers through `vvaharness/sdk/__init__.py`; calls `vvaharness/orchestrator/entry.py` main

// src: vvaharness/sdk/runner.py:21-37
_PROFILE_DIR = "<package>/config/profiles"
ScanOptionsError { kind: ValueError }
fn profile_path(profile):executor=code {
  if (profile has a file extension || profile has a directory part) return profile   // an explicit path is used as given
  shipped = "$_PROFILE_DIR/$profile.yaml"
  require shipped is a file => throw ScanOptionsError("no shipped profile <profile>; available: <names>")
  return shipped
}

// src: vvaharness/sdk/runner.py:40-63
ScanOptions {
  repo
  profile = null
  stop_after = null
  resume = false
  application_id = null
  repo_name = null
  extra_argv = []
  // anything omitted keeps the command line's own default for that flag
  fn argv():executor=code {
    argv = ["--repo", repo]
    if (profile != null) argv += ["--config", profile_path(profile)]
    for each [flag, value] in [["--stop-after", stop_after], ["--application-id", application_id], ["--repo-name", repo_name]] {
      if (value) argv += [flag, value]
    }
    return argv + (if (resume) ["--resume"] else []) + extra_argv
  }
}

// src: vvaharness/sdk/runner.py:66-76
ScanResult {
  exit_code: Number
  argv: String[]   // kept so the run can be reproduced on the command line
  ok = exit_code == 0
}

// src: vvaharness/sdk/runner.py:79-84
fn scan(options):executor=code {
  argv = options.argv()
  _reject_unknown_flags(argv)
  return ScanResult { exit_code: orchestrator.entry.main(argv), argv }   // the same path as `vvaharness scan`, including the trust gate on --config
}

// src: vvaharness/sdk/runner.py:87-93
fn _reject_unknown_flags(argv):executor=code {
  try orchestrator.entry.build_parser().parse_args(argv);
  catch SystemExit => throw ScanOptionsError("invalid scan options: <argv>")   // fails before any work
}
