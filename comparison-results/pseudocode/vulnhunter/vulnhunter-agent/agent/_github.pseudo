// file: vulnhunter-agent/agent/_github.py
// Shared GitHub helpers for the publish and issues stages: REST API base resolution,
// owner/repo extraction from a repo URL, and the results-dir timestamp suffix parser.

@executedBy(CODE) @role(types) @stage("infra")
record GitHubURLError(String message) { }

@executedBy(CODE) @role(io) @stage("infra")
class Github {

    // _TIMESTAMP_RE: results dirs end in YYYY-MM-DD-HHMMSS (skill convention)
    String timestampRe() {
        return "(\\d4-\\d2-\\d2-\\d6)$";                                                             // literal regex, braces dropped // src: vulnhunter-agent/agent/_github.py:17
    }

    String apiBase(String host) {
        if (host == "github.com" || host.endsWith(".github.com")) return "https://api.github.com";   // src: vulnhunter-agent/agent/_github.py:30
        return "https://" + host + "/api/v3";                                                        // GHES // src: vulnhunter-agent/agent/_github.py:32
    }

    String[] parseOwnerRepo(String repoUrl) {
        Url parsed = urlparse(repoUrl);                                                              // src: vulnhunter-agent/agent/_github.py:43
        String path;
        if (parsed.scheme == "http" || parsed.scheme == "https") path = parsed.path;                 // src: vulnhunter-agent/agent/_github.py:44
        else if (repoUrl.contains(":") && !repoUrl.contains("://")) path = repoUrl.splitOnce(":")[1]; // ssh git@host:owner/repo // src: vulnhunter-agent/agent/_github.py:46
        else path = (parsed.path != "") ? parsed.path : repoUrl;                                     // src: vulnhunter-agent/agent/_github.py:49
        path = path.strip("/");
        if (path.endsWith(".git")) path = path.dropSuffix(".git");                                   // src: vulnhunter-agent/agent/_github.py:51
        List<String> parts = path.split("/").filter(p -> p != "");
        if (parts.size() < 2) throw new GitHubURLError("can't parse owner/repo");                   // src: vulnhunter-agent/agent/_github.py:55
        return new String[] { parts[0], parts[1] };                                                  // first two segments; tree URLs tolerated // src: vulnhunter-agent/agent/_github.py:56
    }

    String extractTimestamp(String resultsDirName) {
        Match m = regexSearch(timestampRe(), resultsDirName);                                        // src: vulnhunter-agent/agent/_github.py:61
        return (m != null) ? m.group(1) : "unknown";                                                 // src: vulnhunter-agent/agent/_github.py:62
    }
}
