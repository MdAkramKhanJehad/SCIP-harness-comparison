// file: vvaharness/remediation_agent/models/gates.py
// The 3-gate evidence status block (source, sink, missing-control) as a reusable sub-model of the verdict.

@executedBy(CODE) @role(types)
enum EvidenceGateStatus { PASS, PARTIAL, FAIL }

@executedBy(CODE) @role(types) @stage("S10")
class RemediationAgentModelsGates {
    // Deliberately distinct from S11 validation GateStatus; GateStatus is a back-compat alias.
    EvidenceGateStatus source;          // Gate A: attacker-controlled source identified           // src: vvaharness/remediation_agent/models/gates.py:30
    EvidenceGateStatus sink;            // Gate B: security-relevant sink reachable from source    // src: vvaharness/remediation_agent/models/gates.py:31
    EvidenceGateStatus missingControl;  // Gate C: missing/insufficient validation                 // src: vvaharness/remediation_agent/models/gates.py:32

    RemediationAgentModelsGates defaults(Theta θ) {
        // Conservative default: a verdict omitting a gate still validates, with that gate failed.
        source = θ["code.remediation_agent.models.gates.default_status"];                          // src: vvaharness/remediation_agent/models/gates.py:30
        sink = θ["code.remediation_agent.models.gates.default_status"];                            // src: vvaharness/remediation_agent/models/gates.py:31
        missingControl = θ["code.remediation_agent.models.gates.default_status"];                  // src: vvaharness/remediation_agent/models/gates.py:32
        return this;
    }
}
