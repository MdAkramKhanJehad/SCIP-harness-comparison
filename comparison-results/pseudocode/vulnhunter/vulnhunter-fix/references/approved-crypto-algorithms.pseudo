// file: vulnhunter-fix/references/approved-crypto-algorithms.yaml
// Allow / deny identifier lists and parameter floors read by scripts/crypto-trust-chain-checkers.py
// (REQ-CWE-009 algorithm_approved). A false result forces MITIGATION tier for the crypto finding.

@executedBy(CODE) @role(types)
record CryptoConstants(int pbkdf2_min_iterations, int argon2_min_memory_kb, int argon2_min_iterations, int rsa_min_bits, int ecc_min_bits) { }

@executedBy(CODE) @role(config) @stage("fix")
class ApprovedCryptoAlgorithms {

    Map<String, List<String>> approved(Theta θ) {
        // keys: symmetric (AEAD only), asymmetric, hash, kdf, mac
        return θ["code.references.approved_crypto_algorithms.approved_lists"];      // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:9
    }

    Map<String, List<String>> denied(Theta θ) {
        // keys: symmetric_denied, asymmetric_denied, hash_denied, kdf_denied, mac_denied; case-insensitive, deny wins
        return θ["code.references.approved_crypto_algorithms.denied_lists"];        // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:21
    }

    CryptoConstants constants(Theta θ) {
        return new CryptoConstants(
            θ["code.references.approved_crypto_algorithms.pbkdf2_min_iterations"],   // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:107
            65536,                                                                   // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:108 (argon2_min_memory_kb: not read by the checker)
            3,                                                                       // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:109 (argon2_min_iterations: not read by the checker)
            θ["code.references.approved_crypto_algorithms.rsa_min_bits"],            // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:110
            θ["code.references.approved_crypto_algorithms.ecc_min_bits"]);           // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:111
    }

    boolean algorithmApproved(List<String> addedLines, Theta θ) {
        // as applied by CryptoTrustChainCheckers.checkAlgorithmApproved: deny list, then parameter floors, then allow list
        for (String term : denied(θ).flatValues()) if (tokenPresentIgnoreCase(term, addedLines)) return false; // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:17
        if (weakParameter(addedLines, constants(θ))) return false;                   // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:105
        for (String term : approved(θ).flatValues()) if (tokenPresentIgnoreCase(term, addedLines)) return true; // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:6
        return false;                                                                // src: vulnhunter-fix/references/approved-crypto-algorithms.yaml:7 (no match -> MITIGATION)
    }
}
