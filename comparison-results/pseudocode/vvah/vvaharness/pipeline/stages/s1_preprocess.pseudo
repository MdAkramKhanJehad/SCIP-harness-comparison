// file: vvaharness/pipeline/stages/s1_preprocess.py, vvaharness/scope/walk.py, vvaharness/scope/configs.py
// S1: injects CVEs/controls, merges the S0 seed, and derives modules, notes and language from the graph. No model call.
// The repo walk (scope/walk.py) and config dedup (scope/configs.py) that the step1.* scope knobs drive are rendered here too.

@executedBy(CODE) @role(stage) @stage("S1")
class S1Preprocess {

    /** Injected inputs are loaded by the orchestrator before S1 and handed in; rendered here because they feed S1/S2. */
    Injected loadInjected(Path cfgDir, Theta θ) {
        List<CVE> cves = CveFeed.loadCves(resolve(cfgDir, θ["inject.cve_file"]));                       // src: vvaharness/orchestrator/scan.py:540
        List<Control> controls = DesignControls.loadControls(resolve(cfgDir, θ["inject.controls_file"])); // src: vvaharness/orchestrator/scan.py:541
        // App profile (externally facing, PCI, PII) for environmental severity; read via orchestrator/cmdb.py
        AppProfile app = Cmdb.load(θ["inject.cmdb_file"]);                                              // src: vvaharness/orchestrator/cmdb.py:36
        return new Injected(cves, controls, app);
    }

    ContextPackage run(String repoRoot, Config cfg, List<CVE> knownCves, List<Control> controls, SeedPackage seed, GraphHandle graph, Theta θ) {
        // Set in profiles but not registered; S1 makes no agentic call, so this is inert
        Object unusedTools = θ["step1.allowed_tools"];                                       // src: vvaharness/config/__init__.py:264
        List<String> allFiles;
        Map excluded;
        // Reuse S0's walk; fall back when S0 was off or its checkpoint has no walk
        if (seed != null && seed.allFiles != null && !seed.allFiles.isEmpty()) {             // src: vvaharness/pipeline/stages/s1_preprocess.py:80
            allFiles = seed.allFiles; excluded = seed.excluded;                              // src: vvaharness/pipeline/stages/s1_preprocess.py:81
        } else {
            Pair<List<String>, Map> w = walkRepo(repoRoot, cfg, θ);                          // src: vvaharness/pipeline/stages/s1_preprocess.py:83
            allFiles = w.first; excluded = w.second;
        }
        // Jail agentic reads to the inventory (before dedup so siblings stay readable)
        LocalTools.setScope(repoRoot, allFiles);                                             // src: vvaharness/pipeline/stages/s1_preprocess.py:85
        Pair<List<String>, Map> dd = S1ConfigDedup.dedupConfigs(allFiles, repoRoot, θ);      // src: vvaharness/pipeline/stages/s1_preprocess.py:86
        allFiles = dd.first;
        excluded.put("config_dedup", dd.second);                                             // src: vvaharness/pipeline/stages/s1_preprocess.py:87

        Set<String> keep = Set.copyOf(allFiles);                                             // src: vvaharness/pipeline/stages/s1_preprocess.py:93
        List<String> topDirs = listTopDirs(repoRoot).without("checkpoints", "security-scan"); // src: vvaharness/pipeline/stages/s1_preprocess.py:95
        List<String> ambiguous = new List();                                                 // matched 2+ top dirs: dropped, never guessed
        Map data = Map.of("unsafe_sinks", new List(), "entry_points", new List());           // src: vvaharness/pipeline/stages/s1_preprocess.py:107

        if (seed != null) {                                                                  // src: vvaharness/pipeline/stages/s1_preprocess.py:109
            List seedSinks = seed.unsafeSinks.mapNotNull(s -> resolveInScope(s.file, repoRoot, keep, topDirs, ambiguous)); // src: vvaharness/pipeline/stages/s1_preprocess.py:110
            List seedEps = seed.entryPoints.mapNotNull(e -> resolveInScope(e.file, repoRoot, keep, topDirs, ambiguous));   // src: vvaharness/pipeline/stages/s1_preprocess.py:113
            data.get("unsafe_sinks").addAll(seedSinks);
            data.get("entry_points").addAll(seedEps);
            List<List<String>> seedPaths = new List();
            for (List<String> path : seed.taintPaths) {                                      // src: vvaharness/pipeline/stages/s1_preprocess.py:122
                List<String> resolved = path.mapNotNull(hop -> resolveInScope(hop.file, repoRoot, keep, topDirs, ambiguous)); // src: vvaharness/pipeline/stages/s1_preprocess.py:124
                if (resolved.size() >= 2) seedPaths.add(resolved);                           // src: vvaharness/pipeline/stages/s1_preprocess.py:129
            }
            data.put("seed_taint_paths", seedPaths);                                         // src: vvaharness/pipeline/stages/s1_preprocess.py:131
            for (EntryPoint ep : seed.entryPoints) {                                         // src: vvaharness/pipeline/stages/s1_preprocess.py:136
                if (ep.kind == "framework" && resolveInScope(ep.file, repoRoot, keep, topDirs, ambiguous) == null) Log.warn("S1_FRAMEWORK_ENTRY_UNRESOLVED"); // src: vvaharness/pipeline/stages/s1_preprocess.py:137
            }
        }
        if (!ambiguous.isEmpty()) Log.warn("S1_AMBIGUOUS_PATHS_DROPPED");                    // src: vvaharness/pipeline/stages/s1_preprocess.py:149

        if (graph != null) {                                                                 // src: vvaharness/pipeline/stages/s1_preprocess.py:155
            data.put("language", CodegraphQueries.primaryLanguage(graph));                   // src: vvaharness/pipeline/stages/s1_preprocess.py:156
            data.put("modules", modulesFromGraph(graph, repoRoot, keep, topDirs, ambiguous)); // src: vvaharness/pipeline/stages/s1_preprocess.py:157
            data.put("notes", CodegraphQueries.systemContextNotes(graph));                   // src: vvaharness/pipeline/stages/s1_preprocess.py:158
        } else {
            data.put("modules", new List()); data.put("notes", "");                          // src: vvaharness/pipeline/stages/s1_preprocess.py:160
        }
        // language is required; fall back to the commonest extension
        if (data.get("language") == null) data.put("language", commonestExtLanguage(allFiles)); // src: vvaharness/pipeline/stages/s1_preprocess.py:163
        data.put("all_files", allFiles); data.put("excluded", excluded);                     // src: vvaharness/pipeline/stages/s1_preprocess.py:171
        data.put("known_cves", knownCves); data.put("design_controls", controls);            // src: vvaharness/pipeline/stages/s1_preprocess.py:173

        ContextPackage pkg = ContextPackage.validate(data);                                  // src: vvaharness/pipeline/stages/s1_preprocess.py:177
        int nInScope = pkg.allFiles.size();                                                  // src: vvaharness/pipeline/stages/s1_preprocess.py:183
        // Every later stage would process the empty set and report success, so refuse here
        if (nInScope == 0) throw new EmptyScopeError("0 files in scope after exclusions"); // src: vvaharness/pipeline/stages/s1_preprocess.py:192
        if (pkg.modules.isEmpty() && pkg.entryPoints.isEmpty() && pkg.unsafeSinks.isEmpty()) ErrLog.log("s1", "s1_zero_output"); // src: vvaharness/pipeline/stages/s1_preprocess.py:200
        return pkg;                                                                          // src: vvaharness/pipeline/stages/s1_preprocess.py:207
    }

    String resolveInScope(String path, String repoRoot, Set<String> keep, List<String> topDirs, List<String> ambiguous) {
        Pair<String, Boolean> r = ScopeWalk.resolveScopePath(path, repoRoot, keep, topDirs); // src: vvaharness/pipeline/stages/s1_preprocess.py:102
        if (r.second) ambiguous.add(path);                                                   // src: vvaharness/pipeline/stages/s1_preprocess.py:103
        return r.first;
    }

    List<ModuleInfo> modulesFromGraph(GraphHandle graph, String repoRoot, Set<String> keep, List<String> topDirs, List<String> ambiguous) {
        List<ModuleInfo> modules = new List();
        for (Community c : CodegraphQueries.communitiesAsModules(graph)) {                   // src: vvaharness/pipeline/stages/s1_preprocess.py:69
            List<String> inScope = c.files.mapNotNull(f -> resolveInScope(f, repoRoot, keep, topDirs, ambiguous)); // src: vvaharness/pipeline/stages/s1_preprocess.py:70
            if (!inScope.isEmpty()) modules.add(new ModuleInfo(c.name, inScope));            // src: vvaharness/pipeline/stages/s1_preprocess.py:71
        }
        return modules;
    }

    /** scope/walk.py _exclusion_sets: built-in defaults + step1.* appends, resolved once. */
    @src("vvaharness/scope/walk.py:80")
    Triple<Set, Set, List> exclusionSets(Config cfg, Theta θ) {
        Set<String> dirs = DEFAULT_EXCLUDE_DIRS.union(θ["step1.exclude_dirs"]);             // src: vvaharness/scope/walk.py:83
        Set<String> exts = DEFAULT_EXCLUDE_EXTS.union(θ["step1.exclude_exts"]);             // src: vvaharness/scope/walk.py:84
        List<String> globs = DEFAULT_EXCLUDE_GLOBS.concat(θ["step1.exclude_globs"]);        // src: vvaharness/scope/walk.py:86
        return new Triple(dirs, exts, globs);
    }

    /** scope/walk.py _walk_repo: built-in excludes + step1 appends, size cap, unconditional off-root symlink drop. */
    @src("vvaharness/scope/walk.py:167")
    Pair<List<String>, Map> walkRepo(String repoRoot, Config cfg, Theta θ) {
        Set<String> exclDirs = DEFAULT_EXCLUDE_DIRS.union(θ["step1.exclude_dirs"]);        // src: vvaharness/scope/walk.py:83
        Set<String> exclExts = DEFAULT_EXCLUDE_EXTS.union(θ["step1.exclude_exts"]);        // src: vvaharness/scope/walk.py:84
        List<String> exclGlobs = DEFAULT_EXCLUDE_GLOBS.concat(θ["step1.exclude_globs"]);   // src: vvaharness/scope/walk.py:86
        int maxKb = θ["step1.max_file_kb"];                                                  // src: vvaharness/scope/walk.py:171
        // Off-root symlinks are dropped UNCONDITIONALLY; follow_symlinks only prints a note
        if (θ["step1.follow_symlinks"]) Console.note("follow_symlinks set, but off-root symlinks are still dropped"); // src: vvaharness/scope/walk.py:174
        List<String> out = new List();
        for (Path p : rglob(repoRoot)) {                                                     // src: vvaharness/scope/walk.py:209
            if (!p.isFile()) continue;
            String rel = relPath(p, repoRoot);
            String tgtRel = null;
            if (p.isSymlink()) {                                                             // src: vvaharness/scope/walk.py:215
                if (escapesRoot(p, repoRoot)) { exclude(rel, "symlinks"); continue; }        // src: vvaharness/scope/walk.py:225
                tgtRel = targetRel(p, repoRoot);
            }
            // first matching dir (target/ only when a build marker is in its parent), then ext, then glob
            if (ruleHit(rel, exclDirs, exclExts, exclGlobs)) { exclude(rel, "rule"); continue; } // src: vvaharness/scope/walk.py:228
            // an in-root link is judged by its target too
            if (tgtRel != null && ruleHit(tgtRel, exclDirs, exclExts, exclGlobs)) { exclude(rel, "symlink_targets"); continue; } // src: vvaharness/scope/walk.py:233
            if (p.size() > maxKb * 1024) { exclude(rel, "oversize"); continue; }            // src: vvaharness/scope/walk.py:238
            out.add(rel);                                                                    // src: vvaharness/scope/walk.py:246
        }
        return new Pair(sorted(out), excludedReport());                                     // src: vvaharness/scope/walk.py:258
    }
}

@executedBy(CODE) @role(step) @stage("S1")
@src("vvaharness/scope/configs.py:124")
class S1ConfigDedup {

    /** Collapses many per-env config copies to one per shape-cluster, unless a member carries an extra secret/insecure value. */
    Pair<List<String>, Map> dedupConfigs(List<String> files, String repoRoot, Theta θ) {
        if (!θ["step1.config_dedup.enabled"]) return new Pair(files, Map.of("enabled", false)); // src: vvaharness/scope/configs.py:131
        Set<String> exts = DEDUP_DEFAULTS.exts;                                              // .yml .yaml .json .toml .ini .properties .conf .cfg .env  // src: vvaharness/scope/walk.py:264
        int minCluster = θ["step1.config_dedup.min_cluster_size"];                           // src: vvaharness/scope/configs.py:135
        int maxBytes = 512 * 1024;                                                           // literal: config_dedup.max_file_kb default 512, no knob  // src: vvaharness/scope/walk.py:270
        List<String> candidates = files.filter(f -> exts.contains(ext(f)));                 // src: vvaharness/scope/configs.py:140
        List<String> keep = files.filter(f -> !exts.contains(ext(f)));                      // src: vvaharness/scope/configs.py:143
        if (candidates.size() < minCluster) return new Pair(files, report());               // src: vvaharness/scope/configs.py:146
        boolean wantSec = θ["step1.config_dedup.promote_on_secret_hit"];                     // src: vvaharness/scope/configs.py:150
        boolean wantIns = θ["step1.config_dedup.promote_on_insecure_value"];                 // src: vvaharness/scope/configs.py:151
        // Pass 1: hash each candidate's key-shape; unreadable/oversize stay in scope unclustered
        Map<String, List<String>> clusters = groupByShapeHash(candidates, maxBytes, keep);  // src: vvaharness/scope/configs.py:166
        Map<String, Set<String>> susByRel = suspiciousSets(clusters, minCluster, wantSec, wantIns); // src: vvaharness/scope/configs.py:196
        // Pass 2
        for (List<String> members : clusters.values()) {                                     // src: vvaharness/scope/configs.py:203
            if (members.size() < minCluster) { keep.addAll(members); continue; }             // src: vvaharness/scope/configs.py:204
            members.sortBy(m -> repScore(m));                                                // src: vvaharness/scope/configs.py:207
            Set<String> reps;
            if (θ["step1.config_dedup.keep_per_top_dir"]) reps = firstMemberPerTopDir(members); // src: vvaharness/scope/configs.py:209
            else reps = Set.of(members.get(0));                                              // src: vvaharness/scope/configs.py:213
            Set<String> repSus = union(reps.map(r -> susByRel.get(r)));                      // src: vvaharness/scope/configs.py:215
            keep.addAll(reps);
            for (String rel : members) {                                                     // src: vvaharness/scope/configs.py:221
                if (reps.contains(rel)) continue;
                if (!susByRel.containsKey(rel)) { keep.add(rel); continue; }                 // unreadable on re-read: cannot prove duplicate  // src: vvaharness/scope/configs.py:224
                Set<String> extra = susByRel.get(rel).minus(repSus);                         // src: vvaharness/scope/configs.py:229
                if (!extra.isEmpty()) { keep.add(rel); repSus.addAll(susByRel.get(rel)); }   // promoted  // src: vvaharness/scope/configs.py:230
                else dropped(rel);                                                           // src: vvaharness/scope/configs.py:235
            }
        }
        return new Pair(keep, report());                                                     // src: vvaharness/scope/configs.py:255
    }
}
