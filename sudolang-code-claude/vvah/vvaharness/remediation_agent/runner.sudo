# vvaharness/remediation_agent/runner.py

The per-finding loop. `process_targets` builds the policy context once, then walks the targets one at a time in list order. Each target is skipped when a matching resume checkpoint exists, otherwise sent through `plugin_runner.apply_plugin` (policy pre-gate, model session, post-gate, diff capture, artifacts) and checkpointed. After the loop the scan report copies are augmented with the remediation results.

Source: `vvaharness/remediation_agent/runner.py` (lines 1-184)
Executor: code (apply_plugin contains the model call)
Called from: `vvaharness/remediation_agent/remediate.py` remediate; `vvaharness/orchestrator/scan.py` _run_remediation (Stage 10)

// src: vvaharness/remediation_agent/runner.py:52-55
_Result: "fixed" | "not fixed" | "failed"   // FIXED, NOT_FIXED, FAILED

// src: vvaharness/remediation_agent/runner.py:146-184
fn process_targets(targets, layout, cfg, repo_path, opts, report?, progress?):executor=code {
  total = length(targets)

  // src: runner.py:153-157 — loaded once per run
  policy_ctx = policy.context.build_context(cfg, repo_path)
  // preserved: the comment at runner.py:153 says "No-op unless step_remediate.enforce_policy is true", but policy_enabled reads knob("step_remediate.enforce_policy", default=true) (policy/context.py:38)
  if (policy_ctx.enabled) console "policy gate ENABLED (deny-list + playbook + diff post-gate)"

  // src: runner.py:158-164 — strictly sequential, in list order; no parallelism
  results = []
  processed_ok = targets |> map((target, i from 1) => remediate_one(target, idx=i, total, layout, cfg, repo_path, opts, policy_ctx, _results=results))
  // a raised UnsafeArtifactDir from remediate_one is not caught here and ends the run

  fixed = count of results == FIXED; not_fixed = count == NOT_FIXED; failed = count == FAILED
  processed = count of processed_ok == true

  // src: runner.py:169-175 — failures are folded into not_fixed so that attempted == fixed + not_fixed
  if (progress != null) progress.update(attempted=total, fixed, not_fixed=total - fixed)

  // abstracted: runner.py:176-180 — summary line "N/total findings processed — fixed/total fixed, k not fixed[, f failed]"; outcome mark fail / warn / ok

  // src: runner.py:181-183 — best effort, never fails the run
  report_augment.augment_reports(repo_path, report)

  // src: runner.py:184
  return if (failed == 0) 0 else 1
  // preserved: "not fixed" outcomes (including policy denials and post-gate rejections) still return 0; only an exception inside remediate_one returns 1
}

// src: vvaharness/remediation_agent/runner.py:96-143
fn remediate_one(target, idx, total, layout, cfg, repo_path, opts, policy_ctx?, _results?):executor=code {
  label = redact(target.label)
  step = step_key_of(target, cfg)
  fid = _finding_identity(target)   // target.case_id

  // src: runner.py:104-115 — resume skip only when the stored row names THIS finding
  if (opts.resume) {
    cached = checkpoints.load_ckpt(layout.ckpt_dir, layout.run_id, step)   // external: orchestrator/checkpoints.py; ckpt_dir is ignored, rows live in the state store outside the repository
    if (cached is a dict && cached.finding_id == fid) {
      cached_result = _result_for_kind(cached.kind, diff_captured=cached.diff_captured)
      if (cached_result == NOT_FIXED) mark the progress line incomplete "not fixed"
      append cached_result to _results
      return true
    }
  }

  // src: runner.py:117-119 — deliberately outside the try: a symlinked <slug> folder is tampering evidence and propagates to the caller
  out_dir = artifact_dir(layout.rem_dir, target.slug)   // external: orchestrator/artifacts.py; raises UnsafeArtifactDir

  // src: runner.py:121-143
  try {
    remediation = plugin_runner.run.apply_plugin(target, out_dir, cfg, repo=repo_path, mode=opts.mode, verbose=opts.verbose, policy_ctx)
    record = plugin_runner.run.checkpoint_record(target, out_dir, remediation) + { finding_id: fid }   // identity bound into the row so a later --resume can authenticate it
    checkpoints.save_ckpt(layout.ckpt_dir, layout.run_id, step, record)
    result = _result_for_kind(remediation.kind, diff_captured=(remediation.diff is non-empty))
    if (result == NOT_FIXED) mark the progress line incomplete "not fixed"
    append result to _results
    return true
  }
  catch error => {
    warn REMEDIATION_FINDING_FAILED(finding=target.index, detail=redact(error))   // one bad finding never aborts the run
    append FAILED to _results
    return false
  }
}

// src: vvaharness/remediation_agent/runner.py:58-68
fn _result_for_kind(kind, diff_captured?):executor=code {
  // A proven no-diff attempt is never "fixed"; an absent proof (older checkpoint rows) keeps the old behaviour
  if (diff_captured == false) return NOT_FIXED
  return if (kind in ["edits_applied", "pull_request"]) FIXED else NOT_FIXED
}

// src: vvaharness/remediation_agent/runner.py:80-88
fn step_key_of(target, cfg):executor=code {
  [model, backend] = plugin_runner.run.engine_model(cfg)
  return checkpoints.step_key_for(REMEDIATE_PREFIX, engine_id=ENGINE_ID, engine_version=vvaharness.__version__ (read at call time), case_id=target.case_id, model, backend)
  // external: orchestrator/checkpoints.py — "remediate_" + first 24 hex characters of sha256 over the five values; a model, backend or version change invalidates every resume row
}

// src: vvaharness/remediation_agent/runner.py:71-77
fn model_banner(cfg):executor=code {
  try { [mid, via] = resolve_model(knob("models.remediate")); return "$mid [$via]" }
  catch => return "unknown"   // best effort only
}
