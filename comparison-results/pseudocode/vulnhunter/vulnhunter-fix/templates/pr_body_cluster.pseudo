// file: vulnhunter-fix/templates/pr_body_cluster.md
// PR description body, in-place mode (N findings per PR on one branch). Filled by the deliver prompt; placeholders written as <NAME>.
// Humans read it. Gate 2 checks the nine H2 headings, Gate 6 parses the table, Gate 4 matches the per-finding key markers inside the finding sections.

@executedBy(CODE) @role(io) @stage("fix")
class PrBodyCluster {

    String run(Map<String, String> fields) {
        StringBuilder b = new StringBuilder();
        b.append("## Security Fix Cluster: " + fields.get("CLUSTER_NAME"));                      // src: vulnhunter-fix/templates/pr_body_cluster.md:1
        b.append(closesLine(fields));
        b.append(findingSummary(fields));
        b.append(attackerCapability(fields));
        b.append(securityTest());
        b.append(fixDescription(fields));
        b.append(verificationResults());
        b.append(fields.get("VERIFICATION_TABLE"));                                               // src: vulnhunter-fix/templates/pr_body_cluster.md:50
        b.append(fields.get("CLUSTER_RESIDUAL_RISK"));                                            // src: vulnhunter-fix/templates/pr_body_cluster.md:54
        b.append(sweepSummary(fields));
        b.append(fields.get("CLUSTER_BREAKING_CHANGE"));                                          // src: vulnhunter-fix/templates/pr_body_cluster.md:66
        b.append(fields.get("SETUP_STEPS"));                                                      // src: vulnhunter-fix/templates/pr_body_cluster.md:72
        b.append(footer(fields));
        return b.toString();
    }

    // Line under the title: "Closes #N1, #N2" in the normal case; "Addresses VULN-N per <results_path>" when work.json has no_source_issues (in-place run from a results dir).
    // Followed by a note that each finding is committed separately with its own RED-to-GREEN test and exploit-blocked proof.
    String closesLine(Map<String, String> fields) {
        String line = fields.get("CLOSES_OR_ADDRESSES_LINE");                                     // src: vulnhunter-fix/templates/pr_body_cluster.md:3
        return line + "Bundles " + fields.get("N") + " findings under one PR.";                   // src: vulnhunter-fix/templates/pr_body_cluster.md:5
    }

    // "## Finding Summary": cluster rationale, then one table row per member: VULN, CWE, Severity, Location, Source issue.
    String findingSummary(Map<String, String> fields) {
        return "Rationale: " + fields.get("CLUSTER_RATIONALE") + fields.get("CLUSTER_MEMBERS_TABLE"); // src: vulnhunter-fix/templates/pr_body_cluster.md:12
    }

    // "## Attacker Capability": fixed prose; each finding has its own statement in its subsection; the cluster closes N independent weaknesses and no exploit depends on another.
    String attackerCapability(Map<String, String> fields) {
        return "In aggregate, this cluster closes " + fields.get("N") + " independently-exploitable weakness(es) sharing the remediation theme above"; // src: vulnhunter-fix/templates/pr_body_cluster.md:20
    }

    // "## Security Test": fixed prose: every finding has a dedicated RED-to-GREEN test; each failed pre-fix and passes post-fix.
    String securityTest() {
        return "Every finding carries a dedicated RED→GREEN security test committed on this branch.";  // src: vulnhunter-fix/templates/pr_body_cluster.md:27
    }

    // "## Fix Description": wraps the per-finding H4 blocks. A leading HTML comment explains that idempotency comes from the per-finding key markers
    // (Gate 4 searches anywhere in the body). The comment must not name the finding-section placeholder: a global substitution would inject each
    // finding's own key comment into it, nest HTML comments and leak finding blocks as visible text.
    String fixDescription(Map<String, String> fields) {
        return fields.get("PER_FINDING_SECTIONS");                                                // src: vulnhunter-fix/templates/pr_body_cluster.md:43
    }

    // "## Verification Results": fixed table. Before fix: security tests FAIL (every test RED on main), regression suite PASS. After fix: tests PASS, regression suite PASS with no regressions.
    String verificationResults() {
        return "Before fix: FAIL — every test in this cluster's branch was RED on main; After fix: PASS — all tests GREEN"; // src: vulnhunter-fix/templates/pr_body_cluster.md:46
    }

    // "## Sweep Summary": one row per finding with a VULN column first; a single dash row when the sweep did not run.
    String sweepSummary(Map<String, String> fields) {
        return fields.get("CLUSTER_SWEEP_ROWS");                                                  // src: vulnhunter-fix/templates/pr_body_cluster.md:60
    }

    // Footer: cluster name, finding count, run id (results dir name), attribution. No cluster-level key marker; per-finding markers satisfy Gate 4.
    String footer(Map<String, String> fields) {
        return "Cluster: " + fields.get("CLUSTER_NAME") + " Findings: " + fields.get("N")
             + " VulnHunter-Run: " + fields.get("RESULTS_DIR_NAME") + " Co-Authored-By: Claude Code (VulnFix)"; // src: vulnhunter-fix/templates/pr_body_cluster.md:77
    }
}
