// src: vvaharness/util/pricing.py:203-219
fn bucket_cost_usd(bucket, pricing, cache_defaults?):executor=code {
  d = cache_defaults or CacheRateDefaults()
  cache_write = bucket.cache_write or 0
  fresh = max(bucket.prompt - cache_write, 0)   // bucket.prompt already includes cache writes (see tokens.add)
  write_rate = if (pricing.cache_creation_per_mtok == null) pricing.input_per_mtok * d.write_multiplier else pricing.cache_creation_per_mtok
  read_rate = if (pricing.cache_read_per_mtok == null) pricing.input_per_mtok * d.read_fraction else pricing.cache_read_per_mtok
  return (fresh * input_per_mtok + cache_write * write_rate + bucket.cache_read * read_rate + bucket.completion * output_per_mtok) / 1_000_000
}
