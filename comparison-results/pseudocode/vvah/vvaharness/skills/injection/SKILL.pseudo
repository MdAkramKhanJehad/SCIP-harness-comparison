// file: vvaharness/skills/injection/SKILL.md
// S4 skill playbook "injection": every injection class in the description under a source/sink/no-defence hard gate.
// Probe first (probe.sh), refute candidates with the listed checks, then enumerate one finding per distinct sink.

@executedBy(MODEL) @role(skill) @stage("S4")
class InjectionSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_injection.trigger"])) return List.of();                          // src: vvaharness/skills/injection/SKILL.md:3
        InjectionPrompt.playbook(θ);
        List<String> classes = θ["p.skill_injection.scope_all_named_classes"] ? lens.classesIn(θ["p.skill_injection.trigger"]) : lens.classes; // src: vvaharness/skills/injection/SKILL.md:24
        ProbeOutput probe = null;
        if (θ["p.skill_injection.run_probe_first"]) probe = InjectionProbe.run(repo.root, θ);             // sh .vvaharness/skills/injection/probe.sh // src: vvaharness/skills/injection/SKILL.md:42
        List<Finding> out = new List();
        for (Section s : probe.sections) {
            // (none) is a real answer: stop working that class
            if (s.isNone() && θ["p.skill_injection.probe_none_stops_class"]) continue;                     // src: vvaharness/skills/injection/SKILL.md:45
            for (Candidate c : s.hits) {                                                                    // every line is only a CANDIDATE // src: vvaharness/skills/injection/SKILL.md:44
                c.markCandidate(θ["p.skill_injection.probe_hits_are_candidates"]);                       // never reported as-is
                if (!hardGate(c, θ)) continue;
                if (refuted(c, θ)) continue;
                out.addAll(enumerateSinks(c, θ));
            }
        }
        return out;
    }

    boolean hardGate(Candidate c, Theta θ) {
        if (!θ["p.skill_injection.gate_sink"].contains(c.sinkKind)) return false;                          // (a) interpreting sink // src: vvaharness/skills/injection/SKILL.md:29
        if (!θ["p.skill_injection.gate_source"].contains(c.sourceKind)) return false;                      // (b) externally reachable source // src: vvaharness/skills/injection/SKILL.md:32
        if (c.defences.any(d -> θ["p.skill_injection.gate_no_defence"].contains(d))) return false;         // (c) no intervening defence // src: vvaharness/skills/injection/SKILL.md:35
        if (θ["p.skill_injection.drop_literal_or_unreachable"] && (c.sinkArgIsLiteral || !c.reached)) return false; // DROP // src: vvaharness/skills/injection/SKILL.md:37
        if (θ["p.skill_injection.no_sink_no_finding"] && c.sink == null) return false;                     // src: vvaharness/skills/injection/SKILL.md:38
        return true;
    }

    /** What refutes a candidate (and what does not). */
    boolean refuted(Candidate c, Theta θ) {
        if (θ["p.skill_injection.fp_literal_argument"] && c.argIsConstantOrFixedTupleOrEnum()) return true; // src: vvaharness/skills/injection/SKILL.md:49
        // a defence in the WRONG context does not refute
        if (c.defence != null && !(θ["p.skill_injection.defence_wrong_context_not_refutation"] && c.defence.wrongContext())) return true; // src: vvaharness/skills/injection/SKILL.md:50
        if (θ["p.skill_injection.parse_check_use_mismatch_is_finding"] && c.checksParsedButUsesRaw()) return false; // src: vvaharness/skills/injection/SKILL.md:54
        if (θ["p.skill_injection.trace_second_order_writes"] && c.callSiteLooksClean()) c.traceEarlierWrite(); // src: vvaharness/skills/injection/SKILL.md:57
        if (c.isXmlParserFactory() && c.hasAnyFlag(θ["p.skill_injection.xxe_check_hardening_flag"])) return true; // src: vvaharness/skills/injection/SKILL.md:60
        // an SSRF allow-list that still permits a metadata host does NOT refute
        if (c.isSsrf() && c.allowList != null && !c.allowList.permitsAny(θ["p.skill_injection.ssrf_allowlist_permitting_metadata"])) return true; // src: vvaharness/skills/injection/SKILL.md:63
        if (c.isRedos() && c.inputLengthCapped) c.severity = θ["p.skill_injection.sev_redos_capped_input_low"]; // src: vvaharness/skills/injection/SKILL.md:65
        if (c.isZipSlip() && θ["p.skill_injection.zip_slip_conditions"] && !(c.memberNamesUnvalidated && c.archiveAttackerSupplied)) return true; // src: vvaharness/skills/injection/SKILL.md:67
        return false;
    }

    /** ENUMERATION RULE: each distinct sink is its own finding; never an omnibus "input validation missing". */
    List<Finding> enumerateSinks(Candidate c, Theta θ) {
        List<Finding> out = new List();
        if (θ["p.skill_injection.enum_each_sink_separate"]) {                                               // src: vvaharness/skills/injection/SKILL.md:72
            for (Sink s : c.distinctSinks()) out.add(new Finding(s.vulnClass, s.file, s.line, c.source, s));
        }
        if (θ["p.skill_injection.never_collapse_omnibus"]) out = out.noOmnibus();                           // src: vvaharness/skills/injection/SKILL.md:75
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class InjectionPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_injection.scope_all_named_classes"]);                                             // src: vvaharness/skills/injection/SKILL.md:24
        p.evidence(θ["p.skill_injection.gate_sink"]);                                                       // src: vvaharness/skills/injection/SKILL.md:29
        p.evidence(θ["p.skill_injection.gate_source"]);                                                     // src: vvaharness/skills/injection/SKILL.md:32
        p.evidence(θ["p.skill_injection.gate_no_defence"]);                                                 // src: vvaharness/skills/injection/SKILL.md:35
        p.forbid(θ["p.skill_injection.drop_literal_or_unreachable"]);                                       // src: vvaharness/skills/injection/SKILL.md:37
        p.forbid(θ["p.skill_injection.no_sink_no_finding"]);                                                // src: vvaharness/skills/injection/SKILL.md:38
        p.step(1, θ["p.skill_injection.run_probe_first"]);                                                  // ## Probe first // src: vvaharness/skills/injection/SKILL.md:42
        p.rule(θ["p.skill_injection.probe_hits_are_candidates"]);                                           // src: vvaharness/skills/injection/SKILL.md:44
        p.rule(θ["p.skill_injection.probe_none_stops_class"]);                                              // src: vvaharness/skills/injection/SKILL.md:45
        p.checklist(θ["p.skill_injection.fp_literal_argument"]);                                            // ## What refutes a candidate // src: vvaharness/skills/injection/SKILL.md:49
        p.exemption(θ["p.skill_injection.defence_wrong_context_not_refutation"]);                           // src: vvaharness/skills/injection/SKILL.md:50
        p.rule(θ["p.skill_injection.parse_check_use_mismatch_is_finding"]);                                 // src: vvaharness/skills/injection/SKILL.md:54
        p.rule(θ["p.skill_injection.trace_second_order_writes"]);                                           // src: vvaharness/skills/injection/SKILL.md:57
        p.checklist(θ["p.skill_injection.xxe_check_hardening_flag"]);                                       // src: vvaharness/skills/injection/SKILL.md:60
        p.checklist(θ["p.skill_injection.ssrf_allowlist_permitting_metadata"]);                             // src: vvaharness/skills/injection/SKILL.md:63
        p.threshold(θ["p.skill_injection.sev_redos_capped_input_low"]);                                     // src: vvaharness/skills/injection/SKILL.md:65
        p.rule(θ["p.skill_injection.zip_slip_conditions"]);                                                 // src: vvaharness/skills/injection/SKILL.md:67
        p.must(θ["p.skill_injection.enum_each_sink_separate"]);                                             // ## ENUMERATION RULE // src: vvaharness/skills/injection/SKILL.md:72
        p.forbid(θ["p.skill_injection.never_collapse_omnibus"]);                                            // src: vvaharness/skills/injection/SKILL.md:75
        return p;
    }
}
