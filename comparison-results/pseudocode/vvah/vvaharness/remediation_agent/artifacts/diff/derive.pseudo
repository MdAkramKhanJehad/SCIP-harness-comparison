// file: vvaharness/remediation_agent/artifacts/diff/derive.py
// Picks between git diff and the synthesized fallback, so the diff is the harness's account, not the engine's.

@executedBy(CODE) @role(io) @stage("S10")
class DiffDerive {

    String deriveDiff(String repo, Map<String, String> snapshot, List<String> changed, Theta θ) {
        // Snapshot as baseline scopes the diff to this case's own edits, not an earlier case's.
        String diff = Gitcapture.captureGitDiff(repo, changed, snapshot, θ);                        // src: vvaharness/remediation_agent/artifacts/diff/derive.py:31
        if ((diff == null || diff.isEmpty()) && snapshot != null && θ["code.remediation_agent.artifacts.diff.derive.synth_fallback"]) { // src: vvaharness/remediation_agent/artifacts/diff/derive.py:32
            diff = Synth.synthUnifiedDiff(repo, snapshot, changed);                                 // src: vvaharness/remediation_agent/artifacts/diff/derive.py:33
        }
        return diff != null ? diff : "";                                                            // src: vvaharness/remediation_agent/artifacts/diff/derive.py:34
    }
}
