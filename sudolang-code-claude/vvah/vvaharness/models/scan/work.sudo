# vvaharness/models/scan/work.py

The work units Stage 3 emits: one `InvestigationUnit` per threat, the `TaskManifest` holding them (sorted by risk rank for Stage 4), and `DupLocation` for sites that deduplication collapsed.

Source: `vvaharness/models/scan/work.py` (lines 1-131)
Executor: code
Called from: `vvaharness/pipeline/stages/s3_decompose.py` (producer), `vvaharness/orchestrator/scan.py` (manifest.sorted_units, threats_without_unit_for), Stage 4 and Stage 7

// src: vvaharness/models/scan/work.py:30-43
UnitSize {
  value: "small" | "medium" | "large"   // small: one context, exhaustive; medium: fits but tight; large: file list plus sink hints, the model reads on demand
}
_UNIT_SIZE_ALIAS = {
  xs, tiny, s => "small";
  m, med, moderate, normal, default => "medium";
  l, xl, xxl, big, huge, x_large => "large"
}

// src: vvaharness/models/scan/work.py:46-48
fn threat_unit_id(threat_id):executor=code { return "threat-${ lowercase(threat_id) }" }   // collisions add -N, so the bare id always exists

// src: vvaharness/models/scan/work.py:51-88
InvestigationUnit {
  // populate_by_name: "files" also accepted under the alias "file_ids"
  id: String                 // for example "threat-t8"
  threat: String             // the claim to confirm or refute
  surface: String
  actor: String
  asset: String
  impact: String
  likelihood: String
  controls: String = ""
  evidence: String = ""
  files: String[] = []       // alias file_ids; the threat's whole validated surface, uncut
  sinks: Sink[] = []         // ctx.unsafe_sinks joined on file in files
  entry_points: EntryPoint[] = []
  related_cves: String[] = []
  cwes: String[] = []        // union of sinks[].cwe; the CweGuidance lookup keys
  communities: String[] = [] // call-graph community names; a tool-argument annotation, not a splitter; cosmetic
  risk_rank: Number = 999    // 26 - impact*likelihood; 1 = highest risk
  size: UnitSize = "medium"
  languages: String[] = []
  // coercions (before validation):
  //   size = _coerce_enum(size, ["small","medium","large"], _UNIT_SIZE_ALIAS, default="medium")
  //   risk_rank = _coerce_int(risk_rank, 999)
  //   files, related_cves, cwes, communities, languages = _coerce_str_list(value, "InvestigationUnit.<field>")
}

// src: vvaharness/models/scan/work.py:91-106
TaskManifest {
  units: InvestigationUnit[]
  unreachable_files: String[] = []      // dropped by the ctx.all_files check; listed in the report appendix
  threats_without_unit: String[] = []   // threats with no validated surface file; kept for audit
  // coercions: both lists through _coerce_str_list
}

// src: vvaharness/models/scan/work.py:108-109
fn TaskManifest.sorted_units():executor=code { return units sorted ascending by risk_rank }   // stable sort: equal ranks keep Stage 3 order

// src: vvaharness/models/scan/work.py:111-118
fn TaskManifest.threats_without_unit_for(tm):executor=code {
  if (tm == null) return threats_without_unit
  // derived from the units, not from Stage 3's list: on --resume a rerun Stage 2 can pair with a cached manifest from an older threat model
  minted = set of unit ids
  return tm.threat_ids() where threat_unit_id(tid) not in minted
}

// src: vvaharness/models/scan/work.py:121-131
DupLocation {
  file: String
  line_start: Number
  line_end: Number = 0
  vuln_class: VulnClass
  title: String = ""
  chunk_id: String = ""
  source_ref: String | null = null
  sink_ref: String | null = null
  reasoning: String = ""     // why deduplication merged this site into the canonical finding
}
