Finding {
  index: Number
  severity: String
  title: String
  file: String | null = null
  body: String = ""   // full Markdown block from the header to the next "### ", for the agent prompt
  done: Boolean = false   // DONE_MARKER present on the header

  label = "[$severity] $title" + (if (file) " ($file)" else "")
  // src: finding.py:38-43 — same slug rule as RemediationTarget.slug (see target.sudo)
  slug = "${index as two digits}_" + (first 60 characters of the lower-cased title with every run outside [a-z0-9] replaced by "-", trimmed of "-", or "finding" when empty)
}
