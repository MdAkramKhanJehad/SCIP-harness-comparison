// file: vulnhunter-agent/agent/token_client.py
// Role-based GitHub token accessor (scan / reports). Standalone mode returns config tokens;
// broker mode reads <broker_token_dir>/<role>.json on every request (no in-agent cache).

@executedBy(CODE) @role(backend) @stage("infra")
class TokenClient {

    // get_github_token: return the bearer token for role 'scan' or 'reports'.
    String getGithubToken(String role, GithubConfig github) {
        String brokerDir = github.brokerTokenDir;                                                 // src: vulnhunter-agent/agent/token_client.py:57
        if (brokerDir != "") return readBrokerFile(role, Path(brokerDir));                         // src: vulnhunter-agent/agent/token_client.py:58
        if (role == "scan") return github.scanToken;                                              // src: vulnhunter-agent/agent/token_client.py:60
        if (role == "reports") return github.reportsToken;                                        // src: vulnhunter-agent/agent/token_client.py:62
        throw new ValueError("unknown GitHub role");                                              // src: vulnhunter-agent/agent/token_client.py:64
    }

    // _read_broker_file: one retry after a short sleep absorbs the broker's atomic-rename window.
    String readBrokerFile(String role, Path brokerDir) {
        Path path = brokerDir.resolve(role + ".json");                                            // src: vulnhunter-agent/agent/token_client.py:97
        try {
            return readTokenField(path);                                                          // src: vulnhunter-agent/agent/token_client.py:99
        } catch (FileNotFoundError | JSONDecodeError e) {
            sleep(θ["code.agent.token_client.broker_retry_sleep_seconds"]);                     // src: vulnhunter-agent/agent/token_client.py:101
            return readTokenField(path);                                                          // src: vulnhunter-agent/agent/token_client.py:102
        }
    }

    // _read_token_field: token must be a non-empty string.
    String readTokenField(Path path) {
        Map data = json.loads(path.readText());                                                   // src: vulnhunter-agent/agent/token_client.py:106
        Object token = data.get("token");                                                         // src: vulnhunter-agent/agent/token_client.py:107
        if (!(token instanceof String) || token == "") throw new ValueError("broker token file missing or empty token"); // src: vulnhunter-agent/agent/token_client.py:108
        return token;
    }
}

// BrokerTokenAuth: httpx.Auth that re-resolves the token on every outgoing request.
@executedBy(CODE) @role(backend) @stage("infra")
class BrokerTokenAuth {
    String role;
    GithubConfig github;

    Request authFlow(Request request) {
        String token = TokenClient.getGithubToken(role, github);                                  // src: vulnhunter-agent/agent/token_client.py:91
        request.headers.put("Authorization", "Bearer " + token);                                  // src: vulnhunter-agent/agent/token_client.py:92
        return request;
    }
}
