{
  "models": {
    "autoexclude": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "preprocess": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "threatmodel": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "decompose": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "deepdive": {
      "id": "claude-sonnet-4-6",
      "via": "sdk",
      "temperature": 0.4
    },
    "verify": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "dedup": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "chain": {
      "id": "claude-sonnet-4-6",
      "via": "sdk"
    },
    "remediate": {
      "id": "claude-opus-4-8",
      "via": "sdk"
    },
    "validate": {
      "orchestrator": {
        "id": "claude-sonnet-4-6",
        "via": "sdk"
      },
      "security_architect": {
        "id": "claude-opus-4-8"
      },
      "penetration_tester": {
        "id": "claude-sonnet-4-6"
      },
      "cross_repo_analyzer": {
        "id": "claude-sonnet-4-6"
      }
    },
    "exploit_verification": {
      "attacker": {
        "id": "claude-sonnet-4-6",
        "via": "sdk"
      },
      "judge": {
        "id": "claude-opus-4-8",
        "via": "sdk"
      },
      "classify": {
        "id": "claude-sonnet-4-6",
        "via": "sdk"
      },
      "mapper": {
        "id": "claude-sonnet-4-6",
        "via": "sdk"
      }
    }
  },
  "sdk": {
    "api_key": "${ANTHROPIC_SDK_API_KEY}",
    "base_url": "${ANTHROPIC_SDK_BASE_URL}",
    "verify_ssl": true,
    "ca_cert": "${ANTHROPIC_SDK_CA_CERT}",
    "client_cert": "${ANTHROPIC_SDK_CLIENT_CERT}"
  },
  "cache_markers": "on",
  "cache_min_block_tokens": null,
  "cache_route": "anthropic",
  "step1": {
    "auto_exclude": true,
    "auto_exclude_protect_templates": true,
    "auto_exclude_protect_key_material": true,
    "auto_exclude_protect_secrets": true,
    "auto_exclude_protect_client_sinks": true,
    "auto_exclude_max_tokens": 8000,
    "auto_exclude_effort": "high",
    "allowed_tools": [
      "Read",
      "Grep"
    ],
    "exclude_dirs": [
      ".vs",
      ".settings",
      ".vscode",
      ".idea",
      "node_modules"
    ],
    "exclude_exts": [
      ".msi",
      ".nupkg",
      ".pdb",
      ".lib",
      ".aar",
      ".ser",
      ".pbix",
      ".p12",
      ".pfx",
      ".jks",
      ".der",
      ".cer",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".xlsm",
      ".bmp",
      ".sqlite",
      ".db"
    ],
    "exclude_globs": [
      "**/._*"
    ],
    "max_file_kb": 1024,
    "follow_symlinks": false,
    "config_dedup": {
      "enabled": true,
      "min_cluster_size": 5,
      "keep_per_top_dir": true,
      "promote_on_secret_hit": true,
      "promote_on_insecure_value": true
    }
  },
  "step2": {
    "max_threats": 50,
    "max_assets": 40,
    "max_trust_boundaries": 60,
    "baseline": "auto",
    "empty_retry": true,
    "max_tokens": 64000,
    "effort": "high",
    "max_turns": 60,
    "max_model_calls": 4,
    "deadline": 400,
    "replay_timeout": 300,
    "replay_max_tokens": 16000,
    "timeout": 900,
    "allowed_tools": [
      "Read",
      "Grep"
    ],
    "bash": false,
    "graph_tools": true,
    "graph_tool_budget": 6,
    "planning": true,
    "require_graph": true,
    "require_graph_rejections": 2,
    "skills": true,
    "max_doc_chars": 32000,
    "max_manifest_chars": 4000,
    "max_manifest_total_chars": 24000,
    "max_manifests": 12,
    "max_manifests_per_kind": 2,
    "max_manifest_depth": 3,
    "max_prompt_modules": 100,
    "max_prompt_entry_points": 400,
    "max_inventory_files": 1200,
    "max_api_artefacts": 100,
    "max_config_reps": 80,
    "max_config_rep_chars": 2000,
    "max_config_rep_bodies": 12,
    "max_modules": 100,
    "max_entry_points": 400,
    "max_graph_files": 220,
    "max_graph_sinks": 80,
    "max_graph_edges": 100
  },
  "step4": {
    "parallel": 12,
    "batch_size": 1,
    "max_tokens": 64000,
    "effort": "high",
    "max_turns": 60,
    "max_model_calls": 0,
    "deadline": 400,
    "replay_timeout": 60,
    "replay_max_tokens": 16000,
    "cwe_tools": true,
    "cwe_tool_budget": 6,
    "graph_tool_budget": 6,
    "require_graph": true,
    "evidence_gate": true,
    "evidence_gate_refusals": 3,
    "planning": true,
    "skills": true,
    "inline_source": false,
    "bash": false,
    "line_bucket": 10,
    "max_extra_cwes": 2,
    "max_findings_per_run": 50,
    "split_retry": true
  },
  "step5_prefilter": {
    "sink_reanchor": true,
    "sink_reanchor_max_move_lines": 40,
    "line_tolerance": 5
  },
  "step5_detectors": {
    "enabled": true,
    "max_rows": 200
  },
  "step6_verify": {
    "parallel": 7,
    "batch_size": 12,
    "max_tokens": 32000,
    "effort": "high",
    "max_turns": 30,
    "max_model_calls": 0,
    "batch_deadline": 400,
    "replay_timeout": 60,
    "replay_max_tokens": 12000,
    "batch_wall_clock_ceiling": 900,
    "split_retry": true,
    "min_confidence": 5,
    "trait_stamps": true,
    "reframe_enabled": false,
    "inline_source": true,
    "graph_tools": false,
    "graph_tool_budget": 16,
    "require_graph": false,
    "evidence_gate_refusals": 3,
    "max_budget_usd": 10.0,
    "progress_file": false,
    "allowed_tools": [
      "Read",
      "Grep"
    ]
  },
  "step6_exploit_verification": {
    "enabled": "auto",
    "on_unreachable": "drop",
    "timeout_s": 15,
    "safe_mode": true,
    "allow_state_changing_methods": true,
    "ev_overrides_static": false,
    "max_requests_per_finding": 300,
    "max_payloads_per_finding": 50,
    "rate_limit_rps": 0,
    "max_concurrency_target": 8,
    "max_concurrency_endpoint": 4,
    "parallel": 5,
    "store_probes": false,
    "oob": "auto",
    "ev_replay_variants": true,
    "on_auth_failure": "degrade",
    "auth_expiry_skew_s": 60,
    "max_reauth": 3,
    "classify": {
      "batch": 10,
      "parallel": 5,
      "effort": "high"
    },
    "mapper": {
      "max_turns": 20,
      "parallel": 4,
      "effort": "high",
      "endpoint_index": {
        "chunk": 10
      },
      "finding_map": {
        "chunk": 6,
        "max_endpoints": 5
      }
    },
    "attacker": {
      "enabled": true,
      "max_turns": 20,
      "max_tool_result_chars": 12000,
      "effort": "high"
    },
    "judge": {
      "max_tokens": 4000,
      "max_records": 24,
      "effort": "high"
    }
  },
  "step7_dedup": {
    "line_tolerance": 3,
    "per_sink_keep": true,
    "semantic": false,
    "max_tokens": 64000,
    "effort": "high"
  },
  "step8": {
    "severity_lift_gate": true,
    "chain_quality_checks": true,
    "chain_dedup": true,
    "prompt_fact_blocks": true,
    "max_model_calls": 1,
    "max_turns": 2,
    "deadline": 800,
    "replay_timeout": 300,
    "replay_max_tokens": 16000,
    "max_tokens": 64000,
    "effort": "high",
    "timeout": 2400,
    "prompt_token_budget": 100000
  },
  "step9": {
    "duplicate_result_guard": true
  },
  "step_remediate": {
    "enabled": true,
    "enforce_policy": true,
    "policy_file": null,
    "playbook_file": null,
    "top_n_findings": 5,
    "max_budget_usd": 10.0,
    "max_turns": 40,
    "max_model_calls": 20,
    "timeout": 3600,
    "allowed_tools": [
      "Read",
      "Grep",
      "Edit",
      "Write"
    ]
  },
  "step_validate": {
    "enabled": true,
    "effort": "high",
    "max_turns": 50,
    "max_budget_usd": 15.0,
    "max_findings": 20,
    "timeout": 3600,
    "max_model_calls": 60,
    "orchestrator_max_model_calls": 40,
    "allowed_tools": [
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "inject": {
    "cve_file": "../../../inputs/known_cves.json",
    "controls_file": "../../../inputs/design_controls.yaml",
    "cmdb_file": "../../../inputs/cmdb.csv"
  },
  "batch": {
    "git_token": "${GITHUB_TOKEN}",
    "git_base_url": "${GIT_BASE_URL}",
    "skip_repo_patterns": [
      "*automation*",
      "*-playwright*",
      "*-selenium*",
      "*-karate*",
      "*perf-script*",
      "*perf-test*",
      "*test-buddy*",
      "*-e2e*",
      "*-mock-*"
    ]
  },
  "scan_progress": {
    "enabled": false,
    "style": "compact"
  },
  "output": {
    "posture_channel": true,
    "emit_unreachable_appendix": false,
    "preserve_on_cleanup": [
      "security-scan",
      "security-remediation"
    ],
    "ingest_url": "${VVAHARNESS_INGEST_URL:-}",
    "ingest_token": "${VVAHARNESS_INGEST_TOKEN:-}",
    "ingest_verify": "${VVAHARNESS_INGEST_VERIFY:-true}"
  },
  "think_in_prompt": true
}
