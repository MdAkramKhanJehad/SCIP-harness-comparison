// file: vvaharness/pipeline/stages/s4/prompts.py
// S4 prompts: one scan-constant SYSTEM prompt (cacheable, one per (shell, graph) pair), one per-unit INITIAL
// prompt (or one batch prompt), and the planner's system prompt + write_todos tool description.
// S4InvestigationProcedure renders, as control flow, the procedure these prompts ask the MODEL to carry out.

@executedBy(MODEL) @role(prompt) @stage("S4")
class S4Prompts {

    // Main entry: the (system, first-turn) pair for one single-unit session.
    Pair<Prompt, Prompt> run(InvestigationUnit unit, String code, int callBudget, boolean shell, boolean graph, Theta θ) {
        return Pair.of(buildSystemPrompt(shell, graph, θ), buildInitialPrompt(unit, code, callBudget, graph, θ));
    }

    // ---------------- system prompt ----------------

    Prompt buildSystemPrompt(boolean shell, boolean graph, Theta θ) {
        // order: ROLE, SCOPE, VERDICT, BREADTH, CWE, CWE_PAIRS, CWE_TOOL_DUTY, [GRAPH_TOOL_DUTY], [PLUGIN_TOOL_DUTY],
        //        [SHELL_DUTY], ABSENCE_METHOD, SKILL_DUTY, READ_COMPLETELY, FP_DISCIPLINE, OUTPUT_EXAMPLE
        List<String> order = θ["p.s4_prompts.system_prompt_clause_order"];                               // src: vvaharness/pipeline/stages/s4/prompts.py:426
        Prompt p = new Prompt();
        p.include(role(θ));                                                                              // src: vvaharness/pipeline/stages/s4/prompts.py:428
        p.include(scopeClause(θ));                                                                       // src: vvaharness/pipeline/stages/s4/prompts.py:429
        p.include(verdictClause(θ));                                                                     // src: vvaharness/pipeline/stages/s4/prompts.py:430
        p.include(breadthClause(θ));                                                                     // src: vvaharness/pipeline/stages/s4/prompts.py:431
        p.include(cweClause(θ));                                                                         // src: vvaharness/pipeline/stages/s4/prompts.py:432
        p.include(cwePairs(θ));                                                                          // src: vvaharness/pipeline/stages/s4/prompts.py:433
        p.include(cweToolDuty(θ));                                                                       // src: vvaharness/pipeline/stages/s4/prompts.py:434
        if (graph) p.include(graphToolDuty(θ));                                                          // src: vvaharness/pipeline/stages/s4/prompts.py:435
        if (graph) p.include(pluginToolDuty(θ));                                                         // src: vvaharness/pipeline/stages/s4/prompts.py:436
        if (shell) p.include(shellDuty(graph, θ));      // shell mirrors step4.bash                      // src: vvaharness/pipeline/stages/s4/prompts.py:437
        p.include(absenceMethod(θ));                                                                     // src: vvaharness/pipeline/stages/s4/prompts.py:438
        p.include(skillDuty(θ));                                                                         // src: vvaharness/pipeline/stages/s4/prompts.py:439
        p.include(readCompletelyClause(θ));                                                              // src: vvaharness/pipeline/stages/s4/prompts.py:440
        p.include(fpDiscipline(θ));                                                                      // src: vvaharness/pipeline/stages/s4/prompts.py:441
        if (θ["p.s4_prompts.output_example_included"]) p.include(outputExample(θ));                      // src: vvaharness/pipeline/stages/s4/prompts.py:442
        return p;
    }

    Prompt role(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.s4_prompts.role_one_claim"]);   // "You confirm or refute ONE specific threat claim against the code that implements it." // src: vvaharness/pipeline/stages/s4/prompts.py:348
        p.persona(θ["prompt.s4.role"]);                // hypothesis-driven: tests a threat, does not trace every input // src: vvaharness/pipeline/stages/s4/prompts.py:348
        return p;
    }

    Prompt scopeClause(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s4_prompts.files_starting_point_not_boundary"]);   // FILES is a STARTING POINT, NOT A BOUNDARY // src: vvaharness/pipeline/stages/s4/prompts.py:105
        p.rule("leave FILES whenever the evidence leads out of it: helper sink, tainted caller, settings module, template, base class"); // src: vvaharness/pipeline/stages/s4/prompts.py:107
        p.rule(θ["p.s4_prompts.out_of_files_finding_valid"]);          // report it with its real path and line // src: vvaharness/pipeline/stages/s4/prompts.py:110
        p.forbid(θ["p.s4_prompts.no_widening_unrelated"]);             // follow THIS threat as far as it goes  // src: vvaharness/pipeline/stages/s4/prompts.py:111
        return p;
    }

    Prompt verdictClause(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.s4_prompts.verdict_set"]);                       // exactly one of three verdicts        // src: vvaharness/pipeline/stages/s4/prompts.py:93
        p.choose(θ["prompt.s4.verdicts"]);                                                               // src: vvaharness/pipeline/stages/s4/prompts.py:92
        p.rule(θ["p.s4_prompts.verdict_confirmed_def"]);               // evidence the claim holds; list every distinct finding // src: vvaharness/pipeline/stages/s4/prompts.py:93
        p.rule(θ["p.s4_prompts.verdict_refuted_def"]);                 // followed to implementation, does not hold; first-class outcome // src: vvaharness/pipeline/stages/s4/prompts.py:94
        p.rule(θ["p.s4_prompts.verdict_inconclusive_def"]);            // could not reach the evidence         // src: vvaharness/pipeline/stages/s4/prompts.py:97
        p.forbid(θ["p.s4_prompts.refuted_not_fallback"]);              // refuted is not a fallback for low turns // src: vvaharness/pipeline/stages/s4/prompts.py:98
        p.forbid(θ["p.s4_prompts.confirmed_not_default"]);             // confirmed never a default guess      // src: vvaharness/pipeline/stages/s4/prompts.py:99
        return p;
    }

    Prompt breadthClause(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s4.breadth_and_siblings"]);                   // one location often holds MORE THAN ONE weakness // src: vvaharness/pipeline/stages/s4/prompts.py:31
        p.must(θ["p.s4_prompts.separate_finding_per_class"]);          // own cwe and own line_start/line_end   // src: vvaharness/pipeline/stages/s4/prompts.py:32
        p.forbid(θ["p.s4_prompts.no_fold_no_split"]);                  // no folding classes, no near-duplicates // src: vvaharness/pipeline/stages/s4/prompts.py:34
        p.threshold(θ["p.s4_prompts.evidence_for_bar"]);               // "Evidence for" is the bar            // src: vvaharness/pipeline/stages/s4/prompts.py:36
        return p;
    }

    Prompt cweClause(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s4_prompts.cwe_required"]);                        // every finding MUST carry one most-specific cwe // src: vvaharness/pipeline/stages/s4/prompts.py:23
        p.format(θ["p.s4_prompts.cwe_format"]);                        // formatted exactly as "CWE-79"         // src: vvaharness/pipeline/stages/s4/prompts.py:24
        p.tiebreak(θ["p.s4_prompts.cwe_agree_or_override"]);           // task-line class if analysis agrees, else evidence's id // src: vvaharness/pipeline/stages/s4/prompts.py:26
        return p;
    }

    Prompt cwePairs(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s4_prompts.cwe_pairs_check_second"]);              // confirm first -> check second -> also_cwes // src: vvaharness/pipeline/stages/s4/prompts.py:43
        p.checklist(θ["p.s4_prompts.cwe_pair_cookie_flags"]);          // CWE-1004 + CWE-614 (+ CWE-1275)       // src: vvaharness/pipeline/stages/s4/prompts.py:44
        p.checklist(θ["p.s4_prompts.cwe_pair_csrf_authz"]);            // CWE-352 + CWE-862                     // src: vvaharness/pipeline/stages/s4/prompts.py:46
        p.checklist(θ["p.s4_prompts.cwe_pair_login"]);                 // CWE-307 + CWE-204 (+ CWE-521)          // src: vvaharness/pipeline/stages/s4/prompts.py:48
        p.tiebreak(θ["p.s4_prompts.cwe_pair_password_hash"]);          // CWE-916 / 759 / 328 by failing property // src: vvaharness/pipeline/stages/s4/prompts.py:50
        p.tiebreak(θ["p.s4_prompts.cwe_pair_template_eval"]);          // 79 template, 1336 engine, 95 eval/exec not 94 // src: vvaharness/pipeline/stages/s4/prompts.py:53
        p.checklist(θ["p.s4_prompts.cwe_pair_ssrf_redirect"]);         // CWE-918 + CWE-601 if follows redirects // src: vvaharness/pipeline/stages/s4/prompts.py:55
        p.tiebreak(θ["p.s4_prompts.prefer_most_specific_cwe"]);        // most specific id the evidence supports // src: vvaharness/pipeline/stages/s4/prompts.py:57
        return p;
    }

    Prompt cweToolDuty(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s4_prompts.cweguidance_only_uncovered"]);          // call CweGuidance only for CWEs the pairs miss // src: vvaharness/pipeline/stages/s4/prompts.py:62
        p.evidence(θ["p.s4_prompts.cweguidance_fp_checks_in_rationale"]); // address that entry's FP CHECKS in rationale // src: vvaharness/pipeline/stages/s4/prompts.py:63
        p.forbid("Each call re-sends this whole session, so do not look up what you have just been told."); // src: vvaharness/pipeline/stages/s4/prompts.py:63
        return p;
    }

    // Names registered plugin graph tools; empty when no plugin contributed any.
    @executedBy(CODE)
    Prompt pluginToolDuty(Theta θ) {
        Prompt p = new Prompt();
        List<String> extra = GraphTools.names().filter(n -> !GRAPH_TOOL_NAMES.contains(n));             // src: vvaharness/pipeline/stages/s4/prompts.py:417
        if (extra.isEmpty()) return p;                                                                   // src: vvaharness/pipeline/stages/s4/prompts.py:418
        p.context(extra);
        p.rule(θ["p.s4_prompts.plugin_graph_tools_named"]);            // as callable as the six; read their descriptions // src: vvaharness/pipeline/stages/s4/prompts.py:71
        p.rule(θ["p.s4_prompts.plugin_tool_same_budget"]);             // same budget as a built-in              // src: vvaharness/pipeline/stages/s4/prompts.py:75
        return p;
    }

    Prompt graphToolDuty(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s4_prompts.graph_tool_set"]);                   // six graph tools + Read/Grep/Glob      // src: vvaharness/pipeline/stages/s4/prompts.py:80
        p.must(θ["p.s4_prompts.graph_impact_before_reachability"]);    // GraphImpact before relying on reachability // src: vvaharness/pipeline/stages/s4/prompts.py:81
        p.rule(θ["p.s4_prompts.graph_neighbors_for_context"]);                                           // src: vvaharness/pipeline/stages/s4/prompts.py:83
        p.rule(θ["p.s4_prompts.graph_sinks_in_community"]);                                              // src: vvaharness/pipeline/stages/s4/prompts.py:85
        p.rule(θ["p.s4_prompts.graph_context_blast_radius"]);                                            // src: vvaharness/pipeline/stages/s4/prompts.py:86
        p.rule(θ["p.s4_prompts.graph_over_reading"]);                  // reading a file for a graph answer is weaker // src: vvaharness/pipeline/stages/s4/prompts.py:87
        return p;
    }

    Prompt shellDuty(boolean graph, Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s4_prompts.shell_tool_set"]);                   // grep sed awk sort head wc python3; rg NOT installed // src: vvaharness/pipeline/stages/s4/prompts.py:265
        p.rule(θ["p.s4_prompts.shell_multi_pattern_grep_siblings"]);   // one grep -rEn "p1|p2|p3" = SIBLINGS pass // src: vvaharness/pipeline/stages/s4/prompts.py:268
        p.rule(θ["p.s4_prompts.shell_sed_span_over_read"]);            // sed -n "120,180p" over Read            // src: vvaharness/pipeline/stages/s4/prompts.py:272
        p.threshold(θ["p.s4_prompts.shell_cap_wide_results"]);         // ... | head -40                        // src: vvaharness/pipeline/stages/s4/prompts.py:274
        p.rule(θ["p.s4_prompts.shell_probe_sh"]);                      // sh .vvaharness/skills/<lens>/probe.sh; empty section = absence // src: vvaharness/pipeline/stages/s4/prompts.py:276
        p.rule(θ["p.s4_prompts.shell_context_cost_stance"]);           // tool output re-sent every later turn   // src: vvaharness/pipeline/stages/s4/prompts.py:280
        if (graph) p.must(θ["p.s4_prompts.shell_graph_handoff"]);      // grep to locate, graph to prove reachable; verdict held until a graph tool ran // src: vvaharness/pipeline/stages/s4/prompts.py:287
        p.rule(θ["p.s4_prompts.shell_grep_exit1_no_retry"]);                                             // src: vvaharness/pipeline/stages/s4/prompts.py:293
        p.must(θ["p.s4_prompts.shell_quote_patterns"]);                                                  // src: vvaharness/pipeline/stages/s4/prompts.py:294
        p.forbid(θ["p.s4_prompts.shell_readonly_restrictions"]);       // no writes, installs, network, git mutations; stay in repo // src: vvaharness/pipeline/stages/s4/prompts.py:295
        return p;
    }

    Prompt absenceMethod(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s4.absence_method"]);                         // "When the claim is that something is MISSING" // src: vvaharness/pipeline/stages/s4/prompts.py:136
        p.rule(θ["p.s4_prompts.absence_enumerate_first"]);             // ENUMERATE the sites first, judge second // src: vvaharness/pipeline/stages/s4/prompts.py:140
        p.threshold(θ["p.s4_prompts.absence_needs_all_three"]);        // a finding needs all three             // src: vvaharness/pipeline/stages/s4/prompts.py:142
        p.step(1, θ["p.s4_prompts.absence_cond1_real_reachable_site"]);                                  // src: vvaharness/pipeline/stages/s4/prompts.py:143
        p.step(2, θ["p.s4_prompts.absence_cond2_control_belongs"]);                                      // src: vvaharness/pipeline/stages/s4/prompts.py:145
        p.step(3, θ["p.s4_prompts.absence_cond3_checked_central"]);    // middleware, base class, decorator factory, proxy config, framework default // src: vvaharness/pipeline/stages/s4/prompts.py:148
        p.must(θ["p.s4_prompts.absence_enumerate_population"]);        // Grep whole population, state size, one finding per absent site // src: vvaharness/pipeline/stages/s4/prompts.py:152
        p.rule(θ["p.s4_prompts.absence_refute_with_count"]);           // present everywhere -> REFUTE with count // src: vvaharness/pipeline/stages/s4/prompts.py:153
        return p;
    }

    Prompt skillDuty(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s4_prompts.skill_lens_list"]);                  // 17 lenses under .vvaharness/skills/<name>/SKILL.md // src: vvaharness/pipeline/stages/s4/prompts.py:163
        p.threshold(θ["p.s4_prompts.skill_at_most_one"]);              // Read AT MOST ONE, only when not already given // src: vvaharness/pipeline/stages/s4/prompts.py:166
        p.forbid(θ["p.s4_prompts.skill_no_fetch_absence_sibling"]);    // absence method / sibling sweep already above // src: vvaharness/pipeline/stages/s4/prompts.py:169
        p.must(θ["p.s4_prompts.skill_name_in_rationale"]);                                               // src: vvaharness/pipeline/stages/s4/prompts.py:170
        return p;
    }

    Prompt readCompletelyClause(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s4.read_completely"]);                                                          // src: vvaharness/pipeline/stages/s4/prompts.py:122
        // unclear: this system clause always says the SOURCE CODE block carries every file, even when inline_source is off
        p.forbid(θ["p.s4_prompts.no_refetch_inlined_source"]);         // do not Read a path already in the block // src: vvaharness/pipeline/stages/s4/prompts.py:124
        p.exemption(θ["p.s4_prompts.read_only_for"]);                  // path not in FILES, or block-marked truncated // src: vvaharness/pipeline/stages/s4/prompts.py:129
        p.must(θ["p.s4_prompts.finish_paginated_file"]);               // re-Read at "next offset" until the end // src: vvaharness/pipeline/stages/s4/prompts.py:130
        p.rule(θ["p.s4_prompts.silence_not_absence"]);                                                   // src: vvaharness/pipeline/stages/s4/prompts.py:132
        return p;
    }

    Prompt fpDiscipline(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s4.fp_discipline"]);                                                            // src: vvaharness/pipeline/stages/s4/prompts.py:115
        p.tiebreak(θ["p.s4_prompts.already_in_place_rule"]);           // mitigating control -> refute, or say why it fails // src: vvaharness/pipeline/stages/s4/prompts.py:116
        return p;
    }

    Prompt outputExample(Theta θ) {
        Prompt p = new Prompt();
        p.format("Example of the JSON shape, one confirmed (threat-t8) and one refuted (threat-t7, findings []) outcome"); // src: vvaharness/pipeline/stages/s4/prompts.py:319
        p.format(θ["p.s4_prompts.finding_fields"]);                    // cwe file line_start line_end repeat_lines sink_line title severity description exploit_scenario recommendation preconditions // src: vvaharness/pipeline/stages/s4/prompts.py:325
        p.rule("the schema field descriptions are authoritative");                                       // src: vvaharness/pipeline/stages/s4/prompts.py:332
        p.rule(θ["p.s4_prompts.line_span_whole_construct"]);           // 42-58 decorator to end of body; sink_line 0 for a missing control // src: vvaharness/pipeline/stages/s4/prompts.py:333
        p.rule(θ["p.s4_prompts.repeat_lines_same_defect"]);            // repeat_lines [71, 96], never one 42-96 span // src: vvaharness/pipeline/stages/s4/prompts.py:335
        p.must(θ["p.s4_prompts.preconditions_never_empty_default"]);   // name the gate                         // src: vvaharness/pipeline/stages/s4/prompts.py:338
        p.rule(θ["p.s4_prompts.exploit_scenario_supported_only"]);                                       // src: vvaharness/pipeline/stages/s4/prompts.py:339
        return p;
    }

    // ---------------- planner (TodoListMiddleware) ----------------

    Prompt buildPlanSystemPrompt(boolean graph, Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s4_prompts.plan_mandatory_first_action"]);         // FIRST action is write_todos; no answer/outcome before a worked plan // src: vvaharness/pipeline/stages/s4/prompts.py:352
        p.rule(θ["p.s4_prompts.plan_claim_is_lead"]);                  // the claim is a LEAD, not the scope   // src: vvaharness/pipeline/stages/s4/prompts.py:354
        p.step(1, θ["p.s4_prompts.plan_item1_every_file"]);            // one todo per file or group            // src: vvaharness/pipeline/stages/s4/prompts.py:356
        // unclear: plan text always says the source is "already inlined below", regardless of step4.inline_source
        p.exemption(θ["p.s4_prompts.plan_skill_only_if_needed"]);                                        // src: vvaharness/pipeline/stages/s4/prompts.py:358
        p.step(2, θ["p.s4_prompts.plan_item2_locate_implementation"]);                                   // src: vvaharness/pipeline/stages/s4/prompts.py:361
        if (graph) {
            p.step(3, θ["p.s4_prompts.plan_item3_reachability_graph"]);   // GraphContext / GraphImpact          // src: vvaharness/pipeline/stages/s4/prompts.py:367
        } else {
            p.step(3, θ["p.s4_prompts.plan_item3_reachability_no_graph"]); // Grep callers toward an entry point // src: vvaharness/pipeline/stages/s4/prompts.py:374
        }
        p.step(4, θ["p.s4_prompts.plan_item4_decide_fp_checks"]);                                        // src: vvaharness/pipeline/stages/s4/prompts.py:381
        p.step(5, θ["p.s4_prompts.plan_item5_other_classes"]);                                           // src: vvaharness/pipeline/stages/s4/prompts.py:383
        p.step(6, θ["p.s4_prompts.plan_item6_siblings"]);                                                // src: vvaharness/pipeline/stages/s4/prompts.py:385
        p.step(7, θ["p.s4_prompts.plan_item7_missing_control_enumerate"]);                               // src: vvaharness/pipeline/stages/s4/prompts.py:387
        p.must(θ["p.s4_prompts.plan_todo_status_discipline"]);         // in_progress on start, completed only when done // src: vvaharness/pipeline/stages/s4/prompts.py:389
        p.rule(θ["p.s4_prompts.plan_outcome_gated_on_todos"]);         // enforced in code by EvidenceGate      // src: vvaharness/pipeline/stages/s4/prompts.py:392
        p.exemption(θ["p.s4_prompts.plan_inapplicable_todo_rule"]);    // mark completed and say why; no same-verdict retry // src: vvaharness/pipeline/stages/s4/prompts.py:394
        return p;
    }

    Prompt planToolDescription(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s4_prompts.plan_tool_call_first"]);                // before any other tool and any verdict  // src: vvaharness/pipeline/stages/s4/prompts.py:405
        p.must(θ["p.s4_prompts.plan_tool_verdict_needs_plan"]);                                          // src: vvaharness/pipeline/stages/s4/prompts.py:409
        p.choose(List.of("pending", "in_progress", "completed"));                                        // src: vvaharness/pipeline/stages/s4/prompts.py:410
        p.threshold(θ["p.s4_prompts.plan_tool_once_per_turn"]);        // never twice in one turn               // src: vvaharness/pipeline/stages/s4/prompts.py:410
        return p;
    }

    // ---------------- first-turn prompt ----------------

    Prompt buildInitialPrompt(InvestigationUnit unit, String code, int callBudget, boolean graph, Theta θ) {
        Prompt p = new Prompt();
        p.include(unitBlock(unit, code, false, graph, θ));                                               // src: vvaharness/pipeline/stages/s4/prompts.py:531
        p.include(sweep(callBudget, code != null, graph, θ));                                            // src: vvaharness/pipeline/stages/s4/prompts.py:532
        p.include(closing(callBudget, θ));                                                               // src: vvaharness/pipeline/stages/s4/prompts.py:533
        return p;
    }

    @executedBy(CODE)
    Prompt sweep(int budget, boolean inlined, boolean graph, Theta θ) {
        Object variant = θ["prompt.s4.sweep_variant"];                                                   // src: vvaharness/pipeline/stages/s4/prompts.py:304
        if (budget > 0) return budgetedSweep(budget, inlined, graph, θ);  // θ["p.s4_prompts.sweep_variant_selection"] // src: vvaharness/pipeline/stages/s4/prompts.py:306
        Object selection = θ["p.s4_prompts.sweep_variant_selection"];   // budgeted iff step4.max_model_calls > 0 // src: vvaharness/pipeline/stages/s4/prompts.py:305
        return breadthSweep(inlined, graph, θ);                                                          // src: vvaharness/pipeline/stages/s4/prompts.py:308
    }

    Prompt budgetedSweep(int budget, boolean inlined, boolean graph, Theta θ) {
        Prompt p = new Prompt();
        int lookups = max(0, budget - 1);                                                                // src: vvaharness/pipeline/stages/s4/prompts.py:203
        p.threshold(θ["p.s4_prompts.budgeted_call_count_statement"]);  // "YOU HAVE <budget> MODEL CALLS ... last one is reserved" // src: vvaharness/pipeline/stages/s4/prompts.py:205
        p.threshold(θ["p.s4_prompts.budgeted_plan_spend"]);            // <budget-1> tool-using calls; plan the spend // src: vvaharness/pipeline/stages/s4/prompts.py:207
        if (inlined) {
            p.rule(θ["p.s4_prompts.budgeted_no_read_needed"]);                                           // src: vvaharness/pipeline/stages/s4/prompts.py:208
        } else {
            p.rule(θ["p.s4_prompts.budgeted_one_batched_read"]);                                         // src: vvaharness/pipeline/stages/s4/prompts.py:210
        }
        p.checklist(θ["p.s4_prompts.budgeted_spend_order"]);           // REACHABILITY, then BREADTH IN ONE CALL // src: vvaharness/pipeline/stages/s4/prompts.py:212
        if (graph) {
            p.step(1, θ["p.s4_prompts.budgeted_reachability_graph"]);  // one GraphContext                     // src: vvaharness/pipeline/stages/s4/prompts.py:189
        } else {
            p.step(1, θ["p.s4_prompts.budgeted_reachability_no_graph"]); // one repo-wide Grep                 // src: vvaharness/pipeline/stages/s4/prompts.py:195
        }
        p.rule(θ["p.s4_prompts.unreachable_sink_not_finding"]);        // "An unreachable sink is not a finding" // src: vvaharness/pipeline/stages/s4/prompts.py:190
        p.step(2, θ["p.s4_prompts.budgeted_breadth_one_call"]);        // probe.sh or one multi-pattern grep    // src: vvaharness/pipeline/stages/s4/prompts.py:214
        p.must(θ["p.s4_prompts.budgeted_report_every_weakness"]);      // claim + injection, authz, crypto, secrets, ... // src: vvaharness/pipeline/stages/s4/prompts.py:218
        p.rule(θ["p.s4_prompts.budgeted_narrow_budget_whole_surface"]);                                  // src: vvaharness/pipeline/stages/s4/prompts.py:221
        p.forbid(θ["p.s4_prompts.budgeted_no_empty_findings"]);        // no re-fetch, no empty list for lack of lookups // src: vvaharness/pipeline/stages/s4/prompts.py:223
        return p;
    }

    Prompt breadthSweep(boolean inlined, boolean graph, Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.s4_prompts.sweep_four_passes_ordered"]);      // SURFACE, REACHABILITY, CO-LOCATED, SIBLINGS; no sub-agents; todo list proves them // src: vvaharness/pipeline/stages/s4/prompts.py:244
        if (inlined) {
            p.step(1, θ["p.s4_prompts.sweep_pass1_surface_inlined"]);  // work from the inlined source          // src: vvaharness/pipeline/stages/s4/prompts.py:174
        } else {
            p.step(1, θ["p.s4_prompts.sweep_pass1_surface_to_read"]);  // Read every path to its end            // src: vvaharness/pipeline/stages/s4/prompts.py:181
        }
        if (graph) {
            p.step(2, θ["p.s4_prompts.sweep_pass2_reachability_graph"]);                                 // src: vvaharness/pipeline/stages/s4/prompts.py:229
        } else {
            p.step(2, θ["p.s4_prompts.sweep_pass2_reachability_no_graph"]);                              // src: vvaharness/pipeline/stages/s4/prompts.py:235
        }
        p.rule(θ["p.s4_prompts.unreachable_sink_not_finding"]);                                          // src: vvaharness/pipeline/stages/s4/prompts.py:230
        p.step(3, θ["p.s4_prompts.sweep_pass3_colocated_classes"]);    // walk the same location for every other class // src: vvaharness/pipeline/stages/s4/prompts.py:248
        p.step(4, θ["p.s4_prompts.sweep_pass4_siblings"]);             // grep the repo, each site its own finding // src: vvaharness/pipeline/stages/s4/prompts.py:253
        p.threshold(θ["p.s4_prompts.sibling_phrasings_count"]);        // "two or three phrasings"              // src: vvaharness/pipeline/stages/s4/prompts.py:253
        p.must(θ["p.s4_prompts.sweep_always_make_passes"]);            // even when the claim looks narrow      // src: vvaharness/pipeline/stages/s4/prompts.py:258
        return p;
    }

    Prompt closing(int budget, Theta θ) {
        Prompt p = new Prompt();
        if (budget > 0) {
            p.rule(θ["p.s4_prompts.closing_budgeted"]);                // "Spend your lookups, then report the outcome object." // src: vvaharness/pipeline/stages/s4/prompts.py:314
        } else {
            p.rule(θ["p.s4_prompts.closing_breadth"]);                 // "Work your plan, make all four passes, then report the outcome object." // src: vvaharness/pipeline/stages/s4/prompts.py:315
        }
        return p;
    }

    // One unit's facts; filesOnly names its paths because a batch inlines them once.
    Prompt unitBlock(InvestigationUnit unit, String code, boolean filesOnly, boolean graph, Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s4_prompts.unit_header_fields"]);               // UNIT SIZE RISK ACTOR CLAIM SURFACE ASSET // src: vvaharness/pipeline/stages/s4/prompts.py:519
        p.context(List.of(unit.id, unit.size, unit.impact + "/" + unit.likelihood, unit.actor, unit.threat, unit.surface, unit.asset)); // src: vvaharness/pipeline/stages/s4/prompts.py:519
        if (unit.controls != null && θ["p.s4_prompts.already_in_place_block"]) p.context("ALREADY IN PLACE: " + unit.controls); // src: vvaharness/pipeline/stages/s4/prompts.py:508
        if (unit.evidence != null && θ["p.s4_prompts.where_s2_saw_it_block"]) p.context("WHERE S2 SAW IT: " + unit.evidence);   // src: vvaharness/pipeline/stages/s4/prompts.py:510
        if (!unit.sinks.isEmpty()) p.include(sinkLines(unit, θ));                                        // src: vvaharness/pipeline/stages/s4/prompts.py:513
        if (!unit.cwes.isEmpty()) p.include(cweLines(unit, θ));                                          // src: vvaharness/pipeline/stages/s4/prompts.py:517
        if (!unit.entryPoints.isEmpty()) p.include(entryPointLines(unit, θ));                            // src: vvaharness/pipeline/stages/s4/prompts.py:514
        if (!unit.communities.isEmpty()) p.include(communityLines(unit, graph, θ));                      // src: vvaharness/pipeline/stages/s4/prompts.py:516
        if (!unit.relatedCves.isEmpty()) p.include(cveLines(unit, θ));                                   // src: vvaharness/pipeline/stages/s4/prompts.py:515
        if (filesOnly) p.include(fileList(unit)); else p.include(sourceSection(unit, code, θ));          // src: vvaharness/pipeline/stages/s4/prompts.py:525
        return p;
    }

    Prompt sinkLines(InvestigationUnit unit, Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.s4_prompts.known_sinks_block"]) p.context("KNOWN SINKS IN THESE FILES: file:line function snippet cwes"); // src: vvaharness/pipeline/stages/s4/prompts.py:452
        p.context(unit.sinks);
        return p;
    }

    Prompt entryPointLines(InvestigationUnit unit, Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.s4_prompts.entry_points_auth_tags"]);           // [unauth] / [auth] [kind] file::function // src: vvaharness/pipeline/stages/s4/prompts.py:458
        p.context(unit.entryPoints);
        return p;
    }

    Prompt cveLines(InvestigationUnit unit, Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s4_prompts.known_cves_hunt_variants"]);            // "KNOWN CVEs (hunt for variants/siblings)" // src: vvaharness/pipeline/stages/s4/prompts.py:465
        p.context(unit.relatedCves);
        return p;
    }

    Prompt communityLines(InvestigationUnit unit, boolean graph, Theta θ) {
        Prompt p = new Prompt();
        if (graph) p.rule(θ["p.s4_prompts.community_names_verbatim"]); // pass verbatim as `community` to GraphSinksInCommunity / GraphCommunityOf // src: vvaharness/pipeline/stages/s4/prompts.py:472
        p.context(unit.communities);
        return p;
    }

    Prompt cweLines(InvestigationUnit unit, Theta θ) {
        Prompt p = new Prompt();
        p.context(unit.cwes);
        p.rule(θ["p.s4_prompts.scanner_cwes_floor_not_ceiling"]);      // confirmed pattern hits, a floor not the classification // src: vvaharness/pipeline/stages/s4/prompts.py:484
        return p;
    }

    Prompt fileList(InvestigationUnit unit) {
        return new Prompt().context("FILES (" + unit.files.size() + "): " + unit.files);                 // src: vvaharness/pipeline/stages/s4/prompts.py:490
    }

    Prompt sourceSection(InvestigationUnit unit, String code, Theta θ) {
        Prompt p = new Prompt();
        if (code != null) return p.context("SOURCE CODE:\n" + code);                                    // src: vvaharness/pipeline/stages/s4/prompts.py:495
        p.include(fileList(unit));
        p.must(θ["p.s4_prompts.no_source_read_every_path"]);           // Read every path; sink lines are a starting point // src: vvaharness/pipeline/stages/s4/prompts.py:498
        return p;
    }

    // ---------------- batch prompt ----------------

    Prompt buildBatchPrompt(List<InvestigationUnit> units, String code, int nFiles, int callBudget, boolean graph, Theta θ) {
        Prompt p = new Prompt();
        p.include(batchDuty(units, θ));                                                                  // src: vvaharness/pipeline/stages/s4/prompts.py:576
        for (InvestigationUnit u : units) p.include(unitBlock(u, null, true, graph, θ));                 // src: vvaharness/pipeline/stages/s4/prompts.py:574
        p.include(sharedCodeSection(code, nFiles, θ));                                                   // src: vvaharness/pipeline/stages/s4/prompts.py:577
        p.include(sweep(callBudget, code != null, graph, θ));                                            // src: vvaharness/pipeline/stages/s4/prompts.py:578
        p.include(closing(callBudget, θ));                                                               // src: vvaharness/pipeline/stages/s4/prompts.py:578
        return p;
    }

    Prompt batchDuty(List<InvestigationUnit> units, Theta θ) {
        Prompt p = new Prompt();
        p.context("THIS SESSION CARRIES " + units.size() + " UNITS: " + units.map(u -> u.id));          // src: vvaharness/pipeline/stages/s4/prompts.py:540
        p.forbid(θ["p.s4_prompts.batch_not_permission_to_merge"]);                                       // src: vvaharness/pipeline/stages/s4/prompts.py:541
        p.must(θ["p.s4_prompts.batch_own_outcome_per_unit"]);          // own verdict, rationale, findings, echoing its id // src: vvaharness/pipeline/stages/s4/prompts.py:544
        p.rule(θ["p.s4_prompts.batch_omitted_unit_uninvestigated"]);   // worse than a refutation              // src: vvaharness/pipeline/stages/s4/prompts.py:545
        p.rule(θ["p.s4_prompts.batch_shared_file_not_shared_answer"]);                                   // src: vvaharness/pipeline/stages/s4/prompts.py:547
        p.rule(θ["p.s4_prompts.batch_file_finding_to_owning_unit"]);                                     // src: vvaharness/pipeline/stages/s4/prompts.py:548
        p.rule(θ["p.s4_prompts.batch_proportional_not_equal"]);        // one unit may hold eleven findings     // src: vvaharness/pipeline/stages/s4/prompts.py:551
        p.forbid(θ["p.s4_prompts.batch_no_rationing_no_summarising"]);                                   // src: vvaharness/pipeline/stages/s4/prompts.py:554
        return p;
    }

    Prompt sharedCodeSection(String code, int nFiles, Theta θ) {
        Prompt p = new Prompt();
        if (code == null) {
            p.must(θ["p.s4_prompts.batch_no_source_read_paths"]);      // Read the paths listed under each unit // src: vvaharness/pipeline/stages/s4/prompts.py:562
            return p;
        }
        p.context("SOURCE CODE -- all " + nFiles + " file(s) across every unit above, each inlined ONCE:\n" + code); // src: vvaharness/pipeline/stages/s4/prompts.py:565
        p.rule(θ["p.s4_prompts.batch_source_inlined_once"]);           // two units naming one path ask different questions // src: vvaharness/pipeline/stages/s4/prompts.py:565
        return p;
    }
}

// The procedure the S4 prompts ask the model to carry out in one session. The todo/plan and outcome gating
// is enforced in code by TodoListMiddleware + EvidenceGate (backends/harness/deepagents/evidence_gate.pseudo).
@executedBy(MODEL) @role(agent) @stage("S4")
class S4InvestigationProcedure {

    InvestigationOutcome run(InvestigationUnit unit, boolean graph, boolean inlined, int budget, Theta θ) {
        if (θ["step4.planning"]) writeTodos(unit, graph, θ);                                             // src: vvaharness/pipeline/stages/s4/prompts.py:352
        List<Finding> findings = new List();
        if (budget > 0) {
            findings = budgetedLookups(unit, graph, inlined, budget, θ);
        } else {
            findings = fourPasses(unit, graph, inlined, θ);
        }
        return decide(unit, findings, θ);
    }

    void writeTodos(InvestigationUnit unit, boolean graph, Theta θ) {
        // one todo per FILES path (or group), locate implementation, reachability, decide, co-located, siblings, absence
        for (String f : unit.files) todo("examine " + f);                                                // src: vvaharness/pipeline/stages/s4/prompts.py:356
        todo("locate the sink / tainted caller / real default");                                         // src: vvaharness/pipeline/stages/s4/prompts.py:361
        todo(graph ? "GraphContext / GraphImpact reachability" : "Grep callers toward an entry point");  // src: vvaharness/pipeline/stages/s4/prompts.py:367
        todo("decide the claim; address CweGuidance FP CHECKS");                                         // src: vvaharness/pipeline/stages/s4/prompts.py:381
        todo("other weakness classes at the same location");                                            // src: vvaharness/pipeline/stages/s4/prompts.py:383
        todo("sibling instances");                                                                       // src: vvaharness/pipeline/stages/s4/prompts.py:385
        todo("enumerate where a missing control belongs");                                               // src: vvaharness/pipeline/stages/s4/prompts.py:387
    }

    List<Finding> fourPasses(InvestigationUnit unit, boolean graph, boolean inlined, Theta θ) {
        List<Finding> out = new List();
        // 1 SURFACE
        if (!inlined) for (String f : unit.files) readToEnd(f);                                          // src: vvaharness/pipeline/stages/s4/prompts.py:181
        // 2 REACHABILITY
        boolean reachable = graph ? call("GraphContext", unit.symbol).hasCallers() : grepCallers(unit.symbol); // src: vvaharness/pipeline/stages/s4/prompts.py:229
        if (!reachable) return out;           // an unreachable sink is not a finding                     // src: vvaharness/pipeline/stages/s4/prompts.py:230
        if (isMissingControlClaim(unit)) {
            out.addAll(absenceProcedure(unit, θ));
        } else {
            out.addAll(evidenceAtSite(unit));
        }
        // 3 CO-LOCATED CLASSES
        for (String cls : θ["p.s4_prompts.sweep_pass3_colocated_classes"]) out.addAll(checkClassAt(unit, cls)); // src: vvaharness/pipeline/stages/s4/prompts.py:248
        // 4 SIBLINGS: grep two or three phrasings; each hit judged and reported on its own
        for (Finding f : List.copyOf(out)) out.addAll(grepSiblings(f, θ["p.s4_prompts.sibling_phrasings_count"])); // src: vvaharness/pipeline/stages/s4/prompts.py:253
        return out;
    }

    List<Finding> budgetedLookups(InvestigationUnit unit, boolean graph, boolean inlined, int budget, Theta θ) {
        int lookups = budget - 1;             // last call is reserved for the outcome                    // src: vvaharness/pipeline/stages/s4/prompts.py:203
        if (!inlined) { lookups -= 1; batchedRead(unit.files); }                                         // src: vvaharness/pipeline/stages/s4/prompts.py:210
        boolean reachable = graph ? call("GraphContext", unit.symbol).hasCallers() : grepCallers(unit.symbol); // src: vvaharness/pipeline/stages/s4/prompts.py:189
        List<Finding> out = new List();
        if (!reachable) return out;
        if (lookups > 1) out.addAll(probeOrMultiGrep(unit));  // BREADTH IN ONE CALL                     // src: vvaharness/pipeline/stages/s4/prompts.py:214
        out.addAll(everyEvidencedWeakness(unit));                                                        // src: vvaharness/pipeline/stages/s4/prompts.py:218
        return out;
    }

    List<Finding> absenceProcedure(InvestigationUnit unit, Theta θ) {
        List<Site> population = grepEnumerate(unit);   // enumerate first, state its size                // src: vvaharness/pipeline/stages/s4/prompts.py:152
        List<Finding> out = new List();
        for (Site s : population) {
            boolean c1 = s.realAndExternallyReachable();                                                 // src: vvaharness/pipeline/stages/s4/prompts.py:143
            boolean c2 = s.controlBelongs();                                                             // src: vvaharness/pipeline/stages/s4/prompts.py:145
            boolean c3 = !s.controlSuppliedBy(θ["p.s4_prompts.absence_cond3_checked_central"]);         // src: vvaharness/pipeline/stages/s4/prompts.py:148
            if (c1 && c2 && c3) out.add(findingAt(s));                                                   // src: vvaharness/pipeline/stages/s4/prompts.py:142
        }
        return out;          // empty -> REFUTE with the count of sites checked                          // src: vvaharness/pipeline/stages/s4/prompts.py:153
    }

    InvestigationOutcome decide(InvestigationUnit unit, List<Finding> findings, Theta θ) {
        if (!evidenceReachable()) return outcome(unit.id, "inconclusive", findings);                      // src: vvaharness/pipeline/stages/s4/prompts.py:97
        if (unit.controls != null && controlCoversPath(unit.controls)) {
            // refute, or say in rationale why the control fails to cover this path
            if (!explainControlGap()) return outcome(unit.id, "refuted", List.of());                     // src: vvaharness/pipeline/stages/s4/prompts.py:116
        }
        if (findings.isEmpty()) return outcome(unit.id, "refuted", List.of());                            // src: vvaharness/pipeline/stages/s4/prompts.py:94
        return outcome(unit.id, "confirmed", findings);                                                  // src: vvaharness/pipeline/stages/s4/prompts.py:93
    }
}
