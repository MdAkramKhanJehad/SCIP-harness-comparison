// src: vvaharness/remediation_agent/models/fixer.py:23
FixerStatus: "applied" | "already_applied" | "not_applied" | "tool_error"

// src: vvaharness/remediation_agent/models/fixer.py:26-46
FixerResult {
  status: FixerStatus
  files_changed: [String] = []
  summary: String
  error: String = ""
  retryable: Boolean = false

  // src: fixer.py:35-46 — a reply violating any rule fails validation (handoff then treats it as invalid and terminal)
  require !(status == "applied" && !files_changed) => throw "status=applied requires at least one changed file"
  require !(status != "applied" && files_changed) => throw "only status=applied may report changed files"
  require !(retryable && status != "tool_error") => throw "retryable=true is valid only for status=tool_error"
  require !(status == "tool_error" && error is blank) => throw "status=tool_error requires an error description"
}
// files_changed is the fixer's own claim; the harness measures the real change set from disk (plugin_runner/run.sudo _files_touched)
