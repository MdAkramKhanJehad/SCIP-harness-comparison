// file: vvaharness/skills/crypto/SKILL.md
// S4 skill playbook "crypto": weaknesses exploitable mathematically or by protocol negotiation, not generic hygiene.
// No HARD GATE section in this playbook; only a scope statement and a where-to-look list.

@executedBy(MODEL) @role(skill) @stage("S4")
class CryptoSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_crypto.trigger"])) return List.of();                             // src: vvaharness/skills/crypto/SKILL.md:3
        CryptoPrompt.playbook(θ);
        List<Finding> out = new List();
        for (Candidate c : lookFirst(repo, θ)) {
            // generic "uses MD5 somewhere" hygiene is out of scope
            if (θ["p.skill_crypto.exclude_generic_hygiene"] && !c.exploitableMathematicallyOrByNegotiation()) continue; // src: vvaharness/skills/crypto/SKILL.md:26
            out.add(c.toFinding());
        }
        return out;
    }

    List<Candidate> lookFirst(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (θ["p.skill_crypto.look_non_constant_time_compare"]) out.addAll(repo.grep("== / equals / memcmp on secret/HMAC/token")); // src: vvaharness/skills/crypto/SKILL.md:32
        if (θ["p.skill_crypto.look_jwt_alg_kid_trust"]) out.addAll(repo.grep("alg/kid read from token: alg=none, HS-RS confusion, kid traversal")); // src: vvaharness/skills/crypto/SKILL.md:34
        if (θ["p.skill_crypto.look_iv_nonce_reuse"]) out.addAll(repo.grep("constant/predictable/replayable IV or nonce")); // src: vvaharness/skills/crypto/SKILL.md:37
        if (θ["p.skill_crypto.look_non_csprng"]) out.addAll(repo.grep("Math.random/rand()/Random()/random.random for tokens, keys, OTPs")); // src: vvaharness/skills/crypto/SKILL.md:40
        if (θ["p.skill_crypto.look_unenforced_tls_verification"]) out.addAll(repo.grep("empty trust manager, hostname check true, verify result ignored")); // src: vvaharness/skills/crypto/SKILL.md:43
        if (θ["p.skill_crypto.look_hardcoded_keys_and_logged_keys"]) out.addAll(repo.grep("hard-coded keys/salts/passphrases; key bytes logged")); // src: vvaharness/skills/crypto/SKILL.md:45
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class CryptoPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_crypto.review_scope"]);                                                        // src: vvaharness/skills/crypto/SKILL.md:24
        p.rule(θ["p.skill_crypto.exclude_generic_hygiene"]);                                                // sentence duplicated at lines 26 and 28 // src: vvaharness/skills/crypto/SKILL.md:26
        p.rule(θ["p.skill_crypto.look_list_non_exhaustive"]);                                               // src: vvaharness/skills/crypto/SKILL.md:31
        p.checklist(θ["p.skill_crypto.look_non_constant_time_compare"]);                                    // src: vvaharness/skills/crypto/SKILL.md:32
        p.checklist(θ["p.skill_crypto.look_jwt_alg_kid_trust"]);                                            // src: vvaharness/skills/crypto/SKILL.md:34
        p.checklist(θ["p.skill_crypto.look_iv_nonce_reuse"]);                                               // src: vvaharness/skills/crypto/SKILL.md:37
        p.checklist(θ["p.skill_crypto.look_non_csprng"]);                                                   // src: vvaharness/skills/crypto/SKILL.md:40
        p.checklist(θ["p.skill_crypto.look_unenforced_tls_verification"]);                                  // src: vvaharness/skills/crypto/SKILL.md:43
        p.checklist(θ["p.skill_crypto.look_hardcoded_keys_and_logged_keys"]);                               // src: vvaharness/skills/crypto/SKILL.md:45
        return p;
    }
}
