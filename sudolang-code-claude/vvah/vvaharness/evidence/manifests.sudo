# vvaharness/evidence/manifests.py

Finds build and dependency manifests with a depth-bounded walk, keeps only their dependency sections where the format is understood, and applies per-file and aggregate character caps for the Stage 2 prompt.

Source: `vvaharness/evidence/manifests.py` (lines 1-190)
Executor: code
Called from: `vvaharness/evidence/gather.py` gather

// src: vvaharness/evidence/manifests.py:29-42
_MANIFEST_CANDIDATES = ["package.json", "pom.xml", "build.gradle", "build.gradle.kts", "setup.py", "pyproject.toml", "requirements.txt", "go.mod", "Cargo.toml", "Gemfile", "composer.json", "Dockerfile", "docker-compose.yml", "docker-compose.yaml", ".csproj"]   // ".csproj" matched as a suffix glob
_MANIFEST_RAW_CEILING = 500_000
_PACKAGE_JSON_KEYS = ["name", "version", "dependencies", "devDependencies", "peerDependencies", "require", "require-dev", "scripts"]
_PYPROJECT_PROJECT_KEYS = ["name", "version", "dependencies", "optional-dependencies"]

// src: vvaharness/evidence/manifests.py:179-190
fn gather_manifests(root, walk_bounds, manifest_cap, manifest_total_cap):executor=code {
  [max_depth, max_total, max_per_kind] = walk_bounds
  for each (kind, p) in _find_manifests(root, max_depth, max_total, max_per_kind) {
    raw = evidence.read._read_capped(root, p, _MANIFEST_RAW_CEILING)
    if (!raw) continue
    manifests += (repository-relative path, _structural_truncate(kind, raw, manifest_cap))
  }
  return _apply_manifest_total_cap(manifests, manifest_total_cap)
  // preserved: manifest bodies are not redacted (source comment: "S2 is unredacted")
}

// src: vvaharness/evidence/manifests.py:150-169
fn _find_manifests(root, max_depth, max_total, max_per_kind):executor=code {
  walk from root to depth max_depth (_walk_for_manifests); in each directory collect candidates (_dir_manifest_hits)
  keep the first max_per_kind hits per kind
  return evidence._grouping._round_robin_select(hits_by_kind, max_total, keys=kinds in _MANIFEST_CANDIDATES order)
}

// src: vvaharness/evidence/manifests.py:113-124
fn _dir_manifest_hits(root, d):executor=code {
  for each name in _MANIFEST_CANDIDATES: candidates = (sorted d/*name if name starts with ".") else [d/name]
  keep p when p is not a symlink && p is a file && evidence.read._contained(root, p)   // a manifest-named link could point at any in-repository file
}

// src: vvaharness/evidence/manifests.py:127-147
fn _walkable_children(d):executor=code {
  return sorted subdirectories of d that are not symlinks and whose name is not in scope.walk._DEFAULT_EXCLUDE_DIRS, except "target" when no build marker sits in d
  // preserved: only the built-in exclusion directories are honored (case-sensitive name match); configured step1.exclude_dirs and the auto-exclude overlay do not prune this walk
}

// src: vvaharness/evidence/manifests.py:45-95
fn _structural_truncate(kind, raw, cap):executor=code {
  match (kind) {
    case "package.json" | "composer.json" => keep only _PACKAGE_JSON_KEYS of the parsed JSON object, re-serialized sorted and capped
    case "pyproject.toml" => keep [project] keys in _PYPROJECT_PROJECT_KEYS and tool.poetry.dependencies, re-serialized as JSON and capped
    default => _cap_text(raw, cap)
  }
  // a parse failure or nothing to keep falls back to _cap_text(raw, cap)
}

// src: vvaharness/evidence/manifests.py:98-110
fn _apply_manifest_total_cap(manifests, total_cap):executor=code {
  remaining = total_cap
  for each (name, text) in manifests {
    if (remaining <= 0) stop   // later manifests are dropped entirely
    if (length(text) > remaining) text = _cap_text(text, remaining)
    out += (name, text); remaining -= length(text)
  }
  return out
}
