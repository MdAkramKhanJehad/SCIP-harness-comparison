# vvaharness/sdk/plugins.py

What an outside plugin implements and how a scan receives it. A plugin returns one `Contribution` (graph enrichers, graph tools, subagents). A `PluginSet` validates, bounds, orders and merges the contributions, and installs the graph tools that Stages 2, 4 and 6 can be offered.

Source: `vvaharness/sdk/plugins.py` (lines 1-155)
Executor: code
Called from: `vvaharness/sdk/loading.py` load_plugin_set; `vvaharness/orchestrator/scan.py` scan_repo (`install_graph_tools`, `contribution.enrichers` passed to the graph build)

// src: vvaharness/sdk/plugins.py:31-33
MAX_PLUGINS = 16
MAX_PLUGIN_GRAPH_TOOLS = 8
_MAX_NAME_LENGTH = 64

// src: vvaharness/sdk/plugins.py:36-54
PluginInfo {
  name: String
  version: String
  priority: Number = 100
  require name and version are non-empty => throw ValueError("plugin name and version are required")
  require length(name) <= _MAX_NAME_LENGTH => throw ValueError("plugin name exceeds 64 characters")
  ordering_key = (priority, name)
}

// src: vvaharness/sdk/plugins.py:57-75
Contribution {
  enrichers: GraphEnricher[] = []   // external: context_graph_sdk.plugins.GraphEnricher
  graph_tools: { toolName: ToolFactory } = {}
  subagents: SubagentDefinition[] = []
  merge(other) {
    require no graph tool name appears in both => throw ValueError("two plugins register the same graph tool: <names>")
    return enrichers concatenated, graph_tools combined, subagents concatenated
  }
}

// src: vvaharness/sdk/plugins.py:78-89
VvahPlugin {
  // a runtime-checkable Protocol: conformance is the contract, there is no base class
  info: PluginInfo
  fn contribute() => Contribution
}

// src: vvaharness/sdk/plugins.py:92-106
fn _validated(plugins):executor=code {
  require length(plugins) <= MAX_PLUGINS => throw ValueError("at most 16 plugins")
  for each plugin in plugins {
    require plugin conforms to VvahPlugin => throw TypeError("not a VvahPlugin: <type>")
    require plugin.info.name not already seen => throw ValueError("duplicate plugin name: <name>")
  }
  return plugins sorted by info.ordering_key   // one deterministic order
}

// src: vvaharness/sdk/plugins.py:109-144
PluginSet {
  constructor(plugins = []) {
    _plugins = _validated(plugins)
    merged = Contribution()
    for each plugin in _plugins { merged = merged.merge(plugin.contribute()) }   // a raising contribute() propagates
    require length(merged.graph_tools) <= MAX_PLUGIN_GRAPH_TOOLS => throw ValueError("at most 8 plugin graph tools")
    contribution = merged   // enrichers run in this order
  }
  names = info.name of each plugin, in order
  truthy only when it holds at least one plugin
  fn install_graph_tools():executor=code {
    codegraph.tools.clear_plugin_graph_tools()   // this set becomes the only registered one
    codegraph.tools.register_graph_tools(contribution.graph_tools)   // raises on a name equal to a built-in graph tool (codegraph/tools.py:292-297)
    return names of the installed tools
  }
}
