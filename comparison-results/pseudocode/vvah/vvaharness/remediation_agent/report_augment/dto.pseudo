// file: vvaharness/remediation_agent/report_augment/dto.py
// Load the per-finding cases and bucket them by derived state into the three report buckets.

@executedBy(CODE) @role(types) @stage("S10")
record CaseRecord(String bucket, String reason, FindingCase theCase, boolean falsePositive) {
    // theCase defaults null (synthetic skipped record), falsePositive defaults false. Frozen dataclass.
}

@executedBy(CODE) @role(step) @stage("S10")
class Dto {

    String FINDING_CASE_FILENAME = "finding_case.json";                                              // src: vvaharness/remediation_agent/report_augment/dto.py:36
    List<String> TRIAGE_RELPATH = List.of("evidence", "triage.json");                                // src: vvaharness/remediation_agent/report_augment/dto.py:37

    // The three report-facing buckets, narrower than CaseState on purpose.
    String REMEDIATED = "remediated";                                                                // src: vvaharness/remediation_agent/report_augment/dto.py:40
    String DENY = "deny";                                                                            // src: vvaharness/remediation_agent/report_augment/dto.py:41
    String SKIPPED = "skipped";                                                                      // src: vvaharness/remediation_agent/report_augment/dto.py:42

    // Reason for a finding never handed to the remediation agent.
    String NOT_PROCESSED_REASON = "finding not processed for remediation";                           // src: vvaharness/remediation_agent/report_augment/dto.py:45

    // Bucket per derived case state; DECLINED lands as skipped, re-routed to DENY only when policy refused it.
    Map<CaseState, String> stateBucket(Theta θ) {
        return θ["code.remediation_agent.report_augment.dto.state_bucket"];                          // REMEDIATED, VALIDATED -> remediated; FAILED, DECLINED, OPEN, PENDING -> skipped // src: vvaharness/remediation_agent/report_augment/dto.py:48
    }

    List<CaseRecord> loadCases(Path remDir, Theta θ) {
        List<CaseRecord> records = new ArrayList();
        for (Path path : remDir.glob("*/" + FINDING_CASE_FILENAME).sorted()) {                       // one level deep, sorted path order // src: vvaharness/remediation_agent/report_augment/dto.py:68
            FindingCase c = readCase(path);                                                          // src: vvaharness/remediation_agent/report_augment/dto.py:71
            if (c == null) continue;                                                                 // unreadable case skipped // src: vvaharness/remediation_agent/report_augment/dto.py:74
            Tuple br = bucketAndReason(c, loadTriage(path.parent()), θ);                             // src: vvaharness/remediation_agent/report_augment/dto.py:77
            records.add(new CaseRecord(br.bucket, br.reason, c, dispositionOf(c) == Disposition.FALSE_POSITIVE)); // src: vvaharness/remediation_agent/report_augment/dto.py:80
        }
        return records;
    }

    FindingCase readCase(Path path) {
        try {
            return FindingCase.read(path);                                                           // src: vvaharness/remediation_agent/report_augment/dto.py:83
        } catch (OSError | ValueError e) {
            Logging.warning("skipping unreadable case");                                             // src: vvaharness/remediation_agent/report_augment/dto.py:90
            return null;
        }
    }

    // The evidence/triage.json sidecar for one finding; empty map on absence, parse failure or a non-object.
    Map loadTriage(Path findingDir) {
        Path triagePath = findingDir.join(TRIAGE_RELPATH);                                           // src: vvaharness/remediation_agent/report_augment/dto.py:93
        Object data;
        try { data = Json.loads(triagePath.readText("utf-8")); }                                     // src: vvaharness/remediation_agent/report_augment/dto.py:95
        catch (OSError | ValueError e) { return Map.of(); }                                          // src: vvaharness/remediation_agent/report_augment/dto.py:98
        return data instanceof Map ? data : Map.of();                                                // src: vvaharness/remediation_agent/report_augment/dto.py:100
    }

    // Map one case to its (bucket, human reason); a policy denial is called out separately since a human must act.
    Tuple bucketAndReason(FindingCase c, Map triage, Theta θ) {
        Remediation remediation = remediationOf(c);                                                  // src: vvaharness/remediation_agent/report_augment/dto.py:103
        String summary = remediation != null ? remediation.summary.strip() : "";                     // src: vvaharness/remediation_agent/report_augment/dto.py:105
        if (remediation != null && remediation.disposition == Disposition.POLICY_DENIED) {           // src: vvaharness/remediation_agent/report_augment/dto.py:106
            Object reason = firstTruthy(triage.get("policy_reason"), summary, "policy gate denied automated remediation"); // triage reason, then summary, then default // src: vvaharness/remediation_agent/report_augment/dto.py:108
            return Tuple.of(DENY, String.valueOf(reason));                                           // src: vvaharness/remediation_agent/report_augment/dto.py:109
        }
        String bucket = stateBucket(θ).get(c.state);                                                 // src: vvaharness/remediation_agent/report_augment/dto.py:111
        if (bucket.equals(REMEDIATED)) return Tuple.of(REMEDIATED, summary.isEmpty() ? "remediation applied" : summary); // src: vvaharness/remediation_agent/report_augment/dto.py:112
        return Tuple.of(SKIPPED, summary.isEmpty() ? skippedReason(c) : summary);                    // src: vvaharness/remediation_agent/report_augment/dto.py:114
    }

    // Explain a non-success bucket, distinguishing a failed validation from an untried fix.
    String skippedReason(FindingCase c) {
        if (dispositionOf(c) == Disposition.FALSE_POSITIVE) return "finding rejected as a false positive"; // src: vvaharness/remediation_agent/report_augment/dto.py:117
        if (c.state == CaseState.FAILED) return "fix applied but failed validation; needs rework";   // src: vvaharness/remediation_agent/report_augment/dto.py:120
        if (c.state == CaseState.OPEN && !c.attempts.isEmpty()) return "fix applied; validation inconclusive, pending re-validation"; // src: vvaharness/remediation_agent/report_augment/dto.py:122
        return "remediation not applied; needs review";                                              // src: vvaharness/remediation_agent/report_augment/dto.py:125
    }

    // The newest attempt's remediation; the last attempt is what the report reflects.
    Remediation remediationOf(FindingCase c) {
        if (c == null || c.attempts.isEmpty()) return null;                                          // src: vvaharness/remediation_agent/report_augment/dto.py:128
        return c.attempts.last().remediation;                                                        // src: vvaharness/remediation_agent/report_augment/dto.py:132
    }

    Disposition dispositionOf(FindingCase c) {
        Remediation remediation = remediationOf(c);                                                  // src: vvaharness/remediation_agent/report_augment/dto.py:135
        return remediation != null ? remediation.disposition : null;                                 // src: vvaharness/remediation_agent/report_augment/dto.py:138
    }

    // A synthetic record for a finding never processed.
    CaseRecord skippedRecord() {
        return new CaseRecord(SKIPPED, NOT_PROCESSED_REASON, null, false);                           // src: vvaharness/remediation_agent/report_augment/dto.py:141
    }

    Finding findingOf(CaseRecord record) {
        return record.theCase != null ? record.theCase.finding : null;                               // src: vvaharness/remediation_agent/report_augment/dto.py:146
    }

    String summaryOf(CaseRecord record) {
        Remediation remediation = remediationOf(record.theCase);                                     // src: vvaharness/remediation_agent/report_augment/dto.py:151
        return remediation != null ? remediation.summary.strip() : "";                               // src: vvaharness/remediation_agent/report_augment/dto.py:154
    }

    // Files the newest attempt reports editing, de-duplicated in first-seen order; empty entries dropped.
    List<String> filesTouched(CaseRecord record) {
        Remediation remediation = remediationOf(record.theCase);                                     // src: vvaharness/remediation_agent/report_augment/dto.py:157
        if (remediation == null) return List.of();                                                   // src: vvaharness/remediation_agent/report_augment/dto.py:161
        Set<String> seen = new HashSet();
        List<String> unique = new ArrayList();
        for (String f : remediation.filesTouched) {                                                  // src: vvaharness/remediation_agent/report_augment/dto.py:164
            if (!f.isEmpty() && !seen.contains(f)) { seen.add(f); unique.add(f); }                   // src: vvaharness/remediation_agent/report_augment/dto.py:168
        }
        return unique;
    }

    // The SARIF per-result remediation object.
    Map remediationBlock(CaseRecord record, Theta θ) {
        return Map.of("remediationStatus", record.bucket, "remediationReason", record.reason.substring(0, θ["code.remediation_agent.report_augment.dto.reason_max_chars"])); // reason truncated // src: vvaharness/remediation_agent/report_augment/dto.py:171
    }
}
