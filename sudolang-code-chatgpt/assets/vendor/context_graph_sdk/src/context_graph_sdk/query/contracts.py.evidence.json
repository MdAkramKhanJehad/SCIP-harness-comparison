  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Backend-neutral query and killable-worker contracts.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass\nfrom enum import StrEnum\n\nfrom context_graph_sdk.errors import ModelValidationError\nfrom context_graph_sdk.models import FrozenMap, SnapshotLocator\n\nMAX_QUERY_ROWS = 100_000\nMAX_QUERY_BYTES = 16 * 1024 * 1024\nMAX_REQUEST_BYTES = 256 * 1024\n\n\n@dataclass(frozen=True)\nclass QueryLimits:\n    timeout_seconds: float\n    memory_bytes: int\n    row_limit: int\n    byte_limit: int\n\n    def __post_init__(self) -> None:\n        if not 0 < self.timeout_seconds <= 3_600:\n            raise ModelValidationError(\"timeout_seconds must be in (0, 3600]\")\n        if self.memory_bytes <= 0:\n            raise ModelValidationError(\"memory_bytes must be positive\")\n        if not 1 <= self.row_limit <= MAX_QUERY_ROWS:\n            raise ModelValidationError(f\"row_limit must be in [1, {MAX_QUERY_ROWS}]\")\n        if not 1 <= self.byte_limit <= MAX_QUERY_BYTES:\n            raise ModelValidationError(f\"byte_limit must be in [1, {MAX_QUERY_BYTES}]\")\n\n\n@dataclass(frozen=True)\nclass QueryWorkerRequest:\n    request_id: str\n    snapshot: SnapshotLocator\n    cypher: str\n    parameters: FrozenMap\n    limits: QueryLimits\n\n    def __post_init__(self) -> None:\n        if not self.request_id or len(self.request_id) > 128:\n            raise ModelValidationError(\"request_id must contain 1..128 characters\")\n        if not self.cypher:\n            raise ModelValidationError(\"cypher is required\")\n        if self.encoded_size > MAX_REQUEST_BYTES:\n            raise ModelValidationError(\"serialized query-worker request exceeds request bound\")\n\n    @property\n    def encoded_size(self) -> int:\n        payload = {\n            \"requestId\": self.request_id,\n            \"snapshot\": {\n                \"projectId\": self.snapshot.project_id.value,\n                \"snapshotId\": self.snapshot.snapshot_id.value,\n                \"databasePath\": self.snapshot.database_path,\n            },\n            \"cypher\": self.cypher,\n            \"parameters\": self.parameters.to_dict(),\n            \"limits\": {\n                \"timeoutSeconds\": self.limits.timeout_seconds,\n                \"memoryBytes\": self.limits.memory_bytes,\n                \"rowLimit\": self.limits.row_limit,\n                \"byteLimit\": self.limits.byte_limit,\n            },\n        }\n        return len(\n            json.dumps(payload, ensure_ascii=True, separators=(\",\", \":\"), sort_keys=True).encode()\n        )\n\n\n@dataclass(frozen=True)\nclass WorkerPoolLimits:\n    max_workers: int\n    max_request_bytes: int = MAX_REQUEST_BYTES\n    max_response_bytes: int = MAX_QUERY_BYTES\n\n    def __post_init__(self) -> None:\n        if self.max_workers <= 0:\n            raise ModelValidationError(\"max_workers must be positive\")\n        if self.max_request_bytes <= 0 or self.max_response_bytes <= 0:\n            raise ModelValidationError(\"worker IPC byte bounds must be positive\")\n\n\nclass TruncationReason(StrEnum):\n    ROWS = \"rows\"\n    BYTES = \"bytes\"\n\n\n@dataclass(frozen=True)\nclass QueryWorkerResult:\n    request_id: str\n    rows: tuple[FrozenMap, ...]\n    serialized_bytes: int\n    truncated: bool = False\n    truncation_reason: TruncationReason | None = None\n\n    def __post_init__(self) -> None:\n        if not self.request_id:\n            raise ModelValidationError(\"request_id is required\")\n        if self.serialized_bytes < 0:\n            raise ModelValidationError(\"serialized_bytes cannot be negative\")\n        if self.truncated != (self.truncation_reason is not None):\n            raise ModelValidationError(\"truncation reason must match truncated state\")\n\n\n@dataclass(frozen=True)\nclass WorkerHealth:\n    process_id: int\n    rss_bytes: int\n    thread_count: int\n    file_descriptor_count: int\n\n    def __post_init__(self) -> None:\n        if self.process_id <= 0:\n            raise ModelValidationError(\"worker process_id must be positive\")\n        if min(self.rss_bytes, self.thread_count, self.file_descriptor_count) < 0:\n            raise ModelValidationError(\"worker health values cannot be negative\")\n",
