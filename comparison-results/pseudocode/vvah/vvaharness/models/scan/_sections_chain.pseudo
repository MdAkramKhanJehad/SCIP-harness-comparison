// file: vvaharness/models/scan/_sections_chain.py
// Report sections for exploit chains (S8 output), the unreachable-files appendix, the CMDB app profile
// and the threat-model section (ranked threats with per-threat investigation-unit disposition).

@executedBy(CODE) @role(io) @stage("S9")
class SectionsChain {

    List<String> chainLines(FinalReport report, int n, Chain c) {
        String steps = c.steps.map(idx -> "#" + (idx + 1) + " " + ScanRender.mdCell(report.findings.get(idx).finding.title)).join(" -> "); // src: vvaharness/models/scan/_sections_chain.py:38
        String blocked = c.blockedByControls.isEmpty() ? "" : "  **Blocked by:** " + c.blockedByControls.map(ScanRender.mdCell).join(", "); // src: vvaharness/models/scan/_sections_chain.py:42
        // "Requires" and "Blocked by" are opposites and never share a label
        String requires = c.preconditions.isEmpty() ? "" : "  **Requires:** " + c.preconditions.map(ScanRender.mdCell).join(", "); // src: vvaharness/models/scan/_sections_chain.py:48
        String reached = c.entryReachability == null ? "" : "  **Reached via:** " + ScanRender.escapeAngles(ScanRender.mdCell(c.entryReachability)); // src: vvaharness/models/scan/_sections_chain.py:54
        List<String> out = List.of("### Chain " + n + " - [" + c.severity.upper() + "] " + ScanRender.mdCell(c.title), // src: vvaharness/models/scan/_sections_chain.py:61
                                   "**Path:** " + steps + reached + requires + blocked);
        if (!c.linkEvidence.isEmpty()) {
            out.add("**Step links:**");                                                             // src: vvaharness/models/scan/_sections_chain.py:66
            for (LinkEvidence ln : c.linkEvidence) {
                String mech = ln.mechanism != null ? " - " + ScanRender.escapeAngles(ScanRender.mdCell(ln.mechanism)) : "";
                String loc = (ln.file != null && ln.line != 0) ? " (`" + ln.file + ":" + ln.line + "`)" : ""; // src: vvaharness/models/scan/_sections_chain.py:70
                out.add("- " + ln.fromId + " -> " + ln.toId + mech + loc);
            }
        }
        // read straight off severity_decision: lift_withheld / self_raise_capped notes
        List<String> meta = new List();
        if (c.linkCoverage != null) meta.add("Link coverage: " + ScanRender.mdCell(c.linkCoverage)); // src: vvaharness/models/scan/_sections_chain.py:82
        if (DECISION_NOTE.containsKey(c.severityDecision)) meta.add(DECISION_NOTE.get(c.severityDecision)); // src: vvaharness/models/scan/_sections_chain.py:83
        meta.addAll(c.qualityNotes.map(ScanRender.mdCell)); meta.addAll(c.disclosures.map(ScanRender.mdCell)); // src: vvaharness/models/scan/_sections_chain.py:85
        if (!meta.isEmpty()) out.add("_" + meta.join(" . ") + "_");                                 // src: vvaharness/models/scan/_sections_chain.py:88
        out.add(ScanRender.demoteMdHeadings(c.narrative, true));                                    // src: vvaharness/models/scan/_sections_chain.py:91
        return out;
    }

    String unpromotedPairsText(FinalReport report) {
        List pairs = report.unpromotedLinks;
        int shownCap = θ["code.models.scan._sections_chain.unpromoted_shown"];                      // src: vvaharness/models/scan/_sections_chain.py:33
        String shown = pairs.take(shownCap).map(p -> "#" + (p.o + 1) + " -> #" + (p.t + 1)).join(", "); // src: vvaharness/models/scan/_sections_chain.py:99
        int more = pairs.size() - shownCap;                                                         // src: vvaharness/models/scan/_sections_chain.py:100
        return more > 0 ? shown + " (+" + more + " more)" : shown;                                  // src: vvaharness/models/scan/_sections_chain.py:101
    }

    List<String> unpromotedLinkLeadin(FinalReport report) {
        int n = report.unpromotedLinks.size();
        if (n == 0) return List.of();                                                               // src: vvaharness/models/scan/_sections_chain.py:106
        return List.of("_The chain pass marked <n> link(s) as chain potential that no chain below carries: " + unpromotedPairsText(report) + ". Disclosed, not promoted._"); // src: vvaharness/models/scan/_sections_chain.py:108
    }

    List<String> chainRemovalLeadins(FinalReport report) {
        List<String> out = new List();
        if (report.chainsDropped > 0) out.add("_<n> further proposed chain(s) were removed: steps did not resolve to two or more distinct findings._"); // src: vvaharness/models/scan/_sections_chain.py:115
        if (report.chainsDeduped > 0) out.add("_<n> further proposed chain(s) were identical to a chain already shown and were collapsed._"); // src: vvaharness/models/scan/_sections_chain.py:118
        if (report.chainsInvalid > 0) out.add("_<n> further proposed chain(s) were removed: unreadable shape._"); // src: vvaharness/models/scan/_sections_chain.py:121
        return out;
    }

    List<String> terminalDiversityLeadin(FinalReport report) {
        int n = report.chains.size();
        // keyed on terminal LOCATION (file, line_start), so two copies of one sink count once
        int m = report.chains.filter(c -> !c.steps.isEmpty()).map(c -> report.findings.get(c.steps.last()).finding.fileAndLine()).distinctCount(); // src: vvaharness/models/scan/_sections_chain.py:130
        if (n <= m) return List.of();                                                               // src: vvaharness/models/scan/_sections_chain.py:132
        return List.of("_<n> chain(s) below end at <m> distinct final step(s); a count of chains is not a count of distinct sinks._"); // src: vvaharness/models/scan/_sections_chain.py:134
    }

    List<String> summaryReconciliationNote(FinalReport report) {
        int n = report.chainsDropped + report.chainsInvalid;                                        // src: vvaharness/models/scan/_sections_chain.py:139
        if (n == 0) return List.of();
        return List.of("_<n> proposed chain(s) were removed before this report; the summary above may still describe them._"); // src: vvaharness/models/scan/_sections_chain.py:142
    }

    List<String> emptyChainSectionCopy(FinalReport report) {
        List<String> clauses = new List();
        if (report.chainsDropped > 0) clauses.add("<n> removed: steps did not resolve");           // src: vvaharness/models/scan/_sections_chain.py:150
        if (report.chainsDeduped > 0) clauses.add("<n> identical and collapsed");                  // src: vvaharness/models/scan/_sections_chain.py:153
        if (report.chainsInvalid > 0) clauses.add("<n> unreadable and removed");                   // src: vvaharness/models/scan/_sections_chain.py:155
        if (!report.unpromotedLinks.isEmpty()) clauses.add("<n> link(s) marked as chain potential (" + unpromotedPairsText(report) + ") but no surviving chain carries them"); // src: vvaharness/models/scan/_sections_chain.py:157
        if (!clauses.isEmpty()) return List.of("No exploit chains are reported - " + clauses.join(" ")); // src: vvaharness/models/scan/_sections_chain.py:162
        return List.of("No exploit chains were identified - no chain entry combining findings reached this report."); // src: vvaharness/models/scan/_sections_chain.py:163
    }

    List<String> chainPassCaveat(FinalReport report) {
        if (report.findings.isEmpty()) return List.of();  // no findings, no chain pass             // src: vvaharness/models/scan/_sections_chain.py:169
        return List.of("_Only chain entries the chain pass submitted are checked; a path described elsewhere without one has not been checked._"); // src: vvaharness/models/scan/_sections_chain.py:171
    }

    List<String> renderUnreachableAppendix(FinalReport report) {
        int cap = θ["code.models.scan._sections_chain.unreachable_appendix_cap"];                   // src: vvaharness/models/scan/_sections_chain.py:177
        List<String> files = report.unreachableFiles;
        List<String> out = List.of("## Appendix - Files Named by No Investigation Unit (" + files.size() + ")", // src: vvaharness/models/scan/_sections_chain.py:181
                                   "<n> file(s) in scope were named by no investigation unit, so no review pass read them (coverage gap).");
        for (String f : files.take(cap)) out.add("- `" + foldTicks(ScanRender.mdCell(f)) + "`");    // src: vvaharness/models/scan/_sections_chain.py:190
        if (files.size() > cap) out.add("- _... and <n> more (full list in the s3 checkpoint manifest)_"); // src: vvaharness/models/scan/_sections_chain.py:193
        return out;
    }

    List<String> appProfileLines(FinalReport report) {
        AppProfile ap = report.appProfile;
        if (ap == null) return List.of();                                                           // src: vvaharness/models/scan/_sections_chain.py:202
        String sens = List.of(ap.pciScoped ? "PCI-scoped" : null, ap.processesPan ? "processes PAN" : null, ap.pii ? "PII" : null).nonNull().join(", ").orElse("standard"); // src: vvaharness/models/scan/_sections_chain.py:204
        // CMDB-supplied: escaped so a newline or | cannot inject Markdown
        return List.of("### Application profile (CMDB)", "- ID: " + ScanRender.mdCell(ap.applicationId),
                       "- Externally facing: " + (ap.externallyFacing ? "YES" : "NO"),             // src: vvaharness/models/scan/_sections_chain.py:213
                       "- Data sensitivity: " + sens, "- Source: " + ScanRender.mdCell(ap.source));
    }

    List<String> rankedThreatRows(ThreatModel tm, List<String> withoutUnit) {
        String header = "| ID | Threat | Actor | Surface | Asset | Impact | Likelihood | Controls |";  // src: vvaharness/models/scan/_sections_chain.py:221
        if (withoutUnit != null) header += " Investigation unit |";                                 // src: vvaharness/models/scan/_sections_chain.py:224
        Set missing = Set.of(withoutUnit);
        List<String> out = List.of("### Ranked threats", header);
        for (Pair p : zip(tm.threatIds(), tm.threats)) {                                            // src: vvaharness/models/scan/_sections_chain.py:228
            String row = "| " + ScanRender.mdCell(p.t.id) + " | ... | " + ScanRender.mdCell(p.t.controls) + " |";
            if (withoutUnit != null) row += missing.contains(p.tid) ? " **none - never reviewed** |" : " minted |"; // src: vvaharness/models/scan/_sections_chain.py:237
            out.add(row);
        }
        return out;
    }

    List<String> renderThreatModel(FinalReport report) {
        ThreatModel tm = report.threatModel;
        List<String> out = List.of("## Threat Model");                                              // src: vvaharness/models/scan/_sections_chain.py:245
        out.addAll(appProfileLines(report));
        if (tm.systemContext != null) out.addAll(List.of("### System context", ScanRender.demoteMdHeadings(tm.systemContext, true))); // src: vvaharness/models/scan/_sections_chain.py:247
        if (!tm.assets.isEmpty()) out.addAll(assetTable(tm.assets));                                // src: vvaharness/models/scan/_sections_chain.py:251
        if (!tm.trustBoundaries.isEmpty()) out.addAll(boundaryList(tm.trustBoundaries));           // src: vvaharness/models/scan/_sections_chain.py:259
        if (!tm.threats.isEmpty()) out.addAll(rankedThreatRows(tm, report.threatsWithoutUnit));     // src: vvaharness/models/scan/_sections_chain.py:266
        if (!tm.openQuestions.isEmpty()) {
            // labelled as a model estimate, not a computed count
            out.add("### Open questions");                                                          // src: vvaharness/models/scan/_sections_chain.py:270
            for (String q : tm.openQuestions) out.add("- " + ScanRender.mdCell(q));                 // src: vvaharness/models/scan/_sections_chain.py:276
        }
        return out;
    }
}
