// file: vvaharness/orchestrator/case_ids.py
// Mints the stable content-addressed case_id each finding is tracked under (file, line bucket, CWE),
// so a re-scan that reports the same bug a few lines away keeps the same case directory.

@executedBy(CODE) @role(step) @stage("S9")
class CaseIds {

    String CASE_ID_PREFIX = "vvaf1_";                         // versioned id scheme // src: vvaharness/orchestrator/case_ids.py:28
    int DIGEST_CHARS = 32;                                    // 128 bits of sha256 // src: vvaharness/orchestrator/case_ids.py:34

    /** Fold raw to a repo-relative POSIX path in NFC. */
    String relPosix(String repoRoot, String raw) {
        String text = Unicode.nfc(raw.replace("\\", "/")).strip();                                    // src: vvaharness/orchestrator/case_ids.py:39
        String root = Unicode.nfc(repoRoot.replace("\\", "/")).rstrip("/");                            // src: vvaharness/orchestrator/case_ids.py:40
        if (!root.isEmpty() && text.startsWith(root + "/")) text = text.substring(root.length() + 1);  // src: vvaharness/orchestrator/case_ids.py:41
        while (text.startsWith("./")) text = text.substring(2);                                       // src: vvaharness/orchestrator/case_ids.py:43
        return text.lstrip("/");                                                                       // src: vvaharness/orchestrator/case_ids.py:45
    }

    /** Content the id addresses: path, line bucket, CWE (else vuln_class). */
    String material(String repoRoot, Finding f, Theta θ) {
        String path = relPosix(repoRoot, f.file);                                                      // src: vvaharness/orchestrator/case_ids.py:50
        int bucket = f.lineStart / θ["code.orchestrator.case_ids.line_bucket"];                         // src: vvaharness/orchestrator/case_ids.py:51
        String klass = f.cwe != null ? f.cwe : f.vulnClass.value;                                      // CWE wins over vuln_class // src: vvaharness/orchestrator/case_ids.py:52
        return path + "\n" + bucket + "\n" + klass;                                                    // src: vvaharness/orchestrator/case_ids.py:53
    }

    String digest(String material, int salt) {
        String raw = salt == 0 ? material : material + "\n#" + salt;                                   // src: vvaharness/orchestrator/case_ids.py:58
        return CASE_ID_PREFIX + Sha256.hex(raw).substring(0, DIGEST_CHARS);                            // src: vvaharness/orchestrator/case_ids.py:59
    }

    /** Order findings sharing one bucket by content, not list index. */
    Tuple tiebreakKey(Finding f) {
        return Tuple.of(f.lineStart, f.lineEnd, f.title, f.chunkId, f.sourceRef, f.sinkRef);          // src: vvaharness/orchestrator/case_ids.py:64
    }

    Pair<String, Integer> claim(String material, Set<String> taken) {
        int salt = 0;                                                                                  // src: vvaharness/orchestrator/case_ids.py:76
        while (taken.contains(digest(material, salt))) salt += 1;                                      // src: vvaharness/orchestrator/case_ids.py:77
        return Pair.of(digest(material, salt), salt);                                                  // src: vvaharness/orchestrator/case_ids.py:79
    }

    /** Every finding must hold a distinct non-empty id (the id names a directory). */
    void assertUnique(List<Finding> findings) {
        Map<String, Finding> seen = new Map();
        for (Finding f : findings) {
            if (f.caseId == null || f.caseId.isEmpty()) throw new ValueError("no case_id after minting"); // src: vvaharness/orchestrator/case_ids.py:86
            if (seen.containsKey(f.caseId)) throw new ValueError("case_id minted twice");              // src: vvaharness/orchestrator/case_ids.py:90
            seen.put(f.caseId, f);                                                                     // src: vvaharness/orchestrator/case_ids.py:97
        }
    }

    /** mint_case_ids: in place, idempotent (pre-assigned ids are kept so --resume does not renumber). */
    Map<String, Integer> mint(FinalReport report, Theta θ) {
        List<Finding> findings = report.findings.map(r -> r.finding);                                  // src: vvaharness/orchestrator/case_ids.py:102
        Set<String> taken = findings.filter(f -> f.caseId != null).map(f -> f.caseId).toSet();       // src: vvaharness/orchestrator/case_ids.py:103
        Map<String, List<Finding>> pending = new Map();
        for (Finding f : findings) {
            if (f.caseId == null) pending.computeIfAbsent(material(report.repoRoot, f, θ)).add(f);    // src: vvaharness/orchestrator/case_ids.py:107
        }
        int minted = 0; int collisions = 0;
        for (String material : pending.keys()) {
            for (Finding f : pending.get(material).sortedBy(x -> tiebreakKey(x))) {                   // src: vvaharness/orchestrator/case_ids.py:111
                Pair<String, Integer> c = claim(material, taken);                                      // src: vvaharness/orchestrator/case_ids.py:112
                f.caseId = c.first; taken.add(c.first);                                                // src: vvaharness/orchestrator/case_ids.py:113
                minted += 1; if (c.second > 0) collisions += 1;                                        // src: vvaharness/orchestrator/case_ids.py:115
            }
        }
        assertUnique(findings);                                                                        // src: vvaharness/orchestrator/case_ids.py:117
        return Map.of("minted", minted, "collisions", collisions, "preassigned", findings.size() - minted); // src: vvaharness/orchestrator/case_ids.py:118
    }
}
