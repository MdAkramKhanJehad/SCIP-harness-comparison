// file: vvaharness/validation/synthesis/_consensus.py, vvaharness/validation/constants/synthesis.py
// Deterministic host synthesis of the three persona gate reports into one gate status per gate.
// 2+ agreeing votes (unique top) win at HIGH confidence; otherwise the most conservative top status wins, FLAGGED.

@executedBy(CODE) @role(types)
enum GateStatus { FAIL, PARTIAL, PASS, SKIP, INVALID }

// One persona's file and line evidence, carried onto a synthesized gate verdict.
@executedBy(CODE) @role(types) @stage("S11")
record SynthesizedEvidence(String persona, String file, Integer line, String snippet) { }           // src: vvaharness/validation/synthesis/_consensus.py:46

// Host-produced gate verdict for one finding; confidence is the SynthesisConfidence enum (HIGH or FLAGGED), personaVotes maps persona to its vote.
@executedBy(CODE) @role(types) @stage("S11")
record SynthesizedGate(String trackingId, String gateName, GateStatus status, String confidence, String summary, String details, List<SynthesizedEvidence> evidence, Map<String, GateStatus> personaVotes) { } // src: vvaharness/validation/synthesis/_consensus.py:55

@executedBy(CODE) @role(evaluation) @stage("S11")
class SynthesisConsensus {

    GateStatus mostConservativeStatus(Set<GateStatus> statuses, Theta θ) {
        // The first status of the severity ordering that is present; INVALID when none is. This panel's tie-break policy, not vocabulary.
        Set<GateStatus> present = Set.copyOf(statuses);                                             // src: vvaharness/validation/synthesis/_consensus.py:70
        for (GateStatus s : θ["code.validation.synthesis._consensus.status_conservative_rank"]) {   // src: vvaharness/validation/synthesis/_consensus.py:37  (FAIL, PARTIAL, PASS, SKIP, INVALID: most severe first)
            if (present.contains(s)) return s;                                                      // src: vvaharness/validation/synthesis/_consensus.py:72
        }
        return INVALID;                                                                             // src: vvaharness/validation/synthesis/_consensus.py:74
    }

    Map<String, GateStatus> personaVotes(List<Entry> entries, String gateName, String trackingId, Theta θ) {
        // Fold entries to one vote per persona, merging a duplicate to the most conservative. A duplicate gate would be last-write-wins, faking a vote, so it is logged as agent instability.
        Map<String, GateStatus> votes = new Map();                                                  // src: vvaharness/validation/synthesis/_consensus.py:84
        for (Entry e : entries) {                                                                   // src: vvaharness/validation/synthesis/_consensus.py:85
            GateStatus prior = votes.get(e.persona);                                                // src: vvaharness/validation/synthesis/_consensus.py:86
            if (prior != null) Log.warning("duplicate gate vote for persona " + e.persona + " gate " + gateName + " tracking_id " + trackingId + "; merging to most conservative status"); // src: vvaharness/validation/synthesis/_consensus.py:88
            votes.put(e.persona, prior != null ? mostConservativeStatus(Set.of(prior, e.status), θ) : e.status); // src: vvaharness/validation/synthesis/_consensus.py:97
        }
        return votes;                                                                               // src: vvaharness/validation/synthesis/_consensus.py:100
    }

    List<SynthesizedGate> missingRequiredGates(Map<String, List<Entry>> byGate, String trackingId, List<String> requiredGates) {
        // Synthesize every required gate no persona answered as INVALID and FLAGGED.
        // Zero gates means never examined: partial coverage must not read as a clean consensus, so nothing is added.
        if (byGate.isEmpty()) return List.of();                                                     // src: vvaharness/validation/synthesis/_consensus.py:110
        Set<String> answered = byGate.keys().map(n -> Vocab.normaliseGateName(n));                  // src: vvaharness/validation/synthesis/_consensus.py:112
        List<SynthesizedGate> out = new List();
        for (String gateName : requiredGates) {                                                     // src: vvaharness/validation/synthesis/_consensus.py:124
            if (!answered.contains(Vocab.normaliseGateName(gateName))) {                            // src: vvaharness/validation/synthesis/_consensus.py:125
                out.add(new SynthesizedGate(trackingId, gateName, INVALID, "FLAGGED", "", "required gate '" + gateName + "' was not answered by any persona", List.of(), Map.of())); // src: vvaharness/validation/synthesis/_consensus.py:114
            }
        }
        return out;                                                                                 // src: vvaharness/validation/synthesis/_consensus.py:113
    }

    List<SynthesizedGate> synthesizeGatesForFinding(List<PersonaReport> reports, String trackingId, Theta θ) {
        // Conservative consensus: 2+ votes win at HIGH, else the most conservative wins FLAGGED. requiredGates defaults to FIX_VALIDATION_GATES (root_cause, instance_coverage, no_new_vulnerabilities, security_best_practices).
        String rule = θ["code.s11.consensus_rule"];                                                 // src: vvaharness/validation/synthesis/_consensus.py:134
        Map<String, List<Entry>> byGate = new Map();                                                // src: vvaharness/validation/synthesis/_consensus.py:135
        for (PersonaReport r : reports) {                                                           // src: vvaharness/validation/synthesis/_consensus.py:136
            if (!r.trackingId.equals(trackingId)) continue;                                         // src: vvaharness/validation/synthesis/_consensus.py:137  (reports for other findings ignored)
            for (Gate g : r.gates) byGate.getOrPut(g.gateName).add(new Entry(r.persona, g));        // src: vvaharness/validation/synthesis/_consensus.py:140
        }
        List<SynthesizedGate> out = new List();                                                     // src: vvaharness/validation/synthesis/_consensus.py:142
        for (String gateName : sorted(byGate.keys())) {                                             // src: vvaharness/validation/synthesis/_consensus.py:143  (alphabetical gate order)
            List<Entry> entries = byGate.get(gateName);
            Map<String, GateStatus> votes = personaVotes(entries, gateName, trackingId, θ);         // src: vvaharness/validation/synthesis/_consensus.py:144
            List<GateStatus> evaluated = votes.values().filter(s -> s != SKIP);                     // src: vvaharness/validation/synthesis/_consensus.py:146  (skip is not a vote)
            GateStatus chosen;
            String confidence;
            if (evaluated.isEmpty()) {                                                              // src: vvaharness/validation/synthesis/_consensus.py:147
                chosen = SKIP;                                                                      // src: vvaharness/validation/synthesis/_consensus.py:148
                confidence = "FLAGGED";
            } else {
                Counter counter = Counter.of(evaluated);                                            // src: vvaharness/validation/synthesis/_consensus.py:150
                int topFreq = counter.max();                                                        // src: vvaharness/validation/synthesis/_consensus.py:151
                List<GateStatus> top = counter.keysWith(topFreq);                                   // src: vvaharness/validation/synthesis/_consensus.py:152
                if (top.size() == 1 && topFreq >= θ["code.validation.constants.synthesis.min_consensus_votes"]) { // src: vvaharness/validation/synthesis/_consensus.py:153  (MIN_CONSENSUS_VOTES)
                    chosen = top.get(0);                                                            // src: vvaharness/validation/synthesis/_consensus.py:154
                    confidence = "HIGH";
                } else {
                    chosen = mostConservativeStatus(Set.copyOf(top), θ);                            // src: vvaharness/validation/synthesis/_consensus.py:156  (a tie or a lone vote)
                    confidence = "FLAGGED";                                                         // src: vvaharness/validation/synthesis/_consensus.py:157
                }
            }
            List<String> summaries = new List();                                                    // src: vvaharness/validation/synthesis/_consensus.py:159
            List<String> detailsPieces = new List();                                                // src: vvaharness/validation/synthesis/_consensus.py:160
            List<SynthesizedEvidence> evidence = new List();                                        // src: vvaharness/validation/synthesis/_consensus.py:161
            for (Entry e : entries.sortedBy(item -> item.persona)) {                                // src: vvaharness/validation/synthesis/_consensus.py:162
                if (!e.gate.summary.isEmpty()) summaries.add(e.persona + ": " + e.gate.summary);    // src: vvaharness/validation/synthesis/_consensus.py:163
                if (!e.gate.details.isEmpty()) detailsPieces.add(e.persona + ": " + e.gate.details); // src: vvaharness/validation/synthesis/_consensus.py:165
                for (Evidence ev : e.gate.evidence) evidence.add(new SynthesizedEvidence(e.persona, ev.file, ev.line, ev.snippet)); // src: vvaharness/validation/synthesis/_consensus.py:167
            }
            out.add(new SynthesizedGate(trackingId, gateName, chosen, confidence, summaries.join(" | "), detailsPieces.join(" | "), evidence.sortedBy(item -> Pair.of(item.file != null ? item.file : "", item.line != null ? item.line : 0)), votes.sortedByKey())); // src: vvaharness/validation/synthesis/_consensus.py:172
        }
        out.addAll(missingRequiredGates(byGate, trackingId, θ["code.validation.synthesis._consensus.required_gates"])); // src: vvaharness/validation/synthesis/_consensus.py:188
        return out;                                                                                 // src: vvaharness/validation/synthesis/_consensus.py:189
    }
}
