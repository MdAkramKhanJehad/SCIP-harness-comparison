# vvaharness/remediation_agent/report_parser/parse.py

Legacy path: splits a Markdown scan report into per-finding blocks by their `### N. [SEVERITY] title` headers and promotes each to a typed remediation target. Used only when the checkout has no `findings.json`.

Source: `vvaharness/remediation_agent/report_parser/parse.py` (lines 1-77)
Executor: code
Called from: `vvaharness/remediation_agent/discovery.sudo` load_findings

// src: vvaharness/remediation_agent/report_parser/parse.py:24-34
DONE_MARKER = "<!-- remediation-agent:done -->"   // invisible marker on a finding header once remediated, so "done" survives in the report itself
_HEADER_RE = /^###\s+(\d+)\.\s*\[(CRITICAL|HIGH|MEDIUM|LOW|INFO)\]\s*(.+?)\s*(<!--\s*remediation-agent:done\s*-->)?\s*$/i
_FILE_RE = /^\*\*File:\*\*\s*`([^`]+)`/

// src: vvaharness/remediation_agent/report_parser/parse.py:37-43
fn parse_findings(md_text):executor=code {
  return _parse_blocks(md_text) |> map(parsed => RemediationTarget(finding=fields.to_scan_finding(parsed), index=parsed.index, done=parsed.done))
  // the posture-channel drop (select.pq.drop_non_main_channel) is not applied on this path
}

// src: vvaharness/remediation_agent/report_parser/parse.py:46-76
fn _parse_blocks(md_text):executor=code {
  findings = []; current = null; buf = []
  for each line in md_text {
    if (line matches _HEADER_RE) {
      flush: current.body = buf joined and trimmed
      current = Finding(index=group 1, severity=upper case of group 2, title=group 3 trimmed, done = group 4 present)
      append current to findings; buf = [line]
      continue
    }
    if (current != null) {
      append line to buf
      if (current.file == null && trimmed line matches _FILE_RE) current.file = group 1 trimmed   // the first **File:** line wins
    }
  }
  flush
  return findings
  // lines before the first header are ignored
}
