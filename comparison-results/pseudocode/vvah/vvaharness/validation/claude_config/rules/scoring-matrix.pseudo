// file: vvaharness/validation/claude_config/rules/scoring-matrix.md, vvaharness/validation/scoring/_engine.py, vvaharness/validation/constants/scoring.py
// S11 scoring rule file: four weighted gates, status multipliers, thresholds, critical gate, merge readiness, the 8-step
// algorithm the model is told to run, code-level-signals scope, and secret-exposure handling. ScoringEngine is the host twin.

@executedBy(MODEL) @role(rule_set) @stage("S11")
class ScoringMatrix {

    Prompt run(Theta θ) {
        Prompt p = new Prompt();
        p.include(fourCriteria(θ));
        p.include(statusMultipliers(θ));
        p.include(decisionThresholds(θ));
        p.include(mergeReadiness(θ));
        p.include(scoringExecution(θ));
        p.include(inputSchemaAndOutput(θ));
        p.include(sessionMarkersAndJira(θ));
        p.include(codeLevelSignalsOnly(θ));
        p.include(secretExposureHandling(θ));
        return p;
    }

    Prompt fourCriteria(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.scoring_matrix.def_root_cause"]) p.rule("root_cause: the applied diff modifies the vulnerable code path with proper mitigation (FC1)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:22
        p.threshold(θ["p.scoring_matrix.weight_root_cause"]);                                                    // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:22
        if (θ["p.scoring_matrix.def_instance_coverage"]) p.rule("instance_coverage: all affected files in the diff; no remaining vulnerable code paths (FC2)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:23
        p.threshold(θ["p.scoring_matrix.weight_instance_coverage"]);                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:23
        if (θ["p.scoring_matrix.def_no_new_vulnerabilities"]) p.rule("no_new_vulnerabilities: the fix doesn't introduce new security issues (FC3)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:24
        p.threshold(θ["p.scoring_matrix.weight_no_new_vulnerabilities"]);                                        // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:24
        if (θ["p.scoring_matrix.def_security_best_practices"]) p.rule("security_best_practices: framework-recommended patterns (FC4)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:25
        p.threshold(θ["p.scoring_matrix.weight_security_best_practices"]);                                       // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:25
        p.threshold(θ["p.scoring_matrix.weights_sum"]);                                                          // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:27
        if (!θ["p.scoring_matrix.branch_targeting_gate_removed"]) p.context("branch_targeting gate (0.10) removed; remaining four renormalized"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:27  (knob value false = gate absent)
        return p;
    }

    Prompt statusMultipliers(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.scoring_matrix.multiplier_pass"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:33
        p.threshold(θ["p.scoring_matrix.multiplier_partial"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:34
        p.threshold(θ["p.scoring_matrix.multiplier_fail"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:35
        p.threshold(θ["p.scoring_matrix.multiplier_skip"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:36
        if (θ["p.scoring_matrix.synthesized_gates_normally_evaluated"]) p.rule("synthesized gates should normally be pass/partial/fail"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:38
        if (θ["p.scoring_matrix.skip_excluded_from_scoring"]) p.rule("skip = unevaluated: dropped from numerator and denominator (weight-neutral)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:39
        if (θ["p.scoring_matrix.score_renormalized_over_evaluated"]) p.rule("score renormalized over evaluated gates; a skip's weight is redistributed, not a failure"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:41
        return p;
    }

    Prompt decisionThresholds(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.scoring_matrix.fix_status_set"]);                                                          // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:46
        p.threshold(θ["p.scoring_matrix.threshold_fixed"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:48
        p.threshold(θ["p.scoring_matrix.threshold_partially_fixed"]);                                            // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:49
        p.threshold(θ["p.scoring_matrix.threshold_not_fixed"]);                                                  // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:50
        p.threshold(θ["p.scoring_matrix.coverage_floor_table"]);                                                 // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:51
        p.rule(θ["p.scoring_matrix.unverifiable_missing_or_duplicate"]);                                         // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:51
        p.rule(θ["p.scoring_matrix.critical_gate"]);                                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:53
        if (θ["p.scoring_matrix.critical_gate_skip_invalid_unverifiable"]) p.must("critical gate skip/invalid -> UNVERIFIABLE regardless of score (non-waivable)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:54
        p.tiebreak(θ["p.scoring_matrix.critical_gate_partial_fail_cap"]);                                        // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:56
        return p;
    }

    Prompt mergeReadiness(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.scoring_matrix.merge_fixed"]);                                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:63
        p.format(θ["p.scoring_matrix.merge_partially_fixed"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:64
        p.format(θ["p.scoring_matrix.merge_not_fixed"]);                                                         // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:65
        p.format(θ["p.scoring_matrix.merge_unverifiable"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:66
        return p;
    }

    Prompt scoringExecution(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.scoring_matrix.model_computes_verdict_itself"]) p.must("compute the verdict directly from this matrix; no Bash, do the arithmetic yourself"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:70
        p.checklist(θ["p.scoring_matrix.exact_algorithm_order"]);                                                // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:70
        p.step(1, θ["p.scoring_matrix.gate_set_exactly_four_once"]);                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:72
        p.rule(θ["p.scoring_matrix.invalid_gate_set_result"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:72
        p.step(2, θ["p.scoring_matrix.weighted_score_formula"]);                                                 // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
        if (θ["p.scoring_matrix.invalid_status_fail_closed"]) p.rule("invalid status is evaluated, scores 0.0, stays in the denominator"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
        p.threshold(θ["p.scoring_matrix.multiplier_invalid"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
        p.format(θ["p.scoring_matrix.weighted_score_rounding"]);                                                 // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
        p.step(3, θ["p.scoring_matrix.raw_score_formula"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:74
        p.threshold(θ["p.scoring_matrix.raw_score_clamp_max"]);                                                  // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:74
        p.format(θ["p.scoring_matrix.raw_score_rounding"]);                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:74
        p.step(4, θ["p.scoring_matrix.coverage_floor"]);                                                         // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:75
        p.rule(θ["p.scoring_matrix.coverage_floor_result"]);                                                     // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:75
        if (θ["p.scoring_matrix.critical_gate_precedes_scoring"]) p.step(5, "critical gate skip/invalid -> UNVERIFIABLE, 0.0; precedes scoring"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:76
        p.threshold(θ["p.scoring_matrix.critical_gate_cap_threshold"]);                                          // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:76
        p.step(7, θ["p.scoring_matrix.merge_readiness_map"]);                                                    // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:78
        if (θ["p.scoring_matrix.rotation_cap_only_if_applies"]) p.step(8, "apply the secret-exposure rotation cap iff that section applies"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:79
        if (θ["p.scoring_matrix.show_arithmetic_in_justification"]) p.format("show weight x multiplier = weighted_score and the renormalized division in justification"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:81
        return p;
    }

    // The 8-step algorithm the prompt asks the MODEL to run (on routes where the host does not score, or as its own report).
    @executedBy(MODEL)
    ScoreResult scoringAlgorithm(Map<String, String> gates, Map<String, Double> weights, Theta θ) {
        if (gates.size() != θ["p.scoring_matrix.gate_set_exactly_four_once"] || hasDuplicates(gates)) return ScoreResult.of(θ["p.scoring_matrix.invalid_gate_set_result"]); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:72
        double earned = 0.0;
        double active = 0.0;
        for (String g : gates.keys()) {                                                                          // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
            String s = gates.get(g);
            if (s.equals("skip")) continue;                                                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73  (weight-neutral)
            double mult = s.equals("pass") ? θ["p.scoring_matrix.multiplier_pass"] : s.equals("partial") ? θ["p.scoring_matrix.multiplier_partial"] : s.equals("fail") ? θ["p.scoring_matrix.multiplier_fail"] : θ["p.scoring_matrix.multiplier_invalid"]; // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
            earned = earned + round(weights.get(g) * mult, θ["p.scoring_matrix.weighted_score_rounding"]);      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:73
            active = active + weights.get(g);
        }
        double raw = round(min(earned / active, θ["p.scoring_matrix.raw_score_clamp_max"]), θ["p.scoring_matrix.raw_score_rounding"]); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:74
        if (active < θ["p.scoring_matrix.coverage_floor"]) return ScoreResult.of(θ["p.scoring_matrix.coverage_floor_result"]); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:75
        String crit = gates.get(θ["p.scoring_matrix.critical_gate"]);                                           // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:76
        if (crit.equals("skip") || crit.equals("invalid")) return ScoreResult.of("UNVERIFIABLE", 0.0);           // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:76
        String status = raw >= θ["p.scoring_matrix.threshold_fixed"] ? "Fixed" : raw >= θ["p.scoring_matrix.threshold_partially_fixed"] ? "Partially Fixed" : "Not Fixed"; // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:77
        if ((crit.equals("partial") || crit.equals("fail")) && raw >= θ["p.scoring_matrix.critical_gate_cap_threshold"]) status = θ["p.scoring_matrix.critical_gate_partial_fail_cap"]; // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:76
        return ScoreResult.of(status, raw, mergeFor(status, θ["p.scoring_matrix.merge_readiness_map"]));      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:78
    }

    Prompt inputSchemaAndOutput(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.scoring_matrix.gate_object_required_fields"]);                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:85
        p.format(θ["p.scoring_matrix.gate_object_recommended_fields"]);                                          // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:85
        p.choose(θ["p.scoring_matrix.valid_status_values"]);                                                     // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:101
        p.format(θ["p.scoring_matrix.scoring_output_fields"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:105
        return p;
    }

    Prompt sessionMarkersAndJira(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.scoring_matrix.session_marker_format"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:110
        if (θ["p.scoring_matrix.host_posts_results"]) p.context("the host, not the agent, posts results after the session exits"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:112
        // unclear: "the agent transitions the JIRA ticket" contradicts system.md (no JIRA tools; host derives transition).
        p.format(θ["p.scoring_matrix.jira_fixed_target"]);                                                       // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:120
        p.format(θ["p.scoring_matrix.jira_partially_fixed_target"]);                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:121
        p.format(θ["p.scoring_matrix.jira_not_fixed_target"]);                                                   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:122
        p.format(θ["p.scoring_matrix.jira_unverifiable_target"]);                                                // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:123
        if (θ["p.scoring_matrix.transition_failures_nonfatal"]) p.rule("transition failures are non-fatal warnings"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:125
        return p;
    }

    Prompt codeLevelSignalsOnly(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.scoring_matrix.code_level_scope_all_path_a"]) p.context("applies to all Path A findings, regardless of class"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:129
        p.evidence(θ["p.scoring_matrix.code_level_signal_sources"]);                                            // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:131
        if (θ["p.scoring_matrix.operational_controls_do_not_score"]) p.forbid("operational/process controls counting toward gate scoring or appearing in recommendations"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:131
        if (θ["p.scoring_matrix.no_downgrade_manual_cyber_validation"]) p.exemption("manual cyber validation / out-of-band cyber review"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:135
        if (θ["p.scoring_matrix.no_downgrade_document_process"]) p.exemption("document or process verification (governance, change approvals, ADR docs)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:136
        if (θ["p.scoring_matrix.no_downgrade_runtime_monitoring"]) p.exemption("runtime monitoring / alerting / SIEM / IDS rules"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:137
        if (θ["p.scoring_matrix.no_downgrade_waf_network"]) p.exemption("WAF / IPS / network-layer controls outside the codebase"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:138
        if (θ["p.scoring_matrix.no_downgrade_ghas"]) p.exemption("GHAS push-protection or secret-scanning enablement"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:139
        if (θ["p.scoring_matrix.no_downgrade_precommit_hooks"]) p.exemption("pre-commit hooks (gitleaks, detect-secrets, husky)"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:140
        if (θ["p.scoring_matrix.no_downgrade_external_attestations"]) p.exemption("attestations from teams outside the dev used as gating evidence"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:141
        if (θ["p.scoring_matrix.no_downgrade_non_code_control"]) p.exemption("any control that does not modify the code being validated"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:142
        if (θ["p.scoring_matrix.operational_items_mention_only"]) p.rule("may be mentioned in justification but cannot justify partial/fail or appear in recommendations"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:144
        if (θ["p.scoring_matrix.recommendations_code_level_only"]) p.format("recommendations reserved for code-level hardening genuinely missing from the fix"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:146
        return p;
    }

    Prompt secretExposureHandling(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.scoring_matrix.secret_section_classes"]);                                                 // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:150
        if (θ["p.scoring_matrix.secret_section_path_a_only"]) p.rule("Path A only");                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:150
        if (θ["p.scoring_matrix.secret_section_not_for_injection"]) p.exemption("not for injection / auth-bypass even if the title contains credential"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:150
        if (θ["p.scoring_matrix.secret_verification_non_negotiable"]) p.must("Verification (non-negotiable)");   // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:152
        p.evidence(θ["p.scoring_matrix.secret_diff_redacted_evidence"]);                                         // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:154
        if (θ["p.scoring_matrix.secret_never_reconstruct_persist_query"]) p.forbid("reconstruct, persist, or search for a removed plaintext credential"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:154
        if (θ["p.scoring_matrix.secret_inspect_every_location"]) p.step(1, "inspect every reported location: no literal remains"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:156
        p.context(θ["p.scoring_matrix.secret_config_time_sources"]);                                             // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:156
        if (θ["p.scoring_matrix.secret_run_pattern_scan"]) p.step(2, "run PatternScan(secret_exposure) when granted"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:157
        if (θ["p.scoring_matrix.secret_review_every_candidate"]) p.rule("review every candidate relevant to the credential class and affected paths"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:157
        if (θ["p.scoring_matrix.secret_truncated_scan_not_clean"]) p.forbid("describe a truncated scan as clean; state the coverage limit"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:157
        if (θ["p.scoring_matrix.secret_fallback_without_pattern_scan"]) p.rule("without PatternScan use Read and credential-name/delimiter searches; do not claim it ran"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:157
        if (θ["p.scoring_matrix.secret_clean_scan_supporting_only"]) p.rule("a clean scan is supporting evidence, not proof of absence"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:158
        if (θ["p.scoring_matrix.secret_no_downgrade_for_missing_exact_grep"]) p.exemption("do not downgrade because exact-value grep is unavailable"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:158
        if (θ["p.scoring_matrix.secret_abstract_result_only"]) p.format("record only an abstract result in justification"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:159
        if (θ["p.scoring_matrix.history_hygiene_not_gating"]) p.exemption("repository-history hygiene is not a gating concern"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:161
        if (θ["p.scoring_matrix.no_history_rewrite_recommendation"]) p.forbid("inspect, rewrite, or recommend rewriting history"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:161
        p.context(θ["p.scoring_matrix.exposure_neutralized_conditions"]);                                        // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:161
        if (θ["p.scoring_matrix.secret_root_cause_pass_rule"]) p.rule("root_cause passes when the tree is clean and the replacement reads from a config-time source or removes the credential"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:167
        if (θ["p.scoring_matrix.secret_best_practices_pass_rule"]) p.rule("security_best_practices passes with the framework's standard secret-loading idiom"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:168
        if (θ["p.scoring_matrix.secret_other_gates_normal"]) p.rule("instance_coverage and no_new_vulnerabilities evaluate normally"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:169
        if (θ["p.scoring_matrix.missing_rotation_does_not_downgrade_gates"]) p.exemption("missing rotation attestation does not downgrade gates"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:171
        p.context(θ["p.scoring_matrix.attestation_sources"]);                                                    // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:175
        if (θ["p.scoring_matrix.attestation_accept_any_plausible"]) p.rule("accept any plausible developer statement of rotation"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:175
        p.checklist(θ["p.scoring_matrix.attestation_actions"]);                                                  // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:175
        if (θ["p.scoring_matrix.attestation_done_state"]) p.rule("done-state: past-tense rotated/revoked/regenerated/replaced/deactivated"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:177
        p.evidence(θ["p.scoring_matrix.attestation_scheduled_commitment"]);                                      // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:178
        p.threshold(θ["p.scoring_matrix.attestation_one_marker_sufficient"]);                                    // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:178
        p.forbid(θ["p.scoring_matrix.attestation_does_not_count"]);                                              // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:180
        p.threshold(θ["p.scoring_matrix.secret_base_verdict_bands"]);                                            // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:184
        if (θ["p.scoring_matrix.rotation_cap_independent_of_gates"]) p.rule("rotation attestation is a verdict cap independent of which gates passed"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:184
        if (θ["p.scoring_matrix.attestation_present_base_stands"]) p.rule("attestation present -> base verdict stands"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:186
        p.tiebreak(θ["p.scoring_matrix.attestation_missing_cap"]);                                               // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:187
        if (θ["p.scoring_matrix.attestation_missing_exact_recommendation"]) p.must("recommendations MUST include the exact rotation-request item"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:189
        if (θ["p.scoring_matrix.rotation_request_alongside_code_recs"]) p.rule("rotation request sits alongside code-level recommendations"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:189
        if (θ["p.scoring_matrix.attestation_present_standard_recs"]) p.rule("attestation present -> recommendations follow the standard matrix"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:191
        p.threshold(θ["p.scoring_matrix.audit_line_required"]);                                                  // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:195
        if (θ["p.scoring_matrix.audit_line_with_pattern_scan"]) p.format("audit line (PatternScan): locations clean/remaining, candidate count, complete or truncated, rotation attestation"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:197
        if (θ["p.scoring_matrix.audit_line_without_pattern_scan"]) p.format("audit line (no PatternScan): locations inspected with Read/Grep/Glob, PatternScan unavailable, rotation attestation"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:198
        if (θ["p.scoring_matrix.audit_line_no_secret_values"]) p.forbid("candidate snippets, secret-bearing output, or secret values in the audit line"); // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:200
        return p;
    }

    @executedBy(MODEL)
    String rotationCap(String baseVerdict, boolean secretSectionApplies, boolean attestationFound, List<String> recs, Theta θ) {
        if (!secretSectionApplies) return baseVerdict;                                                           // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:79
        if (attestationFound) return baseVerdict;                                                                // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:186
        recs.add("Reply with text confirming that the leaked credential has been rotated ...");                  // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:189
        return baseVerdict.equals("Fixed") ? θ["p.scoring_matrix.attestation_missing_cap"] : baseVerdict;       // src: vvaharness/validation/claude_config/rules/scoring-matrix.md:187
    }
}

// Host twin (scoring/_engine.py): recomputes raw_score, fix_status and merge readiness from synthesized gates.
@executedBy(CODE) @role(evaluation) @stage("S11")
class ScoringEngine {

    ScoreResult score(List<Criterion> criteria, Theta θ) {
        Map<String, Double> weights = θ["code.s11.gate_weights"];                                                // src: vvaharness/validation/constants/scoring.py:35
        Map<String, Double> th = θ["code.s11.score_thresholds"];                                                 // src: vvaharness/validation/constants/scoring.py:50
        if (!criteria.names().equals(weights.keys()) || hasDuplicates(criteria)) return ScoreResult.inconclusive("Missing/Duplicate criterion"); // src: vvaharness/validation/scoring/_engine.py:94
        if (criteria.any(c -> c.confidence == "FLAGGED")) return ScoreResult.inconclusive("Insufficient persona consensus"); // src: vvaharness/validation/scoring/_engine.py:142
        // Host critical set = {no_new_vulnerabilities, root_cause}. unclear: the prompt names only no_new_vulnerabilities.
        for (Criterion c : criteria) {                                                                           // src: vvaharness/validation/scoring/_engine.py:131
            if (CRITICAL.contains(c.name) && (c.status == "skip" || c.status == "invalid")) return ScoreResult.inconclusive("critical gate not evaluated"); // src: vvaharness/validation/scoring/_engine.py:132
        }
        double earned = 0.0;
        double active = 0.0;
        for (Criterion c : criteria) {                                                                           // src: vvaharness/validation/scoring/_engine.py:109
            if (c.status == "skip") continue;                                                                    // src: vvaharness/validation/scoring/_engine.py:110
            active = active + weights.get(c.name);                                                               // src: vvaharness/validation/scoring/_engine.py:112
            earned = earned + weights.get(c.name) * Map.of("pass", 1.0, "partial", 0.5).getOr(c.status, 0.0);   // src: vvaharness/validation/scoring/_engine.py:113
        }
        // unclear: engine only refuses active_weight <= 0; th.coverage_floor is not applied in _engine.py.
        if (active <= 0.0) return ScoreResult.inconclusive("no gates were evaluated");                           // src: vvaharness/validation/scoring/_engine.py:116
        double raw = round(min(earned / active, 1.0), 4);                                                        // src: vvaharness/validation/scoring/_engine.py:119
        String decision = raw >= th.get("fixed") ? "Fixed" : raw >= th.get("partially_fixed") ? "Partially Fixed" : "Not Fixed"; // src: vvaharness/validation/scoring/_engine.py:178
        boolean notClean = criteria.any(c -> CRITICAL.contains(c.name) && (c.status == "partial" || c.status == "fail")); // src: vvaharness/validation/scoring/_engine.py:160
        if (decision.equals("Fixed") && notClean) decision = "Partially Fixed";                                  // src: vvaharness/validation/scoring/_engine.py:164
        return new ScoreResult(raw, decision);                                                                   // src: vvaharness/validation/scoring/_engine.py:197
    }
}
