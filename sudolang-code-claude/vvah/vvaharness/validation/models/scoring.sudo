# vvaharness/validation/models/scoring.py

Value types for the scoring engine, and the conversion from a host ScoringPolicy to the engine's ScoringConfig (which turns the policy thresholds into decision bands).

Source: `vvaharness/validation/models/scoring.py` (lines 1-130)
Executor: code
Called from: `vvaharness/validation/scoring/*`

// src: vvaharness/validation/models/scoring.py:37-67
RawExtra = Mapping of String to any   // auxiliary input passed through to justifiers
RawCriterion { name; status; summary = ""; details = ""; evidence = []; confidence = "" }
VerdictRule { min_score; decision }
ScoreResult { raw_score; decision; justification }

// src: vvaharness/validation/models/scoring.py:70-119
ScoringConfig {
  name; criterion_name_field; weights; status_multiplier; verdicts: [VerdictRule]; justify
  expected_criteria   // the gate set the agent must emit
  critical_criteria = {}   // "Gates that cannot be skipped/garbled (-> INCONCLUSIVE); cap the decision on FAIL regardless."

  fn from_policy(policy, name, criterion_name_field, status_multiplier, justify):executor=code {
    return ScoringConfig { name, criterion_name_field, weights: policy.weights, expected_criteria: policy.required_gates,
      status_multiplier, justify, critical_criteria: policy.critical,
      verdicts: [ VerdictRule(policy.ready_at, FIXED), VerdictRule(policy.conditional_at, PARTIALLY_FIXED), VerdictRule(0.0, NOT_FIXED) ] }
  }
  fn to_policy():executor=code  // inverse: required_gates sorted, ready_at = verdicts[0].min_score (else 0.0), conditional_at = verdicts[1].min_score (else 0.0)
}

// src: vvaharness/validation/models/scoring.py:122-130
ValidationScore { raw_score; decision; justification; gates: [GateAssessment]; has_critical_failure: Boolean }
