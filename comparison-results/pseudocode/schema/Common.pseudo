// file: (shared by every harness)
// Shared types and conventions for all harness pseudocode. Java-style, not compilable.
// Every harness's .pseudo files use ONLY these conventions, so tools can parse all of them the same way.
//
// ---------------------------------------------------------------------------------------------
// CONVENTIONS (enforced by tools/check_pseudocode.py)
//
//  1. Knob reads.  A knob is read as   θ["<knob id>"]   — the id exactly as in <harness>.knobs.json.
//     Nothing else uses the θ symbol. One knob may be read in several places.
//
//  2. File header. First line:   // file: <real source path>[, <real source path> ...]
//     (paths relative to the harness repo root). Then optional   // doc lines.
//
//  3. Structure.   One or more top-level `class` (or `enum` / `interface` / `record`) blocks per file.
//     Methods are declared on their own line as   <ReturnType> name(<params>) {
//     Classes carry two annotations on the line(s) directly above them:
//        @executedBy(CODE | MODEL | MIXED)   who enforces the logic
//        @role(<role>)                       pipeline | stage | step | prompt | rule_set | agent | tool |
//                                            skill | config | backend | io | evaluation | stub | types
//     and optionally   @stage("S4")   and   @src("path:line").
//     Methods may also carry @executedBy / @role / @stage / @src to override the class value.
//
//  4. Braces.      `{` and `}` are used ONLY for blocks. Never inside strings or comments.
//
//  5. Sources.     Put   // src: path:line   at the end of a line that renders a specific real line.
//
//  6. Prompts.     Prompt text the model receives is written as a Prompt built from typed rules
//     (see class Prompt below). A conditional prompt variant is an `if` around the rule.
//     Logic that a prompt asks the MODEL to carry out (procedures, loops over inputs, decisions)
//     is written as ordinary control flow inside a class marked @executedBy(MODEL).
//
//  7. Model calls. llm(...) = one model call, no tools.  agent(...) = a tool-using session.
//     subagent(...) = a session started by another model session (e.g. the Agent tool).
// ---------------------------------------------------------------------------------------------

@executedBy(CODE) @role(types)
class Theta {
    // θ is the configuration point: knob id -> value. Reading θ["x"] returns the knob's current value.
    Object get(String knobId) { }
}

@executedBy(CODE) @role(types)
enum Executor { CODE, MODEL, MIXED }

@executedBy(CODE) @role(types)
enum Effort { LOW, MEDIUM, HIGH, XHIGH, MAX }

@executedBy(CODE) @role(types)
record ModelSpec(String model, String via, String provider, Effort effort, int maxTokens) { }

@executedBy(CODE) @role(types)
record Bounds(int maxTurns, int maxModelCalls, Duration deadline, Money maxCost) { }

@executedBy(CODE) @role(types)
record AgentSpec(ModelSpec model, List<Tool> tools, List<Skill> skills, Prompt system, Prompt user,
                 Bounds bounds, Schema outputSchema, boolean planning) { }

@executedBy(CODE) @role(types)
record Location(String file, int line) { }

/** A prompt as the model receives it: an ordered list of typed rules. Each rule is usually one knob. */
@executedBy(MODEL) @role(types)
class Prompt {
    Prompt persona(Object text) { }        // "You are a ..." / role and stance lines
    Prompt context(Object material) { }    // material handed to the model (files, findings, schema)
    Prompt rule(Object rule) { }           // a single instruction the model should follow
    Prompt must(Object rule) { }           // MUST / ALWAYS / MANDATORY instruction
    Prompt forbid(Object rule) { }         // MUST NOT / NEVER / Do NOT instruction
    Prompt step(int n, Object rule) { }    // numbered procedure step (order matters)
    Prompt choose(Object enumSet) { }      // the model must pick one value from this set
    Prompt checklist(Object items) { }     // items the model must work through
    Prompt threshold(Object value) { }     // a numeric limit or cut-off stated in text
    Prompt exemption(Object rule) { }      // an exception to another rule
    Prompt evidence(Object requirement) { }// evidence the model must cite
    Prompt format(Object constraint) { }   // output shape / fields / length
    Prompt tiebreak(Object rule) { }       // decision rule when signals conflict
    Prompt include(Prompt other) { }       // splice another prompt fragment
}

@executedBy(CODE) @role(types)
class Runtime {
    /** One model call without tools. */
    Response llm(ModelSpec model, Prompt system, Prompt user, Schema outputSchema) { }
    /** A tool-using model session that runs until it stops or hits its bounds. */
    Transcript agent(AgentSpec spec) { }
    /** A session started by another session (e.g. Claude Code's Agent tool). */
    Transcript subagent(Prompt instructions, Object input) { }
    /** Run tasks concurrently, at most n at a time. */
    <T, R> List<R> parallel(int n, List<T> items, Function<T, R> task) { }
    /** Run tasks in sequential waves of the given size. */
    <T, R> List<R> waves(int size, List<T> items, Function<T, R> task) { }
}
