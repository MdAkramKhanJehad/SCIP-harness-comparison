// file: vulnhunt-fix-verify/SKILL.md
// /vulnhunt-fix-verify orchestrator skill: reads a prior /vulnhunt scan, takes the developer's claim that
// some findings are fixed, and produces an independent per-finding verdict by static inspection of REPO.
// Phases 0, 1, 2, 4 (no phase 3). Prompt sections first, then the procedure the model runs.

@executedBy(MODEL) @role(skill)
class VulnhuntFixVerifySkill {

    // Entry point: the procedure the orchestrator model carries out (Workflow, Steps 0-5).
    @executedBy(MODEL)
    String run(KickoffArgs args, Theta θ) {
        Prompt p = prompt(θ);
        Bound b = bindArgs(args, θ);                                                   // src: vulnhunt-fix-verify/SKILL.md:94
        if (b == null) return "argument error";                                        // src: vulnhunt-fix-verify/SKILL.md:62
        Phase0State s0 = step1Phase0(b, θ);                                            // src: vulnhunt-fix-verify/SKILL.md:100
        if (s0 == null) return "phase 0 failed";
        if (θ["p.skill_vulnhunt-fix-verify.all_ids_missing_skip_to_phase4"] && s0.fixedIdsInReport.isEmpty()) { // src: vulnhunt-fix-verify/SKILL.md:126
            String outPath = step4Phase4(b, θ);                                        // src: vulnhunt-fix-verify/SKILL.md:128
            return step5FinalMessage(outPath, θ);
        }
        step2Phase1(b, s0, θ);                                                         // src: vulnhunt-fix-verify/SKILL.md:132
        step3Phase2(b, s0, θ);                                                         // src: vulnhunt-fix-verify/SKILL.md:143
        String outPath = step4Phase4(b, θ);                                            // src: vulnhunt-fix-verify/SKILL.md:177
        return step5FinalMessage(outPath, θ);                                          // src: vulnhunt-fix-verify/SKILL.md:188
    }

    // ---------------- prompt sections, in file order ----------------

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(toolAllowList(θ));
        p.include(kickoffArguments(θ));
        p.include(phaseLoading(θ));
        p.include(operatingPrinciples(θ));
        p.include(stoppingRules(θ));
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_vulnhunt-fix-verify.persona"]);                                   // src: vulnhunt-fix-verify/SKILL.md:15
        if (θ["p.skill_vulnhunt-fix-verify.independent_verdict_stance"]) p.must("independent verdict per finding; the developer's word is not evidence; the code is"); // src: vulnhunt-fix-verify/SKILL.md:18
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt toolAllowList(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.skill_vulnhunt-fix-verify.tool_allowlist"]);                            // src: vulnhunt-fix-verify/SKILL.md:23
        if (θ["p.skill_vulnhunt-fix-verify.no_bash_no_network"]) p.forbid("no Bash or network tool: cannot run shell commands, exploit tests, or git"); // src: vulnhunt-fix-verify/SKILL.md:24
        if (θ["p.skill_vulnhunt-fix-verify.no_directory_creation"]) p.rule("cannot create directories; every output path must already exist"); // src: vulnhunt-fix-verify/SKILL.md:27
        p.rule("cannot clone or fetch external sources; pre-flight pre-cloned cross-repo refs into ADDITIONAL_REPOS"); // src: vulnhunt-fix-verify/SKILL.md:29
        if (θ["p.skill_vulnhunt-fix-verify.outside_trusted_roots_unverifiable_no_halt"]) p.rule("anything outside trusted roots is unverifiable per R2: record in rationale and continue; do not halt"); // src: vulnhunt-fix-verify/SKILL.md:34
        p.rule(θ["p.skill_vulnhunt-fix-verify.subagent_dispatch_optional"]);                   // src: vulnhunt-fix-verify/SKILL.md:36
        p.threshold(θ["p.skill_vulnhunt-fix-verify.inline_threshold_findings"]);               // src: vulnhunt-fix-verify/SKILL.md:39
        if (θ["p.skill_vulnhunt-fix-verify.subagent_envelope"]) p.must("subagents inherit the same envelope: no Bash, no network, read-only over trusted roots"); // src: vulnhunt-fix-verify/SKILL.md:40
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt kickoffArguments(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_vulnhunt-fix-verify.reject_missing_or_relative_args"]) p.must("reject the request if any required argument is missing or non-absolute"); // src: vulnhunt-fix-verify/SKILL.md:46
        p.format(θ["p.skill_vulnhunt-fix-verify.required_kickoff_args"]);                      // src: vulnhunt-fix-verify/SKILL.md:51
        p.rule(θ["p.skill_vulnhunt-fix-verify.comments_arg_optional"]);                        // src: vulnhunt-fix-verify/SKILL.md:55
        p.rule(θ["p.skill_vulnhunt-fix-verify.additional_repos_arg_optional"]);                // src: vulnhunt-fix-verify/SKILL.md:56
        if (θ["p.skill_vulnhunt-fix-verify.trusted_roots_only"]) p.forbid("anything outside REPO plus ADDITIONAL_REPOS is off-limits to reads"); // src: vulnhunt-fix-verify/SKILL.md:59
        if (θ["p.skill_vulnhunt-fix-verify.no_invented_defaults"]) p.must("stop immediately on missing/malformed/non-absolute args; do not invent defaults"); // src: vulnhunt-fix-verify/SKILL.md:63
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt phaseLoading(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_vulnhunt-fix-verify.phase_file_is_procedure"]) p.rule("each phase file is a procedure you execute yourself, not a subagent prompt"); // src: vulnhunt-fix-verify/SKILL.md:68
        if (θ["p.skill_vulnhunt-fix-verify.check_file_signal_after_phase"]) p.must("after each phase, check the file-existence signal before continuing"); // src: vulnhunt-fix-verify/SKILL.md:74
        p.checklist(θ["p.skill_vulnhunt-fix-verify.phase_sequence"]);                          // src: vulnhunt-fix-verify/SKILL.md:79
        if (!θ["p.skill_vulnhunt-fix-verify.no_exploit_replay_phase"]) p.context("phase 3 intentionally absent (reserved for exploit-test replay)"); // src: vulnhunt-fix-verify/SKILL.md:84
        if (θ["p.skill_vulnhunt-fix-verify.missing_phase_file_fatal"]) p.must("missing phase file: stop the entire workflow with the install error; do not improvise"); // src: vulnhunt-fix-verify/SKILL.md:87
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt operatingPrinciples(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_vulnhunt-fix-verify.code_is_source_of_truth"]) p.must("code is the source of truth; COMMENTS are hints"); // src: vulnhunt-fix-verify/SKILL.md:208
        if (θ["p.skill_vulnhunt-fix-verify.no_bridging_assumptions"]) p.forbid("no bridging assumptions: original location and successor not found -> gate skipped, verdict INCONCLUSIVE"); // src: vulnhunt-fix-verify/SKILL.md:210
        if (θ["p.skill_vulnhunt-fix-verify.fail_closed_schema"]) p.must("every JSON written must match verify_disposition.schema.json"); // src: vulnhunt-fix-verify/SKILL.md:213
        if (θ["p.skill_vulnhunt-fix-verify.read_only_target_and_report"]) p.forbid("do not modify REPO or REPORT"); // src: vulnhunt-fix-verify/SKILL.md:216
        p.format(θ["p.skill_vulnhunt-fix-verify.terse_evidence"]);                             // src: vulnhunt-fix-verify/SKILL.md:219
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt stoppingRules(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_vulnhunt-fix-verify.all_ids_missing_skip_to_phase4"]) p.rule("every FIXED ID missing -> skip phases 1 and 2, run phase 4 (all INVALID_INPUT)"); // src: vulnhunt-fix-verify/SKILL.md:224
        if (θ["p.skill_vulnhunt-fix-verify.partial_id_misses_continue"]) p.rule("partial misses are not a stop signal; they flow to phase 4 as stubs"); // src: vulnhunt-fix-verify/SKILL.md:228
        if (θ["p.skill_vulnhunt-fix-verify.missing_phase_file_fatal"]) p.must("any phase file missing -> stop with installation error"); // src: vulnhunt-fix-verify/SKILL.md:230
        if (θ["p.skill_vulnhunt-fix-verify.all_gates_skipped_inconclusive"]) p.must("all four gates skipped -> INCONCLUSIVE, not FIXED; absence of contradiction is not evidence"); // src: vulnhunt-fix-verify/SKILL.md:232
        return p;
    }

    // ---------------- procedure the model executes ----------------

    @executedBy(MODEL)
    Bound bindArgs(KickoffArgs args, Theta θ) {
        for (String name : θ["p.skill_vulnhunt-fix-verify.required_kickoff_args"]) {             // src: vulnhunt-fix-verify/SKILL.md:51
            if (args.get(name) == null || !args.get(name).isAbsolute()) {
                if (θ["p.skill_vulnhunt-fix-verify.reject_missing_or_relative_args"]) return null;  // src: vulnhunt-fix-verify/SKILL.md:46
            }
        }
        if (θ["p.skill_vulnhunt-fix-verify.no_invented_defaults"] && args.malformed()) return null;   // src: vulnhunt-fix-verify/SKILL.md:62
        Bound b = new Bound(args.REPO, args.REPORT, args.FIXED.split(","), args.OUT, args.COMMENTS, args.ADDITIONAL_REPOS); // src: vulnhunt-fix-verify/SKILL.md:96
        b.trustedRoots = List.of(b.REPO).plus(b.ADDITIONAL_REPOS);                             // src: vulnhunt-fix-verify/SKILL.md:58
        return b;
    }

    @executedBy(MODEL)
    PhaseFile loadPhase(String path, Theta θ) {
        PhaseFile f = Tools.read("${CLAUDE_SKILL_DIR}/" + path);                               // src: vulnhunt-fix-verify/SKILL.md:67
        if (f == null && θ["p.skill_vulnhunt-fix-verify.missing_phase_file_fatal"]) {          // src: vulnhunt-fix-verify/SKILL.md:87
            throw new Fatal("Phase file not found at <path>. The skill is not installed correctly. Run install.sh from the vulnhunter repository root."); // src: vulnhunt-fix-verify/SKILL.md:88
        }
        return f;
    }

    @executedBy(MODEL)
    Phase0State step1Phase0(Bound b, Theta θ) {
        loadPhase("phases/phase0_preflight.md", θ);
        if (θ["p.skill_vulnhunt-fix-verify.phase0_inline"]) {                                  // src: vulnhunt-fix-verify/SKILL.md:102
            // Phase 0 globs roots (missing OUT fatal; missing ADDITIONAL_REPOS entry fatal per missing_additional_repo_fatal),
            // reads manifest (manifest_or_readme_fallback), classifies comment claims, writes phase0_state.json.
            if (θ["p.skill_vulnhunt-fix-verify.missing_additional_repo_fatal"]) b.failOnMissingAdditionalRepo = true; // src: vulnhunt-fix-verify/SKILL.md:106
            b.manifestSource = θ["p.skill_vulnhunt-fix-verify.manifest_or_readme_fallback"];   // src: vulnhunt-fix-verify/SKILL.md:109
            b.claimUnderTrustedRootIsLocal = θ["p.skill_vulnhunt-fix-verify.claim_under_trusted_root_is_local"]; // src: vulnhunt-fix-verify/SKILL.md:112
            Phase0State s = Phase0Preflight.run(b, θ);
            if (θ["p.skill_vulnhunt-fix-verify.check_file_signal_after_phase"] && !Tools.glob(b.OUT + "/phase0_state.json").exists()) return null; // src: vulnhunt-fix-verify/SKILL.md:79
            if (θ["p.skill_vulnhunt-fix-verify.partial_id_misses_continue"]) return s;         // src: vulnhunt-fix-verify/SKILL.md:118
            if (!s.fixedIdsMissing.isEmpty()) return null;  // unclear: SKILL never says to stop on partial misses; this branch only exists when the knob is off
            return s;
        }
        return Runtime.subagent(Tools.read("phases/phase0_preflight.md"), b);  // unclear: SKILL only describes inline execution
    }

    @executedBy(MODEL)
    void step2Phase1(Bound b, Phase0State s0, Theta θ) {
        PhaseFile f = loadPhase("phases/phase1_extract.md", θ);                                // src: vulnhunt-fix-verify/SKILL.md:134
        if (θ["p.skill_vulnhunt-fix-verify.extract_may_use_subagent"] == "optional" && s0.reportIsLarge()) { // src: vulnhunt-fix-verify/SKILL.md:136
            Runtime.subagent(f.instructions, b);
        } else {
            Phase1Extract.run(b, s0, θ);
        }
        if (θ["p.skill_vulnhunt-fix-verify.check_file_signal_after_phase"]) Tools.glob(b.OUT + "/extracted_findings.md"); // src: vulnhunt-fix-verify/SKILL.md:80
        if (θ["p.skill_vulnhunt-fix-verify.do_not_read_extracted_in_full"]) b.forbidFullReadOf(b.OUT + "/extracted_findings.md"); // src: vulnhunt-fix-verify/SKILL.md:140
    }

    @executedBy(MODEL)
    void step3Phase2(Bound b, Phase0State s0, Theta θ) {
        PhaseFile f = loadPhase("phases/phase2_verify.md", θ);
        if (θ["p.skill_vulnhunt-fix-verify.read_phase2_once"]) b.cache(f);                    // src: vulnhunt-fix-verify/SKILL.md:145
        List<String> ids = s0.fixedIdsInReport;
        boolean parallel = θ["p.skill_vulnhunt-fix-verify.parallelize_trigger"].holds(ids.size(), b.contextPressure()); // src: vulnhunt-fix-verify/SKILL.md:150
        if (θ["p.skill_vulnhunt-fix-verify.inline_threshold_findings"].covers(ids.size())) parallel = false; // src: vulnhunt-fix-verify/SKILL.md:39
        if (parallel) {
            // one general-purpose subagent per VULN, all Agent calls in a single message
            List<Prompt> prompts = ids.map(id -> subagentPrompt(id, b, θ));                   // src: vulnhunt-fix-verify/SKILL.md:151
            Runtime.parallel(θ["p.skill_vulnhunt-fix-verify.one_subagent_per_vuln_single_message"], prompts, sp -> Runtime.subagent(sp, b)); // src: vulnhunt-fix-verify/SKILL.md:151
            if (θ["p.skill_vulnhunt-fix-verify.synchronization_barrier"]) b.awaitAllAgentResults();  // src: vulnhunt-fix-verify/SKILL.md:160
            if (θ["p.skill_vulnhunt-fix-verify.no_glob_same_turn_as_agents"]) b.endTurn();         // src: vulnhunt-fix-verify/SKILL.md:166
        } else {
            for (String id : ids) {
                Phase2Verify.run(id, b, θ);                                                    // src: vulnhunt-fix-verify/SKILL.md:157
            }
        }
        checkDispositions(ids, b, θ);                                                          // src: vulnhunt-fix-verify/SKILL.md:170
    }

    @executedBy(MODEL) @role(prompt)
    Prompt subagentPrompt(String id, Bound b, Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.skill_vulnhunt-fix-verify.subagent_prompt_contents"]);                 // src: vulnhunt-fix-verify/SKILL.md:153
        p.context(List.of(id, b.REPO, b.OUT, b.OUT + "/extracted_findings.md#" + id));
        p.must("follow phases/phase2_verify.md and write ${OUT}/disposition_" + id + ".json"); // src: vulnhunt-fix-verify/SKILL.md:156
        if (θ["p.skill_vulnhunt-fix-verify.subagent_envelope"]) p.forbid("no Bash, no network, read-only over trusted roots"); // src: vulnhunt-fix-verify/SKILL.md:40
        return p;
    }

    @executedBy(MODEL)
    void checkDispositions(List<String> ids, Bound b, Theta θ) {
        if (!θ["p.skill_vulnhunt-fix-verify.redo_missing_disposition"]) return;                // src: vulnhunt-fix-verify/SKILL.md:171
        for (String id : ids) {
            int tries = 0;
            while (!Tools.glob(b.OUT + "/disposition_" + id + ".json").exists()) {             // src: vulnhunt-fix-verify/SKILL.md:171
                if (tries >= θ["p.skill_vulnhunt-fix-verify.disposition_retry_limit"]) {       // src: vulnhunt-fix-verify/SKILL.md:173
                    Tools.write(b.OUT + "/disposition_" + id + ".json", new FindingDisposition(id, FixVerdict.INCONCLUSIVE, "disposition could not be produced", null, null, List.of(), List.of())  // unclear: SKILL.md says only INCONCLUSIVE with a rationale noting the failure; gates and issue_comment are not stated); // src: vulnhunt-fix-verify/SKILL.md:174
                    break;  // partial result preferable to halting
                }
                Phase2Verify.run(id, b, θ);  // inline or fresh subagent
                tries++;
            }
        }
    }

    @executedBy(MODEL)
    String step4Phase4(Bound b, Theta θ) {
        loadPhase("phases/phase4_emit.md", θ);
        if (θ["p.skill_vulnhunt-fix-verify.phase4_inline"]) {                                  // src: vulnhunt-fix-verify/SKILL.md:179
            return Phase4Emit.run(b, θ);
        }
        return Runtime.subagent(Tools.read("phases/phase4_emit.md"), b);  // unclear: SKILL only describes inline execution
    }

    @executedBy(MODEL)
    String step5FinalMessage(String outPath, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.skill_vulnhunt-fix-verify.final_message_format"]);                      // src: vulnhunt-fix-verify/SKILL.md:190
        if (θ["p.skill_vulnhunt-fix-verify.no_json_in_final_message"]) p.forbid("do not paste the full JSON inline"); // src: vulnhunt-fix-verify/SKILL.md:204
        return "Verify complete. <one line per VULN> Summary: <counts> Output: " + outPath;
    }
}

@executedBy(CODE) @role(types)
record KickoffArgs(String REPO, String REPORT, String FIXED, String OUT, String COMMENTS, String ADDITIONAL_REPOS) { }
