// file: vulnhunt/phases/phase2_class_inj.md
// INJ (injection) class-group reference read by every INJ trace agent in Phase 2.
// Renders the dangerous-sink reference, the injection class hunts, the INJ-specific Gate 2b sanitizer
// verification, the INJ Gate 3 do-not-eliminate list and the INJ severity floor as MODEL control flow.

@executedBy(MODEL) @role(prompt) @stage("phase2")
class Phase2ClassInj {

    // Entry: one INJ trace agent working one partition (spawned by Phase2Hunt with this file + partition data).
    List<Disposition> run(Partition sg, ReconContext recon, Theta θ) {
        Prompt p = prompt(θ);
        List<Disposition> out = new List();
        Map<String, List<Pattern>> greps = grepPatternsPerClass(recon, θ);
        for (Input in : sg.inputs) {                                            // iteration rules come from Phase2Shared
            out.addAll(traceInput(in, recon, greps, θ));
        }
        return out;
    }

    // ---------------- prompt sections, in file order ----------------

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(sinkReferenceSection(θ));
        p.include(vulnerabilityClassesSection(θ));
        p.include(gate2bSection(θ));
        p.include(gate3Section(θ));
        p.include(severityFloorSection(θ));
        return p;
    }

    Prompt sinkReferenceSection(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(List.of(θ["p.phase2_class_inj.sink_sql_query_execution"], θ["p.phase2_class_inj.sink_os_command_execution"],
            θ["p.phase2_class_inj.sink_file_system_operations"], θ["p.phase2_class_inj.sink_outbound_http_url"],
            θ["p.phase2_class_inj.sink_html_template_rendering"], θ["p.phase2_class_inj.sink_navigation_redirect"],
            θ["p.phase2_class_inj.sink_email_construction"], θ["p.phase2_class_inj.sink_code_evaluation"],
            θ["p.phase2_class_inj.sink_file_upload_receivers"], θ["p.phase2_class_inj.sink_query_language_construction"])); // src: vulnhunt/phases/phase2_class_inj.md:3
        p.context(θ["p.phase2_class_inj.sink_network_filesystem_clients"]);                             // src: vulnhunt/phases/phase2_class_inj.md:10
        p.rule(θ["p.phase2_class_inj.cross_class_nav_flag_for_outbound_headers"]);                      // src: vulnhunt/phases/phase2_class_inj.md:16
        p.rule(θ["p.phase2_class_inj.navigation_sink_dual_context"]);                                   // src: vulnhunt/phases/phase2_class_inj.md:25
        p.rule(θ["p.phase2_class_inj.adapt_and_extend_sink_list"]);                                     // src: vulnhunt/phases/phase2_class_inj.md:38
        return p;
    }

    Prompt vulnerabilityClassesSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.phase2_class_inj.grep_patterns_per_class_from_recon_stack"]);                       // src: vulnhunt/phases/phase2_class_inj.md:44
        p.checklist(List.of(θ["p.phase2_class_inj.class_sql_injection"], θ["p.phase2_class_inj.class_command_injection"],
            θ["p.phase2_class_inj.class_path_traversal"], θ["p.phase2_class_inj.class_client_side_config_asset_traversal"],
            θ["p.phase2_class_inj.class_ssrf_url_path_injection"], θ["p.phase2_class_inj.class_api_query_language_injection"],
            θ["p.phase2_class_inj.class_xml_xxe"], θ["p.phase2_class_inj.class_unrestricted_file_upload"], θ["p.phase2_class_inj.class_xss"],
            θ["p.phase2_class_inj.class_email_header_crlf_injection"], θ["p.phase2_class_inj.class_open_redirect"],
            θ["p.phase2_class_inj.class_ldap_injection"], θ["p.phase2_class_inj.class_code_injection_ssti"]));              // src: vulnhunt/phases/phase2_class_inj.md:42
        return p;
    }

    Prompt gate2bSection(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.gate2b_empirical"]) {                                                             // src: vulnhunt/phases/phase2_class_inj.md:116
            p.rule(θ["p.phase2_class_inj.gate2b_inj_procedure_additive"]);                              // src: vulnhunt/phases/phase2_class_inj.md:118
            p.must(θ["p.phase2_class_inj.gate2b_every_sanitizer_must_be_verified"]);                    // src: vulnhunt/phases/phase2_class_inj.md:121
            p.step(1, θ["p.phase2_class_inj.gate2b_option_a_read_sanitizer_source"]);                   // src: vulnhunt/phases/phase2_class_inj.md:124
            p.step(2, θ["p.phase2_class_inj.gate2b_option_b_test_expression"]);                         // src: vulnhunt/phases/phase2_class_inj.md:128
            p.format(θ["p.phase2_class_inj.gate2b_test_as_runnable_one_liner"]);                        // src: vulnhunt/phases/phase2_class_inj.md:132
            p.step(3, θ["p.phase2_class_inj.gate2b_option_c_state_unverifiable"]);                      // src: vulnhunt/phases/phase2_class_inj.md:135
            p.must(θ["p.phase2_class_inj.gate2b_sanitizer_must_match_sink_context"]);                   // src: vulnhunt/phases/phase2_class_inj.md:140
        }
        return p;
    }

    Prompt gate3Section(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.phase2_class_inj.gate3_keep_url_path_injection_internal_gateway"]);               // src: vulnhunt/phases/phase2_class_inj.md:150
        p.forbid(θ["p.phase2_class_inj.gate3_keep_query_param_injection"]);                             // src: vulnhunt/phases/phase2_class_inj.md:152
        p.forbid(θ["p.phase2_class_inj.gate3_keep_scope_mismatched_sanitizer_only_defense"]);           // src: vulnhunt/phases/phase2_class_inj.md:154
        p.forbid(θ["p.phase2_class_inj.gate3_keep_unsanitized_value_crossing_tier"]);                   // src: vulnhunt/phases/phase2_class_inj.md:156
        p.choose(θ["p.phase2_class_inj.tier_crossing_default_disposition"]);                            // src: vulnhunt/phases/phase2_class_inj.md:159
        p.evidence(θ["p.phase2_class_inj.tier_crossing_downgrade_needs_file_line"]);                    // src: vulnhunt/phases/phase2_class_inj.md:160
        return p;
    }

    Prompt severityFloorSection(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.phase2_class_inj.severity_floor_backend_injection"]);                          // src: vulnhunt/phases/phase2_class_inj.md:164
        p.forbid(θ["p.phase2_class_inj.severity_floor_forbidden_downgrade_reasons"]);                   // src: vulnhunt/phases/phase2_class_inj.md:166
        p.rule(θ["p.phase2_class_inj.assume_backend_hostile_to_injected_params"]);                      // src: vulnhunt/phases/phase2_class_inj.md:168
        return p;
    }

    // ---------------- procedure the prompt asks the agent to carry out ----------------

    @executedBy(MODEL)
    Map<String, List<Pattern>> grepPatternsPerClass(ReconContext recon, Theta θ) {
        Map<String, List<Pattern>> m = new Map();
        if (θ["p.phase2_class_inj.grep_patterns_per_class_from_recon_stack"]) {                         // src: vulnhunt/phases/phase2_class_inj.md:44
            for (String cls : INJ_CLASSES) m.put(cls, buildPatterns(cls, recon.languages, recon.frameworks, recon.fileExtensions));
        }
        return m;
    }

    @executedBy(MODEL)
    List<Disposition> traceInput(Input in, ReconContext recon, Map<String, List<Pattern>> greps, Theta θ) {
        List<Disposition> out = new List();
        List<Sink> sinks = Phase2Shared.traceForward(in, null, θ);
        for (Sink s : sinks) {
            SinkKind k = classifySink(s, θ);
            if (s.setsOutboundHeaderFromInput(in) && θ["p.phase2_class_inj.cross_class_nav_flag_for_outbound_headers"]) { // src: vulnhunt/phases/phase2_class_inj.md:16
                if (s.headerIsIdentityAttributionOrSignal()) out.add(new Disposition(TraceDisposition.CROSS_CLASS, in, s, "NAV"));
            }
            if (k == null) { if (s.classGroup != INJ) out.add(new Disposition(TraceDisposition.CROSS_CLASS, in, s)); continue; }
            for (Finding f : huntClasses(in, s, k, θ)) {
                Disposition d = applyGates(f, θ);
                if (d != null) out.add(d);
            }
        }
        if (out.isEmpty()) out.add(new Disposition(TraceDisposition.NO_MATCH, in));
        return out;
    }

    // ---- Dangerous Sink Reference ----
    @executedBy(MODEL)
    SinkKind classifySink(Sink s, Theta θ) {
        if (θ["p.phase2_class_inj.sink_sql_query_execution"] && (s.isRawQuery() || s.isInterpolatingQueryBuilder() || s.isSqlTemplateLiteral())) return SQL;  // src: vulnhunt/phases/phase2_class_inj.md:5
        if (θ["p.phase2_class_inj.sink_os_command_execution"] && (s.spawnsProcess() || s.invokesShell())) return COMMAND;            // src: vulnhunt/phases/phase2_class_inj.md:7
        if (θ["p.phase2_class_inj.sink_file_system_operations"] && s.isFileOp() && s.pathHasUserComponent()) return FILE;           // src: vulnhunt/phases/phase2_class_inj.md:9
        if (s.isNetworkFsClient(θ["p.phase2_class_inj.sink_network_filesystem_clients"]) && s.keyOrPathUserControlled()) return FILE; // src: vulnhunt/phases/phase2_class_inj.md:10
        if (θ["p.phase2_class_inj.sink_outbound_http_url"] && s.isOutboundHttp() && s.urlPathOrQueryFromInput()) return URL;        // src: vulnhunt/phases/phase2_class_inj.md:14
        if (θ["p.phase2_class_inj.check_body_subfields_set_as_headers"] && s.isOutboundHttp() && s.bodySubfieldsSetAsHeaders()) s.flagCrossClass("NAV"); // src: vulnhunt/phases/phase2_class_inj.md:18
        if (θ["p.phase2_class_inj.sink_html_template_rendering"] && (s.isRawHtmlInsertion() || s.isUnescapedTemplateOutput())) return HTML; // src: vulnhunt/phases/phase2_class_inj.md:21
        if (θ["p.phase2_class_inj.sink_navigation_redirect"] && s.isNavigationOrRedirect()) return NAVIGATION;                       // src: vulnhunt/phases/phase2_class_inj.md:23
        if (θ["p.phase2_class_inj.sink_email_construction"] && (s.isHtmlEmailBody() || s.isEmailHeader())) return EMAIL;             // src: vulnhunt/phases/phase2_class_inj.md:29
        if (θ["p.phase2_class_inj.sink_code_evaluation"] && (s.isEval() || s.isTemplateCompileWithUserTemplate())) return CODE_EVAL; // src: vulnhunt/phases/phase2_class_inj.md:30
        if (θ["p.phase2_class_inj.sink_file_upload_receivers"] && s.isMultipartWithUserControlledNameTypeOrPath()) return UPLOAD;   // src: vulnhunt/phases/phase2_class_inj.md:33
        if (θ["p.phase2_class_inj.sink_query_language_construction"].contains(s.queryLanguage())) return QUERY_LANG;                // src: vulnhunt/phases/phase2_class_inj.md:35
        if (θ["p.phase2_class_inj.adapt_and_extend_sink_list"] && s.isOtherDangerousOpFromCodebaseLibraries()) return OTHER;        // src: vulnhunt/phases/phase2_class_inj.md:38
        return null;
    }

    // ---- Vulnerability Classes ----
    @executedBy(MODEL)
    List<Finding> huntClasses(Input in, Sink s, SinkKind k, Theta θ) {
        List<Finding> fs = new List();
        if (k == SQL && θ["p.phase2_class_inj.class_sql_injection"]) {                                  // src: vulnhunt/phases/phase2_class_inj.md:48
            if (!(θ["p.phase2_class_inj.parameterized_statements_safe"] && s.isParameterized())) fs.add(Finding.of(s, "SQL injection")); // src: vulnhunt/phases/phase2_class_inj.md:50
        }
        if (k == COMMAND && θ["p.phase2_class_inj.class_command_injection"]) {                          // src: vulnhunt/phases/phase2_class_inj.md:51
            Finding f = Finding.of(s, "command injection");
            if (θ["p.phase2_class_inj.shell_vs_direct_exec_attention"] && s.invokesShell()) f.priority = HIGH; // src: vulnhunt/phases/phase2_class_inj.md:52
            fs.add(f);
        }
        if (k == FILE && θ["p.phase2_class_inj.class_path_traversal"]) {                                // src: vulnhunt/phases/phase2_class_inj.md:53
            boolean contained = θ["p.phase2_class_inj.path_traversal_dotdot_or_base_dir_check"] && (s.stripsDotDot() || s.resolvesAgainstAllowedBase()); // src: vulnhunt/phases/phase2_class_inj.md:54
            if (!contained) fs.add(Finding.of(s, "path traversal"));
        }
        if (θ["p.phase2_class_inj.class_client_side_config_asset_traversal"] && s.isSpaFetchOfConfigWithInterpolatedInput()) fs.add(Finding.of(s, "client-side config traversal")); // src: vulnhunt/phases/phase2_class_inj.md:56
        if (k == URL && θ["p.phase2_class_inj.class_ssrf_url_path_injection"]) {                        // src: vulnhunt/phases/phase2_class_inj.md:58
            Sanitizer san = s.sanitizer();
            boolean encodesAll = san != null && san.encodesAll(θ["p.phase2_class_inj.url_significant_chars_encoding_check"]); // src: vulnhunt/phases/phase2_class_inj.md:59
            if (θ["p.phase2_class_inj.html_sanitizers_do_not_protect_urls"] && san != null && san.isHtmlSanitizer()) encodesAll = false; // src: vulnhunt/phases/phase2_class_inj.md:60
            if (!encodesAll) fs.add(Finding.of(s, "SSRF / URL path injection"));
        }
        if (k == QUERY_LANG && θ["p.phase2_class_inj.class_api_query_language_injection"].contains(s.queryLanguage())) { // src: vulnhunt/phases/phase2_class_inj.md:62
            boolean defended = s.queryLanguageEscaping();
            if (θ["p.phase2_class_inj.url_encoding_not_query_language_defense"] && s.onlyUrlEncoded()) defended = false; // src: vulnhunt/phases/phase2_class_inj.md:65
            if (!defended) fs.add(Finding.of(s, "query-language injection"));
        }
        if (θ["p.phase2_class_inj.class_xml_xxe"] && s.isXmlParser() && s.parserHasDangerousDefaults()) fs.add(Finding.of(s, "CWE-611")); // src: vulnhunt/phases/phase2_class_inj.md:70
        if (k == UPLOAD) {
            for (String control : θ["p.phase2_class_inj.class_unrestricted_file_upload"]) {            // src: vulnhunt/phases/phase2_class_inj.md:75
                if (!s.uploadHandler().has(control)) fs.add(Finding.of(s, "CWE-434").missing(control));
            }
        }
        if (θ["p.phase2_class_inj.class_xss"]) fs.addAll(huntXss(in, s, k, θ));                         // src: vulnhunt/phases/phase2_class_inj.md:79
        if (k == EMAIL && s.isEmailHeader() && θ["p.phase2_class_inj.class_email_header_crlf_injection"] && !s.stripsCrlf()) fs.add(Finding.of(s, "CWE-93")); // src: vulnhunt/phases/phase2_class_inj.md:92
        if (k == NAVIGATION && θ["p.phase2_class_inj.class_open_redirect"]) fs.addAll(huntOpenRedirect(in, s, θ)); // src: vulnhunt/phases/phase2_class_inj.md:94
        if (θ["p.phase2_class_inj.class_ldap_injection"] && s.isLdapFilterOrDn()) {                     // src: vulnhunt/phases/phase2_class_inj.md:106
            boolean vulnerable = θ["p.phase2_class_inj.ldap_interpolated_vulnerable_parameterized_safe"] ? s.builtByInterpolation() : !s.isParameterized(); // src: vulnhunt/phases/phase2_class_inj.md:109
            if (in.isAuthenticatedIdentity() && !θ["p.phase2_class_inj.ldap_authenticated_identity_values_tainted"]) vulnerable = false; // src: vulnhunt/phases/phase2_class_inj.md:111
            if (vulnerable) fs.add(Finding.of(s, "CWE-90"));
        }
        if (k == CODE_EVAL && θ["p.phase2_class_inj.class_code_injection_ssti"] && (s.isEval() || in.isTemplateStringNotData())) fs.add(Finding.of(s, "CWE-94")); // src: vulnhunt/phases/phase2_class_inj.md:113
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> huntXss(Input in, Sink s, SinkKind k, Theta θ) {
        List<Finding> fs = new List();
        if (k == HTML && θ["p.phase2_class_inj.xss_context_reflected_stored"] && !s.escapes()) fs.add(Finding.of(s, "CWE-79"));  // src: vulnhunt/phases/phase2_class_inj.md:81
        if (k == NAVIGATION && θ["p.phase2_class_inj.xss_context_navigation_sink"]) {                   // src: vulnhunt/phases/phase2_class_inj.md:82
            List<Sink> navSinks = List.of(s);
            for (String api : θ["p.phase2_class_inj.per_file_nav_sink_sweep"]) navSinks.addAll(grep(s.file, api)); // src: vulnhunt/phases/phase2_class_inj.md:83
            for (Sink ns : navSinks) {                                                                  // trace each independently
                Validation v = ns.schemeValidation();
                if (v != null && θ["p.phase2_class_inj.encoding_transforms_not_sanitizers"].contains(v.transform)) v = null; // src: vulnhunt/phases/phase2_class_inj.md:86
                if (θ["p.phase2_class_inj.navigation_sink_dual_context"] && v == null) {                // src: vulnhunt/phases/phase2_class_inj.md:25
                    fs.add(Finding.of(ns, θ["p.phase2_class_inj.nav_sink_without_scheme_allowlist_is_cwe79"])); // src: vulnhunt/phases/phase2_class_inj.md:26
                }
            }
        }
        if (k == EMAIL && s.isHtmlEmailBody() && θ["p.phase2_class_inj.xss_context_email_body"]) fs.add(Finding.of(s, "CWE-79"));    // src: vulnhunt/phases/phase2_class_inj.md:89
        if (θ["p.phase2_class_inj.xss_context_third_party_markup"] && s.isRichTextMarkup()) fs.add(Finding.of(s, "markup injection")); // src: vulnhunt/phases/phase2_class_inj.md:90
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> huntOpenRedirect(Input in, Sink s, Theta θ) {
        List<Finding> fs = new List();
        if (!θ["p.phase2_class_inj.open_redirect_parameter_names"].contains(in.name) && !s.isRedirectTarget()) return fs; // src: vulnhunt/phases/phase2_class_inj.md:95
        boolean safe = s.validatedAgainstDomainPathAllowlist();
        if (θ["p.phase2_class_inj.redirect_allowlist_not_prefix_check"] && s.onlyPrefixChecked()) safe = false;  // src: vulnhunt/phases/phase2_class_inj.md:96
        if (θ["p.phase2_class_inj.protocol_relative_path_trap"] && s.isPathOnly() && !s.rejectsLeadingDoubleSlash()) safe = false; // src: vulnhunt/phases/phase2_class_inj.md:100
        if (safe) return fs;
        String cwe = "CWE-601";
        if (θ["p.phase2_class_inj.cwe601_requires_scheme_rejection_else_cwe79"] && !s.rejectsJavascriptAndDataSchemes()) cwe = "CWE-79"; // src: vulnhunt/phases/phase2_class_inj.md:103
        fs.add(Finding.of(s, cwe));
        return fs;
    }

    // ---- gates: shared gates, INJ Gate 2b on top, INJ Gate 3 do-not-eliminate, INJ severity floor ----
    @executedBy(MODEL)
    Disposition applyGates(Finding f, Theta θ) {
        if (Phase2Shared.gate0(f, θ) == ELIMINATE) return new Disposition(TraceDisposition.DESIGN_INTENT, f);
        if (Phase2Shared.gate1(f, θ) == ELIMINATE) return null;
        if (Phase2Shared.gate2a(f, θ) == ELIMINATE) return null;
        boolean sanitized = Phase2Shared.gate2b(f, θ) == ELIMINATE;
        if (θ["p.phase2_class_inj.gate2b_inj_procedure_additive"]) sanitized = sanitized && injGate2b(f, θ); // src: vulnhunt/phases/phase2_class_inj.md:118
        if (sanitized) return new Disposition(TraceDisposition.SAFE, f);
        if (!injGate3KeepsFinding(f, θ) && Phase2Shared.gate3(f, θ) == ELIMINATE) return null;
        f.severity = Phase2Shared.classifySeverity(f, θ);
        applySeverityFloor(f, θ);
        if (f.crossesTierUnsanitized()) return new Disposition(θ["p.phase2_class_inj.tier_crossing_default_disposition"], f); // src: vulnhunt/phases/phase2_class_inj.md:159
        return new Disposition(TraceDisposition.CANDIDATE, f);
    }

    // ---- Gate 2b: Sanitizer Verification Methodology (INJ-specific). Returns true iff every sanitizer is verified effective. ----
    @executedBy(MODEL)
    boolean injGate2b(Finding f, Theta θ) {
        if (!θ["prompt.gate2b_empirical"]) return true;                                                 // src: vulnhunt/phases/phase2_class_inj.md:116
        if (!θ["p.phase2_class_inj.gate2b_every_sanitizer_must_be_verified"]) return true;              // src: vulnhunt/phases/phase2_class_inj.md:121
        for (Sanitizer san : f.flow.sanitizers()) {
            Set<String> transformed = null;
            if (θ["p.phase2_class_inj.gate2b_option_a_read_sanitizer_source"]) {                        // src: vulnhunt/phases/phase2_class_inj.md:124
                Source src = read(san.sourceIn(List.of("node_modules", "vendor", "stdlib", "project")));
                if (src != null && !(θ["p.phase2_class_inj.gate2b_minified_source_falls_to_option_b"] && src.isMinified())) transformed = src.listTransformedChars(); // src: vulnhunt/phases/phase2_class_inj.md:126
            }
            if (transformed == null && θ["p.phase2_class_inj.gate2b_option_b_test_expression"]) {       // src: vulnhunt/phases/phase2_class_inj.md:128
                List<String> chars = testCharsFor(f.sink.kind, θ);
                if (θ["p.phase2_class_inj.gate2b_test_as_runnable_one_liner"]) transformed = Bash.run(oneLiner(san, chars)).transformedChars(); // src: vulnhunt/phases/phase2_class_inj.md:132
            }
            if (transformed == null) {
                if (θ["p.phase2_class_inj.gate2b_option_c_state_unverifiable"]) f.note("sanitizer " + san + " unverifiable"); // src: vulnhunt/phases/phase2_class_inj.md:135
                if (θ["p.phase2_class_inj.gate2b_unverifiable_sanitizer_ineffective"]) return false;    // src: vulnhunt/phases/phase2_class_inj.md:137  (go to Gate 3 intact)
            }
            if (θ["p.phase2_class_inj.gate2b_sanitizer_must_match_sink_context"] && !transformed.containsAll(testCharsFor(f.sink.kind, θ))) return false; // src: vulnhunt/phases/phase2_class_inj.md:140
        }
        return true;
    }

    @executedBy(MODEL)
    List<String> testCharsFor(SinkKind k, Theta θ) {
        if (k == URL) return θ["p.phase2_class_inj.gate2b_url_sink_test_chars"];                        // src: vulnhunt/phases/phase2_class_inj.md:129
        if (k == SQL) return θ["p.phase2_class_inj.gate2b_sql_sink_test_chars"];                        // src: vulnhunt/phases/phase2_class_inj.md:130
        if (k == COMMAND) return θ["p.phase2_class_inj.gate2b_command_sink_test_chars"];                // src: vulnhunt/phases/phase2_class_inj.md:131
        if (k == HTML) return θ["p.phase2_class_inj.gate2b_html_sink_test_chars"];                      // src: vulnhunt/phases/phase2_class_inj.md:131
        return List.of();                                                                               // unclear: no test set given for other sink kinds
    }

    // ---- Gate 3: Do NOT Eliminate (INJ-specific). true = this finding is a new capability; shared Gate 3 may not eliminate it. ----
    @executedBy(MODEL)
    boolean injGate3KeepsFinding(Finding f, Theta θ) {
        if (θ["p.phase2_class_inj.gate3_keep_url_path_injection_internal_gateway"] && f.isUrlPathInjectionOnInternalGateway()) return true; // src: vulnhunt/phases/phase2_class_inj.md:150
        if (θ["p.phase2_class_inj.gate3_keep_query_param_injection"] && f.isQueryParamInjectionViaSanitizerScopeMismatch()) return true;   // src: vulnhunt/phases/phase2_class_inj.md:152
        if (θ["p.phase2_class_inj.gate3_keep_scope_mismatched_sanitizer_only_defense"] && f.onlyDefenseIsScopeMismatchedSanitizer()) return true; // src: vulnhunt/phases/phase2_class_inj.md:154
        if (θ["p.phase2_class_inj.gate3_keep_unsanitized_value_crossing_tier"] && f.crossesTierUnsanitized()) {                            // src: vulnhunt/phases/phase2_class_inj.md:156
            if (θ["p.phase2_class_inj.tier_crossing_downgrade_needs_file_line"] && f.citesDownstreamValidationFileLine()) return false;     // src: vulnhunt/phases/phase2_class_inj.md:160
            return true;
        }
        return false;
    }

    // ---- Severity Floor (INJ-specific) ----
    @executedBy(MODEL)
    void applySeverityFloor(Finding f, Theta θ) {
        if (f.isConfirmedInjection() && f.reachesBackendWithServiceCredentials()) {
            f.severity = max(f.severity, θ["p.phase2_class_inj.severity_floor_backend_injection"]);    // src: vulnhunt/phases/phase2_class_inj.md:164
            for (String reason : θ["p.phase2_class_inj.severity_floor_forbidden_downgrade_reasons"]) f.ignoreDowngradeReason(reason); // src: vulnhunt/phases/phase2_class_inj.md:166
            if (θ["p.phase2_class_inj.assume_backend_hostile_to_injected_params"]) f.backendBehaviour = HOSTILE; // src: vulnhunt/phases/phase2_class_inj.md:168
        }
    }
}
