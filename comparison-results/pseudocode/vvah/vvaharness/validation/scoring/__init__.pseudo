// file: vvaharness/validation/scoring/__init__.py
// Public host scoring API: parse raw gate dicts, score them with the engine against a policy, and
// return a typed ValidationScore (decision, raw score, gates, critical-failure flag).

@executedBy(CODE) @role(evaluation) @stage("S11")
class ValidationScoring {

    ScoringConfig FIX_CONFIG = ScoringConfigs.fixConfig();                                           // src: vvaharness/validation/scoring/__init__.py:33

    ScoringConfig configFor(ScoringPolicy policy, Theta θ) {
        if (policy == null || policy.equals(ConstantsScoring.FIX_POLICY)) return FIX_CONFIG;         // bundled panel  // src: vvaharness/validation/scoring/__init__.py:43
        return Scoring.fromPolicy(policy, "fix", "gate_name",                                        // caller-supplied policy  // src: vvaharness/validation/scoring/__init__.py:45
                                  θ["code.validation.constants.scoring.status_multiplier"], Justify.buildFixJustification); // src: vvaharness/validation/scoring/__init__.py:49
    }

    boolean hasCriticalFailure(ScoringConfig config, List<RawCriterion> parsed) {
        return parsed.any(c -> config.criticalCriteria.contains(c.name) && List.of("fail", "partial").contains(c.status)); // _CRITICAL_NOT_CLEAN  // src: vvaharness/validation/scoring/__init__.py:56
    }

    GateAssessment toGate(RawCriterion c) {
        return new GateAssessment(c.name, c.status, c.summary, c.details, c.evidence);               // src: vvaharness/validation/scoring/__init__.py:64
    }

    ValidationScore scoreFix(List<Map> gates, ScoringPolicy policy, Theta θ) {
        ScoringConfig config = configFor(policy, θ);                                                 // src: vvaharness/validation/scoring/__init__.py:77
        List<RawCriterion> parsed = gates.map(g -> parseRawCriterion(g, config.criterionNameField)); // from scoring/_engine.py  // src: vvaharness/validation/scoring/__init__.py:78
        ScoreResult result = ScoringEngine.score(parsed, θ);                                         // engine: scoring/_engine.py score(config, parsed)  // src: vvaharness/validation/scoring/__init__.py:79
        return new ValidationScore(result.rawScore, result.decision, result.justification,           // src: vvaharness/validation/scoring/__init__.py:80
                                   parsed.map(c -> toGate(c)), hasCriticalFailure(config, parsed));  // src: vvaharness/validation/scoring/__init__.py:84
    }
}
