// file: vvaharness/sdk/stages.py
// The per-stage map: which DTO each stage produces, its checkpoint envelope, and which plugin seams are open there.

@executedBy(CODE) @role(types)
enum Phase { DISCOVER, ANALYZE, VERIFY, REMEDIATE }
// values: discover, analyze, verify, remediate

@executedBy(CODE) @role(types)
enum Seam { ENRICH_GRAPH, SWAP_GRAPH, BRING_DTO, ADD_TOOLS, ADD_SUBAGENTS }
// values: enrich-graph, swap-graph, bring-dto, add-tools, add-subagents

@executedBy(CODE) @role(types)
record Stage(String id, Phase phase, String name, Class dto, String payload, boolean agentic, boolean injectable, List<Seam> seams, String caveat) {
    // agentic, injectable default false; seams default empty; caveat defaults empty.
}

@executedBy(CODE) @role(config)
class Stages {

    // Ordered as a scan runs them. payload is the exact checkpoint envelope --resume reads.
    List<Stage> STAGES = List.of(
        new Stage("s0", DISCOVER, "Seed", SeedPackage, "SeedPackage", false, false, List.of(ENRICH_GRAPH, SWAP_GRAPH), "the graph is built here, so this is the only place an enricher runs"), // src: vvaharness/sdk/stages.py:62
        new Stage("s1", DISCOVER, "Precompute", ContextPackage, "ContextPackage", false, true, List.of(BRING_DTO), "an injected ContextPackage has no graph (graph_handle excluded), so S2/S4/S6 warn then stand down"), // src: vvaharness/sdk/stages.py:65
        new Stage("s2", ANALYZE, "Threat model", ThreatModel, "ThreatModel", true, true, List.of(BRING_DTO, ADD_TOOLS, ADD_SUBAGENTS), ""), // src: vvaharness/sdk/stages.py:70
        new Stage("s3", ANALYZE, "Decompose", TaskManifest, "TaskManifest", false, true, List.of(BRING_DTO), "deterministic: one InvestigationUnit per threat, zero model calls"), // src: vvaharness/sdk/stages.py:73
        new Stage("s4", ANALYZE, "Deep dive", Finding, "findings list plus outcomes map", true, true, List.of(BRING_DTO, ADD_TOOLS, ADD_SUBAGENTS), "seed this to run S5 onward on findings you already have"), // src: vvaharness/sdk/stages.py:76
        new Stage("s5", VERIFY, "Prefilter", Finding, "findings list plus pre_dropped list", false, true, List.of(BRING_DTO), ""), // src: vvaharness/sdk/stages.py:80
        new Stage("s6", VERIFY, "Verify", Finding, "verified list plus dropped list", true, false, List.of(ADD_TOOLS, ADD_SUBAGENTS), ""), // src: vvaharness/sdk/stages.py:83
        new Stage("s7", VERIFY, "Dedupe", Finding, "positional 6-tuple (pre_dropped, verified, dropped, canonical, dup_dropped, s5_out_count)", false, false, List.of(), "a 6-tuple, not a dict; the only stage whose envelope is positional"), // src: vvaharness/sdk/stages.py:86
        new Stage("s8", VERIFY, "Report", FinalReport, "FinalReport", false, false, List.of(), ""),  // src: vvaharness/sdk/stages.py:89
        new Stage("s9", VERIFY, "SARIF", null, "str (path to the written sarif)", false, false, List.of(), ""), // src: vvaharness/sdk/stages.py:90
        new Stage("s10", REMEDIATE, "Remediate", null, "not checkpointed by scan_repo", true, false, List.of(ADD_TOOLS, ADD_SUBAGENTS), "reachable as sdk.remediate"), // src: vvaharness/sdk/stages.py:91
        new Stage("s11", REMEDIATE, "Validate", null, "not checkpointed by scan_repo", true, false, List.of(), "reachable as sdk.validate")); // src: vvaharness/sdk/stages.py:94

    Map<String, Stage> BY_ID = STAGES.toMap(s -> s.id, s -> s);                                      // src: vvaharness/sdk/stages.py:104

    // Stage ids whose checkpoint scan_repo writes: a seeded one makes --resume skip the stage. Excludes payloads starting with "not checkpointed" (s10, s11).
    List<String> CHECKPOINTED = STAGES.filter(s -> !s.payload.startsWith("not checkpointed")).map(s -> s.id); // src: vvaharness/sdk/stages.py:107

    Stage stage(String stageId) {
        if (!BY_ID.containsKey(stageId)) throw new KeyError("no such stage; known: sorted ids");     // src: vvaharness/sdk/stages.py:51
        return BY_ID.get(stageId);                                                                   // src: vvaharness/sdk/stages.py:62
    }

    List<Stage> stagesIn(Object phase) {
        Phase wanted = Enum.parse(Phase, phase);                                                              // accepts enum or string; invalid raises ValueError // src: vvaharness/sdk/stages.py:119
        return STAGES.filter(s -> s.phase == wanted);                                                // run order // src: vvaharness/sdk/stages.py:122
    }

    List<Stage> stagesWith(Object seam) {
        Seam wanted = Enum.parse(Seam, seam);                                                                 // src: vvaharness/sdk/stages.py:125
        return STAGES.filter(s -> s.seams.contains(wanted));                                         // src: vvaharness/sdk/stages.py:128
    }

    List<Stage> injectableStages() {
        return STAGES.filter(s -> s.injectable);                                                     // s1 to s5 // src: vvaharness/sdk/stages.py:131
    }
}
