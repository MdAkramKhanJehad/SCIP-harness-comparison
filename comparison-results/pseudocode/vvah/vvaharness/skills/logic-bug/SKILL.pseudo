// file: vvaharness/skills/logic-bug/SKILL.md
// S4 skill playbook "logic-bug": behavioural / state-machine defects with no grep signature.
// Hard gate = trust-boundary citation (entry file:line + decision file:line); reason with seed questions.

@executedBy(MODEL) @role(skill) @stage("S4")
class LogicBugSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_logic-bug.trigger"])) return List.of();                          // src: vvaharness/skills/logic-bug/SKILL.md:3
        LogicBugPrompt.playbook(θ);
        List<Finding> out = new List();
        for (Candidate c : reason(repo, θ)) {
            if (θ["p.skill_logic-bug.gate_trust_boundary_citation"] && (c.entryLine == null || c.decisionLine == null)) { // src: vvaharness/skills/logic-bug/SKILL.md:28
                if (θ["p.skill_logic-bug.no_citation_no_finding"]) continue;                               // src: vvaharness/skills/logic-bug/SKILL.md:32
            }
            if (θ["p.skill_logic-bug.drop_internal_both_sides"].contains(c.internalKind)) continue;         // DROP // src: vvaharness/skills/logic-bug/SKILL.md:30
            out.add(c.toFinding());
        }
        return out;
    }

    /** Reason about behaviour, don't pattern-match: ask each seed question of the code. */
    List<Candidate> reason(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (!θ["p.skill_logic-bug.reason_dont_pattern_match"]) return out;                                 // src: vvaharness/skills/logic-bug/SKILL.md:34
        if (θ["p.skill_logic-bug.seed_check_then_act"]) out.addAll(repo.ask("can a second request/thread/fs actor change what was checked before the mutation?")); // src: vvaharness/skills/logic-bug/SKILL.md:35
        if (θ["p.skill_logic-bug.seed_auth_session_state"]) out.addAll(repo.ask("login/step-up on empty, duplicated, out-of-order or concurrent messages?")); // src: vvaharness/skills/logic-bug/SKILL.md:38
        if (θ["p.skill_logic-bug.seed_numeric_identity_counters"]) out.addAll(repo.ask("overflow, zero, negative after cast, truncated-ID collision?")); // src: vvaharness/skills/logic-bug/SKILL.md:41
        if (θ["p.skill_logic-bug.seed_protocol_state"]) out.addAll(repo.ask("does a malformed message leave the parser mid-state for the next request?")); // src: vvaharness/skills/logic-bug/SKILL.md:44
        if (θ["p.skill_logic-bug.seed_cache_key_dimensions"]) out.addAll(repo.ask("cache key missing tenant/user/role; cached authorisation outliving revocation?")); // src: vvaharness/skills/logic-bug/SKILL.md:47
        if (θ["p.skill_logic-bug.seed_sentinel_return_values"]) out.addAll(repo.ask("-1/null/NaN sentinel used as offset or treated as success?")); // src: vvaharness/skills/logic-bug/SKILL.md:50
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class LogicBugPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_logic-bug.review_scope"]);                                                     // src: vvaharness/skills/logic-bug/SKILL.md:24
        p.evidence(θ["p.skill_logic-bug.gate_trust_boundary_citation"]);                                    // src: vvaharness/skills/logic-bug/SKILL.md:28
        p.forbid(θ["p.skill_logic-bug.drop_internal_both_sides"]);                                          // src: vvaharness/skills/logic-bug/SKILL.md:30
        p.forbid(θ["p.skill_logic-bug.no_citation_no_finding"]);                                            // src: vvaharness/skills/logic-bug/SKILL.md:32
        p.rule(θ["p.skill_logic-bug.reason_dont_pattern_match"]);                                          // src: vvaharness/skills/logic-bug/SKILL.md:34
        p.checklist(θ["p.skill_logic-bug.seed_check_then_act"]);                                            // src: vvaharness/skills/logic-bug/SKILL.md:35
        p.checklist(θ["p.skill_logic-bug.seed_auth_session_state"]);                                        // src: vvaharness/skills/logic-bug/SKILL.md:38
        p.checklist(θ["p.skill_logic-bug.seed_numeric_identity_counters"]);                                 // src: vvaharness/skills/logic-bug/SKILL.md:41
        p.checklist(θ["p.skill_logic-bug.seed_protocol_state"]);                                            // src: vvaharness/skills/logic-bug/SKILL.md:44
        p.checklist(θ["p.skill_logic-bug.seed_cache_key_dimensions"]);                                      // src: vvaharness/skills/logic-bug/SKILL.md:47
        p.checklist(θ["p.skill_logic-bug.seed_sentinel_return_values"]);                                    // src: vvaharness/skills/logic-bug/SKILL.md:50
        return p;
    }
}
