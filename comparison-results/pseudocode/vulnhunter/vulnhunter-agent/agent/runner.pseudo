// L0 of the Python agent: run_vulnhunt launches the /vulnhunt skill (VulnhuntSkill.run) in one Claude Agent SDK
// session against a fresh clone, with cold-start retry and a continuation loop for background subagents.
// ScanFlow renders __main__._run_scan_flow (clone -> scan -> publish -> extract findings -> issues) around it.

@executedBy(CODE) @role(pipeline) @stage("agent")
class ScanFlow {

    // __main__._run_scan_flow: the scan-mode pipeline. Main.runScanFlow delegates here.
    int run(Args args, Theta θ, AuditWriter auditWriter) {
        String repoUrl = args.targets[0];                                                        // src: vulnhunter-agent/agent/__main__.py:797
        boolean[] modes = Main.resolveModes(args, θ);                                            // src: vulnhunter-agent/agent/__main__.py:799
        boolean scan = modes[0]; boolean publish = modes[1]; boolean issues = modes[2];
        Main.validateModes(scan, publish, issues, θ);                                            // src: vulnhunter-agent/agent/__main__.py:800
        if (θ["github.*"].brokerTokenDir == "") Main.preflightStandaloneTokens(θ, scan, publish, issues); // src: vulnhunter-agent/agent/__main__.py:808
        RepoProperties props = (auditWriter != null) ? Main.resolveRepoProperties(args, θ, repoUrl) : new RepoProperties(); // src: vulnhunter-agent/agent/__main__.py:821
        boolean effectiveReadOnly = (args.readOnly == null) ? true : args.readOnly;              // src: vulnhunter-agent/agent/__main__.py:846
        if (scan && args.enableBash && effectiveReadOnly) throw new RuntimeError("invariant: enable_bash with read_only"); // src: vulnhunter-agent/agent/__main__.py:847
        if (scan && !effectiveReadOnly && !args.enableBash) throw new RuntimeError("invariant: read_only=False without enable_bash"); // src: vulnhunter-agent/agent/__main__.py:853

        int exitCode = 0;
        Path resultsDir = null; Extracted extracted = null; PostSummary summary = null; Download download = null;
        SessionTotals scanTotals = new SessionTotals();
        try {
            // ---- scan stage
            Path cloneDir = null;
            if (scan) {
                String cloneBase = (args.cloneDir != null) ? args.cloneDir : θ["scan.clone_base_dir"];    // src: vulnhunter-agent/agent/__main__.py:901
                cloneDir = Clone.shallowClone(repoUrl, cloneBase,
                        θ["scan.clone_timeout_seconds"],                                         // src: vulnhunter-agent/agent/__main__.py:905
                        args.reClone,
                        TokenClient.getGithubToken("scan", θ["github.*"]),                       // src: vulnhunter-agent/agent/__main__.py:907
                        θ["github.*"].host, θ);                                                  // src: vulnhunter-agent/agent/__main__.py:908
                resultsDir = Runner.run(cloneDir, θ, args.model, args.scanId, effectiveReadOnly, args.enableBash,
                        θ["code.scan_retry_backoffs"], auditWriter, scanTotals);                  // src: vulnhunter-agent/agent/__main__.py:910
                if (resultsDir == null) return 1;                                                // src: vulnhunter-agent/agent/__main__.py:922
            }

            // ---- publish stage
            String commitSha = (scan && cloneDir != null) ? Main.shortSha(cloneDir) : "unknown"; // src: vulnhunter-agent/agent/__main__.py:936
            String reportUrl = null;
            if (scan && publish) {                                                               // src: vulnhunter-agent/agent/__main__.py:938
                try {
                    Publish.publishResults(resultsDir, θ["publish.*"], θ["github.*"], repoUrl, commitSha); // src: vulnhunter-agent/agent/__main__.py:940
                } catch (PublishError e) {
                    persistManifest(resultsDir, 2, scanTotals, extracted, summary);              // src: vulnhunter-agent/agent/__main__.py:954
                    return 2;                                                                    // src: vulnhunter-agent/agent/__main__.py:955
                }
                if (issues) reportUrl = Issues.buildReportUrlForLocalScan(θ["publish.*"].destinationRepo, θ["publish.*"].branch, repoUrl, commitSha, resultsDir); // src: vulnhunter-agent/agent/__main__.py:960
            } else if (scan) {
                // publish skipped: --no-publish or [publish] enabled = false
                log("Publish: skipped; flip publish.enabled", θ["publish.enabled"]);             // src: vulnhunter-agent/agent/__main__.py:971
            }

            // ---- download-latest stage (--no-scan + --issues)
            if (!scan && issues) {                                                               // src: vulnhunter-agent/agent/__main__.py:986
                try {
                    download = IssuesRemoteReport.downloadLatestReport(repoUrl, θ["publish.*"], θ["github.*"]); // src: vulnhunter-agent/agent/__main__.py:988
                } catch (RemoteReportError e) {
                    persistManifest(resultsDir, 4, scanTotals, extracted, summary);
                    return 4;                                                                    // src: vulnhunter-agent/agent/__main__.py:996
                }
                resultsDir = download.path;
                reportUrl = Issues.buildReportUrlForRemoteReport(θ["publish.*"].destinationRepo, θ["publish.*"].branch, download.relPath); // src: vulnhunter-agent/agent/__main__.py:999
            }

            // ---- findings extraction (shared by audit stream and issues stage)
            AuditCtx auditCtx = Main.auditContextForResults(resultsDir, args, scan, auditWriter); // src: vulnhunter-agent/agent/__main__.py:1009
            boolean auditOn = θ["audit.enabled"] && auditWriter != null;                         // src: vulnhunter-agent/agent/__main__.py:1018
            if (resultsDir != null && ((auditOn && auditCtx != null) || issues)) {               // src: vulnhunter-agent/agent/__main__.py:1017
                TokenManager tm = Auth.makeTokenManager(θ, "issues");                            // src: vulnhunter-agent/agent/__main__.py:1020
                try {
                    extracted = IssuesExtract.extractFindings(resultsDir, θ, tm, null, auditWriter);             // src: vulnhunter-agent/agent/__main__.py:1022
                } catch (Exception e) {
                    extracted = null;                                                            // src: vulnhunter-agent/agent/__main__.py:1031
                }
                if (auditOn && auditCtx != null && extracted != null) {                          // src: vulnhunter-agent/agent/__main__.py:1032
                    for (FindingEvent ev : AuditExtract.buildFindingEvents(extracted, auditCtx, "OPEN", props)) auditWriter.emitFinding(ev); // src: vulnhunter-agent/agent/__main__.py:1037
                }
            }

            // ---- issues stage
            if (issues) {                                                                        // src: vulnhunter-agent/agent/__main__.py:1050
                TokenManager tm = Auth.makeTokenManager(θ, "issues");
                String targetRepo = firstNonEmpty(args.issuesTargetRepo, config.issues.targetRepo, repoUrl);  // issues.target_repo: no knob // src: vulnhunter-agent/agent/__main__.py:1052
                try {
                    summary = Issues.postIssues(resultsDir, reportUrl, targetRepo, θ, tm, auditWriter, auditCtx, props, extracted, commitSha); // src: vulnhunter-agent/agent/__main__.py:1056
                } catch (Exception e) {
                    persistManifest(resultsDir, 4, scanTotals, extracted, summary);
                    return 4;                                                                    // src: vulnhunter-agent/agent/__main__.py:1073
                }
                if (summary.anyFailed && exitCode == 0) exitCode = 3;                            // src: vulnhunter-agent/agent/__main__.py:1075
            }
            persistManifest(resultsDir, exitCode, scanTotals, extracted, summary);               // src: vulnhunter-agent/agent/__main__.py:1081
            return exitCode;
        } finally {
            if (download != null) download.cleanup();                                            // src: vulnhunter-agent/agent/__main__.py:1085
        }
    }

    // _persist_manifest: write scan_manifest.json whenever a results dir exists (exit 2 suppressed inside the writer).
    void persistManifest(Path resultsDir, int exitCode, SessionTotals totals, Extracted extracted, PostSummary summary) {
        if (resultsDir == null) return;                                                          // src: vulnhunter-agent/agent/__main__.py:883
        Manifest.writeManifest(resultsDir, resultsDir.name, exitCode, totals, extracted, summary); // src: vulnhunter-agent/agent/__main__.py:886
    }
}

