# vvaharness/models/scan/findings.py

`Finding` (one vulnerability as every stage and both subsystems understand it), the Stage 8 chain structures (`LinkEvidence`, `Chain`, `RankedFinding`), and `DroppedFinding`, the audit entry for a finding removed before the report.

Source: `vvaharness/models/scan/findings.py` (lines 1-215)
Executor: code
Called from: Stage 4 (produces findings), Stages 5 to 11 (read and annotate), `vvaharness/models/scan/report.py`

// src: vvaharness/models/scan/findings.py:31-113
Finding {
  title: String
  file: String
  line_start: Number
  vuln_class: VulnClass                // an unknown label folds to "other" (see vocab.sudo)
  severity: Severity = "medium"        // the ranking stage fills it from the RankedFinding wrapper at ingest
  line_end: Number = 0
  cwe: String | null = null            // canonical "CWE-79"; set by Stage 4, carried to Markdown and SARIF taxa
  vuln_class_label: String = ""        // the caller's own wording when vuln_class folded to "other"
  chunk_id: String = ""                // the Stage 3 unit it came from; empty for an external finding
  impact: String = ""                  // 2-3 sentences, business-facing
  description: String = ""
  exploit_scenario: String = ""        // at most 5 sentences (not enforced here)
  preconditions: String[] = []
  recommendation: String = ""
  // evidence, carried through remediation and validation, not re-derived
  code_snippet: String = ""
  source_ref: String | null = null     // "file:line" where untrusted input enters (Stage 4 evidence gate)
  sink_ref: String | null = null       // "file:line" where it is used unsafely
  duplicates: DupLocation[] = []       // sites collapsed into this canonical by Stage 7; a fix must cover them too
  backfilled_refs: String[] = []       // refs Stage 5's AST backfill synthesized
  pre_anchor_line: Number = 0          // Stage 4's pre-re-anchor line so Stage 7 judges proximity on it; 0 = unset; Stage 6 resets it
  case_id: String = ""                 // minted at ingest when empty
  exploitability_notes: String = ""    // Stage 8 commentary, duplicated from RankedFinding
  severity_prose_mismatch: String = "" // Stage 8: the model's severity word that lost to the CVSS band; kept out of the remediation prompt
  channel: String = "main"             // "main" | "posture"; posture (build or deploy) is skipped by remediation
  // coercion (before validation): channel = "posture" if it is a string whose stripped casefold is "posture", otherwise "main"
  control_absence: Boolean = false     // a missing control; Stage 8 lets it chain nothing onward
  origin: String = ""                  // "" = model, "detector" = Stage 5 rule pack, "s6_discovered" = minted during verification, outside the ledger
  is_repeat_clone: Boolean = false     // a repeat-site clone from Stage 6, never the primary; keeps scan.py's ledger an equality
  verdict: "TRUE_POSITIVE" | "FALSE_POSITIVE" | null = null
  verdict_confidence: Number | null = null   // 0..10 (not enforced here)
  verdict_reason: String = ""
  cvss_vector: String | null = null    // CVSS:3.1/AV:_/AC:_/...
  cvss_score: Number | null = null     // 0.0-10.0, computed from the vector
  cvss_rating: String | null = null    // None/Low/Medium/High/Critical
  // exploit verification fields; ev_status null = exploit verification never ran
  ev_status: "CONFIRMED" | "NOT_CONFIRMED" | "INCONCLUSIVE" | "NOT_TESTED" | null = null   // typed as String in the source
  ev_evidence: String = ""; ev_reason_source: String = ""   // rule | triage | judge
  ev_repro: String = ""; ev_method: String = ""             // "deterministic-backed" | "agent-judged"
  ev_confidence: String = ""                                // "high" | "medium" | "low"
  ev_confidence_score: Number | null = null                 // 0-10 certainty in the live outcome
  ev_cvss_vector: String = ""; ev_cvss_score: Number | null = null; ev_cvss_rating: String | null = null
  ev_repro_detail: {} = {}
  // post-Stage 7 environmental enrichment (pipeline._enrich_findings)
  vsvs_vector: String | null = null; vsvs_score: Number | null = null; vsvs_rating: String | null = null
  offensive_priority: String | null = null   // P1..P4 (see OFFENSIVE_LABELS)
  offensive_reason: String = ""
}

// src: vvaharness/models/scan/findings.py:111-113
fn Finding.canonical_key(line_bucket=10):executor=code {
  return [file, floor(line_start / line_bucket), vuln_class, cwe]   // cwe is in the key because VulnClass folds web defects together
}

// src: vvaharness/models/scan/findings.py:119-121
// Lazy file:line split: "a.py:231:5" splits at the first :LINE, but a :LINE followed by path text stays in the path; never crosses "->"
_FILE_LINE_RX = /^\s*((?:(?!->)\S)+?):(\d+)(?::\d+)?(?![\w\/\\]|\.\w)/ (ASCII)

// src: vvaharness/models/scan/findings.py:124-168
LinkEvidence {
  // field descriptions are shown to the model in the Stage 8 output schema (prompt-src: findings.py:126-134)
  from_id: String = ""      // "The FINDING id this link starts at (e.g. f3)."
  to_id: String = ""        // "The FINDING id this link leads to (e.g. f7)."
  mechanism: String = ""    // "Concretely, what from_id produces that to_id consumes — a value, a privilege, a reachable state. Not a restatement of the two titles."
  file: String = ""         // "Repo-relative path of the code that shows this link holds."
  line: Number = 0          // "Line in that file which shows it. Must be a real line."

  // src: findings.py:136-151 — coercion (before validation) of a "file_line" string such as "a.py:231 -> b.py:297"
  //   if input is a dict with a string "file_line": remove it; match _FILE_LINE_RX;
  //   on a match, set file from group 1 only if file is empty, and line from group 2 only if _coerce_line(line) is 0
  // src: findings.py:153-163 — coerce, never reject (one "line 42" would fail the entire Stage 8 reply)
  //   line = float(line) or 0 on error; non-finite => 0; otherwise max(truncate, 0)   (negatives clamp; the citation gate fails line < 1)
  // src: findings.py:165-168 — from_id, to_id, mechanism, file through _coerce.text (null => "")
}

// src: vvaharness/models/scan/findings.py:171-189
Chain {
  title: String              // for example "UAF → arb write → code exec"
  steps: Number[]            // indices into FinalReport.findings
  severity: Severity
  blocked_by_controls: String[] = []   // control names that genuinely stop this
  preconditions: String[] = []         // kept apart: a precondition under "Blocked by" would read as mitigated
  link_evidence: LinkEvidence[] = []
  entry_reachability: String = ""      // how the attacker reaches the first step
  quality_notes: String[] = []         // length prices the split
  disclosures: String[] = []           // informational, not defects
  severity_decision: String = ""       // "lift_withheld" | "self_raise_capped" | "": why the gate acted
  link_coverage: String = ""           // "N/M": resolved link citations / hops needing one
  narrative: String
}

// src: vvaharness/models/scan/findings.py:192-196
// FinalReport.unranked_split matches this exact string to find findings the chain pass saw and skipped
NOT_RANKED_NOTE = "(no chain role found by the chaining pass; severity from the CVSS band)"

// src: vvaharness/models/scan/findings.py:199-202
RankedFinding {
  finding: Finding
  severity: Severity
  exploitability_notes: String   // chain-pass model commentary, including mitigations
}

// src: vvaharness/models/scan/findings.py:205-215
DroppedFinding {
  file: String
  line: Number
  vuln_class: VulnClass
  title: String
  chunk_id: String
  reason: "FALSE_POSITIVE" | "VERIFY_ERROR" | "DUPLICATE" | "UNCONFIRMED" | "EXCLUDED" | "GUARDRAIL_BLOCKED" | "INCONCLUSIVE"
  detail: String = ""        // verdict reason, error text, or deduplication reasoning
  canonical_idx: Number | null = null   // for DUPLICATE: index into FinalReport.findings
}
