// file: vvaharness/backends/llm/openai_responses.py
// Pure Chat <-> Responses API translation for the openai route (no I/O): the same Chat-shaped transcript replays
// over either wire; private keys carry Responses-only replay state (encrypted reasoning, function_call item ids).

@executedBy(CODE) @role(types)
record ResponsesToolCall(String id, String type, String name, String arguments, String itemId) { }

@executedBy(CODE) @role(types)
record ResponsesMessage(String content, List<ResponsesToolCall> toolCalls, String refusal, List<Map> reasoningItems) { }

@executedBy(CODE) @role(types)
record ResponsesChoice(ResponsesMessage message, String finishReason) { }

@executedBy(CODE) @role(types)
record ResponsesReply(List<ResponsesChoice> choices, Map usage) { }

@executedBy(CODE) @role(backend)
class OpenaiResponses {

    String REASONING_ITEMS_KEY = "_reasoning_items";                                                        // stripped before the Chat wire // src: vvaharness/backends/llm/openai_responses.py:46
    String ITEM_ID_KEY = "_item_id";                                                                        // src: vvaharness/backends/llm/openai_responses.py:50
    List<String> INCLUDE_ENCRYPTED_REASONING = List.of("reasoning.encrypted_content");                      // src: vvaharness/backends/llm/openai_responses.py:53
    // a replayed reasoning item is an INPUT item: only these fields (OUTPUT-only fields like status are rejected)
    List<String> REASONING_INPUT_FIELDS = List.of("type", "id", "encrypted_content", "summary");            // src: vvaharness/backends/llm/openai_responses.py:59

    @src("vvaharness/backends/llm/openai_responses.py:62")
    Object get(Object obj, String key, Object dflt) {
        if (obj == null) return dflt;                                                                       // src: vvaharness/backends/llm/openai_responses.py:64
        return obj instanceof Map ? obj.getOrDefault(key, dflt) : obj.attr(key, dflt);                      // src: vvaharness/backends/llm/openai_responses.py:66
    }

    @src("vvaharness/backends/llm/openai_responses.py:71")
    Map asDict(Object obj) {
        if (obj == null) return Map.of();                                                                   // src: vvaharness/backends/llm/openai_responses.py:73
        if (obj instanceof Map) return obj.copy();
        return obj.hasModelDump() ? obj.modelDump() : obj.vars();                                           // src: vvaharness/backends/llm/openai_responses.py:77
    }

    /** Flatten Chat function tool entries to the Responses tool shape. */
    @src("vvaharness/backends/llm/openai_responses.py:80")
    List<Map> toResponsesTools(List<Map> tools) {
        if (tools == null || tools.isEmpty()) return List.of();                                            // src: vvaharness/backends/llm/openai_responses.py:82
        List<Map> flattened = new List();
        for (Map tool : tools) {                                                                            // src: vvaharness/backends/llm/openai_responses.py:85
            Map fn = tool.get("function");
            // explicit: the Responses API attempts strict mode when this is omitted
            flattened.add(Map.of("type", "function", "name", fn.name, "description", fn.description, "parameters", fn.parameters, "strict", θ["code.backends.llm.openai_responses.strict_tools"])); // src: vvaharness/backends/llm/openai_responses.py:93
        }
        return flattened;
    }

    @src("vvaharness/backends/llm/openai_responses.py:98")
    boolean isForcedFunctionChoice(Object toolChoice) {
        return toolChoice instanceof Map && toolChoice.get("type") == "function" && toolChoice.containsKey("function"); // src: vvaharness/backends/llm/openai_responses.py:99
    }

    /** A forced Chat tool_choice becomes the Responses shape; strings pass through. */
    @src("vvaharness/backends/llm/openai_responses.py:106")
    Object toResponsesToolChoice(Object toolChoice) {
        if (isForcedFunctionChoice(toolChoice)) return Map.of("type", "function", "name", toolChoice.function.name); // src: vvaharness/backends/llm/openai_responses.py:109
        return toolChoice;                                                                                  // src: vvaharness/backends/llm/openai_responses.py:110
    }

    @src("vvaharness/backends/llm/openai_responses.py:113")
    Object inputContent(Object content) {
        if (content instanceof List) return content.map(b -> b.type == "text" ? Map.of("type", "input_text", "text", b.text) : b); // src: vvaharness/backends/llm/openai_responses.py:115
        return content;
    }

    @src("vvaharness/backends/llm/openai_responses.py:124")
    List<Map> reasoningInputItems(Map entry) {
        return entry.getOrDefault(REASONING_ITEMS_KEY, List.of()).filter(item -> item.get("encrypted_content") != null); // already allowlisted // src: vvaharness/backends/llm/openai_responses.py:127
    }

    @src("vvaharness/backends/llm/openai_responses.py:133")
    Map textInputItem(Map entry) {
        Object content = entry.get("content");
        if (content == null || content.isEmpty()) return null;                                              // src: vvaharness/backends/llm/openai_responses.py:135
        return Map.of("type", "message", "role", "assistant", "content", List.of(Map.of("type", "output_text", "text", content))); // src: vvaharness/backends/llm/openai_responses.py:137
    }

    @src("vvaharness/backends/llm/openai_responses.py:144")
    List<Map> functionCallItems(Map entry) {
        List<Map> items = new List();
        for (Map toolCall : entry.getOrDefault("tool_calls", List.of())) {                                  // src: vvaharness/backends/llm/openai_responses.py:149
            Map callItem = Map.of("type", "function_call", "call_id", toolCall.id, "name", toolCall.function.name, "arguments", toolCall.function.arguments); // src: vvaharness/backends/llm/openai_responses.py:151
            if (toolCall.get(ITEM_ID_KEY) != null) callItem.put("id", toolCall.get(ITEM_ID_KEY));           // src: vvaharness/backends/llm/openai_responses.py:158
            items.add(callItem);
        }
        return items;
    }

    @src("vvaharness/backends/llm/openai_responses.py:164")
    List<Map> assistantItems(Map entry) {
        List<Map> items = reasoningInputItems(entry);                                                       // src: vvaharness/backends/llm/openai_responses.py:165
        Map textItem = textInputItem(entry);
        if (textItem != null) items.add(textItem);                                                          // src: vvaharness/backends/llm/openai_responses.py:168
        items.addAll(functionCallItems(entry));                                                             // src: vvaharness/backends/llm/openai_responses.py:169
        return items;
    }

    /** Chat-shaped transcript -> Responses input items. */
    @src("vvaharness/backends/llm/openai_responses.py:173")
    List<Map> toResponsesInput(List<Map> messages) {
        List<Map> items = new List();
        for (Map entry : messages) {                                                                        // src: vvaharness/backends/llm/openai_responses.py:176
            String role = entry.get("role");
            if (role == "assistant") items.addAll(assistantItems(entry));                                   // src: vvaharness/backends/llm/openai_responses.py:178
            else if (role == "tool") items.add(Map.of("type", "function_call_output", "call_id", entry.get("tool_call_id"), "output", entry.get("content"))); // src: vvaharness/backends/llm/openai_responses.py:180
            else items.add(Map.of("role", role, "content", inputContent(entry.get("content"))));            // src: vvaharness/backends/llm/openai_responses.py:187
        }
        return items;
    }

    @src("vvaharness/backends/llm/openai_responses.py:191")
    Map toolKwargs(Map baseKw) {
        Map kwargs = new Map();
        List<Map> tools = toResponsesTools(baseKw.get("tools"));                                            // src: vvaharness/backends/llm/openai_responses.py:193
        if (!tools.isEmpty()) kwargs.put("tools", tools);
        if (baseKw.get("tool_choice") != null) kwargs.put("tool_choice", toResponsesToolChoice(baseKw.get("tool_choice"))); // src: vvaharness/backends/llm/openai_responses.py:197
        return kwargs;
    }

    @src("vvaharness/backends/llm/openai_responses.py:202")
    Map responsesOnlyKwargs(Map baseKw, boolean includeEncrypted) {
        // no per-turn server state: encrypted reasoning does the replay
        Map kwargs = Map.of("store", θ["code.backends.llm.openai_responses.store"]);                         // src: vvaharness/backends/llm/openai_responses.py:204
        Object maxTokens = baseKw.getOrDefault("max_completion_tokens", baseKw.get("max_tokens"));          // src: vvaharness/backends/llm/openai_responses.py:205
        if (maxTokens != null) kwargs.put("max_output_tokens", maxTokens);                                  // src: vvaharness/backends/llm/openai_responses.py:207
        Object effort = baseKw.get("reasoning_effort");                                                     // src: vvaharness/backends/llm/openai_responses.py:208
        // never 'none' on the wire: reasoning off is expressed by OMITTING the field
        if (effort != null && effort != LlmModels.REASONING_OFF) kwargs.put("reasoning", Map.of("effort", effort)); // src: vvaharness/backends/llm/openai_responses.py:211
        if (baseKw.get("prompt_cache_key") != null) kwargs.put("prompt_cache_key", baseKw.get("prompt_cache_key")); // src: vvaharness/backends/llm/openai_responses.py:214
        if (includeEncrypted) kwargs.put("include", INCLUDE_ENCRYPTED_REASONING);                           // src: vvaharness/backends/llm/openai_responses.py:216
        return kwargs;
    }

    /** Chat base_kw (+ transcript) -> Responses create payload; Chat-only keys dropped by omission. */
    @src("vvaharness/backends/llm/openai_responses.py:221")
    Map toResponsesRequest(List<Map> messages, Map baseKw, boolean includeEncrypted) {
        Map request = Map.of("model", baseKw.get("model"), "input", toResponsesInput(messages));             // src: vvaharness/backends/llm/openai_responses.py:230
        request.putAll(toolKwargs(baseKw));                                                                 // src: vvaharness/backends/llm/openai_responses.py:231
        request.putAll(responsesOnlyKwargs(baseKw, includeEncrypted));                                      // src: vvaharness/backends/llm/openai_responses.py:232
        return request;
    }

    /** Transcript copy with the Responses-only replay keys stripped, for the Chat wire. */
    @src("vvaharness/backends/llm/openai_responses.py:236")
    List<Map> toChatMessages(List<Map> messages) {
        List<Map> out = new List();
        for (Map entry : messages) {                                                                        // src: vvaharness/backends/llm/openai_responses.py:239
            Map copy = entry.without(REASONING_ITEMS_KEY);                                                  // src: vvaharness/backends/llm/openai_responses.py:240
            if (copy.get("tool_calls") != null) copy.put("tool_calls", copy.get("tool_calls").map(tc -> tc.without(ITEM_ID_KEY))); // src: vvaharness/backends/llm/openai_responses.py:243
            out.add(copy);
        }
        return out;
    }

    /** Responses usage -> Chat usage field names (cached/cache_write/reasoning default 0). */
    @src("vvaharness/backends/llm/openai_responses.py:250")
    Map usageAsChat(Object usage) {
        if (usage == null) return null;                                                                     // src: vvaharness/backends/llm/openai_responses.py:252
        int in = get(usage, "input_tokens", 0);
        int out = get(usage, "output_tokens", 0);
        Object total = get(usage, "total_tokens", null);
        if (total == null) total = in + out;                                                                // src: vvaharness/backends/llm/openai_responses.py:258
        Map promptDetails = asDict(get(usage, "input_tokens_details", null));                               // src: vvaharness/backends/llm/openai_responses.py:260
        promptDetails.setDefault("cached_tokens", 0);
        promptDetails.setDefault("cache_write_tokens", 0);
        Map completionDetails = asDict(get(usage, "output_tokens_details", null));
        completionDetails.setDefault("reasoning_tokens", 0);                                                // src: vvaharness/backends/llm/openai_responses.py:265
        return Map.of("prompt_tokens", in, "completion_tokens", out, "total_tokens", total, "prompt_tokens_details", promptDetails, "completion_tokens_details", completionDetails); // src: vvaharness/backends/llm/openai_responses.py:267
    }

    /** Responses status/incomplete_details -> Chat finish_reason. */
    @src("vvaharness/backends/llm/openai_responses.py:276")
    String finishOf(Object resp, boolean hasToolCalls) {
        Object status = get(resp, "status", null);                                                          // src: vvaharness/backends/llm/openai_responses.py:278
        Object incomplete = get(resp, "incomplete_details", null);
        Object reason = incomplete != null ? get(incomplete, "reason", null) : null;                        // src: vvaharness/backends/llm/openai_responses.py:280
        if (status == "incomplete" && reason == "max_output_tokens") return "length";                       // truncation path // src: vvaharness/backends/llm/openai_responses.py:281
        if (reason == "content_filter") return "content_filter";                                            // src: vvaharness/backends/llm/openai_responses.py:283
        return hasToolCalls ? "tool_calls" : "stop";                                                        // src: vvaharness/backends/llm/openai_responses.py:285
    }

    @src("vvaharness/backends/llm/openai_responses.py:344")
    void raiseForError(Object resp) {
        Object error = get(resp, "error", null);                                                            // src: vvaharness/backends/llm/openai_responses.py:345
        Object status = get(resp, "status", null);
        if (error == null && status != "failed") return;                                                    // src: vvaharness/backends/llm/openai_responses.py:347
        // a failed call with no error body is still a failure, never an empty stop
        String message = error != null ? (error instanceof String ? error : get(error, "message", error.toString())) : "Responses call ended with status and no error body"; // src: vvaharness/backends/llm/openai_responses.py:350
        throw new RuntimeError(message);                                                                    // src: vvaharness/backends/llm/openai_responses.py:355
    }

    @src("vvaharness/backends/llm/openai_responses.py:358")
    Pair messageContent(Object item) {
        List<String> textParts = new List();
        String refusal = null;
        for (Object block : get(item, "content", List.of())) {                                              // src: vvaharness/backends/llm/openai_responses.py:361
            Object type = get(block, "type", null);
            if (type == "output_text") textParts.add(get(block, "text", ""));                               // src: vvaharness/backends/llm/openai_responses.py:363
            else if (type == "refusal" && refusal == null) refusal = get(block, "refusal", null);           // first refusal kept // src: vvaharness/backends/llm/openai_responses.py:365
        }
        return Pair.of(textParts, refusal);
    }

    @src("vvaharness/backends/llm/openai_responses.py:370")
    ResponsesToolCall toolCallFromItem(Object item) {
        return new ResponsesToolCall(get(item, "call_id", null), "function", get(item, "name", null), get(item, "arguments", null), get(item, "id", null)); // allowlist by construction // src: vvaharness/backends/llm/openai_responses.py:373
    }

    @src("vvaharness/backends/llm/openai_responses.py:378")
    List<Map> encryptedReasoningItems(List items) {
        return items.filter(i -> get(i, "type", null) == "reasoning" && get(i, "encrypted_content", null) != null).map(i -> REASONING_INPUT_FIELDS.toMap(f -> get(i, f, null)).dropNulls()); // src: vvaharness/backends/llm/openai_responses.py:379
    }

    /** Chat-like reply (.choices[0].message, .usage) from a Responses object. */
    @src("vvaharness/backends/llm/openai_responses.py:387")
    ResponsesReply fromResponse(Object resp) {
        raiseForError(resp);                                                                                // src: vvaharness/backends/llm/openai_responses.py:389
        List outputItems = get(resp, "output", List.of());
        List<String> outputTextParts = new List();
        String refusalText = null;
        List<ResponsesToolCall> toolCalls = new List();
        for (Object item : outputItems) {                                                                   // src: vvaharness/backends/llm/openai_responses.py:395
            Object type = get(item, "type", null);
            if (type == "message") {                                                                        // src: vvaharness/backends/llm/openai_responses.py:397
                Pair mc = messageContent(item);
                outputTextParts.addAll(mc.first);
                if (refusalText == null) refusalText = mc.second;                                           // src: vvaharness/backends/llm/openai_responses.py:400
            } else if (type == "function_call") {
                toolCalls.add(toolCallFromItem(item));                                                      // src: vvaharness/backends/llm/openai_responses.py:403
            }
        }
        String content = outputTextParts.isEmpty() ? null : String.join("", outputTextParts);               // src: vvaharness/backends/llm/openai_responses.py:405
        ResponsesMessage message = new ResponsesMessage(content, toolCalls, refusalText, encryptedReasoningItems(outputItems)); // src: vvaharness/backends/llm/openai_responses.py:406
        ResponsesChoice choice = new ResponsesChoice(message, finishOf(resp, !toolCalls.isEmpty()));        // src: vvaharness/backends/llm/openai_responses.py:407
        return new ResponsesReply(List.of(choice), usageAsChat(get(resp, "usage", null)));                  // src: vvaharness/backends/llm/openai_responses.py:408
    }
}
