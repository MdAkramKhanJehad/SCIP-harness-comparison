record LoadedValidateSpec(Object config, Object spec) { }

@executedBy(CODE) @role(types)
record PersonaModelResolution(String modelId, String via) { }

@executedBy(CODE) @role(types)
record ModelEnvResult(int exitCode, Map overrides) { }

@executedBy(CODE) @role(config) @stage("S11")
class ValidationCliModel {
    @src("vvaharness/validation/cli/_model.py:35")
    Map personaFields(Theta θ) {
        return θ["code.validation.cli.model.persona_fields"]; // src: vvaharness/validation/cli/_model.py:35
    }
    @src("vvaharness/validation/cli/_model.py:63")
    String checkPersonaVendors(Map overrides, Theta θ) {
        Object provider = overrides.get("provider");
        boolean panelAnthropic = routesToAnthropic(str(truthyOr(overrides.get("model"), "")), provider instanceof String && !provider.isEmpty() ? provider : null);
        for (String field : personaFields(θ).values()) {
            Object model = overrides.get(field); if (!(model instanceof String) || model.isEmpty()) continue;
            if (routesToAnthropic(model, null) != panelAnthropic) return "persona model vendor differs from panel provider";
        }
        return null;
    }
    @src("vvaharness/validation/cli/_model.py:92")
    LoadedValidateSpec loadValidatedSpec(String configPath) {
        if (!Path.of(configPath).exists()) { logWarning("config missing"); return null; }
        Object cfg;
        try { cfg = loadHarnessConfig(configPath); } catch (ConfigPolicyError e) { logWarning(e); return null; }
        Object spec = validateModelSpec(cfg); if (spec == null) { logWarning("models.validate absent"); return null; }
        return new LoadedValidateSpec(cfg, spec);
    }
    @src("vvaharness/validation/cli/_model.py:109")
    boolean declaresRoute(Object spec) {
        return truthy(getattr(spec, "via", null)) || truthy(getattr(spec, "provider", null));
    }
    @src("vvaharness/validation/cli/_model.py:114")
    void warnIgnoredPersonaRoutes(List declared, String via, String provider) {
        if (declared.isEmpty()) return;
        logWarning("persona via/provider ignored; all share orchestrator route", declared, via, provider);
    }
    @src("vvaharness/validation/cli/_model.py:126")
    PersonaModelResolution personaSpecResolved(Object spec) {
        if (spec == null) return null;
        Triple resolved;
        try { resolved = resolveLlm(spec); } catch (ValueError | AttributeError | KeyError | TypeError e) { return null; }
        return truthy(resolved.first) ? new PersonaModelResolution(resolved.first, truthyOr(resolved.second, "")) : null;
    }
    @src("vvaharness/validation/cli/_model.py:137")
    ModelEnvResult applyModelEnv(String configPath, Theta θ) {
        LoadedValidateSpec loaded = loadValidatedSpec(configPath); if (loaded == null) return new ModelEnvResult(2, Map.of());
        Triple resolved = resolveLlm(loaded.spec); Pair route = normalizeValidateBackend(truthyOr(resolved.second, ""), getattr(loaded.spec, "provider", null));
        Map overrides = Parser.tunableOverrides(loaded.config, θ);
        overrides.putAll(Map.of("model", resolved.first, "via", route.first, "provider", route.second, "use_responses_api", useResponsesApiOf(loaded.spec)));
        Object models = getattr(loaded.config, "models", null); Object validate = models == null ? null : getattr(models, "validate", null);
        if (validate != null) {
            for (String name : personaFields(θ).keys()) { PersonaModelResolution persona = personaSpecResolved(getattr(validate, name, null)); if (persona != null) overrides.put(personaFields(θ).get(name), persona.modelId); }
            warnIgnoredPersonaRoutes(personaFields(θ).keys().filter(n -> declaresRoute(getattr(validate, n, null))), route.first, route.second);
        }
        Object block = getattr(loaded.config, "step_validate", null); Object tools = block == null ? null : getattr(block, "allowed_tools", null);
        if (tools instanceof List && !tools.isEmpty()) overrides.put("validate_tools", join(",", tools.map(t -> str(t))));
        overrides.put("cache_markers", markersOn(getattr(loaded.config, "sdk", null)));
        return new ModelEnvResult(0, overrides);
    }
}
