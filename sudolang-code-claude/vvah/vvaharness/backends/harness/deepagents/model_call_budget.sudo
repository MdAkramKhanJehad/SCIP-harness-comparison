// src: vvaharness/backends/harness/deepagents/model_call_budget.py:29-39
// prompt-src: vvaharness/backends/harness/deepagents/model_call_budget.py:31-39
FinalTurnNotice {
  Constraints {
    "FINAL TURN. You have used your $limit model calls for this unit, and every tool except the outcome report has been withdrawn — no further Read, Grep, execute or graph call will run.\n\n"
    "Report the outcome object NOW from the evidence you already hold. Findings you have confirmed are kept; do not discard them because you wanted one more lookup. If a question stayed open, say so in the rationale and set the verdict accordingly — `inconclusive` is honest, silence is not."
  }
}

// src: vvaharness/backends/harness/deepagents/model_call_budget.py:42-117
ModelCallBudget {
  // preserved (source comment at 44): CapOutputTokens' doubled truncation retry is one model call this budget does not count; only S4 raises VVAH-E007
  // src: model_call_budget.py:46-58
  State {
    _limit = max(1, int(limit))   // at least one call
    _outcome = outcome_tools
    _counter = counter            // default "model_call_budget_final_turn"
    _calls = 0
    _raise_when_exhausted = raise_when_exhausted   // default false
    _stage = stage                // default ""
    _final_turn_issued = false
    _lock
  }
  name = "ModelCallBudget[$_counter]"   // src: model_call_budget.py:60-63

  // src: model_call_budget.py:65-69
  fn _claim():executor=code {
    with _lock { _calls += 1; return _calls >= _limit }   // true on the last permitted call
  }

  // src: model_call_budget.py:71-77 — a deadline resume gets the forced final turn again instead of VVAH-E007
  fn grant_resume_turn():executor=code {
    with _lock {
      if (!_final_turn_issued) return
      _final_turn_issued = false
      _calls = _limit - 1
    }
  }

  // src: model_call_budget.py:79-84
  fn _final(request):executor=code {
    kept = [ t for each t in request.tools where t.name in _outcome ]
    COUNTERS.bump(_counter)
    return request with tools = kept, messages = [...request.messages, FinalTurnNotice(_limit)]
  }

  // src: model_call_budget.py:86-93
  fn _check_exhausted():executor=code {
    require !(_raise_when_exhausted && _final_turn_issued) => throw ModelCallBudgetExhaustedError("the forced final turn (every tool but the outcome withdrawn) still did not end the session on the outcome tool", stage=_stage, limit=_limit)
    // A caller that never opted in falls through: further calls run on the full tool list again
  }

  // src: model_call_budget.py:95-117 (async twin 107-117 identical)
  fn wrap_model_call(request, handler):executor=code {
    _check_exhausted()
    if (_claim()) {
      _final_turn_issued = true
      request = _final(request)
    }
    return handler(request)
    // preserved: without raise_when_exhausted, every call after the limit also satisfies _claim (calls >= limit), so each is again outcome-only with another FINAL TURN notice and another counter bump
  }
}
