# vvaharness/backends/harness/models.py

The data contract of the agent-session layer: the tool-name vocabularies every permission gate derives from, the option records a stage passes to a harness (`SessionOptions`, `OneShotOptions`, `StreamingOptions`), the streamed message types, and the error hierarchy with the operator error codes VVAH-E001 to VVAH-E009. The defaults declared here are the defaults of every harness session unless a caller overrides them.

Source: `vvaharness/backends/harness/models.py` (lines 1-782)
Executor: code
Called from: every harness backend (`claude/`, `deepagents/`) and every stage session that builds options

## Tool vocabularies

// src: vvaharness/backends/harness/models.py:35-77
// Every gate derives its tool sets from these constants; derived sets are computed, so a new tool cannot desynchronize them.
LOGICAL_TO_NATIVE = { "Read": "read_file", "Grep": "grep", "Glob": "glob", "Edit": "edit_file", "Write": "write_file" }   // profile name to native deepagents name
READ_TOOLS = { "Read", "Grep", "Glob" }
ORCHESTRATION_TOOLS = { "Agent", "Task", "TodoWrite", "Skill" }
MUTATING_TOOLS = { "Bash", "Edit", "NotebookEdit", "Write" }   // denied in a read-only session
READ_ONLY_TOOLS = READ_TOOLS union ORCHESTRATION_TOOLS   // callable without a path check; Write is gated per path instead
UNCONDITIONALLY_DENIED_TOOLS = MUTATING_TOOLS - { "Write", "Bash" }   // = { "Edit", "NotebookEdit" }
NATIVE_WRITE_TOOLS = { LOGICAL_TO_NATIVE[name] for each name in MUTATING_TOOLS that has a native name }   // = { "edit_file", "write_file" }
NATIVE_CONTENT_TOOLS = { "read_file", "grep" }   // results carry file content; "glob" and "ls" return only paths
NATIVE_IMPLIED_READS = { "ls" }   // not grantable by logical name; granted together with reads only, because a refused ls wastes turns
NATIVE_SHELL_TOOL = "execute"   // deliberately not in LOGICAL_TO_NATIVE (it would become a write tool); granted only with allow_shell
LEGACY_AGENT_TOOL = "Agent"   // legacy custom dispatch tool; native subagents are used instead, so it is never granted
MCP_TOOL_PREFIX = "mcp__"   // a tool from an MCP server; the permission gate allows it

## Enumerations and small records

// src: vvaharness/backends/harness/models.py:80-111
EffortLevel { "low" | "medium" | "high" | "xhigh" | "max" }
fn EffortLevel.parse(value):executor=code {
  return EffortLevel(value), or null when the value is absent or not one of the five tiers
}
SettingSource { "user" | "project" | "local" }
Provider { "anthropic" | "openai" }   // Anthropic, or an OpenAI-compatible endpoint

// src: vvaharness/backends/harness/models.py:113-156
ToolPolicy { allowed_tools: [] ; disallowed_tools: [] }
FactToolSpec { name; description; input_schema   // JSON Schema for the arguments
  fn   // takes keyword arguments, returns JSON, runs in-process
}
SubagentDefinition {
  name; description; prompt
  tools: null; disallowed_tools: null; model: null; skills: null; response_model: null
  max_model_calls: null   // deepagents only: model-call cap whose last call keeps only the outcome tool; null or <= 0 means no cap
}
PermissionDecision { allow: Boolean; reason: ""; interrupt: false }

// src: vvaharness/backends/harness/models.py:158-172
fn compose_tool_builders(...builders):executor=code {
  live = builders that are not null
  return a builder that calls each live builder with the same arguments and concatenates their tool lists (a null result counts as empty)
}

DEFAULT_GRAPH_NAME = "agent"   // src: models.py:176 — cosmetic name for the compiled agent graph

## Session options (the defaults every harness session starts from)

// src: vvaharness/backends/harness/models.py:179-221
SessionOptions {
  model: String
  cwd: Path
  env: {}
  model_provider: null   // deepagents selector "openai" | "anthropic"; null means infer from the model name (see provider_routing.routes_to_anthropic)
  effort: null
  think_in_prompt: false   // deepagents only: ask for reasoning in the prompt instead of native reasoning; a no-op where model_building.reasons_in_prompt is false
  use_responses_api: null   // OpenAI-branch transport override; null resolves to the learned transport, then Responses
  system_prompt: null
  tool_policy: null
  cli_path: null   // absolute path pin for the claude executable
  response_model: null   // Pydantic model class for structured output
  tool_builder: null   // null means the backend's generic readers
  fact_tools: []   // extra tool names granted to subagents beyond the policy
  fact_tool_specs: []   // the Claude route publishes these over MCP; deepagents ignores them
  allow_writes: false   // when false, write and edit tools are denied
  writable_paths: []   // used only when allow_writes is true
  skill_root: null
  graph_name: DEFAULT_GRAPH_NAME
  max_output_tokens: null   // per-call output cap; null inherits 64k on Anthropic and is uncapped on OpenAI; detection only
  output_cap: null   // models.<role>.max_tokens; bounds CapOutputTokens' one doubled-budget retry below 64k
  cache_markers: true   // whether BlockMarkerPromptCaching places markers; wired from config sdk.cache_markers
  parent_middleware: []   // caller-specific middleware for the graph (this is how the evidence gate, tool budget and parent model-call budget arrive)
  force_verdict_only: false   // true: force the outcome tool only on the call that ends the session; false forces every call
}

// src: vvaharness/backends/harness/models.py:224-231
OneShotOptions {   // SessionOptions fields plus:
  max_turns: 15
  output_schema: null
  cache_prefix: null   // cacheable leading user-turn content, never a hint; folded in verbatim where there is no marker seam
}

// src: vvaharness/backends/harness/models.py:234-257
StreamingOptions {   // SessionOptions fields plus:
  max_turns: null
  max_budget_usd: null
  timeout: null   // whole-session wall clock in seconds; null is unbounded
  allow_shell: false   // grants the shell native and selects an executing backend
  setting_sources: null
  permissions: null   // PermissionsPolicy
  agents: {}   // name -> SubagentDefinition
  output_schema: null
  permitted_tool_calls: null   // native names PermitTools admits at wrap_tool_call (fails closed); null installs no gate
  cache_prefix: null   // leading user-turn content in its own marked block: the fourth and last Anthropic cache breakpoint
  session_id: ""   // caller-pinned identity: the LangGraph thread id, the reported session id, and the compiled-graph cache key; "" means a fresh random thread that cannot be resumed
}

## Streamed messages

// src: vvaharness/backends/harness/models.py:260-335
HarnessSessionInit { kind: "session_init"; session_id: ""; raw: {} }
HarnessAssistantText { kind: "assistant_text"; text: ""; agent: null; namespace: null }
HarnessToolUse { kind: "tool_use"; tool_id: ""; name: ""; input: {}; agent: null; namespace: null }
HarnessToolResult { kind: "tool_result"; is_error: false; content: null; agent: null; namespace: null }
HarnessResult {
  kind: "result"; subtype: ""; is_error: false; session_id: null; result_text: null
  structured: null
  errors: null   // the only channel separating schema-validation exhaustion from a fallback retracting output
  usage: null; total_cost_usd: null
  state: null   // backend-specific terminal state; deepagents uses it for host-side subagent report extraction; not frozen because ClaudeHarness sets it after yielding
  truncated: false   // final turn clipped by its output budget
  refused: false; refusal_category: null   // a refused turn with no valid structured answer afterwards
}
HarnessMessage = HarnessSessionInit | HarnessAssistantText | HarnessToolUse | HarnessToolResult | HarnessResult

// src: vvaharness/backends/harness/models.py:338-353
OneShotResult { is_error: false; subtype: ""; result_text: null; structured: null; usage: null; total_cost_usd: null; truncated: false; refused: false; refusal_category: null }

## Errors

// src: vvaharness/backends/harness/models.py:356-400
HarnessError                          // base of every harness failure
SessionNotResumableError: HarnessError   // never pinned, released, capability-gated, still running past the exit grace, or a resume that failed or returned no text
HarnessCLINotFoundError: HarnessError    // fatal for the whole batch
HarnessConnectionError: HarnessError
HarnessProcessError: HarnessError { exit_code; stderr; recursion_limited: false }   // recursion_limited lets a consumer force-finalize after a recursion-limit death
HarnessJSONDecodeError: HarnessError
HarnessMessageParseError: HarnessError

// src: vvaharness/backends/harness/models.py:403-471
AuthenticationError: HarnessError {   // VVAH-E001, a halt error
  message = "[VVAH-E001] Authentication failed" + " (HTTP $status_code)" if set + " [$backend]" if set + ": $message\n" + _AUTH_REMEDIATION
  // abstracted: models.py:403-410 _AUTH_REMEDIATION lists credential options (claude /login or CLAUDE_CODE_OAUTH_TOKEN; ANTHROPIC_SDK_API_KEY or ANTHROPIC_API_KEY; regenerate JWT and set ANTHROPIC_BASE_URL), then "vvaharness doctor" and "--resume"
}
ProxyError: HarnessConnectionError {   // VVAH-E002, a halt error, raised without retry
  message = "[VVAH-E002] Proxy/network error" + optional HTTP code and backend + ": $message\n" + _PROXY_REMEDIATION
  // abstracted: models.py:412-420 _PROXY_REMEDIATION lists ANTHROPIC_BASE_URL, HTTPS_PROXY, NODE_EXTRA_CA_CERTS, SSL_CERT_FILE, CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1, then "vvaharness doctor"
}

// src: vvaharness/backends/harness/models.py:473-524
DegenerateResponseError: HarnessError { stage; response_len; threshold; consecutive }   // VVAH-E003: 200 OK with degenerate content; a single short response is only a warning, so only repeats reach here
OversizePromptError: HarnessError { stage; estimated_tokens; limit }   // VVAH-E004: raised before dispatch on the deepagents route; not a halt error, the scan continues

// src: vvaharness/backends/harness/models.py:527-535
TRUNCATED_BELOW_BUDGET_RATIO = 0.5
fn truncated_below_budget(produced, requested):executor=code {
  return produced != null && requested > 0 && produced < requested * 0.5   // null produced means unknown, never "below budget"
}

// src: vvaharness/backends/harness/models.py:538-576
TruncatedResponseError: HarnessError { stage; requested; retried; produced; reasoning_tokens } {   // VVAH-E005: cut off despite one retry; not a halt error
  if (truncated_below_budget(produced, requested)) {
    append hint " — provider stopped at $produced output tokens against a $requested budget: a gateway-side cap or reasoning consumption, not genuinely long output; set models.<role>.max_tokens: $produced or lower step*.effort"
  }
}

// src: vvaharness/backends/harness/models.py:579-625
ToolStateNotRoundTrippedError: HarnessError { stage; model_id }   // VVAH-E006: endpoint rejected a replayed tool call for missing opaque per-call state; deterministic; not a halt error
// abstracted: models.py:579-598 _TOOL_STATE_REMEDIATION: run `vvaharness doctor --config <profile>`, follow docs/errors.md#vvah-e006; a tool-less session avoids the failure but "loses ALL graph-tool evidence", described as "explicitly the wrong kind of fix"

// src: vvaharness/backends/harness/models.py:628-649
ModelCallBudgetExhaustedError: HarnessError { stage; limit }   // VVAH-E007: opt-in through ModelCallBudget(raise_when_exhausted), Stage 4 only; not a halt error, never changes the exit code

// src: vvaharness/backends/harness/models.py:652-684
CallTimeoutError: HarnessError, TimeoutError { stage; route; budget_s; effort }   // VVAH-E008; budget shown as "${budget_s}s" or "unbounded"; message ends " — raise the stage's timeout/ceiling knob or lower its effort"; the TimeoutError base lets every `except TimeoutError` treat it as a timeout

// src: vvaharness/backends/harness/models.py:687-716
RepeatedToolCallError: HarnessError { stage; route; tool_name; repeats }   // VVAH-E009; message ends " — the session is not converging; aborting rather than exhausting the timeout"; not a halt error

// src: vvaharness/backends/harness/models.py:722-730
fn is_halt_error(exc):executor=code {
  return exc is AuthenticationError || exc is ProxyError   // only VVAH-E001 and VVAH-E002 abort the scan immediately
}
fn is_token_error(exc):executor=code { return exc is AuthenticationError }
