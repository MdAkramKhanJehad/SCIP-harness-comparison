# vvaharness/api.py

The embeddable Python surface: remediate one finding, or validate one remediation, without the scan pipeline.

Source: `vvaharness/api.py` (lines 1-100)
Executor: code (the remediation and validation engines it calls contain the model calls)
Called from: library users; `vvaharness/__init__.py` exposes `remediate` and `validate` lazily

// src: vvaharness/api.py:44-74
fn remediate(finding, repo, mode="fix", config?, verbose=false):executor=code {
  cfg = _config(config)   // the packaged or auto-detected default when config is null
  layout = remediation_agent.discovery.prepare_layout(repo)
  target = RemediationTarget(finding, index=1)
  out_dir = orchestrator.artifacts.artifact_dir(layout.rem_dir, target.slug)   // refuses a symlinked or escaping directory
  remediation = remediation_agent.plugin_runner.apply_plugin(target, out_dir, cfg, repo, mode, verbose)   // contains the model call; see remediation_agent
  // the same remediate_<digest> provenance row the command-line and in-scan paths save, so Stage 11 discovery trusts this case later
  [model, backend] = engine_model(cfg)
  step = checkpoints.step_key_for(REMEDIATE_PREFIX, engine_id=ENGINE_ID, engine_version=__version__, case_id=target.case_id, model, backend)
  checkpoints.save_ckpt(layout.ckpt_dir, layout.run_id, step, checkpoint_record(target, out_dir, remediation) + { finding_id: target.case_id })
  return remediation
}

// src: vvaharness/api.py:77-92
fn validate(finding, remediation, repo, config?):executor=code {
  validation_config = if (config == null) null else validation.config.load_config(project_root=parent directory of config)
  return validation.case_api.validate_case(finding, remediation, repo, config=validation_config)   // stages a copy; writes nothing back to repo
}

// src: vvaharness/api.py:95-100
fn _config(config?):executor=code { return config.load(config || orchestrator._default_config()) }
// preserved: _config uses _default_config, which prefers ./config.yaml in the working directory over the packaged default, although the docstring says "the packaged default profile"; no trust gate is applied on this path
