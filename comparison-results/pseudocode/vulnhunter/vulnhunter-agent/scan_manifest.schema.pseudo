// file: vulnhunter-agent/scan_manifest.schema.json
// Agent-to-scan-worker contract written at <results_dir>/scan_manifest.json. The agent validates before writing,
// the scan worker validates on read; every object is closed (additionalProperties false).

@executedBy(CODE) @role(types)
enum AgentExitCode { SUCCESS_0, NO_FINDINGS_1, PUBLISH_FAILED_2, PARTIAL_ISSUE_POST_3, AGENT_CRASH_4 }

@executedBy(CODE) @role(types)
enum ManifestSeverity { CRITICAL, HIGH, MEDIUM, LOW, EMPTY }

@executedBy(CODE) @role(types)
enum DedupVia { KEY, SEMANTIC, EMPTY }

@executedBy(CODE) @role(types)
record ManifestFinding(String id, String title, String cwe, String cwe_name, ManifestSeverity severity, String location,
                       String root_cause, String data_flow, String entry_point, String exploit_description,
                       String exploit_impact, String fix_strategy, String severity_rationale, String vulnfix_key,
                       String poc_path, String exploit_test_path) { }

@executedBy(CODE) @role(types)
record PostedRecord(String finding_id, String title, String url) { }

@executedBy(CODE) @role(types)
record SkippedRecord(String finding_id, List<Integer> matched_issue_numbers, DedupVia via) { }

@executedBy(CODE) @role(types)
record FailedRecord(String finding_id, String title, String error) { }

@executedBy(CODE) @role(types)
record ScanManifestDocument(String schema_version, String scan_id, AgentExitCode agent_exit_code, double cost_usd,
                    List<ManifestFinding> findings, List<PostedRecord> posted, List<SkippedRecord> skipped,
                    List<FailedRecord> failed) { }

@executedBy(CODE) @role(rule_set) @stage("agent")
class ScanManifestSchema {

    boolean validate(ScanManifestDocument m, Theta θ) {
        // all 8 top-level keys required; no extra keys
        if (m.schema_version != "1") return false;                                   // src: vulnhunter-agent/scan_manifest.schema.json:21 (consumers fail closed on mismatch)
        if (!Regex.match("^.+_VULNHUNT_RESULTS_.+$", m.scan_id)) return false;        // src: vulnhunter-agent/scan_manifest.schema.json:26
        // unclear: description lists exit codes 0,1,3,4,5 but the enum is 0..4
        if (!θ["code.scan_manifest_schema.agent_exit_code_enum"].contains(m.agent_exit_code)) return false; // src: vulnhunter-agent/scan_manifest.schema.json:31
        if (m.cost_usd < 0) return false;                                            // src: vulnhunter-agent/scan_manifest.schema.json:36
        for (ManifestFinding f : m.findings) if (!validFinding(f, θ)) return false;  // src: vulnhunter-agent/scan_manifest.schema.json:41 (empty list valid: exit 1)
        for (PostedRecord p : m.posted) {
            if (!validVulnId(p.finding_id)) return false;                            // src: vulnhunter-agent/scan_manifest.schema.json:169
            if (!validIssueUrl(p.url, θ)) return false;                              // src: vulnhunter-agent/scan_manifest.schema.json:171
        }
        for (SkippedRecord s : m.skipped) {
            if (s.matched_issue_numbers.size() < 1 || s.matched_issue_numbers.anyMatch(n -> n < 1)) return false; // src: vulnhunter-agent/scan_manifest.schema.json:183
        }
        return true;
    }

    boolean validVulnId(String id) {
        return Regex.match("^VULN-\\d<3>$", id);                                     // src: vulnhunter-agent/scan_manifest.schema.json:63 (exactly 3 digits)
    }

    boolean validFinding(ManifestFinding f, Theta θ) {
        // all 16 fields required (θ["p.issues_extract.finding_schema_fields"]); strings may be empty when undetermined
        if (!validVulnId(f.id)) return false;                                        // src: vulnhunter-agent/scan_manifest.schema.json:110
        if (!θ["p.issues_extract.severity_values"].contains(f.severity) && f.severity != "") return false; // src: vulnhunter-agent/scan_manifest.schema.json:68
        if (f.cwe != "" && !Regex.match("^CWE-\\d+$", f.cwe)) return false;          // src: vulnhunter-agent/scan_manifest.schema.json:74
        if (!Regex.match("^[0-9a-f]<16>$", f.vulnfix_key)) return false;              // src: vulnhunter-agent/scan_manifest.schema.json:81 (θ["p.idempotency-key-rule.key_derivation"])
        return true;                                                                 // poc_path / exploit_test_path: string or null
    }

    boolean validIssueUrl(String url, Theta θ) {
        // enterprise hosts allowed; owner/repo/number parsed by the scan worker
        if (θ["code.scan_manifest_schema.issue_url_https_only"]) return Regex.match("^https://[^/]+/[^/]+/[^/]+/issues/\\d+$", url); // src: vulnhunter-agent/scan_manifest.schema.json:86
        return Regex.match("^https?://[^/]+/[^/]+/[^/]+/issues/\\d+$", url);
    }
}
