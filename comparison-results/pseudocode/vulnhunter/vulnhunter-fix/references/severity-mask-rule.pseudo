// file: vulnhunter-fix/references/severity-mask-rule.md
// Rule book (REQ-GAT-002, REQ-SEC-001, REQ-GAT-008): mask the top-severity word in every delivered text; 5-phrase safe-list.
// Consumed by scripts/check-severity-mask.py (Gate 1, read-time, pre-deliver) and vulnhunter_fix/delivery.py:SAFE_PHRASE_PATTERNS
// (write-time, through the worker manual-mask discipline in prompts/worker_agent_common.md).

@executedBy(MODEL) @role(rule_set) @stage("fix.deliver")
class SeverityMaskRule {

    // Entry: write-time mask (model writes "High+" instead), then Gate 1 scan.
    boolean apply(DeliveryTexts texts, Theta θ) {
        List<String> surfaces = θ["p.severity-mask-rule.scan_surfaces"];                          // src: vulnhunter-fix/references/severity-mask-rule.md:7
        for (String s : surfaces) {
            texts.set(s, maskWhenWriting(texts.get(s), θ));
        }
        return gate1(texts, surfaces, θ);
    }

    String maskWhenWriting(String text, Theta θ) {
        // the masked top severity is written as the replacement term
        return text.replaceSeverity(θ["p.severity-mask-rule.masked_replacement_term"]);            // src: vulnhunter-fix/references/severity-mask-rule.md:17
    }

    List<String> safeList(Theta θ) {
        List<String> safe = θ["p.severity-mask-rule.safe_phrase_list"];                            // src: vulnhunter-fix/references/severity-mask-rule.md:19
        if (θ["p.severity-mask-rule.never_widen_safe_list"]) {                                     // src: vulnhunter-fix/references/severity-mask-rule.md:29
            // never add a phrase that widens semantic scope ("critically important" is NOT safe)
            assert !safe.contains("critically important");
        }
        if (θ["p.severity-mask-rule.safe_list_dual_location_sync"]) {                              // src: vulnhunter-fix/references/severity-mask-rule.md:45
            Ci.assertByteEqual(Delivery.SAFE_PHRASE_PATTERNS, CheckSeverityMask.SAFE_PHRASE_PATTERNS); // safe-phrase-sync-lint.py
        }
        return safe;
    }

    boolean matchesSafePhrase(String text, Span m, Theta θ) {
        for (String phrase : safeList(θ)) {
            boolean exactCase = phrase == "Critical Section" && θ["p.severity-mask-rule.critical_section_exact_caps"]; // src: vulnhunter-fix/references/severity-mask-rule.md:25
            for (Span sp : text.findAll(phrase, exactCase ? CASE_SENSITIVE : IGNORECASE)) {
                if (θ["p.severity-mask-rule.safe_phrase_containment_check"] == "containment check") {          // src: vulnhunter-fix/references/severity-mask-rule.md:15
                    if (sp.contains(m)) return true;                                                           // containment, not lookaround
                }
            }
        }
        return false;
    }

    @executedBy(CODE)
    boolean gate1(DeliveryTexts texts, List<String> surfaces, Theta θ) {
        String re = θ["p.severity-mask-rule.critical_regex"];                                     // src: vulnhunter-fix/references/severity-mask-rule.md:9
        int flags = θ["p.severity-mask-rule.case_insensitive_with_inflections"] ? IGNORECASE : 0; // src: vulnhunter-fix/references/severity-mask-rule.md:15
        for (String s : surfaces) {
            String text = texts.get(s);
            for (Span m : Regex.finditer(re, text, flags)) {
                if (!matchesSafePhrase(text, m, θ)) {
                    if (θ["p.severity-mask-rule.unsafe_occurrence_fails_gate"]) return false;    // src: vulnhunter-fix/references/severity-mask-rule.md:7
                }
            }
        }
        return true;
    }
}
