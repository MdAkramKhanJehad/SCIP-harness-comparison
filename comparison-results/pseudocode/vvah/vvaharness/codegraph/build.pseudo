// file: vvaharness/codegraph/build.py
// S0: builds the one code graph a scan analyses (context-graph-sdk Workspace on an ArcadeDB backend, plus enrichers),
// and the degenerate-graph test that decides whether graph-evidence demands can be enforced.

@executedBy(CODE) @role(step) @stage("S0")
class Build {

    // _MIN_GRAPH_NODES_FOR_GATE = 10: builtin fallback of step0.min_graph_nodes_for_gate. src: vvaharness/codegraph/build.py:31

    /** Analyse; on any failure close the workspace and re-raise. */
    CodeGraph analyze(Workspace workspace, String repoRoot, String projectId, List<GraphEnricher> enrichers) {
        try {
            return workspace.analyze(repoRoot, projectId, enrichers);                             // src: vvaharness/codegraph/build.py:37
        } catch (Exception e) {
            workspace.close();                                                                    // src: vvaharness/codegraph/build.py:39
            throw e;                                                                              // src: vvaharness/codegraph/build.py:40
        }
    }

    /** Plugin names for logging; a malformed one is reported as "?". */
    List<String> enricherNames(List<Object> plugins) {
        try { return plugins.map(p -> str(getattr(p.metadata, "name", "?"))); } catch (Exception e) { return plugins.map(p -> "?"); } // src: vvaharness/codegraph/build.py:46
    }

    /** Analyse repoRoot into a fresh workspace. Any backend or plugin failure propagates and aborts the scan (no graph-less fallback). */
    GraphHandle buildGraph(String repoRoot, String projectId, Path workspaceDir, List<GraphEnricher> enrichers, Theta θ) {
        List plugins = List.copyOf(enrichers);                                                    // src: vvaharness/codegraph/build.py:56
        List<String> names = enricherNames(plugins);                                              // src: vvaharness/codegraph/build.py:57
        Workspace workspace = new Workspace(workspaceDir, BackendFactory.of(θ["code.codegraph.build.graph_backend"])); // ArcadeDBBackendFactory. src: vvaharness/codegraph/build.py:58
        CodeGraph graph = analyze(workspace, repoRoot, projectId, plugins);                       // src: vvaharness/codegraph/build.py:59
        for (String name : names) Counters.bump("s0_graph_enricher_ran:" + name);                 // src: vvaharness/codegraph/build.py:60
        GraphInfo info = graph.info();                                                            // src: vvaharness/codegraph/build.py:62
        return new GraphHandle(workspace, graph, projectId, info.nodeCount, info.edgeCount, names); // src: vvaharness/codegraph/build.py:63
    }

    /** True when ctx's graph cannot back a require_graph evidence demand. Unmeasured node count is NOT degenerate. */
    boolean graphIsDegenerate(Object ctx, Theta θ) {
        GraphHandle handle = getattr(ctx, "graph_handle", null);                                                     // src: vvaharness/codegraph/build.py:74
        if (handle == null) return true;                                                          // src: vvaharness/codegraph/build.py:75
        if (θ["code.codegraph.build.degenerate_on_zero_edges"] && handle.edgeCount != null && handle.edgeCount == 0) return true; // src: vvaharness/codegraph/build.py:77
        if (handle.nodeCount == null) return false;                                               // src: vvaharness/codegraph/build.py:80
        int minNodes = θ["step0.min_graph_nodes_for_gate"];                                       // fallback 10. src: vvaharness/codegraph/build.py:82
        return handle.nodeCount < minNodes;                                                       // src: vvaharness/codegraph/build.py:83
    }
}
