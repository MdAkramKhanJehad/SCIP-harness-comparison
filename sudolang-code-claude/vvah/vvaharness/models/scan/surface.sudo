// src: vvaharness/models/scan/surface.py:27-43
_EP_KINDS = ["network", "ipc", "file", "cli", "deserialization", "framework", "other"]
_EP_KIND_ALIAS = {
  rpc, grpc, http, https, rest, api, graphql, websocket, ws, soap, tcp, udp, socket, webhook, endpoint => "network";
  queue, message, mq, kafka, amqp, jms, pubsub, event, signal, pipe, bus => "ipc";
  stdin, argv, command, arg => "cli";
  config, env, filesystem, fs => "file";
  deserialize, serde, unmarshal, parse, pickle, json => "deserialization";
  spring, django, aspnet => "framework"
}

// src: vvaharness/models/scan/surface.py:46-55
EntryPoint {
  file: String
  function: String
  kind: "network" | "ipc" | "file" | "cli" | "deserialization" | "framework" | "other"
  reachable_from_unauth: Boolean = false
  // coercion (before validation): kind = _coerce_enum(kind, _EP_KINDS, _EP_KIND_ALIAS, default="other")
}

// src: vvaharness/models/scan/surface.py:58-70
Sink {
  // an unsafe call site flagged by static grep
  file: String
  line: Number = 0          // coercion: _coerce_int(line, 0)
  function: String          // strcat, memcpy, sprintf, system, ...
  snippet: String = ""      // the offending line, about 120 characters at most (not enforced here)
  cwe: String[] = []        // from Stage 0 seed-rule metadata, for example ["CWE-89"]; empty for agent-discovered sinks
}

// src: vvaharness/models/scan/surface.py:73-82
ModuleInfo {
  name: String
  files: String[] = []
  loc: Number = 0           // rough lines of code; coercion: _coerce_int(loc, 0)
  purpose: String = ""      // one-line summary from the mapper
}
