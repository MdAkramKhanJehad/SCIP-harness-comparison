// file: vvaharness/remediation_agent/policy_gate/matching.py
// The deterministic path-glob primitives the gate and the diff inspection share (fnmatch plus a leading double-star fallback).

@executedBy(CODE) @role(rule_set) @stage("S10")
class Matching {

    boolean globMatch(String path, String pat) {
        // fnmatch, plus a double-star-slash prefix fallback so a bare root-level file still matches a pattern like double-star-slash-x.
        if (Fnmatch.match(path, pat)) return true;                                                  // src: vvaharness/remediation_agent/policy_gate/matching.py:23
        if (pat.startsWith("**/") && Fnmatch.match(path, pat.substring(3))) return true;           // src: vvaharness/remediation_agent/policy_gate/matching.py:25
        return false;                                                                               // src: vvaharness/remediation_agent/policy_gate/matching.py:27
    }

    String firstMatch(List<String> files, List<String> patterns) {
        // Returns the first pattern that any file hits, scanning files in order and patterns in order; null when none hits.
        for (String f : files != null ? files : List.of()) {                                        // src: vvaharness/remediation_agent/policy_gate/matching.py:31
            String nf = (f != null ? f : "").replace("\\", "/");                                    // src: vvaharness/remediation_agent/policy_gate/matching.py:32  (backslashes normalised)
            if (nf.isEmpty()) continue;                                                             // src: vvaharness/remediation_agent/policy_gate/matching.py:33
            for (String pat : patterns) {                                                           // src: vvaharness/remediation_agent/policy_gate/matching.py:35
                if (globMatch(nf, pat)) return pat;                                                 // src: vvaharness/remediation_agent/policy_gate/matching.py:36
            }
        }
        return null;                                                                                // src: vvaharness/remediation_agent/policy_gate/matching.py:38
    }
}
