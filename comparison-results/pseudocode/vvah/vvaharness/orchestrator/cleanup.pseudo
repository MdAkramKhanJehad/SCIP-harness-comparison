// file: vvaharness/orchestrator/cleanup.py
// Batch clone purge: delete the cloned source under a repo root but keep the artifact folders, with a Windows-safe rmtree.

@executedBy(CODE) @role(io)
class Cleanup {

    /** rmtree that clears the read-only bit on error (Windows RO .git/objects/* otherwise make a plain rmtree silently leave the tree). */
    @src("vvaharness/orchestrator/cleanup.py:31")
    void rmtreeRw(Path path) {
        Files.rmtree(path, (func, p, excInfo) -> onErr(func, p, excInfo));                                  // src: vvaharness/orchestrator/cleanup.py:38
    }

    /** rmtree error handler: chmod to writable and retry once; any second failure is swallowed. */
    @src("vvaharness/orchestrator/cleanup.py:33")
    void onErr(Function func, Path p, Object excInfo) {
        try {
            Files.chmod(p, WRITABLE);                                                                       // src: vvaharness/orchestrator/cleanup.py:35
            func.apply(p);                                                                                  // src: vvaharness/orchestrator/cleanup.py:36
        } catch (Exception e) {
            // swallowed                                                                                    // src: vvaharness/orchestrator/cleanup.py:38
        }
    }

    /** Folders kept when a batch clone is purged: output.preserve_on_cleanup, else the scan and case artifact dirs. A case file not listed is data loss, not a stale artefact. */
    @src("vvaharness/orchestrator/cleanup.py:46")
    Set<String> preserveSet(Theta θ) {
        List<String> vals = θ["output.preserve_on_cleanup"];                                                // src: vvaharness/orchestrator/cleanup.py:47
        return (vals != null && !vals.isEmpty()) ? Set.copyOf(vals) : Set.of(Artifacts.SCAN_DIR_NAME, Artifacts.CASE_DIR_NAME); // src: vvaharness/orchestrator/cleanup.py:48
    }

    /** Delete the cloned source under root but preserve the named artifact folders; then warn about any survivor. */
    @src("vvaharness/orchestrator/cleanup.py:51")
    void purgeClone(Path root, Set<String> keep) {
        if (!root.exists()) return;                                                                         // src: vvaharness/orchestrator/cleanup.py:53
        for (Path child : root.children()) {                                                                // src: vvaharness/orchestrator/cleanup.py:55
            if (keep.contains(child.name)) continue;                                                        // src: vvaharness/orchestrator/cleanup.py:56
            if (child.isDir()) {
                rmtreeRw(child);                                                                            // src: vvaharness/orchestrator/cleanup.py:58
            } else {
                try { Files.chmod(child, WRITABLE); } catch (OSError e) { }                                 // src: vvaharness/orchestrator/cleanup.py:61
                Files.unlinkIfExists(child);                                                                // src: vvaharness/orchestrator/cleanup.py:65
            }
        }
        // a failed delete would otherwise leave a secret-bearing clone on disk with no signal
        List<String> leftover = root.children().filter(c -> !keep.contains(c.name)).map(c -> c.name);      // src: vvaharness/orchestrator/cleanup.py:68
        if (!leftover.isEmpty()) log.warning(Events.PURGE_LEFTOVER, root, leftover.size(), leftover.sorted()); // src: vvaharness/orchestrator/cleanup.py:70
    }
}
