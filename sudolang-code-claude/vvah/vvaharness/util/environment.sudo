# vvaharness/util/environment.py

The environment readiness engine shared by `vvaharness setup` and `vvaharness doctor`. Each check returns ok, warn or fail; a required fail makes setup and doctor exit nonzero. Credentials are reported by presence only, never by value.

Source: `vvaharness/util/environment.py` (lines 1-901)
Executor: code
Called from: `vvaharness/cli/_setup.py` and `vvaharness/cli/_commands.py` (setup and doctor: `run_checks`, `summarize`, `detect_gateway`, `detect_ca_cert`, `recommend_profile`); `vvaharness/orchestrator/preflight.py` (`langsmith_tracing_check`, `_gateway_check`, `_backend_credential_ok`) and `vvaharness/orchestrator/scan.py` (`_backend_credential_ok`)

// src: vvaharness/util/environment.py:46-57
OK = "ok"; WARN = "warn"; FAIL = "fail"
Check {
  name; status: OK | WARN | FAIL; detail
  required = false   // "A FAIL blocks setup/doctor (exit non-zero) but NOT `scan`: nothing there calls run_checks"
}

// src: vvaharness/util/environment.py:871-893
fn run_checks(cfg_path):executor=code {
  // display order
  checks = [python_check(), tool_check("git", "batch --repo-file cloning"), tool_check("pip3", "installing optional extras")]
  checks += agent_checks()
  checks += credential_checks()
  checks += langsmith_tracing_check()
  checks += dep_checks()             // ends with graph_sdk_check()
  checks += anthropic_version_check()
  checks += tls_check()
  client_tls = client_tls_check(cfg_path); if (client_tls != null) checks += client_tls
  checks += remediation_inputs_check()
  cfg_checks = config_check(cfg_path)
  if (cfg_checks) checks += [cfg_checks[0], dotenv_check(), overlay_check(cfg_path), ...cfg_checks[1..]]
  return checks
}

// src: vvaharness/util/environment.py:896-901
fn summarize(checks):executor=code {
  return [count status OK, count status WARN, count (status FAIL && required)]
  // preserved: the docstring says required fails "are what block a scan", while the Check comment (line 56) says they do not block `scan`
}

// src: vvaharness/util/environment.py:77-94
fn python_check():executor=code {
  floor = (3, 10)   // used for a source tree; otherwise read ">= X.Y" from the installed package's Requires-Python
  if (interpreter major.minor >= floor) return Check("Python", OK)
  return Check("Python", FAIL, "requires >= floor", required=true)
}

// src: vvaharness/util/environment.py:97-102
fn tool_check(cmd, why, required=false):executor=code {
  return if (cmd on PATH) Check(cmd, OK, path) else Check(cmd, if (required) FAIL else WARN, "not on PATH ($why)", required)
}

// src: vvaharness/util/environment.py:106-154
_AGENTS = [
  ("Claude Code", "claude", (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN), "via:cli"),
  ("OpenAI Codex", "codex", (OPENAI_API_KEY), "via:openai"),
  ("Gemini CLI", "gemini", (GEMINI_API_KEY, GOOGLE_API_KEY), "—"),
  ("Cursor Agent", "cursor-agent", (), "—"),
  ("GitHub Copilot CLI", "copilot", (), "via:cli")
]
fn agent_checks():executor=code {
  oauth = _claude_code_login_present()   // ~/.claude/.credentials.json exists, or ~/.claude.json has oauthAccount; "FALSE NEGATIVE BY DESIGN" (macOS Keychain login invisible), never a gate
  for each agent {
    if (command not on PATH) { WARN "not installed"; continue }
    has_auth = (no keys listed) || any key environment variable set || (cmd == "claude" && oauth)
    status = if (has_auth) OK else WARN   // "login not detected", never "not logged in"
  }
}

// src: vvaharness/util/environment.py:158-197
_DEPS = [("pydantic", required), ("yaml", required), ("anthropic", required), ("tree_sitter", optional), ("tree_sitter_language_pack", optional), ("openai", optional)]
fn dep_checks():executor=code {
  for each (mod, required) in _DEPS {
    match {
      case importable => OK
      case required => FAIL "missing", required=true
      case mod == "tree_sitter" => WARN "NOT INSTALLED — call graph falls back to regex (degraded taint coverage)"
      case mod == "tree_sitter_language_pack" => WARN "NOT INSTALLED — tree-sitter AST plugins unavailable; call graph degrades"
      default => WARN "missing (optional — needed only for via:openai)"
    }
  }
  append graph_sdk_check()
}

// src: vvaharness/util/environment.py:200-241
fn graph_sdk_check():executor=code {
  sdk = directory of importable context_graph_sdk
  require sdk != null => Check(FAIL, "not importable — S0/S1 cannot build the code graph", required=true)
  require no standalone "context-graph-sdk" distribution is installed => Check(FAIL, "... shadows it and fails S0/S1. Uninstall it", required=true)
  own = directory of vvaharness
  if (own == null || sdk is a sibling of own || sdk == own.parent/vendor/context_graph_sdk/src/context_graph_sdk) return Check(OK, "bundled")
  return Check(FAIL, "SHADOWED by an external install ... fails S0/S1 with SnapshotLifecycleError", required=true)
}

// src: vvaharness/util/environment.py:244-285
fn anthropic_version_check():executor=code {
  if (no "anthropic" distribution metadata) return Check(OK, "no version metadata found")   // deliberately not a fail: dep: anthropic already blocks
  spec = first Requires-Dist of vvaharness matching /anthropic\s*[\[<>=!~]/
  ceiling = first "<X" clause in spec   // no assumption about clause order
  if (!ceiling) return Check(OK, "no declared ceiling")
  if (numeric release of installed < numeric release of ceiling) return Check(OK)
  return Check(FAIL, "out of the supported range — run pip install 'anthropic<ceiling'", required=true)
  // abstracted: _release takes the digits of the version core (epoch and local part stripped); not full PEP 440
}

// src: vvaharness/util/environment.py:289-301
fn credential_checks():executor=code {
  for each env in [ANTHROPIC_SDK_API_KEY, ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, OPENAI_API_KEY, GEMINI_API_KEY, GITHUB_TOKEN], Check("cred: $env", if (set) OK "set" else WARN "unset");
}

// src: vvaharness/util/environment.py:305-349
fn langsmith_tracing_check():executor=code {
  // gate groups in order: (LANGSMITH_TRACING_V2, LANGCHAIN_TRACING_V2), then (LANGSMITH_TRACING, LANGCHAIN_TRACING)
  // the first non-empty variable found wins; tracing is on only when its value is exactly "true"
  gate = that variable name if enabled, else null
  if (gate == null) return Check(OK, "disabled")
  if (langsmith package not importable) return Check(OK, "... no tracing can occur")
  return Check(WARN, "$gate=true — every model prompt (which contains scanned repository source) and every completion will be sent to the LangSmith service, ...")   // WARN, never FAIL: a lab may trace deliberately
}

// src: vvaharness/util/environment.py:352-368
fn _gateway_check():executor=code {
  if (ANTHROPIC_BASE_URL set) return Check("via:sdk endpoint", OK, base URL without its query string)
  if (_looks_like_jwt(ANTHROPIC_API_KEY)) return Check(FAIL, "ANTHROPIC_API_KEY looks like a gateway/Claude-Code token (eyJ…) but ANTHROPIC_BASE_URL is unset — it will 401 against the public API. ...", required=true)
  return Check(OK, "public api.anthropic.com (default)")
}
// src: vvaharness/util/environment.py:64-74
fn _looks_like_jwt(v):executor=code {
  return v starts with "eyJ" || (v starts with "ey" && v has exactly three non-empty dot-separated parts)
}

// src: vvaharness/util/environment.py:371-403
fn detect_gateway():executor=code {
  // read only; ANTHROPIC_BASE_URL from the environment, else the first match of ANTHROPIC_BASE_URL=http(s)://... in ~/.zshrc, ~/.zprofile, ~/.bashrc, ~/.bash_profile, ~/.profile (commented lines match too, deliberately)
}
fn detect_ca_cert():executor=code {
  return NODE_EXTRA_CA_CERTS if it names a file, else ~/cacerts.pem if it exists, else null
}

// src: vvaharness/util/environment.py:406-430
fn recommend_profile():executor=code {
  cli_auth = claude on PATH && (_looks_like_jwt(ANTHROPIC_API_KEY) || ANTHROPIC_AUTH_TOKEN set || CLAUDE_CODE_OAUTH_TOKEN set || _claude_code_login_present())
  match {
    case cli_auth && ANTHROPIC_SDK_API_KEY set => "default"
    case cli_auth => "default"
    case ANTHROPIC_SDK_API_KEY set => "sdk"
    case OPENAI_API_KEY set => "full"
    default => null, "no usable credential detected yet"
  }
}

// src: vvaharness/util/environment.py:433-446
fn dotenv_check():executor=code {
  [path, source, rejected] = vvaharness.cli._dotenv_selection()   // external to this batch
  // WARN when any untrusted .env file was ignored; otherwise OK (found or not found)
}

// src: vvaharness/util/environment.py:449-482
fn overlay_check(cfg_path):executor=code {
  local = sibling of cfg_path named LOCAL_OVERLAY_NAME   // see config/constants.sudo
  match {
    case local does not exist => OK "not found (optional)"
    case env NO_LOCAL_CONFIG_ENV set => OK "present but skipped"
    case POSIX && !config._local_overlay_trusted(local) => FAIL "untrusted — must be owned by the invoking user (or root) and not group/world-writable", required=true
    default => _applied_overlay_check: FAIL (required) if it does not load or is not a mapping; else OK listing overridden leaf keys with resolved values
  }
}

// src: vvaharness/util/environment.py:485-494
fn _via_gap_check(name, gap, roles, hint=""):executor=code {
  // mirrors preflight._report_credential_gap: a gap affecting any detection role fails; one confined to post-scan roles (POST_SCAN_ROLES, Stages 10 and 11) only warns
  return if (roles is not a subset of POST_SCAN_ROLES) Check(FAIL, "$gap (required by this profile)", required=true) else Check(WARN, "... that stage will be skipped")
}

// src: vvaharness/util/environment.py:497-596
fn config_check(cfg_path):executor=code {
  require cfg_path exists => [Check("config", FAIL, required=true)]
  try cfg = config.load(cfg_path); catch => return [Check("config", FAIL, "failed to load", required=true)]
  nodes = config_paths._iter_model_roles(cfg)   // MUST be this walk; a hand-rolled one injected a phantom `cli` backend
  roles_by_via = group roles by (node.via or "cli")
  out += Check("active backends", OK)
  if (any role with via deepagents is not in DEEPAGENTS_ROLES) out += Check("via:deepagents roles", FAIL, required=true)
  if (any unrecognized model key) out += Check("model config keys", WARN)   // a typo silently changes nothing; never fatal
  if ("sdk" in vias) {
    out += _gateway_check()
    has_sdk_key = ANTHROPIC_SDK_API_KEY set || cfg.sdk.api_key
    sdk_sole = vias is a subset of {"sdk", "deepagents"}
    fallback = sdk_sole && (ANTHROPIC_API_KEY set || ANTHROPIC_AUTH_TOKEN set)
    if (!has_sdk_key && fallback) out += Check(OK, "using ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN fallback")
    else if (!has_sdk_key) out += _via_gap_check("via:sdk credential", "ANTHROPIC_SDK_API_KEY not set", roles_by_via.sdk)
    for each optional (ANTHROPIC_SDK_BASE_URL / base_url, ANTHROPIC_SDK_CA_CERT / ca_cert, ANTHROPIC_SDK_CLIENT_CERT / client_cert), OK if set in environment or cfg.sdk, else WARN "unset (optional)";
  }
  if ("openai" in vias && OPENAI_API_KEY unset) out += _via_gap_check("via:openai credential", ...)
  if ("cli" in vias && claude not on PATH) out += _via_gap_check("via:cli backend", ...)
  out += _deepagents_checks(nodes, cfg, gateway_done = "sdk" in vias)
  out += _remediate_checks(cfg)   // Stage 10: WARN only
  out += _validate_checks(cfg)    // Stage 11: WARN only
}

// src: vvaharness/util/environment.py:599-611
fn remediation_inputs_check():executor=code {
  require remediation_agent.rule_paths.missing_rules() is empty => Check(FAIL, "missing ...; run interactive `vvaharness setup`", required=true)
}

// src: vvaharness/util/environment.py:614-657
fn _backend_credential_ok(via, model_id="", provider?, cfg?):executor=code {
  match (via) {
    case "cli" => claude on PATH
    case "sdk" => ANTHROPIC_SDK_API_KEY || ANTHROPIC_API_KEY || ANTHROPIC_AUTH_TOKEN set
    case "openai" => OPENAI_API_KEY set
    case "deepagents" => if (!routes_to_anthropic(model_id, provider)) (cfg.openai.api_key || OPENAI_API_KEY) else (cfg.sdk.api_key || ANTHROPIC_API_KEY || ANTHROPIC_AUTH_TOKEN)
    default => true
  }
}

// src: vvaharness/util/environment.py:660-699
fn _deepagents_checks(nodes, cfg, gateway_done):executor=code {
  // credentials are checked per (model id, provider) target, sorted with null provider as ""
  for each target with its roles {
    blocking = roles not a subset of POST_SCAN_ROLES
    status = if (ready) OK else if (blocking) FAIL else WARN; required = blocking && !ready
  }
  if (any target routes to Anthropic && !gateway_done) append _gateway_check() as "via:deepagents endpoint"
}

// src: vvaharness/util/environment.py:702-746
fn _remediate_checks(cfg):executor=code {
  if (!knob("step_remediate.enabled", default=false)) return []
  // models.remediate unset -> WARN "remediation will be skipped"; else OK or WARN by _backend_credential_ok(models.remediate.via default "cli")
}
fn _validate_checks(cfg):executor=code {
  if (!knob("step_validate.enabled", default=false)) return []
  // validate_model_spec(cfg) null -> WARN "validation will be skipped"; else normalize_validate_backend (legacy via:openai routes to deepagents) and OK or WARN by credential
  // plus OK/WARN for claude_agent_sdk importable
}

// src: vvaharness/util/environment.py:749-788
fn tls_check():executor=code {
  // one TLS handshake (timeout 8 seconds) to ANTHROPIC_BASE_URL or https://api.anthropic.com, port default 443, trusting NODE_EXTRA_CA_CERTS when it names a file
  try handshake => OK;
  catch certificate verification error => WARN, suggesting SSL_CERT_FILE (detected bundle from detect_ca_cert if any)
  catch other error => WARN "skipping CA determination; the live probe will confirm"   // never FAIL
}

// src: vvaharness/util/environment.py:791-868
fn client_tls_check(cfg_path):executor=code {
  // null when nothing can be decided: unreadable configuration, no via:sdk or Anthropic-routed deepagents role, or a network error
  roles = roles with via "sdk", or via "deepagents" routed to Anthropic
  if (roles empty) return null
  base = cfg.sdk.base_url || ANTHROPIC_BASE_URL || "https://api.anthropic.com"
  [ctx, source] = _client_trust(cfg.sdk, cfg_path)   // sdk.ca_cert (resolved against the profile directory) wins; else httpx2 trust with SSL_CERT_FILE / SSL_CERT_DIR; else the OS store
  try handshake(ctx) => return Check(OK);
  catch certificate verification error => continue below
  catch other => return null
  blocking = roles not a subset of POST_SCAN_ROLES
  if (handshake with NODE_EXTRA_CA_CERTS bundle also fails or no bundle) return Check(WARN, "set SSL_CERT_FILE (or sdk.ca_cert) ...")
  return Check(if (blocking) FAIL else WARN, "... accepted with NODE_EXTRA_CA_CERTS, which only via:cli reads — scan preflight will fail ...", required=blocking)
}
