// file: vvaharness/validation/constants/policy.py
// Validation-specific tool policy: read-only allow-list for the orchestrator and the write gate.

@executedBy(CODE) @role(config) @stage("S11")
class ConstantsPolicy {

    ToolPolicy validationPolicy(Theta θ) {
        return new ToolPolicy(θ["code.validation.constants.policy.allowed_tools"],                   // Read, Grep, Glob, Agent  // src: vvaharness/validation/constants/policy.py:29
                              θ["code.validation.constants.policy.disallowed_tools"]);               // Write, Edit, NotebookEdit, Bash  // src: vvaharness/validation/constants/policy.py:30
    }

    Set<String> defaultAllowedOutputFiles(Theta θ) {
        return θ["code.validation.constants.policy.default_allowed_output_files"];                  // validation_report.json, synthesized_gates.json  // src: vvaharness/validation/constants/policy.py:34
    }
}
