# vvaharness/orchestrator/store/_db.py

The SQLite state database: where it lives, how it is opened and hardened against symlinks and loose permissions, schema migration, and run rows. Checkpoints and call graph snapshots live here, outside any scanned repository.

Source: `vvaharness/orchestrator/store/_db.py` (lines 1-300)
Executor: code
Called from: `vvaharness/orchestrator/checkpoints.py`, `vvaharness/orchestrator/scan.py` (`register_run`, `reset_run`, `state_root`, `ensure_state_dir`), `vvaharness/orchestrator/batch.py` (stage markers), `vvaharness/cli/_commands.py`

// src: vvaharness/orchestrator/store/_db.py:27-38
_SCHEMA_VERSION = 3
_REPLAY_MAX_BYTES = 1024 * 1024
_DB_FILE_MODE = 0o600       // payloads embed scanned source
_STATE_DIR_MODE = 0o700
_SIDECAR_SUFFIXES = ["-wal", "-shm", "-journal"]
_POSIX = operating system is POSIX   // every permission step is skipped on Windows
// src: vvaharness/orchestrator/store/_db.py:129
_DB_NAME = "vvaharness.db"

// src: vvaharness/orchestrator/store/_db.py:65-66
StoreError {
  // a state-store precondition the code refuses to work around: symlinked state directory or database, or a state root that is not a directory
  // entry.py and batch.py treat it as environment-wide (exit 2; batch stops)
}

// src: vvaharness/orchestrator/store/_db.py:69-73
fn state_root():executor=code {
  return environment VVAHARNESS_STATE_DIR || "~/.vvaharness/state"   // no input or output: scan.py resolves this before its safety check
}

// src: vvaharness/orchestrator/store/_db.py:76-125
fn ensure_state_dir(...parts):executor=code {
  root = state_root()
  if (_POSIX) require root is not a symlink (checked with lstat, before anything follows it) => throw StoreError("refusing to use state directory ...: it is a symlink")
  if (root is a directory) {
    if (_POSIX && root mode has any group or other bit) {
      if (environment VVAHARNESS_STATE_DIR is set) warn once "state directory ... is group/other-accessible ..."   // operator chose it: warn only
      else { tighten root to 0o700; warn once "tightened ... to 700" }      // default location: repaired
    }
  } else {
    try create root with parents; catch FileExistsError => throw StoreError("... exists and is not a directory")
    tighten root to 0o700
  }
  for each part in parts { create "$path/$part"; tighten to 0o700 }   // every level is tightened
  return path
}

// src: vvaharness/orchestrator/store/_db.py:132-160
fn db_location():executor=code { return state_root() + "/vvaharness.db" }   // creates nothing
fn db_path():executor=code { return ensure_state_dir() + "/vvaharness.db" }
fn run_exists(run_id):executor=code {
  require neither state_root() nor the database path is a symlink => throw StoreError
  if (database file missing) return false
  return a runs row exists for run_id   // opened read-only; any OSError or sqlite error becomes StoreError
}

// src: vvaharness/orchestrator/store/_db.py:163-179
fn _create_db_file_safe(path):executor=code {
  try { create path exclusively with O_NOFOLLOW and mode 0o600; return }   // pre-created before sqlite3 would create it at 0644
  catch OSError => {
    require path exists (lstat) => throw FileNotFoundError("could not create state DB ...")
    require path is not a symlink => throw StoreError("refusing to open state DB at ...: it is a symlink")
  }
}

// src: vvaharness/orchestrator/store/_db.py:182-213
fn connect():executor=code {
  path = db_path()
  if (_POSIX) _create_db_file_safe(path)
  con = open sqlite database at path
  PRAGMA foreign_keys = ON; PRAGMA busy_timeout = 30000; PRAGMA synchronous = NORMAL   // per connection
  have = PRAGMA user_version
  if (have != _SCHEMA_VERSION) {
    // src: _db.py:203-213
    if (have == 0) run _schema._DDL
    else { if (have < 2) run _schema._DDL_V2; if (have < 3) run _schema._DDL_V3 }   // cumulative
    PRAGMA user_version = 3
  }
  tighten the database file and each of its sidecars to 0o600 (best effort; failure warns once)
  return con
}

// src: vvaharness/orchestrator/store/_db.py:216-232
fn register_run(run_id, repo_root, repo_name?, app_id?):executor=code {
  upsert runs(run_id, repo_root, repo_name, app_id), updated_at = now   // gc ranks runs by recency
}

// src: vvaharness/orchestrator/store/_db.py:235-248
fn reset_run(run_id):executor=code {
  // called by scan.py for a fresh (non-resume) scan and when git HEAD moved
  in one transaction {
    delete every checkpoints row for run_id   // fixed stage steps and dynamic remediate_/validate_ steps alike
    delete every callgraph_snapshots row for run_id   // nodes, edges and stage refs cascade
  }
  // ev_replays and ev_probes are deliberately NOT cleared: replay bundles must outlive a rescan
  return number of rows cleared
}

// src: vvaharness/orchestrator/store/_db.py:251-275
fn steps_with_prefix(run_id, prefix):executor=code { return sorted step keys of run_id starting with prefix }
fn delete_steps(run_id, prefix, keep):executor=code {
  victims = sorted step keys of run_id starting with prefix and not in keep
  delete those rows in one transaction; return victims
}

// src: vvaharness/orchestrator/store/_db.py:278-300
fn delete_run_graphs(run_id):executor=code { delete state_root()/graphs/run_id, ignoring errors }
fn delete_run(run_id):executor=code {
  if (db_location() does not exist) return false   // never creates the database
  delete the runs row (checkpoints, replays, probes and call graph rows cascade)
  if (deleted) { PRAGMA incremental_vacuum; PRAGMA wal_checkpoint(TRUNCATE) }
  delete_run_graphs(run_id)
  return deleted > 0
}

