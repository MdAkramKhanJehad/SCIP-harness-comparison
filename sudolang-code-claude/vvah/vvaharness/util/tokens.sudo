# vvaharness/util/tokens.py

Process-wide token and spend accounting shared by every model backend: per-phase buckets, reported dollar and turn readings used to diff one engine call (budgets), and the single offline token estimator used to size prompts.

Source: `vvaharness/util/tokens.py` (lines 1-240)
Executor: code
Called from: every model backend (`TOKENS.add`), stages that scope phases (`TOKENS.phase("s4")`), budget checks that diff `TOKENS.spend()`, prompt sizing (`estimate_tokens`), `vvaharness/util/metrics.py` and `vvaharness/manifest.py` (snapshots for metrics and costing)

// src: vvaharness/util/tokens.py:28-37
TokenUsage {
  input_tokens: Number
  output_tokens: Number | null   // an explicit null is passed through, never `or 0`
  cache_creation_input_tokens: Number
  cache_read_input_tokens: Number
  reasoning_tokens: Number   // OpenAI detail already inside output_tokens; never added to a total again
}
DEFAULT_PHASE = "unscoped"   // src: tokens.py:40

// src: vvaharness/util/tokens.py:43-58
Spend { usd = 0.0; turns = 0; usd_reports = 0; turn_reports = 0 }
fn reported_between(before, after):executor=code {
  usd = if (after.usd_reports > before.usd_reports) after.usd - before.usd else null
  turns = if (after.turn_reports > before.turn_reports) after.turns - before.turns else null
  return [usd, turns]   // null means nothing was reported, never zero; assumes calls do not overlap
  // the docstring states it "assumes no overlap" between readings
}

// src: vvaharness/util/tokens.py:63-86
_CPT_PROSE = 4.4; _CPT_DENSE = 2.45; _DENSE_FRAC_LO = 0.08; _DENSE_FRAC_HI = 0.34
fn estimate_tokens(text):executor=code {
  n = length of text; if (n <= 0) return 0
  frac = (count of characters that are neither whitespace nor letters) / n
  cpt = match (frac) {
    case frac <= 0.08 => 4.4                               // prose
    case frac >= 0.34 => 2.45                              // dense numbered source
    default => 4.4 + ((frac - 0.08) / (0.34 - 0.08)) * (2.45 - 4.4)   // linear in between
  }
  return floor(n / cpt)
}

// src: vvaharness/util/tokens.py:89-93
fn _bucket() { return { prompt: 0, completion: 0, cache_read: 0, cache_write: 0, calls: 0, cache_unparsed: 0, usd: null, turns: null, reasoning: 0 } }

// src: vvaharness/util/tokens.py:98-112
_UNPARSED_CACHE_KEY_RX = /^[A-Za-z0-9_.\-]{1,64}$/; _UNPARSED_CACHE_KEY_CAP = 8
fn unparsed_cache_keys(usage, parsed):executor=code {
  // key NAMES only, never values (a hostile gateway could put anything there)
  if (usage is not a map) return ()
  return first 8 (sorted) keys k where k is a string, k not in parsed, value != null, "cache" in lower-case k, and k matches the pattern
}

// src: vvaharness/util/tokens.py:115-240
_TokenCounter {
  State { _phase = DEFAULT_PHASE; prompt; completion; calls; calls_with_usage; completion_absent; usd = 0.0; turns; usd_reports; turn_reports; by_phase: Map(phase -> _bucket()) }

  // src: tokens.py:135-141
  fn phase(name):executor=code {
    set _phase = name for the block
    constraint OnEveryExit { restore the previous phase }
    // _phase is one process-wide value, not per thread; the module comment (line 16) says "Per-phase buckets rely on phases NEVER overlapping (s4/s6 pools sit inside one), hence one global"
  }

  // src: tokens.py:147-194
  fn add(usage, usd?, turns?):executor=code {
    // under one lock
    n_requests = if (usage.calls is a positive integer, not a boolean) usage.calls else 1
    calls += n_requests; by_phase[_phase].calls += n_requests
    if (usd != null) { usd_reports += 1; usd += usd; bucket.usd = (bucket.usd or 0) + usd }
    if (turns != null) { turn_reports += 1; turns += turns; bucket.turns = (bucket.turns or 0) + turns }
    if (usage is not a map) return
    calls_with_usage += n_requests
    fresh = input_tokens or 0; cw = cache_creation_input_tokens or 0; cr = cache_read_input_tokens or 0
    if (output_tokens == null) { completion_absent += 1; warn once "a usage record carried a null completion count; coerced to 0" }
    out = output_tokens or 0
    prompt += fresh + cw; completion += out   // billable prompt = fresh + cache write; cache read tracked apart
    bucket.prompt += fresh + cw; bucket.completion += out; bucket.cache_read += cr; bucket.cache_write += cw
    bucket.reasoning += reasoning_tokens or 0   // detail only
  }

  // src: tokens.py:196-200
  fn spend() { return Spend(usd, turns, usd_reports, turn_reports) }   // point-in-time reading for diffing one engine call

  // src: tokens.py:202-213
  fn note_cache_unparsed(keys, via=""):executor=code {
    if (keys empty) return false
    by_phase[_phase].cache_unparsed += 1
    return true only the first time this (via, keys) pair is seen   // caller logs once per backend and key set
  }

  // src: tokens.py:215-237
  fn reset();   // zero everything
  fn snapshot() { return { prompt, completion, total: prompt + completion, calls, calls_with_usage, completion_absent, usd: if (usd_reports) usd else null, turns: if (turn_reports) turns else null, by_phase } }
}

TOKENS = _TokenCounter()   // src: tokens.py:240 — the single process-wide instance
