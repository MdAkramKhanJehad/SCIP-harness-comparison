// file: vulnhunter-fix/references/committed-test-naming-rule.md
// Rule book (REQ-GAT-013): scaffold test name during RED->GREEN, promotion before commit, and Gate 7 scaffold-leak check.
// Consumed by scripts/check-committed-test-naming.py (Gate 7 via scripts/run-gates.py, pre-deliver);
// the promotion is carried out in prompts/implement.md (IP-Step H) and prompts/worker_agent_common.md (Step G).

@executedBy(MODEL) @role(rule_set) @stage("fix.implement")
class CommittedTestNamingRule {

    // Entry: author -> promote (model, Phase 3), then Gate 7 (code, pre-deliver).
    int apply(Finding f, Branch branch, Theta θ) {
        TestFile t = authorScaffold(f, θ);
        promote(t, f, θ);
        return gate7(branch, θ);
    }

    TestFile authorScaffold(Finding f, Theta θ) {
        // name pattern verify_<VULN_ID>_* keeps it out of the repo's default collection while iterating
        return TestFile.create(θ["p.committed-test-naming-rule.scaffold_test_name"], f.vulnId);        // src: vulnhunter-fix/references/committed-test-naming-rule.md:7
    }

    void promote(TestFile t, Finding f, Theta θ) {
        if (θ["p.committed-test-naming-rule.promote_before_commit"]) {                                  // src: vulnhunter-fix/references/committed-test-naming-rule.md:7
            String name = RepoTypeAdapters.testFileConvention(f.language, θ);                          // src: vulnhunter-fix/references/committed-test-naming-rule.md:7
            t.renameTo(name);
            t.deleteScaffold();
        }
    }

    boolean isScaffold(String path, Theta θ) {
        String regex = θ["p.committed-test-naming-rule.scaffold_signature_regex"];                     // src: vulnhunter-fix/references/committed-test-naming-rule.md:14
        String subject = path;
        int flags = 0;
        if (θ["p.committed-test-naming-rule.signature_case_insensitive_basename"]) {                   // src: vulnhunter-fix/references/committed-test-naming-rule.md:17
            subject = basename(path);
            flags = IGNORECASE;
        }
        // anchoring on VULN means the repo's own verify_email.py / exploit_utils.go do not match
        if (!θ["p.committed-test-naming-rule.signature_anchored_on_vuln"]) {                            // src: vulnhunter-fix/references/committed-test-naming-rule.md:18
            regex = "^(?:verify|exploit)_";                                                              // unclear: unanchored variant is only implied as the thing avoided
        }
        return Regex.search(regex, subject, flags);
    }

    @executedBy(CODE)
    int gate7(Branch branch, Theta θ) {
        List<String> added = null;
        for (String ref : θ["p.committed-test-naming-rule.base_ref_resolution_order"]) {               // src: vulnhunter-fix/references/committed-test-naming-rule.md:23
            if (Git.resolves(ref)) {
                added = Git.diffNames(ref + "...HEAD", "--diff-filter=A");                              // src: vulnhunter-fix/references/committed-test-naming-rule.md:23
                break;
            }
        }
        if (added == null) {
            if (!θ["p.committed-test-naming-rule.no_base_fallback_head_with_warning"]) return 2;       // src: vulnhunter-fix/references/committed-test-naming-rule.md:24
            Log.warnLoud("no base ref; HEAD-only scan may miss scaffolds from earlier commits");      // src: vulnhunter-fix/references/committed-test-naming-rule.md:24
            added = Git.headAddedFiles();
        }
        for (String p : added) {
            if (isScaffold(p, θ) && θ["p.committed-test-naming-rule.gate7_fails_closed_on_leak"]) {   // src: vulnhunter-fix/references/committed-test-naming-rule.md:9
                return 1;                                                                                // src: vulnhunter-fix/references/committed-test-naming-rule.md:27
            }
        }
        if (!θ["p.committed-test-naming-rule.gate7_negative_invariant_only"]) {                         // src: vulnhunter-fix/references/committed-test-naming-rule.md:31
            // positive check (promoted name collected by the repo runner) belongs to the discrimination step, not Gate 7
        }
        return 0;                                                                                        // src: vulnhunter-fix/references/committed-test-naming-rule.md:27
    }
}
