// file: vvaharness/cli/_dotenv.py
// Selection and loading of a trusted .env from exactly cwd or home (never an ancestor, never inside the
// scan target unless VVAHARNESS_ALLOW_CWD_CONFIG is set); values never override the existing environment.

@executedBy(CODE) @role(config)
class Dotenv {

    /** Reject unsafe POSIX ownership/modes (file and parent owned by us, not group/world-writable). */
    boolean dotenvPathIsTrusted(Path path) {
        List<Stat> entries;
        try { entries = List.of(path.parent().stat(), path.stat()); }                                  // src: vvaharness/cli/_dotenv.py:32
        catch (OSError e) { return false; }                                                            // src: vvaharness/cli/_dotenv.py:34
        if (!Os.hasGeteuid()) return true;                                                             // non-POSIX: exact-location checks only // src: vvaharness/cli/_dotenv.py:36
        int uid = Os.geteuid();                                                                        // src: vvaharness/cli/_dotenv.py:38
        for (Stat e : entries) {
            if (e.uid != uid) return false;                                                            // src: vvaharness/cli/_dotenv.py:40
            if ((e.mode & (S_IWGRP | S_IWOTH)) != 0) return false;                                     // src: vvaharness/cli/_dotenv.py:42
        }
        return true;                                                                                   // src: vvaharness/cli/_dotenv.py:44
    }

    /** First accepted .env among cwd then home; returns (path, source, rejected candidates). */
    Triple<Path, String, List<Path>> dotenvSelection(String repo, boolean warn, Theta θ) {
        List<Pair<String, Path>> roots = new List();
        for (String source : List.of("cwd", "home")) {                                                 // order: cwd first // src: vvaharness/cli/_dotenv.py:51
            try { roots.add(Pair.of(source, (source == "cwd" ? Path.cwd() : Path.home()).realPath())); } catch (OSError e) { continue; } // src: vvaharness/cli/_dotenv.py:53
        }
        List<Path> rejected = new List(); Set<Path> seen = new Set();
        for (Pair<String, Path> r : roots) {
            if (seen.contains(r.second)) continue;                                                     // src: vvaharness/cli/_dotenv.py:60
            seen.add(r.second);
            Path candidate = r.second.resolve(".env");                                                 // src: vvaharness/cli/_dotenv.py:63
            if (!candidate.isFile()) continue;                                                         // src: vvaharness/cli/_dotenv.py:64
            Path path;
            try { path = candidate.realPathStrict(); } catch (OSError e) { continue; }                 // src: vvaharness/cli/_dotenv.py:67
            if (path.parent() != r.second || !dotenvPathIsTrusted(path)) {                             // symlinked elsewhere or unsafe perms // src: vvaharness/cli/_dotenv.py:70
                rejected.add(candidate);
                if (warn) Log.warning("DOTENV_UNTRUSTED");                                             // src: vvaharness/cli/_dotenv.py:73
                continue;
            }
            if (repo != null && !θ["code.orchestrator.config_paths.allow_cwd_config_env"]) {           // VVAHARNESS_ALLOW_CWD_CONFIG // src: vvaharness/cli/_dotenv.py:76
                if (ConfigPaths.pathWithin(path, Path.of(repo))) {                                     // .env inside the scan target // src: vvaharness/cli/_dotenv.py:78
                    rejected.add(candidate);
                    if (warn) Log.warning("DOTENV_INSIDE_TARGET");                                     // src: vvaharness/cli/_dotenv.py:81
                    continue;
                }
            }
            return Triple.of(path, r.first, rejected);                                                 // src: vvaharness/cli/_dotenv.py:84
        }
        return Triple.of(null, null, rejected);                                                        // src: vvaharness/cli/_dotenv.py:85
    }

    Path dotenvPath(String repo, boolean warn, Theta θ) {
        return dotenvSelection(repo, warn, θ).first;                                                   // src: vvaharness/cli/_dotenv.py:89
    }

    /** Load the trusted .env (python-dotenv optional), never overriding variables already set. */
    void loadDotenv(String repo, Theta θ) {
        if (!Module.available("dotenv")) return;                                                       // src: vvaharness/cli/_dotenv.py:95
        Path path = dotenvPath(repo, true, θ);                                                         // src: vvaharness/cli/_dotenv.py:98
        if (path == null) return;                                                                      // src: vvaharness/cli/_dotenv.py:99
        DotenvLib.load(path, false);                                                                   // override=False // src: vvaharness/cli/_dotenv.py:101
        Console.write("[env] loaded " + path);                                                         // src: vvaharness/cli/_dotenv.py:102
    }
}
