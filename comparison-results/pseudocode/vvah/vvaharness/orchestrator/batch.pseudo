// file: vvaharness/orchestrator/batch.py
// Batch mode (--repo-file): parse the repo list, drop skip-pattern repos, clone each (or each app group)
// and run one OrchestratorScan per repo or per application, resetting process-global state between them.

@executedBy(CODE) @role(pipeline)
class OrchestratorBatch {

    @src("vvaharness/orchestrator/batch.py:380")
    int runBatch(Path listFile, Args args, Config cfg, Theta θ) {
        String gitToken = θ["batch.git_token"];                                                             // src: vvaharness/orchestrator/batch.py:382
        String gitBase = θ["batch.git_base_url"];                                                           // src: vvaharness/orchestrator/batch.py:383
        List<Entry> entries;
        try {
            // a .csv without a Path column derives the clone URL from batch.git_base_url
            entries = listFile.suffix() == ".csv" ? parseRepoCsv(listFile, gitBase) : parseRepoFile(listFile); // src: vvaharness/orchestrator/batch.py:385
        } catch (ValueError e) {
            return 2;                                                                                       // src: vvaharness/orchestrator/batch.py:391
        }
        // case-insensitive fnmatch globs against RepoName, before cloning
        List<String> skipPats = θ["batch.skip_repo_patterns"];                                              // src: vvaharness/orchestrator/batch.py:395
        if (skipPats != null && !skipPats.isEmpty()) {
            entries = entries.filter(e -> !skipPats.any(p -> Fnmatch.match(e.repoName.lower(), p.lower()))); // src: vvaharness/orchestrator/batch.py:400
            if (entries.isEmpty()) return 2;                                                                // src: vvaharness/orchestrator/batch.py:411
        }
        Path workspace = Path.of(args.workspace);                                                           // src: vvaharness/orchestrator/batch.py:414
        if (args.groupByApp) return runBatchGrouped(entries, workspace, gitToken, args, cfg, θ);            // src: vvaharness/orchestrator/batch.py:417
        List<Result> results = new List();
        for (Entry entry : entries) {                                                                       // sequential, fresh context each // src: vvaharness/orchestrator/batch.py:422
            resetProcessGlobals();                                                                          // tokens, stages, counters, warn-once, redaction registry, guardrail abort // src: vvaharness/orchestrator/batch.py:428
            Path cloned = null;
            try {
                Path local = acquireRepo(entry.ref, workspace, gitToken, entry.repoName);                   // src: vvaharness/orchestrator/batch.py:443
                if (isRemote(entry.ref)) cloned = local;                                                    // src: vvaharness/orchestrator/batch.py:445
                if (args.stopAfter == "clone") { results.add(Result.ok(entry)); continue; }                 // src: vvaharness/orchestrator/batch.py:447
                ScanOutcome outcome = OrchestratorScan.run(local, entry.repoName, entry.applicationId, args, cfg, entry.repoName, null, θ); // src: vvaharness/orchestrator/batch.py:454
                results.add(Result.of(entry, outcome));                                                     // src: vvaharness/orchestrator/batch.py:456
            } catch (KeyboardInterrupt e) {
                throw e;                                                                                    // src: vvaharness/orchestrator/batch.py:467
            } catch (AuthenticationError | ProxyError | StoreError e) {
                throw e;                                                                                    // environment-wide: every remaining repo would fail // src: vvaharness/orchestrator/batch.py:468
            } catch (Exception e) {
                results.add(Result.failed(entry, e));                                                       // repo-scoped: keep the batch moving // src: vvaharness/orchestrator/batch.py:476
            } finally {
                if (cloned != null && !args.keepClones && args.stopAfter != "clone") CloneCleanup.purgeClone(cloned, CloneCleanup.preserveSet(θ)); // src: vvaharness/orchestrator/batch.py:481
            }
        }
        writeSummary(workspace, results);                                                                   // src: vvaharness/orchestrator/batch.py:484
        if (results.any(r -> r.status == "FAILED")) return 1;                                               // health outranks outcome // src: vvaharness/orchestrator/batch.py:503
        if (results.any(r -> r.status == "NOT_REMEDIATED")) return EXIT_NOT_REMEDIATED;                     // src: vvaharness/orchestrator/batch.py:505
        return 0;                                                                                           // src: vvaharness/orchestrator/batch.py:492
    }

    /** --group-by-app: clone every repo sharing an AppID under workspace/app_id and run ONE scan over it. */
    @src("vvaharness/orchestrator/batch.py:545")
    int runBatchGrouped(List<Entry> entries, Path workspace, String gitToken, Args args, Config cfg, Theta θ) {
        Map<String, List<Entry>> groups = entries.groupBy(e -> e.applicationId);                            // src: vvaharness/orchestrator/batch.py:550
        List<Result> results = new List();
        for (String appId : groups.sortedKeys()) {                                                          // src: vvaharness/orchestrator/batch.py:555
            Path appDir = workspace.resolve(sanitize(appId));                                               // sanitised: cannot escape the workspace // src: vvaharness/orchestrator/batch.py:558
            resetProcessGlobals();                                                                          // src: vvaharness/orchestrator/batch.py:565
            try {
                List<String> staged = new List();
                for (Entry r : groups.get(appId)) {
                    try {
                        acquireRepo(r.ref, appDir, gitToken, r.slug);                                       // src: vvaharness/orchestrator/batch.py:578
                        staged.add(r.slug);
                    } catch (StoreError e) { throw e;
                    } catch (Exception ce) { continue;                                                      // one failed clone skips that repo only // src: vvaharness/orchestrator/batch.py:583
                    }
                }
                if (staged.isEmpty()) throw new RuntimeError("all repos failed to stage");                  // src: vvaharness/orchestrator/batch.py:586
                if (args.stopAfter == "clone") { results.add(Result.ok(appId)); continue; }                 // src: vvaharness/orchestrator/batch.py:592
                ScanOutcome outcome = OrchestratorScan.run(appDir, appModuleName(appId), appId, args, cfg, null, null, θ); // src: vvaharness/orchestrator/batch.py:600
                results.add(Result.of(appId, outcome));
            } catch (KeyboardInterrupt | AuthenticationError | ProxyError | StoreError e) {
                throw e;                                                                                    // src: vvaharness/orchestrator/batch.py:613
            } catch (Exception e) {
                results.add(Result.failed(appId, e));                                                       // src: vvaharness/orchestrator/batch.py:619
            } finally {
                if (!args.keepClones && args.stopAfter != "clone") CloneCleanup.purgeClone(appDir, CloneCleanup.preserveSet(θ)); // src: vvaharness/orchestrator/batch.py:624
            }
        }
        writeSummary(workspace, results);                                                                   // src: vvaharness/orchestrator/batch.py:627
        if (results.any(r -> r.status == "FAILED")) return 1;                                               // src: vvaharness/orchestrator/batch.py:646
        if (results.any(r -> r.status == "NOT_REMEDIATED")) return EXIT_NOT_REMEDIATED;                     // src: vvaharness/orchestrator/batch.py:647
        return 0;
    }

    /** Clone a remote ref (token injected into the URL, scrubbed from errors) or use a local path. */
    @src("vvaharness/orchestrator/batch.py:297")
    Path acquireRepo(String ref, Path workspace, String gitToken, String destName) {
        if (!isRemote(ref)) return Path.of(ref);
        String cloneUrl = withToken(ref, gitToken);                                                         // src: vvaharness/orchestrator/batch.py:329
        return Git.clone(cloneUrl, workspace.resolve(destName));
    }

    List<Entry> parseRepoCsv(Path listFile, String gitBaseUrl) {
        // header AppID,RepoName[,Path]; no Path column requires batch.git_base_url
        for (Row row : Csv.read(listFile)) {
            if (row.path == null && gitBaseUrl == null) throw new ValueError("Path is blank and batch.git_base_url is not set"); // src: vvaharness/orchestrator/batch.py:199
            if (row.path == null) row.path = gitBaseUrl + "/" + row.repoName;                               // src: vvaharness/orchestrator/batch.py:204
        }
    }

    List<Entry> parseRepoFile(Path listFile) { }
    boolean isRemote(String ref) { }
    String withToken(String url, String token) { }
    void resetProcessGlobals() { }
    void writeSummary(Path workspace, List<Result> results) { }
    String sanitize(String appId) { }
    String appModuleName(String appId) { }
}
