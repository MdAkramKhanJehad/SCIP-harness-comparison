# vvaharness/remediation_agent/render.py

Renders one typed finding as the Markdown block embedded in the per-finding user prompt (`=== SAST FINDING ===` section of `prompts.sudo` build_user).

Source: `vvaharness/remediation_agent/render.py` (lines 1-135)
Executor: code
Called from: `vvaharness/remediation_agent/prompts.py` build_user

// src: vvaharness/remediation_agent/render.py:31-39
fn render_finding_md(finding, index):executor=code {
  lines = ["### $index. [${upper(finding.severity.value)}] ${_md_cell(finding.title)}", ..._metadata_lines(finding), "", ..._narrative_lines(finding)]
  return (lines joined by newline, right-trimmed) + newline
}

// src: vvaharness/remediation_agent/render.py:61-89
fn _metadata_lines(finding):executor=code {
  [cwe, label] = _cwe_label(finding)   // cwe_for(finding.cwe, finding.vuln_class) then cwe_name; both "" when unclassified (external: vvaharness/report/cwe.py)
  lines = ["**Class:** ${label or finding.vuln_class.value}"]
  if (cwe) append "**CWE:** $label - https://cwe.mitre.org/data/definitions/<number>.html"
  append "**File:** `${finding.file}:${finding.line_start}-${finding.line_end}`"
  append "**CVSS 3.1:** " + (if score: "**<score to 1 decimal>** (<rating>) — <vector span>"; else if vector: vector span; else "_not computed_")
  // taint references are the Stage 4 evidence gate; kept so the model's gate assessment can cite them
  if (finding.source_ref) append "**Source:** `${finding.source_ref}`"
  if (finding.sink_ref) append "**Sink:** `${finding.sink_ref}`"
  if (finding.duplicates) append "**Also at:** " + each duplicate as `file:start[-end]` joined by ", "   // call sites deduplication collapsed into this finding; each needs the same fix
  return lines
}

// src: vvaharness/remediation_agent/render.py:92-135
fn _narrative_lines(finding):executor=code {
  // every prose field passes _demote_md_headings so model-written prose cannot forge a heading in the prompt (external: vvaharness/models)
  emit "#### Description" + demoted description
  if (impact) emit "#### Impact"; if (exploit_scenario) emit "#### Exploit scenario"
  if (preconditions) emit "#### Preconditions" with one "- " bullet each
  if (code_snippet) emit snippet inside a fence from _snippet_fence   // repository bytes: a backtick line must not close a bare fence and forge prompt structure
  if (recommendation) emit "#### How to fix" + demoted recommendation
  if (finding.verdict) emit "#### Adversarial verification" + "**Verdict:** <verdict> (confidence: <_confidence_label>) — <demoted verdict_reason>"
  if (finding.exploitability_notes) emit "**Exploitability:** <demoted notes>"   // Stage 8 chain commentary, including mitigations that may make the fix unnecessary
}
