# vvaharness/pipeline/stages/s1_autoexclude.py

Optional pre-Stage-1 step (`--auto-step1`). The code surveys the repository deterministically, asks a model to propose extra Stage 1 exclusions as a YAML overlay, then removes every proposed entry that a deterministic veto refuses (language erasure, server-side templates, key material, secret-bearing files, first-party client files with a DOM sink), measures the effect on scope, and always writes an overlay file (possibly empty).

Source: `vvaharness/pipeline/stages/s1_autoexclude.py` (lines 1-759)
Executor: mixed (one model call; every veto and the scope gate are code)
Called from: `vvaharness/orchestrator/scan.py` scan_repo (`run` on a fresh scan; `vet_overlay` and `vet_config_dedup` when a stored overlay is reused on `--resume`)

// src: vvaharness/pipeline/stages/s1_autoexclude.py:97-122
Constants {
  _EXCERPT_NAMES = readme*, package.json, pom.xml, build.gradle(.kts), setup.py, setup.cfg, pyproject.toml, cargo.toml, go.mod, makefile, dockerfile, composer.json, gemfile, *.csproj, *.sln, angular.json, lerna.json, nx.json, turbo.json   // case-insensitive full-name match
  _EXCERPT_CHARS = 1500
  _EXCERPT_MAX = 12
  _TREE_DEPTH = 2
  _TREE_MAX_CHILDREN = 60
  _EXT_TOP_N = 40
  _LARGEST_N = 15
  _DEDUP_KEYS = { enabled: Boolean, exts: List, min_cluster_size: Integer, keep_per_top_dir: Boolean, promote_on_secret_hit: Boolean, promote_on_insecure_value: Boolean, max_file_kb: Integer }
  _MIN_RESPONSE_CHARS = 40    // stage-local reply floor; global floors are 150 characters / 30 tokens
  _MIN_RESPONSE_TOKENS = 10
  _TAG = "s1 autoexclude"
  _AGGRESSIVE_KEEP_RATIO = 0.10   // reporting threshold only, never a rejection bar
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:303-335
VetoSets {
  _VENDOR_PATH_SEGMENTS = ["dist", "build", "out", "output", "target", "coverage", "vendor", "vendored", "third_party", "thirdparty", "external", "node_modules", "bower_components", "jspm_packages", "site-packages", ".next", ".nuxt", "_site", "__snapshots__"]
  _KEY_MATERIAL_EXTS = [".pem", ".key", ".ppk", ".p12", ".pfx", ".jks", ".keystore", ".p8", ".pkcs12", ".asc", ".gpg", ".ovpn"]
  _KEY_MATERIAL_NAME_PREFIXES = ["id_rsa", "id_dsa", "id_ecdsa", "id_ed25519"]
  _KEY_MATERIAL_NAMES = [".htpasswd", ".git-credentials", ".npmrc", ".pypirc", ".netrc"]
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:49-94
// prompt-src: vvaharness/pipeline/stages/s1_autoexclude.py:49-94
_SYSTEM {
  role: "You are a build/scan triage agent."
  input: a deterministic survey of a source tree (directory layout, file counts, extension histogram, excerpts from build/README files)
  Constraints {
    "Decide which parts are NOT production code so a security scanner can skip them."
    EXCLUDE these categories {
      Generated/auto-generated code: protobuf stubs, OpenAPI clients, code-gen output, compiled assets, *.pb.go, *.generated.*, *_pb2.py
      Vendored/third-party copies: vendor/, third_party/, node_modules/ (if checked in), bower_components/, external/
      Test-only trees: test fixtures, sample data, mock servers, e2e test suites, cypress/fixtures, __snapshots__
      IDE/editor metadata: .idea/, .vscode/ (except shared settings), .vs/, *.swp, *~
      Build/CI output: dist/, build/, out/, target/, bin/ (compiled output), .cache/, coverage/
      Documentation-only trees: docs/, documentation/, wiki/, man/, guides/
      Demo/example apps: examples/, samples/, demo/, playground/, tutorial/
      Data dumps: fixtures with large data files, seed data, database backups "(NOT migration scripts — those are NEVER EXCLUDE, below)"
      Localisation bundles: locale/, i18n/, l10n/, translations/ (unless they contain code)
      Lock files and manifests that are not source: package-lock.json, yarn.lock, Gemfile.lock, poetry.lock, go.sum, Cargo.lock
    }
    "NEVER EXCLUDE — these are in scope even if they look non-functional:" {
      "Application source code in ANY language"
      Configuration files that affect runtime behavior (nginx.conf, app.yaml, settings.py, application.properties, .env.example)
      Infrastructure-as-code that provisions production (Terraform, CloudFormation, Helm charts, Kubernetes manifests, Ansible playbooks, Dockerfiles)
      "Database migration scripts (they modify production schema)"
      API schema definitions (OpenAPI/Swagger YAML, GraphQL SDL, protobuf .proto source files — NOT generated stubs)
      Security-related files (auth middleware, RBAC config, certificate handling)
      "Shared libraries or internal packages (even if they look like vendor code, if they are maintained in this repo they are production)"
      "Server-side template directories (Django/Jinja/ERB/JSP templates — .html/.j2/.erb files rendered by the app are XSS/SSTI attack surface, even in dirs named template/, templates/, views/, static/)"
    }
    "When unsure whether something is production code, do NOT exclude it."
    "A false negative (scanning non-production code) wastes time; a false positive (excluding production code) misses vulnerabilities."
    "You MUST reply with a single fenced ```yaml block and nothing else."
  }
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:603-636
// prompt-src: vvaharness/pipeline/stages/s1_autoexclude.py:603-636
S1_AUTOEXCLUDE_USER_PROMPT {
  base_dirs; base_exts; base_globs; cur_max_kb; cur_dedup; survey
  Constraints {
    "Below is a deterministic survey of a repository. Propose ADDITIONAL scan exclusions so the security scanner only sees production code."
    "Already excluded (do NOT repeat these — propose only repo-specific extras):" dirs: $base_dirs (sorted), exts: $base_exts (sorted), globs: $base_globs
    "Current max_file_kb = $cur_max_kb"
    "Current config_dedup = {exts: ${cur_dedup.exts}, min_cluster_size: ${cur_dedup.min_cluster_size}}"
    $survey
    "Return ONLY a fenced YAML block with these keys (omit any key you have no change for — do NOT emit empty/null placeholders):"
    exclude_dirs: "directory NAMES (any depth), e.g. \"generated\", \"samples\""
    exclude_exts: "file extensions WITH leading dot, e.g. \".pb.go\", \".min.js\""
    exclude_globs: "repo-relative posix fnmatch, e.g. \"**/*.g.dart\", \"tools/codegen/**\""
    max_file_kb: "OPTIONAL int. Only emit if the largest-files list shows genuine source bigger than the current limit (raise it) or only data dumps above a lower threshold (lower it)."
    config_dedup: "OPTIONAL. Only emit keys you want to change." exts is the "FULL list (REPLACES current). Include defaults you want to keep plus repo-specific formats e.g. \".tfvars\", \".cue\"."; min_cluster_size example 3; max_file_kb example 1024
    "Whole sub-repos that are clearly test-automation, demo, or tooling-only may be excluded via exclude_globs (e.g. \"that-repo/**\"). Be conservative."
  }
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:583-759
fn run(repo_root, cfg, out_path):executor=mixed {
  create parent directory of out_path

  // src: s1_autoexclude.py:589-597
  [base_dirs, base_exts, base_globs] = scope._exclusion_sets(cfg)
  cur_max_kb = Integer(knob("step1.max_file_kb", default=1024))
  cur_dedup = copy of scope._DEDUP_DEFAULTS
  user_dd = knob("step1.config_dedup", default=null)
  if (user_dd != null) { cur_dedup.update(entries of user_dd whose value is not null) }   // `exts: null` would otherwise crash

  // src: s1_autoexclude.py:599-601
  [survey, n_files] = _survey(repo_root, base_dirs, base_exts, base_globs)
  model = knob("models.autoexclude", default=null) || knob("models.preprocess")
  max_tok = Integer(knob("step1.auto_exclude_max_tokens", default=8000))
  effort = knob("step1.auto_exclude_effort", default=null) || null

  // src: s1_autoexclude.py:642-663 — one model call; at most one resend
  constraint StageFloors {
    While this call runs, the reply-quality floor for tag "s1 autoexclude" is min_chars=40, min_tokens=10 (stage_floors).
  }
  raw = dispatch_or_retry_unforced(
    drop_thinking => callModel({
      role: "autoexclude",   // falls back to models.preprocess
      route: resolve_model(model).via,   // deepagents.dispatch_prompt routes by the model's resolved via
      system: _SYSTEM,
      prompt: S1_AUTOEXCLUDE_USER_PROMPT,
      tools: [],
      limits: { max_tokens: max_tok, cwd: repo_root, graph_name: "s1-autoexclude", effort: if (drop_thinking) null else effort },
      output: free text with a fenced YAML block   // no response schema
    }),
    label="survey", stage="s1",
    effort=deepagents.droppable_effort(model, effort, agentic=false),
    resend_refusal=refusal_resend_allowed(cfg, model))
  // external: vvaharness/util/response_quality.py dispatch_or_retry_unforced — the first call is sent with the effort tier; if it fails as a clip at a budget the backend could not grow (only when an effort tier was sent) or as a structured-output failure, it is resent exactly once with drop_thinking=true; any other error propagates. With resend_refusal, the first model refusal gets one identical resend.

  // src: s1_autoexclude.py:665-678 — normalize the proposal
  data = _extract_yaml(raw)   // never raises; {} when nothing usable
  dirs = _norm_list(data.exclude_dirs) where lowercase(d) not in lowercase(base_dirs)
  exts = for each e in _norm_list(data.exclude_exts, lower=true): prefix "." if missing; keep if not in lowercase(base_exts)
  globs = _norm_list(data.exclude_globs) where g not in base_globs

  // src: s1_autoexclude.py:680-683 — one inventory walk, reused by the vetoes and the scope gate
  inv = scope.scope_after(repo_root, cfg)
  [dirs, exts, globs] = vet_overlay(repo_root, cfg, dirs, exts, globs, inventory=inv)

  // src: s1_autoexclude.py:686-688 — max_file_kb accepted only as a positive number different from the current value
  mfk = data.max_file_kb
  new_max_kb = if (mfk is a number && Integer(mfk) > 0 && Integer(mfk) != cur_max_kb) Integer(mfk) else null
  // preserved: a model-proposed max_file_kb has no veto of its own; only the scope gate below measures its effect

  // src: s1_autoexclude.py:690-712 — scope gate on the measured effect of the vetted overlay
  n_before = length(inv)
  after = scope.scope_after(repo_root, cfg, dirs, exts, globs, max_file_kb=new_max_kb)
  n_after = length(after)
  removed = sorted(inv minus after)
  if (n_before > 0 && n_after == 0) {
    warn S1_OVERLAY_EMPTIES_SCOPE; errlog.log(_TAG, "auto-exclude overlay would empty the scope ($n_before files -> 0); overlay discarded", reason="s1_autoexclude_empty_scope")
    [dirs, exts, globs, new_max_kb] = [[], [], [], null]   // same scope as --no-auto-step1; the run is not aborted
  } else if (n_before > 0 && n_after / n_before < _AGGRESSIVE_KEEP_RATIO) {
    warn S1_OVERLAY_AGGRESSIVE   // with up to 3 removed examples; the overlay is still applied
  }

  // src: s1_autoexclude.py:714-738 — config_dedup: only known keys with the right type survive, then the read-site veto
  overlay = { exclude_dirs: dirs, exclude_exts: exts, exclude_globs: globs }
  if (new_max_kb != null) overlay.max_file_kb = new_max_kb
  dd_in = data.config_dedup
  if (dd_in is a dict) {
    dd_out = {}
    for each [k, typ] in _DEDUP_KEYS where k in dd_in {
      match (typ) {
        case List => { xs = _norm_list(dd_in[k], lower=true) each forced to one leading "." and lowercased; if (xs) dd_out[k] = xs }
        case Boolean => if (dd_in[k] is a Boolean) dd_out[k] = dd_in[k]
        case Integer => if (dd_in[k] is a number) dd_out[k] = Integer(dd_in[k])
      }
    }
    dd_out = vet_config_dedup(dd_out)
    if (dd_out) overlay.config_dedup = dd_out
  }

  // src: s1_autoexclude.py:740-744 — writer-site veto, re-run before serialization
  if ("config_dedup" in overlay) {
    overlay.config_dedup = vet_config_dedup(overlay.config_dedup)
    if (!overlay.config_dedup) delete overlay.config_dedup
  }

  // src: s1_autoexclude.py:746-759
  write out_path = "# Auto-generated by vvaharness auto-step1 — appended to global step1.\n" + yaml(overlay, key order kept)
  return out_path
  // abstracted: s1_autoexclude.py:638-639, 751-758 console summary lines; no decision
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:125-235
fn _survey(repo_root, base_dirs, base_exts, base_globs):executor=code {
  globbed = rel => scope.glob_hit(rel, base_globs) != null   // shared helper so the survey agrees with Stage 1
  tree = { "": [subdirs={}, file_count=0, depth=0] }; ext_hist = counter; excerpts = []; largest = []; n_files = 0

  // src: s1_autoexclude.py:140-194
  for each (dirpath, dirnames, filenames) in os.walk(repo_root) {
    depth = 0 for the root, else number of "/" in rel_dir + 1
    dirnames = sorted(d where lowercase(d) not in base_dirs && !globbed(rel_dir/d))   // pruned directories are not descended
    // preserved: this pruning hides every "target" directory, while scope/walk.py _walk_repo excludes "target" only when a build marker sits beside it; the survey and the walk can disagree there
    if (depth <= _TREE_DEPTH) record dirnames as children of rel_dir
    for each fn in filenames {
      rel = rel_dir/fn
      if (any e in base_exts: suffix(fn) == e || lowercase(fn) endswith e) || globbed(rel) continue   // mirrors _walk_repo
      n_files += 1; ext_hist[suffix or "(none)"] += 1
      sz = file size (0 on error)
      keep the _LARGEST_N=15 largest (size, rel)
      add 1 to the file count of every ancestor directory that is in tree
      if (depth <= _TREE_DEPTH && length(excerpts) < _EXCERPT_MAX && sz <= 5_000_000 && _EXCERPT_NAMES matches fn) {
        if (fn is a symlink && (target resolves outside repo_root || resolution fails)) continue   // off-host content never enters the prompt
        excerpts += (rel, first _EXCERPT_CHARS characters, utf-8 with replacement, right-stripped)   // read errors skipped
      }
    }
  }

  // src: s1_autoexclude.py:196-235
  survey = sections {
    "## Directory tree (depth ≤3, already-excluded dirs hidden, counts = files that survive current exclusions)": tree; at depth _TREE_DEPTH up to _TREE_MAX_CHILDREN=60 children shown, then "… (+N more)"
    "## Extension histogram (top 40)": ext_hist.most_common(40), then "… (+N more extensions)" if more
    "## Largest 15 files (after current exclusions)": size in KB and path
    "## Build / README excerpts": each excerpt in a fenced block, or "(no README/build files found at depth ≤2)"
  }
  return [survey, n_files]
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:238-284
fn _extract_yaml(text):executor=code {
  // _yaml_candidates (247-254): yaml/yml-labelled fences, then unlabelled fences, then other labels, then the whole reply; a fence left open at end of text still counts
  first_dict = null; parsed_any = false; err = null
  for each blob in _yaml_candidates(text) {
    try data = yaml.safe_load(blob) || {}; catch YAMLError => { err = err || error; continue }
    parsed_any = true
    if (data is not a dict) continue
    if (keys(data) == {"step1"} && data.step1 is a dict) data = data.step1
    if (data has any of _OVERLAY_KEYS = ["exclude_dirs", "exclude_exts", "exclude_globs", "max_file_kb", "config_dedup"]) return data   // first real proposal wins
    if (first_dict == null) first_dict = data
  }
  if (first_dict != null) return first_dict
  if (!parsed_any && err != null) warn S1_MODEL_YAML_UNPARSEABLE   // detail redacted before truncation to 200 characters
  return {}
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:476-580
fn vet_overlay(repo_root, cfg, dirs, exts, globs, inventory?):executor=code {
  // Applies only to model-proposed entries; operator overlays bypass it; --resume re-vets a stored overlay

  // src: s1_autoexclude.py:484-497 — language-erasure veto (no exemption)
  vetoed = entries of exts + globs where _erases_language(entry)
  if (vetoed) {
    exts = exts where _erases_language(e) == null; globs = globs where _erases_language(g) == null
    warn S1_OVERLAY_VETOED_LANGUAGE; errlog.log(_TAG, ..., reason="s1_autoexclude_language_veto", recovered=true)
    COUNTERS.bump("s1_autoexclude_language_veto", length(vetoed))
  }
  // preserved: the language-erasure veto checks exts and globs only; a dirs entry is never language-checked

  // src: s1_autoexclude.py:500
  inv = inventory or, when absent, scope.scope_after(repo_root, cfg)

  // src: s1_autoexclude.py:502-533 — the shared containment veto, applied to dirs, exts and globs in turn
  _run_containment_veto(protected, noun, label, reason, counter, counter_files, counter_vendor) {
    for each list [dirs as "dir", exts as "ext", globs as "glob"] {
      for each entry {
        if (_is_vendor_or_build_entry(entry)) { keep entry; COUNTERS.bump(counter_vendor); continue }   // vendor or build paths are exempt from containment vetoes
        hits = _removes_protected_files(protected, kind, entry)
        if (hits empty) { keep entry; continue }
        drop entry; warn S1_OVERLAY_VETOED; errlog.log(_TAG, "$label veto: ...", reason, recovered=true)
        COUNTERS.bump(counter); COUNTERS.bump(counter_files, length(hits))
      }
    }
  }

  // src: s1_autoexclude.py:536-578 — four containment vetoes, each on by default, in this order
  if (knob("step1.auto_exclude_protect_templates", default=true)) {
    _run_containment_veto(_template_files(inv), noun="server-side template file(s)", label="template-containment", reason="s1_autoexclude_template_veto", ...)
  }
  if (knob("step1.auto_exclude_protect_key_material", default=true)) {
    _run_containment_veto(_key_material_files(inv), noun="key-material file(s)", label="key-material-containment", reason="s1_autoexclude_key_material_veto", ...)
  }
  if (knob("step1.auto_exclude_protect_secrets", default=true)) {
    _run_containment_veto(_secret_bearing_files(inv, repo_root), noun="secret-bearing file(s)", label="secret-bearing-containment", reason="s1_autoexclude_secret_bearing_veto", ...)
  }
  if (knob("step1.auto_exclude_protect_client_sinks", default=true)) {
    _run_containment_veto(_client_sink_files(inv, repo_root, cfg), noun="first-party client file(s) with a DOM sink", label="client-sink-containment", reason="s1_autoexclude_client_sink_veto", ...)
  }
  return [dirs, exts, globs]
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:436-473
fn vet_config_dedup(dd):executor=code {
  if (dd is not a dict) return dd
  out = copy of dd
  for each flag in ["promote_on_secret_hit", "promote_on_insecure_value"] {
    if (out[flag] == false) {
      warn S1_CONFIG_DEDUP_VETOED; errlog.log(_TAG, "config_dedup veto: model-proposed $flag=false refused; the flag stays enabled", reason="s1_autoexclude_dedup_flag_veto", recovered=true)
      COUNTERS.bump("s1_autoexclude_dedup_flag_veto"); delete out[flag]
    }
  }
  xs = out.exts
  if (xs is a list) {
    bad = xs where (lowercase(e) in _KEY_MATERIAL_EXTS || _erases_language(e))
    if (bad) {
      warn S1_CONFIG_DEDUP_VETOED; errlog.log(..., reason="s1_autoexclude_dedup_ext_veto", recovered=true); COUNTERS.bump("s1_autoexclude_dedup_ext_veto")
      if (xs minus bad) out.exts = xs minus bad else delete out.exts
    }
  }
  // preserved: the warning text says server-side template extensions are also refused, but the check covers only key-material and language-erasing extensions
  return out
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:287-300
fn _erases_language(entry):executor=code {
  ext = if (entry matches "^(?:\*\*/)?\*(\.[A-Za-z0-9_]+)$") lowercase(captured extension)
        else if (entry fully matches "\.[A-Za-z0-9_]+") lowercase(entry)
        else return null
  return if (ext in lang.detect.EXT_TO_LANG) ext else null
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:312-319
fn _is_vendor_or_build_entry(entry):executor=code {
  low = lowercase(entry)
  if (".min." in low) return true
  return any path segment of low (split on / or \, ignoring "", "*", "**") is in _VENDOR_PATH_SEGMENTS
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:322-365
fn _template_files(inventory):executor=code = inventory where lang.detect.is_web_template(rel)
fn _is_key_material(rel):executor=code = lowercase(basename) in _KEY_MATERIAL_NAMES || starts with one of _KEY_MATERIAL_NAME_PREFIXES || suffix in _KEY_MATERIAL_EXTS
fn _key_material_files(inventory):executor=code = inventory where _is_key_material(rel)
fn _secret_bearing_files(inventory, repo_root):executor=code {
  return inventory where redact_counts(first _EXCERPT_CHARS=1500 characters of the file) reports any count   // unreadable files skipped; external: vvaharness/report/redact.py
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:368-389
fn _client_sink_files(inventory, repo_root, cfg):executor=code {
  detectors = compile_detectors(detector_corpus() where rule_id == "detector-docwrite-location")   // same rule Stage 5 uses
  cache = FileCache(repo_root, max_kb=knob("step1.max_file_kb", default=1024))
  return inventory where (EXT_TO_LANG[suffix] in ["javascript", "typescript"]) && !_is_vendor_or_build_entry(rel) && detector_hits(rel, cache.lines(rel), detectors)
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:392-411
fn _removes_protected_files(protected, kind, entry):executor=code {
  // reproduces _walk_repo's predicates in memory
  return protected where match (kind) {
    case "dir" => any parent directory component equals entry (case-insensitive)
    case "ext" => suffix == lowercase(entry) || lowercase(basename) endswith lowercase(entry)
    default => scope.glob_hit(rel, [entry]) != null
  }
}

// src: vvaharness/pipeline/stages/s1_autoexclude.py:414-433
fn _norm_list(v, lower=false):executor=code {
  // a single string becomes a one-item list; non-strings dropped; each stripped of whitespace and leading or trailing "/" "\"; empties dropped; optional lowercase; first occurrence kept
}
