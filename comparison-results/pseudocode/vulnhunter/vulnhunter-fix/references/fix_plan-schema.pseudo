// file: vulnhunter-fix/references/fix_plan-schema.json
// Per-finding plan artifact from Phase 2 (Plan): strategy, files, projected tier + residuals, caller coverage,
// optional tier_judgment, crypto trust-chain booleans, chosen adapter language and CWE-class worker prompt.

@executedBy(CODE) @role(types)
enum ProjectedTier { FULL, MITIGATION, WORKAROUND }

@executedBy(CODE) @role(types)
enum CallersRoutedCoverage { SUPERSET, SUBSET, UNKNOWN }

@executedBy(CODE) @role(types)
record CryptoTrustChain(boolean algorithm_approved, boolean key_source_approved, boolean key_rotation_present, boolean transport_encrypted) { }

@executedBy(CODE) @role(types)
record FixPlan(String vuln_id, String cwe, String strategy, List<String> files_to_change, String why_this_works,
               ProjectedTier projected_completeness_tier, List<String> projected_residual_vectors,
               CallersRoutedCoverage callers_routed_coverage, Map discrimination_evidence, TierJudgment tier_judgment,
               CryptoTrustChain crypto_trust_chain, String adapter_language, String worker_prompt) { }

@executedBy(MIXED) @role(rule_set) @stage("fix")
class FixPlanSchema {

    boolean validate(FixPlan p, Theta θ) {
        // required: vuln_id, cwe, strategy, files_to_change, why_this_works, projected_completeness_tier, tier_judgment
        if (!Regex.match("^VULN-\\d+$", p.vuln_id)) return false;                     // src: vulnhunter-fix/references/fix_plan-schema.json:20
        if (!Regex.match("^CWE-\\d+$", p.cwe)) return false;                          // src: vulnhunter-fix/references/fix_plan-schema.json:24
        if (p.strategy.isEmpty() || p.why_this_works.isEmpty()) return false;        // src: vulnhunter-fix/references/fix_plan-schema.json:28
        if (p.files_to_change.size() < 1) return false;                              // src: vulnhunter-fix/references/fix_plan-schema.json:34
        if (!List.of("FULL", "MITIGATION", "WORKAROUND").contains(p.projected_completeness_tier)) return false; // src: vulnhunter-fix/references/fix_plan-schema.json:42 (compared with post-fix tier; mismatch -> repair loop)
        if (!ResultSchema.validTierJudgment(p.tier_judgment, θ)) return false;        // src: vulnhunter-fix/references/fix_plan-schema.json:65
        if (!projectedResidualRule(p, θ)) return false;                               // src: vulnhunter-fix/references/fix_plan-schema.json:103
        if (p.callers_routed_coverage != null && !θ["p.plan.callers_routed_coverage_enum"].contains(p.callers_routed_coverage)) return false; // src: vulnhunter-fix/references/fix_plan-schema.json:52
        if (p.adapter_language != null && !θ["code.references.fix_plan_schema.adapter_languages"].contains(p.adapter_language)) return false; // src: vulnhunter-fix/references/fix_plan-schema.json:87
        if (p.worker_prompt != null && !List.of("worker_agent_authz.md", "worker_agent_injection.md", "worker_agent_crypto.md",
                                                  "worker_agent_resource.md", "worker_agent_config.md").contains(p.worker_prompt)) return false; // src: vulnhunter-fix/references/fix_plan-schema.json:92
        return true;
    }

    boolean projectedResidualRule(FixPlan p, Theta θ) {
        // FULL -> no projected residuals; otherwise at least one, required
        if (p.projected_completeness_tier == "FULL") return !θ["p.residual-risk-rules.r2_empty_when_full"] || p.projected_residual_vectors.isEmpty(); // src: vulnhunter-fix/references/fix_plan-schema.json:111
        return !θ["p.residual-risk-rules.r1_non_empty_when_not_full"] || (p.projected_residual_vectors != null && p.projected_residual_vectors.size() >= 1); // src: vulnhunter-fix/references/fix_plan-schema.json:116
    }

    String callersRoutedCoverageMeaning(CallersRoutedCoverage c, Theta θ) {
        // superset is required for FULL; subset caps the tier at MITIGATION; unknown = grep-only graph or unresolved sink
        if (θ["p.remediation-rigor.callers_routed_coverage_required"] && c == CallersRoutedCoverage.SUBSET) return "MITIGATION_MAX"; // src: vulnhunter-fix/references/fix_plan-schema.json:53
        return c.name();
    }

    boolean cryptoTrustChainRequired(FixPlan p, Theta θ) {
        // required (four booleans lifted from the triage sidecar, worker must not modify) when routed to worker_agent_crypto.md
        return p.worker_prompt == "worker_agent_crypto.md" && θ["p.worker_agent_crypto.never_mutate_trust_chain"]; // src: vulnhunter-fix/references/fix_plan-schema.json:70
    }
}
