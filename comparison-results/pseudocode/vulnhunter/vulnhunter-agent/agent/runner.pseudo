    SessionResult runScanSession(AgentSpec options, Prompt prompt, Path cloneDir, Theta θ, String model) {
        int consecutiveAuthFailures = 0;
        int consecutiveRateLimits = 0;
        boolean sawAssistant = false;
        SessionTotals totals = new SessionTotals();
        Set<String> pendingTasks = new Set();                                                    // src: vulnhunter-agent/agent/runner.py:978
        int continuations = 0;
        int stalledContinuations = 0;
        boolean logPerTurnUsage = θ["logging.per_turn_usage"];                                   // src: vulnhunter-agent/agent/runner.py:1014
