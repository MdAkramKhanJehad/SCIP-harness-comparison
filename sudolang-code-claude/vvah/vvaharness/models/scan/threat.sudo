_SENSITIVITY_ALIAS = {
  none, info, informational, minor => "low";
  moderate, med, normal => "medium";
  major, severe, important => "high";
  crit, blocker, extreme => "critical"
}
Asset {
  name: String
  description: String = ""
  sensitivity: "low" | "medium" | "high" | "critical" = "medium"
  // coercion: sensitivity = _coerce_enum(sensitivity, {low, medium, high, critical}, _SENSITIVITY_ALIAS, default="medium")
}

// src: vvaharness/models/scan/threat.py:47-50
TrustBoundary {
  entry_point: String
  crossing: String           // for example "unauth network → application logic"
  reachable_assets: String[] = []
}

// src: vvaharness/models/scan/threat.py:53-82
_ACTOR_ALIAS = {
  external, anonymous, unauthenticated, internet, public, attacker => "remote_unauth";
  authenticated, user, tenant, customer => "remote_auth";
  internal, network, lan, adjacent => "adjacent_network";
  local, physical => "local_user";
  admin, root, operator, privileged => "local_admin";
  supply, dependency, third_party, vendor => "supply_chain";
  employee, developer, malicious_insider => "insider"
}
_IMPACT_ALIAS = _SENSITIVITY_ALIAS + { catastrophic, fatal => "existential" }
_LIKELIHOOD_ALIAS = {
  very_unlikely, negligible, remote, improbable => "very_rare";
  unlikely, low => "rare";
  moderate, medium, occasional => "possible";
  probable, high, frequent => "likely";
  very_likely, certain, definite, inevitable => "almost_certain"
}

// src: vvaharness/models/scan/threat.py:85-126
Threat {
  id: String = ""            // assigned from list position after the model replies; a model-minted id is checkable against nothing
  threat: String
  actor: "remote_unauth" | "remote_auth" | "adjacent_network" | "local_user" | "local_admin" | "supply_chain" | "insider"
  surface: String            // entry_point name from trust_boundaries
  surface_files: String[]    // required (no default)
  // schema description shown to the model when Threat is part of the requested output schema (prompt-src: threat.py:93-100):
  // "Every repo-relative file path (from the FILE INVENTORY / entry points / modules lists you were given) that implements or is reachable from this threat's surface. Required whenever the surface names concrete code, not just a general property of the system — this is how the threat reaches the files it affects; an empty list means no downstream stage can act on it."
  asset: String
  impact: "low" | "medium" | "high" | "critical" | "existential"
  likelihood: "very_rare" | "rare" | "possible" | "likely" | "almost_certain"
  controls: String = ""
  evidence: String = ""
  // coercions (before validation):
  //   actor = _coerce_enum(actor, actors, _ACTOR_ALIAS, default="remote_auth")
  //   impact = _coerce_enum(impact, impacts, _IMPACT_ALIAS, default="medium")
  //   likelihood = _coerce_enum(likelihood, likelihoods, _LIKELIHOOD_ALIAS, default="possible")
  //   surface_files = _coerce_str_list(surface_files, "Threat.surface_files")
}

