// file: vvaharness/detect/matcher.py
// Regex matching of a MatchSpec corpus against raw source text: line-by-line seeding (S0 sources/sinks)
// and detector rules whose gates read a call/block span, a widened negative window, a file gate and a proximity gate.

@executedBy(CODE) @role(types)
record Hit(String file, int line, MatchSpec spec, String snippet, int lineEnd) { }   // lineEnd 0 = single-line hit. src: vvaharness/detect/matcher.py:28

@executedBy(CODE) @role(types)
record CompiledDetector(MatchSpec spec, Regex pattern, Regex present, Regex absent, Regex fileGate, Regex near, Regex spanEnd) { } // src: vvaharness/detect/matcher.py:90

@executedBy(CODE) @role(step) @stage("S0")
class Matcher {

    List<Pair<MatchSpec, Regex>> compiled(List<MatchSpec> specs) {
        return specs.map(s -> new Pair(s, Regex.compile(s.pattern)));                             // src: vvaharness/detect/matcher.py:40
    }

    /** Lines as ast/git/editors count them: split on newline only (not form-feed or U+2028), drop trailing empty, strip CR. */
    List<String> splitLines(String text) {
        List<String> out = text.split("\n");                                                      // src: vvaharness/detect/matcher.py:46
        if (!out.isEmpty() && out.last().isEmpty()) out.removeLast();                             // src: vvaharness/detect/matcher.py:47
        return out.map(ln -> ln.removeSuffix("\r"));                                              // src: vvaharness/detect/matcher.py:49
    }

    String readText(Path repoRoot, String relPath) {
        try { return repoRoot.resolve(relPath).readText("utf-8", "replace"); } catch (OSError e) { return null; } // src: vvaharness/detect/matcher.py:55
    }

    /** Every pattern against every line of one file; one hit per (spec, line). */
    List<Hit> scanFile(Path repoRoot, String relPath, List<Pair<MatchSpec, Regex>> compiled, Theta θ) {
        String text = readText(repoRoot, relPath);                                                // src: vvaharness/detect/matcher.py:66
        if (text == null) return new List();                                                      // src: vvaharness/detect/matcher.py:67
        List<Hit> hits = new List();
        List<String> lines = splitLines(text);
        for (int lineNo = 1; lineNo <= lines.size(); lineNo++) {                                  // src: vvaharness/detect/matcher.py:70
            String line = lines.get(lineNo - 1);
            for (Pair<MatchSpec, Regex> sr : compiled) {                                          // src: vvaharness/detect/matcher.py:71
                if (sr.second.search(line)) hits.add(new Hit(relPath, lineNo, sr.first, line.strip().head(θ["code.detect.matcher.snippet_max_chars"]), 0)); // src: vvaharness/detect/matcher.py:73
            }
        }
        return hits;
    }

    /** Match the corpus against every listed file. */
    List<Hit> scanFiles(Path repoRoot, List<String> relPaths, List<MatchSpec> specs, Theta θ) {
        List<Pair<MatchSpec, Regex>> c = compiled(specs);                                         // src: vvaharness/detect/matcher.py:79
        List<Hit> hits = new List();
        for (String relPath : relPaths) hits.addAll(scanFile(repoRoot, relPath, c, θ));           // src: vvaharness/detect/matcher.py:81
        return hits;
    }

    /** Compile every ENABLED detector-role spec; other roles and disabled rules are dropped. */
    List<CompiledDetector> compileDetectors(List<MatchSpec> specs) {
        return specs.filter(s -> s.role == "detector" && s.enabled)                               // src: vvaharness/detect/matcher.py:115
            .map(s -> new CompiledDetector(s, Regex.compile(s.pattern), rx(s.presentRe), rx(s.absentRe), rx(s.fileRe), rx(s.nearRe), rx(s.spanEnd))); // src: vvaharness/detect/matcher.py:108
    }

    Regex rx(String pat) {
        return pat.isEmpty() ? null : Regex.compile(pat);                                         // src: vvaharness/detect/matcher.py:105
    }

    /** seg with every string literal blanked char-for-char; returns (masked, open triple-quote or ""). Single-quote masking is per line. */
    Pair<String, String> maskStrings(String seg, String inTriple) {
        StringBuilder out = new StringBuilder(); int pos = 0;
        if (!inTriple.isEmpty()) {                                                                // src: vvaharness/detect/matcher.py:139
            Match m = TRIPLE_CLOSE.get(inTriple).match(seg);                                      // src: vvaharness/detect/matcher.py:140
            if (m == null) return new Pair(spaces(seg.length()), inTriple);                       // whole line still inside the literal. src: vvaharness/detect/matcher.py:141
            out.append(spaces(m.end())); pos = m.end(); inTriple = "";                            // src: vvaharness/detect/matcher.py:143
        }
        while (true) {                                                                            // src: vvaharness/detect/matcher.py:146
            // STRING_LITERAL_RX: triple-quoted forms first (longest alternation wins), then bare triple openers, then double/single quoted
            Match m = STRING_LITERAL_RX.search(seg, pos);                                         // src: vvaharness/detect/matcher.py:147
            if (m == null) { out.append(seg.substring(pos)); break; }                             // src: vvaharness/detect/matcher.py:148
            out.append(seg.substring(pos, m.start()));                                            // src: vvaharness/detect/matcher.py:151
            String tok = m.group(0);
            if (tok == "\"\"\"" || tok == "'''") {                                                // unterminated opener: string text to EOL. src: vvaharness/detect/matcher.py:153
                out.append(spaces(seg.length() - m.start())); inTriple = tok; break;              // src: vvaharness/detect/matcher.py:154
            }
            out.append(spaces(tok.length())); pos = m.end();                                      // src: vvaharness/detect/matcher.py:157
        }
        return new Pair(out.toString(), inTriple);
    }

    /** Balanced-paren call text from (idx, col) over at most maxLines lines; null when it never balances. Text after the closing paren is trimmed. */
    Pair<String, Integer> callSpan(List<String> lines, int idx, int col, int maxLines, Theta θ) {
        int depth = 0; List<String> parts = new List(); String inTriple = "";
        for (int i = idx; i < Math.min(idx + maxLines, lines.size()); i++) {                      // src: vvaharness/detect/matcher.py:169
            String seg = (i == idx) ? lines.get(i).substring(col) : lines.get(i);                 // src: vvaharness/detect/matcher.py:170
            String masked = seg;
            if (θ["code.detect.matcher.mask_string_literals"]) {                                  // a paren inside a literal would break the balance. src: vvaharness/detect/matcher.py:171
                Pair<String, String> mr = maskStrings(seg, inTriple); masked = mr.first; inTriple = mr.second;
            }
            for (int j = 0; j < masked.length(); j++) {                                           // src: vvaharness/detect/matcher.py:172
                char ch = masked.charAt(j);
                if (ch == '(') depth++;                                                           // src: vvaharness/detect/matcher.py:173
                else if (ch == ')') {
                    depth--;                                                                      // src: vvaharness/detect/matcher.py:176
                    if (depth == 0) { parts.add(seg.substring(0, j + 1)); return new Pair(join("\n", parts), i + 1); } // src: vvaharness/detect/matcher.py:177
                }
            }
            parts.add(seg);                                                                       // src: vvaharness/detect/matcher.py:180
        }
        return null;                                                                              // src: vvaharness/detect/matcher.py:181
    }

    /** Text from (idx, col) through the first line matching endRx, at most maxLines; null when it never closes. */
    Pair<String, Integer> blockSpan(List<String> lines, int idx, int col, Regex endRx, int maxLines) {
        List<String> parts = new List();
        for (int i = idx; i < Math.min(idx + maxLines, lines.size()); i++) {                      // src: vvaharness/detect/matcher.py:188
            String seg = (i == idx) ? lines.get(i).substring(col) : lines.get(i);                 // src: vvaharness/detect/matcher.py:189
            parts.add(seg);
            if (endRx.search(seg)) return new Pair(join("\n", parts), i + 1);                     // src: vvaharness/detect/matcher.py:191
        }
        return null;                                                                              // src: vvaharness/detect/matcher.py:193
    }

    /** Gate text for a hit: call span, block span (when span_end set), else the line itself. */
    Pair<String, Integer> spanFor(CompiledDetector det, List<String> lines, int idx, int col, Theta θ) {
        if (det.spec.span == "call") return callSpan(lines, idx, col, Math.max(1, det.spec.spanMaxLines), θ); // src: vvaharness/detect/matcher.py:200
        if (det.spec.span == "block" && det.spanEnd != null) return blockSpan(lines, idx, col, det.spanEnd, Math.max(1, det.spec.spanMaxLines)); // src: vvaharness/detect/matcher.py:202
        return new Pair(lines.get(idx), idx + 1);                                                 // src: vvaharness/detect/matcher.py:204
    }

    /** Text the absent guard reads: the span widened by absentWindow lines each side. Only the negative gate widens. */
    String guardText(CompiledDetector det, List<String> lines, int idx, String body, int endLine) {
        int window = det.spec.absentWindow;                                                       // src: vvaharness/detect/matcher.py:211
        if (window <= 0) return body;                                                             // src: vvaharness/detect/matcher.py:212
        int lo = Math.max(0, idx - window); int hi = Math.min(lines.size(), endLine + window);    // src: vvaharness/detect/matcher.py:214
        return join("\n", lines.subList(lo, hi));                                                 // src: vvaharness/detect/matcher.py:216
    }

    /** Proximity gate: nearRe within nearWindow lines of the anchor (true when no near gate). */
    boolean nearOk(CompiledDetector det, List<String> lines, int idx) {
        if (det.near == null) return true;                                                        // src: vvaharness/detect/matcher.py:221
        int lo = Math.max(0, idx - det.spec.nearWindow); int hi = Math.min(lines.size(), idx + det.spec.nearWindow + 1); // src: vvaharness/detect/matcher.py:223
        return det.near.search(join("\n", lines.subList(lo, hi)));                                // src: vvaharness/detect/matcher.py:225
    }

    /** Detectors whose whole-file gate admits this file (all when none has a file gate). */
    List<CompiledDetector> liveDetectors(List<String> lines, List<CompiledDetector> detectors) {
        if (detectors.noneMatch(d -> d.fileGate != null)) return detectors;                       // src: vvaharness/detect/matcher.py:235
        String text = join("\n", lines);                                                          // src: vvaharness/detect/matcher.py:237
        return detectors.filter(d -> d.fileGate == null || d.fileGate.search(text));              // src: vvaharness/detect/matcher.py:238
    }

    /** Every compiled detector's hits in one file, at most one per (rule, line). */
    List<Hit> detectorHits(String relPath, List<String> lines, List<CompiledDetector> detectors, Theta θ) {
        List<CompiledDetector> live = detectors.isEmpty() ? new List() : liveDetectors(lines, detectors); // src: vvaharness/detect/matcher.py:289
        if (live.isEmpty()) return new List();                                                    // src: vvaharness/detect/matcher.py:290
        // '#' comment lines skipped only for these extensions ('#' is a CSS selector / anchor in templates)
        boolean skipComments = θ["code.detect.matcher.comment_skip_exts"].anyMatch(e -> relPath.endsWith(e)); // src: vvaharness/detect/matcher.py:293
        FileScan scan = new FileScan(relPath, lines);                                             // src: vvaharness/detect/matcher.py:294
        List<Hit> hits = new List();
        for (int idx = 0; idx < lines.size(); idx++) {                                            // src: vvaharness/detect/matcher.py:296
            String line = lines.get(idx);
            if (skipComments && line.lstrip().startsWith("#")) continue;                          // src: vvaharness/detect/matcher.py:297
            hits.addAll(scan.lineHits(live, idx, line, θ));                                       // src: vvaharness/detect/matcher.py:299
        }
        return hits;
    }
}

/** _FileScan: one file's detector pass; memoises spans per (span, span_end, span_max_lines, line, col) so same-anchor rules share one walk. */
@executedBy(CODE) @role(step) @stage("S0")
class FileScan {

    String relPath; List<String> lines; Map<Object, Pair<String, Integer>> spans;                 // src: vvaharness/detect/matcher.py:243

    Pair<String, Integer> span(CompiledDetector det, int idx, int start, Theta θ) {
        Object key = List.of(det.spec.span, det.spec.spanEnd, det.spec.spanMaxLines, idx, start); // src: vvaharness/detect/matcher.py:253
        if (!spans.containsKey(key)) spans.put(key, Matcher.spanFor(det, lines, idx, start, θ));  // src: vvaharness/detect/matcher.py:255
        return spans.get(key);
    }

    /** True when the present gate misses, the (widened) absent gate matches, or the proximity gate fails. */
    boolean rejected(CompiledDetector det, int idx, String body, int endLine) {
        return (det.present != null && !det.present.search(body))                                 // src: vvaharness/detect/matcher.py:261
            || (det.absent != null && det.absent.search(Matcher.guardText(det, lines, idx, body, endLine))) // src: vvaharness/detect/matcher.py:262
            || !Matcher.nearOk(det, lines, idx);                                                  // src: vvaharness/detect/matcher.py:264
    }

    Hit hit(CompiledDetector det, int idx, String line, int start, Theta θ) {
        Pair<String, Integer> sp = span(det, idx, start, θ);                                      // src: vvaharness/detect/matcher.py:269
        if (sp == null) return null;                                                              // never closed within the cap: do not guess. src: vvaharness/detect/matcher.py:270
        if (rejected(det, idx, sp.first, sp.second)) return null;                                 // src: vvaharness/detect/matcher.py:273
        return new Hit(relPath, idx + 1, det.spec, line.strip().head(θ["code.detect.matcher.snippet_max_chars"]), sp.second); // src: vvaharness/detect/matcher.py:275
    }

    /** One hit per rule per line: each detector searches the line once (first match is the anchor). */
    List<Hit> lineHits(List<CompiledDetector> live, int idx, String line, Theta θ) {
        List<Hit> out = new List();
        for (CompiledDetector det : live) {                                                       // src: vvaharness/detect/matcher.py:281
            Match m = det.pattern.search(line);
            if (m == null) continue;
            Hit h = hit(det, idx, line, m.start(), θ);                                            // src: vvaharness/detect/matcher.py:283
            if (h != null) out.add(h);
        }
        return out;
    }
}
