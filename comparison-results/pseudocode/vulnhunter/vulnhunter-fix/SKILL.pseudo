// file: vulnhunter-fix/SKILL.md
// Top-level vulnhunter-fix skill: mode dispatch, mandatory first actions (Opus gate, version check, preflight, gh auth),
// the git/gh failure policy, task tracking, non-negotiable rules, phase-boundary checkpoints, and the
// Parse -> Plan -> Implement -> Verify -> Sweep -> Deliver workflow that calls each phase's prompt file.

@executedBy(MODEL) @role(skill) @stage("fix")
class VulnhunterFixSkill {

    // ---------------------------------------------------------------------------------------------
    // Entry point: the whole procedure the model follows when /vulnhunter-fix is invoked.
    // ---------------------------------------------------------------------------------------------
    Result run(Invocation inv, Theta θ) {
        Prompt p = systemPrompt(θ);
        // Mode dispatch happens before any other action.
        Dispatch d = dispatchMode(inv, θ);                                                              // src: vulnhunter-fix/SKILL.md:41
        if (d == null) return Result.stopped("Cannot proceed without TARGET_REPO and RESULTS_PATH when run outside a GitHub checkout."); // src: vulnhunter-fix/SKILL.md:86
        // Mandatory first actions.
        if (d.mode == Mode.IN_PLACE && !inv.headless) {
            if (!opusGate(inv, θ)) return Result.stopped("calibrated for Opus");                       // src: vulnhunter-fix/SKILL.md:99
            if (!skillVersionCheck(θ)) return Result.stopped("stale skill install");                    // src: vulnhunter-fix/SKILL.md:115
        }
        if (!preflight(θ)) return Result.stopped("preflight failed");                                    // src: vulnhunter-fix/SKILL.md:143
        if (!ghAuthCheck(d, θ)) return Result.stopped("gh auth failed");                                 // src: vulnhunter-fix/SKILL.md:149
        if (!(d.mode == Mode.IN_PLACE && θ["p.skill_vulnhunter-fix.in_place_skips_steps"].contains(2))) {        // src: vulnhunter-fix/SKILL.md:62
            if (!validateInputs(d, θ)) return Result.stopped("missing inputs");                         // src: vulnhunter-fix/SKILL.md:252
        }
        Config cfg = loadConfig(θ);                                                                       // src: vulnhunter-fix/SKILL.md:260
        WorkDir wd = setupWorkDir(d, cfg, θ);                                                             // src: vulnhunter-fix/SKILL.md:264
        startTaskTracking(d, inv, θ);                                                                     // src: vulnhunter-fix/SKILL.md:272
        return workflow(d, cfg, wd, θ);                                                                   // src: vulnhunter-fix/SKILL.md:312
    }

    // ---------------------------------------------------------------------------------------------
    // Prompt sections (what the model reads, in document order).
    // ---------------------------------------------------------------------------------------------
    Prompt systemPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(overview(θ));
        p.include(modes(θ));
        p.include(mandatoryFirstActions(θ));
        p.include(gitGhFailurePolicy(θ));
        p.include(handoffTemplates(θ));
        p.include(taskTracking(θ));
        p.include(nonNegotiableRules(θ));
        p.include(phaseBoundaryCheckpoints(θ));
        p.include(workflowSection(θ));
        p.include(keyPrinciples(θ));
        p.include(configurationSection(θ));
        return p;
    }

    Prompt overview(Theta θ) {
        Prompt p = new Prompt();
        p.persona("VulnFix: automated security remediation via TDD from VulnHunter scan results");      // src: vulnhunter-fix/SKILL.md:20
        p.step(1, "Parse findings from the report (or vulnhunter-labeled issues in in-place mode)");     // src: vulnhunter-fix/SKILL.md:25
        p.step(2, "Plan fix order and approach");                                                       // src: vulnhunter-fix/SKILL.md:26
        p.step(3, "For each vulnerability: exploit demo -> failing test -> fix -> verify test passes");   // src: vulnhunter-fix/SKILL.md:27
        p.step(4, "Deliver as PRs to a private fork (fork mode) or the same repo (in-place mode)");       // src: vulnhunter-fix/SKILL.md:28
        return p;
    }

    Prompt modes(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.skill_vulnhunter-fix.mode_set"]);                                                 // src: vulnhunter-fix/SKILL.md:32
        p.rule(θ["p.skill_vulnhunter-fix.in_place_worktree_root"]);                                     // src: vulnhunter-fix/SKILL.md:36
        p.rule(θ["p.skill_vulnhunter-fix.fork_mode_clone_and_fork"]);                                   // src: vulnhunter-fix/SKILL.md:37
        p.must(θ["p.skill_vulnhunter-fix.mode_dispatch_first"]);                                        // src: vulnhunter-fix/SKILL.md:41
        p.choose(θ["p.skill_vulnhunter-fix.dispatch_outcomes"]);                                        // src: vulnhunter-fix/SKILL.md:44
        p.rule(θ["p.skill_vulnhunter-fix.in_place_trigger_condition"]);                                 // src: vulnhunter-fix/SKILL.md:55
        p.rule(θ["p.skill_vulnhunter-fix.fork_trigger_condition"]);                                     // src: vulnhunter-fix/SKILL.md:56
        p.must(θ["p.skill_vulnhunter-fix.export_dispatch_fields"]);                                     // src: vulnhunter-fix/SKILL.md:60
        p.rule(θ["p.skill_vulnhunter-fix.in_place_skips_steps"]);                                       // src: vulnhunter-fix/SKILL.md:62
        p.rule(θ["p.skill_vulnhunter-fix.in_place_local_results_switch"]);                              // src: vulnhunter-fix/SKILL.md:66
        p.format(θ["p.skill_vulnhunter-fix.no_source_issues_pr_language"]);                             // src: vulnhunter-fix/SKILL.md:66
        p.must(θ["p.skill_vulnhunter-fix.ambiguous_ask_user"]);                                         // src: vulnhunter-fix/SKILL.md:72
        p.forbid(θ["p.skill_vulnhunter-fix.ambiguous_no_guess"]);                                       // src: vulnhunter-fix/SKILL.md:77
        p.must(θ["p.skill_vulnhunter-fix.none_collect_inputs"]);                                        // src: vulnhunter-fix/SKILL.md:81
        p.rule(θ["p.skill_vulnhunter-fix.none_stop_without_inputs"]);                                   // src: vulnhunter-fix/SKILL.md:86
        return p;
    }

    Prompt mandatoryFirstActions(Theta θ) {
        Prompt p = new Prompt();
        p.step(0, θ["p.skill_vulnhunter-fix.opus_gate"]);                                               // src: vulnhunter-fix/SKILL.md:99
        p.rule(θ["p.skill_vulnhunter-fix.opus_gate_self_check_method"]);                                // src: vulnhunter-fix/SKILL.md:103
        p.format(θ["p.skill_vulnhunter-fix.opus_gate_stop_on_sonnet_haiku"]);                           // src: vulnhunter-fix/SKILL.md:108
        p.exemption(θ["p.skill_vulnhunter-fix.opus_gate_headless_skip"]);                               // src: vulnhunter-fix/SKILL.md:111
        p.rule(θ["p.skill_vulnhunter-fix.opus_gate_applies_after_model_switch"]);                       // src: vulnhunter-fix/SKILL.md:113
        p.step(0, θ["p.skill_vulnhunter-fix.skill_version_check"]);                                     // src: vulnhunter-fix/SKILL.md:115
        p.rule(θ["p.skill_vulnhunter-fix.version_missing_sha_warn"]);                                   // src: vulnhunter-fix/SKILL.md:137
        p.must(θ["p.skill_vulnhunter-fix.version_mismatch_stop"]);                                      // src: vulnhunter-fix/SKILL.md:138
        p.exemption(θ["p.skill_vulnhunter-fix.version_check_api_fail_proceed"]);                        // src: vulnhunter-fix/SKILL.md:139
        p.must(θ["p.skill_vulnhunter-fix.preflight_fail_stop"]);                                        // src: vulnhunter-fix/SKILL.md:147
        p.step(1, θ["p.skill_vulnhunter-fix.gh_auth_check_via_bash"]);                                  // src: vulnhunter-fix/SKILL.md:149
        p.rule(θ["p.skill_vulnhunter-fix.in_place_origin_visibility_check"]);                           // src: vulnhunter-fix/SKILL.md:154
        return p;
    }

    Prompt gitGhFailurePolicy(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_vulnhunter-fix.git_gh_failure_policy_overrides"]);                            // src: vulnhunter-fix/SKILL.md:162
        p.checklist(θ["p.skill_vulnhunter-fix.git_gh_failure_trigger_set"]);                            // src: vulnhunter-fix/SKILL.md:166
        p.exemption(θ["p.skill_vulnhunter-fix.git_gh_expected_nonzero_exempt"]);                        // src: vulnhunter-fix/SKILL.md:169
        p.step(1, θ["p.skill_vulnhunter-fix.git_gh_no_retry_no_equivalent_tool"]);                      // src: vulnhunter-fix/SKILL.md:173
        p.step(2, θ["p.skill_vulnhunter-fix.git_gh_single_handoff_command"]);                           // src: vulnhunter-fix/SKILL.md:181
        p.format(θ["p.skill_vulnhunter-fix.handoff_format_elements"]);                                  // src: vulnhunter-fix/SKILL.md:195
        p.forbid(θ["p.skill_vulnhunter-fix.handoff_no_line_continuation"]);                             // src: vulnhunter-fix/SKILL.md:202
        p.step(3, θ["p.skill_vulnhunter-fix.handoff_wait_for_paste"]);                                  // src: vulnhunter-fix/SKILL.md:204
        p.step(4, θ["p.skill_vulnhunter-fix.handoff_use_paste_verbatim"]);                              // src: vulnhunter-fix/SKILL.md:206
        p.must(θ["p.skill_vulnhunter-fix.handoff_clone_path_inside_workdir"]);                          // src: vulnhunter-fix/SKILL.md:206
        p.step(5, θ["p.skill_vulnhunter-fix.handoff_one_at_a_time"]);                                   // src: vulnhunter-fix/SKILL.md:208
        p.exemption(θ["p.skill_vulnhunter-fix.retry_exception_user_says"]);                             // src: vulnhunter-fix/SKILL.md:211
        p.exemption(θ["p.skill_vulnhunter-fix.retry_exception_real_api_error"]);                        // src: vulnhunter-fix/SKILL.md:212
        p.rule(θ["p.skill_vulnhunter-fix.failure_policy_all_phases"]);                                  // src: vulnhunter-fix/SKILL.md:214
        return p;
    }

    Prompt handoffTemplates(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_vulnhunter-fix.handoff_proxy_env_prefix_required"]);                          // src: vulnhunter-fix/SKILL.md:218
        p.format(θ["p.skill_vulnhunter-fix.go_proxy_prefix"]);                                          // src: vulnhunter-fix/SKILL.md:222
        p.rule("npm / pip / maven: TBD - run from a shell with corporate registry config");              // src: vulnhunter-fix/SKILL.md:223
        p.must(θ["p.skill_vulnhunter-fix.go_prefix_same_line"]);                                        // src: vulnhunter-fix/SKILL.md:241
        p.must(θ["p.skill_vulnhunter-fix.gh_always_pass_repo"]);                                        // src: vulnhunter-fix/SKILL.md:245
        p.rule(θ["p.skill_vulnhunter-fix.prefer_git_over_gh_local"]);                                   // src: vulnhunter-fix/SKILL.md:246
        p.rule(θ["p.skill_vulnhunter-fix.gh_only_for_github_data"]);                                    // src: vulnhunter-fix/SKILL.md:250
        return p;
    }

    Prompt taskTracking(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_vulnhunter-fix.task_tracking_mandatory"]);                                    // src: vulnhunter-fix/SKILL.md:272
        p.threshold(θ["p.skill_vulnhunter-fix.task_tracking_fork_threshold"]);                          // src: vulnhunter-fix/SKILL.md:272
        p.rule(θ["p.skill_vulnhunter-fix.task_per_finding_parse"]);                                     // src: vulnhunter-fix/SKILL.md:276
        p.rule(θ["p.skill_vulnhunter-fix.task_description_plan"]);                                      // src: vulnhunter-fix/SKILL.md:277
        p.rule(θ["p.skill_vulnhunter-fix.task_status_implement"]);                                      // src: vulnhunter-fix/SKILL.md:278
        p.rule(θ["p.skill_vulnhunter-fix.task_subtasks_collab_loop"]);                                  // src: vulnhunter-fix/SKILL.md:278
        p.rule(θ["p.skill_vulnhunter-fix.task_per_cluster_verify"]);                                    // src: vulnhunter-fix/SKILL.md:279
        p.rule(θ["p.skill_vulnhunter-fix.task_per_cluster_deliver"]);                                   // src: vulnhunter-fix/SKILL.md:280
        p.forbid(θ["p.skill_vulnhunter-fix.no_issue_close_at_delivery"]);                               // src: vulnhunter-fix/SKILL.md:280
        p.must(θ["p.skill_vulnhunter-fix.tasklist_before_handoff"]);                                    // src: vulnhunter-fix/SKILL.md:282
        return p;
    }

    Prompt nonNegotiableRules(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.skill_vulnhunter-fix.no_fast_path"]);                                             // src: vulnhunter-fix/SKILL.md:288
        p.checklist(θ["p.skill_vulnhunter-fix.no_fast_path_trigger_set"]);                              // src: vulnhunter-fix/SKILL.md:291
        p.forbid(θ["p.skill_vulnhunter-fix.no_fast_path_stop_no_offer"]);                               // src: vulnhunter-fix/SKILL.md:295
        p.must(θ["p.skill_vulnhunter-fix.refuse_operator_skip_request"]);                               // src: vulnhunter-fix/SKILL.md:297
        return p;
    }

    Prompt phaseBoundaryCheckpoints(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["prompt.fix.operator_gate"]);                                                           // src: vulnhunter-fix/SKILL.md:299
        p.checklist(θ["p.skill_vulnhunter-fix.checkpoint_phase_list"]);                                 // src: vulnhunter-fix/SKILL.md:301
        p.step(1, θ["p.skill_vulnhunter-fix.checkpoint_verify_artifacts"]);                             // src: vulnhunter-fix/SKILL.md:303
        p.step(2, θ["p.skill_vulnhunter-fix.checkpoint_summary"]);                                      // src: vulnhunter-fix/SKILL.md:304
        p.step(3, θ["p.skill_vulnhunter-fix.checkpoint_approve_pause_question"]);                       // src: vulnhunter-fix/SKILL.md:305
        p.step(4, θ["p.skill_vulnhunter-fix.checkpoint_no_read_ahead"]);                                // src: vulnhunter-fix/SKILL.md:306
        p.must(θ["p.skill_vulnhunter-fix.checkpoint_missing_artifacts_stop"]);                          // src: vulnhunter-fix/SKILL.md:308
        return p;
    }

    Prompt workflowSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_vulnhunter-fix.plan_prompt_by_mode"]);                                        // src: vulnhunter-fix/SKILL.md:319
        p.rule(θ["p.skill_vulnhunter-fix.skip_fork_sections_in_place"]);                                // src: vulnhunter-fix/SKILL.md:322
        p.checklist(θ["p.skill_vulnhunter-fix.tdd_six_step_order"]);                                    // src: vulnhunter-fix/SKILL.md:324
        p.must(θ["p.skill_vulnhunter-fix.red_evidence_persisted"]);                                     // src: vulnhunter-fix/SKILL.md:326
        p.forbid(θ["p.skill_vulnhunter-fix.no_source_edit_before_red"]);                                // src: vulnhunter-fix/SKILL.md:327
        p.checklist(θ["p.skill_vulnhunter-fix.seven_gates_before_pr"]);                                 // src: vulnhunter-fix/SKILL.md:338
        return p;
    }

    Prompt keyPrinciples(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_vulnhunter-fix.done_requires_test"]);                                         // src: vulnhunter-fix/SKILL.md:342
        p.rule(θ["p.skill_vulnhunter-fix.pr_unit_by_mode"]);                                            // src: vulnhunter-fix/SKILL.md:343
        p.evidence(θ["p.skill_vulnhunter-fix.pr_evidence_contents"]);                                   // src: vulnhunter-fix/SKILL.md:344
        p.choose(θ["p.skill_vulnhunter-fix.delivery_triage_buckets"]);                                  // src: vulnhunter-fix/SKILL.md:345
        p.rule(θ["p.skill_vulnhunter-fix.pr_draft_flag_scope"]);                                        // src: vulnhunter-fix/SKILL.md:345
        p.rule(θ["p.skill_vulnhunter-fix.unattended_within_phase"]);                                    // src: vulnhunter-fix/SKILL.md:346
        p.rule(θ["p.skill_vulnhunter-fix.fork_private_collaborators"]);                                 // src: vulnhunter-fix/SKILL.md:347
        return p;
    }

    Prompt configurationSection(Theta θ) {
        Prompt p = new Prompt();
        p.context("config.json keys: github.host, default_target_org, fork_org, fork_prefix, pr_draft, verification.max_repair_attempts, behavior.*, collaborators_file"); // src: vulnhunter-fix/SKILL.md:375
        p.rule(θ["p.skill_vulnhunter-fix.in_place_collab_loop_uncapped"]);                              // src: vulnhunter-fix/SKILL.md:381
        p.context("env overrides: VULNFIX_GH_HOST, VULNFIX_BASE_BRANCH, GH_HOST");                      // src: vulnhunter-fix/SKILL.md:389
        return p;
    }

    // ---------------------------------------------------------------------------------------------
    // Mode dispatch (scripts/detect_mode.sh is the source of truth; model parses its stdout).
    // ---------------------------------------------------------------------------------------------
    @executedBy(MIXED)
    Dispatch dispatchMode(Invocation inv, Theta θ) {
        // runs before any other action: θ["p.skill_vulnhunter-fix.mode_dispatch_first"]                     // src: vulnhunter-fix/SKILL.md:41
        Dispatch d = DetectMode.run(inv.targetRepo, inv.resultsPath);                                   // src: vulnhunter-fix/SKILL.md:46
        // d.outcome is one of θ["p.skill_vulnhunter-fix.dispatch_outcomes"]
        if (d.outcome == "ambiguous" && θ["p.skill_vulnhunter-fix.ambiguous_ask_user"]) {                // src: vulnhunter-fix/SKILL.md:72
            Answer a = askUserQuestion(List.of("In-place - fix <owner_repo> (current checkout)", "Fork mode - fix <target> using <results>")); // src: vulnhunter-fix/SKILL.md:74
            // ambiguous_no_guess: block until the developer answers; never pick on their behalf
            waitFor(a, θ["p.skill_vulnhunter-fix.ambiguous_no_guess"]);                                   // src: vulnhunter-fix/SKILL.md:77
            if (a.isInPlace()) d = DetectMode.run("", "");                                              // src: vulnhunter-fix/SKILL.md:74
            else d = DetectMode.run(inv.targetRepo, inv.resultsPath);                                   // src: vulnhunter-fix/SKILL.md:75
        }
        if (d.outcome == "none" && θ["p.skill_vulnhunter-fix.none_collect_inputs"]) {                    // src: vulnhunter-fix/SKILL.md:81
            Answer a = askUserQuestion(List.of("TARGET_REPO", "RESULTS_PATH"));                          // src: vulnhunter-fix/SKILL.md:83
            if (a.missingAny() && θ["p.skill_vulnhunter-fix.none_stop_without_inputs"]) return null;     // src: vulnhunter-fix/SKILL.md:86
            d = DetectMode.run(a.targetRepo, a.resultsPath);                                            // src: vulnhunter-fix/SKILL.md:86
        }
        // in_place: CWD in a git tree with GitHub origin, no TARGET_REPO
        if (d.outcome == "in_place") assert θ["p.skill_vulnhunter-fix.in_place_trigger_condition"];      // src: vulnhunter-fix/SKILL.md:55
        // fork: TARGET_REPO AND RESULTS_PATH supplied, CWD not a git tree
        if (d.outcome == "fork") assert θ["p.skill_vulnhunter-fix.fork_trigger_condition"];              // src: vulnhunter-fix/SKILL.md:56
        if (d.outcome == "in_place" && d.results != null && θ["p.skill_vulnhunter-fix.in_place_local_results_switch"]) { // src: vulnhunter-fix/SKILL.md:66
            d.noSourceIssues = true;
            d.prLanguage = θ["p.skill_vulnhunter-fix.no_source_issues_pr_language"];                     // src: vulnhunter-fix/SKILL.md:66
        }
        if (θ["p.skill_vulnhunter-fix.export_dispatch_fields"]) env.export(d.ownerRepo, d.root, d.target, d.results); // src: vulnhunter-fix/SKILL.md:60
        d.mode = Mode.of(d.outcome, θ["p.skill_vulnhunter-fix.mode_set"]);                                // src: vulnhunter-fix/SKILL.md:32
        return d;
    }

    // ---------------------------------------------------------------------------------------------
    // Mandatory first actions.
    // ---------------------------------------------------------------------------------------------
    boolean opusGate(Invocation inv, Theta θ) {
        if (inv.headless && θ["p.skill_vulnhunter-fix.opus_gate_headless_skip"]) return true;            // src: vulnhunter-fix/SKILL.md:111
        String me = θ["p.skill_vulnhunter-fix.opus_gate_self_check_method"] ? sessionSystemPrompt.modelName() : null; // src: vulnhunter-fix/SKILL.md:103
        // applies even if the user just switched models (the /model switch takes effect next turn)
        boolean recheck = θ["p.skill_vulnhunter-fix.opus_gate_applies_after_model_switch"];             // src: vulnhunter-fix/SKILL.md:113
        if (me.matches(θ["p.skill_vulnhunter-fix.opus_gate"])) return true;                              // src: vulnhunter-fix/SKILL.md:107
        if (me.matches("Sonnet 4.x") || me.matches("Haiku 4.x")) {                                       // src: vulnhunter-fix/SKILL.md:108
            say("This skill is calibrated for Opus. Please run /model " + θ["p.skill_vulnhunter-fix.opus_gate_stop_on_sonnet_haiku"] + " and then re-invoke /vulnhunter-fix."); // src: vulnhunter-fix/SKILL.md:108
            return false;                                                                                 // no other tool calls
        }
        return true;                                                                                      // unclear: models outside the table are not addressed
    }

    @executedBy(MIXED)
    boolean skillVersionCheck(Theta θ) {
        if (!θ["p.skill_vulnhunter-fix.skill_version_check"]) return true;                               // src: vulnhunter-fix/SKILL.md:115
        String upstream = bash("gh api repos/capitalone/vulnhunter/branches/main --jq .commit.sha");    // src: vulnhunter-fix/SKILL.md:121
        String installed = readFileOrEmpty("<SKILL_DIR>/.installed-from");                               // src: vulnhunter-fix/SKILL.md:126
        if (upstream == null) {                                                                           // gh api failed
            if (θ["p.skill_vulnhunter-fix.version_check_api_fail_proceed"] == "warn and proceed") { warn("version check failed"); return true; } // src: vulnhunter-fix/SKILL.md:139
        }
        if (installed.isEmpty()) {
            if (θ["p.skill_vulnhunter-fix.version_missing_sha_warn"] == "warn and proceed") { warn("Could not determine installed skill version"); return true; } // src: vulnhunter-fix/SKILL.md:137
        }
        if (!installed.equals(upstream)) {
            if (θ["p.skill_vulnhunter-fix.version_mismatch_stop"] == "stop") {                             // src: vulnhunter-fix/SKILL.md:138
                handoffToUser("cd <path-to-cloned-vulnhunter-repo> && git pull origin main && ./install.sh", θ); // src: vulnhunter-fix/SKILL.md:138
                return false;
            }
        }
        return true;                                                                                      // src: vulnhunter-fix/SKILL.md:136
    }

    @executedBy(MIXED)
    boolean preflight(Theta θ) {
        int rc = ScriptsPreflight.run();                                                                       // src: vulnhunter-fix/SKILL.md:145
        if (rc != 0 && θ["p.skill_vulnhunter-fix.preflight_fail_stop"]) { report("preflight failed"); return false; } // src: vulnhunter-fix/SKILL.md:147
        return true;
    }

    @executedBy(MIXED)
    boolean ghAuthCheck(Dispatch d, Theta θ) {
        if (θ["p.skill_vulnhunter-fix.gh_auth_check_via_bash"]) {                                        // src: vulnhunter-fix/SKILL.md:149
            if (!bashOk("gh auth status")) return onGitGhFailure("gh auth status", θ);                    // src: vulnhunter-fix/SKILL.md:151
            if (!bashOk("gh api user --jq .login")) return onGitGhFailure("gh api user", θ);              // src: vulnhunter-fix/SKILL.md:152
        }
        if (d.mode == Mode.IN_PLACE && θ["p.skill_vulnhunter-fix.in_place_origin_visibility_check"]) {   // src: vulnhunter-fix/SKILL.md:154
            if (!bashOk("gh repo view \"$OWNER_REPO\" --json name,owner")) return onGitGhFailure("gh repo view", θ); // src: vulnhunter-fix/SKILL.md:156
        }
        return true;
    }

    boolean validateInputs(Dispatch d, Theta θ) {
        if (d.mode == Mode.FORK && θ["p.skill_vulnhunter-fix.fork_inputs_required"]) {                   // src: vulnhunter-fix/SKILL.md:254
            if (d.target == null) d.target = ask("Which GitHub repo should I fix?");                       // src: vulnhunter-fix/SKILL.md:255
            if (d.results == null) d.results = ask("Where are the VulnHunter results?");                   // src: vulnhunter-fix/SKILL.md:256
            return d.target != null && d.results != null;
        }
        return true;                                                                                      // in-place: skip (src: vulnhunter-fix/SKILL.md:258)
    }

    Config loadConfig(Theta θ) {
        if (θ["p.skill_vulnhunter-fix.load_config_json"]) return VulnhunterFixConfig.run(θ);             // src: vulnhunter-fix/SKILL.md:262
        return null;
    }

    @executedBy(MIXED)
    WorkDir setupWorkDir(Dispatch d, Config cfg, Theta θ) {
        WorkDir wd = new WorkDir();
        if (d.mode == Mode.FORK) {
            // Step 5 (clone into ./work/) is skipped in in-place mode: θ["p.skill_vulnhunter-fix.in_place_skips_steps"]
            wd.path = "./work/<fork-repo-name>/";                                                          // src: vulnhunter-fix/SKILL.md:266
            wd.deleteAfterDelivery = θ["p.skill_vulnhunter-fix.fork_clone_deleted_after_delivery"];        // src: vulnhunter-fix/SKILL.md:266
            return wd;
        }
        wd.path = θ["p.skill_vulnhunter-fix.in_place_worktree_root"];                                     // src: vulnhunter-fix/SKILL.md:268
        if (θ["p.skill_vulnhunter-fix.workdir_excluded_via_git_info"]) appendTo(".git/info/exclude", ".vulnhunter-fix/"); // src: vulnhunter-fix/SKILL.md:268
        if (θ["p.skill_vulnhunter-fix.worktree_prune_on_start"]) bash("git worktree prune");             // src: vulnhunter-fix/SKILL.md:268
        wd.worktreesPerCluster = θ["p.skill_vulnhunter-fix.one_worktree_per_cluster"];                    // src: vulnhunter-fix/SKILL.md:268
        return wd;
    }

    // ---------------------------------------------------------------------------------------------
    // git / gh failure policy: STOP and hand off ONE command to the user.
    // ---------------------------------------------------------------------------------------------
    boolean onGitGhFailure(String toolCall, Theta θ) {
        Failure f = lastFailure();
        if (f.isDocumentedExpectedNonZero() && θ["p.skill_vulnhunter-fix.git_gh_expected_nonzero_exempt"]) return true; // src: vulnhunter-fix/SKILL.md:169
        if (f.isRealApiError() && θ["p.skill_vulnhunter-fix.retry_exception_real_api_error"]) return handleInFlow(f); // src: vulnhunter-fix/SKILL.md:212
        if (userSaid("try a different approach") && θ["p.skill_vulnhunter-fix.retry_exception_user_says"]) return retry(toolCall); // src: vulnhunter-fix/SKILL.md:211
        if (!f.matchesAny(θ["p.skill_vulnhunter-fix.git_gh_failure_trigger_set"])) return false;        // src: vulnhunter-fix/SKILL.md:166
        // 1. STOP: no retry, no different flags, no equivalent tool (git clone -> gh repo clone, curl, ...)
        if (θ["p.skill_vulnhunter-fix.git_gh_no_retry_no_equivalent_tool"]) stopRetrying();              // src: vulnhunter-fix/SKILL.md:173
        String cmd = withProxyPrefix(toolCall, θ);
        return handoffToUser(cmd, θ);
    }

    String withProxyPrefix(String cmd, Theta θ) {
        if (cmd.isGoToolchain() && θ["p.skill_vulnhunter-fix.handoff_proxy_env_prefix_required"]) {      // src: vulnhunter-fix/SKILL.md:218
            // prefix must be on the same line as the go command
            if (θ["p.skill_vulnhunter-fix.go_prefix_same_line"]) return θ["p.skill_vulnhunter-fix.go_proxy_prefix"] + " " + cmd; // src: vulnhunter-fix/SKILL.md:241
        }
        if (cmd.isGh() && θ["p.skill_vulnhunter-fix.gh_always_pass_repo"]) cmd = cmd + " --repo \"$OWNER_REPO\""; // src: vulnhunter-fix/SKILL.md:245
        return cmd;                                                                                       // npm/pip/maven prefixes: TBD (src: vulnhunter-fix/SKILL.md:223)
    }

    boolean handoffToUser(String cmd, Theta θ) {
        // 2. exactly ONE command, single line, formatted with warning marker, bold CTA, fenced bash block, why-line after
        assert countCommands(cmd) == θ["p.skill_vulnhunter-fix.git_gh_single_handoff_command"];          // src: vulnhunter-fix/SKILL.md:181
        if (θ["p.skill_vulnhunter-fix.handoff_no_line_continuation"]) cmd = cmd.singleLine();            // src: vulnhunter-fix/SKILL.md:202
        if (cmd.isClone()) cmd = cmd.withDestinationUnder(θ["p.skill_vulnhunter-fix.handoff_clone_path_inside_workdir"]); // src: vulnhunter-fix/SKILL.md:206
        say(renderHandoff(cmd, θ["p.skill_vulnhunter-fix.handoff_format_elements"]));                   // src: vulnhunter-fix/SKILL.md:195
        // 3. wait; no further git/gh calls meanwhile
        String paste = θ["p.skill_vulnhunter-fix.handoff_wait_for_paste"] ? waitForUserPaste() : null;    // src: vulnhunter-fix/SKILL.md:204
        // 4. use the paste verbatim as the step's output
        if (θ["p.skill_vulnhunter-fix.handoff_use_paste_verbatim"]) useAsOutput(paste);                  // src: vulnhunter-fix/SKILL.md:206
        // 5. one command at a time; never batch
        assert θ["p.skill_vulnhunter-fix.handoff_one_at_a_time"];                                         // src: vulnhunter-fix/SKILL.md:208
        return paste != null;
    }

    // ---------------------------------------------------------------------------------------------
    // Task tracking (TaskCreate / TaskUpdate / TaskList).
    // ---------------------------------------------------------------------------------------------
    void startTaskTracking(Dispatch d, Invocation inv, Theta θ) {
        boolean on = θ["p.skill_vulnhunter-fix.task_tracking_mandatory"]                                   // src: vulnhunter-fix/SKILL.md:272
            && (d.mode == Mode.IN_PLACE || inv.findingCount > θ["p.skill_vulnhunter-fix.task_tracking_fork_threshold"]); // src: vulnhunter-fix/SKILL.md:272
        tasks.enabled = on;
    }

    void trackPhase(String phase, PhaseOutput out, Theta θ) {
        if (!tasks.enabled) return;
        if (phase == "Parse" && θ["p.skill_vulnhunter-fix.task_per_finding_parse"]) for (Finding f : out.selected) tasks.create(f.id + " - " + f.title, "pending"); // src: vulnhunter-fix/SKILL.md:276
        if (phase == "Plan" && θ["p.skill_vulnhunter-fix.task_description_plan"]) for (Finding f : out.planned) tasks.describe(f, f.plannedApproach); // src: vulnhunter-fix/SKILL.md:277
        if (phase == "Implement") {
            if (θ["p.skill_vulnhunter-fix.task_status_implement"]) tasks.flipOnStepAAndCommit(out);      // src: vulnhunter-fix/SKILL.md:278
            if (θ["p.skill_vulnhunter-fix.task_subtasks_collab_loop"]) tasks.subtasksForDecisions(out.collabDecisions); // src: vulnhunter-fix/SKILL.md:278
        }
        if (phase == "Verify" && θ["p.skill_vulnhunter-fix.task_per_cluster_verify"]) for (Cluster c : out.clusters) tasks.completeIf("Verify cluster " + c.name, c.redGreenMatrixPassed); // src: vulnhunter-fix/SKILL.md:279
        if (phase == "Deliver" && θ["p.skill_vulnhunter-fix.task_per_cluster_deliver"]) {                // src: vulnhunter-fix/SKILL.md:280
            for (Cluster c : out.clusters) tasks.completeIf("Deliver cluster " + c.name + ": push, PR, comment source issues", c.prUrl != null && c.allIssuesCommented);
            // subject never says "close N issues"; PR Closes #N keywords close them on merge
            assert θ["p.skill_vulnhunter-fix.no_issue_close_at_delivery"];                               // src: vulnhunter-fix/SKILL.md:280
        }
    }

    void reconcileTasks(Theta θ) {
        if (tasks.enabled && θ["p.skill_vulnhunter-fix.tasklist_before_handoff"]) tasks.list();          // src: vulnhunter-fix/SKILL.md:282
    }

    // ---------------------------------------------------------------------------------------------
    // Non-negotiable rules + phase-boundary checkpoints.
    // ---------------------------------------------------------------------------------------------
    boolean guardNoFastPath(Proposal proposal, Theta θ) {
        if (θ["p.skill_vulnhunter-fix.no_fast_path"] && proposal.matchesAny(θ["p.skill_vulnhunter-fix.no_fast_path_trigger_set"])) { // src: vulnhunter-fix/SKILL.md:288
            if (θ["p.skill_vulnhunter-fix.no_fast_path_stop_no_offer"]) proposal.drop();                  // src: vulnhunter-fix/SKILL.md:295
            return false;
        }
        if (operatorSaid("just keep going", "skip the checkpoints") && θ["p.skill_vulnhunter-fix.refuse_operator_skip_request"]) { // src: vulnhunter-fix/SKILL.md:297
            say("rigor steps are not configuration options");
            return false;
        }
        return true;
    }

    boolean checkpoint(String phase, String nextPhase, PhaseOutput out, Theta θ) {
        if (!θ["p.skill_vulnhunter-fix.checkpoint_phase_list"].contains(phase)) return true;              // src: vulnhunter-fix/SKILL.md:301
        reconcileTasks(θ);
        if (θ["p.skill_vulnhunter-fix.checkpoint_verify_artifacts"] && !out.artifactsExistOnDisk()) {     // src: vulnhunter-fix/SKILL.md:303
            if (θ["p.skill_vulnhunter-fix.checkpoint_missing_artifacts_stop"]) { report("missing: " + out.missingArtifacts()); return false; } // src: vulnhunter-fix/SKILL.md:308
        }
        if (θ["p.skill_vulnhunter-fix.checkpoint_summary"]) say(out.summary());                           // src: vulnhunter-fix/SKILL.md:304
        if (θ["prompt.fix.operator_gate"] != null && θ["p.skill_vulnhunter-fix.unattended_within_phase"]) { // src: vulnhunter-fix/SKILL.md:346
            Answer a = askUserQuestion("Phase " + phase + " complete. Proceed to " + nextPhase + "?", θ["p.skill_vulnhunter-fix.checkpoint_approve_pause_question"]); // src: vulnhunter-fix/SKILL.md:305
            // do not open the next phase's prompt file until Approve
            if (θ["p.skill_vulnhunter-fix.checkpoint_no_read_ahead"] && !a.equals("Approve")) return false; // src: vulnhunter-fix/SKILL.md:306
        }
        return true;
    }

    // ---------------------------------------------------------------------------------------------
    // Workflow: Phase 1..5 (each phase = open that phase's prompt file and follow it).
    // ---------------------------------------------------------------------------------------------
    Result workflow(Dispatch d, Config cfg, WorkDir wd, Theta θ) {
        PhaseOutput parsed;
        if (d.mode == Mode.FORK) parsed = PromptsParse.run(d, cfg, θ);                                   // src: vulnhunter-fix/SKILL.md:315
        else parsed = ParseIssues.run(d, cfg, θ);                                                         // src: vulnhunter-fix/SKILL.md:316
        trackPhase("Parse", parsed, θ);
        if (!checkpoint("Parse", "Plan", parsed, θ)) return Result.paused("Parse");

        PhaseOutput plan;
        // in-place: plan.md; fork / headless: plan_fork.md
        if (θ["p.skill_vulnhunter-fix.plan_prompt_by_mode"] != null && d.mode == Mode.IN_PLACE) plan = PromptsPlan.run(parsed, cfg, θ); // src: vulnhunter-fix/SKILL.md:319
        else plan = PlanFork.run(parsed, cfg, θ);                                                         // src: vulnhunter-fix/SKILL.md:319
        // plan.md / plan_fork.md invoke TierJudgment.run(...) when the deterministic classifier returns LLM_REVIEW and route findings to WorkerAgent* prompts
        trackPhase("Plan", plan, θ);
        if (!checkpoint("Plan", "Implement", plan, θ)) return Result.paused("Plan");

        PhaseOutput impl = implementPhase(d, plan, cfg, θ);                                               // src: vulnhunter-fix/SKILL.md:321
        trackPhase("Implement", impl, θ);
        if (!checkpoint("Implement", "Verify", impl, θ)) return Result.paused("Implement");

        // verify.md invokes ReviewerTest.run(...) as a fresh subagent, AgentFix.run(...) in its repair loop, and TierJudgment.run(...) on LLM_REVIEW
        PhaseOutput ver = PromptsVerify.run(impl, cfg, θ);                                                // src: vulnhunter-fix/SKILL.md:333
        trackPhase("Verify", ver, θ);
        if (!checkpoint("Verify", "Sweep", ver, θ)) return Result.paused("Verify");

        PhaseOutput sw = PromptsSweep.run(ver, cfg, θ);                                                   // src: vulnhunter-fix/SKILL.md:301
        if (!checkpoint("Sweep", "Deliver", sw, θ)) return Result.paused("Sweep");

        PhaseOutput del = deliverPhase(d, sw, cfg, wd, θ);                                                // src: vulnhunter-fix/SKILL.md:335
        trackPhase("Deliver", del, θ);
        checkpoint("Deliver", "done", del, θ);
        return Result.done(del);
    }

    PhaseOutput implementPhase(Dispatch d, PhaseOutput plan, Config cfg, Theta θ) {
        // Fork-only sections of implement.md are skipped when running in-place
        boolean skipFork = d.mode == Mode.IN_PLACE && θ["p.skill_vulnhunter-fix.skip_fork_sections_in_place"]; // src: vulnhunter-fix/SKILL.md:322
        // Per finding, on its own branch: exploit demo (RED), security test (RED), fix (GREEN), verify exploit blocked, regression check, commit
        List<String> order = θ["p.skill_vulnhunter-fix.tdd_six_step_order"];                             // src: vulnhunter-fix/SKILL.md:324
        // RED evidence persisted to .vulnhunter-fix/state/<vuln>/red_evidence.json before any fix
        String redPath = θ["p.skill_vulnhunter-fix.red_evidence_persisted"];                            // src: vulnhunter-fix/SKILL.md:326
        // no source edit until Step 2 evidence is on disk
        boolean gate = θ["p.skill_vulnhunter-fix.no_source_edit_before_red"];                            // src: vulnhunter-fix/SKILL.md:327
        // No fix is done until a test proves it works
        boolean doneNeedsTest = θ["p.skill_vulnhunter-fix.done_requires_test"];                          // src: vulnhunter-fix/SKILL.md:342
        return PromptsImplement.run(d.mode, plan, cfg, skipFork, θ);                                      // src: vulnhunter-fix/SKILL.md:322
    }

    PhaseOutput deliverPhase(Dispatch d, PhaseOutput sw, Config cfg, WorkDir wd, Theta θ) {
        // unit of delivery: in-place = cluster, fork = finding
        String unit = θ["p.skill_vulnhunter-fix.pr_unit_by_mode"];                                      // src: vulnhunter-fix/SKILL.md:343
        // seven mechanical gates run BEFORE any gh pr create; any failure -> no PR
        List<String> gates = θ["p.skill_vulnhunter-fix.seven_gates_before_pr"];                          // src: vulnhunter-fix/SKILL.md:338
        // every PR shows exploit, test and fix
        List<String> evidence = θ["p.skill_vulnhunter-fix.pr_evidence_contents"];                         // src: vulnhunter-fix/SKILL.md:344
        // triage each finding into Ready PR / Draft PR / Issue only; pr_draft config is the Draft-bucket default, Ready overrides
        List<String> buckets = θ["p.skill_vulnhunter-fix.delivery_triage_buckets"];                     // src: vulnhunter-fix/SKILL.md:345
        boolean draftScope = θ["p.skill_vulnhunter-fix.pr_draft_flag_scope"];                           // src: vulnhunter-fix/SKILL.md:345
        // fork mode: private fork, collaborators from collaborators.json added when the fork is created
        boolean privateFork = d.mode == Mode.FORK && θ["p.skill_vulnhunter-fix.fork_private_collaborators"]; // src: vulnhunter-fix/SKILL.md:347
        PhaseOutput out = PromptsDeliver.run(d.mode, sw, cfg, θ);                                         // src: vulnhunter-fix/SKILL.md:336
        if (d.mode == Mode.FORK && wd.deleteAfterDelivery && out.success) deleteDir(wd.path);            // src: vulnhunter-fix/SKILL.md:266
        return out;
    }
}
