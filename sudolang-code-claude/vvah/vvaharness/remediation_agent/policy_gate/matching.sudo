// src: vvaharness/remediation_agent/policy_gate/matching.py:21-27
fn _glob_match(path, pat):executor=code {
  if (fnmatch(path, pat)) return true   // external: Python fnmatch; "*" also matches "/"
  if (pat starts with "**/" && fnmatch(path, pat without "**/")) return true   // a bare root-level file still matches "**/x"
  return false
}

// src: vvaharness/remediation_agent/policy_gate/matching.py:30-38
fn _first_match(files, patterns):executor=code {
  for each f in files {
    nf = f with "\\" replaced by "/"
    if (nf is empty) continue
    for each pat in patterns { if (_glob_match(nf, pat)) return pat }
  }
  return null
}
