# vvaharness/backends/harness/deepagents/redaction.py

Read-only session middleware: mask personal data and credential material in results of content-returning native tools, and withhold the write and delete tools from the model. deepagents has no redaction hook on `read_file` or `grep`, and its deny rules fail open, so both are done here.

Source: `vvaharness/backends/harness/deepagents/redaction.py` (lines 1-106)
Executor: code
Called from: `options/graph_builder.py:422-423` (parent, when redact_reads: one-shot when not allow_writes; streaming effectively always) and `options/subagents.py:139` (each subagent whose tools include no mutating tool)

// src: vvaharness/backends/harness/deepagents/redaction.py:94-100
fn read_only_middleware(extra_excluded = {}):executor=code {
  excluded = NATIVE_WRITE_TOOLS union { DELETE_TOOL_NAME } union extra_excluded   // { "edit_file", "write_file", "delete" } plus extras
  return [RedactToolResults(), ExcludeTools(excluded)]   // each subagent needs its own copy
}

// src: vvaharness/backends/harness/deepagents/redaction.py:74-91
RedactToolResults {
  wrap_tool_call(request, handler) {
    result = handler(request)
    if (request.tool_call.name in NATIVE_CONTENT_TOOLS) return _redact_message(result)   // "read_file", "grep" only; glob and ls results are not masked
    return result
  }
  awrap_tool_call(request, handler)   // async counterpart: same masking on the awaited result
}

// src: vvaharness/backends/harness/deepagents/redaction.py:52-62
fn _redact_message(message):executor=code {
  if (message is not a ToolMessage) return message
  rel = message.additional_kwargs.read_file_path || ""
  if (content is a non-empty string) content = redact_counts(sanitize_packed_text(content, rel)).text   // external to this batch: vvaharness.report.redact, vvaharness.backends.llm.tools
  else if (content is a list) content = each block through _redact_block(block, rel)
  return message   // modified in place
}

// src: vvaharness/backends/harness/deepagents/redaction.py:40-49
fn _redact_block(block, rel):executor=code {
  match (block) {
    case a string or { type: "text" } => masked the same way
    case another dict => { type: "text", text: "[binary content elided: ${rel || \"file\"} is not text]" }   // non-text content (for example an image) never reaches the model
    default => block unchanged
  }
}
