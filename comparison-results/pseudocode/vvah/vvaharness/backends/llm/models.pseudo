    // ---------------------------------------------------------------- rejection helpers

    /** The rejection body to match parameter names against, minus any echoed request. */
    @src("vvaharness/backends/llm/models.py:59")
    String rejectionText(Throwable exc) {
        Object body = exc.body;                                                                             // src: vvaharness/backends/llm/models.py:61
        Object detail = body instanceof Map ? body.get("detail") : null;                                    // src: vvaharness/backends/llm/models.py:62
        if (!(detail instanceof List)) {
            return String.valueOf(exc.message != null && !exc.message.isEmpty() ? exc.message : exc);       // src: vvaharness/backends/llm/models.py:64
        }
        List<String> parts = new ArrayList<>();
        for (Object entry : detail) {                                                                       // src: vvaharness/backends/llm/models.py:68
            if (entry instanceof Map) {
                entry = entry.withoutKey("input");                                                          // pydantic input echoes the whole request: drop only that key // src: vvaharness/backends/llm/models.py:70
                if (entry.get("loc") instanceof List) entry.put("loc", String.join(".", entry.get("loc"))); // dot loc to match API spelling // src: vvaharness/backends/llm/models.py:71
            }
            parts.add(String.valueOf(entry));                                                               // src: vvaharness/backends/llm/models.py:72
        }
        return String.join("; ", parts);                                                                    // src: vvaharness/backends/llm/models.py:73
    }

    /** Whether a cause-chain link is a PARAM_REJECTION_STATUS whose body names one of the names. */
    @src("vvaharness/backends/llm/models.py:76")
    boolean isParamRejection(Throwable exc, List<String> names) {
        for (Throwable link : Exceptions.exceptionChain(exc)) {                                             // src: vvaharness/backends/llm/models.py:78
            if (PARAM_REJECTION_STATUS.contains(link.statusCode)) {                                         // src: vvaharness/backends/llm/models.py:79
                String low = rejectionText(link).toLowerCase();                                             // src: vvaharness/backends/llm/models.py:80
                for (String name : names) { if (low.contains(name)) return true; }                          // src: vvaharness/backends/llm/models.py:81
            }
        }
        return false;                                                                                       // src: vvaharness/backends/llm/models.py:84
    }

    /** True for a 200-status stream whose body is itself a parameter-rejection error (SSE error event). */
    @src("vvaharness/backends/llm/models.py:92")
    boolean isGatewayWrappedParamRejection(Throwable exc) {
        // exc.type is the SDK's own parse of the body, so a 200-wrapped transient (overloaded or rate limit) never matches
        return exc.statusCode == 200 && PARAM_REJECTION_ERROR_TYPES.contains(exc.type);                     // src: vvaharness/backends/llm/models.py:100
    }

    // ---------------------------------------------------------------- structured output

    /** The tool whose input schema is the response model. */
    @src("vvaharness/backends/llm/models.py:147")
    Tool responseModelTool(Schema responseModel) {
        return new Tool(RESPONSE_MODEL_TOOL_NAME, "Submit the final " + responseModel.name, responseModel); // title is popped from the schema // src: vvaharness/backends/llm/models.py:151
    }

    // ---------------------------------------------------------------- finish markers

    /** The end-of-reply marker in a reply's response metadata, whichever provider shape it uses. */
    @src("vvaharness/backends/llm/models.py:213")
    String replyFinish(Map meta) {
        Object details = meta.get("incomplete_details");                                                    // src: vvaharness/backends/llm/models.py:215
        if (truthy(meta.get("stop_reason"))) return meta.get("stop_reason");                                // src: vvaharness/backends/llm/models.py:216
        if (truthy(meta.get("finish_reason"))) return meta.get("finish_reason");                            // src: vvaharness/backends/llm/models.py:216
        return details instanceof Map ? details.get("reason") : null;                                       // src: vvaharness/backends/llm/models.py:217
    }

    /** Whether the finish marker is an output-budget cutoff on any route. */
    @src("vvaharness/backends/llm/models.py:220")
    boolean finishTruncated(Object finish) {
        // isinstance first: neither SDK validates this field, and a dict or list is unhashable
        return finish instanceof String && TRUNCATED_FINISHES.contains(finish);                             // src: vvaharness/backends/llm/models.py:223
    }

    /** Output budget for the one truncation retry; null when a request at the cap makes it useless. */
    @src("vvaharness/backends/llm/models.py:233")
    Integer truncationRetryMax(int requested, Integer cap) {
        if (cap != null && requested >= cap) return null;                                                   // src: vvaharness/backends/llm/models.py:235
        int doubled = requested * TRUNCATION_RETRY_MULTIPLIER;                                              // src: vvaharness/backends/llm/models.py:237
        return cap == null ? doubled : Math.min(doubled, cap);                                              // src: vvaharness/backends/llm/models.py:238
    }

    // ---------------------------------------------------------------- jitter and clocks

    /** Seconds scaled by a uniform random factor in 1 minus spread to 1 plus spread; never negative. */
    @src("vvaharness/backends/llm/models.py:245")
    double jitteredDelay(double seconds, Double spread, Random rng) {
        // without jitter the S4/S6 pool workers wake together and recreate the burst; centred on 1.0
        double s = spread != null ? spread : RETRY_JITTER_SPREAD;
        Random r = rng != null ? rng : Random.global();
        double factor = 1.0 + r.uniform(-s, s);                                                             // src: vvaharness/backends/llm/models.py:250
        return Math.max(0.0, seconds * factor);                                                             // src: vvaharness/backends/llm/models.py:251
    }

    /** Session clocks scale with the reasoning-effort tier (request vs session factor table). */
    @src("vvaharness/backends/llm/models.py:275")
    Double effortScaledSeconds(Double seconds, Effort effort, ClockKind kind) {
        // kind is required so no seam can silently pick the wrong table
        if (seconds == null || seconds <= 0) return seconds;                                                // src: vvaharness/backends/llm/models.py:278
        EffortLevel tier = EffortLevelParse.parse(effort);                                                  // src: vvaharness/backends/llm/models.py:280
        if (tier == null) return seconds;                                                                   // src: vvaharness/backends/llm/models.py:281
        double scaled = seconds * EFFORT_TIME_FACTOR.get(kind).get(tier);                                   // src: vvaharness/backends/llm/models.py:283
        return seconds instanceof Integer ? Math.ceil(scaled) : scaled;                                     // an int ceiling stays an int // src: vvaharness/backends/llm/models.py:284
    }

    // ---------------------------------------------------------------- proxy/TLS and timeout failures

    /** Flatten an exception's cause chain (skipping the exception itself), where a proxy/TLS root cause surfaces. */
    @src("vvaharness/backends/llm/models.py:320")
    String causeChain(Throwable e) {
        return String.join(" <- ", Exceptions.exceptionChain(e).skip(1).map(c -> c.typeName + ": " + c));   // src: vvaharness/backends/llm/models.py:322
    }

    /** The cause detail when the exception carries a proxy/TLS signature, else null. */
    @src("vvaharness/backends/llm/models.py:325")
    String proxyDetail(Throwable e) {
        String detail = causeChain(e);                                                                      // src: vvaharness/backends/llm/models.py:327
        if (PROXY_CAUSE_RX.search(detail) != null || PROXY_CAUSE_RX.search(String.valueOf(e)) != null) {    // src: vvaharness/backends/llm/models.py:328
            return !detail.isEmpty() ? detail : String.valueOf(e);                                          // src: vvaharness/backends/llm/models.py:329
        }
        return null;                                                                                        // src: vvaharness/backends/llm/models.py:330
    }

    /** The VVAH-E002 failure when the exception carries a proxy/TLS signature, else null. */
    @src("vvaharness/backends/llm/models.py:333")
    ProxyError proxyError(Throwable e, String backend) {
        String detail = proxyDetail(e);                                                                     // src: vvaharness/backends/llm/models.py:335
        if (detail == null) return null;                                                                    // src: vvaharness/backends/llm/models.py:336
        // status 407 only when a bare 407 appears in the detail; redact BEFORE the cut
        return new ProxyError(Redact.redact(detail).substring(0, PROXY_DETAIL_CAP), Regex.search("\\b407\\b", detail) != null ? 407 : null, backend); // src: vvaharness/backends/llm/models.py:339
    }

    /** Build the typed VVAH-E008 failure and bump its counter; callers raise it from the original exception. */
    @src("vvaharness/backends/llm/models.py:342")
    CallTimeoutError callTimeoutError(String stage, String route, Double budgetS, String effort, String causeText) {
        Counters.bump(LLM_CALL_TIMEOUTS_COUNTER);                                                           // src: vvaharness/backends/llm/models.py:345
        return new CallTimeoutError(causeText, stage, route, budgetS, effort);                              // src: vvaharness/backends/llm/models.py:346
    }

    /** Bump the near-budget counter for a COMPLETED xhigh/max call that used most of its budget. */
    @src("vvaharness/backends/llm/models.py:349")
    void noteBudgetUse(double elapsed, Double budgetS, String effort) {
        if (budgetS == null || budgetS <= 0) return;                                                        // src: vvaharness/backends/llm/models.py:351
        if (!BUDGET_NEAR_TIERS.contains(EffortLevelParse.parse(effort))) return;                            // src: vvaharness/backends/llm/models.py:353
        if (elapsed >= BUDGET_NEAR_RATIO * budgetS) Counters.bump(LLM_CALL_BUDGET_NEAR_COUNTER);            // src: vvaharness/backends/llm/models.py:355
    }

    // ---------------------------------------------------------------- tool allowlists

    /** Normalise a configured allowlist, rejecting the YAML shapes that misbehave downstream. */
    @src("vvaharness/backends/llm/models.py:359")
    List<String> namedTools(List<String> tools, String configKey) {
        // a bare scalar iterates per char; an empty list omits --allowedTools (broader default); null falls back
        if (tools == null) return new ArrayList<>(DEFAULT_READ_TOOLS);                                      // src: vvaharness/backends/llm/models.py:363
        if (tools instanceof String) {                                                                      // src: vvaharness/backends/llm/models.py:364
            throw new ValueError(configKey + " must be a YAML list of tool names, got the bare string");    // ValueError, one catchable type for every bad profile value // src: vvaharness/backends/llm/models.py:367
        }
        List<String> named = new ArrayList<>(tools);                                                        // src: vvaharness/backends/llm/models.py:370
        if (named.isEmpty()) {                                                                              // src: vvaharness/backends/llm/models.py:371
            throw new ValueError(configKey + " is an empty list, which would silently grant a default toolset instead of none"); // src: vvaharness/backends/llm/models.py:372
        }
        if (named.anyMatch(t -> !(t instanceof String))) {                                                  // src: vvaharness/backends/llm/models.py:376
            throw new ValueError(configKey + " must contain only strings");                                 // src: vvaharness/backends/llm/models.py:377
        }
        return named;                                                                                       // src: vvaharness/backends/llm/models.py:380
    }

    /** Validate a detection stage's agentic tool allowlist for the backend it targets. */
    @src("vvaharness/backends/llm/models.py:382")
    List<String> validateDetectionTools(List<String> tools, String configKey, String via) {
        // TRAP: a mutating tool on via sdk delegates to the Agent SDK, which can write the repo
        List<String> named = namedTools(tools, configKey);                                                  // src: vvaharness/backends/llm/models.py:386
