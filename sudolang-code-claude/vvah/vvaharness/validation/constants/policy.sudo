// src: vvaharness/validation/constants/policy.py:27-31
// "No Write: the agent returns structured output; the host persists artifacts and scores them."
VALIDATION_POLICY = ToolPolicy {
  allowed_tools: ["Read", "Grep", "Glob", "Agent"]
  disallowed_tools: ["Write", "Edit", "NotebookEdit", "Bash"]
}
// external: how each backend enforces ToolPolicy lives in vvaharness/backends/harness (outside this batch)

// src: vvaharness/validation/constants/policy.py:33-37
// "Defence in depth: if a future adapter exposes Write, these are the only files it could target."
DEFAULT_ALLOWED_OUTPUT_FILES = { "validation_report.json", "synthesized_gates.json" }
