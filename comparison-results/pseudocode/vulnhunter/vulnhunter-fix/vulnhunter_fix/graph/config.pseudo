// file: vulnhunter-fix/vulnhunter_fix/graph/config.py
// Graph substrate configuration: graphify version pin, cloud-LLM env guard, cache paths,
// language-suffix table and the shared permission-guarded source-file walker.

@executedBy(CODE) @role(config) @stage("fix")
class GraphConfig {

    String graphifyVersionRange(Theta θ) {
        return θ["code.vulnhunter_fix.graph.config.graphify_version_range"];       // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:20
    }

    Path cacheDirForRepo(Path workRoot, String repoName) {
        return workRoot / repoName / "cache";                                        // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:57
    }

    Path graphPathForRepo(Path workRoot, String repoName) {
        return cacheDirForRepo(workRoot, repoName) / "graph.json";                   // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:61
    }

    List<String> checkBackendIsolation(Map<String, String> env, Theta θ) {
        // empty list = AST-only isolation guaranteed; any set var forces grep fallback in Build
        List<String> vars = θ["code.vulnhunter_fix.graph.config.cloud_llm_env_vars"]; // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:24
        return vars.filter(name -> env.get(name) != null && !env.get(name).isEmpty()); // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:70
    }

    String languageForPath(Path path, Theta θ) {
        Map<String, String> suffixes = θ["code.vulnhunter_fix.graph.config.supported_language_suffixes"]; // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:35
        return suffixes.get(path.suffix().lower());                                  // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:74
    }

    Iterator<Path> iterSourceFiles(Path root, Theta θ) {
        for (Path path : safeWalkFiles(root, null, θ)) {                             // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:91
            if (languageForPath(path, θ) != null) yield path;                        // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:92
        }
    }

    Iterator<Path> safeWalkFiles(Path root, Set<String> excludedDirParts, Theta θ) {
        Set<String> excluded = excludedDirParts != null ? excludedDirParts
                             : θ["code.vulnhunter_fix.graph.config.excluded_dir_parts"]; // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:116
        Iterator<Path> candidates;
        try {
            candidates = root.rglob("*");                                            // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:118
        } catch (OSError e) {
            return;                                                                  // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:121
        }
        for (Path path : candidates) {                                               // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:122
            try { if (!path.isFile()) continue; } catch (OSError e) { continue; }    // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:124
            try { if (!excluded.isEmpty() && path.parts().anyMatch(p -> excluded.contains(p))) continue; } catch (OSError e) { continue; } // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:129
            yield path;                                                              // src: vulnhunter-fix/vulnhunter_fix/graph/config.py:133
        }
    }
}
