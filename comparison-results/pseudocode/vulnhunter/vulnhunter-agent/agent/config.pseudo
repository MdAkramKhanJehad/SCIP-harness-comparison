// file: vulnhunter-agent/agent/config.py
// Loads AgentConfig from TOML + env (env VULNHUNT_<SECTION>_<KEY> > TOML > default), one frozen record per section.
// Knob reads here mark where each default is set; the knobs are rendered where they act (runner.pseudo, build_settings.pseudo).

// [anthropic] section. auth_mode: api_key (direct API key), bedrock_oauth (Bedrock proxy behind an OAuth2 client-credentials endpoint,
// needs bedrock_base_url and the oauth block) or bedrock_sigv4 (direct Bedrock with SigV4 via the standard AWS credential chain, needs aws_region).
// Under sigv4 with the sandbox on, IMDS and ECS metadata endpoints are not allow-listed, so container or instance-role credentials need a wider allow-list or no sandbox.
@executedBy(CODE) @role(types) @stage("agent")
record AnthropicConfig(String model, String authMode, String apiKey, String bedrockBaseUrl, String awsRegion, String awsProfile) { }  // src: vulnhunter-agent/agent/config.py:32 (defaults: api_key, empty, empty, us-east-1, empty)

// [repo_properties] section: operator-declared GitHub custom-property name to emitted findings-field name. Empty by default: nothing is fetched
// or emitted unless declared. TOML only (a table has no scalar env form); the CLI --repo-property flag supplies per-run overrides.
@executedBy(CODE) @role(types) @stage("agent")
record RepoPropertiesConfig(Map<String, String> githubPropertyMap) { }                    // src: vulnhunter-agent/agent/config.py:294

@executedBy(CODE) @role(config) @stage("agent")
class AgentConfig {

    Config loadConfig(String path, Theta θ) {
        Path configPath = resolveConfigPath(path);                                               // src: vulnhunter-agent/agent/config.py:418
        Map raw = (configPath != null) ? Toml.load(configPath) : new Map();

        String authMode = resolve(raw, "anthropic", "auth_mode", θ["anthropic.auth_mode"]).lower(); // src: vulnhunter-agent/agent/config.py:433
        if (!List.of("api_key", "bedrock_oauth", "bedrock_sigv4").contains(authMode)) throw new ValueError("bad auth_mode"); // src: vulnhunter-agent/agent/config.py:437
        String apiKey = resolve(raw, "anthropic", "api_key", θ["anthropic.api_key"]);            // src: vulnhunter-agent/agent/config.py:445
        if (apiKey == "") apiKey = env("ANTHROPIC_API_KEY");                                     // src: vulnhunter-agent/agent/config.py:446
        String model = resolveRequired(raw, "anthropic", "model", θ["anthropic.model"]);          // src: vulnhunter-agent/agent/config.py:448
        String baseUrl = resolve(raw, "anthropic", "bedrock_base_url", θ["anthropic.bedrock_base_url"]); // src: vulnhunter-agent/agent/config.py:452
        String region = resolve(raw, "anthropic", "aws_region", θ["anthropic.aws_region"]);       // src: vulnhunter-agent/agent/config.py:455
        if (authMode == "bedrock_oauth" && baseUrl == "") throw new ValueError("bedrock_oauth requires bedrock_base_url"); // src: vulnhunter-agent/agent/config.py:463
        if (authMode == "bedrock_sigv4" && region == "") throw new ValueError("bedrock_sigv4 requires aws_region"); // src: vulnhunter-agent/agent/config.py:469

        OAuthConfig oauth = resolveSection(raw, "oauth", θ["oauth.*"]);                          // src: vulnhunter-agent/agent/config.py:472
        if (authMode == "bedrock_oauth" && (oauth.tokenEndpoint == "" || oauth.clientId == "" || oauth.clientSecret == "")) throw new ValueError("bedrock_oauth requires oauth block"); // src: vulnhunter-agent/agent/config.py:494

        TLSConfig tls = new TLSConfig(resolve(raw, "tls", "ssl_cert_path", θ["tls.ssl_cert_path"])); // src: vulnhunter-agent/agent/config.py:498
        SandboxConfig sandbox = new SandboxConfig(
            resolve(raw, "sandbox", "enabled", θ["sandbox.enabled"]),                            // src: vulnhunter-agent/agent/config.py:506
            resolve(raw, "sandbox", "fail_if_unavailable", θ["sandbox.fail_if_unavailable"]),    // src: vulnhunter-agent/agent/config.py:510
            resolve(raw, "sandbox", "allow_unsandboxed_commands", θ["sandbox.allow_unsandboxed_commands"])); // src: vulnhunter-agent/agent/config.py:517
        TelemetryConfig telemetry = new TelemetryConfig(resolve(raw, "telemetry", "enabled", θ["telemetry.enabled"])); // src: vulnhunter-agent/agent/config.py:526

        ScanConfig scan = new ScanConfig(
            resolve(raw, "scan", "clone_base_dir", θ["scan.clone_base_dir"]),                    // src: vulnhunter-agent/agent/config.py:548
            resolve(raw, "scan", "clone_timeout_seconds", θ["scan.clone_timeout_seconds"]),      // src: vulnhunter-agent/agent/config.py:551
            resolve(raw, "scan", "allowed_tools", θ["scan.allowed_tools"]),                      // src: vulnhunter-agent/agent/config.py:557
            resolve(raw, "scan", "permission_mode", θ["scan.permission_mode"]),                  // src: vulnhunter-agent/agent/config.py:576
            resolve(raw, "scan", "autocompact_pct_override", θ["scan.autocompact_pct_override"]), // src: vulnhunter-agent/agent/config.py:583
            resolve(raw, "scan", "async_agent_stall_timeout_ms", θ["scan.async_agent_stall_timeout_ms"]), // src: vulnhunter-agent/agent/config.py:593
            resolve(raw, "scan", "no_proxy", θ["scan.no_proxy"]));                               // src: vulnhunter-agent/agent/config.py:602

        GitHubConfig github = resolveSection(raw, "github", θ["github.*"]);                      // src: vulnhunter-agent/agent/config.py:609
        PublishConfig publish = resolveSection(raw, "publish", θ["publish.*"]);                  // src: vulnhunter-agent/agent/config.py:619
        publish.enabled = resolve(raw, "publish", "enabled", θ["publish.enabled"]);
        AuditConfig audit = resolveSection(raw, "audit", null);
        audit.enabled = resolve(raw, "audit", "enabled", θ["audit.enabled"]);
        LoggingConfig logging = resolveSection(raw, "logging", null);
        logging.perTurnUsage = resolve(raw, "logging", "per_turn_usage", θ["logging.per_turn_usage"]);
        // aws_profile (default empty) is stripped like the other bedrock strings; telemetry also reads otel_exporter_otlp_endpoint and resource_attributes (default empty)
        // github: host default github.com; scan_token, reports_token, broker_token_dir default empty
        // publish: branch default main; commit author name and email defaults are fixed strings;
        if (publish.enabled && publish.destinationRepo == "") throw new ValueError("publish.enabled=true but publish.destination_repo is empty"); // src: vulnhunter-agent/agent/config.py:709
        // issues: every field is a resolve() with the default of the issues.* knob of the same name (enabled, target_repo, labels, dedup_label,
        // haiku_model, sonnet_model, semantic_dedup, request_timeout_seconds, max_open_issues, token_budget_fraction, model_context_tokens, notify_clean_scan, clean_scan_label)
        IssuesConfig issues = resolveSection(raw, "issues", null);                               // src: vulnhunter-agent/agent/config.py:713
        // logging.retries default false (only per_turn_usage is a registry knob)
        // verify: repo_aliases and allowed_clone_hosts and token_path_prefixes come straight from TOML, never from env:
        Map aliasesRaw = raw.get("verify").getOr("repo_aliases", Map.of());
        if (!(aliasesRaw instanceof Map)) aliasesRaw = Map.of();                                 // src: vulnhunter-agent/agent/config.py:827
        Map repoAliases = aliasesRaw.filter(kv -> kv.value instanceof String && !kv.value.strip().isEmpty()).stringify();   // src: vulnhunter-agent/agent/config.py:837
        // allowed_clone_hosts and token_path_prefixes: only a list value is used (anything else becomes empty); entries are stripped and blanks dropped // src: vulnhunter-agent/agent/config.py:841
        // verify numeric caps default to 20 comment pages, 5000000 timeline bytes, 20 event pages, 200000 edit-diff bytes, 5000000 edit-total bytes; scratch_base_dir ./verify_runs; clone_timeout_seconds 300 // src: vulnhunter-agent/agent/config.py:861
        // audit: events_path and findings_path default under ~/.vulnhunter, app_id NA, actor vulnhunter-agent, stdout false, strict false (only audit.enabled is a registry knob)
        Map propMapRaw = raw.get("repo_properties").getOr("github_property_map", Map.of());
        if (!(propMapRaw instanceof Map)) propMapRaw = Map.of();                                 // src: vulnhunter-agent/agent/config.py:892
        RepoPropertiesConfig repoProps = new RepoPropertiesConfig(propMapRaw.filter(kv -> kv.value instanceof String && !kv.value.strip().isEmpty()).stringify()); // src: vulnhunter-agent/agent/config.py:894
        // source_path = the resolved config path (null when only env vars supplied the values)
        return new Config(model, authMode, oauth, tls, sandbox, telemetry, scan, github, publish, audit, logging);
    }

    // --config, then $VULNHUNT_AGENT_CONFIG, then agent/config.toml; a missing explicit path is fatal.
    Path resolveConfigPath(String explicit) {
        if (explicit != null) { if (!Path.of(explicit).isFile()) throw new FileNotFoundError(explicit); return Path.of(explicit); } // src: vulnhunter-agent/agent/config.py:338
        String e = env("VULNHUNT_AGENT_CONFIG");                                                 // src: vulnhunter-agent/agent/config.py:344
        if (e != null) { if (!Path.of(e).isFile()) throw new FileNotFoundError(e); return Path.of(e); }
        Path candidate = moduleDir().resolve("config.toml");                                     // src: vulnhunter-agent/agent/config.py:351
        return candidate.isFile() ? candidate : null;
    }

    // env var name for a section and key: VULNHUNT_<SECTION>_<KEY> upper-cased
    String envName(String section, String key) {
        return "VULNHUNT_" + section.upper() + "_" + key.upper();                                // src: vulnhunter-agent/agent/config.py:358
    }

    // _resolve(raw_section, section, key, kind, default, required): env var > TOML key > default.
    // raw is already the section table; kind (str by default) only drives env-var coercion.
    // Calls above pass the default as the last argument; kind and required are implied by the default's type and by resolveRequired.
    Object resolve(Map raw, String section, String key, Object dflt) {
        String envVal = env(envName(section, key));                                              // src: vulnhunter-agent/agent/config.py:391
        Object value;
        if (envVal != null) value = coerce(envVal, typeOf(dflt));                                // src: vulnhunter-agent/agent/config.py:393
        else if (raw.containsKey(key)) value = raw.get(key);                                     // src: vulnhunter-agent/agent/config.py:394
        else return dflt;                                                                        // src: vulnhunter-agent/agent/config.py:402
        return value;
    }

    // required=True variant: a missing key with no default raises; an env or TOML string that is blank also raises (a TOML entry of "" would otherwise satisfy key in raw)
    // dflt is the knob value: in the source the default is None, so an absent key raises
    Object resolveRequired(Map raw, String section, String key, Object dflt) {
        String envVal = env(envName(section, key));
        Object value;
        if (envVal != null) value = coerce(envVal, String);
        else if (raw.containsKey(key)) value = raw.get(key);
        else if (dflt == null) throw new ValueError("Missing required value " + section + "." + key + ". Set in config.toml or via " + envName(section, key)); // src: vulnhunter-agent/agent/config.py:398
        else return dflt;
        if (value instanceof String && value.strip().isEmpty()) throw new ValueError("Required value " + section + "." + key + " must not be empty"); // src: vulnhunter-agent/agent/config.py:405
        return value;
    }

    Object coerce(String value, Type kind) {
        if (kind == Boolean) return List.of("1", "true", "yes", "on").contains(value.lower());   // src: vulnhunter-agent/agent/config.py:364
        if (kind == Integer) return int(value);                                                  // src: vulnhunter-agent/agent/config.py:366
        if (kind == Float) return float(value);                                                  // src: vulnhunter-agent/agent/config.py:368
        if (kind == List) return value.split(",").map(strip).filter(nonEmpty);                   // src: vulnhunter-agent/agent/config.py:370
        return value;
    }
}
