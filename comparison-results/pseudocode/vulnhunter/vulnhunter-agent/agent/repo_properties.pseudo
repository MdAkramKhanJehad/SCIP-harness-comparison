// file: vulnhunter-agent/agent/repo_properties.py
// Optional per-repo metadata tags for findings records. Precedence: CLI override > GitHub custom
// properties (via [repo_properties].github_property_map) > blank. Every GitHub failure degrades to blank.

@executedBy(CODE) @role(io) @stage("agent")
class RepoProperties {
    Map<String, String> values = new Map();                                                       // src: vulnhunter-agent/agent/repo_properties.py:52

    boolean isEmpty() {
        return !values.values().any(v -> v != "");                                                // src: vulnhunter-agent/agent/repo_properties.py:55
    }

    String get(String name) {
        return values.getOrDefault(name, "");                                                     // src: vulnhunter-agent/agent/repo_properties.py:58
    }

    // resolve: per-field overlay; non-blank CLI value wins, blank CLI value only fills absent keys.
    RepoProperties resolve(RepoProperties cliOverrides, RepoProperties github) {
        Map<String, String> fetched = (github != null) ? github.values : new Map();               // src: vulnhunter-agent/agent/repo_properties.py:73
        Map<String, String> merged = new Map(fetched);                                            // src: vulnhunter-agent/agent/repo_properties.py:74
        for (Entry e : cliOverrides.values.entries()) {                                           // src: vulnhunter-agent/agent/repo_properties.py:75
            if (e.value != "") merged.put(e.key, e.value);                                        // src: vulnhunter-agent/agent/repo_properties.py:77
            else merged.putIfAbsent(e.key, e.value);                                              // src: vulnhunter-agent/agent/repo_properties.py:79
        }
        return new RepoProperties(merged);                                                        // src: vulnhunter-agent/agent/repo_properties.py:80
    }

    // fetch_from_github: best-effort GET /repos/<owner>/<repo>/properties/values with the scan token.
    RepoProperties fetchFromGithub(String repoUrl) {
        Map<String, String> propertyMap = config.repoProperties.githubPropertyMap;               // src: vulnhunter-agent/agent/repo_properties.py:102
        if (propertyMap.isEmpty()) return new RepoProperties();                                   // src: vulnhunter-agent/agent/repo_properties.py:103
        String owner; String name;
        try {
            (owner, name) = Github.parseOwnerRepo(repoUrl);                                       // src: vulnhunter-agent/agent/repo_properties.py:108
        } catch (Exception exc) {
            return new RepoProperties();                                                          // src: vulnhunter-agent/agent/repo_properties.py:116
        }
        String token = TokenClient.getGithubToken("scan", θ["github.*"]);                         // src: vulnhunter-agent/agent/repo_properties.py:118
        if (token == "") return new RepoProperties();                                             // src: vulnhunter-agent/agent/repo_properties.py:119
        String url = Github.apiBase(θ["github.*"].host) + "/repos/" + owner + "/" + name + "/properties/values"; // src: vulnhunter-agent/agent/repo_properties.py:129
        Response resp;
        try {
            HttpClient client = new HttpClient(Auth.resolveVerify(config.tls),
                    θ["code.agent.repo_properties.fetch_timeout_seconds"],                        // src: vulnhunter-agent/agent/repo_properties.py:87
                    new BrokerTokenAuth("scan", θ["github.*"]));                                  // src: vulnhunter-agent/agent/repo_properties.py:141
            resp = client.get(url);                                                               // src: vulnhunter-agent/agent/repo_properties.py:143
        } catch (HTTPError exc) {
            return new RepoProperties();                                                          // src: vulnhunter-agent/agent/repo_properties.py:151
        }
        if (resp.statusCode == 404) return new RepoProperties();                                  // src: vulnhunter-agent/agent/repo_properties.py:153
        if (resp.statusCode == 401 || resp.statusCode == 403) return new RepoProperties();        // src: vulnhunter-agent/agent/repo_properties.py:162
        if (resp.statusCode >= 400) return new RepoProperties();                                  // src: vulnhunter-agent/agent/repo_properties.py:171
        Object payload;
        try {
            payload = resp.json();                                                                // src: vulnhunter-agent/agent/repo_properties.py:182
        } catch (ValueError exc) {
            return new RepoProperties();                                                          // src: vulnhunter-agent/agent/repo_properties.py:190
        }
        return coerceFromPayload(payload, propertyMap);                                           // src: vulnhunter-agent/agent/repo_properties.py:192
    }

    // _coerce_from_payload: keep only properties named in the map, renamed to the emitted field.
    RepoProperties coerceFromPayload(Object payload, Map<String, String> propertyMap) {
        if (!(payload instanceof List)) return new RepoProperties();                              // src: vulnhunter-agent/agent/repo_properties.py:203
        Map<String, String> values = new Map();
        for (Object entry : payload) {                                                            // src: vulnhunter-agent/agent/repo_properties.py:210
            if (!(entry instanceof Map)) continue;                                                // src: vulnhunter-agent/agent/repo_properties.py:211
            Object prop = entry.get("property_name");                                             // src: vulnhunter-agent/agent/repo_properties.py:213
            if (!(prop instanceof String)) continue;                                              // src: vulnhunter-agent/agent/repo_properties.py:214
            String fieldName = propertyMap.get(prop);                                             // src: vulnhunter-agent/agent/repo_properties.py:216
            if (fieldName == null) continue;                                                      // src: vulnhunter-agent/agent/repo_properties.py:217
            values.put(fieldName, stringify(entry.get("value")));                                 // src: vulnhunter-agent/agent/repo_properties.py:219
        }
        return new RepoProperties(values);
    }

    // _stringify: None -> blank; multi_select list -> comma-joined; else stripped string.
    String stringify(Object value) {
        if (value == null) return "";                                                             // src: vulnhunter-agent/agent/repo_properties.py:231
        if (value instanceof List) return String.join(",", value.filter(v -> v != null).map(v -> str(v).strip())); // src: vulnhunter-agent/agent/repo_properties.py:234
        return str(value).strip();                                                                // src: vulnhunter-agent/agent/repo_properties.py:235
    }
}
