// file: harness/local_harness/benchmark/finding_history.py
// Per-finding detection history across benchmark runs (finding_history.json); identifies "stable"
// findings detected in each of the last N runs so --skip-stable can skip them.

@executedBy(CODE) @role(evaluation)
class FindingHistory {

    Map loadHistory() {
        if (!Fs.isfile(LocalHarnessConfig.HISTORY_FILE())) return Map.of();                   // src: harness/local_harness/benchmark/finding_history.py:15
        Map h = Json.tryParse(Fs.read(LocalHarnessConfig.HISTORY_FILE()));
        return h == null ? Map.of() : h;  // corrupt -> start fresh                            // src: harness/local_harness/benchmark/finding_history.py:20
    }

    void saveHistory(Map h) {
        LocalHarnessConfig.atomicWriteJson(LocalHarnessConfig.HISTORY_FILE(), h);             // src: harness/local_harness/benchmark/finding_history.py:26
    }

    Pair updateHistory(State state, Map targets) {
        long ts = Clock.epochSeconds();
        Map h = loadHistory();
        Set<String> inScope = targets.values().flatMap(t -> t.findings).map(f -> f.findingId).toSet(); // src: harness/local_harness/benchmark/finding_history.py:38
        int recorded = 0, skipped = 0;
        for (String fid : inScope.sorted()) {
            Judgment j = state.judgments.get(fid);
            if (j == null || j.detected == null) { skipped++; continue; }                       // src: harness/local_harness/benchmark/finding_history.py:47
            h.putIfAbsent(fid, new Record(List.of(), List.of()));
            if (j.detected) h.get(fid).detected.add(ts); else h.get(fid).missed.add(ts);       // src: harness/local_harness/benchmark/finding_history.py:54
            recorded++;
        }
        saveHistory(h);
        return new Pair(recorded, skipped);
    }

    Set<String> getStableFindings(Theta θ) {
        int threshold = θ["harness.stable_threshold"];                                         // src: harness/local_harness/benchmark/finding_history.py:64
        Set<String> stable = new Set();
        for (Entry e : loadHistory()) {
            List<Pair> entries = e.detected.map(t -> new Pair(t, true)).plus(e.missed.map(t -> new Pair(t, false))).sortBy("ts", "detected"); // src: harness/local_harness/benchmark/finding_history.py:76
            if (entries.size() < threshold) continue;                                          // src: harness/local_harness/benchmark/finding_history.py:78
            if (entries.last(threshold).all(p -> p.b == true)) stable.add(e.findingId);         // src: harness/local_harness/benchmark/finding_history.py:82
        }
        return stable;
    }
}
