// file: vvaharness/orchestrator/findings_json.py
// The typed scan result (findings.json) written beside the Markdown report, redacted and atomically replaced,
// and read back strictly (absent -> null; present but invalid -> error, never a Markdown fallback).

@executedBy(CODE) @role(io) @stage("S8")
class FindingsJson {

    Path findingsJsonPath(Path repo) {
        return repo.resolve(Artifacts.SCAN_DIR_NAME).resolve(Artifacts.FINDINGS_JSON_NAME);            // src: vvaharness/orchestrator/findings_json.py:43
    }

    /** write_findings_json: redact the whole tree, write to .tmp, then rename over the target. */
    Path write(FinalReport report, Path repo) {
        Path outDir = Artifacts.artifactDir(repo, Artifacts.SCAN_DIR_NAME);                            // symlink/outside-target guard // src: vvaharness/orchestrator/findings_json.py:48
        Path path = outDir.resolve(Artifacts.FINDINGS_JSON_NAME);                                      // src: vvaharness/orchestrator/findings_json.py:49
        outDir.mkdirs();                                                                               // src: vvaharness/orchestrator/findings_json.py:50
        String payload = Json.dump(Redact.redactTree(report.modelDump()), 2) + "\n";                   // src: vvaharness/orchestrator/findings_json.py:51
        Path tmp = path.withSuffix(".json.tmp");                                                       // src: vvaharness/orchestrator/findings_json.py:52
        tmp.writeText(payload);                                                                        // src: vvaharness/orchestrator/findings_json.py:53
        tmp.replace(path);                                                                             // atomic for a concurrent reader // src: vvaharness/orchestrator/findings_json.py:54
        return path;                                                                                   // src: vvaharness/orchestrator/findings_json.py:55
    }

    FinalReport readFindingsJson(Path repo) {
        Path path = findingsJsonPath(repo);                                                            // src: vvaharness/orchestrator/findings_json.py:61
        if (!path.isFile()) return null;                                                               // older build // src: vvaharness/orchestrator/findings_json.py:62
        return validated(path);                                                                        // src: vvaharness/orchestrator/findings_json.py:64
    }

    FinalReport validated(Path path) {
        try { return FinalReport.modelValidateJson(path.readText()); }                                // src: vvaharness/orchestrator/findings_json.py:69
        catch (ValidationError e) { throw new InvalidFindingsJSON(path + " is not a readable scan result"); } // src: vvaharness/orchestrator/findings_json.py:70
    }
}

@executedBy(CODE) @role(types)
class InvalidFindingsJSON {
    // ValueError: findings.json exists but does not validate as a FinalReport                      // src: vvaharness/orchestrator/findings_json.py:36
}
