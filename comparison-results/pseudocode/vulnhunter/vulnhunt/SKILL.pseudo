// file: vulnhunt/SKILL.md
// /vulnhunt orchestrator skill, the L0 of the scan logic: binds scan metadata, then dispatches one subagent per phase
// (recon, hunt fan-out, verify, reproduce+test+fix, sweep) and compiles the report. It does no analysis itself.
// Operating Principles and Investigation Discipline (VulnhuntInvestigationDiscipline) stay in effect in every phase.

@executedBy(MODEL) @role(skill) @stage("orchestrator")
class VulnhuntSkill {

    // Entry: the orchestrator model's procedure (Workflow 1-3). Started by Runner via the kickoff prompt.
    @executedBy(MODEL)
    Report run(Prompt kickoff, Theta θ) {
        Prompt p = prompt(θ);
        ScanMeta m = mandatoryFirstActions(kickoff, θ);                                          // src: vulnhunt/SKILL.md:225
        if (m == null && θ["p.skill_vulnhunt.first_actions_must_pass"]) return null;             // src: vulnhunt/SKILL.md:226
        String phasesDir = PhasesIndex.phasesDir(θ);                                             // src: vulnhunt/SKILL.md:324

        // 2. Hunt -> Report: steps A-E exactly once, no outer loop.
        int passes = (θ["p.skill_vulnhunt.single_pass_a_to_e"] == "once") ? 1 : 1;              // src: vulnhunt/SKILL.md:228
        List<String> topology = θ["prompt.phase_topology"];                                      // src: vulnhunt/SKILL.md:228
        PartitionTables tables = phaseA_Recon(m, phasesDir, θ);                                  // src: vulnhunt/SKILL.md:231
        reportCost(θ);
        phaseB_Hunt(m, phasesDir, tables, θ);                                                    // src: vulnhunt/SKILL.md:240
        reportCost(θ);
        int confirmed = phaseC_Verify(m, phasesDir, θ);                                          // src: vulnhunt/SKILL.md:249
        reportCost(θ);
        if (confirmed == 0 && θ["p.skill_vulnhunt.early_end_still_reports"]) return writeReport(m, phasesDir, θ); // src: vulnhunt/SKILL.md:351
        phaseD_ReproduceTestFix(m, phasesDir, θ);                                                // src: vulnhunt/SKILL.md:256
        reportCost(θ);
        phaseE_Sweep(m, phasesDir, θ);                                                           // src: vulnhunt/SKILL.md:269
        reportCost(θ);
        return writeReport(m, phasesDir, θ);                                                     // src: vulnhunt/SKILL.md:278
    }

    // ---------------- prompt sections, in file order ----------------

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(frontmatter(θ));
        p.include(mandatoryFirstActionsText(θ));
        p.include(persona(θ));
        p.include(operatingPrinciples(θ));
        p.include(analysisApproach(θ));
        p.include(VulnhuntInvestigationDiscipline.prompt(θ));
        p.include(workflowText(θ));
        p.include(reportContents(θ));
        p.include(stoppingRules(θ));
        p.include(phaseLoading(θ));
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt frontmatter(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.skill_vulnhunt.skill_triggers"]);                                         // src: vulnhunt/SKILL.md:9
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt mandatoryFirstActionsText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_vulnhunt.model_check_interactive_only"]) p.step(0, "Model check (interactive/direct invocation only)"); // src: vulnhunt/SKILL.md:18
        p.threshold(θ["p.skill_vulnhunt.min_model"]);                                            // src: vulnhunt/SKILL.md:20
        p.threshold(θ["skill.min_model"]);                                                       // src: vulnhunt/SKILL.md:18
        if (θ["p.skill_vulnhunt.model_check_stop_before_tools"]) p.must("STOP immediately and tell the user; do not run any tools, resolve the target, or offer the mode menu"); // src: vulnhunt/SKILL.md:21
        if (θ["p.skill_vulnhunt.model_check_user_override"]) p.exemption("proceed if the user explicitly wants to continue on the current model"); // src: vulnhunt/SKILL.md:27
        if (θ["p.skill_vulnhunt.model_check_skipped_agent_driven"]) p.exemption("skip this check under path A (agent-driven)"); // src: vulnhunt/SKILL.md:30
        p.must(θ["p.skill_vulnhunt.scan_metadata_bindings"]);                                    // src: vulnhunt/SKILL.md:32
        if (θ["p.skill_vulnhunt.artifact_paths_under_results_dir"]) p.must("Use VULNHUNT_DIR for all artifact paths"); // src: vulnhunt/SKILL.md:34
        if (θ["p.skill_vulnhunt.metadata_block_literal_values"]) p.rule("A: use the metadata block literal values; do not recompute"); // src: vulnhunt/SKILL.md:38
        p.rule(θ["p.skill_vulnhunt.bash_line_selects_mode"]);                                    // src: vulnhunt/SKILL.md:39
        p.rule(θ["p.skill_vulnhunt.default_target_cwd"]);                                        // src: vulnhunt/SKILL.md:43
        p.rule(θ["p.skill_vulnhunt.mode_from_invocation"]);                                      // src: vulnhunt/SKILL.md:44
        p.choose(θ["p.skill_vulnhunt.mode_menu"]);                                               // src: vulnhunt/SKILL.md:45
        if (θ["p.skill_vulnhunt.no_phase1_until_mode_resolved"]) p.forbid("Don't start Phase 1 until mode is resolved"); // src: vulnhunt/SKILL.md:47
        p.format(θ["p.skill_vulnhunt.results_dir_name_pattern"]);                                // src: vulnhunt/SKILL.md:48
        if (θ["p.skill_vulnhunt.never_reuse_results_dir"]) p.forbid("never reuse an existing results dir"); // src: vulnhunt/SKILL.md:49
        if (θ["p.skill_vulnhunt.no_bash_metadata_fallback"]) p.rule("No Bash: ask the user to enable it or supply a pre-made dir path + branch/URL"); // src: vulnhunt/SKILL.md:50
        p.step(2, θ["prompt.dependency_install"]);                                               // src: vulnhunt/SKILL.md:52
        if (θ["p.skill_vulnhunt.read_only_skips_deps_and_test_execution"]) p.rule("Read-only: skip to Phase 1; exploit tests written but not run; static PoCs only"); // src: vulnhunt/SKILL.md:54
        p.checklist(θ["p.skill_vulnhunt.dependency_install"]);                                   // src: vulnhunt/SKILL.md:56
        if (θ["p.skill_vulnhunt.dependency_failure_stop"]) p.must("If install fails or the sandbox blocks it, give the user the exact command and STOP"); // src: vulnhunt/SKILL.md:63
        p.exemption(θ["p.skill_vulnhunt.dependency_skip_override"]);                             // src: vulnhunt/SKILL.md:64
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt persona(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["prompt.persona"]);                                                          // src: vulnhunt/SKILL.md:68
        if (θ["p.skill_vulnhunt.persona_method_statement"]) p.persona("combine systematic static analysis (Grep, Glob, Read) with expert security reasoning to find real, exploitable vulnerabilities"); // src: vulnhunt/SKILL.md:69
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt operatingPrinciples(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.gate_principle"]);                                                      // src: vulnhunt/SKILL.md:74
        p.checklist(θ["p.skill_vulnhunt.gate_pass_triad"]);                                      // src: vulnhunt/SKILL.md:74
        if (θ["p.skill_vulnhunt.no_low_impact_second_guessing"]) p.forbid("Do not second-guess the gates with vague low-impact reasoning"); // src: vulnhunt/SKILL.md:75
        if (θ["p.skill_vulnhunt.data_flow_required"]) p.evidence("concrete data flow from an attacker-controlled source to a dangerous sink"); // src: vulnhunt/SKILL.md:77
        p.evidence(θ["p.skill_vulnhunt.poc_required"]);                                          // src: vulnhunt/SKILL.md:79
        p.rule("cannot demonstrate exploitability -> downgrade to " + θ["p.skill_vulnhunt.undemonstrated_downgrade_to_potential"]); // src: vulnhunt/SKILL.md:80
        if (θ["p.skill_vulnhunt.fix_eliminates_class"]) p.must("Proposed fixes must eliminate the vulnerability class, not just block the PoC payload"); // src: vulnhunt/SKILL.md:82
        p.include(scopeExclusions(θ));                                                           // src: vulnhunt/SKILL.md:84
        return p;
    }

    // Principle 5: production code only.
    @executedBy(MODEL) @role(prompt)
    Prompt scopeExclusions(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["prompt.scope.exclusions"]);                                               // src: vulnhunt/SKILL.md:84
        p.forbid(θ["p.skill_vulnhunt.excluded_code_three_prohibitions"]);                        // src: vulnhunt/SKILL.md:85
        p.forbid(θ["p.skill_vulnhunt.exclude_test_code_globs"]);                                 // src: vulnhunt/SKILL.md:87
        p.forbid(θ["p.skill_vulnhunt.exclude_build_config_globs"]);                              // src: vulnhunt/SKILL.md:89
        if (θ["prompt.scope.infra_config_exception"]) p.exemption(θ["p.skill_vulnhunt.infra_config_exception_directives"]); // src: vulnhunt/SKILL.md:91
        if (θ["p.skill_vulnhunt.trusted_var_promotion_is_vuln"]) p.rule("a directive promoting a normally-trusted variable to attacker-controllable is a vulnerability"); // src: vulnhunt/SKILL.md:96
        p.forbid(θ["p.skill_vulnhunt.exclude_vendored_globs"]);                                  // src: vulnhunt/SKILL.md:100
        p.forbid(θ["p.skill_vulnhunt.exclude_generated_globs"]);                                 // src: vulnhunt/SKILL.md:102
        p.forbid(θ["p.skill_vulnhunt.exclude_documentation_globs"]);                             // src: vulnhunt/SKILL.md:104
        if (θ["p.skill_vulnhunt.vendored_boundary_rule"]) p.rule("flow through vendored code: note the boundary, focus the finding on the first-party caller"); // src: vulnhunt/SKILL.md:106
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt analysisApproach(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_vulnhunt.primary_tools"]);                                             // src: vulnhunt/SKILL.md:111
        if (θ["p.skill_vulnhunt.explore_agent_for_broad_search"]) p.rule("Agent (Explore) for broader exploration when simple searches are not enough"); // src: vulnhunt/SKILL.md:117
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt workflowText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_vulnhunt.first_actions_must_pass"]) p.must("Do not proceed until prior-results check and dependency install pass"); // src: vulnhunt/SKILL.md:225
        p.rule("Execute steps A-E " + θ["p.skill_vulnhunt.single_pass_a_to_e"]);                 // src: vulnhunt/SKILL.md:228
        p.context(θ["prompt.phase_topology"]);                                                   // src: vulnhunt/SKILL.md:228
        if (θ["prompt.cost_report"]) p.must("After each phase completes, run /cost and report the result to the user"); // src: vulnhunt/SKILL.md:229
        p.format(θ["prompt.subagent_return_words"]);                                             // src: vulnhunt/SKILL.md:235
        p.context(θ["prompt.partition_data_file"]);                                              // src: vulnhunt/SKILL.md:241
        p.threshold(θ["p.skill_vulnhunt.min_agent_count_all_partitions"]);                       // src: vulnhunt/SKILL.md:245
        p.format(θ["p.skill_vulnhunt.phase3_output_exact_filename"]);                            // src: vulnhunt/SKILL.md:264
        p.format(θ["p.skill_vulnhunt.sweep_output_contents_and_name"]);                          // src: vulnhunt/SKILL.md:272
        p.rule(θ["prompt.enforcement_style"]);                                                   // src: vulnhunt/SKILL.md:289
        if (θ["prompt.one_vuln_per_sink"]) p.must("one VULN-NNN per sink location; one summary row per exploit-test PASS"); // src: vulnhunt/SKILL.md:289
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt reportContents(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.skill_vulnhunt.report_contents"]);                                      // src: vulnhunt/SKILL.md:301
        p.format(θ["p.skill_vulnhunt.one_vuln_per_sink_location"]);                              // src: vulnhunt/SKILL.md:302
        if (θ["p.skill_vulnhunt.fixes_are_descriptions_only"]) p.format("Proposed fix strategies (descriptions, not applied edits)"); // src: vulnhunt/SKILL.md:304
        if (θ["p.skill_vulnhunt.code_smells_separate_section"]) p.format("Code smells in a separate section"); // src: vulnhunt/SKILL.md:306
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt stoppingRules(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.stopping_rules"]);                                                      // src: vulnhunt/SKILL.md:308
        if (θ["p.skill_vulnhunt.zero_findings_valid"]) p.rule("Zero confirmed findings is a valid outcome: report no exploitable vulnerabilities, list code smells, stop"); // src: vulnhunt/SKILL.md:310
        if (θ["p.skill_vulnhunt.no_softening_criteria"]) p.forbid("Do not soften criteria to maintain output"); // src: vulnhunt/SKILL.md:314
        p.rule(θ["p.skill_vulnhunt.code_smell_definition"]);                                     // src: vulnhunt/SKILL.md:315
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt phaseLoading(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.skill_vulnhunt.phases_dir"]);                                             // src: vulnhunt/SKILL.md:324
        if (θ["p.skill_vulnhunt.orchestrator_role"]) p.persona("Your role is ORCHESTRATOR: you dispatch subagents and verify output files. You do NOT perform analysis yourself."); // src: vulnhunt/SKILL.md:326
        if (θ["p.skill_vulnhunt.missing_phase_file_fatal"]) p.must("If a Read of any phase file returns file not found, STOP the entire workflow and tell the user"); // src: vulnhunt/SKILL.md:329
        if (θ["p.skill_vulnhunt.no_improvised_methodology"]) p.forbid("Do NOT improvise or ad-lib the methodology. A missing phase file is fatal."); // src: vulnhunt/SKILL.md:332
        p.rule(θ["prompt.orchestrator_context_rule"]);                                           // src: vulnhunt/SKILL.md:334
        if (θ["p.skill_vulnhunt.orchestrator_no_results_or_source"]) p.forbid("Do NOT read result files, recon output analysis, or source code into your context"); // src: vulnhunt/SKILL.md:335
        p.rule("Verify subagent completion by checking output files exist with " + θ["p.skill_vulnhunt.completion_via_glob"]); // src: vulnhunt/SKILL.md:336
        if (θ["p.skill_vulnhunt.relaunch_failed_subagent"]) p.rule("If a subagent fails, re-launch it; do NOT diagnose the failure yourself"); // src: vulnhunt/SKILL.md:337
        p.threshold(θ["prompt.subagent_return_words"]);                                          // src: vulnhunt/SKILL.md:338
        p.context(θ["p.skill_vulnhunt.orchestrator_reads_only_hunt_file"]);                      // src: vulnhunt/SKILL.md:340
        p.context(PhasesIndex.phaseFiles(θ));                                                    // src: vulnhunt/SKILL.md:341
        return p;
    }

    // ---------------- procedures the orchestrator carries out ----------------

    // MANDATORY FIRST ACTIONS: Step 0 model check, bind metadata (path A or B), Step 2 dependencies.
    @executedBy(MODEL)
    ScanMeta mandatoryFirstActions(Prompt kickoff, Theta θ) {
        boolean agentDriven = kickoff.has("Pre-resolved scan metadata");                         // src: vulnhunt/SKILL.md:37
        if (!agentDriven && θ["p.skill_vulnhunt.model_check_interactive_only"]) {               // src: vulnhunt/SKILL.md:18
            if (!step0ModelCheck(θ)) return null;
        } else if (θ["p.skill_vulnhunt.model_check_skipped_agent_driven"]) {
            // path A: the agent controls the model; skip the check                                // src: vulnhunt/SKILL.md:30
        }
        ScanMeta m = agentDriven ? bindFromMetadataBlock(kickoff, θ) : bindDirect(θ);            // src: vulnhunt/SKILL.md:32
        if (m == null) return null;
        if (!installDependencies(m, θ)) return null;                                             // src: vulnhunt/SKILL.md:52
        return m;
    }

    @executedBy(MODEL)
    boolean step0ModelCheck(Theta θ) {
        if (selfModel() >= θ["skill.min_model"]) return true;                                     // src: vulnhunt/SKILL.md:20
        if (θ["p.skill_vulnhunt.model_check_stop_before_tools"]) tellUser("VulnHunter is optimized for Claude Opus 4.7/4.8; switch with /model opus, then re-run /vulnhunt"); // src: vulnhunt/SKILL.md:21
        String reply = waitForUser();                                                            // src: vulnhunt/SKILL.md:27
        return θ["p.skill_vulnhunt.model_check_user_override"] && reply.wantsToContinue();       // src: vulnhunt/SKILL.md:28
    }

    // Path A: literal values from the kickoff block; its Bash line drives Step 2.
    @executedBy(MODEL)
    ScanMeta bindFromMetadataBlock(Prompt kickoff, Theta θ) {
        ScanMeta m = new ScanMeta();
        for (String field : θ["p.skill_vulnhunt.scan_metadata_bindings"]) m.bind(field, kickoff.value(field)); // src: vulnhunt/SKILL.md:32
        if (θ["p.skill_vulnhunt.metadata_block_literal_values"]) m.recompute = false;            // src: vulnhunt/SKILL.md:38
        m.mode = kickoff.has("Bash is NOT available") ? "read-only" : "install";                 // src: vulnhunt/SKILL.md:39
        String rule = θ["p.skill_vulnhunt.bash_line_selects_mode"];                              // src: vulnhunt/SKILL.md:39
        return m;
    }

    // Path B: direct invocation; resolve target, mode and metadata yourself.
    @executedBy(MODEL)
    ScanMeta bindDirect(Theta θ) {
        ScanMeta m = new ScanMeta();
        m.target = invocationPath() != null ? invocationPath() : θ["p.skill_vulnhunt.default_target_cwd"]; // src: vulnhunt/SKILL.md:43
        confirmInOneLine(m.target);
        if (invocationMentions(θ["p.skill_vulnhunt.mode_from_invocation"])) {                    // src: vulnhunt/SKILL.md:44
            m.mode = modeFromInvocation();
        } else {
            m.mode = askMenu(θ["p.skill_vulnhunt.mode_menu"]);                                   // src: vulnhunt/SKILL.md:45
        }
        if (m.mode == null && θ["p.skill_vulnhunt.no_phase1_until_mode_resolved"]) return null;  // src: vulnhunt/SKILL.md:47
        if (bashAvailable()) {
            m.dir = mkdirFresh(θ["p.skill_vulnhunt.results_dir_name_pattern"]);                  // src: vulnhunt/SKILL.md:48
            if (θ["p.skill_vulnhunt.never_reuse_results_dir"] && m.dir.existedBefore) m.dir = mkdirFresh(θ["p.skill_vulnhunt.results_dir_name_pattern"]); // src: vulnhunt/SKILL.md:49
            m.branch = git("rev-parse"); m.repoUrl = git("remote get-url origin");               // src: vulnhunt/SKILL.md:50
        } else if (θ["p.skill_vulnhunt.no_bash_metadata_fallback"]) {
            m = askUserForDirBranchUrl();                                                        // src: vulnhunt/SKILL.md:50
        }
        return m;
    }

    // Step 2: dependency installation (Bash-enabled only).
    @executedBy(MODEL)
    boolean installDependencies(ScanMeta m, Theta θ) {
        if (m.mode == "read-only" && θ["p.skill_vulnhunt.read_only_skips_deps_and_test_execution"]) return true; // src: vulnhunt/SKILL.md:54
        String manager = detectPackageManager(θ["prompt.dependency_install"]);                   // src: vulnhunt/SKILL.md:56
        boolean ok = runInstall(manager, θ["p.skill_vulnhunt.dependency_install"]);              // src: vulnhunt/SKILL.md:57
        if (!ok && θ["p.skill_vulnhunt.dependency_failure_stop"]) {                              // src: vulnhunt/SKILL.md:63
            tellUser("exact install command");
            return waitForUser().equals(θ["p.skill_vulnhunt.dependency_skip_override"]);         // src: vulnhunt/SKILL.md:64
        }
        return true;
    }

    // A. Phase 1 - Recon: one general-purpose subagent; orchestrator then reads only the dispatch tables.
    @executedBy(MODEL)
    PartitionTables phaseA_Recon(ScanMeta m, String phasesDir, Theta θ) {
        String type = θ["p.skill_vulnhunt.recon_subagent_type"];                                 // src: vulnhunt/SKILL.md:231
        Prompt instr = new Prompt().context("scan directory " + m.dir).rule("Follow " + phasesDir + "/phase1_recon.md").format("write " + m.dir + "/phase1_output.md").threshold(θ["prompt.subagent_return_words"]); // src: vulnhunt/SKILL.md:232
        dispatchUntilOutput(type, instr, () -> Phase1Recon.run(m.dir, θ), m.dir + "/phase1_output.md", θ); // src: vulnhunt/SKILL.md:231
        if (θ["p.skill_vulnhunt.verify_phase1_output_exists"]) verifyExists(m.dir + "/phase1_output.md", θ); // src: vulnhunt/SKILL.md:236
        return readOnly(m.dir + "/phase1_output.md", θ["p.skill_vulnhunt.orchestrator_reads_only_tables"]); // src: vulnhunt/SKILL.md:237
    }

    // B. Phase 2 - Hunt: write partition data files, then dispatch class-group trace agents per phase2_hunt.md.
    @executedBy(MODEL)
    void phaseB_Hunt(ScanMeta m, String phasesDir, PartitionTables t, Theta θ) {
        readPhaseFile(phasesDir + "/phase2_hunt.md", θ);                                         // src: vulnhunt/SKILL.md:240
        for (Partition sg : t.partitions) {                                                      // src: vulnhunt/SKILL.md:241
            List<String> contents = θ["p.skill_vulnhunt.partition_data_file_contents"];          // src: vulnhunt/SKILL.md:241
            writeFile(m.dir + "/" + θ["p.skill_vulnhunt.partition_data_file_path"].replace("N", sg.n), extract(t, sg, θ["prompt.partition_data_file"])); // src: vulnhunt/SKILL.md:243
        }
        int minAgents = 3 * t.partitions.size() + 1;                                             // src: vulnhunt/SKILL.md:245
        String minRule = θ["p.skill_vulnhunt.min_agent_count_all_partitions"];                   // src: vulnhunt/SKILL.md:245
        Phase2Hunt.run(m.dir, t, minAgents, θ);                                                  // src: vulnhunt/SKILL.md:244
        if (θ["p.skill_vulnhunt.verify_result_files_exist"]) verifyExists(m.dir + "/results/", θ); // src: vulnhunt/SKILL.md:246
        if (θ["p.skill_vulnhunt.orchestrator_no_direct_investigation"]) {                        // src: vulnhunt/SKILL.md:247
            // Do NOT investigate candidates directly or dispatch per-hypothesis agents.
        }
    }

    // C. Phase 2b - Verify: one subagent over all result files.
    @executedBy(MODEL)
    int phaseC_Verify(ScanMeta m, String phasesDir, Theta θ) {
        String type = θ["p.skill_vulnhunt.verify_subagent_single"];                              // src: vulnhunt/SKILL.md:249
        Prompt instr = new Prompt().rule("Follow " + phasesDir + "/phase2b_verify.md").context(m.dir + "/results/").format(m.dir + "/phase2b_output.md").threshold(θ["prompt.subagent_return_words"]); // src: vulnhunt/SKILL.md:250
        dispatchUntilOutput(type, instr, () -> Phase2bVerify.run(m.dir, θ), m.dir + "/phase2b_output.md", θ); // src: vulnhunt/SKILL.md:249
        verifyExists(m.dir + "/phase2b_output.md", θ);                                           // src: vulnhunt/SKILL.md:254
        return countConfirmedFromFileName(m.dir + "/phase2b_output.md");                         // unclear: SKILL.md does not say how the orchestrator learns "zero findings after Phase 2b" without reading the file
    }

    // D. Phase 3a+3b+3c: reproduce, test and fix in ONE subagent.
    @executedBy(MODEL)
    void phaseD_ReproduceTestFix(ScanMeta m, String phasesDir, Theta θ) {
        String combined = θ["p.skill_vulnhunt.phase3abc_combined_subagent"];                     // src: vulnhunt/SKILL.md:256
        Prompt instr = new Prompt()
            .rule("Follow " + phasesDir + "/phase3_reproduce_test.md and " + phasesDir + "/phase3c_fixes.md") // src: vulnhunt/SKILL.md:257
            .context(m.dir + "/phase2b_output.md")                                               // src: vulnhunt/SKILL.md:259
            .format(θ["p.skill_vulnhunt.poc_and_exploit_test_dirs"])                             // src: vulnhunt/SKILL.md:260
            .format(θ["p.skill_vulnhunt.phase3_summary_contents"])                               // src: vulnhunt/SKILL.md:261
            .format(θ["p.skill_vulnhunt.phase3_output_exact_filename"])                          // src: vulnhunt/SKILL.md:264
            .threshold(θ["prompt.subagent_return_words"]);                                       // src: vulnhunt/SKILL.md:265
        dispatchUntilOutput("general-purpose", instr, () -> { Phase3ReproduceTest.run(m.dir, θ); Phase3cFixes.run(m.dir, θ); }, m.dir + "/phase3_output.md", θ); // src: vulnhunt/SKILL.md:256
        if (θ["p.skill_vulnhunt.verify_phase3_outputs"]) {                                       // src: vulnhunt/SKILL.md:266
            verifyExists(m.dir + "/phase3_output.md", θ); verifyExists(m.dir + "/poc/", θ); verifyExists(m.dir + "/exploit_tests/", θ);
        }
    }

    // E. Phase 3d - Sweep: its own subagent, fed from poc/.
    @executedBy(MODEL)
    void phaseE_Sweep(ScanMeta m, String phasesDir, Theta θ) {
        String type = θ["p.skill_vulnhunt.sweep_subagent"];                                      // src: vulnhunt/SKILL.md:269
        Prompt instr = new Prompt().rule("Follow " + phasesDir + "/phase3d_sweep.md")
            .context(m.dir + "/" + θ["p.skill_vulnhunt.sweep_reads_poc_dir"])                    // src: vulnhunt/SKILL.md:271
            .format(θ["p.skill_vulnhunt.sweep_output_contents_and_name"])                        // src: vulnhunt/SKILL.md:272
            .threshold(θ["prompt.subagent_return_words"]);                                       // src: vulnhunt/SKILL.md:275
        dispatchUntilOutput(type, instr, () -> Phase3dSweep.run(m.dir, θ), m.dir + "/phase3d_output.md", θ); // src: vulnhunt/SKILL.md:269
        verifyExists(m.dir + "/phase3d_output.md", θ);                                           // src: vulnhunt/SKILL.md:276
    }

    // 3. Write report: the orchestrator itself compiles it from phase output files, after count checks.
    @executedBy(MODEL)
    Report writeReport(ScanMeta m, String phasesDir, Theta θ) {
        readPhaseFile(phasesDir + "/phase4_report.md", θ);                                       // src: vulnhunt/SKILL.md:280
        if (θ["p.skill_vulnhunt.sweep_instance_count_crosscheck"]) {                             // src: vulnhunt/SKILL.md:283
            for (RootCause rc : sweepTable(m.dir)) {                                             // src: vulnhunt/SKILL.md:284
                if (rc.candidates != rc.confirmedVulns + rc.eliminatedOrSmell && θ["p.skill_vulnhunt.dropped_instances_recovered"]) validateAndAddDropped(rc); // src: vulnhunt/SKILL.md:286
            }
        }
        if (θ["p.skill_vulnhunt.one_row_per_exploit_pass"]) {                                    // src: vulnhunt/SKILL.md:290
            int passes = listExploitTestPasses(m.dir).size();                                    // src: vulnhunt/SKILL.md:290
            List<Row> rows = draftSummaryRows(m.dir);
            if (rows.size() < passes && θ["p.skill_vulnhunt.no_grouping_sink_locations"]) {      // src: vulnhunt/SKILL.md:292
                rows = splitCollapsedFindings(rows);                                             // src: vulnhunt/SKILL.md:293
                if (θ["p.skill_vulnhunt.own_poc_and_test_per_entry"]) createMissingPocAndTests(rows); // src: vulnhunt/SKILL.md:294
            }
        }
        boolean viaOrchestrator = θ["p.skill_vulnhunt.report_compiled_by_orchestrator"];         // src: vulnhunt/SKILL.md:280
        Report r = Phase4Report.run(m, θ);                                                       // src: vulnhunt/SKILL.md:281
        if (θ["p.skill_vulnhunt.readme_generated"]) writeReadme(m.dir, r);                       // src: vulnhunt/SKILL.md:296
        return r;
    }

    // Shared dispatch rule: launch the subagent, check its output file with Glob, re-launch on failure without diagnosis.
    @executedBy(MODEL)
    void dispatchUntilOutput(String subagentType, Prompt instr, Runnable phase, String outputPath, Theta θ) {
        Runtime.subagent(instr, phase);                                                          // src: vulnhunt/SKILL.md:231
        while (!glob(outputPath) && θ["p.skill_vulnhunt.relaunch_failed_subagent"]) Runtime.subagent(instr, phase); // src: vulnhunt/SKILL.md:337
    }

    @executedBy(MODEL)
    void verifyExists(String path, Theta θ) {
        if (θ["p.skill_vulnhunt.completion_via_glob"] == "Glob") glob(path);                      // src: vulnhunt/SKILL.md:336
    }

    @executedBy(MODEL)
    String readPhaseFile(String path, Theta θ) {
        String text = read(path);
        if (text == null && θ["p.skill_vulnhunt.missing_phase_file_fatal"]) stopWorkflow("Phase file not found at " + path + ". Run install.sh."); // src: vulnhunt/SKILL.md:329
        return text;
    }

    @executedBy(MODEL)
    void reportCost(Theta θ) {
        if (θ["prompt.cost_report"] && θ["p.skill_vulnhunt.cost_report_per_phase"]) tellUser(slash("/cost")); // src: vulnhunt/SKILL.md:229
    }
}

/** Investigation Discipline + CRITICAL production-source rule (SKILL.md 119-217): the per-input trace every phase follows. */
@executedBy(MODEL) @role(rule_set) @stage("orchestrator")
class VulnhuntInvestigationDiscipline {

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["prompt.investigation_discipline"]);                                       // src: vulnhunt/SKILL.md:119
        if (θ["p.skill_vulnhunt.tool_first_gated_order"]) p.rule("Each step gates the next; if a step eliminates the input, record its disposition and move on"); // src: vulnhunt/SKILL.md:121
        if (θ["p.skill_vulnhunt.read_source_before_confirming"]) p.must("Always verify analysis by reading actual source before confirming; Grep provides navigation, not judgment"); // src: vulnhunt/SKILL.md:209
        if (θ["p.skill_vulnhunt.read_production_source_variant"]) p.must("CRITICAL: always read the PRODUCTION variant of a sink file, not a mock or test double"); // src: vulnhunt/SKILL.md:212
        return p;
    }

    // Trace one inventory input forward to a disposition.
    @executedBy(MODEL)
    Disposition investigateInput(Input in, Theta θ) {
        // 1. Read the entry point; list every use of the input variable.
        List<Use> uses = θ["p.skill_vulnhunt.step1_read_entry_point"] ? readEntryPoint(in).usesOf(in.variable) : List.of(); // src: vulnhunt/SKILL.md:125
        List<Sink> sinks = new List();
        // 3. Exhaust ALL code paths: every use is traced; one safe path does not clear the input.
        for (Use u : (θ["p.skill_vulnhunt.exhaust_all_code_paths"] ? uses : uses.first())) {      // src: vulnhunt/SKILL.md:155
            sinks.addAll(traceForward(u, θ));
        }
        if (sinks.isEmpty()) return Disposition.SAFE;
        List<Candidate> cands = new List();
        for (Sink s : sinks) {
            // 5. Read source at the sink only after steps 1-4 found it.
            if (θ["p.skill_vulnhunt.read_sink_source_last"]) readSource(productionVariant(s, θ));  // src: vulnhunt/SKILL.md:197
            if (θ["p.skill_vulnhunt.early_return_guard_check"] && guardedByEarlyReturn(s)) {      // src: vulnhunt/SKILL.md:158
                if (!θ["p.skill_vulnhunt.guard_completeness_check"] || guardSufficientForSinkContext(s)) continue; // src: vulnhunt/SKILL.md:163
            }
            cands.add(new Candidate(in, s));
            // 6. Transitive caller search on the sink.
            if (θ["p.skill_vulnhunt.transitive_caller_search"]) {                                 // src: vulnhunt/SKILL.md:201
                for (Path path : callersTransitive(s.function, θ["p.skill_vulnhunt.caller_search_to_entry_points"])) { // src: vulnhunt/SKILL.md:203
                    if (θ["p.skill_vulnhunt.each_production_path_a_finding"]) cands.add(new Candidate(path, s)); // src: vulnhunt/SKILL.md:207
                }
            }
        }
        boolean allSafe = cands.isEmpty() && θ["p.skill_vulnhunt.safe_path_does_not_clear_input"]; // src: vulnhunt/SKILL.md:156
        return allSafe ? Disposition.SAFE : Disposition.CANDIDATE;
    }

    // 2. Trace forward with Grep: callee definitions, across files, until sink / sanitizer / exit; no depth limit.
    @executedBy(MODEL)
    List<Sink> traceForward(Use u, Theta θ) {
        List<Sink> out = new List();
        Worklist w = new Worklist(u);
        int depthLimit = (θ["p.skill_vulnhunt.no_trace_depth_limit"] == "unlimited") ? INFINITY : 0; // src: vulnhunt/SKILL.md:199
        while (!w.isEmpty()) {
            Node n = w.pop();
            if (θ["p.skill_vulnhunt.step2_trace_forward_grep"]) n = grepDefinitionAndRead(n);    // src: vulnhunt/SKILL.md:129
            if (n.isDispatcher() && θ["p.skill_vulnhunt.never_stop_at_abstraction_boundary"]) {   // src: vulnhunt/SKILL.md:133
                for (Node target : n.dispatchTargets()) w.push(target);                          // src: vulnhunt/SKILL.md:136
                if (θ["p.skill_vulnhunt.dispatch_target_ops_are_sinks"]) out.addAll(n.serverSideOpsInTargets()); // src: vulnhunt/SKILL.md:138
                continue;
            }
            if (n.isOutboundCall()) {
                if (θ["p.skill_vulnhunt.audit_all_outbound_params"]) out.addAll(auditOutboundParams(n, θ)); // src: vulnhunt/SKILL.md:141
                if (θ["p.skill_vulnhunt.response_taint_propagation"] && n.urlControls(θ["p.skill_vulnhunt.response_taint_trigger"])) { // src: vulnhunt/SKILL.md:167
                    // response body is attacker-controlled; keep tracing it
                    out.addAll(traceResponse(n, θ["p.skill_vulnhunt.response_taint_sink_mapping"])); // src: vulnhunt/SKILL.md:171
                    if (θ["p.skill_vulnhunt.outbound_call_not_terminal_sink"]) continue;          // src: vulnhunt/SKILL.md:174
                }
                if (θ["p.skill_vulnhunt.response_to_caller_enumeration"] && n.userSelectsResource()) out.addAll(enumerateResponseToCaller(n, θ)); // src: vulnhunt/SKILL.md:177
            }
            if (n.isStoreWrite() && θ["p.skill_vulnhunt.follow_through_stores"]) { for (Node r : readersOf(n.store)) w.push(r); continue; } // src: vulnhunt/SKILL.md:165
            if (n.isSink()) out.add(n.sink());
            else if (!n.isSanitizer() && !n.exitsCodebase()) w.pushAll(n.callees());             // src: vulnhunt/SKILL.md:131
        }
        return out;
    }

    // 2b. At every outbound call, audit ALL security-relevant arguments, not only the traced input.
    @executedBy(MODEL)
    List<Sink> auditOutboundParams(Node call, Theta θ) {
        List<Sink> out = new List();
        for (Arg a : call.args().filter(x -> x.kind in θ["p.skill_vulnhunt.security_relevant_param_set"])) { // src: vulnhunt/SKILL.md:144
            boolean fromValidated = !θ["p.skill_vulnhunt.outbound_param_from_validated_input"] || a.comesFromValidatedInput(); // src: vulnhunt/SKILL.md:146
            boolean notSubstituted = !θ["p.skill_vulnhunt.outbound_param_not_substituted"] || !a.substitutedSinceValidation(); // src: vulnhunt/SKILL.md:148
            if ((!fromValidated || !notSubstituted) && θ["p.skill_vulnhunt.validated_param_mismatch_is_candidate"]) out.add(new Sink(call, a)); // src: vulnhunt/SKILL.md:150
            if (a.isHardcodedWildcard()) out.add(new Sink(call, a, θ["p.skill_vulnhunt.hardcoded_wildcard_high_severity"])); // src: vulnhunt/SKILL.md:152
        }
        return out;
    }

    // 4c. Response-to-caller data enumeration through mappers.
    @executedBy(MODEL)
    List<Sink> enumerateResponseToCaller(Node call, Theta θ) {
        List<Sink> out = new List();
        Type rt = call.responseType();                                                           // src: vulnhunt/SKILL.md:183
        for (Node use : grepUsages(rt)) {                                                        // src: vulnhunt/SKILL.md:184
            if (use.isMapper() && θ["p.skill_vulnhunt.read_mapper_enumerate_fields"]) {          // src: vulnhunt/SKILL.md:185
                List<Field> fields = readMapper(use, θ["p.skill_vulnhunt.declarative_mappings_are_code"]); // src: vulnhunt/SKILL.md:187
                for (Field f : fields.filter(x -> x.kind in θ["p.skill_vulnhunt.sensitive_field_set"])) { // src: vulnhunt/SKILL.md:190
                    if (!f.authorizationChecked()) out.add(new Sink(call, f, θ["p.skill_vulnhunt.sensitive_field_without_authz_cwe200"])); // src: vulnhunt/SKILL.md:192
                }
            }
        }
        boolean idControlEnough = θ["p.skill_vulnhunt.resource_id_control_sufficient"];          // src: vulnhunt/SKILL.md:195
        return out;
    }

    @executedBy(MODEL)
    Path productionVariant(Sink s, Theta θ) {
        return θ["p.skill_vulnhunt.read_production_source_variant"] ? Phase1Recon.productionDirFor(s.file) : s.file; // src: vulnhunt/SKILL.md:212
    }
}
