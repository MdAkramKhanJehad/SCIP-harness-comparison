        catch (HarnessCLINotFoundError e) { throw e; } // src: vvaharness/validation/session/launcher.py:503
        catch (HarnessError e) { throw new ValidationSessionError("Harness error", e, getattr(e, "exit_code", null)); } // src: vvaharness/validation/session/launcher.py:505
        finally { ticker.cancel(); suppressCancelledError(() -> await ticker); } // src: vvaharness/validation/session/launcher.py:511
        return new Triple(result.first, result.second, messages); // src: vvaharness/validation/session/launcher.py:515
