fn stream_trace(line, out=stderr):executor=code {
  // abstracted: --verbose console trace of one stream-json event; no decisions. Assistant text (redacted, first 400 characters), tool_use name with redacted arguments (cut to 160 characters), tool_result size, and error results (redacted, 200 characters) are printed with every terminal control character (C0, DEL, C1) replaced by a space.
