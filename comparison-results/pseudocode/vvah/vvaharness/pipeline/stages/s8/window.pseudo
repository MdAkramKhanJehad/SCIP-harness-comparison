// file: vvaharness/pipeline/stages/s8/window.py
// Limits the S8 enrichment call to a deterministic rank prefix of findings (prompt-token and
// output-entry budgets) plus a one-pass same-file pull-in of MEDIUM/LOW/INFO hops.

@executedBy(CODE) @role(step) @stage("S8")
class S8Window {

    // _OUT_RESERVE = 1500, _TOKENS_PER_ENTRY = 100, _SCHEMA_TOKENS = tokens(ChainReport schema) + 250, _PULLIN_CEILING = 1.25

    List<Integer> floorOrder(List<Finding> findings) {
        return range(findings.size()).sortedBy(i -> Pair.of(SEV_RANK[S8Outcomes.finalSeverity(findings[i], findings[i].severity)], S8Outcomes.offensiveRank(findings[i]))); // src: vvaharness/pipeline/stages/s8/window.py:59
    }

    List<Integer> halfWindow(List<Finding> findings, List<Integer> window) {
        List<Integer> order = floorOrder(window.map(i -> findings[i]));
        int halfN = max(1, order.size() / 2);                                                   // src: vvaharness/pipeline/stages/s8/window.py:70
        return sorted(order.first(halfN).map(k -> window[k]));
    }

    List<Integer> selectWindow(List<Finding> findings, ContextPackage ctx, Theta θ) {
        int n = findings.size();
        int budget = θ["step8.prompt_token_budget"];                                            // src: vvaharness/pipeline/stages/s8/window.py:78
        int maxOut = θ["step8.max_tokens"];                                                     // src: vvaharness/pipeline/stages/s8/window.py:79
        int kOut = max((maxOut - 1500) / 100, 1);                                               // src: vvaharness/pipeline/stages/s8/window.py:80
        boolean factsOn = S8Prompts.factsEnabled(θ);                                            // src: vvaharness/pipeline/stages/s8/window.py:83
        boolean hopText = S8Prompts.hopTextEnabled(θ);                                          // src: vvaharness/pipeline/stages/s8/window.py:84
        List<Integer> blockCosts = range(n).map(i -> Tokens.estimate(S8Prompts.findingBlock("f" + i, findings[i], ctx, factsOn, hopText, θ))); // src: vvaharness/pipeline/stages/s8/window.py:85
        int fixed = Tokens.estimate(S8Prompts.system(θ)) + Tokens.estimate(S8Prompts.buildPrompt(List.of(), ctx, List.of(), θ))
                  + Tokens.estimate(S8Prompts.repoFactBlocks(findings, ctx, labels, factsOn, θ)) + SCHEMA_TOKENS; // src: vvaharness/pipeline/stages/s8/window.py:93
        if (fixed + sum(blockCosts) <= budget && n <= kOut) return range(n);                    // src: vvaharness/pipeline/stages/s8/window.py:96

        List<Integer> order = floorOrder(findings);
        List<Integer> included = new List();
        int total = fixed;
        for (int i : order) {                                                                   // src: vvaharness/pipeline/stages/s8/window.py:102
            // Break, not skip: the window stays a strict rank prefix so chains cite in-window ids.
            if (included.size() >= kOut || total + blockCosts[i] > budget) break;               // src: vvaharness/pipeline/stages/s8/window.py:104
            included.add(i);
            total += blockCosts[i];
        }
        // One pass: pull in same-file MEDIUM/LOW/INFO findings that chains often depend on.
        Set<String> seedFiles = included.map(i -> findings[i].file);
        for (int i : order) {                                                                   // src: vvaharness/pipeline/stages/s8/window.py:113
            if (included.contains(i) || included.size() >= kOut) continue;
            Finding f = findings[i];
            if (List.of(MEDIUM, LOW, INFO).contains(S8Outcomes.finalSeverity(f, f.severity)) && seedFiles.contains(f.file)
                && total + blockCosts[i] <= budget * 1.25) {                                    // src: vvaharness/pipeline/stages/s8/window.py:117
                included.add(i);
                total += blockCosts[i];
            }
        }
        if (n - included.size() > 0) Counters.bump("s8_findings_windowed", n - included.size()); // src: vvaharness/pipeline/stages/s8/window.py:129
        return sorted(included);
    }
}
