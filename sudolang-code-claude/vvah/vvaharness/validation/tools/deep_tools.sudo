# vvaharness/validation/tools/deep_tools.py

Builds the tool set offered on the deepagents route: the generic reader tools plus whichever of the five deterministic fact tools are in the allow list. Each fact tool is bound to the workspace.

Source: `vvaharness/validation/tools/deep_tools.py` (lines 1-104)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` (StreamingOptions.tool_builder; invoked by the deepagents harness)

// src: vvaharness/validation/tools/deep_tools.py:93-101
fn build_validation_tools(options, allowed_tools?):executor=code {
  reader_tools = build_reader_tools(options, allowed_tools)   // external: vvaharness/backends/harness/deepagents/tools.py
  allowed = set(allowed_tools or, when absent, [])
  return reader_tools + _fact_tools(options, allowed)
  // preserved: with allowed_tools null, no fact tool is built
}

// src: vvaharness/validation/tools/deep_tools.py:37-90
fn _fact_tools(options, allowed):executor=code {
  workspace = options.cwd
  if ("DiffTouched" in allowed) offer DiffTouched(file_path) => tools.diff_facts.diff_touched(workspace, file_path)
  if ("ChangedLines" in allowed) offer ChangedLines(file_path) => tools.diff_facts.changed_lines(workspace, file_path)
  if ("DiffImpactMap" in allowed) offer DiffImpactMap() => { files_changed, trust_boundary_touched } of tools.diff_facts.build_diff_impact_map(workspace)
  if ("PatternScan" in allowed) offer PatternScan(pattern_set) => tools.pattern_scanner.pattern_scan(workspace, pattern_set)
  if ("TestInventory" in allowed) offer TestInventory() => tools.test_inventory.test_inventory(workspace)
  // tool descriptions shown to the model are identical to tools/fact_specs.sudo
}
