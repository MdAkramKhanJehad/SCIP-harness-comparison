// file: vvaharness/backends/harness/deepagents/options/response_format.py
// Structured-output strategy: forced tool-calling (ToolStrategy) on Anthropic unless the model rejects forcing;
// a textual submit instruction is appended to the system prompt whenever forcing is dropped or unsupported.

@executedBy(CODE) @role(backend)
class ResponseFormat {

    Object strategyFor(Schema schema, String modelId, String provider) {
        if (routesToAnthropic(modelId, provider) && !FORCED_TOOL_CHOICE_UNSUPPORTED_MODELS.contains(modelId)) { // src: vvaharness/backends/harness/deepagents/options/response_format.py:58
            return new ToolStrategy(schema);                                                             // src: vvaharness/backends/harness/deepagents/options/response_format.py:60
        }
        return schema;                     // bare schema: provider-native structured output where supported // src: vvaharness/backends/harness/deepagents/options/response_format.py:61
    }

    // langchain-anthropic drops a forced tool_choice whenever thinking is enabled/adaptive.
    boolean forcingDroppedUnderThinking(ChatModel model, Object responseFormat) {
        if (!(responseFormat instanceof ToolStrategy)) return false;                                     // src: vvaharness/backends/harness/deepagents/options/response_format.py:73
        return model.thinkingType == "enabled" || model.thinkingType == "adaptive";                      // src: vvaharness/backends/harness/deepagents/options/response_format.py:76
    }

    Prompt submitInstructedPrompt(Prompt systemPrompt, ChatModel model, Schema responseModel, Object responseFormat, Theta θ) {
        if (responseModel == null) return systemPrompt;                                                  // src: vvaharness/backends/harness/deepagents/options/response_format.py:132
        if (forcingDroppedUnderThinking(model, responseFormat)) {                                        // src: vvaharness/backends/harness/deepagents/options/response_format.py:134
            if (!θ["p.response_format.submit_instruction_when_forcing_dropped_thinking"]) return systemPrompt; // src: vvaharness/backends/harness/deepagents/options/response_format.py:134
            Counters.bump("deepagents_tool_choice_dropped");                                             // src: vvaharness/backends/harness/deepagents/options/response_format.py:135
            warnToolChoiceDropped(model);                                                                // src: vvaharness/backends/harness/deepagents/options/response_format.py:136
        } else if (forcingUnsupported(model)) {                           // src: vvaharness/backends/harness/deepagents/options/response_format.py:137
            if (!θ["p.response_format.submit_instruction_when_forcing_unsupported"]) return systemPrompt; // src: vvaharness/backends/harness/deepagents/options/response_format.py:137
            Counters.bump("deepagents_tool_choice_unsupported");                                         // src: vvaharness/backends/harness/deepagents/options/response_format.py:138
            warnToolChoiceUnsupported(model);                                                            // src: vvaharness/backends/harness/deepagents/options/response_format.py:139
        } else {
            return systemPrompt;                                                                         // src: vvaharness/backends/harness/deepagents/options/response_format.py:141
        }
        String toolName = toolNameFor(responseModel);                          // src: vvaharness/backends/harness/deepagents/options/response_format.py:142
        // with_submit_instruction lives in backends/llm/models.py (not in this area)
        return withSubmitInstruction(systemPrompt, responseModel, toolName);                             // src: vvaharness/backends/harness/deepagents/options/response_format.py:143
    }

    Object responseFormat(Schema responseModel, String modelId, String provider) {
        if (responseModel == null) return null;                                                          // src: vvaharness/backends/harness/deepagents/options/response_format.py:150
        return strategyFor(responseModel, modelId, provider);                                            // src: vvaharness/backends/harness/deepagents/options/response_format.py:152
    }

    // Anonymous pydantic model HarnessResponse for ToolStrategy, built from a JSON output schema: each property maps by its
    // JSON type (string, integer, number, boolean, array to list, object to dict; any other or missing type falls back to
    // string). A required property is mandatory; every other property defaults to null.
    Type pydanticResponseFormat(Map schema) {                                                            // src: vvaharness/backends/harness/deepagents/options/response_format.py:37
        Map typeMap = Map.of("string", String, "integer", int, "number", float, "boolean", boolean, "array", List, "object", Map); // src: vvaharness/backends/harness/deepagents/options/response_format.py:39
        Set required = new Set(schema.get("required", []));                                              // src: vvaharness/backends/harness/deepagents/options/response_format.py:47
        Map fields = new Map();
        for (name, prop : schema.get("properties", new Map())) {                                         // src: vvaharness/backends/harness/deepagents/options/response_format.py:49
            base = typeMap.get(prop.get("type"), String);                                                // src: vvaharness/backends/harness/deepagents/options/response_format.py:50
            fields[name] = pair(base, required.contains(name) ? REQUIRED : DEFAULT_NULL);                // src: vvaharness/backends/harness/deepagents/options/response_format.py:51
        }
        return createModel("HarnessResponse", fields);                                                   // src: vvaharness/backends/harness/deepagents/options/response_format.py:53
    }

    // A model identifier for the WARN line, duck-typed: model attribute, else model_name, else unknown.
    String modelTag(ChatModel model) {                                                                   // src: vvaharness/backends/harness/deepagents/options/response_format.py:79
        return str(model.model != null && model.model != "" ? model.model : (model.modelName != null && model.modelName != "" ? model.modelName : "unknown")); // src: vvaharness/backends/harness/deepagents/options/response_format.py:81
    }

    // Name, once per model, that manual thinking cost deepagents a forced tool_choice (the session falls back to a textual
    // submit instruction; the structured-output tool is still advertised and validated when called).
    void warnToolChoiceDropped(ChatModel model) {                                                        // src: vvaharness/backends/harness/deepagents/options/response_format.py:84
        String tag = modelTag(model);
        WarnOnce.warnOnce(WARNED_DROPS, tag, "manual thinking: langchain drops the forced tool_choice for structured output");  // src: vvaharness/backends/harness/deepagents/options/response_format.py:91
    }

    // True when this model is known (seeded, or learned this process) to reject forcing.
    boolean forcingUnsupported(ChatModel model) {                                                        // src: vvaharness/backends/harness/deepagents/options/response_format.py:101
        return FORCED_TOOL_CHOICE_UNSUPPORTED_MODELS.contains(modelTag(model));                          // src: vvaharness/backends/harness/deepagents/options/response_format.py:103
    }

    // Name, once per model, that it is not sent a forced tool_choice (bare response schema plus textual submit instruction).
    void warnToolChoiceUnsupported(ChatModel model) {                                                    // src: vvaharness/backends/harness/deepagents/options/response_format.py:106
        String tag = modelTag(model);
        WarnOnce.warnOnce(WARNED_UNSUPPORTED, tag, "rejects a forced tool_choice with a 400 on this gateway");  // src: vvaharness/backends/harness/deepagents/options/response_format.py:111
    }

    // The tool name ToolStrategy would use for the response model, even if downgraded to bare: first schema spec name.
    String toolNameFor(Type responseModel) {                                                             // src: vvaharness/backends/harness/deepagents/options/response_format.py:119
        return new ToolStrategy(responseModel).schemaSpecs.get(0).name;                                  // src: vvaharness/backends/harness/deepagents/options/response_format.py:121
    }

    // One-shot variant: an injected pydantic model wins; else a model derived from the JSON output schema; else null.
    Object oneshotResponseFormat(OneShotOptions options) {                                               // src: vvaharness/backends/harness/deepagents/options/response_format.py:155
        if (options.responseModel != null) return strategyFor(options.responseModel, options.model, options.modelProvider); // src: vvaharness/backends/harness/deepagents/options/response_format.py:159
        if (options.outputSchema != null) {                                                              // src: vvaharness/backends/harness/deepagents/options/response_format.py:160
            derived = pydanticResponseFormat(copy(options.outputSchema));                                // src: vvaharness/backends/harness/deepagents/options/response_format.py:161
            return strategyFor(derived, options.model, options.modelProvider);                           // src: vvaharness/backends/harness/deepagents/options/response_format.py:162
        }
        return null;                                                                                     // src: vvaharness/backends/harness/deepagents/options/response_format.py:163
    }
}
