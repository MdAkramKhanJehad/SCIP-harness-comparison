# vvaharness/orchestrator/config_paths.py

Configuration path policy and model-role enumeration. It picks the default profile, refuses or replaces a configuration that lives inside the scan target, anchors relative input paths at the profile directory while refusing network (UNC) paths, lists the active model roles that preflight probes, and resolves per-role effort tiers.

Source: `vvaharness/orchestrator/config_paths.py` (lines 1-202)
Executor: code
Called from: `vvaharness/orchestrator/entry.py` main, `vvaharness/orchestrator/preflight.py`, `vvaharness/orchestrator/cmdb.py`, `vvaharness/cli/_commands.py`, `vvaharness/manifest.py`

// src: vvaharness/orchestrator/config_paths.py:36-45
fn _default_config():executor=code {
  return if ("./config.yaml" exists in the working directory) "./config.yaml" else _packaged_default()
}
fn _packaged_default():executor=code { return "<package>/config/profiles/default.yaml" }   // the trusted fallback

// src: vvaharness/orchestrator/config_paths.py:70-86
fn trusted_config(config, boundary, explicit, quiet=false):executor=code {
  // boundary is the untrusted scan target (--repo); null in batch mode
  if (boundary == null || environment VVAHARNESS_ALLOW_CWD_CONFIG is set) return config
  if (!_path_within(config, boundary)) return config
  require !explicit => throw ConfigPolicyError("--config ... resolves inside the scan target (...) — attacker-influenced; refusing. ...")   // entry.py exits 2
  if (!quiet) warn CONFIG_INSIDE_TARGET
  return _packaged_default()   // an auto-detected configuration inside the target is replaced, not used
}

// src: vvaharness/orchestrator/config_paths.py:48-67
fn _path_within(candidate, root):executor=code {
  if (either path fails to resolve) return false
  if (resolved candidate is under resolved root) return true
  // case-insensitive file systems: also true when the candidate or any of its parents is the same file (same stat) as root
  return any p in [candidate, ...parents of candidate] where samestat(p, root)
}

// src: vvaharness/orchestrator/config_paths.py:89-101
fn _resolve_against(base, p):executor=code {
  require !is_network_path(p) => throw ValueError("refusing network/UNC input path ... (reading it could leak credentials over SMB)")
  resolved = if (p is absolute) p else "$base/$p"
  require !is_network_path(resolved) => throw ValueError("refusing network/UNC input path ...")
  return resolved
}

// src: vvaharness/orchestrator/config_paths.py:105-130
_MODEL_ROLES = ["graph_annotate", "callgraph_creation", "autoexclude", "preprocess", "threatmodel", "decompose", "deepdive", "verify", "dedup", "chain", "remediate", "validate", "exploit_verification"]
_CALLGRAPH_ROLES = ["graph_annotate", "callgraph_creation"]   // legacy Stage 0 roles
_SUB_ROLES = { validate: ["orchestrator"], exploit_verification: exploit_verification.settings.EV_MODULES }
EV_MODEL_ROLES = "exploit_verification.<sub>" for each sub in EV_MODULES

// src: vvaharness/orchestrator/config_paths.py:113-119
fn _callgraph_llm_selected(cfg):executor=code {
  return lowercase(trimmed knob("step0.callgraph_detection", default="rules") || "rules") == "llm"
}

// src: vvaharness/orchestrator/config_paths.py:132-150
fn _iter_model_roles(cfg):executor=code {
  for each r in _MODEL_ROLES {
    if (r in _CALLGRAPH_ROLES && !_callgraph_llm_selected(cfg)) continue   // the annotator model is dead configuration unless the mode is exactly "llm"
    m = cfg.models[r]; if (m == null) continue
    if (r not in _SUB_ROLES) { yield [r, m]; continue }
    for each sub in _SUB_ROLES[r] {
      if (m[sub] == null) continue   // absent sub-roles are optional
      yield [if (length(_SUB_ROLES[r]) == 1) r else "$r.$sub", m[sub]]   // validate reports as "validate"; exploit verification as "exploit_verification.<sub>"
    }
  }
}

// src: vvaharness/orchestrator/config_paths.py:154-181
ROLE_EFFORT_KEY = { autoexclude: "step1.auto_exclude_effort", threatmodel: "step2.effort", deepdive: "step4.effort", verify: "step6_verify.effort", dedup: "step7_dedup.effort", chain: "step8.effort", validate: "step_validate.effort" }
fn role_effort(cfg, role):executor=code {
  if (role starts with "exploit_verification.") return exploit_verification.settings.ev_effort(cfg, sub)   // external
  if (role == "preprocess") {
    if (cfg.models.autoexclude is set) return null
    return knob("step1.auto_exclude_effort", default=null) || null   // preprocess shares autoexclude's effort only when models.autoexclude is unset
  }
  if (role not in ROLE_EFFORT_KEY) return null   // decompose and remediate have no effort key
  return knob(ROLE_EFFORT_KEY[role], default=null) || null
}

// src: vvaharness/orchestrator/config_paths.py:184-202
fn highest_effort(tiers):executor=code {
  order = keys of EFFORT_TIME_FACTOR[ClockKind.REQUEST]
  return the tier with the highest index in order, ignoring null and unknown tiers; null if none
}
