# vvaharness/models/case.py

`FindingCase`: one finding tracked across every attempt to fix it, persisted as JSON. Its `state` is derived from the attempts and never accepted from input.

Source: `vvaharness/models/case.py` (lines 1-119)
Executor: code
Called from: Stage 10 (remediation) and Stage 11 (validation), which append attempts and verdicts

// src: vvaharness/models/case.py:32-33
SCHEMA_VERSION = "2.0"

// src: vvaharness/models/case.py:36-47
Attempt {
  // frozen; unknown keys ignored
  ordinal: Number           // 1-based position
  remediation: Remediation
  verdict: Verdict | null = null   // null until validated
  reverted_paths: String[] = []    // paths the harness rolled back after a policy breach
}

// src: vvaharness/models/case.py:50-76
FindingCase {
  // frozen; unknown keys ignored (rejecting one would drop the persisted case)
  schema_version: String = SCHEMA_VERSION
  case_id: String           // stable identity, assigned once per (repository, finding)
  finding: Finding
  attempts: Attempt[] = []  // ordered, possibly multi-engine
  superseded_ids: String[] = []
  state: CaseState = derive.state_of(attempts)   // computed field, serialized on output
  // coercion (before validation): an input dict has its "state" key removed, so no caller can assert a state
}

// src: vvaharness/models/case.py:78-90
fn FindingCase.with_attempt(remediation, reverted_paths=[]):executor=code {
  return copy with attempts + Attempt({ ordinal: length(attempts) + 1, remediation, reverted_paths })
}

// src: vvaharness/models/case.py:92-98
fn FindingCase.with_verdict(verdict):executor=code {
  require attempts is not empty => throw "case $case_id has no attempt to attach a verdict to"
  return copy with the last attempt's verdict replaced by verdict
}

// src: vvaharness/models/case.py:100-119
fn FindingCase.read(path):executor=code {
  try data = parse JSON of path;
  catch JSON error => throw "malformed JSON in finding case $path: $error"
  return validate data as FindingCase
}
fn FindingCase.write(path):executor=code {
  write pretty JSON (indent 2) plus newline to "$path.tmp", then atomically replace path   // a concurrent reader never sees a partial file
}
