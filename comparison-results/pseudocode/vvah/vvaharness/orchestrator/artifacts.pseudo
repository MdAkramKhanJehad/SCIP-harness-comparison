// file: vvaharness/orchestrator/artifacts.py
// Names of the directories a scan leaves in the target checkout, and the guard that refuses to write
// artifacts through a symlink, onto a non-directory, or outside the target tree.

@executedBy(CODE) @role(types)
enum ArtifactNames { SCAN_DIR_NAME, CASE_DIR_NAME, CASE_FILE_NAME, FINDINGS_JSON_NAME }

@executedBy(CODE) @role(io)
class Artifacts {

    String SCAN_DIR_NAME = "security-scan";                  // Markdown report, SARIF, error log, findings.json // src: vvaharness/orchestrator/artifacts.py:32
    String CASE_DIR_NAME = "security-remediation";           // one subdirectory per remediated finding // src: vvaharness/orchestrator/artifacts.py:35
    String CASE_FILE_NAME = "finding_case.json";             // src: vvaharness/orchestrator/artifacts.py:38
    String FINDINGS_JSON_NAME = "findings.json";             // src: vvaharness/orchestrator/artifacts.py:41

    /** For the error message only; never raises. */
    String linkTarget(Path path) {
        try { return path.readlink().toString(); }                                                    // src: vvaharness/orchestrator/artifacts.py:52
        catch (OSError e) { return "?"; }                                                              // src: vvaharness/orchestrator/artifacts.py:54
    }

    /** <repo>/<name>, verified to be a real directory inside repo. Does not mkdir. */
    Path artifactDir(Path repo, String name) {
        Path root = repo;                                                                              // src: vvaharness/orchestrator/artifacts.py:60
        Path out = root.resolve(name);                                                                 // src: vvaharness/orchestrator/artifacts.py:61
        if (out.isSymlink()) throw new UnsafeArtifactDir("refusing to write scan artifacts through a symlink -> " + linkTarget(out)); // src: vvaharness/orchestrator/artifacts.py:62
        if (out.exists() && !out.isDir()) throw new UnsafeArtifactDir("exists and is not a directory"); // src: vvaharness/orchestrator/artifacts.py:67
        boolean inside;
        try { inside = out.realPath().isRelativeTo(root.realPath()); }                                 // src: vvaharness/orchestrator/artifacts.py:72
        catch (OSError e) { throw new UnsafeArtifactDir("cannot be resolved"); }                       // src: vvaharness/orchestrator/artifacts.py:73
        if (!inside) throw new UnsafeArtifactDir("resolves outside the target");                       // src: vvaharness/orchestrator/artifacts.py:77
        return out;                                                                                    // src: vvaharness/orchestrator/artifacts.py:82
    }
}

@executedBy(CODE) @role(types)
class UnsafeArtifactDir {
    // RuntimeError: the artifact location is not a real directory inside the target checkout; raised, not worked around. // src: vvaharness/orchestrator/artifacts.py:44
}
