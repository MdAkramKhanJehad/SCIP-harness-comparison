# vvaharness/remediation_agent/artifacts/diff/snapshot.py

Captures the contents of files before the model edits them (for diff synthesis and post-gate restoration), and lists which snapshotted files changed since.

Source: `vvaharness/remediation_agent/artifacts/diff/snapshot.py` (lines 1-64)
Executor: code
Called from: `plugin_runner/run.sudo` (snapshot before the engine call); `policy/postgate.sudo` enforce_post (changed_since_snapshot)

// src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:46-64
fn snapshot_files(repo, files):executor=code {
  snap = {}
  for each f in files {
    rel = paths._norm_path(f)
    if (!rel || rel in snap) continue
    p = paths._safe_repo_path(repo, f)
    require p != null => { warn "snapshot: refusing out-of-repo file reference"; continue }   // CWE-22: host or CI files must not leak into the diff artifact
    try snap[rel] = if (p is a file) UTF-8 text of p else null;   // null: the file does not exist yet
    catch => snap[rel] = null   // binary or unreadable is treated as absent
  }
  return snap
}

// src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:29-43
fn changed_since_snapshot(repo, before):executor=code {
  // the non-git counterpart of gitcapture.changed_files_whole_tree
  return the snapshot keys whose current content (UTF-8 text, or null when absent, binary or unreadable) differs from the snapshotted value; out-of-repo keys are skipped
}
