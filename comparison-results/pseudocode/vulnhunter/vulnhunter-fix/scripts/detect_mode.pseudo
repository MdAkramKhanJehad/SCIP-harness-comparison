// file: vulnhunter-fix/scripts/detect_mode.sh
// Mode dispatch for the fix skill: from CWD git origin plus TARGET_REPO / RESULTS_PATH decides
// in_place, fork, ambiguous or none, and prints one key=value line on stdout.

@executedBy(CODE) @role(types)
record Dispatch(String mode, String ownerRepo, String root, String origin, String target, String results, int exitCode) { }

@executedBy(CODE) @role(tool) @stage("fix")
class DetectMode {

    Dispatch run(String targetRepoArg, String resultsPathArg, Theta θ) {
        // positional overrides win over exported env
        String targetRepo = !targetRepoArg.isEmpty() ? targetRepoArg : Env.getOr("TARGET_REPO", "");    // src: vulnhunter-fix/scripts/detect_mode.sh:41
        String resultsPath = !resultsPathArg.isEmpty() ? resultsPathArg : Env.getOr("RESULTS_PATH", ""); // src: vulnhunter-fix/scripts/detect_mode.sh:42
        String top = Git.revParseShowToplevelOrEmpty();                                                   // src: vulnhunter-fix/scripts/detect_mode.sh:44
        String origin = "";
        String ownerRepo = "";
        boolean inGitRepo = false;
        if (!top.isEmpty()) {
            origin = Git.remoteGetUrlOrEmpty(top, "origin");                                              // src: vulnhunter-fix/scripts/detect_mode.sh:50
            String host = hostOf(origin);                                                                 // src: vulnhunter-fix/scripts/detect_mode.sh:57
            // host-only check: github.com, *.github.com, github.* (GitHub Enterprise)
            boolean isGithub = host.matchesAnyGlob(θ["code.fix.scripts.detect_mode.github_host_globs"]);  // src: vulnhunter-fix/scripts/detect_mode.sh:73
            if (isGithub) {
                Pair ownerAndRepo = parseOwnerRepo(origin);                                               // src: vulnhunter-fix/scripts/detect_mode.sh:78
                if (ownerAndRepo != null) {                                                               // src: vulnhunter-fix/scripts/detect_mode.sh:93
                    ownerRepo = ownerAndRepo.first + "/" + ownerAndRepo.second;
                    inGitRepo = true;                                                                     // src: vulnhunter-fix/scripts/detect_mode.sh:95
                }
            }
        }
        boolean hasArgs = !targetRepo.isEmpty() || !resultsPath.isEmpty();                                // src: vulnhunter-fix/scripts/detect_mode.sh:101
        // in-place with a local report: results ride on an optional field
        if (inGitRepo && targetRepo.isEmpty() && !resultsPath.isEmpty()) return new Dispatch("in_place", ownerRepo, top, origin, null, resultsPath, 0); // src: vulnhunter-fix/scripts/detect_mode.sh:111
        if (hasArgs && inGitRepo) return new Dispatch("ambiguous", ownerRepo, null, null, targetRepo, resultsPath, 2); // src: vulnhunter-fix/scripts/detect_mode.sh:116
        if (hasArgs) return new Dispatch("fork", null, null, null, targetRepo, resultsPath, 0);           // src: vulnhunter-fix/scripts/detect_mode.sh:121
        if (inGitRepo) return new Dispatch("in_place", ownerRepo, top, origin, null, null, 0);            // src: vulnhunter-fix/scripts/detect_mode.sh:126
        return new Dispatch("none", null, null, null, null, null, 0);                                     // src: vulnhunter-fix/scripts/detect_mode.sh:131
    }

    String hostOf(String origin) {
        if (origin.matchesGlob("git@*:*")) return origin.after("git@").before(":");                      // src: vulnhunter-fix/scripts/detect_mode.sh:58
        if (origin.matchesGlob("http://*") || origin.matchesGlob("https://*") || origin.matchesGlob("ssh://*")) return origin.after("://").before("/").afterLast("@"); // src: vulnhunter-fix/scripts/detect_mode.sh:62
        return "";
    }

    Pair parseOwnerRepo(String origin) {
        String s = origin;
        if (s.matchesGlob("git@*:*")) s = s.after(":");                                                  // src: vulnhunter-fix/scripts/detect_mode.sh:81
        else if (s.contains("://")) s = s.after("://").after("/");                                        // src: vulnhunter-fix/scripts/detect_mode.sh:84
        s = s.removeSuffix(".git").removeSuffix("/");                                                     // src: vulnhunter-fix/scripts/detect_mode.sh:88
        String owner = s.before("/");
        String repo = s.after("/").before("/");
        if (owner.isEmpty() || repo.isEmpty() || owner == s) return null;                                 // src: vulnhunter-fix/scripts/detect_mode.sh:93
        return Pair.of(owner, repo);
    }
}
