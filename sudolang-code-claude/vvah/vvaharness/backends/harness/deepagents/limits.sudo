// src: vvaharness/backends/harness/deepagents/limits.py:19-39
RECURSION_HEADROOM = 900   // extra LangGraph supersteps beyond max_turns
// preserved: source comment limits.py:21-29 — on the streaming route max_turns is "a FLOOR on the loop budget, not a ceiling": LangGraph counts supersteps (about 2 * turns + 3) and the builder asks for max_turns + 900, so "max_turns: 40 permits ~470 turns". A subagent's subgraph starts its own superstep counter against the same limit. The one-shot path uses max_turns + 5; via sdk and cli enforce max_turns as a hard turn cap. Exhausting the budget yields a terminal snapshot before HarnessProcessError(recursion_limited=true), and both consumers force-finalize from it.
MODEL_TIMEOUT_SECONDS = 1800.0   // per-request timeout for every model call; a hang stop, not a spend budget; scaled by effort in model_building
MODEL_MAX_OUTPUT_TOKENS = 64000   // explicit output ceiling, because the library default of 128000 fails with HTTP 400 on lower-cap models
MODEL_MAX_RETRIES = 2   // client retry ladder for 429 and 5xx; not 4, because the outer transient-retry of 3 attempts multiplies (9 sends at 2, 15 at 4) and each retry re-arms the timeout
