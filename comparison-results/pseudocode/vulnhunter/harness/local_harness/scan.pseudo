// file: harness/local_harness/scan.py
// Benchmark harness scanner: runs headless `claude -p "/vulnhunt <dir>"` per cloned repo in parallel,
// read-only by default, with 429 retry; symlink-safe handling of results dirs and logs in untrusted clones.

@executedBy(CODE) @role(evaluation)
class LocalHarnessScan {

    // ---------------- results-dir / log safety helpers ----------------

    boolean isRegularFile(String path) {
        return Fs.lstat(path).isRegular();  // no symlink/FIFO/device                          // src: harness/local_harness/scan.py:46
    }

    File openLogForRead(String path) {
        if (path == null || !isRegularFile(path)) return null;                                 // src: harness/local_harness/scan.py:62
        return Fs.open(path, O_RDONLY | O_NOFOLLOW);                                           // src: harness/local_harness/scan.py:65
    }

    File openLogForWrite(String path) {
        if (Fs.lexists(path)) removeResultsEntry(path);                                        // src: harness/local_harness/scan.py:82
        return Fs.open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW);                        // src: harness/local_harness/scan.py:84
    }

    List<String> tailLines(String path) {
        File f = openLogForRead(path);
        if (f == null) return List.of();
        return f.readLast(65536).lines();  // literal 64 KiB window                            // src: harness/local_harness/scan.py:90
    }

    boolean isLink(String path) {
        return Fs.islink(path) || Fs.isjunction(path);                                         // src: harness/local_harness/scan.py:111
    }

    boolean isGitTracked(String cloneDir, String entry) {
        Proc p = Sh.run(List.of("git", "ls-files", "-z", "--", entry), cloneDir, 30);           // src: harness/local_harness/scan.py:133
        if (p == null) return false;
        return p.returncode == 0 && !p.stdout.isEmpty();
    }

    boolean isScanResultsDir(String cloneDir, String entry) {
        if (!entry.contains("_VULNHUNT_RESULTS_")) return false;                                // src: harness/local_harness/scan.py:149
        String full = cloneDir + "/" + entry;
        if (isLink(full) || !Fs.isdir(full)) return false;                                     // src: harness/local_harness/scan.py:152
        return !isGitTracked(cloneDir, entry);  // repo-committed results dirs are forged       // src: harness/local_harness/scan.py:154
    }

    String findResultsDir(String cloneDir) {
        if (!Fs.isdir(cloneDir)) return null;
        for (String e : Fs.listdir(cloneDir).sorted()) {                                       // src: harness/local_harness/scan.py:164
            if (isScanResultsDir(cloneDir, e)) return cloneDir + "/" + e;
        }
        return null;
    }

    boolean isValidReadme(String resultsDir) {
        String readme = resultsDir + "/README.md";
        return isRegularFile(readme) && Fs.lstat(readme).size > 100;  // literal 100 bytes     // src: harness/local_harness/scan.py:173
    }

    boolean hasValidResults(String cloneDir) {
        String r = findResultsDir(cloneDir);
        if (r == null) return false;
        return isValidReadme(r);                                                               // src: harness/local_harness/scan.py:181
    }

    void removeResultsEntry(String path) {
        if (Fs.islink(path)) Fs.unlink(path);                                                  // src: harness/local_harness/scan.py:194
        else if (isLink(path)) Fs.rmdir(path);
        else if (Fs.isdir(path)) Fs.rmtree(path);
        else if (Fs.lexists(path)) Fs.remove(path);
    }

    List<String> cleanIncompleteResults(String cloneDir, String logFilename) {
        List<String> removed = new List();
        if (!Fs.isdir(cloneDir)) return removed;
        for (String e : Fs.listdir(cloneDir)) {
            if (!e.contains("_VULNHUNT_RESULTS_")) continue;                                   // src: harness/local_harness/scan.py:214
            String full = cloneDir + "/" + e;
            boolean link = isLink(full);
            if (!link && !Fs.isdir(full)) continue;
            if (link || !isScanResultsDir(cloneDir, e) || !isValidReadme(full)) {              // src: harness/local_harness/scan.py:222
                removeResultsEntry(full);
                removed.add(e);
                if (Fs.lexists(cloneDir + "/" + logFilename)) removeResultsEntry(cloneDir + "/" + logFilename);
            }
        }
        return removed;
    }

    List<String> cleanPriorResults(String cloneDir, String logFilename) {
        List<String> removed = new List();
        if (!Fs.isdir(cloneDir)) return removed;
        for (String e : Fs.listdir(cloneDir)) {
            String full = cloneDir + "/" + e;
            if (e.contains("_VULNHUNT_RESULTS_") && (isLink(full) || Fs.isdir(full))) { removeResultsEntry(full); removed.add(e); } // src: harness/local_harness/scan.py:243
        }
        if (Fs.lexists(cloneDir + "/" + logFilename)) { removeResultsEntry(cloneDir + "/" + logFilename); removed.add(logFilename); } // src: harness/local_harness/scan.py:250
        return removed;
    }

    boolean isRateLimitFailure(String logPath) {
        if (logPath == null || !isRegularFile(logPath)) return false;
        for (String line : tailLines(logPath).reversed()) {
            Event ev = Json.tryParse(line);
            if (ev != null && ev.type == "result") return ev.api_error_status == 429;          // src: harness/local_harness/scan.py:268
        }
        return false;
    }

    Map extractCostFromLog(String logPath) {
        if (logPath == null || !isRegularFile(logPath)) return Map.of();
        for (String line : tailLines(logPath).reversed()) {
            Event ev = Json.tryParse(line);
            if (ev != null && ev.type == "result") {                                           // src: harness/local_harness/scan.py:293
                return Map.of("total_cost_usd", ev.total_cost_usd, "input_tokens", ev.modelUsage.sum("inputTokens"),
                    "output_tokens", ev.modelUsage.sum("outputTokens"), "cache_read_tokens", ev.modelUsage.sum("cacheReadInputTokens"),
                    "cache_creation_tokens", ev.modelUsage.sum("cacheCreationInputTokens"), "duration_api_ms", ev.duration_api_ms, "num_turns", ev.num_turns);
            }
        }
        return Map.of();
    }

    // ---------------- scan metadata + prompt ----------------

    String normalizeRepoUrl(String raw) {
        String url = raw.trim();
        if (url.matches("^git@([^:]+):(.+)$")) url = "https://" + url.host() + "/" + url.path(); // src: harness/local_harness/scan.py:329
        url = url.stripUserinfo();                                                              // src: harness/local_harness/scan.py:332
        return url.endsWith(".git") ? url.dropSuffix(".git") : url;
    }

    Pair gitMetadata(String folder) {
        String branch = Sh.git(folder, "rev-parse", "--abbrev-ref", "HEAD");                   // src: harness/local_harness/scan.py:344
        String sha = Sh.git(folder, "rev-parse", "--short", "HEAD");
        String branchLabel = (!branch.isEmpty() && !sha.isEmpty()) ? branch + " [" + sha + "]" : "unknown";
        String repoUrl = normalizeRepoUrl(Sh.git(folder, "remote", "get-url", "origin"));
        return new Pair(branchLabel, repoUrl.isEmpty() ? basename(folder) : repoUrl);         // src: harness/local_harness/scan.py:347
    }

    String createResultsDir(String folder) {
        String d = folder + "/" + basename(folder) + "_VULNHUNT_RESULTS_" + Clock.stamp("%Y-%m-%d-%H%M%S"); // src: harness/local_harness/scan.py:357
        Fs.mkdir(d);  // fails rather than reuse
        return d;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt buildScanPrompt(String folder, String resultsDir, String branchLabel, String repoUrl, boolean readonly, Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.scan.skill_invocation"].replace("<folder_path>", folder));              // src: harness/local_harness/scan.py:370
        if (θ["p.scan.headless_mode_notice"]) p.context("IMPORTANT: This is running in non-interactive headless mode."); // src: harness/local_harness/scan.py:371
        if (θ["p.scan.no_approval_execute_immediately"]) p.forbid("Do NOT ask for approval or confirmation. Execute immediately."); // src: harness/local_harness/scan.py:372
        String bashLine;
        if (readonly) {
            if (θ["p.scan.read_only_scan_suffix"]) p.rule("Perform a read-only scan, skip instructions related to getting dependencies and executing code"); // src: harness/local_harness/scan.py:376
            bashLine = "Bash is NOT available — use " + θ["p.scan.bash_unavailable_line"] + " only."; // src: harness/local_harness/scan.py:379
        } else {
            bashLine = θ["p.scan.bash_available_line"];                                        // src: harness/local_harness/scan.py:381
        }
        if (θ["p.scan.pre_resolved_metadata_literal"]) p.must("Pre-resolved scan metadata (use these literal values — do NOT run shell commands to recompute them)"); // src: harness/local_harness/scan.py:384
        p.context(θ["p.scan.metadata_fields"].bind(resultsDir, branchLabel, repoUrl, bashLine)); // src: harness/local_harness/scan.py:386
        return p;
    }

    String absPathRule(String tool, String path) {
        return tool + "(//" + Fs.realpath(path).lstrip("/") + "/**)";                          // src: harness/local_harness/scan.py:399
    }

    // ---------------- one scan ----------------

    ScanResult scanFolder(String folder, String logFile, boolean readonly, Theta θ) {
        String label = basename(folder);
        if (logFile == null) logFile = folder + "/benchmark_scan.log";                         // src: harness/local_harness/scan.py:411
        if (!Fs.isdir(LocalHarnessConfig.SKILLS_DIR())) return new ScanResult(folder, label, 1, 0, 0, null, Map.of()); // src: harness/local_harness/scan.py:414
        String resultsDir = createResultsDir(folder);                                          // src: harness/local_harness/scan.py:418
        Pair meta = gitMetadata(folder);
        Prompt prompt = buildScanPrompt(folder, resultsDir, meta.a, meta.b, readonly, θ);      // src: harness/local_harness/scan.py:420
        List<String> toolArgs;
        if (readonly) {
            toolArgs = List.of("--tools", θ["harness.scan_tools"].join(","),                    // src: harness/local_harness/scan.py:424
                "--permission-mode", "default", "--allowedTools", absPathRule("Edit", resultsDir), "Agent"); // src: harness/local_harness/scan.py:425
        } else {
            toolArgs = List.of("--allowedTools", "Read", "Write", "Edit", "Bash", "Agent", "--permission-mode", "acceptEdits"); // src: harness/local_harness/scan.py:428
        }
        List<String> cmd = List.of("claude", "-p", prompt, "--output-format", "stream-json", "--verbose").plus(toolArgs); // src: harness/local_harness/scan.py:431
        if (θ["code.strict_mcp_config"]) cmd = cmd.plus("--setting-sources", "user", "--strict-mcp-config"); // src: harness/local_harness/scan.py:456
        cmd = cmd.plus("--model", θ["harness.MODEL"], "--add-dir", folder, "--add-dir", LocalHarnessConfig.SKILLS_DIR(), "--add-dir", LocalHarnessConfig.PHASES_DIR()); // src: harness/local_harness/scan.py:458
        Proc proc = Sh.popen(cmd, folder, STDERR_TO_STDOUT);                                   // src: harness/local_harness/scan.py:431
        Timer timer = Timer.start(θ["harness.SCAN_TIMEOUT"], () -> proc.kill());              // src: harness/local_harness/scan.py:479
        int events = 0;
        try (File log = openLogForWrite(logFile)) {                                            // src: harness/local_harness/scan.py:482
            for (String line : proc.stdout) {
                log.write(line);
                if (Json.tryParse(line) != null) events++;
            }
        } finally { timer.cancel(); }
        proc.waitFor();
        boolean timedOut = timer.fired();
        if (timedOut && isValidReadme(resultsDir)) timedOut = false;                           // src: harness/local_harness/scan.py:505
        Map cost = timedOut ? Map.of() : extractCostFromLog(logFile);                          // src: harness/local_harness/scan.py:508
        if (Fs.listdir(resultsDir).isEmpty()) resultsDir = null;                               // src: harness/local_harness/scan.py:524
        return new ScanResult(folder, label, proc.returncode, events, proc.elapsed(), resultsDir, cost);
    }

    ScanResult scanFolderWithRetry(String folder, String logFilename, boolean readonly, Theta θ) {
        double backoff = 60;  // SCAN_RETRY_INITIAL_BACKOFF literal                            // src: harness/local_harness/config.py:25
        double total = 0;
        for (int attempt = 0; attempt <= θ["harness.SCAN_MAX_RETRIES"]; attempt++) {           // src: harness/local_harness/scan.py:538
            if (attempt > 0) {
                Clock.sleep(backoff);
                backoff = Math.min(backoff * 2.0, 300);  // multiplier / max backoff literals  // src: harness/local_harness/scan.py:543
                cleanPriorResults(folder, logFilename == null ? "benchmark_scan.log" : logFilename); // src: harness/local_harness/scan.py:545
            }
            ScanResult r = scanFolder(folder, logFilename == null ? null : folder + "/" + logFilename, readonly, θ);
            total += r.elapsed;
            if (r.returncode != 0 && isRateLimitFailure(folder + "/" + (logFilename == null ? "benchmark_scan.log" : logFilename))) { // src: harness/local_harness/scan.py:553
                if (attempt < θ["harness.SCAN_MAX_RETRIES"]) continue;                         // src: harness/local_harness/scan.py:554
            }
            return r.withElapsed(total);
        }
        return null;
    }

    List<Pair> scanTargets(List<Target> targets, Integer maxWorkers, int statusInterval, String logFilename, boolean readonly, Theta θ) {
        if (maxWorkers == null) maxWorkers = θ["harness.MAX_SCAN_WORKERS"];                     // src: harness/local_harness/scan.py:575
        return Runtime.parallel(maxWorkers, targets, t -> {                                   // src: harness/local_harness/scan.py:585
            try { return new Pair(t.key, scanFolderWithRetry(t.cloneDir, logFilename, readonly, θ)); }
            catch (Exception e) { return new Pair(t.key, new ScanResult(t.cloneDir, t.key, -1, 0, 0, null, Map.of())); } // src: harness/local_harness/scan.py:597
        });
        // every statusInterval seconds (default 300) prints pending keys
    }
}

@executedBy(CODE) @role(types)
record ScanResult(String folderPath, String label, int returncode, int eventCount, double elapsed, String resultsDir, Map costData) { }
