// file: vvaharness/remediation_agent/policy/context.py
// Primary class named PolicyContextLoader because the generated name Context is already used by another file. Load the gate, the playbook and the repo's detected frameworks once per run (honouring profile path overrides).

@executedBy(CODE) @role(types) @stage("S10")
record PolicyContext(RemediationGate gate, Playbook playbook, Set<String> frameworks, boolean enabled) { } // src: vvaharness/remediation_agent/policy/context.py:42  (enabled defaults to true)

@executedBy(CODE) @role(config) @stage("S10")
class PolicyContextLoader {

    Object sr(Config cfg, String key, Object dflt) {
        // Reads step_remediate.<key>; when the whole step_remediate block is absent, returns the default.
        Object block = cfg.step_remediate;                                                          // src: vvaharness/remediation_agent/policy/context.py:32
        return block != null ? block.getOr(key, dflt) : dflt;                                       // src: vvaharness/remediation_agent/policy/context.py:33
    }

    boolean policyEnabled(Config cfg, Theta θ) {
        // Whether the policy gate and playbook are active for this run (code fallback when the key is absent: true).
        return sr(cfg, "enforce_policy", θ["step_remediate.enforce_policy"]);                        // src: vvaharness/remediation_agent/policy/context.py:38
    }

    String resolveInput(Config cfg, String raw) {
        // A configured input path, or null when unset or non-existent (null means the bundled default).
        if (raw == null || raw.isEmpty()) return null;                                              // src: vvaharness/remediation_agent/policy/context.py:55  (a missing file would fail closed and deny EVERY finding)
        if (Config.isNetworkPath(raw)) throw new ValueError("refusing network/UNC remediation input path");  // src: vvaharness/remediation_agent/policy/context.py:58  (a UNC override would leak NTLM credentials over SMB)
        String cfgDir = cfg != null ? cfg.data.get("_config_dir") : null;                           // src: vvaharness/remediation_agent/policy/context.py:62
        String resolved = cfgDir != null ? ConfigPaths.resolveAgainst(cfgDir, raw) : raw;                 // src: vvaharness/remediation_agent/policy/context.py:63
        if (resolved != null && !Path.exists(resolved)) return null;                                // src: vvaharness/remediation_agent/policy/context.py:64  (warns, falls back to the bundled default)
        return resolved;                                                                            // src: vvaharness/remediation_agent/policy/context.py:68
    }

    PolicyContext buildContext(Config cfg, String repoRoot, Theta θ) {
        String policyFile = resolveInput(cfg, sr(cfg, "policy_file", null));                        // src: vvaharness/remediation_agent/policy/context.py:72
        String playbookFile = resolveInput(cfg, sr(cfg, "playbook_file", null));                    // src: vvaharness/remediation_agent/policy/context.py:73
        RemediationGate gate = Gate.init(policyFile, θ);                                            // src: vvaharness/remediation_agent/policy/context.py:74
        Playbook pb = RemediationAgentPlaybook.load(playbookFile, θ);                               // src: vvaharness/remediation_agent/policy/context.py:75
        Set<String> fw;
        try {
            fw = Frameworks.detectFrameworks(repoRoot, θ);                                          // src: vvaharness/remediation_agent/policy/context.py:77
        } catch (Exception e) {
            fw = Set.of();                                                                          // src: vvaharness/remediation_agent/policy/context.py:79  (detection failure means no frameworks)
        }
        return new PolicyContext(gate, pb, fw, policyEnabled(cfg, θ));                              // src: vvaharness/remediation_agent/policy/context.py:80
    }
}
