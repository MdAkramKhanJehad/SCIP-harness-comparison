// VulnHunter scan pipeline (commit 6d25b5c)
// Drawn from the `pipeline:` block of vulnhunter.knobs.yaml.
// Render: dot -Tsvg vulnhunter_pipeline.dot -o vulnhunter_pipeline.svg
digraph VulnHunter {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, bgcolor="#fcfcfb",
         nodesep=0.35, ranksep=0.32, pad=0.3, newrank=true,
         label=<<b>VulnHunter scan pipeline</b><br/><font point-size="10" color="#52514e">Only the outer runner is Python; phases A–E and the report are prompts run inside one model session.<br/>Grey text = main knobs (ids in vulnhunter.knobs.yaml)</font>>,
         labelloc=t, labeljust=l];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10,
         color="#a8a7a2", fillcolor="#ffffff", fontcolor="#0b0b0b", margin="0.14,0.06"];
  edge  [color="#7a7975", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9, fontcolor="#52514e"];

  subgraph cluster_legend {
    label=<<b>Node kinds</b>>; fontsize=10; style="rounded"; color="#e4e3df";
    lg_det [label="Python code (runner)", fillcolor="#e9e8e4"];
    lg_orc [label="Orchestrator prompt\n(/vulnhunt SKILL.md)", fillcolor="#d6e6f8", color="#2a78d6"];
    lg_sub [label="Subagent prompt\n(phases/*.md)", fillcolor="#2a78d6", fontcolor="#ffffff", color="#2a78d6"];
    lg_opt [label="Optional (flag-gated)", style="rounded,dashed", fillcolor="#ffffff"];
    lg_det -> lg_orc -> lg_sub -> lg_opt [style=invis];
  }

  subgraph cluster_runner {
    label=<<b>agent_scan</b>  <font color="#52514e">vulnhunter-agent/agent/runner.py</font>>; fontsize=10;
    style="rounded"; color="#a8a7a2";
    clone [label=<<b>Clone repo</b><br/><font point-size="9" color="#52514e">code.clone_depth · refuse if old results exist</font>>, fillcolor="#e9e8e4"];
    sess  [label=<<b>Start SDK session</b><br/><font point-size="9" color="#52514e">anthropic.model · scan.allowed_tools (no Bash by default)<br/>scan.permission_mode · no max_turns · no cost cap</font>>, fillcolor="#e9e8e4"];
    kick  [label=<<b>Send "/vulnhunt &lt;clone&gt;"</b><br/><font point-size="9" color="#52514e">code.kickoff_metadata<br/>then re-prompt while subagents are pending (code.continuation_prompt)<br/>stop after code.max_stalled_continuations idle re-prompts</font>>, fillcolor="#e9e8e4"];
    clone -> sess -> kick;
  }

  subgraph cluster_skill {
    label=<<b>/vulnhunt</b>  <font color="#52514e">vulnhunt/SKILL.md + phases/*.md (all prompt text)</font>>; fontsize=10;
    style="rounded"; color="#2a78d6";
    gate  [label=<<b>Model check · mode</b><br/><font point-size="9" color="#52514e">stop if model &lt; skill.min_model (interactive)<br/>STATIC, or EXECUTE (needs Bash)</font>>, fillcolor="#d6e6f8", color="#2a78d6"];
    p1    [label=<<b>A · Recon</b>  (phase1)<br/><font point-size="9" color="#ffffff">inputs · sinks · call graph (recon.callgraph_depth)<br/>shared infra · partitions SG-1..n (oversize_inputs / _files)<br/>PRODUCTION | DEV-ONLY · threat model</font>>, fillcolor="#2a78d6", fontcolor="#ffffff", color="#2a78d6"];
    p2    [label=<<b>B · Hunt</b>  (phase2)<br/><font point-size="9" color="#ffffff">partition × hunt.class_groups + sink_driven_agents<br/>waves of hunt.wave_size · investigation_discipline<br/>hard_gates in order<br/>→ CANDIDATE | SAFE | NO-MATCH | CROSS-CLASS | DESIGN-INTENT</font>>, fillcolor="#2a78d6", fontcolor="#ffffff", color="#2a78d6"];
    agg   [label=<<b>Aggregate</b><br/><font point-size="9" color="#52514e">CANDIDATE if any agent says so · merge same sink<br/>dispositions must equal inventory · absent-input check</font>>, fillcolor="#d6e6f8", color="#2a78d6"];
    p2b   [label=<<b>C · Adversarial review</b>  (phase2b)<br/><font point-size="9" color="#ffffff">consensus skip · nine checks per candidate<br/>→ CONFIRMED | FALSE POSITIVE (needs file:line)</font>>, fillcolor="#2a78d6", fontcolor="#ffffff", color="#2a78d6"];
    p3    [label=<<b>D · Exploit + fix strategy</b>  (phase3, 3c)<br/><font point-size="9" color="#ffffff">only severity in scope.phase3_severity_floor<br/>PoC + exploit test; run if EXECUTE, else reason<br/>→ fix strategy | Code Smell | Potential | eliminated</font>>, fillcolor="#2a78d6", fontcolor="#ffffff", color="#2a78d6"];
    p3d   [label=<<b>E · Variant sweep</b>  (phase3d)<br/><font point-size="9" color="#ffffff">grep each root cause across the repo</font>>, fillcolor="#2a78d6", fontcolor="#ffffff", color="#2a78d6"];
    p4    [label=<<b>Report</b>  (phase4)<br/><font point-size="9" color="#52514e">one VULN-NNN per sink location · count checks</font>>, fillcolor="#d6e6f8", color="#2a78d6"];
    gate -> p1 -> p2 -> agg -> p2b -> p3 -> p3d -> p4;
    p3d -> p2 [style=dashed, xlabel="new hits re-enter  ", constraint=false];
  }

  subgraph cluster_after {
    label=<<b>After the session</b>  <font color="#52514e">runner.py · issues_extract.py</font>>; fontsize=10;
    style="rounded"; color="#a8a7a2";
    pub [label=<<b>Publish results</b> (optional)<br/><font point-size="9" color="#52514e">publish.enabled</font>>, fillcolor="#e9e8e4", style="rounded,filled,dashed"];
    iss [label=<<b>File issues</b> (optional)<br/><font point-size="9" color="#52514e">Confirmed findings → dedup → post · issues.enabled</font>>, fillcolor="#e9e8e4", style="rounded,filled,dashed"];
    pub -> iss [style=dashed];
  }

  kick -> gate;
  p4 -> pub [style=dashed, label=" session ends"];
  {rank=same; lg_det; clone}
}
