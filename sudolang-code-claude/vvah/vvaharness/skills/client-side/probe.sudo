# vvaharness/skills/client-side/probe.sh

Client-side sink battery: one read-only pass over browser-delivered code printing path:line hits per CWE class, including the server lines that read client-sent identity and amount parameters.

Source: `vvaharness/skills/client-side/probe.sh` (lines 1-199)
Executor: code (POSIX shell; read-only greps; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/client-side/probe.sh [root]`, because the lens SKILL.md or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 5-17 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints `path:line` hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/client-side/probe.sh:19-199
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/client-side/probe.sh:19-67 — setup and the scan helper
  EXC = exclude directories node_modules, .git, dist, build, coverage, .next, out, vendor, __pycache__, .venv, bower_components, __mocks__, __tests__, cypress, e2e, .storybook, stories, test, tests, .vvaharness, security-scan;
        exclude files *.min.js, *-min.js, *.bundle.js, *.map, *.test.*, *.spec.*, *.stories.*, *.example*, SKILL.md, probe.sh
  JS  = *.js *.jsx *.ts *.tsx *.mjs *.cjs *.vue *.svelte
  TPL = *.html *.htm *.ejs *.hbs *.handlebars *.pug *.jade *.erb *.twig *.mustache *.njk *.liquid
  CFG = *.json *.env .env* *.yml *.yaml Dockerfile* *.conf
  SRV = *.py *.rb *.php *.java *.go *.cs *.js *.ts *.kt *.scala
  CLIENT = JS + TPL

  scan(label, includes, pattern, cap = 10) {
    // grep -rEnIs, case-sensitive; each printed line cut after 200 characters with " ..."
    if (no match) print "(none)"
    else { print first cap hits; if (total > cap) print "... <total> hits total, <cap> shown" }
  }
  print "each section is capped; '(none)' means the pattern class is absent, not that the probe failed"

  // src: vvaharness/skills/client-side/probe.sh:69-118 — inventory, embedded python3; prints "(inventory unavailable)" if python3 fails
  inventory {
    walk ROOT skipping node_modules, .git, dist, build, coverage, .next, out, vendor, __pycache__, .venv, bower_components
    count client files by extension (.js .jsx .ts .tsx .mjs .cjs .vue .svelte .html .htm .ejs .hbs .handlebars .pug .jade .erb .twig .mustache), excluding *.min.js, *-min.js, *.bundle.js; print the counts and the top 10 two-level directories
    list files of interest (package.json, lockfiles, .dockerignore, .npmrc, bundler configs, angular.json, setupProxy.js, config.js, constants.js/ts, environment.prod.ts, service-worker.js, any .env*, Dockerfile*, *.map), first 30 sorted, then "... <n> total"
    if (package-lock.json, yarn.lock or pnpm-lock.yaml exists at ROOT) print "lockfile: <name>"
    else if (package.json exists at ROOT) print "lockfile: NONE beside package.json -- ^ ranges resolve at build time"
  }

  // Section caps are the trailing number in each call below (default 10).
  // src: vvaharness/skills/client-side/probe.sh:120-121
  scan("SECRET LITERALS (CWE-798)")
  // pattern and arguments, verbatim: "$CLIENT $CFG" '(sk_live_|sk_test_|rk_live_|AKIA[0-9A-Z]{6}|ASIA[0-9A-Z]{6}|AIza[0-9A-Za-z_-]{10}|ghp_[0-9A-Za-z]{10}|gho_[0-9A-Za-z]{10}|glpat-|xox[baprs]-|SG\.[0-9A-Za-z_-]{10}|-----BEGIN [A-Z ]*PRIVATE KEY|mongodb(\+srv)?://[^ "'"'"']*:|postgres(ql)?://[^ "'"'"']*:)' 15
  // src: vvaharness/skills/client-side/probe.sh:123-124
  scan("CREDENTIAL-SHAPED ASSIGNMENTS (CWE-798, CWE-540)")
  // pattern and arguments, verbatim: "$CLIENT $CFG" '(api_?[kK]ey|apiSecret|client_?[sS]ecret|secret_?[kK]ey|access_?[kK]ey|private_?[kK]ey|password|passwd|pepper|salt|firebaseConfig|connectionString)[[:space:]]*[:=][[:space:]]*("[^"]{6,}"|'"'"'[^'"'"']{6,}'"'"')' 15
  // src: vvaharness/skills/client-side/probe.sh:126-127
  scan("BUILD-INLINED ENV -- published by definition (CWE-540)")
  // pattern and arguments, verbatim: "$CLIENT $CFG" '(REACT_APP_|NEXT_PUBLIC_|VITE_|VUE_APP_|GATSBY_|NUXT_PUBLIC_|EXPO_PUBLIC_|PUBLIC_|DefinePlugin|process\.env\.[A-Z_]+)' 15
  // src: vvaharness/skills/client-side/probe.sh:129-130
  scan("SHIPPED ARTIFACTS / DEV SERVER (CWE-540, CWE-489)")
  // pattern and arguments, verbatim: "$CLIENT $CFG" '(sourceMappingURL|GENERATE_SOURCEMAP|productionSourceMap|devtool[[:space:]]*:|CMD[[:space:]]*\[?.*(npm[[:space:]]+(run[[:space:]]+)?(start|dev)|react-scripts[[:space:]]+start|vite|next[[:space:]]+dev|ng[[:space:]]+serve)|^COPY \. |FROM[[:space:]]+node:(8|10|12|14|16)|debug[[:space:]]*[:=][[:space:]]*true)' 15
  // src: vvaharness/skills/client-side/probe.sh:132-133
  scan("HTML SINKS (CWE-79)")
  // pattern and arguments, verbatim: "$CLIENT" '(\.innerHTML|\.outerHTML|insertAdjacentHTML|document\.write(ln)?\(|createContextualFragment|\.html\(|\.(append|prepend|after|before|replaceWith)\()' 15
  // src: vvaharness/skills/client-side/probe.sh:135-136
  scan("FRAMEWORK RAW-HTML ESCAPES (CWE-79)")
  // pattern and arguments, verbatim: "$CLIENT" '(dangerouslySetInnerHTML|v-html|\[innerHTML\]|bypassSecurityTrust|\{@html|rehype-?[rR]aw|ReactMarkdown|domPropsInnerHTML|Handlebars\.SafeString|\|[[:space:]]*safe|\{\{\{)' 15
  // src: vvaharness/skills/client-side/probe.sh:138-139
  scan("CODE EXECUTION SINKS (CWE-95)")
  // pattern and arguments, verbatim: "$CLIENT" '(\beval\(|new Function\(|[^a-zA-Z]Function\(["'"'"']|setTimeout\([[:space:]]*["'"'"'`]|setInterval\([[:space:]]*["'"'"'`]|new Worker\(|importScripts\(|_\.template\(|Vue\.compile\(|vm\.runIn|execScript)' 12
  // src: vvaharness/skills/client-side/probe.sh:141-142
  scan("NAVIGATION / URL SINKS (CWE-79, CWE-601)")
  // pattern and arguments, verbatim: "$CLIENT" '(location[[:space:]]*=[^=]|location\.(href|assign|replace)|window\.open\(|\.href[[:space:]]*=[^=]|\.action[[:space:]]*=[^=]|\.src[[:space:]]*=[^=]|srcdoc|setAttribute\([[:space:]]*["'"'"'](href|src|action|formaction|on)|javascript:|data:text/html)' 15
  // src: vvaharness/skills/client-side/probe.sh:144-145
  scan("TAINT SOURCES (CWE-20 inputs, not findings alone)")
  // pattern and arguments, verbatim: "$CLIENT" '(location\.(hash|search|pathname|href)|document\.(URL|documentURI|baseURI|referrer|cookie)|window\.name|history\.state|URLSearchParams|useSearchParams|router\.(query|asPath)|useParams\(|\bevent\.data\b|\.onmessage|WebSocket\()' 15
  // src: vvaharness/skills/client-side/probe.sh:147-148
  scan("PROTOTYPE POLLUTION (CWE-1321)")
  // pattern and arguments, verbatim: "$CLIENT" '(\$\.extend\([[:space:]]*true|deepmerge|lodash\.merge|_\.merge\(|_\.set\(|_\.setWith|Object\.assign\([[:space:]]*\{\}[[:space:]]*,[[:space:]]*[a-z]|__proto__|\bprototype\[|constructor\[)' 10
  // src: vvaharness/skills/client-side/probe.sh:150-151
  scan("POSTMESSAGE / MESSAGE LISTENERS (CWE-346, CWE-201)")
  // pattern and arguments, verbatim: "$CLIENT" '(addEventListener\([[:space:]]*["'"'"']message|\.onmessage[[:space:]]*=|\.postMessage\()' 12
  // src: vvaharness/skills/client-side/probe.sh:153-154
  scan("ORIGIN CHECKS PRESENT -- refutation evidence (CWE-940)")
  // pattern and arguments, verbatim: "$CLIENT" '(\.origin[[:space:]]*(===|==|!==|!=)|\.origin\.(indexOf|startsWith|endsWith|match|includes)|ALLOWED_ORIGIN|allowedOrigins|checkOrigin|event\.source)' 10
  // src: vvaharness/skills/client-side/probe.sh:156-157
  scan("FRAME / WINDOW ISOLATION (CWE-1022)")
  // pattern and arguments, verbatim: "$CLIENT" '(<iframe|target=["'"'"']_blank|rel=["'"'"'][^"'"'"']*noopener|sandbox=|allow-scripts|window\.opener)' 10
  // src: vvaharness/skills/client-side/probe.sh:159-160
  scan("TOKEN / CREDENTIAL STORAGE (CWE-522, CWE-1004, CWE-1275)")
  // pattern and arguments, verbatim: "$CLIENT" '((localStorage|sessionStorage)\.(setItem|getItem)|(localStorage|sessionStorage)\[|document\.cookie[[:space:]]*=|Cookies\.set\(|js-cookie|indexedDB|\.setItem\([[:space:]]*["'"'"'](token|jwt|access_?token|refresh_?token|api_?key|password|user))' 15
  // src: vvaharness/skills/client-side/probe.sh:162-163
  scan("CLIENT-SIDE JWT DECODE (CWE-807)")
  // pattern and arguments, verbatim: "$CLIENT" '(atob\(|jwt_?[dD]ecode|jwtDecode|decodeJwt|jose\.decode|split\(["'"'"']\.["'"'"']\)|Buffer\.from\([^,]*,[[:space:]]*["'"'"']base64)' 12
  // src: vvaharness/skills/client-side/probe.sh:165-166
  scan("SECRETS IN CLIENT LOGS (CWE-532)")
  // pattern and arguments, verbatim: "$CLIENT" 'console\.(log|info|debug|warn|error|table)\([^)]*(token|jwt|password|passwd|secret|api_?key|apiKey|ssn|cvv|card_?number|authorization)' 10
  // src: vvaharness/skills/client-side/probe.sh:168-169
  scan("CLIENT-ONLY AUTHZ / RENDER GATES (CWE-602)")
  // pattern and arguments, verbatim: "$CLIENT" '(is_?[aA]dmin|isSuperuser|isStaff|isOwner|(user|auth|currentUser|me|profile|account)\.role|\.role[[:space:]]*(===|==|!==|!=)[[:space:]]*["'"'"'](admin|superuser|root|owner|manager|staff|editor)|hasPermission|hasRole|canActivate|AuthGuard|RequireAuth|isAuthenticated|\.permissions|v-if=["'"'"'][^"'"'"']*(role|admin|permission)|\{[[:space:]]*(user|auth|currentUser)[.a-zA-Z_]*[[:space:]]*&&)' 15
  // src: vvaharness/skills/client-side/probe.sh:171-172
  scan("CLIENT-ONLY WRITE GATES / FORM VALIDATION (CWE-602)")
  // pattern and arguments, verbatim: "$CLIENT" '(disabled[[:space:]]*=|readOnly|readonly|type=["'"'"']hidden["'"'"']|maxLength|minLength|pattern=|[[:space:]]required[[:space:]>/]|step=["'"'"']|yup\.|zod|z\.object|Joi\.|useForm\()' 12
  // src: vvaharness/skills/client-side/probe.sh:174-175
  scan("CLIENT-SUPPLIED IDENTITY / AMOUNT -- client send (CWE-639)")
  // pattern and arguments, verbatim: "$CLIENT" '(user_?[iI]d|account_?[iI]d|tenant_?[iI]d|customer_?[iI]d|owner_?[iI]d|org_?[iI]d|is_?admin|[^a-zA-Z](amount|price|balance|quantity|discount|total)[[:space:]]*[:=][^=]|(role|is_?admin)[[:space:]]*[:=][[:space:]]*["'"'"']?(admin|superuser|owner|manager|staff|true))' 15
  // src: vvaharness/skills/client-side/probe.sh:177-178
  scan("SERVER READS THAT PARAMETER -- the actual defect (CWE-639)")
  // pattern and arguments, verbatim: "$SRV" '((get|\[)[[:space:]]*\(?["'"'"'](user_?id|account_?id|tenant_?id|customer_?id|owner_?id|role|is_?admin|amount|price|balance)["'"'"']|(body|query|params|payload)\.(userId|accountId|tenantId|role|isAdmin|amount|price))' 15
  // src: vvaharness/skills/client-side/probe.sh:180-181
  scan("REQUEST / TRANSPORT CONFIG (CWE-942, CWE-319)")
  // pattern and arguments, verbatim: "$CLIENT $CFG" '(mode:[[:space:]]*["'"'"']no-cors|credentials:[[:space:]]*["'"'"']include|withCredentials|Access-Control-Allow-Origin|Allow-Credentials|rejectUnauthorized|NODE_TLS_REJECT_UNAUTHORIZED|window\.location\.(hostname|protocol|host)|"proxy"[[:space:]]*:|setupProxy|http://[a-zA-Z0-9.-]+)' 15
  // src: vvaharness/skills/client-side/probe.sh:183-184
  scan("OPEN REDIRECT (CWE-601)")
  // pattern and arguments, verbatim: "$CLIENT" '((location\.href|location\.replace|location\.assign|navigate\(|router\.(push|replace)\(|window\.open\()[^;]*(next|returnUrl|return_to|redirect|continue|callback|from|target|url)|http-equiv=["'"'"']refresh)' 12
  // src: vvaharness/skills/client-side/probe.sh:186-187
  scan("DEPENDENCY PINS with versions (CWE-1104, CWE-1395)")
  // pattern and arguments, verbatim: '--include=package.json --include=bower.json' '"[@a-zA-Z0-9._/-]+"[[:space:]]*:[[:space:]]*"[~^>=<* ]*[0-9x]' 40
  // src: vvaharness/skills/client-side/probe.sh:189-190
  scan("EXTERNAL SCRIPTS / SRI (CWE-353)")
  // pattern and arguments, verbatim: "$TPL $JS" '(<script[^>]*src=["'"'"'](https?:)?//|<link[^>]*href=["'"'"']https?://|integrity=|crossorigin=)' 12
  // src: vvaharness/skills/client-side/probe.sh:192-193
  scan("PUBLIC-BY-DESIGN KEYS -- refutation evidence")
  // pattern and arguments, verbatim: "$CLIENT $CFG" '(pk_live_|pk_test_|firebaseConfig|authDomain|messagingSenderId|ingest\.sentry\.io|sentry.{0,10}[dD][sS][nN]|maps\.googleapis\.com|recaptcha|VITE_PUBLIC|NEXT_PUBLIC_(SITE|URL|BASE))' 10
  // src: vvaharness/skills/client-side/probe.sh:195-196
  scan("SANITIZERS / SAFE SINKS PRESENT -- refutation evidence")
  // pattern and arguments, verbatim: "$CLIENT" '(DOMPurify|sanitize-?[hH]tml|sanitizeHtml|\bxss\(|escapeHtml|escape\(|textContent|innerText|encodeURIComponent|DomSanitizer|helmet|CSP|Content-Security-Policy)' 15

  // src: vvaharness/skills/client-side/probe.sh:198-199
  print "== END OF PROBE =="; exit 0
}
