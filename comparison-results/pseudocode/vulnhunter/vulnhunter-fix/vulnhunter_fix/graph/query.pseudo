// file: vulnhunter-fix/vulnhunter_fix/graph/query.py
// Graph query API used by Plan / Implement / Verify / Sweep: blast_radius, god_nodes, context_for_file,
// changed_impact, co_changes, status, plus callers_of / callees_of / reachable_from (grep backend degrades).

@executedBy(CODE) @role(tool) @stage("fix")
class Query {

    GraphDocument loadGraph(Path cachePath, Theta θ) {
        return Schema.fromDict(Json.parse(cachePath.readText()), θ);                 // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:36
    }
}

@executedBy(CODE) @role(tool) @stage("fix")
class GraphQuery {
    // state: doc, sourceRoot (defaults to doc.rootDir), byFile: file -> node ids, outEdges / inEdges: id -> (id, kind)

    void init(GraphDocument doc, Path sourceRoot) {
        this.sourceRoot = sourceRoot != null ? sourceRoot.resolve() : Path(doc.rootDir).resolve(); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:44
        for (String nid : doc.nodes.keys()) byFile[doc.nodes[nid].file].add(nid);    // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:46
        for (Edge e : doc.edges) {                                                   // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:50
            outEdges[e.src].add(e.dst, e.kind);                                      // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:51
            inEdges[e.dst].add(e.src, e.kind);                                       // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:52
        }
    }

    Map status() {
        return Map.of("backend", doc.backend, "confidence", doc.confidence, "graphify_version", doc.graphifyVersion,
                      "schema_version", doc.schemaVersion, "content_hash", doc.contentHash,
                      "node_count", doc.nodes.size(), "edge_count", doc.edges.size()); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:57
    }

    Map contextForFile(String file) {
        List<String> ids = byFile.getOrDefault(file, List.of());                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:68
        return Map.of("confidence", doc.confidence, "file", file, "nodes", ids.map(n -> doc.nodes[n].name),
                      "imports", ids.flatMap(n -> outEdges[n]).filter(k -> k == "imports"),
                      "importers", ids.flatMap(n -> inEdges[n]).filter(k -> k == "imports")); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:69
    }

    String resolveFileKey(String ref) {
        if (byFile.containsKey(ref)) return ref;                                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:86
        String head = ref.rpartition(":")[0];                                        // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:88
        if (!head.isEmpty() && byFile.containsKey(head)) return head;                // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:89
        return ref;                                                                  // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:91
    }

    Map blastRadius(String file, Theta θ) {
        int maxDepth = θ["code.vulnhunter_fix.graph.query.blast_radius_max_depth"];  // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:93
        file = resolveFileKey(file);                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:94
        Set<String> seen = new Set();
        Deque<Pair<String, Integer>> frontier = new Deque();
        for (String nid : byFile.getOrDefault(file, List.of())) frontier.add(nid, 0); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:97
        Set<String> resultFiles = new Set();
        while (!frontier.isEmpty()) {                                                // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:100
            Pair<String, Integer> cur = frontier.popLeft();                          // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:101
            if (seen.contains(cur.id) || cur.depth > maxDepth) continue;             // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:102
            seen.add(cur.id);
            Node node = doc.nodes.get(cur.id);
            if (node != null) resultFiles.add(node.file);                            // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:106
            for (String src : inEdges.getOrDefault(cur.id, List.of())) frontier.add(src, cur.depth + 1); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:108 (reverse edges of any kind)
        }
        resultFiles.remove(file);                                                    // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:110
        return Map.of("confidence", doc.confidence, "file", file, "reachable_files", resultFiles.sorted()); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:111
    }

    List<Map> godNodes(Theta θ) {
        int topN = θ["code.vulnhunter_fix.graph.query.god_nodes_top_n"];             // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:113
        Counter<String> degrees = new Counter();
        for (String nid : doc.nodes.keys()) degrees[nid] = outEdges[nid].size() + inEdges[nid].size(); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:116
        return degrees.mostCommon(topN).filter(nid -> doc.nodes.containsKey(nid))
                      .map(nid -> Map.of("id", nid, "name", doc.nodes[nid].name, "file", doc.nodes[nid].file, "degree", degrees[nid])); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:117
    }

    Map changedImpact(List<String> filesChanged, Theta θ) {
        Set<String> impacted = new Set();
        for (String f : filesChanged) impacted.addAll(blastRadius(f, θ).reachable_files); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:131
        return Map.of("confidence", doc.confidence, "files_changed", filesChanged.distinct().sorted(), "impacted_files", impacted.sorted()); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:133
    }

    List<String> coChanges(String file, Theta θ) {
        // placeholder: structural neighbours stand in for git co-change history
        return blastRadius(file, θ).reachable_files.subList(0, θ["code.vulnhunter_fix.graph.query.co_changes_cutoff"]); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:146
    }

    List<String> callersOf(String symbol, Theta θ) {
        if (doc.backend == "grep") return Fallback.grepCallersOf(sourceRoot, symbol.split(":", 1).last(), θ); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:158
        Set<String> results = new Set();
        for (String tid : matchSymbol(symbol)) {                                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:163
            for (Pair<String, String> in : inEdges.getOrDefault(tid, List.of())) {   // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:164
                if (in.kind != "calls") continue;                                    // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:165
                Node s = doc.nodes.get(in.id);
                if (s != null) results.add(s.file + ":" + s.name);                   // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:169
            }
        }
        return results.sorted();                                                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:170
    }

    List<String> calleesOf(String symbol) {
        if (doc.backend == "grep") return List.of();                                 // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:173
        Set<String> results = new Set();
        for (String tid : matchSymbol(symbol)) {                                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:177
            for (Pair<String, String> out : outEdges.getOrDefault(tid, List.of())) { // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:178
                if (out.kind != "calls") continue;                                   // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:179
                Node d = doc.nodes.get(out.id);
                if (d != null) results.add(d.file + ":" + d.name);                   // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:183
            }
        }
        return results.sorted();                                                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:184
    }

    boolean reachableFrom(String inputFile, int inputLine, String sinkSymbol) {
        if (doc.backend == "grep") return false;                                     // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:193 (callers must not gate on low confidence)
        Set<String> sinkIds = Set.of(matchSymbol(sinkSymbol));                       // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:195
        if (sinkIds.isEmpty()) return false;                                         // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:196
        String enclosing = symbolAtLine(inputFile, inputLine);                       // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:202
        List<String> entryIds = enclosing != null ? List.of(enclosing) : byFile.getOrDefault(inputFile, List.of()); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:203
        Set<String> seen = new Set();
        Deque<String> frontier = new Deque(entryIds);
        while (!frontier.isEmpty()) {                                                // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:209
            String nid = frontier.popLeft();
            if (seen.contains(nid)) continue;                                        // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:211
            seen.add(nid);
            if (sinkIds.contains(nid)) return true;                                  // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:214
            for (Pair<String, String> out : outEdges.getOrDefault(nid, List.of())) {
                if (out.kind == "calls") frontier.add(out.id);                       // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:217 (unbounded depth)
            }
        }
        return false;                                                                // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:219
    }

    String symbolAtLine(String file, int line) {
        // nearest preceding definition line in the file
        String best = null;
        int bestLine = -1;
        for (String nid : byFile.getOrDefault(file, List.of())) {                    // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:234
            Node n = doc.nodes.get(nid);
            if (n != null && n.line <= line && n.line > bestLine) { best = nid; bestLine = n.line; } // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:236
        }
        return best;                                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:239
    }

    List<String> matchSymbol(String symbol) {
        if (symbol.contains(":")) {                                                  // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:242
            if (doc.nodes.containsKey(symbol)) return List.of(symbol);               // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:243
            List<String> byQual = doc.nodes.filter(n -> n.qualifiedName == symbol).ids(); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:249
            if (!byQual.isEmpty()) return byQual;                                    // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:251
            String file = symbol.rpartition(":")[0];
            String tail = symbol.rpartition(":")[2];                                 // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:255
            if (!file.isEmpty() && tail.isDigit()) {                                 // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:256
                String nid = symbolAtLine(file, int(tail));                          // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:257
                return nid != null ? List.of(nid) : List.of();                       // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:258
            }
            if (!file.isEmpty() && !tail.isEmpty()) {                                // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:262
                List<String> scoped = doc.nodes.filter(n -> n.name == tail && n.file == file).ids(); // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:263
                if (!scoped.isEmpty()) return scoped;                                // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:265
            }
            return List.of();                                                        // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:267
        }
        return doc.nodes.filter(n -> n.name == symbol).ids();                        // src: vulnhunter-fix/vulnhunter_fix/graph/query.py:268 (bare name matches every same-named symbol)
    }
}
