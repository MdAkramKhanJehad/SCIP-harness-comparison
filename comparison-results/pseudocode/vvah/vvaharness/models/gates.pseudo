    // name: OPEN vocabulary, any name is legal                                                     // src: vvaharness/models/gates.py:49

    GateStatus statusDefault() {
        return θ["code.models.gates.default_gate_status"];  // a gate with no status reads as INVALID // src: vvaharness/models/gates.py:50
