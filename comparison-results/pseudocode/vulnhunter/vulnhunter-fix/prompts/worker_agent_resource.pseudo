// file: vulnhunter-fix/prompts/worker_agent_resource.md
// CWE-class worker prompt for resource findings (CWE-117/200/362/400/532); extends the common preamble with
// per-CWE fix patterns, pre/post discrimination, FULL-tier bar, anti-pattern downgrades and residual template.

@executedBy(MODEL) @role(prompt) @stage("fix.implement.worker")
class WorkerAgentResource {

    WorkerResult run(Manifest manifest, Theta θ) {
        // extends worker_agent_common.md (read that file first)
        return WorkerAgentCommon.run(manifest, prompt(θ), θ);                                       // src: vulnhunter-fix/prompts/worker_agent_resource.md:3
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.worker_agent_resource.class_scope"]);                                        // src: vulnhunter-fix/prompts/worker_agent_resource.md:7
        p.rule(θ["p.worker_agent_resource.fix_cwe117"]);                                            // src: vulnhunter-fix/prompts/worker_agent_resource.md:13
        p.rule(θ["p.worker_agent_resource.fix_cwe200"]);                                            // src: vulnhunter-fix/prompts/worker_agent_resource.md:14
        p.rule(θ["p.worker_agent_resource.fix_cwe362"]);                                            // src: vulnhunter-fix/prompts/worker_agent_resource.md:15
        p.rule(θ["p.worker_agent_resource.fix_cwe400"]);                                            // src: vulnhunter-fix/prompts/worker_agent_resource.md:16
        p.rule(θ["p.worker_agent_resource.fix_cwe532"]);                                            // src: vulnhunter-fix/prompts/worker_agent_resource.md:17
        p.must(θ["p.worker_agent_resource.discrimination_pre_post"]);                               // src: vulnhunter-fix/prompts/worker_agent_resource.md:21
        p.checklist(θ["p.worker_agent_resource.full_correct_layer"]);                               // src: vulnhunter-fix/prompts/worker_agent_resource.md:30
        p.checklist(θ["p.worker_agent_resource.full_no_unbounded_fallback"]);                       // src: vulnhunter-fix/prompts/worker_agent_resource.md:31
        p.checklist(θ["p.worker_agent_resource.full_observed_pre_fix"]);                            // src: vulnhunter-fix/prompts/worker_agent_resource.md:33
        p.rule(θ["p.worker_agent_resource.anti_service_wide_limit"]);                               // src: vulnhunter-fix/prompts/worker_agent_resource.md:38
        p.rule(θ["p.worker_agent_resource.anti_field_renamed"]);                                    // src: vulnhunter-fix/prompts/worker_agent_resource.md:40
        p.rule(θ["p.worker_agent_resource.anti_catch_race_exception"]);                             // src: vulnhunter-fix/prompts/worker_agent_resource.md:41
        p.rule(θ["p.worker_agent_resource.anti_log_no_throttle"]);                                  // src: vulnhunter-fix/prompts/worker_agent_resource.md:43
        p.format(θ["p.worker_agent_resource.residual_template"]);                                   // src: vulnhunter-fix/prompts/worker_agent_resource.md:48
        return p;
    }

    void applyCanonicalFix(Finding f, Theta θ) {
        switch (f.cwe) {
            case "CWE-117": apply(θ["p.worker_agent_resource.fix_cwe117"]); break;                  // src: vulnhunter-fix/prompts/worker_agent_resource.md:13
            case "CWE-200": apply(θ["p.worker_agent_resource.fix_cwe200"]); break;                  // src: vulnhunter-fix/prompts/worker_agent_resource.md:14
            case "CWE-362": apply(θ["p.worker_agent_resource.fix_cwe362"]); break;                  // src: vulnhunter-fix/prompts/worker_agent_resource.md:15
            case "CWE-400": apply(θ["p.worker_agent_resource.fix_cwe400"]); break;                  // src: vulnhunter-fix/prompts/worker_agent_resource.md:16
            case "CWE-532": apply(θ["p.worker_agent_resource.fix_cwe532"]); break;                  // src: vulnhunter-fix/prompts/worker_agent_resource.md:17
        }
    }

    Discrimination discriminate(Finding f, Theta θ) {
        Discrimination d = new Discrimination();
        if (θ["p.worker_agent_resource.discrimination_pre_post"]) {                                 // src: vulnhunter-fix/prompts/worker_agent_resource.md:21
            d.preFix = (exhaustionSucceeds(f) || sensitiveFieldPresent(f)) ? "fail" : "pass";
            d.postFix = (rejectedWithBoundedError(f) || fieldAbsent(f)) ? "pass" : "fail";         // src: vulnhunter-fix/prompts/worker_agent_resource.md:23
        }
        return d;
    }

    String tier(Finding f, Diff diff, Discrimination d, Theta θ) {
        boolean layer = θ["p.worker_agent_resource.full_correct_layer"] && diff.boundAtSink();      // src: vulnhunter-fix/prompts/worker_agent_resource.md:30
        boolean noFallback = θ["p.worker_agent_resource.full_no_unbounded_fallback"] && !diff.allowThroughOnLimitFailure(); // src: vulnhunter-fix/prompts/worker_agent_resource.md:31
        boolean observed = θ["p.worker_agent_resource.full_observed_pre_fix"] && d.observedPreFix(); // src: vulnhunter-fix/prompts/worker_agent_resource.md:33
        String t = (layer && noFallback && observed) ? "FULL" : "MITIGATION";   // "allow through" fallback is automatic MITIGATION; other failures unclear
        if (diff.serviceWideLimit()) t = θ["p.worker_agent_resource.anti_service_wide_limit"];      // src: vulnhunter-fix/prompts/worker_agent_resource.md:38
        if (diff.logFieldRenamedRecordStillEmitted()) t = θ["p.worker_agent_resource.anti_field_renamed"]; // src: vulnhunter-fix/prompts/worker_agent_resource.md:40
        if (f.cwe == "CWE-362" && diff.catchesRaceExceptionOnly()) t = θ["p.worker_agent_resource.anti_catch_race_exception"]; // src: vulnhunter-fix/prompts/worker_agent_resource.md:41
        if (f.cwe == "CWE-400" && diff.logsWithoutThrottle()) t = θ["p.worker_agent_resource.anti_log_no_throttle"]; // src: vulnhunter-fix/prompts/worker_agent_resource.md:43
        return t;
    }

    List<String> residuals(String tier, Theta θ) {
        if (tier == "FULL") return List.of();
        return List.of(θ["p.worker_agent_resource.residual_template"].with("<resource-name>", "<specific unbounded path>")); // src: vulnhunter-fix/prompts/worker_agent_resource.md:48
    }
}
