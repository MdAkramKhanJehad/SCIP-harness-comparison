# vvaharness/models/vocab.py

The closed enumerations and open labels the pipeline branches on: severity, weakness class, remediation and validation outcomes, gate status, case state, merge readiness, and the gate name lists. Several enumerations resolve an unknown value to a fail-closed member instead of raising.

Source: `vvaharness/models/vocab.py` (lines 1-205)
Executor: code
Called from: every model module and every stage that reads severity, gate or remediation labels (re-exported by `vvaharness/models/__init__.py`)

// src: vvaharness/models/vocab.py:40-44
fn _fold(value):executor=code {
  if (value is not a string) return null
  return value stripped, casefolded, with "-" and " " replaced by "_"
}

// src: vvaharness/models/vocab.py:47-60
// Kept as a (str, Enum), not StrEnum, because report code interpolates the members.
Severity {
  value: "critical" | "high" | "medium" | "low" | "info"   // CRITICAL, HIGH, MEDIUM, LOW, INFO, in this order
  // coercion: an unknown value is folded with _fold and matched against the member values (so "Medium" resolves);
  // no match => null, so construction raises
}

// src: vvaharness/models/vocab.py:63-64
SEV_RANK = { Severity member: its position in declaration order }   // 0 = most severe: critical=0, high=1, medium=2, low=3, info=4

// src: vvaharness/models/vocab.py:67-73
OFFENSIVE_LABELS = {
  "P1": "Externally Exploitable, No Auth",
  "P2": "Externally Exploitable, Obtainable Auth",
  "P3": "Internal Network / Privileged Position",
  "P4": "Code-Knowledge / Insider Dependent"
}

// src: vvaharness/models/vocab.py:76-101
VulnClass {
  value: "use-after-free" | "heap-overflow" | "stack-overflow" | "format-string" | "integer-overflow"
       | "type-confusion" | "race-condition" | "injection" | "unsafe-deserialization" | "logic-flaw"
       | "info-leak" | "other"
  // members: UAF, HEAP_OVERFLOW, STACK_OVERFLOW, FMT_STRING, INT_OVERFLOW, TYPE_CONFUSION, RACE, INJECTION,
  //          DESERIALIZATION, LOGIC, INFO_LEAK, OTHER
  // coercion (never raises): non-string => OTHER; folded value equal to a member value with "-" read as "_" => that member;
  // otherwise OTHER (the original label is kept by the Finding in vuln_class_label)
}

// src: vvaharness/models/vocab.py:104-111
RemediationKind { value: "edits_applied" | "diff_proposed" | "pull_request" | "no_action" | "already_resolved" }

// src: vvaharness/models/vocab.py:114-122
RemediationOutcome { value: "fixed" | "partially_fixed" | "not_fixed" | "false_positive" | "needs_review" | "denied" }

// src: vvaharness/models/vocab.py:125-131
Disposition { value: "false_positive" | "policy_denied" | "accepted_risk" | "not_applicable" }

// src: vvaharness/models/vocab.py:134-148
Decision {
  value: "fixed" | "partially_fixed" | "not_fixed" | "inconclusive"
  // coercion, fail closed: non-string => INCONCLUSIVE; folded match => that member; otherwise INCONCLUSIVE (no alias for retired values)
}

// src: vvaharness/models/vocab.py:151-166
GateStatus {
  value: "pass" | "partial" | "fail" | "skip" | "invalid"   // INVALID is harness-only; it scores as failure and is never dropped
  // coercion, fail closed: non-string => INVALID; folded match => that member; otherwise INVALID
}

// src: vvaharness/models/vocab.py:169-177
CaseState {
  value: "open" | "remediated" | "validated" | "failed" | "declined" | "pending"
  // never set by an engine and never stored; derive.state_of computes it (docstring; enforced by FindingCase dropping an input "state")
}

// src: vvaharness/models/vocab.py:180-185
MergeReadiness { value: "ready" | "ready_with_conditions" | "not_ready" }   // owned by whoever runs the scan, not by the engine

// src: vvaharness/models/vocab.py:188-200
EVIDENCE_GATES = ["source", "sink", "missing_control"]   // asserted by a remediator before patching
FIX_VALIDATION_GATES = ["root_cause", "instance_coverage", "no_new_vulnerabilities", "security_best_practices"]   // scored by the bundled fix-validation panel
CANONICAL_GATE_NAMES = EVIDENCE_GATES + FIX_VALIDATION_GATES   // documented, not enforced: gate names are an open vocabulary

// src: vvaharness/models/vocab.py:203-205
fn normalise_gate_name(value):executor=code {
  return _fold(value) || ""   // an unknown name passes through; never rejected
}
