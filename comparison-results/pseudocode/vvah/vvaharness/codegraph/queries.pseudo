// file: vvaharness/codegraph/queries.py
// S1: deterministic ContextPackage fields from the built graph via Cypher: modules (communities -> files),
// primary language, and a one-line system-context note.

@executedBy(CODE) @role(step) @stage("S1")
class Queries {
    String COMMUNITY_FILES_QUERY = θ["code.codegraph.queries.community_files_query"]; // src: vvaharness/codegraph/queries.py:23
    String LANGUAGE_COUNTS_QUERY = θ["code.codegraph.queries.language_counts_query"]; // src: vvaharness/codegraph/queries.py:29
    Map COUNT_QUERIES = θ["code.codegraph.queries.count_queries"]; // src: vvaharness/codegraph/queries.py:36


    // _COMMUNITY_FILES_QUERY: (fn)-[:MEMBER_OF]->(c:Community), (file:File)-[:DEFINES]->(fn) -> community, file path. src: vvaharness/codegraph/queries.py:23
    // _LANGUAGE_COUNTS_QUERY: File.language non-empty, count per language, descending. src: vvaharness/codegraph/queries.py:29
    // _COUNT_QUERIES: counts of File, Function and Community nodes. src: vvaharness/codegraph/queries.py:36

    /** Community name -> its member functions' file paths (graph-relative, deduped, first-seen order). */
    Map<String, List<String>> communitiesAsModules(GraphHandle handle) {
        Map<String, List<String>> modules = new Map();
        for (Row row : handle.graph.cypher(COMMUNITY_FILES_QUERY).rows) {                         // src: vvaharness/codegraph/queries.py:46
            Object name = row.get("community"); Object path = row.get("path");                    // src: vvaharness/codegraph/queries.py:48
            if (!(name instanceof String) || !(path instanceof String)) continue;                 // src: vvaharness/codegraph/queries.py:49
            modules.putIfAbsent(name, new List());                                                // src: vvaharness/codegraph/queries.py:51
            if (!modules.get(name).contains(path)) modules.get(name).add(path);                   // src: vvaharness/codegraph/queries.py:52
        }
        return modules;
    }

    /** Most common non-empty File.language, or null on an empty graph. */
    String primaryLanguage(GraphHandle handle) {
        List<Row> rows = handle.graph.cypher(LANGUAGE_COUNTS_QUERY).rows;                         // src: vvaharness/codegraph/queries.py:59
        if (rows.isEmpty()) return null;                                                          // src: vvaharness/codegraph/queries.py:60
        Object language = rows.get(0).get("language");                                            // src: vvaharness/codegraph/queries.py:62
        return (language instanceof String) ? language : null;                                    // src: vvaharness/codegraph/queries.py:63
    }

    int intCount(GraphHandle handle, String query) {
        List<Row> rows = handle.graph.cypher(query).rows;                                         // src: vvaharness/codegraph/queries.py:67
        if (rows.isEmpty()) return 0;                                                             // src: vvaharness/codegraph/queries.py:68
        Object n = rows.get(0).get("n");                                                          // src: vvaharness/codegraph/queries.py:70
        return (n instanceof Integer) ? n : 0;                                                    // src: vvaharness/codegraph/queries.py:71
    }

    /** One-line summary: N files (top languages), N functions, N communities. Fed to S2 as s1 notes. */
    String systemContextNotes(GraphHandle handle, Theta θ) {
        Map<String, Integer> counts = COUNT_QUERIES.mapValues(q -> intCount(handle, q));          // src: vvaharness/codegraph/queries.py:76
        List<String> languages = handle.graph.cypher(LANGUAGE_COUNTS_QUERY).rows.map(r -> r.get("language")).filter(l -> l instanceof String); // src: vvaharness/codegraph/queries.py:77
        String langStr = join(", ", languages.head(θ["code.codegraph.queries.notes_max_languages"])); // src: vvaharness/codegraph/queries.py:81
        if (langStr.isEmpty()) langStr = "unknown";
        return counts.get("files") + " files (" + langStr + "), " + counts.get("functions") + " functions, " + counts.get("communities") + " communities."; // src: vvaharness/codegraph/queries.py:82
    }
}
