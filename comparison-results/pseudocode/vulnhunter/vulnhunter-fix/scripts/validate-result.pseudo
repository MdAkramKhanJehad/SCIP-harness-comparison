// file: vulnhunter-fix/scripts/validate-result.py
// Validates a worker result.json against references/result-schema.json; used at every phase handoff and by the schema-repair loop (REQ-SCH-003/004).

@executedBy(CODE) @role(evaluation) @stage("fix")
class ValidateResult {

    // callers use run(path); returns ok plus the exit code
    Map run(String path) {
        int rc = validateFile(path);
        return Map.of("ok", rc == 0, "rc", rc);
    }

    int validateFile(String path) {
        Map schema = Json.parse(Files.read(skillRoot().join("references", "result-schema.json")));            // src: vulnhunter-fix/scripts/validate-result.py:37
        Draft202012Validator.checkSchema(schema);
        Object payload;
        try {
            payload = Json.parse(Files.read(path));                                                           // src: vulnhunter-fix/scripts/validate-result.py:41
        } catch (OSError e) {
            return 2;                                                                                         // src: vulnhunter-fix/scripts/validate-result.py:44
        } catch (JSONDecodeError e) {
            return 3;                                                                                         // src: vulnhunter-fix/scripts/validate-result.py:49
        }
        Validator v = Draft202012Validator.of(schema);                                                        // src: vulnhunter-fix/scripts/validate-result.py:52
        List<Error> errors = v.iterErrors(payload).sortedBy(e -> e.absolutePath);                             // src: vulnhunter-fix/scripts/validate-result.py:53
        if (errors.isEmpty()) return 0;                                                                       // src: vulnhunter-fix/scripts/validate-result.py:55
        return 1;                                                                                             // src: vulnhunter-fix/scripts/validate-result.py:59
    }

    int main(List<String> argv) {
        if (argv.size() != 2) return 64;                                                                      // src: vulnhunter-fix/scripts/validate-result.py:65
        return validateFile(argv.get(1));
    }
}
