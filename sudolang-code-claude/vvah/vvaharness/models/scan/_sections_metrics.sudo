# vvaharness/models/scan/_sections_metrics.py

Report sections built from `ScanMetrics`: Scan Metrics (with tokens by phase and language coverage), the Verification funnel, Scan Health (coverage loss, degradation, relented evidence gates, unranked findings), and the scan-scope appendix.

Source: `vvaharness/models/scan/_sections_metrics.py` (lines 1-404)
Executor: code
Called from: `vvaharness/models/scan/report.py` (FinalReport.to_markdown)

// src: vvaharness/models/scan/_sections_metrics.py:37-95
fn _render_metrics(report, unreachable_appendix=true):executor=code {
  emit "## Scan Metrics": Scan ID, Module, Start, End, Duration (sec), Files in scope, Files analyzed (unique),
       "Coverage: <coverage_pct to 1 decimal>% (files analyzed / files in scope)", _render_chunk_kind_line(report),
       token counts (null => "unavailable")
  if (folders_scanned) emit "- Folders scanned: N"
  emit _render_pipeline_diagnostics(report, unreachable_appendix)   // see _sections_pipeline.sudo
  if (tokens_by_phase) emit "### Tokens by Phase" table, rows sorted by prompt+completion descending; phase "unlabeled"/"unscoped" shown as "unscoped (outside stage wrapper)";
     "_Prompt = fresh + cache-write (billable). Cache-read shown separately, NOT included in totals._"
  if (loc_in_scope_by_language) emit "### Language LOC Coverage" table sorted by language; percentage = scanned / in scope * 100 (0.0 when in scope is 0)
}

// src: vvaharness/models/scan/_sections_metrics.py:97-153
fn _render_verification(report, posture_channel=true):executor=code {
  by_reason = count of dropped by reason
  verr = report._undetermined_drop_count()   // undetermined verifications are not false positives; counted apart
  reverify_dropped = count of dropped where reason != "DUPLICATE" && chunk_id ends with "+s6"   // verifier-discovered rows
  dup_pre = count of DUPLICATE drops with canonical_idx == null   // Stage 5 pre-verification collapse
  [verified_tp, verified_fp] = report._verified_tp_fp()
  rate = if (tp + fp) "<tp / (tp + fp) * 100 to 1 decimal>%" else "n/a (no TRUE_POSITIVE/FALSE_POSITIVE verdicts)"
  n_posture = if (posture_channel) count of posture findings else 0
  emit "## Verification", "- Raw findings (pre-verification): <raw_findings_count>",
       "- Verified true positives: $verified_tp → <length(findings)> reported after dedup[ (A application-defect + P posture)]"
  if (discovered + clones) emit "  - of which D verifier-discovered and C repeat-site clone(s) — minted during verification, so not in the raw count"   // omitted at 0
  emit "- False positives (dropped): <FALSE_POSITIVE>", "- Unconfirmed (dropped — verifier confidence below the gate): <UNCONFIRMED>",
       "- Verifier errors or inconclusive (excluded — undetermined, not confirmed clean): $verr"
  if (reverify_dropped) emit "- Verifier-discovered findings dropped on re-verify (inside the three dropped counts above, not in the raw count): N"
  emit "- Duplicates collapsed (all passes): <DUPLICATE> — $dup_pre before verification, <rest> after", "- Verifier confirmation rate: $rate",
       "  - True positives as a share of the verifier's true- and false-positive verdicts on candidates the harness itself produced; the harness grading its own findings, not precision against ground truth."
  emit _ev_lines(report)
}

// src: vvaharness/models/scan/_sections_metrics.py:156-180
fn _ev_lines(report):executor=code {
  counts over reported findings' ev_status: confirmed, not confirmed, inconclusive; tested = sum
  if (tested) emit "- Exploit verification: C confirmed live, N not confirmed, I requiring review (T live-tested)", "  - <_EV_POSITIVE_ONLY_NOTE>"
  if (metrics.ev_rescued_count) emit "- Kept without a true-positive verdict (exploit-verified live, dropped by the static verifier): N"   // not gated on tested
}

// src: vvaharness/models/scan/_sections_metrics.py:183-206
_RELENT_STAGES = [["s2", "S2 threat model"], ["s4", "S4 deep-dive"], ["s6", "S6 verification"]]
fn _relent_lines(m):executor=code {
  for each [prefix, label] where m.<prefix>_evidence_gate_rejected_relented > 0 {
    emit "- ⚠️ $label proceeded without graph-tool evidence after <rejected> rejected attempt(s) (`<prefix>_evidence_gate_rejected_relented`=N)."
  }
}

// src: vvaharness/models/scan/_sections_metrics.py:209-220
fn _unranked_lines(report):executor=code {
  [ranked, by_design, feeder_missed] = report.unranked_split()
  if (!(by_design || feeder_missed)) return []
  return "- S8 ranked $ranked of <total> finding(s)[; $by_design omitted by design (no chain role)][; $feeder_missed feed a chain step but got no entry]."
}

// src: vvaharness/models/scan/_sections_metrics.py:223-268
fn _render_scan_health(report):executor=code {
  hollow = report.is_hollow(); coverage = report.coverage_degraded(); failed = metrics.chunks_failed; errs = metrics.errors_by_stage
  if (!(report.degraded || failed || errs || hollow || coverage || relents || unranked || metrics.deepdive_skipped)) return []   // section omitted when healthy
  emit "## Scan Health"
  if (deepdive_skipped) emit "- External findings supplied; S4 deep-dive intentionally skipped. No deep-dive coverage is claimed; downstream verification is separate."
  if (hollow) emit "- ⚠️ **Hollow scan** — analysis completed but the threat-model pass produced no usable threats on a non-empty repository; coverage and ranking for this scan may be understated."
  emit _coverage_degraded_lines(report, coverage)
  if (degraded) emit "- ⚠️ **DEGRADED** — <degraded_reason or (no reason recorded)>"
  if (failed) emit "- ⚠️ Degraded coverage: $failed/<chunks_attempted or chunks_total> deep-dive chunk(s) failed or timed out — their findings are absent from this report. (Unit count, not files; needn't match the file coverage % above.)"
  if (errs) emit "- Non-fatal errors logged by stage: <stage=n sorted>"
  emit relents, unranked; if (errors_log_path) emit "- Full error log: `<file name>`"
}

// src: vvaharness/models/scan/_sections_metrics.py:270-306
fn _coverage_degraded_lines(report, reasons):executor=code {
  if ("s6_undetermined" in reasons) {
    n = undetermined drops; total = n + verified tp + verified fp   // denominator is every verdict reached
    emit "- ⚠️ **Verification coverage loss** — $n of $total verdicts were undetermined (<percent>%); those findings are neither confirmed nor cleared."
  }
  if ("zero_analysis" in reasons) {
    source = if (deepdive_skipped) "from external input and downstream processing, not S4 deep-dive analysis"
             else if (every finding.origin == "detector") "from a deterministic detector, not a reviewed analysis"
             else "from detectors and the verifier's re-verify wave, not a reviewed analysis"
    emit "- ⚠️ **No file reached deep-dive analysis** — N file(s) were in scope but 0 were analysed (0% coverage), so every finding in this report comes $source."
  }
  if ("llm_turn_cap_exhausted" in reasons) emit "- ⚠️ **Turn budget exhausted** — N agentic session(s) exhausted their turn budget and were forced to answer from partial evidence. Their units still recorded outcome=completed: this discloses reduced depth, it does not mean those units failed."
}

// src: vvaharness/models/scan/_sections_metrics.py:308-404
fn _render_scope_appendix(report):executor=code {
  emit "## Appendix: Scan Scope"
  if (folders_scanned) emit "### Folders scanned (N)" with each folder escaped
  ex = metrics.excluded
  if (config_dedup.dropped || any of dirs, exts, globs, oversize, symlinks, symlink_targets) {
    emit "### Excluded from scan (<sum of all counts + config_dedup dropped> files)"
    // abstracted: one sub-list per kind, escaped; dirs, exts, globs and outside-repo symlinks sorted by count descending, excluded-target symlinks sorted by path, oversize files in recorded order:
    // folders (exclude_dirs), file types (exclude_exts), patterns (exclude_globs), oversize (> max_file_kb, with size in KB),
    // symlinks resolving outside the repository (not followed), symlinks whose target is excluded, and config dedup
    // ("candidates config files -> clusters shape-clusters; kept reps representatives + promoted promoted (suspicious value), dropped N near-duplicates", top clusters, promoted files with the matched rule)
  }
}
