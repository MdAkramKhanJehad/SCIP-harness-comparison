# vvaharness/orchestrator/case_rollup.py

Roll-up of remediation and validation outcomes. It defines the exit code for "nothing remediated validated as fixed", tallies the case records on disk per repository, and accumulates an invocation-wide total that the run manifest reports.

Source: `vvaharness/orchestrator/case_rollup.py` (lines 1-151)
Executor: code
Called from: `vvaharness/orchestrator/batch.py` (`EXIT_NOT_REMEDIATED`), `vvaharness/pipeline/stages/s11_validate.py` (`record`), `vvaharness/manifest.py` (`totals`), `vvaharness/validation/cli/_run.py` (`rc_for_verdicts`)

// src: vvaharness/orchestrator/case_rollup.py:49-56
EXIT_NOT_REMEDIATED = 3          // not 1 (harness broke) and not 2 (refused before spend)
_MAX_CASE_BYTES = 4 * 1024 * 1024   // a hostile pre-seeded security-remediation/ cannot make the reader load a gigabyte
_TOTALS = {}                     // process-wide accumulator

// src: vvaharness/orchestrator/case_rollup.py:59-65
fn rc_for_verdicts(verdicts):executor=code {
  states = verdict_state(v) for each non-null v
  if (CaseState.VALIDATED in states || CaseState.FAILED not in states) return 0
  return EXIT_NOT_REMEDIATED
  // a narrow AND-gate: exit 3 only when nothing validated AND at least one failed; merge readiness is left to the operator
}

// src: vvaharness/orchestrator/case_rollup.py:85-127
fn rollup_for(repo):executor=code {
  // counts cases ON DISK; deliberately not used for exit codes
  try case_root = artifacts.artifact_dir(repo, CASE_DIR_NAME);
  catch UnsafeArtifactDir => { warn CASE_ROOT_UNSAFE; return {} }
  if (case_root is not a directory) return {}
  // same glob as Stage 11 case discovery; deliberately not filtered by age
  for each path in case_root matching "*/" + CASE_FILE_NAME {
    try {
      if (path is not a regular file) continue   // a planted device node or FIFO is skipped
      if (path does not resolve inside case_root) { warn CASE_PATH_OUTSIDE_ROOT; continue }
      require size <= _MAX_CASE_BYTES => throw ValueError
      case = FindingCase.read(path)
      state = state_of(case.attempts)
      decision = last attempt's verdict.decision, or null when unvalidated
    }
    catch any error => { warn CASE_RECORD_UNREADABLE; continue }   // no case file may fail a finished tally
    cases += 1; states[state] += 1; if (decision) decisions[decision] += 1
  }
  if (cases == 0) return {}
  return { cases, states sorted by name, decisions sorted by name }
}

// src: vvaharness/orchestrator/case_rollup.py:130-151
fn record(repo):executor=code {
  rollup = rollup_for(repo)
  if (rollup) add rollup.cases, each state count and each decision count into _TOTALS
  return rollup
}
fn totals():executor=code { return if (_TOTALS empty) {} else { cases, states, decisions } from _TOTALS }
fn reset():executor=code { clear _TOTALS }   // test isolation
// preserved: batch.py resets many process-global registries per repository but not _TOTALS, so totals() is invocation-wide across a batch by design ("invocation-wide accumulator")
