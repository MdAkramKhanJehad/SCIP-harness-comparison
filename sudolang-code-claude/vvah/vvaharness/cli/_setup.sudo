// src: vvaharness/cli/_setup.py:121-215
fn _setup(rest):executor=code {
  cfg_path = _paths._config_path_from(rest)   // no trust gate: setup takes no --repo
  _prompt_for_remediation_inputs()
  checks = environment.run_checks(cfg_path); [n_ok, n_warn, n_blocking] = environment.summarize(checks)
  [prof, why] = environment.recommend_profile()   // printed with a scan command line
  if (check "via:sdk endpoint" failed) print ANTHROPIC_BASE_URL (detected gateway if found), SSL_CERT_FILE (detected certificate if found), CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 guidance
  _cache_advisory(cfg_path)
  if (".env" does not exist && "--write-env" in rest) write .env from .env.example plus detected ANTHROPIC_BASE_URL, SSL_CERT_FILE and NODE_EXTRA_CA_CERTS   // read-only unless --write-env
  if ("--install-agents" in rest) _install_agents()
  return if (n_blocking) 1 else 0
}

// src: vvaharness/cli/_setup.py:89-119
fn _install_agents():executor=code {
  put("./AGENTS.md", agentdoc.AGENT_DOC); put("./.github/copilot-instructions.md", agentdoc.AGENT_DOC)   // always
  if ("claude" on PATH) { put("./CLAUDE.md", AGENT_DOC); put("~/.claude/skills/vvaharness/SKILL.md", agentdoc.CLAUDE_SKILL) }
  if ("gemini" on PATH) put("./GEMINI.md", agentdoc.gemini_doc())
  return 0
}
// src: vvaharness/cli/_setup.py:96-108
fn put(path, content, anchor):executor=code {
  if (path exists) return   // never overwritten
  require !(POSIX && _symlinked_ancestor(path, anchor)) => return   // warns "refusing to write $path: $symlink is a symlink"
  create parent directories; write content
}

// src: vvaharness/cli/_setup.py:46-86
fn _cache_advisory(cfg_path):executor=code {
  // returns silently when the configuration fails to load (ConfigPolicyError, OSError, ValueError)
  // prints advice only when some role is via "sdk", cache markers are enabled, cache_route is not false/"none", and the SDK endpoint's cache route is unknown (markers withheld)
  // suggests "cache_route: anthropic" in config.local.yaml and "vvaharness doctor --cache-probe"
}

// src: vvaharness/cli/_setup.py:217-241
fn _prompt_for_remediation_inputs():executor=code {
  missing = remediation_agent.rule_paths.missing_rules(...)
  if (!missing || standard input is not a terminal) return
  loop {
    answer = ask "Path to the VVAH inputs directory (blank to skip): "; if (blank or end of input) return
    [directory, absent] = rule_paths.validate_inputs_dir(answer)
    if (absent) continue   // asks again
    rule_paths.save_inputs_dir(directory); return
  }
}

