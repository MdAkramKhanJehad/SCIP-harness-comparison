# vvaharness/remediation_agent/frameworks.py

Language detection per finding file and framework detection per repository. These are the keys the playbook resolves a fix strategy on.

Source: `vvaharness/remediation_agent/frameworks.py` (lines 1-82)
Executor: code
Called from: `policy/context.sudo` build_context (detect_frameworks); `policy/decide.sudo` pre_decision and `policy/patch_content.sudo` _is_executable_source (language_for)

// src: vvaharness/remediation_agent/frameworks.py:20-33 — language comes from the finding's OWN extension, so polyglot repositories work
_EXT_LANG {
  python: .py .pyi
  java: .java .kt .scala .groovy
  javascript: .js .jsx .mjs .ts .tsx
  csharp: .cs
  go: .go
  ruby: .rb
  php: .php
  c: .c .h
  cpp: .cc .cpp .cxx .hpp
  rust: .rs
}

// src: vvaharness/remediation_agent/frameworks.py:35-61 — manifest file name -> marker substring -> framework key
_MANIFESTS {
  "requirements.txt", "pyproject.toml": django, flask, sqlalchemy, fastapi
  "Pipfile": django, flask, sqlalchemy
  "package.json": "\"react\"" -> react, "\"next\"" -> react, "\"express\"" -> express, "\"vue\"" -> vue, "\"angular\"" -> angular
  "pom.xml": "spring-boot" -> spring, "<groupId>org.springframework" -> spring, "hibernate" -> hibernate
  "build.gradle": "org.springframework" -> spring, "spring-boot" -> spring
  "Gemfile": rails, sinatra
  "go.mod": "gin-gonic" -> gin, "gorilla/mux" -> gorilla
}

// src: vvaharness/remediation_agent/frameworks.py:64-66
fn language_for(file_path) = _EXT_LANG key for the lower-cased suffix of file_path, else "default"

// src: vvaharness/remediation_agent/frameworks.py:69-82
fn detect_frameworks(repo_root):executor=code {
  found = {}
  for each [fname, markers] in _MANIFESTS {
    for each p in (repo_root/fname) and (repo_root/*/fname) {   // the root and its immediate children only
      txt = lower-cased text of p (decode errors replaced); on OSError skip p
      for each [needle, fw] in markers { if (lower(needle) in txt) add fw to found }   // plain substring match
    }
  }
  return found
}
