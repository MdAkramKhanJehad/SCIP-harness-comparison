# vvaharness/pipeline/stages/s5/__init__.py

Stage 5 ("Step 5 — enrich and pre-filter"), deterministic, no model. Each Stage 4 finding passes a path gate, is re-anchored from a function header to its sink line, gets its code snippet and evidence references filled from disk, and passes a coordinate gate. Survivors are trivially deduplicated, then the zero-model detector pass adds rule matches that no kept finding already covers. Every removal is recorded as a DroppedFinding.

Source: `vvaharness/pipeline/stages/s5/__init__.py` (lines 1-119)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (Stage 5 block)

// src: vvaharness/pipeline/stages/s5/__init__.py:59-119
fn run(findings, ctx, cfg):executor=code {
  cache = s5.enrich.FileCache(ctx.repo_root, max_kb=knob("step1.max_file_kb", default=1024))
  valid_files = if (ctx.all_files) set(ctx.all_files) else null   // null: the inventory gate stands down
  anchors = entry_anchor_lines(ctx)              // external to this batch: pipeline/callgraph_consumer
  seeds = seed_paths_by_file(ctx.seed_taint_paths)
  tol = _line_tolerance(cfg)

  // src: :69-73
  reanchorer = null
  if (knob("step5_prefilter.sink_reanchor", default=true)) {
    reanchorer = s5.reanchor.Reanchorer(cache, s5.reanchor.sink_patterns_by_cwe(), knob("step5_prefilter.sink_reanchor_max_move_lines", default=40))
  }

  // src: :75-94
  keep = []; pre_anchor = []; dropped = []
  for each raw in findings {
    // path gate first: enrich and re-anchor read disk, so an out-of-inventory path must cause no I/O
    f = raw
    verdict = s5.gates.reject_path(raw, valid_files)
    if (verdict == null) {
      f = s5.enrich.enrich(raw, cache, anchors, seeds, reanchorer)
      verdict = s5.gates.reject(f, valid_files, cache.lines(f.file))
    }
    if (verdict == null) {
      f.pre_anchor_line = raw.line_start   // Stage 4's line, before re-anchoring
      keep += f; pre_anchor += raw.line_start
      continue
    }
    [reason, detail] = verdict
    COUNTERS.bump("s5_dropped_" + first word of detail, lowercased, "/" replaced by "_")
    dropped += _dropped(f, reason, detail)
  }

  // src: :96-97 — proximity is judged on Stage 4's PRE-re-anchor lines, so re-anchoring cannot collapse two distinct sinks
  [keep, dup_dropped] = s7_dedup.prefilter(keep, tol, pre_anchor)   // external to this batch: rendered in pipeline/stages/s7_dedup.sudo; collapses same-file, same-vuln_class or same-weakness findings within tol lines, no model call
  dropped += dup_dropped

  // src: :99-112 — the detector pass runs after re-anchor and prefilter, so its dedup sees post-re-anchor coordinates
  n_det = 0
  if (knob("step5_detectors.enabled", default=true)) {
    max_rows = knob("step5_detectors.max_rows", default=200)
    for each row in s5.detectors.run(keep, ctx, cache, tol, max_rows) {
      f = s5.enrich.enrich(row, cache, anchors, seeds)   // no re-anchorer: a detector row already sits on the statement its rule matched
      verdict = s5.gates.reject(f, valid_files, cache.lines(f.file))
      if (verdict == null) { keep += f; n_det += 1; continue }
      COUNTERS.bump("s5_det_rejected")
      dropped += _dropped(f, ...verdict)
    }
    // preserved: detector rows are appended after the prefilter, so they are never trivially deduplicated against each other here beyond detectors._dedup, and get no pre_anchor_line
  }
  // abstracted: :114-118 console and log summary of counts and drop reasons
  return [keep, dropped]
}

// src: vvaharness/pipeline/stages/s5/__init__.py:40-48
fn _line_tolerance(cfg):executor=code {
  // a profile's 0 (exact-line matching) is a real value, so test for null, not falsiness
  tol = knob("step5_prefilter.line_tolerance", default=null)
  if (tol == null) tol = knob("step7_dedup.line_tolerance", default=3)
  return tol as integer
}

// src: vvaharness/pipeline/stages/s5/__init__.py:34-37
fn _dropped(f, reason, detail):executor=code {
  return DroppedFinding(file=f.file, line=f.line_start, vuln_class, title, chunk_id, reason, detail)   // an audit-trail entry, so a removal is never silent
}

