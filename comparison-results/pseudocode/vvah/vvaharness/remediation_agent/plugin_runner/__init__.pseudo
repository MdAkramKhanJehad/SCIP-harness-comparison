            raw = LlmRegistry.agentic(user, cfg.models.remediate, tools, repo, θ["step_remediate.max_turns"], timeoutOf(sr, θ), RemediationAgentPrompts.system(θ), List.of(), null, null, Cli.streamTrace(verbose), null, θ); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:490
        }
