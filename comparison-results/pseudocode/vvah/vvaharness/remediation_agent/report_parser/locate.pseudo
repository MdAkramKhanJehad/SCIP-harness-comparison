// file: vvaharness/remediation_agent/report_parser/locate.py
// Artefact folder names (lock-step with the scan) and scan-report discovery.

@executedBy(CODE) @role(io) @stage("S10")
class ReportParserLocate {

    // Must stay in lock-step with out_dir = repo / "security-scan" in orchestrator.scan.scan_repo.
    String SCAN_DIR_NAME = "security-scan";                                                          // src: vvaharness/remediation_agent/report_parser/locate.py:21
    String REMEDIATION_DIR_NAME = "security-remediation";                                            // src: vvaharness/remediation_agent/report_parser/locate.py:22
    String REPORT_GLOB = θ["code.remediation_agent.report_parser.locate.report_glob"];               // src: vvaharness/remediation_agent/report_parser/locate.py:23

    Path findScanDir(Path repo) {
        Path scanDir = Path.of(repo).join(SCAN_DIR_NAME);                                            // src: vvaharness/remediation_agent/report_parser/locate.py:26
        return scanDir.isDir() ? scanDir : null;                                                     // src: vvaharness/remediation_agent/report_parser/locate.py:29
    }

    // The newest report: sorted by (file name, mtime) and the last taken, so the name dominates and mtime only breaks ties.
    Path latestReport(Path scanDir, Theta θ) {
        List<Path> reports = Path.of(scanDir).glob(θ["code.remediation_agent.report_parser.locate.report_glob"]).sortedBy(p -> Tuple.of(p.name, p.stat().mtime)); // src: vvaharness/remediation_agent/report_parser/locate.py:32
        return !reports.isEmpty() ? reports.last() : null;                                           // src: vvaharness/remediation_agent/report_parser/locate.py:38
    }
}
