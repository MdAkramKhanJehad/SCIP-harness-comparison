// file: harness/local_harness/batch/run.py
// Batch vulnhunt runner: validates GitHub URLs from REPO_LIST.txt, shallow-clones each, optionally skips repos
// with existing results (--resume), scans in parallel (read-only unless --execute), and prints a summary.

@executedBy(CODE) @role(pipeline) @stage("benchmark")
class Run {

    Pair<String, String> repoPartsFromUrl(String url) {
        String value = url.strip();                                                  // src: harness/local_harness/batch/run.py:38
        String path;
        if (!value.contains("://")) {                                                // src: harness/local_harness/batch/run.py:39
            Triple t = value.partition(":");
            if (t.sep.isEmpty() || t.host.rsplit("@").last().casefold() != "github.com") throw ValueError("expected a github.com repository URL"); // src: harness/local_harness/batch/run.py:41
            path = t.rest;
        } else {
            Url parsed = urlsplit(value);                                           // src: harness/local_harness/batch/run.py:44
            if (!Set.of("http", "https", "ssh", "git").contains(parsed.scheme)) throw ValueError("expected an HTTP(S), SSH, or git GitHub URL"); // src: harness/local_harness/batch/run.py:45
            if (!Set.of("github.com", "www.github.com").contains(parsed.hostname.casefold())) throw ValueError("expected a github.com repository URL"); // src: harness/local_harness/batch/run.py:47
            path = parsed.path;                                                      // src: harness/local_harness/batch/run.py:49
        }
        List<String> parts = path.rstrip("/").split("/").filter(p -> !p.isEmpty());  // src: harness/local_harness/batch/run.py:51
        if (parts.size() != 2) throw ValueError("expected ... OWNER/REPOSITORY");    // src: harness/local_harness/batch/run.py:52
        String owner = parts[0];
        String repo = parts[1].removeSuffix(".git");                                 // src: harness/local_harness/batch/run.py:56
        for (String c : List.of(owner, repo)) {
            if (Set.of("", ".", "..").contains(c) || !Regex.fullmatch("[A-Za-z0-9._-]+", c)) throw ValueError("repository path contains unsupported characters"); // src: harness/local_harness/batch/run.py:59
        }
        return new Pair(owner, repo);
    }

    String repoNameFromUrl(String url) {
        return repoPartsFromUrl(url).second;                                         // src: harness/local_harness/batch/run.py:69
    }

    String repoTargetNameFromUrl(String url) {
        Pair<String, String> p = repoPartsFromUrl(url);
        return p.first.casefold() + "__" + p.second.casefold();                      // src: harness/local_harness/batch/run.py:76
    }

    void cmdScan(Args args, Theta θ) {
        List<String> urls = Utils.parseRepoList(null);                               // src: harness/local_harness/batch/run.py:81
        if (urls.isEmpty()) exit(1);                                                 // src: harness/local_harness/batch/run.py:82
        Map<String, String> repoTargets = new LinkedMap();
        List<Pair> cloneFailures = new List();
        for (String url : urls) {                                                    // src: harness/local_harness/batch/run.py:89
            String name;
            try { name = repoTargetNameFromUrl(url); } catch (ValueError e) { cloneFailures.add(url, "invalid repository URL"); continue; } // src: harness/local_harness/batch/run.py:92
            if (repoTargets.containsKey(name)) continue;                             // src: harness/local_harness/batch/run.py:95 (duplicate, first wins)
            repoTargets.put(name, url);
        }
        // Phase 1: clone (depth=1, sequential)
        List<String> folders = new List();
        for (String name : repoTargets.keys()) {                                     // src: harness/local_harness/batch/run.py:112
            Pair<String, String> r = LocalHarnessClone.shallowClone(repoTargets[name], "repos_being_scanned/" + name, args.reClone, θ); // src: harness/local_harness/batch/run.py:114
            if (r.second != null) cloneFailures.add(repoTargets[name], r.second);    // src: harness/local_harness/batch/run.py:117
            else folders.add(r.first);
        }
        if (folders.isEmpty()) exit(1);                                              // src: harness/local_harness/batch/run.py:127
        // Phase 2: scan
        if (args.resume) {                                                           // src: harness/local_harness/batch/run.py:132
            for (String f : folders) LocalHarnessScan.cleanIncompleteResults(f, "batch_scan.log"); // src: harness/local_harness/batch/run.py:134
            folders = folders.filter(f -> !LocalHarnessScan.hasValidResults(f));     // src: harness/local_harness/batch/run.py:138
        }
        if (folders.isEmpty()) exit(0);                                              // src: harness/local_harness/batch/run.py:145
        List<Target> targets = folders.map(f -> new Target(f, Fs.basename(f)));      // src: harness/local_harness/batch/run.py:149
        List<Pair> results = LocalHarnessScan.scanTargets(targets, args.maxWorkers, 300, "batch_scan.log", !args.execute, θ); // src: harness/local_harness/batch/run.py:155
        // Phase 3: summary: per-target OK / FAIL(exit), elapsed, cost; totals
        for (Pair p : results) {                                                     // src: harness/local_harness/batch/run.py:167
            boolean ok = p.result.returncode == 0;                                   // src: harness/local_harness/batch/run.py:168
        }
    }

    void cmdStatus(Args args) {
        Utils.scanStatus(null, null);                                                // src: harness/local_harness/batch/run.py:185
    }

    void cmdCollect(Args args) {
        Utils.collectResults(null, args.uploadDir);                                  // src: harness/local_harness/batch/run.py:190
    }

    void main(Theta θ) {
        Args args = Argparse.parse("scan | status | collect");                       // src: harness/local_harness/batch/run.py:194
        args.reClone = Argparse.flag("--re-clone", false);                           // src: harness/local_harness/batch/run.py:198
        args.resume = Argparse.flag("--resume", false); // src: harness/local_harness/batch/run.py:200
        args.maxWorkers = Argparse.intArg("--max-workers", θ["harness.MAX_SCAN_WORKERS"]); // src: harness/local_harness/batch/run.py:202
        args.execute = Argparse.flag("--execute", θ["code.local_harness.batch.run.execute_default"]); // src: harness/local_harness/batch/run.py:204 (grants Bash; default read-only)
        if (args.command == null) args.command = "scan";                             // src: harness/local_harness/batch/run.py:216 (bare invocation = scan with defaults)
        if (args.command == "scan") cmdScan(args, θ);                                // src: harness/local_harness/batch/run.py:223
        else if (args.command == "status") cmdStatus(args);                          // src: harness/local_harness/batch/run.py:225
        else if (args.command == "collect") cmdCollect(args);                        // src: harness/local_harness/batch/run.py:227
    }
}
