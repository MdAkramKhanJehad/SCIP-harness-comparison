// file: vvaharness/backends/llm/sdk.py
// via: sdk -- raw Anthropic Messages loop with read-only localtools; mutating/Bash tool requests are
// delegated to the Claude Agent SDK. Streams to dodge HTTP timeouts, caches the prompt, retries 429/5xx.
// Hard turn cap, one prose re-ask, then a forced final answer. Cache markers only where three gates agree:
// the route accepts cache_control, the kill switch is on, and the prefix clears the model minimum.

@executedBy(CODE) @role(backend)
class LlmSdk {

