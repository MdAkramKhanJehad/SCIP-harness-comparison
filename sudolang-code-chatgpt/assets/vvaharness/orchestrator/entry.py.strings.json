    {
      "source": "vvaharness/orchestrator/entry.py",
      "line_start": 177,
      "line_end": 181,
      "text": "stop after the named step (for debugging); 'clone' stops right after acquiring repos in batch mode and implies --keep-clones; 'ev' verifies the collection named by EV_API_COLLECTION (parse + reachability probe) and stops before S1)",
