// file: vvaharness/backends/llm/sdk.py
// via: sdk -- raw Anthropic Messages loop with read-only localtools; mutating/Bash tool requests are
// delegated to the Claude Agent SDK. Hard turn cap, one prose re-ask, then a forced final answer.

@executedBy(CODE) @role(backend)
class LlmSdk {

    void configure(String apiKey, String baseUrl, Object verifySsl, String caCert, Object clientCert, boolean allowApiKeyFallback) { }
    void configureCache(Object markers, Integer minBlockTokens, String route) { }

    @src("vvaharness/backends/llm/sdk.py:1202")
    String agentic(Prompt userPrompt, String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, Integer maxTurns, Integer timeout, Schema responseModel, Effort effort, Theta θ) {
        int turnsCap = maxTurns != null ? maxTurns : _AGENTIC_MAX_TURNS;                                    // src: vvaharness/backends/llm/sdk.py:1243
        if (allowedTools.contains("Bash")) throw new ValueError("Bash is forbidden on via: sdk");          // src: vvaharness/backends/llm/sdk.py:1250
        List<String> missing = LocalTools.unsupported(allowedTools);                                        // src: vvaharness/backends/llm/sdk.py:1254
        if (!missing.isEmpty()) return AgentSdk.agentic(userPrompt, model, systemPrompt, allowedTools, cwd, maxTurns, timeout, effort); // mutation tools -> cwd-confined Agent SDK // src: vvaharness/backends/llm/sdk.py:1268
        Double sessionBudget = timeout != null ? LlmModels.effortScaledSeconds(timeout, effort, SESSION) : null; // src: vvaharness/backends/llm/sdk.py:1283
        Prompt systemText = systemPrompt;
        Map kw = Map.of("tools", LocalTools.schemas(allowedTools));
        if (responseModel != null) {
            if (!forcingBlocked(model, effort)) kw.put("tool_choice", "any");                               // src: vvaharness/backends/llm/sdk.py:1307
            else systemText = StructuredOutputPrompts.withSubmitInstruction(systemPrompt, responseModel, LlmModels.RESPONSE_MODEL_TOOL_NAME, θ); // src: vvaharness/backends/llm/sdk.py:1310
        }
        boolean schemaNudged = false;
        for (int turn = 1; turn <= turnsCap; turn++) {                                                      // src: vvaharness/backends/llm/sdk.py:1337
            if (sessionBudget != null && elapsed() >= sessionBudget) throw new CallTimeoutError();          // src: vvaharness/backends/llm/sdk.py:1338
            Message msg = send(systemText, kw);
            raiseIfRefused(msg);                                                                            // src: vvaharness/backends/llm/sdk.py:1465
            if (msg.stopReason != "tool_use") {
                // prose where a submit was expected: ask once by name, never on the last turn
                if (responseModel != null && !schemaNudged && turn < turnsCap) {                             // src: vvaharness/backends/llm/sdk.py:1470
                    schemaNudged = true;
                    append(StructuredOutputPrompts.proseReask(θ));                                          // src: vvaharness/backends/llm/sdk.py:1483
                    continue;
                }
                return msg.text;                                                                            // src: vvaharness/backends/llm/sdk.py:1488
            }
            dispatchTools(msg);                                                                             // ungranted names never run // src: vvaharness/backends/llm/sdk.py:1540
        }
        // Budget exhausted: force a final answer
        Counters.bump("llm_turn_cap_exhausted");                                                            // src: vvaharness/backends/llm/sdk.py:1570
        append(TurnCapPrompt.finalAnswer(responseModel != null, θ));                                        // src: vvaharness/backends/llm/sdk.py:1572
        // forced tool (or tools forbidden) unless forcing is blocked
        kw.put("tool_choice", responseModel == null ? "none" : (forcingBlocked(model, effort) ? null : LlmModels.RESPONSE_MODEL_TOOL_NAME)); // src: vvaharness/backends/llm/sdk.py:1594
        return send(systemText, kw).text;
    }

    boolean forcingBlocked(String model, Effort effort) { }
    Message send(Prompt system, Map kw) { }
    void append(Prompt p) { }
    void dispatchTools(Message msg) { }
    void raiseIfRefused(Message msg) { }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/sdk.py:1572")
class TurnCapPrompt {

    Prompt finalAnswer(boolean hasResponseModel, Theta θ) {
        Prompt p = new Prompt();
        if (hasResponseModel) p.must(θ["p.sdk.turn_cap_forced_structured_answer"]);                         // "Tool budget exhausted. Call emit_structured_response now with your best answer based on what you have read so far." // src: vvaharness/backends/llm/sdk.py:1575
        else p.must(θ["p.sdk.turn_cap_forced_text_answer"]);                                                // "Tool budget exhausted. Reply now with your final answer ...; do not call any tool." // src: vvaharness/backends/llm/sdk.py:1583
        return p;
    }
}
