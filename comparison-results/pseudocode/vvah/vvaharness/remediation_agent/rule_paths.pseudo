// file: vvaharness/remediation_agent/rule_paths.py
// Locate the remediation rule files (policy + playbook) across source checkout, installed share dir and a user-configured inputs dir.

@executedBy(CODE) @role(config) @stage("S10")
class RulePaths {

    List<String> ruleFiles() {
        return List.of("remediation_policy.yaml", "remediation_playbook.yaml");                     // src: vvaharness/remediation_agent/rule_paths.py:23
    }

    Path settingsPath() {
        String override = OsEnviron.get("VVAHARNESS_SETTINGS_FILE");                                      // src: vvaharness/remediation_agent/rule_paths.py:27
        if (override != null && !override.isEmpty()) return Path.expanduser(override);             // src: vvaharness/remediation_agent/rule_paths.py:29
        Path root = Path.of(OsEnviron.getOr("XDG_CONFIG_HOME", Path.home() + "/.config"));                // src: vvaharness/remediation_agent/rule_paths.py:30
        return root.join("vvaharness").join("settings.json");                                       // src: vvaharness/remediation_agent/rule_paths.py:31
    }

    Path configuredInputsDir() {
        try {
            Map raw = Json.parse(settingsPath().readText());                                        // src: vvaharness/remediation_agent/rule_paths.py:36
            Object value = raw instanceof Map ? raw.get("inputs_dir") : null;                       // src: vvaharness/remediation_agent/rule_paths.py:37
            return value != null ? Path.expanduser(value) : null;                                   // src: vvaharness/remediation_agent/rule_paths.py:38
        } catch (OSError | ValueError | TypeError e) {
            return null;                                                                            // src: vvaharness/remediation_agent/rule_paths.py:40
        }
    }

    Path saveInputsDir(String path) {
        Path directory = Path.expanduser(path).resolve();                                           // src: vvaharness/remediation_agent/rule_paths.py:44
        Path target = settingsPath();
        target.parent.mkdirs();                                                                     // src: vvaharness/remediation_agent/rule_paths.py:46
        Map data = new Map();
        try {
            Map existing = Json.parse(target.readText());                                           // src: vvaharness/remediation_agent/rule_paths.py:49
            if (existing instanceof Map) data.putAll(existing);                                     // src: vvaharness/remediation_agent/rule_paths.py:51
        } catch (OSError | ValueError | TypeError e) {
            // ignore unreadable settings                                                           // src: vvaharness/remediation_agent/rule_paths.py:53
        }
        data.put("inputs_dir", directory.toString());                                               // src: vvaharness/remediation_agent/rule_paths.py:54
        target.writeText(Json.dump(data));                                                          // src: vvaharness/remediation_agent/rule_paths.py:55
        return target;
    }

    List<Path> candidateInputsDirs(Path packageFile, Theta θ) {
        Path sourceInputs = Path.of(packageFile).resolve().parents(2).join("inputs");               // src: vvaharness/remediation_agent/rule_paths.py:61
        Path sharedInputs = Path.of(Sys.prefix).join("share/vvaharness/rules");                     // src: vvaharness/remediation_agent/rule_paths.py:62
        Path configured = configuredInputsDir();                                                    // src: vvaharness/remediation_agent/rule_paths.py:63
        // Search order: source checkout, then installed share dir, then user-configured dir; first hit wins.
        List<Path> ordered = θ["code.remediation_agent.rule_paths.inputs_dir_order"].map(k -> k.equals("source") ? sourceInputs : (k.equals("shared") ? sharedInputs : configured)); // src: vvaharness/remediation_agent/rule_paths.py:64
        return ordered.filter(p -> p != null).distinct();                                           // src: vvaharness/remediation_agent/rule_paths.py:65
    }

    Path locateRule(String filename, Path packageFile, Theta θ) {
        List<Path> candidates = candidateInputsDirs(packageFile, θ).map(p -> p.join(filename));     // src: vvaharness/remediation_agent/rule_paths.py:70
        for (Path p : candidates) {
            if (p.isFile()) return p;                                                               // src: vvaharness/remediation_agent/rule_paths.py:71
        }
        return candidates.get(0);                                                                   // src: vvaharness/remediation_agent/rule_paths.py:71  (missing -> first candidate)
    }

    List<String> missingRules(Path packageFile, Theta θ) {
        return ruleFiles().filter(n -> !locateRule(n, packageFile, θ).isFile());                    // src: vvaharness/remediation_agent/rule_paths.py:75
    }

    Pair<Path, List<String>> validateInputsDir(String path) {
        Path directory = Path.expanduser(path);                                                     // src: vvaharness/remediation_agent/rule_paths.py:79
        List<String> missing = ruleFiles().filter(n -> !directory.join(n).isFile());                // src: vvaharness/remediation_agent/rule_paths.py:80
        return new Pair(directory, missing);                                                        // src: vvaharness/remediation_agent/rule_paths.py:81
    }
}
