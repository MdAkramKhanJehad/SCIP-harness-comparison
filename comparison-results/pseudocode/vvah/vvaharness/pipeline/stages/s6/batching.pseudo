// file: vvaharness/pipeline/stages/s6/batching.py
// Group findings into verification sessions (sorted by file), and compute the pool-sweep ceiling.

@executedBy(CODE) @role(step) @stage("S6")
class S6Batching {

    List<Item> label(List<Finding> findings) {
        return findings.indexed().map((i, f) -> Item.of("f" + i, f));                           // src: vvaharness/pipeline/stages/s6/batching.py:30
    }

    List<List<Item>> planBatches(List<Item> items, int size) {
        if (size <= 1) return items.map(it -> List.of(it));                                     // src: vvaharness/pipeline/stages/s6/batching.py:36
        List<Item> packed = items.sortedBy(it -> it.f.file);                                    // src: vvaharness/pipeline/stages/s6/batching.py:37
        return packed.chunks(size);                                                             // src: vvaharness/pipeline/stages/s6/batching.py:38
    }

    int ceilingSecs(Theta θ) {
        // <= 0 means disabled; a bad value falls back to 900.
        return max(0, θ["step6_verify.batch_wall_clock_ceiling"]);                              // src: vvaharness/pipeline/stages/s6/batching.py:45
    }

    Effort sweepEffort(Theta θ, String via) {
        Effort e = θ["step6_verify.effort"];                                                    // src: vvaharness/pipeline/stages/s6/batching.py:52
        return e != null ? e : (via == "cli" ? Cli.globalEffort() : null);
    }

    int sweepCeilingSecs(Theta θ, String via) {
        int raw = ceilingSecs(θ);
        if (raw == 0) return 0;                                                                 // src: vvaharness/pipeline/stages/s6/batching.py:58
        // Sweep >= any backend clock armed for the same batch: effort-scaled plus a stop grace.
        return LlmModels.effortScaledSeconds(raw, sweepEffort(θ, via), SESSION) + TIMEOUT_STOP_GRACE_SECONDS; // src: vvaharness/pipeline/stages/s6/batching.py:60
    }

    Map<String, Set<Integer>> filedLines(List<Item> items) {
        return items.groupBy(it -> it.f.file, it -> it.f.lineStart);                            // src: vvaharness/pipeline/stages/s6/batching.py:69
    }
}
