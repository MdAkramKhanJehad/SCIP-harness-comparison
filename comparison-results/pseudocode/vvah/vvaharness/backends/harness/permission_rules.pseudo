// file: vvaharness/backends/harness/permission_rules.py
// Write-permission predicate used by PermissionsPolicy: Write is allowed only to a permitted output
// file sitting directly in the target directory. No command-parsing predicates (Bash is denied outright).

@executedBy(CODE) @role(rule_set)
class PermissionRules {

    // Resolve Write's file_path, anchoring a relative path under the target dir.
    Path resolveWritePath(Map<String, Object> inputData, Path resolvedTarget) {
        Object rawPath = inputData.getOrDefault("file_path", "");                                        // src: vvaharness/backends/harness/permission_rules.py:36
        if (!(rawPath instanceof String) || rawPath.isEmpty()) return null;                              // src: vvaharness/backends/harness/permission_rules.py:37
        Path candidate = Path.of(rawPath);
        if (!candidate.isAbsolute()) candidate = resolvedTarget.resolve(candidate);                      // src: vvaharness/backends/harness/permission_rules.py:40
        try {
            return candidate.resolve();                                                                  // src: vvaharness/backends/harness/permission_rules.py:43
        } catch (OSError e) {
            return null;                                                                                 // src: vvaharness/backends/harness/permission_rules.py:45
        }
    }

    // Directly in the target dir (parent equals target, case-insensitive); subdirectories do not count.
    boolean underTarget(Path resolved, Path resolvedTarget) {
        return normcase(resolved.parent()).equals(normcase(resolvedTarget));                             // src: vvaharness/backends/harness/permission_rules.py:50
    }

    PermissionDecision evaluateWrite(Map<String, Object> inputData, Path resolvedTarget, Set<String> allowedOutputFiles) {
        Path resolved = resolveWritePath(inputData, resolvedTarget);                                     // src: vvaharness/backends/harness/permission_rules.py:59
        if (env("VVAHARNESS_DEBUG") != null) Console.write("[s11-writegate] raw/resolved/target");       // src: vvaharness/backends/harness/permission_rules.py:60
        if (resolved == null) return new PermissionDecision(false, "Write path missing or unresolvable", true); // src: vvaharness/backends/harness/permission_rules.py:66
        if (!underTarget(resolved, resolvedTarget) || !allowedOutputFiles.contains(resolved.name())) {   // src: vvaharness/backends/harness/permission_rules.py:67
            return new PermissionDecision(false, "Write to disallowed path", true);                      // src: vvaharness/backends/harness/permission_rules.py:68
        }
        return new PermissionDecision(true, "", false);                                                  // src: vvaharness/backends/harness/permission_rules.py:69
    }
}
