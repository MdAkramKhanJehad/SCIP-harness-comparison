// file: vvaharness/backends/llm/agent_sdk.py
// Claude Agent SDK backend for the Remediation Agent's fix mode (via: sdk with mutation tools; sdk.py itself is read-only).
// Deny-by-default PreToolUse gate: Read/Glob/Grep allowed, Edit/Write confined to cwd (no symlinks, no .git), Bash denied.

@executedBy(CODE) @role(types)
record DrainResult(ResultMessage result, boolean timedOut) { }

@executedBy(CODE) @role(backend)
class AgentSdk {

    Set<String> WRITE_TOOLS = θ["code.backends.llm.agent_sdk.write_tools"];                                 // gated to cwd // src: vvaharness/backends/llm/agent_sdk.py:45
    Set<String> READ_TOOLS = θ["code.backends.llm.agent_sdk.read_tools"];                                   // always permitted // src: vvaharness/backends/llm/agent_sdk.py:47
    Set<String> REDACT_TOOLS = θ["code.backends.llm.agent_sdk.redact_tools"];                               // PostToolUse-masked outputs // src: vvaharness/backends/llm/agent_sdk.py:49
    Set<String> TOOL_PATH_KEYS = Set.of("filePath", "file_path", "filenames", "path");                      // redacted with carry=false // src: vvaharness/backends/llm/agent_sdk.py:89

    /** Real path confined to root, or null if unresolvable, escaping, or a symlinked final component. */
    @src("vvaharness/backends/llm/agent_sdk.py:52")
    Path resolveWithinRoot(Path root, Object raw) {
        if (!(raw instanceof String) || raw.isEmpty()) return null;                                         // src: vvaharness/backends/llm/agent_sdk.py:54
        try {
            Path candidate = Path.isAbs(raw) ? Path.of(raw) : root.resolve(raw);                            // src: vvaharness/backends/llm/agent_sdk.py:57
            if (candidate.isSymlink()) return null;                                                         // redirect primitive denied // src: vvaharness/backends/llm/agent_sdk.py:59
            Path target = candidate.realpath();                                                             // src: vvaharness/backends/llm/agent_sdk.py:61
            target.relativeTo(root);                                                                        // throws when outside root // src: vvaharness/backends/llm/agent_sdk.py:62
            return target;
        } catch (OSError e) {
            return null;                                                                                    // src: vvaharness/backends/llm/agent_sdk.py:64
        }
    }

    @src("vvaharness/backends/llm/agent_sdk.py:68")
    boolean withinRoot(Path root, Object raw) {
        return resolveWithinRoot(root, raw) != null;                                                        // src: vvaharness/backends/llm/agent_sdk.py:70
    }

    /** Ambient env, forwarding the SDK-specific key/base URL, plus the cli no-refusal-resend pins (set last). */
    @src("vvaharness/backends/llm/agent_sdk.py:73")
    Map sdkEnv() {
        Map env = System.environ().copy();                                                                  // src: vvaharness/backends/llm/agent_sdk.py:75
        if (env.get("ANTHROPIC_API_KEY") == null) {                                                         // src: vvaharness/backends/llm/agent_sdk.py:76
            String fallback = firstNonEmpty(env.get("ANTHROPIC_AUTH_TOKEN"), env.get("ANTHROPIC_SDK_API_KEY")); // src: vvaharness/backends/llm/agent_sdk.py:77
            if (fallback != null) env.put("ANTHROPIC_API_KEY", fallback);                                   // src: vvaharness/backends/llm/agent_sdk.py:80
        }
        String sdkBase = env.get("ANTHROPIC_SDK_BASE_URL");                                                 // src: vvaharness/backends/llm/agent_sdk.py:81
        if (sdkBase != null && env.get("ANTHROPIC_BASE_URL") == null) env.put("ANTHROPIC_BASE_URL", sdkBase); // src: vvaharness/backends/llm/agent_sdk.py:83
        env.putAll(Env.NO_REFUSAL_RESEND_ENV);                                                              // an ambient "0" cannot win // src: vvaharness/backends/llm/agent_sdk.py:85
        return env;
    }

    /** Mask secret/PII in payload (str/list/dict); path keys redacted without carry. */
    @src("vvaharness/backends/llm/agent_sdk.py:92")
    Object redactToolOutput(Object payload, boolean carry) {
        if (payload instanceof String) return Redact.redactCounts(payload, carry).masked;                   // src: vvaharness/backends/llm/agent_sdk.py:94
        if (payload instanceof List) return payload.map(item -> redactToolOutput(item, carry));             // src: vvaharness/backends/llm/agent_sdk.py:98
        if (payload instanceof Map) return payload.mapValues((k, v) -> redactToolOutput(v, carry && !TOOL_PATH_KEYS.contains(k))); // src: vvaharness/backends/llm/agent_sdk.py:100
        return payload;
    }

    /** PostToolUse hook masking Read/Grep/Bash output; null when HookMatcher is missing (best effort). */
    @src("vvaharness/backends/llm/agent_sdk.py:105")
    Map buildRedactionHooks() {
        if (!Sdk.has("HookMatcher")) return null;                                                           // src: vvaharness/backends/llm/agent_sdk.py:109
        return Map.of("PostToolUse", List.of(new HookMatcher(this::postToolUse)));                          // src: vvaharness/backends/llm/agent_sdk.py:134
    }

    @src("vvaharness/backends/llm/agent_sdk.py:112")
    Map postToolUse(Map inputData) {
        try {
            if (!REDACT_TOOLS.contains(inputData.get("tool_name"))) return Map.of();                        // src: vvaharness/backends/llm/agent_sdk.py:115
            Object response = inputData.get("tool_response");
            if (response == null) return Map.of();                                                          // src: vvaharness/backends/llm/agent_sdk.py:118
            Object masked = redactToolOutput(response, true);                                               // src: vvaharness/backends/llm/agent_sdk.py:120
            if (masked == response) return Map.of();
            return Map.of("hookEventName", "PostToolUse", "updatedToolOutput", masked);                     // the only key the CLI honours // src: vvaharness/backends/llm/agent_sdk.py:124
        } catch (Exception e) {
            return Map.of();                                                                                // src: vvaharness/backends/llm/agent_sdk.py:131
        }
    }

    /** PreToolUse gate: write confinement + deny-by-default; fail-closed on any exception. */
    @src("vvaharness/backends/llm/agent_sdk.py:158")
    Map preToolUseGate(Path root, Map inputData) {
        try {
            String toolName = inputData.getOrDefault("tool_name", "");                                      // src: vvaharness/backends/llm/agent_sdk.py:169
            Map toolInput = inputData.getOrDefault("tool_input", Map.of());
            if (WRITE_TOOLS.contains(toolName)) {                                                           // src: vvaharness/backends/llm/agent_sdk.py:173
                String raw = null;
                String keyUsed = null;
                for (String key : List.of("file_path", "path", "notebook_path")) {                          // src: vvaharness/backends/llm/agent_sdk.py:175
                    if (toolInput.get(key) != null) { raw = toolInput.get(key); keyUsed = key; break; }
                }
                Path resolved = resolveWithinRoot(root, raw);                                               // src: vvaharness/backends/llm/agent_sdk.py:180
                if (resolved == null) return deny(toolName + " target is outside the repository root, unresolvable, or a symlink"); // src: vvaharness/backends/llm/agent_sdk.py:182
                if (GitPaths.isGitMetadata(resolved.relativeTo(root))) return deny(toolName + " target is .git metadata"); // src: vvaharness/backends/llm/agent_sdk.py:185
                Map safeInput = toolInput.copy();
                safeInput.put(keyUsed, resolved.toString());                                                // hand over the resolved path, not the alias // src: vvaharness/backends/llm/agent_sdk.py:190
                return Map.of("permissionDecision", "allow", "updatedInput", safeInput);                    // src: vvaharness/backends/llm/agent_sdk.py:191
            }
            if (READ_TOOLS.contains(toolName)) return Map.of();                                             // covered by the allow entry // src: vvaharness/backends/llm/agent_sdk.py:197
            // DENY-BY-DEFAULT, esp. Bash: host-shell RCE + credential exfil
            return deny(toolName + " is not permitted in remediation fix mode");                            // src: vvaharness/backends/llm/agent_sdk.py:200
        } catch (Exception exc) {
            return deny("the security gate could not evaluate this call and denies it as a precaution");    // src: vvaharness/backends/llm/agent_sdk.py:204
        }
    }

    Map deny(String reason) {
        return Map.of("hookEventName", "PreToolUse", "permissionDecision", "deny", "permissionDecisionReason", reason); // src: vvaharness/backends/llm/agent_sdk.py:162
    }

    /** ClaudeAgentOptions with the cwd-confined write gate. */
    @src("vvaharness/backends/llm/agent_sdk.py:139")
    AgentOptions buildOptions(String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, Double maxBudgetUsd, Integer maxTurns) {
        if (!Sdk.has("ClaudeAgentOptions", "HookMatcher")) throw new RuntimeError("Agent SDK build has no PreToolUse hook support"); // src: vvaharness/backends/llm/agent_sdk.py:148
        Path root = cwd.resolve();                                                                          // src: vvaharness/backends/llm/agent_sdk.py:156
        Map hooks = buildRedactionHooks() != null ? buildRedactionHooks() : new Map();                      // src: vvaharness/backends/llm/agent_sdk.py:207
        hooks.put("PreToolUse", List.of(new HookMatcher(in -> preToolUseGate(root, in))));                   // src: vvaharness/backends/llm/agent_sdk.py:208
        AgentOptions opts = new AgentOptions();
        opts.model = model;                                                                                 // src: vvaharness/backends/llm/agent_sdk.py:211
        opts.cwd = root;
        opts.env = sdkEnv();                                                                                // src: vvaharness/backends/llm/agent_sdk.py:213
        opts.permissionMode = θ["code.backends.llm.agent_sdk.permission_mode"];                             // the hook is the live gate // src: vvaharness/backends/llm/agent_sdk.py:215
        // the scanned repo's .claude/settings.json can never re-grant Bash or register a hook
        opts.settingSources = θ["code.backends.llm.agent_sdk.setting_sources"];                             // src: vvaharness/backends/llm/agent_sdk.py:219
        opts.strictMcpConfig = true;                                                                        // repo .mcp.json never spawned // src: vvaharness/backends/llm/agent_sdk.py:222
        opts.allowedTools = allowedTools;                                                                   // src: vvaharness/backends/llm/agent_sdk.py:223
        opts.hooks = hooks;
        opts.verbatimPrompts = true;                                                                        // finding text never parsed as @path or /command // src: vvaharness/backends/llm/agent_sdk.py:227
        if (systemPrompt != null) opts.systemPrompt = systemPrompt;                                         // src: vvaharness/backends/llm/agent_sdk.py:230
        if (maxTurns != null) opts.maxTurns = maxTurns;                                                     // src: vvaharness/backends/llm/agent_sdk.py:232
        if (maxBudgetUsd != null) opts.maxBudgetUsd = maxBudgetUsd;                                         // src: vvaharness/backends/llm/agent_sdk.py:234
        return opts;
    }

    /** One fresh pass over receive_response(), returning the terminal ResultMessage. */
    @src("vvaharness/backends/llm/agent_sdk.py:246")
    ResultMessage drain(SdkClient client, Consumer onMessage) {
        for (Message message : client.receiveResponse()) {                                                  // src: vvaharness/backends/llm/agent_sdk.py:250
            onMessage.accept(message);
            if (message instanceof ResultMessage) return message;                                           // src: vvaharness/backends/llm/agent_sdk.py:252
        }
        return null;
    }

    /** Drain to the terminal result bounded by timeout; on expiry interrupt, then re-drain within grace. */
    @src("vvaharness/backends/llm/agent_sdk.py:257")
    DrainResult drainUntilResult(SdkClient client, Consumer onMessage, Double timeout, double grace) {
        if (timeout == null || timeout <= 0) return new DrainResult(drain(client, onMessage), false);       // src: vvaharness/backends/llm/agent_sdk.py:260
        try {
            return new DrainResult(Async.withTimeout(timeout, () -> drain(client, onMessage)), false);      // src: vvaharness/backends/llm/agent_sdk.py:265
        } catch (TimeoutError e) {
            if (!e.ourDeadline()) throw e;                                                                  // src: vvaharness/backends/llm/agent_sdk.py:268
        }
        try { client.interrupt(); } catch (Exception e) { }                                                 // src: vvaharness/backends/llm/agent_sdk.py:271
        try {
            return new DrainResult(Async.withTimeout(grace, () -> drain(client, onMessage)), true);         // fresh call, not a resume // src: vvaharness/backends/llm/agent_sdk.py:276
        } catch (TimeoutError e) {
            if (!e.ourDeadline()) throw e;
            return new DrainResult(null, true);                                                             // src: vvaharness/backends/llm/agent_sdk.py:281
        }
    }

    /** Stream one agentic session to completion and return the final text. */
    @src("vvaharness/backends/llm/agent_sdk.py:284")
    String run(Prompt userPrompt, AgentOptions opts, Double timeout, String tag, Effort effort) {
        List<String> textParts = new List();
        Double budget = LlmModels.effortScaledSeconds(timeout, effort, SESSION);                            // src: vvaharness/backends/llm/agent_sdk.py:302
        double start = Clock.monotonic();
        SdkClient client = new SdkClient(opts);                                                             // src: vvaharness/backends/llm/agent_sdk.py:306
        client.query(userPrompt);                                                                           // src: vvaharness/backends/llm/agent_sdk.py:307
        DrainResult drained = drainUntilResult(client, m -> textParts.addAssistantText(m), budget, LlmModels.TIMEOUT_STOP_GRACE_SECONDS); // src: vvaharness/backends/llm/agent_sdk.py:308
        client.close();
        ResultMessage result = drained.result;
        if (result != null && result.usage != null) Tokens.TOKENS.add(result.usage);                        // src: vvaharness/backends/llm/agent_sdk.py:313
        if (drained.timedOut) throw LlmModels.callTimeoutError(tag, "agent-sdk", budget, effort);           // src: vvaharness/backends/llm/agent_sdk.py:315
        LlmModels.noteBudgetUse(Clock.monotonic() - start, budget, effort);                                 // src: vvaharness/backends/llm/agent_sdk.py:318
        String resultText = result != null ? result.result : null;
        return (resultText != null && !resultText.isEmpty() ? resultText : String.join("", textParts)).strip(); // src: vvaharness/backends/llm/agent_sdk.py:320
    }

    /** Agentic loop with native Edit/Write via the Agent SDK; writes cwd-confined, Bash denied by the gate. */
    @src("vvaharness/backends/llm/agent_sdk.py:323")
    String agentic(Prompt userPrompt, String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, Integer maxTurns, Double timeout, Effort effort) {
        // permission_mode param accepted for parity only; max_budget_usd and tag also accepted
        if (!Sdk.importable("claude_agent_sdk")) throw new RuntimeError("Edit/Write/Bash on via: sdk need the Claude Agent SDK; or set via: cli"); // src: vvaharness/backends/llm/agent_sdk.py:341
        List<String> allowed = allowedTools == null ? LlmModels.DEFAULT_READ_TOOLS : allowedTools;          // null = read-only default, [] = none // src: vvaharness/backends/llm/agent_sdk.py:348
        AgentOptions opts = buildOptions(model, systemPrompt, allowed, cwd, null, maxTurns);                // src: vvaharness/backends/llm/agent_sdk.py:353
        return run(userPrompt, opts, timeout, null, effort);                                                // src: vvaharness/backends/llm/agent_sdk.py:357
    }
}
