// file: vvaharness/remediation_agent/frameworks.py
// Per-file language (from the finding's own extension) and per-repo framework detection: the keys the playbook resolves a strategy on.

@executedBy(CODE) @role(rule_set) @stage("S10")
class Frameworks {

    String languageFor(String filePath, Theta θ) {
        // .py/.pyi python; .java/.kt/.scala/.groovy java; .js/.jsx/.mjs/.ts/.tsx javascript; .cs csharp; .go; .rb ruby; .php; .c/.h c; .cc/.cpp/.cxx/.hpp cpp; .rs rust
        Map<String, String> extLang = θ["code.remediation_agent.frameworks.ext_lang"];              // src: vvaharness/remediation_agent/frameworks.py:21
        return extLang.getOr(Path.suffix(filePath != null ? filePath : "").lower(), "default");     // src: vvaharness/remediation_agent/frameworks.py:66
    }

    Set<String> detectFrameworks(String repoRoot, Theta θ) {
        Path root = Path.of(repoRoot);
        Set<String> found = new Set();
        // manifest -> marker substring -> framework key (requirements.txt/pyproject/Pipfile/package.json/pom.xml/build.gradle/Gemfile/go.mod)
        Map<String, Map<String, String>> manifests = θ["code.remediation_agent.frameworks.manifest_markers"]; // src: vvaharness/remediation_agent/frameworks.py:36
        for (String fname : manifests.keys()) {                                                     // src: vvaharness/remediation_agent/frameworks.py:73
            // Search depth: repo root and its immediate children only.
            List<Path> hits = θ["code.remediation_agent.frameworks.manifest_search_depth"] >= 1 ? root.glob(fname).plus(root.glob("*/" + fname)) : root.glob(fname); // src: vvaharness/remediation_agent/frameworks.py:74
            for (Path p : hits) {
                String txt;
                try {
                    txt = p.readText("replace").lower();                                            // src: vvaharness/remediation_agent/frameworks.py:76
                } catch (OSError e) {
                    continue;                                                                       // src: vvaharness/remediation_agent/frameworks.py:78
                }
                for (String needle : manifests.get(fname).keys()) {                                 // src: vvaharness/remediation_agent/frameworks.py:79
                    if (txt.contains(needle.lower())) found.add(manifests.get(fname).get(needle));  // src: vvaharness/remediation_agent/frameworks.py:80
                }
            }
        }
        return found;                                                                               // src: vvaharness/remediation_agent/frameworks.py:82
    }
}
