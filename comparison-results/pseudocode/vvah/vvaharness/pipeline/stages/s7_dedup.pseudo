// file: vvaharness/pipeline/stages/s7_dedup.py
// Step 7 deduplication: a deterministic same-site pass (also used by S5 as its prefilter),
// then one optional model call on the findings the deterministic pass could not resolve.

@executedBy(CODE) @role(stage) @stage("S7")
class S7Dedup {

    Pair<List<Finding>, List<DroppedFinding>> prefilter(List<Finding> findings, int lineTol, List<Integer> groupLines) {
        if (findings.size() <= 1) return Pair.of(findings, List.of());                          // src: vvaharness/pipeline/stages/s7_dedup.py:39
        // group_lines must be S4's anchors, or S5's re-anchor pulls two distinct sinks into line_tol.
        Map<Integer, Integer> canonicalOf = S7Collapse.collapseTrivial(findings, lineTol, groupLines); // src: vvaharness/pipeline/stages/s7_dedup.py:43
        S7Collapse.attachDuplicates(findings, canonicalOf, canonicalOf.keys().toMap(j -> S7Collapse.TRIVIAL_REASON), null); // src: vvaharness/pipeline/stages/s7_dedup.py:45
        List<Finding> keep = findings.filterIndex(i -> !canonicalOf.containsKey(i));             // src: vvaharness/pipeline/stages/s7_dedup.py:50
        List<DroppedFinding> dropped = findings.filterIndex(i -> canonicalOf.containsKey(i)).map(f -> new DroppedFinding(f, "DUPLICATE", S7Collapse.TRIVIAL_REASON)); // src: vvaharness/pipeline/stages/s7_dedup.py:51
        return Pair.of(keep, dropped);
    }

    Pair<List<Finding>, List<DroppedFinding>> run(List<Finding> verified, Theta θ, String label, ContextPackage ctx) {
        if (verified.size() <= 1) return Pair.of(verified, List.of());                          // src: vvaharness/pipeline/stages/s7_dedup.py:65
        int lineTol = θ["step7_dedup.line_tolerance"];                                          // src: vvaharness/pipeline/stages/s7_dedup.py:68

        // Group on pre_anchor_line, never post-re-anchor, or two distinct sinks get collapsed here.
        List<Integer> groupLines = verified.map(f -> f.preAnchorLine != 0 ? f.preAnchorLine : f.lineStart); // src: vvaharness/pipeline/stages/s7_dedup.py:71
        Map<Integer, Integer> canonicalOf = S7Collapse.collapseTrivial(verified, lineTol, groupLines); // src: vvaharness/pipeline/stages/s7_dedup.py:73
        Map<Integer, String> reasoning = canonicalOf.keys().toMap(j -> S7Collapse.TRIVIAL_REASON); // src: vvaharness/pipeline/stages/s7_dedup.py:74
        List<Integer> unresolved = range(verified.size()).filter(i -> !canonicalOf.containsKey(i)); // src: vvaharness/pipeline/stages/s7_dedup.py:76

        // null tells attachDuplicates to discard duplicate sites rather than retain them.
        Set<Integer> keepSameSite = θ["step7_dedup.per_sink_keep"] ? new Set() : null;          // src: vvaharness/pipeline/stages/s7_dedup.py:82
        if (keepSameSite != null) keepSameSite.addAll(canonicalOf.keys());                      // src: vvaharness/pipeline/stages/s7_dedup.py:85

        if (unresolved.size() >= 2 && θ["step7_dedup.semantic"]) {                               // src: vvaharness/pipeline/stages/s7_dedup.py:92
            // The one semantic call (S7Session) sends this effort and output-token cap.
            Effort effort = θ["step7_dedup.effort"];                                            // src: vvaharness/pipeline/stages/s7/session.py:42
            int maxTokens = θ["step7_dedup.max_tokens"];                                        // src: vvaharness/pipeline/stages/s7/session.py:52
            List<DedupRow> sem = S7Session.semanticDedup(verified, unresolved, θ, ctx, label);   // src: vvaharness/pipeline/stages/s7_dedup.py:93
            int blocked = 0;
            for (DedupRow row : sem) {                                                          // src: vvaharness/pipeline/stages/s7_dedup.py:95
                // semanticDedup returns positions in `unresolved`, not global indices.
                int gIdx = unresolved[row.localIdx];
                int gCanon = unresolved[row.localCanon];
                if (canonicalOf.containsKey(gIdx) || gCanon >= gIdx) continue;                  // src: vvaharness/pipeline/stages/s7_dedup.py:99
                // Test the ROOT, not the named canonical: code refuses any cross-CWE collapse the model proposes.
                if (S7Collapse.cweConflict(verified[gIdx], verified[root(canonicalOf, gCanon)])) { // src: vvaharness/pipeline/stages/s7_dedup.py:102
                    blocked += 1;
                    continue;
                }
                canonicalOf.put(gIdx, gCanon);                                                  // src: vvaharness/pipeline/stages/s7_dedup.py:105
                reasoning.put(gIdx, row.why);
                // Fail-safe: keep the member's line only when the model ruled the sites independent.
                if (row.independentSites && keepSameSite != null) keepSameSite.add(gIdx);       // src: vvaharness/pipeline/stages/s7_dedup.py:108
            }
            if (blocked > 0) Counters.bump("s7_dedup_cwe_conflict_blocked", blocked);           // src: vvaharness/pipeline/stages/s7_dedup.py:111
        }

        // Merging each dup onto its canonical is how the MD report and SARIF surface every call site.
        S7Collapse.attachDuplicates(verified, canonicalOf, reasoning, keepSameSite);             // src: vvaharness/pipeline/stages/s7_dedup.py:115

        List<Finding> canonical = new List();
        Map<Integer, Integer> newIndexOf = new Map();
        for (int i : range(verified.size())) {                                                  // src: vvaharness/pipeline/stages/s7_dedup.py:119
            if (!canonicalOf.containsKey(i)) { newIndexOf.put(i, canonical.size()); canonical.add(verified[i]); }
        }
        List<DroppedFinding> dropped = new List();
        for (int i : range(verified.size())) {                                                  // src: vvaharness/pipeline/stages/s7_dedup.py:125
            if (canonicalOf.containsKey(i)) {
                dropped.add(new DroppedFinding(verified[i], "DUPLICATE", reasoning.getOrDefault(i, "duplicate"), newIndexOf.get(root(canonicalOf, i)))); // src: vvaharness/pipeline/stages/s7_dedup.py:128
            }
        }
        return Pair.of(canonical, dropped);
    }

    int root(Map<Integer, Integer> canonicalOf, int i) {
        while (canonicalOf.containsKey(i)) i = canonicalOf.get(i);                              // src: vvaharness/pipeline/stages/s7_dedup.py:88
        return i;
    }
}
