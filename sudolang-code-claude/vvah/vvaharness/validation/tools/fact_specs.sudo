# vvaharness/validation/tools/fact_specs.py

The same five fact tools as backend-neutral specifications, for the Claude cli/sdk route (which serves them as an MCP server; the model sees them prefixed `mcp__facts__`).

Source: `vvaharness/validation/tools/fact_specs.py` (lines 1-103)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` build_validation_options (fact_tool_specs)

// src: vvaharness/validation/tools/fact_specs.py:52-100
fn build_validation_fact_specs(workspace):executor=code {
  return [
    FactToolSpec { name: "DiffTouched", description: "Return whether *file_path* is in diff.patch and its changed line ranges.",
      input: { file_path: String  /* "Repo-relative path." */ }, fn: diff_touched(workspace, file_path) },
    FactToolSpec { name: "ChangedLines", description: "Return added line ranges for *file_path* from diff.patch.",
      input: { file_path: String }, fn: changed_lines(workspace, file_path) },
    FactToolSpec { name: "DiffImpactMap", description: "Return files changed by diff.patch and whether a trust boundary was touched.",
      input: {}, fn: { files_changed, trust_boundary_touched } of build_diff_impact_map(workspace) },
    FactToolSpec { name: "PatternScan", description: "Return bounded, secret-free match metadata and a scan summary. Builtin sets: \"secret_exposure\", \"insecure_value\". The final item reports counts, limits, and whether results were truncated.",
      input: { pattern_set: String  /* "Builtin set: \"secret_exposure\" or \"insecure_value\"." */ }, fn: pattern_scan(workspace, pattern_set) },
    FactToolSpec { name: "TestInventory", description: "Inventory test files and detect negative/adversarial test markers.",
      input: {}, fn: test_inventory(workspace) }
  ]
  // external: which of these a persona may call is decided by its tool list and the backend (vvaharness/backends/harness/claude/facts.py)
}
