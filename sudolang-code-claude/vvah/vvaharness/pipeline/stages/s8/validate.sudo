_HEDGE_RX = /(?i)\b(even without|future maintainer|alternatively\b)/   // narrow on purpose; broader tells fire on ordinary prose
_HEDGE_NOTE = "_Note: this chain's own narrative suggests its steps may be independently sufficient rather than strictly sequential — read the path as a grouping unless each step is needed._"

// src: vvaharness/pipeline/stages/s8/validate.py:195-216
_HARDENING_NOTE = "Step(s) {pos} of this path describe a missing control rather than a capability the attacker carries forward, so the path may be a grouping of related findings rather than a sequence."
_LINK_COVERAGE_NOTE = "{n} of {m} step-to-step hop(s) carry a citation this scan could check."
_COMMENT_CITATION_NOTE = "Link evidence cites a line that is wholly a comment ({where}), which documents an intention rather than the mechanism."
_TITLE_DIVERGENCE_NOTE = "The chain title names \"{term}\", which none of its steps covers."
