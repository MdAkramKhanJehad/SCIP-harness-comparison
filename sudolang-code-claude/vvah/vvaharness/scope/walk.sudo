// src: vvaharness/scope/walk.py:33-68
ExclusionDefaults {
  _DEFAULT_EXCLUDE_DIRS = [".git", ".hg", ".svn", "node_modules", "__pycache__", ".venv", "venv", "dist", "build", ".idea", ".vscode", "target", "vendor", ".terraform", ".next", ".nuxt", "coverage", ".pytest_cache", ".mypy_cache", "test", "tests", "__tests__", "__test__", "e2e", "testdata", "fixtures", "__fixtures__", "mocks", "__mocks__", "stubs", "checkpoints", "security-scan", "security-remediation", ".vvaharness"]
    // "spec"/"specs" deliberately absent (UI component folders); IaC and CI directories are kept; "target" only with a build marker
  _DEFAULT_EXCLUDE_EXTS = [".png", ".jpg", ".jpeg", ".gif", ".ico", ".svg", ".pdf", ".zip", ".gz", ".tar", ".7z", ".jar", ".war", ".class", ".exe", ".dll", ".so", ".dylib", ".bin", ".o", ".a", ".obj", ".pyc", ".pyo", ".pkl", ".lock", ".min.js", ".map", ".woff", ".woff2", ".ttf", ".eot", ".mp4", ".mp3", ".wav"]
  _DEFAULT_EXCLUDE_GLOBS = ["**/test_*.py", "**/*_test.py", "**/conftest.py", "**/*_test.go", "**/*.test.js", "**/*.test.ts", "**/*.test.jsx", "**/*.test.tsx", "**/*.spec.js", "**/*.spec.ts", "**/*.spec.jsx", "**/*.spec.tsx", "**/*Test.java", "**/*Tests.java", "**/*IT.java", "**/*Test.cs", "**/*Tests.cs", "**/*Test.kt", "**/.gitignore", "**/.gitattributes", "**/.gitmodules", "**/.gitkeep", "**/.editorconfig", "**/.dockerignore", "**/.npmignore", "**/.eslintignore", "**/.prettierignore", "**/.mailmap", "**/CODEOWNERS", "**/.DS_Store", "**/LICENSE", "**/LICENSE.*", "**/NOTICE"]
    // Dockerfile, Jenkinsfile, Makefile, *.tf and Helm YAML are kept
  _TARGET_BUILD_MARKERS = ["pom.xml", "build.gradle", "build.gradle.kts", "Cargo.toml", "build.sbt", "project.clj"]
}

// src: vvaharness/scope/walk.py:167-257
fn _walk_repo(repo_root, cfg):executor=code {
  [excl_dirs, excl_exts, excl_globs] = _exclusion_sets(cfg)
  max_kb = knob("step1.max_file_kb", default=1024)
  follow_symlinks = Boolean(knob("step1.follow_symlinks", default=false))
  if (follow_symlinks) console note: symlinks resolving outside the repository are still dropped
  // preserved: follow_symlinks is read only for this console note; nothing else in the walk reads it, so in-tree symlinked files are kept or excluded the same way whatever its value

  // src: walk.py:187-207 — the first rule that excludes a repository-relative path
  _rule_hit(r) {
    parts = r split on "/"
    if (some parent component (not the file name) is in excl_dirs, case-insensitive, and that component is not "target" or _has_target_build_marker(root, components before it)) return [dirs bucket, path up to that component]
    if (some e in excl_exts: suffix(lowercase name) == e || lowercase name endswith e) return [exts bucket, e]
    if (glob_hit(r, excl_globs)) return [globs bucket, that glob]
    return null
  }

  // src: walk.py:209-246 — every regular file under root, in rglob order, then sorted
  for each p in root.rglob("*") where p is a file {
    rel = repository-relative posix path
    if (p is a symlink) {
      escapes = target (resolved, not strict) is outside the resolved root; a resolution error counts as escaping (errlog.log("s1", rel, reason="symlink_resolve_failed"))
      if (escapes) { count in symlinks; continue }   // unconditional: no setting re-opens it
      tgt_rel = target's repository-relative path
    }
    if (_rule_hit(rel)) { count in that bucket; continue }
    if (tgt_rel != null && _rule_hit(tgt_rel)) { count in symlink_targets; continue }   // an in-tree link is judged by its target too
    if (stat fails) { errlog.log("s1", rel, reason="stat_failed"); continue }
    if (size > max_kb * 1024) { record (rel, size) as oversize; continue }
    out += rel
  }
  excluded = { dirs, exts, globs, oversize: count, oversize_files: sorted by size descending, symlinks, symlink_targets }
  return [sorted(out), excluded]
}

// src: vvaharness/scope/walk.py:80-87
fn _exclusion_sets(cfg):executor=code {
  excl_dirs = lowercase(_DEFAULT_EXCLUDE_DIRS union knob("step1.exclude_dirs", default=[]))
  excl_exts = _DEFAULT_EXCLUDE_EXTS union knob("step1.exclude_exts", default=[])   // configured extensions are not lowercased
  excl_globs = _DEFAULT_EXCLUDE_GLOBS + knob("step1.exclude_globs", default=[])
  return [excl_dirs, excl_exts, excl_globs]
  // configuration appends to the defaults; it cannot remove a default exclusion
}

// src: vvaharness/scope/walk.py:88-96
fn glob_hit(rel, globs):executor=code {
  name = last path component of rel
  for each g in globs {
    if (fnmatchcase(rel, g)) return g   // case-sensitive
    if (g starts with "**/" && fnmatchcase(name, g without "**/")) return g   // "**/" also matches at the root
  }
  return null
}

// src: vvaharness/scope/walk.py:71-77
fn _has_target_build_marker(root, parent_parts):executor=code = any of _TARGET_BUILD_MARKERS is a file in the directory that directly contains target/

// src: vvaharness/scope/walk.py:151-164
fn scope_after(repo_root, cfg, dirs=[], exts=[], globs=[], max_file_kb?):executor=code {
  // the inventory _walk_repo yields with extra exclusions; a guard on a proposed overlay measures the walk that actually runs
  shadow.step1 = { exclude_dirs: base dirs union lowercase(dirs), exclude_exts: base exts union exts, exclude_globs: base globs + globs, max_file_kb: max_file_kb or, when absent, knob("step1.max_file_kb", default=1024), follow_symlinks: false }
  return _walk_repo(repo_root, shadow)[0]
}

// src: vvaharness/scope/walk.py:99-136
fn _norm_rel(repo_root, p):executor=code {
  p = backslashes to "/", leading "./" removed
  if (p starts with the absolute or the given repo root + "/", case-insensitive) return the remainder
  return p without leading "/"   // the agent's virtual filesystem is repository-rooted
}
fn resolve_inventory_path(repo_root, p, inventory):executor=code {
  folded = backslashes to "/", leading "./" removed
  if (!inventory) return folded without leading "/"
  for each cand in [folded, folded without leading "/", folded without "<repo directory name>/" prefix] {
    if (cand in inventory) return cand   // raw spelling first; the first hit wins
  }
  return _norm_rel(repo_root, folded)
}

// src: vvaharness/scope/walk.py:139-148
fn _resolve_scope_path(path, repo_root, keep, top_dirs):executor=code {
  rel = resolve_inventory_path(repo_root, path, keep)
  if (rel in keep) return [rel, false]
  matches = "$td/$rel" for td in top_dirs where in keep
  if (length(matches) == 1) return [matches[0], false]
  return [null, length(matches) > 1]   // ambiguous matches are dropped, never guessed
}

// src: vvaharness/scope/walk.py:260-271
_DEDUP_DEFAULTS {
  enabled: true
  exts: [".yml", ".yaml", ".json", ".toml", ".ini", ".properties", ".conf", ".cfg", ".env"]
  min_cluster_size: 3
  keep_per_top_dir: true
  promote_on_secret_hit: true
  promote_on_insecure_value: true
  max_file_kb: 512
}

// src: vvaharness/scope/walk.py:273-286 — credential material that must never be dropped as a duplicate
_SECRET_RX {
  // case-insensitive
  key names password|passwd|pwd|secret|api[_-]?key|apikey|access[_-]?key|auth[_-]?token|private[_-]?key|client[_-]?secret|credential (optional "s"), then ":" or "=", then a value of 8 or more characters that is not a templated or indirect reference (CRYPT:, ENC(, {{, ${, <%=, <%, vault:, secret:, file:, /) and not itself a "key:" pair
  or "-----BEGIN ... PRIVATE KEY-----"
  or AKIA followed by 16 uppercase letters or digits
  or xox[baprs]- tokens of 10 or more characters
  or gh[pousr]_ tokens of 36 or more characters
  or three-part JSON Web Tokens starting "eyJ"
}

// src: vvaharness/scope/walk.py:288-298 — insecure values (not secrets) that make a config variant worth keeping
_INSECURE_RX {
  // case-insensitive
  certificate or TLS verification set to false|0|no|none|off (verify, verify_ssl, verification_ssl, ssl_verify, validate_cert*, tls_verify, check_hostname, reject_unauthorized)
  insecure* set to true|1|yes
  InsecureSkipVerify: true
  auth|authentication|authn|security set to none|disabled|off|false
  debug set to true|1|yes
  allow_anonymous set to true|1|yes
}
