// file: vvaharness/rules/repo_kinds.py
// Repo-kind classifier and its STRIDE-hint / minimum-baseline lookup tables for S2.
// Baseline ids BL-<kind>-<suffix> make the model's disposition machine-checkable (S2Baseline.audit).

@executedBy(CODE) @role(rule_set) @stage("S2")
class RepoKinds {

    /** STRIDE_BY_KIND: a hint per entry-point kind, rendered into the S2 ENTRY POINTS block; not a constraint. */
    Map<String, String> strideByKind(Theta θ) {
        Map<String, String> m = new Map();
        m.put("network", θ["p.repo_kinds.stride_network"]);                                   // src: vvaharness/rules/repo_kinds.py:26
        m.put("framework", θ["p.repo_kinds.stride_framework"]);                               // specialisation of network  // src: vvaharness/rules/repo_kinds.py:27
        m.put("ipc", θ["p.repo_kinds.stride_ipc"]);                                           // src: vvaharness/rules/repo_kinds.py:29
        m.put("file", θ["p.repo_kinds.stride_file"]);                                         // src: vvaharness/rules/repo_kinds.py:30
        m.put("cli", θ["p.repo_kinds.stride_cli"]);                                           // src: vvaharness/rules/repo_kinds.py:31
        m.put("deserialization", θ["p.repo_kinds.stride_deserialization"]);                   // src: vvaharness/rules/repo_kinds.py:32
        m.put("other", θ["p.repo_kinds.stride_other"]);                                       // src: vvaharness/rules/repo_kinds.py:33
        return m;
    }

    /** BASELINES[kind]: (id, OWASP/CWE category text) items the S2 model must dispose of. */
    List<Pair<String, String>> baselines(String kind, Theta θ) {
        List<Pair<String, String>> items = new List();
        if (kind == "web-api") {
            items.add(new Pair("BL-WEB-A01", θ["p.repo_kinds.baseline_bl_web_a01"]));     // src: vvaharness/rules/repo_kinds.py:49
            items.add(new Pair("BL-WEB-A02", θ["p.repo_kinds.baseline_bl_web_a02"]));     // src: vvaharness/rules/repo_kinds.py:50
            items.add(new Pair("BL-WEB-A03", θ["p.repo_kinds.baseline_bl_web_a03"]));     // src: vvaharness/rules/repo_kinds.py:51
            items.add(new Pair("BL-WEB-A04", θ["p.repo_kinds.baseline_bl_web_a04"]));     // src: vvaharness/rules/repo_kinds.py:52
            items.add(new Pair("BL-WEB-A05", θ["p.repo_kinds.baseline_bl_web_a05"]));     // src: vvaharness/rules/repo_kinds.py:53
            items.add(new Pair("BL-WEB-A07", θ["p.repo_kinds.baseline_bl_web_a07"]));     // src: vvaharness/rules/repo_kinds.py:54
            items.add(new Pair("BL-WEB-A08", θ["p.repo_kinds.baseline_bl_web_a08"]));     // src: vvaharness/rules/repo_kinds.py:55
            items.add(new Pair("BL-WEB-A10", θ["p.repo_kinds.baseline_bl_web_a10"]));     // src: vvaharness/rules/repo_kinds.py:56
            items.add(new Pair("BL-WEB-XSS", θ["p.repo_kinds.baseline_bl_web_xss"]));     // src: vvaharness/rules/repo_kinds.py:57
            items.add(new Pair("BL-WEB-CSRF", θ["p.repo_kinds.baseline_bl_web_csrf"]));   // src: vvaharness/rules/repo_kinds.py:58
        }
        if (kind == "mobile") {
            items.add(new Pair("BL-MOB-M1", θ["p.repo_kinds.baseline_bl_mob_m1"]));       // src: vvaharness/rules/repo_kinds.py:61
            items.add(new Pair("BL-MOB-M3", θ["p.repo_kinds.baseline_bl_mob_m3"]));       // src: vvaharness/rules/repo_kinds.py:62
            items.add(new Pair("BL-MOB-M5", θ["p.repo_kinds.baseline_bl_mob_m5"]));       // src: vvaharness/rules/repo_kinds.py:63
            items.add(new Pair("BL-MOB-M8", θ["p.repo_kinds.baseline_bl_mob_m8"]));       // src: vvaharness/rules/repo_kinds.py:64
            items.add(new Pair("BL-MOB-M9", θ["p.repo_kinds.baseline_bl_mob_m9"]));       // src: vvaharness/rules/repo_kinds.py:65
        }
        if (kind == "native") {
            items.add(new Pair("BL-NAT-119", θ["p.repo_kinds.baseline_bl_nat_119"]));     // src: vvaharness/rules/repo_kinds.py:68
            items.add(new Pair("BL-NAT-416", θ["p.repo_kinds.baseline_bl_nat_416"]));     // src: vvaharness/rules/repo_kinds.py:69
            items.add(new Pair("BL-NAT-190", θ["p.repo_kinds.baseline_bl_nat_190"]));     // src: vvaharness/rules/repo_kinds.py:70
            items.add(new Pair("BL-NAT-134", θ["p.repo_kinds.baseline_bl_nat_134"]));     // src: vvaharness/rules/repo_kinds.py:71
            items.add(new Pair("BL-NAT-362", θ["p.repo_kinds.baseline_bl_nat_362"]));     // src: vvaharness/rules/repo_kinds.py:72
            items.add(new Pair("BL-NAT-78", θ["p.repo_kinds.baseline_bl_nat_78"]));       // src: vvaharness/rules/repo_kinds.py:73
        }
        if (kind == "iac") {
            items.add(new Pair("BL-IAC-IAM", θ["p.repo_kinds.baseline_bl_iac_iam"]));     // src: vvaharness/rules/repo_kinds.py:76
            items.add(new Pair("BL-IAC-NET", θ["p.repo_kinds.baseline_bl_iac_net"]));     // src: vvaharness/rules/repo_kinds.py:77
            items.add(new Pair("BL-IAC-SECRETS", θ["p.repo_kinds.baseline_bl_iac_secrets"]));// src: vvaharness/rules/repo_kinds.py:78
            items.add(new Pair("BL-IAC-PRIV", θ["p.repo_kinds.baseline_bl_iac_priv"]));   // src: vvaharness/rules/repo_kinds.py:79
            items.add(new Pair("BL-IAC-TLS", θ["p.repo_kinds.baseline_bl_iac_tls"]));     // src: vvaharness/rules/repo_kinds.py:80
        }
        if (kind == "library") {
            items.add(new Pair("BL-LIB-INJ", θ["p.repo_kinds.baseline_bl_lib_inj"]));     // src: vvaharness/rules/repo_kinds.py:83
            items.add(new Pair("BL-LIB-DESER", θ["p.repo_kinds.baseline_bl_lib_deser"])); // src: vvaharness/rules/repo_kinds.py:84
            items.add(new Pair("BL-LIB-PATH", θ["p.repo_kinds.baseline_bl_lib_path"]));   // src: vvaharness/rules/repo_kinds.py:85
            items.add(new Pair("BL-LIB-REDOS", θ["p.repo_kinds.baseline_bl_lib_redos"])); // src: vvaharness/rules/repo_kinds.py:86
        }
        if (kind == "web-template") {
            items.add(new Pair("BL-TPL-XSS", θ["p.repo_kinds.baseline_bl_tpl_xss"]));     // src: vvaharness/rules/repo_kinds.py:89
            items.add(new Pair("BL-TPL-SSTI", θ["p.repo_kinds.baseline_bl_tpl_ssti"]));   // src: vvaharness/rules/repo_kinds.py:90
            items.add(new Pair("BL-TPL-CSRF", θ["p.repo_kinds.baseline_bl_tpl_csrf"]));   // src: vvaharness/rules/repo_kinds.py:91
            items.add(new Pair("BL-TPL-SECRET", θ["p.repo_kinds.baseline_bl_tpl_secret"]));// src: vvaharness/rules/repo_kinds.py:92
        }        return items;
    }

    /** repo_kind: classify the repo from evidence; several kinds may apply, none -> library. */
    Set<String> repoKind(ThreatEvidence ev, ContextPackage ctx, Theta θ) {
        Set<String> kinds = new Set();
        List<String> allFiles = ctx != null ? ctx.allFiles.lower() : List.of();                // src: vvaharness/rules/repo_kinds.py:99
        String manifestText = ev.manifests.bodies().join("\n");                                // src: vvaharness/rules/repo_kinds.py:100
        Set<String> langs = Set.of(ev.primaryLanguage).union(ev.languages);                    // src: vvaharness/rules/repo_kinds.py:102
        Set<String> nonTemplateLangs = langs.minus(Set.of("", "web-template"));                // src: vvaharness/rules/repo_kinds.py:104
        boolean entrypointOrArtefact = ev.entryPoints.anyMatch(k -> k == "network" || k == "framework") || !ev.apiArtefacts.isEmpty(); // src: vvaharness/rules/repo_kinds.py:106
        boolean manifestWebFw = Regex.search(θ["p.repo_kinds.web_framework_regex"], manifestText); // src: vvaharness/rules/repo_kinds.py:109
        // An all-template tree is scaffolding even if a manifest names a framework
        boolean templateDominated = !allFiles.isEmpty() && nonTemplateLangs.isEmpty() && allFiles.anyMatch(f -> LangDetect.isWebTemplate(f)); // src: vvaharness/rules/repo_kinds.py:111
        if (entrypointOrArtefact || (manifestWebFw && !templateDominated)) kinds.add("web-api"); // src: vvaharness/rules/repo_kinds.py:114
        else if (templateDominated) kinds.add("web-template");                                 // src: vvaharness/rules/repo_kinds.py:116
        if (allFiles.anyMatch(f -> f.endsWithAny("androidmanifest.xml", "info.plist", "podfile")) || Regex.search("com.android", manifestText)) kinds.add("mobile"); // src: vvaharness/rules/repo_kinds.py:119
        if (allFiles.anyMatch(f -> LangDetect.isIacFile(f))) kinds.add("iac");                // src: vvaharness/rules/repo_kinds.py:124
        if (langs.intersects(θ["p.repo_kinds.native_langs"])) kinds.add("native");            // src: vvaharness/rules/repo_kinds.py:127
        if (kinds.isEmpty()) kinds.add(θ["p.repo_kinds.default_kind_library"]);               // src: vvaharness/rules/repo_kinds.py:130
        return kinds;
    }
}
