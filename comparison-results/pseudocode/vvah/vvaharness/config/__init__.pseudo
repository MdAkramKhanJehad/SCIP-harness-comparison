// file: vvaharness/config/__init__.py
// Config loading: profile YAML (the operator's --config, ./config.yaml or a packaged profile) deep-merged over the built-in
// step defaults (STEP_DEFAULTS: profile value wins over the defaults table, which wins over a call-site getattr fallback),
// then an optional trusted config.local.yaml overlay (merge made visible, never silent), then dollar-brace VAR expansion with a secret-name policy.
// The defaults table itself is data: each registered default is the builtin layer of the matching knob and is read as theta where it acts.

@executedBy(CODE) @role(types)
@src("vvaharness/config/__init__.py:40")
class ConfigPolicyError extends ValueError {
    // refusal to load a config that violates the interpolation or overlay-trust policy
}

@executedBy(CODE) @role(types)
@src("vvaharness/config/__init__.py:44")
class ConfigPathError extends ConfigPolicyError {
    // the --config path itself is unusable: missing, a directory, or unreadable. A subclass (not a sibling) so every existing
    // catch of ConfigPolicyError reports it clearly with no change of its own.
}

@executedBy(CODE) @role(config)
class Config {

    /** Thin attribute wrapper over the YAML dict: cfg.models.deepdive etc. Dunder probes and the data slot itself raise AttributeError (guards recursion during deepcopy); a missing key raises AttributeError; a dict value comes back wrapped. */
    @src("vvaharness/config/__init__.py:101")
    Object getattr(String name) {
        if ((name.startsWith("__") && name.endsWith("__")) || name == "_data") throw new AttributeError(name); // src: vvaharness/config/__init__.py:105
        Map data = this.dict.get("_data");                                                                  // src: vvaharness/config/__init__.py:107
        Object v;
        try {
            v = data.get(name);                                                                             // src: vvaharness/config/__init__.py:109
        } catch (KeyError | TypeError e) {
            throw new AttributeError(name);                                                                 // src: vvaharness/config/__init__.py:111
        }
        return v instanceof Map ? new Config(v) : v;                                                        // src: vvaharness/config/__init__.py:112
    }

    /** cfg[k]: the raw dict entry (no wrapping). */
    @src("vvaharness/config/__init__.py:114")
    Object getitem(String k) {
        return this.data.get(k);                                                                            // src: vvaharness/config/__init__.py:115
    }

    /** Expand one VAR-in-dollar-braces with optional colon-dash default match. A secret-named variable may expand only into the CREDENTIAL_DESTINATIONS keys; refused on the NAME alone, set or unset, so a profile fails the same way on every machine. */
    @src("vvaharness/config/__init__.py:61")
    String expandEnv(Match m, List<String> path) {
        String name = m.group(1); String dflt = m.group(2);                                                 // src: vvaharness/config/__init__.py:62
        String keyPath = path.join(".");                                                                    // src: vvaharness/config/__init__.py:63
        if (Constants.isSecretVarName(name) && !Constants.CREDENTIAL_DESTINATIONS.contains(keyPath)) {      // src: vvaharness/config/__init__.py:66
            throw new ConfigPolicyError("config key interpolates a secret-named environment variable outside the allowed destination keys"); // src: vvaharness/config/__init__.py:68
        }
        // POSIX VAR-in-dollar-braces with colon-dash default: the default applies when VAR is unset OR set-but-empty
        String val = Os.environ.get(name);                                                                  // src: vvaharness/config/__init__.py:75
        if (val != null && !val.isEmpty()) return val;                                                      // src: vvaharness/config/__init__.py:76
        return dflt != null ? dflt : "";                                                                    // src: vvaharness/config/__init__.py:78
    }

    /** Recursive expansion: strings substitute, dicts and lists recurse with the key path, everything else passes through. */
    @src("vvaharness/config/__init__.py:81")
    Object expand(Object val, List<String> path) {
        if (val instanceof String) return Regex.sub(DOLLAR_BRACE_VAR_PATTERN, m -> expandEnv(m, path), val); // pattern: variable name, optional :- default // src: vvaharness/config/__init__.py:83
        if (val instanceof Map) return val.mapValues((k, v) -> expand(v, path + List.of(k.toString())));  // src: vvaharness/config/__init__.py:85
        if (val instanceof List) return val.map(v -> expand(v, path));                                      // src: vvaharness/config/__init__.py:87
        return val;                                                                                         // src: vvaharness/config/__init__.py:88
    }

    /** Dict-preserving wrapper over expand for the whole config tree. */
    @src("vvaharness/config/__init__.py:91")
    Map expandTree(Map tree, List<String> path) {
        return tree.mapValues((k, v) -> expand(v, path + List.of(k.toString())));                           // src: vvaharness/config/__init__.py:93
    }

    /** Deep merge: dicts recurse, everything else (lists included) is replaced by the overlay value. */
    @src("vvaharness/config/__init__.py:121")
    Map deepMerge(Map base, Map over) {
        Map out = base.copy();                                                                              // src: vvaharness/config/__init__.py:122
        for (Entry e : over) {                                                                              // src: vvaharness/config/__init__.py:123
            if (e.value instanceof Map && out.get(e.key) instanceof Map) out.put(e.key, deepMerge(out.get(e.key), e.value)); // src: vvaharness/config/__init__.py:124
            else out.put(e.key, e.value);                                                                   // src: vvaharness/config/__init__.py:127
        }
        return out;                                                                                         // src: vvaharness/config/__init__.py:128
    }

    /** POSIX trust gate for the overlay: owned by the effective user or root, and not group or world writable. A file swapped in through a writable parent is attacker-owned and already fails the UID check. */
    @src("vvaharness/config/__init__.py:716")
    boolean localOverlayTrusted(Path path) {
        Stat st;
        try {
            st = path.stat();                                                                               // src: vvaharness/config/__init__.py:719
        } catch (OSError e) {
            return false;                                                                                   // src: vvaharness/config/__init__.py:721
        }
        Integer euid = Os.geteuidOrNull();                                                                  // src: vvaharness/config/__init__.py:722
        if (euid != null && st.uid != euid && st.uid != 0) return false;                                    // src: vvaharness/config/__init__.py:725
        return euid == null || (st.mode & (GROUP_WRITE | OTHER_WRITE)) == 0;                                // src: vvaharness/config/__init__.py:727
    }

    /** Raise unless the overlay passes the POSIX trust gate; on a non-POSIX platform log once instead (ownership unverified). */
    @src("vvaharness/config/__init__.py:730")
    void requireOverlayTrust(Path local, boolean logOverlay) {
        if (Os.geteuidOrNull() == null) {                                                                   // src: vvaharness/config/__init__.py:732
            if (logOverlay) Console.write("config overlay ownership unverified (non-POSIX platform)");      // src: vvaharness/config/__init__.py:733
            return;                                                                                         // src: vvaharness/config/__init__.py:736
        }
        if (!localOverlayTrusted(local)) throw new ConfigPolicyError("config overlay is not trusted: it must be owned by the invoking user (or root) and not group/world-writable; or set VVAHARNESS_NO_LOCAL_CONFIG to skip it"); // src: vvaharness/config/__init__.py:737
    }

    /** Trust-check and read config.local.yaml: (mapping, logged-flag), or (null, ...) when absent or skipped. The overlay path is announced once per process per unique file. */
    @src("vvaharness/config/__init__.py:746")
    Pair<Map, Boolean> localOverlay(Path local, Theta θ) {
        if (!local.exists()) return Pair.of(null, false);                                                   // src: vvaharness/config/__init__.py:748
        String key = local.resolve().toString();                                                            // src: vvaharness/config/__init__.py:750
        boolean logOverlay = !loggedOverlays.contains(key);                                                 // src: vvaharness/config/__init__.py:751
        loggedOverlays.add(key);                                                                            // src: vvaharness/config/__init__.py:752
        if (θ["env.VVAHARNESS_NO_LOCAL_CONFIG"] != null && !θ["env.VVAHARNESS_NO_LOCAL_CONFIG"].isEmpty()) { // any non-empty value skips the overlay // src: vvaharness/config/__init__.py:753
            if (logOverlay) Console.write("config overlay present but SKIPPED (VVAHARNESS_NO_LOCAL_CONFIG set)"); // src: vvaharness/config/__init__.py:754
            return Pair.of(null, logOverlay);                                                               // src: vvaharness/config/__init__.py:757
        }
        requireOverlayTrust(local, logOverlay);                                                             // src: vvaharness/config/__init__.py:758
        Object over = Yaml.safeLoad(local.readText());                                                      // src: vvaharness/config/__init__.py:759
        if (over == null) over = new Map();
        if (!(over instanceof Map)) throw new ValueError("config overlay must be a YAML mapping");          // ValueError, not TypeError: the loader's YAML-shape refusal contract // src: vvaharness/config/__init__.py:760
        return Pair.of(over, logOverlay);                                                                   // src: vvaharness/config/__init__.py:764
    }

    /** Dotted key paths of every leaf (non-dict, or empty dict) value in a nested mapping. */
    @src("vvaharness/config/__init__.py:767")
    List<String> leafPaths(Map tree, List<String> prefix) {
        List<String> out = new List();                                                                      // src: vvaharness/config/__init__.py:769
        for (Entry e : tree) {                                                                              // src: vvaharness/config/__init__.py:770
            List<String> path = prefix + List.of(e.key.toString());                                         // src: vvaharness/config/__init__.py:771
            if (e.value instanceof Map && !e.value.isEmpty()) out.addAll(leafPaths(e.value, path));         // src: vvaharness/config/__init__.py:772
            else out.add(path.join("."));                                                                   // src: vvaharness/config/__init__.py:775
        }
        return out;                                                                                         // src: vvaharness/config/__init__.py:776
    }

    /** The value at a dotted path in the resolved tree, or null when a segment is missing or a non-dict is hit. */
    @src("vvaharness/config/__init__.py:779")
    Object resolvedLeaf(Map data, String path) {
        Object node = data;                                                                                 // src: vvaharness/config/__init__.py:780
        for (String seg : path.split(".")) {                                                                // src: vvaharness/config/__init__.py:781
            if (!(node instanceof Map)) return null;                                                        // src: vvaharness/config/__init__.py:782
            node = node.get(seg);                                                                           // src: vvaharness/config/__init__.py:784
        }
        return node;                                                                                        // src: vvaharness/config/__init__.py:785
    }

    /** host or host:port of an endpoint value, never its userinfo, never its path. SECURITY: the banner prints POST-expansion values on every command, so an embedded credential must not echo into CI logs. A scheme-less value is re-parsed as an authority. */
    @src("vvaharness/config/__init__.py:788")
    String endpointDisplay(Object value) {
        String raw = (value == null ? "" : value.toString()).strip();                                       // src: vvaharness/config/__init__.py:799
        if (raw.isEmpty()) return "(unset)";                                                                // src: vvaharness/config/__init__.py:801
        String host; Integer port;
        try {
            Url parts = Url.split(raw.contains("//") ? raw : "//" + raw);                                   // src: vvaharness/config/__init__.py:803
            host = parts.hostname; port = parts.port;                                                       // src: vvaharness/config/__init__.py:804
        } catch (ValueError e) {
            return "(unparseable)";                                                                         // malformed authority or bad port // src: vvaharness/config/__init__.py:806
        }
        if (host == null || host.isEmpty()) return "(unparseable)";                                         // src: vvaharness/config/__init__.py:807
        return port != null && port != 0 ? host + ":" + port : host;                                        // src: vvaharness/config/__init__.py:809
    }

    /** One overlay override rendered with the visibility its value class allows: credential keys show set/unset only, endpoint keys show the host only, TLS-routing keys show the value, anything else just the path. */
    @src("vvaharness/config/__init__.py:812")
    String overrideEntry(String path, Map resolved) {
        Object value = resolvedLeaf(resolved, path);                                                        // src: vvaharness/config/__init__.py:814
        if (Constants.CREDENTIAL_DESTINATIONS.contains(path)) return path + (value != null && !value.toString().isEmpty() ? " (set)" : " (unset)"); // src: vvaharness/config/__init__.py:815
        if (Constants.ENDPOINT_KEYS.contains(path)) return path + " -> " + endpointDisplay(value);          // urlsplit locally: config must not import orchestrator // src: vvaharness/config/__init__.py:817
        if (Constants.TLS_ROUTING_KEYS.contains(path) || Constants.TLS_ROUTING_KEYS.contains(path.rsplit(".", 1).last())) return path + "=" + value; // src: vvaharness/config/__init__.py:820
        return path;                                                                                        // src: vvaharness/config/__init__.py:823
    }

    /** Per-class banner entries for the overlay's leaf key paths, sorted. */
    @src("vvaharness/config/__init__.py:827")
    List<String> overlayOverrideEntries(List<String> leaves, Map resolved) {
        return leaves.sorted().map(path -> overrideEntry(path, resolved));                                  // src: vvaharness/config/__init__.py:829
    }

    /** Extra text naming the directory a relative path resolved against; empty for an absolute path. */
    @src("vvaharness/config/__init__.py:832")
    String pathContext(Path p) {
        if (p.isAbsolute()) return "";                                                                      // src: vvaharness/config/__init__.py:834
        return " (resolved: " + p.resolve() + ", cwd: " + Path.cwd() + ")";                                 // src: vvaharness/config/__init__.py:836
    }

    /** Read the primary configuration without overlays or environment expansion. Validates the path itself first, so a bad --config reports clearly instead of a raw FileNotFoundError or parser traceback. */
    @src("vvaharness/config/__init__.py:839")
    Map readPrimary(String path) {
        Path p = Path.of(path);                                                                             // src: vvaharness/config/__init__.py:841
        if (!p.exists()) throw new ConfigPathError("config not found: " + p + pathContext(p));              // src: vvaharness/config/__init__.py:845
        if (!p.isFile()) throw new ConfigPathError("config path is not a file: " + p + pathContext(p));     // src: vvaharness/config/__init__.py:847
        if (!Os.access(p, READ)) throw new ConfigPathError("config is not readable: " + p + pathContext(p)); // src: vvaharness/config/__init__.py:849
        Object raw;
        try {
            raw = Yaml.safeLoad(p.readText());                                                              // safe_load gives null for an empty or all-comments file: treated as an empty mapping // src: vvaharness/config/__init__.py:854
            if (raw == null) raw = new Map();
        } catch (YAMLError e) {
            throw new ConfigPathError("config is not valid YAML: names the file, no raw parser traceback"); // src: vvaharness/config/__init__.py:859
        } catch (UnicodeDecodeError e) {
            throw new ConfigPathError("config is not valid UTF-8");                                         // src: vvaharness/config/__init__.py:862
        }
        if (!(raw instanceof Map)) throw new ConfigPathError("config must be a YAML mapping");              // src: vvaharness/config/__init__.py:863
        return raw;                                                                                         // src: vvaharness/config/__init__.py:865
    }

    /** load(): builtin defaults < profile < config.local.yaml (unless VVAHARNESS_NO_LOCAL_CONFIG); refusal_retries checked as an int 0..1. The overlay resolves next to the --config path (operator-controlled), never the scanned target. */
    @src("vvaharness/config/__init__.py:868")
    Config load(String path, Theta θ) {
        Path p = Path.of(path);                                                                             // src: vvaharness/config/__init__.py:869
        Map raw = readPrimary(path);                                                                        // must exist, be a file, readable, a YAML mapping // src: vvaharness/config/__init__.py:870
        raw = deepMerge(STEP_DEFAULTS, raw);                                                                // user values win over the builtin defaults table // src: vvaharness/config/__init__.py:873
        Path local = p.withName("config.local.yaml");                                                       // src: vvaharness/config/__init__.py:884
        Pair<Map, Boolean> ol = localOverlay(local, θ);                                                     // only when owner-trusted and not group/world writable // src: vvaharness/config/__init__.py:885
        if (ol.first != null) raw = deepMerge(raw, ol.first);                                               // overlay wins over the profile // src: vvaharness/config/__init__.py:887
        Map data = expandTree(raw, List.of());                                                              // VAR-in-dollar-braces, with optional colon-dash default; secret-named variables restricted // src: vvaharness/config/__init__.py:888
        checkRefusalRetries(data.get("refusal_retries"), p, θ);                                             // int 0..1 or ConfigPolicyError // src: vvaharness/config/__init__.py:889
        // banner AFTER expansion so endpoint and TLS entries show resolved values
        if (ol.first != null && ol.second) {                                                                // src: vvaharness/config/__init__.py:891
            String overrides = overlayOverrideEntries(leafPaths(ol.first, List.of()), data).join(", ");     // src: vvaharness/config/__init__.py:892
            Console.write("config overlay applied (overrides: " + (overrides.isEmpty() ? "(empty)" : overrides) + ")"); // src: vvaharness/config/__init__.py:893
        }
        Config cfg = new Config(data);                                                                      // src: vvaharness/config/__init__.py:895
        cfg.data.put("_config_dir", p.resolve().parent().toString());                                       // input-style paths (policy_file, TLS cert paths) resolve against it // src: vvaharness/config/__init__.py:899
        return cfg;                                                                                         // src: vvaharness/config/__init__.py:900
    }

    /** Refuse a refusal_retries that is not an int in 0..max (null keeps the default). A bool is an int subclass: true must not read as 1. */
    @src("vvaharness/config/__init__.py:907")
    void checkRefusalRetries(Object value, Path p, Theta θ) {
        if (value == null || (value instanceof Integer && !(value instanceof Boolean) && 0 <= value && value <= θ["code.config.refusal_retries_max"])) return; // src: vvaharness/config/__init__.py:910
        throw new ConfigPolicyError("config: refusal_retries must be an integer from 0 to the cap; each extra resend repeats a prompt the model already refused"); // src: vvaharness/config/__init__.py:913
    }

    /** Deep merge where dicts recurse and everything else (lists included) REPLACES: the latest overlay's lists win outright instead of accumulating. */
    @src("vvaharness/config/__init__.py:918")
    Map replaceMerge(Map base, Map over) {
        Map out = base.copy();                                                                              // src: vvaharness/config/__init__.py:922
        for (Entry e : over) {                                                                              // src: vvaharness/config/__init__.py:923
            Object cur = out.get(e.key);                                                                    // src: vvaharness/config/__init__.py:924
            if (e.value instanceof Map && cur instanceof Map) out.put(e.key, replaceMerge(cur, e.value));   // src: vvaharness/config/__init__.py:925
            else out.put(e.key, e.value);                                                                   // src: vvaharness/config/__init__.py:928
        }
        return out;                                                                                         // src: vvaharness/config/__init__.py:929
    }

    /** step1 overlay merge: top-level lists (exclude_dirs, exclude_exts, exclude_globs) APPEND (de-duplicated, order kept) so per-app files add to the global baseline; nested dicts switch to replaceMerge so config_dedup values come from the latest overlay. */
    @src("vvaharness/config/__init__.py:932")
    Map appendMerge(Map base, Map over) {
        Map out = base.copy();                                                                              // src: vvaharness/config/__init__.py:937
        for (Entry e : over) {                                                                              // src: vvaharness/config/__init__.py:938
            Object cur = out.get(e.key);                                                                    // src: vvaharness/config/__init__.py:939
            if (e.value instanceof Map && cur instanceof Map) out.put(e.key, replaceMerge(cur, e.value));   // src: vvaharness/config/__init__.py:940
            else if (e.value instanceof List && cur instanceof List) out.put(e.key, cur + e.value.filter(x -> !cur.contains(x))); // src: vvaharness/config/__init__.py:942
            else out.put(e.key, e.value);                                                                   // src: vvaharness/config/__init__.py:945
        }
        return out;                                                                                         // src: vvaharness/config/__init__.py:946
    }

    /** Layer a per-scan step1 file on top of cfg.step1: either a bare-key file or one wrapped in a top-level step1 block. Lists append, scalars replace. Returns (cfg, applied). expand=false keeps dollar-brace placeholders literal: the LLM-authored auto-step1 overlay must never reach the operator's environment. */
    @src("vvaharness/config/__init__.py:969")
    Pair<Config, Boolean> applyStep1Overlay(Config cfg, Object path, boolean expand, Theta θ) {
        Path p = Path.of(path);                                                                             // src: vvaharness/config/__init__.py:976
        // refuse network/UNC paths before the first filesystem touch: on Windows that touch would leak the NTLM hash via SMB
        if (isNetworkPath(p.toString())) throw new ValueError("step1 overlay must be a local path; refusing network/UNC path"); // src: vvaharness/config/__init__.py:979
        if (!p.isFile()) return Pair.of(cfg, false);                                                        // a missing overlay is simply not applied // src: vvaharness/config/__init__.py:983
        long size = p.stat().size;                                                                          // src: vvaharness/config/__init__.py:985
        // a wrong path is one typo away from a report, a binary, or a multi-MB YAML: cap the read
        if (size > θ["code.config.step1_overlay_max_bytes"]) throw new ValueError("step1 overlay exceeds the byte limit; check this is the intended overlay file"); // 1 MiB // src: vvaharness/config/__init__.py:986
        String text;
        try {
            text = p.readText();                                                                            // src: vvaharness/config/__init__.py:992
        } catch (UnicodeDecodeError e) {
            throw new ValueError("step1 overlay is not valid UTF-8 text");                                  // src: vvaharness/config/__init__.py:994
        }
        Object over;
        try {
            over = Yaml.safeLoad(text);                                                                     // src: vvaharness/config/__init__.py:998
            if (over == null) over = new Map();
        } catch (YAMLError e) {
            throw new ValueError("step1 overlay is not valid YAML");                                        // src: vvaharness/config/__init__.py:1000
        }
        if (!(over instanceof Map)) throw new ValueError("step1 overlay must be a YAML mapping");           // src: vvaharness/config/__init__.py:1002
        if (over.keys().equals(Set.of("step1")) && over.get("step1") instanceof Map) over = over.get("step1"); // unwrap a top-level step1 block // src: vvaharness/config/__init__.py:1003
        over = expand ? expandTree(over, List.of("step1")) : over;                                          // src: vvaharness/config/__init__.py:1005
        Map base1 = cfg.data.get("step1") != null ? cfg.data.get("step1") : new Map();                      // src: vvaharness/config/__init__.py:1006
        cfg.data.put("step1", appendMerge(base1, over));                                                    // src: vvaharness/config/__init__.py:1007
        return Pair.of(cfg, true);                                                                          // src: vvaharness/config/__init__.py:1008
    }

    /** UNC / network paths are refused before any filesystem access. Evaluated with a Windows path model so the result is identical on every OS: a leading double backslash or double slash, or a drive that renders as a UNC share. */
    @src("vvaharness/config/__init__.py:949")
    boolean isNetworkPath(String path) {
        String s = path.strip();                                                                            // src: vvaharness/config/__init__.py:956
        if (s.startsWith("\\\\") || s.startsWith("//")) return true;                                        // src: vvaharness/config/__init__.py:957
        return PureWindowsPath.of(s).drive.startsWith("\\\\");                                              // UNC drives render as a double-backslash host; local drives as C: // src: vvaharness/config/__init__.py:960
    }

    Config deepCopy() {
        return new Config(this.data.deepCopy());                                                            // src: vvaharness/orchestrator/scan.py:496
    }

    /** Per-role reasoning tier; the real function is orchestrator/config_paths.py role_effort (ConfigPaths.roleEffort), kept here for callers that reach it through Config. */
    Effort roleEffort(Config cfg, String role) {
        return ConfigPaths.roleEffort(cfg, role, null);                                                     // src: vvaharness/orchestrator/config_paths.py:165
    }
}
