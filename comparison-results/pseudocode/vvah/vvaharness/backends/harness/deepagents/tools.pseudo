// file: vvaharness/backends/harness/deepagents/tools.py
// Logical -> native tool-name resolution for the DeepAgents backend, the session-tool permit set (fails closed
// on native-name collisions) and build_tools (returns no tools: natives come from the filesystem middleware).

@executedBy(CODE) @role(tool)
class DeepagentsTools {
    static Set<String> WARNED_UNKNOWN_TOOLS = new Set();

    // Logical names deliberately absent from LOGICAL_TO_NATIVE.
    Set<String> unmappedByDesign(Theta θ) {
        return HarnessModels.orchestrationTools(θ).union(HarnessModels.mutatingTools(θ));                // src: vvaharness/backends/harness/deepagents/tools.py:39
    }

    // WARN once per allow-listed name that maps to no tool; never raises (a typo must not abort a scan).
    void warnUnknownTools(StreamingOptions options, Set<String> allowed, Theta θ) {
        Set<String> known = HarnessModels.logicalToNative(θ).keySet().union(unmappedByDesign(θ)).union(options.base.factTools); // src: vvaharness/backends/harness/deepagents/tools.py:48
        for (String name : sorted(allowed.minus(known))) {                                               // src: vvaharness/backends/harness/deepagents/tools.py:49
            if (name.startsWith(HarnessModels.mcpToolPrefix(θ))) continue;                               // src: vvaharness/backends/harness/deepagents/tools.py:50
            WarnOnce.warnOnce(WARNED_UNKNOWN_TOOLS, name, "WARN [deepagents]: unrecognised tool name in the allow-list -- it maps to no tool on this backend and is ignored"); // src: vvaharness/backends/harness/deepagents/tools.py:52
        }
    }

    // Explicit allowed_tools wins, else the session's tool policy (empty when none).
    Set<String> allowedToolNames(StreamingOptions options, List<String> allowedTools) {
        ToolPolicy policy = options.base.toolPolicy != null ? options.base.toolPolicy : new ToolPolicy(List.of(), List.of()); // src: vvaharness/backends/harness/deepagents/tools.py:64
        return new Set(allowedTools != null ? allowedTools : policy.allowedTools);                       // src: vvaharness/backends/harness/deepagents/tools.py:65
    }

    List<String> nativeToolNames(StreamingOptions options, List<String> allowedTools, Theta θ) {
        Set<String> allowed = allowedToolNames(options, allowedTools);                                   // src: vvaharness/backends/harness/deepagents/tools.py:72
        warnUnknownTools(options, allowed, θ);                                                           // src: vvaharness/backends/harness/deepagents/tools.py:73
        List<String> out = new List();
        for (String logical : HarnessModels.logicalToNative(θ).keySet()) {                               // src: vvaharness/backends/harness/deepagents/tools.py:74
            if (allowed.contains(logical)) out.add(HarnessModels.logicalToNative(θ).get(logical));       // src: vvaharness/backends/harness/deepagents/tools.py:75
        }
        return out;
    }

    // Names of caller-built session tools for the executor permit set; fails closed on a native-name collision.
    Set<String> sessionToolNames(List<Tool> tools, Theta θ) {
        Set<String> names = tools.map(t -> t.name).filter(n -> n instanceof String);   // nameless entries drop // src: vvaharness/backends/harness/deepagents/tools.py:86
        Set<String> reserved = names.intersect(DeepagentsModels.allNativeTools(θ));                      // src: vvaharness/backends/harness/deepagents/tools.py:91
        if (!reserved.isEmpty()) {                                                                       // src: vvaharness/backends/harness/deepagents/tools.py:92
            throw new ValueError("session tool names collide with reserved native tool names; permitting a native via a session tool would bypass the executor-seam gate"); // src: vvaharness/backends/harness/deepagents/tools.py:93
        }
        return names;
    }

    // Natives come from middleware, so nothing is built here; the unknown-name WARN repeats on this prod path.
    List<Tool> buildTools(StreamingOptions options, List<String> allowedTools, Theta θ) {
        warnUnknownTools(options, allowedToolNames(options, allowedTools), θ);                           // src: vvaharness/backends/harness/deepagents/tools.py:108
        return List.of();                                                                                // src: vvaharness/backends/harness/deepagents/tools.py:109
    }
}
