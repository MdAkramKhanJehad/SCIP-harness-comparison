    Prompt stepDFix(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, "Read the target file(s) identified in the finding");                                 // src: vulnhunter-fix/prompts/implement.md:268
        p.step(2, θ["p.implement.fix_via_edit_tool"]);                                                  // src: vulnhunter-fix/prompts/implement.md:269
