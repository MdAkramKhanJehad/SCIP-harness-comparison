// file: vulnhunt/phases/phase3_reproduce_test.md
// Phase 3a/3b: assign VULN-NNN ids, write one PoC per CONFIRMED finding (runnable or static trace),
// then one exploit test per finding; test outcome decides confirm / Code Smell / Potential / eliminate.

@executedBy(MODEL) @role(prompt) @stage("phase3")
class Phase3ReproduceTest {

    // ---------------------------------------------------------------- prompt sections

    Prompt outputDestinations(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase3_reproduce_test.exact_output_locations_not_prompt_names"]) p.forbid("do NOT name files after a prompt (phase3c_fixes.md, phase3_reproduce_test.md)"); // src: vulnhunt/phases/phase3_reproduce_test.md:9
        p.format(θ["p.phase3_reproduce_test.poc_output_path"]);                            // src: vulnhunt/phases/phase3_reproduce_test.md:13
        p.format(θ["p.phase3_reproduce_test.exploit_test_output_path"]);                   // src: vulnhunt/phases/phase3_reproduce_test.md:14
        p.format(θ["p.phase3_reproduce_test.phase_summary_contents"]);                     // src: vulnhunt/phases/phase3_reproduce_test.md:15
        p.format(θ["p.phase3_reproduce_test.phase_summary_filename"]);                     // src: vulnhunt/phases/phase3_reproduce_test.md:17
        return p;
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context("Phase 2b complete; CONFIRMED findings only; Operating Principles and Investigation Discipline in effect"); // src: vulnhunt/phases/phase3_reproduce_test.md:3
        p.include(outputDestinations(θ));
        p.choose(θ["prompt.poc_format"]);                                                  // src: vulnhunt/phases/phase3_reproduce_test.md:44
        if (θ["prompt.exploit_test.enabled"]) p.must("Phase 3b: Exploit Test (MANDATORY - DO NOT SKIP)"); // src: vulnhunt/phases/phase3_reproduce_test.md:109
        p.rule(θ["prompt.exploit_test.execution"]);                                        // src: vulnhunt/phases/phase3_reproduce_test.md:194
        p.choose(θ["prompt.exploit_test.outcomes"]);                                       // src: vulnhunt/phases/phase3_reproduce_test.md:192
        if (θ["prompt.code_smell_section"]) p.format("Code Smells go to a separate Code Quality / Defense in Depth section"); // src: vulnhunt/phases/phase3_reproduce_test.md:206
        if (θ["prompt.exploit_test.poc_before_code_smell"]) p.must("Exploitation attempt before classifying as Code Smell"); // src: vulnhunt/phases/phase3_reproduce_test.md:211
        p.rule(θ["prompt.exploit_test.config_provable"]);                                  // src: vulnhunt/phases/phase3_reproduce_test.md:231
        return p;
    }

    // ---------------------------------------------------------------- procedure

    @executedBy(MODEL)
    Phase3Result run(VerifyOutcome phase2b, KickoffPrompt kickoff, Theta θ) {
        AssignmentTable ids = completenessCheck(phase2b, θ);
        List<Poc> pocs = new List();
        for (Assignment a : ids.rows()) {
            if (a.isSubsumedByPlatform() && θ["p.phase3_reproduce_test.no_per_endpoint_pocs_for_subsumed"]) continue; // src: vulnhunt/phases/phase3_reproduce_test.md:40
            if (θ["p.phase3_reproduce_test.poc_per_confirmed_vulnerability"]) pocs.add(Phase3aReproduce.reproduce(a, kickoff, θ)); // src: vulnhunt/phases/phase3_reproduce_test.md:35
        }
        ExploitTable tests = Phase3bExploitTest.run(pocs, kickoff, θ);
        enforceEveryRowCovered(ids, pocs, tests, θ);
        List<Finding> toFixes = tests.passed();
        if (!θ["p.phase3_reproduce_test.only_pass_proceeds_to_3c"]) toFixes = tests.all(); // src: vulnhunt/phases/phase3_reproduce_test.md:249
        List<FixStrategy> fixes = Phase3cFixes.run(toFixes, θ);
        writeFile(θ["p.phase3_reproduce_test.phase_summary_filename"], ids, fixes);        // src: vulnhunt/phases/phase3_reproduce_test.md:17
        return new Phase3Result(ids, pocs, tests, fixes, tests.codeSmells());
    }

    // Pre-Phase 3 Completeness Check
    @executedBy(MODEL)
    AssignmentTable completenessCheck(VerifyOutcome phase2b, Theta θ) {
        List<Finding> eligible = phase2b.confirmed().filter(f -> θ["prompt.scope.phase3_severity_floor"].contains(f.severity)); // src: vulnhunt/phases/phase3_reproduce_test.md:22
        AssignmentTable t = new AssignmentTable(θ["p.phase3_reproduce_test.assignment_table_columns"]); // src: vulnhunt/phases/phase3_reproduce_test.md:25
        if (θ["p.phase3_reproduce_test.assignment_table_before_any_poc"]) {                // src: vulnhunt/phases/phase3_reproduce_test.md:22
            int n = 1;
            for (Finding f : eligible) t.add(String.format("VULN-%03d", n++), f.phase2bIndex, f.title, f.severity);
        }
        if (θ["p.phase3_reproduce_test.assignment_row_count_equals_confirmed"] && t.rows() < eligible.size()) t.addMissing(eligible); // src: vulnhunt/phases/phase3_reproduce_test.md:28
        return t;
    }

    @executedBy(MODEL)
    void enforceEveryRowCovered(AssignmentTable ids, List<Poc> pocs, ExploitTable tests, Theta θ) {
        for (Assignment a : ids.rows()) {
            if (θ["p.phase3_reproduce_test.every_row_gets_poc_and_test"] && (!pocs.has(a) || !tests.has(a)) && !a.isSubsumedByPlatform()) writePocAndTest(a); // src: vulnhunt/phases/phase3_reproduce_test.md:29
            if (θ["p.phase3_reproduce_test.no_removal_without_fail_verdict"] && a.removed() && tests.resultOf(a) != FAIL) a.restore(); // src: vulnhunt/phases/phase3_reproduce_test.md:30
        }
    }
}

@executedBy(MODEL) @role(step) @stage("phase3a")
class Phase3aReproduce {

    @executedBy(MODEL)
    Poc reproduce(Assignment a, KickoffPrompt kickoff, Theta θ) {
        Poc poc;
        if (a.isPlatformFinding()) {                                                       // src: vulnhunt/phases/phase3_reproduce_test.md:38
            Endpoint rep = a.representativeEndpoints().take(θ["p.phase3_reproduce_test.platform_finding_single_poc_and_test"]); // src: vulnhunt/phases/phase3_reproduce_test.md:39
            a = a.restrictTo(rep);
        }
        boolean bash = kickoff.says("Bash is AVAILABLE for exploit-test execution");       // src: vulnhunt/phases/phase3_reproduce_test.md:47
        if (bash || !θ["p.phase3_reproduce_test.runnable_poc_requires_bash_flag"]) {       // src: vulnhunt/phases/phase3_reproduce_test.md:46
            poc = runnablePoc(a);                                                          // src: vulnhunt/phases/phase3_reproduce_test.md:52
        } else if (θ["p.phase3_reproduce_test.static_trace_only_without_bash"]) {          // src: vulnhunt/phases/phase3_reproduce_test.md:48
            poc = staticTrace(a, θ);
        } else {
            poc = staticTrace(a, θ);
        }
        validate(poc, a, θ);
        return poc;
    }

    @executedBy(MODEL)
    Poc staticTrace(Assignment a, Theta θ) {
        Poc p = new Poc(a, "Static PoC");
        if (!θ["p.phase3_reproduce_test.static_poc_concrete_step_trace"]) return p;        // src: vulnhunt/phases/phase3_reproduce_test.md:68
        p.step(ENTRY, a.entry);                                                            // src: vulnhunt/phases/phase3_reproduce_test.md:74
        for (Hop h : a.propagationHops()) p.step(PROPAGATION, h);                          // src: vulnhunt/phases/phase3_reproduce_test.md:78
        p.step(SINK, a.sink);                                                              // src: vulnhunt/phases/phase3_reproduce_test.md:82
        p.step(IMPACT, a.impact);                                                          // src: vulnhunt/phases/phase3_reproduce_test.md:86
        if (θ["p.phase3_reproduce_test.static_poc_req_concrete_input"]) p.require(p.entry.concreteValue() != null); // src: vulnhunt/phases/phase3_reproduce_test.md:91
        if (θ["p.phase3_reproduce_test.static_poc_req_file_line_every_step"]) p.require(p.steps.all(s -> s.fileLine != null)); // src: vulnhunt/phases/phase3_reproduce_test.md:92
        if (θ["p.phase3_reproduce_test.static_poc_req_literal_sink_value"]) p.require(p.sink.literalValue() != null); // src: vulnhunt/phases/phase3_reproduce_test.md:93
        if (θ["p.phase3_reproduce_test.static_poc_req_concrete_impact"]) p.require(p.impact.isConcrete()); // src: vulnhunt/phases/phase3_reproduce_test.md:94
        return p;
    }

    // Phase 3a Validation
    @executedBy(MODEL)
    void validate(Poc poc, Assignment a, Theta θ) {
        if (θ["p.phase3_reproduce_test.poc_must_be_saved_to_file"]) writeFile(θ["p.phase3_reproduce_test.poc_output_path"], poc); // src: vulnhunt/phases/phase3_reproduce_test.md:99
        if (θ["p.phase3_reproduce_test.no_poc_file_not_confirmed"] && !poc.fileExists()) a.cannotReportAsConfirmed(); // src: vulnhunt/phases/phase3_reproduce_test.md:100
        if (θ["p.phase3_reproduce_test.poc_verify_call_chain_with_grep"]) {                // src: vulnhunt/phases/phase3_reproduce_test.md:102
            for (Hop h : poc.uncertainSteps()) grep(h);
        }
        if (θ["p.phase3_reproduce_test.poc_explain_execution_steps"]) poc.explainSteps();  // src: vulnhunt/phases/phase3_reproduce_test.md:104
        if (θ["p.phase3_reproduce_test.poc_describe_attacker_gain"]) poc.describeAttackerGain(); // src: vulnhunt/phases/phase3_reproduce_test.md:105
    }
}

@executedBy(MODEL) @role(step) @stage("phase3b")
class Phase3bExploitTest {

    @executedBy(MODEL)
    ExploitTable run(List<Poc> pocs, KickoffPrompt kickoff, Theta θ) {
        ExploitTable table = new ExploitTable(θ["p.phase3_reproduce_test.exploit_table_columns"]); // src: vulnhunt/phases/phase3_reproduce_test.md:244
        if (!θ["prompt.exploit_test.enabled"]) return table;                               // src: vulnhunt/phases/phase3_reproduce_test.md:109
        for (Poc poc : pocs) {
            if (!θ["p.phase3_reproduce_test.executable_end_to_end_test_per_finding"]) continue; // src: vulnhunt/phases/phase3_reproduce_test.md:111
            ExploitTest t = writeTest(poc, θ);
            TestResult r = (θ["prompt.exploit_test.execution"] == "mentally executed unless Bash is enabled" && !kickoff.bashEnabled()) ? mentallyExecute(t) : bash(t.command()); // src: vulnhunt/phases/phase3_reproduce_test.md:194
            table.add(poc.finding, t.name, r, applyOutcome(poc, t, r, θ));
        }
        if (θ["p.phase3_reproduce_test.present_exploit_table_before_fixes"]) showUser(table); // src: vulnhunt/phases/phase3_reproduce_test.md:242
        return table;
    }

    @executedBy(MODEL)
    ExploitTest writeTest(Poc poc, Theta θ) {
        ExploitTest t = new ExploitTest();
        t.name = name(θ["p.phase3_reproduce_test.test_name_format"], poc);                 // src: vulnhunt/phases/phase3_reproduce_test.md:151
        List<String> langs = θ["p.phase3_reproduce_test.test_language_native_then_python_or_shell"]; // src: vulnhunt/phases/phase3_reproduce_test.md:261
        if (θ["p.phase3_reproduce_test.test_in_project_framework_or_standalone"]) t.framework = projectTestFramework() != null ? projectTestFramework() : standaloneScript(langs); // src: vulnhunt/phases/phase3_reproduce_test.md:145
        if (poc.finding.isAbsenceOfControl()) return configProvableTest(poc, t, θ);
        if (θ["p.phase3_reproduce_test.test_minimum_environment"]) t.setup = minimumEnvironment(poc); // src: vulnhunt/phases/phase3_reproduce_test.md:154
        t.action = callVulnerable(poc.entry, θ["p.phase3_reproduce_test.test_uses_exact_poc_payload"] ? poc.exactPayload() : poc.payloadVariant()); // src: vulnhunt/phases/phase3_reproduce_test.md:159
        if (θ["p.phase3_reproduce_test.test_proves_attacker_goal_not_pattern"] && θ["p.phase3_reproduce_test.test_assertion_on_attacker_goal"]) t.assertion = successCriterion(poc.finding.vulnClass, θ); // src: vulnhunt/phases/phase3_reproduce_test.md:161
        else t.assertion = assertCodePatternPresent(poc);
        if (θ["p.phase3_reproduce_test.adapt_test_pattern_other_classes"]) t.adaptPattern(poc.finding.vulnClass); // src: vulnhunt/phases/phase3_reproduce_test.md:189
        if (θ["p.phase3_reproduce_test.test_cleanup_step"]) t.cleanup = removeTempFilesRestoreState(); // src: vulnhunt/phases/phase3_reproduce_test.md:170
        writeFile(θ["p.phase3_reproduce_test.exploit_tests_directory"] + t.name, t);       // src: vulnhunt/phases/phase3_reproduce_test.md:253
        return t;
    }

    // What "Succeeds" Means: assertion on the attacker's goal, per class
    @executedBy(MODEL)
    Assertion successCriterion(VulnClass k, Theta θ) {
        switch (k) {
            case SQL_INJECTION: if (θ["p.phase3_reproduce_test.succeeds_sql_injection"]) return assertThat("query returns unauthorized data or modifies data"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:121
            case COMMAND_INJECTION: if (θ["p.phase3_reproduce_test.succeeds_command_injection"]) return assertThat("attacker command executes and produces output"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:122
            case PATH_TRAVERSAL: if (θ["p.phase3_reproduce_test.succeeds_path_traversal"]) return assertThat("file outside intended directory read/written"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:123
            case SSRF: if (θ["p.phase3_reproduce_test.succeeds_ssrf"]) return assertThat("request reaches a different endpoint/service"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:124
            case XSS: if (θ["p.phase3_reproduce_test.succeeds_xss"]) return assertThat("payload renders unescaped in response"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:125
            case CRYPTO: if (θ["p.phase3_reproduce_test.succeeds_crypto"]) return assertThat("attacker can decrypt/forge data"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:126
            case IDOR: if (θ["p.phase3_reproduce_test.succeeds_idor"]) return assertThat("attacker retrieves/modifies another user resource"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:127
            case CSRF: if (θ["p.phase3_reproduce_test.succeeds_csrf"]) return assertThat("cross-origin request performs state-changing action as victim"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:128
            case MASS_ASSIGNMENT: if (θ["p.phase3_reproduce_test.succeeds_mass_assignment"]) return assertThat("attacker sets a field they should not access"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:129
            case RACE_CONDITION: if (θ["p.phase3_reproduce_test.succeeds_race_condition"]) return assertThat("concurrent requests produce inconsistent state benefiting attacker"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:130
            case OPEN_REDIRECT: if (θ["p.phase3_reproduce_test.succeeds_open_redirect"]) return assertThat("victim redirected to attacker-controlled domain"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:131
            case EMAIL_HEADER_INJECTION: if (θ["p.phase3_reproduce_test.succeeds_email_header_injection"]) return assertThat("additional headers or recipients injected"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:132
            case IDENTITY_SPOOFING: if (θ["p.phase3_reproduce_test.succeeds_identity_spoofing"]) return assertThat("action attributed to/authorized as a different user"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:133
            case CONFUSED_DEPUTY: if (θ["p.phase3_reproduce_test.succeeds_confused_deputy"]) return assertThat("request reaches downstream with service elevated credentials and attacker data"); break; // src: vulnhunt/phases/phase3_reproduce_test.md:134
            case CONDITIONAL_VALIDATION_BYPASS:
                if (θ["p.phase3_reproduce_test.succeeds_conditional_validation_bypass"]) {  // src: vulnhunt/phases/phase3_reproduce_test.md:135
                    if (θ["p.phase3_reproduce_test.cvb_per_caller_protected_resource"]) {  // src: vulnhunt/phases/phase3_reproduce_test.md:135
                        for (Caller c : callersOfVulnerableFunction()) identifyProtectedResourceAndValidationBetween(c);
                    }
                    return assertThat("request succeeds without bypassed checks using a credential that would have been rejected");
                }
                break;
            default:
                if (θ["p.phase3_reproduce_test.succeeds_unlisted_classes"]) return assertThat(defineConcreteAttackerGain(k)); // src: vulnhunt/phases/phase3_reproduce_test.md:137
        }
        return assertThat(defineConcreteAttackerGain(k));
    }

    // Configuration-provable findings
    @executedBy(MODEL)
    ExploitTest configProvableTest(Poc poc, ExploitTest t, Theta θ) {
        if (θ["prompt.exploit_test.config_provable"] == "static verification test") {     // src: vulnhunt/phases/phase3_reproduce_test.md:233
            for (String a : θ["p.phase3_reproduce_test.config_provable_static_assertions"]) t.assertStatic(a); // src: vulnhunt/phases/phase3_reproduce_test.md:235
        }
        if (!θ["p.phase3_reproduce_test.config_provable_no_network_proof"]) t.assertNetworkReachable(); // src: vulnhunt/phases/phase3_reproduce_test.md:236
        if (θ["p.phase3_reproduce_test.config_provable_no_network_control_downgrade"]) t.forbidDowngradeOnAssumedNetworkControls(); // src: vulnhunt/phases/phase3_reproduce_test.md:237
        return t;
    }

    // Test Outcomes and Actions
    @executedBy(MODEL)
    Action applyOutcome(Poc poc, ExploitTest t, TestResult r, Theta θ) {
        Finding f = poc.finding;
        if (r == PASS) return f.set(θ["p.phase3_reproduce_test.outcome_pass"]);            // src: vulnhunt/phases/phase3_reproduce_test.md:198
        if (r == CODE_RUNS_ATTACK_MITIGATED) {
            r = FAIL;                                                                      // src: vulnhunt/phases/phase3_reproduce_test.md:140
            return codeSmell(f, poc, t, θ["p.phase3_reproduce_test.path_runs_but_blocked_is_fail"], θ); // src: vulnhunt/phases/phase3_reproduce_test.md:140
        }
        if (θ["p.phase3_reproduce_test.outcome_fail_investigate"] == "investigate") r = investigateWhy(readCodePathTestHit(t)); // src: vulnhunt/phases/phase3_reproduce_test.md:200
        switch (r.reason) {
            case MITIGATED_DOWNSTREAM: return codeSmell(f, poc, t, θ["p.phase3_reproduce_test.outcome_code_runs_but_mitigated"], θ); // src: vulnhunt/phases/phase3_reproduce_test.md:199
            case FRAMEWORK_PREVENTS: return codeSmell(f, poc, t, θ["p.phase3_reproduce_test.outcome_fail_framework_prevents"], θ); // src: vulnhunt/phases/phase3_reproduce_test.md:201
            case TYPE_SYSTEM_PREVENTS: return f.set(θ["p.phase3_reproduce_test.outcome_fail_type_system_prevents"]); // src: vulnhunt/phases/phase3_reproduce_test.md:202
            case CANNOT_CONSTRUCT_TEST:
                if (θ["p.phase3_reproduce_test.cannot_write_test_downgrade"]) return f.set(θ["p.phase3_reproduce_test.outcome_fail_cannot_construct_test"]); // src: vulnhunt/phases/phase3_reproduce_test.md:203
                return f.keep();
            case EXCEPTION_BEFORE_SINK:
                if (exceptionLeaksInfo(t)) return f.reclassifyAsInfoLeak();                // src: vulnhunt/phases/phase3_reproduce_test.md:204
                return f.set(θ["p.phase3_reproduce_test.outcome_fail_exception_before_sink"]); // src: vulnhunt/phases/phase3_reproduce_test.md:204
        }
        return f.keep();
    }

    @executedBy(MODEL)
    Action codeSmell(Finding f, Poc poc, ExploitTest t, Object label, Theta θ) {
        if (f.isAbsenceOfControl() && θ["p.phase3_reproduce_test.config_provable_no_network_control_downgrade"] && t.mitigationIsAssumedNetworkControl()) return f.keep(); // src: vulnhunt/phases/phase3_reproduce_test.md:237
        if (θ["prompt.exploit_test.poc_before_code_smell"] && θ["p.phase3_reproduce_test.code_smell_requires_poc_and_test_files_first"]) { // src: vulnhunt/phases/phase3_reproduce_test.md:212
            if (!poc.fileExists() || !t.fileExists()) { writeFile(poc); writeFile(t); }
        }
        Justification j = new Justification();
        if (θ["p.phase3_reproduce_test.code_smell_show_exact_payload"]) j.add(poc.exactPayload()); // src: vulnhunt/phases/phase3_reproduce_test.md:219
        if (θ["p.phase3_reproduce_test.code_smell_show_exact_code_path"]) j.add(poc.codePath()); // src: vulnhunt/phases/phase3_reproduce_test.md:220
        Defense d = t.blockingDefense();
        if (θ["p.phase3_reproduce_test.code_smell_show_blocking_defense_file_line"]) j.add(d == null ? null : d.fileLineWithEmpiricalBehavior()); // src: vulnhunt/phases/phase3_reproduce_test.md:221
        if (θ["p.phase3_reproduce_test.code_smell_show_why_defense_fits_sink"]) j.add(d == null ? null : d.whyEffectiveFor(poc.sink)); // src: vulnhunt/phases/phase3_reproduce_test.md:224
        if (θ["p.phase3_reproduce_test.no_concrete_defense_not_code_smell"] && (d == null || !j.complete())) return f.keepAsCandidate(); // src: vulnhunt/phases/phase3_reproduce_test.md:226
        f.set(label);
        if (θ["p.phase3_reproduce_test.code_smell_reported_in_separate_section"]) f.section = "Code Quality / Defense in Depth"; // src: vulnhunt/phases/phase3_reproduce_test.md:207
        if (θ["p.phase3_reproduce_test.code_smells_no_vuln_ids"]) f.vulnId = null;          // src: vulnhunt/phases/phase3_reproduce_test.md:209
        return f.action();
    }
}
