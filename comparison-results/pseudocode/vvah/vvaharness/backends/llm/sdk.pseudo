        List<String> advertised = ok + extraTools.map(t -> t.get("name"));                                  // src: vvaharness/backends/llm/sdk.py:1291
        if (responseModel != null) {
            tools = tools + List.of(LlmModels.responseModelTool(responseModel));                            // src: vvaharness/backends/llm/sdk.py:1293
            advertised = advertised + List.of(RESPONSE_MODEL_TOOL_NAME);                                    // src: vvaharness/backends/llm/sdk.py:1294
        }
