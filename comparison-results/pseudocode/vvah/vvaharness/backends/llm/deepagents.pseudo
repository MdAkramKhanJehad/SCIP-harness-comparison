        WarnOnce.warnOnce(WARNED_DROPPED_KNOBS, "deepagents:max_budget_usd", "max_budget_usd accepted but not enforced on the deepagents route; route via cli for an enforced budget"); // src: vvaharness/backends/llm/deepagents.py:472
    }

