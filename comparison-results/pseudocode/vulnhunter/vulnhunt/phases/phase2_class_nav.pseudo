// file: vulnhunt/phases/phase2_class_nav.md
// NAV (navigation / authentication / authorization) class-group reference read by every NAV trace agent in Phase 2.
// The prompt sections are rendered as Prompt builders; the procedure they ask for (mandatory input gates,
// NAV gate exemptions, severity floor, missing-auth assessment, class hunts, post-trace audit) as MODEL control flow.

@executedBy(MODEL) @role(prompt) @stage("phase2")
class Phase2ClassNav {

    // Entry: one NAV trace agent working one partition (spawned by Phase2Hunt with this file + partition data).
    List<Disposition> run(Partition sg, ReconContext recon, Theta θ) {
        Prompt p = prompt(θ);
        List<Disposition> out = new List();
        for (Input in : sg.inputs) {                                            // iteration rules come from Phase2Shared
            out.addAll(traceInput(in, sg, recon, θ));
        }
        if (recon.authFields.allNone()) {                                       // src: vulnhunt/phases/phase2_class_nav.md:97
            out.addAll(missingAuthAssessment(sg.endpoints, θ));
        }
        out.addAll(postTraceAuthHelperAudit(sg, out, θ));                       // src: vulnhunt/phases/phase2_class_nav.md:212
        return out;
    }

    // ---------------- prompt sections, in file order ----------------

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(mandatoryInputGatesSection(θ));
        p.include(gate0ExemptionsSection(θ));
        p.include(severityFloorSection(θ));
        p.include(missingAuthSection(θ));
        p.include(authorizationDecisionPointsSection(θ));
        p.include(vulnerabilityClassesSection(θ));
        p.include(postTraceAuditSection(θ));
        return p;
    }

    Prompt mandatoryInputGatesSection(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.request_body_gate"]) {                                                            // src: vulnhunt/phases/phase2_class_nav.md:5
            p.must(θ["p.phase2_class_nav.body_gate_before_any_disposition"]);                           // src: vulnhunt/phases/phase2_class_nav.md:8
            p.step(1, θ["p.phase2_class_nav.body_gate_a_grep_all_endpoints_same_type"]);                // src: vulnhunt/phases/phase2_class_nav.md:11
            p.step(2, θ["p.phase2_class_nav.body_gate_b_classify_fields_by_setter"]);                   // src: vulnhunt/phases/phase2_class_nav.md:12
            p.checklist(θ["p.phase2_class_nav.body_gate_sensitive_field_categories"]);                  // src: vulnhunt/phases/phase2_class_nav.md:13
            p.step(3, θ["p.phase2_class_nav.body_gate_c_list_overridden_fields_per_endpoint"]);         // src: vulnhunt/phases/phase2_class_nav.md:16
            p.rule(θ["p.phase2_class_nav.schema_validation_not_mass_assignment_defense"]);              // src: vulnhunt/phases/phase2_class_nav.md:18
            p.step(4, θ["p.phase2_class_nav.body_gate_d_read_mapper_source"]);                          // src: vulnhunt/phases/phase2_class_nav.md:21
            p.step(5, θ["p.phase2_class_nav.body_gate_e_cross_endpoint_comparison"]);                   // src: vulnhunt/phases/phase2_class_nav.md:28
            p.forbid(θ["p.phase2_class_nav.no_safe_on_partial_override"]);                              // src: vulnhunt/phases/phase2_class_nav.md:33
            p.forbid(θ["p.phase2_class_nav.no_design_intent_for_body_inputs_by_role"]);                 // src: vulnhunt/phases/phase2_class_nav.md:37
        }
        if (θ["prompt.resource_id_gate"]) {                                                             // src: vulnhunt/phases/phase2_class_nav.md:40
            p.context(θ["p.phase2_class_nav.resource_id_gate_input_scope"]);                            // src: vulnhunt/phases/phase2_class_nav.md:42
            p.must(θ["p.phase2_class_nav.resource_id_gate_before_any_disposition"]);                    // src: vulnhunt/phases/phase2_class_nav.md:43
            p.step(1, θ["p.phase2_class_nav.resource_id_gate_a_ownership_check"]);                      // src: vulnhunt/phases/phase2_class_nav.md:46
            p.step(2, θ["p.phase2_class_nav.resource_id_gate_b_downstream_credential"]);                // src: vulnhunt/phases/phase2_class_nav.md:48
            p.step(3, θ["p.phase2_class_nav.resource_id_gate_c_each_id_independent"]);                  // src: vulnhunt/phases/phase2_class_nav.md:58
            p.rule(θ["p.phase2_class_nav.format_validation_not_ownership"]);                            // src: vulnhunt/phases/phase2_class_nav.md:63
            p.rule(θ["p.phase2_class_nav.infra_auth_not_ownership"]);                                   // src: vulnhunt/phases/phase2_class_nav.md:64
            p.rule(θ["p.phase2_class_nav.idor_emit_at_default_severity"]);                              // src: vulnhunt/phases/phase2_class_nav.md:68
        }
        return p;
    }

    Prompt gate0ExemptionsSection(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.phase2_class_nav.gate0_exempt_cwe639_in_bff_gateway"]);                        // src: vulnhunt/phases/phase2_class_nav.md:77
        p.exemption(θ["p.phase2_class_nav.gate0_exempt_identity_and_signal_spoofing"]);                 // src: vulnhunt/phases/phase2_class_nav.md:80
        return p;
    }

    Prompt severityFloorSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.severity_floors"]);                                                            // src: vulnhunt/phases/phase2_class_nav.md:84
        p.threshold(θ["p.phase2_class_nav.severity_floor_unauth_mgmt_endpoint"]);                       // src: vulnhunt/phases/phase2_class_nav.md:86
        p.threshold(θ["p.phase2_class_nav.severity_floor_unauth_mgmt_state_modifying"]);                // src: vulnhunt/phases/phase2_class_nav.md:88
        p.forbid(θ["p.phase2_class_nav.network_isolation_must_not_downgrade"]);                         // src: vulnhunt/phases/phase2_class_nav.md:90
        return p;
    }

    Prompt missingAuthSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.phase2_class_nav.missing_auth_assessment_trigger"]);                                // src: vulnhunt/phases/phase2_class_nav.md:97
        p.choose(θ["p.phase2_class_nav.missing_auth_severity"]);                                        // src: vulnhunt/phases/phase2_class_nav.md:109
        return p;
    }

    Prompt authorizationDecisionPointsSection(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.phase2_class_nav.authz_decision_points_present_complete_unbypassable"]);        // src: vulnhunt/phases/phase2_class_nav.md:113
        p.rule("Adapt the specific API names to the detected language/framework.");                    // src: vulnhunt/phases/phase2_class_nav.md:124
        return p;
    }

    Prompt vulnerabilityClassesSection(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(List.of(θ["p.phase2_class_nav.class_missing_or_ineffective_auth"], θ["p.phase2_class_nav.class_authz_helpers_not_invoked"],
            θ["p.phase2_class_nav.class_broken_session_management"], θ["p.phase2_class_nav.class_insecure_password_handling"],
            θ["p.phase2_class_nav.class_jwt_issues"], θ["p.phase2_class_nav.class_idor"], θ["p.phase2_class_nav.class_auth_on_promotable_server_variables"],
            θ["p.phase2_class_nav.class_conditional_validation_bypass"], θ["p.phase2_class_nav.class_csrf"], θ["p.phase2_class_nav.class_identity_spoofing"],
            θ["p.phase2_class_nav.class_security_signal_spoofing"], θ["p.phase2_class_nav.class_confused_deputy"],
            θ["p.phase2_class_nav.class_authorization_scope_selection"], θ["p.phase2_class_nav.class_downstream_authorization_verification"],
            θ["p.phase2_class_nav.class_mass_assignment"], θ["p.phase2_class_nav.class_parameter_pollution_role_confusion"]));  // src: vulnhunt/phases/phase2_class_nav.md:126
        return p;
    }

    Prompt postTraceAuditSection(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.auth_helper_coverage_audit"]) {                                                   // src: vulnhunt/phases/phase2_class_nav.md:212
            p.must(θ["p.phase2_class_nav.post_trace_audit_before_finalizing"]);                         // src: vulnhunt/phases/phase2_class_nav.md:214
            p.exemption(θ["p.phase2_class_nav.post_trace_audit_exemptions"]);                           // src: vulnhunt/phases/phase2_class_nav.md:219
            p.rule(θ["p.phase2_class_nav.url_path_conventions_not_auth_proof"]);                        // src: vulnhunt/phases/phase2_class_nav.md:222
        }
        return p;
    }

    // ---------------- procedure the prompt asks the agent to carry out ----------------

    @executedBy(MODEL)
    List<Disposition> traceInput(Input in, Partition sg, ReconContext recon, Theta θ) {
        List<Disposition> out = new List();
        // Mandatory input gates run BEFORE any disposition is recorded for the input.
        if (in.isRequestBody() && θ["prompt.request_body_gate"]) {                                     // src: vulnhunt/phases/phase2_class_nav.md:7
            out.addAll(requestBodyGate(in, sg, θ));
        }
        if (in.kindIn(θ["p.phase2_class_nav.resource_id_gate_input_scope"]) && θ["prompt.resource_id_gate"]) { // src: vulnhunt/phases/phase2_class_nav.md:42
            out.addAll(resourceIdGate(in, θ));
        }
        // Forward trace per shared iteration rules; NAV sinks are authorization decision points.
        List<Sink> sinks = Phase2Shared.traceForward(in, null, θ);
        for (Sink s : sinks) {
            if (s.classGroup != NAV) { out.add(Disposition.crossClass(in, s)); continue; }
            checkDecisionPoints(s, θ);
            for (Finding f : huntClasses(in, s, recon, θ)) {
                Disposition d = applyGates(f, θ);
                if (d != null) out.add(d);
            }
        }
        if (out.isEmpty()) out.add(Disposition.noMatch(in));
        return out;
    }

    // ---- Request Body Gate (CWE-915) ----
    @executedBy(MODEL)
    List<Disposition> requestBodyGate(Input body, Partition sg, Theta θ) {
        // (a)-(e) must be complete before recording any disposition for a body input.
        assert θ["p.phase2_class_nav.body_gate_before_any_disposition"];                                // src: vulnhunt/phases/phase2_class_nav.md:8
        List<Endpoint> eps = new List();
        if (θ["p.phase2_class_nav.body_gate_a_grep_all_endpoints_same_type"]) eps = grep.endpointsDeserializingInto(body.type); // src: vulnhunt/phases/phase2_class_nav.md:11
        List<Field> sensitive = new List();
        if (θ["p.phase2_class_nav.body_gate_b_classify_fields_by_setter"]) {                            // src: vulnhunt/phases/phase2_class_nav.md:12
            for (Field fld : read(body.type).fields) {
                fld.allowedSetter = classifyWhoMaySet(fld);
                if θ["p.phase2_class_nav.body_gate_sensitive_field_categories"].contains((fld.category) || fld.roleRestricted) sensitive.add(fld); // src: vulnhunt/phases/phase2_class_nav.md:13
            }
        }
        Map<Endpoint, Set<Field>> stripped = new Map();
        if (θ["p.phase2_class_nav.body_gate_c_list_overridden_fields_per_endpoint"]) {                  // src: vulnhunt/phases/phase2_class_nav.md:16
            for (Endpoint ep : eps) {
                Set<Field> s = ep.handler.fieldsOverriddenNulledOrStrippedBeforeService(sensitive);
                if (θ["p.phase2_class_nav.schema_validation_not_mass_assignment_defense"]) s.removeIf(x -> x.onlySchemaValidated); // src: vulnhunt/phases/phase2_class_nav.md:18
                stripped.put(ep, s);
            }
        }
        Set<Field> copied = new Set();
        if (θ["p.phase2_class_nav.body_gate_d_read_mapper_source"]) {                                   // src: vulnhunt/phases/phase2_class_nav.md:21
            Mapper m = read(body.mapperSource);
            copied = m.copiedFields();
            if (m.copiesAllUnconditionally() && θ["p.phase2_class_nav.unconditional_mapper_all_fields_candidates"]) copied = body.type.fields; // src: vulnhunt/phases/phase2_class_nav.md:23
            if (m.forwardsRemainderViaCatchAll() && θ["p.phase2_class_nav.catch_all_forwarding_is_unfiltered_mapper"]) copied.addAll(body.type.fieldsNotExplicitlyExtracted()); // src: vulnhunt/phases/phase2_class_nav.md:24
        }
        List<Field> candidates = new List();
        for (Endpoint ep : eps) {
            for (Field fld : sensitive) {
                if (copied.contains(fld) && !stripped.get(ep).contains(fld) && !ep.callerMaySet(fld)) candidates.add(fld);
                if (θ["p.phase2_class_nav.body_gate_e_cross_endpoint_comparison"]                       // src: vulnhunt/phases/phase2_class_nav.md:28
                        && strippedInHigherTrustEndpoint(fld, stripped) && !stripped.get(ep).contains(fld) && ep.isLowerTrust()) candidates.add(fld);
            }
        }
        assert θ["p.phase2_class_nav.body_gate_complete_all_steps_first"];                              // src: vulnhunt/phases/phase2_class_nav.md:34
        if (θ["p.phase2_class_nav.no_safe_on_partial_override"] && !stripped.isEmpty() && !candidates.isEmpty()) { /* partial overrides never make it SAFE */ } // src: vulnhunt/phases/phase2_class_nav.md:33
        if (θ["p.phase2_class_nav.endpoint_role_gate_does_not_satisfy_body_gate"]) { /* an endpoint role guard does not clear any field */ } // src: vulnhunt/phases/phase2_class_nav.md:36
        if (θ["p.phase2_class_nav.no_design_intent_for_body_inputs_by_role"]) { /* DESIGN-INTENT based on caller role/trust is not allowed */ } // src: vulnhunt/phases/phase2_class_nav.md:37
        List<Disposition> out = new List();
        if (θ["p.phase2_class_nav.each_sensitive_field_separate_candidate"]) {                          // src: vulnhunt/phases/phase2_class_nav.md:35
            for (Field fld : candidates.distinct()) out.add(Disposition.candidate(body, fld, "CWE-915"));
        } else if (!candidates.isEmpty()) {
            out.add(Disposition.candidate(body, candidates, "CWE-915"));
        }
        return out;
    }

    // ---- Resource ID Gate (CWE-639) ----
    @executedBy(MODEL)
    List<Disposition> resourceIdGate(Input in, Theta θ) {
        assert θ["p.phase2_class_nav.resource_id_gate_before_any_disposition"];                         // src: vulnhunt/phases/phase2_class_nav.md:43
        List<ResourceId> ids = List.of(in.resourceId());
        if (θ["p.phase2_class_nav.resource_id_gate_c_each_id_independent"]) ids = in.endpoint.allResourceIds(); // src: vulnhunt/phases/phase2_class_nav.md:58
        List<Disposition> out = new List();
        List<ResourceId> unbound = new List();
        for (ResourceId id : ids) {
            boolean owned = false;
            if (θ["p.phase2_class_nav.resource_id_gate_a_ownership_check"]) {                           // src: vulnhunt/phases/phase2_class_nav.md:46
                Check c = findOwnershipCheck(id);                                                       // authentication alone is not authorization
                if (θ["p.phase2_class_nav.format_validation_not_ownership"] && c.isFormatValidationOnly()) c = null;        // src: vulnhunt/phases/phase2_class_nav.md:63
                if (c != null && θ["p.phase2_class_nav.infra_auth_not_ownership"].contains(c.layer)) c = null;                    // src: vulnhunt/phases/phase2_class_nav.md:64
                owned = (c != null);
                if (!owned && id.forwardedAfterInfraOnlyAuth()) {
                    out.add(Disposition.of(θ["p.phase2_class_nav.resource_id_after_infra_only_auth_candidate"], id, "CWE-639")); // src: vulnhunt/phases/phase2_class_nav.md:66
                    continue;
                }
            }
            if (θ["p.phase2_class_nav.resource_id_gate_b_downstream_credential"]) {                     // src: vulnhunt/phases/phase2_class_nav.md:48
                Credential cred = id.downstreamCall().credential();
                if (cred.isServiceLevel()) {
                    if (!id.downstreamCall().forwardsUserIdentityAnyChannel()) {
                        out.add(Disposition.of(θ["p.phase2_class_nav.service_creds_only_downstream_is_candidate"], id, "CWE-639")); // src: vulnhunt/phases/phase2_class_nav.md:52
                        continue;
                    } else if (θ["p.phase2_class_nav.forwarded_identity_clears_deputy_not_idor"]) {      // src: vulnhunt/phases/phase2_class_nav.md:54
                        // confused-deputy concern eliminated; IDOR concern remains -> still needs owned == true
                    }
                }
            }
            if (!owned) unbound.add(id);
        }
        if (θ["p.phase2_class_nav.no_grouping_ids_each_separate_candidate"]) {                          // src: vulnhunt/phases/phase2_class_nav.md:59
            for (ResourceId id : unbound) out.add(Disposition.candidate(in, id, "CWE-639"));
        } else if (!unbound.isEmpty()) out.add(Disposition.candidate(in, unbound, "CWE-639"));
        for (Disposition d : out) {
            d.severity = θ["p.phase2_class_nav.idor_emit_at_default_severity"];                         // src: vulnhunt/phases/phase2_class_nav.md:68
            // Phase 2b (Phase2bVerify) later applies the Authorization Delegation Rule and may downgrade.
        }
        return out;
    }

    // ---- Authorization decision points to verify along the trace ----
    @executedBy(MODEL)
    void checkDecisionPoints(Sink s, Theta θ) {
        List<String> props = θ["p.phase2_class_nav.authz_decision_points_present_complete_unbypassable"]; // src: vulnhunt/phases/phase2_class_nav.md:113
        if (θ["p.phase2_class_nav.decision_point_route_middleware"]) verify(s.routeMiddleware(), props);           // src: vulnhunt/phases/phase2_class_nav.md:115
        if (θ["p.phase2_class_nav.decision_point_resource_ownership_queries"]) verify(s.ownershipQueries(), props); // src: vulnhunt/phases/phase2_class_nav.md:116
        if (θ["p.phase2_class_nav.decision_point_session_token_validation"]) verify(s.sessionTokenValidation(), props); // src: vulnhunt/phases/phase2_class_nav.md:117
        if (θ["p.phase2_class_nav.decision_point_field_level_access_control"]) verify(s.fieldLevelAccessControl(), props); // src: vulnhunt/phases/phase2_class_nav.md:118
        if (θ["p.phase2_class_nav.decision_point_outbound_security_signal_headers"]) {                  // src: vulnhunt/phases/phase2_class_nav.md:119
            verify(s.outboundSecuritySignalHeaders(), props);
            if (θ["p.phase2_class_nav.explicit_header_copy_separate_from_bulk_forwarding"]) s.markExplicitHeaderCopyAsSeparateFinding(); // src: vulnhunt/phases/phase2_class_nav.md:121
        }
    }

    // ---- Vulnerability classes: each enabled class is a hunt over the input/sink ----
    @executedBy(MODEL)
    List<Finding> huntClasses(Input in, Sink s, ReconContext recon, Theta θ) {
        List<Finding> fs = new List();
        if (θ["p.phase2_class_nav.class_missing_or_ineffective_auth"] && s.isSensitiveEndpoint()) {     // src: vulnhunt/phases/phase2_class_nav.md:130
            Guard g = s.declaredGuard();
            if (g != null && θ["p.phase2_class_nav.read_enforcing_middleware_source"]) {                // src: vulnhunt/phases/phase2_class_nav.md:131
                Source src = read(g.enforcingSource());
                if (src == null && θ["p.phase2_class_nav.unreadable_enforcement_treated_ineffective"]) g = null; // src: vulnhunt/phases/phase2_class_nav.md:133
                else if (!src.deniesUnauthorized()) g = null;
            }
            if (g == null) fs.add(Finding.of(s, "missing/ineffective auth"));
        }
        if (θ["p.phase2_class_nav.class_authz_helpers_not_invoked"] && s.handler.isStateChanging()) {   // src: vulnhunt/phases/phase2_class_nav.md:135
            List<Fn> helpers = grep(θ["p.phase2_class_nav.authz_helper_grep_patterns"]);                // src: vulnhunt/phases/phase2_class_nav.md:136
            if (!s.handler.invokesAny(helpers) && s.handler.siblingsInModule().anyInvoke(helpers)) {
                Finding f = Finding.of(s, "CWE-862");
                if (θ["p.phase2_class_nav.cwe862_independent_of_colocated_idor"]) f.independentOfColocated("CWE-639"); // src: vulnhunt/phases/phase2_class_nav.md:139
                fs.add(f);
            }
        }
        if (θ["p.phase2_class_nav.class_broken_session_management"]) fs.addAll(huntBrokenSessions(s));   // src: vulnhunt/phases/phase2_class_nav.md:142
        if (θ["p.phase2_class_nav.class_insecure_password_handling"]) fs.addAll(huntPasswordHandling(s)); // src: vulnhunt/phases/phase2_class_nav.md:143
        for (String jwtIssue : θ["p.phase2_class_nav.class_jwt_issues"]) fs.addAll(huntJwt(s, jwtIssue)); // src: vulnhunt/phases/phase2_class_nav.md:144
        if (θ["p.phase2_class_nav.class_idor"] && in.isResourceIdentifier()) {                          // src: vulnhunt/phases/phase2_class_nav.md:145
            // every resource identifier already went through resourceIdGate
            if (s.isDatabaseRecordSelector() && θ["p.phase2_class_nav.db_record_selector_is_nav_idor_sink"]) s.classGroup = NAV; // src: vulnhunt/phases/phase2_class_nav.md:146
        }
        if (θ["p.phase2_class_nav.class_auth_on_promotable_server_variables"] && s.authComparesServerVariable()) { // src: vulnhunt/phases/phase2_class_nav.md:149
            if (recon.promotedVariables.contains(s.serverVariable()) && recon.promotedViaBroadTrust(s.serverVariable())) fs.add(Finding.of(s, "CWE-290"));
        }
        if (θ["p.phase2_class_nav.class_conditional_validation_bypass"]) {                              // src: vulnhunt/phases/phase2_class_nav.md:153
            for (Block b : s.securityBlocksGatedOnPresence()) {
                if (b.skippedWhenAbsent()) fs.add(Finding.of(b, "CWE-306").needsFailClosedFix());
            }
            if (θ["p.phase2_class_nav.cvb_companion_input_pattern"]) {                                  // src: vulnhunt/phases/phase2_class_nav.md:156
                for (Pair ab : s.credentialUsedUnconditionallyValidatedOnlyWithCompanion()) fs.add(Finding.of(ab, "CWE-306"));
            }
            if (θ["p.phase2_class_nav.cvb_no_downstream_validates_dismissal"]) { /* never dismiss because the downstream validates */ } // src: vulnhunt/phases/phase2_class_nav.md:158
        }
        if θ["p.phase2_class_nav.class_csrf"].contains((s.handler.httpMethod)) {                               // src: vulnhunt/phases/phase2_class_nav.md:161
            boolean protectedByFramework = θ["p.phase2_class_nav.csrf_framework_protection_all_routes"] && recon.frameworkCsrfEnabledForAllRoutes(); // src: vulnhunt/phases/phase2_class_nav.md:162
            boolean exempt = θ["p.phase2_class_nav.csrf_json_only_strict_content_type_exemption"] && s.handler.jsonOnlyStrictContentType() && recon.frameworkRejectsCrossOriginForms(); // src: vulnhunt/phases/phase2_class_nav.md:164
            if (!s.handler.validatesCsrfToken() && !protectedByFramework && !exempt) fs.add(Finding.of(s, "CWE-352"));
        }
        if (θ["p.phase2_class_nav.class_identity_spoofing"] && in.isUserSuppliedIdentity() && !s.crossCheckedAgainstSession(in)) { // src: vulnhunt/phases/phase2_class_nav.md:166
            fs.add(Finding.of(s, "CWE-290"));
        }
        if (θ["p.phase2_class_nav.identity_header_enumerate_all_setters"]) {                            // src: vulnhunt/phases/phase2_class_nav.md:171
            for (Header h : s.outboundIdentityHeaders()) {
                if (h.setters().anyUnverified() && h.setters().anyVerified()) fs.add(Finding.of(h.unverifiedSetter(), "CWE-290"));
            }
        }
        if (θ["p.phase2_class_nav.class_security_signal_spoofing"] && s.copiesAttackerValueIntoSignalHeader(in)) { // src: vulnhunt/phases/phase2_class_nav.md:174
            String cwe = θ["p.phase2_class_nav.signal_spoofing_distinct_from_bulk_forwarding"] ? "CWE-290" : "CWE-441"; // src: vulnhunt/phases/phase2_class_nav.md:177
            fs.add(Finding.of(s, cwe));
        }
        if (θ["p.phase2_class_nav.class_confused_deputy"] && s.isOutboundOnBehalfOfUser()) {           // src: vulnhunt/phases/phase2_class_nav.md:180
            List<CallSite> sites = θ["p.phase2_class_nav.confused_deputy_each_call_site_independent"] ? s.outboundCallSites() : List.of(s.callSite()); // src: vulnhunt/phases/phase2_class_nav.md:185
            for (CallSite cs : sites) {
                if (cs.forwardsUserIdentityViaCustomHeaders()) { resourceIdGate(cs.resourceIdInput(), θ); continue; }
                if (θ["p.phase2_class_nav.confused_deputy_only_when_no_user_identity"] && cs.serviceTokenOnly()) fs.add(Finding.of(cs, "confused deputy")); // src: vulnhunt/phases/phase2_class_nav.md:187
            }
        }
        if (θ["p.phase2_class_nav.class_authorization_scope_selection"] && in.selectsAuthorizationScope()) { // src: vulnhunt/phases/phase2_class_nav.md:189
            if (θ["p.phase2_class_nav.scope_selection_trace_service_layer"]) {                          // src: vulnhunt/phases/phase2_class_nav.md:192
                if (!serviceLayer(in).checksPerValueAuthorization() || selectedConfig(in).canDisableChecks()) fs.add(Finding.of(s, "authorization-scope selection"));
            }
        }
        if (s.isOutboundApiCall()) {
            List<String> qs = θ["p.phase2_class_nav.class_downstream_authorization_verification"];      // src: vulnhunt/phases/phase2_class_nav.md:195
            boolean identityCarried = s.carriesEndUserIdentity();                                       // question (1)
            boolean identityBound = s.identityBoundToResourceId();                                      // question (2)
            if (!identityCarried && θ["p.phase2_class_nav.no_downstream_auth_credit_without_identity"]) s.creditDownstreamAuth = false; // src: vulnhunt/phases/phase2_class_nav.md:200
        }
        if (θ["p.phase2_class_nav.class_mass_assignment"] && in.isRequestBody()) { /* covered by requestBodyGate, CWE-915 */ } // src: vulnhunt/phases/phase2_class_nav.md:203
        if (θ["p.phase2_class_nav.class_parameter_pollution_role_confusion"] && s.sharedDtoOrEndpointAcrossActors()) { // src: vulnhunt/phases/phase2_class_nav.md:205
            for (Field fld : s.dto.fieldsIntendedForOtherActor()) if (!s.enforcesRoleBasedFieldFiltering(fld)) fs.add(Finding.of(fld, "role confusion"));
        }
        return fs;
    }

    // ---- shared gates + NAV-specific Gate 0 exemptions and severity floor ----
    @executedBy(MODEL)
    Disposition applyGates(Finding f, Theta θ) {
        boolean gate0Exempt = false;
        if (θ["p.phase2_class_nav.gate0_exempt_cwe639_in_bff_gateway"] && f.cwe == "CWE-639" && f.service.isBffOrchestratorOrGateway()) gate0Exempt = true; // src: vulnhunt/phases/phase2_class_nav.md:77
        if (θ["p.phase2_class_nav.gate0_exempt_identity_and_signal_spoofing"] && (f.cwe == "CWE-290")) gate0Exempt = true; // src: vulnhunt/phases/phase2_class_nav.md:80
        if (!gate0Exempt && Phase2Shared.gate0(f, θ) == ELIMINATE) return Disposition.designIntent(f);  // "passthrough by design" not allowed when exempt
        if (Phase2Shared.gate1(f, θ) == ELIMINATE) return null;
        if (Phase2Shared.gate2a(f, θ) == ELIMINATE) return null;
        if (Phase2Shared.gate2b(f, θ) == ELIMINATE) return Disposition.safe(f);
        if (Phase2Shared.gate3(f, θ) == ELIMINATE) return null;
        f.severity = Phase2Shared.classifySeverity(f, θ);
        applySeverityFloor(f, θ);
        return Disposition.candidate(f);
    }

    @executedBy(MODEL)
    void applySeverityFloor(Finding f, Theta θ) {
        if (!θ["prompt.severity_floors"]) return;                                                       // src: vulnhunt/phases/phase2_class_nav.md:84
        if (f.isUnauthenticatedMgmtAdminDebugEndpoint() && f.networkExposed() && !f.hasAppLayerAuth()) {
            if (θ["p.phase2_class_nav.absence_of_app_auth_is_the_finding"]) f.isFinding = true;         // src: vulnhunt/phases/phase2_class_nav.md:89
            Severity floor = θ["p.phase2_class_nav.severity_floor_unauth_mgmt_endpoint"];               // src: vulnhunt/phases/phase2_class_nav.md:86
            if (f.permitsStateModification()) floor = θ["p.phase2_class_nav.severity_floor_unauth_mgmt_state_modifying"]; // src: vulnhunt/phases/phase2_class_nav.md:88
            if (θ["p.phase2_class_nav.network_isolation_must_not_downgrade"]) f.ignoreDowngradeReason("network-layer isolation"); // src: vulnhunt/phases/phase2_class_nav.md:90
            f.severity = max(f.severity, floor);
        }
        if (θ["p.phase2_class_nav.framework_managed_endpoints_without_auth_are_findings"] && f.isFrameworkManagedEndpointWithoutAuth()) f.isFinding = true; // src: vulnhunt/phases/phase2_class_nav.md:91
    }

    // ---- Missing Auth Assessment (all three Phase 1 auth fields are NONE) ----
    @executedBy(MODEL)
    List<Disposition> missingAuthAssessment(List<Endpoint> eps, Theta θ) {
        List<Disposition> out = new List();
        if (!θ["p.phase2_class_nav.missing_auth_assessment_trigger"]) return out;                       // src: vulnhunt/phases/phase2_class_nav.md:97
        for (Endpoint ep : eps) {
            if (θ["p.phase2_class_nav.missing_auth_not_finding_self_service"] && ep.isSelfServiceInitiation()) continue; // src: vulnhunt/phases/phase2_class_nav.md:105
            if (θ["p.phase2_class_nav.missing_auth_not_finding_public_info"] && ep.returnsPublicUnscopedInfo()) continue; // src: vulnhunt/phases/phase2_class_nav.md:106
            if (θ["p.phase2_class_nav.missing_auth_not_finding_health_metrics"] && ep.isHealthStatusMetrics()) continue;  // src: vulnhunt/phases/phase2_class_nav.md:107
            boolean crossPrincipal = θ["p.phase2_class_nav.missing_auth_candidate_cross_principal"] && ep.touchesResourcesOfDistinctPrincipals(); // src: vulnhunt/phases/phase2_class_nav.md:100
            boolean bearerless = θ["p.phase2_class_nav.missing_auth_candidate_bearerless_identifier"] && ep.soleAccessControlIsBearerlessIdentifier(); // src: vulnhunt/phases/phase2_class_nav.md:101
            if (crossPrincipal || bearerless) {
                Disposition d = Disposition.candidate(ep, "CWE-306");
                d.severity = θ["p.phase2_class_nav.missing_auth_severity"].get(ep.isStateChange() ? "cross-principal state change" : "cross-principal read"); // src: vulnhunt/phases/phase2_class_nav.md:109
                out.add(d);
            }
        }
        return out;
    }

    // ---- MANDATORY Post-Trace Audit: Authorization Helper Coverage ----
    @executedBy(MODEL)
    List<Disposition> postTraceAuthHelperAudit(Partition sg, List<Disposition> sofar, Theta θ) {
        List<Disposition> out = new List();
        if (!θ["prompt.auth_helper_coverage_audit"]) return out;                                        // src: vulnhunt/phases/phase2_class_nav.md:212
        if (!θ["p.phase2_class_nav.post_trace_audit_before_finalizing"]) return out;                    // src: vulnhunt/phases/phase2_class_nav.md:214
        for (Module mod : sg.controllersAndModules()) {
            for (Handler h : mod.handlers) {
                if (h.kindIn(θ["p.phase2_class_nav.post_trace_audit_exemptions"])) continue;            // src: vulnhunt/phases/phase2_class_nav.md:219
                boolean hasAuth = h.invokesAuthnOrAuthzFunction();
                if (θ["p.phase2_class_nav.url_path_conventions_not_auth_proof"] && h.authOnlyByUrlConvention()) hasAuth = false; // src: vulnhunt/phases/phase2_class_nav.md:222
                if (θ["p.phase2_class_nav.only_credit_readable_auth_code"] && !h.authCodeIsReadable()) hasAuth = false;         // src: vulnhunt/phases/phase2_class_nav.md:223
                if (!hasAuth && mod.siblingsOf(h).anyInvokeAuth()) {
                    Disposition d = Disposition.of(θ["p.phase2_class_nav.post_trace_audit_gap_is_candidate"], h, "CWE-306/862"); // src: vulnhunt/phases/phase2_class_nav.md:215
                    if (θ["p.phase2_class_nav.post_trace_audit_full_candidate_entry"]) d = Phase2Shared.formatCandidate(d, θ);   // src: vulnhunt/phases/phase2_class_nav.md:220
                    out.add(d);
                }
            }
        }
        return out;
    }
}
