# vvaharness/pipeline/stages/s1_preprocess.py

Stage 1 (pre-process, no model call). Reuses the Stage 0 file walk, jails agentic file reads to that inventory, collapses near-duplicate configuration files, resolves seed paths against the inventory, derives modules, notes and the primary language from the code graph, and builds the `ContextPackage`. It refuses an empty scope.

Source: `vvaharness/pipeline/stages/s1_preprocess.py` (lines 1-207)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (Stage 1)

// src: vvaharness/pipeline/stages/s1_preprocess.py:43-63
QSEP = "::"; MODULE_SCOPE = "<module>"
fn q_join(file, name):executor=code = "$file::$name"
fn q_split(qname):executor=code = if ("::" in qname) [part before last "::", part after] else ["", qname]
fn q_file(qname):executor=code = q_split(qname)[0]
fn q_name(qname):executor=code = q_split(qname)[1]

// src: vvaharness/pipeline/stages/s1_preprocess.py:76-207
fn run(repo_root, cfg, known_cves, controls, seed?, graph_handle?):executor=code {
  // src: s1_preprocess.py:80-90 — reuse Stage 0's walk when it has one
  if (seed != null && seed.all_files) { [all_files, excluded] = [seed.all_files, seed.excluded] }
  else { [all_files, excluded] = scope._walk_repo(repo_root, cfg) }
  backends.llm.tools.set_scope(repo_root, all_files)   // jails agentic reads to the inventory; set BEFORE dedup so dropped config siblings stay readable
  [all_files, dedup_report] = scope._dedup_configs(all_files, repo_root, cfg)
  excluded.config_dedup = dedup_report

  // src: s1_preprocess.py:93-105 — seed paths are resolved against the inventory
  keep = set(all_files)
  top_dirs = sorted names of top-level directories of repo_root except "checkpoints" and "security-scan"   // a seed path may omit its top-level repository directory under --group-by-app
  ambiguous = []
  _resolve_in_scope(path) {
    [hit, amb] = scope._resolve_scope_path(path, repo_root, keep, top_dirs)
    if (amb) ambiguous += path   // matched two or more top directories: dropped, never guessed
    return hit
  }

  data = { unsafe_sinks: [], entry_points: [] }
  // src: s1_preprocess.py:109-147
  if (seed) {
    seed_sinks = seed.unsafe_sinks whose file resolves, with file replaced by the resolved path
    seed_eps = seed.entry_points whose file resolves, with file replaced by the resolved path
    data.unsafe_sinks += seed_sinks; data.entry_points += seed_eps
    seed_paths = []
    for each path in seed.taint_paths {
      resolved = for each hop "file:line": resolve file (or the whole hop when no file part); keep "hit:line" (or hit) when it resolves
      if (length(resolved) >= 2) seed_paths += resolved   // paths shorter than 2 resolved hops are dropped
    }
    data.seed_taint_paths = seed_paths
    framework_unresolvable = "${ep.file}::${ep.function}" for each seed entry point with lowercase(kind) == "framework" whose file does not resolve
    if (framework_unresolvable) warn S1_FRAMEWORK_ENTRY_UNRESOLVED   // sample of 3
  }
  if (ambiguous) warn S1_AMBIGUOUS_PATHS_DROPPED   // sample of 5

  // src: s1_preprocess.py:154-170
  data.repo_root = repo_root
  if (graph_handle != null) {
    data.language = codegraph.primary_language(graph_handle)
    data.modules = _modules_from_graph(graph_handle, _resolve_in_scope)
    data.notes = codegraph.system_context_notes(graph_handle)
  } else { data.modules = []; data.notes = "" }
  if (!data.language) {
    data.language = most common EXT_TO_LANG language over all_files by suffix, or "unknown"
  }
  data.all_files = all_files; data.excluded = excluded
  data.known_cves = known_cves; data.design_controls = controls

  // src: s1_preprocess.py:177-207
  pkg = ContextPackage.model_validate(data)   // field validators coerce off-schema values, so this does not raise
  n_in_scope = length(pkg.all_files)
  n_total = n_in_scope + excluded dir count + ext count + glob count + oversize + config_dedup.dropped
  require n_in_scope > 0 => throw EmptyScopeError("0 files in scope after exclusions (... on disk ...). Nothing was analysed, so no conclusion can be drawn about this repository. Re-run with --no-auto-step1, or widen the step1 exclusions.")
  if (n_in_scope > 0 && !pkg.modules && !pkg.entry_points && !pkg.unsafe_sinks) {
    errlog.log("s1", "context-package", "S1 produced 0 modules, 0 entry points and 0 sinks with $n_in_scope files in scope", reason="s1_zero_output")   // recorded for scan health and SARIF; the run continues
  }
  return pkg
  // abstracted: s1_preprocess.py:88-90, 118-119, 132, 145-147, 185-190 progress, console and log lines
}

// src: vvaharness/pipeline/stages/s1_preprocess.py:66-73
fn _modules_from_graph(graph_handle, resolve_in_scope):executor=code {
  // Leiden communities from the code graph, filtered to the in-scope inventory
  return for each (name, files) in codegraph.communities_as_modules(graph_handle): { name, files: sorted unique resolved files } where files is non-empty
}
