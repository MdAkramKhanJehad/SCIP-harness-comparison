// file: vvaharness/skills/code-exploration/SKILL.md
// S4 skill playbook "code-exploration": the coverage procedure every lens runs on top of.
// Glob inventory -> directory census -> skipped file classes -> read to EOF -> follow edges -> FP checks -> enumerate -> coverage report.

@executedBy(MODEL) @role(skill) @stage("S4")
class CodeExplorationSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        // Loaded FIRST, before any lens, when asked to map a repo / enumerate attack surface / conclude absence.
        if (!(lens.task.matches(θ["p.skill_code-exploration.trigger"]))) return List.of();          // src: vvaharness/skills/code-exploration/SKILL.md:3
        // Not a vulnerability lens: coverage procedure underneath every lens.
        assert θ["p.skill_code-exploration.coverage_procedure_under_every_lens"];                    // src: vvaharness/skills/code-exploration/SKILL.md:24
        Inventory inv = enumerate(repo, θ);                                                          // section 1
        Census census = splitByDirectory(inv, θ);
        Set<String> scope = new Set<String>();
        globSkippedClasses(repo, inv, scope, θ);                                                     // section 2
        List<Finding> findings = new List<Finding>();
        Set<String> fullyRead = new Set<String>();
        Set<String> excluded = new Set<String>();
        Worklist<String> queue = new Worklist<String>(inv.paths);
        while (!queue.isEmpty() && !stopCondition(inv, fullyRead, excluded, θ)) {
            String file = queue.next();
            ReadResult rr = readToEnd(file, θ);                                                      // section 3
            if (rr.excludedFromScope) {
                // third state: neither read nor unread
                if (θ["p.skill_code-exploration.record_scope_excluded_as_third_state"]) excluded.add(file); // src: vvaharness/skills/code-exploration/SKILL.md:103
                continue;
            }
            if (rr.complete) fullyRead.add(file);
            queue.addAll(followEdges(file, rr, θ));                                                  // section 4
            for (Candidate c : lens.candidatesIn(file, rr)) {
                if (!passesHardGate(c, inv, rr, θ)) continue;
                if (refuted(c, repo, rr, θ)) continue;                                               // FP checks
                findings.addAll(enumerateSites(c, θ));                                               // enumeration rule
            }
            if (θ["p.skill_code-exploration.ask_what_else_in_file"]) findings.addAll(askWhatElse(file, rr, lens)); // src: vvaharness/skills/code-exploration/SKILL.md:263
            census.mark(file);
        }
        reportCoverage(inv, census, fullyRead, excluded, θ);
        return findings;
    }

    Inventory enumerate(Repo repo, Theta θ) {
        // Glob first, always; never start from the file you were handed.
        if (θ["p.skill_code-exploration.glob_first_always"]) {                                     // src: vvaharness/skills/code-exploration/SKILL.md:77
            Inventory inv = Tools.Glob(θ["p.skill_code-exploration.inventory_glob_pattern"]);        // src: vvaharness/skills/code-exploration/SKILL.md:80
            // Glob truncates at 500 hits: narrow by subtree until every group returns whole.
            while (inv.size() >= θ["p.skill_code-exploration.glob_truncation_500_narrow"] && inv.hasMoreMarker()) { // src: vvaharness/skills/code-exploration/SKILL.md:100
                inv = inv.mergeSubtreeGlobs(inv.topDirs().map(d -> Tools.Glob(d + "/**")));
            }
            // Graph node list is never a substitute (graph skips the dot-namespace).
            if (θ["p.skill_code-exploration.graph_not_inventory"]) inv.source = "Glob";             // src: vvaharness/skills/code-exploration/SKILL.md:107
            return inv;
        }
        return Tools.GraphNodes();
    }

    Census splitByDirectory(Inventory inv, Theta θ) {
        Census c = new Census();
        if (θ["p.skill_code-exploration.split_inventory_by_directory_plan"]) c = inv.groupByDirectory().writeAsPlan(); // src: vvaharness/skills/code-exploration/SKILL.md:83
        if (θ["p.skill_code-exploration.mark_groups_and_sum_counts"]) assert c.sumCounts() == inv.size(); // src: vvaharness/skills/code-exploration/SKILL.md:91
        return c;
    }

    void globSkippedClasses(Repo repo, Inventory inv, Set<String> scope, Theta θ) {
        if (!θ["p.skill_code-exploration.glob_skipped_classes_by_name"]) return;                     // src: vvaharness/skills/code-exploration/SKILL.md:114
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_templates_globs"]));               // src: vvaharness/skills/code-exploration/SKILL.md:117
        List<Hit> esc = Tools.Grep(θ["p.skill_code-exploration.grep_templates_escape_defeats"]);     // src: vvaharness/skills/code-exploration/SKILL.md:119
        if (θ["p.skill_code-exploration.read_every_escape_hit"]) for (Hit h : esc) scope.add(h.file); // src: vvaharness/skills/code-exploration/SKILL.md:124
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_container_orchestration_globs"])); // src: vvaharness/skills/code-exploration/SKILL.md:126
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_cicd_globs"]));                    // src: vvaharness/skills/code-exploration/SKILL.md:135
        // CI files read for: pull_request_target, unpinned actions, github.event interpolation into run:, secrets echoed
        scope.lookFor(θ["p.skill_code-exploration.cicd_read_for"]);                                  // src: vvaharness/skills/code-exploration/SKILL.md:136
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_dependency_manifest_globs"]));     // src: vvaharness/skills/code-exploration/SKILL.md:139
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_dotfile_env_globs"]));             // src: vvaharness/skills/code-exploration/SKILL.md:144
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_sql_migration_globs"]));           // src: vvaharness/skills/code-exploration/SKILL.md:149
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_static_asset_globs"]));            // src: vvaharness/skills/code-exploration/SKILL.md:152
        scope.addAll(Tools.Glob(θ["p.skill_code-exploration.class_init_base_helper_globs"]));        // src: vvaharness/skills/code-exploration/SKILL.md:155
    }

    ReadResult readToEnd(String file, Theta θ) {
        ReadResult rr = new ReadResult(file);
        int offset = 0;
        while (true) {
            Page pg = Tools.Read(file, offset, θ["p.skill_code-exploration.read_page_limit"]);       // src: vvaharness/skills/code-exploration/SKILL.md:174
            rr.append(pg);
            if (pg.isScopeExclusionError()) { rr.excludedFromScope = true; return rr; }
            boolean truncated = θ["p.skill_code-exploration.watch_truncation_markers"] && pg.tailHasTruncationMarker(); // src: vvaharness/skills/code-exploration/SKILL.md:178
            if (truncated && θ["p.skill_code-exploration.continue_from_last_line"]) { offset = pg.lastLineShown; continue; } // src: vvaharness/skills/code-exploration/SKILL.md:181
            // EOF proof: offset-past-EOF marker or a short page with no truncation marker
            if (θ["p.skill_code-exploration.confirm_eof"] && (pg.isPastEof() || pg.lines < θ["p.skill_code-exploration.read_page_limit"])) break; // src: vvaharness/skills/code-exploration/SKILL.md:184
            offset = pg.lastLineShown;
        }
        rr.complete = true;
        // Reader window trap: only first 800,000 chars decoded, 200,000 per page -> EOF may be false.
        List<Integer> win = θ["p.skill_code-exploration.reader_window_limits"];                     // src: vvaharness/skills/code-exploration/SKILL.md:187
        if (rr.fileChars > win.get(0) && θ["p.skill_code-exploration.grep_tail_construct_record_partial"]) { // src: vvaharness/skills/code-exploration/SKILL.md:189
            Hit tail = Tools.Grep(file, rr.expectedTailConstruct());
            if (tail != null && tail.line > rr.lastLineSeen) { rr.complete = false; rr.partial = true; }
        }
        // Narrow with offset/limit only after a full read; Grep locates, never concludes.
        assert θ["p.skill_code-exploration.narrow_only_after_full_read"];                            // src: vvaharness/skills/code-exploration/SKILL.md:192
        assert θ["p.skill_code-exploration.grep_locates_never_concludes"];                           // src: vvaharness/skills/code-exploration/SKILL.md:193
        return rr;
    }

    List<String> followEdges(String file, ReadResult rr, Theta θ) {
        List<String> next = new List<String>();
        if (!θ["p.skill_code-exploration.edges_mandatory"]) return next;                             // src: vvaharness/skills/code-exploration/SKILL.md:197
        if (θ["p.skill_code-exploration.edge_handler_to_template"]) next.addAll(rr.renderedTemplates()); // src: vvaharness/skills/code-exploration/SKILL.md:200
        if (θ["p.skill_code-exploration.edge_handler_to_model"]) next.addAll(rr.writtenModels().withBaseClassMigrationSerializer()); // src: vvaharness/skills/code-exploration/SKILL.md:204
        if (θ["p.skill_code-exploration.edge_config_and_template_parent"]) { next.addAll(rr.configFilesForKeysRead()); next.addAll(rr.extendsOrIncludes()); } // src: vvaharness/skills/code-exploration/SKILL.md:206
        if (θ["p.skill_code-exploration.use_graph_real_signatures"]) {                               // src: vvaharness/skills/code-exploration/SKILL.md:208
            List<String> importers = Tools.call(θ["p.skill_code-exploration.graph_importers_usage"], file); // src: vvaharness/skills/code-exploration/SKILL.md:209
            for (String fn : rr.functions()) next.addAll(Tools.call(θ["p.skill_code-exploration.graph_neighbors_both_args"], file, fn)); // src: vvaharness/skills/code-exploration/SKILL.md:210
            next.addAll(Tools.call(θ["p.skill_code-exploration.graph_community_then_sinks"], file)); // src: vvaharness/skills/code-exploration/SKILL.md:212
            if (θ["p.skill_code-exploration.cweguidance_once_class_in_hand"] && rr.hasClassInHand()) Tools.CweGuidance(rr.cweInHand()); // src: vvaharness/skills/code-exploration/SKILL.md:214
            // Empty graph answer is a signal, not an all-clear (function-body imports have no module-level importer).
            if (θ["p.skill_code-exploration.empty_graph_not_all_clear"] && importers.isEmpty() && rr.looksLive()) { // src: vvaharness/skills/code-exploration/SKILL.md:215
                if (θ["p.skill_code-exploration.no_importer_read_init"]) next.add(rr.packageInitPy()); // src: vvaharness/skills/code-exploration/SKILL.md:218
            }
            next.addAll(importers);
        }
        // Graph hits add to the Glob sweep; never replace it.
        assert θ["p.skill_code-exploration.graph_adds_never_replaces"];                              // src: vvaharness/skills/code-exploration/SKILL.md:220
        return next;
    }

    boolean passesHardGate(Candidate c, Inventory inv, ReadResult rr, Theta θ) {
        if (θ["p.skill_code-exploration.gate_written_inventory"] && !inv.writtenDown) return false;  // src: vvaharness/skills/code-exploration/SKILL.md:65
        if (θ["p.skill_code-exploration.gate_file_read_to_last_line"] && !rr.complete) return false;  // src: vvaharness/skills/code-exploration/SKILL.md:67
        if (θ["p.skill_code-exploration.gate_path_and_real_line_span"] && !(c.hasRepoRelativePath() && c.lineSpanFromNumberedRead())) return false; // src: vvaharness/skills/code-exploration/SKILL.md:69
        if (c.cweIds.size() != θ["p.skill_code-exploration.gate_one_most_specific_cwe"]) return false; // src: vvaharness/skills/code-exploration/SKILL.md:70
        if (θ["p.skill_code-exploration.gate_absence_names_files_opened"] && c.isAbsenceClaim() && c.filesOpenedForControl.isEmpty()) return false; // src: vvaharness/skills/code-exploration/SKILL.md:71
        // Example paths in this doc are shapes, never targets; never report what you have not read.
        if (θ["p.skill_code-exploration.examples_are_not_targets"] && c.derivedFromSkillExample()) return false; // src: vvaharness/skills/code-exploration/SKILL.md:30
        if (θ["p.skill_code-exploration.never_report_unread"] && !c.siteWasRead()) return false;      // src: vvaharness/skills/code-exploration/SKILL.md:31
        // Shapes in central files (section 2)
        if (θ["p.skill_code-exploration.read_abstract_base_before_model_claims"] && c.claimsModelLacksIdOrTimestamp() && !c.readAbstractBase()) return false; // src: vvaharness/skills/code-exploration/SKILL.md:165
        return true;
    }

    boolean refuted(Candidate c, Repo repo, ReadResult rr, Theta θ) {
        // A refutation with a named search is a result.
        if (θ["p.skill_code-exploration.refute_with_named_search"]) c.recordNamedSearch();         // src: vvaharness/skills/code-exploration/SKILL.md:225
        if (θ["p.skill_code-exploration.fp_control_exists_elsewhere"] && c.isMissingGuard()) {     // src: vvaharness/skills/code-exploration/SKILL.md:227
            // open __init__.py, base class, router registration, middleware, reverse-proxy config
            if (repo.findCentralControl(c, List.of("**/__init__.py", "base class", "blueprint registration", "**/middleware*", "proxy config")) != null) return true;
        }
        if (θ["p.skill_code-exploration.fp_template_autoescapes"] && c.isXss() && !c.siteHasEscapeDefeatMarker()) return true; // src: vvaharness/skills/code-exploration/SKILL.md:231
        if (θ["p.skill_code-exploration.fp_file_not_shipped"] && (c.fileIgnoredByDockerOrGit() || c.underTests())) return true; // src: vvaharness/skills/code-exploration/SKILL.md:234
        if (θ["p.skill_code-exploration.fp_prose_is_not_the_bug"] && c.fileIsDocumentation()) return true; // src: vvaharness/skills/code-exploration/SKILL.md:236
        if (θ["p.skill_code-exploration.fp_example_config"] && c.fileIsExampleWithPlaceholders()) return true; // src: vvaharness/skills/code-exploration/SKILL.md:238
        if (θ["p.skill_code-exploration.fp_fixed_literal"] && !c.attackerVaried()) return true;     // src: vvaharness/skills/code-exploration/SKILL.md:240
        if (θ["p.skill_code-exploration.fp_prefix_only_not_gated"] && !rr.complete) return true;     // src: vvaharness/skills/code-exploration/SKILL.md:241
        return false;
    }

    List<Finding> enumerateSites(Candidate c, Theta θ) {
        List<Finding> out = new List<Finding>();
        if (θ["p.skill_code-exploration.enum_one_finding_per_site"]) {                              // src: vvaharness/skills/code-exploration/SKILL.md:246
            for (Site s : c.distinctSites()) {
                // noisy grep: writers are findings, readers/verifiers are hits to judge
                if (θ["p.skill_code-exploration.enum_sort_noisy_grep"] && s.onlyReadsTheConstruct()) continue; // src: vvaharness/skills/code-exploration/SKILL.md:255
                if (θ["p.skill_code-exploration.do_not_pad_duplicates"] && out.containsSameConstruct(s)) continue; // src: vvaharness/skills/code-exploration/SKILL.md:260
                out.add(new Finding(s.file, s.lineStart, s.lineEnd, c.cwe));
            }
            if (θ["p.skill_code-exploration.state_what_counted"]) c.explainCounted(out);             // src: vvaharness/skills/code-exploration/SKILL.md:256
        } else {
            out.add(c.asFinding());
        }
        if (θ["p.skill_code-exploration.never_collapse_omnibus"]) out.removeIf(f -> f.isOmnibus()); // src: vvaharness/skills/code-exploration/SKILL.md:258
        return out;
    }

    List<Finding> askWhatElse(String file, ReadResult rr, Lens lens) {
        // Two classes, two CWEs, two findings, one file you already had open.
        return lens.otherClassesIn(file, rr);
    }

    boolean stopCondition(Inventory inv, Set<String> fullyRead, Set<String> excluded, Theta θ) {
        // Coverage = inventory minus files read to end; compute explicitly before stopping.
        Set<String> gap = θ["p.skill_code-exploration.coverage_is_set_difference"] ? inv.paths.minus(fullyRead) : Set.empty(); // src: vvaharness/skills/code-exploration/SKILL.md:94
        if (θ["p.skill_code-exploration.compute_coverage_before_stop"] && !gap.isEmpty()) {         // src: vvaharness/skills/code-exploration/SKILL.md:95
            // non-empty -> mid-pass, not done (unless every remaining entry is listed with a reason)
        }
        // Only two endings: gap empty, or every remaining element listed with a reason.
        return gap.isEmpty() || gap.allListedWithReason(θ["p.skill_code-exploration.exploration_stop_condition"]); // src: vvaharness/skills/code-exploration/SKILL.md:283
    }

    void reportCoverage(Inventory inv, Census census, Set<String> fullyRead, Set<String> excluded, Theta θ) {
        Report r = new Report();
        r.arithmetic(θ["p.skill_code-exploration.coverage_report_arithmetic"], inv.size(), census.opened(), fullyRead.size(), excluded.size()); // src: vvaharness/skills/code-exploration/SKILL.md:271
        if (θ["p.skill_code-exploration.coverage_report_unfinished_list"]) r.unfinished(inv.paths.minus(fullyRead).withReasons()); // src: vvaharness/skills/code-exploration/SKILL.md:272
        if (θ["p.skill_code-exploration.coverage_report_group_status"]) r.groups(census.openClosed()); // src: vvaharness/skills/code-exploration/SKILL.md:275
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt frontmatter(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_code-exploration.trigger"]);                                               // src: vvaharness/skills/code-exploration/SKILL.md:3
        return p;
    }

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_code-exploration.coverage_procedure_under_every_lens"]);                // src: vvaharness/skills/code-exploration/SKILL.md:24
        p.forbid(θ["p.skill_code-exploration.examples_are_not_targets"]);                            // src: vvaharness/skills/code-exploration/SKILL.md:30
        p.forbid(θ["p.skill_code-exploration.never_report_unread"]);                                 // src: vvaharness/skills/code-exploration/SKILL.md:31
        p.context("measured failure: 17 of 44 paths (38%) named; 27 files invisible");               // src: vvaharness/skills/code-exploration/SKILL.md:37
        return p;
    }

    Prompt hardGate(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_code-exploration.gate_written_inventory"]);                               // src: vvaharness/skills/code-exploration/SKILL.md:65
        p.must(θ["p.skill_code-exploration.gate_file_read_to_last_line"]);                          // src: vvaharness/skills/code-exploration/SKILL.md:67
        p.evidence(θ["p.skill_code-exploration.gate_path_and_real_line_span"]);                     // src: vvaharness/skills/code-exploration/SKILL.md:69
        p.threshold(θ["p.skill_code-exploration.gate_one_most_specific_cwe"]);                      // src: vvaharness/skills/code-exploration/SKILL.md:70
        p.evidence(θ["p.skill_code-exploration.gate_absence_names_files_opened"]);                  // src: vvaharness/skills/code-exploration/SKILL.md:71
        return p;
    }

    Prompt enumerateSection(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.skill_code-exploration.glob_first_always"]);                                 // src: vvaharness/skills/code-exploration/SKILL.md:77
        p.rule(θ["p.skill_code-exploration.inventory_glob_pattern"]);                               // src: vvaharness/skills/code-exploration/SKILL.md:80
        p.step(2, θ["p.skill_code-exploration.split_inventory_by_directory_plan"]);                 // src: vvaharness/skills/code-exploration/SKILL.md:83
        p.must(θ["p.skill_code-exploration.mark_groups_and_sum_counts"]);                           // src: vvaharness/skills/code-exploration/SKILL.md:91
        p.rule(θ["p.skill_code-exploration.coverage_is_set_difference"]);                           // src: vvaharness/skills/code-exploration/SKILL.md:94
        p.must(θ["p.skill_code-exploration.compute_coverage_before_stop"]);                         // src: vvaharness/skills/code-exploration/SKILL.md:95
        p.threshold(θ["p.skill_code-exploration.glob_truncation_500_narrow"]);                      // src: vvaharness/skills/code-exploration/SKILL.md:100
        p.rule(θ["p.skill_code-exploration.record_scope_excluded_as_third_state"]);                 // src: vvaharness/skills/code-exploration/SKILL.md:103
        p.forbid(θ["p.skill_code-exploration.graph_not_inventory"]);                                // src: vvaharness/skills/code-exploration/SKILL.md:107
        return p;
    }

    Prompt skippedClassesSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_code-exploration.glob_skipped_classes_by_name"]);                         // src: vvaharness/skills/code-exploration/SKILL.md:114
        p.checklist(θ["p.skill_code-exploration.class_templates_globs"]);                           // src: vvaharness/skills/code-exploration/SKILL.md:117
        p.checklist(θ["p.skill_code-exploration.grep_templates_escape_defeats"]);                   // src: vvaharness/skills/code-exploration/SKILL.md:119
        p.must(θ["p.skill_code-exploration.read_every_escape_hit"]);                                // src: vvaharness/skills/code-exploration/SKILL.md:124
        p.checklist(θ["p.skill_code-exploration.class_container_orchestration_globs"]);             // src: vvaharness/skills/code-exploration/SKILL.md:126
        p.checklist(θ["p.skill_code-exploration.class_cicd_globs"]);                                // src: vvaharness/skills/code-exploration/SKILL.md:135
        p.checklist(θ["p.skill_code-exploration.cicd_read_for"]);                                   // src: vvaharness/skills/code-exploration/SKILL.md:136
        p.checklist(θ["p.skill_code-exploration.class_dependency_manifest_globs"]);                 // src: vvaharness/skills/code-exploration/SKILL.md:139
        p.rule(θ["p.skill_code-exploration.unpinned_or_ancient_versions_are_findings"]);            // src: vvaharness/skills/code-exploration/SKILL.md:141
        p.checklist(θ["p.skill_code-exploration.class_dotfile_env_globs"]);                         // src: vvaharness/skills/code-exploration/SKILL.md:144
        p.rule(θ["p.skill_code-exploration.committed_real_values_are_credential_findings"]);        // src: vvaharness/skills/code-exploration/SKILL.md:145
        p.checklist(θ["p.skill_code-exploration.class_sql_migration_globs"]);                       // src: vvaharness/skills/code-exploration/SKILL.md:149
        p.checklist(θ["p.skill_code-exploration.class_static_asset_globs"]);                        // src: vvaharness/skills/code-exploration/SKILL.md:152
        p.checklist(θ["p.skill_code-exploration.class_init_base_helper_globs"]);                    // src: vvaharness/skills/code-exploration/SKILL.md:155
        p.rule(θ["p.skill_code-exploration.init_route_registration_shape"]);                        // src: vvaharness/skills/code-exploration/SKILL.md:160
        p.rule(θ["p.skill_code-exploration.init_engine_echo_shape"]);                               // src: vvaharness/skills/code-exploration/SKILL.md:163
        p.must(θ["p.skill_code-exploration.read_abstract_base_before_model_claims"]);               // src: vvaharness/skills/code-exploration/SKILL.md:165
        p.rule(θ["p.skill_code-exploration.base_template_settles_control"]);                        // src: vvaharness/skills/code-exploration/SKILL.md:167
        return p;
    }

    Prompt readToEndSection(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.skill_code-exploration.read_page_limit"]);                                 // src: vvaharness/skills/code-exploration/SKILL.md:174
