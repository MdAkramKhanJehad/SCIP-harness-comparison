// file: vvaharness/remediation_agent/remediate.py, vvaharness/remediation_agent/policy/context.py, vvaharness/remediation_agent/plugin_runner/__init__.py, vvaharness/remediation_agent/plugin_runner/helpers.py, vvaharness/orchestrator/scan.py
// S10 entry: parse the scan report, select the top-N findings by CVSS, and walk them through the per-finding fix loop.
// Also renders where the step_remediate.* session knobs take effect (policy context build, per-finding session invoke).

@executedBy(CODE) @role(stage) @stage("S10")
class RemediationAgentRemediate {

    int run(String repo, List<String> args, Config cfg, Theta θ) {
        // Pipeline path: scan.py runs S10 only when --remediate or step_remediate.enabled, and only with findings.
        boolean remOn = args.contains("--remediate") || θ["step_remediate.enabled"];               // src: vvaharness/orchestrator/scan.py:997
        if (!remOn) return 0;                                                                       // src: vvaharness/orchestrator/scan.py:1000
        if (repo == null) return 2;                                                                 // src: vvaharness/remediation_agent/remediate.py:40
        if (cfg == null) return 2;                                                                  // src: vvaharness/remediation_agent/remediate.py:43
        RemediateOptions opts = RemediationAgentOptions.parseOptions(args);                                         // src: vvaharness/remediation_agent/remediate.py:48
        if (opts == null) return 2;                                                                 // src: vvaharness/remediation_agent/remediate.py:50
        if (!Path.exists(repo)) return 1;                                                           // src: vvaharness/remediation_agent/remediate.py:54
        Path report = RemediationAgentDiscovery.locateReport(repo);                                                 // src: vvaharness/remediation_agent/remediate.py:58
        if (report == null) return 1;                                                               // src: vvaharness/remediation_agent/remediate.py:59
        Integer top;
        // Interactive picker: a profile cap must not pre-truncate the list; an explicit --top still applies.
        if (opts.interactive && opts.top == null) {                                                 // src: vvaharness/remediation_agent/remediate.py:63
            top = null;
        } else {
            top = Topspec.resolveTop(opts.top, θ["step_remediate.top_n_findings"]);                // src: vvaharness/remediation_agent/remediate.py:66
        }
        Found found = RemediationAgentDiscovery.loadFindings(repo, report, top);                                    // src: vvaharness/remediation_agent/remediate.py:69
        if (found == null) return 1;                                                                // src: vvaharness/remediation_agent/remediate.py:70  (corrupt findings.json is an error, no MD fallback)
        List<RemediationTarget> findings = found.selected;                                          // src: vvaharness/remediation_agent/remediate.py:74
        if (findings.size() == 0) return 0;                                                         // src: vvaharness/remediation_agent/remediate.py:77
        Layout layout = RemediationAgentDiscovery.prepareLayout(repo);                                              // src: vvaharness/remediation_agent/remediate.py:81
        Checkpoints.pruneStaleSteps(layout.runId, "remediate", found.discovered.map(t -> Runner.stepKeyOf(t, cfg))); // src: vvaharness/remediation_agent/remediate.py:83
        if (opts.interactive) {                                                                     // src: vvaharness/remediation_agent/remediate.py:92
            return Interactive.runInteractive(findings, report, layout, cfg, opts.mode, opts.verbose); // src: vvaharness/remediation_agent/remediate.py:94
        }
        return Runner.processTargets(findings, layout, cfg, repo, opts, report, θ);                 // src: vvaharness/remediation_agent/remediate.py:100
    }
}

// policy/context.py: load gate + playbook once per run (honouring profile path overrides).
@executedBy(CODE) @role(config) @stage("S10")
class PolicyContextBuild {

    boolean policyEnabled(Theta θ) {
        return θ["step_remediate.enforce_policy"];                                                  // src: vvaharness/remediation_agent/policy/context.py:38
    }

    String resolveInput(Config cfg, String raw) {
        if (raw == null || raw.isEmpty()) return null;                                              // src: vvaharness/remediation_agent/policy/context.py:54  (None -> bundled default)
        if (Paths.isNetworkPath(raw)) throw new ValueError("refusing network/UNC remediation input path"); // src: vvaharness/remediation_agent/policy/context.py:57
        String resolved = Paths.resolveAgainst(cfg.configDir, raw);                                 // src: vvaharness/remediation_agent/policy/context.py:62
        if (!Path.exists(resolved)) return null;                                                    // src: vvaharness/remediation_agent/policy/context.py:63  (falls back to bundled default)
        return resolved;
    }

    PolicyContext buildContext(Config cfg, String repoRoot, Theta θ) {
        String policyFile = resolveInput(cfg, θ["step_remediate.policy_file"]);                    // src: vvaharness/remediation_agent/policy/context.py:72
        String playbookFile = resolveInput(cfg, θ["step_remediate.playbook_file"]);                // src: vvaharness/remediation_agent/policy/context.py:73
        RemediationGate gate = RemediationAgentPolicyGate.load(policyFile, θ);                     // src: vvaharness/remediation_agent/policy/context.py:74
        Playbook pb = RemediationAgentPlaybook.load(playbookFile, θ);                              // src: vvaharness/remediation_agent/policy/context.py:75
        Set<String> fw = Frameworks.detectFrameworks(repoRoot);                                     // src: vvaharness/remediation_agent/policy/context.py:77  (exception -> empty set)
        return new PolicyContext(gate, pb, fw, policyEnabled(θ));                                   // src: vvaharness/remediation_agent/policy/context.py:80
    }
}

// plugin_runner/__init__.py + helpers.py: one fix session for one finding, routed by backend.
@executedBy(CODE) @role(backend) @stage("S10")
class PluginRunnerInvoke {

    List<String> tools(Theta θ) {
        List<String> t = θ["step_remediate.allowed_tools"];                                         // src: vvaharness/remediation_agent/plugin_runner/helpers.py:32
        return (t != null && !t.isEmpty()) ? t : List.of("Read", "Glob", "Grep");                    // src: vvaharness/remediation_agent/plugin_runner/helpers.py:33
    }

    int timeoutOf(Theta θ) {
        int t = θ["step_remediate.timeout"];                                                        // src: vvaharness/remediation_agent/plugin_runner/__init__.py:115
        return t > 0 ? t : 3600;                                                                    // src: vvaharness/remediation_agent/plugin_runner/__init__.py:115  (falsy -> one hour)
    }

    ModelCallBudget remediateCallBudget(Theta θ) {
        int limit = θ["step_remediate.max_model_calls"];                                            // src: vvaharness/remediation_agent/plugin_runner/__init__.py:125
        if (limit <= 0) return null;                                                                // src: vvaharness/remediation_agent/plugin_runner/__init__.py:126  (unmetered)
        // On the last call every tool but RemediationVerdict is withdrawn.
        return new ModelCallBudget(limit, Set.of("RemediationVerdict"), "s10");                     // src: vvaharness/remediation_agent/plugin_runner/__init__.py:128
    }

    String symlinkSafeMode(String repo, String mode) {
        if (!mode.equals("fix")) return mode;                                                       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:445
        if (Policy.escapingSymlinks(repo).isEmpty()) return mode;                                   // src: vvaharness/remediation_agent/plugin_runner/__init__.py:448
        return "report";                                                                            // src: vvaharness/remediation_agent/plugin_runner/__init__.py:458  (symlink escaping checkout -> report-only, CWE-59)
    }

    Object invoke(RemediationTarget target, Config cfg, String repo, String mode, boolean verbose, PreResult pre, PolicyContext ctx, Theta θ) {
        String user = RemediationAgentPrompts.buildUserFromPolicy(target, repo, mode, pre, ctx, θ); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:465
        ModelSpec m = Registry.resolve(cfg.models.remediate);                                       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:466
        mode = symlinkSafeMode(repo, mode);                                                         // src: vvaharness/remediation_agent/plugin_runner/__init__.py:468
        if (m.via.equals("deepagents")) {                                                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:469
            return invokeDeepagents(user, m, repo, mode, target.file, θ);                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:475
        } else if (m.via.equals("cli")) {                                                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:480
            return invokeCli(user, m, repo, mode, θ);                                               // src: vvaharness/remediation_agent/plugin_runner/__init__.py:481
        }
        // sdk/openai: no permission_mode fallback, the tools list is the only gate.
        List<String> tools = tools(θ).filter(t -> !t.equals("Edit") && !t.equals("Write"));        // src: vvaharness/remediation_agent/plugin_runner/__init__.py:487
        if (mode.equals("fix")) tools = tools.plus("Edit", "Write");                                // src: vvaharness/remediation_agent/plugin_runner/__init__.py:489
        Bounds b = new Bounds(θ["step_remediate.max_turns"], 0, timeoutOf(θ), θ["step_remediate.max_budget_usd"]); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:496
        return Runtime.agent(new AgentSpec(m, tools, List.of(), RemediationAgentPrompts.system(θ), user, b, "RemediationVerdict", false)); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:490
    }

    Object invokeDeepagents(String user, ModelSpec m, String repo, String mode, String primaryFile, Theta θ) {
        List<String> tools = tools(θ).filter(t -> !t.equals("Bash"));                              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:335
        boolean fixMode = mode.equals("fix");                                                       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:336
        Map<String, Subagent> agents = Map.of();
        if (fixMode) {                                                                              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:347
            // Orchestrator reads redacted source; the fixer (with Edit) reads unredacted.
            agents = Map.of("fixer", new Subagent(RemediationAgentPrompts.fixerSystem(θ), tools.plus("Edit"), "FixerResult", θ["step_remediate.max_model_calls"])); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:350
        }
        // On deepagents max_turns is a recursion floor (max_turns + 900), not a hard cap.
        Bounds b = new Bounds(θ["step_remediate.max_turns"], θ["step_remediate.max_model_calls"], timeoutOf(θ), θ["step_remediate.max_budget_usd"]); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:366
        Prompt sys = fixMode ? RemediationAgentPrompts.orchestratorSystem(θ) : RemediationAgentPrompts.system(θ); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:368
        // Parent middleware: FixerDispatchGuard (fix mode) + model-call budget; verdict tool forced only to end the session.
        Middleware mw = List.of(fixMode ? new FixerDispatchGuard(user, primaryFile) : null, remediateCallBudget(θ)); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:380
        Transcript t = Runtime.agent(new AgentSpec(m, tools, List.of(), sys, user, b, "RemediationVerdict", false)); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:387
        if (t.structured != null) return t.structured;                                              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:294
        // No structured verdict: ask the same model to emit its verdict as JSON from its own history.
        return Runtime.llm(m, null, "return ONLY a JSON object matching RemediationVerdict schema", "RemediationVerdict"); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:298
    }

    Object invokeCli(String user, ModelSpec m, String repo, String mode, Theta θ) {
        List<String> tools = tools(θ).filter(t -> !t.equals("Bash"));                              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:402
        if (mode.equals("fix")) tools = tools.plus("Edit", "Write");                                // src: vvaharness/remediation_agent/plugin_runner/__init__.py:405
        // One context reads unredacted source on via:cli (no orchestrator/fixer split).
        Bounds b = new Bounds(θ["step_remediate.max_turns"], 0, timeoutOf(θ), θ["step_remediate.max_budget_usd"]); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:420
        String permission = mode.equals("fix") ? "acceptEdits" : "default";                         // src: vvaharness/remediation_agent/plugin_runner/__init__.py:430
        return Runtime.agent(new AgentSpec(m, tools, List.of(), RemediationAgentPrompts.system(θ), user, b, "RemediationVerdict", false)); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:414
    }
}
