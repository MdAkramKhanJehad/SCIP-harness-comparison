// file: vvaharness/remediation_agent/artifacts/diff/snapshot.py
// Captures file contents before the agent edits them (for diff synthesis and post-gate restore), and which files changed since.

@executedBy(CODE) @role(io) @stage("S10")
class Snapshot {

    List<String> changedSinceSnapshot(String repo, Map<String, String> before) {
        // Non-git counterpart to changedFilesWholeTree.
        List<String> changed = new List();
        for (String rel : (before != null ? before : Map.of()).keys()) {                            // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:33
            Path p = DiffPaths.safeRepoPath(repo, rel);                                             // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:34
            if (p == null) continue;                                                                // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:36
            String now;
            try {
                now = p.isFile() ? p.readText() : null;                                             // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:38
            } catch (Exception e) {
                now = null;                                                                         // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:40  (binary/unreadable = absent)
            }
            if (!Objects.equals(now, before.get(rel))) changed.add(rel);                            // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:41
        }
        return changed;
    }

    Map<String, String> snapshotFiles(String repo, List<String> files) {
        Map<String, String> snap = new Map();
        for (String f : files) {                                                                    // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:50
            String rel = DiffPaths.normPath(f);                                                     // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:51
            if (rel.isEmpty() || snap.containsKey(rel)) continue;                                   // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:52
            // Fail closed on out-of-repo refs so host/CI files cannot leak into the diff artifact (CWE-22).
            Path p = DiffPaths.safeRepoPath(repo, f);                                               // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:55
            if (p == null) continue;                                                                // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:59
            try {
                snap.put(rel, p.isFile() ? p.readText() : null);                                    // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:61  (null = did not exist)
            } catch (Exception e) {
                snap.put(rel, null);                                                                // src: vvaharness/remediation_agent/artifacts/diff/snapshot.py:63
            }
        }
        return snap;
    }
}
