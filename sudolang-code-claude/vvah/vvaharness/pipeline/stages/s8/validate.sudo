// src: vvaharness/pipeline/stages/s8/validate.py:39-56
fn location_key(ranked, step):executor=code { return [ranked[step].finding.file, ranked[step].finding.line_start] }   // not line_end: it defaults 0 and Stage 6 rewrites it
fn collapse_same_location(steps, ranked):executor=code {
  kept = steps with any step whose location_key repeats an earlier one removed
  return [kept, length(steps) - length(kept)]
}

// src: vvaharness/pipeline/stages/s8/validate.py:59-87
fn resolve_citation(repo_root, file, line):executor=code {
  if (!file || line < 1) return false
  root = try resolved repo_root; catch => return false   // a symlink loop must not discard the enrichment
  // only these deterministic rewrites; anything else unresolved is the fabrication signal
  candidates = [file, file with leading "/" or "\" stripped (if different),
    absolute file made relative to root (if it starts with "/" or "\"),
    for file and stripped: the tail after a first path segment equal to the repository directory name]
  return any candidate c where length(s8.facts._file_lines(root, c)) >= line
}

// src: vvaharness/pipeline/stages/s8/validate.py:90-122
fn resolved_citation(repo_root, file, line):executor=code {
  file = trimmed file
  if (resolve_citation(repo_root, file, line)) return [true, file, line]
  [cand_file, cand_line] = _unpacked_citation(file, line)
  if ([cand_file, cand_line] != [file, line] && resolve_citation(repo_root, cand_file, cand_line)) return [true, cand_file, cand_line]
  return [false, file, 0]   // text kept, line zeroed: a truthy line reads as "checked evidence"
}

