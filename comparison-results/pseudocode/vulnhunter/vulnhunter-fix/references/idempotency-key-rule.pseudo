// file: vulnhunter-fix/references/idempotency-key-rule.md
// Rule book (REQ-GAT-005): vulnfix-key derivation, marker shape, and Gate 4 checks.
// Consumed by scripts/check-idempotency.py (Gate 4, pre-deliver via run-gates.py) and vulnhunter_fix.delivery.compute_idempotency_key()
// (also mirrored by scripts/parse_results.py and scripts/issue_intake.py compute_vulnfix_key).

@executedBy(MODEL) @role(rule_set) @stage("fix.deliver")
class IdempotencyKeyRule {

    // Entry: stamp the marker into an artifact body, then gate it.
    boolean apply(Artifact a, Finding f, Theta θ) {
        a.body = embedMarkers(a, f, θ);
        return gate4(List.of(a), θ);
    }

    String deriveKey(Finding f, Theta θ) {
        String location = f.location;
        if (θ["p.idempotency-key-rule.location_canonical_repo_relative"]) {                        // src: vulnhunter-fix/references/idempotency-key-rule.md:21
            location = canonicalRepoRelative(f.location);
        }
        String cwe = f.cwe;
        if (θ["p.idempotency-key-rule.primary_cwe_first_match"] == "first CWE-\\d+ match") {       // src: vulnhunter-fix/references/idempotency-key-rule.md:22
            cwe = Regex.search("CWE-\\d+", f.cwe).group();                                         // handles "CWE-89, CWE-79"
        }
        String rootCause = f.rootCause;
        if (θ["p.idempotency-key-rule.root_cause_not_normalized"]) {                              // src: vulnhunter-fix/references/idempotency-key-rule.md:23
            rootCause = normalize(rootCause);                                                       // default false: passed through byte-identical
        }
        String formula = θ["p.idempotency-key-rule.key_derivation"];                              // src: vulnhunter-fix/references/idempotency-key-rule.md:18
        // formula = sha256(location + "|" + primary_cwe + "|" + root_cause)[:16]
        return Hash.sha256(location + "|" + cwe + "|" + rootCause).hex().substring(0, 16);        // src: vulnhunter-fix/references/idempotency-key-rule.md:18
    }

    String embedMarkers(Artifact a, Finding f, Theta θ) {
        String body = a.body + θ["p.idempotency-key-rule.marker_format"].replace("<16 hex chars>", deriveKey(f, θ)); // src: vulnhunter-fix/references/idempotency-key-rule.md:10
        if (a.kind == TRACKING_ISSUE && θ["p.idempotency-key-rule.tracking_issue_report_id_marker"]) {              // src: vulnhunter-fix/references/idempotency-key-rule.md:13
            body = body + "<!-- vulnfix-report-id: " + a.reportId + " -->";
        }
        return body;
    }

    @executedBy(CODE)
    boolean gate4(List<Artifact> bodies, Theta θ) {
        List<String> errors = new List();
        for (Artifact a : bodies) {
            String key = Regex.find("vulnfix-key: (\\S+)", a.body);
            if (θ["p.idempotency-key-rule.gate4_marker_required"] && key == null) errors.add("missing vulnfix-key"); // src: vulnhunter-fix/references/idempotency-key-rule.md:30
            if (a.kind == TRACKING_ISSUE && θ["p.idempotency-key-rule.gate4_report_id_required"]) {                   // src: vulnhunter-fix/references/idempotency-key-rule.md:31
                String rid = Regex.find("vulnfix-report-id: (\\S+)", a.body);
                if (rid == null) errors.add("missing vulnfix-report-id");
                else if (!Regex.fullmatch(θ["p.idempotency-key-rule.gate4_key_pattern"], rid)) errors.add("malformed report-id"); // src: vulnhunter-fix/references/idempotency-key-rule.md:32
            }
            if (key != null && !Regex.fullmatch(θ["p.idempotency-key-rule.gate4_key_pattern"], key)) errors.add("malformed key"); // src: vulnhunter-fix/references/idempotency-key-rule.md:32
        }
        if (!errors.isEmpty() && θ["p.idempotency-key-rule.gate4_failure_halts_delivery"]) {       // src: vulnhunter-fix/references/idempotency-key-rule.md:34
            Delivery.halt(errors);
            return false;
        }
        return errors.isEmpty();
    }
}
