# vvaharness/detect/spec.py

`MatchSpec`: one compiled pattern a detector treats as a source, sink or detector rule, with the gates a detector rule applies before it fires.

Source: `vvaharness/detect/spec.py` (lines 1-48)
Executor: code
Called from: `vvaharness/detect/patterns.py` (corpus), `vvaharness/detect/matcher.py`; detector rules come from the Stage 5 rule pack

// src: vvaharness/detect/spec.py:21-48
MatchSpec {
  // frozen
  rule_id: String
  role: "source" | "sink" | "detector"
  pattern: String              // regular expression matched against one line of source text
  cwe: String
  kind: String
  semantic_family: String = ""
  owasp_top10_2025: Set<String> = {}
  // detector-rule fields (role == "detector"); line specs ignore them
  enabled: Boolean = true      // per-rule kill switch, part of the rule data
  languages: Set<String> = {}  // EXT_TO_LANG keys
  title: String = ""           // finding title minted for a hit
  citation: String = ""        // one-line public CWE/OWASP citation
  span: "line" | "call" | "block" = "line"   // call = balanced parentheses within span_max_lines; block = up to span_end
  span_end: String = ""        // regular expression closing a block span (for example "</form")
  span_max_lines: Number = 1
  present_re: String = ""      // fire only when the span DOES match this
  absent_re: String = ""       // fire only when the span does NOT match this
  absent_window: Number = 0    // extra lines the absent_re guard also sees (negative gate only)
  file_re: String = ""         // file-scope gate: the whole file must match somewhere
  near_re: String = ""         // proximity gate: must match within near_window lines
  near_window: Number = 0
}
