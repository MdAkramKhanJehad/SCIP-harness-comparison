// file: vvaharness/backends/harness/registry.py
// Backend registry: maps the `via` selector to a lazy Harness factory (each backend's SDK imported only on use).

@executedBy(CODE) @role(backend)
class HarnessRegistry {

    HarnessHarness makeClaude() {
        return new ClaudeClient();                                                                       // src: vvaharness/backends/harness/registry.py:34
    }

    HarnessHarness makeDeepagents() {
        try {
            return new Client();      // DeepAgentHarness                                                // src: vvaharness/backends/harness/registry.py:50
        } catch (ImportError e) {
            // deepagents requires Python 3.11+
            throw new RuntimeError("the deepagents backend needs the 'deepagents' package ... Use via: cli or sdk, or upgrade Python."); // src: vvaharness/backends/harness/registry.py:48
        }
    }

    HarnessHarness getHarness(String via, Theta θ) {
        String key = (via == null || via.isEmpty()) ? θ["code.backends.harness.registry.default_via"] : via; // src: vvaharness/backends/harness/registry.py:62
        // _BACKENDS: cli -> claude, sdk -> claude, deepagents -> deepagents
        Map<String, Supplier<HarnessHarness>> backends = Map.of("cli", makeClaude, "sdk", makeClaude, "deepagents", makeDeepagents); // src: vvaharness/backends/harness/registry.py:53
        Supplier<HarnessHarness> factory = backends.get(key);                                            // src: vvaharness/backends/harness/registry.py:63
        if (factory == null) throw new ValueError("unknown backend " + key);                             // src: vvaharness/backends/harness/registry.py:66
        return factory.get();                                                                            // src: vvaharness/backends/harness/registry.py:67
    }
}
