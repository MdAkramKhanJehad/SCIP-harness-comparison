// file: vvaharness/backends/harness/deepagents/usage.py
// Recover token usage for DeepAgents sessions from AIMessage usage_metadata, normalized to fresh input
// (input_tokens - cache_read - cache_creation), with a per-persona (subagent namespace) breakdown.

@executedBy(CODE) @role(types)
record SessionUsage(int inputTokens, int outputTokens, int cacheReadInputTokens, int cacheCreationInputTokens, int calls, int turns, Map<String, TokenUsage> subagents) { }

@executedBy(CODE) @role(backend)
class Usage {
    static Set<String> EXCLUSIVE_USAGE_WARNED = new Set();

    int asInt(Object value) {
        if (value instanceof Boolean || !(value instanceof Integer)) return 0;                           // src: vvaharness/backends/harness/deepagents/usage.py:40
        return value;
    }

    // TTL cache-write keys langchain-anthropic nests under input_token_details.
    List<String> ephemeralCacheKeys() {
        return List.of("ephemeral_5m_input_tokens", "ephemeral_1h_input_tokens");                        // src: vvaharness/backends/harness/deepagents/usage.py:46
    }

    Pair<Integer, Integer> cacheCounts(Map<String, Object> meta) {
        Object details = meta.get("input_token_details");                                                // src: vvaharness/backends/harness/deepagents/usage.py:54
        if (!(details instanceof Map)) return Pair.of(0, 0);                                             // src: vvaharness/backends/harness/deepagents/usage.py:56
        int ephemeral = ephemeralCacheKeys().sum(k -> asInt(details.get(k)));                            // src: vvaharness/backends/harness/deepagents/usage.py:57
        int cacheCreation = ephemeral > 0 ? ephemeral : asInt(details.get("cache_creation"));            // src: vvaharness/backends/harness/deepagents/usage.py:58
        return Pair.of(asInt(details.get("cache_read")), cacheCreation);                                 // src: vvaharness/backends/harness/deepagents/usage.py:59
    }

    int rawCacheCreation(Map<String, Object> raw) {
        if (raw == null) return 0;                                                                       // src: vvaharness/backends/harness/deepagents/usage.py:64
        int creation = asInt(raw.get("cache_creation_input_tokens"));                                    // src: vvaharness/backends/harness/deepagents/usage.py:66
        if (creation == 0 && raw.get("cache_creation") instanceof Map) {                                 // src: vvaharness/backends/harness/deepagents/usage.py:67
            creation = ephemeralCacheKeys().sum(k -> asInt(raw.get("cache_creation").get(k)));           // src: vvaharness/backends/harness/deepagents/usage.py:71
        }
        return creation;
    }

    Pair<List<String>, Map<String, Object>> unpackEvent(Object event) {
        if (!(event instanceof Tuple)) return Pair.of(List.of(), event);                                 // src: vvaharness/backends/harness/deepagents/usage.py:129
        if (event.size() != 2) return Pair.of(List.of(), null);                                          // src: vvaharness/backends/harness/deepagents/usage.py:133
        List<String> namespace = event.first instanceof List ? event.first.map(p -> str(p)) : List.of(); // src: vvaharness/backends/harness/deepagents/usage.py:134
        return Pair.of(namespace, event.second instanceof Map ? event.second : null);                    // src: vvaharness/backends/harness/deepagents/usage.py:139
    }

    SessionUsage aggregateUsageMetadata(List<Object> messages) {
        UsageAccumulator acc = new UsageAccumulator();                                                   // src: vvaharness/backends/harness/deepagents/usage.py:226
        for (Object m : messages) {
            if (m instanceof BaseMessage) acc.addMessage(m, List.of());                                  // src: vvaharness/backends/harness/deepagents/usage.py:229
        }
        return acc.snapshot();                                                                           // src: vvaharness/backends/harness/deepagents/usage.py:230
    }
}

@executedBy(CODE) @role(backend)
class UsageCounts {
    int inputTokens = 0;
    int outputTokens = 0;
    int cacheRead = 0;
    int cacheCreation = 0;
    int calls = 0;

    void add(Map<String, Object> meta, Map<String, Object> rawUsage) {
        Pair<Integer, Integer> c = Usage.cacheCounts(meta);                                              // src: vvaharness/backends/harness/deepagents/usage.py:89
        int cacheRead = c.first;
        int cacheCreation = c.second;
        if (cacheCreation == 0) cacheCreation = Usage.rawCacheCreation(rawUsage);   // gateways omitting the detail key // src: vvaharness/backends/harness/deepagents/usage.py:92
        int totalInput = Usage.asInt(meta.get("input_tokens"));                                          // src: vvaharness/backends/harness/deepagents/usage.py:93
        int cached = cacheRead + cacheCreation;
        int fresh;
        if (totalInput < cached) {                                                                       // src: vvaharness/backends/harness/deepagents/usage.py:95
            // exclusive-convention gateway (cache counted outside input_tokens): treat input_tokens as fresh-only
            WarnOnce.warnOnce(Usage.EXCLUSIVE_USAGE_WARNED, "exclusive-usage-record", "[deepagents] WARN: usage record reports more cached input than total input"); // src: vvaharness/backends/harness/deepagents/usage.py:97
            fresh = totalInput;                                                                          // src: vvaharness/backends/harness/deepagents/usage.py:106
        } else {
            fresh = totalInput - cached;                                                                 // src: vvaharness/backends/harness/deepagents/usage.py:108
        }
        this.inputTokens += fresh;
        this.outputTokens += Usage.asInt(meta.get("output_tokens"));                                     // src: vvaharness/backends/harness/deepagents/usage.py:110
        this.cacheRead += cacheRead;
        this.cacheCreation += cacheCreation;
        this.calls += 1;                                                                                 // src: vvaharness/backends/harness/deepagents/usage.py:113
    }

    TokenUsage asUsage() {
        return new TokenUsage(inputTokens, outputTokens, cacheRead, cacheCreation);                      // src: vvaharness/backends/harness/deepagents/usage.py:116
    }
}

@executedBy(CODE) @role(backend)
class UsageAccumulator {
    Set<String> seenIds = new Set();
    UsageCounts total = new UsageCounts();
    Map<String, UsageCounts> subagents = new Map();
    Map<List<String>, String> nsToAgent = new Map();

    void addEvent(Object event) {
        Pair<List<String>, Map<String, Object>> e = Usage.unpackEvent(event);                            // src: vvaharness/backends/harness/deepagents/usage.py:156
        if (e.second == null) return;                                                                    // src: vvaharness/backends/harness/deepagents/usage.py:157
        for (Object update : e.second.values()) addUpdate(update, e.first);                              // src: vvaharness/backends/harness/deepagents/usage.py:160
    }

    void addUpdate(Object update, List<String> namespace) {
        if (!(update instanceof Map)) return;                                                            // src: vvaharness/backends/harness/deepagents/usage.py:163
        Object msgs = update.get("messages");
        if (!(msgs instanceof List)) return;                                                             // src: vvaharness/backends/harness/deepagents/usage.py:166
        for (Object msg : msgs) {
            if (msg instanceof BaseMessage) addMessage(msg, namespace);                                  // src: vvaharness/backends/harness/deepagents/usage.py:170
        }
    }

    // Dedupe by message id (the same message appears in several stream updates).
    boolean isDuplicate(Object messageId) {
        if (!(messageId instanceof String)) return false;                                                // src: vvaharness/backends/harness/deepagents/usage.py:173
        if (seenIds.contains(messageId)) return true;                                                    // src: vvaharness/backends/harness/deepagents/usage.py:175
        seenIds.add(messageId);
        return false;
    }

    void addMessage(BaseMessage message, List<String> namespace) {
        if (!(message instanceof AIMessage)) return;                                                     // src: vvaharness/backends/harness/deepagents/usage.py:184
        String name = message.name;
        if (!namespace.isEmpty() && name != null) nsToAgent.put(namespace, name);                        // src: vvaharness/backends/harness/deepagents/usage.py:187
        Map<String, Object> meta = message.usageMetadata;
        if (meta == null || isDuplicate(message.id)) return;                                             // src: vvaharness/backends/harness/deepagents/usage.py:190
        Object raw = message.responseMetadata.get("usage");
        Map<String, Object> rawUsage = raw instanceof Map ? raw : null;                                  // src: vvaharness/backends/harness/deepagents/usage.py:193
        total.add(meta, rawUsage);                                                                       // src: vvaharness/backends/harness/deepagents/usage.py:194
        if (!namespace.isEmpty()) {
            String agent = agentLabel(namespace, name);                                                  // src: vvaharness/backends/harness/deepagents/usage.py:196
            subagents.computeIfAbsent(agent, new UsageCounts()).add(meta, rawUsage);                     // src: vvaharness/backends/harness/deepagents/usage.py:197
        }
    }

    String agentLabel(List<String> namespace, String name) {
        if (name != null && !name.isEmpty()) return name;                                                // src: vvaharness/backends/harness/deepagents/usage.py:200
        String learned = nsToAgent.get(namespace);
        if (learned != null) return learned;                                                             // src: vvaharness/backends/harness/deepagents/usage.py:203
        return namespace.get(0).split(":", 1)[0];          // "node_name:task_id" -> node name           // src: vvaharness/backends/harness/deepagents/usage.py:206
    }

    // Callers must pass turns themselves: TOKENS.add(usage, usage.turns).
    SessionUsage snapshot() {
        if (total.calls == 0) return null;                                                               // src: vvaharness/backends/harness/deepagents/usage.py:211
        SessionUsage usage = new SessionUsage(total.asUsage());                                          // src: vvaharness/backends/harness/deepagents/usage.py:213
        usage.calls = total.calls;
        usage.turns = total.calls;                         // one model call counted as one turn         // src: vvaharness/backends/harness/deepagents/usage.py:215
        if (!subagents.isEmpty()) usage.subagents = sortedByKey(subagents).mapValues(c -> c.asUsage());  // src: vvaharness/backends/harness/deepagents/usage.py:217
        return usage;
    }
}
