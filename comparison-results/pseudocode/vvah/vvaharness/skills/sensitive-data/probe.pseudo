// file: vvaharness/skills/sensitive-data/probe.sh
// Sensitive-data exposure sweep: ~20 labelled, case-insensitive grep sections across error/debug exposure, logging,
// serialization, storage, headers/caching, debug routes and settings constants; CAP=20 hits shown per section.

@executedBy(CODE) @role(tool) @stage("S4")
class SensitiveDataProbe {

    int CAP = 20;                                                                                           // src: vvaharness/skills/sensitive-data/probe.sh:19
    List<String> EXCLUDE_DIRS = List.of(".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build", ".vvaharness", "vendor"); // src: vvaharness/skills/sensitive-data/probe.sh:20

    ProbeOutput run(Path root, Theta θ) {
        // sensitive-name vocabulary used inside the log, serializer, markup and column patterns
        String sens = θ["p.skill_sensitive-data.probe_sensitive_name_regex"];                               // src: vvaharness/skills/sensitive-data/probe.sh:22
        ProbeOutput out = new ProbeOutput("Candidates only. Each needs sensitive content AND an attacker-reachable channel."); // src: vvaharness/skills/sensitive-data/probe.sh:42
        for (String label : θ["p.skill_sensitive-data.probe_leak_channels"]) {                             // src: vvaharness/skills/sensitive-data/probe.sh:45
            out.add(hits(label, sens, root));
        }
        return out;
    }

    Section hits(String label, String sens, Path root) {
        List<String> lines = Grep.rEni(root, label.patternWith(sens), EXCLUDE_DIRS);                      // src: vvaharness/skills/sensitive-data/probe.sh:29
        if (lines.isEmpty()) return Section.none(label);                                                    // "(none)": polarity sections read this as a finding // src: vvaharness/skills/sensitive-data/probe.sh:31
        return new Section(label, lines.size(), lines.head(CAP));                                           // src: vvaharness/skills/sensitive-data/probe.sh:34
    }
}
