# vvaharness/report/appcontext.py

Application context to contextual severity, with no model involved: reads the configuration-management database (CMDB) CSV, resolves an application's exposure and data-sensitivity flags (inheriting blank flags from a parent), computes a CVSS 3.1 environmental score with a fixed static-analysis temporal preset, and assigns a keyword- and vector-driven OffensivePriority P1-P4 with a reason string.

Source: `vvaharness/report/appcontext.py` (lines 1-386)
Executor: code
Called from: `vvaharness/orchestrator/cmdb.py` (load_cmdb_csv, lookup_app), `vvaharness/orchestrator/enrich_findings.py` (vsvs_score, offensive_priority_for, after Stage 7), `vvaharness/pipeline/stages/s9_sarif.py`, `vvaharness/pipeline/stages/s9/typed_sarif.py`

// src: vvaharness/report/appcontext.py:30-34
csv field size limit = 2^31 - 1
[SAST_E, SAST_RL, SAST_RC] = ["P", "O", "C"]   // temporal preset: proof-of-concept, official fix, confirmed

// src: vvaharness/report/appcontext.py:36-78
// Lower-case substrings searched in title + category + description.
Options keywords {
  KW_CODE_KNOWLEDGE: ["source code is accessible", "access to the source", "access to the repo", "read access to the repo", "decompil",
    "reverse engineer", "if the attacker knows", "knowing the function", "knowledge of the source", "internal function name",
    "would need to know", "hardcoded credential", "hardcoded password", "hardcoded secret", "hardcoded token",
    "hard-coded credential", "hard-coded password", "hard-coded secret", "credential in source", "secret in source",
    "test credential", "qa credential", "qa password", "test password", "encryption key in source", "key hardcoded"]
  KW_INTERNAL: ["internal network", "intranet", "corporate network", "internal-only", "internal only", "back-office",
    "corporate sso", "enterprise sso", "enterprise idp", "behind sso", "behind the idp", "loopback", "127.0.0.1", "localhost",
    "local listener", "local user", "local access", "same host", "on the host", "service-to-service", "mtls",
    "behind api gateway", "behind the gateway", "vpn", "external partner", "third-party provisioned", "log access",
    "db access", "database access", "mitm", "man-in-the-middle", "man in the middle", "compromised server",
    "compromise of", "control of the", "physical access", "adjacent network"]
  KW_HIGH_PRIV: ["super_admin", "super admin", "system_admin", "dist_admin", "with admin", "as an admin", "an admin user",
    "admin role", "privileged user", "privileged account", "requires admin", "admin-only", "admin privileges"]
  KW_OBTAINABLE_AUTH: ["self-registration", "self-registered", "self registration", "free signup", "sign up for",
    "any registered user", "any authenticated user", "any user account", "any valid user", "developer account",
    "portal user", "merchant account", "low-privilege user", "low privilege user", "lowest role"]
  KW_NO_AUTH: ["unauthenticated", "no authentication", "without authentication", "no auth required", "without auth",
    "pre-auth", "anonymous", "no credentials", "without credentials", "[allowanonymous]", "allowanonymous",
    "publicly accessible", "public endpoint"]
}

// src: vvaharness/report/appcontext.py:82-110
AppInfo {
  id, name, externally_facing = false, pci_scoped = false, processes_pan = false, pii = false
  ext_raw, pci_raw, pan_raw, pii_raw   // null when the CSV cell is blank: that is what lets a child inherit from its parent
  parent_app_id, source = "application"
  cr() = if (pci_scoped || processes_pan || pii) "H" else "M"
  ir() = if (pci_scoped || processes_pan) "H" else "M"
  ar() = "M"
  mav(base_av) = if (!externally_facing && base_av == "N") "A" else base_av   // not externally facing: network becomes adjacent
}

// src: vvaharness/report/appcontext.py:113-128
fn _yes(v) = v != null && lowercase(trim(v)) == "yes"
fn _nz(v) = trimmed v, or null when blank
fn normalize_app_id(app_id) = app_id with leading zeros removed, or "0"; null stays null   // "042" and "42" collide

// src: vvaharness/report/appcontext.py:147-204
fn load_cmdb_csv(path):executor=code {
  if (!path || !path is a file) return {}
  header = first row that is non-empty, not starting with "#", and not all blank   // the file carries a license comment block
  if (header == null) return {}
  columns by lower-case name: id, name, externally_facing, pci, pan, pii, parent_id
  require "id" column present => throw ValueError("CMDB CSV missing 'id' column: $path")
  for each later row with a non-blank id {
    a = AppInfo with raw flags = _nz(cell), boolean flags = _yes(raw), parent_app_id = _nz(parent_id)
    key = normalize_app_id(a.id)
    if (key already loaded && _cmdb_enrichment_differs(prior, a)) warn APPCONTEXT_KEY_COLLISION   // both raw ids logged
    out[key] = a   // last row wins, deliberately
  }
  return out
}

// src: vvaharness/report/appcontext.py:139-144
fn _cmdb_enrichment_differs(x, y) = any of externally_facing, pci_scoped, processes_pan, pii differs || normalized parent ids differ

// src: vvaharness/report/appcontext.py:230-254
fn lookup_app(app_id, cmdb, cmdb_comp):executor=code {
  if (!app_id) return null
  key = normalize_app_id(app_id); a = cmdb[key]; c = cmdb_comp[key]   // cmdb_comp: the component table
  if (a != null) {
    any_blank = any of a.pci_raw, a.pan_raw, a.pii_raw, a.ext_raw is null
    parent_id = a.parent_app_id || (c.parent_app_id if c exists)
    if (any_blank && parent_id) {
      p = cmdb[normalize_app_id(parent_id)]
      if (p && normalize_app_id(p.id) != key) return _merge_with_parent(a, a, p, "application->parent ${p.id}")   // no self-parent
    }
    a.source = "application"; return a
  }
  if (c == null) return null
  p = if (c.parent_app_id) cmdb[normalize_app_id(c.parent_app_id)] else null
  return _merge_with_parent(c, c, p, if (p) "component->parent ${p.id}" else "component")
}

// src: vvaharness/report/appcontext.py:207-227
fn _merge_with_parent(base, own, parent, source):executor=code {
  // per flag: own non-blank value wins; else the parent's value; else own's (false)
  for each flag in [externally_facing, pci_scoped, processes_pan, pii], r.flag = _pick(own, parent, flag)
  r.id, r.name = base.id, base.name; r.parent_app_id = own.parent_app_id; r.source = source
  return r
}

// src: vvaharness/report/appcontext.py:280-310
fn vsvs_score(base_vector, app):executor=code {
  if (!base_vector || app == null) return null
  m = parse_vector(base_vector)   // "K:V" pairs split on "/", upper-cased
  require AV, AC, PR, UI, S, C, I, A all present => return null
  mav = app.mav(m.AV); scope_changed = m.S == "C"
  weights from cvss tables (MAV via cvss.AV, PR by scope); unknown letters -> NO_SCORE
  require no weight < 0 => return null
  cr, ir, ar = cvss.REQ[app.cr() / ir() / ar()] or, when absent, NEUTRAL_WEIGHT   // "M" is not in REQ, so M -> 1.0
  e, rl, rc = EXPLOIT_MATURITY["P"], REMEDIATION_LEVEL["O"], REPORT_CONFIDENCE["C"]   // 0.94, 0.95, 1.0
  miss = min(1 - (1 - cr*c) * (1 - ir*i) * (1 - ar*a), MISS_CAP)
  m_impact = cvss.modified_impact(miss, scope_changed)
  env_vector = base (prefixed "CVSS:3.1/" if needed) + "/E:P/RL:O/RC:C/CR:<cr>/IR:<ir>/AR:<ar>/MAV:<mav>"
  if (m_impact <= 0) return VsvsResult(env_vector, 0.0, "None")
  mod_base = cvss.combine(m_impact, 8.22 * mav * ac * pr * ui, scope_changed)
  env = cvss.roundup1(mod_base * e * rl * rc)
  return VsvsResult(env_vector, env, cvss.rating(env))
}

// src: vvaharness/report/appcontext.py:318-384
fn offensive_priority_for(title, category, description, cvss_vector, app):executor=code {
  body = lowercase(title + category + description)
  v = parse_vector(cvss_vector) or {}
  av = v.AV or, when absent, "N"; pr = v.PR or, when absent, "L"; pr_explicit = "PR" in v; ac = v.AC or, when absent, "L"
  cmdb_external = app != null && app.externally_facing
  cmdb_internal = app != null && !app.externally_facing
  code_knowledge = body contains any KW_CODE_KNOWLEDGE || category contains "hardcoded"
  internal_net = cmdb_internal || av in [A, L, P] || body contains any KW_INTERNAL
  high_priv = pr == "H" || body contains any KW_HIGH_PRIV
  obtainable_auth = pr == "L" || body contains any KW_OBTAINABLE_AUTH
  pr_requires_auth = pr_explicit && pr in [L, H]   // an explicit PR:L/H vetoes a stray "unauthenticated" in prose
  no_auth = !pr_requires_auth && (body contains any KW_NO_AUTH || (pr == "N" && !obtainable_auth && !high_priv))
  internet_reachable = av == "N" && !internal_net && cmdb_external
  exposure_unknown = app == null && av == "N" && !internal_net

  // first matching branch wins
  if (code_knowledge) prio = "P4"                         // "requires source-code / insider knowledge"
  else if (exposure_unknown && !high_priv) prio = "P3"    // "exposure unverified — no CMDB context"
  else if (!internet_reachable || high_priv) prio = "P3"  // internal / non-network / privileged position
  else if (no_auth) prio = "P1"                           // "internet-facing" + "AV:<av> - unauthenticated"
  else prio = "P2"                                        // "PR:<pr> - auth required but obtainable"
  if (ac == "H" && prio in [P1, P2]) append reason "AC:H - complex preconditions"   // annotates only, no demotion
  return [prio, reasons joined by "; "]
  // abstracted: the exact reason strings per branch (lines 346-379) are display text
}
// src: vvaharness/report/appcontext.py:318-344
// preserved: with no CMDB record (app == null) an AV:N finding is at best P3, so P1 and P2 require a CMDB row marked externally facing.
