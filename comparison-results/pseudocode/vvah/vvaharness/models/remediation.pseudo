// file: vvaharness/models/remediation.py
// Remediation contract: what an S10 engine produced; finalize() turns engine evidence into the contract.
// The pydantic model Remediation is rendered as record RemediationData; class Remediation holds finalize().

@executedBy(CODE) @role(types)
record FileChange(String file, String summary) { }

@executedBy(CODE) @role(types)
record RemediationData(RemediationKind kind, String summary, Disposition disposition, String diff, List<String> filesTouched,
                   List<FileChange> changes, List<GateAssessment> gates, String rootCause, List<String> remainingRisks,
                   List<String> recommendations, String externalRef, Provenance producedBy) {
    // diff/filesTouched advisory: the harness's own pre/post snapshot is authoritative            // src: vvaharness/models/remediation.py:52

    RemediationData requireDispositionForNoAction() {
        if (kind == RemediationKind.NO_ACTION && disposition == null) {                             // src: vvaharness/models/remediation.py:66
            throw new ValueError("kind=no_action requires a disposition explaining why nothing was applied"); // src: vvaharness/models/remediation.py:68
        }
        return this;
    }
}

@executedBy(CODE) @role(types)
record RemediationEvidence(RemediationOutcome outcome, String summary, String rootCause, List<FileChange> changes,
                           List<GateAssessment> gates, List<String> remainingRisks, List<String> recommendations, Provenance producedBy) { }

@executedBy(CODE) @role(rule_set) @stage("S10")
class Remediation {

    Remediation finalize(RemediationEvidence evidence, String mode, String diff, List<String> filesTouched) {
        // _KIND: outcome -> (fix-mode kind, report-mode kind, disposition)
        //   FIXED, PARTIALLY_FIXED -> (EDITS_APPLIED, DIFF_PROPOSED, null)
        //   NOT_FIXED, NEEDS_REVIEW -> (NO_ACTION, NO_ACTION, NOT_APPLICABLE); FALSE_POSITIVE -> FALSE_POSITIVE; DENIED -> POLICY_DENIED
        Triple t = θ["code.models.remediation.outcome_kind_map"].get(evidence.outcome);             // src: vvaharness/models/remediation.py:108
        RemediationKind kind = θ["code.models.remediation.report_only_modes"].contains(mode) ? t.reportKind : t.fixKind; // src: vvaharness/models/remediation.py:109
        if (θ["code.models.remediation.empty_edit_as_already_resolved"]
                && kind == RemediationKind.EDITS_APPLIED && filesTouched.isEmpty() && diff.isEmpty()) { // src: vvaharness/models/remediation.py:111
            kind = RemediationKind.ALREADY_RESOLVED;                                                // src: vvaharness/models/remediation.py:112
        }
        return new Remediation(kind, evidence.summary, t.disposition, diff, filesTouched, evidence.changes, evidence.gates,
                               evidence.rootCause, evidence.remainingRisks, evidence.recommendations, "", evidence.producedBy); // src: vvaharness/models/remediation.py:113
    }
}
