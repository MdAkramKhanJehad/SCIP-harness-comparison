// file: vvaharness/util/logs.py
// Structured logging for the vvaharness package: key-value lines to a terminal, JSON to a file, always redacted.
// Diagnostics only; nothing here changes what a scan finds.

@executedBy(CODE) @role(io)
class Logs {

    static final String ROOT = "vvaharness";                                   // src: vvaharness/util/logs.py:31
    static final List<String> LEVELS = List.of("critical", "error", "warning", "info", "debug"); // src: vvaharness/util/logs.py:34
    static final String DEFAULT_LEVEL = "warning";                             // src: vvaharness/util/logs.py:36
    boolean cliMode = false;                                                   // true once configure() ran // src: vvaharness/util/logs.py:39
    static final List<String> SKIP = List.of("event", "level", "logger", "timestamp", "code", "exc_info", "exception", "func_name", "lineno", "stack"); // src: vvaharness/util/logs.py:116

    Logger getLogger(String name) {
        // processors: filter_by_level first, then SHARED chain, then final dispatch
        return wrapLogger(name, List.of(filterByLevel, SHARED, this::finalDispatch)); // src: vvaharness/util/logs.py:44
    }

    Object finalDispatch(Logger logger, String name, Map<String, Object> event) {
        if (cliMode) return wrapForFormatter(logger, name, event);             // src: vvaharness/util/logs.py:55
        Map<String, Object> kwargs = renderToLogKwargs(logger, name, event);   // embedder's own handlers // src: vvaharness/util/logs.py:57
        Object exc = kwargs.extra.get("exception");
        if (exc != null) {
            kwargs.msg = kwargs.msg + "\n" + exc;                              // src: vvaharness/util/logs.py:62
            kwargs.excInfo = false;                                            // no unredacted traceback re-render // src: vvaharness/util/logs.py:63
        }
        return kwargs;
    }

    Map<String, Object> eventCode(Logger l, String n, Map<String, Object> event) {
        if (event.get("event") instanceof Events) { event.put("code", ev.name); event.put("event", ev.value); } // src: vvaharness/util/logs.py:87
        return event;
    }

    Object redactValue(Object v) {
        if (v instanceof String) return Redact.redact(v);                      // src: vvaharness/util/logs.py:95
        if (v instanceof Throwable || v instanceof PathLike) return Redact.redact(str(v)); // src: vvaharness/util/logs.py:97
        if (v instanceof Collection) return sameType(v, v.map(x -> redactValue(x))); // src: vvaharness/util/logs.py:99
        if (v instanceof Map) return v.mapValues(x -> redactValue(x));         // src: vvaharness/util/logs.py:103
        return v;
    }

    Map<String, Object> redactEvent(Logger l, String n, Map<String, Object> event) {
        return event.mapValues(v -> redactValue(v));                           // every field, any type // src: vvaharness/util/logs.py:110
    }

    String abbreviate(String dotted) {
        List<String> parts = dotted.split(".");
        if (parts.size() < 3) return dotted;                                   // src: vvaharness/util/logs.py:123
        return parts.head(-2).map(p -> p.charAt(0)).concat(parts.tail(2)).join("."); // src: vvaharness/util/logs.py:125
    }

    boolean supportsColour(Stream stream) {
        if (env("NO_COLOR") != null || env("TERM") == "dumb") return false;    // src: vvaharness/util/logs.py:155
        try { return stream.isatty(); } catch (OSError | ValueError e) { return false; } // src: vvaharness/util/logs.py:159
    }

    boolean configure(String level, Path path) {
        String asked = (level != null ? level : env("VVAHARNESS_LOG_LEVEL", "")).strip().lower(); // src: vvaharness/util/logs.py:183
        String chosen = asked.isEmpty() ? DEFAULT_LEVEL : asked;               // src: vvaharness/util/logs.py:184
        Integer numeric = LoggingLevels.get(chosen.upper());
        if (numeric == null) {                                                 // src: vvaharness/util/logs.py:186
            stderr.print("WARN: unknown log level; expected one of " + LEVELS);
            numeric = WARNING; asked = "";                                     // src: vvaharness/util/logs.py:189
        }
        Logger log = loggingGetLogger(ROOT);
        for (Handler h : log.handlers.filter(h -> h.vvaharness)) { log.removeHandler(h); h.close(); } // replace ours // src: vvaharness/util/logs.py:192
        for (Handler h : handlers(path != null ? path : env("VVAHARNESS_LOG_FILE"))) { // src: vvaharness/util/logs.py:195
            h.setFormatter(formatter(h)); h.vvaharness = true; log.addHandler(h);
        }
        log.setLevel(numeric);                                                 // src: vvaharness/util/logs.py:199
        log.propagate = false;                                                 // no double lines via root // src: vvaharness/util/logs.py:201
        cliMode = true;
        return !asked.isEmpty();
    }

    Formatter formatter(Handler handler) {
        Renderer r = handler instanceof FileHandler ? JSONRenderer : new ProductRenderer(supportsColour(handler.stream)); // JSON for --log-file // src: vvaharness/util/logs.py:209
        return new ProcessorFormatter(SHARED, r);                              // src: vvaharness/util/logs.py:213
    }

    List<Handler> handlers(Path path) {
        StderrHandler stderrH = new StderrHandler();                           // looks sys.stderr up per record // src: vvaharness/util/logs.py:223
        if (path == null) return List.of(stderrH);                             // src: vvaharness/util/logs.py:224
        FileHandler fh;
        try { path.parent.mkdirs(); fh = new FileHandler(path); }              // src: vvaharness/util/logs.py:227
        catch (OSError e) { stderr.print("WARN: cannot open log file; logging to stderr"); return List.of(stderrH); } // src: vvaharness/util/logs.py:230
        stderrH.setLevel(WARNING);                                             // stderr capped once a file tees it // src: vvaharness/util/logs.py:234
        return List.of(stderrH, fh);
    }
}

@executedBy(CODE) @role(io)
class ProductRenderer {
    static final Map<String, String> TAG = Map.of("critical", "FATAL", "error", "ERROR", "warning", "WARN", "info", "INFO", "debug", "DEBUG"); // src: vvaharness/util/logs.py:113
    boolean colour;

    String paint(String text, String level) {
        return colour ? ansi(level, text) : text;                              // src: vvaharness/util/logs.py:136
    }

    String render(Logger l, String n, Map<String, Object> event) {
        String level = str(event.getOrDefault("level", "info"));
        String clock = str(event.get("timestamp")).substring(11, 23);          // src: vvaharness/util/logs.py:140
        String fields = event.keys().filter(k -> !Logs.SKIP.contains(k)).map(k -> k + "=" + event.get(k)).join(" "); // src: vvaharness/util/logs.py:141
        String code = event.get("code");
        String line = "  " + paint(clock, "debug") + " " + paint(TAG.get(level), level) + " " + abbreviate(event.get("logger")) + " : " + event.get("event"); // src: vvaharness/util/logs.py:144
        if (!fields.isEmpty() || code != null) line += "  " + paint(fields + " (" + code + ")", "debug"); // src: vvaharness/util/logs.py:147
        Object exc = event.get("exception");
        return exc instanceof String && !exc.isEmpty() ? line + "\n" + exc : line; // src: vvaharness/util/logs.py:150
    }
}
