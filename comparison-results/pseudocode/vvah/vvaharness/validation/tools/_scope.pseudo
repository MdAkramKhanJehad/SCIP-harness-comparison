// file: vvaharness/validation/tools/_scope.py
// Shared in-scope file iteration for the validation fact tools: mirrors the S1 production scan scope
// (module defaults, not the run's config), optionally keeps test dirs, and refuses workspace-escaping symlinks.

@executedBy(CODE) @role(tool) @stage("S11")
class ToolsScope {

    Set<String> testDirs(Theta θ) {
        return θ["code.validation.tools._scope.test_dirs"];                                         // test, tests, __tests__, e2e, fixtures, mocks, stubs ...  // src: vvaharness/validation/tools/_scope.py:34
    }

    Set<String> infraDirs(Theta θ) {
        Set<String> production = θ["step1.exclude_dirs"].lower();                                    // scope._DEFAULT_EXCLUDE_DIRS (module default; unclear: config overrides of step1.exclude_dirs do not reach here)  // src: vvaharness/validation/tools/_scope.py:38
        if (!production.containsAll(testDirs(θ))) throw new RuntimeError("validation _TEST_DIRS drifted from production set"); // import-time check  // src: vvaharness/validation/tools/_scope.py:43
        return production.minus(testDirs(θ));                                                        // src: vvaharness/validation/tools/_scope.py:39
    }

    boolean hasExcludedExt(String name, Theta θ) {
        return θ["step1.exclude_exts"].any(ext -> name.lower().endsWith(ext.lower()));              // scope._DEFAULT_EXCLUDE_EXTS  // src: vvaharness/validation/tools/_scope.py:52
    }

    boolean excludedFile(Path relPath, boolean includeTests, Theta θ) {
        if (hasExcludedExt(relPath.name(), θ)) return true;                                          // src: vvaharness/validation/tools/_scope.py:56
        return !includeTests && Scope.globHit(relPath.asPosix(), θ["step1.exclude_globs"]) != null; // test globs only when tests excluded  // src: vvaharness/validation/tools/_scope.py:58
    }

    boolean escapesWorkspace(Path path, Path root) {
        if (!path.isSymlink()) return false;                                                         // src: vvaharness/validation/tools/_scope.py:65
        try {
            path.resolve().relativeTo(root);                                                         // src: vvaharness/validation/tools/_scope.py:68
        } catch (OSError | ValueError e) {
            return true;                                                                             // host-file-disclosure guard  // src: vvaharness/validation/tools/_scope.py:70
        }
        return false;
    }

    Iterator<Path> iterInScopeFiles(Path workspace, boolean includeTests, Theta θ) {
        Path root = workspace.resolve();                                                             // src: vvaharness/validation/tools/_scope.py:77
        Set<String> excludedDirs = includeTests ? infraDirs(θ) : infraDirs(θ).union(testDirs(θ));    // src: vvaharness/validation/tools/_scope.py:78
        for (WalkEntry w : Os.walk(workspace, false)) {                                              // no symlink following  // src: vvaharness/validation/tools/_scope.py:79
            w.dirNames = w.dirNames.filter(n -> !excludedDirs.contains(n.lower()) || (n.lower().equals("target") && !Scope.hasTargetBuildMarker(w.current, List.of(), θ))).sorted(); // src: vvaharness/validation/tools/_scope.py:81
            for (String name : w.fileNames.sorted()) {                                               // src: vvaharness/validation/tools/_scope.py:87
                Path path = w.current.resolve(name);
                if (excludedFile(path.relativeTo(workspace), includeTests, θ) || escapesWorkspace(path, root) || !path.isFile()) continue; // src: vvaharness/validation/tools/_scope.py:90
                yield path;                                                                          // src: vvaharness/validation/tools/_scope.py:96
            }
        }
    }
}
