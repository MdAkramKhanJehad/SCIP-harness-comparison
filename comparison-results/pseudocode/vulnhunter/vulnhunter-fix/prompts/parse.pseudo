// file: vulnhunter-fix/prompts/parse.md
// Phase 1 (fork mode): parse VulnHunter results (local dir or repo URL) with scripts/parse_results.py,
// validate actionability, read PoC/exploit/README context, present a summary table, stop on errors.

@executedBy(MIXED) @role(prompt) @stage("fix.parse")
class PromptsParse {

    List<Finding> run(String resultsPath, String targetRepo, Theta θ) {
        Prompt p = prompt(θ);
        requireInputs(resultsPath, targetRepo, θ);
        resultsPath = resolveResultsPath(resultsPath, θ);
        List<Finding> findings = parseResults(resultsPath, θ);
        List<Finding> warn = validateActionable(findings, targetRepo, θ);
        readDetailedContext(findings, θ);
        present(findings, warn, θ);
        return findings;
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.parse.required_inputs"]);                                                    // src: vulnhunter-fix/prompts/parse.md:5
        p.must(θ["p.parse.git_gh_failure_stop"]);                                                   // src: vulnhunter-fix/prompts/parse.md:8
        p.step(1, θ["p.parse.url_results_shallow_clone"]);                                          // src: vulnhunter-fix/prompts/parse.md:16
        p.step(2, θ["p.parse.run_regex_parser"]);                                                   // src: vulnhunter-fix/prompts/parse.md:29
        p.step(3, θ["p.parse.actionability_checks"]);                                               // src: vulnhunter-fix/prompts/parse.md:36
        p.step(4, θ["p.parse.read_detailed_context"]);                                              // src: vulnhunter-fix/prompts/parse.md:44
        p.format(θ["p.parse.output_table_columns"]);                                                // src: vulnhunter-fix/prompts/parse.md:53
        p.rule(θ["p.parse.non_actionable_warn_only"]);                                              // src: vulnhunter-fix/prompts/parse.md:54
        p.must(θ["p.parse.stop_readme_missing"]);                                                   // src: vulnhunter-fix/prompts/parse.md:58
        p.must(θ["p.parse.stop_no_confirmed"]);                                                     // src: vulnhunter-fix/prompts/parse.md:59
        p.forbid(θ["p.parse.stop_parser_fail_no_freelance"]);                                       // src: vulnhunter-fix/prompts/parse.md:60
        return p;
    }

    @executedBy(MODEL)
    void requireInputs(String resultsPath, String targetRepo, Theta θ) {
        for (String name : θ["p.parse.required_inputs"]) if (value(name) == null) stop("missing input " + name); // src: vulnhunter-fix/prompts/parse.md:5
    }

    @executedBy(MODEL)
    String resolveResultsPath(String resultsPath, Theta θ) {
        if (resultsPath.startsWith("https://")) {                                                   // src: vulnhunter-fix/prompts/parse.md:14
            int rc = bash("git clone --depth 1 <RESULTS_PATH> " + θ["p.parse.url_results_shallow_clone"]); // src: vulnhunter-fix/prompts/parse.md:16
            // git/gh failure: STOP and ask the user to run it; no retry, no tool substitution
            if (rc != 0 && θ["p.parse.git_gh_failure_stop"]) stopAskUser();                         // src: vulnhunter-fix/prompts/parse.md:8
            resultsPath = θ["p.parse.url_results_shallow_clone"];                                   // src: vulnhunter-fix/prompts/parse.md:17
        }
        if (!exists(resultsPath + "/README.md") && θ["p.parse.stop_readme_missing"]) stop("Invalid results path. Expected VulnHunter output at: <path>"); // src: vulnhunter-fix/prompts/parse.md:58
        return resultsPath;
    }

    @executedBy(CODE)
    List<Finding> parseResults(String resultsPath, Theta θ) {
        List<Finding> fs = null;
        if (θ["p.parse.run_regex_parser"]) fs = ParseResults.run(resultsPath);                      // src: vulnhunter-fix/prompts/parse.md:29
        // parser failure: stop; never freelance findings from the README (in-place may use parse_issues.md Step 5a)
        if (fs == null && θ["p.parse.stop_parser_fail_no_freelance"]) stop("Failed to parse <path>/README.md"); // src: vulnhunter-fix/prompts/parse.md:60
        if (fs.filter(f -> f.status == "Confirmed").isEmpty() && θ["p.parse.stop_no_confirmed"]) stop("No confirmed vulnerabilities to remediate."); // src: vulnhunter-fix/prompts/parse.md:59
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> validateActionable(List<Finding> findings, String targetRepo, Theta θ) {
        List<Finding> warn = new List();
        for (Finding f : findings) {
            // Confirmed, non-empty fix strategy, location is a real file, PoC or exploit test exists
            boolean ok = f.status == "Confirmed" && !f.fixStrategy.isEmpty() && existsIn(targetRepo, f.location.file) && (f.pocExists || f.exploitTestExists); // src: vulnhunter-fix/prompts/parse.md:36
            if (!ok && θ["p.parse.actionability_checks"] != null) warn.add(f);                      // src: vulnhunter-fix/prompts/parse.md:36
        }
        return warn;
    }

    @executedBy(MODEL)
    void readDetailedContext(List<Finding> findings, Theta θ) {
        for (Finding f : findings.filter(x -> x.status == "Confirmed")) {
            for (String src : θ["p.parse.read_detailed_context"]) read(f, src);                     // src: vulnhunter-fix/prompts/parse.md:44
        }
    }

    @executedBy(MODEL)
    void present(List<Finding> findings, List<Finding> warn, Theta θ) {
        print(findings.size());                                                                     // src: vulnhunter-fix/prompts/parse.md:52
        printTable(findings, θ["p.parse.output_table_columns"]);                                    // src: vulnhunter-fix/prompts/parse.md:53
        // non-actionable findings: warn, do not block
        if (θ["p.parse.non_actionable_warn_only"] == "warn") printWarning(warn);                    // src: vulnhunter-fix/prompts/parse.md:54
    }
}
