// file: vvaharness/util/stage_telemetry.py
// Process-wide per-stage telemetry (outcome, duration) and the composer of the run manifest's
// stages / totals / pricing sections: token phases are mapped to stages and costed per role model.

@executedBy(CODE) @role(types)
record StageRecord(String label, String outcome, Double durationSec) { }

/** The shape of TOKENS.snapshot(); every key optional (total=False). */
@executedBy(CODE) @role(types)
record TokenSnapshot(int prompt, int completion, int total, int calls, int callsWithUsage,
                     int completionAbsent, Map<String, TokenBucket> byPhase) { }   // src: vvaharness/util/stage_telemetry.py:93
// completion_absent: explicit-null completions coerced to 0; kept in the shape so the composer does not lose it

@executedBy(CODE) @role(types)
record UnattributedTokens(int prompt, int completion, int cacheRead, int cacheWrite, int calls) { }

@executedBy(CODE) @role(types)
record StageEntry(String label, String outcome, Double durationSec, TokenBucket tokens, String model, Double costUsd, boolean costEstimated, String cachedFromConfigSha) { }

@executedBy(CODE) @role(types)
record Totals(int promptTokens, int completionTokens, int totalTokens, int cacheReadTokens, int cacheWriteTokens, int calls, int callsWithUsage,
              int completionAbsent, int cacheUnparsedCalls, Double costUsd, UnattributedTokens unattributed, TokenBucket cachedCarryover) { }

@executedBy(CODE) @role(types)
record PricingProvenance(String file, String sha256, String source) { }

@executedBy(CODE) @role(types)
record PricingStatus(String status, String reason) { }

@executedBy(CODE) @role(types)
record StageSection(Map<String, StageEntry> stages, Totals totals, PricingProvenance pricing, PricingStatus pricingStatus) { }

@executedBy(CODE) @role(evaluation)
class StageTelemetry {

    static final List<String> STAGE_IDS = List.of("s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11"); // src: vvaharness/util/stage_telemetry.py:34
    // token phase -> (stage, role whose model prices it); an unmapped phase rolls to totals.unattributed
    static final Map<String, Pair<String, String>> PHASE_MAP = Map.of(         // src: vvaharness/util/stage_telemetry.py:37
        "s0-seed", Pair.of("s0", null), "s1-autoexclude", Pair.of("s1", "autoexclude"), "s1-preprocess", Pair.of("s1", "preprocess"),
        "s2-threatmodel", Pair.of("s2", "threatmodel"), "s3-decompose", Pair.of("s3", "decompose"), "s4-deepdive", Pair.of("s4", "deepdive"),
        "s5-prefilter", Pair.of("s5", "dedup"), "s6-verify", Pair.of("s6", "verify"), "s6-ev", Pair.of("s6", "exploit_verification.attacker"),
        "s7-dedup", Pair.of("s7", "dedup"), "s8-chain", Pair.of("s8", "chain"), "s10-remediate", Pair.of("s10", "remediate"),
        "remediation-agent-remediate", Pair.of("s10", "remediate"), "s11-validate", Pair.of("s11", "validate"));
    static final Map<String, String> STAGE_ROLES = Map.of("s0", null, "s1", "preprocess", "s2", "threatmodel", "s3", "decompose", "s4", "deepdive", "s5", "dedup",
        "s6", "verify", "s7", "dedup", "s8", "chain", "s9", null, "s10", "remediate", "s11", "validate"); // src: vvaharness/util/stage_telemetry.py:56
    static final Set<String> ESTIMATED_COST_STAGES = Set.of("s11");           // src: vvaharness/util/stage_telemetry.py:71
    static final Set<String> ESTIMATED_COST_ROLES = Set.of("exploit_verification.attacker"); // src: vvaharness/util/stage_telemetry.py:73
    static final String NOT_RUN = "not_run";
    static final String RUNNING = "running";

    // The methods below render source class _StageRecorder (process-wide singleton STAGES, line 185); its lock guards every mutation because a stage body can touch it off the main thread.
    Lock lock; Map<String, StageRecord> stages;                                // the STAGES recorder

    void start(String stageId, String label) {
        synchronized (lock) { stages.put(stageId, new StageRecord(label, RUNNING, null)); } // src: vvaharness/util/stage_telemetry.py:196
    }

    void done(String stageId, String outcome, Double durationSec) {
        synchronized (lock) {
            StageRecord r = stages.get(stageId);
            if (r == null) { r = new StageRecord("", outcome, null); stages.put(stageId, r); } // done without start // src: vvaharness/util/stage_telemetry.py:204
            r.outcome = outcome; r.durationSec = durationSec;                  // src: vvaharness/util/stage_telemetry.py:208
        }
    }

    void mark(String stageId, String outcome, String label) {
        synchronized (lock) { stages.put(stageId, new StageRecord(label, outcome, null)); } // cached/skipped/disabled // src: vvaharness/util/stage_telemetry.py:214
    }

    void reset() {
        synchronized (lock) { stages.clear(); }                                // src: vvaharness/util/stage_telemetry.py:220
    }

    Map<String, StageRecord> snapshot() {
        synchronized (lock) {
            List<String> known = STAGE_IDS.filter(s -> stages.containsKey(s)); // s0-first // src: vvaharness/util/stage_telemetry.py:225
            List<String> extra = stages.keys().filter(s -> !STAGE_IDS.contains(s));
            return copyOrdered(stages, known.concat(extra));
        }
    }

    TokenBucket sumBuckets(List<TokenBucket> buckets) {
        return new TokenBucket(sum(prompt), sum(completion), sum(cacheRead), sum(cacheWrite), sum(calls)); // src: vvaharness/util/stage_telemetry.py:257
    }

    boolean hasTokens(TokenBucket b) {
        return b.prompt + b.completion + b.cacheRead > 0;                      // src: vvaharness/util/stage_telemetry.py:267
    }

    Pair<Map<String, List<Pair<String, TokenBucket>>>, UnattributedTokens> groupPhases(Map tokenSnap) {
        Map byStage = Map.of(); UnattributedTokens un = new UnattributedTokens(0, 0, 0, 0, 0);
        for (Entry<String, TokenBucket> e : tokenSnap.byPhase) {               // src: vvaharness/util/stage_telemetry.py:277
            Pair<String, String> mapped = PHASE_MAP.get(e.key);
            if (mapped == null) { un.addAll(e.value); continue; }              // every key, so the manifest reconciles // src: vvaharness/util/stage_telemetry.py:279
            byStage.computeIfAbsent(mapped.first).add(Pair.of(mapped.second, e.value)); // src: vvaharness/util/stage_telemetry.py:288
        }
        return Pair.of(byStage, un);
    }

    TokenBucket stageTokenBucket(String stepId, Map tokenSnap) {
        return sumBuckets(groupPhases(tokenSnap).first.getOrDefault(stepId, List.of()).map(p -> p.second)); // src: vvaharness/util/stage_telemetry.py:295
    }

    String resolveModel(String role, Map<String, String> roleModels, Theta θ) {
        if (role == null) return null;                                         // src: vvaharness/util/stage_telemetry.py:301
        for (String r : List.of(role).concat(θ["code.util.stage_telemetry.role_fallbacks"].getOrDefault(role, List.of()))) // src: vvaharness/util/stage_telemetry.py:303
            if (roleModels.get(r) != null) return roleModels.get(r);
        return null;
    }

    ModelPricing rateFor(String role, Map<String, String> roleModels, PricingTable pricing, Theta θ) {
        String modelId = resolveModel(role, roleModels, θ);
        if (modelId == null) return null;                                      // src: vvaharness/util/stage_telemetry.py:312
        return pricing.models.get(modelId);
    }

    Double stageCost(List<Pair<String, TokenBucket>> phases, Map<String, String> roleModels, PricingTable pricing, Theta θ) {
        if (pricing == null) return null;                                      // src: vvaharness/util/stage_telemetry.py:321
        double total = 0.0;
        for (Pair<String, TokenBucket> p : phases) {                           // src: vvaharness/util/stage_telemetry.py:324
            ModelPricing rate = rateFor(p.first, roleModels, pricing, θ);
            if (rate != null) total += Pricing.bucketCostUsd(p.second, rate, pricing.cacheDefaults, θ); // src: vvaharness/util/stage_telemetry.py:328
            else if (hasTokens(p.second)) return null;                         // unpriced spend -> unknown cost // src: vvaharness/util/stage_telemetry.py:329
        }
        return total;
    }

    Double provenanceCost(String modelId, TokenBucket bucket, PricingTable pricing, Theta θ) {
        if (pricing == null) return null;                                      // src: vvaharness/util/stage_telemetry.py:337
        ModelPricing rate = modelId != null ? pricing.models.get(modelId) : null;
        if (rate != null) return Pricing.bucketCostUsd(bucket, rate, pricing.cacheDefaults, θ); // src: vvaharness/util/stage_telemetry.py:341
        return hasTokens(bucket) ? null : 0.0;                                 // src: vvaharness/util/stage_telemetry.py:342
    }

    StageEntry stageEntry(String stageId, StageRecord record, List<Pair<String, TokenBucket>> phases, Map<String, String> roleModels, PricingTable pricing, Map provenance, Theta θ) {
        String role = STAGE_ROLES.get(stageId);
        String model; TokenBucket tokens; Double cost; String cachedSha;
        if (provenance != null) {                                              // cached stage: report what it was produced under // src: vvaharness/util/stage_telemetry.py:351
            model = provenance.get("model");
            TokenBucket raw = provenance.getOrDefault("tokens", empty);
            tokens = sumBuckets(List.of(raw, sumBuckets(phases.map(p -> p.second)))); // cached AND partly live: add // src: vvaharness/util/stage_telemetry.py:358
            Double cachedCost = provenanceCost(model, raw, pricing, θ);
            Double liveCost = stageCost(phases, roleModels, pricing, θ);
            cost = (cachedCost == null || liveCost == null) ? null : cachedCost + liveCost; // src: vvaharness/util/stage_telemetry.py:361
            cachedSha = provenance.get("config_sha256");
        } else {
            model = resolveModel(role, roleModels, θ);                         // src: vvaharness/util/stage_telemetry.py:365
            tokens = sumBuckets(phases.map(p -> p.second));
            cost = stageCost(phases, roleModels, pricing, θ);
            cachedSha = null;
        }
        boolean estimated = ESTIMATED_COST_STAGES.contains(stageId) || phases.any(p -> ESTIMATED_COST_ROLES.contains(p.first) && hasTokens(p.second)); // src: vvaharness/util/stage_telemetry.py:376
        return new StageEntry(record != null ? record.label : "", record != null ? record.outcome : NOT_RUN, record != null ? record.durationSec : null,
                              tokens, model, cost, estimated, cachedSha);     // src: vvaharness/util/stage_telemetry.py:369
    }

    Double totalCost(Map<String, StageEntry> stages) {
        List<Double> costs = stages.values().map(e -> e.costUsd);
        List<Double> priced = costs.filter(c -> c != null);
        if (priced.size() != costs.size()) return null;                        // any unpriced stage -> null total // src: vvaharness/util/stage_telemetry.py:386
        return sum(priced);
    }

    Totals totals(Map tokenSnap, Map<String, StageEntry> stages, UnattributedTokens un, Map cachedProvenance) {
        TokenBucket combined = sumBuckets(tokenSnap.byPhase.values());          // src: vvaharness/util/stage_telemetry.py:395
        int cacheUnparsedCalls = tokenSnap.byPhase.values().filter(b -> b.cache_unparsed instanceof Integer).sum(b -> b.cache_unparsed); // src: vvaharness/util/stage_telemetry.py:397
        TokenBucket carry = sumBuckets(cachedProvenance.values().map(p -> p.getOrDefault("tokens", empty))); // envelope, not stage rows // src: vvaharness/util/stage_telemetry.py:401
        return new Totals(tokenSnap.prompt + carry.prompt, tokenSnap.completion + carry.completion, tokenSnap.total + carry.prompt + carry.completion,
                          combined.cacheRead + carry.cacheRead, combined.cacheWrite + carry.cacheWrite, tokenSnap.calls + carry.calls,
                          tokenSnap.callsWithUsage, tokenSnap.completionAbsent, cacheUnparsedCalls, totalCost(stages), un, carry); // src: vvaharness/util/stage_telemetry.py:405
    }

    PricingProvenance provenance(PricingTable pricing) {
        if (pricing == null) return null;                                      // src: vvaharness/util/stage_telemetry.py:426
        return new PricingProvenance(pricing.path, pricing.sha256, pricing.source);
    }

    PricingStatus pricingStatus(Map<String, StageEntry> stages, PricingTable pricing) {
        if (pricing == null) return new PricingStatus("unavailable", "no pricing table configured"); // src: vvaharness/util/stage_telemetry.py:435
        List<String> unpriced = sorted(stages.values().filter(e -> e.costUsd == null && e.model != null).map(e -> e.model).distinct()); // src: vvaharness/util/stage_telemetry.py:436
        if (!unpriced.isEmpty()) return new PricingStatus("incomplete", "pricing missing for model(s): " + unpriced.join(", ")); // src: vvaharness/util/stage_telemetry.py:438
        return new PricingStatus("available", "pricing table applied");
    }

    List<String> orderedStageIds(Map stageSnap, Map byStage) {
        Set<String> present = union(stageSnap.keys(), byStage.keys());         // src: vvaharness/util/stage_telemetry.py:448
        return STAGE_IDS.filter(s -> present.contains(s)).concat(stageSnap.keys().filter(s -> !STAGE_IDS.contains(s))); // src: vvaharness/util/stage_telemetry.py:451
    }

    StageSection composeStageSection(Map stageSnap, Map tokenSnap, Map<String, String> roleModels, PricingTable pricing, Map cachedProvenance, Theta θ) {
        Pair grouped = groupPhases(tokenSnap);                                 // src: vvaharness/util/stage_telemetry.py:462
        if (cachedProvenance == null) cachedProvenance = Map.of();
        Map<String, StageEntry> stages = Map.of();
        for (String id : orderedStageIds(stageSnap, grouped.first))            // src: vvaharness/util/stage_telemetry.py:468
            stages.put(id, stageEntry(id, stageSnap.get(id), grouped.first.getOrDefault(id, List.of()), roleModels, pricing, cachedProvenance.get(id), θ)); // src: vvaharness/util/stage_telemetry.py:465
        return new StageSection(stages, totals(tokenSnap, stages, grouped.second, cachedProvenance), provenance(pricing), pricingStatus(stages, pricing)); // src: vvaharness/util/stage_telemetry.py:470
    }
}

@executedBy(CODE) @role(evaluation)
class CachedProvenanceRecorder {
    Lock lock; Map<String, Map> entries;                                       // a --resume'd stage's actual provenance

    void record(String stageId, Map provenance) {
        synchronized (lock) { entries.put(stageId, provenance); }              // src: vvaharness/util/stage_telemetry.py:242
    }

    void reset() {
        synchronized (lock) { entries.clear(); }                               // src: vvaharness/util/stage_telemetry.py:246
    }

    Map<String, Map> snapshot() {
        synchronized (lock) { return copy(entries); }                          // src: vvaharness/util/stage_telemetry.py:250
    }
}
