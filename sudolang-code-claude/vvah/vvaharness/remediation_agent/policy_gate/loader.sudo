# vvaharness/remediation_agent/policy_gate/loader.py

Parses and normalizes the remediation policy file (`inputs/remediation_policy.yaml` by default). Any load or parse error of the file returns null, which makes the gate fail closed.

Source: `vvaharness/remediation_agent/policy_gate/loader.py` (lines 1-91)
Executor: code
Called from: `policy_gate/gate.sudo` RemediationGate

// src: vvaharness/remediation_agent/policy_gate/loader.py:38-47
PolicyData {
  deny: { CWE id: reason } = {}
  allow: Set of CWE id = {}   // patchable CWEs
  deny_paths: List = []
  forbid_patch_paths: List = []
  kill_env: String | null = null
  kill_file: Path | null = null
  default: Action = GUIDANCE_ONLY
}

// src: vvaharness/remediation_agent/policy_gate/loader.py:29-35
fn _norm_cwe(raw):executor=code {
  // "943", "CWE-943", "cwe-943" all become "CWE-943"
  if (raw == null) return null
  s = upper case of trimmed raw, without a leading "CWE-"
  return if (s is all digits) "CWE-$s" else null
}

// src: vvaharness/remediation_agent/policy_gate/loader.py:50-91
fn parse_policy(path):executor=code {
  try doc = yaml.safe_load(text of path) or {};
  catch error => { log error "remediation policy load failed (...) — fail-closed"; return null }

  // src: loader.py:59-61 — "allow": patch everything not denied; anything else (the safe default "deny"): allow list only
  data.default = if (lower case of (doc.default_action or "deny") == "allow") PATCH else GUIDANCE_ONLY

  // src: loader.py:63-72
  for each entry in doc.deny {
    cwe = _norm_cwe(entry.id)
    if (!cwe) continue   // an entry with an unparseable id is skipped
    reason = entry.reason or "policy_denied"   // default only when the key is absent
    data.deny[cwe] = reason
    for each child in entry.descendants {
      c = _norm_cwe(child)
      if (c && c not already in data.deny) data.deny[c] = "descendant_of:$cwe ($reason)"   // an explicit entry for the child keeps its own reason
    }
  }

  // src: loader.py:74-77
  for each entry in doc.allow { if (_norm_cwe(entry.id)) add it to data.allow }

  // src: loader.py:79-84
  data.deny_paths = doc.deny_paths as strings
  data.forbid_patch_paths = doc.forbid_patch_paths as strings
  data.kill_env = doc.kill_switch.env_var or null
  data.kill_file = doc.kill_switch.file as a path, or null
  // abstracted: loader.py:85-90 — info log with the counts and the default
  return data
  // preserved: only reading and YAML parsing are inside the try; a structurally wrong entry (for example a deny entry that is not a mapping) raises out of parse_policy instead of failing closed
}
