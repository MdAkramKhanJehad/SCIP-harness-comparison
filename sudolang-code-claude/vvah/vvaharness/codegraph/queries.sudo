# vvaharness/codegraph/queries.py

Deterministic `ContextPackage` field producers over the built graph: communities as modules, the primary language, and a one-line system-context summary.

Source: `vvaharness/codegraph/queries.py` (lines 1-84)
Executor: code
Called from: `vvaharness/pipeline/stages/s1_preprocess.py`

// src: vvaharness/codegraph/queries.py:23-40
_COMMUNITY_FILES_QUERY = "MATCH (fn)-[:MEMBER_OF]->(c:Community) MATCH (file:File)-[:DEFINES]->(fn) RETURN c.name AS community, file.filePath AS path"
_LANGUAGE_COUNTS_QUERY = "MATCH (f:File) WHERE f.language IS NOT NULL AND f.language <> '' RETURN f.language AS language, count(*) AS n ORDER BY n DESC"
_COUNT_QUERIES = { files: "MATCH (f:File) RETURN count(f) AS n", functions: "MATCH (fn:Function) RETURN count(fn) AS n", communities: "MATCH (c:Community) RETURN count(c) AS n" }

// src: vvaharness/codegraph/queries.py:43-54
fn communities_as_modules(handle):executor=code {
  for each row of handle.graph.cypher(_COMMUNITY_FILES_QUERY) {
    skip unless community and path are both strings
    append path to modules[community] if not already there   // graph-relative paths, deduplicated, first-seen order
  }
  return modules
}

// src: vvaharness/codegraph/queries.py:57-71
fn primary_language(handle):executor=code {
  rows = handle.graph.cypher(_LANGUAGE_COUNTS_QUERY).rows
  return if (rows && rows[0].language is a string) rows[0].language else null
}
fn _int_count(handle, query):executor=code { return first row's n when it is an integer, else 0 }

// src: vvaharness/codegraph/queries.py:74-84
fn system_context_notes(handle):executor=code {
  counts = _int_count for each of _COUNT_QUERIES
  languages = string languages from _LANGUAGE_COUNTS_QUERY
  return "<files> files (<first 5 languages joined, or unknown>), <functions> functions, <communities> communities."
}
