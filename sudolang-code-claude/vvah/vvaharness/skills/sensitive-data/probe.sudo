# vvaharness/skills/sensitive-data/probe.sh

Exposure sweep over the channels where PII, secrets and internals leak: debug and error output, logs, serialization, storage, headers, debug routes and settings constants.

Source: `vvaharness/skills/sensitive-data/probe.sh` (lines 1-79)
Executor: code (POSIX shell; read-only greps; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/sensitive-data/probe.sh [root]`, because the lens SKILL.md or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 4-16 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints `path:line` hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/sensitive-data/probe.sh:18-79
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/sensitive-data/probe.sh:18-42 — setup and the hits helper
  CAP = 20
  XD = exclude directories .git, node_modules, .venv, venv, __pycache__, dist, build, .vvaharness, vendor
  Q = "['\"]"   // either quote character
  SENS = "pass(wd|word)?|secret|token|api_?key|apikey|private_key|credential|ssn|social_security|birth|card_?(no|num|number)|cvv|iban|account_?num|salary|medical|diagnos|flag"
  TPL = include *.html *.htm *.jinja *.jinja2 *.j2 *.tpl *.erb *.hbs *.twig *.ejs *.vue
  CFG = include *settings*.py *config*.py *conf*.py *constants*.py *.properties *settings*.rb *config*.js *config*.ts

  hits(label, pattern, ...extraGrepArgs) {
    // grep -rEni: CASE-INSENSITIVE extended regex, binary files skipped
    if (no match) print "(none)" else print "<total> match(es); showing up to 20" then the first CAP lines
  }
  // preserved: every section is case-insensitive, so the "ALL_CAPS constant" section (line 76) also matches lower-case and mixed-case names, and "debug mode on" matches any casing.
  // The SKILL marks three sections as findings when they print "(none)": strong KDF present, Cache-Control / no-store, Strict-Transport-Security. The probe itself only prints "(absent = ...)" hints in those labels.

  print "Candidates only. Each needs sensitive content AND an attacker-reachable channel."

  // src: vvaharness/skills/sensitive-data/probe.sh:44 — printf '\n--- ERROR AND DEBUG EXPOSURE ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:45-45
  hits("debug mode on")
  // pattern and arguments, verbatim: 'DEBUG[[:space:]]*=[[:space:]]*True|debug[[:space:]]*=[[:space:]]*True|app\.debug|FLASK_DEBUG|ASPNETCORE_ENVIRONMENT[[:space:]]*[:=][[:space:]]*.?Development|display_errors[[:space:]]*=[[:space:]]*On|NODE_ENV[[:space:]]*[:=][[:space:]]*.?development'
  // src: vvaharness/skills/sensitive-data/probe.sh:46-46
  hits("exception text returned to the caller")
  // pattern and arguments, verbatim: 'return[^;]*str\(e\)|jsonify\([^)]*(str\(e\)|e\.message|exc)|error[^;]*:[[:space:]]*(str\(|f")|res\.(send|json)\([^)]*(err|error)|printStackTrace|getStackTrace|traceback\.format_exc|\.stack[[:space:]]*[,)}]'
  // src: vvaharness/skills/sensitive-data/probe.sh:47-47
  hits("raw exception or SQL passed into a template context")
  // pattern and arguments, verbatim: '(render|render_template|render_to_response|res\.render)\([^)]*(error|exception|exc|err|sql|query|message|traceback)'
  // src: vvaharness/skills/sensitive-data/probe.sh:48-48
  hits("template variables that render internals")
  // pattern and arguments, verbatim: '\{[\{%][[:space:]]*=?[[:space:]]*(error|err|exception|exc|sql|sql_error|query|message|traceback|stack)' $TPL
  // src: vvaharness/skills/sensitive-data/probe.sh:50 — printf '\n--- LOGGING ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:51-51
  hits("sensitive names inside a log/print call")
  // pattern and arguments, verbatim: "(log(ger|ging)?|print|console|System\\.out|fmt\\.Print|puts|NSLog)[^;]*($SENS)"
  // src: vvaharness/skills/sensitive-data/probe.sh:52-52
  hits("whole request, body, or auth header logged")
  // pattern and arguments, verbatim: '(log|logger|print|console)[^;]*((request|req)\.(body|data|form|args|json|headers|POST|GET|cookies)|Authorization|Bearer|set-cookie)'
  // src: vvaharness/skills/sensitive-data/probe.sh:53-53
  hits("request/response logging middleware")
  // pattern and arguments, verbatim: 'LoggingMiddleware|log_request|morgan\(|RequestLoggingFilter|CommonsRequestLoggingFilter|http_logger|axios.*interceptors'
  // src: vvaharness/skills/sensitive-data/probe.sh:55 — printf '\n--- RESPONSE / SERIALIZATION LEAKAGE ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:56-56
  hits("whole-object serialization with no field allow-list")
  // pattern and arguments, verbatim: '\.__dict__|to_dict\(\)|model_to_dict\(|\.serialize\(\)|\.dict\(\)|vars\(|JSON\.stringify\([a-z_]+\)|fields[[:space:]]*=[[:space:]]*.__all__|exclude[[:space:]]*=[[:space:]]*\(\)'
  // src: vvaharness/skills/sensitive-data/probe.sh:57-57
  hits("sensitive field names in a serializer or query projection")
  // pattern and arguments, verbatim: "(fields|columns|select|attributes|only|values)[[:space:]]*[:=][^;]*($SENS)"
  // src: vvaharness/skills/sensitive-data/probe.sh:58-58
  hits("sensitive values rendered into markup")
  // pattern and arguments, verbatim: "\\{[\\{%][^}]*($SENS)|<input[^>]*hidden[^>]*($SENS)|<!--[^>]*($SENS)" $TPL
  // src: vvaharness/skills/sensitive-data/probe.sh:60 — printf '\n--- STORAGE ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:61-61
  hits("weak or reversible password handling")
  // pattern and arguments, verbatim: 'md5|sha1\(|sha256\([^)]*pass|base64[^;]*pass|rot13|password[[:space:]]*==|encode\([^)]*pass'
  // src: vvaharness/skills/sensitive-data/probe.sh:62-62
  hits("strong KDF present (absent = passwords unprotected)")
  // pattern and arguments, verbatim: 'bcrypt|argon2|scrypt|pbkdf2|make_password|password_hash\(|PasswordEncoder|Devise'
  // src: vvaharness/skills/sensitive-data/probe.sh:63-63
  hits("sensitive column declared with no protection")
  // pattern and arguments, verbatim: "($SENS)[^;]*(Column|Field|VARCHAR|TEXT|String\\(|char\\()"
  // src: vvaharness/skills/sensitive-data/probe.sh:64-64
  hits("world-writable or temp files holding data")
  // pattern and arguments, verbatim: 'chmod\([^)]*(0?777|0?666)|tempfile\.mktemp|os\.umask\(0\)|/tmp/'
  // src: vvaharness/skills/sensitive-data/probe.sh:66 — printf '\n--- HEADERS / CACHING / TRANSPORT ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:67-67
  hits("Cache-Control / no-store (absent = PII cacheable by proxies)")
  // pattern and arguments, verbatim: 'Cache-Control|no-store|Pragma'
  // src: vvaharness/skills/sensitive-data/probe.sh:68-68
  hits("Strict-Transport-Security (absent on HTTPS = downgrade)")
  // pattern and arguments, verbatim: 'Strict-Transport-Security|SECURE_HSTS_SECONDS|hsts'
  // src: vvaharness/skills/sensitive-data/probe.sh:69-69
  hits("framework / version disclosure headers")
  // pattern and arguments, verbatim: 'X-Powered-By|X-AspNet-Version|expose_php|Server[[:space:]]*[:=][[:space:]]*.?(Apache|nginx|Express|Werkzeug)'
  // src: vvaharness/skills/sensitive-data/probe.sh:71 — printf '\n--- DEBUG / ADMIN ROUTES ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:72-72
  hits("introspection routes")
  // pattern and arguments, verbatim: "(route|path|get|post|mapping)\\([^)]*$Q?/?(debug|status|health|metrics|actuator|env|config|phpinfo|trace|dump|_profiler|admin)"
  // src: vvaharness/skills/sensitive-data/probe.sh:73-73
  hits("config or environment object handed out")
  // pattern and arguments, verbatim: 'app\.config|settings\.__dict__|os\.environ(\[|\.items|\.copy|\))|process\.env[[:space:]]*[,)}]|GetEnvironmentVariables|ConfigurationManager\.AppSettings'
  // src: vvaharness/skills/sensitive-data/probe.sh:75 — printf '\n--- SETTINGS CONSTANTS (judge each name and value) ---\n'
  // src: vvaharness/skills/sensitive-data/probe.sh:76-76
  hits("ALL_CAPS constant assigned a non-trivial string literal")
  // pattern and arguments, verbatim: "^[[:space:]]*[A-Z][A-Z0-9_]{3,}[[:space:]]*[:=][[:space:]]*$Q[^$Q]{6,}$Q" $CFG

  // src: vvaharness/skills/sensitive-data/probe.sh:78-79
  print "(end of sweep)"; exit 0
}
