    String runGit(Path cloneDir, String... args) {
        if (GIT_EXECUTABLE == null) return "";                                                   // src: vulnhunter-agent/agent/runner.py:366
        Proc out = subprocess(GIT_EXECUTABLE, args, cloneDir, 10);                               // src: vulnhunter-agent/agent/runner.py:375
        if (out.failed || out.returncode != 0) return "";                                        // src: vulnhunter-agent/agent/runner.py:385
        return out.stdout.strip();
    }

    Path computeResultsDir(Path cloneDir, String model) {
        String ts = utcNow("%Y-%m-%d-%H%M%S");                                                   // src: vulnhunter-agent/agent/runner.py:407
        return cloneDir.resolve(cloneDir.name + "_VULNHUNT_RESULTS_" + modelTag(model) + "_" + ts); // src: vulnhunter-agent/agent/runner.py:408
    }

    // The scan refuses to start if any old results dir exists, so the model cannot read prior output.
    void checkNoPriorResults(Path cloneDir) {
        if (!cloneDir.isDir()) return;                                                           // src: vulnhunter-agent/agent/runner.py:419
        List<String> priors = cloneDir.list().filter(e -> e.isDir() && e.name.contains("_VULNHUNT_RESULTS_")); // src: vulnhunter-agent/agent/runner.py:421
        if (!priors.isEmpty()) throw new PriorResultsError(priors);                             // src: vulnhunter-agent/agent/runner.py:426
    }

    void emitScanCompleted(AuditWriter w, Theta θ, String repoSlug, String reportId, String model, String sha, Path resultsDir, SessionResult sr, Exception error, long wallStart) {
        Double cost = (sr != null) ? sr.costUsd : null;                                          // src: vulnhunter-agent/agent/runner.py:827
        Path resultsFinal = (sr != null && sr.resultsDir != null) ? sr.resultsDir : resultsDir;
        int duration = now() - wallStart;                                                        // src: vulnhunter-agent/agent/runner.py:835
        Integer findingsCount = AuditExtract.countFindingsFromDisk(resultsFinal);                // src: vulnhunter-agent/agent/runner.py:838
        String notes = "";
        if (error != null) { notes = "failed: " + error; findingsCount = null; }                 // src: vulnhunter-agent/agent/runner.py:843
        w.emitAudit(Audit.buildScanCompleted(repoSlug, reportId, model, sha, findingsCount, cost, duration, notes)); // src: vulnhunter-agent/agent/runner.py:852
    }

    void emitScanCompletedSafely(AuditWriter w, Theta θ, String repoSlug, String reportId, String model, String sha, Path resultsDir, SessionResult sr, Exception error, long wallStart) {
        if (w == null) return;                                                                   // src: vulnhunter-agent/agent/runner.py:881
        try { emitScanCompleted(w, θ, repoSlug, reportId, model, sha, resultsDir, sr, error, wallStart); } catch (Exception e) { logError(e); } // src: vulnhunter-agent/agent/runner.py:884
    }

    boolean isAuthFailure(SystemMessage m) {
        return m.data.errorStatus == 401 || m.data.error.lower() == "authentication_failed";     // src: vulnhunter-agent/agent/runner.py:1236
    }

    boolean isRateLimitSystemMessage(SystemMessage m) {
        Integer status = (m.data.errorStatus instanceof Integer) ? m.data.errorStatus : m.data.apiErrorStatus; // src: vulnhunter-agent/agent/runner.py:1256
        return Transient.classify(status, m.data.error);                                         // src: vulnhunter-agent/agent/runner.py:1259
    }

    boolean isRateLimitResult(ResultMessage m) {
        if (!m.isError) return false;                                                            // src: vulnhunter-agent/agent/runner.py:1272
        return Transient.classify(m.apiErrorStatus, m.errors);                                   // src: vulnhunter-agent/agent/runner.py:1276
    }
}

/** _build_vulnhunt_prompt: the kickoff user message the orchestrator model receives. */
@executedBy(MODEL) @role(prompt) @stage("agent")
class RunnerKickoffPrompt {

    Prompt build(Path clonePath, String model, boolean readOnly, Path resultsDir, String branchLabel, String repoUrl, boolean enableBash, List<String> effectiveTools, Theta θ) {
        Prompt p = new Prompt();
        String tag = Runner.modelTag(model);                                                     // src: vulnhunter-agent/agent/runner.py:166
        p.step(0, θ["p.runner.skill_invocation"] + " " + clonePath);                            // src: vulnhunter-agent/agent/runner.py:171
        if (θ["p.runner.headless_mode_notice"]) p.context("IMPORTANT: This is running in non-interactive headless mode."); // src: vulnhunter-agent/agent/runner.py:82
        if (θ["p.runner.no_approval_execute_immediately"]) p.forbid("Do NOT ask for approval or confirmation. Execute immediately."); // src: vulnhunter-agent/agent/runner.py:83
        if (readOnly && θ["p.runner.read_only_scan_suffix"]) p.rule("Perform a read-only scan, skip instructions related to getting dependencies and executing code."); // src: vulnhunter-agent/agent/runner.py:93
        if (θ["p.runner.explicit_model_tag"]) p.must("Use the model tag " + tag + " for this scan. Name the results directory and any other artifacts with that exact tag"); // src: vulnhunter-agent/agent/runner.py:172
        if (θ["p.runner.no_model_self_identification"]) p.forbid("do not introspect your own model identity"); // src: vulnhunter-agent/agent/runner.py:174

        if (resultsDir == null && repoUrl == null && branchLabel == "unknown") return p;         // src: vulnhunter-agent/agent/runner.py:176

        String resolvedRepoUrl = (repoUrl != null) ? repoUrl : clonePath.name;                   // src: vulnhunter-agent/agent/runner.py:181
        String bashLine;
        if (enableBash) {                                                                        // src: vulnhunter-agent/agent/runner.py:185
            bashLine = θ["p.runner.bash_available_line"] + " (--enable-bash was passed).";        // src: vulnhunter-agent/agent/runner.py:187
        } else {
            String toolPhrase;
            if (effectiveTools == null) {
                toolPhrase = θ["p.runner.tool_phrase_fallback"];                                 // src: vulnhunter-agent/agent/runner.py:197
            } else {
                List<String> names = effectiveTools.filter(t -> t != "Bash" && t != "Agent");    // src: vulnhunter-agent/agent/runner.py:199
                toolPhrase = names.isEmpty() ? θ["p.runner.tool_phrase_fallback"] : String.join("/", names); // src: vulnhunter-agent/agent/runner.py:200
            }
            bashLine = θ["p.runner.bash_unavailable_line"].replace("<tools>", toolPhrase);       // src: vulnhunter-agent/agent/runner.py:204
        }
        if (θ["p.runner.pre_resolved_metadata_literal"]) p.forbid("Pre-resolved scan metadata (use these literal values; do NOT run shell commands to recompute them)"); // src: vulnhunter-agent/agent/runner.py:207
        List<String> fields = θ["p.runner.metadata_fields"];                                     // src: vulnhunter-agent/agent/runner.py:209
        p.context("VULNHUNT_DIR: " + resultsDir);                                                // src: vulnhunter-agent/agent/runner.py:209
        p.context("VULNHUNT_BRANCH: " + branchLabel);                                            // src: vulnhunter-agent/agent/runner.py:210
        p.context("Repository URL: " + resolvedRepoUrl);                                         // src: vulnhunter-agent/agent/runner.py:211
        p.context(bashLine);                                                                     // src: vulnhunter-agent/agent/runner.py:212
        return p;
    }
}

/** _CONTINUATION_PROMPT: re-sent whenever the orchestrator stops while subagent tasks are still pending. */
@executedBy(MODEL) @role(prompt) @stage("agent")
class RunnerContinuationPrompt {

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        String text = θ["code.continuation_prompt"];                                             // src: vulnhunter-agent/agent/runner.py:460
        if (θ["p.runner.continuation_resume_workflow"]) p.rule("Continue the /vulnhunt workflow. Background subagents may still be running"); // src: vulnhunter-agent/agent/runner.py:461
        if (θ["p.runner.continuation_do_not_stop_until_done"]) p.forbid("do not stop until every dispatched task has completed"); // src: vulnhunter-agent/agent/runner.py:462
        p.checklist(θ["p.runner.continuation_required_phases"]);                                 // src: vulnhunter-agent/agent/runner.py:463
        if (θ["p.runner.continuation_verify_phase_outputs"]) p.must("Verify each phase's output files exist before moving on."); // src: vulnhunter-agent/agent/runner.py:464
        if (θ["p.runner.continuation_no_goodbye_before_report"]) p.forbid("Do not respond with a goodbye message until the report is written."); // src: vulnhunter-agent/agent/runner.py:465
        return p;
    }
}
