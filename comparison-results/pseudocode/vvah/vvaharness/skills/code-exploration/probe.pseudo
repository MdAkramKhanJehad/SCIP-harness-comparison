// file: vvaharness/skills/code-exploration/probe.sh
// Read-only probe the model may run: inventories file classes a source-only sweep skips,
// then runs escape / transport / CI / credential pattern batteries. Output-capped; always exits 0.

@executedBy(CODE) @role(tool) @stage("S4")
class CodeExplorationProbe {

    String run(String root, Theta θ) {
        Out out = new Out();
        if (!Fs.cd(root)) { out.line("== PROBE ABORTED: cannot enter root =="); return out.exit0(); } // src: vvaharness/skills/code-exploration/probe.sh:23
        List<String> prune = θ["p.skill_code-exploration.probe_pruned_dirs"];                      // src: vvaharness/skills/code-exploration/probe.sh:25
        out.section("PROBE ROOT").line(Fs.pwd()).line("pruned dirs: " + prune);                    // src: vvaharness/skills/code-exploration/probe.sh:44
        if (Sys.hasPython3()) {                                                                      // src: vvaharness/skills/code-exploration/probe.sh:49
            List<String> files = walk(prune);
            inventory(files, out);
            fileClasses(files, out);
            dotfiles(files, out);
            zeroByte(files, out);
        } else {
            // grep fallback, text files only, first 60
            out.section("INVENTORY (python3 unavailable)").emit(Grep.listTextFiles(".", prune).sorted().head(60)); // src: vvaharness/skills/code-exploration/probe.sh:162
        }
        patternBatteries(prune, out, θ);
        out.section("PROBE COMPLETE").line("This probe locates; it does not conclude. Read each named file to its last line."); // src: vvaharness/skills/code-exploration/probe.sh:221
        return out.exit0();
    }

    List<String> walk(List<String> prune) {
        List<String> files = new List<String>();
        for (Dir d : Fs.walk(".")) {                                                                 // src: vvaharness/skills/code-exploration/probe.sh:56
            d.subdirs.removeIf(s -> prune.contains(s.name));                                         // src: vvaharness/skills/code-exploration/probe.sh:59
            files.addAll(d.files);
        }
        return files;
    }

    void inventory(List<String> files, Out out) {
        Map<String, Integer> groups = files.countBy(p -> Fs.dirname(p));                             // src: vvaharness/skills/code-exploration/probe.sh:67
        out.section("INVENTORY (" + files.size() + " files; authoritative)");
        out.lines(groups.sortedByCountDesc().head(40));                                              // src: vvaharness/skills/code-exploration/probe.sh:70
        if (groups.size() > 40) out.line("... more directory groups");                              // src: vvaharness/skills/code-exploration/probe.sh:72
    }

    void fileClasses(List<String> files, Out out) {
        // Eight classes: templates, container/orchestration/IaC, CI/CD, manifests, env/credential dotfiles,
        // SQL/migrations/seeds, static assets, central controls. Match by basename glob or by directory component.
        for (FileClass fc : FileClass.ALL) {                                                         // src: vvaharness/skills/code-exploration/probe.sh:77
            List<String> found = files.filter(p -> fc.basenameGlobs.anyMatch(Fs.basename(p)) || fc.dirs.anyIn(Fs.parts(p))); // src: vvaharness/skills/code-exploration/probe.sh:123
            out.section(fc.label + " (" + found.size() + ")");
            if (found.isEmpty()) { out.line("(none)"); continue; }                                   // src: vvaharness/skills/code-exploration/probe.sh:131
            out.lines(found.head(15));                                                               // src: vvaharness/skills/code-exploration/probe.sh:134
            if (found.size() > 15) out.line("... more");
        }
    }

    void dotfiles(List<String> files, Out out) {
        // the namespace the graph walk skips entirely
        List<String> dots = files.filter(p -> Fs.parts(p).anyStartsWith("."));                       // src: vvaharness/skills/code-exploration/probe.sh:139
        out.section("ALL DOTFILES (" + dots.size() + ")").lines(dots.head(20));                      // src: vvaharness/skills/code-exploration/probe.sh:141
    }

    void zeroByte(List<String> files, Out out) {
        List<String> empty = files.filter(p -> Fs.size(p) == 0);                                     // src: vvaharness/skills/code-exploration/probe.sh:149
        out.section("ZERO-BYTE FILES (" + empty.size() + ")").lines(empty.head(10));                 // src: vvaharness/skills/code-exploration/probe.sh:151
    }

    void patternBatteries(List<String> prune, Out out, Theta θ) {
        List<String> batteries = θ["p.skill_code-exploration.probe_pattern_batteries"];             // src: vvaharness/skills/code-exploration/probe.sh:166
        for (String b : batteries) {
            if (b.equals("TLS in transport config")) {
                // per conf file: count listen/bind lines and ssl|tls|https|443 tokens
                List<String> confs = Grep.filesMatching("listen|server_name|ssl_certificate|uwsgi_pass|proxy_pass|upstream|bind=", List.of("*.conf", "*.ini", "*.cfg", "*.template"), prune).head(12); // src: vvaharness/skills/code-exploration/probe.sh:179
                out.section("TRANSPORT CONFIG");
                if (confs.isEmpty()) out.line("(none)");
                for (String f : confs) out.line(f + ": lines=" + Fs.lineCount(f) + " listen/bind=" + Grep.count(f, "listen|bind") + " tls tokens=" + Grep.count(f, "ssl|https|443|tls")); // src: vvaharness/skills/code-exploration/probe.sh:184
            } else if (b.equals("security header presence counts")) {
                // count files per header/control; 0 supports an absence claim
                for (String h : List.of("Content-Security-Policy", "Strict-Transport-Security", "X-Frame-Options", "X-Content-Type-Options", "Referrer-Policy", "SameSite", "HttpOnly", "secure=True", "COOKIE_SECURE", "csrf_token", "CSRFProtect", "csrf_exempt", "before_request", "login_required")) { // src: vvaharness/skills/code-exploration/probe.sh:198
                    out.line(h + ": " + Grep.filesMatchingIgnoreCase(h, prune).size() + " file(s)");
                }
            } else {
                // regex battery for this label, over its include set (templates / source / config), first 20 hits
                out.section(b).emit(Grep.rEn(BatteryRegex.of(b), BatteryRegex.includesOf(b), prune).head(20)); // src: vvaharness/skills/code-exploration/probe.sh:167
            }
        }
    }
}
