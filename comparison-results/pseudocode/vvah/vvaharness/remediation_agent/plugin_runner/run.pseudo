// file: vvaharness/remediation_agent/plugin_runner/run.py
// The harness guards around one engine call: pre-gate, snapshots, engine call, post-gate and amend. The engine's self-report is replaced by what the harness can prove from the working tree.
// Pass-1 rendered part of this file inside runner.pseudo (class PluginRunnerRun); this file renders every function of it.

@executedBy(CODE) @role(types) @stage("S10")
record EngineRequest(RemediationTarget target, String repo, String mode, Config cfg, boolean verbose, PolicyContext policyCtx) { } // src: vvaharness/remediation_agent/plugin_runner/run.py:56  (verbose defaults false, policyCtx null)

@executedBy(CODE) @role(types) @stage("S10")
record GuardedCall(RemediationVerdict verdict, Map<String, String> snapshot, PreResult pre, Map<String, Object> meta, boolean denied, Instant started, Spend spendBefore, List<String> preCallDirty) { } // src: vvaharness/remediation_agent/plugin_runner/run.py:73  (pre is null on the denied path; snapshot and meta default empty)

@executedBy(CODE) @role(types) @stage("S10")
record Amended(Remediation remediation, List<String> revertedPaths, Map<String, Object> meta) { }   // src: vvaharness/remediation_agent/plugin_runner/run.py:87  (the harness's own account of an attempt, overriding the engine's self-report)

@executedBy(CODE) @role(step) @stage("S10")
class Run {

    boolean enforce(EngineRequest request) {
        // True when a policy context is present AND switched on.
        return request.policyCtx != null && request.policyCtx.enabled;                              // src: vvaharness/remediation_agent/plugin_runner/run.py:69
    }

    GuardedCall callWithGuards(Function fn, EngineRequest request, Theta θ) {
        // Run fn behind the pre-call guards (policy gate, then snapshot) and return what they saw.
        Instant started = Clock.nowUtc();                                                           // src: vvaharness/remediation_agent/plugin_runner/run.py:99
        Spend spendBefore = TokenCounter.spend();                                                         // src: vvaharness/remediation_agent/plugin_runner/run.py:100
        Map<String, Object> meta = baseMeta(request, started);                                      // src: vvaharness/remediation_agent/plugin_runner/run.py:101
        PreResult pre = enforce(request) ? Decide.preDecision(request.policyCtx, request.target, θ) : null; // src: vvaharness/remediation_agent/plugin_runner/run.py:102
        if (request.verbose) tracePolicy(request, pre);                                             // src: vvaharness/remediation_agent/plugin_runner/run.py:103
        if (pre != null && !Decide.allowed(pre)) {                                                  // src: vvaharness/remediation_agent/plugin_runner/run.py:105
            return denied(request, pre, meta, started, spendBefore);                                // src: vvaharness/remediation_agent/plugin_runner/run.py:106
        }
        // Content baseline BEFORE the engine runs: lets engineFailed tell this call's own in-flight edit apart from an earlier case's accepted fix on the same path.
        List<String> preCallDirty = Gitcapture.changedFilesWholeTree(request.repo, θ);              // src: vvaharness/remediation_agent/plugin_runner/run.py:109
        Map<String, String> preCallSnapshot = Snapshot.snapshotFiles(request.repo, preCallDirty);   // src: vvaharness/remediation_agent/plugin_runner/run.py:110
        Map<String, String> snapshot = Snapshot.snapshotFiles(request.repo, snapshotTargets(request, θ)); // src: vvaharness/remediation_agent/plugin_runner/run.py:111
        Object raw;
        try {
            raw = callEngine(fn, request, pre);                                                     // src: vvaharness/remediation_agent/plugin_runner/run.py:113
        } catch (Exception exc) {
            // A timeout or crash is a case outcome, not a bug.
            return engineFailed(request, exc, preCallDirty, preCallSnapshot, snapshot, pre, meta, started, spendBefore, θ); // src: vvaharness/remediation_agent/plugin_runner/run.py:115
        }
        return new GuardedCall(PluginRunnerRun.coerceVerdict(raw, request.target), snapshot, pre, meta, false, started, spendBefore, preCallDirty); // src: vvaharness/remediation_agent/plugin_runner/run.py:117
    }

    GuardedCall engineFailed(EngineRequest request, Exception exc, List<String> preCallDirty, Map<String, String> preCallSnapshot, Map<String, String> snapshot, PreResult pre, Map<String, Object> meta, Instant started, Spend spendBefore, Theta θ) {
        // The engine call itself raised: revert whatever changed since preCallSnapshot, by content and restoring to that snapshot rather than HEAD, so an earlier case's still-uncommitted fix on the same path survives and the half-applied edit is not mistaken for a real fix.
        List<String> nowDirty = Gitcapture.changedFilesWholeTree(request.repo, θ);                 // src: vvaharness/remediation_agent/plugin_runner/run.py:128
        List<String> newUntracked = nowDirty.filter(f -> !preCallDirty.contains(f));                // src: vvaharness/remediation_agent/plugin_runner/run.py:129
        List<String> changedDuringCall = Snapshot.changedSinceSnapshot(request.repo, preCallSnapshot); // src: vvaharness/remediation_agent/plugin_runner/run.py:130
        List<String> toRevert = changedDuringCall.plus(newUntracked).distinct();                    // src: vvaharness/remediation_agent/plugin_runner/run.py:131
        List<String> reverted = !toRevert.isEmpty() ? Revert.revertFiles(request.repo, toRevert, preCallSnapshot, θ) : List.of(); // src: vvaharness/remediation_agent/plugin_runner/run.py:132
        String detail = exc.stderr != null ? exc.stderr : String.valueOf(exc);                      // src: vvaharness/remediation_agent/plugin_runner/run.py:134
        Console.write("[guard] engine call failed for finding " + request.target.index + " (" + detail + "); reverted " + reverted.size() + " in-flight edit(s)"); // src: vvaharness/remediation_agent/plugin_runner/run.py:135
        RemediationVerdict verdict = new RemediationVerdict(request.target.index, "Not Fixed", new Gates(), List.of(), "remediation session failed: " + exc); // src: vvaharness/remediation_agent/plugin_runner/run.py:138
        // The returned call carries no preCallDirty: an empty baseline reads every pre-existing forbidden file (all of .git) as this call's edit.
        return new GuardedCall(verdict, snapshot, pre, meta, false, started, spendBefore, List.of()); // src: vvaharness/remediation_agent/plugin_runner/run.py:142
    }

    Amended harnessAmend(RemediationVerdict remediation, Map<String, String> snapshot, EngineRequest request, PreResult pre, boolean denied, Instant started, Spend spendBefore, List<String> preCallDirty, Theta θ) {
        // Replace the engine's self-report with what the harness can prove, reading the whole working tree rather than the reported changes.
        List<String> reverted = List.of();                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:152
        Map<String, Object> meta = Map.of();                                                        // src: vvaharness/remediation_agent/plugin_runner/run.py:153
        if (pre != null) {                                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:154
            PostResult post = Postgate.enforcePost(request.policyCtx, request.target, remediation, pre, request.repo, snapshot, true, θ); // src: vvaharness/remediation_agent/plugin_runner/run.py:155
            reverted = post.reverted;                                                               // src: vvaharness/remediation_agent/plugin_runner/run.py:157
            meta = postMeta(pre, post);                                                             // src: vvaharness/remediation_agent/plugin_runner/run.py:158
        }
        String diff = DiffDerive.deriveDiff(request.repo, snapshot, remediation.changes.filter(c -> c.file != null && !c.file.isEmpty()).map(c -> c.file), θ); // src: vvaharness/remediation_agent/plugin_runner/run.py:159
        RemediationEvidence evidence = RemediationAgentModels.toEvidence(remediation, provenance(request, denied, started, spendBefore), θ); // src: vvaharness/remediation_agent/plugin_runner/run.py:161
        // The harness supplies mode, diff and file list: the engine could not know the first two and is unreliable on the third.
        Remediation contract = Remediation.finalize(evidence, request.mode, diff, filesTouched(request.repo, evidence, snapshot, preCallDirty, θ)); // src: vvaharness/remediation_agent/plugin_runner/run.py:164
        meta = reconcilePostMeta(meta, contract, θ);                                                // src: vvaharness/remediation_agent/plugin_runner/run.py:167
        return new Amended(contract, reverted, meta);                                               // src: vvaharness/remediation_agent/plugin_runner/run.py:168
    }

    Map<String, Object> reconcilePostMeta(Map<String, Object> meta, Remediation remediation, Theta θ) {
        // Prevent the policy audit label from contradicting persisted evidence.
        if (!θ["code.remediation_agent.plugin_runner.run.reconcile_audit_with_evidence"]) return meta; // src: vvaharness/remediation_agent/plugin_runner/run.py:174
        // Pre-gate denials and post-gate reverts already carry a stronger reason; only permitted patches are reconciled.
        if (!"patch".equals(meta.get("policy_action")) || meta.get("policy_reverted") != null) return meta; // src: vvaharness/remediation_agent/plugin_runner/run.py:174
        boolean noAction = remediation.kind == NO_ACTION || remediation.kind == ALREADY_RESOLVED;   // src: vvaharness/remediation_agent/plugin_runner/run.py:176
        if (remediation.diff != null && !remediation.diff.isEmpty() && !noAction) return meta;      // src: vvaharness/remediation_agent/plugin_runner/run.py:178
        String reason = (remediation.diff == null || remediation.diff.isEmpty()) ? "no_diff_captured" : "remediation_not_applied"; // src: vvaharness/remediation_agent/plugin_runner/run.py:180
        Map<String, Object> reconciled = meta.with("policy_reason", reason).with("final_verdict", "REJECT"); // src: vvaharness/remediation_agent/plugin_runner/run.py:181
        if (!reason.equals(meta.get("policy_reason"))) reconciled.put("policy_pre_reason", meta.getOr("policy_reason", "")); // src: vvaharness/remediation_agent/plugin_runner/run.py:186
        return reconciled;                                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:188
    }

    Remediation applyPlugin(RemediationTarget target, Path outDir, Config cfg, String repo, String mode, boolean verbose, PolicyContext policyCtx, Theta θ) {
        // Remediate one target through the guards and persist its artefacts. mode defaults to fix.
        EngineRequest request = new EngineRequest(target, repo, mode, cfg, verbose, policyCtx);     // src: vvaharness/remediation_agent/plugin_runner/run.py:197
        GuardedCall guarded = callWithGuards(PluginRunnerInvoke.invoke, request, θ);                // src: vvaharness/remediation_agent/plugin_runner/run.py:199  (the engine seam is the invoke function of plugin_runner)
        Amended amended = harnessAmend(guarded.verdict, guarded.snapshot, request, guarded.pre, guarded.denied, guarded.started, guarded.spendBefore, guarded.preCallDirty, θ); // src: vvaharness/remediation_agent/plugin_runner/run.py:200
        RemediationAgentArtifacts.writeCase(outDir, target, guarded.verdict, amended.remediation, amended.revertedPaths); // src: vvaharness/remediation_agent/plugin_runner/run.py:204  (meta is the guards meta merged with the amend meta)
        return amended.remediation;                                                                 // src: vvaharness/remediation_agent/plugin_runner/run.py:207
    }

    Map<String, Object> checkpointRecord(RemediationTarget target, Path outDir, Remediation remediation) {
        // The small JSON record resume stores for one processed finding; deliberately not the whole Remediation.
        return Map.of("finding_index", target.index, "artifact_dir", String.valueOf(outDir), "kind", remediation.kind.value, "disposition", remediation.disposition != null ? remediation.disposition.value : null, "diff_captured", remediation.diff != null && !remediation.diff.isEmpty()); // src: vvaharness/remediation_agent/plugin_runner/run.py:213
    }

    List<String> filesTouched(String repo, RemediationEvidence evidence, Map<String, String> snapshot, List<String> preCallDirty, Theta θ) {
        // What actually changed under repo during THIS case: proven where possible (git status against the pre-case baseline, then snapshot), never merely claimed by the engine.
        List<String> proven = Gitcapture.changedFilesWholeTree(repo, θ);                            // src: vvaharness/remediation_agent/plugin_runner/run.py:227
        if (!proven.isEmpty()) {                                                                    // src: vvaharness/remediation_agent/plugin_runner/run.py:228
            // Drop any path already dirty before this call UNLESS this case's own snapshot proves it changed further by content: a real edit still gets credited.
            Set<String> preNorm = preCallDirty.map(f -> DiffPaths.normPath(f));                     // src: vvaharness/remediation_agent/plugin_runner/run.py:231
            Set<String> changedThisCase = (snapshot != null && !snapshot.isEmpty()) ? Snapshot.changedSinceSnapshot(repo, snapshot).map(f -> DiffPaths.normPath(f)) : Set.of(); // src: vvaharness/remediation_agent/plugin_runner/run.py:232
            proven = proven.filter(f -> !preNorm.contains(DiffPaths.normPath(f)) || changedThisCase.contains(DiffPaths.normPath(f))); // src: vvaharness/remediation_agent/plugin_runner/run.py:234
            return proven;                                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:236
        }
        // Not a git tree (or nothing dirty): snapshot diff plus the engine's claimed files that really exist inside the repo.
        List<String> fromSnapshot = Snapshot.changedSinceSnapshot(repo, snapshot);                  // src: vvaharness/remediation_agent/plugin_runner/run.py:237
        List<String> claimed = evidence.changes.filter(c -> resolves(repo, c.file)).map(c -> c.file); // src: vvaharness/remediation_agent/plugin_runner/run.py:238
        return fromSnapshot.plus(claimed).distinct();                                               // src: vvaharness/remediation_agent/plugin_runner/run.py:239
    }

    boolean resolves(String repo, String ref) {
        // True when ref names a real file confined to repo.
        if (ref == null || ref.isEmpty()) return false;                                             // src: vvaharness/remediation_agent/plugin_runner/run.py:244
        Path resolved = DiffPaths.safeRepoPath(repo, ref);                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:246
        return resolved != null && resolved.isFile();                                               // src: vvaharness/remediation_agent/plugin_runner/run.py:247
    }

    Map<String, Object> baseMeta(EngineRequest request, Instant started) {
        // Display-only context the summary renderer and the audit sidecar carry.
        return Map.of("severity", request.target.severity, "title", request.target.title, "file", request.target.file, "mode", request.mode, "generated", started.isoformat()); // src: vvaharness/remediation_agent/plugin_runner/run.py:252
    }

    Map<String, Object> postMeta(PreResult pre, PostResult post) {
        // The audit trail of one post-gate pass, for the evidence sidecar: the post-gate reason wins over the pre-gate reason, which is then kept as policy_pre_reason.
        String reason = post.reason != null ? post.reason : pre.decision.reason;                    // src: vvaharness/remediation_agent/plugin_runner/run.py:263
        Map<String, Object> meta = Map.of("policy_action", pre.decision.action.value, "policy_reason", reason, "final_verdict", post.finalVerdict); // src: vvaharness/remediation_agent/plugin_runner/run.py:264
        if (post.reason != null) meta.put("policy_pre_reason", pre.decision.reason);                // src: vvaharness/remediation_agent/plugin_runner/run.py:269
        if (post.reverted != null && !post.reverted.isEmpty()) {                                    // src: vvaharness/remediation_agent/plugin_runner/run.py:271
            meta.put("policy_reverted", post.reverted);                                             // src: vvaharness/remediation_agent/plugin_runner/run.py:272
            meta.put("policy_matched_globs", post.matchedGlobs);                                    // src: vvaharness/remediation_agent/plugin_runner/run.py:273
        }
        return meta;                                                                                // src: vvaharness/remediation_agent/plugin_runner/run.py:274
    }

    void tracePolicy(EngineRequest request, PreResult pre) {
        // Surface the policy decision and resolved playbook strategy under verbose.
        if (pre != null) {                                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:281
            Trace.dumpPolicy(request.target, pre);                                                  // src: vvaharness/remediation_agent/plugin_runner/run.py:282
            return;                                                                                 // src: vvaharness/remediation_agent/plugin_runner/run.py:283
        }
        Console.write("[policy] enforcement disabled (step_remediate.enforce_policy=false): no policy gate or playbook strategy injected for finding " + request.target.index); // src: vvaharness/remediation_agent/plugin_runner/run.py:284
    }

    GuardedCall denied(EngineRequest request, PreResult pre, Map<String, Object> meta, Instant started, Spend spendBefore) {
        // Short-circuit a policy-denied finding to guidance: no model call, no tokens.
        RemediationVerdict verdict = Decide.guidanceVerdict(request.policyCtx, request.target, pre); // src: vvaharness/remediation_agent/plugin_runner/run.py:292
        Console.write("[policy] pre-gate guidance-only for finding " + request.target.index + " (" + pre.decision.reason + ") - agent skipped"); // src: vvaharness/remediation_agent/plugin_runner/run.py:293
        return new GuardedCall(verdict, Map.of(), null, meta.with("policy_action", pre.decision.action.value).with("policy_reason", pre.decision.reason).with("final_verdict", "REJECT"), true, started, spendBefore, List.of()); // src: vvaharness/remediation_agent/plugin_runner/run.py:295
    }

    List<String> snapshotTargets(EngineRequest request, Theta θ) {
        // Files needed to prove and, when necessary, revert S10 edits: the target file, every workflow file (workflow refs are judged PRE-EDIT so each needs a rollback baseline), and, when enforcing, every worktree file matching the forbid and deny globs.
        List<String> targets = request.target.file != null && !request.target.file.isEmpty() ? List.of(request.target.file) : List.of(); // src: vvaharness/remediation_agent/plugin_runner/run.py:307
        targets = targets.plus(WorkflowRefs.workflowSnapshotPaths(request.repo, θ));                // src: vvaharness/remediation_agent/plugin_runner/run.py:309
        if (!enforce(request)) return targets;                                                      // src: vvaharness/remediation_agent/plugin_runner/run.py:310
        RemediationGate gate = request.policyCtx.gate;                                              // src: vvaharness/remediation_agent/plugin_runner/run.py:312
        List<String> patterns = gate != null ? Gate.forbidPatchPaths(gate).plus(Gate.denyPaths(gate)) : List.of(); // src: vvaharness/remediation_agent/plugin_runner/run.py:313
        return targets.plus(Postgate.worktreeForbiddenMatches(request.repo, patterns, θ)).distinct(); // src: vvaharness/remediation_agent/plugin_runner/run.py:316
    }

    Object callEngine(Function fn, EngineRequest request, PreResult pre) {
        // Invoke the engine seam, passing the policy context (pre and ctx) only on the enforced path.
        if (pre != null) return fn(request.target, request.cfg, request.repo, request.mode, request.verbose, pre, request.policyCtx); // src: vvaharness/remediation_agent/plugin_runner/run.py:321
        return fn(request.target, request.cfg, request.repo, request.mode, request.verbose);        // src: vvaharness/remediation_agent/plugin_runner/run.py:324
    }

    Provenance provenance(EngineRequest request, boolean denied, Instant started, Spend spendBefore) {
        // Stamp who produced this attempt; engine_version is load-bearing since it is hashed into the resume checkpoint key.
        // Denied means refused before any token was spent, so naming a model would assert a call that never happened.
        Pair<String, String> mb = denied ? Pair.of("", "") : engineModel(request.cfg);              // src: vvaharness/remediation_agent/plugin_runner/run.py:334
        Pair<Double, Integer> ut = denied ? Pair.of(0.0, 0) : Tokens.reportedBetween(spendBefore, TokenCounter.spend()); // src: vvaharness/remediation_agent/plugin_runner/run.py:335
        return new Provenance("vvaharness.remediation_agent", VERSION, mb.first, mb.second, started, started != null ? Clock.nowUtc() : null, ut.first, ut.second); // src: vvaharness/remediation_agent/plugin_runner/run.py:336  (ENGINE_ID)
    }

    Pair<String, String> engineModel(Config cfg) {
        // Resolve (model id, backend) for the remediate role; public because the runner step key hashes the same pair into the resume key.
        try {
            ResolvedModel m = LlmRegistry.resolve(cfg.models.remediate, null);                      // src: vvaharness/remediation_agent/plugin_runner/run.py:347
            // Registry-qualified: bare cli is a subprocess here and an in-process SDK in validation.
            return Pair.of(String.valueOf(m.id), "llm:" + m.via);                                   // src: vvaharness/remediation_agent/plugin_runner/run.py:351  (LLM_REGISTRY prefix)
        } catch (Exception e) {
            return Pair.of("", "");                                                                 // src: vvaharness/remediation_agent/plugin_runner/run.py:349  (provenance is attribution, never a hard failure)
        }
    }
}
