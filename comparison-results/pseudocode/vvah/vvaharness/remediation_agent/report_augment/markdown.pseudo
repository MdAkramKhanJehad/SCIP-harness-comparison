// file: vvaharness/remediation_agent/report_augment/markdown.py
// Add per-finding "### Remediation" sections and a report-level "## Remediation Summary" to the MD copy; idempotent on re-runs.

@executedBy(CODE) @role(step) @stage("S10")
class Markdown {

    // Finding heading, e.g. "### 1. [HIGH] Some title". Group 1 is the report ordinal (shared with the SARIF results array); group 2 is the title, used only when no ordinal match exists.
    Regex FINDING_RE = Regex.multiline("^### (\\d+)\\. \\[[^\\]]*\\]\\s*(.+?)\\s*$");                 // src: vvaharness/remediation_agent/report_augment/markdown.py:37
    // A previously appended Remediation block, anchored to the end of a finding segment.
    Regex EXISTING_REMEDIATION_RE = Regex.dotall("\\n+### Remediation\\n.*\\z");                      // src: vvaharness/remediation_agent/report_augment/markdown.py:39
    // A previously appended Remediation Summary block, stripped before re-inserting.
    Regex SUMMARY_RE = Regex.dotall("## Remediation Summary\\n.*?(?=\\n#1,6 |\\z)");                  // heading up to the next heading of any level or end of text // src: vvaharness/remediation_agent/report_augment/markdown.py:41
    // A level-2 heading ends a finding segment so the Remediation block stays above report-level sections.
    Regex LEVEL2_HEADING_RE = Regex.multiline("^## ");                                               // src: vvaharness/remediation_agent/report_augment/markdown.py:43

    // Render the "### Remediation" section for one finding. Summary and file names are model-controlled and escaped here (CWE-79).
    String mdRemediationSection(CaseRecord record) {
        String status = record.bucket;                                                               // src: vvaharness/remediation_agent/report_augment/markdown.py:46
        String summary = firstNonEmpty(Dto.summaryOf(record), record.reason.strip(), "n/a");         // summary, then reason, then n/a // src: vvaharness/remediation_agent/report_augment/markdown.py:49
        List<String> files = Dto.filesTouched(record);                                               // src: vvaharness/remediation_agent/report_augment/markdown.py:52
        String approach;
        if (status.equals("remediated")) approach = "Automated fix applied by the Remediation Agent and written as a unified diff; awaiting validation."; // src: vvaharness/remediation_agent/report_augment/markdown.py:55
        else if (status.equals("deny")) approach = "Policy gate denied automated patching; guidance-only - a human must remediate."; // src: vvaharness/remediation_agent/report_augment/markdown.py:58
        else approach = "No automated patch applied.";                                               // src: vvaharness/remediation_agent/report_augment/markdown.py:61
        List<String> lines = new ArrayList(List.of("### Remediation", "- **Status:** " + Mdsafe.mdEscape(status), "- **Summary:** " + Mdsafe.mdEscape(summary), "- **Approach:** " + approach, "- **Details of what was remediated:**")); // src: vvaharness/remediation_agent/report_augment/markdown.py:64
        if (!files.isEmpty()) lines.addAll(files.map(f -> "  - " + Mdsafe.mdCodeSpan(f)));          // src: vvaharness/remediation_agent/report_augment/markdown.py:67
        else lines.add("  - (no files changed)");                                                    // src: vvaharness/remediation_agent/report_augment/markdown.py:70
        return String.join("\n", lines) + "\n";                                                      // src: vvaharness/remediation_agent/report_augment/markdown.py:73
    }

    // The record's finding title lower-cased and stripped for matching; empty when synthetic.
    String caseTitle(CaseRecord record) {
        Finding finding = Dto.findingOf(record);                                                     // src: vvaharness/remediation_agent/report_augment/markdown.py:76
        return finding != null ? finding.title.strip().lower() : "";                                 // src: vvaharness/remediation_agent/report_augment/markdown.py:79
    }

    // Find the case for an MD heading title; refuses ambiguous matches (fails closed to avoid mis-attribution, CWE-345).
    CaseRecord bestMdMatch(String title, List<CaseRecord> records, Theta θ) {
        String norm = title.strip().lower();                                                         // src: vvaharness/remediation_agent/report_augment/markdown.py:82
        if (norm.isEmpty()) return null;                                                             // src: vvaharness/remediation_agent/report_augment/markdown.py:85
        List<CaseRecord> exact = records.filter(r -> caseTitle(r).equals(norm));                     // src: vvaharness/remediation_agent/report_augment/markdown.py:88
        if (exact.size() == 1) return exact.get(0);                                                  // src: vvaharness/remediation_agent/report_augment/markdown.py:91
        if (exact.size() > 1) { Logging.warning("cases share the exact title - refusing to guess; finding rendered as skipped"); return null; } // src: vvaharness/remediation_agent/report_augment/markdown.py:94
        // No exact match: unambiguous substring fallback only, in either direction, ignoring cases with an empty title.
        List<CaseRecord> fuzzy = records.filter(r -> !caseTitle(r).isEmpty() && (norm.contains(caseTitle(r)) || caseTitle(r).contains(norm))); // src: vvaharness/remediation_agent/report_augment/markdown.py:96
        if (fuzzy.size() == 1) return fuzzy.get(0);                                                  // src: vvaharness/remediation_agent/report_augment/markdown.py:99
        if (fuzzy.size() > 1) Logging.warning("ambiguous title match - refusing to guess; finding rendered as skipped"); // src: vvaharness/remediation_agent/report_augment/markdown.py:102
        return null;                                                                                 // src: vvaharness/remediation_agent/report_augment/markdown.py:105
    }

    // Insert or replace per-finding sections plus a report-level summary. ordinalMatches (the SARIF-side match) is tried before title matching, since two findings can share a title.
    void augmentMd(Path path, List<CaseRecord> records, Map<Integer, CaseRecord> ordinalMatches, Theta θ) {
        String text = path.readText("utf-8");                                                        // src: vvaharness/remediation_agent/report_augment/markdown.py:108
        text = SUMMARY_RE.sub("", text).rstrip() + "\n";                                             // drop any prior summary so re-runs are idempotent // src: vvaharness/remediation_agent/report_augment/markdown.py:109
        List matches = FINDING_RE.finditer(text);                                                    // src: vvaharness/remediation_agent/report_augment/markdown.py:111
        if (matches.isEmpty()) return;                                                               // file left unchanged (not even the summary strip) // src: vvaharness/remediation_agent/report_augment/markdown.py:112
        List<Integer> bounds = matches.map(m -> m.start()).concat(List.of(text.length()));           // src: vvaharness/remediation_agent/report_augment/markdown.py:114
        List<String> rebuilt = new ArrayList(List.of(text.substring(0, bounds.get(0))));             // src: vvaharness/remediation_agent/report_augment/markdown.py:115
        for (int i = 0; i < matches.size(); i++) {                                                   // src: vvaharness/remediation_agent/report_augment/markdown.py:117
            Match m = matches.get(i);
            int start = bounds.get(i); int end = bounds.get(i + 1);                                  // src: vvaharness/remediation_agent/report_augment/markdown.py:118
            Match cut = LEVEL2_HEADING_RE.search(text, m.end(), end);                                // segment ends at the next finding heading or the first level-2 heading // src: vvaharness/remediation_agent/report_augment/markdown.py:120
            int segEnd = cut != null ? cut.start() : end;                                            // src: vvaharness/remediation_agent/report_augment/markdown.py:121
            int ordinal = Integer.parseInt(m.group(1));                                              // src: vvaharness/remediation_agent/report_augment/markdown.py:123
            CaseRecord record = firstNonNull(ordinalMatches == null ? null : ordinalMatches.get(ordinal), bestMdMatch(m.group(2), records, θ), Dto.skippedRecord()); // ordinal, then title, then synthetic skipped // src: vvaharness/remediation_agent/report_augment/markdown.py:124
            rebuilt.add(augmentSegment(text.substring(start, segEnd), record));                      // src: vvaharness/remediation_agent/report_augment/markdown.py:126
            rebuilt.add(text.substring(segEnd, end));                                                // level-2 material stays below the block // src: vvaharness/remediation_agent/report_augment/markdown.py:127
        }
        rebuilt.add("\n" + ReportAugmentSummary.mdSummarySection(records));                          // src: vvaharness/remediation_agent/report_augment/markdown.py:129
        path.writeText(String.join("", rebuilt), "utf-8");                                           // src: vvaharness/remediation_agent/report_augment/markdown.py:130
    }

    // Replace any prior Remediation block in the segment and append the current one.
    String augmentSegment(String segment, CaseRecord record) {
        String stripped = EXISTING_REMEDIATION_RE.sub("", segment);                                  // src: vvaharness/remediation_agent/report_augment/markdown.py:133
        return stripped.rstrip() + "\n\n" + mdRemediationSection(record) + "\n";                     // src: vvaharness/remediation_agent/report_augment/markdown.py:136
    }
}
