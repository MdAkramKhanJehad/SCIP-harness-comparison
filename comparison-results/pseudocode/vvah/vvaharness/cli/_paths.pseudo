// file: vvaharness/cli/_paths.py
// Config/repo path resolution from raw argv and the config trust boundary shared by every subcommand.

@executedBy(CODE) @role(config)
class Paths {

    /** Config.load plus backend configuration; a policy refusal is reported and returns null. */
    Config loadAndConfigure(String cfgPath, String label, Theta θ) {
        Config cfg;
        try { cfg = Config.load(cfgPath, false); }                                                     // src: vvaharness/cli/_paths.py:34
        catch (ConfigPolicyError e) { Console.write(label + ": refused"); return null; }               // src: vvaharness/cli/_paths.py:35
        OrchestratorPreflight.configureBackends(cfg, Path.of(cfgPath).realPath().parent(), θ);          // src: vvaharness/cli/_paths.py:38
        return cfg;
    }

    /** Effective --config (last occurrence wins) and whether it was explicit; else the default config. */
    Pair<String, Boolean> configPathFromExplicit(List<String> rest) {
        String found = null;
        for (int i = 0; i < rest.size(); i++) {                                                        // src: vvaharness/cli/_paths.py:45
            String a = rest.get(i);
            if (a == "--config" && i + 1 < rest.size()) found = rest.get(i + 1);                       // src: vvaharness/cli/_paths.py:47
            else if (a.startsWith("--config=")) found = a.after("=");                                  // src: vvaharness/cli/_paths.py:49
        }
        if (found != null) return Pair.of(found, true);                                                // src: vvaharness/cli/_paths.py:51
        return Pair.of(ConfigPaths.defaultConfig().toString(), false);                                 // src: vvaharness/cli/_paths.py:53
    }

    String configPathFrom(List<String> rest) {
        return configPathFromExplicit(rest).first;                                                     // src: vvaharness/cli/_paths.py:57
    }

    /** --config is checked against the --repo target when given. */
    String configTrustBoundary(List<String> rest) {
        return repoFrom(rest);                                                                         // src: vvaharness/cli/_paths.py:61
    }

    /** Error text when the interpreter is older than Requires-Python, else null. */
    String checkPython() {
        String req;
        try { req = Metadata.of("vvaharness").get("Requires-Python"); } catch (Exception e) { return null; } // src: vvaharness/cli/_paths.py:67
        Match m = Regex.search(">=\\s*(\\d+)\\.(\\d+)", req);                                          // src: vvaharness/cli/_paths.py:71
        if (m == null) return null;                                                                    // src: vvaharness/cli/_paths.py:72
        if (Sys.version() < Version.of(m.group(1), m.group(2))) return "vvaharness requires a newer Python"; // src: vvaharness/cli/_paths.py:75
        return null;                                                                                   // src: vvaharness/cli/_paths.py:79
    }

    /** --repo target (split or = form), else null. */
    String repoFrom(List<String> rest) {
        for (int i = 0; i < rest.size(); i++) {                                                        // src: vvaharness/cli/_paths.py:83
            String a = rest.get(i);
            if (a == "--repo" && i + 1 < rest.size()) return rest.get(i + 1);                          // src: vvaharness/cli/_paths.py:84
            if (a.startsWith("--repo=")) return a.after("=");                                          // src: vvaharness/cli/_paths.py:86
        }
        return null;                                                                                   // src: vvaharness/cli/_paths.py:88
    }
}
