// file: vvaharness/pipeline/stages/replay.py
// Bound a stage at a wall clock; when it expires, resume the pinned session (one extra user turn) or, failing that,
// re-ask a fresh tool-less call from the recorded transcript. Used by S2, S4, S6 and S8.

@executedBy(CODE) @role(step)
class Replay {

    /** The call's result, raising VVAH-E008 once seconds elapse; 0/None means no clock. step*.timeout reaches the route only on deepagents and the cli MCP bridge (sdk and openai drop it), so a stage that must be bounded on every route owns its clock here. */
    @src("vvaharness/pipeline/stages/replay.py:221")
    Object runWithDeadline(Callable call, Double seconds, String stage, Effort effort) {
        if (seconds == null || seconds <= 0) return call.run();                                             // src: vvaharness/pipeline/stages/replay.py:226
        double started = monotonic();                                                                       // src: vvaharness/pipeline/stages/replay.py:231
        Future fut = startDaemon(call, "deadline-" + stage);                                                // daemon worker: never joined at exit // src: vvaharness/pipeline/stages/replay.py:232
        try {
            return fut.result(seconds);                                                                     // src: vvaharness/pipeline/stages/replay.py:234
        } catch (TimeoutError exc) {
            if (fut.done()) return fut.result();                                                            // the call's own error (a route CallTimeoutError is a TimeoutError), counted once // src: vvaharness/pipeline/stages/replay.py:238
            fut.addDoneCallback(orphanSettled(stage, started));                                             // counts only if the abandoned call later settles // src: vvaharness/pipeline/stages/replay.py:243
            fut.cancel();                                                                                   // no-op on a RUNNING future // src: vvaharness/pipeline/stages/replay.py:244
            throw LlmModels.callTimeoutError(stage, "stage", seconds, effort, "stage deadline exceeded " + seconds + "s"); // src: vvaharness/pipeline/stages/replay.py:245
        }
    }

    /** A done-callback factory: when an abandoned future later settles, count and log it once (cancelled futures are skipped). */
    @src("vvaharness/pipeline/stages/replay.py:223")
    Consumer<Future> orphanSettled(String stage, double started) {
        return fut -> onDone(fut, stage, started);                                                          // src: vvaharness/pipeline/stages/replay.py:233
    }

    /** Nested _on_done(fut). */
    @src("vvaharness/pipeline/stages/replay.py:226")
    void onDone(Future fut, String stage, double started) {
        if (fut.cancelled()) return;                                                                        // src: vvaharness/pipeline/stages/replay.py:227
        String outcome = fut.exception() == null ? "result" : typeName(fut.exception());                    // src: vvaharness/pipeline/stages/replay.py:229
        Counters.bump(stage.split(" ")[0] + "_orphan_settled");                                             // src: vvaharness/pipeline/stages/replay.py:230
        Log.warn("STAGE_ORPHAN_SETTLED", stage.split(" ")[0], outcome, round(monotonic() - started, 1));    // src: vvaharness/pipeline/stages/replay.py:231
    }

    /** Run call into fut unless it was cancelled first, relaying any exception to the waiter (never swallowed). */
    @src("vvaharness/pipeline/stages/replay.py:206")
    void settleFuture(Future fut, Callable call) {
        if (!fut.setRunningOrNotifyCancel()) return;                                                        // src: vvaharness/pipeline/stages/replay.py:208
        try { fut.setResult(call.run()); }                                                                  // src: vvaharness/pipeline/stages/replay.py:211
        catch (Throwable exc) { fut.setException(exc); }                                                    // BaseException relayed to the waiter // src: vvaharness/pipeline/stages/replay.py:213
    }

    /** Run call on a daemon thread named name, settling its outcome into the returned Future. */
    @src("vvaharness/pipeline/stages/replay.py:216")
    Future startDaemon(Callable call, String name) {
        Future fut = new Future();                                                                          // src: vvaharness/pipeline/stages/replay.py:218
        new DaemonThread(() -> settleFuture(fut, call), name).start();                                      // src: vvaharness/pipeline/stages/replay.py:219
        return fut;
    }

    /** A unique id pinning one dispatch's session, so its deadline can resume that conversation. */
    @src("vvaharness/pipeline/stages/replay.py:294")
    String sessionIdFor(String stage, String key) {
        return stage + "-" + key + "-" + uuid4().hex();                                                     // src: vvaharness/pipeline/stages/replay.py:296
    }

    /** Context manager: a session id released on EVERY exit (resume_or_replay only covers the timeout path); without it the success path kept StreamingOptions, the compiled graph and its checkpointed conversation for the whole scan (s4 one session per unit, s6 one per batch). */
    @src("vvaharness/pipeline/stages/replay.py:300")
    String pinnedSession(String stage, String key, Function<String, Object> body) {
        String sessionId = sessionIdFor(stage, key);                                                        // src: vvaharness/pipeline/stages/replay.py:306
        try { return body.apply(sessionId); }                                                               // src: vvaharness/pipeline/stages/replay.py:308
        finally { releasePinnedSession(sessionId); }                                                        // src: vvaharness/pipeline/stages/replay.py:310
    }

    /** One message's content as text, flattening the block-list shape both routes may use: a string as is; a list as its blocks joined by newlines (dict block: text or content, else its str; empty parts dropped); None becomes empty. */
    @src("vvaharness/pipeline/stages/replay.py:100")
    String textOf(Object content) {
        if (content is String) return content;                                                              // src: vvaharness/pipeline/stages/replay.py:102
        if (content is List) {                                                                              // src: vvaharness/pipeline/stages/replay.py:104
            List<String> parts = content.map(b -> b is Map ? str(firstTruthy(b.get("text"), b.get("content"), "")) : str(b)); // src: vvaharness/pipeline/stages/replay.py:105
            return parts.filter(pp -> !pp.isEmpty()).join("\n");                                            // src: vvaharness/pipeline/stages/replay.py:109
        }
        return content == null ? "" : str(content);                                                         // src: vvaharness/pipeline/stages/replay.py:110
    }

    /** A message's display role from a langchain object or an API-shaped dict (type or role, lower-cased into human to USER, ai to ASSISTANT, tool to TOOL RESULT, system to SYSTEM; unknown upper-cased; empty MESSAGE). */
    @src("vvaharness/pipeline/stages/replay.py:113")
    String roleOf(Object message, Theta θ) {
        String raw = message is Map ? str(firstTruthy(message.get("role"), message.get("type"), "")) : str(firstTruthy(getattr(message, "type", null), getattr(message, "role", ""), "")); // src: vvaharness/pipeline/stages/replay.py:115
        return θ["code.replay.role_labels"].getOrDefault(raw.lower(), raw.upper().isEmpty() ? "MESSAGE" : raw.upper()); // src: vvaharness/pipeline/stages/replay.py:119
    }

    /** The tool calls a message requested, one line each ("  -> called name(args)", args cut to 400 chars), or empty when none; non-dict calls are skipped. */
    @src("vvaharness/pipeline/stages/replay.py:122")
    String toolCallsOf(Object message, Theta θ) {
        List calls = firstTruthy(message is Map ? message.get("tool_calls") : getattr(message, "tool_calls", null), List.of()); // src: vvaharness/pipeline/stages/replay.py:124
        List<String> lines = new List();
        for (Object call : calls) {                                                                         // src: vvaharness/pipeline/stages/replay.py:126
            if (!(call is Map)) continue;                                                                   // src: vvaharness/pipeline/stages/replay.py:127
            Map fn = call.get("function") is Map ? call.get("function") : Map.of();                         // src: vvaharness/pipeline/stages/replay.py:129
            Object name = firstTruthy(call.get("name"), fn.get("name"), "?");                               // src: vvaharness/pipeline/stages/replay.py:130
            Object args = firstTruthy(call.get("args"), fn.get("arguments"), "");                           // src: vvaharness/pipeline/stages/replay.py:131
            lines.add("  -> called " + name + "(" + str(args).substring(0, θ["code.replay.tool_args_max_chars"]) + ")"); // src: vvaharness/pipeline/stages/replay.py:132
        }
        return lines.join("\n");                                                                            // src: vvaharness/pipeline/stages/replay.py:133
    }

    /** Continue the pinned session's own conversation for the output it never reported; else replay(). */
    @src("vvaharness/pipeline/stages/replay.py:308")
    String resumeOrReplay(String sessionId, Callable replay, Object model, String instruction, String stage, String tag, int timeout) {
        Counters.bump(stage + "_deadline_resume");                                                          // src: vvaharness/pipeline/stages/replay.py:314
        double started = monotonic();                                                                       // src: vvaharness/pipeline/stages/replay.py:315
        String out;
        try {
            out = Deepagents.resumeAgentic(sessionId, instruction, model, timeout);                         // a resume appends ONE user turn to the live thread: prior messages stay in context and prompt-cached; replay re-sends a rendered copy (lossy, a guaranteed cache miss) // src: vvaharness/pipeline/stages/replay.py:317
        } catch (ModelRefusal e) {
            throw e;                                                                                        // the single refusal resend belongs elsewhere // src: vvaharness/pipeline/stages/replay.py:322
        } catch (Exception exc) {
            Counters.bump(stage + "_deadline_resume_unavailable");                                          // src: vvaharness/pipeline/stages/replay.py:326
            Log.warn("REPLAY_NO_LIVE_SESSION", stage, tag, exc.message);                                    // deliberately broad: a resume is an optimisation // src: vvaharness/pipeline/stages/replay.py:327
            return replay.run();                                                                            // lossy transcript re-ask // src: vvaharness/pipeline/stages/replay.py:328
        } finally {
            releasePinnedSession(sessionId);                                                                // src: vvaharness/pipeline/stages/replay.py:330
        }
        Console.write("resume returned in " + (monotonic() - started) + "s");                               // src: vvaharness/pipeline/stages/replay.py:331
        return out;                                                                                         // src: vvaharness/pipeline/stages/replay.py:332
    }

    /** The re-ask: the transcript when the route shared one, else the original prompt. */
    @src("vvaharness/pipeline/stages/replay.py:278")
    Prompt replayPrompt(Transcript transcript, Prompt originalPrompt, Prompt instruction, String stage, Theta θ) {
        Prompt p = new Prompt();
        p.include(instruction);
        if (!transcript.captured()) {
            Counters.bump(stage + "_replay_without_transcript");                                            // src: vvaharness/pipeline/stages/replay.py:282
            p.rule("No transcript was recoverable on this route. The original request follows; answer it directly."); // src: vvaharness/pipeline/stages/replay.py:283
            p.context(originalPrompt);
            return p;
        }
        Counters.bump(stage + "_replay_from_transcript");                                                   // src: vvaharness/pipeline/stages/replay.py:286
        p.context(transcript.render(θ));                                                                    // "=== SESSION TRANSCRIPT ===" // src: vvaharness/pipeline/stages/replay.py:287
        return p;
    }

    /** Deadline handed to the route so its own clock stops before the stage deadline (less grace, pre-divided by the effort factor). */
    @src("vvaharness/pipeline/stages/replay.py:258")
    Double deadlineBound(Double existing, int deadline, Effort effort, String via) {
        if (deadline <= TIMEOUT_STOP_GRACE_SECONDS) return existing;                                        // src: vvaharness/pipeline/stages/replay.py:263
        // the cli leg folds a None effort to the global cli.effort first
        Effort tier = via == "cli" ? CliRoute.effectiveEffort(effort) : effort;                             // src: vvaharness/pipeline/stages/replay.py:266
        double net = deadline - TIMEOUT_STOP_GRACE_SECONDS;                                                 // src: vvaharness/pipeline/stages/replay.py:267
        double bound = net * (net / LlmModels.effortScaledSeconds(net, tier, SESSION));                     // src: vvaharness/pipeline/stages/replay.py:269
        return (existing == null || existing > bound) ? bound : existing;                                   // src: vvaharness/pipeline/stages/replay.py:270
    }

    void releasePinnedSession(String sessionId) { }
}

@executedBy(CODE) @role(io)
@src("vvaharness/pipeline/stages/replay.py:147")
class Transcript {

    /** The conversation as a prompt block (max_chars default 120000), oldest turns trimmed first when it must shrink. Messages with neither body nor tool calls are skipped; a body over the entry cap is cut with a count. */
    @src("vvaharness/pipeline/stages/replay.py:171")
    String render(Theta θ) {
        List<Message> held = messages.copy();                                                               // under the lock // src: vvaharness/pipeline/stages/replay.py:173
        List<String> blocks = new List();
        for (Message m : held) {                                                                            // src: vvaharness/pipeline/stages/replay.py:175
            Object raw = m is Map ? m.get("content") : getattr(m, "content", "");                          // src: vvaharness/pipeline/stages/replay.py:176
            String body = Replay.textOf(raw); String calls = Replay.toolCallsOf(m, θ);                      // src: vvaharness/pipeline/stages/replay.py:178
            if (body.isEmpty() && calls.isEmpty()) continue;                                                // src: vvaharness/pipeline/stages/replay.py:179
            if (body.length() > θ["p.replay.max_entry_chars"]) body = body.substring(0, θ["p.replay.max_entry_chars"]) + "[... N chars cut]"; // src: vvaharness/pipeline/stages/replay.py:181
            blocks.add("[" + Replay.roleOf(m, θ) + "]\n" + body + (calls.isEmpty() ? "" : "\n" + calls));  // src: vvaharness/pipeline/stages/replay.py:185
        }
        String out = String.join("\n\n", blocks);                                                          // src: vvaharness/pipeline/stages/replay.py:186
        if (out.length() <= θ["code.replay.transcript_max_chars"]) return out;                              // src: vvaharness/pipeline/stages/replay.py:187
        return "[... earlier turns cut to fit the window ...]\n\n" + out.tail(θ["code.replay.transcript_max_chars"]); // src: vvaharness/pipeline/stages/replay.py:189
    }

    /** Whether the route shared any conversation with this sink. */
    @src("vvaharness/pipeline/stages/replay.py:166")
    boolean captured() {
        return !messages.isEmpty();                                                                         // under the lock // src: vvaharness/pipeline/stages/replay.py:169
    }

    /** Keep messages when at least as complete as what is held (fed by the RecordTranscript middleware). */
    @src("vvaharness/pipeline/stages/replay.py:155")
    void record(List<Message> captured) {
        try { captured = List.copyOf(captured == null ? List.of() : captured); } catch (TypeError e) { return; } // a non-iterable is ignored // src: vvaharness/pipeline/stages/replay.py:157
        synchronized (lock) { if (captured.size() >= messages.size()) messages = captured; }               // src: vvaharness/pipeline/stages/replay.py:163
    }
}

/** Middleware that mirrors each turn's messages into the sink so the stage holds them after a kill; it never alters the request. Per-instance name RecordTranscript (langchain requires unique middleware names). */
@executedBy(CODE) @role(io)
@src("vvaharness/pipeline/stages/replay.py:192")
class RecordTranscript {
    Transcript sink;

    /** Capture the request's messages, then pass it through untouched. */
    @src("vvaharness/pipeline/stages/replay.py:195")
    Object wrapModelCall(Object request, Function handler) {
        sink.record(getattr(request, "messages", null));                                                    // src: vvaharness/pipeline/stages/replay.py:197
        return handler.apply(request);                                                                      // src: vvaharness/pipeline/stages/replay.py:198
    }

    /** Async twin of wrapModelCall, for the streaming route. */
    @src("vvaharness/pipeline/stages/replay.py:200")
    Object awrapModelCall(Object request, Function handler) {
        sink.record(getattr(request, "messages", null));                                                    // src: vvaharness/pipeline/stages/replay.py:202
        return await handler.apply(request);                                                                // src: vvaharness/pipeline/stages/replay.py:203
    }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/pipeline/stages/replay.py:66")
class ReplayInstructions {

    /** Shared preamble: what a session is told after it hit its deadline. */
    Prompt preamble(Theta θ) {
        Prompt p = new Prompt();
        p.include(θ["prompt.replay_instructions"]);                                                         // report from the transcript alone; unreached items inconclusive // src: vvaharness/pipeline/stages/replay.py:66
        p.context(θ["p.replay.preamble_deadline_context"]);                                                 // "The session below hit its wall-clock deadline before it reported ... reproduced verbatim." // src: vvaharness/pipeline/stages/replay.py:67
        p.must(θ["p.replay.preamble_no_tools_keep_conclusions"]);                                           // "You have no tools and no further turns. Report from this transcript alone, and keep every conclusion" // src: vvaharness/pipeline/stages/replay.py:70
        return p;
    }

    Prompt s2(Theta θ) {
        Prompt p = preamble(θ);
        p.must(θ["p.replay.s2_replay_keep_all"]);                                                           // "Report the threat model NOW. Keep every asset, trust boundary and threat" // src: vvaharness/pipeline/stages/replay.py:75
        p.rule(θ["p.replay.s2_replay_undisposed_baseline"]);                                                // undisposed baseline item -> open_questions // src: vvaharness/pipeline/stages/replay.py:76
        return p;
    }

    Prompt s4(Theta θ) {
        Prompt p = preamble(θ);
        p.format(θ["p.replay.s4_replay_one_per_unit"]);                                                     // one outcome per unit id; keep evidenced findings with file and line // src: vvaharness/pipeline/stages/replay.py:81
        p.choose(θ["p.replay.s4_replay_unreached_inconclusive"]);                                           // unreached unit is `inconclusive`, never omitted // src: vvaharness/pipeline/stages/replay.py:82
        return p;
    }

    Prompt s6(Theta θ) {
        Prompt p = preamble(θ);
        p.format(θ["p.replay.s6_replay_one_per_finding"]);                                                  // one outcome per finding id; unreached is `inconclusive` // src: vvaharness/pipeline/stages/replay.py:87
        return p;
    }

    /** S8 asks for less: an empty chain list still ships every finding. */
    Prompt s8(Theta θ) {
        Prompt p = preamble(θ);
        p.must(θ["p.replay.s8_replay_only_evidenced"]);                                                     // only evidenced chains and already-decided severity changes // src: vvaharness/pipeline/stages/replay.py:94
        p.forbid(θ["p.replay.s8_replay_drop_unfinished_chain"]);                                            // drop an unfinished chain rather than guess its links // src: vvaharness/pipeline/stages/replay.py:95
        return p;
    }
}
