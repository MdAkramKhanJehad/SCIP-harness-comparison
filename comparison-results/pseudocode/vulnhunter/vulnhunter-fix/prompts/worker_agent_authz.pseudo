// file: vulnhunter-fix/prompts/worker_agent_authz.md
// CWE-class worker prompt for authorization findings (CWE-287/290/306/639/862/863/915); extends the common preamble
// with the canonical fix pattern, two-user discrimination, FULL-tier bar, anti-pattern downgrades and residual template.

@executedBy(MODEL) @role(prompt) @stage("fix.implement.worker")
class WorkerAgentAuthz {

    WorkerResult run(Manifest manifest, Theta θ) {
        // extends worker_agent_common.md (read that file first)
        if (θ["p.worker_agent_authz.extends_common"]) return WorkerAgentCommon.run(manifest, prompt(θ), θ); // src: vulnhunter-fix/prompts/worker_agent_authz.md:3
        return null;
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.worker_agent_authz.extends_common"]);                                           // src: vulnhunter-fix/prompts/worker_agent_authz.md:3
        p.include(canonicalFix(θ));
        p.include(discrimination(θ));
        p.include(fullTierBar(θ));
        p.include(antiPatterns(θ));
        p.format(θ["p.worker_agent_authz.residual_template"]);                                      // src: vulnhunter-fix/prompts/worker_agent_authz.md:55
        return p;
    }

    Prompt canonicalFix(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.worker_agent_authz.fix_check_earliest_path"]);                               // src: vulnhunter-fix/prompts/worker_agent_authz.md:7
        p.step(2, θ["p.worker_agent_authz.fix_fail_closed"]);                                       // src: vulnhunter-fix/prompts/worker_agent_authz.md:9
        p.step(3, θ["p.worker_agent_authz.fix_server_side_verify"]);                                // src: vulnhunter-fix/prompts/worker_agent_authz.md:11
        p.step(4, θ["p.worker_agent_authz.fix_route_all_callers"]);                                 // src: vulnhunter-fix/prompts/worker_agent_authz.md:13
        return p;
    }

    Prompt discrimination(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.worker_agent_authz.discrimination_two_users"]);                                 // src: vulnhunter-fix/prompts/worker_agent_authz.md:18
        p.choose(θ["p.worker_agent_authz.discrimination_post_fix_status"]);                         // src: vulnhunter-fix/prompts/worker_agent_authz.md:23
        p.format(θ["p.worker_agent_authz.discrimination_record_path"]);                             // src: vulnhunter-fix/prompts/worker_agent_authz.md:25
        return p;
    }

    Prompt fullTierBar(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.worker_agent_authz.full_single_authorized_path"]);                         // src: vulnhunter-fix/prompts/worker_agent_authz.md:31
        p.checklist(θ["p.worker_agent_authz.full_no_fallback_branch"]);                             // src: vulnhunter-fix/prompts/worker_agent_authz.md:33
        p.checklist(θ["p.worker_agent_authz.full_two_context_test"]);                               // src: vulnhunter-fix/prompts/worker_agent_authz.md:35
        p.rule(θ["p.worker_agent_authz.full_fail_mitigation"]);                                     // src: vulnhunter-fix/prompts/worker_agent_authz.md:37
        return p;
    }

    Prompt antiPatterns(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.worker_agent_authz.anti_client_side_only"]);                                    // src: vulnhunter-fix/prompts/worker_agent_authz.md:42
        p.rule(θ["p.worker_agent_authz.anti_unsigned_header"]);                                     // src: vulnhunter-fix/prompts/worker_agent_authz.md:43
        p.rule(θ["p.worker_agent_authz.anti_log_only_deny"]);                                       // src: vulnhunter-fix/prompts/worker_agent_authz.md:45
        p.rule(θ["p.worker_agent_authz.anti_check_after_side_effect"]);                             // src: vulnhunter-fix/prompts/worker_agent_authz.md:47
        return p;
    }

    void applyCanonicalFix(Finding f, Theta θ) {
        if (θ["p.worker_agent_authz.fix_check_earliest_path"]) moveCheckTo(f, List.of("middleware", "route decorator", "method entry")); // src: vulnhunter-fix/prompts/worker_agent_authz.md:7
        if (θ["p.worker_agent_authz.fix_fail_closed"]) defaultDenyAllowAfterIdentityAndRole(f);    // src: vulnhunter-fix/prompts/worker_agent_authz.md:9
        if (θ["p.worker_agent_authz.fix_server_side_verify"]) forbidClientIdentityHeaderAsSoleSignal(f); // src: vulnhunter-fix/prompts/worker_agent_authz.md:11
        if (θ["p.worker_agent_authz.fix_route_all_callers"]) routeAllCallersThroughAuthorizedPath(f); // src: vulnhunter-fix/prompts/worker_agent_authz.md:13
    }

    Discrimination discriminate(Finding f, Theta θ) {
        // user A owns R; user B does not
        List<UserContext> users = makeUsers(θ["p.worker_agent_authz.discrimination_two_users"]);    // src: vulnhunter-fix/prompts/worker_agent_authz.md:18
        Discrimination d = new Discrimination();
        d.preFix = users.get(1).get("/resource/R").returnsData() ? "fail" : "pass";                 // src: vulnhunter-fix/prompts/worker_agent_authz.md:21
        d.postFix = θ["p.worker_agent_authz.discrimination_post_fix_status"].contains(users.get(1).get("/resource/R").status) ? "pass" : "fail"; // src: vulnhunter-fix/prompts/worker_agent_authz.md:23
        write(θ["p.worker_agent_authz.discrimination_record_path"], d);                             // src: vulnhunter-fix/prompts/worker_agent_authz.md:25
        return d;
    }

    String tier(Finding f, Diff diff, Discrimination d, Theta θ) {
        String t = "FULL";
        boolean single = θ["p.worker_agent_authz.full_single_authorized_path"] && Graph.callersOf(f.sinkSymbol).allViaAuthorizedPath(); // src: vulnhunter-fix/prompts/worker_agent_authz.md:31
        boolean noFallback = !diff.changedFiles().grepE(θ["p.worker_agent_authz.full_no_fallback_branch"]); // src: vulnhunter-fix/prompts/worker_agent_authz.md:33
        boolean twoCtx = θ["p.worker_agent_authz.full_two_context_test"] && d.usesTwoContexts();    // src: vulnhunter-fix/prompts/worker_agent_authz.md:35
        if (!(single && noFallback && twoCtx)) t = θ["p.worker_agent_authz.full_fail_mitigation"];  // src: vulnhunter-fix/prompts/worker_agent_authz.md:37
        // anti-patterns auto-downgrade
        if (diff.clientSideAuthOnly()) t = θ["p.worker_agent_authz.anti_client_side_only"];         // src: vulnhunter-fix/prompts/worker_agent_authz.md:42
        if (diff.unsignedHeaderIdentity()) t = θ["p.worker_agent_authz.anti_unsigned_header"];      // src: vulnhunter-fix/prompts/worker_agent_authz.md:43
        if (diff.denyIsLogOnly()) t = θ["p.worker_agent_authz.anti_log_only_deny"];                 // src: vulnhunter-fix/prompts/worker_agent_authz.md:45
        if (diff.roleCheckAfterSideEffect() && t == "FULL") t = θ["p.worker_agent_authz.anti_check_after_side_effect"]; // src: vulnhunter-fix/prompts/worker_agent_authz.md:47
        return t;
    }

    List<String> residuals(String tier, Finding f, Theta θ) {
        if (tier == "FULL") return List.of();
        return List.of(θ["p.worker_agent_authz.residual_template"].with("<path>", "<specific reason unclosed>")); // src: vulnhunter-fix/prompts/worker_agent_authz.md:55
    }
}
