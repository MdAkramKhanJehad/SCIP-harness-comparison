// file: vvaharness/validation/ingest/case_loader.py
// Discover safe case paths, enforce provenance before filtering or CVSS caps, and preserve explicit ID order.

// Real name LoadedCase (frozen dataclass): a parsed case and the path it came from, so its verdict lands back in the same file.
@executedBy(CODE) @role(types)
record LoadedValidationCase(FindingCase caseValue, Path path) { }

@executedBy(CODE) @role(io) @stage("S11")
class ValidationCaseLoader {
    @src("vvaharness/validation/ingest/case_loader.py:51")
    String caseId(LoadedValidationCase loaded) {
        return loaded.caseValue.caseId;
    }
    @src("vvaharness/validation/ingest/case_loader.py:56")
    List<Path> discoverCases(Path repo) {
        Path rem = trustedArtifactDir(repo, "security-remediation");
        if (!rem.isDirectory()) return List.of();
        return sorted(rem.glob("*/finding_case.json").filter(p -> !p.isSymlink() && !p.parent.isSymlink()));
    }
    @src("vvaharness/validation/ingest/case_loader.py:74")
    LoadedValidationCase loadCase(Path path) {
        return new LoadedValidationCase(readFindingCase(path), path);
    }
    @src("vvaharness/validation/ingest/case_loader.py:79")
    LoadedValidationCase loadCaseSafe(Path path) {
        try { return loadCase(path); } catch (OSError | ValueError | ValidationError e) { logWarning("skipping unreadable case", path, e); return null; }
    }
    @src("vvaharness/validation/ingest/case_loader.py:91")
    List<String> allCaseIds(Path repo) {
        try { return discoverCases(repo).map(p -> caseId(loadCase(p))); } catch (OSError | ValueError | ValidationError e) { return null; }
    }
    @src("vvaharness/validation/ingest/case_loader.py:99")
    List<LoadedValidationCase> allCases(Path repo) {
        return discoverCases(repo).map(p -> loadCaseSafe(p)).filter(c -> c != null);
    }
    @src("vvaharness/validation/ingest/case_loader.py:112")
    boolean declinedForReview(FindingCase c) {
        Object latest = c.attempts.isEmpty() ? null : c.attempts.last();
        return latest != null && latest.remediation.disposition == NOT_APPLICABLE;
    }
    @src("vvaharness/validation/ingest/case_loader.py:104")
    boolean isValidatable(LoadedValidationCase loaded, Theta θ) {
        FindingCase c = loaded.caseValue;
        if (θ["code.validation.constants.artifacts.validatable_states"].contains(c.state.value)) return true; // src: vvaharness/validation/constants/artifacts.py:36
        return c.state == DECLINED && declinedForReview(c);
    }
    @src("vvaharness/validation/ingest/case_loader.py:119")
    double cvssScore(LoadedValidationCase c) {
        return truthyOr(c.caseValue.finding.cvssScore, 0.0);
    }
    @src("vvaharness/validation/ingest/case_loader.py:124")
    List<LoadedValidationCase> topByCvss(List<LoadedValidationCase> cases, int limit) {
        return stableSortDescending(cases, c -> cvssScore(c)).head(limit);
    }
    @src("vvaharness/validation/ingest/case_loader.py:129")
    void logSelection(List<LoadedValidationCase> cases) {
        for (LoadedValidationCase c : cases) logInfo("selected case", caseId(c), c.caseValue.state);
    }
    @src("vvaharness/validation/ingest/case_loader.py:137")
    List<LoadedValidationCase> capped(List<LoadedValidationCase> cases, Integer limit) {
        if (limit == null || limit <= 0 || cases.size() <= limit) return cases;
        logInfo("cap validation by CVSS", limit, cases.size()); return topByCvss(cases, limit);
    }
    @src("vvaharness/validation/ingest/case_loader.py:149")
    List<LoadedValidationCase> filterOwned(List<LoadedValidationCase> cases, Set owned) {
        List out = new List();
        for (LoadedValidationCase c : cases) {
            if (owned.contains(new Pair(caseId(c), c.path.parent.resolve()))) out.add(c);
            else logWarning("no S10 record for this case", c.path.parent);
        }
        return out;
    }
    @src("vvaharness/validation/ingest/case_loader.py:196")
    List<LoadedValidationCase> selectById(List<LoadedValidationCase> cases, List<String> ids, Theta θ) {
        Map byId = cases.indexLastBy(c -> caseId(c));
        if (ids.anyMatch(id -> !byId.containsKey(id))) throw new IngestError("requested ids not found");
        if (ids.anyMatch(id -> !isValidatable(byId.get(id), θ))) throw new IngestError("requested cases not validatable");
        return ids.map(id -> byId.get(id));
    }
    @src("vvaharness/validation/ingest/case_loader.py:172")
    List<LoadedValidationCase> selectCases(Path repo, List<String> ids, Integer maxFindings, Set owned, Theta θ) {
        List cases = allCases(repo);
        if (owned != null) cases = filterOwned(cases, owned);
        List selected = ids != null ? selectById(cases, ids, θ) : capped(cases.filter(c -> isValidatable(c, θ)), maxFindings);
        logSelection(selected); return selected;
    }
}
