// file: vulnhunter-fix/scripts/preflight.py
// Local-only preflight for the fix skill (no network): tool versions, pinned deps, cloud-LLM env isolation,
// memory and disk, a fork-mode git-init probe, and in-place clean-tree + worktree prune. Exit 1 on any failed check.

@executedBy(CODE) @role(tool) @stage("fix")
class ScriptsPreflight {

    int checksPassed = 0;
    int checksFailed = 0;

    // SKILL.pseudo calls run(); rc != 0 stops the skill
    int run(Theta θ) {
        return main(θ);
    }

    void check(String name, boolean passed, String detail, boolean optional) {
        if (passed) checksPassed += 1;                                                                     // src: vulnhunter-fix/scripts/preflight.py:34
        else if (!optional) checksFailed += 1;                                                             // src: vulnhunter-fix/scripts/preflight.py:38
        print((passed ? "[ok] " : optional ? "[WARN] " : "[FAIL] ") + name + " " + detail);
    }

    List<Integer> parseVersion(String s) {
        // leading integer components only; stops at the first non-integer part
        return s.strip().split(".").takeWhileInt();                                                        // src: vulnhunter-fix/scripts/preflight.py:47
    }

    void checkPython(Theta θ) {
        check("Python", Sys.versionMajorMinor() >= θ["code.fix.scripts.preflight.min_python"], "", false); // src: vulnhunter-fix/scripts/preflight.py:57
    }

    void checkGit(Theta θ) {
        if (Shutil.which("git") == null) {
            check("git", false, "not found in PATH", false);                                               // src: vulnhunter-fix/scripts/preflight.py:68
            return;
        }
        try {
            List<Integer> v = parseVersion(Subprocess.output(List.of("git", "--version"), 5).after("git version ").firstWord()); // src: vulnhunter-fix/scripts/preflight.py:71
            check("git", v.subList(0, 2) >= θ["code.fix.scripts.preflight.min_git"], "", false);           // src: vulnhunter-fix/scripts/preflight.py:74
        } catch (CalledProcessError | TimeoutExpired | FileNotFoundError e) {
            check("git", false, "cannot determine version", false);                                        // src: vulnhunter-fix/scripts/preflight.py:81
        }
    }

    void checkGhCli() {
        if (Shutil.which("gh") == null) {
            check("gh CLI", false, "not found in PATH", false);                                            // src: vulnhunter-fix/scripts/preflight.py:87
            return;
        }
        try {
            Subprocess.output(List.of("gh", "--version"), 5);                                               // src: vulnhunter-fix/scripts/preflight.py:90
            check("gh CLI", true, "", false);                                                              // any version accepted
        } catch (CalledProcessError | TimeoutExpired | FileNotFoundError e) {
            check("gh CLI", false, "cannot determine version", false);                                     // src: vulnhunter-fix/scripts/preflight.py:94
        }
    }

    void checkClaudeCli() {
        if (Shutil.which("claude") == null) {
            check("Claude CLI", false, "not found in PATH", false);                                        // src: vulnhunter-fix/scripts/preflight.py:100
            return;
        }
        try {
            Subprocess.output(List.of("claude", "--version"), 5);                                           // src: vulnhunter-fix/scripts/preflight.py:105
            check("Claude CLI", true, "", false);
        } catch (CalledProcessError | TimeoutExpired | FileNotFoundError e) {
            check("Claude CLI", false, "cannot determine version", false);                                 // src: vulnhunter-fix/scripts/preflight.py:110
        }
    }

    long freeDiskBytes(String path) {
        if (Os.name() == "nt") return Win32.getDiskFreeSpaceExAvailableToCaller(path);                     // src: vulnhunter-fix/scripts/preflight.py:130
        return Os.statvfs(path).fBavail * Os.statvfs(path).fFrsize;                                        // src: vulnhunter-fix/scripts/preflight.py:136
    }

    void checkDiskSpace(Theta θ) {
        double freeGb;
        try {
            freeGb = freeDiskBytes(".") / GB;                                                              // src: vulnhunter-fix/scripts/preflight.py:141
        } catch (OSError | AttributeError e) {
            check("Disk space", true, "cannot determine; skipping check", false);                          // src: vulnhunter-fix/scripts/preflight.py:143
            return;
        }
        check("Disk space", freeGb >= θ["code.fix.scripts.preflight.min_free_disk_gb"], "", false);        // src: vulnhunter-fix/scripts/preflight.py:145
    }

    long totalMemoryBytes() {
        if (Os.name() == "nt") return Win32.globalMemoryStatusEx().ullTotalPhys;                           // src: vulnhunter-fix/scripts/preflight.py:178
        return Os.sysconf("SC_PAGE_SIZE") * Os.sysconf("SC_PHYS_PAGES");                                   // src: vulnhunter-fix/scripts/preflight.py:179
    }

    void checkMemory() {
        try {
            double memGb = totalMemoryBytes() / GB;                                                        // src: vulnhunter-fix/scripts/preflight.py:184
            int cpus = Os.cpuCount() != null ? Os.cpuCount() : 1;
            // informational only: slots are printed, never enforced or passed on
            int slots = Math.max(1, Math.min(cpus, (int) (memGb / 4), 8));                                 // src: vulnhunter-fix/scripts/preflight.py:186
            check("Memory -> " + slots + " parallel slots", true, "", false);                              // src: vulnhunter-fix/scripts/preflight.py:187
        } catch (ValueError | OSError | AttributeError e) {
            check("Memory", true, "cannot determine", false);                                              // src: vulnhunter-fix/scripts/preflight.py:189
        }
    }

    void checkGitCloneWritable() {
        // fork-mode only: git init with templates disabled must work and .git/config must be writable
        String probe = null;
        try {
            probe = Tempfile.mkdtemp(".vulnfix-probe-", ".");                                              // src: vulnhunter-fix/scripts/preflight.py:208
            Proc r = Subprocess.run(List.of("git", "-c", "init.templateDir=", "init", "-q", probe), Env.with("GIT_TEMPLATE_DIR", ""), 15); // src: vulnhunter-fix/scripts/preflight.py:211
            if (r.rc != 0) {
                check("git init under cwd", false, "failed even with GIT_TEMPLATE_DIR=", false);           // src: vulnhunter-fix/scripts/preflight.py:216
                return;
            }
            String config = Path.join(probe, ".git", "config");
            if (!Path.isFile(config)) {
                check("git init under cwd", false, ".git/config was not created", false);                  // src: vulnhunter-fix/scripts/preflight.py:224
                return;
            }
            Files.append(config, "# preflight write-probe\n");                                             // src: vulnhunter-fix/scripts/preflight.py:227
            check("git clone-ready", true, "", false);
        } catch (Exception e) {
            check("git clone-ready", false, e, false);                                                     // src: vulnhunter-fix/scripts/preflight.py:230
        } finally {
            if (probe != null) Shutil.rmtree(probe);                                                       // src: vulnhunter-fix/scripts/preflight.py:233
        }
    }

    String detectInPlaceRoot() {
        if (Shutil.which("git") == null) return null;                                                      // src: vulnhunter-fix/scripts/preflight.py:243
        String top;
        try {
            top = Subprocess.output(List.of("git", "rev-parse", "--show-toplevel")).strip();               // src: vulnhunter-fix/scripts/preflight.py:246
        } catch (CalledProcessError e) {
            return null;
        }
        if (top.isEmpty()) return null;
        String origin;
        try {
            origin = Subprocess.output(List.of("git", "-C", top, "remote", "get-url", "origin")).strip();  // src: vulnhunter-fix/scripts/preflight.py:255
        } catch (CalledProcessError e) {
            return null;
        }
        // looser than detect_mode: substring "github" anywhere in the origin
        if (!origin.lower().contains("github")) return null;                                               // src: vulnhunter-fix/scripts/preflight.py:261
        return top;
    }

    void checkInPlaceMode(String repoRoot) {
        String top = repoRoot != null ? repoRoot : detectInPlaceRoot();                                    // src: vulnhunter-fix/scripts/preflight.py:276
        if (top == null) return;
        int rc = Subprocess.run(List.of("git", "-C", top, "diff", "--quiet")).rc;                          // src: vulnhunter-fix/scripts/preflight.py:284
        int rcStaged = Subprocess.run(List.of("git", "-C", top, "diff", "--cached", "--quiet")).rc;        // src: vulnhunter-fix/scripts/preflight.py:288
        check("Working tree is clean", rc == 0 && rcStaged == 0, "commit or stash before running", false); // src: vulnhunter-fix/scripts/preflight.py:293
        try {
            Subprocess.runChecked(List.of("git", "-C", top, "worktree", "prune"));                         // src: vulnhunter-fix/scripts/preflight.py:302
            check("git worktree prune", true, "", false);
        } catch (CalledProcessError | FileNotFoundError e) {
            check("git worktree prune", false, e, false);                                                  // src: vulnhunter-fix/scripts/preflight.py:308
        }
    }

    void checkGraphifyy(Theta θ) {
        try {
            Import.module("graphify");                                                                     // src: vulnhunter-fix/scripts/preflight.py:323
        } catch (ImportError e) {
            check("graphifyy (module import)", false, "cannot import", false);                             // src: vulnhunter-fix/scripts/preflight.py:325
            return;
        }
        String v;
        try {
            v = Metadata.version("graphifyy");                                                             // src: vulnhunter-fix/scripts/preflight.py:329
        } catch (Exception e) {
            check("graphifyy version", false, "cannot resolve distribution version", false);               // src: vulnhunter-fix/scripts/preflight.py:331
            return;
        }
        check("graphifyy", parseVersion(v).inRange(θ["code.fix.scripts.preflight.graphifyy_version_range"]), "", false); // src: vulnhunter-fix/scripts/preflight.py:334
    }

    void checkBackendIsolation(Theta θ) {
        // REQ-GRA-004: any set cloud-LLM key fails preflight (graph must stay AST-only)
        List<String> leaked = θ["code.fix.scripts.preflight.cloud_llm_env_vars"].filter(n -> Env.get(n) != null && !Env.get(n).isEmpty()); // src: vulnhunter-fix/scripts/preflight.py:344
        if (!leaked.isEmpty()) {
            check("graph backend isolation", false, "cloud LLM env vars are set", false);                  // src: vulnhunter-fix/scripts/preflight.py:346
            return;
        }
        check("graph backend isolation", true, "", false);                                                 // src: vulnhunter-fix/scripts/preflight.py:353
    }

    void checkJsonschema(Theta θ) {
        try {
            Import.module("jsonschema");                                                                   // src: vulnhunter-fix/scripts/preflight.py:359
        } catch (ImportError e) {
            check("jsonschema (module import)", false, "cannot import", false);                            // src: vulnhunter-fix/scripts/preflight.py:361
            return;
        }
        String v;
        try {
            v = Metadata.version("jsonschema");                                                            // src: vulnhunter-fix/scripts/preflight.py:365
        } catch (Exception e) {
            check("jsonschema version", false, "cannot resolve distribution version", false);              // src: vulnhunter-fix/scripts/preflight.py:367
            return;
        }
        check("jsonschema", parseVersion(v).inRange(θ["code.fix.scripts.preflight.jsonschema_version_range"]), "", false); // src: vulnhunter-fix/scripts/preflight.py:370
    }

    int main(Theta θ) {
        String inPlaceRoot = detectInPlaceRoot();                                                          // src: vulnhunter-fix/scripts/preflight.py:382
        checkPython(θ);                                                                                    // src: vulnhunter-fix/scripts/preflight.py:385
        checkGit(θ);
        checkGhCli();
        checkClaudeCli();
        checkGraphifyy(θ);                                                                                 // src: vulnhunter-fix/scripts/preflight.py:391
        checkBackendIsolation(θ);
        checkJsonschema(θ);
        checkMemory();                                                                                     // src: vulnhunter-fix/scripts/preflight.py:396
        checkDiskSpace(θ);
        // clone-writable probe only outside a checkout (fork mode)
        if (inPlaceRoot == null) checkGitCloneWritable();                                                  // src: vulnhunter-fix/scripts/preflight.py:402
        checkInPlaceMode(inPlaceRoot);                                                                     // src: vulnhunter-fix/scripts/preflight.py:406
        if (checksFailed > 0) {
            printBootstrapHint();                                                                          // src: vulnhunter-fix/scripts/preflight.py:418
            return 1;                                                                                      // src: vulnhunter-fix/scripts/preflight.py:419
        }
        return 0;                                                                                          // src: vulnhunter-fix/scripts/preflight.py:422
    }

    void printBootstrapHint() {
        try {
            Import.module("graphify");
            Import.module("jsonschema");
            return;                                                                                        // deps importable: no hint
        } catch (ImportError e) {
        }
        String skillDir = Path.expanduser("~/.claude/skills/vulnhunter-fix");                              // src: vulnhunter-fix/scripts/preflight.py:438
        String venvPy = Os.name() == "nt" ? Path.join(skillDir, ".venv", "Scripts", "python.exe") : Path.join(skillDir, ".venv", "bin", "python3"); // src: vulnhunter-fix/scripts/preflight.py:444
        if (Path.isFile(venvPy)) print("bundled venv exists but preflight is not running through it; re-run or rebuild with install.sh"); // src: vulnhunter-fix/scripts/preflight.py:452
        else if (Path.isFile(Path.join(skillDir, "SKILL.md"))) print("skill installed but bundled venv missing; run install.sh"); // src: vulnhunter-fix/scripts/preflight.py:464
        else print("no installed skill; run install.sh from the source checkout");                         // src: vulnhunter-fix/scripts/preflight.py:472
    }
}
