// file: vvaharness/backends/harness/deepagents/models.py
// The DeepAgents backend's data contract: TLS/credential env keys, the model cache key, the filesystem
// deny rules (read-only sessions, .git internals), the native tool inventory, subagent and graph shapes.

@executedBy(CODE) @role(config)
class DeepagentsModels {

    // Env vars OpenSSL/httpx read for CA bundle; mTLS client cert/key; internal verify_ssl carrier (value-stamped).
    List<String> tlsEnvVars() {
        return List.of("SSL_CERT_FILE", "SSL_CERT_DIR", "VVAHARNESS_TLS_CLIENT_CERT", "VVAHARNESS_TLS_CLIENT_KEY", "VVAHARNESS_TLS_VERIFY"); // src: vvaharness/backends/harness/deepagents/models.py:37
    }

    // The API key wins over the auth token.
    String anthropicKey(Map<String, String> env) {
        return env.get("ANTHROPIC_API_KEY") != null ? env.get("ANTHROPIC_API_KEY") : env.get("ANTHROPIC_AUTH_TOKEN"); // src: vvaharness/backends/harness/deepagents/models.py:50
    }

    String anthropicBase(Map<String, String> env) {
        return env.get("ANTHROPIC_BASE_URL");                                                            // src: vvaharness/backends/harness/deepagents/models.py:55
    }

    String openaiKey(Map<String, String> env) {
        return env.get("OPENAI_API_KEY");                                                                // src: vvaharness/backends/harness/deepagents/models.py:60
    }

    String openaiBase(Map<String, String> env) {
        return env.get("OPENAI_BASE_URL");                                                               // src: vvaharness/backends/harness/deepagents/models.py:65
    }

    // Canonical read-only profile (compat/tests only): native write tools excluded.
    HarnessProfile readOnlyHarnessProfile(Theta θ) {
        return new HarnessProfile(HarnessModels.nativeWriteTools(θ));                                    // src: vvaharness/backends/harness/deepagents/models.py:105
    }

    // Runs without DOTGLOB: ** skips dot paths, so dot spellings are listed explicitly (else .git/.env stay writable).
    List<FilesystemPermission> readOnlyPermissions(Theta θ) {
        return List.of(new FilesystemPermission(List.of("write"), θ["code.backends.harness.deepagents.models.read_only_deny_globs"], "deny")); // src: vvaharness/backends/harness/deepagents/models.py:108
    }

    // A .git/config write is RCE (core.fsmonitor / sshCommand): denied even in a write-enabled session,
    // for every letter-case spelling of .git (wcmatch is case-sensitive).
    List<FilesystemPermission> gitInternalsDeny() {
        List<String> paths = new List();
        for (String d : GitPaths.gitDirSpellings()) {                                                    // src: vvaharness/backends/harness/deepagents/models.py:121
            paths.addAll(List.of("/" + d, "/" + d + "/**", "/**/" + d, "/**/" + d + "/**"));             // src: vvaharness/backends/harness/deepagents/models.py:122
        }
        return List.of(new FilesystemPermission(List.of("write"), paths, "deny"));                       // src: vvaharness/backends/harness/deepagents/models.py:119
    }

    // deepagents registers delete unconditionally; write sessions withhold it explicitly.
    String deleteToolName() {
        return "delete";                                                                                 // src: vvaharness/backends/harness/deepagents/models.py:128
    }

    // Sub-agent dispatch tool, auto-added (not in ALL_NATIVE_TOOLS), so withheld by name.
    String subagentDispatchTool() {
        return "task";                                                                                   // src: vvaharness/backends/harness/deepagents/models.py:131
    }

    // Every native tool FilesystemMiddleware/backend can register; anything not granted is excluded.
    Set<String> allNativeTools(Theta θ) {
        return θ["code.backends.harness.deepagents.models.all_native_tools"];                            // src: vvaharness/backends/harness/deepagents/models.py:134
    }
}

@executedBy(CODE) @role(types)
class ModelKey {
    // Hashable cache key for a resolved model; carries the RESOLVED transport so a learned flip misses the cache.
    ModelKeyRecord of(String modelId, Map<String, String> env, String provider, String effort, Boolean useResponsesApi) {
        return new ModelKeyRecord(modelId, provider == null ? "" : provider, DeepagentsModels.openaiKey(env), DeepagentsModels.openaiBase(env), DeepagentsModels.anthropicKey(env), DeepagentsModels.anthropicBase(env), effort, useResponsesApi); // src: vvaharness/backends/harness/deepagents/models.py:92
    }
}

@executedBy(CODE) @role(types)
record ModelKeyRecord(String modelId, String provider, String openaiKey, String openaiBase, String anthropicKey, String anthropicBase, String effort, Boolean useResponsesApi) { }

@executedBy(CODE) @role(types)
record SubagentSpec(String name, String description, String systemPrompt, ChatModel model, List<Tool> tools, List<Middleware> middleware, Object responseFormat, List<String> skills) { }

@executedBy(CODE) @role(types)
record GraphConfigurable(String threadId) { }

@executedBy(CODE) @role(types)
record GraphInvokeConfig(GraphConfigurable configurable, Integer recursionLimit) { }

// Source NamedTuple CompiledGraph (graph + invoke config) is rendered as the record CompiledGraphPair.
@executedBy(CODE) @role(types)
record CompiledGraphPair(CompiledStateGraph graph, GraphInvokeConfig config) { }

@executedBy(CODE) @role(types)
record DeepAgentsGraphState(List<Message> messages, Object structuredResponse, TokenUsage usage, List<Map<String, Object>> sdkPersonaReports) { }

@executedBy(CODE) @role(types)
record StreamEvent(List<String> namespace, Map<String, DeepAgentsGraphState> payload) { }
