// file: vvaharness/remediation_agent/select/pq.py
// The top N by CVSS selector: a heap based queue with a severity band fallback and a stable index tie-breaker, plus the posture-channel filter.

@executedBy(CODE) @role(step) @stage("S10")
class Pq {

    double bandScore(String severity, Theta θ) {
        // CVSS 3.1 band anchors when a finding has no numeric score: a band-only CRITICAL outranks a numeric 7.5 HIGH. Unknown or empty bands score 0.0.
        Map<String, Double> anchors = θ["code.remediation_agent.select.pq.band_scores"];            // src: vvaharness/remediation_agent/select/pq.py:29  (CRITICAL 9.0, HIGH 7.0, MEDIUM 4.0, LOW 1.0, INFO 0.0)
        return anchors.getOr((severity != null ? severity : "").strip().upper(), 0.0);              // src: vvaharness/remediation_agent/select/pq.py:40
    }

    double scoreOf(Finding it, Double numeric, String severity, Theta θ) {
        // Inner function _score: a numeric score that is not NaN wins; otherwise the severity band anchor (explicit severity accessor, else the item's own severity attribute).
        if (numeric != null && !Double.isNaN(numeric)) return numeric;                              // src: vvaharness/remediation_agent/select/pq.py:58  (a NaN key would silently derail the whole heap ordering)
        return bandScore(severity, θ);                                                              // src: vvaharness/remediation_agent/select/pq.py:62
    }

    List<Finding> selectTopByCvss(List<Finding> items, Integer n, Theta θ) {
        // The n highest-CVSS items ordered highest to lowest; the (negated score, index) min-heap makes ties keep input order and never compares items.
        if (n == null || n <= 0) return List.copyOf(items);                                         // src: vvaharness/remediation_agent/select/pq.py:52  (no cap: everything, unsorted)
        List<Pair<Double, Integer>> heap = items.mapIndexed((i, it) -> Pair.of(-scoreOf(it, it.cvssScore, it.severity, θ), i)); // src: vvaharness/remediation_agent/select/pq.py:64
        Heap.heapify(heap);                                                                         // src: vvaharness/remediation_agent/select/pq.py:65
        List<Finding> out = new List();
        for (int k = 0; k < Math.min(n, heap.size()); k = k + 1) {                                  // src: vvaharness/remediation_agent/select/pq.py:66
            out.add(items.get(Heap.pop(heap).second));
        }
        return out;
    }

    List<Finding> selectTopLogged(List<Finding> items, Integer n, String logPrefix, Theta θ) {
        // select_top_by_cvss plus the shared selecting-top-N-of-M log line.
        int total = items.size();                                                                   // src: vvaharness/remediation_agent/select/pq.py:79
        List<Finding> selected = selectTopByCvss(items, n, θ);                                      // src: vvaharness/remediation_agent/select/pq.py:80
        if (n != null && 0 < n && n < total) {                                                      // src: vvaharness/remediation_agent/select/pq.py:81  (logged only when the selection actually narrows the set)
            Console.write(logPrefix + " selecting top " + n + " of " + total + " finding(s) by CVSS score");  // src: vvaharness/remediation_agent/select/pq.py:82
        }
        return selected;                                                                            // src: vvaharness/remediation_agent/select/pq.py:84
    }

    List<Finding> dropNonMainChannel(List<Finding> items, String logPrefix, Theta θ) {
        // Items minus every finding the S6 verifier stamped channel posture. Fail safe: ONLY exactly posture (case folded, stripped) is dropped; junk and empty channel values are kept.
        List<Finding> kept = items.filter(it -> !(it.finding.channel != null ? it.finding.channel : "").strip().casefold().equals(θ["code.remediation_agent.select.pq.dropped_channel"])); // src: vvaharness/remediation_agent/select/pq.py:90
        int skipped = items.size() - kept.size();                                                   // src: vvaharness/remediation_agent/select/pq.py:92
        if (skipped > 0) Console.write(logPrefix + " skipping " + skipped + " posture-stamped finding(s)");  // src: vvaharness/remediation_agent/select/pq.py:94
        return kept;                                                                                // src: vvaharness/remediation_agent/select/pq.py:97
    }
}
