// file: vulnhunter-fix/templates/issue_body.md
// Fallback issue body for one finding (used when no PR can be opened). Filled by the deliver prompt; placeholders written as <NAME>.
// Humans read it. Gate 2 (check-body-completeness) checks its H2 headings, Gate 1 masks severity words, Gate 4 and the intake parser read the footer HTML comment key marker.

@executedBy(CODE) @role(io) @stage("fix")
class TemplatesIssueBody {

    String run(Map<String, String> fields) {
        StringBuilder b = new StringBuilder();
        b.append("## Security Finding: " + fields.get("VULN_ID") + " — " + fields.get("TITLE"));  // src: vulnhunter-fix/templates/issue_body.md:1
        b.append(findingSummary(fields));
        b.append(attackerCapability(fields));
        b.append(status(fields));
        b.append(fixDescription(fields));
        b.append(securityTest(fields));
        b.append(verificationResults());
        b.append(breakingChange(fields));
        b.append(residualRisk(fields));
        b.append(verificationTable(fields));
        b.append(sweepSummary(fields));
        b.append(priority(fields));
        b.append(footer(fields));
        return b.toString();
    }

    // "## Finding Summary" (required by Gate 2): two-column table of ID, CWE (id: name), Severity, Location in backticks, Root Cause, Data Flow.
    String findingSummary(Map<String, String> fields) {
        return table(List.of("VULN_ID", "CWE: CWE_NAME", "SEVERITY", "LOCATION", "ROOT_CAUSE", "DATA_FLOW"), fields); // src: vulnhunter-fix/templates/issue_body.md:3
    }

    // "## Attacker Capability" (required): exploit description, then an "Impact" line.
    String attackerCapability(Map<String, String> fields) {
        return fields.get("EXPLOIT_DESCRIPTION") + "Impact: " + fields.get("EXPLOIT_IMPACT");     // src: vulnhunter-fix/templates/issue_body.md:15
    }

    // "## Status": STATUS_DESCRIPTION, then ONE of seven alternative paragraphs; the deliver step keeps the one matching the outcome and deletes the others.
    String status(Map<String, String> fields) {
        String s = fields.get("STATUS_DESCRIPTION");                                              // src: vulnhunter-fix/templates/issue_body.md:21
        // alternatives, by outcome:
        //  PR opened:       "Automated fix submitted: #<PR_NUMBER> — review and merge when ready."
        //  cannot auto-fix: "Cannot auto-fix. Reason: <CANNOT_FIX_REASON>" plus "What is needed to resolve this: <HUMAN_ACTION_REQUIRED>"
        //  cross-repo:      "Cross-repo fix required" with <CROSS_REPO_DETAILS>
        //  human decision:  "Requires human decision" (review the Design Options section, comment with the chosen approach)
        //  breaking change: "Breaking change. No PR has been created" (see the Breaking Change section)
        //  issue only:      "Issue only — design or setup unresolved" (see Open Design Questions and Plan to Resolve)
        if (fields.has("OPEN_DESIGN_QUESTIONS")) {
            s += "### Open Design Questions" + fields.get("OPEN_DESIGN_QUESTIONS");               // src: vulnhunter-fix/templates/issue_body.md:39
            s += "### Plan to Resolve" + fields.get("RESOLUTION_PLAN");                           // src: vulnhunter-fix/templates/issue_body.md:43
        }
        return s;
    }

    // "## Fix Description" (required): strategy plus a collapsed details block holding the proposed diff when available.
    String fixDescription(Map<String, String> fields) {
        return "Strategy: " + fields.get("FIX_STRATEGY") + collapsedDiff(fields.get("DIFF"));    // src: vulnhunter-fix/templates/issue_body.md:47
    }

    // "## Security Test" (required): the test source in a fenced block tagged with the language.
    String securityTest(Map<String, String> fields) {
        return "The following test validates the fix works correctly:" + fenced(fields.get("LANG"), fields.get("TEST_CODE")); // src: vulnhunter-fix/templates/issue_body.md:58
    }

    // "## Verification Results" (required): fixed three steps, no placeholders: apply the fix, run the security test (should PASS), run existing tests (no regressions expected).
    String verificationResults() {
        return "1. Apply the fix 2. Run the security test — it should PASS 3. Run existing tests — no regressions expected"; // src: vulnhunter-fix/templates/issue_body.md:66
    }

    // "## Breaking Change" (conditional: status BREAKING_CHANGE; Gate 2 rejects the em-dash heading form): interface change, what callers must do, known callers, registration actions.
    String breakingChange(Map<String, String> fields) {
        if (fields.get("STATUS") != "BREAKING_CHANGE") return "";
        return "Caller Action Required. Interface change: " + fields.get("INTERFACE_CHANGE_DESCRIPTION") + " What callers must do: " + fields.get("CALLER_ACTION_REQUIRED")
             + " Known callers (best-effort search): " + fields.get("KNOWN_CALLERS") + " Registration / gateway actions: " + fields.get("REGISTRATION_ACTIONS"); // src: vulnhunter-fix/templates/issue_body.md:72
    }

    // "## Residual Risk" (conditional: completeness tier not FULL): the rendered section from Delivery.renderResidualRiskSection.
    String residualRisk(Map<String, String> fields) {
        return fields.get("RESIDUAL_RISK_SECTION");                                               // src: vulnhunter-fix/templates/issue_body.md:84
    }

    // "## Verification Table" (conditional): validated by validate-verification (header, cited yes cells, verdict).
    String verificationTable(Map<String, String> fields) {
        return fields.get("VERIFICATION_TABLE");                                                  // src: vulnhunter-fix/templates/issue_body.md:88
    }

    // "## Sweep Summary" (conditional: sweep ran): header row Root cause, Pattern, Found, Captured, Mitigated, Remaining, then SWEEP_ROWS.
    String sweepSummary(Map<String, String> fields) {
        return fields.get("SWEEP_ROWS");                                                          // src: vulnhunter-fix/templates/issue_body.md:94
    }

    // "### Priority": severity and rationale (Gate 1 severity mask applies to the whole body).
    String priority(Map<String, String> fields) {
        return fields.get("SEVERITY") + " — " + fields.get("SEVERITY_RATIONALE");                 // src: vulnhunter-fix/templates/issue_body.md:101
    }

    // Footer: attribution lines, then the machine marker that Gate 4 and the intake parser match anywhere in the body
    // (regex: HTML comment, vulnfix-key, 16 lowercase hex characters).
    String footer(Map<String, String> fields) {
        return "VulnHunter-Finding: " + fields.get("VULN_ID") + " Identified by VulnHunter scan on " + fields.get("SCAN_DATE") // src: vulnhunter-fix/templates/issue_body.md:107
             + "<!-- vulnfix-key: " + fields.get("IDEMPOTENCY_KEY") + " -->";                     // src: vulnhunter-fix/templates/issue_body.md:111
    }
}
