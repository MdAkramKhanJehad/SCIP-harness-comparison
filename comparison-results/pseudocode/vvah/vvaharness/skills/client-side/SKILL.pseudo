// file: vvaharness/skills/client-side/SKILL.md
// S4 skill playbook "client-side": frontend lens. Nothing shipped to the client is secret; a client-only
// control is not a security control; the server line that trusts a client value is the finding.

@executedBy(MODEL) @role(skill) @stage("S4")
class ClientSideSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        // Activate on frontend/, public/, static/, src/components/, bundler config ...
        if (!repo.hasPathsMatching(θ["p.skill_client-side.trigger"])) return List.of();            // src: vvaharness/skills/client-side/SKILL.md:3
        // Nothing upstream hands you frontend code; go look.
        if (θ["p.skill_client-side.go_look_for_frontend"]) repo.globFrontend();                     // src: vvaharness/skills/client-side/SKILL.md:28
        ProbeOutput po = runProbe(repo, θ);
        List<Candidate> cands = new List<Candidate>();
        cands.addAll(judgeIdentity(po, repo, θ));
        cands.addAll(judgeBeyondProbe(po, repo, θ));
        cands.addAll(po.sinkHits().map(h -> Candidate.fromHit(h)));
        List<Finding> out = new List<Finding>();
        for (Candidate c : cands) {
            if (!hardGate(c, θ)) continue;
            if (refuted(c, po, θ)) continue;
            out.addAll(enumerate(c, θ));
        }
        return out;
    }

    ProbeOutput runProbe(Repo repo, Theta θ) {
        if (!θ["p.skill_client-side.run_probe_first"]) return ProbeOutput.empty();                  // src: vvaharness/skills/client-side/SKILL.md:33
        ProbeOutput po = Tools.Bash("sh .vvaharness/skills/client-side/probe.sh " + repo.root);    // src: vvaharness/skills/client-side/SKILL.md:33
        // calls ClientSideProbe.run(...)
        for (String sec : po.expectedSections()) {
            if (θ["p.skill_client-side.probe_missing_section_means_broken"] && !po.has(sec)) po.markBroken(sec); // src: vvaharness/skills/client-side/SKILL.md:37
            if (θ["p.skill_client-side.probe_truncation_regrep"] && po.truncated(sec)) po.replace(sec, Tools.Grep(po.regexOf(sec))); // src: vvaharness/skills/client-side/SKILL.md:38
        }
        // probe locates, decides nothing
        assert θ["p.skill_client-side.probe_decides_nothing"];                                      // src: vvaharness/skills/client-side/SKILL.md:39
        return po;
    }

    List<Candidate> judgeIdentity(ProbeOutput po, Repo repo, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        // Client-supplied identity: highest value here.
        Priority pri = θ["p.skill_client-side.client_supplied_identity_priority"];                   // src: vvaharness/skills/client-side/SKILL.md:55
        for (Hit send : po.section("CLIENT-SUPPLIED IDENTITY")) {
            for (Hit read : po.section("SERVER READS THAT PARAMETER").sameParam(send)) {
                if (θ["p.skill_client-side.read_the_handler"]) {                                      // src: vvaharness/skills/client-side/SKILL.md:57
                    Handler h = Tools.Read(read.file).handlerAt(read.line);
                    if (h.readsParamInsteadOfPrincipal(read.param)) {
                        // CWE-639 anchored at the server line, client line as evidence
                        out.add(Candidate.at(read, θ["p.skill_client-side.cwe639_at_server_line"]).evidence(send).priority(pri)); // src: vvaharness/skills/client-side/SKILL.md:56
                    }
                }
            }
        }
        // The shape we miss: a client file proves a server parameter is attacker-controlled.
        if (θ["p.skill_client-side.client_file_proves_server_param"]) {                             // src: vvaharness/skills/client-side/SKILL.md:108
            for (String p : repo.clientFiles().paramsSentToServer()) {
                if (θ["p.skill_client-side.read_client_report_server_line"]) out.add(Candidate.at(repo.serverLineReading(p), "CWE-639")); // src: vvaharness/skills/client-side/SKILL.md:110
            }
        }
        return out;
    }

    List<Candidate> judgeBeyondProbe(ProbeOutput po, Repo repo, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        // client-side JWT decode used as identity/permission
        if (θ["p.skill_client-side.jwt_client_decode_untrusted"]) for (Hit h : po.section("CLIENT-SIDE JWT DECODE")) if (h.claimUsedAsIdentityOrPermission()) out.add(Candidate.at(h, "CWE-807")); // src: vvaharness/skills/client-side/SKILL.md:58
        // build-inlined env: ask only whether the value is secret
        if (θ["p.skill_client-side.build_env_is_published"]) for (Hit h : po.section("BUILD-INLINED ENV")) if (h.valueIsSecret()) out.add(Candidate.at(h, "CWE-540")); // src: vvaharness/skills/client-side/SKILL.md:60
        // origin checks: only strict equality against an allow-list refutes
        for (Hit h : po.section("POSTMESSAGE / MESSAGE LISTENERS")) {
            if (θ["p.skill_client-side.origin_check_strict_equality_only"] && !h.listenerHasStrictOriginEquality()) out.add(Candidate.at(h, "CWE-346")); // src: vvaharness/skills/client-side/SKILL.md:61
            if (h.isPostMessageWildcardWithToken()) out.add(Candidate.at(h, θ["p.skill_client-side.postmessage_wildcard_cwe201"])); // src: vvaharness/skills/client-side/SKILL.md:62
        }
        // base URL from window.location.hostname + credentials include -> check server reflects Origin with Allow-Credentials
        if (θ["p.skill_client-side.hostname_base_url_check_cors"]) for (Hit h : po.section("REQUEST / TRANSPORT CONFIG")) if (h.baseUrlFromHostname() && repo.serverReflectsOriginWithCredentials()) out.add(Candidate.at(h, "CWE-942")); // src: vvaharness/skills/client-side/SKILL.md:63
        // shipped artifacts
        for (Hit h : po.section("SHIPPED ARTIFACTS / DEV SERVER")) {
            if (h.isDevServerCmd()) out.add(Candidate.at(h, θ["p.skill_client-side.dev_server_cmd_cwe489"])); // src: vvaharness/skills/client-side/SKILL.md:66
            if (θ["p.skill_client-side.copy_all_without_dockerignore"] && h.isCopyAll() && !repo.dockerignoreExcludes(".env", ".git")) out.add(Candidate.at(h, "CWE-540")); // src: vvaharness/skills/client-side/SKILL.md:67
        }
        if (θ["p.skill_client-side.no_lockfile_means_unpinned"] && po.lockfileNone()) out.add(Candidate.at(repo.file("package.json"), "CWE-1104")); // src: vvaharness/skills/client-side/SKILL.md:68
        // toggles that persist nowhere: only visible by reading the component
        if (θ["p.skill_client-side.read_component_for_unpersisted_toggles"]) for (String comp : repo.clientComponents()) out.addAll(Tools.Read(comp).togglesWithNoRequest()); // src: vvaharness/skills/client-side/SKILL.md:69
        for (Form f : repo.passwordForms()) if (f.onlyNewPasswordField()) out.add(Candidate.at(f, θ["p.skill_client-side.password_form_no_reauth_cwe620"])); // src: vvaharness/skills/client-side/SKILL.md:71
        // startsWith('/') does not refute a redirect (protocol-relative //evil.com)
        for (Hit h : po.section("OPEN REDIRECT")) if (!(h.guard() != null && !(θ["p.skill_client-side.startswith_slash_not_refutation"] && h.guard().isStartsWithSlash()))) out.add(Candidate.at(h, "CWE-601")); // src: vvaharness/skills/client-side/SKILL.md:72
        // markup-only bound (step=0.01) is no bound: check the handler rejects negatives
        if (θ["p.skill_client-side.markup_bound_check_handler"]) for (Hit h : po.section("CLIENT-ONLY WRITE GATES")) if (!repo.handlerFor(h).rejectsOutOfBound()) out.add(Candidate.at(h, "CWE-602")); // src: vvaharness/skills/client-side/SKILL.md:73
        return out;
    }

    boolean hardGate(Candidate c, Theta θ) {
        if (θ["p.skill_client-side.gate_construct_with_span"] && !c.hasConstructLineSpan()) return false; // src: vvaharness/skills/client-side/SKILL.md:43
        if (θ["p.skill_client-side.gate_named_consequence"] && c.namedConsequence == null) return false; // src: vvaharness/skills/client-side/SKILL.md:45
        if (θ["p.skill_client-side.gate_server_gap_in_hand"] && c.claimsFrontendEnforces()) {        // src: vvaharness/skills/client-side/SKILL.md:47
            if (!c.backendReachable()) { c.status = θ["p.skill_client-side.unreachable_backend_downgrade"]; c.downgrade(); } // src: vvaharness/skills/client-side/SKILL.md:48
            else if (!c.serverGapInHand()) return false;
        }
        // a client-only check IS the finding (the server-side absence it conceals)
        if (θ["p.skill_client-side.frontend_only_check_is_finding"] && c.isClientOnlyCheck()) c.anchorAtServerAbsence(); // src: vvaharness/skills/client-side/SKILL.md:27
        if (θ["p.skill_client-side.nothing_client_is_secret"] && c.isShippedSecret()) c.confirmExposure(); // src: vvaharness/skills/client-side/SKILL.md:25
        if (θ["p.skill_client-side.client_control_not_security"] && c.relyingOnClientControl()) c.treatAsNoControl(); // src: vvaharness/skills/client-side/SKILL.md:26
        if (c.cweIds.size() != θ["p.skill_client-side.gate_one_most_specific_cwe"]) return false;   // src: vvaharness/skills/client-side/SKILL.md:49
        if (θ["p.skill_client-side.cwe_checked_with_cweguidance"]) c.cwe = Tools.CweGuidance(c.cwe).mostSpecific(); // src: vvaharness/skills/client-side/SKILL.md:49
        return true;
    }

    boolean refuted(Candidate c, ProbeOutput po, Theta θ) {
        if (θ["p.skill_client-side.fp_sanitizer_on_path"] && po.section("SANITIZERS").onPathOf(c)) return true; // src: vvaharness/skills/client-side/SKILL.md:77
        if (θ["p.skill_client-side.fp_framework_interpolation_escapes"] && c.isFrameworkDefaultInterpolation()) return true; // src: vvaharness/skills/client-side/SKILL.md:78
        if (θ["p.skill_client-side.fp_literal_or_enum_sink"] && (c.sinkValueLiteralOrEnum() || c.setTimeoutWithFunctionRef() || c.setAttributeNonUrlNonEvent())) return true; // src: vvaharness/skills/client-side/SKILL.md:79
        if (θ["p.skill_client-side.fp_public_by_design_secret"] && po.section("PUBLIC-BY-DESIGN KEYS").contains(c.site)) { c.nameWhichPublicKey(); return true; } // src: vvaharness/skills/client-side/SKILL.md:81
        if (θ["p.skill_client-side.fp_server_repeats_check"] && c.serverRepeatsCheck()) return true; // src: vvaharness/skills/client-side/SKILL.md:83
        if (θ["p.skill_client-side.fp_lookup_target_not_cwe639"] && c.cwe.equals("CWE-639") && c.idOnlyLookupTargetActorFromPrincipal()) return true; // src: vvaharness/skills/client-side/SKILL.md:84
        if (θ["p.skill_client-side.fp_pin_is_patched"] && c.isDependencyPin() && c.versionPatched()) return true; // src: vvaharness/skills/client-side/SKILL.md:86
        if (θ["p.skill_client-side.state_which_fp_checked"]) c.recordFpChecksRun();                 // src: vvaharness/skills/client-side/SKILL.md:88
        return false;
    }

    List<Finding> enumerate(Candidate c, Theta θ) {
        List<Finding> out = new List<Finding>();
        if (!θ["p.skill_client-side.enum_one_finding_per_site"]) { out.add(c.asFinding()); return out; } // src: vvaharness/skills/client-side/SKILL.md:92
        for (Site s : c.distinctSites()) {
            // token storage anchored at the write, not every getItem; storage token and JS-cookie refresh token are two
            if (θ["p.skill_client-side.enum_token_storage_anchor_at_write"] && c.isTokenStorage() && !s.isWrite()) continue; // src: vvaharness/skills/client-side/SKILL.md:95
            out.add(new Finding(s.file, s.lineStart, s.lineEnd, c.cwe));
        }
        if (θ["p.skill_client-side.enum_each_raw_html_sink"] && c.isRawHtmlSink()) assert out.size() == c.sinkOccurrences(); // src: vvaharness/skills/client-side/SKILL.md:97
        if (θ["p.skill_client-side.enum_each_identity_request"] && c.isClientIdentity()) assert out.size() == c.requests(); // src: vvaharness/skills/client-side/SKILL.md:98
        if (θ["p.skill_client-side.enum_each_vulnerable_pin"] && c.isDependencyPin()) assert out.size() == c.vulnerablePins(); // src: vvaharness/skills/client-side/SKILL.md:100
        // other axis: what else is wrong with this component? each class with its own CWE
        if (θ["p.skill_client-side.other_axis_multiple_classes_per_file"]) out.addAll(c.file.otherClasses()); // src: vvaharness/skills/client-side/SKILL.md:101
        if (θ["p.skill_client-side.never_collapse_blanket_finding"]) out.removeIf(f -> f.isBlanket()); // src: vvaharness/skills/client-side/SKILL.md:104
        return out;
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_client-side.trigger"]);                                                   // src: vvaharness/skills/client-side/SKILL.md:3
        p.rule(θ["p.skill_client-side.nothing_client_is_secret"]);                                  // src: vvaharness/skills/client-side/SKILL.md:25
        p.rule(θ["p.skill_client-side.client_control_not_security"]);                               // src: vvaharness/skills/client-side/SKILL.md:26
        p.rule(θ["p.skill_client-side.frontend_only_check_is_finding"]);                            // src: vvaharness/skills/client-side/SKILL.md:27
        p.must(θ["p.skill_client-side.go_look_for_frontend"]);                                      // src: vvaharness/skills/client-side/SKILL.md:28
        return p;
    }

    Prompt probeSection(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.skill_client-side.run_probe_first"]);                                       // src: vvaharness/skills/client-side/SKILL.md:33
        p.rule(θ["p.skill_client-side.probe_missing_section_means_broken"]);                        // src: vvaharness/skills/client-side/SKILL.md:37
        p.must(θ["p.skill_client-side.probe_truncation_regrep"]);                                   // src: vvaharness/skills/client-side/SKILL.md:38
        p.rule(θ["p.skill_client-side.probe_decides_nothing"]);                                     // src: vvaharness/skills/client-side/SKILL.md:39
        return p;
    }

    Prompt hardGateSection(Theta θ) {
        Prompt p = new Prompt();
        p.evidence(θ["p.skill_client-side.gate_construct_with_span"]);                              // src: vvaharness/skills/client-side/SKILL.md:43
        p.evidence(θ["p.skill_client-side.gate_named_consequence"]);                                // src: vvaharness/skills/client-side/SKILL.md:45
        p.evidence(θ["p.skill_client-side.gate_server_gap_in_hand"]);                               // src: vvaharness/skills/client-side/SKILL.md:47
        p.rule(θ["p.skill_client-side.unreachable_backend_downgrade"]);                             // src: vvaharness/skills/client-side/SKILL.md:48
        p.threshold(θ["p.skill_client-side.gate_one_most_specific_cwe"]);                           // src: vvaharness/skills/client-side/SKILL.md:49
        p.must(θ["p.skill_client-side.cwe_checked_with_cweguidance"]);                              // src: vvaharness/skills/client-side/SKILL.md:49
        return p;
    }

    Prompt judgementSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_client-side.client_supplied_identity_priority"]);                         // src: vvaharness/skills/client-side/SKILL.md:55
        p.rule(θ["p.skill_client-side.cwe639_at_server_line"]);                                     // src: vvaharness/skills/client-side/SKILL.md:56
        p.must(θ["p.skill_client-side.read_the_handler"]);                                          // src: vvaharness/skills/client-side/SKILL.md:57
        p.rule(θ["p.skill_client-side.jwt_client_decode_untrusted"]);                               // src: vvaharness/skills/client-side/SKILL.md:58
        p.rule(θ["p.skill_client-side.build_env_is_published"]);                                    // src: vvaharness/skills/client-side/SKILL.md:60
        p.rule(θ["p.skill_client-side.origin_check_strict_equality_only"]);                         // src: vvaharness/skills/client-side/SKILL.md:61
        p.rule(θ["p.skill_client-side.postmessage_wildcard_cwe201"]);                               // src: vvaharness/skills/client-side/SKILL.md:62
        p.rule(θ["p.skill_client-side.hostname_base_url_check_cors"]);                              // src: vvaharness/skills/client-side/SKILL.md:63
        p.rule(θ["p.skill_client-side.dev_server_cmd_cwe489"]);                                     // src: vvaharness/skills/client-side/SKILL.md:66
        p.rule(θ["p.skill_client-side.copy_all_without_dockerignore"]);                             // src: vvaharness/skills/client-side/SKILL.md:67
        p.rule(θ["p.skill_client-side.no_lockfile_means_unpinned"]);                                // src: vvaharness/skills/client-side/SKILL.md:68
        p.must(θ["p.skill_client-side.read_component_for_unpersisted_toggles"]);                    // src: vvaharness/skills/client-side/SKILL.md:69
        p.rule(θ["p.skill_client-side.password_form_no_reauth_cwe620"]);                            // src: vvaharness/skills/client-side/SKILL.md:71
        p.rule(θ["p.skill_client-side.startswith_slash_not_refutation"]);                           // src: vvaharness/skills/client-side/SKILL.md:72
        p.rule(θ["p.skill_client-side.markup_bound_check_handler"]);                                // src: vvaharness/skills/client-side/SKILL.md:73
        return p;
    }

    Prompt fpSection(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.skill_client-side.fp_sanitizer_on_path"]);                                 // src: vvaharness/skills/client-side/SKILL.md:77
        p.exemption(θ["p.skill_client-side.fp_framework_interpolation_escapes"]);                   // src: vvaharness/skills/client-side/SKILL.md:78
        p.exemption(θ["p.skill_client-side.fp_literal_or_enum_sink"]);                              // src: vvaharness/skills/client-side/SKILL.md:79
        p.exemption(θ["p.skill_client-side.fp_public_by_design_secret"]);                           // src: vvaharness/skills/client-side/SKILL.md:81
        p.exemption(θ["p.skill_client-side.fp_server_repeats_check"]);                              // src: vvaharness/skills/client-side/SKILL.md:83
        p.exemption(θ["p.skill_client-side.fp_lookup_target_not_cwe639"]);                          // src: vvaharness/skills/client-side/SKILL.md:84
        p.exemption(θ["p.skill_client-side.fp_pin_is_patched"]);                                    // src: vvaharness/skills/client-side/SKILL.md:86
        p.must(θ["p.skill_client-side.state_which_fp_checked"]);                                    // src: vvaharness/skills/client-side/SKILL.md:88
        return p;
    }

    Prompt enumerationSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_client-side.enum_one_finding_per_site"]);                                 // src: vvaharness/skills/client-side/SKILL.md:92
        p.rule(θ["p.skill_client-side.enum_token_storage_anchor_at_write"]);                        // src: vvaharness/skills/client-side/SKILL.md:95
        p.rule(θ["p.skill_client-side.enum_each_raw_html_sink"]);                                   // src: vvaharness/skills/client-side/SKILL.md:97
        p.rule(θ["p.skill_client-side.enum_each_identity_request"]);                                // src: vvaharness/skills/client-side/SKILL.md:98
        p.rule(θ["p.skill_client-side.enum_each_vulnerable_pin"]);                                  // src: vvaharness/skills/client-side/SKILL.md:100
        p.must(θ["p.skill_client-side.other_axis_multiple_classes_per_file"]);                      // src: vvaharness/skills/client-side/SKILL.md:101
        p.forbid(θ["p.skill_client-side.never_collapse_blanket_finding"]);                          // src: vvaharness/skills/client-side/SKILL.md:104
        return p;
    }

    Prompt shapeWeMissSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_client-side.client_file_proves_server_param"]);                           // src: vvaharness/skills/client-side/SKILL.md:108
        p.must(θ["p.skill_client-side.read_client_report_server_line"]);                            // src: vvaharness/skills/client-side/SKILL.md:110
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(probeSection(θ));
        p.include(hardGateSection(θ));
        p.include(judgementSection(θ));
        p.include(fpSection(θ));
        p.include(enumerationSection(θ));
        p.include(shapeWeMissSection(θ));
        return p;
    }
}
