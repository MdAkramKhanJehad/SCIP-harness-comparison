// file: vvaharness/skills/ssrf/SKILL.md
// S4 skill playbook "ssrf": outbound fetch whose destination derives from request-controlled input.
// Three-part gate, opaque-fetch-helper shape (the url PARAMETER is the sink), blind SSRF counts, one finding per sink site.

@executedBy(MODEL) @role(skill) @stage("S4")
class SsrfSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        if (!repo.taskMatches(θ["p.skill_ssrf.trigger"])) return List.of();                        // src: vvaharness/skills/ssrf/SKILL.md:3
        ProbeOutput po = runProbe(repo, θ);
        List<Sink> sinks = new List<Sink>();
        sinks.addAll(po.fetchSinks());
        // opaque fetch helpers: url-parameter contracts and fetch-named helpers, even with stubbed bodies
        sinks.addAll(po.urlParameterContracts().filter(h -> h.paramNamedAny(θ["p.skill_ssrf.fetch_contract_names"]))); // src: vvaharness/skills/ssrf/SKILL.md:28
        if (θ["p.skill_ssrf.url_parameter_is_sink"]) sinks.addAll(po.fetchNamedHelpers());          // src: vvaharness/skills/ssrf/SKILL.md:49
        List<Finding> out = new List<Finding>();
        for (Sink s : sinks) {
            for (CallSite cs : callSitesOf(s, θ)) {
                Candidate c = hardGate(s, cs, θ);
                if (c == null) continue;
                if (refuted(c, θ)) continue;
                stillCounts(c, θ);
                c.cwe = chooseCwe(c, θ);
                out.add(anchor(c, s, cs, θ));
            }
        }
        return enumerate(out, θ);
    }

    ProbeOutput runProbe(Repo repo, Theta θ) {
        if (!θ["p.skill_ssrf.run_probe_first"]) return ProbeOutput.empty();                          // src: vvaharness/skills/ssrf/SKILL.md:38
        ProbeOutput po = Tools.Bash("sh .vvaharness/skills/ssrf/probe.sh");                         // src: vvaharness/skills/ssrf/SKILL.md:38
        // calls SsrfProbe.run(...); empty sink sections do NOT end the hunt
        if (θ["p.skill_ssrf.empty_sink_sections_do_not_end_hunt"] && po.fetchSinks().isEmpty()) po.continueWithContractsAndHelpers(); // src: vvaharness/skills/ssrf/SKILL.md:43
        return po;
    }

    List<CallSite> callSitesOf(Sink s, Theta θ) {
        // trace helpers to callers with GraphImporters and GraphNeighbors
        return Tools.call(θ["p.skill_ssrf.trace_helpers_with_graph"], s.file, s.function);         // src: vvaharness/skills/ssrf/SKILL.md:44
    }

    Candidate hardGate(Sink s, CallSite cs, Theta θ) {
        // (a) sink: network I/O, or a fetch contract (even stubbed / vendored / unseen)
        if (θ["p.skill_ssrf.gate_sink_or_fetch_contract"] && !(s.doesNetworkIo() || s.isFetchContract())) return null; // src: vvaharness/skills/ssrf/SKILL.md:27
        // never refute an opaque helper on "no request in body" / "stub" / "no HTTP library installed"
        if (s.isFetchContract() && s.refutationReason() != null && s.refutationReason().in(θ["p.skill_ssrf.never_refute_on_stub_or_no_http_lib"])) s.clearRefutation(); // src: vvaharness/skills/ssrf/SKILL.md:53
        // (b) source: request-controlled channel or second-order DB column
        Source src = cs.urlSourceIn(θ["p.skill_ssrf.gate_request_controlled_source"]);              // src: vvaharness/skills/ssrf/SKILL.md:30
        if (src == null) return null;
        if (θ["p.skill_ssrf.drop_literal_or_deploy_config_url"] && (src.isLiteral() || src.onlyDeployConfig())) return null; // src: vvaharness/skills/ssrf/SKILL.md:34
        // (c) no scheme AND host allow-list enforced on the address actually connected to
        Guard g = cs.guard();
        if (θ["p.skill_ssrf.urlfield_is_fake_defence"] && g != null && g.isUrlFieldOrNonEmptiness()) g = null; // src: vvaharness/skills/ssrf/SKILL.md:54
        if (θ["p.skill_ssrf.gate_no_scheme_and_host_allowlist"] && g != null && g.schemeAndHostOnConnectedAddress()) return null; // src: vvaharness/skills/ssrf/SKILL.md:33
        return new Candidate(s, cs, src, g);
    }

    boolean refuted(Candidate c, Theta θ) {
        if (θ["p.skill_ssrf.fp_resolved_address_allowlist"] && c.guard != null && c.guard.resolvesPinsAndRechecksEachHop()) return true; // src: vvaharness/skills/ssrf/SKILL.md:71
        if (θ["p.skill_ssrf.fp_egress_proxy_in_repo"] && c.egressRestrictedByProxyInRepo()) return true; // src: vvaharness/skills/ssrf/SKILL.md:73
        if (θ["p.skill_ssrf.fp_hardcoded_or_fixed_base"] && c.inputFillsOnlyPathOrQueryOfFixedBase()) return true; // src: vvaharness/skills/ssrf/SKILL.md:74
        if (θ["p.skill_ssrf.fp_trusted_config_unless_writable"] && c.source.trustedConfig() && !c.source.handlerCanWriteConfig()) return true; // src: vvaharness/skills/ssrf/SKILL.md:76
        // NOT refutations: scheme-only checks, host check on unresolved string, syntax validators
        if (c.guard != null && c.guard.kindIn(θ["p.skill_ssrf.not_refutations"])) return false;   // src: vvaharness/skills/ssrf/SKILL.md:77
        return false;
    }

    void stillCounts(Candidate c, Theta θ) {
        if (θ["p.skill_ssrf.blind_ssrf_counts"] && c.responseNotReturned()) c.markBlind();          // src: vvaharness/skills/ssrf/SKILL.md:62
        if (θ["p.skill_ssrf.state_observed_channel"]) c.observedChannel = c.inferChannel();          // src: vvaharness/skills/ssrf/SKILL.md:63
        if (θ["p.skill_ssrf.discarded_response_still_finding"] && c.bodyWrittenToUnreadColumn()) c.keep(); // src: vvaharness/skills/ssrf/SKILL.md:64
        if (θ["p.skill_ssrf.grep_reader_severity_rises"] && Tools.Grep(c.storedColumn()).hasReader()) c.raiseSeverity(); // src: vvaharness/skills/ssrf/SKILL.md:65
        if (θ["p.skill_ssrf.name_internal_target"]) c.internalTarget = c.reachableInternalTarget(); // src: vvaharness/skills/ssrf/SKILL.md:66
        if (c.guard != null && (c.guard.resolvesOnce() || c.guard.privateLiteralDenyList())) c.cite(θ["p.skill_ssrf.weak_host_checks_cite_bypass"]); // src: vvaharness/skills/ssrf/SKILL.md:67
    }

    String chooseCwe(Candidate c, Theta θ) {
        String cwe = θ["p.skill_ssrf.cwe_default_918"];                                            // src: vvaharness/skills/ssrf/SKILL.md:90
        if (c.mechanismIsXmlExternalEntity()) cwe = "CWE-611";                                       // src: vvaharness/skills/ssrf/SKILL.md:90
        if (c.endpointExistsToRelay()) cwe = "CWE-441";                                              // 601 never a substitute  // src: vvaharness/skills/ssrf/SKILL.md:91
        assert θ["p.skill_ssrf.cwe_441_relay_601_never"] != null && !cwe.equals("CWE-601");         // src: vvaharness/skills/ssrf/SKILL.md:91
        if (θ["p.skill_ssrf.call_cweguidance"]) Tools.CweGuidance(cwe);                             // src: vvaharness/skills/ssrf/SKILL.md:92
        return cwe;
    }

    Finding anchor(Candidate c, Sink s, CallSite cs, Theta θ) {
        // anchor on the route call site; when only the helper's contract is in evidence, its def line + name the route
        if (θ["p.skill_ssrf.anchor_on_route_call_site"] && cs != null) return new Finding(cs.file, cs.line, c.cwe); // src: vvaharness/skills/ssrf/SKILL.md:57
        return new Finding(s.file, s.defLine, c.cwe).naming(cs.route());
    }

    List<Finding> enumerate(List<Finding> fs, Theta θ) {
        // one finding per distinct sink site: two routes via one helper = two findings
        if (θ["p.skill_ssrf.enum_one_finding_per_sink_site"]) fs = fs.distinctBy(f -> f.file + f.line); // src: vvaharness/skills/ssrf/SKILL.md:83
        // helper a third finding only if independently reachable; caller-less exported helper reported separately or not at all
        if (θ["p.skill_ssrf.helper_third_only_if_reachable"]) fs.removeIf(f -> f.isHelperDef() && !f.independentlyReachable()); // src: vvaharness/skills/ssrf/SKILL.md:85
        if (θ["p.skill_ssrf.never_collapse_report_classes_separately"]) { fs.removeIf(f -> f.isOmnibus()); fs.splitOtherClassesAtSameLines(); } // src: vvaharness/skills/ssrf/SKILL.md:87
        return fs;
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_ssrf.trigger"]);                                                          // src: vvaharness/skills/ssrf/SKILL.md:3
        p.persona(θ["p.skill_ssrf.stance"]);                                                        // src: vvaharness/skills/ssrf/SKILL.md:24
        return p;
    }

    Prompt hardGateSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_ssrf.gate_sink_or_fetch_contract"]);                                      // src: vvaharness/skills/ssrf/SKILL.md:27
        p.checklist(θ["p.skill_ssrf.fetch_contract_names"]);                                        // src: vvaharness/skills/ssrf/SKILL.md:28
        p.checklist(θ["p.skill_ssrf.gate_request_controlled_source"]);                              // src: vvaharness/skills/ssrf/SKILL.md:30
        p.must(θ["p.skill_ssrf.gate_no_scheme_and_host_allowlist"]);                                // src: vvaharness/skills/ssrf/SKILL.md:33
        p.forbid(θ["p.skill_ssrf.drop_literal_or_deploy_config_url"]);                              // src: vvaharness/skills/ssrf/SKILL.md:34
        return p;
    }

    Prompt probeSection(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.skill_ssrf.run_probe_first"]);                                              // src: vvaharness/skills/ssrf/SKILL.md:38
        p.rule(θ["p.skill_ssrf.empty_sink_sections_do_not_end_hunt"]);                              // src: vvaharness/skills/ssrf/SKILL.md:43
        p.rule(θ["p.skill_ssrf.trace_helpers_with_graph"]);                                         // src: vvaharness/skills/ssrf/SKILL.md:44
        return p;
    }

    Prompt opaqueHelperSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_ssrf.url_parameter_is_sink"]);                                            // src: vvaharness/skills/ssrf/SKILL.md:49
        p.forbid(θ["p.skill_ssrf.never_refute_on_stub_or_no_http_lib"]);                            // src: vvaharness/skills/ssrf/SKILL.md:53
        p.rule(θ["p.skill_ssrf.urlfield_is_fake_defence"]);                                         // src: vvaharness/skills/ssrf/SKILL.md:54
        p.format(θ["p.skill_ssrf.anchor_on_route_call_site"]);                                      // src: vvaharness/skills/ssrf/SKILL.md:57
        return p;
    }

    Prompt stillCountsSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_ssrf.blind_ssrf_counts"]);                                                // src: vvaharness/skills/ssrf/SKILL.md:62
        p.must(θ["p.skill_ssrf.state_observed_channel"]);                                           // src: vvaharness/skills/ssrf/SKILL.md:63
        p.forbid(θ["p.skill_ssrf.discarded_response_still_finding"]);                               // src: vvaharness/skills/ssrf/SKILL.md:64
        p.rule(θ["p.skill_ssrf.grep_reader_severity_rises"]);                                       // src: vvaharness/skills/ssrf/SKILL.md:65
        p.must(θ["p.skill_ssrf.name_internal_target"]);                                             // src: vvaharness/skills/ssrf/SKILL.md:66
        p.evidence(θ["p.skill_ssrf.weak_host_checks_cite_bypass"]);                                 // src: vvaharness/skills/ssrf/SKILL.md:67
        return p;
    }

    Prompt fpSection(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.skill_ssrf.fp_resolved_address_allowlist"]);                               // src: vvaharness/skills/ssrf/SKILL.md:71
        p.exemption(θ["p.skill_ssrf.fp_egress_proxy_in_repo"]);                                     // src: vvaharness/skills/ssrf/SKILL.md:73
        p.exemption(θ["p.skill_ssrf.fp_hardcoded_or_fixed_base"]);                                  // src: vvaharness/skills/ssrf/SKILL.md:74
        p.exemption(θ["p.skill_ssrf.fp_trusted_config_unless_writable"]);                           // src: vvaharness/skills/ssrf/SKILL.md:76
        p.forbid(θ["p.skill_ssrf.not_refutations"]);                                                // src: vvaharness/skills/ssrf/SKILL.md:77
        return p;
    }

    Prompt enumerationSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_ssrf.enum_one_finding_per_sink_site"]);                                   // src: vvaharness/skills/ssrf/SKILL.md:83
        p.rule(θ["p.skill_ssrf.helper_third_only_if_reachable"]);                                   // src: vvaharness/skills/ssrf/SKILL.md:85
        p.forbid(θ["p.skill_ssrf.never_collapse_report_classes_separately"]);                       // src: vvaharness/skills/ssrf/SKILL.md:87
        p.choose(θ["p.skill_ssrf.cwe_default_918"]);                                                // src: vvaharness/skills/ssrf/SKILL.md:90
        p.rule(θ["p.skill_ssrf.cwe_441_relay_601_never"]);                                          // src: vvaharness/skills/ssrf/SKILL.md:91
        p.must(θ["p.skill_ssrf.call_cweguidance"]);                                                 // src: vvaharness/skills/ssrf/SKILL.md:92
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(hardGateSection(θ));
        p.include(probeSection(θ));
        p.include(opaqueHelperSection(θ));
        p.include(stillCountsSection(θ));
        p.include(fpSection(θ));
        p.include(enumerationSection(θ));
        return p;
    }
}
