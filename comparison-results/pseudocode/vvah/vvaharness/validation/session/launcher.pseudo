        Object findings = structured.get("findings"); Object gates = structured.get("synthesized_gates"); // src: vvaharness/validation/session/launcher.py:235
        if (findings != null) writeWorkspaceJson(workspace, "validation_report.json", Map.of("target_jira_status", structured.get("target_jira_status"), "findings", findings)); // src: vvaharness/validation/session/launcher.py:238
        if (gates != null) writeWorkspaceJson(workspace, "synthesized_gates.json", gates); // src: vvaharness/validation/session/launcher.py:244
    }
    List<Map> synthesizeGates(List<PersonaReport> reports, List<String> ids, Theta θ) {
