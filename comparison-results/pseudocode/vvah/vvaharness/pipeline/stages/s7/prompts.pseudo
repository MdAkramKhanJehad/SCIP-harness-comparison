// file: vvaharness/pipeline/stages/s7/prompts.py
// Step 7's prompt: the collapse test (SYSTEM) and the finding rows it rules on (build_payload).
// The model applies the collapse test to every unresolved finding; code refuses cross-CWE merges afterwards.

@executedBy(MODEL) @role(prompt) @stage("S7")
class S7Prompts {

    Prompt system(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.s7_prompts.role_collapse_overlaps"]);                                    // src: vvaharness/pipeline/stages/s7/prompts.py:23
        p.include(decisionTest(θ));
        p.include(collapseWhen(θ));
        p.include(keepSeparateWhen(θ));
        p.include(independentSites(θ));
        p.include(closing(θ));
        return p;
    }

    Prompt decisionTest(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s7.collapse_test"]);                                                   // src: vvaharness/pipeline/stages/s7/prompts.py:23
        p.tiebreak(θ["p.s7_prompts.decision_test_one_fix"]);                                    // src: vvaharness/pipeline/stages/s7/prompts.py:26
        // "If each needs its own code change, they are separate - even if the bug class and file are identical."
        return p;
    }

    Prompt collapseWhen(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s7_prompts.duplicate_of_lower_index"]);                                   // src: vvaharness/pipeline/stages/s7/prompts.py:30
        p.checklist(List.of(
            θ["p.s7_prompts.collapse_same_defect_diff_label"],                                  // src: vvaharness/pipeline/stages/s7/prompts.py:31
            θ["p.s7_prompts.collapse_shared_helper"],                                           // src: vvaharness/pipeline/stages/s7/prompts.py:33
            θ["p.s7_prompts.collapse_global_control_absent"],                                   // src: vvaharness/pipeline/stages/s7/prompts.py:35
            θ["p.s7_prompts.collapse_cause_effect_pair"],                                       // src: vvaharness/pipeline/stages/s7/prompts.py:37
            θ["p.s7_prompts.collapse_one_setting_many_reads"]));                                // src: vvaharness/pipeline/stages/s7/prompts.py:39
        p.threshold(θ["p.s7_prompts.collapse_line_proximity"]);                                 // src: vvaharness/pipeline/stages/s7/prompts.py:40
        return p;
    }

    Prompt keepSeparateWhen(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s7_prompts.keep_separate_marker"]);                                       // src: vvaharness/pipeline/stages/s7/prompts.py:43
        p.checklist(List.of(
            θ["p.s7_prompts.keep_different_fix_locations"],                                     // src: vvaharness/pipeline/stages/s7/prompts.py:44
            θ["p.s7_prompts.keep_same_cwe_independent"],                                        // src: vvaharness/pipeline/stages/s7/prompts.py:46
            θ["p.s7_prompts.keep_different_cwe"]));                                             // src: vvaharness/pipeline/stages/s7/prompts.py:48
        p.forbid(θ["p.s7_prompts.never_collapse_across_cwe"]);                                  // src: vvaharness/pipeline/stages/s7/prompts.py:52
        p.exemption(θ["p.s7_prompts.sibling_cwe_families"]);                                    // src: vvaharness/pipeline/stages/s7/prompts.py:53
        return p;
    }

    Prompt independentSites(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s7_prompts.independent_sites_required"]);                                   // src: vvaharness/pipeline/stages/s7/prompts.py:57
        p.tiebreak(θ["p.s7_prompts.independent_sites_test"]);                                   // src: vvaharness/pipeline/stages/s7/prompts.py:58
        p.rule(θ["p.s7_prompts.independent_sites_no_collapse_effect"]);                         // src: vvaharness/pipeline/stages/s7/prompts.py:59
        // "On a duplicate_of: -1 row set false."
        return p;
    }

    Prompt closing(Theta θ) {
        Prompt p = new Prompt();
        p.tiebreak(θ["p.s7_prompts.unsure_keep_both"]);                                         // src: vvaharness/pipeline/stages/s7/prompts.py:64
        return p;
    }

    @executedBy(CODE)
    Prompt buildPayload(List<Finding> verified, List<Integer> unresolved, Theta θ) {
        // Only the findings the deterministic pass could not resolve, indexed as the reply must be.
        Prompt p = new Prompt();
        if (θ["p.s7_prompts.payload_unresolved_only"]) {                                        // src: vvaharness/pipeline/stages/s7/prompts.py:70
            List rows = new List();
            for (int local : range(unresolved.size())) {                                        // src: vvaharness/pipeline/stages/s7/prompts.py:82
                Finding f = verified[unresolved[local]];
                rows.add(Row.of(θ["p.s7_prompts.payload_fields"], local, f.file, f.lineStart, f.vulnClass, f.title,   // src: vvaharness/pipeline/stages/s7/prompts.py:75
                    f.description.truncate(θ["p.s7_prompts.payload_description_cap"]),          // src: vvaharness/pipeline/stages/s7/prompts.py:77
                    f.exploitScenario.truncate(θ["p.s7_prompts.payload_exploit_scenario_cap"]), // src: vvaharness/pipeline/stages/s7/prompts.py:78
                    f.cwe, f.sourceRef, f.sinkRef));
            }
            p.context("FINDINGS TO DEDUPLICATE:\n" + Json.dump(rows));                           // src: vvaharness/pipeline/stages/s7/prompts.py:83
        }
        return p;
    }

    @executedBy(MODEL)
    List<DedupDecision> applyCollapseTest(List<Row> findings, Theta θ) {
        // The procedure SYSTEM asks the model to carry out, one decision per finding index.
        List<DedupDecision> out = new List();
        for (Row b : findings) {
            int dupOf = -1;
            for (Row a : findings.before(b)) {
                if (a.cwe != b.cwe && !θ["p.s7_prompts.sibling_cwe_families"].sameFamily(a.cwe, b.cwe)) continue; // src: vvaharness/pipeline/stages/s7/prompts.py:52
                if (oneEditFixesBoth(a, b) && !unsure(a, b)) { dupOf = a.index; break; }      // src: vvaharness/pipeline/stages/s7/prompts.py:26
            }
            boolean independent = dupOf >= 0 && !fixingOneFixesOthers(b, dupOf);                // src: vvaharness/pipeline/stages/s7/prompts.py:58
            out.add(new DedupDecision(b.index, dupOf, oneSentenceReason(b, dupOf), independent));
        }
        return out;
    }
}
