# vvaharness/orchestrator/case_ids.py

Minting the stable, content-addressed `case_id` that every reported finding is tracked under. The id survives a rescan that reports the same bug a few lines away, because lines are bucketed. It names the case directory used by remediation and validation, so uniqueness is enforced before anything is written.

Source: `vvaharness/orchestrator/case_ids.py` (lines 1-122)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (after Stage 8, before any file is written)

// src: vvaharness/orchestrator/case_ids.py:27-34
CASE_ID_PREFIX = "vvaf1_"   // versioned so a future scheme is distinguishable
LINE_BUCKET = 10            // line tolerance
_DIGEST_CHARS = 32          // 128 bits of the SHA-256 digest

// src: vvaharness/orchestrator/case_ids.py:100-122
fn mint_case_ids(report):executor=code {
  findings = finding of each ranked entry in report.findings
  taken = { f.case_id for each f in findings where f.case_id is set }
  // idempotent: findings that already hold an id (for example from a resumed Stage 8 checkpoint) keep it
  pending = findings without case_id, grouped by _material(report.repo_root, finding), in first-seen order
  for each [material, group] in pending {
    for each finding in group sorted by _tiebreak_key {
      [case_id, salt] = _claim(material, taken)
      finding.case_id = case_id; taken += case_id
    }
  }
  _assert_unique(findings)
  return { minted, collisions: count of salts > 0, preassigned: length(findings) - minted }
}

// src: vvaharness/orchestrator/case_ids.py:48-53
fn _material(repo_root, finding):executor=code {
  path = _rel_posix(repo_root, finding.file)
  bucket = floor(finding.line_start / LINE_BUCKET)
  klass = finding.cwe || finding.vuln_class.value   // CWE wins when present
  return "$path\n$bucket\n$klass"
}

// src: vvaharness/orchestrator/case_ids.py:37-45
fn _rel_posix(repo_root, raw):executor=code {
  // NFC-normalized, forward slashes, trimmed; repo_root prefix removed; leading "./" and "/" removed
  // so an absolute versus relative path, a Windows separator, or a decomposed filename do not mint two ids
}

// src: vvaharness/orchestrator/case_ids.py:74-79
fn _claim(material, taken):executor=code {
  salt = 0
  while (_digest(material, salt) in taken) salt += 1
  return [_digest(material, salt), salt]
}
// src: vvaharness/orchestrator/case_ids.py:56-59
fn _digest(material, salt):executor=code {
  raw = if (salt == 0) material else "$material\n#$salt"
  return CASE_ID_PREFIX + sha256(raw)[:32]
}

// src: vvaharness/orchestrator/case_ids.py:62-71
fn _tiebreak_key(finding):executor=code {
  return (finding.line_start, finding.line_end, finding.title, finding.chunk_id, finding.source_ref || "", finding.sink_ref || "")
  // content only, not list position, so a reordered report does not re-mint ids
}

// src: vvaharness/orchestrator/case_ids.py:82-97
fn _assert_unique(findings):executor=code {
  for each finding in findings {
    require finding.case_id => throw ValueError("finding <file>:<line> has no case_id after minting")
    require finding.case_id not already seen => throw ValueError("case_id ... minted twice: ... The id names the case directory, so writing both would lose one finding.")
  }
  // the exception propagates out of scan_repo: the run stops before the report is written
}
