// file: vvaharness/validation/io/message_logger.py
// Drains a Harness streaming session to session.jsonl (one JSON line per message), prints optional live
// previews, and derives the exit status from the terminal HarnessResult.

@executedBy(CODE) @role(io) @stage("S11")
class MessageLogger {

    Map serialize(HarnessMessage m) {
        return Dataclasses.asdict(m);                                                                // src: vvaharness/validation/io/message_logger.py:40
    }

    String agentDesc(HarnessToolUse m) {
        if (!(m.input instanceof Map)) return "sub-agent";                                           // src: vvaharness/validation/io/message_logger.py:45
        Object raw = m.input.get("description");                                                     // src: vvaharness/validation/io/message_logger.py:47
        return raw instanceof String ? raw : "sub-agent";                                            // src: vvaharness/validation/io/message_logger.py:48
    }

    void logKeyEvent(HarnessMessage m) {
        if (m instanceof HarnessToolUse) {                                                           // src: vvaharness/validation/io/message_logger.py:52
            Log.info("Tool call: " + m.name);
            if (m.name.equals("Agent")) Log.info("Agent spawned: " + agentDesc(m));                  // src: vvaharness/validation/io/message_logger.py:54
        } else if (m instanceof HarnessSessionInit) {
            Log.info("Session initialized");                                                         // src: vvaharness/validation/io/message_logger.py:57
        } else if (m instanceof HarnessResult) {
            Log.info("Session completed: " + m.subtype);                                             // src: vvaharness/validation/io/message_logger.py:59
        }
    }

    String formatToolUse(HarnessToolUse m) {
        String tid = m.toolId.lastChars(8);                                                          // src: vvaharness/validation/io/message_logger.py:64
        if (m.name.equals("Agent")) return "++ agent " + agentDesc(m) + " [" + tid + "]";             // src: vvaharness/validation/io/message_logger.py:65
        return ">> " + m.name + " [" + tid + "]";                                                    // src: vvaharness/validation/io/message_logger.py:67
    }

    List<String> formatAssistantText(HarnessAssistantText m) {
        String text = m.text.strip();                                                                // src: vvaharness/validation/io/message_logger.py:72
        return text.isEmpty() ? List.of() : List.of(text.replace("\n", " "));                        // src: vvaharness/validation/io/message_logger.py:73
    }

    List<String> formatTerminal(HarnessMessage m) {
        if (m instanceof HarnessToolResult) return List.of("<< result " + (m.isError ? "ERROR" : "ok")); // src: vvaharness/validation/io/message_logger.py:78
        if (m instanceof HarnessResult) return List.of("== session complete (" + m.subtype + ")");    // src: vvaharness/validation/io/message_logger.py:80
        return List.of();
    }

    List<String> fmtSessionInit(HarnessMessage m) {
        return List.of(".. init session=" + m.sessionId.prefix(12));                                 // src: vvaharness/validation/io/message_logger.py:87
    }

    List<String> fmtToolUse(HarnessMessage m) {
        // Dispatch-table adapter: casts the message to HarnessToolUse and wraps formatToolUse in a one-element list.
        return List.of(formatToolUse(m));                                                            // src: vvaharness/validation/io/message_logger.py:92
    }

    List<String> fmtAssistantText(HarnessMessage m) {
        // Dispatch-table adapter: casts the message to HarnessAssistantText and delegates to formatAssistantText.
        return formatAssistantText(m);                                                               // src: vvaharness/validation/io/message_logger.py:96
    }

    List<String> formatLive(HarnessMessage m) {
        // _LIVE_FORMATTERS keyed on the exact message type; any other type falls through to formatTerminal.
        if (m.type == HarnessSessionInit) return fmtSessionInit(m);                                  // src: vvaharness/validation/io/message_logger.py:100
        if (m.type == HarnessToolUse) return fmtToolUse(m);                                          // src: vvaharness/validation/io/message_logger.py:101
        if (m.type == HarnessAssistantText) return fmtAssistantText(m);                              // src: vvaharness/validation/io/message_logger.py:102
        return formatTerminal(m);                                                                    // src: vvaharness/validation/io/message_logger.py:107
    }

    void printLive(HarnessMessage m) {
        for (String line : formatLive(m)) Console.write(line);                                       // src: vvaharness/validation/io/message_logger.py:111
    }

    Pair<Integer, String> processMessage(HarnessMessage m, String observedSid, boolean live) {
        logKeyEvent(m);                                                                              // src: vvaharness/validation/io/message_logger.py:119
        if (live) printLive(m);                                                                      // src: vvaharness/validation/io/message_logger.py:120
        if (m instanceof HarnessSessionInit && m.sessionId != null) observedSid = m.sessionId;       // src: vvaharness/validation/io/message_logger.py:122
        if (m instanceof HarnessResult) {                                                            // src: vvaharness/validation/io/message_logger.py:124
            observedSid = m.sessionId != null ? m.sessionId : observedSid;                           // src: vvaharness/validation/io/message_logger.py:125
            if (m.subtype.equals("error_max_budget_usd")) Log.warning("Validation session halted: max_budget_usd exceeded"); // src: vvaharness/validation/io/message_logger.py:126
            return Pair.of(m.subtype.equals("success") ? 0 : 1, observedSid);                        // only success exits 0  // src: vvaharness/validation/io/message_logger.py:128
        }
        return Pair.of(null, observedSid);
    }

    Pair<Integer, String> streamAndLog(AsyncIterator<HarnessMessage> messages, Path logDir, String sessionId, boolean live) {
        logDir.mkdirs();                                                                             // src: vvaharness/validation/io/message_logger.py:139
        Path sessionLog = logDir.resolve("session.jsonl");                                           // src: vvaharness/validation/io/message_logger.py:140
        int exitCode = 1;                                                                            // no result message = failure  // src: vvaharness/validation/io/message_logger.py:141
        String observedSid = sessionId;
        for (HarnessMessage m : messages) {                                                          // src: vvaharness/validation/io/message_logger.py:144
            sessionLog.appendLine(Json.dumps(serialize(m)));                                         // flushed per line  // src: vvaharness/validation/io/message_logger.py:145
            Pair<Integer, String> r = processMessage(m, observedSid, live);                          // src: vvaharness/validation/io/message_logger.py:147
            observedSid = r.second;
            if (r.first != null) exitCode = r.first;                                                 // src: vvaharness/validation/io/message_logger.py:148
        }
        return Pair.of(exitCode, observedSid);                                                       // src: vvaharness/validation/io/message_logger.py:150
    }
}
