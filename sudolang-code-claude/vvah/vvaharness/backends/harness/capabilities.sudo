# vvaharness/backends/harness/capabilities.py

Static traits of each backend that the remediation (Stage 10) and validation (Stage 11) hosts consult before building a prompt. Never consulted for a detection prompt. Keyed by `via`.

Source: `vvaharness/backends/harness/capabilities.py` (lines 1-60)
Executor: code
Called from: `vvaharness/validation/session/launcher.py:350` and `:371`

// src: vvaharness/backends/harness/capabilities.py:27-55
HarnessCapabilities { reads_injected_claude_config: Boolean; returns_schema_validated_reports: Boolean }
_NONE = HarnessCapabilities(false, false)   // an unknown selector gets every trait off, so a new backend must opt in
_BY_VIA = {
  "cli": HarnessCapabilities(reads_injected_claude_config=true, returns_schema_validated_reports=true),
  "sdk": HarnessCapabilities(reads_injected_claude_config=true, returns_schema_validated_reports=true),   // one harness with "cli"; traits must stay identical; it auto-loads .claude/
  "deepagents": HarnessCapabilities(reads_injected_claude_config=false, returns_schema_validated_reports=true)   // native subagents carry an output schema, so the host synthesizes gates deterministically
}

// src: vvaharness/backends/harness/capabilities.py:58-60
fn capabilities_for(via):executor=code { return _BY_VIA[via || ""] or _NONE }
