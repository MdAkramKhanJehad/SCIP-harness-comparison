// file: vvaharness/pipeline/stages/s8_chain.py
// Step 8: deterministic ranking floor plus model-optional chain/narrative enrichment over a
// rank-prefix window; any enrichment failure still ships the deterministically ranked report.

@executedBy(CODE) @role(stage) @stage("S8")
class S8Chain {

    String enrichmentFailureText(Exception e) {
        // A refusal gets a plain sentence (its exception text would leak route/category into the report).
        if (e is ModelRefusal) return "no chain analysis: the chain model refused the request"; // src: vvaharness/pipeline/stages/s8_chain.py:67
        return "chain call failed (" + Redact.redact(e).truncate(400) + ")";                    // src: vvaharness/pipeline/stages/s8_chain.py:69
    }

    Tuple chainCallWithHalfWindowRetry(List<Finding> sub, List<String> labels, List<Integer> window, List<Finding> findings, ContextPackage ctx, Theta θ) {
        int invalid0 = Counters.get("s8_ranked_findings_entry_invalid");                        // src: vvaharness/pipeline/stages/s8_chain.py:83
        try {
            return Tuple.of(S8Session.chainCall(sub, ctx, θ, labels, true), window, labels, invalid0); // src: vvaharness/pipeline/stages/s8_chain.py:85
        } catch (TruncatedResponseError e) {
            if (!ResponseQuality.isTruncatedWithoutRetry(e)) throw e;                           // src: vvaharness/pipeline/stages/s8_chain.py:87
            // At-cap clip: halve the rank-prefix window and resend ONCE (no drop-tier resend of its own).
            List<Integer> half = S8Window.halfWindow(findings, window);                         // src: vvaharness/pipeline/stages/s8_chain.py:89
            if (half.equals(window)) throw e;                                                   // src: vvaharness/pipeline/stages/s8_chain.py:90
            List<String> halfLabels = half.map(i -> "f" + i);
            String raw = S8Session.chainCall(half.map(i -> findings[i]), ctx, θ, halfLabels, false); // src: vvaharness/pipeline/stages/s8_chain.py:98
            return Tuple.of(raw, half, halfLabels, Counters.get("s8_ranked_findings_entry_invalid"));
        }
    }

    void persistRaw(String text, String suffix) {
        // Redacted raw reply beside the errlog; a write failure only warns.
        try { Files.write(Errlog.currentPath().sibling(suffix), Redact.redact(text)); } catch (OSError e) { Log.warning("S8_RAW_PERSIST_FAILED"); } // src: vvaharness/pipeline/stages/s8_chain.py:110
    }

    Tuple jsonRepair(Object raw, Exception err, ContextPackage ctx, Theta θ) {
        if (!S8Session.repairable(raw)) return Tuple.of(null, null, Map.of());                  // src: vvaharness/pipeline/stages/s8_chain.py:120
        if (!S8Session.repairFits(raw, θ)) {                                                     // src: vvaharness/pipeline/stages/s8_chain.py:123
            Counters.bump("s8_parse_repair_skipped_oversize");
            return Tuple.of(null, null, Map.of());
        }
        Counters.bump("s8_parse_repair_attempted");                                             // src: vvaharness/pipeline/stages/s8_chain.py:129
        String repaired = null;
        ChainReport data;
        try {
            repaired = S8Session.repairCall(raw, err, ctx, θ);                                  // src: vvaharness/pipeline/stages/s8_chain.py:132
            data = S8Outcomes.parseChainReply(repaired);
        } catch (Exception e2) {
            if (Harness.isHaltError(e2)) throw e2;                                              // src: vvaharness/pipeline/stages/s8_chain.py:135
            return Tuple.of(null, null, Map.of("repair_error", Redact.redact(e2).truncate(400)));
        }
        Counters.bump("s8_parse_repair_recovered");                                             // src: vvaharness/pipeline/stages/s8_chain.py:142
        persistRaw(repaired, "_s8_raw_repaired.txt");
        return Tuple.of(data, repaired, Map.of());
    }

    FinalReport run(List<Finding> findings, ContextPackage ctx, Theta θ, List<DroppedFinding> dropped, int rawFindingsCount, ScanMetrics metrics) {
        if (findings.isEmpty()) {                                                               // src: vvaharness/pipeline/stages/s8_chain.py:152
            // "read nothing" and "found nothing" must not share a summary.
            boolean empty = metrics != null && metrics.totalFilesInScope == 0;                  // src: vvaharness/pipeline/stages/s8_chain.py:154
            return new FinalReport(findings = List.of(), chains = List.of(), dropped = dropped,
                summary = empty ? "0 files analysed - no conclusion can be drawn" : "No findings survived adversarial verification.",
                degraded = empty, enrichmentUnavailable = empty);                               // src: vvaharness/pipeline/stages/s8_chain.py:155
        }
        List<Integer> window;
        try {
            window = S8Window.selectWindow(findings, ctx, θ);                                   // src: vvaharness/pipeline/stages/s8_chain.py:174
        } catch (Exception e) {
            // Never fails the stage: fall back to the un-windowed call.
            window = range(findings.size());                                                    // src: vvaharness/pipeline/stages/s8_chain.py:180
        }
        if (window.isEmpty()) {
            // A model that saw zero findings must not author the report.
            return S8Outcomes.deterministicReport(ctx, findings, dropped, rawFindingsCount, metrics, "prompt_token_budget admits no findings into the enrichment window", θ); // src: vvaharness/pipeline/stages/s8_chain.py:183
        }
        List<Finding> sub = window.map(i -> findings[i]);
        List<String> labels = window.map(i -> "f" + i);                                         // src: vvaharness/pipeline/stages/s8_chain.py:189

        String raw; int invalid0;
        try {
            Tuple t = chainCallWithHalfWindowRetry(sub, labels, window, findings, ctx, θ);      // src: vvaharness/pipeline/stages/s8_chain.py:192
            raw = t.raw; window = t.window; labels = t.labels; invalid0 = t.invalid0;
        } catch (Exception e) {
            if (Harness.isHaltError(e)) throw e;                                                // src: vvaharness/pipeline/stages/s8_chain.py:195
            return S8Outcomes.deterministicReport(ctx, findings, dropped, rawFindingsCount, metrics, enrichmentFailureText(e), θ); // src: vvaharness/pipeline/stages/s8_chain.py:199
        }
        boolean windowed = window.size() < findings.size();                                    // src: vvaharness/pipeline/stages/s8_chain.py:203
        persistRaw(raw, "_s8_raw.txt");                                                         // src: vvaharness/pipeline/stages/s8_chain.py:206

        ChainReport data;
        try {
            data = S8Outcomes.parseChainReply(raw);                                             // src: vvaharness/pipeline/stages/s8_chain.py:210
        } catch (ValueError e) {
            invalid0 = Counters.get("s8_ranked_findings_entry_invalid");                        // src: vvaharness/pipeline/stages/s8_chain.py:213
            Tuple rep = jsonRepair(raw, e, ctx, θ);                                             // src: vvaharness/pipeline/stages/s8_chain.py:214
            if (rep.report == null) {
                return S8Outcomes.deterministicReport(ctx, findings, dropped, rawFindingsCount, metrics, "reply unparseable", θ); // src: vvaharness/pipeline/stages/s8_chain.py:225
            }
            data = rep.report;
            raw = rep.repairedRaw;                                                              // src: vvaharness/pipeline/stages/s8_chain.py:231
        }

        Map originalSeverity = findings.toIdentityMap(f -> f.severity);                         // src: vvaharness/pipeline/stages/s8_chain.py:234
        Pair hydrated;
        try {
            hydrated = S8Outcomes.hydrateReport(data, ctx, findings, dropped, rawFindingsCount, metrics, windowed ? Set.of(window) : null, θ); // src: vvaharness/pipeline/stages/s8_chain.py:236
        } catch (Exception e) {
            for (Finding f : findings) f.severity = originalSeverity.get(f);                    // src: vvaharness/pipeline/stages/s8_chain.py:241
            return S8Outcomes.deterministicReport(ctx, findings, dropped, rawFindingsCount, metrics, "hydration failed", θ); // src: vvaharness/pipeline/stages/s8_chain.py:244
        }
        FinalReport report = hydrated.report;
        Set covered = hydrated.covered;
        if (windowed) {
            // A windowed model saw part of the report, so its prose is not executive over all of it.
            report.summary = report.summary + "\n\n" + S8Outcomes.templatedSummary(report.findings); // src: vvaharness/pipeline/stages/s8_chain.py:251
        }
        if (covered.size() < window.size()) {                                                   // src: vvaharness/pipeline/stages/s8_chain.py:254
            // Sparse ranking: the reply omitted some shown findings; they ship unranked.
            boolean nothingDropped = data.rankedFindings.size() == covered.size() && Counters.get("s8_ranked_findings_entry_invalid") == invalid0; // src: vvaharness/pipeline/stages/s8_chain.py:261
            if (nothingDropped) Counters.bump("s8_sparse_ranking_recovered");                   // src: vvaharness/pipeline/stages/s8_chain.py:266
            else Errlog.log("s8", "chain", "chain reply ranked fewer findings than shown");     // src: vvaharness/pipeline/stages/s8_chain.py:270
        }
        return report;
    }

    @src("vvaharness/pipeline/stages/s8/session.py:70")
    Object chainBounds(Theta θ) {
        // The S8 knobs read downstream by S8Session / S8Window / S8Prompts / S8Outcomes (real read sites cited).
        ModelSpec model = new ModelSpec(θ["models.chain.id"], θ["models.chain.via"], θ["models.chain.provider"], θ["step8.effort"], θ["step8.max_tokens"]); // src: vvaharness/pipeline/stages/s8/session.py:87
        Bounds bounds = new Bounds(θ["step8.max_turns"], θ["step8.max_model_calls"], θ["step8.deadline"], null); // src: vvaharness/pipeline/stages/s8/session.py:84
        int timeout = θ["step8.timeout"];                                                       // src: vvaharness/pipeline/stages/s8/session.py:85
        Object replay = List.of(θ["step8.replay_timeout"], θ["step8.replay_max_tokens"]);      // src: vvaharness/pipeline/stages/s8/session.py:117
        // unclear: step8.resume_timeout is registered, but s8/session.py never resumes (a deadline goes straight to the transcript replay).
        Object resume = θ["step8.resume_timeout"];                                              // src: vvaharness/pipeline/stages/s8/session.py:173
        int budget = θ["step8.prompt_token_budget"];                                            // src: vvaharness/pipeline/stages/s8/window.py:78
        Object promptShape = List.of(θ["step8.hop_text"], θ["step8.prompt_fact_blocks"]);      // src: vvaharness/pipeline/stages/s8/prompts.py:101
        Object gates = List.of(θ["step8.severity_lift_gate"], θ["step8.chain_quality_checks"], θ["step8.chain_dedup"]); // src: vvaharness/pipeline/stages/s8/outcomes.py:708
        return List.of(model, bounds, timeout, replay, resume, budget, promptShape, gates);
    }
}
