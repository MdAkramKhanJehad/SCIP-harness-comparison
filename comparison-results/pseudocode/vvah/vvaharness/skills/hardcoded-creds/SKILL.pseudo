// file: vvaharness/skills/hardcoded-creds/SKILL.md
// S4 skill playbook "hardcoded-creds": literal credentials, keys, tokens and signing secrets committed to source.
// Settings/config files first, then source patterns; env-var references are never findings. No probe.sh.

@executedBy(MODEL) @role(skill) @stage("S4")
class HardcodedCredsSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        if (!repo.taskMatches(θ["p.skill_hardcoded-creds.trigger"])) return List.of();             // src: vvaharness/skills/hardcoded-creds/SKILL.md:3
        List<Candidate> cands = new List<Candidate>();
        // settings / config files first (highest yield)
        cands.addAll(scanSettings(repo, θ));
        cands.addAll(scanSource(repo, θ));
        // look list is non-exhaustive: reason beyond it
        if (θ["p.skill_hardcoded-creds.look_list_non_exhaustive"]) cands.addAll(repo.otherCredentialShapedLiterals()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:33
        List<Finding> out = new List<Finding>();
        for (Candidate c : cands) {
            if (!hardGate(c, θ)) continue;
            Finding f = c.asFinding();
            f.severity = severity(c, θ);
            out.add(f);
        }
        return out;
    }

    boolean hardGate(Candidate c, Theta θ) {
        // an ACTUAL committed value, not an env-var reference
        if (θ["p.skill_hardcoded-creds.gate_actual_committed_value"] && !c.isCommittedLiteral()) return false; // src: vvaharness/skills/hardcoded-creds/SKILL.md:28
        if (c.matchesAny(θ["p.skill_hardcoded-creds.env_references_not_findings"])) return false;   // src: vvaharness/skills/hardcoded-creds/SKILL.md:29
        if (θ["p.skill_hardcoded-creds.only_directly_usable_literals"] && !c.directlyUsable()) return false; // src: vvaharness/skills/hardcoded-creds/SKILL.md:31
        return true;
    }

    List<Candidate> scanSettings(Repo repo, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        String order = θ["p.skill_hardcoded-creds.settings_files_first"];                           // src: vvaharness/skills/hardcoded-creds/SKILL.md:35
        if (θ["p.skill_hardcoded-creds.look_django_settings"]) {                                    // src: vvaharness/skills/hardcoded-creds/SKILL.md:36
            for (Assignment a : repo.read("**/settings.py").assignments()) {
                // flag ALL literal values in security-sensitive keys, not just common names
                if (θ["p.skill_hardcoded-creds.flag_all_sensitive_key_literals"] ? a.keyIsSecuritySensitive() : a.keyIsCommonSecretName()) out.add(Candidate.at(a)); // src: vvaharness/skills/hardcoded-creds/SKILL.md:38
            }
        }
        if (θ["p.skill_hardcoded-creds.look_flask_config"]) out.addAll(repo.read("**/config.py", "app.config").sensitiveLiterals()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:39
        if (θ["p.skill_hardcoded-creds.look_committed_env_files"]) {                               // src: vvaharness/skills/hardcoded-creds/SKILL.md:41
            for (String env : repo.glob(".env*").filter(f -> !repo.gitignored(f))) {
                for (Assignment a : repo.read(env).assignments()) {
                    // even sample .env files with real-looking secrets are findings
                    if (!env.isSample() || (θ["p.skill_hardcoded-creds.sample_env_real_looking_is_finding"] && a.realLooking())) out.add(Candidate.at(a)); // src: vvaharness/skills/hardcoded-creds/SKILL.md:42
                }
            }
        }
        if (θ["p.skill_hardcoded-creds.look_spring_properties"]) out.addAll(repo.read("application.properties", "application.yml").sensitiveLiterals()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:43
        for (String cfg : repo.glob("config.yaml", "config.json")) out.addAll(repo.read(cfg).keysNamed(θ["p.skill_hardcoded-creds.look_config_yaml_json_keys"]).nonPlaceholder()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:45
        return out;
    }

    List<Candidate> scanSource(Repo repo, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        List<String> files = repo.sourceFiles();
        // test files are in scope: committed and just as exploitable
        if (!θ["p.skill_hardcoded-creds.test_files_in_scope"]) files = files.filter(f -> !f.isTest()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:55
        for (String f : files) {
            Page src = Tools.Read(f);
            if (θ["p.skill_hardcoded-creds.look_jwt_signing_literals"]) out.addAll(src.jwtEncodeWithLiteralSecret()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:49
            if (θ["p.skill_hardcoded-creds.look_api_key_literals"]) out.addAll(src.apiKeyLiterals()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:50
            if (θ["p.skill_hardcoded-creds.look_db_password_literals"]) out.addAll(src.dbConnectWithLiteralPassword()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:52
            if (θ["p.skill_hardcoded-creds.look_crypto_key_literals"]) out.addAll(src.cryptoKeyLiterals()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:53
            if (θ["p.skill_hardcoded-creds.look_seed_default_passwords"] && f.isSeedOrMigration()) out.addAll(src.defaultPasswords()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:54
            if (θ["p.skill_hardcoded-creds.look_passwords_in_comments"]) out.addAll(src.commentsWithPasswords()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:57
            if (θ["p.skill_hardcoded-creds.look_auth_comparison_literals"]) {                      // src: vvaharness/skills/hardcoded-creds/SKILL.md:58
                for (Comparison cmp : src.equalityComparisonsInAuthFunctions()) {
                    // every hardcoded credential in an auth comparison, even if the var is not named 'password'
                    if (θ["p.skill_hardcoded-creds.flag_every_auth_comparison_literal"] || cmp.varNamedPassword()) out.add(Candidate.at(cmp)); // src: vvaharness/skills/hardcoded-creds/SKILL.md:61
                }
            }
            if (θ["p.skill_hardcoded-creds.look_in_memory_user_stores"]) out.addAll(src.dictLiteralsWithUnhashedPassword()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:63
            if (θ["p.skill_hardcoded-creds.look_attribute_assignments"]) out.addAll(src.attributeAssignmentsToSensitiveNames()); // src: vvaharness/skills/hardcoded-creds/SKILL.md:66
        }
        return out;
    }

    Severity severity(Candidate c, Theta θ) {
        if (c.isSigningOrJwtOrCryptoKey()) return θ["p.skill_hardcoded-creds.sev_signing_keys_critical"]; // src: vvaharness/skills/hardcoded-creds/SKILL.md:71
        if (c.isDbPasswordOrCloudKey()) return θ["p.skill_hardcoded-creds.sev_db_cloud_keys_high"]; // src: vvaharness/skills/hardcoded-creds/SKILL.md:72
        if (c.isServiceTokenOrWebhookSecret()) return θ["p.skill_hardcoded-creds.sev_service_tokens_high"]; // src: vvaharness/skills/hardcoded-creds/SKILL.md:73
        if (c.isSeedDefaultPassword()) return θ["p.skill_hardcoded-creds.sev_default_passwords_medium"]; // src: vvaharness/skills/hardcoded-creds/SKILL.md:74
        if (c.isPlaceholder()) {
            // LOW (note only) unless used in production paths
            if (θ["p.skill_hardcoded-creds.sev_placeholder_unless_used_in_prod"] && c.usedInProductionPath()) return c.severityByKind(); // src: vvaharness/skills/hardcoded-creds/SKILL.md:76
            return θ["p.skill_hardcoded-creds.sev_placeholders_low"];                              // src: vvaharness/skills/hardcoded-creds/SKILL.md:75
        }
        return c.severityByKind();
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_hardcoded-creds.trigger"]);                                               // src: vvaharness/skills/hardcoded-creds/SKILL.md:3
        p.persona(θ["p.skill_hardcoded-creds.persona"]);                                            // src: vvaharness/skills/hardcoded-creds/SKILL.md:24
        p.context(θ["p.skill_hardcoded-creds.attacker_model"]);                                     // src: vvaharness/skills/hardcoded-creds/SKILL.md:25
        return p;
    }

    Prompt hardGateSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_hardcoded-creds.gate_actual_committed_value"]);                           // src: vvaharness/skills/hardcoded-creds/SKILL.md:28
        p.exemption(θ["p.skill_hardcoded-creds.env_references_not_findings"]);                      // src: vvaharness/skills/hardcoded-creds/SKILL.md:29
        p.must(θ["p.skill_hardcoded-creds.only_directly_usable_literals"]);                         // src: vvaharness/skills/hardcoded-creds/SKILL.md:31
        return p;
    }

    Prompt whereToLookSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_hardcoded-creds.look_list_non_exhaustive"]);                              // src: vvaharness/skills/hardcoded-creds/SKILL.md:33
        p.step(1, θ["p.skill_hardcoded-creds.settings_files_first"]);                              // src: vvaharness/skills/hardcoded-creds/SKILL.md:35
        p.checklist(θ["p.skill_hardcoded-creds.look_django_settings"]);                             // src: vvaharness/skills/hardcoded-creds/SKILL.md:36
        p.must(θ["p.skill_hardcoded-creds.flag_all_sensitive_key_literals"]);                       // src: vvaharness/skills/hardcoded-creds/SKILL.md:38
        p.checklist(θ["p.skill_hardcoded-creds.look_flask_config"]);                                // src: vvaharness/skills/hardcoded-creds/SKILL.md:39
        p.checklist(θ["p.skill_hardcoded-creds.look_committed_env_files"]);                         // src: vvaharness/skills/hardcoded-creds/SKILL.md:41
        p.rule(θ["p.skill_hardcoded-creds.sample_env_real_looking_is_finding"]);                    // src: vvaharness/skills/hardcoded-creds/SKILL.md:42
        p.checklist(θ["p.skill_hardcoded-creds.look_spring_properties"]);                           // src: vvaharness/skills/hardcoded-creds/SKILL.md:43
        p.checklist(θ["p.skill_hardcoded-creds.look_config_yaml_json_keys"]);                       // src: vvaharness/skills/hardcoded-creds/SKILL.md:45
        p.checklist(θ["p.skill_hardcoded-creds.look_jwt_signing_literals"]);                        // src: vvaharness/skills/hardcoded-creds/SKILL.md:49
        p.checklist(θ["p.skill_hardcoded-creds.look_api_key_literals"]);                            // src: vvaharness/skills/hardcoded-creds/SKILL.md:50
        p.checklist(θ["p.skill_hardcoded-creds.look_db_password_literals"]);                        // src: vvaharness/skills/hardcoded-creds/SKILL.md:52
        p.checklist(θ["p.skill_hardcoded-creds.look_crypto_key_literals"]);                         // src: vvaharness/skills/hardcoded-creds/SKILL.md:53
        p.checklist(θ["p.skill_hardcoded-creds.look_seed_default_passwords"]);                      // src: vvaharness/skills/hardcoded-creds/SKILL.md:54
        p.rule(θ["p.skill_hardcoded-creds.test_files_in_scope"]);                                   // src: vvaharness/skills/hardcoded-creds/SKILL.md:55
        p.checklist(θ["p.skill_hardcoded-creds.look_passwords_in_comments"]);                       // src: vvaharness/skills/hardcoded-creds/SKILL.md:57
        p.checklist(θ["p.skill_hardcoded-creds.look_auth_comparison_literals"]);                    // src: vvaharness/skills/hardcoded-creds/SKILL.md:58
        p.must(θ["p.skill_hardcoded-creds.flag_every_auth_comparison_literal"]);                    // src: vvaharness/skills/hardcoded-creds/SKILL.md:61
        p.checklist(θ["p.skill_hardcoded-creds.look_in_memory_user_stores"]);                       // src: vvaharness/skills/hardcoded-creds/SKILL.md:63
        p.checklist(θ["p.skill_hardcoded-creds.look_attribute_assignments"]);                       // src: vvaharness/skills/hardcoded-creds/SKILL.md:66
        return p;
    }

    Prompt severitySection(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.skill_hardcoded-creds.sev_signing_keys_critical"]);                           // src: vvaharness/skills/hardcoded-creds/SKILL.md:71
        p.choose(θ["p.skill_hardcoded-creds.sev_db_cloud_keys_high"]);                              // src: vvaharness/skills/hardcoded-creds/SKILL.md:72
        p.choose(θ["p.skill_hardcoded-creds.sev_service_tokens_high"]);                             // src: vvaharness/skills/hardcoded-creds/SKILL.md:73
        p.choose(θ["p.skill_hardcoded-creds.sev_default_passwords_medium"]);                        // src: vvaharness/skills/hardcoded-creds/SKILL.md:74
        p.choose(θ["p.skill_hardcoded-creds.sev_placeholders_low"]);                                // src: vvaharness/skills/hardcoded-creds/SKILL.md:75
        p.exemption(θ["p.skill_hardcoded-creds.sev_placeholder_unless_used_in_prod"]);              // src: vvaharness/skills/hardcoded-creds/SKILL.md:76
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(hardGateSection(θ));
        p.include(whereToLookSection(θ));
        p.include(severitySection(θ));
        return p;
    }
}
