# vvaharness/backends/harness/registry.py

Maps a `via` selector to a fresh harness instance. This is the provider routing at backend level: `cli` and `sdk` both use the Claude Agent SDK harness, `deepagents` uses the LangGraph deepagents harness. Backends are imported lazily so selecting one does not import another's SDK.

Source: `vvaharness/backends/harness/registry.py` (lines 1-69)
Executor: code
Called from: stage session code and remediation or validation launchers (`get_harness(via)`)

// src: vvaharness/backends/harness/registry.py:52-56
_BACKENDS = { "cli": _make_claude, "sdk": _make_claude, "deepagents": _make_deepagents }

// src: vvaharness/backends/harness/registry.py:59-66
fn get_harness(via = null):executor=code {
  key = via || "sdk"   // no selector means the SDK route
  factory = _BACKENDS[key]
  require factory exists => throw ValueError("unknown backend $key; valid values are: \"cli\", \"sdk\", \"deepagents\"")
  return factory()   // a new instance on every call
}

// src: vvaharness/backends/harness/registry.py:28-33
fn _make_claude():executor=code { return claude.client.ClaudeHarness() }

// src: vvaharness/backends/harness/registry.py:36-49
fn _make_deepagents():executor=code {
  try return deepagents.client.DeepAgentHarness()
  catch ImportError => throw RuntimeError("the deepagents backend needs the 'deepagents' package, which requires Python 3.11+ (running <major>.<minor>). Use via: cli or sdk, or upgrade Python.")
}
