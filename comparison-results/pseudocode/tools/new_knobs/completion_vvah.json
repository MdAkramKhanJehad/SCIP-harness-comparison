 {
  "id": "code.plugins.semgrep.tools.callers_of_flagged_sinks",
  "target": "vvaharness/plugins/semgrep/tools.pseudo",
  "category": "detection_method",
  "group": "semgrep",
  "stage": "S0",
  "origin": "code_constant",
  "kind": "implicit",
  "type": "str",
  "default": "\nMATCH (f:SemgrepFinding)-[trace:TRACE_TOUCHES]->(sink)<-[:CALLS]-(caller)\nWHERE trace.role = 'sink' AND f.filePath = $file\nRETURN f.ruleId AS ruleId, sink.name AS sink, caller.name AS caller,\n       caller.filePath AS callerPath\nORDER BY sink, caller\nLIMIT 25\n",
  "domain": null,
  "domain_basis": null,
  "source": "vvaharness/plugins/semgrep/tools.py:44",
  "does": "Read-only query joining Semgrep sink traces to structural callers, with an embedded row cap.",
  "affects": [
   "recall",
   "cost"
  ]
 },
 {
  "id": "code.plugins.semgrep.tools.findings_for_file",
  "target": "vvaharness/plugins/semgrep/tools.pseudo",
  "category": "detection_method",
  "group": "semgrep",
  "stage": "S0",
  "origin": "code_constant",
  "kind": "implicit",
  "type": "str",
  "default": "\nMATCH (subject)-[:FLAGGED_BY]->(f:SemgrepFinding)-[:DETECTED_BY]->(r:SemgrepRule)\nWHERE f.filePath = $file\nRETURN f.ruleId AS ruleId, f.filePath AS path, f.semgrepStartLine AS line,\n       f.severity AS severity, subject.name AS symbol,\n       r.cweIds AS cweIds, r.vulnerabilityClasses AS classes\nORDER BY line, ruleId\nLIMIT 25\n",
  "domain": null,
  "domain_basis": null,
  "source": "vvaharness/plugins/semgrep/tools.py:25",
  "does": "Read-only per-file Semgrep finding query, including its ordering and embedded row cap.",
  "affects": [
   "recall",
   "cost"
  ]
 },
 {
  "id": "code.plugins.semgrep.tools.scan_coverage",
