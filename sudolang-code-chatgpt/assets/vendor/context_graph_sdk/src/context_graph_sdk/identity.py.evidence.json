  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Stable project, snapshot, node, and edge identity helpers.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport re\nfrom dataclasses import dataclass\n\nfrom .errors import ModelValidationError\n\n_ID_PATTERN = re.compile(r\"^[A-Za-z0-9][A-Za-z0-9._-]*$\")\n\n\ndef _validate_named_id(value: str, kind: str, maximum: int = 128) -> str:\n    if not value or len(value) > maximum:\n        raise ModelValidationError(f\"{kind} must contain 1..{maximum} characters\")\n    if not _ID_PATTERN.fullmatch(value):\n        raise ModelValidationError(f\"{kind} contains unsupported characters: {value!r}\")\n    return value\n\n\n@dataclass(frozen=True, order=True)\nclass ProjectId:\n    value: str\n\n    def __post_init__(self) -> None:\n        _validate_named_id(self.value, \"project_id\")\n\n    def __str__(self) -> str:\n        return self.value\n\n\n@dataclass(frozen=True, order=True)\nclass SnapshotId:\n    value: str\n\n    def __post_init__(self) -> None:\n        _validate_named_id(self.value, \"snapshot_id\")\n\n    def __str__(self) -> str:\n        return self.value\n\n\ndef validate_local_id(local_id: str) -> str:\n    if not local_id or len(local_id) > 512:\n        raise ModelValidationError(\"local_id must contain 1..512 characters\")\n    return local_id\n\n\ndef _sha256(namespace: str, *components: str) -> str:\n    digest = hashlib.sha256()\n    digest.update(namespace.encode())\n    for component in components:\n        encoded = component.encode()\n        digest.update(len(encoded).to_bytes(8, \"big\"))\n        digest.update(encoded)\n    return digest.hexdigest()\n\n\ndef make_local_id(kind: str, *components: str) -> str:\n    _validate_named_id(kind, \"identity kind\", 64)\n    if not components:\n        raise ModelValidationError(\"local identity requires string components\")\n    return _sha256(f\"local:{kind}\", *components)\n\n\ndef make_global_id(project_id: ProjectId, local_id: str) -> str:\n    return _sha256(\"global-node\", project_id.value, validate_local_id(local_id))\n\n\ndef make_edge_id(\n    project_id: ProjectId,\n    source_id: str,\n    relationship_type: str,\n    target_id: str,\n    discriminator: str = \"\",\n) -> str:\n    if not all(value for value in (source_id, relationship_type, target_id)):\n        raise ModelValidationError(\"edge identity requires non-empty endpoint and type values\")\n    return _sha256(\n        \"local-edge\", project_id.value, source_id, relationship_type, target_id, discriminator\n    )\n",
