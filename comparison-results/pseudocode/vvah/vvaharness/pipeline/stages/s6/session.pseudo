// file: vvaharness/pipeline/stages/s6/session.py
// One agentic verification session per batch: tools and middleware (graph tools, tool budget,
// evidence gate, model-call budget), dispatch under a deadline with resume/replay, and a JSON repair.

@executedBy(CODE) @role(step) @stage("S6")
class S6Session {

    // _REPLAY_EFFORT = "low"; _PRIMARY_MIN_CHARS = 40; _PRIMARY_MIN_TOKENS = 10 (code constants)

    boolean hasVerdictMaterial(String raw) {
        return List.of("TRUE_POSITIVE", "FALSE_POSITIVE", "INCONCLUSIVE").any(t -> raw.contains(t)); // src: vvaharness/pipeline/stages/s6/session.py:84
    }

    boolean graphEnabled(Theta θ) {
        if (!θ["step6_verify.graph_tools"]) return false;                                       // src: vvaharness/pipeline/stages/s6/session.py:96
        // Gate on the route too: naming tools the session cannot call invites fabricated tool output.
        return Deepagents.routeCarriesTools(θ, θ["models.verify.via"]);                         // src: vvaharness/pipeline/stages/s6/session.py:100
    }

    ModelCallBudget callBudget(Theta θ, int members) {
        int limit = θ["step6_verify.max_model_calls"];                                          // src: vvaharness/pipeline/stages/s6/session.py:113
        if (limit <= 0) return null;                                                            // src: vvaharness/pipeline/stages/s6/session.py:114
        // On the last call every tool but the outcome tool is withdrawn.
        return new ModelCallBudget(limit + max(0, members - 1), Set.of("VerificationOutcomes", "VerificationOutcome")); // src: vvaharness/pipeline/stages/s6/session.py:116
    }

    int perItem(int base, int members) {
        return base * max(1, members);                                                          // src: vvaharness/pipeline/stages/s6/session.py:125
    }

    Triple toolSetup(ContextPackage ctx, Theta θ, int members) {
        List middleware = new List();
        ToolBuilder builder = null;
        List<String> names = List.of();
        if (graphEnabled(θ)) {                                                                  // src: vvaharness/pipeline/stages/s6/session.py:135
            builder = CodegraphTools.buildGraphToolBuilder(ctx);
            names = CodegraphTools.graphToolNames();
            int limit = θ["step6_verify.graph_tool_budget"];                                    // src: vvaharness/pipeline/stages/s6/session.py:138
            if (limit > 0) middleware.add(new ToolCallBudget(names, perItem(limit, members))); // src: vvaharness/pipeline/stages/s6/session.py:140
            if (θ["step6_verify.require_graph"]) {                                              // src: vvaharness/pipeline/stages/s6/session.py:143
                Set required = Codegraph.GRAPH_TOOL_NAMES;
                if (Build.graphIsDegenerate(ctx, θ)) {                                      // src: vvaharness/pipeline/stages/s6/session.py:146
                    Counters.bump("evidence_gate_stood_down_degenerate_graph");
                    required = Set.of();
                }
                middleware.add(new EvidenceGate(perItem(θ["step6_verify.evidence_gate_refusals"], members), required)); // src: vvaharness/pipeline/stages/s6/session.py:156
            }
        }
        middleware.add(callBudget(θ, members));                                                 // src: vvaharness/pipeline/stages/s6/session.py:160
        return Triple.of(builder, names, middleware.nonNull());
    }

    String loadCode(List<String> files, Path repoRoot, Theta θ) {
        if (!θ["step6_verify.inline_source"]) return null;                                      // src: vvaharness/pipeline/stages/s6/session.py:166
        return S4Deepdive.loadFilesFull(files, repoRoot, "s6", θ);                                 // src: vvaharness/pipeline/stages/s6/session.py:170
    }

    /** The structured-output model, only on the routes that honour one (RESPONSE_MODEL_VIAS); else None. */
    @src("vvaharness/pipeline/stages/s6/session.py:176")
    Object responseModel(Theta θ) {
        return LlmModels.RESPONSE_MODEL_VIAS.contains(θ["models.verify.via"]) ? VerificationOutcomes : null; // src: vvaharness/pipeline/stages/s6/session.py:178
    }

    String dispatch(List<Item> items, ContextPackage ctx, Theta θ, List<Tool> tools, String tag, boolean dropThinking, Attempt attempt) {
        attempt.replayed = false;
        Transcript transcript = new Transcript();
        int deadline = θ["step6_verify.batch_deadline"];                                        // src: vvaharness/pipeline/stages/s6/session.py:204
        try {
            return Replay.runWithDeadline(() -> agenticLeg(items, ctx, θ, tools, tag, transcript, dropThinking), deadline); // src: vvaharness/pipeline/stages/s6/session.py:207
        } catch (CallTimeoutError e) {
            // Deadline hit: resume the live session for the verdicts, else replay the transcript tool-free.
            return Replay.resumeOrReplay(sessionId, () -> { attempt.replayed = true; return replayLeg(items, ctx, θ, tag, transcript); },
                                         θ["step6_verify.resume_timeout"]);                     // src: vvaharness/pipeline/stages/s6/session.py:221
        } finally {
            Replay.releasePinnedSession(sessionId);
        }
    }

    String replayLeg(List<Item> items, ContextPackage ctx, Theta θ, String tag, Transcript transcript) {
        Counters.bump("s6_deadline_replay");                                                    // src: vvaharness/pipeline/stages/s6/session.py:229
        String code = loadCode(items.files(), ctx.repoRoot, θ);
        ModelSpec m = new ModelSpec(θ["models.verify.id"], θ["models.verify.via"], θ["models.verify.provider"], Effort.LOW, θ["step6_verify.replay_max_tokens"]); // src: vvaharness/pipeline/stages/s6/session.py:241
        int timeout = θ["step6_verify.replay_timeout"];                                         // src: vvaharness/pipeline/stages/s6/session.py:242
        return Runtime.llm(m, null, Replay.replayPrompt(transcript, S6Prompts.buildVerifyPrompt(items, ctx, code, θ)), S6Outcomes.schema(θ)); // src: vvaharness/pipeline/stages/s6/session.py:233
    }

    String agenticLeg(List<Item> items, ContextPackage ctx, Theta θ, List<Tool> tools, String tag, Transcript transcript, boolean dropThinking) {
        String code = loadCode(items.files(), ctx.repoRoot, θ);                                 // src: vvaharness/pipeline/stages/s6/session.py:257
        Triple setup = toolSetup(ctx, θ, items.size());                                         // src: vvaharness/pipeline/stages/s6/session.py:258
        boolean graph = graphEnabled(θ) && ctx.graphHandle != null && !Build.graphIsDegenerate(ctx, θ); // src: vvaharness/pipeline/stages/s6/session.py:268
        Prompt system = S6Prompts.buildSystemPrompt(graph, θ["step6_verify.trait_stamps"], θ["step6_verify.reframe_enabled"], θ); // src: vvaharness/pipeline/stages/s6/session.py:267
        Effort effort = dropThinking ? null : θ["step6_verify.effort"];                         // src: vvaharness/pipeline/stages/s6/session.py:284
        ModelSpec model = new ModelSpec(θ["models.verify.id"], θ["models.verify.via"], θ["models.verify.provider"], effort, θ["step6_verify.max_tokens"]); // src: vvaharness/pipeline/stages/s6/session.py:286
        Bounds bounds = new Bounds(θ["step6_verify.max_turns"], θ["step6_verify.max_model_calls"],   // src: vvaharness/pipeline/stages/s6/session.py:281
                                   Replay.deadlineBound(S6Batching.ceilingSecs(θ), θ["step6_verify.batch_deadline"]), // src: vvaharness/pipeline/stages/s6/session.py:288
                                   θ["step6_verify.max_budget_usd"]);                           // src: vvaharness/pipeline/stages/s6/session.py:280
        // Floors: primary reply shorter than 40 chars / 10 tokens is a quality failure.
        return Runtime.agent(new AgentSpec(model, tools + setup.builderTools, List.of(), system,
                                           S6Prompts.buildVerifyPrompt(items, ctx, code, θ), bounds, S6Outcomes.schema(θ), false)); // src: vvaharness/pipeline/stages/s6/session.py:261
    }

    Map<String, VerificationOutcome> verifyBatch(List<Item> items, ContextPackage ctx, Theta θ, List<Tool> tools, Supplier<Boolean> abandoned, boolean resendRefusal) {
        Effort effort = θ["step6_verify.effort"];                                               // src: vvaharness/pipeline/stages/s6/session.py:305
        Attempt attempt = new Attempt();
        // A thinking effort can leave the tool unforced; retry once unforced (unless abandoned).
        String raw = ResponseQuality.dispatchOrRetryUnforced(dropThinking -> dispatch(items, ctx, θ, tools, tag, dropThinking, attempt),
                                                             mayRetry = effort != null && !abandoned.get(), resendRefusal); // src: vvaharness/pipeline/stages/s6/session.py:312
        Map outcomes = S6Outcomes.splitBatchReply(raw, items.ids());                            // src: vvaharness/pipeline/stages/s6/session.py:320
        if (!outcomes.isEmpty()) return stamped(outcomes, attempt.replayed);                    // src: vvaharness/pipeline/stages/s6/session.py:321
        if (abandoned.get()) { Counters.bump("s6_outcome_repair_skipped_abandoned"); return Map.of(); } // src: vvaharness/pipeline/stages/s6/session.py:324
        if (!hasVerdictMaterial(raw)) {                                                         // src: vvaharness/pipeline/stages/s6/session.py:327
            // The repair says "restate, do NOT reconsider": a verdictless primary would fabricate one.
            Counters.bump("s6_outcome_repair_skipped_no_verdict");
            return Map.of();
        }
        Counters.bump("s6_outcome_repaired_attempt");                                           // src: vvaharness/pipeline/stages/s6/session.py:336
        ModelSpec m = new ModelSpec(θ["models.verify.id"], θ["models.verify.via"], θ["models.verify.provider"], null, θ["step6_verify.max_tokens"]); // src: vvaharness/pipeline/stages/s6/session.py:349
        String repaired = Runtime.llm(m, null, S6Prompts.repairPrompt(raw, items.ids(), θ), S6Outcomes.schema(θ)); // src: vvaharness/pipeline/stages/s6/session.py:341
        outcomes = S6Outcomes.splitBatchReply(repaired, items.ids());                           // src: vvaharness/pipeline/stages/s6/session.py:352
        if (!outcomes.isEmpty()) Counters.bump("s6_outcome_repaired_ok");
        return stamped(outcomes, attempt.replayed);
    }

    Map<String, VerificationOutcome> stamped(Map<String, VerificationOutcome> outcomes, boolean replayed) {
        // Replay flag set from the attempt, never from the model's reply.
        for (VerificationOutcome o : outcomes.values()) o.replayed = replayed;                  // src: vvaharness/pipeline/stages/s6/session.py:363
        return outcomes;
    }
}
