fn _extract_text(message):executor=code { /* string content, or the joined "text" blocks */ }
fn _last_ai_text(messages):executor=code { /* last non-empty (stripped) assistant text scanning backward, else null */ }
fn _last_ai_message(messages):executor=code { /* the final assistant turn, else null */ }

// src: vvaharness/backends/harness/deepagents/translate.py:81-84
fn reply_truncated(messages):executor=code {
  m = _last_ai_message(messages)
  return m != null && finish_truncated(reply_finish(m.response_metadata or {}))   // see backends/llm/models.sudo
}

// src: vvaharness/backends/harness/deepagents/translate.py:87-96
fn reply_refusal(messages):executor=code {
  // Every assistant turn is checked in order; the first refused one wins (a refused turn need not be last, since a cut tool_use's tool may still run)
  for each message in messages where message is an AI message {
    [refused, category] = ai_message_refused(message)
    if (refused) return [true, category]
  }
  return [false, null]
  // Subagent refusals are not visible here; the parent's next turn decides
}

// src: vvaharness/backends/harness/deepagents/translate.py:99-120
fn translate_final_state(state, oneshot=false):executor=code {
  messages = state.messages or []
  usage = aggregate_usage_metadata(messages)   // state.usage is never populated on this route
  if (usage) TOKENS.add(usage, turns=usage.turns)
  truncated = reply_truncated(messages)
  if (state.structured_response is a validated model) {
    return OneShotResult(result_text=structured as JSON, structured, usage, truncated)   // a valid structured answer wins over an earlier refused turn
  }
  [refused, category] = reply_refusal(messages)
  return OneShotResult(result_text=_last_ai_text(messages), usage, truncated, refused, refusal_category=category)
  // preserved: the oneshot argument is accepted but not read
}

// src: vvaharness/backends/harness/deepagents/translate.py:123-174
fn translate_stream_events(event, seen_tool_call_ids, ns_to_agent={}):executor=code {
  [namespace, payload] = event (namespace () for a bare payload)
  for each message in every node update's "messages" of payload {
    match (message) {
      case AI message => {
        if (message.name) ns_to_agent[namespace] = message.name
        agent = message.name or ns_to_agent[namespace]
        if (text is not blank) emit(HarnessAssistantText(text, agent, namespace))
        for each call in message.tool_calls {
          if (call.id is empty || call.id in seen_tool_call_ids) continue   // each tool call reported once
          seen_tool_call_ids.add(call.id)
          emit(HarnessToolUse(tool_id=call.id, name, input=args, agent, namespace))
        }
      }
      case tool message => emit(HarnessToolResult(content, is_error = status == "error", agent=ns_to_agent[namespace], namespace))
    }
  }
}

// src: vvaharness/backends/harness/deepagents/translate.py:177-212
fn make_terminal_result(state, session_id?, stream_usage?):executor=code {
  messages = state.messages or []
  final_text = _last_ai_text(messages)
  if (state.structured_response is a validated model) final_text = structured as JSON; refused = false
  else { structured = null; [refused, category] = reply_refusal(messages) }
  // Usage fallback ladder: state.usage (never populated on this route), then stream_usage (the only one that includes persona subagent turns), then aggregation over final messages
  usage = state.usage if a dict else (stream_usage or, when absent, aggregate_usage_metadata(messages))
  if (usage) TOKENS.add(usage, turns=usage.turns)
  return HarnessResult(subtype="success", session_id, result_text=final_text, structured, usage, total_cost_usd=null, state, truncated=reply_truncated(messages), refused, refusal_category=category)
}
