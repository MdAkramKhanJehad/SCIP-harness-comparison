// src: vvaharness/validation/constants/diff.py:21-24
// A changed file path matching this counts as a trust boundary (DiffImpactMap.trust_boundary_touched).
TRUST_BOUNDARY_RE = /(?i)(auth|session|login|logout|password|crypto|cipher|tls|ssl|token|secret|credential|permission|role|config|settings)\b/

// src: vvaharness/validation/constants/diff.py:26-43
DiffMarkers {
  HUNK_HEADER_RE = /^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@/   // group 1 (HUNK_NEW_START_GROUP) is the new-side start line
  GIT_HEADER_PREFIX = "diff --git "
  GIT_HEADER_MIN_TOKENS = 4   // fewer tokens means a truncated header
  OLD_FILE_MARKER = "--- "; NEW_FILE_MARKER = "+++ "; MARKER_PATH_START = 4
  DEV_NULL_PATH = "/dev/null"
  GIT_PATH_PREFIXES = ["a/", "b/"]
  ADDED_LINE = "+"; REMOVED_LINE = "-"; NO_NEWLINE_NOTE = "\\"
}
