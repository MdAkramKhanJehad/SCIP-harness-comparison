// file: vvaharness/scope/walk.py
// The deterministic repo walk (every file S3/S4 may see), its built-in exclusion rules,
// agent-path normalisation against the inventory, and the secret/insecure-value regexes used by config dedup.

@executedBy(CODE) @role(types)
record EmptyScopeError(String message) { }   // no file survived the exclusions; exit code 2. src: vvaharness/scope/walk.py:29

@executedBy(CODE) @role(io) @stage("S1")
class Walk {

    // _DEFAULT_EXCLUDE_DIRS: VCS, deps, build output, IDE dirs, test/fixture/mock dirs and the harness's own output dirs.
    // spec/specs deliberately NOT excluded; IaC/CI dirs kept (only .terraform excluded).
    Set<String> defaultExcludeDirs(Theta θ) {
        return θ["code.scope.walk.default_exclude_dirs"];                                       // src: vvaharness/scope/walk.py:34
    }

    // _DEFAULT_EXCLUDE_EXTS: images, archives, binaries, compiled objects, lockfiles, .min.js, .map, fonts, media.
    Set<String> defaultExcludeExts(Theta θ) {
        return θ["code.scope.walk.default_exclude_exts"];                                       // src: vvaharness/scope/walk.py:44
    }

    // _DEFAULT_EXCLUDE_GLOBS: co-located test files per language plus repo metadata (.gitignore, LICENSE, CODEOWNERS ...).
    // Dockerfile/Jenkinsfile/Makefile/*.tf and Helm YAML are kept.
    List<String> defaultExcludeGlobs(Theta θ) {
        return θ["code.scope.walk.default_exclude_globs"];                                      // src: vvaharness/scope/walk.py:51
    }

    /** True when a build marker sits in the dir that directly contains target/, i.e. target/ is real build output. */
    boolean hasTargetBuildMarker(Path root, List<String> parentParts, Theta θ) {
        Path parent = parentParts.isEmpty() ? root : root.joinpath(parentParts);                // src: vvaharness/scope/walk.py:76
        return θ["code.scope.walk.target_build_markers"].anyMatch(m -> parent.resolve(m).isFile()); // src: vvaharness/scope/walk.py:77
    }

    /** Built-in defaults plus config step1.* appends; dirs lower-cased. */
    Triple<Set<String>, Set<String>, List<String>> exclusionSets(Config cfg, Theta θ) {
        Set<String> exclDirs = union(defaultExcludeDirs(θ), θ["step1.exclude_dirs"]).map(d -> d.lower()); // src: vvaharness/scope/walk.py:82
        Set<String> exclExts = union(defaultExcludeExts(θ), θ["step1.exclude_exts"]);          // src: vvaharness/scope/walk.py:84
        List<String> exclGlobs = concat(defaultExcludeGlobs(θ), θ["step1.exclude_globs"]);     // src: vvaharness/scope/walk.py:85
        return new Triple(exclDirs, exclExts, exclGlobs);                                      // src: vvaharness/scope/walk.py:87
    }

    /** First glob excluding the repo-relative posix path, else null. Double-star-slash globs also match the basename. */
    String globHit(String rel, List<String> globs) {
        String name = rel.rsplitLast("/");                                                     // src: vvaharness/scope/walk.py:90
        for (String g : globs) {                                                               // src: vvaharness/scope/walk.py:91
            if (fnmatchCase(rel, g)) return g;                                                 // src: vvaharness/scope/walk.py:92
            if (g.startsWith("**/") && fnmatchCase(name, g.substring(3))) return g;            // src: vvaharness/scope/walk.py:94
        }
        return null;                                                                           // src: vvaharness/scope/walk.py:96
    }

    String foldSlashes(String p) {
        p = p.replace("\\", "/");                                                              // src: vvaharness/scope/walk.py:101
        while (p.startsWith("./")) p = p.substring(2);                                         // src: vvaharness/scope/walk.py:102
        return p;
    }

    /** Normalise an agent-emitted path to the repo-relative posix form _walk_repo produces. */
    String normRel(String repoRoot, String p) {
        if (p == null || p.isEmpty()) return p;                                                // src: vvaharness/scope/walk.py:109
        p = foldSlashes(p);                                                                    // src: vvaharness/scope/walk.py:111
        String relRoot = posix(repoRoot).rstrip("/") + "/";                                    // src: vvaharness/scope/walk.py:112
        String absRoot = posix(resolve(repoRoot)).rstrip("/") + "/";                           // src: vvaharness/scope/walk.py:113
        for (String r : List.of(absRoot, relRoot)) {                                           // src: vvaharness/scope/walk.py:115
            if (p.lower().startsWith(r.lower())) return p.substring(r.length());               // src: vvaharness/scope/walk.py:116
        }
        return p.lstrip("/");   // DeepAgents vfs is repo-rooted: strip the virtual root        // src: vvaharness/scope/walk.py:119
    }

    /** p in its inventory spelling if any deterministic reading is in the inventory, else normRel(p). */
    String resolveInventoryPath(String repoRoot, String p, Collection<String> inventory) {
        if (p == null || p.isEmpty()) return p;                                                // src: vvaharness/scope/walk.py:124
        String folded = foldSlashes(p);                                                        // src: vvaharness/scope/walk.py:126
        if (inventory == null || inventory.isEmpty()) return folded.lstrip("/");               // src: vvaharness/scope/walk.py:127
        // Raw spelling first, then without leading slash, then without the repo-dir-name prefix; first hit wins
        for (String cand : List.of(folded, folded.lstrip("/"), folded.removePrefix(basename(repoRoot) + "/"))) { // src: vvaharness/scope/walk.py:133
            if (inventory.contains(cand)) return cand;                                         // src: vvaharness/scope/walk.py:134
        }
        return normRel(repoRoot, folded);                                                      // src: vvaharness/scope/walk.py:136
    }

    /** (resolved path or null, ambiguous?) — a path matching under 2+ top dirs is never guessed. */
    Pair<String, Boolean> resolveScopePath(String path, String repoRoot, Set<String> keep, List<String> topDirs) {
        String rel = resolveInventoryPath(repoRoot, path, keep);                               // src: vvaharness/scope/walk.py:142
        if (keep.contains(rel)) return new Pair(rel, false);                                   // src: vvaharness/scope/walk.py:143
        List<String> matches = topDirs.map(td -> td + "/" + rel).filter(x -> keep.contains(x)); // src: vvaharness/scope/walk.py:145
        if (matches.size() == 1) return new Pair(matches.get(0), false);                       // src: vvaharness/scope/walk.py:146
        return new Pair(null, matches.size() > 1);                                             // src: vvaharness/scope/walk.py:148
    }

    /** In-scope inventory the real walk would yield with extra step1 exclusions (guard for proposed auto-exclude overlays). */
    List<String> scopeAfter(String repoRoot, Config cfg, List<String> dirs, List<String> exts, List<String> globs, Integer maxFileKb, Theta θ) {
        Triple<Set<String>, Set<String>, List<String>> base = exclusionSets(cfg, θ);           // src: vvaharness/scope/walk.py:155
        Config shadow = new Config();                                                          // src: vvaharness/scope/walk.py:156
        shadow.step1.excludeDirs = sorted(union(base.first, dirs.map(d -> d.lower())));        // src: vvaharness/scope/walk.py:157
        shadow.step1.excludeExts = sorted(union(base.second, exts));                           // src: vvaharness/scope/walk.py:158
        shadow.step1.excludeGlobs = concat(base.third, globs);                                 // src: vvaharness/scope/walk.py:159
        shadow.step1.maxFileKb = (maxFileKb != null) ? maxFileKb : θ["step1.max_file_kb"];     // src: vvaharness/scope/walk.py:160
        shadow.step1.followSymlinks = false;                                                   // src: vvaharness/scope/walk.py:162
        return walkRepo(repoRoot, shadow, θ).first;                                            // src: vvaharness/scope/walk.py:164
    }

    /** (bucket, key) of the first dir/ext/glob rule excluding path r, else null. Inner function _rule_hit. */
    Pair<String, String> ruleHit(Path root, String r, Set<String> exclDirs, Set<String> exclExts, List<String> exclGlobs, Theta θ) {
        List<String> parts = r.split("/");                                                     // src: vvaharness/scope/walk.py:189
        Integer hitIdx = null;
        for (int i = 0; i < parts.size() - 1; i++) {                                           // src: vvaharness/scope/walk.py:191
            String part = parts.get(i).lower();
            // "target" is excluded only when a build marker sits in its parent dir
            if (exclDirs.contains(part) && (part != "target" || hasTargetBuildMarker(root, parts.subList(0, i), θ))) { hitIdx = i; break; } // src: vvaharness/scope/walk.py:192
        }
        if (hitIdx != null) return new Pair("dirs", join("/", parts.subList(0, hitIdx + 1)));  // src: vvaharness/scope/walk.py:197
        String name = parts.last().lower();                                                    // src: vvaharness/scope/walk.py:199
        String hitExt = exclExts.firstMatch(e -> suffix(name) == e || name.endsWith(e));        // src: vvaharness/scope/walk.py:200
        if (hitExt != null) return new Pair("exts", hitExt);                                   // src: vvaharness/scope/walk.py:202
        String hitGlob = globHit(r, exclGlobs);                                                // src: vvaharness/scope/walk.py:204
        if (hitGlob != null) return new Pair("globs", hitGlob);                                // src: vvaharness/scope/walk.py:205
        return null;                                                                           // src: vvaharness/scope/walk.py:207
    }

    /** Returns (sorted in-scope files, excluded-summary). */
    Pair<List<String>, Map> walkRepo(String repoRoot, Config cfg, Theta θ) {
        Path root = Path.of(repoRoot);                                                         // src: vvaharness/scope/walk.py:168
        Path rootResolved = root.resolve();                                                    // src: vvaharness/scope/walk.py:169
        Triple<Set<String>, Set<String>, List<String>> ex = exclusionSets(cfg, θ);             // src: vvaharness/scope/walk.py:170
        int maxKb = θ["step1.max_file_kb"];                                                    // src: vvaharness/scope/walk.py:171
        boolean followSymlinks = θ["step1.follow_symlinks"];                                   // src: vvaharness/scope/walk.py:173
        if (followSymlinks) Console.write("NOTE: off-root symlinks still dropped; only in-tree followed"); // src: vvaharness/scope/walk.py:174

        List<String> out = new List();                                                         // src: vvaharness/scope/walk.py:179
        Map<String, Map<String, Integer>> buckets = Map.of("dirs", new Map(), "exts", new Map(), "globs", new Map()); // src: vvaharness/scope/walk.py:180
        List<Pair<String, Long>> skippedSize = new List();                                     // src: vvaharness/scope/walk.py:183
        Map<String, Integer> skippedSymlinks = new Map();                                      // src: vvaharness/scope/walk.py:184
        Map<String, Integer> skippedSymlinkTargets = new Map();                                // src: vvaharness/scope/walk.py:185

        for (Path p : root.rglob("*")) {                                                       // src: vvaharness/scope/walk.py:209
            if (!p.isFile()) continue;                                                         // src: vvaharness/scope/walk.py:210
            String rel = posix(p.relativeTo(root));                                            // src: vvaharness/scope/walk.py:212
            String tgtRel = null;
            // rglob follows symlinks; containment check is unconditional (no config re-opens it)
            if (p.isSymlink() && θ["code.scope.walk.drop_offroot_symlinks"]) {                 // src: vvaharness/scope/walk.py:215
                boolean escapes;
                try {
                    Path tgt = p.resolve(false);                                               // src: vvaharness/scope/walk.py:217
                    escapes = !tgt.isRelativeTo(rootResolved);                                 // src: vvaharness/scope/walk.py:218
                    if (!escapes) tgtRel = posix(tgt.relativeTo(rootResolved));                // src: vvaharness/scope/walk.py:220
                } catch (OSError e) {
                    escapes = true;                                                            // src: vvaharness/scope/walk.py:222
                    ErrLog.log("s1", rel, e, "symlink_resolve_failed");                        // src: vvaharness/scope/walk.py:223
                }
                if (escapes) { skippedSymlinks.inc(rel); continue; }                           // src: vvaharness/scope/walk.py:225
            }
            Pair<String, String> hit = ruleHit(root, rel, ex.first, ex.second, ex.third, θ);   // src: vvaharness/scope/walk.py:228
            if (hit != null) { buckets.get(hit.first).inc(hit.second); continue; }             // src: vvaharness/scope/walk.py:229
            // An in-root link is judged by its target too, or a.txt -> key.pem smuggles it into scope
            if (θ["code.scope.walk.symlink_target_rule_check"] && tgtRel != null && ruleHit(root, tgtRel, ex.first, ex.second, ex.third, θ) != null) { // src: vvaharness/scope/walk.py:234
                skippedSymlinkTargets.inc(rel); continue;                                      // src: vvaharness/scope/walk.py:235
            }
            try {
                long sz = p.stat().size;                                                       // src: vvaharness/scope/walk.py:238
                if (sz > maxKb * 1024) { skippedSize.add(new Pair(rel, sz)); continue; }       // src: vvaharness/scope/walk.py:239
            } catch (OSError e) {
                ErrLog.log("s1", rel, e, "stat_failed");                                       // src: vvaharness/scope/walk.py:243
                continue;                                                                      // src: vvaharness/scope/walk.py:245
            }
            out.add(rel);                                                                      // src: vvaharness/scope/walk.py:246
        }
        Map excluded = Map.of("dirs", buckets.get("dirs"), "exts", buckets.get("exts"), "globs", buckets.get("globs"), // src: vvaharness/scope/walk.py:248
            "oversize", skippedSize.size(), "oversize_files", skippedSize.sortedBy(kv -> -kv.second), // src: vvaharness/scope/walk.py:252
            "symlinks", skippedSymlinks, "symlink_targets", skippedSymlinkTargets);            // src: vvaharness/scope/walk.py:254
        return new Pair(sorted(out), excluded);                                                // src: vvaharness/scope/walk.py:257
    }

    /** _DEDUP_DEFAULTS: built-in config-dedup settings; step1.config_dedup.* overrides each key. */
    Map dedupDefaults(Theta θ) {
        return Map.of(
            "enabled", θ["step1.config_dedup.enabled"],                                        // src: vvaharness/scope/walk.py:263
            "exts", θ["code.scope.walk.dedup_default_exts"],                                   // src: vvaharness/scope/walk.py:264
            "min_cluster_size", θ["step1.config_dedup.min_cluster_size"],                      // src: vvaharness/scope/walk.py:266
            "keep_per_top_dir", θ["step1.config_dedup.keep_per_top_dir"],                      // src: vvaharness/scope/walk.py:267
            "promote_on_secret_hit", θ["step1.config_dedup.promote_on_secret_hit"],            // src: vvaharness/scope/walk.py:268
            "promote_on_insecure_value", θ["step1.config_dedup.promote_on_insecure_value"],    // src: vvaharness/scope/walk.py:269
            "max_file_kb", θ["code.scope.walk.dedup_max_file_kb"]);                            // src: vvaharness/scope/walk.py:270
    }

    /** _SECRET_RX: credential key=value with 8+ char non-templated value, PEM private-key header, AKIA keys, Slack xox tokens, GitHub gh*_ tokens, JWTs. */
    Regex secretRx(Theta θ) {
        return Regex.compile(θ["code.scope.walk.secret_rx"]);                                  // src: vvaharness/scope/walk.py:274
    }

    /** _INSECURE_RX: verify-ssl/tls/cert-validation off, insecure=true, InsecureSkipVerify, auth none/disabled, debug=true, allow_anonymous=true. */
    Regex insecureRx(Theta θ) {
        return Regex.compile(θ["code.scope.walk.insecure_rx"]);                                // src: vvaharness/scope/walk.py:289
    }
}
