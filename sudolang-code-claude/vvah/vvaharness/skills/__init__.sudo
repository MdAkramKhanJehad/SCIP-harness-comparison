# vvaharness/skills/__init__.py

The packaged detection skills (one folder per lens, each with a `SKILL.md` and sometimes a `probe.sh`) and the code that copies them into the scanned repository so a model session can load them. The copy is made once per repository per scan and removed when the scan returns, fails or is interrupted.

Source: `vvaharness/skills/__init__.py` (lines 1-99)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (`@with_injected_skills` on `scan_repo`); `vvaharness/pipeline/stages/s2/session.py` and `vvaharness/pipeline/stages/s4/session.py` (`inject_skills` passed as `skill_root`)

// src: vvaharness/skills/__init__.py:24-31
PACKAGED_SKILLS = folder of this module
INJECTED_SUBDIR = ".vvaharness/skills"   // repository-relative location of the temporary copy
State {
  _INJECTED: Map<resolved repo path, Path | null>      // memo of the first injection result per repository
  _TEMP_COPIES: Map<resolved repo path, (destination, parent_existed)>
  _INJECT_LOCK   // one process-wide lock guarding both maps
}

// src: vvaharness/skills/__init__.py:34-39
fn skill_names():executor=code {
  return sorted names of subfolders of PACKAGED_SKILLS that contain a file "SKILL.md"
}

// src: vvaharness/skills/__init__.py:67-73
fn inject_skills(repo_root):executor=code {
  key = resolved repo_root
  with _INJECT_LOCK {
    if (key not in _INJECTED) { _INJECTED[key] = _inject(repo_root) }
    return _INJECTED[key]   // Path of the copy, or null when copying failed; a failure is memoized too
  }
  // preserved: a null result is cached, so a failed injection is not retried for the rest of the scan
}

// src: vvaharness/skills/__init__.py:42-64
fn _inject(repo_root):executor=code {
  parent = repo_root + "/.vvaharness"
  require parent is not a symlink => return null   // refuses a committed symlink planted by the scanned repository
  parent_existed = parent exists
  try { create parent if missing; create repo_root + "/.vvaharness/skills" (must not already exist) }
  catch OSError => return null   // includes the case where ".vvaharness/skills" already exists
  _TEMP_COPIES[resolved repo_root] = (dst, parent_existed)   // recorded before the copy, so cleanup runs even if the copy fails
  try copy the whole PACKAGED_SKILLS tree into dst (merging into existing folders)
  catch OSError => return null
  remove dst/__init__.py and dst/__pycache__ from the copy
  return dst
}

// src: vvaharness/skills/__init__.py:76-95
fn with_injected_skills(function):executor=code {
  // decorator: wraps scan_repo(repo, ...)
  scoped(repo, ...args) {
    return function(repo, ...args)
    constraint OnEveryExit {
      key = resolved repo
      with _INJECT_LOCK {
        drop _INJECTED[key]
        if (_TEMP_COPIES has key) {
          (destination, parent_existed) = pop _TEMP_COPIES[key]
          delete destination tree   // not best effort: an error here propagates
          if (!parent_existed) { try remove the now-empty ".vvaharness" folder; catch OSError => ignore }
        }
      }
    }
  }
}
// external: how a backend turns `skill_root` into skills a model can load is in `vvaharness/backends/harness/deepagents/options/filesystem.py` (`_skill_sources`) and `vvaharness/backends/llm/deepagents.py`; outside this batch.
