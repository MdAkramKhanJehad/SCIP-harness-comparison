# vvaharness/validation/hints/loader.py

Loads the per-CWE bypass hints from the operator file `./inputs/validator_hints.yaml` (relative to the current working directory), once per process. No packaged fallback.

Source: `vvaharness/validation/hints/loader.py` (lines 1-96)
Executor: code
Called from: `vvaharness/validation/session/launch_prompt.sudo` _bypass_hint_lines

// src: vvaharness/validation/hints/loader.py:88-96
fn hints_for(category):executor=code {
  reg = _registry()   // loaded once and cached for the process
  direct = reg.hints[trimmed category]
  if (direct != null) return direct
  return reg.hints[trimmed text before the first ":" in category] or, when absent, []   // "CWE-89: SQL Injection" style
}

// src: vvaharness/validation/hints/loader.py:44-74
fn CweHints.load():executor=code {
  path = "<cwd>/inputs/validator_hints.yaml"
  if (path does not exist) raw = {}   // optional operator input
  else {
    raw = yaml.safe_load(path)
    if (unreadable or not valid YAML) { print "validate: ignoring malformed hints file <path>; proceeding without per-CWE bypass hints"; raw = {} }
    else if (raw is not a mapping) raw = {}   // silently
  }
  keep entries whose key is a string and value is a list; key trimmed, values converted to strings
}
