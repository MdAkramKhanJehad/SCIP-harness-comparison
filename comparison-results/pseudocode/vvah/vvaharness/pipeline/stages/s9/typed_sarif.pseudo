// file: vvaharness/pipeline/stages/s9/typed_sarif.py
// SARIF 2.1.0 emitter: one result per surviving finding, the duplicate-result guard,
// rules/taxa tables, run properties and scan-health notifications.

@executedBy(CODE) @role(io) @stage("S9")
class TypedSarif {

    String sarifLevel(String sev) {
        return Map.of("CRITICAL", "error", "HIGH", "error", "MEDIUM", "warning").getOrDefault(sev, "note"); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:93
    }

    String securitySeverity(String sev, double cvssScore) {
        if (cvssScore >= 0) return format("%.1f", cvssScore);                                   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:98
        return Map.of("CRITICAL", "9.0", "HIGH", "7.0", "MEDIUM", "4.0", "LOW", "0.1").getOrDefault(sev, "0.0"); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:100
    }

    Tuple dupResultKey(Finding f, String eff, String msg) {
        // channel and origin are legs: without them a CRITICAL folds into its posture or detector twin.
        return Tuple.of(f.file, f.lineStart, eff != null ? eff : f.vulnClass, msg, f.channel, f.origin); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:124
    }

    Map buildSarif(FinalReport report, String applicationId, AppInfo appInfo, Theta θ) {
        boolean dupGuard = θ["step9.duplicate_result_guard"];                                   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:174
        boolean postureChannel = θ["output.posture_channel"];                                   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:175
        List labels = report.findings.map(rf -> classLabel(rf.finding));                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:183
        List scores = report.findings.map(rf -> Cvss.score(rf.finding.cvssVector));             // src: vvaharness/pipeline/stages/s9/typed_sarif.py:184
        List msgs = resultMessages(report, scores);
        Map winnerOf = new Map(); Map aliasIds = new Map(); Set seenDupSites = new Set();
        if (dupGuard) {                                                                          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:193
            // Resolve twins BEFORE the loop: the strongest severity wins, not the first seen.
            for (int i : range(report.findings.size())) {                                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:197
                Integer held = winnerOf.get(dupKey(i));
                if (held == null || severityRank(i) < severityRank(held)) winnerOf.put(dupKey(i), i); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:199
            }
            for (int i : range(report.findings.size())) {                                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:201
                if (winnerOf.get(dupKey(i)) != i && report.findings[i].caseId != null) aliasIds.append(winnerOf.get(dupKey(i)), report.findings[i].caseId); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:203
                seenDupSites.add(Tuple.of(f.file, f.lineStart, labels[i].eff));                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:206
            }
        }
        List results = new List();
        for (RankedFinding rf : report.findings) {                                              // src: vvaharness/pipeline/stages/s9/typed_sarif.py:208
            if (dupGuard && winnerOf.get(dupKey(rf)) != rf.index) {                              // src: vvaharness/pipeline/stages/s9/typed_sarif.py:211
                Counters.bump("s9_sarif_dup_result_suppressed");                                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:213
                continue;
            }
            Map props = severityAndCweProps(rf);                                                // src: vvaharness/pipeline/stages/s9/typed_sarif.py:227
            List related = new List();
            for (DupLocation d : rf.finding.duplicates) {                                       // src: vvaharness/pipeline/stages/s9/typed_sarif.py:279
                if (dupGuard) {
                    Tuple gkey = Tuple.of(d.file, d.lineStart, eff);
                    if (seenDupSites.contains(gkey)) { Counters.bump("s9_sarif_dup_site_deduped"); continue; } // src: vvaharness/pipeline/stages/s9/typed_sarif.py:283
                    seenDupSites.add(gkey);
                }
                related.add(relatedLocation(d));                                                // src: vvaharness/pipeline/stages/s9/typed_sarif.py:306
            }
            if (postureChannel) props.put("channel", rf.finding.channel);                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:316
            if (rf.finding.origin != null) props.put("origin", rf.finding.origin);               // src: vvaharness/pipeline/stages/s9/typed_sarif.py:318
            results.add(result(rf, props, related));                                            // src: vvaharness/pipeline/stages/s9/typed_sarif.py:327
        }
        Map health = S9Health.scanHealth(report);                                               // src: vvaharness/pipeline/stages/s9/typed_sarif.py:385
        List notifications = healthNotifications(health);                                       // src: vvaharness/pipeline/stages/s9/typed_sarif.py:386
        return sarifDocument(rulesFor(results), taxaFor(results), runProps(report, applicationId, appInfo, health), results, notifications); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:437
    }

    List healthNotifications(Map health) {
        List n = new List();
        for (Entry e : health.get("errors_by_stage")) n.add(warning(e.key + ": " + e.value + " non-fatal error(s) logged")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:387
        if (health.get("chunks_failed") > 0) n.add(warning("deep-dive unit(s) failed or timed out; their findings are absent")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:394
        if (health.get("degraded")) n.add(warning(health.get("degraded_reason")));              // src: vvaharness/pipeline/stages/s9/typed_sarif.py:400
        if (health.get("threats_truncated") > 0) n.add(warning("threat(s) exceeded the step2.max_threats cap")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:408
        return n;
    }

    Path writeSarif(FinalReport report, Path sarifPath, String applicationId, AppInfo appInfo, Theta θ) {
        Map doc = buildSarif(report, applicationId, appInfo, θ);                                // src: vvaharness/pipeline/stages/s9/typed_sarif.py:449
        Files.write(sarifPath, Json.dump(Redact.tree(doc)));                                    // src: vvaharness/pipeline/stages/s9/typed_sarif.py:451
        return sarifPath;
    }
}
