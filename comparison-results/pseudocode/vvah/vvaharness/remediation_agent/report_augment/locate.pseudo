// file: vvaharness/remediation_agent/report_augment/locate.py
// Locate the scan report pair (sarif plus sibling md) to augment and copy it into security-remediation once.

@executedBy(CODE) @role(io) @stage("S10")
class Locate {

    // Newest scan SARIF pattern; the sibling .md shares the stem.
    String SCAN_REPORT_GLOB = θ["code.remediation_agent.report_augment.locate.scan_report_glob"];    // src: vvaharness/remediation_agent/report_augment/locate.py:31

    // Returns (scan sarif, sibling md) to augment, or null.
    Tuple locateScanReport(Path repo, Path reportMd, Theta θ) {
        // reportMd is non-tamperable; the glob fallback must NOT be newest-wins, it bails on multiples.
        if (reportMd != null) {                                                                      // src: vvaharness/remediation_agent/report_augment/locate.py:34
            Path md = Path.of(reportMd);
            if (!md.exists()) { Logging.warning("explicit scan report not found - skipping augmentation"); return null; } // src: vvaharness/remediation_agent/report_augment/locate.py:37
            Path sarif = md.withSuffix(".sarif");                                                    // src: vvaharness/remediation_agent/report_augment/locate.py:39
            if (!sarif.exists()) { Logging.warning("sibling SARIF not found - skipping augmentation"); return null; } // src: vvaharness/remediation_agent/report_augment/locate.py:42
            return Tuple.of(sarif, md);                                                              // src: vvaharness/remediation_agent/report_augment/locate.py:45
        }
        List<Path> sarifs = repo.join(ReportParser.SCAN_DIR_NAME).glob(θ["code.remediation_agent.report_augment.locate.scan_report_glob"]).sorted(); // src: vvaharness/remediation_agent/report_augment/locate.py:48
        if (sarifs.isEmpty()) return null;                                                           // src: vvaharness/remediation_agent/report_augment/locate.py:50
        if (sarifs.size() > 1) {                                                                     // refuses to guess which is canonical // src: vvaharness/remediation_agent/report_augment/locate.py:53
            Logging.warning("multiple scan SARIF reports and no explicit report - refusing to guess");
            return null;                                                                             // src: vvaharness/remediation_agent/report_augment/locate.py:56
        }
        Path sarif = sarifs.get(0);
        Path md = sarif.withSuffix(".md");                                                           // src: vvaharness/remediation_agent/report_augment/locate.py:58
        return md.exists() ? Tuple.of(sarif, md) : null;                                             // src: vvaharness/remediation_agent/report_augment/locate.py:61
    }

    // Copy the scan SARIF and MD into security-remediation once (never overwrites an existing copy); return the copies.
    Tuple ensureCombined(Path repo, Path sarifSrc, Path mdSrc) {
        Path dstDir = Artifacts.artifactDir(repo, ReportParser.REMEDIATION_DIR_NAME);                // raises UnsafeArtifactDir on a symlinked or non-directory dir // src: vvaharness/remediation_agent/report_augment/locate.py:64
        dstDir.mkdir(true);                                                                          // exist_ok // src: vvaharness/remediation_agent/report_augment/locate.py:66
        Path sarifDst = dstDir.join(sarifSrc.name);                                                  // src: vvaharness/remediation_agent/report_augment/locate.py:68
        Path mdDst = dstDir.join(mdSrc.name);                                                        // src: vvaharness/remediation_agent/report_augment/locate.py:70
        if (!sarifDst.exists()) Files.copy2(sarifSrc, sarifDst);                                     // src: vvaharness/remediation_agent/report_augment/locate.py:72
        if (!mdDst.exists()) Files.copy2(mdSrc, mdDst);                                              // src: vvaharness/remediation_agent/report_augment/locate.py:74
        return Tuple.of(sarifDst, mdDst);                                                            // src: vvaharness/remediation_agent/report_augment/locate.py:76
    }
}
