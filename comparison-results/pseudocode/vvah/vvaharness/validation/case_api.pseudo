// file: vvaharness/validation/case_api.py
// S11 entry point for one in-memory case (SDK validate): stage a workspace, run the gate pipeline, score.
// Never writes to the target repo; the temp workspace is always removed.

@executedBy(CODE) @role(stage) @stage("S11")
class CaseApi {

    String ENGINE = "vvaharness.sdk.validate";                                                       // src: vvaharness/validation/case_api.py:47

    FindingCase caseFor(Finding finding, Remediation remediation) {
        RemediationTarget target = new RemediationTarget(finding, 1);                                // src: vvaharness/validation/case_api.py:60
        return Report.buildReport(target, remediation);                                              // src: vvaharness/validation/case_api.py:61
    }

    String refusal(Finding finding, Remediation remediation, Path repo) {
        if (!repo.isDir()) return "repo is not a directory: " + repo;                                // src: vvaharness/validation/case_api.py:67
        if (finding.file == null) return "the finding carries no file, so no workspace can be staged for it"; // src: vvaharness/validation/case_api.py:68
        if (remediation.diff == null) return "the remediation carries no diff, so there is nothing to apply and judge"; // src: vvaharness/validation/case_api.py:69
        return "";                                                                                   // src: vvaharness/validation/case_api.py:72
    }

    boolean alreadyRunning() {
        try {
            Asyncio.getRunningLoop();                                                                // src: vvaharness/validation/case_api.py:78
        } catch (RuntimeError e) {
            return false;                                                                            // src: vvaharness/validation/case_api.py:80
        }
        return true;
    }

    Provenance provenance(Instant started, Object spendBefore) {
        Spend s = Tokens.reportedBetween(spendBefore, TokenCounter.spend());                               // src: vvaharness/validation/case_api.py:86
        return new Provenance(ENGINE, started, Instant.now(), s.usd, s.turns);                       // src: vvaharness/validation/case_api.py:87
    }

    Verdict judge(FindingCase c, Path repo, Path workspace, Config config, ScoringPolicy policy) {
        Instant started = Instant.now();                                                             // src: vvaharness/validation/case_api.py:94
        Object spendBefore = TokenCounter.spend();                                                         // src: vvaharness/validation/case_api.py:95
        String sessionId = Uuid.hex();                                                               // src: vvaharness/validation/case_api.py:96
        Workspace.stageWorkspace(repo, workspace, c.attempts.last().remediation.diff);               // src: vvaharness/validation/case_api.py:97
        FixValidationPlan plan = new FixValidationPlan(c.caseId, sessionId, ManifestBuilder.buildManifest(c, sessionId), workspace, workspace, provenance(started, spendBefore), policy); // src: vvaharness/validation/case_api.py:98
        Outcome outcome = Asyncio.run(Pipeline.executePlan(plan, config, false, new RunMetadata(1))); // post_results always false here  // src: vvaharness/validation/case_api.py:107
        return CaseWriteback.buildVerdict(c, workspace, provenance(started, spendBefore), policy, outcome.sessionFailed); // src: vvaharness/validation/case_api.py:110
    }

    Verdict validateCase(Finding finding, Remediation remediation, Path repo, Config config, ScoringPolicy policy) {
        String why = refusal(finding, remediation, repo);                                            // src: vvaharness/validation/case_api.py:120
        if (!why.isEmpty()) throw new ValidationCaseError(why);                                      // src: vvaharness/validation/case_api.py:121
        if (alreadyRunning()) throw new ValidationBusyError("validate_case cannot be called from a running event loop"); // src: vvaharness/validation/case_api.py:123
        FindingCase c = caseFor(finding, remediation);                                               // src: vvaharness/validation/case_api.py:128
        ScoringPolicy resolvedPolicy = policy != null ? policy : ConstantsScoring.FIX_POLICY;       // default policy: fix-validation scoring policy  // src: vvaharness/validation/case_api.py:129
        Config resolvedConfig = config != null ? config : SettingsConfig.loadConfig(repo, false, null); // src: vvaharness/validation/case_api.py:130
        Path workspaceRoot = TempDir.mkdtemp("vvah-validate-");                                      // src: vvaharness/validation/case_api.py:131
        try {
            return judge(c, repo, workspaceRoot.resolve(c.caseId), resolvedConfig, resolvedPolicy);  // src: vvaharness/validation/case_api.py:133
        } finally {
            Fs.rmtree(workspaceRoot, true);                                                          // src: vvaharness/validation/case_api.py:136
        }
    }
}

@executedBy(CODE) @role(types)
record ValidationCaseError(String message) { }

@executedBy(CODE) @role(types)
record ValidationBusyError(String message) { }
