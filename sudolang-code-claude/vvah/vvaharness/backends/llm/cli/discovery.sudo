# vvaharness/backends/llm/cli/discovery.py

Finds the `claude` binary (resolved once at import), probes which flags and permission modes the installed build accepts (memoised for the process), maps a requested permission mode onto an accepted one, and formats `claude` failures for error messages.

Source: `vvaharness/backends/llm/cli/discovery.py` (lines 1-269)
Executor: code
Called from: `cli/oneshot.sudo` `prompt`, `cli/session.sudo` `agentic` and `_confinement_argv`, `cli/env.sudo` `_effort_argv`, `cli_mcp.sudo` (binary path)

// src: vvaharness/backends/llm/cli/discovery.py:36-49
fn _which_abs(...names):executor=code {
  for each name in names {
    hit = shutil.which(name)
    if (hit && hit is an absolute path) return hit
  }
  return null
  // A relative hit comes from Windows's implicit current-directory search (CWE-427: a planted claude.cmd in the scanned repository) and is rejected
}

// src: vvaharness/backends/llm/cli/discovery.py:52-86
fn _find_claude_cmd():executor=code {
  override = environment variable VVAHARNESS_CLAUDE_BINARY
  if (override) {
    if (override is a file) return [override]
    warn CLI_BINARY_OVERRIDE_MISSING   // then falls through to normal discovery
  }
  if (os is Windows) {
    set environment NoDefaultCurrentDirectoryInExePath = "1" if not already set   // CreateProcess drops the current directory from its search for this process and children
    cmd_path = _which_abs("claude", "claude.cmd", "claude.CMD")
    if (cmd_path) {
      pkg = parent(cmd_path)/node_modules/@anthropic-ai/claude-code
      if (pkg/bin/claude.exe exists) return [that native binary]   // 2.1.x and later
      if (pkg/cli.js exists) return [_which_abs("node") || "node", pkg/cli.js]   // 2.0.x and earlier
      return [cmd_path]   // last resort: the .cmd shim by full path
    }
    warn "'claude' not found on PATH; using bare name"
    return ["claude"]
  }
  resolved = shutil.which("claude")   // Unix: pinned to the absolute path PATH resolves to
  if (resolved) return [resolved]
  warn "'claude' not found on PATH; using bare name"
  return ["claude"]
}

// src: vvaharness/backends/llm/cli/discovery.py:89-97
State {
  _CLAUDE_CMD = _find_claude_cmd()   // resolved once at import time
  _PERMISSION_FALLBACKS = ("dontAsk", "manual", "default", "acceptEdits")   // most restrictive first; "bypassPermissions" deliberately absent
  _caps_cache = null
  _PROBE_SENTINELS = ("--vvah-capability-probe-aaa", "--vvah-capability-probe-bbb")
}

// src: vvaharness/backends/llm/cli/discovery.py:100-107
fn _cli_output(...args, timeout=20):executor=code {
  try r = run [..._CLAUDE_CMD, ...args] with stdin closed, capturing output, timeout seconds
  catch any error => return ""
  return r.stdout + r.stderr
}

// src: vvaharness/backends/llm/cli/discovery.py:110-117
fn _resume_capable():executor=code {
  m = first "X.Y.Z" version in _cli_output("--version")   // both streams, so a banner line does not hide the version
  if (!m) return false
  return (X, Y, Z) >= (2, 1, 286)   // the build that fixed --resume after a kill
}

// src: vvaharness/backends/llm/cli/discovery.py:120-133
fn _flag_accepted(flag, help_text):executor=code {
  if (flag appears in help_text) return true   // --help is trusted only as positive evidence
  if (!help_text) return false
  out = _cli_output(flag, ..._PROBE_SENTINELS, "-p", "x", "--output-format", "json", timeout=30)   // _parse_probe: argument parsing always fails on the sentinels
  return "unknown option '$flag'" not in out && out contains either sentinel
}

// src: vvaharness/backends/llm/cli/discovery.py:136-170
fn _cli_capabilities():executor=code {
  if (_caps_cache != null) return _caps_cache   // probed once per process
  help_text = _cli_output("--help")
  modes = quoted values in the "(choices: ...)" list after --permission-mode in help_text, else empty set
  probed = help_text is non-empty
  _caps_cache = {
    effort: _flag_accepted("--effort", help_text),
    max_turns: _flag_accepted("--max-turns", help_text),
    max_budget: _flag_accepted("--max-budget-usd", help_text),
    tools: _flag_accepted("--tools", help_text),   // --allowedTools alone left 28 tools including Bash/Edit/Write on 2.1.270
    disallowed_tools: _flag_accepted("--disallowedTools", help_text),
    permission_prompts: _flag_accepted("--permission-prompts", help_text),
    strict_mcp_config: _flag_accepted("--strict-mcp-config", help_text),
    setting_sources: _flag_accepted("--setting-sources", help_text),
    disable_slash_commands: _flag_accepted("--disable-slash-commands", help_text),
    restricted: _flag_accepted("--restricted", help_text),
    json_schema: !probed || _flag_accepted("--json-schema", help_text),   // optimistic when --help is unreadable
    permission_modes: modes,
    probed,
    resume: _resume_capable()   // a version floor, not a flag
  }
  return _caps_cache
}

// src: vvaharness/backends/llm/cli/discovery.py:173-195
fn _safe_permission_mode(requested):executor=code {
  modes = _cli_capabilities().permission_modes
  if (modes is empty) return requested   // help unreadable: do not second-guess
  if (requested in modes) return requested
  for each m in _PERMISSION_FALLBACKS {
    if (m in modes) { warn CLI_PERMISSION_MODE_UNAVAILABLE; return m }
  }
  fallback = first of sorted(modes) that is not "bypassPermissions"
  require fallback != null => throw RuntimeError("... refusing to run a scan session under bypassPermissions. Install a supported CLI build.")
  warn CLI_NO_PERMISSION_MODE
  return fallback
}

// src: vvaharness/backends/llm/cli/discovery.py:198-216
fn _tail(text, n=1200):executor=code { return "" if empty, else stripped text, or "...\n" + its last n characters when longer }
fn _short_cmd(cmd):executor=code { return argv joined by spaces, each argument longer than 80 characters shown as its first 60 characters + "...<N chars>" }

// src: vvaharness/backends/llm/cli/discovery.py:219-248
fn _extract_envelope_error(stdout):executor=code {
  if (!stdout) return null
  env = JSON parsed from the first "{" or "[" in stdout, else return null
  if (env is a list) env = last event that is type "result", or has is_error, or subtype in ["error", "error_during_execution"]
  if (env is not a dict) return null
  if (!(env.is_error || env.subtype in ["error", "error_during_execution"])) return null
  msg = env.result || env.error || env.message || "unknown error"
  return if (env.api_error_status) "$status $msg" else msg
}

// src: vvaharness/backends/llm/cli/discovery.py:251-269
fn _format_cli_error(prefix, cmd, result):executor=code {
  env_err = _extract_envelope_error(result.stdout)
  if (env_err) return "$prefix: $env_err (rc=$returncode)"
  // redact() before _tail(), never after: a credential straddling the cut loses its anchor
  return lines: "$prefix (rc=...)", "cmd: ${_short_cmd(cmd)}", then redacted stderr tail and stdout tail when present, else "no stdout/stderr captured"
}
