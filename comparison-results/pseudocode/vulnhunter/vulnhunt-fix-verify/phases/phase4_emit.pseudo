// file: vulnhunt-fix-verify/phases/phase4_emit.md
// Fix-verify phase 4: merge phase0_state.json and per-VULN dispositions, add INVALID_INPUT stubs for
// missing IDs, order by the FIXED argument, validate against verify_disposition.schema.json, write.

@executedBy(MODEL) @role(stage) @stage("FV4")
class Phase4Emit {

    String run(Bound b, Theta θ) {
        if (!θ["p.phase4_emit.run_in_own_context"]) return Runtime.subagent(new Prompt(), b);   // src: vulnhunt-fix-verify/phases/phase4_emit.md:3
        Phase0State s = step41ReadState(b);                                                      // src: vulnhunt-fix-verify/phases/phase4_emit.md:14
        List<FindingDisposition> ds = step42ReadDispositions(s, b, θ);                                  // src: vulnhunt-fix-verify/phases/phase4_emit.md:28
        step43AddInvalidInput(s, ds, θ);                                                         // src: vulnhunt-fix-verify/phases/phase4_emit.md:37
        ds = step44Order(ds, b, θ);                                                              // src: vulnhunt-fix-verify/phases/phase4_emit.md:79
        Document doc = step45Build(s, ds, θ);                                                    // src: vulnhunt-fix-verify/phases/phase4_emit.md:87
        step46Validate(doc, θ);                                                                  // src: vulnhunt-fix-verify/phases/phase4_emit.md:117
        Tools.write(b.OUT + "/verify_disposition.json", doc);                                    // src: vulnhunt-fix-verify/phases/phase4_emit.md:147
        step48RunLog(ds, b, θ);                                                                  // src: vulnhunt-fix-verify/phases/phase4_emit.md:149
        if (θ["p.phase4_emit.no_further_output"]) return b.OUT + "/verify_disposition.json";     // src: vulnhunt-fix-verify/phases/phase4_emit.md:169
        return b.OUT + "/verify_disposition.json";
    }

    @executedBy(MODEL)
    Phase0State step41ReadState(Bound b) {
        return Json.parse(Tools.read(b.OUT + "/phase0_state.json"));                             // src: vulnhunt-fix-verify/phases/phase4_emit.md:16
    }

    @executedBy(MODEL)
    List<FindingDisposition> step42ReadDispositions(Phase0State s, Bound b, Theta θ) {
        List<FindingDisposition> ds = new List();
        if (s.fixedIdsInReport.isEmpty() && θ["p.phase4_emit.skip_disposition_read_when_empty"]) return ds; // src: vulnhunt-fix-verify/phases/phase4_emit.md:32
        for (String id : s.fixedIdsInReport) ds.add(Json.parse(Tools.read(b.OUT + "/disposition_" + id + ".json"))); // src: vulnhunt-fix-verify/phases/phase4_emit.md:30
        return ds;
    }

    @executedBy(MODEL)
    void step43AddInvalidInput(Phase0State s, List<FindingDisposition> ds, Theta θ) {
        if (!θ["p.phase4_emit.invalid_input_stub_per_missing_id"]) return;                       // src: vulnhunt-fix-verify/phases/phase4_emit.md:39
        for (String id : s.fixedIdsMissing) {
            FindingDisposition d = new FindingDisposition(id, FixVerdict.INVALID_INPUT, null, null, null, null, null);   // remaining fields are set below
            if (θ["p.phase4_emit.invalid_input_rationale_text"]) d.rationale = id + " does not appear in the supplied report. Verify the report directory and the fixed-list argument."; // src: vulnhunt-fix-verify/phases/phase4_emit.md:45
            d.gates = new Gates(θ["p.phase4_emit.invalid_input_gates_na"], "n/a", "n/a", "n/a");                      // src: vulnhunt-fix-verify/phases/phase4_emit.md:48
            d.evidence = List.of();
            if (θ["p.phase4_emit.invalid_input_regressions_omitted"]) d.regressions = null; else d.regressions = List.of(); // src: vulnhunt-fix-verify/phases/phase4_emit.md:57
            d.issueComment = "**VulnHunter Fix-Verify: " + θ["p.phase4_emit.invalid_input_comment_body"] + "** " + id + " does not appear in the supplied scan report. Confirm the finding ID and re-invoke."; // src: vulnhunt-fix-verify/phases/phase4_emit.md:64
            if (θ["p.phase4_emit.limitations_on_stubs"]) d.issueComment += IssueCommentTemplates.limitations(s, θ); // src: vulnhunt-fix-verify/phases/phase4_emit.md:70
            ds.add(d);
        }
    }

    @executedBy(MODEL)
    List<FindingDisposition> step44Order(List<FindingDisposition> ds, Bound b, Theta θ) {
        if (θ["p.phase4_emit.dispositions_in_input_order"]) return ds.sortBy(d -> b.FIXED.indexOf(d.findingId)); // src: vulnhunt-fix-verify/phases/phase4_emit.md:81
        return ds;
    }

    @executedBy(MODEL)
    Document step45Build(Phase0State s, List<FindingDisposition> ds, Theta θ) {
        Document doc = new Document("1", s.scanId, s.targetRepo, s.verifiedAt, new CommentsEval(s.provided, s.claims), ds); // src: vulnhunt-fix-verify/phases/phase4_emit.md:91
        if (!θ["p.phase4_emit.run_flags_not_copied"]) doc.extra(s.promptInjectionAttempted, s.agentAnnotatedHints); // src: vulnhunt-fix-verify/phases/phase4_emit.md:111
        return doc;
    }

    @executedBy(MODEL)
    void step46Validate(Document doc, Theta θ) {
        if (!θ["p.phase4_emit.mental_schema_walk"]) return;                                      // src: vulnhunt-fix-verify/phases/phase4_emit.md:119
        boolean ok = true;
        ok &= doc.schemaVersion == θ["p.phase4_emit.schema_version_value"];                      // src: vulnhunt-fix-verify/phases/phase4_emit.md:124
        ok &= doc.scanId.matches("^.+_VULNHUNT_RESULTS_.+$");                                    // src: vulnhunt-fix-verify/phases/phase4_emit.md:125
        ok &= doc.targetRepo.keys() == θ["p.phase4_emit.target_repo_keys"];                      // src: vulnhunt-fix-verify/phases/phase4_emit.md:126
        ok &= doc.targetRepo.headCommit.matches(θ["p.phase4_emit.head_commit_format"]);          // src: vulnhunt-fix-verify/phases/phase4_emit.md:127
        ok &= doc.verifiedAt.isIso8601();                                                        // src: vulnhunt-fix-verify/phases/phase4_emit.md:130
        ok &= doc.commentsEvaluation.claims.all(c -> θ["p.phase4_emit.claim_status_set"].contains(c.status)); // src: vulnhunt-fix-verify/phases/phase4_emit.md:131
        for (FindingDisposition d : doc.dispositions) {
            ok &= d.findingId.matches("^VULN-\\d{3}$");                                          // src: vulnhunt-fix-verify/phases/phase4_emit.md:132
            ok &= θ["p.phase4_emit.final_verdict_set"].contains(d.verdict);                      // src: vulnhunt-fix-verify/phases/phase4_emit.md:133
            if (θ["p.phase4_emit.gates_exact_keys"]) ok &= d.gates.keys().size() == 4;           // src: vulnhunt-fix-verify/phases/phase4_emit.md:134
            if (θ["p.phase4_emit.issue_comment_non_empty"]) ok &= !d.issueComment.isEmpty();     // src: vulnhunt-fix-verify/phases/phase4_emit.md:137
        }
        if (θ["p.phase4_emit.no_extra_fields"]) ok &= !doc.hasExtraFields() && doc.dispositions.none(d -> d.hasExtraFields()); // src: vulnhunt-fix-verify/phases/phase4_emit.md:138
        if (!ok && θ["p.phase4_emit.fix_malformed_before_write"]) doc.repairMalformed();         // src: vulnhunt-fix-verify/phases/phase4_emit.md:141
    }

    @executedBy(MODEL)
    void step48RunLog(List<FindingDisposition> ds, Bound b, Theta θ) {
        String s = "## Summary | ID | Verdict |" + ds.map(d -> d.findingId + " | " + d.verdict);  // src: vulnhunt-fix-verify/phases/phase4_emit.md:154
        if (θ["p.phase4_emit.summary_log_counts"]) s += " Counts: " + ds.countBy(d -> d.verdict); // src: vulnhunt-fix-verify/phases/phase4_emit.md:162
        Tools.append(b.OUT + "/verify_run.log.md", s + " Output: " + b.OUT + "/verify_disposition.json");
    }
}
