// file: vulnhunter-agent/agent/verify_post.py
// Post verify outcomes to the source issues: verdict comment (with attribution banner), optional
// body-tampering archival comment, then reopen for NOT_FIXED / PARTIAL / INCONCLUSIVE. No labels.

@executedBy(CODE) @role(io) @stage("verify")
class VerifyPost {

    String archivalHeader() {
        return "VulnHunter Fix-Verify — original issue context: the verification above was performed against the original body (reconstructed from GitHub's edit history), not the current text."; // src: vulnhunter-agent/agent/verify_post.py:44
    }

    // _render_verdict_comment: server-owned banner marks the narrative as developer-supplied, not authoritative (CWE-290).
    String renderVerdictComment(String findingId, String verdict, String issueCommentMd) {
        String banner = θ["code.agent.verify_post.attribution_banner"]
                .format(findingId, verdict);                                                      // src: vulnhunter-agent/agent/verify_post.py:73
        return banner + issueCommentMd;                                                           // src: vulnhunter-agent/agent/verify_post.py:80
    }

    // post_disposition: verdict comment (raises on failure) -> archival comment (if tampered) -> reopen (if verdict set).
    PostResult postDisposition(HttpClient client, String host, IssueRef ref, String findingId, String verdict, String issueCommentMd, boolean bodyTampered, String originalBody, boolean allowReopen) {
        if (issueCommentMd.strip() == "") throw new ValueError("issue_comment is empty — refusing to post"); // src: vulnhunter-agent/agent/verify_post.py:139
        String verdictUrl = GithubVerify.postComment(client, host, ref, renderVerdictComment(findingId, verdict, issueCommentMd), θ); // src: vulnhunter-agent/agent/verify_post.py:150
        String archivalUrl = "";
        boolean archivalFailed = false;
        if (bodyTampered) {                                                                       // src: vulnhunter-agent/agent/verify_post.py:167
            String archivalBody = archivalHeader() + originalBody;                                // src: vulnhunter-agent/agent/verify_post.py:168
            try {
                archivalUrl = GithubVerify.postComment(client, host, ref, archivalBody, θ);       // src: vulnhunter-agent/agent/verify_post.py:170
            } catch (GitHubVerifyError exc) {
                archivalFailed = true;                                                            // src: vulnhunter-agent/agent/verify_post.py:177
            }
        }
        boolean reopened = false;
        boolean reopenFailed = false;
        if (allowReopen && shouldReopen(verdict)) {                                               // src: vulnhunter-agent/agent/verify_post.py:190
            try {
                GithubVerify.reopenIssue(client, host, ref, θ);                                   // src: vulnhunter-agent/agent/verify_post.py:192
                reopened = true;                                                                  // src: vulnhunter-agent/agent/verify_post.py:193
            } catch (GitHubVerifyError exc) {
                reopenFailed = true;                                                              // src: vulnhunter-agent/agent/verify_post.py:201
            }
        }
        return new PostResult(findingId, ref.number, verdict, verdictUrl, archivalUrl, reopened, reopenFailed, archivalFailed); // src: vulnhunter-agent/agent/verify_post.py:212
    }

    // should_reopen: FIXED and INVALID_INPUT leave the issue closed.
    boolean shouldReopen(String verdict) {
        return θ["code.agent.verify_post.reopen_verdicts"].contains(verdict);                     // src: vulnhunter-agent/agent/verify_post.py:230
    }
}

@executedBy(CODE) @role(types)
record PostResult(String findingId, int issueNumber, String verdict, String verdictCommentUrl,
                  String archivalCommentUrl, boolean reopened, boolean reopenFailed, boolean archivalFailed) { }
