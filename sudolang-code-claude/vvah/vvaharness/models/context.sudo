// src: vvaharness/models/context.py:26-51
ScoringPolicy {
  // frozen; unknown keys forbidden (extra="forbid")
  required_gates: String[] = []
  weights: { gate: Number } = {}
  critical: Set<String> = {}      // gates whose failure caps the verdict
  ready_at: Number = 0.85         // score at or above which a fix is ready
  conditional_at: Number = 0.60   // score at or above which a fix is ready with conditions

  // src: vvaharness/models/context.py:41-51 — the scorer prefers weights, so the two sets must agree
  require set(required_gates) == set(keys of weights) => throw "ScoringPolicy gate sets disagree: required-only=$only_required, weighted-only=$only_weighted. A gate this host scores must be one it asked for, and vice versa."
}

// src: vvaharness/models/context.py:53-59
fn ScoringPolicy.missing_from(gate_names):executor=code {
  answered = { normalise_gate_name(n) for each n in gate_names }
  return required_gates where normalise_gate_name(g) not in answered   // order of required_gates kept
}
