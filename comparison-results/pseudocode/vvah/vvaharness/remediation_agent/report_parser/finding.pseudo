// file: vvaharness/remediation_agent/report_parser/finding.py
// The parsed finding-header record, in its own module so every parsing helper can import it without cycles.

@executedBy(CODE) @role(types) @stage("S10")
class ReportParserFinding {
    // Real class name Finding (dataclass). Fields: int index, String severity, String title, String file, String body, boolean done.
    int index; String severity; String title; String file = null; String body = ""; boolean done = false;
    // Real class name Finding. file defaults null, body defaults empty (full markdown block, header to next "### "), done defaults false (DONE_MARKER present on the header).

    String label() {
        String loc = file != null && !file.isEmpty() ? " (" + file + ")" : "";                       // src: vvaharness/remediation_agent/report_parser/finding.py:34
        return "[" + severity + "] " + title + loc;                                                  // src: vvaharness/remediation_agent/report_parser/finding.py:36
    }

    // Stable, filesystem-safe folder name, e.g. 01_stored-query-injection.
    String slug() {
        String base = Regex.sub("[^a-z0-9]+", "-", title.lower()).strip("-");                        // src: vvaharness/remediation_agent/report_parser/finding.py:39
        base = base.substring(0, Math.min(60, base.length())).rstrip("-");                           // 60-char cap // src: vvaharness/remediation_agent/report_parser/finding.py:40
        if (base.isEmpty()) base = "finding";                                                        // src: vvaharness/remediation_agent/report_parser/finding.py:42
        return String.format("%02d_%s", index, base);                                                // src: vvaharness/remediation_agent/report_parser/finding.py:43
    }
}
