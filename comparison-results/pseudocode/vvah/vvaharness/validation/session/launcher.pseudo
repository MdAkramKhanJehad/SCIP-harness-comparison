        Callable drain = () -> streamAndLog(logStream(guardRepeats(harness.runStreaming(prompt, options), "s11", route), messages, heartbeat), logDir.resolve("orchestrator"), sid, live=false); // src: vvaharness/validation/session/launcher.py:486
