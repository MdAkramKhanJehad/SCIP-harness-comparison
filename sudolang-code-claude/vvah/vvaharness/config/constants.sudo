# vvaharness/config/constants.py

Constants for the configuration loader: the local overlay file name and its opt-out variable, the secret-name patterns that decide which environment variables may be interpolated where, and the key classes that decide how the overlay banner prints a value.

Source: `vvaharness/config/constants.py` (lines 1-93)
Executor: code
Called from: `vvaharness/config/__init__.py` (`_expand_env`, `_local_overlay`, `_override_entry`)

// src: vvaharness/config/constants.py:21-23
LOCAL_OVERLAY_NAME = "config.local.yaml"
NO_LOCAL_CONFIG_ENV = "VVAHARNESS_NO_LOCAL_CONFIG"   // set to any value: the overlay is skipped

// src: vvaharness/config/constants.py:25-40
SECRET_NAME_PATTERNS = {"API_KEY", "APIKEY", "TOKEN", "SECRET", "PASSWORD", "PASSWD", "CREDENTIAL", "PRIVATE_KEY"}   // upper-case substrings
SECRET_SEGMENT_PATTERNS = {"AUTH"}   // suffix of an underscore-delimited segment: OAUTH and _AUTH_ count, AUTHOR does not

// src: vvaharness/config/constants.py:42-52
// The only key paths a secret-named environment variable may interpolate into.
CREDENTIAL_DESTINATIONS = {"sdk.api_key", "openai.api_key", "batch.git_token", "output.ingest_token"}

// src: vvaharness/config/constants.py:54-62
ENDPOINT_KEYS = {"sdk.base_url", "openai.base_url", "output.ingest_url", "batch.git_base_url"}   // banner prints the resolved host only

// src: vvaharness/config/constants.py:64-73
TLS_ROUTING_KEYS = {"verify_ssl", "ca_cert", "client_cert", "no_proxy", "cache_route"}   // leaf names (and the full path cache_route) whose value the banner prints

// src: vvaharness/config/constants.py:76-81
fn is_secret_var_name(name):executor=code {
  upper = uppercase(name)
  if (any pattern in SECRET_NAME_PATTERNS is a substring of upper) return true
  return any segment of (upper split on "_") ends with a pattern in SECRET_SEGMENT_PATTERNS
}
