# vvaharness/validation/cli/__init__.py

The command-line entry point of Stage 11 validation (`vvaharness validate`, alias `s11`). It parses arguments, applies the configuration trust gate, resolves the validation model, refuses unsafe workspace or repository paths before anything is staged or spent, chooses which findings to validate, runs validation and removes a workspace it created.

Source: `vvaharness/validation/cli/__init__.py` (lines 1-272)
Executor: code (the validation sessions it starts contain the model calls)
Called from: the `vvaharness validate` / `s11` command, and the scan's Stage 11 wrapper (with a progress sink)

// src: vvaharness/validation/cli/__init__.py:44-55
_WORKSPACE_PREFIX = "vvah-validate-"
_KNOWN_ERRORS = [IngestError, ValidationSessionError, pydantic ValidationError, FileNotFoundError, OSError, yaml.YAMLError]

// src: vvaharness/validation/cli/__init__.py:254-268
fn main(argv?, progress?):executor=code {
  try return _dispatch(argv, progress)
  catch error in _KNOWN_ERRORS => { console: "validate: $error"; return 1 }
  catch any other error => { console: "validate: unexpected error (<type>): $error"; return 1 }   // "CLI boundary must not surface a bare traceback"
}

// src: vvaharness/validation/cli/__init__.py:209-230
fn _dispatch(argv?, progress?):executor=code {
  args = ValidateArgs.of(_parser._build_parser().parse_args(argv))
  [rc, overrides] = _preflight(args)
  if (rc != 0) return rc
  config = config.settings.load_config(overrides=overrides)   // project root is the current working directory
  repo = absolute path of args.repo   // "so the Write gate and report reader agree on one path"
  plan = _resolve_workspace_plan(args, repo)
  require !plan.error => { console: plan.error; return 1 }
  result = _run_validation_cleaning_up(repo, args, config, plan)
  if (progress != null) _record_progress(result, progress)
  return result.exit_code
}

// src: vvaharness/validation/cli/__init__.py:172-184
fn _preflight(args):executor=code {
  // "Both refusals run before load_config, so nothing is staged and nothing spent."
  [rc, overrides] = _trusted_model_env(args)
  if (rc != 0) return [rc, overrides]
  err = _model._check_persona_vendors(overrides)
  require !err => { console: err; return [2, overrides] }
  err = _check_path_guards(args)
  require !err => { console: err; return [1, overrides] }
  return [0, overrides]
}

// src: vvaharness/validation/cli/__init__.py:129-137
fn _trusted_model_env(args):executor=code {
  try cfg_path = orchestrator.trusted_config(_resolve_config_path(args), args.repo, explicit=(args.config != null))   // external to this area: the --config trust gate
  catch ConfigPolicyError as e => { console: "validate: $e"; return ModelEnvResult(2, {}) }
  return _model._apply_model_env(cfg_path)
}

// src: vvaharness/validation/cli/__init__.py:68-74
fn _resolve_config_path(args):executor=code {
  if (args.config) return args.config
  default = orchestrator._default_config()
  console: "validate: no --config given; using default profile $default"
  return default
}

// src: vvaharness/validation/cli/__init__.py:120-126
fn _check_path_guards(args):executor=code = _network_path_error(args) || _workspace_inside_repo_error(args) || _nonempty_workspace_error(args)   // first error wins

// src: vvaharness/validation/cli/__init__.py:82-90
fn _network_path_error(args):executor=code {
  for each [flag, path] in [["--workspace", args.workspace], ["--repo", args.repo]] {
    if (path != null && is_network_path(path)) return "validate: $flag '$path' is a network/UNC path; refusing (reading it could leak credentials over SMB)"
  }
  return null
}

// src: vvaharness/validation/cli/__init__.py:93-107
fn _workspace_inside_repo_error(args):executor=code {
  if (args.workspace == null) return null
  if (resolved args.workspace is not inside resolved args.repo) return null
  return "validate: --workspace ${ args.workspace } is inside --repo ${ args.repo }; Claude Code's ancestor-directory settings walk would then load the target's own CLAUDE.md as privileged instructions. Pass a path outside the repository."
}

// src: vvaharness/validation/cli/__init__.py:77-79, 110-117
fn _nonempty_workspace_error(args):executor=code {
  if (args.workspace == null || args.workspace is not an existing directory with entries) return null
  return "validate: --workspace ${ args.workspace } is not empty; it is treated as ephemeral and removed on completion. Pass a new or empty path."
}

// src: vvaharness/validation/cli/__init__.py:140-145
_WorkspacePlan { workspace_root: Path; owns_workspace: Boolean; error: String | null }

// src: vvaharness/validation/cli/__init__.py:148-169
fn _resolve_workspace_plan(args, repo):executor=code {
  if (args.workspace != null) return _WorkspacePlan(resolved args.workspace, owns_workspace=false, error=null)
  workspace_root = resolved new temporary directory with prefix _WORKSPACE_PREFIX
  if (workspace_root is not inside repo) return _WorkspacePlan(workspace_root, owns_workspace=true, error=null)
  // "Defensive: only reachable via a TMPDIR pointed inside --repo"
  remove workspace_root (ignoring errors)
  return _WorkspacePlan(workspace_root, true, error="validate: the default workspace $workspace_root resolved inside --repo $repo (check \$TMPDIR); Claude Code's ancestor-directory settings walk would then load the target's own CLAUDE.md. Pass --workspace pointing outside the repository.")
}

// src: vvaharness/validation/cli/__init__.py:58-65
fn _resolve_selection(args, config):executor=code {
  // "--finding ids win, then --all uncapped, else top-N by CVSS"
  if (args.findings) return Selection(case_ids=args.findings, resume=args.resume)
  if (args.every_validatable) return Selection(resume=args.resume)   // no cap
  cap = args.max_findings or, when absent, config.max_findings   // config.max_findings default 20 (step_validate.max_findings)
  return Selection(max_findings=cap, resume=args.resume)
}

// src: vvaharness/validation/cli/__init__.py:187-206
fn _run_validation_cleaning_up(repo, args, config, plan):executor=code {
  constraint OnEveryExit { if (plan.owns_workspace) remove plan.workspace_root (ignoring errors) }   // an operator --workspace is not removed here
  return _run.run_validation(repo, selection=_resolve_selection(args, config), workspace_root=plan.workspace_root, config, report_md=args.scan_report)
}

// src: vvaharness/validation/cli/__init__.py:233-251
fn _record_progress(result, progress):executor=code {
  passed = count of result.verdicts whose verdict_state is VALIDATED
  validated = result.metadata.total_findings
  progress.update(validated, passed, failed=validated - passed)   // "Anything short of a VALIDATED state counts as failed"
  // preserved: total_findings counts every selected case, including cases refused before validation, while verdicts holds only cases that ran or resumed
}
