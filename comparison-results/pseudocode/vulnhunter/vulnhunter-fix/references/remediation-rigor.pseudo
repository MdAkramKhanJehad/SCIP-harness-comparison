// file: vulnhunter-fix/references/remediation-rigor.md
// Rule book: cross-phase remediation-rigor invocations (scripts per phase), error semantics and back-fill rules.
// Companion to the "## Remediation-rigor additions" stubs in prompts/plan.md (Phase 2), prompts/implement.md (Phase 3),
// prompts/verify.md (Phase 4) and prompts/deliver.md (Phase 5); one method per phase section.

// Raised when a delivery gate fails and the rule says delivery stops (the gate scripts exit non-zero).
@executedBy(CODE) @role(types)
record DeliveryHalted(Object reason) { }

@executedBy(MODEL) @role(rule_set)
class RemediationRigor {

    // Entry: apply the rigor block for the given phase.
    void run(String phase, Context ctx, Theta θ) {
        String workDir = θ["p.remediation-rigor.work_dir_convention"];                                   // src: vulnhunter-fix/references/remediation-rigor.md:11
        ctx.workDir = ctx.inPlace ? ".vulnhunter-fix/" : ".work/<repo>/";
        if (phase == "plan") plan(ctx, θ);
        else if (phase == "implement") implement(ctx, θ);
        else if (phase == "verify") verify(ctx, θ);
        else if (phase == "deliver") deliver(ctx, θ);
    }

    // ---------------- Phase 2 (Plan) ----------------
    @stage("fix.plan")
    void plan(Context ctx, Theta θ) {
        GraphOut g = buildGraph(ctx, θ);
        for (Finding f : ctx.findings) {
            if (f.isCryptoCwe()) cryptoTrustChain(f, θ);
            String tier = classifyAtPlan(f, ctx.plan(f), θ);
            callersRoutedCoverage(f, ctx.plan(f), g, θ);
        }
        if (θ["p.remediation-rigor.language_selects_adapter"]) {                                        // src: vulnhunter-fix/references/remediation-rigor.md:46
            ctx.workerManifest.include(RepoTypeAdapters.run(ctx.repo, θ));                               // scripts/language-detect.py
        }
        antiMergeAtPlan(ctx, θ);
        if (θ["p.remediation-rigor.fix_plan_schema_validation"]) {                                      // src: vulnhunter-fix/references/remediation-rigor.md:54
            if (!Validate.fixPlan(ctx.plans, "references/fix_plan-schema.json")) SchemaRepairLoop.enter(); // REQ-SCH-004
        }
    }

    @executedBy(CODE)
    GraphOut buildGraph(Context ctx, Theta θ) {
        GraphOut g;
        if (θ["p.remediation-rigor.graph_built_once_cached"] && Cache.hit(ctx.repo.contentHash())) {    // src: vulnhunter-fix/references/remediation-rigor.md:15
            g = Cache.load(ctx.workDir + "cache/graph.json");
        } else {
            g = Scripts.buildGraph(ctx.repo);                                                              // graph.json + graph_context/<VULN>.json per finding
        }
        if (θ["p.remediation-rigor.worker_never_invokes_graphify"]) ctx.workerTools.remove("graphify"); // src: vulnhunter-fix/references/remediation-rigor.md:15
        assert θ["p.remediation-rigor.graph_backend_values"].contains(g.backend);                       // src: vulnhunter-fix/references/remediation-rigor.md:17
        if (g.backend == "grep") {
            for (Finding f : ctx.findings) {
                if (θ["p.remediation-rigor.grep_backend_warn_graph_heavy_classes"].contains(f.cweClass)) { // src: vulnhunter-fix/references/remediation-rigor.md:17
                    Operator.warn("grep backend for graph-heavy class " + f.cweClass);
                    if (θ["p.remediation-rigor.grep_fallback_annotation_required"]) f.col7Annotation = "(grep_fallback)"; // src: vulnhunter-fix/references/remediation-rigor.md:17
                }
            }
        }
        return g;
    }

    void cryptoTrustChain(Finding f, Theta θ) {
        f.sidecar.cryptoTrustChain = Scripts.cryptoTrustChainCheckers(f);                                 // four booleans
        if (θ["p.remediation-rigor.crypto_full_forbidden_unless_all_true"] && f.sidecar.cryptoTrustChain.anyFalse()) { // src: vulnhunter-fix/references/remediation-rigor.md:21
            f.forbidProjection("FULL");
        }
    }

    String classifyAtPlan(Finding f, PlanArtifact plan, Theta θ) {
        String out = FixCompletenessRubric.classify(f.diff, f, plan, f.result, θ);
        assert θ["p.remediation-rigor.classifier_output_set"].contains(out);                            // src: vulnhunter-fix/references/remediation-rigor.md:25
        assert θ["p.remediation-rigor.never_silently_promote_full"];                                    // src: vulnhunter-fix/references/remediation-rigor.md:25
        if (θ["p.remediation-rigor.plan_tops_out_at_llm_review"] && plan.discriminationEvidence == null && out == "FULL") { // src: vulnhunter-fix/references/remediation-rigor.md:42
            out = "LLM_REVIEW";                                                                            // FULL projection must escalate to tier_judgment.md
        }
        if (out != "LLM_REVIEW") {
            if (θ["p.remediation-rigor.record_projected_tier"]) plan.projectedCompletenessTier = out;   // src: vulnhunter-fix/references/remediation-rigor.md:29
            return out;
        }
        plan.tierJudgment = tierJudgment(f, θ);
        return plan.tierJudgment.finalTier;
    }

    TierJudgmentOut tierJudgment(Finding f, Theta θ) {
        int malformed = 0;
        for (int i = 0; i < θ["p.remediation-rigor.tier_judgment_max_attempts"]; i++) {                 // src: vulnhunter-fix/references/remediation-rigor.md:30
            TierJudgmentOut o = TierJudgment.run(f, θ["p.remediation-rigor.tier_judgment_temperature"]);  // src: vulnhunter-fix/references/remediation-rigor.md:30
            if (o.wellFormed()) return o;                                                                 // final_tier + rationale
            malformed++;
        }
        return TierJudgmentOut.of(θ["p.remediation-rigor.two_malformed_outputs_manual_review"]);         // src: vulnhunter-fix/references/remediation-rigor.md:30
    }

    void callersRoutedCoverage(Finding f, PlanArtifact plan, GraphOut g, Theta θ) {
        if (!θ["p.remediation-rigor.callers_routed_coverage_required"]) return;                         // src: vulnhunter-fix/references/remediation-rigor.md:34
        if (θ["p.remediation-rigor.coverage_unknown_when_grep_or_unresolved"] && (g.backend == "grep" || f.sinkSymbol == null)) { // src: vulnhunter-fix/references/remediation-rigor.md:40
            plan.callersRoutedCoverage = "unknown";
        } else if (plan.touchesAll(f.triage.callersOfSink)) {
            plan.callersRoutedCoverage = θ["p.remediation-rigor.coverage_superset_required_for_full"];   // src: vulnhunter-fix/references/remediation-rigor.md:38
        } else {
            plan.callersRoutedCoverage = "subset";
            plan.tierCap = θ["p.remediation-rigor.coverage_subset_caps_mitigation"];                     // src: vulnhunter-fix/references/remediation-rigor.md:39
        }
    }

    void antiMergeAtPlan(Context ctx, Theta θ) {
        for (Group grp : ctx.groups) {
            String r = AntiMergeMath.apply(grp, θ);
            if (θ["p.remediation-rigor.anti_merge_strict_gate5"] && r != "allow") {                     // --strict exits non-zero  src: vulnhunter-fix/references/remediation-rigor.md:50
                if (θ["p.remediation-rigor.disallowed_group_split_before_implement"]) ctx.splitIntoIndividualPrs(grp); // src: vulnhunter-fix/references/remediation-rigor.md:50
            }
        }
    }

    // ---------------- Phase 3 (Implement) ----------------
    @stage("fix.implement")
    void implement(Context ctx, Theta θ) {
        for (Finding f : ctx.findings) {
            List<String> classes = θ["p.remediation-rigor.worker_class_prompt_injection"];             // src: vulnhunter-fix/references/remediation-rigor.md:93
            if (classes.contains(f.cweClass)) ctx.worker(f).inject("worker_agent_" + f.cweClass + ".md"); // all extend worker_agent_common.md
            stepE5Discrimination(f, θ);
            stepG5PreexistingTests(f, θ);
            if (f.cweClass == "crypto" && f.plan.cryptoTrustChain.anyFalse()) {                           // REQ-CWE-007
                f.result.completenessTier = "MITIGATION";
                ResidualRiskRules.r5CryptoResiduals(f.result, f, θ);
            }
        }
    }

    // Step E.5 -- discrimination evidence
    String stepE5Discrimination(Finding f, Theta θ) {
        if (!θ["p.remediation-rigor.discrimination_evidence_required_for_full"]) return "skip";         // src: vulnhunter-fix/references/remediation-rigor.md:62
        DiscriminationEvidence e;
        if (θ["p.remediation-rigor.discrimination_method_stash_and_run_preferred"] == "stash-and-run" && f.stashPractical()) { // src: vulnhunter-fix/references/remediation-rigor.md:65
            Git.stash();
            String pre = f.runTest();                                                                      // expect FAIL
            Git.stashPop();
            String post = f.runTest();                                                                     // expect PASS
            e = new DiscriminationEvidence("stash-and-run", pre, post, null);                                    // outputs recorded verbatim
        } else if (θ["p.remediation-rigor.discrimination_method_trace_fallback"]) {                     // src: vulnhunter-fix/references/remediation-rigor.md:66
            e = new DiscriminationEvidence("trace", null, null, f.describePrePostPaths());   // unclear: the prose says "describe the code paths hit pre-fix vs. post-fix"; which schema field holds the description is not stated
        }
        Json.write(".work/<repo>/discrimination/" + f.vulnId + ".json", e);
        if (e.preFixResult != "fail" || e.postFixResult != "pass") {
            if (θ["p.remediation-rigor.non_discriminating_test_returns_to_step_c"]) return "goto Step C"; // R4 violation  src: vulnhunter-fix/references/remediation-rigor.md:80
        }
        return "ok";
    }

    // Step G.5 -- pre-existing test updates
    String stepG5PreexistingTests(Finding f, Theta θ) {
        if (!θ["p.remediation-rigor.run_preexisting_suite_before_commit"]) return "ok";                 // src: vulnhunter-fix/references/remediation-rigor.md:84
        for (TestFailure t : f.repo.runExistingSuite()) {
            if (t.encodedVulnerableBehavior()) {
                if (θ["p.remediation-rigor.update_tests_encoding_vulnerable_behavior"]) {               // src: vulnhunter-fix/references/remediation-rigor.md:85
                    t.assertSecureOutcome();
                    t.commentAbove(θ["p.remediation-rigor.updated_test_comment"]);                      // src: vulnhunter-fix/references/remediation-rigor.md:86
                    if (θ["p.remediation-rigor.record_preexisting_test_updates"]) Json.append(".work/<repo>/preexisting_test_updates/" + f.vulnId + ".json", t); // src: vulnhunter-fix/references/remediation-rigor.md:87
                }
            } else if (θ["p.remediation-rigor.unrelated_regressions_mean_overscoped"]) {               // src: vulnhunter-fix/references/remediation-rigor.md:89
                return "goto Step D";                                                                      // fix is over-scoped
            }
        }
        return "ok";
    }

    // ---------------- Phase 4 (Verify) ----------------
    @stage("fix.verify")
    void verify(Context ctx, Theta θ) {
        for (Finding f : ctx.findings) {
            reclassify(f, θ);
        }
        if (θ["p.remediation-rigor.sweep_for_every_verified_finding"]) {                                 // src: vulnhunter-fix/references/remediation-rigor.md:119
            for (Finding f : ctx.findings.filter(x -> x.verified)) sweep(f, θ);
        }
        Table t = VerificationTableRules.run(ctx.findings, ctx.graph, ctx.result, ctx.sidecar, θ);
        assert t.columns() == θ["p.remediation-rigor.verification_table_columns"];                     // src: vulnhunter-fix/references/remediation-rigor.md:121
        if (θ["p.remediation-rigor.yes_cells_need_citation"]) Scripts.validateVerification(t);         // src: vulnhunter-fix/references/remediation-rigor.md:123
        if (θ["p.remediation-rigor.result_schema_validation"]) {                                         // src: vulnhunter-fix/references/remediation-rigor.md:131
            for (Result r : ctx.groupResults) if (!Scripts.validateResult(r)) SchemaRepairLoop.enter();
        }
    }

    void reclassify(Finding f, Theta θ) {
        if (!θ["p.remediation-rigor.post_fix_reclassification"]) return;                                // src: vulnhunter-fix/references/remediation-rigor.md:105
        String now = FixCompletenessRubric.classify(f.appliedDiff, f, f.plan, f.result, θ);
        if (now == "LLM_REVIEW") {
            if (θ["p.remediation-rigor.llm_review_never_terminal"]) now = tierJudgment(f, θ).finalTier; // src: vulnhunter-fix/references/remediation-rigor.md:113
        }
        if (now == f.plan.projectedCompletenessTier) {
            if (θ["p.remediation-rigor.tier_match_proceeds"]) f.result.record(now, f.result.residualVectors); // src: vulnhunter-fix/references/remediation-rigor.md:109
        } else if (θ["p.remediation-rigor.tier_mismatch_triggers_repair"]) {                            // src: vulnhunter-fix/references/remediation-rigor.md:110
            repairLoop(f, "tier mismatch: projected " + f.plan.projectedCompletenessTier + " got " + now, θ);
        }
    }

    void repairLoop(Finding f, String brief, Theta θ) {
        if (θ["p.remediation-rigor.worktree_reset_before_retry"]) Scripts.worktreeReset(f.worktree);   // hard reset  src: vulnhunter-fix/references/remediation-rigor.md:127
        RepairLoop.retry(f, brief);
    }

    void sweep(Finding f, Theta θ) {
        for (Sibling s : Scripts.sweepRootCauses(f)) {
            if (f.result.filesModified.contains(s.file) && θ["p.remediation-rigor.sweep_path_a_amend"]) { // src: vulnhunter-fix/references/remediation-rigor.md:119
                Pr.amend(s);
            } else {
                Issue.open(s, θ["p.remediation-rigor.sweep_path_b_followup_issue"]);                    // src: vulnhunter-fix/references/remediation-rigor.md:119
            }
            if (f.result.tier == "VERIFIED_FULL") {
                f.result.tier = θ["p.remediation-rigor.sweep_siblings_downgrade_full"];                 // src: vulnhunter-fix/references/remediation-rigor.md:119
                f.result.sweepRevised = true;
            }
        }
    }

    // ---------------- Phase 5 (Deliver) ----------------
    @stage("fix.deliver")
    void deliver(Context ctx, Theta θ) {
        for (Body b : ctx.bodies) {
            ResidualRiskRules.apply(b.result, b.finding, θ);                                               // honesty guards: empty / FULL-with-residuals / hand-wave; Draft for WORKAROUND
            bodyCompleteness(b, ctx, θ);
        }
        runGates(ctx, θ);
    }

    @executedBy(CODE)
    void bodyCompleteness(Body b, Context ctx, Theta θ) {
        List<String> req = θ["p.remediation-rigor.required_body_headings"];                              // src: vulnhunter-fix/references/remediation-rigor.md:161
        if (b.isPr && θ["p.remediation-rigor.pr_requires_verification_table_heading"]) req.add("Verification Table");      // src: vulnhunter-fix/references/remediation-rigor.md:161
        if (b.result.completenessTier != "FULL" && θ["p.remediation-rigor.non_full_requires_residual_heading"]) req.add("Residual Risk"); // src: vulnhunter-fix/references/remediation-rigor.md:161
        if (b.status == "BREAKING_CHANGE" && θ["p.remediation-rigor.breaking_change_bare_heading"]) {                       // src: vulnhunter-fix/references/remediation-rigor.md:161
            req.add("Breaking Change");                                                                    // bare heading; Gate 2 rejects em-dash suffix
        }
        if (ctx.sweepRan && θ["p.remediation-rigor.sweep_summary_heading"]) req.add("Sweep Summary");   // src: vulnhunter-fix/references/remediation-rigor.md:161
        for (String h : req) if (!b.hasHeading("## " + h)) Gate.fail("Gate 2 body completeness: " + h);
    }

    @executedBy(CODE)
    void runGates(Context ctx, Theta θ) {
        for (String gate : θ["p.remediation-rigor.delivery_gate_set"]) {                                 // scripts/run-gates.py, before any gh call  src: vulnhunter-fix/references/remediation-rigor.md:127
            if (!RunGates.runGateScript(gate, RunGates.buildInvocations(gate, ctx).get(0), ctx.timeoutSeconds).passed && θ["p.remediation-rigor.failing_gate_halts_delivery"]) {        // src: vulnhunter-fix/references/remediation-rigor.md:127
                throw new DeliveryHalted(gate);
            }
        }
    }
}
