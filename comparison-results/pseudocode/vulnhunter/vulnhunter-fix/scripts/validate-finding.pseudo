// file: vulnhunter-fix/scripts/validate-finding.py
// Validates a finding (or a parser aggregate with a findings list) against references/finding-schema.json (REQ-SCH-006).

@executedBy(CODE) @role(evaluation) @stage("fix")
class ValidateFinding {

    // callers use run(path); returns ok plus the exit code
    Map run(String path) {
        int rc = validateFile(path);
        return Map.of("ok", rc == 0, "rc", rc);
    }

    int validateFile(String path) {
        Map schema = Json.parse(Files.read(skillRoot().join("references", "finding-schema.json")));           // src: vulnhunter-fix/scripts/validate-finding.py:33
        Draft202012Validator.checkSchema(schema);
        Object payload;
        try {
            payload = Json.parse(Files.read(path));                                                           // src: vulnhunter-fix/scripts/validate-finding.py:37
        } catch (OSError e) {
            return 2;                                                                                         // src: vulnhunter-fix/scripts/validate-finding.py:40
        } catch (JSONDecodeError e) {
            return 3;                                                                                         // src: vulnhunter-fix/scripts/validate-finding.py:43
        }
        Validator v = Draft202012Validator.of(schema);                                                        // src: vulnhunter-fix/scripts/validate-finding.py:45
        // aggregate form: validate each findings[i]; any error -> 1
        if (payload.isMap() && payload.get("findings").isList()) {                                            // src: vulnhunter-fix/scripts/validate-finding.py:47
            int rc = 0;
            for (Map finding : payload.get("findings")) {
                if (!v.iterErrors(finding).isEmpty()) rc = 1;                                                 // src: vulnhunter-fix/scripts/validate-finding.py:53
            }
            return rc;
        }
        List<Error> errors = v.iterErrors(payload).sortedBy(e -> e.absolutePath);                             // src: vulnhunter-fix/scripts/validate-finding.py:56
        if (errors.isEmpty()) return 0;                                                                       // src: vulnhunter-fix/scripts/validate-finding.py:58
        return 1;                                                                                             // src: vulnhunter-fix/scripts/validate-finding.py:61
    }

    int main(List<String> argv) {
        if (argv.size() != 2) return 64;                                                                      // src: vulnhunter-fix/scripts/validate-finding.py:65
        return validateFile(argv.get(1));
    }
}
