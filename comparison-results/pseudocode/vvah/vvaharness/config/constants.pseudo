// file: vvaharness/config/constants.py
// Env-interpolation policy and overlay-visibility constants for the config loader, plus the secret-name test.

@executedBy(CODE) @role(config)
class Constants {

    // Overlay file and the env switch that disables it.
    String LOCAL_OVERLAY_NAME = θ["code.config.constants.local_overlay_name"];                       // src: vvaharness/config/constants.py:21
    String NO_LOCAL_CONFIG_ENV = θ["code.config.constants.no_local_config_env"];                     // src: vvaharness/config/constants.py:23

    // Uppercase substrings that mark an env-var name as secret-bearing.
    Set SECRET_NAME_PATTERNS = θ["code.config.constants.secret_name_patterns"];                      // src: vvaharness/config/constants.py:26

    // Matched as a suffix of an underscore-delimited segment: OAUTH and _AUTH_ count, AUTHOR does not.
    Set SECRET_SEGMENT_PATTERNS = θ["code.config.constants.secret_segment_patterns"];                // src: vvaharness/config/constants.py:40

    // The only key paths a secret-patterned env var may interpolate into.
    Set CREDENTIAL_DESTINATIONS = θ["code.config.constants.credential_destinations"];                // src: vvaharness/config/constants.py:45

    // Overlay banner: endpoint keys print the resolved host only.
    Set ENDPOINT_KEYS = θ["code.config.constants.endpoint_keys"];                                    // src: vvaharness/config/constants.py:55

    // Overlay banner: leaf names (plus the full path cache_route) whose resolved value is printed.
    Set TLS_ROUTING_KEYS = θ["code.config.constants.tls_routing_keys"];                              // src: vvaharness/config/constants.py:65

    boolean isSecretVarName(String name) {
        String upper = name.upper();                                                                 // src: vvaharness/config/constants.py:76
        if (SECRET_NAME_PATTERNS.anyMatch(pat -> upper.contains(pat))) return true;                  // substring test // src: vvaharness/config/constants.py:78
        return upper.split("_").anyMatch(seg -> SECRET_SEGMENT_PATTERNS.anyMatch(pat -> seg.endsWith(pat))); // suffix of one segment // src: vvaharness/config/constants.py:81
    }
}
