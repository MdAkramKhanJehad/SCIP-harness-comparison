// file: vvaharness/evidence/docs.py
// S2 evidence: README/SECURITY/ARCHITECTURE-shaped documents within a shared char budget:
// fixed-name docs breadth-first, then grow truncated ones, then a few name-matched extra .md/.rst files.

@executedBy(CODE) @role(step) @stage("S2")
class Docs {

    /** Every present fixed-name document gets a fair share (1/3 of remaining, floored) first. */
    Pair<List<Pair<String, String>>, Integer> breadthPass(Path root, List<Pair<String, Path>> found, int docCap, Theta θ) {
        List<Pair<String, String>> docs = new List();
        int budget = docCap;                                                                      // src: vvaharness/evidence/docs.py:43
        for (Pair<String, Path> f : found) {                                                      // src: vvaharness/evidence/docs.py:44
            if (budget <= 0) break;                                                               // src: vvaharness/evidence/docs.py:45
            int subCap = Math.min(docCap, Math.max(θ["code.evidence.docs.min_doc_read_chars"], budget / θ["code.evidence.docs.breadth_share_divisor"])); // src: vvaharness/evidence/docs.py:47
            String body = Read.readCapped(root, f.second, subCap, false, θ);                     // src: vvaharness/evidence/docs.py:48
            if (!body.isEmpty()) { docs.add(new Pair(f.first, body)); budget -= body.length(); }  // src: vvaharness/evidence/docs.py:49
        }
        return new Pair(docs, budget);                                                            // src: vvaharness/evidence/docs.py:52
    }

    /** Re-read one fixed-name doc with more budget; returns (body, chars spent). */
    Pair<String, Integer> growOne(Path root, String name, String body, int docCap, int budget, Theta θ) {
        Path p = root.resolve(name);                                                              // src: vvaharness/evidence/docs.py:57
        if (!p.isFile()) return new Pair(body, 0);                                                // src: vvaharness/evidence/docs.py:58
        String bigger = Read.readCapped(root, p, Math.min(docCap, body.length() + budget), false, θ); // src: vvaharness/evidence/docs.py:60
        int grown = bigger.length() - body.length();                                              // src: vvaharness/evidence/docs.py:61
        return grown > 0 ? new Pair(bigger, grown) : new Pair(body, 0);                           // src: vvaharness/evidence/docs.py:62
    }

    /** One breadth-first growth round; returns (remaining budget, anything grew). */
    Pair<Integer, Boolean> growRound(Path root, List<Pair<String, String>> docs, int budget, int docCap, Theta θ) {
        boolean grew = false;
        for (int i = 0; i < docs.size(); i++) {                                                   // src: vvaharness/evidence/docs.py:69
            if (budget <= 0) break;                                                               // src: vvaharness/evidence/docs.py:70
            Pair<String, Integer> r = growOne(root, docs.get(i).first, docs.get(i).second, docCap, budget, θ); // src: vvaharness/evidence/docs.py:72
            if (r.second > 0) { docs.set(i, new Pair(docs.get(i).first, r.first)); budget -= r.second; grew = true; } // src: vvaharness/evidence/docs.py:73
        }
        return new Pair(budget, grew);                                                            // src: vvaharness/evidence/docs.py:77
    }

    /** Spend leftover budget growing truncated docs until none grow (at most one round per doc). */
    List<Pair<String, String>> growPass(Path root, List<Pair<String, String>> docs, int budget, int docCap, Theta θ) {
        int guard = 0;
        while (budget > 0 && guard < docs.size()) {                                               // src: vvaharness/evidence/docs.py:84
            Pair<Integer, Boolean> r = growRound(root, docs, budget, docCap, θ);                  // src: vvaharness/evidence/docs.py:85
            budget = r.first;
            if (!r.second) break;                                                                 // src: vvaharness/evidence/docs.py:86
            guard++;
        }
        return docs;
    }

    /** Non-fixed-name .md/.rst paths whose stem matches the doc-name regex, sorted, capped. */
    List<String> selectExtraDocs(List<String> fullFiles, Set<String> seen, Theta θ) {
        return sorted(fullFiles.filter(rel ->
                θ["code.evidence.docs.extra_doc_exts"].contains(suffix(rel).lower())            // src: vvaharness/evidence/docs.py:96
                && !seen.contains(rel)                                                            // src: vvaharness/evidence/docs.py:97
                && Regex.searchIgnoreCase(θ["code.evidence.docs.doc_name_rx"], stem(rel))))       // src: vvaharness/evidence/docs.py:98
            .head(θ["code.evidence.docs.doc_extra_max"]);                                        // src: vvaharness/evidence/docs.py:99
    }

    /** Read the selected extras, budget split evenly across them (floored). */
    List<Pair<String, String>> extraDocs(Path root, List<String> fullFiles, Set<String> seen, int budget, Theta θ) {
        List<String> extras = selectExtraDocs(fullFiles, seen, θ);                                // src: vvaharness/evidence/docs.py:105
        int perCap = Math.max(θ["code.evidence.docs.min_doc_read_chars"], budget / Math.max(extras.size(), 1)); // src: vvaharness/evidence/docs.py:106
        List<Pair<String, String>> docs = new List();
        for (String rel : extras) {                                                               // src: vvaharness/evidence/docs.py:108
            if (budget <= 0) break;                                                               // src: vvaharness/evidence/docs.py:109
            String body = Read.readCapped(root, root.resolve(rel), Math.min(budget, perCap), false, θ); // src: vvaharness/evidence/docs.py:111
            if (!body.isEmpty()) { docs.add(new Pair(rel, body)); budget -= body.length(); }      // src: vvaharness/evidence/docs.py:112
        }
        return docs;
    }

    /** Fixed-name docs (priority order) breadth then growth, plus bounded name-matched extras. */
    List<Pair<String, String>> gatherDocs(Path root, List<String> fullFiles, int docCap, Theta θ) {
        // docCap = step2.max_doc_chars (passed by EvidenceGather)
        List<Pair<String, Path>> found = θ["code.evidence.docs.doc_candidates"].filter(n -> root.resolve(n).isFile()).map(n -> new Pair(n, root.resolve(n))); // repo-root only. src: vvaharness/evidence/docs.py:120
        Pair<List<Pair<String, String>>, Integer> b = breadthPass(root, found, docCap, θ); // src: vvaharness/evidence/docs.py:121
        List<Pair<String, String>> docs = growPass(root, b.first, b.second, docCap, θ);           // src: vvaharness/evidence/docs.py:122
        int budget = docCap - docs.sum(d -> d.second.length());                                   // src: vvaharness/evidence/docs.py:123
        Set<String> seen = docs.map(d -> d.first).toSet();                                        // src: vvaharness/evidence/docs.py:124
        return concat(docs, extraDocs(root, fullFiles, seen, budget, θ));                         // src: vvaharness/evidence/docs.py:125
    }
}
