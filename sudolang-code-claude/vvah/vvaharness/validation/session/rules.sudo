# vvaharness/validation/session/rules.py

Reads the two packaged rules files as prompt text, with the leading licence comment removed. Used when the backend does not load `.claude/rules/` itself (deepagents).

Source: `vvaharness/validation/session/rules.py` (lines 1-56)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` (_rules_section, build_validation_options)

// src: vvaharness/validation/session/rules.py:24-27
_LICENCE_COMMENT = /\A\s*<!--.*?-->\s*/s
SCORING_RULES = "scoring-matrix.md"; ADVERSARIAL_RULES = "adversarial-review.md"

// src: vvaharness/validation/session/rules.py:30-38
fn _rules_text(filename):executor=code {
  path = CLAUDE_CONFIG_SOURCE + "/rules/" + filename
  require path is a file => throw FileNotFoundError("required claude_config rule missing at ...")
  return text of path with _LICENCE_COMMENT removed, trimmed
}

// src: vvaharness/validation/session/rules.py:41-48
fn orchestrator_rules_text():executor=code = _rules_text(SCORING_RULES) + "\n\n" + _rules_text(ADVERSARIAL_RULES)
fn persona_rules_text():executor=code = _rules_text(ADVERSARIAL_RULES)
// The orchestrator receives both files; each persona receives only the adversarial-review rules.
