// file: vvaharness/skills/client-side/probe.sh
// Read-only client-side probe: inventory of client files and files of interest, lockfile check,
// then ~26 CWE-labelled grep sections (sinks, refutation evidence, server lines reading client params). Exits 0.

@executedBy(CODE) @role(tool) @stage("S4")
class ClientSideProbe {

    String run(String root, Theta θ) {
        Out out = new Out();
        List<String> exclusions = θ["p.skill_client-side.probe_path_exclusions"];                  // src: vvaharness/skills/client-side/probe.sh:21
        out.line("== CLIENT-SIDE PROBE ==").line("root: " + root);                                   // src: vvaharness/skills/client-side/probe.sh:65
        inventory(root, out);
        // each sink class: label (CWE-tagged), include set (client JS+templates / config / server src), regex, cap
        for (SinkClass sc : SinkClass.from(θ["p.skill_client-side.probe_sink_classes"])) {          // src: vvaharness/skills/client-side/probe.sh:120
            scan(root, sc.label, sc.includes, sc.regex, sc.cap, exclusions, out, θ);
        }
        out.line("== END OF PROBE ==");                                                              // src: vvaharness/skills/client-side/probe.sh:198
        return out.exit0();
    }

    void scan(String root, String label, List<String> includes, String regex, Integer cap, List<String> exclusions, Out out, Theta θ) {
        int c = (cap != null) ? cap : θ["p.skill_client-side.probe_hit_cap"];                     // src: vvaharness/skills/client-side/probe.sh:50
        out.section(label);
        List<String> hits = Grep.rEnIs(regex, includes, exclusions, root);                           // src: vvaharness/skills/client-side/probe.sh:52
        if (hits.isEmpty()) { out.line("(none)"); return; }                                          // src: vvaharness/skills/client-side/probe.sh:53
        out.lines(hits.head(c).map(l -> l.truncate(200)));                                           // src: vvaharness/skills/client-side/probe.sh:58
        if (hits.size() > c) out.line("... " + hits.size() + " hits total, " + c + " shown");        // src: vvaharness/skills/client-side/probe.sh:59
    }

    void inventory(String root, Out out) {
        // walk, skipping dependency/build dirs; count client-file extensions and top-2-level dirs
        Inventory inv = Fs.walk(root).skipDirs(List.of("node_modules", ".git", "dist", "build", "coverage", ".next", "out", "vendor", "__pycache__", ".venv", "bower_components")); // src: vvaharness/skills/client-side/probe.sh:76
        out.line("client files: " + inv.countByExt(List.of(".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte", ".html", ".ejs", ".hbs"))); // src: vvaharness/skills/client-side/probe.sh:98
        out.lines(inv.filesOfInterest().head(30));                                                   // src: vvaharness/skills/client-side/probe.sh:105
        String lock = inv.firstExisting(List.of("package-lock.json", "yarn.lock", "pnpm-lock.yaml")); // src: vvaharness/skills/client-side/probe.sh:111
        if (lock != null) out.line("lockfile: " + lock);
        else if (inv.exists("package.json")) out.line("lockfile: NONE beside package.json -- ^ ranges resolve at build time"); // src: vvaharness/skills/client-side/probe.sh:117
    }
}
