// file: vulnhunter-fix/scripts/issue_intake.py
// In-place intake primitives (no gh, no network): extract the three machine markers from an issue body,
// reconstruct an original body from edit history (unused in v1), enforce one (owner, repo, results_dir) per run,
// and compute the vulnfix idempotency key.

@executedBy(CODE) @role(types)
record ExtractedMarkers(String vulnfixKey, String findingId, String resultsDir) { }

@executedBy(CODE) @role(types)
record IssueRecord(String owner, String repo, int number, String url, String title, boolean bodyTampered, String originalBody, ExtractedMarkers markers) { }

@executedBy(CODE) @role(tool) @stage("fix")
class IssueIntake {

    ExtractedMarkers run(String body, Theta θ) {
        return extractMarkers(body, "issue body", θ);
    }

    ExtractedMarkers extractMarkers(String body, String sourceLabel, Theta θ) {
        // all three regexes are anchored to HTML comments and case-insensitive
        Match mKey = Regex.searchIgnoreCase(θ["code.fix.scripts.issue_intake.vulnfix_key_regex"], body);   // src: vulnhunter-fix/scripts/issue_intake.py:34
        Match mId = Regex.searchIgnoreCase(θ["code.fix.scripts.issue_intake.finding_id_regex"], body);     // src: vulnhunter-fix/scripts/issue_intake.py:37
        Match mDir = Regex.searchIgnoreCase(θ["code.fix.scripts.issue_intake.results_dir_regex"], body);   // src: vulnhunter-fix/scripts/issue_intake.py:40
        List<String> missing = List.of();
        if (mKey == null) missing.add("vulnfix-key");                                                      // src: vulnhunter-fix/scripts/issue_intake.py:71
        if (mId == null) missing.add("vulnhunt-finding-id");                                               // src: vulnhunter-fix/scripts/issue_intake.py:73
        if (mDir == null) missing.add("vulnhunt-results-dir");                                             // src: vulnhunter-fix/scripts/issue_intake.py:75
        if (!missing.isEmpty()) throw new MarkerExtractionError(sourceLabel + ": missing required marker(s)"); // src: vulnhunter-fix/scripts/issue_intake.py:78
        String resultsDir = mDir.group(1);
        // path-traversal guard on the results dir name
        if (List.of("..", "/", "\\").any(tok -> resultsDir.contains(tok))) throw new MarkerExtractionError("forbidden path token"); // src: vulnhunter-fix/scripts/issue_intake.py:83
        return new ExtractedMarkers(mKey.group(1).lower(), mId.group(1).upper(), resultsDir);             // src: vulnhunter-fix/scripts/issue_intake.py:88
    }

    // currently unused by the v1 in-place flow (edited bodies are skipped)
    String reconstructOriginal(String currentBody, List<Map> edits) {
        if (edits.isEmpty()) return currentBody;                                                           // src: vulnhunter-fix/scripts/issue_intake.py:114
        List<Map> sorted;
        try {
            sorted = edits.sortedBy(e -> e.get("editedAt"));                                               // src: vulnhunter-fix/scripts/issue_intake.py:117
        } catch (KeyError e) {
            throw new DiffApplyError("Edit missing required field");                                       // src: vulnhunter-fix/scripts/issue_intake.py:119
        }
        Object snapshot = sorted.get(0).get("diff");                                                       // src: vulnhunter-fix/scripts/issue_intake.py:121
        if (snapshot == null) throw new DiffApplyError("oldest edit has no diff field");                   // src: vulnhunter-fix/scripts/issue_intake.py:123
        if (!snapshot.isString()) throw new DiffApplyError("diff field is not a string");                  // src: vulnhunter-fix/scripts/issue_intake.py:128
        return snapshot;
    }

    Triple<String, String, String> enforceHomogeneity(List<IssueRecord> records) {
        if (records.isEmpty()) throw new ValueError("No issues to enforce homogeneity over");             // src: vulnhunter-fix/scripts/issue_intake.py:160
        Set<Triple> keys = records.map(r -> Triple.of(r.owner.lower(), r.repo.lower(), r.markers.resultsDir)).toSet(); // src: vulnhunter-fix/scripts/issue_intake.py:161
        if (keys.size() == 1) return keys.first();                                                         // src: vulnhunter-fix/scripts/issue_intake.py:165
        throw new ValueError("In-place run requires all issues to share the same (repo, scan_id)");       // src: vulnhunter-fix/scripts/issue_intake.py:171
    }

    String primaryCwe(String cwe) {
        // first CWE-NNN in a possibly multi-CWE string; same normalization as parse_results
        Match m = Regex.search("CWE-\\d+", cwe);                                                           // src: vulnhunter-fix/scripts/issue_intake.py:184
        return m != null ? m.group(0) : "";
    }

    String computeVulnfixKey(String location, String cwe, String rootCause, Theta θ) {
        // θ["code.vulnfix_key"]: sha256(location|primary_cwe|root_cause), first 16 hex chars
        return Sha256.hex(location + "|" + primaryCwe(cwe) + "|" + rootCause).substring(0, 16);           // src: vulnhunter-fix/scripts/issue_intake.py:201
    }
}
