# vvaharness/remediation_agent/select/pq.py

The "top N by CVSS" selector shared by both remediation entry points (the standalone `remediate` command and Stage 10 in the scan), plus the drop of posture-channel findings.

Source: `vvaharness/remediation_agent/select/pq.py` (lines 1-97)
Executor: code
Called from: `vvaharness/remediation_agent/discovery.sudo` load_findings and _targets_from_typed; `orchestrator/scan.py` `_run_remediation`

// src: vvaharness/remediation_agent/select/pq.py:28-35
// CVSS 3.1 band anchors used when a finding has no numeric score: a band-only CRITICAL outranks a numeric 7.5 HIGH
_BAND_SCORE = { CRITICAL: 9.0, HIGH: 7.0, MEDIUM: 4.0, LOW: 1.0, INFO: 0.0 }

// src: vvaharness/remediation_agent/select/pq.py:38-40
fn band_score(severity):executor=code {
  return _BAND_SCORE[upper case of trimmed severity] or 0.0   // unknown or empty band scores 0.0
}

// src: vvaharness/remediation_agent/select/pq.py:43-66
fn select_top_by_cvss(items, n, score_of, severity_of?):executor=code {
  if (n == null || n <= 0) return items in input order   // no cap: no reordering
  _score(it) {
    s = score_of(it)
    if (s != null && s is not NaN) return s   // NaN is not a score: it would derail the heap ordering
    return band_score(if (severity_of) severity_of(it) else it.severity)
  }
  // min-heap on (-score, input index): highest score first, the earlier item wins a tie
  return the first min(n, length(items)) items ordered by score descending, ties by input index
  // preserved: whenever n is a positive integer the result is reordered by score, even when n >= length(items) and nothing is removed
}

// src: vvaharness/remediation_agent/select/pq.py:69-84
fn select_top_logged(items, n, score_of, severity_of?, log_prefix):executor=code {
  selected = select_top_by_cvss(items, n, score_of, severity_of)
  if (n != null && 0 < n < length(items)) console "$log_prefix selecting top $n of ${length(items)} finding(s) by CVSS score"
  return selected
}

// src: vvaharness/remediation_agent/select/pq.py:87-97
fn drop_non_main_channel(items, log_prefix):executor=code {
  // Fail-safe: ONLY exactly "posture" (trimmed, case-folded) is dropped; junk and empty channel values are kept
  kept = items |> filter(it => casefold(trimmed it.finding.channel or "") != "posture")
  if (some were dropped) console "$log_prefix skipping $count posture-stamped finding(s) (build/deploy/dependency posture, not application code); every other channel value is kept"
  return kept
  // the channel is stamped by the Stage 6 verifier
}
