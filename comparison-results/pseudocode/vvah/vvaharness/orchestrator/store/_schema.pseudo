// SQL schema of the state DB (runs, checkpoints, ev_replays, ev_probes, callgraph_* tables) and the
// v1->v2 (callgraph tables) and v2->v3 (ev tables) migrations. Rendered as records with their constraints.

@executedBy(CODE) @role(types)
record RunRow(String runId, String repoRoot, String repoName, String appId, String startedAt, String updatedAt) { } // PK run_id // src: vvaharness/orchestrator/store/_schema.py:22

/** One stage's checkpoint blob; size CHECK <= 100 MiB; cascades with its run. */
@executedBy(CODE) @role(types)
record CheckpointRow(String runId, String step, byte[] payload, int size, String createdAt) { } // PK (run_id, step) // src: vvaharness/orchestrator/store/_schema.py:31

/** Confirming EV exchange per verified finding; survives reset_run so a later ev-replay works; size CHECK <= 1 MiB. */
@executedBy(CODE) @role(types)
record EvReplayRow(String runId, String findingKey, byte[] payload, int size, String createdAt) { } // src: vvaharness/orchestrator/store/_schema.py:45

/** Every EV payload sent this run (only when store_probes); credential material redacted by the caller. */
@executedBy(CODE) @role(types)
record EvProbeRow(int id, String runId, String findingKey, String findingTitle, String file, int lineStart, int lineEnd,
                  String cwe, String vulnClass, String evClass, String evSubtype, String evVerdict, String endpointMethod,
                  String endpointPath, String payloadLabel, String injectionPoint, String reqMethod, String reqUrl,
                  String reqQuery, String reqBody, int authed, String authApplied, int respStatus, int respMs,
                  String respSnippet, String createdAt) { }                                            // src: vvaharness/orchestrator/store/_schema.py:61

@executedBy(CODE) @role(types)
record CallgraphSnapshotRow(String runId, String graphId, int nodeCount, int edgeCount, int entryPointCount, int sinkCount, String createdAt) { } // src: vvaharness/orchestrator/store/_schema.py:92

@executedBy(CODE) @role(types)
record CallgraphNodeRow(String runId, String graphId, String qnode, String filePath, String functionName, int startLine,
                        int endLine, int isEntryPoint, String entryKind, int reachableFromUnauth, int isSink, int sinkLine) { } // src: vvaharness/orchestrator/store/_schema.py:103

@executedBy(CODE) @role(types)
record CallgraphEdgeRow(String runId, String graphId, String callerQnode, String calleeQnode) { } // src: vvaharness/orchestrator/store/_schema.py:121

@executedBy(CODE) @role(types)
record CallgraphStageRefRow(String runId, String step, String graphId, String createdAt) { }      // PK (run_id, step) // src: vvaharness/orchestrator/store/_schema.py:131

