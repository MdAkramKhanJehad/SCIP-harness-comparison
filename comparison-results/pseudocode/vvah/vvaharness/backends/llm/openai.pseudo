// file: vvaharness/backends/llm/openai.py
// via: openai -- OpenAI-compatible chat/responses loop with read-only localtools (no Edit/Write: fix mode errors).
// Hard turn cap, one prose re-ask, then a forced-final call that keeps only the submit tool when a schema is forced.

@executedBy(CODE) @role(backend)
class LlmOpenai {

    void configure(String apiKey, String baseUrl, Object verifySsl, String caCert) { }
    void configureCache(Object markers) { }

    @src("vvaharness/backends/llm/openai.py:1589")
    String agentic(Prompt userPrompt, String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, Integer maxTurns, Schema responseModel, Effort effort, Theta θ) {
        int turnsCap = maxTurns != null ? maxTurns : _MAX_TURNS;                                            // src: vvaharness/backends/llm/openai.py:1651
        boolean schemaNudged = false;
        for (int turn = 1; turn <= turnsCap; turn++) {                                                      // src: vvaharness/backends/llm/openai.py:1711
            Message msg = send(userPrompt, systemPrompt, allowedTools);
            if (msg.toolCalls.isEmpty()) {
                if (responseModel != null && !schemaNudged && turn < turnsCap) {                             // src: vvaharness/backends/llm/openai.py:1960
                    schemaNudged = true;
                    append(StructuredOutputPrompts.proseReask(θ));                                          // src: vvaharness/backends/llm/openai.py:1966
                    continue;
                }
                return msg.text;
            }
            dispatchTools(msg);
        }
        Counters.bump("llm_turn_cap_exhausted");                                                            // src: vvaharness/backends/llm/openai.py:2054
        // forced-final drops tools; with a schema the submit tool is kept alone and required
        append(OpenaiTurnCapPrompt.finalAnswer(responseModel != null, θ));                                  // src: vvaharness/backends/llm/openai.py:2075
        return sendForcedFinal(responseModel);                                                              // src: vvaharness/backends/llm/openai.py:2081
    }

    Message send(Prompt user, Prompt system, List<String> tools) { }
    String sendForcedFinal(Schema responseModel) { }
    void append(Prompt p) { }
    void dispatchTools(Message msg) { }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/openai.py:2069")
class OpenaiTurnCapPrompt {

    Prompt finalAnswer(boolean hasResponseModel, Theta θ) {
        Prompt p = new Prompt();
        if (hasResponseModel) p.must(θ["p.openai.turn_cap_forced_structured_answer"]);                      // "Tool budget exhausted. Call emit_structured_response now with what you have established so far; it is the only way to reply." // src: vvaharness/backends/llm/openai.py:2071
        else p.must(θ["p.openai.turn_cap_forced_text_answer"]);                                             // "Tool budget exhausted. Reply now with your final answer ...; do not call tools." // src: vvaharness/backends/llm/openai.py:2073
        return p;
    }
}
