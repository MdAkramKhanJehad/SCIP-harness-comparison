// file: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md
// S11 skill (injected into .claude/skills on Claude routes): condensed copy of the scoring matrix, isolation,
// anti-manipulation, code-level-signals and secret-exposure rules, plus the read-only output contract.

@executedBy(MODEL) @role(skill) @stage("S11")
class ValidationScoringSkill {

    Prompt run(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_validation-scoring.skill_description_trigger"]) p.context("description: apply the s11 fix-validation scoring matrix, adversarial-review rules, and structured-output contract"); // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:3
        if (θ["p.skill_validation-scoring.use_whenever_validating"]) p.rule("use this skill whenever validating a remediation patch in a read-only session"); // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:24
        p.include(outputContract(θ));
        p.include(scoring(θ));
        p.include(isolationAndManipulation(θ));
        p.include(codeLevelSignals(θ));
        p.include(secretExposure(θ));
        return p;
    }

    Prompt outputContract(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_validation-scoring.no_write_tool"]) p.forbid("use any Write tool; the session is read-only"); // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:28
        p.format(θ["p.skill_validation-scoring.top_level_fields"]);                                              // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:30
        return p;
    }

    Prompt scoring(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.skill_validation-scoring.weights_copy"]);                                               // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:38
        p.threshold(θ["p.skill_validation-scoring.multipliers_copy_no_skip"]);                                   // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:47
        p.threshold(θ["p.skill_validation-scoring.thresholds_copy"]);                                            // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:55
        p.rule(θ["p.skill_validation-scoring.unverifiable_conditions"]);                                         // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:59
        p.format(θ["p.skill_validation-scoring.merge_readiness_copy"]);                                          // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:67
        return p;
    }

    Prompt isolationAndManipulation(Theta θ) {
        Prompt p = new Prompt();
        p.rule("each persona analyzes independently; orchestrator synthesizes; personas do not reference each other"); // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:71
        p.forbid(θ["p.skill_validation-scoring.anti_manipulation_examples"]);                                    // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:75
        if (θ["p.skill_validation-scoring.cite_file_line_every_gate"]) p.evidence("file:line for every gate");   // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:75
        return p;
    }

    Prompt codeLevelSignals(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.skill_validation-scoring.code_level_controls_list"]);                                   // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:79
        if (θ["p.skill_validation-scoring.recommendations_code_level_only"]) p.format("recommendations must be code-level hardening only"); // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:79
        return p;
    }

    Prompt secretExposure(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.skill_validation-scoring.secret_scope_hardcoded_only"]) p.context("for hardcoded credential findings only"); // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:83
        // unclear: grepping the leaked value conflicts with scoring-matrix.md:154 (never search for the removed plaintext).
        p.step(1, θ["p.skill_validation-scoring.secret_grep_leaked_value"]);                                     // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:84
        p.evidence(θ["p.skill_validation-scoring.attestation_acceptance_skill"]);                                // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:85
        p.tiebreak(θ["p.skill_validation-scoring.attestation_missing_cap_skill"]);                               // src: vvaharness/validation/claude_config/skills/validation-scoring/SKILL.md:86
        return p;
    }
}
