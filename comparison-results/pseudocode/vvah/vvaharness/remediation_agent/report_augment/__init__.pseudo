// file: vvaharness/remediation_agent/report_augment/__init__.py
// Augment the combined SARIF and Markdown scan report with remediation results; best-effort, never fails the run.

@executedBy(CODE) @role(step) @stage("S10")
class ReportAugment {

    void augmentReports(Path repo, Path reportMd, Theta θ) {                                         // reportMd optional
        try {
            augment(Path.of(repo), reportMd != null ? Path.of(reportMd) : null, θ);                  // src: vvaharness/remediation_agent/report_augment/__init__.py:39
        } catch (Exception e) {                                                                      // augmentation must never fail the remediation run
            Logging.exception("remediation report augmentation failed; results not written to combined report"); // src: vvaharness/remediation_agent/report_augment/__init__.py:45
        }
    }

    void augment(Path repo, Path reportMd, Theta θ) {
        Path remDir = Artifacts.artifactDir(repo, ReportParser.REMEDIATION_DIR_NAME);                // refuses a symlinked or non-directory dir; the broad except above logs it as a skip // src: vvaharness/remediation_agent/report_augment/__init__.py:48
        List<CaseRecord> records = remDir.isDir() ? Dto.loadCases(remDir, θ) : List.of();            // src: vvaharness/remediation_agent/report_augment/__init__.py:50
        if (records.isEmpty()) { Logging.info("no remediation cases - skipping report augmentation"); return; } // src: vvaharness/remediation_agent/report_augment/__init__.py:52
        Tuple located = Locate.locateScanReport(repo, reportMd, θ);                                  // src: vvaharness/remediation_agent/report_augment/__init__.py:55
        if (located == null) { Logging.warning("no scan report - skipping report augmentation"); return; } // src: vvaharness/remediation_agent/report_augment/__init__.py:57
        Tuple dst = Locate.ensureCombined(repo, located.sarif, located.md);                          // src: vvaharness/remediation_agent/report_augment/__init__.py:59
        Map<Integer, CaseRecord> ordinalMatches = Sarif.augmentSarif(dst.sarif, records, θ);         // SARIF first so MD can reuse its ordinal matches // src: vvaharness/remediation_agent/report_augment/__init__.py:62
        Markdown.augmentMd(dst.md, records, ordinalMatches, θ);                                      // src: vvaharness/remediation_agent/report_augment/__init__.py:64
        Logging.info("remediation results written to combined report");                              // src: vvaharness/remediation_agent/report_augment/__init__.py:66
    }
}
