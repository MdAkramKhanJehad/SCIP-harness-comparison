// file: vvaharness/models/derive.py
// Pure decisions computed from a case: case state from attempts, merge readiness from a verdict.

@executedBy(CODE) @role(rule_set) @stage("S11")
class Derive {

    CaseState kindState(RemediationKind kind) {
        // _KIND_STATE: an unvalidated attempt's state follows what the engine did
        // EDITS_APPLIED, DIFF_PROPOSED, PULL_REQUEST, ALREADY_RESOLVED -> REMEDIATED; NO_ACTION -> DECLINED
        return θ["code.models.derive.kind_state_map"].get(kind);                                    // src: vvaharness/models/derive.py:38
    }

    CaseState verdictState(Verdict verdict) {
        if (verdict.ticket != null) return CaseState.PENDING;                                       // src: vvaharness/models/derive.py:62
        if (θ["code.models.derive.closing_dispositions"].contains(verdict.disposition)) return CaseState.DECLINED; // src: vvaharness/models/derive.py:64
        // _DECISION_STATE: FIXED->VALIDATED, PARTIALLY_FIXED->FAILED, NOT_FIXED->FAILED, INCONCLUSIVE->OPEN (re-validatable)
        return θ["code.models.derive.decision_state_map"].get(verdict.decision);                    // src: vvaharness/models/derive.py:66
    }

    CaseState attemptState(Attempt attempt) {
        if (attempt.verdict == null) return kindState(attempt.remediation.kind);                    // src: vvaharness/models/derive.py:72
        return verdictState(attempt.verdict);                                                       // src: vvaharness/models/derive.py:73
    }

    CaseState stateOf(List<Attempt> attempts) {
        // The LAST attempt rules, not the best one ever seen.
        if (attempts.isEmpty()) return CaseState.OPEN;                                              // src: vvaharness/models/derive.py:79
        return attemptState(attempts.last());                                                       // src: vvaharness/models/derive.py:80
    }

    MergeReadiness readinessForScore(double score, ScoringPolicy policy) {
        if (score >= policy.readyAt) return MergeReadiness.READY;                                   // src: vvaharness/models/derive.py:85
        if (score >= policy.conditionalAt) return MergeReadiness.READY_WITH_CONDITIONS;             // src: vvaharness/models/derive.py:87
        return MergeReadiness.NOT_READY;                                                            // src: vvaharness/models/derive.py:89
    }

    MergeReadiness lowest(List<MergeReadiness> readiness) {
        // _RANK: NOT_READY 0 < READY_WITH_CONDITIONS 1 < READY 2; every rule can only lower the bar
        return readiness.minBy(r -> RANK.get(r));                                                   // src: vvaharness/models/derive.py:110
    }

    MergeReadiness mergeReadinessFor(Verdict verdict, ScoringPolicy policy) {
        // _DECISION_READINESS ceiling: FIXED->READY, PARTIALLY_FIXED->READY_WITH_CONDITIONS, NOT_FIXED/INCONCLUSIVE->NOT_READY
        MergeReadiness ceiling = θ["code.models.derive.decision_readiness_ceiling"].get(verdict.decision); // src: vvaharness/models/derive.py:117
        if (!verdict.conditions.isEmpty()) ceiling = lowest(List.of(ceiling, MergeReadiness.READY_WITH_CONDITIONS)); // src: vvaharness/models/derive.py:119
        if (verdict.score == null) return ceiling;                                                  // src: vvaharness/models/derive.py:121
        return lowest(List.of(ceiling, readinessForScore(verdict.score, policy != null ? policy : ModelsContext.defaults(θ)))); // src: vvaharness/models/derive.py:122
    }
}
