// file: vvaharness/remediation_agent/policy_gate/gate.py, vvaharness/remediation_agent/policy_gate/loader.py, vvaharness/remediation_agent/policy_gate/action.py, vvaharness/remediation_agent/policy_gate/matching.py, vvaharness/remediation_agent/policy_gate/diffscan.py, vvaharness/remediation_agent/policy/postgate.py, inputs/remediation_policy.yaml
// Deterministic eligibility gate (pre-gate, before any model call) and the post-gate that reverts forbidden edits.
// Evaluation order: kill_switch -> deny -> deny_paths -> allow -> default_action. Missing/invalid policy fails closed.

@executedBy(CODE) @role(types)
enum Action { PATCH, GUIDANCE_ONLY }

@executedBy(CODE) @role(rule_set) @stage("S10")
class RemediationAgentPolicyGate {

    RemediationGate load(String policyPath, Theta θ) {
        PolicyData d = parsePolicy(policyPath != null ? policyPath : "inputs/remediation_policy.yaml", θ); // src: vvaharness/remediation_agent/policy_gate/gate.py:47
        return new RemediationGate(d, d != null);                                                   // src: vvaharness/remediation_agent/policy_gate/gate.py:49
    }

    PolicyData parsePolicy(String path, Theta θ) {
        Map doc = Yaml.safeLoad(path);                                                              // src: vvaharness/remediation_agent/policy_gate/loader.py:53
        if (doc == null) return null;                                                               // src: vvaharness/remediation_agent/policy_gate/loader.py:56  (load error -> fail-closed)
        PolicyData data = new PolicyData();
        // default_action: allow -> patch all but denied; deny -> allow-list only. Shipped yaml: allow (code fallback when key absent: deny).
        String def = θ["policy.default_action"];                                                    // src: inputs/remediation_policy.yaml:36
        data.defaultAction = def.equals("allow") ? PATCH : GUIDANCE_ONLY;                           // src: vvaharness/remediation_agent/policy_gate/loader.py:61
        for (Map entry : doc.get("deny")) {                                                         // src: vvaharness/remediation_agent/policy_gate/loader.py:63  (shipped list empty)
            String cwe = normCwe(entry.get("id"));
            if (cwe == null) continue;
            data.deny.put(cwe, entry.getOr("reason", "policy_denied"));                             // src: vvaharness/remediation_agent/policy_gate/loader.py:68
            for (Object child : entry.get("descendants")) data.deny.putIfAbsent(normCwe(child), "descendant_of:" + cwe); // src: vvaharness/remediation_agent/policy_gate/loader.py:72
        }
        for (Map entry : doc.get("allow")) data.allow.add(normCwe(entry.get("id")));                // src: vvaharness/remediation_agent/policy_gate/loader.py:77
        data.denyPaths = doc.get("deny_paths");                                                     // src: vvaharness/remediation_agent/policy_gate/loader.py:79  (shipped list empty)
        data.forbidPatchPaths = doc.get("forbid_patch_paths");                                      // src: vvaharness/remediation_agent/policy_gate/loader.py:80  (shipped: .git, CI configs, hooks ...)
        data.killEnv = doc.get("kill_switch").get("env_var");                                       // src: vvaharness/remediation_agent/policy_gate/loader.py:82  (VVAHARNESS_REMEDIATE_DISABLE)
        data.killFile = doc.get("kill_switch").get("file");                                         // src: vvaharness/remediation_agent/policy_gate/loader.py:84  (./.vvaharness-remediate-off)
        return data;
    }

    String normCwe(Object raw) {
        // 943 / CWE-943 / cwe-943 -> CWE-943; non-numeric -> null
        String s = String.valueOf(raw).strip().upper().removePrefix("CWE-");                        // src: vvaharness/remediation_agent/policy_gate/loader.py:33
        return s.isDigit() ? "CWE-" + s : null;                                                     // src: vvaharness/remediation_agent/policy_gate/loader.py:35
    }

    Decision decide(RemediationGate gate, String cweId, String filePath) {
        PolicyData d = gate.data;
        if (!gate.loaded || d == null) return new Decision(GUIDANCE_ONLY, "policy_unavailable_fail_closed"); // src: vvaharness/remediation_agent/policy_gate/gate.py:65
        // 0. kill-switch, checked on every call
        if (d.killEnv != null && Env.get(d.killEnv).lower() in List.of("1", "true", "yes", "on")) return new Decision(GUIDANCE_ONLY, "kill_switch_env"); // src: vvaharness/remediation_agent/policy_gate/gate.py:68
        if (d.killFile != null && Path.exists(d.killFile)) return new Decision(GUIDANCE_ONLY, "kill_switch_file"); // src: vvaharness/remediation_agent/policy_gate/gate.py:70
        String cwe = normCwe(cweId);                                                                // src: vvaharness/remediation_agent/policy_gate/gate.py:73
        if (cwe == null) return new Decision(GUIDANCE_ONLY, "unmapped_cwe");                        // src: vvaharness/remediation_agent/policy_gate/gate.py:75
        // 1. deny-list (incl. descendants): absolute
        if (d.deny.containsKey(cwe)) return new Decision(GUIDANCE_ONLY, d.deny.get(cwe));           // src: vvaharness/remediation_agent/policy_gate/gate.py:78
        // 2. sensitive-path guard: blocks even allowed CWEs
        for (String pat : d.denyPaths) {                                                            // src: vvaharness/remediation_agent/policy_gate/gate.py:84
            if (globMatch(filePath, pat)) return new Decision(GUIDANCE_ONLY, "sensitive_path:" + pat); // src: vvaharness/remediation_agent/policy_gate/gate.py:86
        }
        // 3. allow-list
        if (d.allow.contains(cwe)) return new Decision(PATCH, "allow_list");                        // src: vvaharness/remediation_agent/policy_gate/gate.py:92
        // 4. default
        return new Decision(d.defaultAction, "default_action");                                     // src: vvaharness/remediation_agent/policy_gate/gate.py:96
    }

    boolean globMatch(String path, String pat) {
        if (Fnmatch.match(path, pat)) return true;                                                  // src: vvaharness/remediation_agent/policy_gate/matching.py:23
        return pat.startsWith("**/") && Fnmatch.match(path, pat.substring(3));                      // src: vvaharness/remediation_agent/policy_gate/matching.py:25
    }

    List<String> forbiddenFiles(RemediationGate gate, List<String> changed) {
        return changed.filter(f -> gate.forbidPatchPaths.any(p -> globMatch(f, p)) || gate.denyPaths.any(p -> globMatch(f, p))); // src: vvaharness/remediation_agent/policy_gate/gate.py:114
    }

    String capVerdict(Action action, boolean allGatesPassed) {
        if (action == GUIDANCE_ONLY) return "REJECT";                                               // src: vvaharness/remediation_agent/policy_gate/diffscan.py:60
        return allGatesPassed ? "ACCEPT" : "REJECT";                                                // src: vvaharness/remediation_agent/policy_gate/diffscan.py:62
    }

    PostResult enforcePost(PolicyContext ctx, RemediationTarget target, Verdict v, PreResult pre, String repo, Snapshot before) {
        // Observe the whole working tree, not just what the agent reported.
        List<String> wholeTree = Artifacts.changedFilesWholeTree(repo);                             // src: vvaharness/remediation_agent/policy/postgate.py:112
        String diff = Artifacts.captureGitDiff(repo, v.changes.map(c -> c.file).plus(wholeTree), before); // src: vvaharness/remediation_agent/policy/postgate.py:136
        List<String> candidates = DiffScan.inspectDiff(diff).plus(wholeTree);                       // src: vvaharness/remediation_agent/policy/postgate.py:140
        List<String> forbidden = forbiddenFiles(ctx.gate, candidates);                              // src: vvaharness/remediation_agent/policy/postgate.py:143
        List<String> unsafeRefs = WorkflowRefs.introducedUnsafeWorkflowRefs(repo, before);          // src: vvaharness/remediation_agent/policy/postgate.py:151
        List<String> unsafeContent = PatchContent.scanAddedLines(diff);                             // src: vvaharness/remediation_agent/policy/postgate.py:155
        List<String> bad = forbidden.plus(unsafeRefs).plus(unsafeContent);                          // src: vvaharness/remediation_agent/policy/postgate.py:156
        if (bad.isEmpty()) {                                                                        // src: vvaharness/remediation_agent/policy/postgate.py:159
            // ACCEPT needs the agent's own three gates = pass, a non-empty diff, and verdict Fixed/Partially Fixed.
            boolean gatesPassed = v.gates.source == "pass" && v.gates.sink == "pass" && v.gates.missingControl == "pass" && !diff.isBlank() && v.verdict in List.of("Fixed", "Partially Fixed"); // src: vvaharness/remediation_agent/policy/postgate.py:162
            return new PostResult(List.of(), capVerdict(pre.decision.action, gatesPassed));         // src: vvaharness/remediation_agent/policy/postgate.py:165
        }
        List<String> reverted = Policy.revertFiles(repo, bad, before);                              // src: vvaharness/remediation_agent/policy/postgate.py:168
        // Post-gate revert is partial: route to a human (not Denied, which the pre-gate owns).
        return new PostResult(reverted, "REJECT");                                                  // src: vvaharness/remediation_agent/policy/postgate.py:204
    }
}
