# vvaharness/remediation_agent/rule_paths.py

Locates the two remediation rule files (`remediation_policy.yaml`, `remediation_playbook.yaml`) across a source checkout, an installed package and a user-configured inputs folder.

Source: `vvaharness/remediation_agent/rule_paths.py` (lines 1-81)
Executor: code
Called from: `playbook.sudo` and `policy_gate/gate.sudo` (default paths at import); `vvaharness/cli/_setup.py`, `vvaharness/util/environment.py` (setup and checks)

// src: vvaharness/remediation_agent/rule_paths.py:23
RULE_FILES = ["remediation_policy.yaml", "remediation_playbook.yaml"]

// src: vvaharness/remediation_agent/rule_paths.py:26-31
fn settings_path() = environment VVAHARNESS_SETTINGS_FILE (user-expanded) if set, else "${XDG_CONFIG_HOME or ~/.config}/vvaharness/settings.json"

// src: vvaharness/remediation_agent/rule_paths.py:34-40
fn configured_inputs_dir() = settings_path() JSON field "inputs_dir" (user-expanded), or null on any read or parse error

// src: vvaharness/remediation_agent/rule_paths.py:59-66
fn candidate_inputs_dirs(package_file):executor=code {
  ordered = [<harness repository root>/inputs, <sys.prefix>/share/vvaharness/rules, configured_inputs_dir()]
  return ordered without nulls and without repeats, order kept
  // package_file is ignored (kept for a stable call surface)
}

// src: vvaharness/remediation_agent/rule_paths.py:69-71
fn locate_rule(filename, package_file):executor=code {
  candidates = candidate_inputs_dirs(package_file) |> map(d => d/filename)
  return first candidate that is a file, else candidates[0]   // a missing file still yields a path; the loaders then fail closed (policy) or load nothing (playbook)
  // preserved: the user-configured inputs folder is searched LAST, so it cannot override a file present in the source checkout or the installed share folder
}

// src: vvaharness/remediation_agent/rule_paths.py:43-56, 74-81
// abstracted: save_inputs_dir writes "inputs_dir" into settings.json (merging existing keys); missing_rules and validate_inputs_dir list which RULE_FILES are absent. Setup helpers, no remediation decision.
