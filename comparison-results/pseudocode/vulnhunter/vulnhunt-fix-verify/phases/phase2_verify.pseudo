// file: vulnhunt-fix-verify/phases/phase2_verify.md
// Fix-verify phase 2: per-VULN static verification through four gates (sink_mitigated, reachability,
// class_eliminated, sweep_complete), verdict mapping, issue_comment templates, disposition_VULN-NNN.json.

@executedBy(MODEL) @role(stage) @stage("FV2")
class Phase2Verify {

    // One finding at a time (inline) or as a per-VULN subagent.
    Disposition run(String findingId, Bound b, Theta θ) {
        if (θ["p.phase2_verify.one_finding_at_a_time"]) b.scopeTo(findingId);                  // src: vulnhunt-fix-verify/phases/phase2_verify.md:7
        if (θ["p.phase2_verify.no_nested_subagents"] && b.isSubagent) b.disallow("Agent");      // src: vulnhunt-fix-verify/phases/phase2_verify.md:22
        Section sec = setup(findingId, b, θ);                                                    // src: vulnhunt-fix-verify/phases/phase2_verify.md:25
        if (sec == null) {
            if (θ["p.phase2_verify.missing_section_stub"]) {                                     // src: vulnhunt-fix-verify/phases/phase2_verify.md:35
                Disposition stub = Disposition.stub(findingId, "INCONCLUSIVE", "extracted section missing or malformed").allGates("skipped");
                Tools.write(b.OUT + "/disposition_" + findingId + ".json", stub);
                return stub;
            }
        }
        Gates g = new Gates();
        List<Evidence> ev = new List();
        List<String> order = θ["p.phase2_verify.gates_in_order"];                               // src: vulnhunt-fix-verify/phases/phase2_verify.md:47
        List<String> gateNames = θ["prompt.fix_verify.gates"];                                  // src: vulnhunt-fix-verify/phases/phase2_verify.md:58
        Gate1Result g1 = gate1SinkMitigated(sec, b, ev, θ);                                      // src: vulnhunt-fix-verify/phases/phase2_verify.md:58
        g.sinkMitigated = g1.outcome;
        g.reachability = gate2Reachability(sec, g1, b, ev, θ);                                   // src: vulnhunt-fix-verify/phases/phase2_verify.md:88
        g.classEliminated = gate3ClassEliminated(sec, g1, b, ev, θ);                             // src: vulnhunt-fix-verify/phases/phase2_verify.md:114
        List<String> regressions = new List();
        g.sweepComplete = gate4SweepComplete(sec, b, ev, regressions, θ);                        // src: vulnhunt-fix-verify/phases/phase2_verify.md:134
        for (String gate : order) {
            if (ev.forGate(gate).size() < θ["p.phase2_verify.gate_min_evidence"]) ev.add(new Evidence(gate, "<file:line>", "<detail>")); // src: vulnhunt-fix-verify/phases/phase2_verify.md:48
        }
        checkClaims(sec, ev, θ);                                                                 // src: vulnhunt-fix-verify/phases/phase2_verify.md:403
        String verdict = mapVerdict(g, g1, θ);                                                   // src: vulnhunt-fix-verify/phases/phase2_verify.md:162
        Disposition d = writeDisposition(findingId, verdict, g, ev, regressions, sec, g1, b, θ); // src: vulnhunt-fix-verify/phases/phase2_verify.md:174
        return d;
    }

    // ---------------- prompt sections ----------------

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase2_verify.one_finding_at_a_time"]) p.must("stay scoped to one finding's work at a time"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:7
        if (θ["p.phase2_verify.read_only_own_section"]) p.must("read only the ## <FINDING_ID> section of EXTRACTED"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:18
        if (θ["p.phase2_verify.no_nested_subagents"]) p.forbid("a dispatched subagent must not dispatch further subagents"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:22
        p.rule(θ["p.phase2_verify.section_read_paging"]);                                        // src: vulnhunt-fix-verify/phases/phase2_verify.md:30
        p.rule(θ["p.phase2_verify.poc_read_once_optional"]);                                     // src: vulnhunt-fix-verify/phases/phase2_verify.md:40
        if (θ["p.phase2_verify.no_exploit_test_read"]) p.forbid("do not read the exploit-test file in v1"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:41
        p.checklist(θ["p.phase2_verify.gates_in_order"]);                                        // src: vulnhunt-fix-verify/phases/phase2_verify.md:47
        p.evidence("at least " + θ["p.phase2_verify.gate_min_evidence"] + " evidence entry with file:line per gate"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:48
        if (θ["p.phase2_verify.trace_into_additional_repos"]) p.rule("trace may Read/Grep into ADDITIONAL_REPOS"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:52
        if (θ["p.phase2_verify.sweep_scoped_to_repo"]) p.rule("sweep (gate 4) stays scoped to REPO"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:55
        if (θ["p.phase2_verify.never_read_outside_trusted_roots"]) p.forbid("never read outside the trusted roots"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:56
        if (θ["p.phase2_verify.gate1_question"]) p.rule("Gate 1: does the sink now use a safe API, or is input sanitized at a chokepoint?"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:60
        if (θ["p.phase2_verify.gate2_question"]) p.rule("Gate 2: is the entry point still wired to the mitigated sink path?"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:90
        if (θ["p.phase2_verify.gate3_question"]) p.rule("Gate 3: does the fix eliminate the class or only block the PoC payload?"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:116
        if (θ["p.phase2_verify.gate4_question"]) p.rule("Gate 4: do other instances of the sweep pattern remain unfixed?"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:136
        p.include(verdictMappingPrompt(θ));
        p.include(dispositionShapePrompt(θ));
        p.include(whatNotToDo(θ));
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt verdictMappingPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.phase2_verify.verdict_fixed_condition"]);                                    // src: vulnhunt-fix-verify/phases/phase2_verify.md:166
        if (θ["p.phase2_verify.na_gates_treated_as_passing"]) p.rule("n/a gates are treated as passing"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:166
        p.rule(θ["p.phase2_verify.verdict_not_fixed_condition"]);                                // src: vulnhunt-fix-verify/phases/phase2_verify.md:167
        p.rule(θ["p.phase2_verify.verdict_partial_condition"]);                                  // src: vulnhunt-fix-verify/phases/phase2_verify.md:168
        p.rule(θ["p.phase2_verify.verdict_inconclusive_condition"]);                             // src: vulnhunt-fix-verify/phases/phase2_verify.md:169
        p.threshold(θ["p.phase2_verify.inconclusive_skipped_gate_count"]);                       // src: vulnhunt-fix-verify/phases/phase2_verify.md:169
        if (θ["p.phase2_verify.invalid_input_not_emitted_here"]) p.forbid("never emit INVALID_INPUT in phase 2"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:171
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt dispositionShapePrompt(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.phase2_verify.verdict_set"]);                                              // src: vulnhunt-fix-verify/phases/phase2_verify.md:182
        p.format(θ["p.phase2_verify.rationale_length"]);                                         // src: vulnhunt-fix-verify/phases/phase2_verify.md:183
        p.choose(θ["p.phase2_verify.gate_outcome_values"]);                                      // src: vulnhunt-fix-verify/phases/phase2_verify.md:186
        p.choose(θ["p.phase2_verify.evidence_kinds"]);                                           // src: vulnhunt-fix-verify/phases/phase2_verify.md:193
        p.format(θ["p.phase2_verify.evidence_detail_one_sentence"]);                             // src: vulnhunt-fix-verify/phases/phase2_verify.md:195
        if (θ["p.phase2_verify.regressions_only_on_sweep_fail"]) p.format("regressions only when sweep_complete = fail; omit otherwise"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:202
        if (θ["p.phase2_verify.rationale_and_issue_comment_required"]) p.must("rationale and issue_comment are both required"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:205
        if (θ["p.phase2_verify.follow_issue_comment_templates"]) p.must("follow the issue comment templates; keep heading, gate checklist and trailer"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:213
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt whatNotToDo(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase2_verify.no_exploit_test_run"]) p.forbid("do not run the exploit test; v1 is static only"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:401
        if (θ["p.phase2_verify.no_repo_modification"]) p.forbid("do not modify REPO");          // src: vulnhunt-fix-verify/phases/phase2_verify.md:402
        if (θ["p.phase2_verify.code_wins_over_claim"]) p.tiebreak("code contradicts an accepted claim -> code wins"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:403
        if (θ["p.phase2_verify.note_claim_contradiction"]) p.evidence("note contradiction as kind rule_check, location comments:<line>"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:407
        if (θ["p.phase2_verify.no_pass_on_absence_of_evidence"]) p.forbid("do not mark pass because no evidence of failure was found"); // src: vulnhunt-fix-verify/phases/phase2_verify.md:408
        p.rule(θ["p.phase2_verify.unconfirmed_means_skipped"]);                                  // src: vulnhunt-fix-verify/phases/phase2_verify.md:410
        return p;
    }

    // ---------------- procedure ----------------

    @executedBy(MODEL)
    Section setup(String id, Bound b, Theta θ) {
        String extracted = b.OUT + "/extracted_findings.md";
        int start = Tools.grep("^## " + id + "$", extracted).firstLine();                        // src: vulnhunt-fix-verify/phases/phase2_verify.md:27
        if (start < 0) return null;
        String text = "";
        int off = start;
        while (true) {                                                                           // src: vulnhunt-fix-verify/phases/phase2_verify.md:29
            String page = Tools.read(extracted, off, θ["p.phase2_verify.section_read_paging"]);  // src: vulnhunt-fix-verify/phases/phase2_verify.md:30
            text += page.untilNextHeading("^## VULN-");
            if (page.reachedNextHeadingOrEof()) break;   // never truncate at a hard cap
            off += page.lines();
        }
        if (θ["p.phase2_verify.read_only_own_section"] == false) text = Tools.read(extracted);   // src: vulnhunt-fix-verify/phases/phase2_verify.md:18
        Section sec = Section.parse(text);
        if (sec.malformed()) return null;
        if (sec.pocPath != "missing" && θ["p.phase2_verify.poc_read_once_optional"] != null) sec.pocContext = Tools.read(sec.pocPath); // src: vulnhunt-fix-verify/phases/phase2_verify.md:40
        if (!θ["p.phase2_verify.no_exploit_test_read"]) sec.exploitTest = Tools.read(sec.exploitTestPath); // src: vulnhunt-fix-verify/phases/phase2_verify.md:41
        return sec;
    }

    @executedBy(MODEL)
    Gate1Result gate1SinkMitigated(Section sec, Bound b, List<Evidence> ev, Theta θ) {
        Gate1Result r = new Gate1Result();
        Location loc = sec.location;
        String code = Tools.read(b.REPO + "/" + loc.file, θ["p.phase2_verify.gate1_read_window"]); // src: vulnhunt-fix-verify/phases/phase2_verify.md:67
        if (code == null || !code.containsFunction(sec.sinkFunction)) {                          // src: vulnhunt-fix-verify/phases/phase2_verify.md:68
            Location succ = θ["p.phase2_verify.gate1_successor_search"] ? Tools.grep(sec.identifyingSymbol(), b.REPO).first() : null; // src: vulnhunt-fix-verify/phases/phase2_verify.md:70
            if (succ == null) {
                r.locationAbsent = true;
                if (θ["p.phase2_verify.gate1_skip_when_no_successor"]) {                         // src: vulnhunt-fix-verify/phases/phase2_verify.md:73
                    ev.add(new Evidence("sink_inspection", loc, "original location absent; no successor found"));
                    r.outcome = "skipped"; return r;
                }
            }
            loc = succ; code = Tools.read(b.REPO + "/" + succ.file, θ["p.phase2_verify.gate1_read_window"]);
        }
        List<String> roots = θ["p.phase2_verify.trace_into_additional_repos"] ? b.trustedRoots : List.of(b.REPO); // src: vulnhunt-fix-verify/phases/phase2_verify.md:52
        if (code.sinkUsesAny(θ["p.phase2_verify.gate1_pass_safe_api"])) r.outcome = "pass";       // src: vulnhunt-fix-verify/phases/phase2_verify.md:76
        else if (θ["p.phase2_verify.gate1_pass_chokepoint"] && traceDataFlow(sec, roots, sec.claims).sanitizedAtChokepoint()) r.outcome = "pass"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:77
        else if (θ["p.phase2_verify.gate1_fail_same_construct"] && code.sameDangerousConstruct(sec)) r.outcome = "fail"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:82
        else r.outcome = θ["p.phase2_verify.unconfirmed_means_skipped"];                          // src: vulnhunt-fix-verify/phases/phase2_verify.md:410
        if (θ["p.phase2_verify.no_pass_on_absence_of_evidence"] && r.outcome == "pass" && !code.positiveEvidence()) r.outcome = "skipped"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:408
        if (θ["p.phase2_verify.gate1_cite_and_quote_construct"]) ev.add(new Evidence("sink_inspection", loc, "<quoted construct>")); // src: vulnhunt-fix-verify/phases/phase2_verify.md:84
        r.location = loc;
        return r;
    }

    @executedBy(MODEL)
    String gate2Reachability(Section sec, Gate1Result g1, Bound b, List<Evidence> ev, Theta θ) {
        Location handler = Tools.grep(sec.entryPoint.routeOrSymbol(), b.REPO).first();           // src: vulnhunt-fix-verify/phases/phase2_verify.md:95
        Trace t = traceCallChain(handler, g1.location, θ["p.phase2_verify.gate2_coarse_trace"]); // src: vulnhunt-fix-verify/phases/phase2_verify.md:99
        if (t.pathDeleted()) {
            if (θ["p.phase2_verify.gate2_deleted_path_counts_as_fixed"]) { sec.rationaleFlags.add("code path removed"); return "pass"; } // src: vulnhunt-fix-verify/phases/phase2_verify.md:104
        }
        if (t.undeterminable()) {
            if (θ["p.phase2_verify.gate2_skip_dynamic_routing"]) { ev.add(new Evidence("data_flow_trace", handler, "reachability undeterminable (dynamic dispatch)")); return "skipped"; } // src: vulnhunt-fix-verify/phases/phase2_verify.md:109
        }
        if (t.reachesMitigatedSink()) {
            ev.addAll(t.intermediates().take(θ["p.phase2_verify.gate2_pass_cite_intermediate"]).map(l -> new Evidence("data_flow_trace", l, "<step>"))); // src: vulnhunt-fix-verify/phases/phase2_verify.md:102
            return "pass";
        }
        return "fail";  // unclear: the prompt lists no explicit fail outcome for gate 2
    }

    @executedBy(MODEL)
    String gate3ClassEliminated(Section sec, Gate1Result g1, Bound b, List<Evidence> ev, Theta θ) {
        String fix = Tools.read(b.REPO + "/" + g1.location.file);                                // src: vulnhunt-fix-verify/phases/phase2_verify.md:121
        String out = "skipped";
        if (θ["p.phase2_verify.gate3_pass_class_neutralized"] && fix.neutralizesClass(sec.cwe)) out = "pass";   // src: vulnhunt-fix-verify/phases/phase2_verify.md:123
        else if (θ["p.phase2_verify.gate3_fail_poc_only"] && fix.blocksOnlyLiteralPayload(sec.pocContext)) out = "fail"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:127
        if (θ["p.phase2_verify.gate3_explain_why"]) ev.add(new Evidence("sink_inspection", g1.location, "<why the fix does/doesn't eliminate the class>")); // src: vulnhunt-fix-verify/phases/phase2_verify.md:131
        return out;
    }

    @executedBy(MODEL)
    String gate4SweepComplete(Section sec, Bound b, List<Evidence> ev, List<String> regressions, Theta θ) {
        if (θ["p.phase2_verify.gate4_na_without_sweep_group"] && sec.sweepRootCause == "none" && sec.sweepPattern == "none") return "n/a"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:141
        if (sec.patternTooBroad()) {
            if (θ["p.phase2_verify.gate4_skip_broad_pattern"]) { ev.add(new Evidence("sweep_grep", null, "<why pattern too broad>")); return "skipped"; } // src: vulnhunt-fix-verify/phases/phase2_verify.md:159
        }
        String scope = θ["p.phase2_verify.sweep_scoped_to_repo"] ? b.REPO : b.trustedRoots;      // src: vulnhunt-fix-verify/phases/phase2_verify.md:55
        List<Location> matches = θ["p.phase2_verify.gate4_grep_recorded_pattern"] ? Tools.grep(sec.sweepPattern, scope) : List.of(); // src: vulnhunt-fix-verify/phases/phase2_verify.md:143
        for (Location m : matches) {                                                             // src: vulnhunt-fix-verify/phases/phase2_verify.md:144
            if (θ["p.phase2_verify.gate4_sibling_findings_ignored"] && m.isSeparateReportedVuln()) continue; // src: vulnhunt-fix-verify/phases/phase2_verify.md:145
            String code = Tools.read(m.file, m.line);
            if (θ["p.phase2_verify.gate4_fixed_match_ok"] && code.isSafeConstruct()) continue;   // src: vulnhunt-fix-verify/phases/phase2_verify.md:152
            if (θ["p.phase2_verify.gate4_new_instance_fails"] && !m.inReport() && code.looksVulnerable()) { // src: vulnhunt-fix-verify/phases/phase2_verify.md:149
                if (θ["p.phase2_verify.gate4_fail_populates_regressions"]) regressions.add(m.toString()); // src: vulnhunt-fix-verify/phases/phase2_verify.md:156
                else regressions.add(m.toString());
            }
        }
        ev.add(new Evidence("sweep_grep", matches.first(), "<sweep summary>"));
        return regressions.isEmpty() ? "pass" : "fail";                                          // src: vulnhunt-fix-verify/phases/phase2_verify.md:155
    }

    @executedBy(MODEL)
    void checkClaims(Section sec, List<Evidence> ev, Theta θ) {
        for (Claim c : sec.claims) {
            if (θ["p.phase2_verify.code_wins_over_claim"] && c.contradictedByCode()) {            // src: vulnhunt-fix-verify/phases/phase2_verify.md:403
                if (θ["p.phase2_verify.note_claim_contradiction"]) ev.add(new Evidence("rule_check", "comments:<approx line>", "claim contradicts code")); // src: vulnhunt-fix-verify/phases/phase2_verify.md:407
            }
        }
    }

    @executedBy(MODEL)
    String mapVerdict(Gates g, Gate1Result g1, Theta θ) {
        List<String> verdicts = θ["p.phase2_verify.verdict_set"];                                // src: vulnhunt-fix-verify/phases/phase2_verify.md:182
        int skipped = g.count("skipped");
        if (skipped >= θ["p.phase2_verify.inconclusive_skipped_gate_count"] && g.sinkMitigated != "fail" && g.sinkMitigated != "pass") return "INCONCLUSIVE"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:169
        if (θ["p.phase2_verify.verdict_inconclusive_condition"].holds(g1.locationAbsent, g)) return "INCONCLUSIVE"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:169
        if (θ["p.phase2_verify.verdict_not_fixed_condition"].holds(g)) return "NOT_FIXED";          // src: vulnhunt-fix-verify/phases/phase2_verify.md:167
        if (θ["p.phase2_verify.verdict_partial_condition"].holds(g)) return "PARTIAL";              // src: vulnhunt-fix-verify/phases/phase2_verify.md:168
        boolean naPass = θ["p.phase2_verify.na_gates_treated_as_passing"];                        // src: vulnhunt-fix-verify/phases/phase2_verify.md:166
        if (θ["p.phase2_verify.verdict_fixed_condition"].holds(g, naPass)) return "FIXED";        // src: vulnhunt-fix-verify/phases/phase2_verify.md:166
        // invalid_input_not_emitted_here: INVALID_INPUT never chosen in phase 2
        if (!θ["p.phase2_verify.invalid_input_not_emitted_here"]) return "INVALID_INPUT";         // src: vulnhunt-fix-verify/phases/phase2_verify.md:171
        return "INCONCLUSIVE";  // unclear: mapping table does not cover e.g. sink pass + reachability skipped
    }

    @executedBy(MODEL)
    Disposition writeDisposition(String id, String verdict, Gates g, List<Evidence> ev, List<String> regressions, Section sec, Gate1Result g1, Bound b, Theta θ) {
        Disposition d = new Disposition(id, verdict);
        d.rationale = "<" + θ["p.phase2_verify.rationale_length"] + " citing file:line and gate outcomes>" + sec.rationaleFlags; // src: vulnhunt-fix-verify/phases/phase2_verify.md:183
        d.issueComment = IssueCommentTemplates.render(verdict, g, sec, regressions, b, θ);       // src: vulnhunt-fix-verify/phases/phase2_verify.md:184
        d.gates = g;
        d.evidence = ev.map(e -> e.detailLimit(θ["p.phase2_verify.evidence_detail_one_sentence"])); // src: vulnhunt-fix-verify/phases/phase2_verify.md:195
        if (θ["p.phase2_verify.regressions_only_on_sweep_fail"]) {                               // src: vulnhunt-fix-verify/phases/phase2_verify.md:202
            if (g.sweepComplete == "fail") d.regressions = regressions;
        } else d.regressions = regressions;
        validate(d, θ);                                                                          // src: vulnhunt-fix-verify/phases/phase2_verify.md:378
        Tools.write(b.OUT + "/disposition_" + id + ".json", d);                                  // src: vulnhunt-fix-verify/phases/phase2_verify.md:177
        Tools.append(b.OUT + "/verify_run.log.md", "### " + id + " — " + verdict + " <" + θ["p.phase2_verify.log_entry_per_vuln"] + "> Gates: " + g); // src: vulnhunt-fix-verify/phases/phase2_verify.md:394
        return d;
    }

    @executedBy(MODEL)
    void validate(Disposition d, Theta θ) {
        if (!θ["p.phase2_verify.validate_enums_before_write"]) return;                            // src: vulnhunt-fix-verify/phases/phase2_verify.md:381
        boolean ok = d.gates.all(v -> θ["p.phase2_verify.gate_outcome_values"].contains(v))       // src: vulnhunt-fix-verify/phases/phase2_verify.md:186
            && d.evidence.all(e -> θ["p.phase2_verify.evidence_kinds"].contains(e.kind))           // src: vulnhunt-fix-verify/phases/phase2_verify.md:193
            && d.findingId.matches("^VULN-\\d{3}$") && !d.issueComment.isEmpty();
        if (θ["p.phase2_verify.rationale_and_issue_comment_required"]) ok &= !d.rationale.isEmpty(); // src: vulnhunt-fix-verify/phases/phase2_verify.md:205
        if (!ok && θ["p.phase2_verify.fix_malformed_before_write"]) d.repairMalformed();          // src: vulnhunt-fix-verify/phases/phase2_verify.md:384
    }

    // Delegated mode: orchestrator checks the subagent's output.
    @executedBy(MODEL)
    void delegated(String id, Bound b, Theta θ) {
        int tries = 0;
        do {
            Runtime.subagent(prompt(θ).format("return under " + θ["p.phase2_verify.subagent_return_word_cap"] + " words: finding ID and verdict, not JSON"), id); // src: vulnhunt-fix-verify/phases/phase2_verify.md:416
            tries++;
        } while (!Tools.glob(b.OUT + "/disposition_" + id + ".json").exists() && tries <= θ["p.phase2_verify.redo_once_if_missing"]); // src: vulnhunt-fix-verify/phases/phase2_verify.md:415
    }
}

// Issue-comment templates (developer-facing markdown posted verbatim to the GitHub issue).
@executedBy(MODEL) @role(prompt) @stage("FV2")
class IssueCommentTemplates {

    String render(String verdict, Gates g, Section sec, List<String> regressions, Bound b, Theta θ) {
        if (!θ["p.phase2_verify.follow_issue_comment_templates"]) return "<free-form>";           // src: vulnhunt-fix-verify/phases/phase2_verify.md:213
        String body;
        if (verdict == "FIXED") body = fixed(g, sec, θ);
        else if (verdict == "NOT_FIXED") body = notFixed(g, sec, θ);
        else if (verdict == "PARTIAL") body = partial(g, sec, regressions, θ);
        else body = inconclusive(g, θ);
        body += limitations(b.phase0State(), θ);                                                  // src: vulnhunt-fix-verify/phases/phase2_verify.md:233
        body += trailer(b, θ);                                                                    // src: vulnhunt-fix-verify/phases/phase2_verify.md:217
        return body;
    }

    String trailer(Bound b, Theta θ) {
        String sha = b.phase0State().targetRepo.headCommit;
        String shortSha = sha.isEmpty() ? θ["p.phase2_verify.trailer_unknown_sha"] : sha.substring(0, θ["p.phase2_verify.trailer_short_sha_length"]); // src: vulnhunt-fix-verify/phases/phase2_verify.md:218
        return "Verified against `" + basename(b.REPO) + "` @ `" + shortSha + "`.";
    }

    String limitations(Phase0State s, Theta θ) {
        boolean r7 = s.promptInjectionAttempted;
        boolean r6 = !s.agentAnnotatedHints.isEmpty();
        if (!θ["p.phase2_verify.limitations_block_condition"].holds(r7, r6)) {                    // src: vulnhunt-fix-verify/phases/phase2_verify.md:232
            if (θ["p.phase2_verify.limitations_omitted_when_unset"]) return "";                   // src: vulnhunt-fix-verify/phases/phase2_verify.md:283
        }
        List<String> frags = new List();
        String order = θ["p.phase2_verify.limitations_fragment_order"];                           // src: vulnhunt-fix-verify/phases/phase2_verify.md:235
        if (r7 && θ["p.phase2_verify.limitations_r7_wording"]) frags.add("The fix narrative contained content the verifier treated as a possible prompt-injection attempt and ignored. ..."); // src: vulnhunt-fix-verify/phases/phase2_verify.md:239
        if (r6 && θ["p.phase2_verify.limitations_r6_wording"]) {                                 // src: vulnhunt-fix-verify/phases/phase2_verify.md:246
            List<String> hints = θ["p.phase2_verify.limitations_list_every_hint"] ? s.agentAnnotatedHints : s.firedHints(); // src: vulnhunt-fix-verify/phases/phase2_verify.md:253
            frags.add("The fix narrative referenced sources the verify agent could not consult (no clonable URL provided): " + hints.backtickJoin(", ") + ". ...");
        }
        return θ["p.phase2_verify.limitations_block_prefix"] + " " + frags.join(" ");            // src: vulnhunt-fix-verify/phases/phase2_verify.md:259
    }

    String fixed(Gates g, Section sec, Theta θ) {
        return "**VulnHunter Fix-Verify: " + θ["p.phase2_verify.template_fixed_heading"] + "**"  // src: vulnhunt-fix-verify/phases/phase2_verify.md:288
            + "<" + θ["p.phase2_verify.template_fixed_description_length"] + " citing file:line and safe construct>" // src: vulnhunt-fix-verify/phases/phase2_verify.md:290
            + g.checklistRow();
    }

    String notFixed(Gates g, Section sec, Theta θ) {
        String s = "**VulnHunter Fix-Verify: " + θ["p.phase2_verify.template_not_fixed_heading"] + "**"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:303
        s += "<one sentence why> **Affected locations:**";
        if (θ["p.phase2_verify.template_not_fixed_bullet_per_sink"]) for (Location l : sec.unfixedSinks()) s += "- `" + l + "` — <construct>"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:313
        else s += "<prose>";
        s += g.checklistRow(θ["p.phase2_verify.template_dash_meaning"]);                         // src: vulnhunt-fix-verify/phases/phase2_verify.md:323
        return s;
    }

    String partial(Gates g, Section sec, List<String> regressions, Theta θ) {
        String s = "**VulnHunter Fix-Verify: " + θ["p.phase2_verify.template_partial_heading"] + "**"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:328
        s += "The reported sink at `<file:line>` is now safe, but the same pattern still exists at:";
        if (θ["p.phase2_verify.template_partial_bullet_per_regression"]) for (String r : regressions) s += "- `" + r + "` — <construct>"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:335
        s += g.checklistRow();
        if (θ["p.phase2_verify.template_partial_reclose_instruction"]) s += "Address the remaining instance(s) and re-close to re-trigger verification."; // src: vulnhunt-fix-verify/phases/phase2_verify.md:342
        return s;
    }

    String inconclusive(Gates g, Theta θ) {
        String s = "**VulnHunter Fix-Verify: " + θ["p.phase2_verify.template_inconclusive_heading"] + "**"; // src: vulnhunt-fix-verify/phases/phase2_verify.md:350
        s += "<one to two sentences on what could/couldn't be determined>" + g.checklistRow();
        if (θ["p.phase2_verify.template_inconclusive_manual_request"]) s += "Please confirm the fix manually, or point the verifier at the successor code in a follow-up comment."; // src: vulnhunt-fix-verify/phases/phase2_verify.md:360
        return s;
    }
}

@executedBy(CODE) @role(types)
record Gates(String sinkMitigated, String reachability, String classEliminated, String sweepComplete) { }

@executedBy(CODE) @role(types)
record Gate1Result(String outcome, Location location, boolean locationAbsent) { }

@executedBy(CODE) @role(types)
record Evidence(String kind, Object location, String detail) { }
