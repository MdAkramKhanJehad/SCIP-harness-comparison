// =================================================================================================
// In-place implementation: one worktree + branch per cluster, one commit per finding.
// =================================================================================================
@executedBy(MODEL) @role(step) @stage("implement")
class ImplementInPlace {

    PhaseOutput run(PhaseOutput plan, Config cfg, Theta θ) {
        PhaseOutput out = new PhaseOutput();
        for (Cluster c : plan.selectedClusters) {
            Worktree wt = setupClusterWorktree(c, θ);
            // per-finding loop in the Phase 2 sequence; never a new branch per finding
            for (Finding f : c.findingsInPlanOrder()) {                                                  // src: vulnhunter-fix/prompts/implement.md:41
                assert θ["p.implement.in_place_finding_order_and_no_new_branch"];                        // src: vulnhunter-fix/prompts/implement.md:41
                FindingResult r = perFinding(f, c, wt, cfg, θ);
                out.add(r);
                if (r.paused) {
                    // worktree and partial commits stay; next run resumes at the next un-fixed finding
                    if (θ["p.implement.ip_resume_partial_cluster"]) return out.pausedAt(f);              // src: vulnhunter-fix/prompts/implement.md:135
                }
            }
        }
        return out;                                                                                      // src: vulnhunter-fix/prompts/implement.md:133
    }

    @executedBy(MIXED)
    Worktree setupClusterWorktree(Cluster c, Theta θ) {
        // one branch per cluster: θ["p.implement.in_place_one_branch_per_cluster"]
        String key = sha256(c.name).hex().substring(0, θ["p.implement.cluster_key_derivation"]);         // src: vulnhunter-fix/prompts/implement.md:27
        String slug = c.name.lower().replaceSpaces("-").stripSpecial();                                  // src: vulnhunter-fix/prompts/implement.md:24
        String branch = θ["p.implement.cluster_branch_naming"].replace("<cluster-slug>", slug);         // src: vulnhunter-fix/prompts/implement.md:24
        // masked fix/code-quality-* naming is fork-only
        assert θ["p.implement.in_place_no_masked_branch"];                                               // src: vulnhunter-fix/prompts/implement.md:37
        assert θ["p.implement.in_place_one_branch_per_cluster"] != null;                                 // src: vulnhunter-fix/prompts/implement.md:7
        return SetupWorktree.run(key, slug);                                                             // src: vulnhunter-fix/prompts/implement.md:30
    }

    FindingResult perFinding(Finding f, Cluster c, Worktree wt, Config cfg, Theta θ) {
        // IP-Step A: exploit demo in $TMPDIR, never committed, never under security_tests/
        Exploit x = writeExploit(f, θ["p.implement.ip_exploit_location_tmpdir"]);                       // src: vulnhunter-fix/prompts/implement.md:45
        assert θ["p.implement.no_security_tests_dir_for_exploit"];                                       // src: vulnhunter-fix/prompts/implement.md:45
        FindingResult r = new FindingResult(f);

        // IP-Step B: patchability check -> collaboration loop trigger, never a terminal CANNOT_AUTO_FIX/BREAKING_CHANGE
        if (ImplementShared.notAutoPatchable(f, θ) || f.matchesAny(θ["p.implement.ip_collab_trigger_criteria"])) { // src: vulnhunter-fix/prompts/implement.md:53
            if (θ["p.implement.ip_no_terminal_cannot_auto_fix"]) r = ImplementCollaborationLoop.run(f, wt, "patchability", θ); // src: vulnhunter-fix/prompts/implement.md:51
            // never propose deferring to a follow-up PR or "scaffolding only"
            assert θ["p.implement.ip_no_defer_or_scaffolding_framing"];                                  // src: vulnhunter-fix/prompts/implement.md:53
            if (r.paused) return r;
        }

        // IP-Step C: RED test
        Test t = ImplementShared.writeSecurityTest(f, θ["p.implement.ip_test_requirements"], θ);                 // src: vulnhunter-fix/prompts/implement.md:58
        if (θ["p.implement.ip_run_test_confirm_fail"] && t.run().passed) return ImplementShared.reworkTest(f, θ); // src: vulnhunter-fix/prompts/implement.md:64

        // IP-Step D: GREEN fix per proposed_fix.strategy
        if (θ["p.implement.ip_fix_per_proposed_strategy"]) ImplementShared.applyFix(f, f.proposedFix.strategy, θ); // src: vulnhunter-fix/prompts/implement.md:68
        if (ImplementShared.hasPlaceholder(f, θ) || ImplementShared.interfaceBreaks(f, θ)) {
            if (θ["p.implement.ip_breaking_change_to_collab_loop"]) r = ImplementCollaborationLoop.run(f, wt, "breaking change", θ); // src: vulnhunter-fix/prompts/implement.md:68
            if (r.paused) return r;
        }
        if (ImplementShared.touchesDependencyManifest(f, θ)) {
            List<Hit> hits = ImplementShared.pinScan(f, θ);
            hits.addAll(ImplementShared.companionCheck(f, θ));
            // each D.3.a / D.3.b hit becomes one AskUserQuestion, not a notes field
            if (θ["p.implement.ip_dep_hits_surfaced_per_hit"]) for (Hit h : hits) ImplementCollaborationLoop.askAboutHit(h, θ); // src: vulnhunter-fix/prompts/implement.md:70
            assert θ["p.implement.no_auto_bump_unapproved"];                                             // src: vulnhunter-fix/prompts/implement.md:70
        }

        // IP-Step E: rerun exploit from $TMPDIR, then delete it (no git rm)
        if (θ["p.implement.ip_exploit_rerun_then_delete"]) { x.run(); x.delete(); }                      // src: vulnhunter-fix/prompts/implement.md:74

        // IP-Step E.5: discrimination evidence
        Discrimination de = ImplementShared.recordDiscrimination(f, t, θ["p.implement.ip_discrimination_evidence"], θ); // src: vulnhunter-fix/prompts/implement.md:85
        if (!de.discriminating()) return perFindingFromStepC(f, c, wt, cfg, θ);                         // src: vulnhunter-fix/prompts/implement.md:85

        // IP-Step F: regression check
        Regression rg = ImplementShared.regressionCheck(f, θ["p.implement.ip_regression_policy_default"], θ);    // src: vulnhunter-fix/prompts/implement.md:89
        if (rg.causedByFix && !rg.adjustable) { r = ImplementCollaborationLoop.run(f, wt, "regression", θ); if (r.paused) return r; }

        // IP-Step G: scope check against this finding (plus in-cluster shared helpers)
        if (θ["p.implement.ip_scope_check"]) {                                                           // src: vulnhunter-fix/prompts/implement.md:93
            for (String file : git("diff --name-only")) if (!c.attributable(file, f)) stashOrRevert(file); // src: vulnhunter-fix/prompts/implement.md:93
        }

        // IP-Step G.5: pre-existing test updates
        PreexistingUpdates pu = ImplementShared.updatePreexistingTests(f, θ["p.implement.ip_preexisting_test_updates"], θ); // src: vulnhunter-fix/prompts/implement.md:97
        if (pu.overScoped) return perFindingFromStepD(f, c, wt, cfg, θ);                                // src: vulnhunter-fix/prompts/implement.md:97

        // IP-Step H: commit (one per finding, severity masked)
        ImplementShared.commit(f, t, θ["p.implement.ip_severity_mask_commit"], θ);                               // src: vulnhunter-fix/prompts/implement.md:99
        r.committed = true;
        return r;
    }

    FindingResult perFindingFromStepC(Finding f, Cluster c, Worktree wt, Config cfg, Theta θ) {
        return perFinding(f, c, wt, cfg, θ);                                                             // unclear: "return to IP-Step C" re-enters the loop at C; modelled as a re-run
    }

    FindingResult perFindingFromStepD(Finding f, Cluster c, Worktree wt, Config cfg, Theta θ) {
        return perFinding(f, c, wt, cfg, θ);                                                             // unclear: "return to IP-Step D"; modelled as a re-run
    }
}

// =================================================================================================
// Fork-mode implementation: one masked branch per finding, CANNOT_AUTO_FIX -> issue fallback.
// =================================================================================================
@executedBy(MODEL) @role(step) @stage("implement")
class ImplementFork {

    PhaseOutput run(PhaseOutput plan, Config cfg, Theta θ) {
        PhaseOutput out = new PhaseOutput();
        // any git clone / gh repo fork / git push / gh pr create failure -> SKILL.md failure policy (no retry, no substitute tool)
        if (θ["p.implement.fork_git_failure_stop"]) out.onGitFailure = "VulnhunterFixSkill.onGitGhFailure"; // src: vulnhunter-fix/prompts/implement.md:145
        if (!preImplementationSetup(plan, cfg, θ)) return out.routeAllToIssueFallback();
        // one branch per finding, never combine root causes
        for (Finding f : plan.findings) {                                                                // src: vulnhunter-fix/prompts/implement.md:170
            assert θ["p.implement.fork_fresh_branch_per_finding"];                                       // src: vulnhunter-fix/prompts/implement.md:171
            assert θ["p.implement.fork_one_branch_per_finding"] != null;                                 // src: vulnhunter-fix/prompts/implement.md:8
            out.add(perFinding(f, cfg, θ));
        }
        return out;                                                                                      // src: vulnhunter-fix/prompts/implement.md:585
    }

    @executedBy(MIXED)
    boolean preImplementationSetup(PhaseOutput plan, Config cfg, Theta θ) {
        int rc = CheckRepoAccess.run(plan.targetRepo);                                                   // src: vulnhunter-fix/prompts/implement.md:151
        if (rc == 1 && θ["p.implement.fork_no_push_access_path"]) {                                      // src: vulnhunter-fix/prompts/implement.md:154
            if (!cfg.behavior.autoForkOnNoAccess) return false;                                          // config key auto_fork_on_no_access; else skip to Phase 5 issue fallback (src: vulnhunter-fix/prompts/implement.md:156)
        }
        CloneRepo.run(plan.targetRepo, ".work/clone", true);                                             // src: vulnhunter-fix/prompts/implement.md:160
        cd(".work/clone");                                                                               // src: vulnhunter-fix/prompts/implement.md:165
        return true;
    }

    @executedBy(MIXED)
    String createBranch(Finding f, Theta θ) {
        String key = Delivery.computeIdempotencyKey(f.location, f.cwe, f.rootCause);                     // src: vulnhunter-fix/prompts/implement.md:179
        // fix/code-quality-<descriptor>-<hash-prefix>, descriptor from the masked set (general-hardening fallback)
        String name = Delivery.computeMaskedBranchName(f.cwe, key, θ["p.implement.fork_masked_branch_pattern"], θ["p.implement.masked_descriptor_set"]); // src: vulnhunter-fix/prompts/implement.md:175
        assert θ["p.implement.branch_no_vuln_hint"];                                                     // src: vulnhunter-fix/prompts/implement.md:188
        git("checkout main"); git("checkout -b " + name);                                                // src: vulnhunter-fix/prompts/implement.md:184
        return name;
    }

    FindingResult perFinding(Finding f, Config cfg, Theta θ) {
        FindingResult r = new FindingResult(f);
        String branch = createBranch(f, θ);

        // Step A: exploit demo, local only
        Exploit x = ImplementShared.writeExploitDemo(f, θ);                                                       // src: vulnhunter-fix/prompts/implement.md:190

        // Step B: patchability check
        if (θ["p.implement.patchability_check_before_fix"] && ImplementShared.notAutoPatchable(f, θ)) {           // src: vulnhunter-fix/prompts/implement.md:216
            // no partial or fake fix; mark and route to issue
            assert θ["p.implement.no_partial_or_fake_fix"];                                              // src: vulnhunter-fix/prompts/implement.md:224
            return issueFallback(f, branch, "not auto-patchable", θ);                                    // src: vulnhunter-fix/prompts/implement.md:227
        }

        // Step C: RED test
        Test t = ImplementShared.writeSecurityTest(f, null, θ);                                                   // src: vulnhunter-fix/prompts/implement.md:230
        if (t.run().passed) return ImplementShared.reworkTest(f, θ);                                              // src: vulnhunter-fix/prompts/implement.md:262

        // Step D.1 (BEFORE applying the fix): interface breaking-change check
        if (ImplementShared.interfaceBreaks(f, θ)) {
            Callers cs = ImplementShared.searchCallers(f, θ);
            if (cs.allInRepoAndAtomic() && θ["p.implement.breaking_path_a_atomic"]) {                    // src: vulnhunter-fix/prompts/implement.md:303
                ImplementShared.applyFix(f, f.proposedFix.strategy, θ);
                cs.updateAllCallSitesInSameCommit();                                                     // src: vulnhunter-fix/prompts/implement.md:305
            } else {
                // Path B: no fix, no branch, BREAKING_CHANGE with structured details -> issue only
                r.status = θ["p.implement.breaking_path_b_no_fix"];                                      // src: vulnhunter-fix/prompts/implement.md:308
                r.breakingChangeDetails = describe(f, cs, θ["p.implement.breaking_change_details_fields"]); // src: vulnhunter-fix/prompts/implement.md:312
                if (θ["p.implement.breaking_change_issue_only"]) r.delivery = "issue_only";              // src: vulnhunter-fix/prompts/implement.md:318
                deleteBranch(branch);
                return r;
            }
        }
        // Step D.2: cross-repo coordination
        if (ImplementShared.needsSecondRepo(f)) {                                                                 // src: vulnhunter-fix/prompts/implement.md:322
            if (θ["p.implement.cross_repo_no_one_sided_fix"]) return issueFallback(f, branch, "cross-repo coordination", θ); // src: vulnhunter-fix/prompts/implement.md:325
        }
        // Step D: GREEN fix
        if (!r.fixApplied) ImplementShared.applyFix(f, f.proposedFix.strategy, θ);                                 // src: vulnhunter-fix/prompts/implement.md:267
        if (ImplementShared.hasPlaceholder(f, θ)) {
            if (θ["p.implement.placeholder_found_revert"]) { revertFix(f); return issueFallback(f, branch, "placeholder detected", θ); } // src: vulnhunter-fix/prompts/implement.md:278
        }
        // Step D.3: dep-class checks -> notes, never auto-bump
        if (ImplementShared.touchesDependencyManifest(f, θ)) {
            for (Hit h : ImplementShared.pinScan(f, θ)) if (θ["p.implement.stale_pin_fork_notes"]) f.notes.add(h.fileLine + " " + h.observed + " -> " + h.recommended); // src: vulnhunter-fix/prompts/implement.md:367
            for (Hit h : ImplementShared.companionCheck(f, θ)) if (θ["p.implement.companion_fork_notes"]) f.notes.add(h.observed + " -> " + h.recommended); // src: vulnhunter-fix/prompts/implement.md:397
        }
        if (!t.run().passed && θ["p.implement.commit_even_if_test_fails"]) r.handToVerifyRepair = true;  // src: vulnhunter-fix/prompts/implement.md:408

        // Step E: exploit blocked, then delete
        x.run();                                                                                         // src: vulnhunter-fix/prompts/implement.md:416
        if (θ["p.implement.delete_exploit_after_run"]) x.delete();                                       // src: vulnhunter-fix/prompts/implement.md:419

        // Step E.5: discrimination evidence (mandatory)
        Discrimination de = ImplementShared.recordDiscrimination(f, t, ".work/<repo>/discrimination/<vuln>.json", θ); // src: vulnhunter-fix/prompts/implement.md:427
        if (!de.discriminating()) return perFinding(f, cfg, θ);                                          // return to Step C (src: vulnhunter-fix/prompts/implement.md:435)

        // Step F: regression check (policy-aware)
        Regression rg = ImplementShared.regressionCheck(f, θ["p.implement.test_policy_default"], θ);              // src: vulnhunter-fix/prompts/implement.md:439
        if (rg.causedByFix) {
            if (θ["p.implement.regression_caused_adjust_fix"]) rg = ImplementShared.adjustFixPreservingBehavior(f, θ); // src: vulnhunter-fix/prompts/implement.md:469
            if (!rg.adjustable && θ["p.implement.regression_unfixable_revert"]) { revertFix(f); return issueFallback(f, branch, "fix breaks happy path", θ); } // src: vulnhunter-fix/prompts/implement.md:470
        }

        // Step G: scope check against main
        if (θ["p.implement.fork_scope_check"]) {                                                         // src: vulnhunter-fix/prompts/implement.md:476
            for (String file : git("diff --name-only main")) if (!f.attributable(file)) stashOrRevert(file); // src: vulnhunter-fix/prompts/implement.md:478
        }
        // Step G.5: pre-existing test updates (mandatory)
        PreexistingUpdates pu = ImplementShared.updatePreexistingTests(f, ".work/<repo>/preexisting_test_updates/<vuln>.json", θ); // src: vulnhunter-fix/prompts/implement.md:485
        if (pu.overScoped) return perFinding(f, cfg, θ);                                                 // return to Step D (src: vulnhunter-fix/prompts/implement.md:485)

        // Step H: commit
        ImplementShared.commit(f, t, θ["p.implement.severity_mask_everywhere"], θ);                               // src: vulnhunter-fix/prompts/implement.md:487
        r.committed = true;
        return r;
    }

    FindingResult issueFallback(Finding f, String branch, String reason, Theta θ) {
        FindingResult r = new FindingResult(f);
        r.status = θ["p.implement.cannot_auto_fix_marking"];                                             // src: vulnhunter-fix/prompts/implement.md:225
        if (θ["p.implement.fork_fallback_cleanup"]) { deletePartialFix(branch); deleteBranch(branch); } // src: vulnhunter-fix/prompts/implement.md:576
        // high-priority issue in the fork, opened in Phase 5
        r.issueBody = ImplementShared.issueBody(f, reason, θ["p.implement.cannot_auto_fix_issue_content"], θ["p.implement.fork_fallback_issue_fields"]); // src: vulnhunter-fix/prompts/implement.md:578
        r.delivery = "issue_only";                                                                       // src: vulnhunter-fix/prompts/implement.md:227
        return r;
    }
}

// =================================================================================================
// ImplementShared per-finding rules (fork Steps A-H; in-place IP-Steps reuse them "same as fork mode").
// =================================================================================================
@executedBy(MODEL) @role(rule_set) @stage("implement")
class ImplementShared {

    Exploit writeExploitDemo(Finding f, Theta θ) {
        Exploit x = new Exploit(f);
        x.requirements = θ["p.implement.exploit_requirements"];                                          // src: vulnhunter-fix/prompts/implement.md:196
        x.path = θ["p.implement.ip_exploit_location_tmpdir"];                                            // src: vulnhunter-fix/prompts/implement.md:200
        x.neverCommitted = θ["p.implement.exploit_local_only"];                                          // src: vulnhunter-fix/prompts/implement.md:192
        return x;
    }

    boolean notAutoPatchable(Finding f, Theta θ) {
        return f.fixRequiresAny(θ["p.implement.not_auto_patchable_criteria"]);                           // src: vulnhunter-fix/prompts/implement.md:218
    }

    Test writeSecurityTest(Finding f, Object ipRequirements, Theta θ) {
        Test t = new Test(f);
        if (θ["p.implement.test_existing_framework"]) t.framework = repo.existingFramework();            // src: vulnhunter-fix/prompts/implement.md:235
        if (θ["p.implement.test_existing_dir_not_security_tests"]) t.dir = repo.existingTestDir();       // src: vulnhunter-fix/prompts/implement.md:236
        if (θ["p.implement.test_same_language"]) t.language = repo.language();                           // src: vulnhunter-fix/prompts/implement.md:237
        if (θ["p.implement.test_imports_production_code"]) {                                             // src: vulnhunter-fix/prompts/implement.md:238
            if (!f.codeImportable() && θ["p.implement.refactor_for_testability"]) refactorBehaviorPreserving(f); // src: vulnhunter-fix/prompts/implement.md:239
        }
        t.scaffoldName = θ["p.implement.scaffold_transient_name"];                                       // src: vulnhunter-fix/prompts/implement.md:240
        if (θ["p.implement.decide_final_test_name_at_red"]) t.finalName = repo.testNamingConvention(f);  // src: vulnhunter-fix/prompts/implement.md:240
        t.assertClassSpecific = θ["p.implement.assertion_class_specific"];                               // src: vulnhunter-fix/prompts/implement.md:241
        t.assertSecureBehavior = θ["p.implement.assert_secure_behavior"];                                // src: vulnhunter-fix/prompts/implement.md:242
        t.mustFailNow = θ["p.implement.test_must_fail_on_vulnerable_code"];                              // src: vulnhunter-fix/prompts/implement.md:232
        // RED evidence must exist before any source edit
        t.gate = θ["prompt.fix.tdd_gate"];                                                                // src: vulnhunter-fix/prompts/implement.md:259
        return t;
    }

    // How the collaboration loop ended for the finding (continueAuto, paused, committed or redo), carried as the finding's result.
    FindingResult loopResult(String ended, Object... detail) { }

    FindingResult reworkTest(Finding f, Theta θ) {
        return ImplementShared.loopResult("redo", f, "test did not fail on vulnerable code");                             // unclear: prompt says confirm it fails; no explicit branch for a passing RED test
    }

    void applyFix(Finding f, String strategy, Theta θ) {
        // read target file(s) -> Edit tool -> follow strategy exactly -> conservative if ambiguous
        if (θ["p.implement.fix_via_edit_tool"]) editTool.apply(f.targetFiles);                           // src: vulnhunter-fix/prompts/implement.md:269
        if (θ["p.implement.follow_report_strategy_exactly"]) follow(strategy);                           // src: vulnhunter-fix/prompts/implement.md:270
        if (strategy.ambiguous()) follow(θ["p.implement.ambiguous_strategy_conservative"]);              // src: vulnhunter-fix/prompts/implement.md:271
    }

    boolean hasPlaceholder(Finding f, Theta θ) {
        return f.fixDiff.containsAny(θ["p.implement.placeholder_scan"]);                                 // src: vulnhunter-fix/prompts/implement.md:273
    }

    boolean interfaceBreaks(Finding f, Theta θ) {
        return f.fixChangesAny(θ["p.implement.interface_change_check_before_fix"]);                      // src: vulnhunter-fix/prompts/implement.md:284
    }

    Callers searchCallers(Finding f, Theta θ) {
        Callers cs = new Callers();
        if (θ["p.implement.caller_search_in_repo_and_org"]) {                                            // src: vulnhunter-fix/prompts/implement.md:292
            cs.addAll(bash("grep -rn \"functionName|/endpoint/path\" ."));                               // src: vulnhunter-fix/prompts/implement.md:295
            cs.addAll(bash("gh search code ... --owner=<target_org> -L " + θ["p.implement.external_caller_search_limit"])); // src: vulnhunter-fix/prompts/implement.md:298
        }
        return cs;
    }

    boolean needsSecondRepo(Finding f) {
        return f.fixRequiresChangeInAnotherRepo();                                                       // src: vulnhunter-fix/prompts/implement.md:322
    }

    boolean touchesDependencyManifest(Finding f, Theta θ) {
        return f.modifiedFiles.anyIn(θ["p.implement.dep_check_trigger_manifests"]);                      // src: vulnhunter-fix/prompts/implement.md:331
    }

    List<Hit> pinScan(Finding f, Theta θ) {
        // both D.3 checks surface; neither auto-bumps
        assert θ["p.implement.dep_checks_surface_only"];                                                 // src: vulnhunter-fix/prompts/implement.md:333
        if (!θ["p.implement.out_of_manifest_pin_scan_mandatory"]) return List.of();                     // src: vulnhunter-fix/prompts/implement.md:335
        List<Hit> hits = grep(f.primaryPackage, θ["p.implement.pin_scan_file_globs"]);                   // src: vulnhunter-fix/prompts/implement.md:340
        hits.addAll(reasonAbout(θ["p.implement.pin_scan_manual_inspect_list"]));                         // src: vulnhunter-fix/prompts/implement.md:354
        if (hits.isEmpty()) f.evidence.add(θ["p.implement.pin_scan_clean_recorded"]);                   // src: vulnhunter-fix/prompts/implement.md:369
        return hits;
    }

    List<Hit> companionCheck(Finding f, Theta θ) {
        if (!θ["p.implement.companion_partner_check"]) return List.of();                                // src: vulnhunter-fix/prompts/implement.md:371
        List<Hit> hits = olderCompanions(f.manifest, θ["p.implement.companion_table"]);                  // src: vulnhunter-fix/prompts/implement.md:373
        Guide g = findUpgradeGuide(θ["p.implement.upgrade_guide_lookup"]);                               // src: vulnhunter-fix/prompts/implement.md:390
        if (g != null) for (Hit h : hits) h.citeVerbatim(g.lockstepRules());                             // src: vulnhunter-fix/prompts/implement.md:390
        if (hits.isEmpty()) f.evidence.add("companion_check: " + pickOne(θ["p.implement.companion_check_record_values"])); // src: vulnhunter-fix/prompts/implement.md:399
        return hits;
    }

    Discrimination recordDiscrimination(Finding f, Test t, String path, Theta θ) {
        // mandatory before Step F
        assert θ["p.implement.discrimination_evidence_mandatory"];                                       // src: vulnhunter-fix/prompts/implement.md:427
        Discrimination d = new Discrimination(θ["p.implement.discrimination_method_stash_and_run"]);    // src: vulnhunter-fix/prompts/implement.md:427
        git("stash"); d.pre = t.run(); git("stash pop"); d.post = t.run();                               // src: vulnhunter-fix/prompts/implement.md:427
        if (θ["p.implement.assertion_target_final_path"]) d.assertionTarget = t.finalName;               // src: vulnhunter-fix/prompts/implement.md:433
        writeJson(path, d);
        // pre != fail OR post != pass -> non-discriminating -> back to Step C
        if (θ["p.implement.non_discriminating_return_to_test"]) d.discriminating = d.pre == "fail" && d.post == "pass"; // src: vulnhunter-fix/prompts/implement.md:435
        // E.5 and G.5 mandatory in both modes
        assert θ["p.implement.e5_g5_mandatory_both_modes"];                                              // src: vulnhunter-fix/prompts/implement.md:590
        return d;
    }

    @executedBy(MIXED)
    Regression regressionCheck(Finding f, String policy, Theta θ) {
        Regression rg = new Regression();
        if (policy == "skip") {
            // security test from Step C still runs regardless
            if (θ["p.implement.skip_semantics"]) rg.banner = "Unverified - Manual Test Execution Required"; // src: vulnhunter-fix/prompts/implement.md:443
            return rg;
        }
        // runner detection: pytest.ini/setup.cfg/tests -> pytest; package.json -> npm test; go.mod -> go test ./... (with proxy env)
        for (String runner : θ["p.implement.regression_runner_detection_order"]) {                      // src: vulnhunter-fix/prompts/implement.md:449
            if (repo.has(runner)) { rg.output = bash(runner).tail(θ["p.implement.regression_tail_lines"]); break; } // src: vulnhunter-fix/prompts/implement.md:450
        }
        if (rg.envError) {
            if (policy == "must-pass" && θ["p.implement.must_pass_semantics"]) rg.rejected = true;       // src: vulnhunter-fix/prompts/implement.md:442
            if (policy == "best-effort" && θ["p.implement.env_error_best_effort_continue"]) rg.banner = "Human-in-the-Loop Validation Required"; // src: vulnhunter-fix/prompts/implement.md:472
        }
        // real test failures still block under best-effort
        if (rg.realFailures && θ["p.implement.best_effort_semantics"]) rg.causedByFix = rg.passedOnMain(); // src: vulnhunter-fix/prompts/implement.md:441
        return rg;
    }

    Regression adjustFixPreservingBehavior(Finding f, Theta θ) {
        return reworkFixKeepingSecurityTestGreen(f);                                                     // src: vulnhunter-fix/prompts/implement.md:469
    }

    PreexistingUpdates updatePreexistingTests(Finding f, String path, Theta θ) {
        PreexistingUpdates pu = new PreexistingUpdates();
        for (TestFailure tf : runPreexistingSuite()) {
            if (tf.encodedVulnerableBehavior()) pu.update(tf, θ["p.implement.preexisting_test_updates_mandatory"]); // src: vulnhunter-fix/prompts/implement.md:485
            else if (θ["p.implement.over_scoped_regression_return"]) pu.overScoped = true;               // src: vulnhunter-fix/prompts/implement.md:485
        }
        writeJson(path, pu);
        return pu;
    }

    @executedBy(MIXED)
    void commit(Finding f, Test t, String severityMask, Theta θ) {
        if (θ["p.implement.promote_scaffold_before_commit"]) {                                           // src: vulnhunter-fix/prompts/implement.md:489
            // preferred: merge into canonical test file; otherwise git mv to repo-convention name
            String path = pickFirstApplicable(θ["p.implement.promotion_paths"]);                         // src: vulnhunter-fix/prompts/implement.md:490
            t.promoteTo(path);
        }
        if (θ["p.implement.never_add_verify_prefixed"]) assert !staged().anyStartsWith("verify_");       // src: vulnhunter-fix/prompts/implement.md:493
        if (θ["p.implement.stage_only_test_and_fix"]) git("add " + t.finalName + " " + f.fixedFiles + " " + f.refactoredFiles); // src: vulnhunter-fix/prompts/implement.md:495
        String msg = θ["p.implement.commit_message_format"]                                              // src: vulnhunter-fix/prompts/implement.md:505
            + "\nRemediate CWE-XXX ... Validated: test was RED (vulnerable), now GREEN (secure)\n"
            + θ["p.implement.commit_trailers"];                                                          // src: vulnhunter-fix/prompts/implement.md:514
        msg = msg.replace("Critical", severityMask);                                                     // src: vulnhunter-fix/prompts/implement.md:520
        git("commit -m " + msg);
    }

    String issueBody(Finding f, String reason, Object content, Object fields) {
        return render(f, reason, content, fields);                                                       // src: vulnhunter-fix/prompts/implement.md:578
    }
}

// =================================================================================================
// CANNOT_AUTO_FIX -> interactive collaboration loop (in-place only; replaces the issue fallback).
// =================================================================================================
@executedBy(MODEL) @role(step) @stage("implement")
class ImplementCollaborationLoop {

    FindingResult run(Finding f, Worktree wt, String reason, Theta θ) {
        // in-place has no Issue-only outcome: every selected finding ends Ready PR or Draft PR
        List<String> outcomes = θ["p.implement.ip_no_issue_only_outcome"];                              // src: vulnhunter-fix/prompts/implement.md:524
        if (!reason.in(θ["p.implement.collab_loop_entry_reasons"])) return ImplementShared.loopResult("continueAuto", f); // src: vulnhunter-fix/prompts/implement.md:528
        // 1. state the blocker plainly
        say(blocker(f, reason, θ["p.implement.collab_state_blocker"]));                                  // src: vulnhunter-fix/prompts/implement.md:539
        // 4. loop until GREEN, uncapped (no max_repair_attempts in interactive mode)
        while (θ["p.implement.collab_loop_until_green_no_cap"] == "uncapped") {                          // src: vulnhunter-fix/prompts/implement.md:555
            // 2. concrete options via AskUserQuestion; always include Pause; never Issue-only; never open-ended chat
            List<String> opts = concreteOptions(f, reason);
            if (θ["p.implement.collab_always_pause_option"]) opts.add("Pause this finding - resume in a future run"); // src: vulnhunter-fix/prompts/implement.md:550
            if (θ["p.implement.collab_no_issue_only_option"]) opts.remove("Issue-only");                 // src: vulnhunter-fix/prompts/implement.md:551
            if (θ["p.implement.collab_concrete_options"] && θ["p.implement.collab_not_a_chat"]) assert opts.allConcrete(); // src: vulnhunter-fix/prompts/implement.md:566
            Answer a = askUserQuestion(opts);                                                            // src: vulnhunter-fix/prompts/implement.md:544
            if (a.isPause() || a.walkedAway()) {
                // 5. no synthesized issue; issue stays open; worktree stays for resume
                if (θ["p.implement.walk_away_no_issue"]) return ImplementShared.loopResult("paused", f, wt);             // src: vulnhunter-fix/prompts/implement.md:561
            }
            // 3. apply the choice and re-run verification: RED->GREEN + exploit blocked, every round
            apply(a);
            Verification v = rerunRedGreenAndExploit(f);
            if (θ["p.implement.collab_round_ends_red_green"] && θ["p.implement.collab_no_tdd_skip"]) assert v.redGreenRecorded; // src: vulnhunter-fix/prompts/implement.md:553
            if (v.green) {
                ImplementShared.commit(f, v.test, θ["p.implement.ip_severity_mask_commit"], θ);                    // src: vulnhunter-fix/prompts/implement.md:558
                // Draft PR only when the chosen path needs operator setup
                String triage = (θ["p.implement.collab_draft_only_when_setup"] && a.requiresOperatorSetup()) ? outcomes.get(1) : outcomes.get(0); // src: vulnhunter-fix/prompts/implement.md:558
                return ImplementShared.loopResult("committed", f, triage);
            }
            if (θ["p.implement.collab_round_shows_delta"]) say(deltaSinceLastRound(v));                  // src: vulnhunter-fix/prompts/implement.md:556
            reason = narrowedBy(v, reason);                                                              // src: vulnhunter-fix/prompts/implement.md:557
        }
        return ImplementShared.loopResult("paused", f, wt);
    }

    void askAboutHit(Hit h, Theta θ) {
        List<String> opts = h.isCompanion ? θ["p.implement.companion_options_in_place"] : θ["p.implement.stale_pin_options_in_place"]; // src: vulnhunter-fix/prompts/implement.md:360
        Answer a = askUserQuestion(h.describe(), opts);                                                  // src: vulnhunter-fix/prompts/implement.md:392
        apply(a);
        if (θ["p.implement.stale_pin_rerun_test"]) rerunSecurityTest();                                  // src: vulnhunter-fix/prompts/implement.md:365
    }
}

// =================================================================================================
// Worker-class routing notes (REQ-CWE-003 / REQ-CWE-007).
// =================================================================================================
@executedBy(MODEL) @role(rule_set) @stage("implement")
class ImplementWorkerClassRouting {

    Prompt workerPromptFor(Finding f, Plan plan, Theta θ) {
        // plan orchestrator injects the matching worker-class prompt; all extend worker_agent_common.md
        String cls = f.cweClass(θ["p.implement.cwe_class_worker_routing"]);                              // src: vulnhunter-fix/prompts/implement.md:592
        Prompt common = WorkerAgentCommon.run(f, plan, θ);
        if (cls == "authz") return WorkerAgentAuthz.run(f, plan, θ).include(common);
        if (cls == "injection") return WorkerAgentInjection.run(f, plan, θ).include(common);
        if (cls == "crypto") return WorkerAgentCrypto.run(f, plan, θ).include(common);
        if (cls == "resource") return WorkerAgentResource.run(f, plan, θ).include(common);
        if (cls == "config") return WorkerAgentConfig.run(f, plan, θ).include(common);
        return common;
    }

    String cryptoTierGate(Plan plan, String proposedTier, Theta θ) {
        // FULL requires all four plan.crypto_trust_chain booleans; any false forces MITIGATION with a trust-chain: residual
        if (proposedTier == "FULL" && !plan.cryptoTrustChain.allTrue(θ["p.implement.crypto_full_requires_four_booleans"])) return "MITIGATION"; // src: vulnhunter-fix/prompts/implement.md:594
        return proposedTier;
    }
}
