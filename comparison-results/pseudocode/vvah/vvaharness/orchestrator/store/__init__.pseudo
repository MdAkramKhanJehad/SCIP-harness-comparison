// file: vvaharness/orchestrator/store/__init__.py
// State store facade: one SQLite file under $VVAHARNESS_STATE_DIR holding per-run checkpoint blobs,
// callgraph snapshots, exploit-verification replays/probes, and run metadata. Re-exports _db, callgraph, replays.

@executedBy(CODE) @role(io)
class Store {

    // DB plumbing lives in store/_db.py (class Db; partly stubbed as StateStore in orchestrator/entry.pseudo).           // src: vvaharness/orchestrator/store/__init__.py:17
    Connection connect() {
        return Db.connect();                                                                       // src: vvaharness/orchestrator/store/__init__.py:24
    }
    Path dbLocation() {
        return Db.dbLocation();                                                                    // src: vvaharness/orchestrator/store/__init__.py:25
    }
    Path dbPath() {
        return Db.dbPath();                                                                        // src: vvaharness/orchestrator/store/__init__.py:26
    }
    boolean deleteRun(String runId) {
        return Db.deleteRun(runId);                                                                // src: vvaharness/orchestrator/store/__init__.py:27
    }
    void deleteRunGraphs(String runId) {
        Db.deleteRunGraphs(runId);                                                                 // src: vvaharness/orchestrator/store/__init__.py:28
    }
    List<String> deleteSteps(String runId, String prefix, Set<String> keep) {
        return Db.deleteSteps(runId, prefix, keep);                                                // src: vvaharness/orchestrator/store/__init__.py:29
    }
    Path ensureStateDir(String kind, String runId, String sub) {
        return Db.ensureStateDir(kind, runId, sub);                                                // src: vvaharness/orchestrator/store/__init__.py:30
    }
    void registerRun(String runId, Path repo, String repoName, String appId) {
        Db.registerRun(runId, repo, repoName, appId);                                              // src: vvaharness/orchestrator/store/__init__.py:31
    }
    boolean runExists(String runId) {
        return Db.runExists(runId);                                                                // src: vvaharness/orchestrator/store/__init__.py:32
    }
    int resetRun(String runId) {
        return Db.resetRun(runId);                                                                 // src: vvaharness/orchestrator/store/__init__.py:33
    }
    Path stateRoot(Theta θ) {
        return Db.stateRoot(θ);                                                                    // src: vvaharness/orchestrator/store/__init__.py:34
    }
    List<String> stepsWithPrefix(String runId, String prefix) {
        return Db.stepsWithPrefix(runId, prefix);                                                  // src: vvaharness/orchestrator/store/__init__.py:35
    }

    String ddl() {
        return Schema.DDL;                                                                         // src: vvaharness/orchestrator/store/__init__.py:37
    }

    String saveCallgraph(String runId, String step, Object obj) {
        return Callgraph.saveCallgraph(runId, step, obj);                                          // src: vvaharness/orchestrator/store/__init__.py:38
    }
    Map loadCallgraph(String runId, String step) {
        return Callgraph.loadCallgraph(runId, step);                                               // src: vvaharness/orchestrator/store/__init__.py:38
    }

    int saveReplays(String runId, List items) {
        return Replays.saveReplays(runId, items);                                                  // src: vvaharness/orchestrator/store/__init__.py:39
    }
    int pruneReplays(String runId, Set<String> keepKeys) {
        return Replays.pruneReplays(runId, keepKeys);                                              // src: vvaharness/orchestrator/store/__init__.py:43
    }
    List loadReplays(String runId) {
        return Replays.loadReplays(runId);                                                         // src: vvaharness/orchestrator/store/__init__.py:42
    }
    int deleteReplays(String runId) {
