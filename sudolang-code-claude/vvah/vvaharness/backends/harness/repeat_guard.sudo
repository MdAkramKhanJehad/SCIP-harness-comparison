# vvaharness/backends/harness/repeat_guard.py

The repeated-identical-tool-call guard (VVAH-E009). It wraps a streaming session and aborts it when the same agent calls the same tool with the same input 20 times in a row. Only the Stage 10 and Stage 11 stream consumers install it.

Source: `vvaharness/backends/harness/repeat_guard.py` (lines 1-68)
Executor: code
Called from: `vvaharness/validation/session/launcher.py:488` (Stage 11) and `vvaharness/remediation_agent/plugin_runner/__init__.py:256` (Stage 10, deepagents route); grep of the package finds no other installation, so detection stages (Stages 1-8) run without it

// src: vvaharness/backends/harness/repeat_guard.py:30-31
REPEAT_CALL_LIMIT = 20

// src: vvaharness/backends/harness/repeat_guard.py:48-68
fn guard_repeats(source, stage, route):executor=code {
  last = null; streak = 0
  constraint OnEveryExit {
    close source now (aclose, errors suppressed) rather than leaving it to garbage collection   // src: repeat_guard.py:40-45, 67-68
  }
  for each msg in source {
    if (msg is HarnessToolUse) {
      signature = _signature(msg)
      streak = if (signature == last) streak + 1 else 1   // only consecutive identical calls count; any different tool call resets
      last = signature
      require streak < REPEAT_CALL_LIMIT
        => throw RepeatedToolCallError("${signature.agent} called ${msg.name} with identical input $streak times in a row", stage, route, tool_name=msg.name, repeats=streak)
    }
    yield msg   // assistant text and tool results pass through and do not reset the streak
  }
}

// src: vvaharness/backends/harness/repeat_guard.py:34-37
fn _signature(msg):executor=code {
  return (msg.agent || "orchestrator", msg.name, JSON of msg.input with sorted keys)
}
