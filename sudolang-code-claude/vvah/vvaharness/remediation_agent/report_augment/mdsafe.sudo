// src: vvaharness/remediation_agent/report_augment/mdsafe.py:21-33
_MD_ESCAPE = { "\\", "`", "*", "_", "[", "]", "|", "#" backslash-escaped; "<" "&lt;", ">" "&gt;", "&" "&amp;" }
fn _md_escape(value):executor=code {
  return value with every line separator (including U+2028/U+2029) folded to a space, bidirectional and zero-width characters removed, then every _MD_ESCAPE character replaced
}

// src: vvaharness/remediation_agent/report_augment/mdsafe.py:36-43
fn _md_code_span(value):executor=code {
  return "`" + (value with line separators folded, invisible characters and backticks removed, "&", "<", ">" entity-escaped) + "`"
}
