// file: vvaharness/models/scan/threat.py
// The threat model S2 produces (assets, boundaries, threats): schema, off-schema enum coercion,
// and the deterministic rank + coverage-preserving caps S2.run applies.

@executedBy(CODE) @role(types) @stage("S2")
record Asset(String name, String description, String sensitivity) { }

@executedBy(CODE) @role(types) @stage("S2")
record TrustBoundary(String entryPoint, String crossing, List<String> reachableAssets) { }

@executedBy(CODE) @role(types) @stage("S2")
record Threat(String id, String threat, String actor, String surface, List<String> surfaceFiles, String asset, String impact, String likelihood, String controls, String evidence) { }

@executedBy(MIXED) @role(types) @stage("S2")
class ScanThreat {

    /** Asset.sensitivity: off-schema values coerced via aliases, default medium. */
    String coerceSensitivity(String v, Theta θ) {
        return Coerce.coerceEnum(v, θ["p.threat.asset_sensitivity_set"], SENSITIVITY_ALIAS, "medium"); // src: vvaharness/models/scan/threat.py:39
    }

    /** Threat.actor: fixed seven-value taxonomy; aliases (external, admin, vendor...) mapped, default remote_auth. */
    String coerceActor(String v, Theta θ) {
        return Coerce.coerceEnum(v, θ["p.threat.actor_set"], ACTOR_ALIAS, "remote_auth");  // src: vvaharness/models/scan/threat.py:89
    }

    String coerceImpact(String v, Theta θ) {
        return Coerce.coerceEnum(v, θ["p.threat.impact_set"], IMPACT_ALIAS, "medium");     // src: vvaharness/models/scan/threat.py:103
    }

    String coerceLikelihood(String v, Theta θ) {
        return Coerce.coerceEnum(v, θ["p.threat.likelihood_set"], LIKELIHOOD_ALIAS, "possible"); // src: vvaharness/models/scan/threat.py:104
    }

    /** Field description of Threat.surface_files (sent to the model as part of the ThreatModel schema). */
    @executedBy(MODEL) @role(prompt)
    Prompt surfaceFilesDescription(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.threat.surface_files_every_path"]);                                    // src: vvaharness/models/scan/threat.py:94
        p.must(θ["p.threat.surface_files_required_when_concrete"]);                        // src: vvaharness/models/scan/threat.py:96
        p.rule(θ["p.threat.surface_files_empty_is_dead_end"]);                             // src: vvaharness/models/scan/threat.py:99
        return p;
    }

    /** Positional T<n> when blank: the key S3 mints units under. */
    List<String> threatIds(ThreatModel tm) {
        return tm.threats.mapIndexed((i, t) -> t.id.isEmpty() ? "T" + (i + 1) : t.id);     // src: vvaharness/models/scan/threat.py:138
    }

    /** Deterministic total order, most severe first: impact, asset sensitivity, likelihood, actor, uncontrolled first, id. */
    Tuple rankKey(Threat t, ThreatModel tm) {
        return new Tuple(-IMPACT_RANK.get(t.impact), -sensitivityOf(t, tm), -LIKELIHOOD_RANK.get(t.likelihood), -ACTOR_RANK.get(t.actor), (t.controls.isEmpty() || t.controls == "none") ? 0 : 1, idOrdinal(t.id), t.id); // src: vvaharness/models/scan/threat.py:225
    }

    /** Truncate to maxThreats, preserving every trust boundary's coverage (addressed by position, never id). */
    ThreatModel capThreats(ThreatModel tm, int maxThreats) {
        List<Threat> threats = sorted(tm.threats, t -> rankKey(t, tm));                    // no dedup  // src: vvaharness/models/scan/threat.py:309
        if (threats.size() <= maxThreats) return tm.withThreats(threats);                  // src: vvaharness/models/scan/threat.py:311
        Set<Integer> kept = range(0, maxThreats);                                          // src: vvaharness/models/scan/threat.py:315
        List<Integer> evicted = range(maxThreats, threats.size());                         // src: vvaharness/models/scan/threat.py:316
        kept = promoteForCoverage(threats, kept, evicted, tm.trustBoundaries);              // src: vvaharness/models/scan/threat.py:319
        return tm.withThreats(sorted(kept).map(i -> threats.get(i)));                      // src: vvaharness/models/scan/threat.py:327
    }

    /** Swap in an evicted threat covering an uncovered boundary for the worst-ranked survivor whose removal loses no coverage. */
    Set<Integer> promoteForCoverage(List<Threat> threats, Set<Integer> kept, List<Integer> evicted, List<TrustBoundary> boundaries) {
        Set<String> uncovered = boundaries.names().minus(coveredBoundaries(threats, kept, boundaries)); // src: vvaharness/models/scan/threat.py:283
        boolean progressed = true;
        while (!uncovered.isEmpty() && progressed) {                                       // src: vvaharness/models/scan/threat.py:287
            progressed = false;
            for (String b : uncovered.copy()) {                                            // src: vvaharness/models/scan/threat.py:289
                Integer cand = nextCoveringCandidate(threats, kept, evicted, b);            // src: vvaharness/models/scan/threat.py:290
                if (cand == null) continue;
                Integer evict = bestEvictable(threats, kept, boundaries);                   // src: vvaharness/models/scan/threat.py:293
                if (evict == null) continue;
                kept.remove(evict); kept.add(cand);                                         // src: vvaharness/models/scan/threat.py:296
                uncovered.remove(b); progressed = true;                                     // src: vvaharness/models/scan/threat.py:301
            }
        }
        return kept;
    }

    ThreatModel capAssets(ThreatModel tm, int maxAssets) {
        if (tm.assets.size() <= maxAssets) return tm;                                      // src: vvaharness/models/scan/threat.py:331
        return tm.withAssets(sorted(tm.assets, a -> new Tuple(-SENSITIVITY_RANK.get(a.sensitivity), a.name)).take(maxAssets)); // src: vvaharness/models/scan/threat.py:333
    }

    ThreatModel capBoundaries(ThreatModel tm, int maxBoundaries) {
        if (tm.trustBoundaries.size() <= maxBoundaries) return tm;                         // src: vvaharness/models/scan/threat.py:339
        return tm.withBoundaries(sorted(tm.trustBoundaries, b -> new Tuple(-b.reachableAssets.size(), b.entryPoint)).take(maxBoundaries)); // src: vvaharness/models/scan/threat.py:341
    }
}
