// file: vvaharness/orchestrator/store/_db.py
// SQLite state store plumbing: state-dir resolution and creation (owner-only, symlink-refusing), the DB file, connection pragmas,
// schema migration, and the per-run row operations (register, reset, steps, delete). The facade is orchestrator/store/__init__.pseudo.

@executedBy(CODE) @role(io)
class Db {

    /** Largest replay bundle stored: enforced here AND by a table CHECK, so a direct INSERT is bounded too. */
    @src("vvaharness/orchestrator/store/_db.py:30")
    int REPLAY_MAX_BYTES = θ["code.orchestrator.store.replay_max_bytes"];                                   // 1 MiB; bodies themselves are capped at 512 bytes // src: vvaharness/orchestrator/store/_db.py:30

    /** Permission problems degrade to ONE stderr warning per path per process: a confidentiality hardening must not break a scan. */
    @src("vvaharness/orchestrator/store/_db.py:41")
    void warnOnce(String key, String message) {
        WarnOnce.warnOnce(PERM_WARNED, key, "[store] WARN: " + message);                                    // src: vvaharness/orchestrator/store/_db.py:43
    }

    /** Best-effort chmod of path down to mode when it is looser. Never raises, never loosens an already-tighter mode; non-POSIX is skipped entirely. */
    @src("vvaharness/orchestrator/store/_db.py:46")
    void tightenMode(Path path, int mode) {
        if (!POSIX) return;                                                                                 // src: vvaharness/orchestrator/store/_db.py:50
        int current;
        try {
            current = Files.modeBits(path);                                                                 // src: vvaharness/orchestrator/store/_db.py:52
        } catch (OSError e) {
            return;                                                                                         // absent (for example no sidecar yet): nothing to tighten // src: vvaharness/orchestrator/store/_db.py:54
        }
        if ((current & ~mode) == 0) return;                                                                 // already at least as tight as the target // src: vvaharness/orchestrator/store/_db.py:56
        try {
            Files.chmod(path, mode);                                                                        // src: vvaharness/orchestrator/store/_db.py:58
        } catch (OSError e) {
            warnOnce(path.toString(), "could not tighten permissions on the path (it holds scanned-source snippets)"); // src: vvaharness/orchestrator/store/_db.py:60
        }
    }

    /** Where scan state lives, resolved and nothing more: VVAHARNESS_STATE_DIR, else ~/.vvaharness/state. Deliberately NO I/O (scan resolves this pre-safety-check, so --stop-after must not mkdir home). */
    @src("vvaharness/orchestrator/store/_db.py:69")
    Path stateRoot(Theta θ) {
        String env = θ["env.VVAHARNESS_STATE_DIR"];                                                         // src: vvaharness/orchestrator/store/_db.py:72
        return env != null && !env.isEmpty() ? Path.of(env) : Path.home().resolve(".vvaharness").resolve("state"); // src: vvaharness/orchestrator/store/_db.py:72
    }

    /** state_root()/parts, creating each level owner-only. The only place state-root dirs are made; EVERY level is tightened (parents=True leaves the umask default). */
    @src("vvaharness/orchestrator/store/_db.py:76")
    Path ensureStateDir(List<String> parts, Theta θ) {
        Path root = stateRoot(θ);                                                                           // src: vvaharness/orchestrator/store/_db.py:78
        if (POSIX) {                                                                                        // src: vvaharness/orchestrator/store/_db.py:79
            // lstat BEFORE anything follows it: a planted link would redirect is_dir()
            Stat lst = Files.lstatOrNull(root);                                                             // src: vvaharness/orchestrator/store/_db.py:82
            if (lst != null && lst.isSymlink()) throw new StoreError("refusing to use state directory: it is a symlink"); // src: vvaharness/orchestrator/store/_db.py:86
        }
        if (root.isDir()) {                                                                                 // src: vvaharness/orchestrator/store/_db.py:89
            // NOT one decision: an operator-chosen VVAHARNESS_STATE_DIR only warns; the default dir is repaired
            if (POSIX) {                                                                                    // src: vvaharness/orchestrator/store/_db.py:91
                int mode = Files.modeBitsOrZero(root);                                                      // src: vvaharness/orchestrator/store/_db.py:93
                if ((mode & 0077) != 0) {                                                                   // group or other accessible // src: vvaharness/orchestrator/store/_db.py:97
                    if (θ["env.VVAHARNESS_STATE_DIR"] != null && !θ["env.VVAHARNESS_STATE_DIR"].isEmpty()) {
                        warnOnce(root.toString(), "state directory is group/other-accessible and holds scanned-source snippets"); // src: vvaharness/orchestrator/store/_db.py:99
                    } else {
                        tightenMode(root, θ["code.orchestrator.store.state_dir_mode"]);                     // src: vvaharness/orchestrator/store/_db.py:105
                        warnOnce(root.toString(), "tightened the state directory to 700");                  // src: vvaharness/orchestrator/store/_db.py:106
                    }
                }
            }
        } else {
            try {
                root.mkdirs();                                                                              // src: vvaharness/orchestrator/store/_db.py:113
            } catch (FileExistsError e) {
                // exist_ok forgives only an existing directory; a plain file is refused cleanly
                throw new StoreError("refusing to use state directory: it exists and is not a directory");   // src: vvaharness/orchestrator/store/_db.py:116
            }
            tightenMode(root, θ["code.orchestrator.store.state_dir_mode"]);                                 // a directory this process created is owner-only by construction // src: vvaharness/orchestrator/store/_db.py:121
        }
        Path path = root;                                                                                   // src: vvaharness/orchestrator/store/_db.py:122
        for (String part : parts) {                                                                         // src: vvaharness/orchestrator/store/_db.py:123
            path = path.resolve(part);
            path.mkdirs();                                                                                  // src: vvaharness/orchestrator/store/_db.py:125
            tightenMode(path, θ["code.orchestrator.store.state_dir_mode"]);                                 // src: vvaharness/orchestrator/store/_db.py:126
        }
        return path;                                                                                        // src: vvaharness/orchestrator/store/_db.py:127
    }

    /** The DB path, creating NOTHING: the read-only counterpart of dbPath. Asking whether state exists must not create the state directory (gc needs exactly this). */
    @src("vvaharness/orchestrator/store/_db.py:132")
    Path dbLocation(Theta θ) {
        return stateRoot(θ).resolve("vvaharness.db");                                                       // src: vvaharness/orchestrator/store/_db.py:135
    }

    /** Look up a run without creating, migrating or changing store permissions (read-only URI). Any symlink on the path is refused. */
    @src("vvaharness/orchestrator/store/_db.py:138")
    boolean runExists(String runId, Theta θ) {
        Path path = dbLocation(θ);                                                                          // src: vvaharness/orchestrator/store/_db.py:140
        try {
            for (Path candidate : List.of(stateRoot(θ), path)) {                                            // src: vvaharness/orchestrator/store/_db.py:143
                if (candidate.isSymlink()) throw new StoreError("refusing to inspect state path: it is a symlink"); // src: vvaharness/orchestrator/store/_db.py:144
            }
            try {
                path.stat();                                                                                // src: vvaharness/orchestrator/store/_db.py:146
            } catch (FileNotFoundError e) {
                return false;                                                                               // src: vvaharness/orchestrator/store/_db.py:148
            }
            Connection con = Sqlite.connectReadOnly(path.resolve());                                        // src: vvaharness/orchestrator/store/_db.py:149
            try {
                return con.queryOne("SELECT 1 FROM runs WHERE run_id = ?", runId) != null;                  // src: vvaharness/orchestrator/store/_db.py:151
            } finally {
                con.close();                                                                                // src: vvaharness/orchestrator/store/_db.py:153
            }
        } catch (OSError | SqliteError error) {
            throw new StoreError("could not inspect state database");                                       // src: vvaharness/orchestrator/store/_db.py:155
        }
    }

    /** The state DB path, resolved the way scan resolves the legacy checkpoints root, so --resume and the in-target safety check see the same location. Creates the state dir. */
    @src("vvaharness/orchestrator/store/_db.py:158")
    Path dbPath(Theta θ) {
        return ensureStateDir(List.of(), θ).resolve("vvaharness.db");                                       // src: vvaharness/orchestrator/store/_db.py:160
    }

    /** Create the DB file owner-only, refusing a symlink planted at path. sqlite3 itself creates 0644 and lacks O_EXCL and O_NOFOLLOW, so the file is pre-created. */
    @src("vvaharness/orchestrator/store/_db.py:163")
    void createDbFileSafe(Path path, Theta θ) {
        try {
            Files.createExclusiveNoFollow(path, θ["code.orchestrator.store.db_file_mode"]);                 // O_CREAT | O_EXCL | O_NOFOLLOW at mode 0600 // src: vvaharness/orchestrator/store/_db.py:167
            return;                                                                                         // freshly created by us, so not a symlink // src: vvaharness/orchestrator/store/_db.py:169
        } catch (OSError err) {
            // already exists, or is a symlink; either way, checked below
        }
        Stat st;
        try {
            st = Files.lstat(path);                                                                         // src: vvaharness/orchestrator/store/_db.py:173
        } catch (FileNotFoundError e) {
            throw new FileNotFoundError("could not create state DB");                                       // report the create's own cause (for example EACCES on a read-only dir), not lstat's ENOENT // src: vvaharness/orchestrator/store/_db.py:176
        }
        if (st.isSymlink()) throw new StoreError("refusing to open state DB: it is a symlink");             // src: vvaharness/orchestrator/store/_db.py:179
    }

    /** Open the state DB, ensure the schema exists, return a connection. Cheap enough per operation since sqlite connections are thread-affine. */
    @src("vvaharness/orchestrator/store/_db.py:182")
    Connection connect(Theta θ) {
        Path path = dbPath(θ);                                                                              // src: vvaharness/orchestrator/store/_db.py:184
        if (POSIX) createDbFileSafe(path, θ);                                                               // src: vvaharness/orchestrator/store/_db.py:186
        Connection con = Sqlite.connect(path);                                                              // src: vvaharness/orchestrator/store/_db.py:187
        // per-connection pragmas: must be set on every handle
        con.execute("PRAGMA foreign_keys = ON");                                                            // src: vvaharness/orchestrator/store/_db.py:189
        con.execute("PRAGMA busy_timeout = " + θ["code.orchestrator.store.busy_timeout_ms"]);               // 30 s of lock wait before SQLITE_BUSY // src: vvaharness/orchestrator/store/_db.py:190
        con.execute("PRAGMA synchronous = NORMAL");                                                         // src: vvaharness/orchestrator/store/_db.py:191
        // skipped entirely once user_version matches, so the hot path is three pragmas plus one read
        int have = con.queryOne("PRAGMA user_version").get(0);                                              // src: vvaharness/orchestrator/store/_db.py:193
        if (have != SCHEMA_VERSION) migrate(con, have);                                                     // SCHEMA_VERSION is 3 // src: vvaharness/orchestrator/store/_db.py:194
        // tighten a 0644 DB from an older release plus the WAL, SHM and journal sidecars (same payload bytes)
        for (Path p : List.of(path, path + "-wal", path + "-shm", path + "-journal")) {                      // src: vvaharness/orchestrator/store/_db.py:197
            tightenMode(p, θ["code.orchestrator.store.db_file_mode"]);                                      // src: vvaharness/orchestrator/store/_db.py:199
        }
        return con;                                                                                         // src: vvaharness/orchestrator/store/_db.py:200
    }

    /** Schema migration: v0 gets the whole DDL; an existing DB runs the migrations cumulatively (v1 gets both V2 and V3). */
    @src("vvaharness/orchestrator/store/_db.py:203")
    void migrate(Connection con, int have) {
        if (have == 0) {
            con.executeScript(Schema.DDL);                                                                  // src: vvaharness/orchestrator/store/_db.py:206
        } else {
            if (have < 2) con.executeScript(Schema.DDL_V2);                                                 // src: vvaharness/orchestrator/store/_db.py:209
            if (have < 3) con.executeScript(Schema.DDL_V3);                                                 // src: vvaharness/orchestrator/store/_db.py:211
        }
        con.execute("PRAGMA user_version = " + SCHEMA_VERSION);                                             // src: vvaharness/orchestrator/store/_db.py:212
        con.commit();                                                                                       // src: vvaharness/orchestrator/store/_db.py:213
    }

    /** Upsert the per-run metadata row at the top of scanRepo, so gc can rank runs by recency. */
    @src("vvaharness/orchestrator/store/_db.py:216")
    void registerRun(String runId, String repoRoot, String repoName, String appId, Theta θ) {
        Connection con = connect(θ);                                                                        // src: vvaharness/orchestrator/store/_db.py:219
        con.transaction(() -> con.execute("INSERT INTO runs ... ON CONFLICT(run_id) DO UPDATE SET repo_root, repo_name, app_id, updated_at = now", runId, repoRoot, repoName, appId)); // src: vvaharness/orchestrator/store/_db.py:221
        con.close();                                                                                        // src: vvaharness/orchestrator/store/_db.py:232
    }

    /** Delete every checkpoint row (fixed s1..s9 steps and dynamic remediate and validate steps) and callgraph snapshot of one run; returns the count. ev_replays are DELIBERATELY not cleared: they must outlive a rescan (deleteRun reaps them by FK cascade). */
    @src("vvaharness/orchestrator/store/_db.py:235")
    int resetRun(String runId, Theta θ) {
        Connection con = connect(θ);                                                                        // src: vvaharness/orchestrator/store/_db.py:238
        try {
            int cleared = 0;                                                                                // src: vvaharness/orchestrator/store/_db.py:241
            cleared += con.execute("DELETE FROM checkpoints WHERE run_id = ?", runId).rowcount;             // src: vvaharness/orchestrator/store/_db.py:242
            cleared += con.execute("DELETE FROM callgraph_snapshots WHERE run_id = ?", runId).rowcount;     // src: vvaharness/orchestrator/store/_db.py:244
            return cleared;                                                                                 // src: vvaharness/orchestrator/store/_db.py:246
        } finally {
            con.close();                                                                                    // src: vvaharness/orchestrator/store/_db.py:248
        }
    }

    /** Checkpoint step keys of a run starting with prefix, sorted. The dynamic keys hash engine identity and a case id, so no caller can reconstruct one to look it up directly. */
    @src("vvaharness/orchestrator/store/_db.py:251")
    List<String> stepsWithPrefix(String runId, String prefix, Theta θ) {
        Connection con = connect(θ);                                                                        // src: vvaharness/orchestrator/store/_db.py:254
        try {
            List<Row> rows = con.query("SELECT step FROM checkpoints WHERE run_id = ?", runId);             // src: vvaharness/orchestrator/store/_db.py:255
            return rows.map(r -> r.get(0)).filter(step -> step.startsWith(prefix)).sorted();               // src: vvaharness/orchestrator/store/_db.py:257
        } finally {
            con.close();                                                                                    // src: vvaharness/orchestrator/store/_db.py:259
        }
    }

    /** Delete a run's checkpoint rows whose step starts with prefix and is not in keep: the complement of resetRun for the standalone remediate and validate commands. Returns the deleted keys, sorted. */
    @src("vvaharness/orchestrator/store/_db.py:262")
    List<String> deleteSteps(String runId, String prefix, Collection<String> keep, Theta θ) {
        Connection con = connect(θ);                                                                        // src: vvaharness/orchestrator/store/_db.py:265
        try {
            List<String> victims = con.query("SELECT step FROM checkpoints WHERE run_id = ?", runId).map(r -> r.get(0)).filter(step -> step.startsWith(prefix) && !keep.contains(step)).sorted(); // src: vvaharness/orchestrator/store/_db.py:267
            con.transaction(() -> con.executeMany("DELETE FROM checkpoints WHERE run_id = ? AND step = ?", victims.map(v -> Pair.of(runId, v)))); // src: vvaharness/orchestrator/store/_db.py:271
            return victims;                                                                                 // src: vvaharness/orchestrator/store/_db.py:273
        } finally {
            con.close();                                                                                    // src: vvaharness/orchestrator/store/_db.py:275
        }
    }

    /** Remove the run's code-graph workspaces under graphs/run_id; absent is fine. */
    @src("vvaharness/orchestrator/store/_db.py:278")
    void deleteRunGraphs(String runId, Theta θ) {
        Files.rmtree(stateRoot(θ).resolve("graphs").resolve(runId), true);                                  // src: vvaharness/orchestrator/store/_db.py:280
    }

    /** Fully evict one run: delete its runs row (checkpoints and ev_replays go by ON DELETE CASCADE), vacuum, drop its graph workspaces. Guarded like prune_checkpoints: connect would create the DB just to report no such run. */
    @src("vvaharness/orchestrator/store/_db.py:283")
    boolean deleteRun(String runId, Theta θ) {
        if (!dbLocation(θ).exists()) return false;                                                          // src: vvaharness/orchestrator/store/_db.py:286
        Connection con = connect(θ);                                                                        // src: vvaharness/orchestrator/store/_db.py:288
        try {
            int deleted = con.transaction(() -> con.execute("DELETE FROM runs WHERE run_id = ?", runId).rowcount); // src: vvaharness/orchestrator/store/_db.py:291
            if (deleted > 0) {                                                                              // src: vvaharness/orchestrator/store/_db.py:293
                // incremental_vacuum frees one page per fetched row: unfetched, it frees one page
                con.query("PRAGMA incremental_vacuum");                                                     // src: vvaharness/orchestrator/store/_db.py:295
                con.execute("PRAGMA wal_checkpoint(TRUNCATE)");                                             // src: vvaharness/orchestrator/store/_db.py:296
            }
            deleteRunGraphs(runId, θ);                                                                      // src: vvaharness/orchestrator/store/_db.py:297
            return deleted > 0;                                                                             // src: vvaharness/orchestrator/store/_db.py:298
        } finally {
            con.close();                                                                                    // src: vvaharness/orchestrator/store/_db.py:300
        }
    }
}

/** A state-store precondition refused rather than silently worked around: a symlinked state dir or DB path, or a state root that exists but is not a directory. */
@executedBy(CODE) @role(types)
@src("vvaharness/orchestrator/store/_db.py:65")
class StoreError extends RuntimeError { }
