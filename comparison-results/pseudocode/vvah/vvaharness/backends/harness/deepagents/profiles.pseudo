// file: vvaharness/backends/harness/deepagents/profiles.py
// Harness profiles for OpenAI-compatible models: the "investigation floor" system-prompt suffix registered with
// deepagents per provider (openai only) and per stage-keyed model. Anthropic routes get no suffix.

@executedBy(CODE) @role(config)
class DeepagentsProfiles {

    boolean registered;

    // Called once per process from the graph builder before create_deep_agent.
    void registerVvahHarnessProfiles(Theta θ) {
        if (registered) return;                                                                          // src: vvaharness/backends/harness/deepagents/profiles.py:108
        Prompt floor = InvestigationFloorPrompt.investigationFloor(θ);                                   // src: vvaharness/backends/harness/deepagents/profiles.py:110
        for (String key : θ["p.deepagents_profiles.profiled_providers"]) {   // ("openai",)                // src: vvaharness/backends/harness/deepagents/profiles.py:79
            registerHarnessProfile(key, floor);                                                          // src: vvaharness/backends/harness/deepagents/profiles.py:112
        }
        Map<String, Map<String, String>> stageSuffix = θ["p.deepagents_profiles.stage_suffix_overrides"];  // currently empty // src: vvaharness/backends/harness/deepagents/profiles.py:85
        Map<String, String> perModel = θ["p.deepagents_profiles.per_model_suffix_overrides"];              // currently empty // src: vvaharness/backends/harness/deepagents/profiles.py:81
        for (String key : minus(stageKeyedModels(stageSuffix), perModel.keys()).sorted()) {
            registerHarnessProfile(key, floor);                                                          // src: vvaharness/backends/harness/deepagents/profiles.py:114
        }
        for (String key : perModel.keys()) registerHarnessProfile(key, new Prompt().rule(perModel.get(key))); // src: vvaharness/backends/harness/deepagents/profiles.py:116
        registered = true;
    }

    // The suffix overriding registry_key's for this stage, or null to leave it in place.
    String stageProfileSuffix(String stage, String registryKey, Theta θ) {
        Map<String, Map<String, String>> stageSuffix = θ["p.deepagents_profiles.stage_suffix_overrides"];  // src: vvaharness/backends/harness/deepagents/profiles.py:95
        Map<String, String> byModel = stageSuffix.get(stage);
        return byModel != null ? byModel.get(registryKey) : null;                                        // src: vvaharness/backends/harness/deepagents/profiles.py:96
    }

    Set<String> stageKeyedModels(Map<String, Map<String, String>> stageSuffix) {
        return stageSuffix.values().flatMap(m -> m.keys()).toSet();                                      // src: vvaharness/backends/harness/deepagents/profiles.py:101
    }
}

@executedBy(MODEL) @role(prompt)
class InvestigationFloorPrompt {

    // _INVESTIGATION_FLOOR = join of four blocks (reflect-in-writing, not the without-writing variant).
    Prompt investigationFloor(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.investigation_floor"]);                       // applied on the openai provider only   // src: vvaharness/backends/harness/deepagents/profiles.py:70
        List<String> blocks = θ["p.deepagents_profiles.investigation_floor_composition"];                 // src: vvaharness/backends/harness/deepagents/profiles.py:70
        p.include(readBeforeAnswering(θ));                                                               // src: vvaharness/backends/harness/deepagents/profiles.py:72
        p.include(parallelToolCalls(θ));                                                                 // src: vvaharness/backends/harness/deepagents/profiles.py:73
        p.include(reflectInWriting(θ));                                                                  // src: vvaharness/backends/harness/deepagents/profiles.py:74
        p.include(enumerateDoNotSummarise(θ));                                                           // src: vvaharness/backends/harness/deepagents/profiles.py:75
        return p;
    }

    Prompt readBeforeAnswering(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.deepagents_profiles.never_describe_unopened_code"]);                               // src: vvaharness/backends/harness/deepagents/profiles.py:35
        p.persona(θ["p.deepagents_profiles.graded_on_actual_repo"]);                                     // src: vvaharness/backends/harness/deepagents/profiles.py:35
        p.must(θ["p.deepagents_profiles.open_every_dependent_file"]);                                    // src: vvaharness/backends/harness/deepagents/profiles.py:35
        p.must(θ["p.deepagents_profiles.named_path_must_be_read"]);                                      // src: vvaharness/backends/harness/deepagents/profiles.py:35
        p.rule(θ["p.deepagents_profiles.empty_tool_result_requery"]);  // empty result is a fact about the query // src: vvaharness/backends/harness/deepagents/profiles.py:35
        return p;
    }

    Prompt parallelToolCalls(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.deepagents_profiles.batch_tool_calls"]);                                             // src: vvaharness/backends/harness/deepagents/profiles.py:40
        p.exemption(θ["p.deepagents_profiles.serialise_only_dependent_calls"]);                          // src: vvaharness/backends/harness/deepagents/profiles.py:40
        p.forbid(θ["p.deepagents_profiles.never_guess_parameters"]);                                     // src: vvaharness/backends/harness/deepagents/profiles.py:40
        return p;
    }

    Prompt reflectInWriting(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.deepagents_profiles.reflect_after_each_batch"]);                                     // src: vvaharness/backends/harness/deepagents/profiles.py:45
        p.forbid(θ["p.deepagents_profiles.no_final_answer_with_unverified_claim"]);                      // src: vvaharness/backends/harness/deepagents/profiles.py:45
        return p;
    }

    // Alternative block defined but not part of the floor (available to a per-model override).
    Prompt reflectWithoutWriting(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.deepagents_profiles.reflect_without_writing_variant"]);                              // src: vvaharness/backends/harness/deepagents/profiles.py:50
        p.forbid(θ["p.deepagents_profiles.no_final_answer_with_unverified_claim"]);                      // src: vvaharness/backends/harness/deepagents/profiles.py:50
        return p;
    }

    Prompt enumerateDoNotSummarise(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.deepagents_profiles.list_length_is_deliverable"]);                                   // src: vvaharness/backends/harness/deepagents/profiles.py:55
        p.rule(θ["p.deepagents_profiles.narrow_items_over_broad"]);                                      // src: vvaharness/backends/harness/deepagents/profiles.py:55
        p.must(θ["p.deepagents_profiles.exhaust_evidenced_cases"]);                                      // src: vvaharness/backends/harness/deepagents/profiles.py:55
        p.forbid(θ["p.deepagents_profiles.no_stop_at_representative_few"]);                              // src: vvaharness/backends/harness/deepagents/profiles.py:55
        p.forbid(θ["p.deepagents_profiles.no_merge_by_shared_file"]);                                    // src: vvaharness/backends/harness/deepagents/profiles.py:55
        return p;
    }

    // Defined (_BEAT_THE_CLOCK) but not in the floor composition; unclear: no registration uses it today.
    Prompt beatTheClock(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.deepagents_profiles.wall_clock_stance"]);                                         // src: vvaharness/backends/harness/deepagents/profiles.py:60
        p.forbid(θ["p.deepagents_profiles.three_costly_habits"]);                                        // src: vvaharness/backends/harness/deepagents/profiles.py:60
        p.rule(θ["p.deepagents_profiles.cite_path_line_and_move_on"]);                                   // src: vvaharness/backends/harness/deepagents/profiles.py:60
        p.forbid(θ["p.deepagents_profiles.clock_never_reduces_item_count"]);                             // src: vvaharness/backends/harness/deepagents/profiles.py:62
        return p;
    }

    // Defined (_DO_NOT_NARRATE) but not in the floor composition; unclear: no registration uses it today.
    Prompt doNotNarrate(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.deepagents_profiles.no_restating_code"]);                                          // src: vvaharness/backends/harness/deepagents/profiles.py:67
        p.forbid(θ["p.deepagents_profiles.no_narrating_plan"]);                                          // src: vvaharness/backends/harness/deepagents/profiles.py:67
        p.forbid(θ["p.deepagents_profiles.no_summarising_tool_results"]);                                // src: vvaharness/backends/harness/deepagents/profiles.py:67
        p.rule(θ["p.deepagents_profiles.brevity_never_shortens_list"]);                                  // src: vvaharness/backends/harness/deepagents/profiles.py:67
        return p;
    }
}
