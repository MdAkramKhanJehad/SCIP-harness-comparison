// src: vvaharness/validation/config/settings/agent.py:35-62
// defaults from vvaharness/validation/constants/artifacts.py:127-140
AgentConfig {   // extra fields forbidden
  binary: String = "claude"                      // DEFAULT_CLAUDE_BINARY
  model: String = "claude-opus-4-8[1m]"          // DEFAULT_MODEL
  max_turns: Number = 50                         // DEFAULT_MAX_TURNS
  max_budget_usd: Number | null = 15.0           // DEFAULT_MAX_BUDGET_USD
  effort: EffortLevel = HIGH                     // DEFAULT_EFFORT
  timeout: Number = 3600                         // DEFAULT_TIMEOUT_S; "Whole-session wall clock, seconds; a falsy value falls back to DEFAULT_TIMEOUT_S."
  max_model_calls: Number = 60                   // DEFAULT_PERSONA_MAX_MODEL_CALLS; per reviewer persona before its forced final report turn (deepagents only)
  orchestrator_max_model_calls: Number = 40      // DEFAULT_ORCHESTRATOR_MAX_MODEL_CALLS; orchestrator before its forced final report turn (deepagents only)
  via: String = "deepagents"                     // DEFAULT_VALIDATION_VIA
  provider: String | null = null                 // deepagents backend: openai | anthropic; null means infer
  use_responses_api: Boolean | null = null       // OpenAI transport override for deepagents; null resolves (learned, then Responses)
  security_architect_model: String | null = null // per-persona model override; null inherits model
  penetration_tester_model: String | null = null
  cross_repo_analyzer_model: String | null = null
  validate_tools: [String] | null = null         // reviewer persona tool allow-list (step_validate.allowed_tools); null keeps the subagent .md default
  cache_markers: Boolean = true                  // whether BlockMarkerPromptCaching places cache markers
}
