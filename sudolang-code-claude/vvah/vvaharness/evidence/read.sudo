# vvaharness/evidence/read.py

The single containment-checked, length-capped read used for every on-disk evidence read.

Source: `vvaharness/evidence/read.py` (lines 1-58)
Executor: code
Called from: `vvaharness/evidence/docs.py`, `vvaharness/evidence/configs.py`, `vvaharness/evidence/manifests.py`

// src: vvaharness/evidence/read.py:23-33
fn _contained(root, p):executor=code {
  // strict resolution: a dangling symlink or a missing file returns null
  return resolved p if it is inside resolved root, else null
}

// src: vvaharness/evidence/read.py:36-39
fn _cap_text(txt, cap_chars):executor=code = if (length(txt) > cap_chars) first cap_chars characters + "\n…(truncated, N chars total)" else txt

// src: vvaharness/evidence/read.py:42-58
fn _read_capped(root, p, cap_chars, whole_or_nothing=false):executor=code {
  rp = _contained(root, p)
  require rp != null => {
    errlog.log("s2", "containment", "refused to read outside repo root: $p", reason="containment_refused", recovered=true)
    return ""
  }
  txt = read rp as utf-8 with replacement ("" on any error)
  if (whole_or_nothing && length(txt) > cap_chars) return ""   // never a truncated prefix
  return _cap_text(txt, cap_chars)
}
