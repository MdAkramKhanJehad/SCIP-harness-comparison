// file: vvaharness/pipeline/stages/s5/__init__.py
// Step 5: enrich S4's findings for S6 (snippet, evidence refs, sink re-anchor), refuse only
// coordinates that do not exist, trivially dedupe, then append zero-LLM detector rows.

@executedBy(CODE) @role(stage) @stage("S5")
class S5 {

    DroppedFinding dropped(Finding f, String reason, String detail) {
        return new DroppedFinding(f.file, f.lineStart, f.vulnClass, f.title, f.chunkId, reason, detail); // src: vvaharness/pipeline/stages/s5/__init__.py:36
    }

    int lineTolerance(Theta θ) {
        // A profile's 0 (exact-line matching) is a real value: test null, not falsiness.
        Integer tol = θ["step5_prefilter.line_tolerance"];                                      // src: vvaharness/pipeline/stages/s5/__init__.py:45
        if (tol == null) tol = θ["step7_dedup.line_tolerance"];                                  // src: vvaharness/pipeline/stages/s5/__init__.py:47
        return tol;
    }

    String breakdown(List<DroppedFinding> dropped) {
        return Counts.byReason(dropped).join(", ");                                             // src: vvaharness/pipeline/stages/s5/__init__.py:53
    }

    Pair<List<Finding>, List<DroppedFinding>> run(List<Finding> findings, ContextPackage ctx, Theta θ) {
        FileCache cache = new FileCache(ctx.repoRoot, θ["step1.max_file_kb"]);                   // src: vvaharness/pipeline/stages/s5/__init__.py:63
        Set<String> validFiles = ctx.allFiles.isEmpty() ? null : Set.of(ctx.allFiles);          // src: vvaharness/pipeline/stages/s5/__init__.py:64
        Map anchors = CallgraphConsumer.entryAnchorLines(ctx);                                    // src: vvaharness/pipeline/stages/s5/__init__.py:65
        Map seeds = CallgraphConsumer.seedPathsByFile(ctx.seedTaintPaths);                        // src: vvaharness/pipeline/stages/s5/__init__.py:66
        int tol = lineTolerance(θ);                                                               // src: vvaharness/pipeline/stages/s5/__init__.py:67

        Reanchorer reanchorer = null;
        if (θ["step5_prefilter.sink_reanchor"]) {                                                 // src: vvaharness/pipeline/stages/s5/__init__.py:70
            reanchorer = new Reanchorer(cache, S5Reanchor.sinkPatternsByCwe(),
                                        θ["step5_prefilter.sink_reanchor_max_move_lines"]);       // src: vvaharness/pipeline/stages/s5/__init__.py:73
        }

        List<Finding> keep = new List();
        List<Integer> preAnchor = new List();   // dedup judges proximity on S4's PRE-reanchor line
        List<DroppedFinding> drops = new List();
        for (Finding raw : findings) {                                                            // src: vvaharness/pipeline/stages/s5/__init__.py:79
            // Path gate first: an out-of-inventory path must do no disk I/O.
            Finding f = raw;
            Verdict verdict = S5Gates.rejectPath(raw, validFiles, θ);                             // src: vvaharness/pipeline/stages/s5/__init__.py:82
            if (verdict == null) {
                f = S5Enrich.enrich(raw, cache, anchors, seeds, reanchorer);                      // src: vvaharness/pipeline/stages/s5/__init__.py:84
                verdict = S5Gates.reject(f, validFiles, cache.lines(f.file), θ);                  // src: vvaharness/pipeline/stages/s5/__init__.py:85
            }
            if (verdict == null) {
                f.preAnchorLine = raw.lineStart;                                                  // src: vvaharness/pipeline/stages/s5/__init__.py:87
                keep.add(f);
                preAnchor.add(raw.lineStart);
                continue;
            }
            Counters.bump("s5_dropped_" + verdict.detail.firstWord());                            // src: vvaharness/pipeline/stages/s5/__init__.py:93
            drops.add(dropped(f, verdict.reason, verdict.detail));
        }

        Pair dd = S7Dedup.prefilter(keep, tol, preAnchor);                                        // src: vvaharness/pipeline/stages/s5/__init__.py:96
        keep = dd.first;
        drops.addAll(dd.second);

        // After reanchor+prefilter: detectors dedupe against post-reanchor coordinates.
        int nDet = 0;
        if (θ["step5_detectors.enabled"]) {                                                       // src: vvaharness/pipeline/stages/s5/__init__.py:101
            int maxRows = θ["step5_detectors.max_rows"];                                          // src: vvaharness/pipeline/stages/s5/__init__.py:102
            for (Finding row : S5Detectors.run(keep, ctx, cache, tol, maxRows, θ)) {             // src: vvaharness/pipeline/stages/s5/__init__.py:103
                // No reanchorer: a detector row already sits on the statement its rule matched.
                Finding f = S5Enrich.enrich(row, cache, anchors, seeds, null);                    // src: vvaharness/pipeline/stages/s5/__init__.py:105
                Verdict verdict = S5Gates.reject(f, validFiles, cache.lines(f.file), θ);          // src: vvaharness/pipeline/stages/s5/__init__.py:106
                if (verdict == null) {
                    keep.add(f);
                    nDet += 1;
                    continue;
                }
                Counters.bump("s5_det_rejected");                                                 // src: vvaharness/pipeline/stages/s5/__init__.py:111
                drops.add(dropped(f, verdict.reason, verdict.detail));
            }
        }
        Console.write("[s5-enrich] " + findings.size() + " -> " + keep.size() + " " + breakdown(drops)); // src: vvaharness/pipeline/stages/s5/__init__.py:116
        return Pair.of(keep, drops);
    }
}
