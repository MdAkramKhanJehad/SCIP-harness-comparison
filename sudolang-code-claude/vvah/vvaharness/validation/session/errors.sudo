# vvaharness/validation/session/errors.py

The per-session failure type. Raising it makes the case INCONCLUSIVE (execution/pipeline.sudo); its reason string is what the operator sees.

Source: `vvaharness/validation/session/errors.py` (lines 1-45)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo`, `vvaharness/validation/execution/pipeline.sudo`, `vvaharness/validation/cli/__init__.sudo`

// src: vvaharness/validation/session/errors.py:21-45
ValidationSessionError {
  message; cause?; exit_code?
  fn reason_string():executor=code {
    parts = [message]
    if (exit_code != null) append "exit_code=$exit_code"
    if (cause is HarnessProcessError && cause.stderr) append "stderr: " + last 3 lines of stderr joined by " | "   // STDERR_TAIL_LINES = 3
    else if (cause != null) append "cause=<type>: <cause>"
    return join(parts, " -- ")
  }
}
