// file: vvaharness/backends/llm/cli/retry.py
// The cli retry policy around one `claude` subprocess: rate-limit/overload backoff, bounded timeout retry,
// auth (VVAH-E001) short retries, proxy/TLS (VVAH-E002) fail-fast, refusal first, truncation (VVAH-E005) helpers.

@executedBy(CODE) @role(backend)
class Retry {

    // a hard usage cap ("... resets ...") won't heal: never retried
    Regex RL_HARD_CAP = θ["code.backends.llm.cli.retry.rl_hard_cap_rx"];                                    // "hit your (usage )?limit.*resets" // src: vvaharness/backends/llm/cli/retry.py:56
    int RL_MAX_RETRIES = θ["code.backends.llm.cli.retry.rl_max_retries"];                                   // src: vvaharness/backends/llm/cli/retry.py:57
    List<Integer> RL_BACKOFF = θ["code.backends.llm.cli.retry.rl_backoff_s"];                               // src: vvaharness/backends/llm/cli/retry.py:58
    int TIMEOUT_MAX_RETRIES = LlmModels.TIMEOUT_MAX_RETRIES;                                                // src: vvaharness/backends/llm/cli/retry.py:60
    // placeholder text Claude Code emits while sub-agents run; consumed by cli/session.py (retry, not empty)
    Regex PENDING_RESULT_RX = θ["code.backends.llm.cli.retry.pending_result_rx"];                           // src: vvaharness/backends/llm/cli/retry.py:63
    int PENDING_MAX_RETRIES = θ["code.backends.llm.cli.retry.pending_max_retries"];                         // read in cli/session.py:543 // src: vvaharness/backends/llm/cli/retry.py:71
    List<Integer> PENDING_BACKOFF = θ["code.backends.llm.cli.retry.pending_backoff_s"];                     // read in cli/session.py:549 // src: vvaharness/backends/llm/cli/retry.py:72
    // 3 fast retries absorb JWT clock-skew only, then halt for a credential refresh
    Regex AUTH_FAILURE = θ["code.backends.llm.cli.retry.auth_failure_rx"];                                  // src: vvaharness/backends/llm/cli/retry.py:82
    int AUTH_MAX_RETRIES = θ["code.backends.llm.cli.retry.auth_max_retries"];                               // src: vvaharness/backends/llm/cli/retry.py:91
    List<Integer> AUTH_BACKOFF = θ["code.backends.llm.cli.retry.auth_backoff_s"];                           // src: vvaharness/backends/llm/cli/retry.py:92
    Regex PROXY_FAILURE = LlmModels.PROXY_CAUSE_RX;                                                         // cannot heal: raised immediately // src: vvaharness/backends/llm/cli/retry.py:95

    @src("vvaharness/backends/llm/cli/retry.py:75")
    boolean isPendingResult(String text) {
        if (text == null) return false;                                                                     // src: vvaharness/backends/llm/cli/retry.py:76
        return PENDING_RESULT_RX.search(text) != null;                                                      // src: vvaharness/backends/llm/cli/retry.py:78
    }

    @src("vvaharness/backends/llm/cli/retry.py:98")
    Triple envelopeFields(Map env) {
        Object status = env.get("api_error_status");                                                        // src: vvaharness/backends/llm/cli/retry.py:100
        Object text = firstNonEmpty(env.get("result"), env.get("error"), env.get("message"));               // src: vvaharness/backends/llm/cli/retry.py:101
        return Triple.of(status instanceof Integer ? status : null, text instanceof String ? text : null, true);
    }

    /** The last stream-json line that is a terminal result event. */
    @src("vvaharness/backends/llm/cli/retry.py:107")
    Map lastResultLine(String stdout) {
        for (String line : stdout.splitLines().reversed()) {                                                // src: vvaharness/backends/llm/cli/retry.py:113
            line = line.strip();
            if (line.isEmpty()) continue;
            Object evt;
            try { evt = Json.loads(line); } catch (JsonError e) { continue; }                               // src: vvaharness/backends/llm/cli/retry.py:118
            if (evt instanceof Map && evt.type == "result") return evt;                                     // src: vvaharness/backends/llm/cli/retry.py:121
        }
        return null;
    }

    /** (api_error_status, result_text, envelope_found) from the CLI's terminal result event. */
    @src("vvaharness/backends/llm/cli/retry.py:126")
    Triple terminalResultFields(String stdout) {
        if (stdout == null || stdout.isEmpty()) return Triple.of(null, null, false);                        // src: vvaharness/backends/llm/cli/retry.py:129
        String s = stdout.strip();
        int start = firstOf(s.indexOf("<curly>"), s.indexOf("["));                                          // src: vvaharness/backends/llm/cli/retry.py:132
        if (start < 0) return Triple.of(null, null, false);                                                 // src: vvaharness/backends/llm/cli/retry.py:134
        Object env;
        try {
            env = Json.loads(s.substring(start));                                                           // src: vvaharness/backends/llm/cli/retry.py:136
        } catch (JsonError e) {
            Map line = lastResultLine(s);                                                                   // NDJSON stream // src: vvaharness/backends/llm/cli/retry.py:138
            return line != null ? envelopeFields(line) : Triple.of(null, null, false);                      // src: vvaharness/backends/llm/cli/retry.py:139
        }
        if (env instanceof List) {                                                                          // src: vvaharness/backends/llm/cli/retry.py:140
            env = env.reversed().firstWhere(e -> e.type == "result");
            if (env == null) return Triple.of(null, null, false);                                           // truncated stream // src: vvaharness/backends/llm/cli/retry.py:144
        }
        if (!(env instanceof Map)) return Triple.of(null, null, false);                                     // src: vvaharness/backends/llm/cli/retry.py:145
        return envelopeFields(env);                                                                         // src: vvaharness/backends/llm/cli/retry.py:147
    }

    /** The output-token cap a failed run reports hitting (matched in text, not status), or null. */
    @src("vvaharness/backends/llm/cli/retry.py:150")
    Integer truncationCap(Result result) {
        Triple f = terminalResultFields(result.stdout);                                                     // src: vvaharness/backends/llm/cli/retry.py:153
        String blob = (f.third && f.second != null) ? f.second : result.stdout + "\n" + result.stderr;      // src: vvaharness/backends/llm/cli/retry.py:154
        Match m = LlmModels.CLI_TOKEN_CAP_RX.search(blob);                                                  // src: vvaharness/backends/llm/cli/retry.py:155
        if (m == null) return null;                                                                         // src: vvaharness/backends/llm/cli/retry.py:157
        return Integer.parse(m.group(1));                                                                   // src: vvaharness/backends/llm/cli/retry.py:159
    }

    /** Build the typed VVAH-E005 failure (three messages, as on sdk). */
    @src("vvaharness/backends/llm/cli/retry.py:164")
    TruncatedResponseError truncationError(int requested, int retried, String tag, Integer retryAt) {
        Counters.bump(LlmModels.TRUNCATED_REPLIES_COUNTER);                                                 // src: vvaharness/backends/llm/cli/retry.py:168
        String msg;
        if (retried != 0) msg = "reply still hit the output-token budget after the doubled retry";          // src: vvaharness/backends/llm/cli/retry.py:171
        else if (retryAt == null) msg = "max_tokens is already at the model output cap; no useful retry";   // cap = code.deepagents.model_max_output_tokens // src: vvaharness/backends/llm/cli/retry.py:173
        else msg = "reply hit the output-token budget with no retry budget left";                           // src: vvaharness/backends/llm/cli/retry.py:177
        return new TruncatedResponseError(msg, tag, requested, retried);                                    // src: vvaharness/backends/llm/cli/retry.py:178
    }

    @src("vvaharness/backends/llm/cli/retry.py:182")
    void logTruncationRetry(String tag, int requested, int retryAt, String label) {
        Counters.bump(LlmModels.TRUNCATED_RETRY_ATTEMPTED_COUNTER);                                         // src: vvaharness/backends/llm/cli/retry.py:185
        Log.warning(Event.TRUNCATED_RETRY, label, requested, retryAt);
        Errlog.log(tag, "VVAH-E005 warning: reply truncated; retrying once", true);                         // recovered // src: vvaharness/backends/llm/cli/retry.py:187
    }

    @src("vvaharness/backends/llm/cli/retry.py:194")
    String acceptReply(String text, int truncRetried) {
        if (truncRetried != 0) Counters.bump(LlmModels.TRUNCATED_RETRY_RECOVERED_COUNTER);                  // src: vvaharness/backends/llm/cli/retry.py:197
        return text;
    }

    /** Non-zero exit: true only for a genuine transient worth retrying. */
    @src("vvaharness/backends/llm/cli/retry.py:201")
    boolean isTransientFailure(Result result) {
        Triple f = terminalResultFields(result.stdout);                                                     // src: vvaharness/backends/llm/cli/retry.py:203
        if (f.third) {
            if (LlmModels.CLI_RETRYABLE_STATUS.contains(f.first)) return true;                              // src: vvaharness/backends/llm/cli/retry.py:205
            // null-status transient phrase (e.g. Overloaded) still retries
            if (f.first == null && f.second != null && (LlmModels.RATE_LIMIT_TRANSIENT_RX.search(f.second) || LlmModels.CLI_STATUS_429_RX.search(f.second) || LlmModels.CLI_CONN_TRANSIENT_RX.search(f.second))) return true; // src: vvaharness/backends/llm/cli/retry.py:208
            return false;
        }
        // no terminal event: stdout is model content, scan stderr only
        return LlmModels.RATE_LIMIT_TRANSIENT_RX.search(result.stderr) || LlmModels.CLI_STATUS_429_RX.search(result.stderr) || LlmModels.CLI_CONN_TRANSIENT_RX.search(result.stderr); // src: vvaharness/backends/llm/cli/retry.py:216
    }

    /** VVAH-E001 classification. */
    @src("vvaharness/backends/llm/cli/retry.py:221")
    boolean isAuthFailure(Result result) {
        Triple f = terminalResultFields(result.stdout);                                                     // src: vvaharness/backends/llm/cli/retry.py:223
        if (f.third) {
            if (f.first == 401) return true;                                                                // src: vvaharness/backends/llm/cli/retry.py:225
            return f.second != null && AUTH_FAILURE.search(f.second) != null;                               // src: vvaharness/backends/llm/cli/retry.py:227
        }
        return AUTH_FAILURE.search(result.stderr) != null;                                                  // never blind-scan model stdout // src: vvaharness/backends/llm/cli/retry.py:232
    }

    /** What made this look like a proxy/TLS error (VVAH-E002): evidence, not a verdict. */
    @src("vvaharness/backends/llm/cli/retry.py:235")
    String proxyFailureEvidence(Result result) {
        Triple f = terminalResultFields(result.stdout);                                                     // src: vvaharness/backends/llm/cli/retry.py:238
        String haystack;
        if (f.third) {
            if (f.first == 407) return "terminal result reported status 407";                               // src: vvaharness/backends/llm/cli/retry.py:240
            haystack = f.second != null ? f.second : "";
        } else {
            haystack = result.stdout + "\n" + result.stderr;                                                // fires at connection, before any model turn // src: vvaharness/backends/llm/cli/retry.py:248
        }
        Match m = PROXY_FAILURE.search(haystack);                                                           // src: vvaharness/backends/llm/cli/retry.py:249
        if (m == null) return null;
        return "matched " + m.group(0) + " in: ..." + haystack.window(m, 120) + "...";                      // src: vvaharness/backends/llm/cli/retry.py:252
    }

    @src("vvaharness/backends/llm/cli/retry.py:256")
    boolean isProxyFailure(Result result) {
        return proxyFailureEvidence(result) != null;                                                        // src: vvaharness/backends/llm/cli/retry.py:258
    }

    /** A retried attempt gets a fresh --session-id: the CLI rejects a reused one. */
    @src("vvaharness/backends/llm/cli/retry.py:261")
    void rotateSessionId(List<String> cmd) {
        if (cmd.contains("--session-id")) cmd.set(cmd.indexOf("--session-id") + 1, Uuid.uuid4());          // src: vvaharness/backends/llm/cli/retry.py:264
    }

    /** Process.run plus backoff on GENUINE transient failures only; refusal > proxy > auth > hard cap > transient. */
    @src("vvaharness/backends/llm/cli/retry.py:267")
    Result runWithRetry(List<String> cmd, String label, String input, Path cwd, double timeout, Integer timeoutRetries, Map env) {
        if (timeoutRetries == null) timeoutRetries = TIMEOUT_MAX_RETRIES;                                   // src: vvaharness/backends/llm/cli/retry.py:268
        int attempt = 0;
        int authAttempt = 0;
        int timeoutAttempt = 0;
        while (true) {                                                                                      // src: vvaharness/backends/llm/cli/retry.py:275
            Result result;
            try {
                result = Process.run(cmd, input, cwd, timeout, env, label, 300, null, null);                // src: vvaharness/backends/llm/cli/retry.py:277
            } catch (TimeoutExpired e) {
                if (Cancel.aborted() || timeoutAttempt >= timeoutRetries) throw e;                          // src: vvaharness/backends/llm/cli/retry.py:280
                timeoutAttempt++;
                continue;                                                                                   // src: vvaharness/backends/llm/cli/retry.py:285
            }
            if (result.returncode == 0) return result;                                                      // src: vvaharness/backends/llm/cli/retry.py:286
            Triple f = terminalResultFields(result.stdout);
            String errText = f.second != null ? f.second : result.stdout + "\n" + result.stderr;            // src: vvaharness/backends/llm/cli/retry.py:289
            // refusal classified BEFORE auth/proxy: its stray "token" substrings must never reach the auth regex
            Envelope.raiseIfRefusedExit(result.stdout, label);                                              // src: vvaharness/backends/llm/cli/retry.py:293
            String proxyEvidence = proxyFailureEvidence(result);                                            // src: vvaharness/backends/llm/cli/retry.py:294
            if (proxyEvidence != null) throw new ProxyError(Redact.redact(errText).substring(0, 400), "cli"); // VVAH-E002 // src: vvaharness/backends/llm/cli/retry.py:296
            if (isAuthFailure(result)) {                                                                    // src: vvaharness/backends/llm/cli/retry.py:303
                if (authAttempt < AUTH_MAX_RETRIES) {                                                       // src: vvaharness/backends/llm/cli/retry.py:304
                    Thread.sleep(AUTH_BACKOFF.get(min(authAttempt, AUTH_BACKOFF.size() - 1)));              // src: vvaharness/backends/llm/cli/retry.py:305
                    authAttempt++;
                    rotateSessionId(cmd);                                                                   // src: vvaharness/backends/llm/cli/retry.py:311
                    continue;
                }
                throw new AuthenticationError(Redact.redact(errText).substring(0, 400), 401, "cli");        // VVAH-E001 // src: vvaharness/backends/llm/cli/retry.py:313
            }
            if (RL_HARD_CAP.search(errText) != null) return result;                                         // hard usage cap: not retrying // src: vvaharness/backends/llm/cli/retry.py:315
            if (attempt >= RL_MAX_RETRIES || !isTransientFailure(result)) return result;                    // src: vvaharness/backends/llm/cli/retry.py:318
            int wait = RL_BACKOFF.get(min(attempt, RL_BACKOFF.size() - 1));                                 // src: vvaharness/backends/llm/cli/retry.py:320
            for (int slept = 0; slept < wait; slept += 5) {                                                 // abort-aware sleep in 5 s slices // src: vvaharness/backends/llm/cli/retry.py:324
                if (Cancel.aborted()) throw new RuntimeError("aborted by user (Ctrl-C)");                   // src: vvaharness/backends/llm/cli/retry.py:326
                Thread.sleep(min(5, wait - slept));
            }
            rotateSessionId(cmd);                                                                           // src: vvaharness/backends/llm/cli/retry.py:329
            attempt++;
        }
    }

    /** One-line [cli] usage summary (tokens incl. cache, stop_reason, resolved model and cost). */
    @src("vvaharness/backends/llm/cli/retry.py:333")
    void logUsage(Map usage, String stopReason, Map modelUsage) {
        if (usage == null || usage.isEmpty()) return;                                                       // src: vvaharness/backends/llm/cli/retry.py:337
        int cacheR = usage.getInt("cache_read_input_tokens");
        int cacheW = usage.getInt("cache_creation_input_tokens");
        int in = usage.getInt("input_tokens") + cacheR + cacheW;                                            // src: vvaharness/backends/llm/cli/retry.py:341
        int out = usage.getInt("output_tokens");
        Console.write("[cli] usage: in=" + in + " out=" + out + " stop_reason=" + stopReason + " model=" + modelUsage.keys()); // src: vvaharness/backends/llm/cli/retry.py:353
    }
}
