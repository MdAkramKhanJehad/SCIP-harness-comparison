// file: vvaharness/validation/execution/pipeline.py
// Execute one validation plan, collecting host-enriched verdicts. Expected session failures return an unscored result.

@executedBy(CODE) @role(types)
record ValidationPlanOutcome(List findings, boolean sessionFailed = false) { }

@executedBy(CODE) @role(step) @stage("S11")
class ValidationExecutionPipeline {
    @src("vvaharness/validation/execution/pipeline.py:43")
    ValidationPlanOutcome unverifiable(FixValidationPlan plan, String reason, Provenance provenance) {
        Verdict verdict = new Verdict(INCONCLUSIVE, reason, null, List.of("Manual review required: " + reason), provenance);
        return new ValidationPlanOutcome(List.of(new CollectedFinding(verdict, unverifiableRow(plan.caseId, plan.caseId, reason))), true);
    }
    @src("vvaharness/validation/execution/pipeline.py:67")
    ValidationPlanOutcome executePlan(FixValidationPlan plan, Config config, boolean postResults, RunMetadata meta, Theta θ) {
        Provenance stamp = plan.provenance; Path workspace = plan.workspaceDir;
        workspace.mkdir(parents=true, existOk=true);
        Object manifest = plan.manifest.copyWith("post_results", postResults); manifest.write(workspace.resolve("manifest.json"));
        try { await ValidationSessionLauncher.launchSession(config, manifest, workspace, plan.outputDir, θ); }
        catch (ValidationSessionError e) { meta.errors.add("Validation session failed: " + plan.caseId); return unverifiable(plan, e.reasonString(), stamp); }
        List collected = collectAndEnrich(workspace, stamp, plan.policy);
        if (collected.isEmpty()) return unverifiable(plan, "Validation session produced no results", stamp);
        return new ValidationPlanOutcome(collected);
    }
}
