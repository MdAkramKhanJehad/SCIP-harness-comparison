// file: vvaharness/models/scan/_render.py
// Markdown-safety helpers shared by the report renderers: neutralise headings, fences, line breaks,
// invisible/bidi characters and HTML angles in untrusted (repo- or model-authored) text.

@executedBy(CODE) @role(io)
class ScanRender {

    // _ATX_HEADING_RX = ^(\s{0,3})#{1,6}[ \t]+(.*)$ ; _FENCE_RX = ^\s{0,3}(```|~~~) ; _SETEXT_H1_RX = ^\s{0,3}=+\s*$  // src: vvaharness/models/scan/_render.py:23
    // _MD_LINEBREAK_RX: every separator splitlines() honours (\r \n \v \f \x1c-\x1e \x85 U+2028 U+2029)         // src: vvaharness/models/scan/_render.py:28

    String demoteMdHeadings(String text, boolean escapeAngles) {
        if (text == null || text.isEmpty()) return text;                                            // src: vvaharness/models/scan/_render.py:49
        List<String> lines = text.splitlines();
        boolean[] fenced = new boolean[lines.size()];
        Integer openIdx = null; String marker = "";
        for (int i = 0; i < lines.size(); i++) {                                                    // src: vvaharness/models/scan/_render.py:56
            Match m = FENCE_RX.match(lines.get(i));
            if (m == null) continue;
            if (openIdx == null) { openIdx = i; marker = m.group(1); }                              // src: vvaharness/models/scan/_render.py:61
            else if (m.group(1).equals(marker)) { markFenced(fenced, openIdx, i); openIdx = null; } // src: vvaharness/models/scan/_render.py:62
        }
        String dangling = openIdx != null ? lines.get(openIdx) : "";                                // src: vvaharness/models/scan/_render.py:66
        List<String> out = new List();
        for (int i = 0; i < lines.size(); i++) {
            String ln = lines.get(i);
            if (fenced[i]) { out.add(ln); continue; }                                               // src: vvaharness/models/scan/_render.py:69
            if (escapeAngles) {
                // escape < > outside inline code spans only, so a quoted code value stays byte-identical
                ln = escapeOutsideCodeSpans(ln);                                                    // src: vvaharness/models/scan/_render.py:74
            }
            ln = ATX_HEADING_RX.sub(ln, "<indent>**<heading text>**");  // forged heading -> bold    // src: vvaharness/models/scan/_render.py:77
            if (SETEXT_H1_RX.match(ln) && !out.isEmpty() && !out.last().strip().isEmpty()) out.add(""); // src: vvaharness/models/scan/_render.py:80
            out.add(ln);
        }
        if (!dangling.isEmpty()) {
            // close an unterminated fence with the opener's own marker run
            Match m = Regex.match("\\s{0,3}(`{3,}|~{3,})", dangling);                               // src: vvaharness/models/scan/_render.py:85
            out.add(m != null ? m.group(1) : "```");                                               // src: vvaharness/models/scan/_render.py:86
        }
        return String.join("\n", out);
    }

    String escapeAngles(String text) {
        return str(text or "").replace("<", "&lt;").replace(">", "&gt;");                          // src: vvaharness/models/scan/_render.py:96
    }

    String snippetFence(String code) {
        // a fence longer than any backtick run in code, minimum 3
        List runs = TICK_RUN_RX.findall(str(code or ""));                                           // src: vvaharness/models/scan/_render.py:101
        return "`".repeat(max(3, runs.maxLen(0) + 1));                                              // src: vvaharness/models/scan/_render.py:102
    }

    String codeSpan(String text) {
        String s = stripInvisible(MD_LINEBREAK_RX.sub(" ", str(text or ""))).strip();              // src: vvaharness/models/scan/_render.py:108
        List runs = TICK_RUN_RX.findall(s);
        if (runs.isEmpty()) return "`" + s + "`";                                                   // src: vvaharness/models/scan/_render.py:111
        String d = "`".repeat(runs.maxLen(0) + 1);                                                  // src: vvaharness/models/scan/_render.py:112
        return d + " " + s + " " + d;
    }

    String vectorSpan(String vec) {
        // a well-formed CVSS:3.x vector renders bare; anything else goes through codeSpan
        String v = str(vec or "");
        return CVSS_VECTOR_RX.fullmatch(v) ? "`" + v + "`" : codeSpan(v);                           // src: vvaharness/models/scan/_render.py:124
    }

    String oneLine(String text) {
        return NEWLINE_RUN_RX.sub(" ", str(text or "")).strip();                                    // src: vvaharness/models/scan/_render.py:130
    }

    String confidenceLabel(Integer confidence) {
        return confidence != null ? confidence + "/10" : "not scored";                              // src: vvaharness/models/scan/_render.py:135
    }

    String stripInvisible(String s) {
        // zero-width / bidi (Trojan-Source) / C0 control characters removed
        return θ["code.models.scan._render.invisible_char_pattern"].sub("", s);                     // src: vvaharness/models/scan/_render.py:34
    }

    String mdCell(String text) {
        if (text == null) return "";                                                                // src: vvaharness/models/scan/_render.py:141
        String s = MD_LINEBREAK_RX.sub(" ", text);                                                  // src: vvaharness/models/scan/_render.py:143
        s = stripInvisible(s);                                                                      // src: vvaharness/models/scan/_render.py:144
        s = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");  // & before angles  // src: vvaharness/models/scan/_render.py:146
        return s.replace("\\", "\\\\").replace("|", "\\|").strip();  // backslashes before pipes    // src: vvaharness/models/scan/_render.py:148
    }

    List<String> renderReproBlock(Map detail) {
        try {
            return ExploitVerificationRepro.renderBlock(ReproDetail.validate(detail));              // src: vvaharness/models/scan/_render.py:157
        } catch (Exception e) {
            return List.of();  // no block on failure                                               // src: vvaharness/models/scan/_render.py:159
        }
    }
}
