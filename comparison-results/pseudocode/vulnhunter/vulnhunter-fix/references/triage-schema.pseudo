// file: vulnhunter-fix/references/triage-schema.json
// Per-finding graph sidecar .work/<repo>/graph_context/<vuln>.json written by the executor; workers read it instead
// of the graph. Closed object; crypto_trust_chain present only for crypto-routed findings.

@executedBy(CODE) @role(types)
record TriageCryptoTrustChain(boolean algorithm_approved, boolean key_source_approved, boolean key_rotation_present,
                              boolean transport_encrypted, String checker_version, String algorithm_evidence,
                              String key_source_evidence, String key_rotation_evidence, String transport_evidence) { }

@executedBy(CODE) @role(types)
record TriageSidecar(String vuln_id, String confidence, String sink_symbol, List<String> callers_of_sink, List<String> blast_radius,
                     Boolean reachable_from_entry, String graph_backend, String generated_at, String graphifyy_version,
                     TriageCryptoTrustChain crypto_trust_chain) { }

@executedBy(CODE) @role(rule_set) @stage("fix")
class TriageSchema {

    boolean validate(TriageSidecar s, Theta θ) {
        // required: vuln_id, confidence, sink_symbol (nullable for config findings), callers_of_sink, generated_at
        if (!Regex.match("^VULN-\\d+$", s.vuln_id)) return false;                     // src: vulnhunter-fix/references/triage-schema.json:18
        if (!List.of("high", "low").contains(s.confidence)) return false;            // src: vulnhunter-fix/references/triage-schema.json:22 (selects strict vs token validator matching)
        for (String c : s.callers_of_sink) if (!Regex.match("^[^:]+:.+$", c)) return false; // src: vulnhunter-fix/references/triage-schema.json:33
        if (s.graph_backend != null && !θ["p.remediation-rigor.graph_backend_values"].contains(s.graph_backend)) return false; // src: vulnhunter-fix/references/triage-schema.json:49
        // confidence binds backend: high <-> ast, low <-> grep (backend then required)
        if (s.confidence == "high" && s.graph_backend != "ast") return false;        // src: vulnhunter-fix/references/triage-schema.json:92
        if (s.confidence == "low" && s.graph_backend != "grep") return false;        // src: vulnhunter-fix/references/triage-schema.json:104
        if (s.crypto_trust_chain != null && (s.crypto_trust_chain.checker_version == null || s.crypto_trust_chain.checker_version.isEmpty())) return false; // src: vulnhunter-fix/references/triage-schema.json:76
        return true;
    }

    boolean cryptoFullAllowed(TriageSidecar s, Theta θ) {
        // mechanical checker outputs, never LLM-authored; all four true is required for FULL
        TriageCryptoTrustChain c = s.crypto_trust_chain;
        if (!θ["p.worker_agent_crypto.full_iff_four_booleans"]) return true;         // src: vulnhunter-fix/references/triage-schema.json:62
        return c.algorithm_approved && c.key_source_approved && c.key_rotation_present && c.transport_encrypted; // src: vulnhunter-fix/references/triage-schema.json:62
    }
}
