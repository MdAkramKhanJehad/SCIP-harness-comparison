// file: vvaharness/pipeline/stages/s4_deepdive.py
// S4 (deep-dive): every InvestigationUnit from S3 is investigated in its own agentic session (or a shared
// session for a batch of file-overlapping units). Returns (findings, outcome-per-unit) so a failed/blocked unit
// stays distinguishable from a clean one. The per-session wiring lives in s4/session.pseudo (S4Session).

@executedBy(CODE) @role(stage) @stage("S4")
class S4Deepdive {

    // Entry the L0 orchestrator calls.
    Pair<List<Finding>, Map<String, String>> run(List<InvestigationUnit> units, ContextPackage ctx, Config cfg, Theta θ) {
        units = units.sortedBy(u -> u.riskRank);                                                         // src: vvaharness/pipeline/stages/s4_deepdive.py:49
        int parallel = θ["step4.parallel"];                                                              // src: vvaharness/pipeline/stages/s4_deepdive.py:50
        S4Session.deepdiveTools(cfg, θ);          // fail closed pre-pool on a bad step4.allowed_tools     // src: vvaharness/pipeline/stages/s4_deepdive.py:53
        int guardrailHits = 0;
        int guardrailGate = max(3, parallel);                                                            // src: vvaharness/pipeline/stages/s4_deepdive.py:63
        int successes = 0;
        // unit id -> completed | error | guardrail | skipped | uninvestigated | failed | halted
        Map<String, String> outcomes = new Map();                                                        // src: vvaharness/pipeline/stages/s4_deepdive.py:65
        List<InvestigationUnit> nonEmpty = new List();
        for (InvestigationUnit unit : units) {
            if (!unit.files.isEmpty()) {                                                                 // src: vvaharness/pipeline/stages/s4_deepdive.py:70
                nonEmpty.add(unit);
                continue;
            }
            outcomes.put(unit.id, "skipped");                // second, independent layer after S3       // src: vvaharness/pipeline/stages/s4_deepdive.py:79
        }
        units = nonEmpty;
        if (parallel <= 1) {                                                                             // src: vvaharness/pipeline/stages/s4_deepdive.py:93
            return runSerial(units, ctx, cfg, outcomes, guardrailGate, θ);
        }
        return runParallel(units, ctx, cfg, outcomes, parallel, guardrailGate, θ);
    }

    Pair<List<Finding>, Map<String, String>> runSerial(List<InvestigationUnit> units, ContextPackage ctx, Config cfg, Map<String, String> outcomes, int guardrailGate, Theta θ) {
        List<Finding> all = new List();
        int guardrailHits = 0;
        int successes = 0;
        for (int i = 0; i < units.size(); i++) {
            InvestigationUnit unit = units.get(i);
            List<Finding> findings;
            try {
                findings = S4Session.investigateUnit(unit, ctx, ctx.repoRoot, cfg, θ);                    // src: vvaharness/pipeline/stages/s4_deepdive.py:101
            } catch (GuardrailBlocked e) {
                guardrailHits += 1;
                outcomes.put(unit.id, "guardrail");                                                      // src: vvaharness/pipeline/stages/s4_deepdive.py:107
                if (guardrailHits >= guardrailGate && successes == 0) guardrailFailFast(e);              // src: vvaharness/pipeline/stages/s4_deepdive.py:110
                continue;
            } catch (Exception e) {
                if (Cli.aborted()) throw e;                                                              // src: vvaharness/pipeline/stages/s4_deepdive.py:114
                if (isHaltError(e)) {                                                                    // src: vvaharness/pipeline/stages/s4_deepdive.py:116
                    // every remaining unit would fail identically -- stop dispatching
                    for (InvestigationUnit skipped : units.subList(i)) outcomes.put(skipped.id, "halted"); // src: vvaharness/pipeline/stages/s4_deepdive.py:125
                    break;
                }
                outcomes.put(unit.id, "error");      // every retry failed; report discloses the gap      // src: vvaharness/pipeline/stages/s4_deepdive.py:133
                continue;
            }
            successes += 1;
            outcomes.put(unit.id, "completed");                                                          // src: vvaharness/pipeline/stages/s4_deepdive.py:138
            all.addAll(findings);
        }
        return Pair.of(all, outcomes);                                                                   // src: vvaharness/pipeline/stages/s4_deepdive.py:152
    }

    Pair<List<Finding>, Map<String, String>> runParallel(List<InvestigationUnit> units, ContextPackage ctx, Config cfg, Map<String, String> outcomes, int parallel, int guardrailGate, Theta θ) {
        Map<String, List<Finding>> results = new Map();
        List<List<InvestigationUnit>> batches = S4Batching.planBatches(units, batchSize(θ), θ);          // src: vvaharness/pipeline/stages/s4_deepdive.py:156
        boolean splitRetry = θ["step4.split_retry"];                                                     // src: vvaharness/pipeline/stages/s4_deepdive.py:157
        Executor ex = new ThreadPool(parallel);                                                          // src: vvaharness/pipeline/stages/s4_deepdive.py:160
        Map<Future, List<InvestigationUnit>> futs = new Map();
        Map<Future, List<InvestigationUnit>> retryFuts = new Map();
        for (List<InvestigationUnit> batch : batches) {
            futs.put(submitBatch(ex, batch, ctx, cfg, θ), batch);                                        // src: vvaharness/pipeline/stages/s4_deepdive.py:190
        }
        int guardrailHits = 0;
        int successes = 0;
        boolean halted = false;
        for (Future fut : asCompleted(futs)) {                                                           // src: vvaharness/pipeline/stages/s4_deepdive.py:193
            List<InvestigationUnit> batch = futs.get(fut);
            BatchResult r;
            try {
                r = fut.result();      // (findingsByUnit, mergedByUnit, verdictByUnit)                    // src: vvaharness/pipeline/stages/s4_deepdive.py:196
            } catch (GuardrailBlocked e) {
                guardrailHits += 1;
                for (InvestigationUnit unit : batch) {
                    results.put(unit.id, List.of());
                    outcomes.put(unit.id, "guardrail");                                                  // src: vvaharness/pipeline/stages/s4_deepdive.py:204
                }
                if (guardrailHits >= guardrailGate && successes == 0) {                                  // src: vvaharness/pipeline/stages/s4_deepdive.py:207
                    Cli.abort();
                    guardrailFailFast(e);
                }
                continue;
            } catch (Exception e) {
                if (isHaltError(e)) {                                                                    // src: vvaharness/pipeline/stages/s4_deepdive.py:213
                    markHalted(batch, pendingBatches(futs), outcomes, results);                          // src: vvaharness/pipeline/stages/s4_deepdive.py:217
                    Cli.abort();
                    halted = true;
                    break;
                }
                boolean retryable = splitRetry && batch.size() > 1 && !isDeterministicFailure(e) && !Cli.aborted(); // src: vvaharness/pipeline/stages/s4_deepdive.py:228
                for (InvestigationUnit unit : batch) {
                    outcomes.put(unit.id, "error");                                                      // src: vvaharness/pipeline/stages/s4_deepdive.py:231
                    if (retryable) {
                        resubmit(ex, unit, ctx, cfg, futs, retryFuts, θ);   // retry the lost unit alone   // src: vvaharness/pipeline/stages/s4_deepdive.py:237
                        continue;
                    }
                    results.put(unit.id, List.of());                                                     // src: vvaharness/pipeline/stages/s4_deepdive.py:242
                }
                continue;
            }
            successes += 1;
            for (InvestigationUnit unit : batch) {
                List<Finding> findings = r.findingsByUnit.getOrDefault(unit.id, List.of());
                String verdict = r.verdictByUnit.get(unit.id);
                if (verdict == "uninvestigated" || verdict == "failed") {                                // src: vvaharness/pipeline/stages/s4_deepdive.py:250
                    // omitted from the shared batch reply / its entry did not parse
                    outcomes.put(unit.id, verdict);
                    boolean retryable = splitRetry && batch.size() > 1 && !Cli.aborted();                // src: vvaharness/pipeline/stages/s4_deepdive.py:252
                    if (retryable) {
                        resubmit(ex, unit, ctx, cfg, futs, retryFuts, θ);                                // src: vvaharness/pipeline/stages/s4_deepdive.py:262
                        continue;
                    }
                    results.put(unit.id, List.of());                                                     // src: vvaharness/pipeline/stages/s4_deepdive.py:269
                    continue;
                }
                // confirmed / refuted / inconclusive all land as "completed"; findings are kept as reduced
                results.put(unit.id, findings);                                                          // src: vvaharness/pipeline/stages/s4_deepdive.py:273
                outcomes.put(unit.id, "completed");                                                      // src: vvaharness/pipeline/stages/s4_deepdive.py:274
            }
        }
        // one retry level: a failed singleton has nothing left to split
        if (!halted) {
            for (Future fut : asCompleted(retryFuts)) {                                                  // src: vvaharness/pipeline/stages/s4_deepdive.py:282
                List<InvestigationUnit> batch = retryFuts.get(fut);
                BatchResult r;
                try {
                    r = fut.result();
                } catch (GuardrailBlocked e) {
                    guardrailHits += 1;
                    for (InvestigationUnit unit : batch) outcomes.put(unit.id, "guardrail");             // src: vvaharness/pipeline/stages/s4_deepdive.py:293
                    if (guardrailHits >= guardrailGate && successes == 0) guardrailFailFast(e);          // src: vvaharness/pipeline/stages/s4_deepdive.py:296
                    continue;
                } catch (Exception e) {
                    if (isHaltError(e)) {                                                                // src: vvaharness/pipeline/stages/s4_deepdive.py:302
                        markHalted(batch, pendingBatches(futs, retryFuts), outcomes, results);
                        Cli.abort();
                        break;
                    }
                    for (InvestigationUnit unit : batch) {
                        results.put(unit.id, List.of());
                        outcomes.put(unit.id, "error");                                                  // src: vvaharness/pipeline/stages/s4_deepdive.py:322
                    }
                    continue;
                }
                successes += 1;
                for (InvestigationUnit unit : batch) {
                    results.put(unit.id, r.findingsByUnit.getOrDefault(unit.id, List.of()));
                    outcomes.put(unit.id, "completed");                                                  // src: vvaharness/pipeline/stages/s4_deepdive.py:330
                }
            }
        }
        ex.shutdown(true);                                                                               // src: vvaharness/pipeline/stages/s4_deepdive.py:344
        List<Finding> all = new List();
        for (InvestigationUnit unit : units) all.addAll(results.getOrDefault(unit.id, List.of()));       // src: vvaharness/pipeline/stages/s4_deepdive.py:349
        return Pair.of(all, outcomes);                                                                   // src: vvaharness/pipeline/stages/s4_deepdive.py:362
    }

    void resubmit(Executor ex, InvestigationUnit unit, ContextPackage ctx, Config cfg, Map<Future, List<InvestigationUnit>> futs, Map<Future, List<InvestigationUnit>> retryFuts, Theta θ) {
        Future fut = submitBatch(ex, List.of(unit), ctx, cfg, θ);                                        // src: vvaharness/pipeline/stages/s4_deepdive.py:165
        futs.put(fut, List.of(unit));
        retryFuts.put(fut, List.of(unit));
    }

    int markHalted(List<InvestigationUnit> batch, List<List<InvestigationUnit>> pending, Map<String, String> outcomes, Map<String, List<Finding>> results) {
        int n = 0;
        for (InvestigationUnit unit : concat(batch, pending)) {
            if (outcomes.containsKey(unit.id)) continue;                                                 // src: vvaharness/pipeline/stages/s4_deepdive.py:176
            outcomes.put(unit.id, "halted");                                                             // src: vvaharness/pipeline/stages/s4_deepdive.py:178
            results.put(unit.id, List.of());
            n += 1;
        }
        return n;
    }

    void guardrailFailFast(GuardrailBlocked e) {
        // only content-guardrail blocks count, never ModelRefusal (refusals return fast)
        throw new RuntimeError("content-guardrail blocks with zero successful units -- aborting run; switch models.deepdive.via"); // src: vvaharness/pipeline/stages/s4_deepdive.py:87
    }

    int batchSize(Theta θ) {
        return θ["step4.batch_size"];         // capped int; read here and passed to S4Batching           // src: vvaharness/pipeline/stages/s4_deepdive.py:367
    }

    Future submitBatch(Executor ex, List<InvestigationUnit> batch, ContextPackage ctx, Config cfg, Theta θ) {
        if (batch.size() == 1) {                                                                         // src: vvaharness/pipeline/stages/s4_deepdive.py:376
            InvestigationUnit unit = batch.get(0);
            return ex.submit(() -> BatchResult.single(unit.id, S4Session.investigateUnit(unit, ctx, ctx.repoRoot, cfg, θ))); // src: vvaharness/pipeline/stages/s4_deepdive.py:380
        }
        // investigate_batch caps and dedups per member like the single-unit path
        return ex.submit(() -> S4Session.investigateBatch(batch, ctx, ctx.repoRoot, cfg, θ));            // src: vvaharness/pipeline/stages/s4_deepdive.py:388
    }

    // The never-empty, cache-marked context prefix, byte-identical for every unit of the scan.
    String buildSharedContextBlock(ContextPackage ctx) {
        List<String> parts = new List();
        if (ctx.appProfile != null) parts.add(ctx.appProfile.toPromptBlock());                          // src: vvaharness/pipeline/stages/s4_deepdive.py:406
        if (ctx.threatModel != null) {
            // caps: 4000 system chars, 10 assets, 15 boundaries, 25 threats (no knob)
            parts.add(ctx.threatModel.toCompactPromptBlock(4000, 10, 15, 25));                           // src: vvaharness/pipeline/stages/s4_deepdive.py:409
        }
        if (!ctx.entryPoints.isEmpty()) {
            // sorted for a byte-identical prefix; at most 60 entry points (no knob), tagged [unauth]/[auth]
            parts.add(entryPointInventory(ctx.entryPoints.sortedBy(e -> e.file + e.function).take(60))); // src: vvaharness/pipeline/stages/s4_deepdive.py:418
        }
        parts.add(SharedContextPrompt.trustRule());                                                      // src: vvaharness/pipeline/stages/s4_deepdive.py:432
        return String.join("\n\n", parts);
    }

    // PAN masking: Luhn-or-card-keyword gated; keeps first 4 digits, X for the rest.
    String maskPan(String match, String window) {
        String digits = match.digitsOnly();
        if (digits.length() < 13) return match;                                                          // src: vvaharness/pipeline/stages/s4_deepdive.py:457
        if (!(luhn(digits) || CARD_CTX.search(window))) return match;                                    // src: vvaharness/pipeline/stages/s4_deepdive.py:461
        return keepFirstFourDigits(match);                                                               // src: vvaharness/pipeline/stages/s4_deepdive.py:463
    }

    String redactSource(String text, String rel, String stage) {
        text = sanitizePackedText(text, rel);                                                            // src: vvaharness/pipeline/stages/s4_deepdive.py:481
        String masked = PAN_RX.sub(m -> maskPan(m, windowBefore(m, 48)), text);                          // src: vvaharness/pipeline/stages/s4_deepdive.py:491
        masked = Redact.redactCounts(masked);                                                            // src: vvaharness/pipeline/stages/s4_deepdive.py:493
        return masked;
    }

    // Whole-file, line-numbered, redacted dump for inline-source prompts (gated by step4.inline_source in S4Session).
    String loadFilesFull(List<String> files, Path repoRoot, String stage) {
        List<String> parts = new List();
        for (String rel : files) {
            Path p = repoRoot.resolve(rel);
            if (!p.isFile()) {
                parts.add("=== " + rel + " ===\n[FILE NOT FOUND]");                                     // src: vvaharness/pipeline/stages/s4_deepdive.py:514
                continue;
            }
            String text = redactSource(p.readText(), rel, stage);                                        // src: vvaharness/pipeline/stages/s4_deepdive.py:521
            // each line clipped to MAX_LINE_CHARS = 8000 (no knob)
            parts.add("=== " + rel + " ===\n" + numberLines(text, 8000));                                // src: vvaharness/pipeline/stages/s4_deepdive.py:522
        }
        return String.join("\n", parts);
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class SharedContextPrompt {
    Prompt trustRule() {
        Prompt p = new Prompt();
        p.rule("TRUST RULE: Operator argv/env on the operator's OWN host is TRUSTED.");                  // src: vvaharness/pipeline/stages/s4_deepdive.py:433
        p.rule("CI job parameters, scheduler args, shared config/CSV/test-data files editable by other principals, and framework-overridable variables ARE attack surface even on an internal app -- report those (typically LOW). See OUT-OF-SCOPE rule A."); // src: vvaharness/pipeline/stages/s4_deepdive.py:434
        return p;
    }
}

// The cfg.step4 block (defaults: vvaharness/config/__init__.py:290) and where each key acts in S4Session /
// S4Outcomes. These reads mirror the reads in the session file, which are the points of effect.
@executedBy(CODE) @role(config) @stage("S4")
class S4StepConfig {

    Object stageLevel(Theta θ) {
        Object parallel = θ["step4.parallel"];                 // ThreadPool width                        // src: vvaharness/pipeline/stages/s4_deepdive.py:50
        Object splitRetry = θ["step4.split_retry"];            // batch -> singleton retry                // src: vvaharness/pipeline/stages/s4_deepdive.py:157
        Object maxFindings = θ["step4.max_findings_per_run"];  // S4Session.capFindings                   // src: vvaharness/pipeline/stages/s4/session.py:342
        Object lineBucket = θ["step4.line_bucket"];            // S4Session.dedupByKey                    // src: vvaharness/pipeline/stages/s4/session.py:371
        Object maxExtraCwes = θ["step4.max_extra_cwes"];       // S4Outcomes.fanOut                       // src: vvaharness/pipeline/stages/s4/outcomes.py:258
        return null;
    }

    Object sessionTools(Theta θ) {
        Object allowed = θ["step4.allowed_tools"];             // native read-only jail                   // src: vvaharness/pipeline/stages/s4/session.py:87
        Object bash = θ["step4.bash"];                         // unjailed shell + shell duty prompt       // src: vvaharness/pipeline/stages/s4/session.py:300
        Object cweTools = θ["step4.cwe_tools"];                // CweGuidance KB tool                     // src: vvaharness/pipeline/stages/s4/session.py:166
        Object cweBudget = θ["step4.cwe_tool_budget"];         // ToolCallBudget on KB tools              // src: vvaharness/pipeline/stages/s4/session.py:169
        Object graphBudget = θ["step4.graph_tool_budget"];     // ToolCallBudget on graph tools           // src: vvaharness/pipeline/stages/s4/session.py:164
        Object skills = θ["step4.skills"];                     // mount skill playbooks                   // src: vvaharness/pipeline/stages/s4/session.py:295
        Object inline = θ["step4.inline_source"];              // inline whole files into first turn      // src: vvaharness/pipeline/stages/s4/session.py:180
        return null;
    }

    Object sessionGates(Theta θ) {
        Object planning = θ["step4.planning"];                 // TodoListMiddleware                      // src: vvaharness/pipeline/stages/s4/session.py:124
        Object gate = θ["step4.evidence_gate"];                // EvidenceGate (needs planning)           // src: vvaharness/pipeline/stages/s4/session.py:134
        Object refusals = θ["step4.evidence_gate_refusals"];   // gate max_rejections                     // src: vvaharness/pipeline/stages/s4/session.py:151
        Object requireGraph = θ["step4.require_graph"];        // required graph tools on the gate        // src: vvaharness/pipeline/stages/s4/session.py:136
        return null;
    }

    Object sessionBounds(Theta θ) {
        Object maxTurns = θ["step4.max_turns"];                // recursion floor: + 900 on deepagents    // src: vvaharness/pipeline/stages/s4/session.py:297
        Object maxCalls = θ["step4.max_model_calls"];          // ModelCallBudget; 0 = unmetered          // src: vvaharness/pipeline/stages/s4/session.py:107
        Object maxTokens = θ["step4.max_tokens"];              // per-call output cap                     // src: vvaharness/pipeline/stages/s4/session.py:293
        Object effort = θ["step4.effort"];                     // reasoning tier                          // src: vvaharness/pipeline/stages/s4/session.py:258
        Object deadline = θ["step4.deadline"];                 // stage wall clock, 0 = none              // src: vvaharness/pipeline/stages/s4/session.py:202
        Object resumeTimeout = θ["step4.resume_timeout"];      // resume after deadline                   // src: vvaharness/pipeline/stages/s4/session.py:222
        Object replayTimeout = θ["step4.replay_timeout"];      // tool-free replay timeout                // src: vvaharness/pipeline/stages/s4/session.py:237
        Object replayMaxTokens = θ["step4.replay_max_tokens"]; // tool-free replay output cap             // src: vvaharness/pipeline/stages/s4/session.py:236
        return null;
    }
}
