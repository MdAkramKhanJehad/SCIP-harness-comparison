// file: vulnhunter-agent/agent/audit_extract.py
// Audit-stream converters: a cheap on-disk VULN count for scan_completed, and a pure converter from the
// issues-stage ExtractedReport to findings-event dicts (the Haiku extractor is never re-run here).

@executedBy(CODE) @role(io) @stage("agent")
class AuditExtract {

    // count_findings_from_disk: distinct VULN-NNN ids under the artifact subdirs (no LLM).
    int countFindingsFromDisk(Path resultsDir, Theta θ) {
        if (!resultsDir.isDir()) return 0;                                                          // src: vulnhunter-agent/agent/audit_extract.py:46
        Set<String> seen = new Set();
        for (String sub : θ["code.agent.audit_extract.finding_count_dirs"]) {                       // poc, exploit_tests // src: vulnhunter-agent/agent/audit_extract.py:49
            Path d = resultsDir.resolve(sub);
            if (!d.isDir()) continue;                                                               // src: vulnhunter-agent/agent/audit_extract.py:51
            for (Path entry : d.iterdir()) {
                Match m = regexSearch("VULN[-_](\\d+)", entry.name, IGNORECASE);                  // same pattern as issues_extract // src: vulnhunter-agent/agent/audit_extract.py:54
                if (m != null) seen.add(format("VULN-%03d", int(m.group(1))));                      // src: vulnhunter-agent/agent/audit_extract.py:56
            }
        }
        return seen.size();                                                                         // same VULN in both dirs counts once // src: vulnhunter-agent/agent/audit_extract.py:57
    }

    List<Map> buildFindingEvents(ExtractedReport extracted, String repoSlug, String appId, String reportId, Path resultsDir, boolean opened, String status, Map githubIssueUrlByVuln, RepoProperties repoProperties) {
        Map urlMap = (githubIssueUrlByVuln != null) ? githubIssueUrlByVuln : Map.of();              // src: vulnhunter-agent/agent/audit_extract.py:83
        RepoProperties props = (repoProperties != null) ? repoProperties : new RepoProperties();    // src: vulnhunter-agent/agent/audit_extract.py:84
        List<Map> out = new List();
        for (Finding f : extracted.findings) out.add(one(f, repoSlug, appId, reportId, resultsDir, opened, status, urlMap.getOrDefault(f.id, ""), props)); // src: vulnhunter-agent/agent/audit_extract.py:85
        return out;
    }

    Map one(Finding finding, String repoSlug, String appId, String reportId, Path resultsDir, boolean opened, String status, String githubIssueUrl, RepoProperties props) {
        return Audit.buildFindingEvent(appId, repoSlug, reportId,
                Audit.findingIdFor(reportId, finding.id),                                           // src: vulnhunter-agent/agent/audit_extract.py:117
                finding.id, finding.title,
                (finding.cwe != null && finding.cwe != "") ? finding.cwe : "CWE-UNKNOWN",           // src: vulnhunter-agent/agent/audit_extract.py:120
                finding.severity, status, finding.location, finding.rootCause, finding.entryPoint, finding.dataFlow,
                "",                                                                                 // exploit_test_cmd: not carried by Finding // src: vulnhunter-agent/agent/audit_extract.py:131
                finding.fixStrategy,
                "",                                                                                 // proposed_fix_files: not surfaced // src: vulnhunter-agent/agent/audit_extract.py:135
                finding.severityRationale,                                                          // reused as proposed_fix_why // src: vulnhunter-agent/agent/audit_extract.py:138
                relativize(finding.pocPath, resultsDir),                                            // src: vulnhunter-agent/agent/audit_extract.py:139
                relativize(finding.exploitTestPath, resultsDir),                                    // src: vulnhunter-agent/agent/audit_extract.py:140
                githubIssueUrl, opened, props.values);                                              // src: vulnhunter-agent/agent/audit_extract.py:143
    }

    String relativize(String path, Path root) {
        if (path == null || path == "") return "";                                                  // src: vulnhunter-agent/agent/audit_extract.py:154
        try {
            return Path(path).resolve().relativeTo(root.resolve()).toString();                       // src: vulnhunter-agent/agent/audit_extract.py:157
        } catch (ValueError e) {
            return path;                                                                            // outside root: keep original // src: vulnhunter-agent/agent/audit_extract.py:159
        }
    }
}
