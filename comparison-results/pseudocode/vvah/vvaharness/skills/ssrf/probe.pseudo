// file: vvaharness/skills/ssrf/probe.sh
// Read-only SSRF probe: fetch sinks in seven ecosystems, indirect mechanisms, url-parameter contracts and their
// call sites, request sources, allow-list/redirect posture, declared HTTP deps; reference tables only when a sink exists.

@executedBy(CODE) @role(tool) @stage("S4")
class SsrfProbe {

    String run(String root, Theta θ) {
        Out out = new Out();
        int cap = Env.getInt("SSRF_PROBE_CAP", 12);                                                 // src: vvaharness/skills/ssrf/probe.sh:21
        boolean found = false;
        out.line("### SSRF PROBE root=" + root);                                                     // src: vvaharness/skills/ssrf/probe.sh:75
        for (String sec : θ["p.skill_ssrf.probe_fetch_sinks_and_contracts"]) {                      // src: vvaharness/skills/ssrf/probe.sh:78
            if (sec.equals("fetch-named helpers and their call sites")) {
                found |= scan(root, "FETCH-NAMED HELPERS", Patterns.FETCH_NAMED_DEF, cap, out);    // src: vvaharness/skills/ssrf/probe.sh:105
                // call sites: same names, excluding def/function lines; anchor findings here
                List<String> calls = Grep.rEn(Patterns.FETCH_NAMED_CALL, root).filter(l -> !l.matches("def|function|func|fun|sub")); // src: vvaharness/skills/ssrf/probe.sh:109
                out.section("CALL SITES OF FETCH-NAMED HELPERS");
                if (calls.isEmpty()) out.line("(none)"); else out.lines(calls.head(cap));           // src: vvaharness/skills/ssrf/probe.sh:112
            } else if (sec.equals("redirect/resolution/allow-list posture")) {
                // SINKS snapshot taken before this section; posture cap 8
                cap = 8;                                                                             // src: vvaharness/skills/ssrf/probe.sh:123
                scan(root, sec, Patterns.of(sec), cap, out);                                         // src: vvaharness/skills/ssrf/probe.sh:124
                countOnly(root, "INTERNAL-TARGET AND SCHEME STRINGS PRESENT IN TREE", Patterns.INTERNAL_TARGETS, out); // src: vvaharness/skills/ssrf/probe.sh:127
            } else if (sec.equals("declared HTTP-client dependencies")) {
                List<String> dep = Grep.rEn(Patterns.HTTP_CLIENT_DEPS, Patterns.MANIFEST_GLOBS, root); // src: vvaharness/skills/ssrf/probe.sh:131
                out.section("DECLARED HTTP-CLIENT DEPENDENCIES (absence NEVER refutes a fetch sink)");
                if (dep.isEmpty()) out.line("(none) - no HTTP client declared; a url-parameter helper is STILL a sink"); // src: vvaharness/skills/ssrf/probe.sh:138
                else out.lines(dep.head(12));
            } else {
                // ecosystem sink sections, indirect mechanisms, url-parameter contracts, request sources
                found |= scan(root, sec, Patterns.of(sec), cap, out);                               // src: vvaharness/skills/ssrf/probe.sh:78
            }
        }
        // reference tables only when a sink or url-contract helper exists
        if (found) for (String table : θ["p.skill_ssrf.probe_reference_tables_when_sink"]) out.section("REFERENCE: " + table).lines(Reference.of(table)); // src: vvaharness/skills/ssrf/probe.sh:145
        out.line("### END SSRF PROBE");                                                              // src: vvaharness/skills/ssrf/probe.sh:173
        return out.exit0();
    }

    boolean scan(String root, String label, String pat, int cap, Out out) {
        out.section(label);
        List<String> hits = Grep.rEn(pat, root, Excludes.SSRF);                                      // src: vvaharness/skills/ssrf/probe.sh:37
        if (hits.isEmpty()) { out.line("(none)"); return false; }
        out.lines(hits.head(cap).map(h -> h.truncate(140)));                                         // src: vvaharness/skills/ssrf/probe.sh:43
        if (hits.size() > cap) out.line("... hits total, showing cap - grep this pattern yourself for the rest"); // src: vvaharness/skills/ssrf/probe.sh:44
        return true;
    }

    void countOnly(String root, String label, String pat, Out out) {
        List<String> hits = Grep.rEn(pat, root, Excludes.SSRF);                                      // src: vvaharness/skills/ssrf/probe.sh:57
        out.section(label);
        if (hits.isEmpty()) out.line("(none)"); else { out.line(hits.size() + " hits; sample:"); out.lines(hits.head(3)); } // src: vvaharness/skills/ssrf/probe.sh:61
    }
}
