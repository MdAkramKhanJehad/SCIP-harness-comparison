# vvaharness/backends/harness/deepagents/options/streaming.py

Compiles the streaming (multi-turn) parent graph with its declarative subagents, sets the recursion limit, and keeps a per-session registry so a resumed session re-enters the same in-memory conversation. This is where `ForceVerdictOnly` is installed on the parent and where the executor tool gate is derived for streaming callers that opt in.

Source: `vvaharness/backends/harness/deepagents/options/streaming.py` (lines 1-161)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/client.py` (streaming run and resume), through `options/__init__.py` build_streaming_agent / resumable / release_session

// src: vvaharness/backends/harness/deepagents/options/streaming.py:133-149
fn build_streaming_agent(options: StreamingOptions):executor=code {
  graph = _build_streaming_graph(options)
  compiled = CompiledGraph(graph, config={
    configurable: { thread_id: options.session_id or 8 random bytes as hexadecimal },
    recursion_limit: (options.max_turns or 50) + RECURSION_HEADROOM   // RECURSION_HEADROOM = 900 (limits.py:30)
  })
  // preserved: LangGraph counts supersteps (graph nodes), not turns, so max_turns here is a floor on the loop budget, not a turn cap (limits.py:19-29). Each subagent subgraph starts its own superstep counter against the same limit.
  if (options.session_id) {
    with _SESSIONS_LOCK: _SESSIONS[options.session_id] = compiled   // the conversation lives in this graph's MemorySaver
  }
  return compiled
}

// src: vvaharness/backends/harness/deepagents/options/streaming.py:89-125
fn _build_streaming_graph(options):executor=code {
  subagent_specs = build_subagents(options)   // subagents.get_subagent_specs(options); always includes "general-purpose"
  // The orchestrator gets read tools only; it dispatches subagents through the auto-added task tool.
  parent_tools = [t for each t in subagents._tool_policy(options).allowed_tools if t in READ_TOOLS]
  tools = subagents._build_session_tools(options, parent_tools)
  return graph_builder._create_agent(
    model_id=options.model, env=options.env, think_in_prompt=options.think_in_prompt,
    system_prompt=options.system_prompt, tools, name=options.graph_name,
    skills=filesystem._skill_sources(options.skill_root, options.cwd),   // preserved: an empty list is passed through here (one-shot converts it to null)
    permissions=filesystem._filesystem_permissions(options),
    model_provider=options.model_provider,
    redact_reads=bool(subagent_specs) || !options.allow_writes,
    // preserved: subagent_specs is never empty (general-purpose is always added), so redact_reads is always true on the streaming parent
    backend=filesystem._session_backend(options),
    response_model=options.response_model,
    response_format=response_format._response_format(options.response_model, options.model, options.model_provider),
    subagents=subagent_specs,
    extra_excluded_tools=_extra_excluded_tools(options),   // null adds no exclusion
    permitted_tool_calls=_permitted_tool_calls(options, tools),   // null installs no PermitTools gate
    max_output_tokens=options.max_output_tokens, output_cap=options.output_cap,
    cache_markers=options.cache_markers,
    cache_tail=true,   // agentic sessions re-read the marked tail every turn
    parent_middleware=[...options.parent_middleware, ...(if (options.force_verdict_only) [ForceVerdictOnly()] else [])],
    // deepagents.force_verdict_only.ForceVerdictOnly is appended AFTER the caller's middleware, only when options.force_verdict_only is true
    effort=options.effort, use_responses_api=options.use_responses_api)
}

// src: vvaharness/backends/harness/deepagents/options/streaming.py:65-75
fn _permitted_tool_calls(options, session_tools):executor=code {
  if (options.permitted_tool_calls == null) return null
  permitted = options.permitted_tool_calls union session_tool_names(session_tools) union _middleware_tool_names(options)
  if (options.agents) permitted = permitted union [SUBAGENT_DISPATCH_TOOL]   // "task" only when personas are configured
  return permitted
}

// src: vvaharness/backends/harness/deepagents/options/streaming.py:78-86
fn _extra_excluded_tools(options):executor=code {
  // Derived from the same permitted_tool_calls as the gate so the two cannot drift; advertisement only.
  if (options.permitted_tool_calls == null) return null
  excluded = ALL_NATIVE_TOOLS - options.permitted_tool_calls
  if (options.agents) return excluded
  return excluded union [SUBAGENT_DISPATCH_TOOL]
}

// src: vvaharness/backends/harness/deepagents/options/streaming.py:57-62
fn _middleware_tool_names(options):executor=code {
  return names of every tool in each caller middleware's `tools` attribute
}

// src: vvaharness/backends/harness/deepagents/options/streaming.py:128-130, 152-161
State {
  _SESSIONS: map session_id -> CompiledGraph   // guarded by _SESSIONS_LOCK
}
fn resumable(session_id):executor=code { with _SESSIONS_LOCK: return _SESSIONS[session_id] or null }
fn release_session(session_id):executor=code { with _SESSIONS_LOCK: remove session_id from _SESSIONS }

// src: vvaharness/backends/harness/deepagents/options/streaming.py:52-54
fn build_subagents(options):executor=code { return subagents.get_subagent_specs(options) }
