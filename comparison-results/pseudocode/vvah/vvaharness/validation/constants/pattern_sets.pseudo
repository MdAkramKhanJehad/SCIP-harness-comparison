// file: vvaharness/validation/constants/pattern_sets.py
// Constants for the deterministic PatternScan fact tool: built-in pattern sets and scan skips.

@executedBy(CODE) @role(config) @stage("S11")
class PatternSets {

    Map<String, PatternSet> defaultPatternSets(Theta θ) {
        return θ["code.validation.constants.pattern_sets.default_pattern_sets"];                    // secret_exposure=scope._SECRET_RX, insecure_value=scope._INSECURE_RX  // src: vvaharness/validation/constants/pattern_sets.py:24
    }

    Set<String> skipInScan(Theta θ) {
        return θ["code.validation.constants.pattern_sets.skip_in_scan"];                            // diff.patch  // src: vvaharness/validation/constants/pattern_sets.py:29
    }

    byte NUL_BYTE = 0;                                                                               // file containing NUL = binary, skipped  // src: vvaharness/validation/constants/pattern_sets.py:32
    String BUILTIN_RULE = "__builtin__";                                                             // src: vvaharness/validation/constants/pattern_sets.py:33
}

@executedBy(CODE) @role(types)
record PatternSet(String description, Regex pattern) { }
