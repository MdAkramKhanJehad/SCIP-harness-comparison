# vvaharness/pipeline/stages/s7/session.py

The single Stage 7 model call (the semantic pass). Any failure other than a halt error degrades to "no collapse": an empty list of decisions.

Source: `vvaharness/pipeline/stages/s7/session.py` (lines 1-75)
Executor: mixed
Called from: `vvaharness/pipeline/stages/s7_dedup.py` run

// src: vvaharness/pipeline/stages/s7/session.py:32-33 — minimum-response floors, set under the shortest valid reply
MIN_RESPONSE_CHARS = 90
MIN_RESPONSE_TOKENS = 15

// src: vvaharness/pipeline/stages/s7/session.py:36-75
fn semantic_dedup(verified, unresolved, cfg, ctx, label="s7-dedup"):executor=mixed {
  // Returns rows [local_idx, local_canonical_idx, reasoning, independent_sites]
  tag = label with "-" replaced by " "   // spaced form is the floors tag; hyphenated form is the errlog key
  effort = knob("step7_dedup.effort", default=null) or null

  // src: session.py:44-56
  _dispatch(drop_thinking) => callModel({
    role: "dedup",
    route: "deepagents dispatch_prompt (single prompt, no agent loop); backend resolved from cfg.models.dedup",   // external: vvaharness/backends/llm/deepagents
    system: SYSTEM,                                          // see s7/prompts.sudo
    prompt: s7.prompts.build_payload(verified, unresolved),
    tools: [],                                               // none offered; cwd=ctx.repo_root roots the virtual filesystem at the repository
    limits: { max_tokens: knob("step7_dedup.max_tokens", default=64000), effort: if (drop_thinking) null else effort },
    output: DedupDecisions                                   // response_model; see s7/outcomes.sudo
  })

  // src: session.py:58-74
  try {
    // floors: a reply under 90 characters or 15 tokens fails the minimum-response check (external: util/response_quality)
    with stage_floors(tag, min_chars=MIN_RESPONSE_CHARS, min_tokens=MIN_RESPONSE_TOKENS) {
      raw = dispatch_or_retry_unforced(_dispatch, "semantic", stage=first part of label before "-",
        effort=droppable_effort(cfg.models.dedup, effort, agentic=false),
        may_retry=() => effort != null,
        resend_refusal=refusal_resend_allowed(cfg, cfg.models.dedup))
      // external: util/response_quality.dispatch_or_retry_unforced — on a schema rejection or an at-output-cap clip, one resend with drop_thinking=true, allowed only when an effort was set; optionally one identical resend after a model refusal
    }
  }
  catch error => {
    if (is_halt_error(error)) throw error
    // abstracted: console line "semantic dedup call failed (non-fatal)" with redacted error text
    errlog.log(label, "semantic", error)
    return []   // fail open: no collapse
  }
  return s7.outcomes.parse_decisions(raw, length(unresolved), label)
}
