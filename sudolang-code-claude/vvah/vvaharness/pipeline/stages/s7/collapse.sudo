# vvaharness/pipeline/stages/s7/collapse.py

The deterministic half of Stage 7. `collapse_trivial` decides which findings are the same site and the same weakness, with no model call. `attach_duplicates` folds each collapsed finding onto its canonical root as an extra call site and lets the survivor inherit a main channel, a cluster CWE name and a specific vulnerability class. `cwe_conflict` is also the code check applied to the model's proposed merges.

Source: `vvaharness/pipeline/stages/s7/collapse.py` (lines 1-222)
Executor: code
Called from: `vvaharness/pipeline/stages/s7_dedup.py` run and prefilter

// src: vvaharness/pipeline/stages/s7/collapse.py:25-38
TRIVIAL_REASON = "trivial: same site, shared weakness within line tolerance"
STRICT_CWE_CLASS = { VulnClass.LOGIC }
CATCH_ALL_VULN_CLASS = { VulnClass.OTHER, VulnClass.LOGIC }   // catch-all labels a specific sibling overwrites, never the reverse
MIN_TITLE_OVERLAP = 0.15   // below this title token overlap a pair is not trivially one weakness
_TITLE_STOPWORDS = ["via", "the", "and", "with", "to", "of", "on", "no", "or", "for", "is", "by",
  "without", "all", "in", "a", "an", "from", "into", "that", "this", "its"]

// src: vvaharness/pipeline/stages/s7/collapse.py:158-222
fn collapse_trivial(findings, line_tol, group_lines?, min_title_overlap=MIN_TITLE_OVERLAP):executor=code {
  // Returns { duplicate index -> canonical index }; the lower index is always canonical
  n = length(findings)
  // src: collapse.py:165-171 — group line is group_lines[i] when given and in range, else line_start
  glines = for each i in 0..n-1: if (group_lines && i < length(group_lines)) group_lines[i] else findings[i].line_start
  // src: collapse.py:172-175 — each span shifted onto its group line
  spans = for each i: [glines[i], findings[i].line_end + glines[i] - findings[i].line_start]

  canonical_of = {}
  // src: collapse.py:178-221 — first earlier match wins (break)
  for each j in 0..n-1 {
    if (j in canonical_of) continue
    b = findings[j]
    for each i in 0..j-1 {
      if (i in canonical_of) continue
      a = findings[i]
      if (a.file != b.file) continue
      cross_class = a.vuln_class != b.vuln_class
      shared_weakness = false
      if (a.cwe && b.cwe) {
        shared_weakness = weakness_key(a.cwe) != null && weakness_key(a.cwe) == weakness_key(b.cwe)
                          && weakness_key(a.cwe) not in _GENERIC_PARENT_CWES   // external: vvaharness/rules/cwe.py; generic parents are CWE-20 and CWE-74
      }
      // a class mismatch merges only across one shared, non-generic weakness
      if (cross_class && !shared_weakness) continue
      // src: collapse.py:197-202 — LOGIC without both CWEs never collapses (a missing CWE is common before Stage 6)
      if (a.cwe && b.cwe) {
        if (cwe_conflict(a, b)) continue
      } else if (a.vuln_class in STRICT_CWE_CLASS) continue
      // src: collapse.py:203-214 — an equal CWE is not proof of one weakness; unlike titles are deferred
      if (title_overlap(a, b) < min_title_overlap) {
        COUNTERS.bump("s7_trivial_collapse_deferred_unlike_titles")
        continue   // both findings are KEPT
      }
      // src: collapse.py:215-221
      close = abs(glines[i] - glines[j]) <= line_tol
      overlap = spans[i][0] <= spans[j][1] && spans[j][0] <= spans[i][1]
      if (close || overlap) {
        if (cross_class) COUNTERS.bump("s7_trivial_collapse_cross_class_merged")
        canonical_of[j] = i
        break
      }
    }
  }
  return canonical_of
}

// src: vvaharness/pipeline/stages/s7/collapse.py:41-52
fn title_overlap(a, b):executor=code {
  tokens(title) => lowercased runs of [a-z0-9] longer than 2 characters, minus _TITLE_STOPWORDS
  [ta, tb] = [tokens(a.title), tokens(b.title)]
  if (ta is empty || tb is empty) return 1.0   // an empty title never blocks a collapse
  return length(ta intersection tb) / length(ta union tb)   // Jaccard overlap
}

// src: vvaharness/pipeline/stages/s7/collapse.py:56-62
fn cwe_conflict(a, b):executor=code {
  // A semantic collapse across CWEs merges distinct defects
  if (!(a.cwe && b.cwe)) return false
  [key_a, key_b] = [weakness_key(a.cwe), weakness_key(b.cwe)]   // external: vvaharness/rules/cwe.py folds sibling clusters (89/943/564, 78/77, 22/23/36, 79/80, 862/285/284) onto the first id
  return key_a == null || key_a != key_b   // an id that fails to parse is never evidence of a match
}

// src: vvaharness/pipeline/stages/s7/collapse.py:117-155
fn attach_duplicates(findings, canonical_of, reasoning, keep_same_site?):executor=code {
  // src: collapse.py:121-126 — root follows canonical_of with a cycle guard
  root(i) => follow canonical_of from i, stopping at a non-duplicate or an index already seen
  roots = {}
  for each [j, parent] in canonical_of {
    r = root(parent); roots = roots union {r}
    [dj, rf] = [findings[j], findings[r]]
    _inherit_main_channel(dj, rf)
    _inherit_cluster_cwe(dj, rf)
    _inherit_vuln_class(dj, rf)
    // src: collapse.py:135-150
    same_site = dj.file == rf.file && dj.line_start <= rf.line_end && rf.line_start <= dj.line_end
    if (!same_site) {
      append dup_location(dj, reasoning[j] or "duplicate") to rf.duplicates
    } else if (keep_same_site != null) {
      // keep_same_site means "independent sites": each sink line is its own operation
      if (j in keep_same_site && dj.line_start != rf.line_start) {
        append dup_location(dj, reasoning[j] or "duplicate") to rf.duplicates
        COUNTERS.bump("s7_dedup_same_site_kept")
      } else {
        COUNTERS.bump("s7_dedup_same_site_discarded")
      }
    }
    // when keep_same_site is null, a same-site duplicate leaves no location on the survivor
    // src: collapse.py:151-153 — the duplicate's own collected sites move to the root
    if (dj.duplicates) { rf.duplicates += dj.duplicates; dj.duplicates = [] }
  }
  // src: collapse.py:154-155
  for each r in roots, findings[r].duplicates = dedup_locations(findings[r].duplicates);
}

// src: vvaharness/pipeline/stages/s7/collapse.py:92-97
fn _inherit_main_channel(dup, canonical):executor=code {
  // canonical is only the lowest index, so a posture winner would route a real defect out of the main channel
  if (dup.channel == "main" && canonical.channel != "main") {
    canonical.channel = "main"; COUNTERS.bump("s7_dedup_channel_inherited_main")
  }
}

// src: vvaharness/pipeline/stages/s7/collapse.py:100-106
fn _inherit_cluster_cwe(dup, canonical):executor=code {
  // input is sorted on the raw cwe string, so CWE-77 would outrank CWE-78; the survivor takes the cluster's first id
  key = weakness_key(canonical.cwe)
  if (key && key == norm_cwe(dup.cwe) && key != norm_cwe(canonical.cwe)) {
    canonical.cwe = key; COUNTERS.bump("s7_dedup_cwe_inherited")
  }
}

// src: vvaharness/pipeline/stages/s7/collapse.py:109-114
fn _inherit_vuln_class(dup, canonical):executor=code {
  if (canonical.vuln_class in CATCH_ALL_VULN_CLASS && dup.vuln_class not in CATCH_ALL_VULN_CLASS) {
    canonical.vuln_class = dup.vuln_class
  }
}

// src: vvaharness/pipeline/stages/s7/collapse.py:65-77
fn dup_location(f, reasoning):executor=code {
  return DupLocation(file, line_start, line_end, vuln_class, title, chunk_id, source_ref, sink_ref of f, reasoning)
}

// src: vvaharness/pipeline/stages/s7/collapse.py:80-89
fn dedup_locations(locs):executor=code {
  return locs with repeated (file, line_start, line_end) removed, first occurrence kept, order kept
}
