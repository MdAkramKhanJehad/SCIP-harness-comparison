// file: vvaharness/pipeline/stages/s8/prompts.py
// Step 8's prompts: the chaining brief (SYSTEM), the per-finding block it ranks, the repo fact
// blocks, the user prompt with EVIDENCE RULES, and the json-repair re-ask.

@executedBy(MODEL) @role(prompt) @stage("S8")
class S8Prompts {

    Prompt system(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.s8_prompts.role_exploit_strategist"]);                                   // src: vvaharness/pipeline/stages/s8/prompts.py:26
        p.rule(θ["prompt.s8.evidence_rule"]);                                                   // src: vvaharness/pipeline/stages/s8/prompts.py:26
        p.rule(θ["p.s8_prompts.verdicts_authoritative"]);                                       // src: vvaharness/pipeline/stages/s8/prompts.py:28
        p.forbid(θ["p.s8_prompts.no_reverify"]);                                                // src: vvaharness/pipeline/stages/s8/prompts.py:29
        p.include(chainPotential(θ));
        p.include(chainShapes(θ));
        p.include(rankingRules(θ));
        p.include(severityBands(θ));
        p.include(chainRules(θ));
        p.include(closeTheLoop(θ));
        return p;
    }

    Prompt chainPotential(Theta θ) {
        // For each finding, reassess only the CHAIN potential given:
        Prompt p = new Prompt();
        p.checklist(θ["p.s8_prompts.chain_potential_questions"]);                               // src: vvaharness/pipeline/stages/s8/prompts.py:33
        p.rule(θ["p.s8_prompts.preauth_check_design_controls"]);                                // src: vvaharness/pipeline/stages/s8/prompts.py:34
        p.choose(θ["p.s8_prompts.primitive_set"]);                                              // src: vvaharness/pipeline/stages/s8/prompts.py:37
        p.must(θ["p.s8_prompts.feeds_record_every_id"]);                                        // src: vvaharness/pipeline/stages/s8/prompts.py:38
        p.forbid(θ["p.s8_prompts.feeds_never_same_location"]);                                  // src: vvaharness/pipeline/stages/s8/prompts.py:39
        return p;
    }

    Prompt chainShapes(Theta θ) {
        // Then look for CHAINS: "one bug supplies what another needs".
        Prompt p = new Prompt();
        p.rule(θ["p.s8_prompts.look_for_chains"]);                                              // src: vvaharness/pipeline/stages/s8/prompts.py:41
        p.checklist(List.of(
            θ["p.s8_prompts.chain_shape_authbypass_postauth"],                                  // src: vvaharness/pipeline/stages/s8/prompts.py:43
            θ["p.s8_prompts.chain_shape_infoleak_secret_sink"],                                 // src: vvaharness/pipeline/stages/s8/prompts.py:44
            θ["p.s8_prompts.chain_shape_ssrf_internal"],                                        // src: vvaharness/pipeline/stages/s8/prompts.py:46
            θ["p.s8_prompts.chain_shape_upload_codeload"],                                      // src: vvaharness/pipeline/stages/s8/prompts.py:47
            θ["p.s8_prompts.chain_shape_weak_session_authz"],                                   // src: vvaharness/pipeline/stages/s8/prompts.py:48
            θ["p.s8_prompts.chain_shape_finding_plus_cve"],                                     // src: vvaharness/pipeline/stages/s8/prompts.py:49
            θ["p.s8_prompts.chain_shape_memory_pairs"]));                                       // src: vvaharness/pipeline/stages/s8/prompts.py:50
        p.rule(θ["p.s8_prompts.chain_reachability_rule"]);                                      // src: vvaharness/pipeline/stages/s8/prompts.py:52
        p.tiebreak(θ["p.s8_prompts.reachability_signal_weights"]);                              // src: vvaharness/pipeline/stages/s8/prompts.py:54
        p.rule(θ["p.s8_prompts.control_blocks_chain_downrank"]);                                // src: vvaharness/pipeline/stages/s8/prompts.py:57
        return p;
    }

    Prompt rankingRules(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s8_prompts.cvss_is_shipped_severity"]);                                     // src: vvaharness/pipeline/stages/s8/prompts.py:59
        p.must(θ["p.s8_prompts.ranked_entry_only_if_feeds_or_change"]);                         // src: vvaharness/pipeline/stages/s8/prompts.py:60
        p.format(θ["p.s8_prompts.ranked_reason_length"]);                                       // src: vvaharness/pipeline/stages/s8/prompts.py:62
        p.forbid(θ["p.s8_prompts.no_restate_findings"]);                                        // src: vvaharness/pipeline/stages/s8/prompts.py:63
        return p;
    }

    Prompt severityBands(Theta θ) {
        // Use these bands when you DO change one.
        Prompt p = new Prompt();
        p.choose(θ["p.s8_prompts.severity_bands"]);                                             // src: vvaharness/pipeline/stages/s8/prompts.py:66
        p.threshold(θ["p.s8_prompts.band_critical"]);                                           // src: vvaharness/pipeline/stages/s8/prompts.py:67
        p.threshold(θ["p.s8_prompts.band_high"]);                                               // src: vvaharness/pipeline/stages/s8/prompts.py:68
        p.threshold(θ["p.s8_prompts.band_medium"]);                                             // src: vvaharness/pipeline/stages/s8/prompts.py:69
        p.threshold(θ["p.s8_prompts.band_low"]);                                                // src: vvaharness/pipeline/stages/s8/prompts.py:70
        p.threshold(θ["p.s8_prompts.band_info"]);                                               // src: vvaharness/pipeline/stages/s8/prompts.py:71
        p.must(θ["p.s8_prompts.refer_by_id_only"]);                                             // src: vvaharness/pipeline/stages/s8/prompts.py:73
        return p;
    }

    Prompt chainRules(Theta θ) {
        // Two rules bind every chain you propose.
        Prompt p = new Prompt();
        p.must(θ["p.s8_prompts.chain_rule_step_changes_capability"]);                           // src: vvaharness/pipeline/stages/s8/prompts.py:77
        p.must(θ["p.s8_prompts.chain_rule_title_in_steps"]);                                    // src: vvaharness/pipeline/stages/s8/prompts.py:82
        return p;
    }

    Prompt closeTheLoop(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.s8_prompts.close_loop_before_summary"]);                                 // src: vvaharness/pipeline/stages/s8/prompts.py:86
        p.rule(θ["p.s8_prompts.evidenced_feeds_become_chains"]);                                // src: vvaharness/pipeline/stages/s8/prompts.py:87
        p.forbid(θ["p.s8_prompts.precondition_not_feeds"]);                                     // src: vvaharness/pipeline/stages/s8/prompts.py:88
        p.must(θ["p.s8_prompts.summary_only_listed_chains"]);                                   // src: vvaharness/pipeline/stages/s8/prompts.py:90
        return p;
    }

    @executedBy(CODE)
    boolean factsEnabled(Theta θ) {
        // Gates the fact blocks: entry-point inventory, Dockerfile USER, decorator prologue in each snippet.
        boolean on = θ["step8.prompt_fact_blocks"];                                             // src: vvaharness/pipeline/stages/s8/prompts.py:101
        return on && θ["p.s8_prompts.fact_blocks_enabled"];                                     // src: vvaharness/pipeline/stages/s8/prompts.py:101
    }

    @executedBy(CODE)
    boolean hopTextEnabled(Theta θ) {
        // Off by default and in every profile: attack-narrative text may raise the refusal rate.
        boolean on = θ["step8.hop_text"];                                                       // src: vvaharness/pipeline/stages/s8/prompts.py:110
        return on && θ["p.s8_prompts.hop_text_enabled"];                                        // src: vvaharness/pipeline/stages/s8/prompts.py:110
    }

    @executedBy(CODE)
    String hopLines(Finding f, Theta θ) {
        // Scenario / Preconditions lines, each omitted when empty.
        return θ["p.s8_prompts.hop_lines_fields"].filter(field -> !f.get(field).isEmpty()).join("\n"); // src: vvaharness/pipeline/stages/s8/prompts.py:115
    }

    @executedBy(CODE)
    Prompt entryPointBlock(ContextPackage ctx, Theta θ) {
        Prompt p = new Prompt();
        String lines = S6Prompts.entryPointLines(ctx, θ);                                       // src: vvaharness/pipeline/stages/s8/prompts.py:132
        if (lines.isEmpty()) return p;
        p.context(lines);
        p.rule(θ["p.s8_prompts.entry_point_inventory_incomplete"]);                             // src: vvaharness/pipeline/stages/s8/prompts.py:122
        p.forbid(θ["p.s8_prompts.entry_absence_not_arguable"]);                                 // src: vvaharness/pipeline/stages/s8/prompts.py:125
        return p;
    }

    @executedBy(CODE)
    String reachabilityForFinding(Finding f, Theta θ) {
        List<String> parts = new List();
        if (f.sourceRef != null) parts.add("source=" + f.sourceRef + (f.backfilledRefs.contains("source_ref") ? " (inferred from AST, unverified)" : "")); // src: vvaharness/pipeline/stages/s8/prompts.py:140
        if (f.sinkRef != null) parts.add("sink=" + f.sinkRef + (f.backfilledRefs.contains("sink_ref") ? " (inferred from AST, unverified)" : "")); // src: vvaharness/pipeline/stages/s8/prompts.py:143
        Object markers = θ["p.s8_prompts.reachability_markers"];                                // src: vvaharness/pipeline/stages/s8/prompts.py:145
        return parts.isEmpty() ? "(no graph context)" : parts.join(" ");
    }

    @executedBy(CODE)
    Prompt findingBlock(String fid, Finding f, ContextPackage ctx, boolean factsOn, boolean hopText, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s8_prompts.finding_block_fields"]);                                       // src: vvaharness/pipeline/stages/s8/prompts.py:159
        p.context("[" + fid + "] " + f.vulnClass + " @ " + f.file + ":" + f.lineStart + " Title CVSS Verified description"); // src: vvaharness/pipeline/stages/s8/prompts.py:159
        if (hopText) p.context(hopLines(f, θ));                                                 // src: vvaharness/pipeline/stages/s8/prompts.py:163
        p.context("Reachability: " + reachabilityForFinding(f, θ));                             // src: vvaharness/pipeline/stages/s8/prompts.py:164
        String snippet = S8Facts.snippetFor(f, ctx.repoRoot, factsOn);                          // src: vvaharness/pipeline/stages/s8/prompts.py:155
        if (!snippet.isEmpty()) p.context("CODE:\n" + indentBlock(snippet, "      "));          // src: vvaharness/pipeline/stages/s8/prompts.py:167
        return p;
    }

    /** Indent a code block under its field (default pad is six spaces) so the prompt stays scannable. */
    @executedBy(CODE)
    @src("vvaharness/pipeline/stages/s8/prompts.py:171")
    String indentBlock(String text, String pad) {
        return text.splitlines().map(ln -> pad + ln).join("\n");                                  // src: vvaharness/pipeline/stages/s8/prompts.py:173
    }

    @executedBy(CODE)
    Prompt repoFactBlocks(List<Finding> findings, ContextPackage ctx, List<String> labels, boolean factsOn, Theta θ) {
        // The windowing estimator calls this same function, so its estimate cannot drift from the prompt.
        Prompt p = new Prompt();
        if (factsOn) p.include(entryPointBlock(ctx, θ));                                        // src: vvaharness/pipeline/stages/s8/prompts.py:186
        List<String> exposure = S8Facts.exposureFacts(ctx, findings, factsOn);                  // src: vvaharness/pipeline/stages/s8/prompts.py:180
        p.context("DEPLOYMENT EXPOSURE: " + (exposure.isEmpty() ? "(not determined)" : exposure.join("\n")));
        p.tiebreak(θ["p.s8_prompts.deployment_exposure_overrides"]);                            // src: vvaharness/pipeline/stages/s8/prompts.py:187
        List<String> colocated = S8Facts.sameLocationGroups(findings, labels);                  // src: vvaharness/pipeline/stages/s8/prompts.py:183
        p.context("FINDINGS AT THE SAME LOCATION: " + (colocated.isEmpty() ? "(none)" : colocated.join("\n")));
        p.forbid(θ["p.s8_prompts.colocated_never_two_steps"]);                                  // src: vvaharness/pipeline/stages/s8/prompts.py:191
        return p;
    }

    @executedBy(CODE)
    Prompt buildPrompt(List<Finding> findings, ContextPackage ctx, List<String> labels, Theta θ) {
        if (labels == null) labels = S8Outcomes.findingIds(findings);                           // src: vvaharness/pipeline/stages/s8/prompts.py:199
        boolean factsOn = factsEnabled(θ);                                                      // src: vvaharness/pipeline/stages/s8/prompts.py:201
        boolean hopText = hopTextEnabled(θ);                                                    // src: vvaharness/pipeline/stages/s8/prompts.py:202
        Prompt p = new Prompt();
        p.context("REPO: " + ctx.repoRoot);                                                     // src: vvaharness/pipeline/stages/s8/prompts.py:223
        if (θ["p.s8_prompts.threat_model_block"]) {                                             // src: vvaharness/pipeline/stages/s8/prompts.py:221
            if (ctx.appProfile != null) p.context(ctx.appProfile.toPromptBlock());              // src: vvaharness/pipeline/stages/s8/prompts.py:219
            if (ctx.threatModel != null) p.context(ctx.threatModel.toPromptBlock());            // src: vvaharness/pipeline/stages/s8/prompts.py:221
        }
        if (θ["p.s8_prompts.design_controls_block"]) p.context("DESIGN CONTROLS: " + ctx.designControls); // src: vvaharness/pipeline/stages/s8/prompts.py:225
        if (θ["p.s8_prompts.known_cves_combinations"]) p.context("KNOWN CVEs (check for combinations with new findings): " + ctx.knownCves); // src: vvaharness/pipeline/stages/s8/prompts.py:228
        p.include(repoFactBlocks(findings, ctx, labels, factsOn, θ));                           // src: vvaharness/pipeline/stages/s8/prompts.py:231
        for (int i : range(findings.size())) p.include(findingBlock(labels[i], findings[i], ctx, factsOn, hopText, θ)); // src: vvaharness/pipeline/stages/s8/prompts.py:203
        p.include(evidenceRules(θ));                                                            // src: vvaharness/pipeline/stages/s8/prompts.py:236
        p.format(θ["p.s8_prompts.json_only"]);                                                  // src: vvaharness/pipeline/stages/s8/prompts.py:264
        return p;
    }

    Prompt evidenceRules(Theta θ) {
        // EVIDENCE RULES:
        Prompt p = new Prompt();
        p.tiebreak(θ["p.s8_prompts.evidence_rule_code_wins"]);                                  // src: vvaharness/pipeline/stages/s8/prompts.py:237
        p.rule(θ["p.s8_prompts.evidence_rule_nondefault_condition"]);                           // src: vvaharness/pipeline/stages/s8/prompts.py:241
        p.evidence(θ["p.s8_prompts.evidence_rule_link_evidence"]);                              // src: vvaharness/pipeline/stages/s8/prompts.py:245
        p.forbid(θ["p.s8_prompts.unevidenced_chain_omit"]);                                     // src: vvaharness/pipeline/stages/s8/prompts.py:248
        p.must(θ["p.s8_prompts.evidence_rule_entry_reachability"]);                             // src: vvaharness/pipeline/stages/s8/prompts.py:251
        p.evidence(θ["p.s8_prompts.evidence_rule_facts_not_inferences"]);                       // src: vvaharness/pipeline/stages/s8/prompts.py:252
        p.rule(θ["p.s8_prompts.unshown_fact_conditional_wording"]);                             // src: vvaharness/pipeline/stages/s8/prompts.py:256
        p.forbid(θ["p.s8_prompts.assumed_fact_invented_chain"]);                                // src: vvaharness/pipeline/stages/s8/prompts.py:260
        return p;
    }

    @executedBy(CODE)
    Prompt repairPrompt(String raw, Exception err, Theta θ) {
        // REPAIR TASK: restate as ONE JSON object with keys ranked_findings, chains, summary.
        Prompt p = new Prompt();
        p.forbid(θ["p.s8_prompts.repair_restate_only"]);                                        // src: vvaharness/pipeline/stages/s8/prompts.py:272
        p.context("PARSE ERROR: " + err + "\n--- ORIGINAL REPLY ---\n" + raw);                  // src: vvaharness/pipeline/stages/s8/prompts.py:274
        return p;
    }

    @executedBy(MODEL)
    ChainReport chainAnalysis(List<FindingBlock> findings, Theta θ) {
        // The procedure SYSTEM + EVIDENCE RULES ask the model to carry out.
        List<RankedEntry> ranked = new List();
        for (FindingBlock f : findings) {                                                       // src: vvaharness/pipeline/stages/s8/prompts.py:33
            List<String> feeds = findings.filter(g -> g.location != f.location && suppliesPrimitive(f, g)).ids(); // src: vvaharness/pipeline/stages/s8/prompts.py:38
            boolean change = severityShouldChange(f, θ["p.s8_prompts.severity_bands"]);         // src: vvaharness/pipeline/stages/s8/prompts.py:66
            if (!feeds.isEmpty() || change) ranked.add(new RankedEntry(f.id, feeds, reasonInTwoSentences(f))); // src: vvaharness/pipeline/stages/s8/prompts.py:60
        }
        List<ChainEntry> chains = new List();
        for (RankedEntry r : ranked) {                                                          // src: vvaharness/pipeline/stages/s8/prompts.py:86
            for (String to : r.feeds) {
                LinkEvidence ev = citeFileLine(r.id, to);                                       // src: vvaharness/pipeline/stages/s8/prompts.py:245
                if (ev == null) continue;                                                       // src: vvaharness/pipeline/stages/s8/prompts.py:248
                if (!stepChangesCapability(r.id, to)) continue;                                 // src: vvaharness/pipeline/stages/s8/prompts.py:77
                if (blockedByDesignControl(r.id, to)) downrank(r.id, to);                       // src: vvaharness/pipeline/stages/s8/prompts.py:57
                chains.add(buildChain(r.id, to, ev));
            }
        }
        // summary comes last and describes only listed chains
        return new ChainReport(ranked, chains, summarize(chains));                              // src: vvaharness/pipeline/stages/s8/prompts.py:90
    }
}
