// file: vvaharness/validation/constants/test_inventory.py
// Constants for the TestInventory fact tool: which files count as tests, and which markers make a test "negative".

@executedBy(CODE) @role(config) @stage("S11")
class TestInventory {

    TestNameRules pyTestNames(Theta θ) {
        return θ["code.validation.constants.test_inventory.py_test_names"];                         // exact conftest.py/tests.py/test.py, prefix test_, suffix _test.py  // src: vvaharness/validation/constants/test_inventory.py:19
    }

    List<String> jsTestSuffixes(Theta θ) {
        return θ["code.validation.constants.test_inventory.js_test_suffixes"];                      // src: vvaharness/validation/constants/test_inventory.py:22
    }

    List<String> negativeTestMarkers(Theta θ) {
        return θ["code.validation.constants.test_inventory.negative_test_markers"];                 // case-insensitive, word-bounded  // src: vvaharness/validation/constants/test_inventory.py:28
    }
}

@executedBy(CODE) @role(types)
record TestNameRules(Set<String> exact, String prefix, String suffix) { }
