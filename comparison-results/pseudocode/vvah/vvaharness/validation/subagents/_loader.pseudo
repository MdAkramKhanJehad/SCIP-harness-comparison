// file: vvaharness/validation/subagents/_loader.py
// Parse bundled persona files; an override narrows declared tools and preserves declared fact tools.

@executedBy(CODE) @role(config) @stage("S11")
class ValidationSubagentLoader {
    @src("vvaharness/validation/subagents/_loader.py:31")
    List<String> optionalStrTuple(Object value) {
        return value instanceof List && !value.isEmpty() ? immutableCopy(value) : null;
    }
    @src("vvaharness/validation/subagents/_loader.py:36")
    SubagentDefinition buildSubagentDefinition(Map meta, String prompt) {
        Object name = meta.get("name"); if (!(name instanceof String) || name.isEmpty()) throw new ValueError("missing name");
        Object description = meta.get("description"); if (!(description instanceof String) || description.isEmpty()) throw new ValueError("missing description");
        return new SubagentDefinition(name, description, prompt, optionalStrTuple(meta.get("allowedTools")), optionalStrTuple(meta.get("deniedTools")), meta.get("model") instanceof String ? meta.get("model") : null, optionalStrTuple(meta.get("skills")), PersonaReport);
    }
    @src("vvaharness/validation/subagents/_loader.py:60")
    List<Path> iterBundledFiles() {
        return packageFiles("vvaharness.validation.subagents").iterdir().filter(e -> e.name.endsWith(".md")).map(e -> Path.of(str(e)));
    }
    @src("vvaharness/validation/subagents/_loader.py:114")
    void assertAllFound(Set<String> wanted, Set<String> found) {
        if (wanted == null) return;
        if (!wanted.minus(found).isEmpty()) throw new ValueError("requested subagents not found");
    }
    @src("vvaharness/validation/subagents/_loader.py:68")
    Map<String, SubagentDefinition> loadAgents(List<String> names, Map modelOverrides, List<String> toolsOverride, String suffix, Integer maxModelCalls, Theta θ) {
        Set wanted = names == null ? null : Set.copyOf(names); Map overrides = truthyOr(modelOverrides, Map.of()); Map result = new Map();
        for (Path path : iterBundledFiles()) {
            Pair parsed = parseFrontmatter(path.readText("utf-8")); SubagentDefinition agent = buildSubagentDefinition(parsed.first, parsed.second);
            if (wanted != null && !wanted.contains(agent.name)) continue;
            if (overrides.containsKey(agent.name)) agent = agent.copyWith("model", overrides.get(agent.name));
            if (toolsOverride != null) agent = agent.copyWith("tools", truthyOr(agent.tools, List.of()).filter(t -> toolsOverride.contains(t) || FACT_TOOLS.contains(t)));
            if (truthy(suffix)) agent = agent.copyWith("prompt", agent.prompt.rstrip() + "\n\n" + suffix);
            agent = agent.copyWith("max_model_calls", truthyOr(maxModelCalls, null)); // zero and null leave it unmetered.
            result.put(agent.name, agent);
        }
        assertAllFound(wanted, result.keys()); return result;
    }
}
