// file: vvaharness/validation/io/_host_score.py
// Deterministic host-side scoring from synthesized_gates.json; the agent's own score/fix_status is never
// authoritative. Fails closed: absent or malformed gates -> INCONCLUSIVE with no score.

@executedBy(CODE) @role(evaluation) @stage("S11")
class HostScore {

    String NO_GATES = "no host-verified gates were available for this finding; the agent's self-reported verdict is not authoritative, so no score is recorded"; // src: vvaharness/validation/io/_host_score.py:37

    String readGatesText(Path workspaceDir) {
        try {
            return workspaceDir.resolve("synthesized_gates.json").readText();                        // src: vvaharness/validation/io/_host_score.py:46
        } catch (OSError e) {
            return null;                                                                             // silent fail-closed  // src: vvaharness/validation/io/_host_score.py:48
        }
    }

    List<Object> parseGatesArray(String text) {
        Object data;
        try {
            data = Json.loads(text);                                                                 // src: vvaharness/validation/io/_host_score.py:54
        } catch (JSONDecodeError e) {
            Log.warning("synthesized_gates.json unparseable; failing closed");                       // src: vvaharness/validation/io/_host_score.py:56
            return null;
        }
        if (data instanceof List) return data;                                                       // src: vvaharness/validation/io/_host_score.py:58
        Log.warning("synthesized_gates.json is not a JSON array; failing closed");                   // src: vvaharness/validation/io/_host_score.py:60
        return null;
    }

    Map<String, List<Map>> gatesByTrackingId(List<Object> data) {
        Map<String, List<Map>> byId = new Map();
        int dropped = 0;
        for (Object entry : data) {                                                                  // src: vvaharness/validation/io/_host_score.py:68
            if (entry instanceof Map && entry.get("gates") instanceof List) byId.put(str(entry.getOrDefault("tracking_id", "")), entry.get("gates")); // src: vvaharness/validation/io/_host_score.py:69
            else dropped += 1;                                                                       // src: vvaharness/validation/io/_host_score.py:72
        }
        if (dropped > 0) Log.warning("dropped malformed entries");                                   // src: vvaharness/validation/io/_host_score.py:73
        return byId;
    }

    Map<String, List<Map>> loadSynthesizedGates(Path workspaceDir) {
        String text = readGatesText(workspaceDir);                                                   // src: vvaharness/validation/io/_host_score.py:80
        if (text == null) return new Map();                                                          // src: vvaharness/validation/io/_host_score.py:81
        List<Object> data = parseGatesArray(text);                                                   // src: vvaharness/validation/io/_host_score.py:83
        if (data == null) return new Map();                                                          // src: vvaharness/validation/io/_host_score.py:84
        return gatesByTrackingId(data);                                                              // src: vvaharness/validation/io/_host_score.py:86
    }

    Narrative narrative(OutputFinding f) {
        if (f == null) return new Narrative(List.of(), List.of(), "");                               // src: vvaharness/validation/io/_host_score.py:99
        return new Narrative(f.conditionsForFullFix, f.recommendations, f.justification != null ? f.justification : ""); // agent prose kept  // src: vvaharness/validation/io/_host_score.py:101
    }

    Verdict conformant(Verdict verdict, ScoringPolicy policy, Theta θ) {
        if (policy == null) return verdict;                                                          // src: vvaharness/validation/io/_host_score.py:110
        List<String> missing = policy.missingFrom(verdict.gates.map(g -> g.name));                   // src: vvaharness/validation/io/_host_score.py:112
        if (missing.isEmpty()) return verdict;                                                       // src: vvaharness/validation/io/_host_score.py:113
        if (!θ["code.validation.io._host_score.missing_required_gate_inconclusive"]) return verdict;
        return verdict.copy(Decision.INCONCLUSIVE, null, "verdict does not answer required gate(s): " + missing + "; not scored"); // src: vvaharness/validation/io/_host_score.py:115
    }

    Verdict verdictFor(OutputFinding outputFinding, List<Map> gates, Provenance provenance, ScoringPolicy policy) {
        Narrative said = narrative(outputFinding);                                                   // src: vvaharness/validation/io/_host_score.py:131
        if (gates == null || gates.isEmpty()) {                                                      // src: vvaharness/validation/io/_host_score.py:132
            return new Verdict(Decision.INCONCLUSIVE, NO_GATES, null, List.of(), said.conditions, said.recommendations, said.rationale, provenance); // src: vvaharness/validation/io/_host_score.py:133
        }
        Scored scored = ValidationScoring.scoreFix(gates, policy);                                   // src: vvaharness/validation/io/_host_score.py:142
        Double score = scored.decision == Decision.INCONCLUSIVE ? null : scored.rawScore;            // refusal = no number, not zero  // src: vvaharness/validation/io/_host_score.py:147
        return new Verdict(scored.decision, scored.justification, score, scored.gates, said.conditions, said.recommendations, said.rationale, provenance); // src: vvaharness/validation/io/_host_score.py:143
    }
}

@executedBy(CODE) @role(types)
record Narrative(List<String> conditions, List<String> recommendations, String rationale) { }
