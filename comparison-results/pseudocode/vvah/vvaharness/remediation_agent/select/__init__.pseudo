// file: vvaharness/remediation_agent/select/__init__.py
// Facade for the shared "top N by CVSS" selection (pq.py + topspec.py), used by both remediation entry points.

@executedBy(CODE) @role(step) @stage("S10")
class Select {

    double bandScore(String severity) {
        return Topspec.bandScore(severity);                                                         // src: vvaharness/remediation_agent/select/__init__.py:19
    }

    List<Finding> dropNonMainChannel(List<Finding> items) {
        return Topspec.dropNonMainChannel(items);                                                   // src: vvaharness/remediation_agent/select/__init__.py:20
    }

    List<Finding> selectTopByCvss(List<Finding> items, Integer n) {
        return Topspec.selectTopByCvss(items, n);                                                   // src: vvaharness/remediation_agent/select/__init__.py:21
    }

    List<Finding> selectTopLogged(List<Finding> items, Integer n) {
        // unclear: select_top_logged (pq.py) is not rendered in the pass-1 Topspec file; same selection plus a log line.
        return Topspec.selectTopByCvss(items, n);                                                   // src: vvaharness/remediation_agent/select/__init__.py:22
    }

    Object coerceTopValue(String raw) {
        return Topspec.coerceTopValue(raw);                                                         // src: vvaharness/remediation_agent/select/__init__.py:26
    }

    Object parseTopArg(List<String> args) {
        // unclear: parse_top_arg (topspec.py) is not rendered in the pass-1 Topspec file; reads --top N / --top=N and coerces.
        int i = args.indexOf("--top");
        if (i >= 0 && i + 1 < args.size()) return Topspec.coerceTopValue(args.get(i + 1));         // src: vvaharness/remediation_agent/select/__init__.py:28
        return null;
    }

    Integer resolveTop(Object cliTop, Object cfgTopN) {
        return Topspec.resolveTop(cliTop, cfgTopN);                                                 // src: vvaharness/remediation_agent/select/__init__.py:29
    }
}
