# vvaharness/backends/harness/permission_rules.py

The path predicate behind the Write permission: a write is allowed only to an allow-listed file name sitting directly in the target directory.

Source: `vvaharness/backends/harness/permission_rules.py` (lines 1-72)
Executor: code
Called from: `permissions.py` PermissionsPolicy.evaluate

// src: vvaharness/backends/harness/permission_rules.py:53-69
fn evaluate_write(input_data, resolved_target, allowed_output_files):executor=code {
  resolved = _resolve_write_path(input_data, resolved_target)
  if (environment variable VVAHARNESS_DEBUG is set) log "[s11-writegate] raw=... resolved=... target=..."   // abstracted: debug output only
  require resolved != null => return PermissionDecision(false, "Write path missing or unresolvable", interrupt=true)
  require _under_target(resolved, resolved_target) && resolved.name in allowed_output_files
    => return PermissionDecision(false, "Write to disallowed path: $resolved", interrupt=true)
  return PermissionDecision(true)
}

// src: vvaharness/backends/harness/permission_rules.py:32-45
fn _resolve_write_path(input_data, resolved_target):executor=code {
  raw = input_data.file_path
  if (raw is not a non-empty string) return null
  candidate = if (raw is absolute) raw else resolved_target / raw   // a relative path is anchored under the target
  try return candidate fully resolved (symbolic links followed)
  catch ValueError or OSError => return null
}

// src: vvaharness/backends/harness/permission_rules.py:48-50
fn _under_target(resolved, resolved_target):executor=code {
  return normcase(parent directory of resolved) == normcase(resolved_target)   // directly in the target, not in a subdirectory; case-insensitive where the platform is
}
