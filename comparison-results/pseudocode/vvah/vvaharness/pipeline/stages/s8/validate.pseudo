// file: vvaharness/pipeline/stages/s8/validate.py
// Deterministic chain checks for S8: one-code-fact collapse, citation resolution, link coverage,
// hardening steps, quality annotations, the severity lift gate, chain dedup, unpromoted links.

@executedBy(CODE) @role(rule_set) @stage("S8")
class S8Validate {

    Pair locationKey(List<RankedFinding> ranked, int step) {
        // Not line_end (defaults 0, s6 rewrites it).
        return Pair.of(ranked[step].finding.file, ranked[step].finding.lineStart);              // src: vvaharness/pipeline/stages/s8/validate.py:43
    }

    Pair collapseSameLocation(List<Integer> steps, List<RankedFinding> ranked) {
        Set seen = new Set();
        List<Integer> kept = new List();
        for (int s : steps) {                                                                   // src: vvaharness/pipeline/stages/s8/validate.py:50
            if (seen.contains(locationKey(ranked, s))) continue;
            seen.add(locationKey(ranked, s));
            kept.add(s);
        }
        return Pair.of(kept, steps.size() - kept.size());
    }

    Triple resolvedCitation(String repoRoot, String file, int line) {
        // The citation as given, or one unpacked spelling (file:LINE packed in the path, URL path) that resolves.
        if (resolveCitation(repoRoot, file, line)) return Triple.of(true, file, line);          // src: vvaharness/pipeline/stages/s8/validate.py:112
        Pair u = unpackedCitation(file, line);
        return Triple.of(resolveCitation(repoRoot, u.file, u.line), u.file, u.line);
    }

    boolean resolveCitation(String repoRoot, String file, int line) {
        // A real line of a real file inside the repo.
        return line >= 1 && Repo.isFileWithin(repoRoot, file) && line <= Repo.lineCount(repoRoot, file); // src: vvaharness/pipeline/stages/s8/validate.py:60
    }

    Triple linkOk(List<LinkEvidence> links, List<Integer> steps, String repoRoot) {
        int hops = max(steps.size() - 1, 0);                                                    // src: vvaharness/pipeline/stages/s8/validate.py:130
        int resolved = links.count(ln -> resolvedCitation(repoRoot, ln.file, ln.line).ok);      // src: vvaharness/pipeline/stages/s8/validate.py:132
        return Triple.of(links.size() >= hops && resolved == links.size(), resolved, hops);     // src: vvaharness/pipeline/stages/s8/validate.py:134
    }

    Pair annotateHedges(String narrative) {
        // A narrative that hedges ("may", "could", bundle-not-sequence) gets a note and blocks the lift.
        boolean hedged = Regex.search(HEDGE_RX, narrative);                                     // src: vvaharness/pipeline/stages/s8/validate.py:178
        return Pair.of(hedged ? narrative + "\n\n" + HEDGE_NOTE : narrative, hedged);
    }

    List<Integer> hardeningSteps(List<Integer> steps, List<RankedFinding> ranked) {
        // NON-TERMINAL stamped control absences; the terminal step is exempt.
        return range(steps.size() - 1).filter(i -> ranked[steps[i]].finding.controlAbsence);   // src: vvaharness/pipeline/stages/s8/validate.py:192
    }

    List<String> qualityAnnotations(ChainEntry chain, List<Integer> steps, List<RankedFinding> ranked, String repoRoot, boolean linksOk, int resolved, int hops, List<Integer> hardening) {
        List<String> out = new List();
        if (!hardening.isEmpty()) out.add(HARDENING_NOTE);                                      // src: vvaharness/pipeline/stages/s8/validate.py:282
        if (!linksOk) out.add(resolved + " of " + hops + " hops carry a resolving citation");   // src: vvaharness/pipeline/stages/s8/validate.py:287
        if (!citedCommentLines(chain.linkEvidence, repoRoot).isEmpty()) out.add(COMMENT_CITATION_NOTE); // src: vvaharness/pipeline/stages/s8/validate.py:295
        String term = titleDivergence(chain.title, steps, ranked);
        if (!term.isEmpty()) out.add("The chain title names a weakness none of its steps covers"); // src: vvaharness/pipeline/stages/s8/validate.py:302
        return out;
    }

    boolean liftAllowed(boolean linksOk, List<Integer> hardening, boolean hedged) {
        // Never lowers, only withholds a severity above what the chain was rated.
        return linksOk && hardening.isEmpty() && !hedged;                                       // src: vvaharness/pipeline/stages/s8/validate.py:312
    }

    Triple dedupChains(List<Chain> chains) {
        // Merge identical ordered step lists (strongest, best-evidenced survives); relate chains sharing a terminal step.
        Map best = new Map();
        for (int i : range(chains.size())) {                                                    // src: vvaharness/pipeline/stages/s8/validate.py:328
            Integer first = best.get(chains[i].steps);
            if (first == null || survivorKey(chains[i]) < survivorKey(chains[first])) best.put(chains[i].steps, i); // src: vvaharness/pipeline/stages/s8/validate.py:331
        }
        List<Chain> kept = sorted(best.values()).map(i -> chains[i]);
        List related = pairs(kept).filter(ab -> ab.a.steps.last() == ab.b.steps.last() && ab.a.steps[0] != ab.b.steps[0]); // src: vvaharness/pipeline/stages/s8/validate.py:340
        return Triple.of(kept, chains.size() - kept.size(), related);
    }

    List unpromotedLinks(Set claims, List<Chain> chains, List<RankedFinding> ranked) {
        // feeds claims no shipped chain carries, compared by code location and direction.
        Set covered = chains.flatMap(c -> orderedPairs(c.steps)).map(ab -> Pair.of(locationKey(ranked, ab.a), locationKey(ranked, ab.b))); // src: vvaharness/pipeline/stages/s8/validate.py:354
        return claims.filter(ot -> locationKey(ranked, ot.o) != locationKey(ranked, ot.t) && !covered.contains(Pair.of(locationKey(ranked, ot.o), locationKey(ranked, ot.t)))); // src: vvaharness/pipeline/stages/s8/validate.py:358
    }
}
