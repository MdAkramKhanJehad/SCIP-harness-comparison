# vvaharness/backends/llm/cli/envelope.py

Reads the JSON envelope `claude -p --output-format json|stream-json` prints: detects the content-guardrail canned refusal and model refusals, extracts the reply text (structured output first), token usage, cost and turn count, and stitches a reply the CLI split across turns.

Source: `vvaharness/backends/llm/cli/envelope.py` (lines 1-265)
Executor: code
Called from: `cli/oneshot.sudo` `prompt`, `cli/session.sudo` `agentic` and `_finalize_via_resume`, `cli/retry.sudo` `_run_with_retry`, `cli_mcp.sudo` `_run`; `parse_json_response` is re-exported through `registry.sudo`

// src: vvaharness/backends/llm/cli/envelope.py:43-60
_GUARDRAIL_REFUSALS = { "Your request was not allowed" }   // exact match only, avoiding false positives
fn _check_guardrail(env):executor=code {
  text = env.result
  if (text is a string && trimmed text in _GUARDRAIL_REFUSALS && (env.num_turns || 1) <= 1 && !env.is_error) {
    throw GuardrailBlocked("content-guardrail blocked this prompt (...). The classifier on api.anthropic.com is rejecting the prompt content — this is NOT a pipeline bug. ")
  }
}

// src: vvaharness/backends/llm/cli/envelope.py:63-88
fn _spend_of(event):executor=code { return [num_turns if an integer else null, total_cost_usd as a number else null] }
fn _structured_text(event):executor=code {
  payload = event.structured_output
  if (payload is not a dict or list) return null
  try return JSON serialization of payload; catch TypeError or ValueError => return null   // falls back to `result`
}
fn _telemetry_of(event):executor=code { return [stop_reason if a string else null, modelUsage if a dict else null] }   // read from the terminal event only; streamed events report stop_reason null

// src: vvaharness/backends/llm/cli/envelope.py:91-114
fn _decode_stream(stdout):executor=code {
  try return JSON of the whole stdout
  catch => return every line that parses as JSON (blank and malformed lines skipped), or null when none parse
}
fn _stream_events(stdout):executor=code { return every dict in _decode_stream(stdout), flattening one level of lists }

// src: vvaharness/backends/llm/cli/envelope.py:117-131
fn _refusal_category_of(stdout):executor=code {
  // Structured keys only, never the wording; only runs when the terminal stop_reason is a refusal
  events = _stream_events(stdout)
  refused = messages of "assistant" events whose message.stop_reason == ANTHROPIC_STOP_REFUSAL   // "refusal"
  category = if (refused) models.refusal_category(last of refused) else null
  if (category != null) return category
  return apiRefusalCategory of the last "system" event with subtype "model_refusal_no_fallback", if a string, else null
}

// src: vvaharness/backends/llm/cli/envelope.py:134-140
fn _raise_if_refused(stop_reason, tag, stdout):executor=code {
  // callers bank token usage first
  require stop_reason != ANTHROPIC_STOP_REFUSAL => throw model_refusal(route="cli", stage=tag || "", category=_refusal_category_of(stdout))
}

// src: vvaharness/backends/llm/cli/envelope.py:143-155
fn _raise_if_refused_exit(stdout, tag):executor=code {
  try env_res = _parse_envelope(stdout); catch any error => return   // best effort: the caller reports the exit
  if (env_res.stop_reason != ANTHROPIC_STOP_REFUSAL) return
  _note_unparsed_cache_keys(env_res.usage)
  TOKENS.add(env_res.usage, usd=env_res.usd, turns=env_res.turns)
  _raise_if_refused(env_res.stop_reason, tag, stdout)
  // Limitation stated in the source: assumes a refused non-zero exit still emits a "refusal" envelope
}

// src: vvaharness/backends/llm/cli/envelope.py:158-184
fn _stitch_continuation(events, result_text, turns, tag):executor=code {
  // TRAP (2.1.270): `result` holds only the LAST turn of a split reply; used in prompt mode only
  if (!turns || turns <= 1) return result_text
  stitched = all assistant text blocks across events, in order, concatenated and trimmed   // _assistant_text
  body = trimmed result_text
  if (!stitched || !body || stitched == body || !(stitched ends with body)) return result_text   // not a recognisable continuation tail
  COUNTERS.bump(CLI_CONTINUED_REPLIES_COUNTER); warn CLI_REPLY_SPLIT_ACROSS_TURNS
  return stitched
}

// src: vvaharness/backends/llm/cli/envelope.py:187-239
fn _parse_envelope(stdout, stitch_continuations=false, tag?):executor=code {
  env = _decode_stream(stdout)
  if (env == null) return EnvelopeResult(trimmed stdout, usage=null)   // not JSON at all: raw text is the reply
  if (env is a list) {
    result_evt = last event with type "result", or null
    if (result_evt) _check_guardrail(result_evt)
    text = _structured_text(result_evt) || result_evt.result   // structured output wins over result text
    if (text is not a non-blank string) {
      text = text blocks of the last "assistant" event, concatenated   // "" when none: a clean degrade, never the raw envelope
    }
    [turns, usd] = _spend_of(result_evt); [stop_reason, model_usage] = _telemetry_of(result_evt)
    text = trimmed text
    if (stitch_continuations) text = _stitch_continuation(env, text, turns, tag)
    return EnvelopeResult(text, result_evt.usage if a dict else null, turns, usd, stop_reason, model_usage)
  }
  if (env is not a dict) return EnvelopeResult(trimmed stdout, null)
  _check_guardrail(env)
  result = _structured_text(env) || env.result
  if (result is not a string) result = ""   // valid envelope without a string result reads as empty, not as the raw envelope
  return EnvelopeResult(trimmed result, env.usage if a dict else null, turns, usd, stop_reason, model_usage)   // no stitching on the single-dict shape
}

// src: vvaharness/backends/llm/cli/envelope.py:242-247
_PARSED_USAGE_CACHE_KEYS = cache.ANTHROPIC_PARSED_CACHE_KEYS
fn _note_unparsed_cache_keys(usage):executor=code { cache.note_unparsed_cache_keys(usage, via="cli") }

// src: vvaharness/backends/llm/cli/envelope.py:252-265
fn parse_json_response(text):executor=code {
  try {
    envelope = JSON of text
    if (envelope is a dict with key "result") {
      return if (envelope.result is a string) JSON of envelope.result else envelope.result   // a non-JSON string result raises and falls to extract_json below
    }
    return envelope
  }
  catch JSONDecodeError or TypeError => return util.json_extract.extract_json(text)   // external to this batch: tolerant JSON salvage
}
