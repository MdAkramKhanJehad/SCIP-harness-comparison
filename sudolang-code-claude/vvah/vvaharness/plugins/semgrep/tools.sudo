# vvaharness/plugins/semgrep/tools.py

Four read-only graph tools over the Semgrep subgraph the enricher attached to the code graph. Every query is capped, and a failed query returns an error dictionary saying the Semgrep subgraph is absent.

Source: `vvaharness/plugins/semgrep/tools.py` (lines 1-123)
Executor: code (the tools run as code when a model invokes them)
Called from: `vvaharness/plugins/semgrep/plugin.py` (Contribution.graph_tools, registered through `vvaharness/codegraph/tools.py` register_graph_tools); `triage.py` (tool names)

// src: vvaharness/plugins/semgrep/tools.py:22-23
_MAX_ROWS = 25          // preserved: declared but not referenced; the queries hard-code LIMIT 25 / 40 / 1
_MAX_TRACE_STEPS = 40   // preserved: declared but not referenced

// src: vvaharness/plugins/semgrep/tools.py:25-58
_FINDINGS_FOR_FILE = "MATCH (subject)-[:FLAGGED_BY]->(f:SemgrepFinding)-[:DETECTED_BY]->(r:SemgrepRule) WHERE f.filePath = $file RETURN ruleId, path, line (semgrepStartLine), severity, symbol, cweIds, classes ORDER BY line, ruleId LIMIT 25"
_TRACE_FOR_RULE = "MATCH (f:SemgrepFinding)-[trace:TRACE_TOUCHES]->(symbol) WHERE f.ruleId = $rule_id RETURN ruleId, step, role, path, line, symbol ORDER BY step LIMIT 40"
_CALLERS_OF_FLAGGED_SINKS = "MATCH (f:SemgrepFinding)-[trace:TRACE_TOUCHES]->(sink)<-[:CALLS]-(caller) WHERE trace.role = 'sink' AND f.filePath = $file RETURN ruleId, sink, caller, callerPath ORDER BY sink, caller LIMIT 25"
_SCAN_COVERAGE = "MATCH (s:SemgrepScan) RETURN complete, findings (findingCount), errors (errorCount), skipped (skippedCount) LIMIT 1"

// src: vvaharness/plugins/semgrep/tools.py:61-67
fn _rows(gtx, query, params):executor=code {
  try return rows of gtx.handle.graph.cypher(query, params) as dicts;
  catch error => return [{ error: "<ErrorType>: <message>", hint: "no Semgrep subgraph in this scan; the enricher did not run" }]
}
// preserved: unlike the built-in graph tools, these are not wrapped by _counted, so they bump no graph_tool_result_* counter

// src: vvaharness/plugins/semgrep/tools.py:70-78
GraphSemgrepFindings {
  description: "Semgrep findings on *file*, each with its rule id, severity, enclosing symbol, and the rule's CWE ids. Empty means Semgrep flagged nothing here, which is not proof the file is safe."
  fn GraphSemgrepFindings(file):executor=code { return _rows(gtx, _FINDINGS_FOR_FILE, { file }) }
}

// src: vvaharness/plugins/semgrep/tools.py:81-89
GraphSemgrepTaintTrace {
  description: "Ordered taint steps for findings of *rule_id*, each step carrying an explicit role of source, intermediate or sink. Semgrep reports representative routes, not every route, and an empty result means it recorded no explicit trace rather than that no flow exists."
  fn GraphSemgrepTaintTrace(rule_id):executor=code { return _rows(gtx, _TRACE_FOR_RULE, { rule_id }) }
}

// src: vvaharness/plugins/semgrep/tools.py:92-100
GraphSemgrepSinkCallers {
  description: "Functions that call a Semgrep-traced sink in *file* — the reachability question a finding alone cannot answer. An empty caller list means nothing in the graph reaches that sink, so it is an entry point or unreachable."
  fn GraphSemgrepSinkCallers(file):executor=code { return _rows(gtx, _CALLERS_OF_FLAGGED_SINKS, { file }) }
}

// src: vvaharness/plugins/semgrep/tools.py:103-111
GraphSemgrepCoverage {
  description: "Whether this repository's Semgrep scan was complete, with its finding, error and skip counts. A complete scan means no represented coverage loss; it is not a security assurance."
  fn GraphSemgrepCoverage():executor=code { return _rows(gtx, _SCAN_COVERAGE, {}) }
}

// src: vvaharness/plugins/semgrep/tools.py:114-121
SEMGREP_TOOLS = { GraphSemgrepFindings, GraphSemgrepTaintTrace, GraphSemgrepSinkCallers, GraphSemgrepCoverage }
SEMGREP_TOOL_NAMES = keys of SEMGREP_TOOLS
