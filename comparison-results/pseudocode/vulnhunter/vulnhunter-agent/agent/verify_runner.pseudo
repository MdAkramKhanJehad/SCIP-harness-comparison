// file: vulnhunter-agent/agent/verify_runner.py, vulnhunter-agent/agent/config.py
// Verify mode SDK driver: build the /vulnhunt-fix-verify kickoff prompt, run one read-only session
// with a fixed tool set, then classify verify_disposition.json (disposition / empty / schema-invalid).

@executedBy(CODE) @role(agent) @stage("verify")
class VerifyRunner {

    List<String> allowedTools(Theta θ) {
        return θ["code.verify_tools"];                                                     // src: vulnhunter-agent/agent/verify_runner.py:75
    }

    // VerifyConfig: verify-mode bounds and allow-lists (scratch dir, clone timeout, repo_aliases,
    // allowed_clone_hosts, token_path_prefixes, max_comment_pages, max_timeline_bytes, max_event_pages, max_edit_*_bytes)
    VerifyConfig verifyConfig(Theta θ) {
        return θ["verify.*"];                                                              // src: vulnhunter-agent/agent/config.py:262
    }

    String buildKickoffPrompt(Path repo, Path report, List<String> fixedIds, Path out, Path comments, List<Path> additionalRepos, Theta θ) {
        if (fixedIds.isEmpty()) throw new ValueError("fixed_ids must be a non-empty list of VULN-NNN strings"); // src: vulnhunter-agent/agent/verify_runner.py:135
        String fixedValue = θ["p.verify_runner.fixed_ids_comma_separated"] ? String.join(",", fixedIds) : fixedIds.toString(); // src: vulnhunter-agent/agent/verify_runner.py:137
        List<String> lines = new List();
        lines.add(θ["p.verify_runner.skill_invocation"]);                                  // src: vulnhunter-agent/agent/verify_runner.py:139
        lines.add("");
        lines.add("Arguments:");                                                           // src: vulnhunter-agent/agent/verify_runner.py:141
        List<String> args = θ["p.verify_runner.kickoff_argument_block"];                   // src: vulnhunter-agent/agent/verify_runner.py:142
        lines.add("  repo:     " + repo);
        lines.add("  report:   " + report);
        lines.add("  fixed:    " + fixedValue);
        lines.add("  out:      " + out);
        if (θ["p.verify_runner.comments_always_passed"]) lines.add("  comments: " + comments); // src: vulnhunter-agent/agent/verify_runner.py:146
        if (θ["p.verify_runner.additional_repos_line_conditional"] && additionalRepos != null && !additionalRepos.isEmpty()) { // src: vulnhunter-agent/agent/verify_runner.py:148
            lines.add("  additional_repos: " + String.join(",", additionalRepos));         // src: vulnhunter-agent/agent/verify_runner.py:150
        }
        lines.add("");
        return String.join("\n", lines);
    }

    VerifySessionResult classifyOutput(Path outDir) {
        Path disposition = outDir.resolve("verify_disposition.json");                      // src: vulnhunter-agent/agent/verify_runner.py:165
        if (disposition.isFile()) return loadAndValidate(disposition, "verify_disposition.schema.json", OutputKind.DISPOSITION); // src: vulnhunter-agent/agent/verify_runner.py:166
        return new VerifySessionResult(OutputKind.EMPTY, null, null, "verify_disposition.json did not appear"); // src: vulnhunter-agent/agent/verify_runner.py:172
    }

    VerifySessionResult loadAndValidate(Path path, String schemaFilename, OutputKind successKind) {
        Object payload;
        try {
            payload = json.loads(path.readText());                                         // src: vulnhunter-agent/agent/verify_runner.py:196
        } catch (JSONDecodeError e) {
            return new VerifySessionResult(OutputKind.SCHEMA_INVALID, path, null, "Could not parse"); // src: vulnhunter-agent/agent/verify_runner.py:198
        }
        Object schema;
        try {
            schema = json.loads(schemaRoot().resolve(schemaFilename).readText());          // src: vulnhunter-agent/agent/verify_runner.py:206
        } catch (OSError e) {
            return new VerifySessionResult(OutputKind.SCHEMA_INVALID, path, null, "Could not load schema"); // src: vulnhunter-agent/agent/verify_runner.py:208
        }
        List<Error> errors = Draft202012Validator(schema).iterErrors(payload).sorted();    // src: vulnhunter-agent/agent/verify_runner.py:215
        if (!errors.isEmpty()) return new VerifySessionResult(OutputKind.SCHEMA_INVALID, path, null, join(errors.take(5))); // src: vulnhunter-agent/agent/verify_runner.py:216
        return new VerifySessionResult(successKind, path, payload, "");                     // src: vulnhunter-agent/agent/verify_runner.py:229
    }

    VerifySessionResult runVerifySession(Theta θ, String authToken, Path cwd, Path outDir, String prompt, Path logPath, String modelOverride) {
        String model = modelOverride != null ? modelOverride : config.anthropic.model;    // src: vulnhunter-agent/agent/verify_runner.py:260
        String scanId = outDir.parent.name;
        Settings settings = BuildSettings.buildClaudeSettings(θ, authToken, model, scanId); // src: vulnhunter-agent/agent/verify_runner.py:263
        // locked allow-list; setting_sources = user only (cwd is the untrusted clone), skills = all
        AgentSpec spec = new AgentSpec(new ModelSpec(model, "sdk", null, null, 0), allowedTools(θ), List.of("vulnhunt-fix-verify"), null, prompt, null, null, false); // src: vulnhunter-agent/agent/verify_runner.py:266
        spec.permissionMode = config.scan.permissionMode;                                  // src: vulnhunter-agent/agent/verify_runner.py:272
        spec.settingSources = List.of("user");                                             // src: vulnhunter-agent/agent/verify_runner.py:284
        SessionTotals totals = new SessionTotals();
        try {
            for (Event event : Runtime.agent(spec).events()) {                             // src: vulnhunter-agent/agent/verify_runner.py:301
                logPath.append(eventSummary(event));                                       // src: vulnhunter-agent/agent/verify_runner.py:306
                dispatchEvent(event, totals, config.logging.perTurnUsage);                 // src: vulnhunter-agent/agent/verify_runner.py:312
            }
        } catch (Exception exc) {
            return new VerifySessionResult(OutputKind.EMPTY, null, null, "SDK session raised"); // src: vulnhunter-agent/agent/verify_runner.py:325
        }
        StreamEvents.logSessionTotals(totals, "Verify");                                   // src: vulnhunter-agent/agent/verify_runner.py:339
        return classifyOutput(outDir);                                                     // src: vulnhunter-agent/agent/verify_runner.py:340
    }

    void dispatchEvent(Event event, SessionTotals totals, boolean logPerTurnUsage) {
        // Task* are SystemMessage subtypes, so tested first (same order as runner)
        if (event instanceof TaskStartedMessage) StreamEvents.logTaskStarted(event);       // src: vulnhunter-agent/agent/verify_runner.py:381
        else if (event instanceof TaskUpdatedMessage || event instanceof TaskNotificationMessage) StreamEvents.logTaskStatus(event); // src: vulnhunter-agent/agent/verify_runner.py:391
        else if (event instanceof AssistantMessage) {
            if (logPerTurnUsage) StreamEvents.logPerTurnUsage(event);                      // src: vulnhunter-agent/agent/verify_runner.py:396
            StreamEvents.logAssistantMessage(event);
        }
        else if (event instanceof UserMessage) StreamEvents.logUserMessage(event);
        else if (event instanceof SystemMessage) StreamEvents.logSystemMessage(event);
        else if (event instanceof ResultMessage) { StreamEvents.logResult(event); StreamEvents.accumulateResult(totals, event); } // src: vulnhunter-agent/agent/verify_runner.py:408
    }

    String eventSummary(Event event) {
        if (event instanceof ResultMessage) return "ResultMessage is_error cost";          // src: vulnhunter-agent/agent/verify_runner.py:423
        return event.className();
    }
}
