# vvaharness/remediation_agent/policy/workflow_refs.py

Fail-closed validation of Stage 10 edits to reusable GitHub workflow references (`uses: owner/repo/.github/workflows/x.yml@ref`). A reference introduced by the attempt is accepted only when its ref is a full 40-character commit SHA that is not a placeholder and that already appeared for the same workflow in the pre-edit snapshot. Unsafe references that existed before the attempt are ignored.

Source: `vvaharness/remediation_agent/policy/workflow_refs.py` (lines 1-121)
Executor: code
Called from: `policy/postgate.sudo` enforce_post (introduced_unsafe_workflow_refs); `plugin_runner/run.sudo` _snapshot_targets (workflow_snapshot_paths)

// src: vvaharness/remediation_agent/policy/workflow_refs.py:25-31
_WORKFLOW_PREFIX = ".github/workflows/"
_FULL_SHA = /[0-9a-fA-F]{40}\Z/
_USES = /(?im)^\s*(?:-\s*)?uses\s*:\s*['"]?(?P<workflow>[^@\s'"#]+\/\.github\/workflows\/[^@\s'"#]+\.ya?ml)@(?P<ref>[^\s'"#]+)/

// src: vvaharness/remediation_agent/policy/workflow_refs.py:34-47
fn workflow_snapshot_paths(repo):executor=code {
  if ("$repo/.github/workflows/" is not a folder) return []
  try return sorted repository-relative paths of the files "*.yml" and "*.yaml" directly in that folder;   // not recursive
  catch OSError => return []
}

// src: vvaharness/remediation_agent/policy/workflow_refs.py:50-90
fn introduced_unsafe_workflow_refs(repo, before?):executor=code {
  snapshot = before or {}
  // src: workflow_refs.py:56-66 — trusted SHAs and prior reference counts come only from the PRE-EDIT snapshot
  for each [raw_path, text] in snapshot {
    path = artifacts.diff.paths._norm_path(raw_path)
    if (!_is_workflow_path(path) || text == null) continue
    prior[path] = counts of (workflow, ref) pairs in text
    for each [workflow, ref] in _references(text) { if (_is_nonplaceholder_sha(ref)) add casefold(ref) to trusted[casefold(workflow)] }
  }
  // src: workflow_refs.py:68-90
  current_paths = workflow_snapshot_paths(repo) union (snapshot paths that are workflow paths)
  issues = {}
  for each path in sorted current_paths {
    target = artifacts.diff.paths._safe_repo_path(repo, path)
    if (target == null) continue
    try current = text of target, or "" when it is not a file; catch OSError => continue
    for each [workflow, ref] occurrence in _references(current) {
      if (this occurrence count of (workflow, ref) <= prior[path] count) continue   // pre-existing occurrences are not this attempt's
      reason = _unsafe_reason(workflow, ref, trusted)
      if (reason) append "$workflow@$ref ($reason)" to issues[path]
    }
  }
  return issues   // { path: [messages] }
  // preserved: workflow files below sub-folders of .github/workflows/ are not listed by workflow_snapshot_paths, so a new file there is checked only if the snapshot named it
}

// src: vvaharness/remediation_agent/policy/workflow_refs.py:93-106
fn _references(text):executor=code { return every (workflow, ref) pair matched by _USES in text }
fn _is_workflow_path(path):executor=code { return casefold(path) starts with _WORKFLOW_PREFIX && ends with ".yml" or ".yaml" }
fn _is_nonplaceholder_sha(ref):executor=code { return ref fully matches _FULL_SHA && it has more than one distinct (case-folded) character }   // rejects "000...0"-style placeholders

// src: vvaharness/remediation_agent/policy/workflow_refs.py:109-118
fn _unsafe_reason(workflow, ref, trusted):executor=code {
  if (ref does not fully match _FULL_SHA) return "not an immutable 40-character commit SHA"
  if (!_is_nonplaceholder_sha(ref)) return "placeholder commit SHA"
  if (casefold(ref) not in trusted[casefold(workflow)]) return "commit SHA is not established by the pre-edit repository"
  return ""
}
