// src: vvaharness/validation/models/results.py:89-100
fn gate_score_rows(verdict, config):executor=code {
  for each gate in verdict.gates:
    rows[gate.name] = { status, weight: config.weights[gate.name] or, when absent, 0.0, weighted_score: round(weight * (config.status_multiplier[status] or, when absent, 0.0), 4) }
  return rows
}

// src: vvaharness/validation/models/results.py:103-109
_ANSWER_COLUMNS = { FIXED: ["Yes","No","No"], PARTIALLY_FIXED: ["No","Yes","No"], NOT_FIXED: ["No","No","Yes"], INCONCLUSIVE: ["?","?","?"] }

// src: vvaharness/validation/models/results.py:112-140
fn render_row(verdict, output_finding, finding_number, gate_scores_json="", policy?):executor=code {
  [fixed, partially, not_fixed] = _ANSWER_COLUMNS[verdict.decision]
  score = verdict.score or, when absent, 0.0
  return ValidationResult {
    finding_number, tracking_id: output_finding.tracking_id, finding_title: output_finding.finding_title,
    finding_description: output_finding.finding_description, affected_files: output_finding.affected_files,
    fixed, partially_fixed: partially, not_fixed,
    files_needing_fixes: if (output_finding.conditions_for_full_fix) join(it, "; ") else output_finding.files_needing_fixes,
    reason_for_decision: "${ verdict.decision.value } (score: $score). ${ verdict.rationale }",
    severity: output_finding.severity,
    pr_merge_readiness: merge_readiness_for(verdict, policy).value,
    recommendations: join(verdict.recommendations, "; "),
    fix_confidence: score, gate_results_json: gate_scores_json, justification: verdict.rationale
  }
}
// merge_readiness_for (vvaharness/models/derive.py:113-122): the lowest of the decision's ceiling
// (FIXED: ready, PARTIALLY_FIXED: ready_with_conditions, NOT_FIXED and INCONCLUSIVE: not_ready), ready_with_conditions when the verdict has conditions,
// and, when a score exists, the score band (>= policy.ready_at ready, >= policy.conditional_at ready_with_conditions, else not_ready).
// With FIX_POLICY the bands are 0.80 and 0.50; with policy null the default ScoringPolicy is used (ready_at default 0.85, vvaharness/models/context.py:36).

// src: vvaharness/validation/models/results.py:150-169
fn unverifiable_row(tracking_id, title, reason, finding_number=0):executor=code {
  return ValidationResult { tracking_id, title, fixed/partially_fixed/not_fixed: "?", reason_for_decision: "INCONCLUSIVE: $reason",
    severity: "medium", pr_merge_readiness: "not_ready", recommendations: "Manual review required: $reason", fix_confidence: 0.0, other fields "" }
  // "confidence 0.0, column can't hold \"no number\""; pr_merge_readiness is explicitly not_ready, "not blank"
}
