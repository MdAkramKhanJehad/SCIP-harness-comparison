// file: vvaharness/remediation_agent/policy/patch_content.py
// Fail-closed regex scan of the lines an S10 patch ADDED (CWE-1427): rejects backdoors, dynamic code execution,
// network egress, credential reads and reverse shells that path gates and the agent's self-report cannot see.

@executedBy(CODE) @role(types)
record ContentRule(String label, String reason, List<Regex> patterns) { }

@executedBy(CODE) @role(rule_set) @stage("S10")
class PatchContent {

    List<ContentRule> rules(Theta θ) {
        // Narrow on purpose: reject a backdoor, not any mention of auth. First matching category wins per line.
        return List.of(
            // credential-ish name compared == to a string literal; backdoor/master_key/skip_auth/allow_all sentinels;
            // is_admin/verify/authorize(...) rewritten to return True; verify/ssl_verify/rejectUnauthorized = False; CERT_NONE / InsecureSkipVerify: true
            new ContentRule("auth_bypass", "introduces an authentication/authorization short-circuit", θ["code.remediation_agent.policy.patch_content.auth_bypass_patterns"]), // src: vvaharness/remediation_agent/policy/patch_content.py:33
            // eval/exec/compile(; os.system, subprocess.*, child_process.*, Runtime.exec, ProcessBuilder, shell_exec, popen, system(;
            // new Function(; pickle.load(s)/non-Safe yaml.load; __import__/importlib.import_module; setTimeout with a string
            new ContentRule("code_execution", "introduces dynamic code execution", θ["code.remediation_agent.policy.patch_content.code_execution_patterns"]), // src: vvaharness/remediation_agent/policy/patch_content.py:65
            // requests/urllib/httpx/http.client/aiohttp/fetch/axios/XMLHttpRequest/WebSocket/socket calls; curl/wget/nc to a URL or IP.
            // Deliberately NO bare URL/IP literal pattern: egress is a call, not a literal.
            new ContentRule("network_egress", "introduces outbound network access", θ["code.remediation_agent.policy.patch_content.network_egress_patterns"]), // src: vvaharness/remediation_agent/policy/patch_content.py:85
            // open/read_text/readFile/cat of .ssh/.aws/id_rsa/.pem/.env/credentials/shadow/passwd; os.environ SECRET/TOKEN/PASSWORD/API_KEY;
            // base64 decode / atob of a 24+ char literal
            new ContentRule("credential_exfiltration", "reads credentials or secret material into a new code path", θ["code.remediation_agent.policy.patch_content.credential_exfiltration_patterns"]), // src: vvaharness/remediation_agent/policy/patch_content.py:107
            // /bin/sh|bash|cmd.exe|powershell with -i/-c/-nop/-enc; pty.spawn, dup2; nc -l, bash -i redirect
            new ContentRule("reverse_shell", "introduces a reverse shell or interactive listener", θ["code.remediation_agent.policy.patch_content.reverse_shell_patterns"]) // src: vvaharness/remediation_agent/policy/patch_content.py:123
        );
    }

    boolean isCommentOnly(String text, Theta θ) {
        // Leaders: # // /* * <!-- -- ; % triple-quotes rem. An injected payload must become code to act.
        return θ["code.remediation_agent.policy.patch_content.skip_comment_only_lines"] && Regex.match("^\\s*(comment leader)", text); // src: vvaharness/remediation_agent/policy/patch_content.py:137
    }

    boolean isProseString(String text, Theta θ) {
        // Whole line is one string literal whose body contains a space: describes a construct, does not perform it.
        if (!θ["code.remediation_agent.policy.patch_content.skip_prose_string_lines"]) return false;
        Match m = Regex.match("^ punct* prefix? quote body quote punct* $", text.strip());           // src: vvaharness/remediation_agent/policy/patch_content.py:169
        return m != null && m.group("body").contains(" ");                                          // src: vvaharness/remediation_agent/policy/patch_content.py:170
    }

    Map<String, List<Pair<Integer, String>>> addedLinesByFile(String diffText) {
        if (diffText == null || diffText.isEmpty()) return Map.of();                                // src: vvaharness/remediation_agent/policy/patch_content.py:185
        Map<String, List<Pair<Integer, String>>> out = new Map();
        String current = null;
        int counter = 0;
        for (String raw : diffText.splitlines()) {                                                  // src: vvaharness/remediation_agent/policy/patch_content.py:190
            Match m = Regex.match("^diff --git a/<a> b/<b>", raw);                                 // src: vvaharness/remediation_agent/policy/patch_content.py:191
            if (m != null) {
                current = m.group("b") != null ? m.group("b").strip() : m.group("a").strip();       // src: vvaharness/remediation_agent/policy/patch_content.py:193
                counter = 0;
                continue;
            }
            m = Regex.match("^+++ (b/)?<path>", raw);                                               // src: vvaharness/remediation_agent/policy/patch_content.py:196
            if (m != null) {
                String path = m.group("path").strip();
                current = path.equals("/dev/null") ? null : path;                                   // src: vvaharness/remediation_agent/policy/patch_content.py:199
                counter = 0;
                continue;
            }
            if (raw.startsWith("+++") || raw.startsWith("---") || raw.startsWith("@@ ")) continue;  // src: vvaharness/remediation_agent/policy/patch_content.py:202
            if (current != null && raw.startsWith("+")) {                                           // src: vvaharness/remediation_agent/policy/patch_content.py:204  (only added lines)
                counter = counter + 1;
                out.getOrPut(current, new List()).add(new Pair(counter, raw.substring(1)));         // src: vvaharness/remediation_agent/policy/patch_content.py:206
            }
        }
        return out;
    }

    boolean isExecutableSource(String path, Theta θ) {
        // Logs, reports, manifests and Markdown cannot execute; scanning them is noise.
        String suffix = Path.suffix(path != null ? path : "").lower();                              // src: vvaharness/remediation_agent/policy/patch_content.py:234
        return θ["code.remediation_agent.policy.patch_content.shell_exts"].contains(suffix) || !Frameworks.languageFor(path, θ).equals("default"); // src: vvaharness/remediation_agent/policy/patch_content.py:235
    }

    Map<String, List<String>> scanAddedLines(String diffText, List<String> onlyFiles, Theta θ) {
        Map<String, List<Pair<Integer, String>>> added;
        try {
            added = addedLinesByFile(diffText);                                                     // src: vvaharness/remediation_agent/policy/patch_content.py:249
        } catch (Exception e) {
            return Map.of();                                                                        // src: vvaharness/remediation_agent/policy/patch_content.py:251  (never breaks a run; empty = pass)
        }
        Set<String> allowed = onlyFiles != null ? onlyFiles.map(f -> fold(f)).toSet() : null;       // src: vvaharness/remediation_agent/policy/patch_content.py:252
        Map<String, List<String>> issues = new Map();
        for (String path : added.keys()) {                                                          // src: vvaharness/remediation_agent/policy/patch_content.py:254
            if (allowed != null && !allowed.contains(fold(path))) continue;                         // src: vvaharness/remediation_agent/policy/patch_content.py:255
            String folded = fold(path);
            // vvaharness/, security-scan/, security-remediation/ hold detector material by design.
            if (θ["code.remediation_agent.policy.patch_content.harness_owned_prefixes"].any(p -> folded.startsWith(p))) continue; // src: vvaharness/remediation_agent/policy/patch_content.py:258
            if (θ["code.remediation_agent.policy.patch_content.executable_sources_only"] && !isExecutableSource(path, θ)) continue; // src: vvaharness/remediation_agent/policy/patch_content.py:260
            for (Pair<Integer, String> ln : added.get(path)) {                                      // src: vvaharness/remediation_agent/policy/patch_content.py:262
                String text = ln.second;
                if (text.strip().isEmpty() || isCommentOnly(text, θ) || isProseString(text, θ)) continue; // src: vvaharness/remediation_agent/policy/patch_content.py:263
                for (ContentRule r : rules(θ)) {                                                    // src: vvaharness/remediation_agent/policy/patch_content.py:266
                    if (r.patterns.any(p -> p.search(text))) {                                      // src: vvaharness/remediation_agent/policy/patch_content.py:267
                        issues.getOrPut(path, new List()).add(r.label + ": " + r.reason + " (line " + ln.first + ": " + snippet(text, 120) + ")"); // src: vvaharness/remediation_agent/policy/patch_content.py:268
                        break;                                                                      // src: vvaharness/remediation_agent/policy/patch_content.py:270  (one category per line)
                    }
                }
            }
        }
        return issues;
    }

    List<String> undeclaredEditedFiles(String diffText, List<String> declared) {
        // Files the patch changed that the fixer dispatch never declared: shape of an injected backdoor.
        Map<String, List<Pair<Integer, String>>> touched;
        try {
            touched = addedLinesByFile(diffText);                                                   // src: vvaharness/remediation_agent/policy/patch_content.py:286
        } catch (Exception e) {
            return List.of();                                                                       // src: vvaharness/remediation_agent/policy/patch_content.py:288
        }
        Set<String> want = declared.filter(d -> d != null && !d.isEmpty()).map(d -> fold(d)).toSet(); // src: vvaharness/remediation_agent/policy/patch_content.py:289
        return touched.keys().filter(p -> !want.contains(fold(p))).sorted();                        // src: vvaharness/remediation_agent/policy/patch_content.py:290
    }

    String fold(String path) {
        return (path != null ? path : "").replace("\\", "/").lstrip("./").casefold();              // src: vvaharness/remediation_agent/policy/patch_content.py:294
    }

    String snippet(String text, int limit) {
        String flat = text.split().join(" ");                                                       // src: vvaharness/remediation_agent/policy/patch_content.py:299
        return flat.length() <= limit ? flat : flat.substring(0, limit - 1) + "...";                // src: vvaharness/remediation_agent/policy/patch_content.py:300
    }
}
