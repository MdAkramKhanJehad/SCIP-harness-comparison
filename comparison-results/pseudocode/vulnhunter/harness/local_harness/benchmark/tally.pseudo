// file: harness/local_harness/benchmark/tally.py
// Benchmark tally: detection rate (recall) overall and per vulnerability type from judge verdicts,
// plus cost/time/token aggregates; writes tally.json and BENCHMARK_REPORT.md.

@executedBy(CODE) @role(evaluation)
class BenchmarkTally {

    Tally generateTally(State state, Theta θ) {
        String metric = θ["harness.metric"];  // recall only; no precision / FP metric         // src: harness/local_harness/benchmark/tally.py:25
        Map byType = new Map();
        List<Row> findings = new List();
        for (Entry e : state.judgments) {                                                       // src: harness/local_harness/benchmark/tally.py:36
            Boolean detected = e.judgment.detected;
            String type = e.judgment.typeOr("Unknown");
            byType.get(type).total++;
            if (detected == true) byType.get(type).detected++;                                 // src: harness/local_harness/benchmark/tally.py:41
            else if (detected == false) byType.get(type).missed++;
            else byType.get(type).error++;  // judge error/timeouts counted separately
            findings.add(Row.of(e));
        }
        int total = findings.size();
        int det = findings.count(f -> f.detected == true);
        double detectionRate = total > 0 ? (double) det / total : 0.0;                         // src: harness/local_harness/benchmark/tally.py:64
        int scanFailures = state.scanTargets.count(t -> t.status == "scan_failed");            // src: harness/local_harness/benchmark/tally.py:66
        CostSummary cost = CostSummary.aggregate(state.scanTargets);                           // src: harness/local_harness/benchmark/tally.py:78
        return new Tally(state.model, total, det, detectionRate.round(4), scanFailures, byType, cost, findings.sortBy("benchmark_file", "finding_id")); // src: harness/local_harness/benchmark/tally.py:100
    }

    void writeTallyJson(Tally t) {
        LocalHarnessConfig.atomicWriteJson(TALLY_FILE, t);                                     // src: harness/local_harness/benchmark/tally.py:133
    }

    void writeTallyMarkdown(Tally t) {
        Fs.write(TALLY_REPORT, t.renderMarkdown());  // summary, per-type rate, per-finding table // src: harness/local_harness/benchmark/tally.py:137
    }
}
