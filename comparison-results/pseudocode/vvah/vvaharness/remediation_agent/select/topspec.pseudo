// file: vvaharness/remediation_agent/select/topspec.py, vvaharness/remediation_agent/select/pq.py
// Resolve the --top N cap (CLI flag wins over step_remediate.top_n_findings) and select the top N findings by CVSS.

@executedBy(CODE) @role(step) @stage("S10")
class Topspec {

    Object coerceTopValue(String raw) {
        if (raw.strip().lower() in List.of("all", "*")) return "all";                               // src: vvaharness/remediation_agent/select/topspec.py:29
        int n = Integer.parse(raw);                                                                 // src: vvaharness/remediation_agent/select/topspec.py:32
        if (n <= 0) throw new ValueError("must be a positive integer or all");                      // src: vvaharness/remediation_agent/select/topspec.py:37
        return n;
    }

    Integer resolveTop(Object cliTop, Object cfgTopN) {
        // cfgTopN: absent block -> null; garbage/0/negative in a profile -> wildcard (no cap).
        Object chosen = cliTop != null ? cliTop : cfgTopN;                                          // src: vvaharness/remediation_agent/select/topspec.py:79
        if (chosen instanceof Integer) return chosen;                                               // src: vvaharness/remediation_agent/select/topspec.py:80
        return null;                                                                                // src: vvaharness/remediation_agent/select/topspec.py:83  (no cap)
    }

    List<Finding> selectTopByCvss(List<Finding> items, Integer n) {
        if (n == null || n <= 0) return items;                                                      // src: vvaharness/remediation_agent/select/pq.py:50
        // Score = numeric CVSS, else band anchor (CRITICAL 9, HIGH 7, MEDIUM 4, LOW 1, INFO 0); index breaks ties.
        return items.sortedBy(it -> -(it.cvssScore != null ? it.cvssScore : bandScore(it.severity))).take(n); // src: vvaharness/remediation_agent/select/pq.py:62
    }

    double bandScore(String severity) {
        return Map.of("CRITICAL", 9.0, "HIGH", 7.0, "MEDIUM", 4.0, "LOW", 1.0, "INFO", 0.0).getOr(severity.upper(), 0.0); // src: vvaharness/remediation_agent/select/pq.py:39
    }

    List<Finding> dropNonMainChannel(List<Finding> items) {
        // Only channel == "posture" is dropped, before the top-N cap.
        return items.filter(it -> !it.channel.casefold().equals("posture"));                        // src: vvaharness/remediation_agent/select/pq.py:88
    }
}
