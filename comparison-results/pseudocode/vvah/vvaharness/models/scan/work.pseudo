// file: vvaharness/models/scan/work.py
// The work units S3 emits: one InvestigationUnit per threat (with its validated file surface, sinks, entry points,
// CVEs, CWEs), the TaskManifest holding them, and DupLocation (a dedup-collapsed site kept on a finding).

@executedBy(CODE) @role(types)
enum UnitSize { SMALL, MEDIUM, LARGE }
// SMALL fits one context, exhaustive; MEDIUM fits but tight; LARGE too big to inline (file list + sink hints, model Reads on demand)

@executedBy(CODE) @role(types)
record InvestigationUnit(String id, String threat, String surface, String actor, String asset, String impact, String likelihood,
                         String controls, String evidence, List<String> files, List<Sink> sinks, List<EntryPoint> entryPoints,
                         List<String> relatedCves, List<String> cwes, List<String> communities, int riskRank, UnitSize size,
                         List<String> languages) {
    // files: alias file_ids, the threat's whole validated surface, uncut                           // src: vvaharness/models/scan/work.py:63
    // cwes: union of sinks[].cwe = CweGuidance lookup keys; communities: cosmetic tool-arg annotation, not a splitter // src: vvaharness/models/scan/work.py:67
    // riskRank: 26 - impact*likelihood; 1 = highest risk                                          // src: vvaharness/models/scan/work.py:70

    UnitSize vSize(Object v) {
        // unknown / missing size -> MEDIUM; aliases xs/tiny/s -> small, m/med/normal/default -> medium, l/xl/big/huge -> large
        return Coerce.coerceEnum(v, UNIT_SIZES, θ["code.models.scan.work.unit_size_alias"], θ["code.models.scan.work.default_unit_size"]); // src: vvaharness/models/scan/work.py:77
    }

    int vRank(Object v) {
        return Coerce.coerceInt(v, θ["code.models.scan.work.default_risk_rank"]);  // unparsable rank sorts last // src: vvaharness/models/scan/work.py:82
    }

    List<String> vStrList(Object v, String field) {
        // files, related_cves, cwes, communities, languages
        return Coerce.coerceStrList(v, "InvestigationUnit." + field);                               // src: vvaharness/models/scan/work.py:88
    }
}

@executedBy(CODE) @role(types)
record TaskManifest(List<InvestigationUnit> units, List<String> unreachableFiles, List<String> threatsWithoutUnit) {
    // unreachableFiles: dropped by the ctx.all_files check, listed in the report appendix         // src: vvaharness/models/scan/work.py:94

    List<String> vUnreachableFiles(Object v) {
        return Coerce.coerceStrList(v, "TaskManifest.unreachable_files");                           // src: vvaharness/models/scan/work.py:101
    }

    List<String> vThreatsWithoutUnit(Object v) {
        return Coerce.coerceStrList(v, "TaskManifest.threats_without_unit");                        // src: vvaharness/models/scan/work.py:106
    }

    List<InvestigationUnit> sortedUnits() {
        return units.sortedBy(u -> u.riskRank);  // S4 consumes units in ascending risk rank        // src: vvaharness/models/scan/work.py:109
    }

    List<String> threatsWithoutUnitFor(ThreatModel tm) {
        // derived from the units: on --resume a re-run s2 may pair with a cached older manifest
        if (tm == null) return threatsWithoutUnit;                                                  // src: vvaharness/models/scan/work.py:116
        Set minted = units.map(u -> u.id);
        return tm.threatIds().filter(tid -> !minted.contains(Work.threatUnitId(tid)));              // src: vvaharness/models/scan/work.py:118
    }
}

@executedBy(CODE) @role(types)
record DupLocation(String file, int lineStart, int lineEnd, VulnClass vulnClass, String title, String chunkId,
                   String sourceRef, String sinkRef, String reasoning) { }

@executedBy(CODE) @role(types)
class Work {

    String threatUnitId(String threatId) {
        // collisions add -N in s3, so the bare id always exists
        return "threat-" + threatId.toLowerCase();                                                  // src: vvaharness/models/scan/work.py:48
    }
}
