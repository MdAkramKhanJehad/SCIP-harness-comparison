// file: vvaharness/backends/harness/permissions.py
// PermissionsPolicy: the deny-by-default permission gate for a validation (S11) session. Tool names come from
// the vocabulary in harness.models. TRAP: the SDK skips can_use_tool for bare-listed tools, so listing "Write"
// in allowed_tools would void evaluate_write.

@executedBy(CODE) @role(rule_set)
class Permissions {
    Path targetDir;
    // Deny-all writes by default; a consumer opts specific output filenames in.
    Set<String> allowedOutputFiles = Set.of();                                                           // src: vvaharness/backends/harness/permissions.py:44

    // Non-Write/Bash tools: Edit family denied, read/orchestration/MCP tools allowed, anything else denied.
    PermissionDecision evaluateSimple(String toolName, Theta θ) {
        if (HarnessModels.unconditionallyDeniedTools(θ).contains(toolName)) {                            // src: vvaharness/backends/harness/permissions.py:48
            return new PermissionDecision(false, "read-only validation session: Edit/NotebookEdit blocked", true); // src: vvaharness/backends/harness/permissions.py:49
        }
        if (HarnessModels.readOnlyTools(θ).contains(toolName) || toolName.startsWith(HarnessModels.mcpToolPrefix(θ))) { // src: vvaharness/backends/harness/permissions.py:52
            return new PermissionDecision(true, "", false);                                              // src: vvaharness/backends/harness/permissions.py:53
        }
        return new PermissionDecision(false, "tool not permitted in read-only validation session", true); // src: vvaharness/backends/harness/permissions.py:54
    }

    PermissionDecision evaluate(String toolName, Map<String, Object> inputData, Theta θ) {
        Path resolved = targetDir.resolve();                                                             // src: vvaharness/backends/harness/permissions.py:62
        if (toolName.equals("Write")) return PermissionRules.evaluateWrite(inputData, resolved, allowedOutputFiles); // src: vvaharness/backends/harness/permissions.py:63
        if (toolName.equals("Bash")) {                                                                   // src: vvaharness/backends/harness/permissions.py:65
            return new PermissionDecision(false, "Bash is disabled in validation sessions -- no shell execution permitted", true); // src: vvaharness/backends/harness/permissions.py:66
        }
        return evaluateSimple(toolName, θ);                                                              // src: vvaharness/backends/harness/permissions.py:71
    }
}
