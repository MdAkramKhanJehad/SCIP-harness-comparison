@executedBy(CODE) @role(types)
class CallTimeoutError {
    // VVAH-E008: also a TimeoutError so every except TimeoutError still catches it; non-halt.
    void init(String message, String stage, String route, Double budgetS, String effort) {
        String budget = budgetS != null ? budgetS + "s" : "unbounded";                                   // src: vvaharness/backends/harness/models.py:669
        String full = "[VVAH-E008] Call timed out | stage=" + stage + " | route=" + route + " | budget=" + budget + ": " + message + " -- raise the stage's timeout/ceiling knob or lower its effort"; // src: vvaharness/backends/harness/models.py:676
    }
}

