// file: vvaharness/detect/patterns.py, vvaharness/detect/__init__.py
// The default source/sink corpus S0 matches against source text, plus the declarative S5 detector rules.
// Every callee is a public, documented API defensible from CWE semantics; never benchmark-led.

@executedBy(CODE) @role(rule_set) @stage("S0")
class DetectPatterns {

    /** detect.scan: match the source/sink corpus against every listed file (S0 seed). */
    @src("vvaharness/detect/__init__.py:45")
    DetectResult scan(String repoRoot, List<String> relPaths, Theta θ) {
        List<Hit> hits = Matcher.scanFiles(repoRoot, relPaths, defaultCorpus(θ));             // src: vvaharness/detect/__init__.py:47
        return new DetectResult(Roles.hitsToEntryPoints(hits), Roles.hitsToSinks(hits), hits); // src: vvaharness/detect/__init__.py:48
    }

    // Hidden constants (read by the spec builders below)
    // _COMMAND_METHODS, _COMMAND_QUALIFIED, _SQL_METHODS, _DESERIALIZE_METHODS, _DESERIALIZE_MODULE_METHODS, _SOURCE_ACCESSORS

    /** _owasp: OWASP 2025 categories for a semantic family; unknown family falls back to A03 Injection. */
    @src("vvaharness/detect/patterns.py:24")
    Set<String> owasp(String family, Theta θ) {
        return Set.copyOf(RulesCwe.owasp2025BySemantic(θ).getOrDefault(family, List.of("A03:2025-Injection"))); // src: vvaharness/detect/patterns.py:25
    }

    /** _bare_call: name( not preceded by a word char or dot (rejects dot-qualified receivers by design). */
    @src("vvaharness/detect/patterns.py:28")
    String bareCall(String name) {
        return "(?<![\\w.])" + name + "\\s*\\(";                                                          // src: vvaharness/detect/patterns.py:29
    }

    /** _method_call: .name( */
    @src("vvaharness/detect/patterns.py:32")
    String methodCall(String name) {
        return "\\." + name + "\\s*\\(";                                                                  // src: vvaharness/detect/patterns.py:33
    }

    /** _qualified_call: module.name( at a word boundary. */
    @src("vvaharness/detect/patterns.py:36")
    String qualifiedCall(String module, String name) {
        return "\\b" + module + "\\." + name + "\\s*\\(";                                                  // src: vvaharness/detect/patterns.py:37
    }

    /** _command_specs: CWE-78 sinks, bare calls first then os/subprocess qualified calls. */
    @src("vvaharness/detect/patterns.py:97")
    List<MatchSpec> commandSpecs(Theta θ) {
        List<MatchSpec> specs = new List();
        for (String name : θ["code.detect.patterns.command_methods"]) {                                      // system, popen, spawn, exec, eval // src: vvaharness/detect/patterns.py:58
            specs.add(new MatchSpec("detect-sink-command-" + name, "sink", bareCall(name), "CWE-78", "command_injection", "command-exec", owasp("command-exec", θ))); // src: vvaharness/detect/patterns.py:99
        }
        for (Entry<String, List<String>> e : θ["code.detect.patterns.command_qualified"]) {                  // os: system; subprocess: run, call, check_output, check_call, Popen // src: vvaharness/detect/patterns.py:62
            for (String name : e.value) {
                specs.add(new MatchSpec("detect-sink-command-" + e.key + "-" + name, "sink", qualifiedCall(e.key, name), "CWE-78", "command_injection", "command-exec", owasp("command-exec", θ))); // src: vvaharness/detect/patterns.py:110
            }
        }
        return specs;                                                                                        // src: vvaharness/detect/patterns.py:123
    }

    /** _template_specs: a single CWE-79 sink, render_template_string. */
    @src("vvaharness/detect/patterns.py:126")
    List<MatchSpec> templateSpecs(Theta θ) {
        return List.of(new MatchSpec("detect-sink-template-render_template_string", "sink", bareCall("render_template_string"), "CWE-79", "xss", "html-response", owasp("html-response", θ))); // src: vvaharness/detect/patterns.py:128
    }

    /** _cookie_specs: two specs, one per CWE, because a MatchSpec holds one CWE; both ids must share the trailing segment (s0 reads it). No semantic family or OWASP set. */
    @src("vvaharness/detect/patterns.py:140")
    List<MatchSpec> cookieSpecs() {
        List<MatchSpec> specs = new List();
        for (Pair<String, String> fc : List.of(Pair.of("httponly", "CWE-1004"), Pair.of("secure", "CWE-614"))) { // src: vvaharness/detect/patterns.py:151
            specs.add(new MatchSpec("detect-sink-cookie-" + fc.first + "-set_cookie", "sink", methodCall("set_cookie"), fc.second, "cookie_flag")); // src: vvaharness/detect/patterns.py:144
        }
        return specs;
    }

    /** _sql_specs: CWE-89 sinks for .execute/.executemany/.raw/.query calls. */
    @src("vvaharness/detect/patterns.py:154")
    List<MatchSpec> sqlSpecs(Theta θ) {
        List<MatchSpec> specs = new List();
        for (String name : θ["code.detect.patterns.sql_methods"]) {                                          // src: vvaharness/detect/patterns.py:65
            specs.add(new MatchSpec("detect-sink-sql-" + name, "sink", methodCall(name), "CWE-89", "sql_injection", "sql-exec", owasp("sql-exec", θ))); // src: vvaharness/detect/patterns.py:157
        }
        return specs;
    }

    /** _deserialize_specs: CWE-502 sinks, bare calls first then pickle/yaml module-qualified calls. */
    @src("vvaharness/detect/patterns.py:169")
    List<MatchSpec> deserializeSpecs(Theta θ) {
        List<MatchSpec> specs = new List();
        for (String name : θ["code.detect.patterns.deserialize_methods"]) {                                  // loads, load, deserialize, unmarshal // src: vvaharness/detect/patterns.py:66
            specs.add(new MatchSpec("detect-sink-deser-" + name, "sink", bareCall(name), "CWE-502", "unsafe_deserialization", "deserialization", owasp("deserialization", θ))); // src: vvaharness/detect/patterns.py:172
        }
        for (Entry<String, List<String>> e : θ["code.detect.patterns.deserialize_module_methods"]) {          // pickle: loads, load; yaml: load // src: vvaharness/detect/patterns.py:67
            for (String name : e.value) {
                specs.add(new MatchSpec("detect-sink-deser-" + e.key + "-" + name, "sink", qualifiedCall(e.key, name), "CWE-502", "unsafe_deserialization", "deserialization", owasp("deserialization", θ))); // src: vvaharness/detect/patterns.py:183
            }
        }
        return specs;
    }

    /** _source_specs: one role=source spec per accessor, pattern is the accessor between word boundaries, kind from the map. */
    @src("vvaharness/detect/patterns.py:198")
    List<MatchSpec> sourceSpecs(Theta θ) {
        List<MatchSpec> specs = new List();
        // accessors: Flask request.* and Django request.* (upper-case plus body) are network; os.environ and os.getenv are file; sys.argv and sys.stdin are cli;
        // BaseHTTPRequestHandler and SimpleHTTPRequestHandler are network (class names, NOT self.path or self.headers)
        for (Entry<String, String> a : θ["code.detect.patterns.source_accessors"]) {                         // src: vvaharness/detect/patterns.py:72
            specs.add(new MatchSpec("detect-source-" + a.key, "source", "\\b" + a.key + "\\b", "CWE-20", a.value, "untrusted-input", owasp("untrusted-input", θ))); // src: vvaharness/detect/patterns.py:201
        }
        return specs;
    }

    /** default_corpus: role=sink / role=source specs only (order: command, sql, deserialize, template, cookie, source). */
    @src("vvaharness/detect/patterns.py:213")
    List<MatchSpec> defaultCorpus(Theta θ) {
        List<MatchSpec> specs = new List();
        specs.addAll(commandSpecs(θ));      // CWE-78  // src: vvaharness/detect/patterns.py:215
        specs.addAll(sqlSpecs(θ));          // CWE-89  // src: vvaharness/detect/patterns.py:215
        specs.addAll(deserializeSpecs(θ));  // CWE-502 // src: vvaharness/detect/patterns.py:215
        specs.addAll(templateSpecs(θ));      // CWE-79  // src: vvaharness/detect/patterns.py:216
        specs.addAll(cookieSpecs());        // cookie flags // src: vvaharness/detect/patterns.py:216
        specs.addAll(sourceSpecs(θ));       // CWE-20, request accessors -> entry points // src: vvaharness/detect/patterns.py:216
        return specs;
    }

    /** detector_corpus: S5 rules (role=detector keeps them out of S0's view); every hit goes through S6. */
    List<MatchSpec> detectorCorpus(Theta θ) {
        // 11 rules; per-rule enabled flags are packaged data: form-no-csrf-post and form-get-password ship disabled
        List<MatchSpec> rules = θ["code.s5.detector_rules"];                                 // src: vvaharness/detect/patterns.py:326
        // detector-cookie-httponly (CWE-1004), detector-cookie-secure (CWE-614),
        // detector-autoescape-off-code / -template, detector-jinja-env-noescape, detector-template-safe (CWE-79),
        // detector-docwrite-location (CWE-79, proximity gate: location./document.URL/decodeURIComponent within 3 lines),
        // detector-form-no-csrf-post (CWE-352, OFF), detector-form-get-password (CWE-598, OFF),
        // detector-httpresponse-concat, detector-html-string-concat (CWE-79)
        return rules.filter(r -> r.enabled);                                                 // src: vvaharness/detect/patterns.py:221
    }

    MatchSpec detector(String ruleId, Theta θ) {
        return θ["code.s5.detector_rules"].first(r -> r.ruleId == ruleId);                   // src: vvaharness/pipeline/stages/s1_autoexclude.py:370
    }
}

/** The typed output of one detect.scan() call (source class Result in detect/__init__.py:37; frozen dataclass). */
@executedBy(CODE) @role(types)
record DetectResult(List<EntryPoint> entryPoints, List<Sink> unsafeSinks, List<Hit> hits) { }  // src: vvaharness/detect/__init__.py:37
