// file: vvaharness/pipeline/stages/replay.py
// Bound a stage at a wall clock; when it expires, resume the pinned session (one extra user turn) or, failing that,
// re-ask a fresh tool-less call from the recorded transcript. Used by S2, S4, S6 and S8.

@executedBy(CODE) @role(step)
class Replay {

    /** The call's result, raising VVAH-E008 once seconds elapse; 0/None means no clock. */
    @src("vvaharness/pipeline/stages/replay.py:221")
    Object runWithDeadline(Callable call, Double seconds, String stage, Effort effort) {
        if (seconds == null || seconds <= 0) return call.run();                                             // src: vvaharness/pipeline/stages/replay.py:226
        Future fut = startDaemon(call, "deadline-" + stage);                                                // src: vvaharness/pipeline/stages/replay.py:232
        try {
            return fut.result(seconds);                                                                     // src: vvaharness/pipeline/stages/replay.py:234
        } catch (TimeoutError exc) {
            if (fut.done()) return fut.result();                                                            // the call's own error, counted once // src: vvaharness/pipeline/stages/replay.py:238
            fut.cancel();                                                                                   // orphan may still settle later // src: vvaharness/pipeline/stages/replay.py:244
            throw new CallTimeoutError(stage, seconds, effort);                                             // src: vvaharness/pipeline/stages/replay.py:245
        }
    }

    /** Continue the pinned session's own conversation for the output it never reported; else replay(). */
    @src("vvaharness/pipeline/stages/replay.py:308")
    String resumeOrReplay(String sessionId, Callable replay, Object model, String instruction, String stage, int timeout) {
        Counters.bump(stage + "_deadline_resume");                                                          // src: vvaharness/pipeline/stages/replay.py:314
        try {
            return Deepagents.resumeAgentic(sessionId, instruction, model, timeout);                        // src: vvaharness/pipeline/stages/replay.py:317
        } catch (ModelRefusal e) {
            throw e;                                                                                        // the single refusal resend belongs elsewhere // src: vvaharness/pipeline/stages/replay.py:322
        } catch (Exception exc) {
            Counters.bump(stage + "_deadline_resume_unavailable");                                          // src: vvaharness/pipeline/stages/replay.py:326
            return replay.run();                                                                            // lossy transcript re-ask // src: vvaharness/pipeline/stages/replay.py:328
        } finally {
            releasePinnedSession(sessionId);                                                                // src: vvaharness/pipeline/stages/replay.py:330
        }
    }

    /** The re-ask: the transcript when the route shared one, else the original prompt. */
    @src("vvaharness/pipeline/stages/replay.py:278")
    Prompt replayPrompt(Transcript transcript, Prompt originalPrompt, Prompt instruction, String stage, Theta θ) {
        Prompt p = new Prompt();
        p.include(instruction);
        if (!transcript.captured()) {
            Counters.bump(stage + "_replay_without_transcript");                                            // src: vvaharness/pipeline/stages/replay.py:282
            p.rule("No transcript was recoverable on this route. The original request follows; answer it directly."); // src: vvaharness/pipeline/stages/replay.py:283
            p.context(originalPrompt);
            return p;
        }
        Counters.bump(stage + "_replay_from_transcript");                                                   // src: vvaharness/pipeline/stages/replay.py:286
        p.context(transcript.render(θ));                                                                    // "=== SESSION TRANSCRIPT ===" // src: vvaharness/pipeline/stages/replay.py:287
        return p;
    }

    /** Deadline handed to the route so its own clock stops before the stage deadline (less grace, pre-divided by the effort factor). */
    @src("vvaharness/pipeline/stages/replay.py:258")
    Double deadlineBound(Double existing, int deadline, Effort effort, String via) {
        if (deadline <= TIMEOUT_STOP_GRACE_SECONDS) return existing;                                        // src: vvaharness/pipeline/stages/replay.py:263
        // the cli leg folds a None effort to the global cli.effort first
        Effort tier = via == "cli" ? CliRoute.effectiveEffort(effort) : effort;                             // src: vvaharness/pipeline/stages/replay.py:266
        double net = deadline - TIMEOUT_STOP_GRACE_SECONDS;                                                 // src: vvaharness/pipeline/stages/replay.py:267
        double bound = net * (net / LlmModels.effortScaledSeconds(net, tier, SESSION));                     // src: vvaharness/pipeline/stages/replay.py:269
        return (existing == null || existing > bound) ? bound : existing;                                   // src: vvaharness/pipeline/stages/replay.py:270
    }

    Future startDaemon(Callable call, String name) { }
    void releasePinnedSession(String sessionId) { }
}

@executedBy(CODE) @role(io)
@src("vvaharness/pipeline/stages/replay.py:147")
class Transcript {

    /** The conversation as a prompt block; each entry capped, oldest turns trimmed first. */
    String render(Theta θ) {
        List<String> blocks = new List();
        for (Message m : messages) {                                                                        // src: vvaharness/pipeline/stages/replay.py:174
            String body = m.text;
            if (body.length() > θ["p.replay.max_entry_chars"]) body = body.substring(0, θ["p.replay.max_entry_chars"]) + "[... chars cut]"; // src: vvaharness/pipeline/stages/replay.py:63
            blocks.add("[" + m.role + "]\n" + body + m.toolCalls);                                          // src: vvaharness/pipeline/stages/replay.py:184
        }
        String out = String.join("\n\n", blocks);
        if (out.length() <= 120000) return out;                                                             // src: vvaharness/pipeline/stages/replay.py:186
        return "[... earlier turns cut to fit the window ...]" + out.tail(120000);                          // src: vvaharness/pipeline/stages/replay.py:188
    }

    /** Keep messages when at least as complete as what is held (fed by the RecordTranscript middleware). */
    void record(List<Message> captured) {
        if (captured.size() >= messages.size()) messages = captured;                                        // src: vvaharness/pipeline/stages/replay.py:163
    }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/pipeline/stages/replay.py:66")
class ReplayInstructions {

    /** Shared preamble: what a session is told after it hit its deadline. */
    Prompt preamble(Theta θ) {
        Prompt p = new Prompt();
        p.include(θ["prompt.replay_instructions"]);                                                         // report from the transcript alone; unreached items inconclusive // src: vvaharness/pipeline/stages/replay.py:66
        p.context(θ["p.replay.preamble_deadline_context"]);                                                 // "The session below hit its wall-clock deadline before it reported ... reproduced verbatim." // src: vvaharness/pipeline/stages/replay.py:67
        p.must(θ["p.replay.preamble_no_tools_keep_conclusions"]);                                           // "You have no tools and no further turns. Report from this transcript alone, and keep every conclusion" // src: vvaharness/pipeline/stages/replay.py:70
        return p;
    }

    Prompt s2(Theta θ) {
        Prompt p = preamble(θ);
        p.must(θ["p.replay.s2_replay_keep_all"]);                                                           // "Report the threat model NOW. Keep every asset, trust boundary and threat" // src: vvaharness/pipeline/stages/replay.py:75
        p.rule(θ["p.replay.s2_replay_undisposed_baseline"]);                                                // undisposed baseline item -> open_questions // src: vvaharness/pipeline/stages/replay.py:76
        return p;
    }

    Prompt s4(Theta θ) {
        Prompt p = preamble(θ);
        p.format(θ["p.replay.s4_replay_one_per_unit"]);                                                     // one outcome per unit id; keep evidenced findings with file and line // src: vvaharness/pipeline/stages/replay.py:81
        p.choose(θ["p.replay.s4_replay_unreached_inconclusive"]);                                           // unreached unit is `inconclusive`, never omitted // src: vvaharness/pipeline/stages/replay.py:82
        return p;
    }

    Prompt s6(Theta θ) {
        Prompt p = preamble(θ);
        p.format(θ["p.replay.s6_replay_one_per_finding"]);                                                  // one outcome per finding id; unreached is `inconclusive` // src: vvaharness/pipeline/stages/replay.py:87
        return p;
    }

    /** S8 asks for less: an empty chain list still ships every finding. */
    Prompt s8(Theta θ) {
        Prompt p = preamble(θ);
        p.must(θ["p.replay.s8_replay_only_evidenced"]);                                                     // only evidenced chains and already-decided severity changes // src: vvaharness/pipeline/stages/replay.py:94
        p.forbid(θ["p.replay.s8_replay_drop_unfinished_chain"]);                                            // drop an unfinished chain rather than guess its links // src: vvaharness/pipeline/stages/replay.py:95
        return p;
    }
}
