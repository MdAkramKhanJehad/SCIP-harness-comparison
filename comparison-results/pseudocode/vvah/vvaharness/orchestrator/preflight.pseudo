    // ---- doctor --cache-probe: spends real tokens, never in a scan; usage ONLY via the token counter, never an own client ----

    /** Deterministic filler of at least minTokens ESTIMATED tokens, built well PAST the floor (8192 nominal can really be about 3900). */
    @src("vvaharness/orchestrator/preflight.py:898")
    String cacheProbeFiller(Integer minTokens, Theta θ) {
        int floor = minTokens != null ? minTokens : θ["code.orchestrator.preflight.cache_probe_filler_min_tokens"]; // src: vvaharness/orchestrator/preflight.py:898
        int targetChars = (int) (floor * θ["code.orchestrator.preflight.cache_probe_filler_chars_per_token"] * θ["code.orchestrator.preflight.cache_probe_filler_margin"]); // src: vvaharness/orchestrator/preflight.py:901
        List<String> words = List.of("alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel", "india", "juliet", "kilo", "lima", "mike", "november", "oscar", "papa", "quebec", "romeo", "sierra", "tango", "uniform", "victor", "whiskey", "xray", "yankee", "zulu"); // src: vvaharness/orchestrator/preflight.py:902
        StringBuilder out = new StringBuilder();
        int total = 0; int i = 0;
        while (total < targetChars) {                                                                       // src: vvaharness/orchestrator/preflight.py:906
            String line = "CACHE-PROBE-FILLER-LINE-" + zeroPad(i, 6) + " " + words.join(" ") + " " + i + "\n"; // src: vvaharness/orchestrator/preflight.py:907
            out.append(line); total += line.length(); i += 1;                                               // src: vvaharness/orchestrator/preflight.py:908
        }
        return out.toString();                                                                              // src: vvaharness/orchestrator/preflight.py:911
    }

    /** Reduce a URL to scheme://host[:port] only: never a path, query string, or userinfo (any can carry a secret). */
    @src("vvaharness/orchestrator/preflight.py:914")
    String schemeHost(String url) {
        if (url == null || url.isEmpty()) return "(default)";                                               // src: vvaharness/orchestrator/preflight.py:916
        String out;
        try {
            Url parts = Url.split(url);                                                                     // src: vvaharness/orchestrator/preflight.py:919
            String host = parts.hostname != null ? parts.hostname : "";                                     // src: vvaharness/orchestrator/preflight.py:920
            if (host.contains(":")) host = "[" + host + "]";                                                // hostname strips IPv6 brackets; without them the port looks like another address group // src: vvaharness/orchestrator/preflight.py:922
            if (parts.port != null && parts.port != 0) host = host + ":" + parts.port;                      // src: vvaharness/orchestrator/preflight.py:924
            if (parts.scheme != null && !parts.scheme.isEmpty() && !host.isEmpty()) out = parts.scheme + "://" + host; // src: vvaharness/orchestrator/preflight.py:926
            else out = host.isEmpty() ? "(unparseable)" : host;                                             // src: vvaharness/orchestrator/preflight.py:929
        } catch (Exception e) {
            out = "(unparseable)";                                                                          // src: vvaharness/orchestrator/preflight.py:931
        }
        return Redact.redact(out);                                                                          // src: vvaharness/orchestrator/preflight.py:932
    }

    /** The base_url actually in force for via, scheme+host only, read from the backend's own configured client (never modified). */
    @src("vvaharness/orchestrator/preflight.py:935")
    String resolvedBaseUrlSchemeHost(String via) {
        String raw;
        try {
            if (via == "sdk") raw = sdk.getClient().baseUrl.toString();                                  // src: vvaharness/orchestrator/preflight.py:940
            else if (via == "openai") raw = openai.getClient().baseUrl.toString();                       // src: vvaharness/orchestrator/preflight.py:942
            else return "(cli subprocess - no base_url)";                                                   // src: vvaharness/orchestrator/preflight.py:944
        } catch (Exception e) {
            return "(unresolved)";                                                                          // src: vvaharness/orchestrator/preflight.py:946
        }
        return schemeHost(raw);                                                                             // src: vvaharness/orchestrator/preflight.py:947
    }

    /** Ground truth for whether the FINAL successful request carried thinking, checked AFTER the call (the sdk drops it at runtime for models that reject it). */
    @src("vvaharness/orchestrator/preflight.py:950")
    boolean thinkingActuallySent(String modelId, Integer requestedBudget) {
        if (requestedBudget == null || requestedBudget == 0) return false;                                  // src: vvaharness/orchestrator/preflight.py:953
        return !LlmSdk.NO_THINK_MODELS.contains(modelId);                                                   // src: vvaharness/orchestrator/preflight.py:955
    }

    /** Whether the sdk backend's OWN gate would place a cache_control marker on this call's system block. Null when unknowable (cli builds in-subprocess, openai places none) or on any failure. */
    @src("vvaharness/orchestrator/preflight.py:958")
    Boolean markerWouldBePlaced(String via, String systemPrompt, String modelId) {
        if (via != "sdk") return null;                                                                      // src: vvaharness/orchestrator/preflight.py:962
        try {
            if (!sdk.cacheMarkersEnabled()) return false;                                                // src: vvaharness/orchestrator/preflight.py:965
            if (!LlmSdk.CACHE_CONTROL_ROUTES.contains(sdk.cacheRoute(sdk.getClient()))) return false; // src: vvaharness/orchestrator/preflight.py:967
            return sdk.cachePrefixMeetsMinimum(systemPrompt, modelId);                                   // src: vvaharness/orchestrator/preflight.py:969
        } catch (Exception e) {
            return null;                                                                                    // diagnostic-only; never break the probe // src: vvaharness/orchestrator/preflight.py:971
        }
    }

    /** Build the (usage A, usage B) dicts the classifier expects from ONE probe pair. Field PRESENCE is OBSERVED, never inferred from via. */
    @src("vvaharness/orchestrator/preflight.py:974")
    Pair<Map, Map> usageDictForClassifier(int cacheWrite, int cacheRead, boolean writePresent, boolean readPresent) {
        Map usageA = new Map(); Map usageB = new Map();                                                     // src: vvaharness/orchestrator/preflight.py:979
        if (writePresent) usageA.put("cache_creation_input_tokens", cacheWrite);                            // src: vvaharness/orchestrator/preflight.py:981
        if (readPresent) usageB.put("cache_read_input_tokens", cacheRead);                                  // src: vvaharness/orchestrator/preflight.py:983
        return Pair.of(usageA, usageB);                                                                     // src: vvaharness/orchestrator/preflight.py:985
    }

    /** Pure classifier: two calls' cache usage to one of seven verdicts. Field PRESENCE (not value) selects the row, so never-reported differs from zero. */
    @src("vvaharness/orchestrator/preflight.py:988")
    CacheVerdict classifyCacheVerdict(Map usageA, Map usageB) {
        boolean creationPresent = usageA.containsKey("cache_creation_input_tokens");                        // src: vvaharness/orchestrator/preflight.py:991
        boolean readPresent = usageB.containsKey("cache_read_input_tokens");                                // src: vvaharness/orchestrator/preflight.py:992
        if (!creationPresent && !readPresent) return NO_CACHE_FIELDS;                                       // src: vvaharness/orchestrator/preflight.py:993
        int read = orZero(usageB.get("cache_read_input_tokens"));                                           // src: vvaharness/orchestrator/preflight.py:995
        if (creationPresent) {                                                                              // src: vvaharness/orchestrator/preflight.py:996
            int creation = orZero(usageA.get("cache_creation_input_tokens"));                               // src: vvaharness/orchestrator/preflight.py:997
            if (creation > 0 && read > 0) return ANTHROPIC_WORKS;                                           // src: vvaharness/orchestrator/preflight.py:998
            if (creation > 0 && read == 0) return ANTHROPIC_ROUTING_GAP;                                    // writes succeed but reads do not // src: vvaharness/orchestrator/preflight.py:1000
            if (creation == 0 && read > 0) return ANTHROPIC_ALREADY_WARM;                                   // nothing written: the prefix was already cached and read back // src: vvaharness/orchestrator/preflight.py:1002
            return ANTHROPIC_NOT_HONOURED;                                                                  // src: vvaharness/orchestrator/preflight.py:1005
        }
        return read > 0 ? OPENAI_WORKING : OPENAI_BELOW_MIN;                                                // src: vvaharness/orchestrator/preflight.py:1006
    }

    /** The real deep-dive system prompt, imported read-only rather than copied so the probe cannot drift from it. */
    @src("vvaharness/orchestrator/preflight.py:1009")
    String deepdiveSystemPrompt() {
        return S4Prompts.buildSystemPrompt();                                                               // src: vvaharness/orchestrator/preflight.py:1012
    }

    /** Unique (model_id, via) -> model node, restricted to the vias prompt() dispatches (sdk, openai, cli). Do NOT widen: deepagents has its own probe. */
    @src("vvaharness/orchestrator/preflight.py:1015")
    Map<Pair<String, String>, Object> cacheProbeTargets(Config cfg, Theta θ) {
        Map<Pair<String, String>, Object> targets = new Map();                                              // src: vvaharness/orchestrator/preflight.py:1017
        for (Role r : ConfigPaths.iterModelRoles(cfg)) {                                                    // src: vvaharness/orchestrator/preflight.py:1018
            ResolvedModel rm = LlmRegistry.resolve(r.model, θ);                                             // src: vvaharness/orchestrator/preflight.py:1019
            if (!θ["code.orchestrator.preflight.cache_probe_prompt_vias"].contains(rm.via)) continue;       // src: vvaharness/orchestrator/preflight.py:1020
            targets.putIfAbsent(Pair.of(rm.modelId, rm.via), r.model);                                      // src: vvaharness/orchestrator/preflight.py:1022
        }
        return targets;                                                                                     // src: vvaharness/orchestrator/preflight.py:1023
    }

    /** Run ONE backend call and return its cache usage. Token VALUES come from a snapshot diff of the global counter; PRESENCE from wrapping TOKENS.add (the diff cannot see present-at-zero). */
    @src("vvaharness/orchestrator/preflight.py:1026")
    Map<String, Object> observeCall(String phaseLabel, Runnable invoke) {
        List<Map> observed = new List();                                                                    // src: vvaharness/orchestrator/preflight.py:1029
        Object prevAdd = Tokens.TOKENS.ownAdd();                                                            // the instance override if any, else a sentinel // src: vvaharness/orchestrator/preflight.py:1031
        Tokens.TOKENS.phase(phaseLabel, () -> {                                                             // src: vvaharness/orchestrator/preflight.py:1039
            Map before = Tokens.TOKENS.snapshot().byPhase.getOrDefault(phaseLabel, Map.of());               // src: vvaharness/orchestrator/preflight.py:1040
            Tokens.TOKENS.add = (usage, kw) -> observingAdd(observed, phaseLabel, usage, kw);               // src: vvaharness/orchestrator/preflight.py:1041
            try {
                invoke.run();                                                                               // src: vvaharness/orchestrator/preflight.py:1043
            } finally {
                Tokens.TOKENS.restoreAdd(prevAdd);                                                          // back to the class method when there was no instance override // src: vvaharness/orchestrator/preflight.py:1045
            }
            Map after = Tokens.TOKENS.snapshot().byPhase.getOrDefault(phaseLabel, Map.of());                // src: vvaharness/orchestrator/preflight.py:1049
        });
        // returns cache_read and cache_write as after minus before, plus per-call presence flags
        return Map.of("cache_read", 0, "cache_write", 0,                                                    // src: vvaharness/orchestrator/preflight.py:1051
            "cache_read_present", observed.any(u -> u.containsKey("cache_read_input_tokens")),              // src: vvaharness/orchestrator/preflight.py:1054
            "cache_write_present", observed.any(u -> u.containsKey("cache_creation_input_tokens")));        // src: vvaharness/orchestrator/preflight.py:1056
    }

    /** The wrapped TOKENS.add: record the usage dict when it is reported in this probe phase, then delegate to the real add. */
    @src("vvaharness/orchestrator/preflight.py:1034")
    void observingAdd(List<Map> observed, String phaseLabel, Object usage, Map kw) {
        if (usage instanceof Map && Tokens.TOKENS.currentPhase() == phaseLabel) observed.add(usage.copy());  // src: vvaharness/orchestrator/preflight.py:1035
        Tokens.TOKENS.realAdd(usage, kw);                                                                   // src: vvaharness/orchestrator/preflight.py:1037
    }

    /** One prompt() call observed through observeCall, so the request is built by the backend itself. */
    @src("vvaharness/orchestrator/preflight.py:1061")
    Map<String, Object> callAndDiff(Object model, String systemPrompt, String userPrompt, Integer thinkingBudget, String phaseLabel, Theta θ) {
        return observeCall(phaseLabel, () -> invoke(model, systemPrompt, userPrompt, thinkingBudget, θ));   // src: vvaharness/orchestrator/preflight.py:1076
    }

    /** The probe call itself: the point is usage, not the reply, so the report-prose floors (150 chars / 30 tokens) are lowered to 1. */
    @src("vvaharness/orchestrator/preflight.py:1066")
    void invoke(Object model, String systemPrompt, String userPrompt, Integer thinkingBudget, Theta θ) {
        ResponseQuality.stageFloors("cache-probe", θ["code.orchestrator.preflight.probe_ping_min_chars"], θ["code.orchestrator.preflight.probe_ping_min_tokens"], () -> // src: vvaharness/orchestrator/preflight.py:1068
            llmRegistry.prompt(userPrompt, model, systemPrompt, thinkingBudget, θ["code.orchestrator.preflight.cache_probe_max_tokens"], θ["code.orchestrator.preflight.cache_probe_timeout_s"], "cache-probe")); // src: vvaharness/orchestrator/preflight.py:1071
    }

    /** Unique (model_id, deepagents) -> model node: the roles the prompt-route probe skips. */
    @src("vvaharness/orchestrator/preflight.py:1079")
    Map<Pair<String, String>, Object> deepagentsCacheProbeTargets(Config cfg, Theta θ) {
        Map<Pair<String, String>, Object> targets = new Map();                                              // src: vvaharness/orchestrator/preflight.py:1081
        for (Role r : ConfigPaths.iterModelRoles(cfg)) {                                                    // src: vvaharness/orchestrator/preflight.py:1082
            ResolvedModel rm = LlmRegistry.resolve(r.model, θ);                                             // src: vvaharness/orchestrator/preflight.py:1083
            if (rm.via != "deepagents") continue;                                                           // src: vvaharness/orchestrator/preflight.py:1084
            targets.putIfAbsent(Pair.of(rm.modelId, rm.via), r.model);                                      // src: vvaharness/orchestrator/preflight.py:1086
        }
        return targets;                                                                                     // src: vvaharness/orchestrator/preflight.py:1087
    }

    /** Whether the deepagents route's OWN gate places block markers on this call: both predicates must hold. */
    @src("vvaharness/orchestrator/preflight.py:1090")
    boolean deepagentsMarkerWouldBePlaced(Config cfg, String modelId, String provider) {
        return deepagents.markersOn(cfg.sdk) && ProviderRouting.routesToAnthropic(modelId, provider);       // src: vvaharness/orchestrator/preflight.py:1095
    }

    /** Scheme+host of the base URL the deepagents route will actually use, read from the same env build the dispatch uses. */
    @src("vvaharness/orchestrator/preflight.py:1099")
    String deepagentsBaseUrl(Config cfg, String modelId, String provider) {
        String raw;
        try {
            Object env = deepagents.buildHarnessEnv(modelId, provider, cfg.sdk, cfg.openai, cfg.configDir); // src: vvaharness/orchestrator/preflight.py:1108
            raw = ProviderRouting.routesToAnthropic(modelId, provider) ? DeepagentsModels.anthropicBase(env) : DeepagentsModels.openaiBase(env); // src: vvaharness/orchestrator/preflight.py:1114
        } catch (Exception e) {
            return "(unresolved)";                                                                          // diagnostic label only; never break the probe // src: vvaharness/orchestrator/preflight.py:1117
        }
        return schemeHost(raw);                                                                             // src: vvaharness/orchestrator/preflight.py:1118
    }

    /** Two dispatch_prompt calls (A then B) sharing one filler system prompt, in one temp dir. */
    @src("vvaharness/orchestrator/preflight.py:1121")
    Pair<Map, Map> probeDeepagentsCache(Config cfg, Object modelNode, String labelBase, Theta θ) {
        String systemPrompt = cacheProbeFiller(null, θ);                                                    // src: vvaharness/orchestrator/preflight.py:1124
        Path workdir = Files.mkdtemp("vva-cache-probe-deepagents-");                                        // src: vvaharness/orchestrator/preflight.py:1138
        Map write = deepagentsCall(cfg, modelNode, systemPrompt, "USER_MSG_A", labelBase + "::A", workdir, θ); // src: vvaharness/orchestrator/preflight.py:1139
        Map read = deepagentsCall(cfg, modelNode, systemPrompt, "USER_MSG_B", labelBase + "::B", workdir, θ);  // src: vvaharness/orchestrator/preflight.py:1140
        return Pair.of(write, read);                                                                        // src: vvaharness/orchestrator/preflight.py:1141
    }

    /** One observed deepagents dispatch: same PONG-sized reply and per-tag floors as callAndDiff. */
    @src("vvaharness/orchestrator/preflight.py:1126")
    Map<String, Object> deepagentsCall(Config cfg, Object modelNode, String systemPrompt, String userPrompt, String phaseLabel, Path workdir, Theta θ) {
        return observeCall(phaseLabel, () -> ResponseQuality.stageFloors("cache-probe", θ["code.orchestrator.preflight.probe_ping_min_chars"], θ["code.orchestrator.preflight.probe_ping_min_tokens"], () -> // src: vvaharness/orchestrator/preflight.py:1129
            deepagents.dispatchPrompt(userPrompt, modelNode, cfg, workdir, systemPrompt, θ["code.orchestrator.preflight.cache_probe_max_tokens"], "cache-probe"))); // src: vvaharness/orchestrator/preflight.py:1132
    }

    /** The live diagnostic behind vvaharness doctor --cache-probe: per (model_id, via) two prompt shapes x two thinking arms, A then B within the call-B deadline. */
    @src("vvaharness/orchestrator/preflight.py:1144")
    boolean runCacheProbe(Config cfg, Theta θ) {
        Map<Pair<String, String>, Object> targets = cacheProbeTargets(cfg, θ);                              // src: vvaharness/orchestrator/preflight.py:1147
        Map<Pair<String, String>, Object> deepagentsTargets = deepagentsCacheProbeTargets(cfg, θ);          // src: vvaharness/orchestrator/preflight.py:1148
        List<Pair<String, String>> shapes = List.of(Pair.of("synthetic", cacheProbeFiller(null, θ)), Pair.of("deepdive-system", deepdiveSystemPrompt())); // src: vvaharness/orchestrator/preflight.py:1149
        int nCalls = targets.size() * shapes.size() * 2 * 2 + deepagentsTargets.size() * 2;                 // prompt routes: shapes x thinking arms x (A, B); deepagents: (A, B) only // src: vvaharness/orchestrator/preflight.py:1154
        if (nCalls == 0) {                                                                                  // src: vvaharness/orchestrator/preflight.py:1155
            Console.write("no sdk/openai/cli/deepagents model roles configured: nothing to probe");         // src: vvaharness/orchestrator/preflight.py:1156
            return true;                                                                                    // src: vvaharness/orchestrator/preflight.py:1158
        }
        boolean ok = true;
        List<Map> rows = new List();                                                                        // src: vvaharness/orchestrator/preflight.py:1165
        Table measured = Console.statusTable("cache-probe measurements", List.of("via", "model", "filler", "thinking_sent", "base_url", "creation", "read", "verdict")); // src: vvaharness/orchestrator/preflight.py:1166
        for (Entry<Pair<String, String>, Object> t : targets.sortedEntries()) {                             // src: vvaharness/orchestrator/preflight.py:1170
            String modelId = t.key.first; String via = t.key.second;
            String baseUrl = resolvedBaseUrlSchemeHost(via);                                                // src: vvaharness/orchestrator/preflight.py:1171
            for (Pair<String, String> shape : shapes) {                                                     // src: vvaharness/orchestrator/preflight.py:1172
                // thinking arm on uses the probe-only budget (no shipped profile sets thinking_budget); arm off sends none
                for (Pair<String, Integer> arm : List.of(Pair.of("on", θ["code.orchestrator.preflight.cache_probe_thinking_budget"]), Pair.of("off", null))) { // src: vvaharness/orchestrator/preflight.py:1173
                    String labelBase = "cache_probe::" + modelId + "::" + via + "::" + shape.first + "::" + arm.first; // src: vvaharness/orchestrator/preflight.py:1174
                    Map write; Map read; double elapsed;
                    try {
                        double t0 = Clock.now();
                        write = callAndDiff(t.value, shape.second, "USER_MSG_A", arm.second, labelBase + "::A", θ); // src: vvaharness/orchestrator/preflight.py:1177
                        read = callAndDiff(t.value, shape.second, "USER_MSG_B", arm.second, labelBase + "::B", θ); // src: vvaharness/orchestrator/preflight.py:1181
                        elapsed = Clock.now() - t0;                                                         // src: vvaharness/orchestrator/preflight.py:1185
                    } catch (Exception e) {
                        // report and keep probing; the message is redacted and cut to 200 chars
                        Console.statusRow(measured, "fail", via, modelId, shape.first);                     // src: vvaharness/orchestrator/preflight.py:1187
                        ok = false;                                                                         // src: vvaharness/orchestrator/preflight.py:1191
                        continue;                                                                           // src: vvaharness/orchestrator/preflight.py:1192
                    }
                    if (elapsed > θ["code.orchestrator.preflight.cache_probe_call_b_deadline_s"]) log.warning(Events.PREFLIGHT_CACHE_PROBE_SLOW, via, modelId, shape.first, arm.first, elapsed); // src: vvaharness/orchestrator/preflight.py:1193
                    boolean thinkingSent = thinkingActuallySent(modelId, arm.second);                       // src: vvaharness/orchestrator/preflight.py:1197
                    Pair<Map, Map> usage = usageDictForClassifier(write.cache_write, read.cache_read, write.cache_write_present, read.cache_read_present); // src: vvaharness/orchestrator/preflight.py:1198
                    CacheVerdict verdict = classifyCacheVerdict(usage.first, usage.second);                 // src: vvaharness/orchestrator/preflight.py:1203
                    // only a definite False (never null) moves blame off the gateway to our own gate
                    if (verdict == ANTHROPIC_NOT_HONOURED && markerWouldBePlaced(via, shape.second, modelId) == Boolean.FALSE) verdict = MARKER_WITHHELD; // src: vvaharness/orchestrator/preflight.py:1204
                    rows.add(Map.of("model_id", modelId, "via", via, "filler", shape.first, "thinking_requested", arm.first, "thinking_sent", thinkingSent, "base_url", baseUrl, "cache_creation", write.cache_write, "cache_read", read.cache_read, "verdict", verdict)); // src: vvaharness/orchestrator/preflight.py:1209
                    Console.statusRow(measured, "ok", via, modelId, shape.first, thinkingSent ? "yes" : "no", baseUrl, write.cache_write, read.cache_read, verdict); // src: vvaharness/orchestrator/preflight.py:1215
                }
            }
        }
        for (Entry<Pair<String, String>, Object> t : deepagentsTargets.sortedEntries()) {                   // src: vvaharness/orchestrator/preflight.py:1220
            String modelId = t.key.first; String via = t.key.second;
            String provider = t.value.provider;                                                             // src: vvaharness/orchestrator/preflight.py:1221
            String baseUrl = deepagentsBaseUrl(cfg, modelId, provider);                                     // src: vvaharness/orchestrator/preflight.py:1222
            String labelBase = "cache_probe::" + modelId + "::" + via + "::synthetic::off";                 // src: vvaharness/orchestrator/preflight.py:1223
            Pair<Map, Map> wr; double elapsed;
            try {
                double t0 = Clock.now();
                wr = probeDeepagentsCache(cfg, t.value, labelBase, θ);                                      // src: vvaharness/orchestrator/preflight.py:1226
                elapsed = Clock.now() - t0;                                                                 // src: vvaharness/orchestrator/preflight.py:1228
            } catch (Exception e) {
                Console.statusRow(measured, "fail", via, modelId, "synthetic");                             // src: vvaharness/orchestrator/preflight.py:1230
                ok = false;                                                                                 // src: vvaharness/orchestrator/preflight.py:1233
                continue;                                                                                   // src: vvaharness/orchestrator/preflight.py:1234
            }
            // expected on this route: graph build dominates the first call
            if (elapsed > θ["code.orchestrator.preflight.cache_probe_call_b_deadline_s"]) log.warning(Events.PREFLIGHT_CACHE_PROBE_SLOW, via, modelId, "synthetic", elapsed); // src: vvaharness/orchestrator/preflight.py:1235
            Pair<Map, Map> usage = usageDictForClassifier(wr.first.cache_write, wr.second.cache_read, wr.first.cache_write_present, wr.second.cache_read_present); // src: vvaharness/orchestrator/preflight.py:1240
            CacheVerdict verdict = classifyCacheVerdict(usage.first, usage.second);                         // src: vvaharness/orchestrator/preflight.py:1245
            // same as the prompt arm: only our own gate may move blame off the gateway
            if (verdict == ANTHROPIC_NOT_HONOURED && !deepagentsMarkerWouldBePlaced(cfg, modelId, provider)) verdict = MARKER_WITHHELD; // src: vvaharness/orchestrator/preflight.py:1246
            rows.add(Map.of("model_id", modelId, "via", via, "filler", "synthetic", "thinking_requested", "off", "thinking_sent", false, "base_url", baseUrl, "verdict", verdict)); // src: vvaharness/orchestrator/preflight.py:1250
            Console.statusRow(measured, "ok", via, modelId, "synthetic", "no", baseUrl, wr.first.cache_write, wr.second.cache_read, verdict); // src: vvaharness/orchestrator/preflight.py:1256
        }
        // one verdict line per row: the verdict text table below; empty rows prints a no-successful-calls note
        for (Map r : rows) Console.write(verdictText(r.verdict));                                           // src: vvaharness/orchestrator/preflight.py:1262
        return ok;                                                                                          // src: vvaharness/orchestrator/preflight.py:1268
    }

    /** The advice text per verdict (display only). */
    @src("vvaharness/orchestrator/preflight.py:862")
    String verdictText(CacheVerdict v) {
        switch (v) {
            case ANTHROPIC_WORKS: return "cache markers are honoured on this route";                        // src: vvaharness/orchestrator/preflight.py:863
            case ANTHROPIC_ROUTING_GAP: return "writes succeed but reads do not: investigate routing or cache-key affinity"; // src: vvaharness/orchestrator/preflight.py:866
            case ANTHROPIC_NOT_HONOURED: return "the marker is not taking effect: check gateway stripping, minimum cacheable size, thinking"; // src: vvaharness/orchestrator/preflight.py:869
            case ANTHROPIC_ALREADY_WARM: return "caching works; the prefix was already cached"; // src: vvaharness/orchestrator/preflight.py:874
            case OPENAI_WORKING: return "implicit prefix cache working";                                    // src: vvaharness/orchestrator/preflight.py:878
            case OPENAI_BELOW_MIN: return "no cache read: below minimum size or unstable prefix";           // src: vvaharness/orchestrator/preflight.py:881
            case NO_CACHE_FIELDS: return "route reports no cache accounting: treat as implicit";            // src: vvaharness/orchestrator/preflight.py:885
            case MARKER_WITHHELD: return "this tool's own gate never placed a marker: change cache_route / cache_min_block_tokens"; // src: vvaharness/orchestrator/preflight.py:889
        }
    }
}

/** Verdict codes of the cache probe. MARKER_WITHHELD is not one of the classifier's six rows: set only when markerWouldBePlaced says False. */
@executedBy(CODE) @role(types)
@src("vvaharness/orchestrator/preflight.py:852")
enum CacheVerdict { ANTHROPIC_WORKS, ANTHROPIC_ROUTING_GAP, ANTHROPIC_NOT_HONOURED, ANTHROPIC_ALREADY_WARM, OPENAI_WORKING, OPENAI_BELOW_MIN, NO_CACHE_FIELDS, MARKER_WITHHELD }

@executedBy(MODEL) @role(prompt)
@src("vvaharness/orchestrator/preflight.py:464")
class PreflightProbePrompt {

    /** The probe forces a genuine tool call (Read) followed by a final answer turn. */
    Prompt nativeRoundtrip(String markerName, Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.preflight.probe_read_marker_file"]);                                                    // "Use your file-reading tool to read the file <marker_name> in the current directory" // src: vvaharness/orchestrator/preflight.py:467
        p.format(θ["p.preflight.probe_reply_exact_contents"]);                                              // "reply with exactly its contents and nothing else." // src: vvaharness/orchestrator/preflight.py:468
        return p;
    }
}
