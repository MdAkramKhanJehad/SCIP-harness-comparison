// file: vvaharness/validation/ingest/workspace.py
// Stages a pre-patched by-value copy of the target repo for S11 (excluding VCS/build dirs, agent-instruction
// files and escaping symlinks), and refuses validation when no touched file of the fix exists.

@executedBy(CODE) @role(io) @stage("S11")
class Workspace {

    List<String> ignorePatterns(Theta θ) {
        List<String> ig = θ["code.validation.ingest.workspace.staging_ignore_patterns"];            // .git, venv, .venv, checkpoints, __pycache__, *.pyc, node_modules  // src: vvaharness/validation/ingest/workspace.py:34
        ig.addAll(List.of("security-scan", "security-remediation"));                                 // src: vvaharness/validation/ingest/workspace.py:39
        ig.addAll(ConstantsArtifacts.excludedFromStaging(θ));                                        // .mcp.json + agent instruction files  // src: vvaharness/validation/ingest/workspace.py:44
        return ig;
    }

    Path linkRel(Path repo, Path candidate) {
        try {
            return candidate.relativeTo(repo);                                                       // src: vvaharness/validation/ingest/workspace.py:56
        } catch (ValueError e) {
            return candidate;                                                                        // src: vvaharness/validation/ingest/workspace.py:58
        }
    }

    String linkEscapeReason(Path candidate, Path root) {
        Path resolved;
        try {
            resolved = candidate.resolveStrict();                                                    // src: vvaharness/validation/ingest/workspace.py:67
        } catch (OSError e) {
            return "dangling (missing target)";                                                      // src: vvaharness/validation/ingest/workspace.py:69
        }
        return resolved.isRelativeTo(root) ? null : "outside repository";                            // src: vvaharness/validation/ingest/workspace.py:70
    }

    Set<String> ignoreEscapingLinks(Path repo, String srcDir, List<String> names, Theta θ) {
        Path root = repo.resolve();                                                                  // src: vvaharness/validation/ingest/workspace.py:83
        Set<String> skip = Glob.matching(ignorePatterns(θ), names);                                  // src: vvaharness/validation/ingest/workspace.py:86
        for (String name : names) {                                                                  // src: vvaharness/validation/ingest/workspace.py:87
            if (skip.contains(name)) continue;
            Path c = Path.of(srcDir, name);
            if (!c.isSymlink()) continue;                                                            // src: vvaharness/validation/ingest/workspace.py:88
            String reason = linkEscapeReason(c, root);                                               // src: vvaharness/validation/ingest/workspace.py:90
            if (reason != null) {                                                                    // src: vvaharness/validation/ingest/workspace.py:91
                Console.write("staging: skipped link " + linkRel(repo, c) + " -> " + reason);        // src: vvaharness/validation/ingest/workspace.py:93
                skip.add(name);                                                                      // src: vvaharness/validation/ingest/workspace.py:94
            }
        }
        return skip;
    }

    void stageWorkspace(Path repo, Path workspace, String diff, Theta θ) {
        if (workspace.exists()) Fs.rmtree(workspace);                                                // src: vvaharness/validation/ingest/workspace.py:102
        Fs.copytree(repo, workspace, (dir, names) -> ignoreEscapingLinks(repo, dir, names, θ));      // by value, symlinks dereferenced  // src: vvaharness/validation/ingest/workspace.py:104
        workspace.resolve("diff.patch").writeText(diff);                                             // src: vvaharness/validation/ingest/workspace.py:105
    }

    Path underRepo(Path repo, Path candidate) {
        try {
            Path resolved = candidate.resolve();                                                     // src: vvaharness/validation/ingest/workspace.py:111
            resolved.relativeTo(repo.resolve());                                                     // src: vvaharness/validation/ingest/workspace.py:112
            return resolved;
        } catch (ValueError | OSError e) {
            return null;                                                                             // fail closed  // src: vvaharness/validation/ingest/workspace.py:114
        }
    }

    Path resolveTouched(Path repo, String touched, Theta θ) {
        if (Path.of(touched).isAbsolute()) return null;                                              // CWE-22 guard  // src: vvaharness/validation/ingest/workspace.py:120
        List<Path> bases = List.of(repo.resolve(touched));
        if (θ["code.validation.ingest.workspace.app_dir_fallback"]) bases.add(repo.resolve("app").resolve(touched)); // src: vvaharness/validation/ingest/workspace.py:122
        for (Path base : bases) {                                                                    // src: vvaharness/validation/ingest/workspace.py:122
            Path c = underRepo(repo, base);                                                          // src: vvaharness/validation/ingest/workspace.py:123
            if (c != null && c.exists()) return c;                                                   // src: vvaharness/validation/ingest/workspace.py:124
        }
        return null;
    }

    boolean anyTouchedExists(Path repo, List<String> filesTouched, Theta θ) {
        return filesTouched.any(t -> resolveTouched(repo, t, θ) != null);                            // src: vvaharness/validation/ingest/workspace.py:131
    }

    void assertRemediationApplied(Path repo, List<String> filesTouched, Theta θ) {
        if (!anyTouchedExists(repo, filesTouched, θ)) throw new IngestErrors("no touched files found under " + repo); // src: vvaharness/validation/ingest/workspace.py:136
    }
}
