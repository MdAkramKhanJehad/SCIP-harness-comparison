// src: vvaharness/util/logs.py:180-235
fn configure(level?, path?):executor=code {
  chosen = level or env VVAHARNESS_LOG_LEVEL or "warning"; an unknown level warns and falls back to warning
  replace previously attached vvaharness handlers (idempotent)
  handlers: standard error always; plus a file handler for path or env VVAHARNESS_LOG_FILE when it can be opened, in which case standard error is capped at WARNING
  file handler renders JSON; standard error renders product lines (colour only on a terminal without NO_COLOR or TERM=dumb)
  no propagation to the root logger
  return whether a level was explicitly asked for
  // abstracted: renderer formatting details (lines 113-161)
}
