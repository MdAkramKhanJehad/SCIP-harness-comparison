// file: vulnhunt/phases/phase2b_verify.md
// Phase 2b: adversarial (disprove) verification of every Phase 2 candidate, run by the model.
// Prompt-only logic: manifest, consensus-skip, nine checks per candidate, platform auth rollup,
// verdict table (CONFIRMED / FALSE POSITIVE), anti-merge rule, drop of false positives.

@executedBy(MODEL) @role(prompt) @stage("phase2b")
class Phase2bVerify {

    // ---------------------------------------------------------------- prompt sections (in file order)

    Prompt context(Theta θ) {
        Prompt p = new Prompt();
        p.context("Phase 2 complete; candidates from parallel trace agents, one subgraph partition each; cross-subgraph defense visibility may be incomplete"); // src: vulnhunt/phases/phase2b_verify.md:3
        p.include(Phase2bVerifySeverity.tiers(θ["p.phase2b_verify.severity_tiers_carried_from_phase2"])); // src: vulnhunt/phases/phase2b_verify.md:9
        p.context("orchestrator Operating Principles and Investigation Discipline in effect"); // src: vulnhunt/phases/phase2b_verify.md:10
        return p;
    }

    Prompt mandate(Theta θ) {
        Prompt p = new Prompt();
        if (!θ["prompt.phase2b.enabled"]) return p;                                       // src: vulnhunt/phases/phase2b_verify.md:12
        if (θ["p.phase2b_verify.no_report_before_verification"]) p.must("STOP. Before writing any report or presenting findings, complete this verification phase"); // src: vulnhunt/phases/phase2b_verify.md:14
        if (θ["p.phase2b_verify.disprove_stance"]) p.persona("Every finding is a candidate; your job is to try to DISPROVE each one"); // src: vulnhunt/phases/phase2b_verify.md:16
        p.context(θ["prompt.phase2b.fp_prior"]);                                          // src: vulnhunt/phases/phase2b_verify.md:18
        if (θ["p.phase2b_verify.argue_opposing_case_per_candidate"]) p.rule("Take each candidate and argue the opposing case, that it is NOT a real vulnerability"); // src: vulnhunt/phases/phase2b_verify.md:19
        return p;
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(context(θ));
        p.include(mandate(θ));
        p.checklist(θ["prompt.phase2b.checks"]);                                          // src: vulnhunt/phases/phase2b_verify.md:46
        p.choose(θ["prompt.phase2b.verdicts"]);                                           // src: vulnhunt/phases/phase2b_verify.md:249
        p.format(θ["p.phase2b_verify.verdict_table_columns"]);                            // src: vulnhunt/phases/phase2b_verify.md:255
        p.forbid(θ["prompt.anti_merge_rule"]);                                            // src: vulnhunt/phases/phase2b_verify.md:267
        return p;
    }

    // ---------------------------------------------------------------- procedure the prompt asks for

    @executedBy(MODEL)
    VerifyOutcome run(List<ResultFile> phase2Results, Phase1Inventory phase1, Theta θ) {
        if (!θ["prompt.phase2b.enabled"]) return VerifyOutcome.skipped();                  // src: vulnhunt/phases/phase2b_verify.md:12
        List<Candidate> manifest = buildManifest(phase2Results, θ);
        VerdictTable table = new VerdictTable(θ["p.phase2b_verify.verdict_table_columns"]); // src: vulnhunt/phases/phase2b_verify.md:255
        List<Candidate> remaining = consensusSkip(manifest, table, θ);
        for (Candidate c : remaining) {                                                    // src: vulnhunt/phases/phase2b_verify.md:46
            VerdictRow row = verifyCandidate(c, θ);
            table.add(row);
        }
        postVerificationSweeps(manifest, table, θ);
        Phase2bVerifyRollup.run(phase1, table, θ);                                         // src: vulnhunt/phases/phase2b_verify.md:224
        checkTableCompleteness(manifest, table, θ);
        Phase2bVerifyOutput.present(table, θ);
        return Phase2bVerifyOutput.drop(table, θ);
    }

    @executedBy(MODEL)
    List<Candidate> buildManifest(List<ResultFile> results, Theta θ) {
        if (!θ["prompt.phase2b.candidate_manifest"]) return allCandidates(results);         // src: vulnhunt/phases/phase2b_verify.md:22
        List<Candidate> manifest = new List();
        for (ResultFile f : results) {                                                     // src: vulnhunt/phases/phase2b_verify.md:24
            for (Entry e : f.entries) {
                if (e.disposition == CANDIDATE) manifest.add(e.line(θ["p.phase2b_verify.manifest_line_fields"])); // src: vulnhunt/phases/phase2b_verify.md:25
            }
        }
        manifest.target = manifest.size();                                                 // src: vulnhunt/phases/phase2b_verify.md:26
        return manifest;
    }

    @executedBy(MODEL)
    List<Candidate> consensusSkip(List<Candidate> manifest, VerdictTable table, Theta θ) {
        if (!θ["prompt.phase2b.consensus_skip"]) return manifest;                          // src: vulnhunt/phases/phase2b_verify.md:31
        List<Candidate> remaining = new List();
        for (Candidate c : manifest) {
            boolean anyCandidate = c.agentDispositions.any(d -> d == CANDIDATE);
            boolean split = !c.agentsAgree() || !c.sameEvidenceFileLine();
            if (c.fromSinkDrivenAgent && θ["p.phase2b_verify.sink_driven_candidates_always_full_verification"]) { // src: vulnhunt/phases/phase2b_verify.md:41
                remaining.add(c);
            } else if (anyCandidate && θ["p.phase2b_verify.any_candidate_disposition_full_verification"]) { // src: vulnhunt/phases/phase2b_verify.md:40
                remaining.add(c);
            } else if (split && θ["p.phase2b_verify.split_decision_full_verification"]) { // src: vulnhunt/phases/phase2b_verify.md:38
                remaining.add(c);
            } else if (c.allCiteGate1FailAtSameFileLine() && θ["p.phase2b_verify.consensus_gate1_fail_skips_reverification"]) { // src: vulnhunt/phases/phase2b_verify.md:35
                VerdictRow r = VerdictRow.eliminated(c, "ELIMINATED - Gate 1 consensus <file:line>"); // src: vulnhunt/phases/phase2b_verify.md:36
                if (θ["p.phase2b_verify.consensus_skipped_entries_in_table"]) table.add(r.mark("consensus-skipped")); // src: vulnhunt/phases/phase2b_verify.md:43
            } else {
                remaining.add(c);
            }
        }
        return remaining;
    }

    @executedBy(MODEL)
    VerdictRow verifyCandidate(Candidate c, Theta θ) {
        Scope scope = θ["prompt.phase2b.full_codebase_search"] ? Scope.FULL_REPO : c.partitionScope; // src: vulnhunt/phases/phase2b_verify.md:48
        VerdictRow row = new VerdictRow(c);
        row.gatesComplete = check1GatesAnswered(c, row, θ);
        if (row.routedToCodeQuality) return row;
        row.reachable = check2Reachability(c, scope, θ);
        row.defenses = check3Defenses(c, scope, θ);
        row.severity = check4Severity(c, row, θ);
        if (row.routedToCodeQuality) return row;
        if (row.wouldDowngradeOrEliminate()) row.callSites = check5DowngradeDiscipline(c, scope, row, θ);
        if (c.cwe == 306 && c.isConditionalValidationBypass()) check6Cvb(c, row, θ);        // src: vulnhunt/phases/phase2b_verify.md:157
        if (row.wouldDowngradeOrEliminate()) check7CommentSkepticism(c, row, θ);
        if (c.isIdor() || c.isResourceIdGate()) Phase2bVerifySeverity.authzDelegationLadder(c, row, θ); // src: vulnhunt/phases/phase2b_verify.md:186
        row.verdict = decideVerdict(c, row, θ);
        return row;
    }

    // ---- check 1: gates answered
    @executedBy(MODEL)
    boolean check1GatesAnswered(Candidate c, VerdictRow row, Theta θ) {
        if (θ["p.phase2b_verify.check1_blank_gates_answered"]) {                           // src: vulnhunt/phases/phase2b_verify.md:55
            for (Gate g : List.of(GATE0, GATE1, GATE2A, GATE2B, GATE3)) {
                if (c.gate(g).isBlank()) { c.answerNow(g); row.redFlag("blank gate"); }   // src: vulnhunt/phases/phase2b_verify.md:56
            }
        }
        if (θ["p.phase2b_verify.check1_no_input_elimination"] && !c.hasAttackerControlledInput()) { // src: vulnhunt/phases/phase2b_verify.md:58
            row.failGate(GATE2A);
            row.routeTo(θ["p.phase2b_verify.check1_no_input_routes_to_code_quality"]);     // src: vulnhunt/phases/phase2b_verify.md:60
        }
        if (c.isAvailabilityDegradationUnderOperationalFailure()) row.routeTo(θ["p.phase2b_verify.check1_no_input_routes_to_code_quality"]); // src: vulnhunt/phases/phase2b_verify.md:60
        return true;
    }

    // ---- check 2: production reachability (Gate 1)
    @executedBy(MODEL)
    Reachability check2Reachability(Candidate c, Scope scope, Theta θ) {
        if (!θ["p.phase2b_verify.check2_reverify_gate1"]) return c.gate(GATE1);           // src: vulnhunt/phases/phase2b_verify.md:65
        Reachability r = reverifyGate1(c, scope, patternsAcrossAllCandidates());
        if (θ["p.phase2b_verify.check2_route_registration_not_reachability"] && r.onlyEvidenceIsRouteRegistration()) r = Reachability.UNPROVEN; // src: vulnhunt/phases/phase2b_verify.md:67
        if (θ["p.phase2b_verify.check2_shared_library_is_production"] && c.inSharedLibraryOrMiddleware() && !c.ownSourceHasDevOnlyGuard()) r = Reachability.PRODUCTION; // src: vulnhunt/phases/phase2b_verify.md:68
        return r;
    }

    // ---- check 3: defenses between source and sink
    @executedBy(MODEL)
    DefenseResult check3Defenses(Candidate c, Scope scope, Theta θ) {
        DefenseResult out = new DefenseResult();
        if (!θ["p.phase2b_verify.check3_identify_every_defense"]) return out;             // src: vulnhunt/phases/phase2b_verify.md:73
        for (Defense d : findDefenses(c.source, c.sink, scope)) {                          // src: vulnhunt/phases/phase2b_verify.md:75
            boolean blocks;
            if (θ["p.phase2b_verify.check3_read_library_source_or_docs"]) blocks = readLibrarySourceOrDocs(d).blocks(c.attack); // src: vulnhunt/phases/phase2b_verify.md:74
            else blocks = d.assumedToBlock();
            if (θ["p.phase2b_verify.check3_defense_auto_escaping"] && d.kind == AUTO_ESCAPING) out.add(d, blocks); // src: vulnhunt/phases/phase2b_verify.md:79
            if (θ["p.phase2b_verify.check3_defense_type_constraints"] && d.kind == TYPE_CONSTRAINT) out.add(d, blocks); // src: vulnhunt/phases/phase2b_verify.md:81
            if (θ["p.phase2b_verify.check3_defense_framework_validation"] && d.kind == FRAMEWORK_VALIDATION) out.add(d, blocks); // src: vulnhunt/phases/phase2b_verify.md:83
            if (θ["p.phase2b_verify.check3_scope_mismatch_is_vulnerability"] && d.isSanitizer() && !d.matchesSinkContext(c.sink)) { // src: vulnhunt/phases/phase2b_verify.md:85
                // the listed examples illustrate the rule; any sanitizer/sink context mismatch counts
                out.markScopeMismatchAsFinding(d, θ["p.phase2b_verify.check3_scope_mismatch_examples"]); // src: vulnhunt/phases/phase2b_verify.md:86
            }
        }
        return out;
    }

    // ---- check 4: severity calibration
    @executedBy(MODEL)
    Severity check4Severity(Candidate c, VerdictRow row, Theta θ) {
        Severity s = c.tier;
        if (!θ["p.phase2b_verify.check4_recheck_severity_tier"]) return s;                // src: vulnhunt/phases/phase2b_verify.md:94
        if (θ["p.phase2b_verify.check4_impact_type_matches_tier"] && c.impact == RCE) s = Severity.HIGH_PLUS; // src: vulnhunt/phases/phase2b_verify.md:95
        if (θ["p.phase2b_verify.check4_attacker_identity_factored"] && c.attackerUnauthenticated()) s = s.raise(); // src: vulnhunt/phases/phase2b_verify.md:96
        if (θ["p.phase2b_verify.check4_preconditions_adjust_tier"]) {                     // src: vulnhunt/phases/phase2b_verify.md:97
            if (c.needsRaceOrChainOrSpecialConfig()) s = s.lower();                        // src: vulnhunt/phases/phase2b_verify.md:98
            if (c.singleUnauthenticatedRequest()) s = s.raise();                           // src: vulnhunt/phases/phase2b_verify.md:99
        }
        if (θ["p.phase2b_verify.check4_gadget_must_exist"] && c.isClassLoadingOrDeserialization() && !usableGadgetExists(c)) row.weaken("no usable gadget"); // src: vulnhunt/phases/phase2b_verify.md:100
        if (θ["p.phase2b_verify.check4_crypto_practically_exploitable"] && c.isCrypto() && !practicallyExploitable(c)) row.weaken("crypto not practical"); // src: vulnhunt/phases/phase2b_verify.md:101
        // IAM-delegated entry points
        if (c.onlyEntryPointNeedsCloudIam() && c.iamPolicyOutOfScope() && c.inputsUnconstrained()) { // src: vulnhunt/phases/phase2b_verify.md:103
            boolean managedQueue = θ["p.phase2b_verify.iam_rule_covers_managed_queue_consumers"].contains(c.consumerKind); // src: vulnhunt/phases/phase2b_verify.md:106
            boolean stillInScope = managedQueue && θ["p.phase2b_verify.queue_consumer_classes_still_in_scope"].contains(c.vulnClass); // src: vulnhunt/phases/phase2b_verify.md:108
            boolean promote = θ["p.phase2b_verify.iam_delegated_promote_if_broadly_granted"] && scanShowsPermissionBroadlyGranted(c); // src: vulnhunt/phases/phase2b_verify.md:105
            if (!promote && !stillInScope) row.routeTo(θ["p.phase2b_verify.iam_delegated_entry_points_to_code_quality"]); // src: vulnhunt/phases/phase2b_verify.md:104
        }
        return s;
    }

    // ---- check 5: downgrade discipline + sweeps per candidate
    @executedBy(MODEL)
    CallSiteEvidence check5DowngradeDiscipline(Candidate c, Scope scope, VerdictRow row, Theta θ) {
        CallSiteEvidence ev = new CallSiteEvidence();
        if (θ["prompt.phase2b.downgrade_discipline"] == null) return ev;                   // src: vulnhunt/phases/phase2b_verify.md:111
        List<CallSite> sites = new List();
        if (θ["p.phase2b_verify.downgrade_step1_grep_all_call_sites"]) sites = grep(c.sinkFunction, scope); // src: vulnhunt/phases/phase2b_verify.md:114
        for (CallSite cs : sites) {
            if (θ["p.phase2b_verify.downgrade_step2_read_each_call_site"]) cs.status = read(cs).attackerDataReaches(); // src: vulnhunt/phases/phase2b_verify.md:115
            if (θ["p.phase2b_verify.downgrade_step3_trace_callers_transitively"] && c.sinkInSharedUtility()) cs.status = traceCallersTransitively(cs); // src: vulnhunt/phases/phase2b_verify.md:117
            if (θ["p.phase2b_verify.downgrade_step4_document_each_call_site"]) ev.document(cs); // src: vulnhunt/phases/phase2b_verify.md:118
        }
        if (θ["p.phase2b_verify.downgrade_only_when_all_call_sites_safe"] && !sites.all(cs -> cs.nonExploitable())) row.blockDowngrade("not all call sites verified"); // src: vulnhunt/phases/phase2b_verify.md:120
        if (θ["p.phase2b_verify.downgrade_evidence_recorded_in_table"]) row.allCallSitesChecked = ev.summary(); // src: vulnhunt/phases/phase2b_verify.md:122
        if (θ["p.phase2b_verify.multi_writer_property_rule"] && row.dismissReason == SERVER_CONTROLLED) { // src: vulnhunt/phases/phase2b_verify.md:124
            List<Writer> writers = grepWritePaths(c.sinkProperty, scope);                  // src: vulnhunt/phases/phase2b_verify.md:125
            if (!writers.all(w -> w.serverControlled())) row.blockDowngrade("property has attacker-reachable writer"); // src: vulnhunt/phases/phase2b_verify.md:126
        }
        return ev;
    }

    // ---- sweeps run across the whole candidate set (still section 5)
    @executedBy(MODEL)
    void postVerificationSweeps(List<Candidate> manifest, VerdictTable table, Theta θ) {
        for (Subgraph sg : subgraphs()) {
            List<Input> safe = sg.safeInputsClosestTo(θ["p.phase2b_verify.safe_spot_check_sink_kinds"]); // src: vulnhunt/phases/phase2b_verify.md:130
            for (Input i : safe.take(θ["p.phase2b_verify.safe_spot_check_count_per_subgraph"])) reverifyGate2bWithFreshReadGrep(i); // src: vulnhunt/phases/phase2b_verify.md:129
        }
        if (θ["p.phase2b_verify.sink_coverage_gap_check"]) {                              // src: vulnhunt/phases/phase2b_verify.md:134
            List<Sink> sinks = grep(θ["p.phase2b_verify.sink_coverage_redirect_sink_patterns"]); // src: vulnhunt/phases/phase2b_verify.md:135
            sinks.addAll(grep(θ["p.phase2b_verify.sink_coverage_auth_sensitive_operations"])); // src: vulnhunt/phases/phase2b_verify.md:136
            for (Sink s : sinks) {
                if (!table.hasDisposition(s) && θ["p.phase2b_verify.sink_without_disposition_trace_backward"]) table.addAll(traceBackwardFromSink(s)); // src: vulnhunt/phases/phase2b_verify.md:138
                else if (s.distinctSources() > 1 && θ["p.phase2b_verify.multi_source_sink_each_path_traced"]) { // src: vulnhunt/phases/phase2b_verify.md:139
                    for (Source src : s.distinctSources) if (!table.pathTraced(src, s)) table.addAll(traceForward(src, s)); // src: vulnhunt/phases/phase2b_verify.md:140
                }
            }
        }
        if (θ["p.phase2b_verify.co_parameter_gap_check"]) {                               // src: vulnhunt/phases/phase2b_verify.md:144
            for (VerdictRow r : table.confirmedOrReducedConfidence()) {
                for (Param prm : r.endpoint.userControlledParams()) {                      // src: vulnhunt/phases/phase2b_verify.md:145
                    if (!table.hasOwnDisposition(prm)) table.addAll(evaluate(prm));       // src: vulnhunt/phases/phase2b_verify.md:146
                    if (prm.isResourceId() && θ["p.phase2b_verify.co_parameter_resource_ids_need_ownership_eval"] && !prm.hasOwnershipEval()) table.addAll(evaluateOwnership(prm)); // src: vulnhunt/phases/phase2b_verify.md:147
                }
            }
        }
        if (θ["p.phase2b_verify.sibling_auth_pattern_comparison"]) {                      // src: vulnhunt/phases/phase2b_verify.md:149
            for (ControllerFile cf : filesEncounteredDuringVerification()) {
                for (Handler h : cf.handlers()) {
                    if (!h.requiresAuth() && cf.siblingsRequireAuth()) table.addCandidate(h, 306); // src: vulnhunt/phases/phase2b_verify.md:151
                }
            }
        }
        if (θ["p.phase2b_verify.elevate_prose_noted_gap_to_candidate"]) {                 // src: vulnhunt/phases/phase2b_verify.md:152
            for (ProseNote n : traceAgentProseAuthGapsWithoutCandidateEntry()) table.addCandidate(n.handler, 306); // src: vulnhunt/phases/phase2b_verify.md:153
        }
    }

    // ---- check 6: conditional validation bypass
    @executedBy(MODEL)
    void check6Cvb(Candidate c, VerdictRow row, Theta θ) {
        if (!θ["p.phase2b_verify.check6_cvb_enumerate_skipped_checks"]) return;          // src: vulnhunt/phases/phase2b_verify.md:157
        Table t = new Table(θ["p.phase2b_verify.check6_cvb_table_columns"]);              // src: vulnhunt/phases/phase2b_verify.md:160
        int uncovered = 0;
        for (Check k : c.checksSkippedWhenGatingInputAbsent()) {
            t.add(k, k.enforces(), thisServiceValidates(k), downstreamCovers(k), k.evidenceFileLine());
            if (!downstreamCovers(k)) uncovered++;
        }
        for (String reason : row.dismissReasons()) {
            if (θ["p.phase2b_verify.check6_cvb_prohibited_dismissals"].contains(reason)) row.rejectDismissal(reason); // src: vulnhunt/phases/phase2b_verify.md:163
        }
        if (uncovered >= θ["p.phase2b_verify.check6_cvb_one_no_stands"]) row.blockElimination("CVB: uncovered check"); // src: vulnhunt/phases/phase2b_verify.md:163
        else if (θ["p.phase2b_verify.check6_cvb_eliminate_only_if_all_covered"]) row.allowElimination(); // src: vulnhunt/phases/phase2b_verify.md:158
    }

    // ---- check 7: comment skepticism
    @executedBy(MODEL)
    void check7CommentSkepticism(Candidate c, VerdictRow row, Theta θ) {
        if (!θ["p.phase2b_verify.check7_comment_skepticism"]) return;                     // src: vulnhunt/phases/phase2b_verify.md:169
        List<Gate> proseGates = new List();
        for (GateAnswer a : row.gateAnswers()) {
            if (θ["p.phase2b_verify.prose_by_design_gate0"] && a.gate == GATE0 && a.citesProse("by design", "intentional", "backward compat")) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:174
            if (θ["p.phase2b_verify.prose_sanitize_naming_gate2b"] && a.gate == GATE2B && a.citesNaming("sanitize()", "validate()", "safe*()")) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:175
            if (θ["p.phase2b_verify.prose_downstream_validates_gate3"] && (a.gate == GATE3 || a.isElimination()) && a.citesProse("downstream validates", "API gateway checks")) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:176
            if (θ["p.phase2b_verify.prose_internal_only_gate1"] && a.gate == GATE1 && a.citesProse("internal only", "not user-facing")) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:177
            if (θ["p.phase2b_verify.prose_type_safe_schema_validated"] && (a.gate == GATE2B || a.isMandatoryGate()) && a.citesProse("type-safe", "schema validated")) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:178
            if (θ["p.phase2b_verify.prose_infra_auth_resource_id_gate"] && (a.gate == RESOURCE_ID_GATE_A || (a.gate == GATE0 && c.isIdor())) && a.citesProse("ALB authenticates", "infrastructure handles auth", "pre-authenticated traffic", "/protected/ path", "Swagger Bearer definition")) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:179
            if (θ["p.phase2b_verify.prose_admin_endpoint_naming_gate0"] && a.gate == GATE0 && a.citesNaming("admin endpoint", "management API", "internal tool") && !a.citesEnforcementFileLine()) proseGates.add(a.gate); // src: vulnhunt/phases/phase2b_verify.md:180
        }
        if (θ["p.phase2b_verify.check7_reverify_empirically"]) {                          // src: vulnhunt/phases/phase2b_verify.md:182
            for (Gate g : proseGates) row.setGate(g, reverifyEmpirically(c, g));
        }
    }

    @executedBy(MODEL)
    Verdict decideVerdict(Candidate c, VerdictRow row, Theta θ) {
        List<Verdict> allowed = θ["prompt.phase2b.verdicts"];                              // src: vulnhunt/phases/phase2b_verify.md:249
        if (!row.disproved()) return CONFIRMED;
        Location elim = row.eliminatingFileLine();
        if (θ["prompt.phase2b.fp_needs_citation"] && elim == null) {                       // src: vulnhunt/phases/phase2b_verify.md:261
            if (θ["p.phase2b_verify.fp_without_citation_not_eliminated"]) return CONFIRMED; // src: vulnhunt/phases/phase2b_verify.md:264
        }
        return FALSE_POSITIVE;
    }

    @executedBy(MODEL)
    void checkTableCompleteness(List<Candidate> manifest, VerdictTable table, Theta θ) {
        if (θ["p.phase2b_verify.verdict_table_row_count_equals_manifest"] && table.rows() < manifest.target) { // src: vulnhunt/phases/phase2b_verify.md:26
            for (Candidate c : manifest.missingFrom(table)) {
                // a candidate never listed was never evaluated: verification failure, not implicit rejection
                if (θ["p.phase2b_verify.unlisted_candidate_is_verification_failure"]) table.add(verifyCandidate(c, θ)); // src: vulnhunt/phases/phase2b_verify.md:28
            }
        }
    }
}

@executedBy(MODEL) @role(rule_set) @stage("phase2b")
class Phase2bVerifySeverity {

    Prompt tiers(Object tierNames) {
        Prompt p = new Prompt();
        p.choose(tierNames);                                                               // src: vulnhunt/phases/phase2b_verify.md:9
        return p;
    }

    // check 8: Authorization Delegation Rule (CWE-639 severity ladder)
    @executedBy(MODEL)
    void authzDelegationLadder(Candidate c, VerdictRow row, Theta θ) {
        if (row.ladderApplied && θ["p.phase2b_verify.authz_delegation_ladder_applied_once"] == "once") return; // src: vulnhunt/phases/phase2b_verify.md:186
        row.ladderApplied = true;
        AuthGate gate = null;
        if (θ["p.phase2b_verify.authz_delegation_read_auth_gate"]) gate = readAuthGateHandlerCalls(c); // src: vulnhunt/phases/phase2b_verify.md:187
        boolean crypto = cryptoOriginAuth(gate, θ);
        boolean scope = callerScopeCheck(c, gate, θ);
        if (crypto && scope) row.severity = θ["p.phase2b_verify.ladder_crypto_and_scope"];   // src: vulnhunt/phases/phase2b_verify.md:191
        else if (crypto) row.severity = θ["p.phase2b_verify.ladder_crypto_only"];          // src: vulnhunt/phases/phase2b_verify.md:192
        else row.severity = θ["p.phase2b_verify.ladder_no_crypto"];                        // src: vulnhunt/phases/phase2b_verify.md:193
        if (row.downgraded() && θ["p.phase2b_verify.trust_model_note_on_downgrade"]) c.trustModelNote = oneLineTrustModel(gate); // src: vulnhunt/phases/phase2b_verify.md:215
    }

    @executedBy(MODEL)
    boolean cryptoOriginAuth(AuthGate gate, Theta θ) {
        if (gate == null) return false;
        boolean ok = θ["p.phase2b_verify.crypto_origin_auth_definition"].contains(gate.kind) && gate.verifiedInAuditedCodeAt() != null; // src: vulnhunt/phases/phase2b_verify.md:195
        if (gate.importPathMatches(θ["p.phase2b_verify.known_pop_library_import_pattern"]) && gate.validateCalledOnProductionPath() && !gate.insideEnvSkipGuard()) { // src: vulnhunt/phases/phase2b_verify.md:199
            if (θ["p.phase2b_verify.known_pop_library_no_source_read"]) ok = true;         // src: vulnhunt/phases/phase2b_verify.md:202
            else ok = readLibrarySource(gate).validatesSignature();
        }
        if (θ["p.phase2b_verify.header_presence_checks_do_not_qualify"] && gate.isHeaderPresenceOrOptionalHeaderOnly()) ok = false; // src: vulnhunt/phases/phase2b_verify.md:196
        if (θ["p.phase2b_verify.bypassable_gate_counts_as_no_crypto"] && gate.bypassableOnAnyPath()) ok = false; // src: vulnhunt/phases/phase2b_verify.md:197
        if (θ["p.phase2b_verify.gateway_comments_do_not_count"] && gate.onlyCommentsOrNaming()) ok = false; // src: vulnhunt/phases/phase2b_verify.md:213
        return ok;
    }

    @executedBy(MODEL)
    boolean callerScopeCheck(Candidate c, AuthGate gate, Theta θ) {
        boolean uidPresent = c.requestHasHeader(θ["p.phase2b_verify.caller_scope_option_a_end_user_uid"]); // src: vulnhunt/phases/phase2b_verify.md:204
        if (uidPresent && c.uidBoundToOperationAt() != null) return true;                 // src: vulnhunt/phases/phase2b_verify.md:206
        boolean allowList = c.headerValidatedAgainstInCodeAllowList(θ["p.phase2b_verify.caller_scope_option_b_app_id_allowlist"]); // src: vulnhunt/phases/phase2b_verify.md:207
        if (allowList) {
            if (θ["p.phase2b_verify.option_b_only_when_uid_absent"] && uidPresent) return false; // src: vulnhunt/phases/phase2b_verify.md:208
            return !(θ["p.phase2b_verify.gateway_comments_do_not_count"] && c.allowListOnlyInComments()); // src: vulnhunt/phases/phase2b_verify.md:213
        }
        return false;
    }
}

@executedBy(MODEL) @role(rule_set) @stage("phase2b")
class Phase2bVerifyRollup {

    // check 9: Universal Auth Gap rollup (the one allowed merge)
    @executedBy(MODEL)
    void run(Phase1Inventory phase1, VerdictTable table, Theta θ) {
        if (θ["prompt.universal_auth_rollup"] == null) return;                             // src: vulnhunt/phases/phase2b_verify.md:219
        if (θ["p.phase2b_verify.rollup_run_once_before_verdict_table"] == "once" && table.rollupDone) return; // src: vulnhunt/phases/phase2b_verify.md:224
        table.rollupDone = true;
        List<Handler> inScope = new List();
        for (EntryPoint e : phase1.step1bEntryPoints) {                                    // src: vulnhunt/phases/phase2b_verify.md:221
            boolean qualifies = !θ["p.phase2b_verify.rollup_in_scope_handlers_definition"] || e.readsWritesUserData() || e.mutatesState() || e.returnsIdentifiableResource(); // src: vulnhunt/phases/phase2b_verify.md:221
            if (θ["p.phase2b_verify.rollup_excludes_auth_system_handlers"].contains(e.purpose)) qualifies = false; // src: vulnhunt/phases/phase2b_verify.md:223
            if (qualifies) inScope.add(e.handler);
        }
        if (inScope.isEmpty() && θ["p.phase2b_verify.rollup_a_precedence_and_zero_handlers_na"]) return; // src: vulnhunt/phases/phase2b_verify.md:244
        int withAuth = inScope.count(h -> hasValidAuthCode(h, θ));
        boolean fireA = withAuth == 0;                                                     // src: vulnhunt/phases/phase2b_verify.md:227
        boolean fireB = !fireA && inScope.none(h -> h.bindsVerifiedUid() || h.allowListsCallerAppHeader()); // src: vulnhunt/phases/phase2b_verify.md:239
        if (θ["p.phase2b_verify.rollup_b_authz_absent_condition"] == false) fireB = false;
        if (fireA && fireB && θ["p.phase2b_verify.rollup_a_precedence_and_zero_handlers_na"]) fireB = false; // src: vulnhunt/phases/phase2b_verify.md:244
        if (fireA) {
            Finding f = table.emitPlatform(θ["p.phase2b_verify.rollup_a_emits_platform_authn"]); // src: vulnhunt/phases/phase2b_verify.md:236
            subsume(table, f, θ["p.phase2b_verify.rollup_a_subsumed_cwes"], θ);            // src: vulnhunt/phases/phase2b_verify.md:237
        } else if (fireB) {
            Finding f = table.emitPlatform(θ["p.phase2b_verify.rollup_b_emits_platform_authz"]); // src: vulnhunt/phases/phase2b_verify.md:241
            subsume(table, f, θ["p.phase2b_verify.rollup_b_subsumed_cwes"], θ);            // src: vulnhunt/phases/phase2b_verify.md:242
        }
    }

    @executedBy(MODEL)
    boolean hasValidAuthCode(Handler h, Theta θ) {
        for (AuthCall a : h.callChain().authCalls()) {                                     // src: vulnhunt/phases/phase2b_verify.md:230
            if (!θ["p.phase2b_verify.rollup_auth_code_definition"].contains(a.kind)) continue; // src: vulnhunt/phases/phase2b_verify.md:229
            if (θ["p.phase2b_verify.rollup_a_all_weak_counts_as_absent"] && (a.verifyFalse() || a.signatureCheckCommentedOut())) continue; // src: vulnhunt/phases/phase2b_verify.md:227
            return true;
        }
        return false;
    }

    @executedBy(MODEL)
    void subsume(VerdictTable table, Finding platform, Object cwes, Theta θ) {
        if (!θ["p.phase2b_verify.rollup_exempt_from_anti_merge"]) return;                 // src: vulnhunt/phases/phase2b_verify.md:245
        for (VerdictRow r : table.confirmed()) {
            if (cwes.contains(r.cwe)) r.mark(θ["p.phase2b_verify.rollup_subsumed_marked_in_verdict_table"]); // src: vulnhunt/phases/phase2b_verify.md:246
        }
        if (θ["p.phase2b_verify.rollup_platform_poc_stands_in"]) platform.pocStandsInFor(table.subsumedBy(platform)); // src: vulnhunt/phases/phase2b_verify.md:247
    }
}

@executedBy(MODEL) @role(step) @stage("phase2b")
class Phase2bVerifyOutput {

    @executedBy(MODEL)
    void present(VerdictTable table, Theta θ) {
        enforceAntiMerge(table, θ);
        if (θ["p.phase2b_verify.present_verdict_table_before_phase3"]) showUser(table.render(θ["p.phase2b_verify.verdict_table_columns"])); // src: vulnhunt/phases/phase2b_verify.md:251
    }

    @executedBy(MODEL)
    void enforceAntiMerge(VerdictTable table, Theta θ) {
        if (θ["prompt.anti_merge_rule"] == null) return;                                   // src: vulnhunt/phases/phase2b_verify.md:267
        for (Pair<VerdictRow, VerdictRow> pr : table.mergedPairs()) {
            if (pr.isPlatformRollup()) continue;                                           // src: vulnhunt/phases/phase2b_verify.md:267
            if (pr.differInAny(θ["p.phase2b_verify.anti_merge_dimensions"])) table.split(pr); // src: vulnhunt/phases/phase2b_verify.md:268
            if (θ["p.phase2b_verify.different_params_same_endpoint_separate"] && pr.sameEndpoint() && pr.differentParams()) table.split(pr); // src: vulnhunt/phases/phase2b_verify.md:270
            if (θ["p.phase2b_verify.second_step_not_subsumed_if_independently_exploitable"] && pr.second().independentlyExploitableViaPreexistingData()) table.split(pr); // src: vulnhunt/phases/phase2b_verify.md:271
            if (θ["p.phase2b_verify.mass_assignment_and_idor_always_separate"] && pr.cwes().equals(Set.of(915, 639))) table.split(pr); // src: vulnhunt/phases/phase2b_verify.md:276
        }
        if (θ["p.phase2b_verify.silent_omission_is_merging"]) {                           // src: vulnhunt/phases/phase2b_verify.md:275
            for (Candidate c : table.candidatesWithoutRow()) table.add(c.ownRow());
        }
        if (θ["p.phase2b_verify.each_finding_own_verdict_row"]) table.assertOneRowPerFinding(); // src: vulnhunt/phases/phase2b_verify.md:274
    }

    @executedBy(MODEL)
    VerifyOutcome drop(VerdictTable table, Theta θ) {
        List<Finding> survivors = table.all();
        if (θ["p.phase2b_verify.drop_false_positives_only_confirmed_proceed"]) survivors = table.withVerdict(CONFIRMED).excluding(table.subsumed()); // src: vulnhunt/phases/phase2b_verify.md:281
        if (survivors.isEmpty() && θ["p.phase2b_verify.zero_survivors_report"]) return VerifyOutcome.noneFound(table.codeQualityRecommendations()); // src: vulnhunt/phases/phase2b_verify.md:282
        return VerifyOutcome.toPhase3(survivors, table);
    }
}
