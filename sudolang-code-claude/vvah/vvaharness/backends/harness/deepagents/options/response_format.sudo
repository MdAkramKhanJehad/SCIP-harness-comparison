# vvaharness/backends/harness/deepagents/options/response_format.py

Chooses the structured-output strategy for a graph or subagent: a forced tool call (`ToolStrategy`) on Anthropic routes, unless the model is known to reject forcing, otherwise the bare schema. When forcing will not happen (manual thinking drops it client-side, or the model rejects it), it appends a textual submit instruction to the system prompt.

Source: `vvaharness/backends/harness/deepagents/options/response_format.py` (lines 1-164)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/graph_builder.sudo` _create_agent (submit_instructed_prompt); `streaming.sudo` (_response_format); `oneshot.sudo` (_oneshot_response_format); `subagents.sudo` (_strategy_for, _tool_name_for)

// src: vvaharness/backends/harness/deepagents/options/response_format.py:56-61
fn _strategy_for(schema, model_id, provider):executor=code {
  if (provider_routing.routes_to_anthropic(model_id, provider) && model_id not in _FORCED_TOOL_CHOICE_UNSUPPORTED_MODELS) return ToolStrategy(schema)
  return schema   // bare schema: langchain uses native structured output where supported  // external: langchain.agents.structured_output
  // _FORCED_TOOL_CHOICE_UNSUPPORTED_MODELS is the same set object as deepagents.tool_choice_rejection.UNSUPPORTED_MODELS (model_building.py:300); it grows at runtime
}

// src: vvaharness/backends/harness/deepagents/options/response_format.py:146-152
fn _response_format(response_model, model_id, provider):executor=code {
  if (response_model == null) return null
  return _strategy_for(response_model, model_id, provider)
}

// src: vvaharness/backends/harness/deepagents/options/response_format.py:155-164
fn _oneshot_response_format(options):executor=code {
  if (options.response_model != null) return _strategy_for(options.response_model, options.model, options.model_provider)
  if (options.output_schema != null) return _strategy_for(_pydantic_response_format(options.output_schema), options.model, options.model_provider)
  return null
}

// src: vvaharness/backends/harness/deepagents/options/response_format.py:124-143
fn submit_instructed_prompt(system_prompt, model, response_model, response_format):executor=code {
  if (response_model == null) return system_prompt
  if (forcing_dropped_under_thinking(model, response_format)) {
    COUNTERS.bump("deepagents_tool_choice_dropped"); warn once per model (console WARN [deepagents] ... manual thinking drops the forced tool_choice)
  } else if (_forcing_unsupported(model)) {
    COUNTERS.bump("deepagents_tool_choice_unsupported"); warn once per model (console WARN [deepagents] ... rejects a forced tool_choice with a 400)
  } else {
    return system_prompt
  }
  return with_submit_instruction(system_prompt, response_model, tool_name=_tool_name_for(response_model))   // see SubmitInstruction
}

// prompt-src: vvaharness/backends/llm/models.py:165-174
SubmitInstruction {
  // Appended after two newlines to the system prompt (or used alone when there is none). Defined outside this batch; shown because this file decides when it is added.
  Constraints {
    "When you have your final $response_model_name, call the `$tool_name` tool with it; a plain-text reply is not accepted."
  }
}
// The console warnings (response_format.py:84-98, 106-116) state that a reply skipping the outcome tool "is re-asked in-session by the stage's own evidence or plan gate, not by this hook." No check is made here.

// src: vvaharness/backends/harness/deepagents/options/response_format.py:64-76
fn forcing_dropped_under_thinking(model, response_format):executor=code {
  if (response_format is not a ToolStrategy) return false
  return model.thinking.type in ["enabled", "adaptive"]
  // preserved: "adaptive" counts as dropped here, although forcing.sudo ForcingChatAnthropic re-forces the choice under adaptive thinking; the submit instruction is therefore also appended on adaptive Anthropic builds
}

// src: vvaharness/backends/harness/deepagents/options/response_format.py:101-103, 79-81
fn _forcing_unsupported(model):executor=code { return (model.model or model.model_name or "unknown") in _FORCED_TOOL_CHOICE_UNSUPPORTED_MODELS }

// src: vvaharness/backends/harness/deepagents/options/response_format.py:119-121
fn _tool_name_for(response_model):executor=code { return ToolStrategy(response_model).schema_specs[0].name }

