// file: vulnhunter-fix/scripts/_skill_bootstrap.py
// Import-time bootstrap: re-executes the calling script under the bundled .venv Python (3.11) when the
// current interpreter differs, then prepends the venv site-packages and the skill root to sys.path.

@executedBy(CODE) @role(config)
class SkillBootstrap {

    String venvPython() {
        if (Os.name() == "nt") return Path.join(skillRoot(), ".venv", "Scripts", "python.exe");          // src: vulnhunter-fix/scripts/_skill_bootstrap.py:40
        return Path.join(skillRoot(), ".venv", "bin", "python3");                                        // src: vulnhunter-fix/scripts/_skill_bootstrap.py:43
    }

    String skillRoot() {
        return Path.dirname(Path.dirname(Path.abspath(thisFile())));                                     // src: vulnhunter-fix/scripts/_skill_bootstrap.py:38
    }

    boolean sameInterpreter(String a, String b) {
        try {
            return Path.normcase(Path.realpath(a)) == Path.normcase(Path.realpath(b));                   // src: vulnhunter-fix/scripts/_skill_bootstrap.py:50
        } catch (OSError e) {
            return false;                                                                                // src: vulnhunter-fix/scripts/_skill_bootstrap.py:52
        }
    }

    // Runs at import time; callers must import this module first.
    void run(List<String> argv) {
        String venvPy = venvPython();
        // 1. re-exec once under the bundled interpreter; env guard prevents an exec loop
        if (Path.isFile(venvPy) && !sameInterpreter(Sys.executable(), venvPy) && Env.get("VULNFIX_SKILL_REEXEC") != "1" && argv.get(0) != "-c") { // src: vulnhunter-fix/scripts/_skill_bootstrap.py:58
            Env.set("VULNFIX_SKILL_REEXEC", "1");                                                        // src: vulnhunter-fix/scripts/_skill_bootstrap.py:66
            if (Os.name() == "nt") {
                // os.execv does not block on Windows; use a blocking subprocess and exit with its code
                Sys.exit(Subprocess.run(List.of(venvPy).plus(argv)).returncode);                         // src: vulnhunter-fix/scripts/_skill_bootstrap.py:76
            } else {
                Os.execv(venvPy, List.of(venvPy).plus(argv));                                            // src: vulnhunter-fix/scripts/_skill_bootstrap.py:78
            }
        }
        // 2. matching-minor site-packages at index 0
        String matching = Os.name() == "nt" ? Path.join(skillRoot(), ".venv", "Lib", "site-packages") : Path.join(skillRoot(), ".venv", "lib", "python" + Sys.versionMajorMinor(), "site-packages"); // src: vulnhunter-fix/scripts/_skill_bootstrap.py:88
        prependOnce(matching);                                                                           // src: vulnhunter-fix/scripts/_skill_bootstrap.py:99
        // 3. skill root so vulnhunter_fix.* imports resolve
        prependOnce(skillRoot());                                                                        // src: vulnhunter-fix/scripts/_skill_bootstrap.py:103
    }

    void prependOnce(String path) {
        if (Path.isDir(path) && !Sys.path().contains(path)) Sys.path().insert(0, path);                 // src: vulnhunter-fix/scripts/_skill_bootstrap.py:82
    }
}
