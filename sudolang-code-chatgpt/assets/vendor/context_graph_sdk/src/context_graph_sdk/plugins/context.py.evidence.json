  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Bounded local plugin execution context implementations.\"\"\"\n\nfrom __future__ import annotations\n\nimport threading\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nfrom context_graph_sdk.errors import ModelValidationError\nfrom context_graph_sdk.models import FrozenMap\nfrom context_graph_sdk.pipeline import PluginDiagnostic, PluginLogLevel\n\nMAX_PLUGIN_REPORTS = 1_000\nMAX_SOURCE_READ_BYTES = 10 * 1024 * 1024\n\n\nclass CancellationToken:\n    def __init__(self) -> None:\n        self._event = threading.Event()\n\n    @property\n    def is_cancelled(self) -> bool:\n        return self._event.is_set()\n\n    def cancel(self) -> None:\n        self._event.set()\n\n\nclass RepositorySourceReader:\n    def __init__(self, root: Path) -> None:\n        self._root = root.resolve()\n\n    def read_text(self, relative_path: str, max_bytes: int) -> str:\n        if not 0 < max_bytes <= MAX_SOURCE_READ_BYTES:\n            raise ModelValidationError(\"source read byte limit is outside the approved bound\")\n        candidate = (self._root / relative_path).resolve()\n        if candidate == self._root or self._root not in candidate.parents:\n            raise ModelValidationError(\"plugin source path escapes the repository\")\n        with candidate.open(\"rb\") as source:\n            return source.read(max_bytes).decode(\"utf-8\", errors=\"replace\")\n\n\n@dataclass(frozen=True)\nclass PluginLogRecord:\n    level: PluginLogLevel\n    message: str\n    details: FrozenMap\n\n\nclass BufferedPluginReporter:\n    # One shared instance applies this aggregate budget across an entire run.\n    def __init__(self) -> None:\n        self._logs: list[PluginLogRecord] = []\n        self._diagnostics: list[PluginDiagnostic] = []\n\n    @property\n    def logs(self) -> tuple[PluginLogRecord, ...]:\n        return tuple(self._logs)\n\n    @property\n    def diagnostics(self) -> tuple[PluginDiagnostic, ...]:\n        return tuple(self._diagnostics)\n\n    def log(self, level: PluginLogLevel, message: str, details: FrozenMap) -> None:\n        if not message:\n            raise ModelValidationError(\"plugin log message is required\")\n        self._reserve()\n        self._logs.append(PluginLogRecord(level, message, details))\n\n    def diagnostic(self, diagnostic: PluginDiagnostic) -> None:\n        self._reserve()\n        self._diagnostics.append(diagnostic)\n\n    def _reserve(self) -> None:\n        if len(self._logs) + len(self._diagnostics) >= MAX_PLUGIN_REPORTS:\n            raise ModelValidationError(\"plugin report count exceeds bound\")\n",
