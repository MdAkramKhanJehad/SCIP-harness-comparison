// file: vulnhunter-agent/agent/_llm.py
// Small one-shot JSON LLM calls (findings extraction, dedup, verify parsing) via the SDK with no tools:
// same-model transient retry, then one fallback model.

@executedBy(CODE) @role(backend) @stage("agent")
class Llm {

    // _send_prompt: one model call, no tools, no skills, no setting sources; empty temp cwd.
    String sendPrompt(String model, String system, String user, Theta θ, String authToken, CostStats cost) {
        String settings = BuildSettings.buildClaudeSettings(θ, authToken, model, "");            // src: vulnhunter-agent/agent/_llm.py:267
        ModelSpec spec = new ModelSpec(model, "claude-agent-sdk", null, null, null);
        // tools=[], allowed_tools=[], permission_mode=bypassPermissions, setting_sources=[], skills=[]
        Response r = Runtime.llm(spec, system, user, null);                                      // src: vulnhunter-agent/agent/_llm.py:269
        if (cost != null) cost.addResult(r.result);                                              // src: vulnhunter-agent/agent/_llm.py:292
        if (r.result.isError && Transient.isTransientStatus(r.result.apiErrorStatus)) throw new TransientLLMError(); // src: vulnhunter-agent/agent/_llm.py:297
        return r.text;                                                                           // src: vulnhunter-agent/agent/_llm.py:306
    }

    Retrying buildAsyncRetrying(List<Double> backoffs, Hook beforeSleep) {
        Wait wait = backoffs.isEmpty() ? Wait.none() : Wait.chain(backoffs);                     // src: vulnhunter-agent/agent/_llm.py:322
        return new Retrying(isTransient, wait, 1 + backoffs.size(), beforeSleep, true);           // src: vulnhunter-agent/agent/_llm.py:326
    }

    // call_json: retry the same model on transient errors per the backoff list; parse the reply as JSON.
    Object callJson(String model, String system, String user, Theta θ, TokenManager tm, CostStats cost, String stage) {
        List<Double> backoffs = θ["code.llm_transient_backoffs"];                                // src: vulnhunter-agent/agent/_llm.py:107
        Retrying retrying = buildAsyncRetrying(backoffs, makeRetryLogger(model, stage, config.logging.retries)); // log_retries comes from config.logging.retries, forwarded by callJsonWithFallback                                        // src: vulnhunter-agent/agent/_llm.py:419
        for (Attempt attempt : retrying) {                                                       // src: vulnhunter-agent/agent/_llm.py:426
            String text;
            try {
                text = sendPrompt(model, system, user, θ, tm.getValidToken(), cost);             // src: vulnhunter-agent/agent/_llm.py:430
            } catch (LLMError e) {
                throw e;
            } catch (Exception e) {
                throw classifyBoundaryError(model, e);                                           // src: vulnhunter-agent/agent/_llm.py:448
            }
            if (text.strip() == "") throw new LLMError("empty response");                       // src: vulnhunter-agent/agent/_llm.py:449
            return Json.parse(extractJsonBlock(text));                                           // src: vulnhunter-agent/agent/_llm.py:453
        }
        throw new LLMError("retrying loop exited without resolution");                          // src: vulnhunter-agent/agent/_llm.py:473
    }

    // call_json_with_fallback: primary model (with retries); on any LLMError, the fallback model (with retries).
    Object callJsonWithFallback(String primaryModel, String fallbackModel, String system, String user, Theta θ, TokenManager tm, CostStats cost, String stage, AuditWriter w) {
        try {
            return callJson(primaryModel, system, user, θ, tm, cost, stage);                     // src: vulnhunter-agent/agent/_llm.py:510
        } catch (LLMError e) {
            if (w != null) w.emitAudit(Audit.buildModelFallback(primaryModel, fallbackModel, stage, e)); // src: vulnhunter-agent/agent/_llm.py:531
            return callJson(fallbackModel, system, user, θ, tm, cost, stage);                    // src: vulnhunter-agent/agent/_llm.py:543
        }
    }

    // retry predicate: pure isinstance walk of the cause then context chain (cycle-safe) for a TransientLLMError
    boolean isTransient(Throwable exc) {
        Set<Object> seen = new Set();
        Throwable cur = exc;
        while (cur != null && !seen.contains(identity(cur))) {                                   // src: vulnhunter-agent/agent/_llm.py:172
            seen.add(identity(cur));
            if (cur instanceof TransientLLMError) return true;                                   // src: vulnhunter-agent/agent/_llm.py:175
            cur = cur.cause != null ? cur.cause : cur.context;                                   // src: vulnhunter-agent/agent/_llm.py:177
        }
        return false;
    }

    // before_sleep hook factory: null when log_retries is false so tenacity calls nothing (no retry chatter unless asked)
    Hook makeRetryLogger(String model, String stage, boolean logRetries) {
        if (!logRetries) return null;                                                            // src: vulnhunter-agent/agent/_llm.py:345
        String stageTag = !stage.isEmpty() ? "[" + stage + "] " : "";                            // src: vulnhunter-agent/agent/_llm.py:347
        return retryState -> hook(retryState, model, stageTag);
    }

    // nested _hook: logs "attempt K of N total" at INFO with the next sleep delay (0 when no next action) and the failing exception
    void hook(RetryState retryState, String model, String stageTag) {
        double delay = retryState.nextAction != null ? retryState.nextAction.sleep : 0.0;        // src: vulnhunter-agent/agent/_llm.py:351
        Throwable exc = retryState.outcome != null ? retryState.outcome.exception() : null;      // src: vulnhunter-agent/agent/_llm.py:356
        Integer maxAttempts = retryState.retryObject.stop.maxAttemptNumber;                      // src: vulnhunter-agent/agent/_llm.py:366
        Log.info(stageTag + model + " transient error (" + exc + "); retrying in " + round(delay) + "s (attempt " + retryState.attemptNumber + "/" + (maxAttempts ? maxAttempts : "?") + ")"); // src: vulnhunter-agent/agent/_llm.py:369
    }

    LLMError classifyBoundaryError(String model, Exception e) {
        // typed status (429/5xx) first, then text fallback on the exception chain
        return looksTransientAtBoundary(e) ? new TransientLLMError(model) : new LLMError(model); // src: vulnhunter-agent/agent/_llm.py:151
    }

    // estimate_tokens: rough char-to-token estimate (~4 chars per token).
    int estimateTokens(String text) {
        return max(1, len(text) / 4);                                                                    // src: vulnhunter-agent/agent/_llm.py:554
    }
}
