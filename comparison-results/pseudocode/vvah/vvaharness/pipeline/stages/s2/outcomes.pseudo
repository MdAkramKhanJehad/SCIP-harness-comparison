// file: vvaharness/pipeline/stages/s2/outcomes.py
// S2's reply parsing and the deterministic finalisation of its threats (ids by position, surface_files resolved to inventory).

@executedBy(CODE) @role(step) @stage("S2")
class S2Outcomes {

    ThreatModel parseThreatModel(String raw) {
        Object data = JsonExtract.extractJson(raw);                                           // src: vvaharness/pipeline/stages/s2/outcomes.py:33
        // a non-empty object with none of the threat-model fields is a truncated sub-object
        if (data is Map && !data.isEmpty() && !data.keySet().intersects(ThreatModel.fields())) throw new ValueError("no threat-model fields"); // src: vvaharness/pipeline/stages/s2/outcomes.py:35
        return ThreatModel.validate(data);                                                    // src: vvaharness/pipeline/stages/s2/outcomes.py:41
    }

    void finalizeThreats(ThreatModel tm, ContextPackage ctx) {
        int i = 1;
        for (Threat t : tm.threats) t.id = "T" + (i++);                                       // src: vvaharness/pipeline/stages/s2/outcomes.py:44
        if (ctx == null || tm.threats.isEmpty()) return;                                      // src: vvaharness/pipeline/stages/s2/outcomes.py:46
        Set<String> valid = Set.copyOf(ctx.allFiles);                                         // src: vvaharness/pipeline/stages/s2/outcomes.py:48
        int emitted = 0;
        List<String> dropped = new List();
        for (Threat t : tm.threats) {                                                         // src: vvaharness/pipeline/stages/s2/outcomes.py:51
            List<Pair<String, String>> pairs = t.surfaceFiles.map(r -> new Pair(r, ScopeWalk.resolveInventoryPath(ctx.repoRoot, r, valid))); // src: vvaharness/pipeline/stages/s2/outcomes.py:52
            t.surfaceFiles = distinct(pairs.filter(p -> valid.contains(p.second)).map(p -> p.second)); // src: vvaharness/pipeline/stages/s2/outcomes.py:53
            dropped.addAll(pairs.filter(p -> !valid.contains(p.second)).map(p -> p.first));  // src: vvaharness/pipeline/stages/s2/outcomes.py:54
            emitted += pairs.size();
        }
        if (dropped.isEmpty()) return;                                                        // src: vvaharness/pipeline/stages/s2/outcomes.py:58
        Counters.bump("s2_surface_files_dropped", dropped.size());                            // src: vvaharness/pipeline/stages/s2/outcomes.py:60
        if (dropped.size() == emitted) ErrLog.log("s2", "every surface_files path was rejected"); // S3 mints nothing  // src: vvaharness/pipeline/stages/s2/outcomes.py:64
    }

    void warnOutputCaps(Triple<Integer, Integer, Integer> raw, ThreatModel tm, Triple<Integer, Integer, Integer> limits) {
        // threats / assets / trust_boundaries: warn naming step2.<key> for each cap that dropped items
        for (String kind : List.of("threats", "assets", "trust_boundaries")) {               // src: vvaharness/pipeline/stages/s2/outcomes.py:85
            if (kept(tm, kind) >= raw.get(kind)) continue;                                    // src: vvaharness/pipeline/stages/s2/outcomes.py:86
            Log.warn("S2_CAP_TRUNCATED", kind);                                               // src: vvaharness/pipeline/stages/s2/outcomes.py:90
        }
    }
}
