fn render_rows(findings, cursor?):executor=code {
  // abstracted: render.py:20-48 — terminal colours and screen clearing (_clear_and_draw draws a header "Remediation Agent remediation — N issue(s), D done" and the hint "↑/↓ move · Enter remediate · q quit"); no decisions
  return one row per finding: report ordinal, a check mark when done, "[SEVERITY] title", "(file)" when known; the cursor row is highlighted with "❯"
