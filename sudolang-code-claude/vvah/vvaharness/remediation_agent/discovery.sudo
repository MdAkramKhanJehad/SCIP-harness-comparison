# vvaharness/remediation_agent/discovery.py

Locates the scan report, turns its findings into remediation targets (typed `findings.json` first, legacy Markdown parse otherwise), marks targets whose fix already stands as done, applies the `--top N` cap, and prepares the output and checkpoint locations.

Source: `vvaharness/remediation_agent/discovery.py` (lines 1-163)
Executor: code
Called from: `vvaharness/remediation_agent/remediate.py` remediate; `prepare_layout` also from `vvaharness/api.py`

// src: vvaharness/remediation_agent/discovery.py:48
CHECKPOINTS_DIR_NAME = "checkpoints"

// src: vvaharness/remediation_agent/discovery.py:80-85
Findings {
  selected   // the targets this run works on
  discovered   // every target the report had; still needed for checkpoint pruning
}

// src: vvaharness/remediation_agent/discovery.py:143-148
Layout { rem_dir; ckpt_dir; run_id }

// src: vvaharness/remediation_agent/discovery.py:59-72
fn locate_report(repo_path):executor=code {
  scan_dir = report_parser.locate.find_scan_dir(repo_path)
  require scan_dir != null => { console fail "no 'security-scan' folder found ... run `vvaharness scan --repo ...` first."; return [null, 1] }
  report = report_parser.locate.latest_report(scan_dir)
  require report != null => { console fail "no scan report (*_report.md) found ..."; return [null, 1] }
  return [report, 0]
}

// src: vvaharness/remediation_agent/discovery.py:121-140
fn load_findings(repo_path, report, top?):executor=code {
  typed = findings_json.read_findings_json(repo_path)   // external: orchestrator/findings_json.py; raises InvalidFindingsJSON on a corrupt file (no silent Markdown fallback)
  // Case files older than the scan result do not count as done
  since = _mtime(if (typed != null) findings_json_path(repo_path) else report)   // null (no cutoff) when the time cannot be read
  done = completed_case_ids(repo_path, since)
  if (typed != null) {
    discovered = _targets_from_typed(typed, done)
  } else {
    discovered = report_parser.parse.parse_findings(text of report)   // legacy path for an older scan without findings.json
    for each t in discovered { t.done = t.done || t.case_id in done }
    // preserved: the legacy path does not call drop_non_main_channel, so posture-channel findings are not removed here
  }
  selected = select.pq.select_top_logged(discovered, top, score_of=cvss_score_of, log_prefix="[Remediation Agent]")
  return Findings(selected, discovered)
}

// src: vvaharness/remediation_agent/discovery.py:107-118
fn _targets_from_typed(report, done):executor=code {
  targets = []
  for each [i from 1, rf] in report.findings {
    f = rf.finding; f.severity = rf.severity
    t = RemediationTarget(finding=f, index=i)   // ordinals are assigned BEFORE the posture drop, matching the report's "### N." headings
    t.done = t.case_id in done
    append t to targets
  }
  return select.pq.drop_non_main_channel(targets, log_prefix="[Remediation Agent]")
}

// src: vvaharness/remediation_agent/discovery.py:88-104
fn completed_case_ids(repo_path, since?):executor=code {
  done = {}
  for each case_path in sorted glob "<repo>/security-remediation/*/finding_case.json" {
    try {
      if (since != null && modification time of case_path < since) continue
      case = FindingCase parsed from case_path
    } catch (OSError | ValueError) => continue
    if (case.state in [REMEDIATED, VALIDATED]) add case.case_id to done
  }
  remove "" from done
  return done
  // preserved: the case files read here are inside the scanned repository and are not checked against provenance.owned_cases; a committed case file newer than the report can mark a finding done (the flag only affects the interactive display and the "pending" selection)
}

// src: vvaharness/remediation_agent/discovery.py:75-77
fn cvss_score_of(target):executor=code { return target.finding.cvss_score }   // null when the report carried only a vector or a bare band

// src: vvaharness/remediation_agent/discovery.py:151-163
fn prepare_layout(repo_path):executor=code {
  rem_dir = artifact_dir(repo_path, REMEDIATION_DIR_NAME)   // external: orchestrator/artifacts.py; raises UnsafeArtifactDir rather than follow a committed symlink
  create rem_dir if missing
  return Layout(rem_dir, ckpt_dir = repo_path + "/" + CHECKPOINTS_DIR_NAME, run_id = run_id_for(repo_path))
  // the ckpt_dir value is ignored by save_ckpt and load_ckpt, which use the state store (orchestrator/checkpoints.py:241-268)
}
