// file: vvaharness/rules/kb_tools.py
// The CWE knowledge base as a fact tool (CweGuidance), composed into a session via compose_tool_builders.

@executedBy(CODE) @role(tool)
class KbTools {

    List<String> KB_TOOL_NAMES = List.of("CweGuidance");                                    // src: vvaharness/rules/kb_tools.py:27

    /** Tool CweGuidance(cwe_id): its description is what the model sees. */
    @executedBy(MIXED)
    Map cweGuidance(String cweId, Theta θ) {
        Prompt description = new Prompt().context(θ["p.kb_tools.cweguidance_description"]); // "Sanitizers, non-sanitizers and FP checks known for one CWE id"  // src: vvaharness/rules/kb_tools.py:47
        Counters.bump("s4_cwe_guidance_called");                                             // src: vvaharness/rules/kb_tools.py:49
        Map entry = GenericKb.forCwes(GenericKb.load(θ), List.of(cweId), null);             // src: vvaharness/rules/kb_tools.py:50
        // a miss still returns every key; only a hit fills cwe
        if (entry.get("cwe").isEmpty()) {                                                    // src: vvaharness/rules/kb_tools.py:52
            Counters.bump("s4_cwe_guidance_unknown_cwe");                                    // src: vvaharness/rules/kb_tools.py:53
            noteUnknownCwe(cweId);                                                           // src: vvaharness/rules/kb_tools.py:54
        }
        return entry;                                                                        // src: vvaharness/rules/kb_tools.py:55
    }

    /** Record cweId among this run's KB misses as the comma-joined note fact. Sessions share this process's tool instance (possibly concurrently): the id set, not the last single id, distinguishes a KB gap from a model inventing ids. */
    @src("vvaharness/rules/kb_tools.py:33")
    void noteUnknownCwe(String cweId) {
        String ids;
        synchronized (unknownCweLock) {                                                      // src: vvaharness/rules/kb_tools.py:37
            if (unknownCweIds.contains(cweId)) return;                                       // src: vvaharness/rules/kb_tools.py:38
            unknownCweIds.add(cweId);                                                        // src: vvaharness/rules/kb_tools.py:40
            ids = sorted(unknownCweIds).join(",");                                           // src: vvaharness/rules/kb_tools.py:41
        }
        Counters.note("s4_cwe_guidance_unknown_ids", ids);                                   // note is outside the lock // src: vvaharness/rules/kb_tools.py:42
    }

    /** build_kb_tool_builder: returns the ToolBuilder (build below, captured over nothing). Called here with options so callers get the built tools. */
    @src("vvaharness/rules/kb_tools.py:58")
    List<Tool> buildKbToolBuilder(StreamingOptions options, Theta θ) {
        return build(options, null, θ);                                                      // src: vvaharness/rules/kb_tools.py:66
    }

    /** Nested _build(options, allowed_tools): CweGuidance only when options.fact_tools contains it; allowed_tools is ignored. */
    @src("vvaharness/rules/kb_tools.py:61")
    List<Tool> build(StreamingOptions options, List<String> allowedTools, Theta θ) {
        if (θ["p.kb_tools.cweguidance_fact_gated"] && !options.factTools.contains("CweGuidance")) return List.of(); // src: vvaharness/rules/kb_tools.py:62
        return List.of(new Tool("CweGuidance"));                                             // src: vvaharness/rules/kb_tools.py:64
    }
}
