// file: vulnhunt/phases/phase3d_sweep.md
// Phase 3d sweep subagent: for every confirmed root cause, grep the FULL codebase (source and sink patterns, transitive
// callers), triage every instance, and send each CANDIDATE through gates, PoC and exploit test; writes phase3d_output.md.

@executedBy(MODEL) @role(prompt) @stage("phase3d")
class Phase3dSweep {

    // Entry: the procedure the sweep subagent carries out.
    @executedBy(MODEL)
    SweepTable run(String vulnhuntDir, Theta θ) {
        Prompt p = prompt(θ);
        if (!θ["prompt.sweep.enabled"]) return null;                                             // src: vulnhunt/phases/phase3d_sweep.md:6
        List<Finding> confirmed = readPocDir(vulnhuntDir + "/poc/");                             // src: vulnhunt/phases/phase3d_sweep.md:3
        confirmed = preSweepValidation(confirmed, θ);                                            // src: vulnhunt/phases/phase3d_sweep.md:23
        SweepTable table = new SweepTable(θ["p.phase3d_sweep.sweep_table_columns"]);             // src: vulnhunt/phases/phase3d_sweep.md:88
        for (RootCause rc : distinctRootCauses(confirmed)) {                                     // src: vulnhunt/phases/phase3d_sweep.md:27
            table.add(sweepRootCause(rc, vulnhuntDir, confirmed, θ));
        }
        for (RootCause rc : relatedPatterns(confirmed, θ)) table.add(sweepRootCause(rc, vulnhuntDir, confirmed, θ)); // src: vulnhunt/phases/phase3d_sweep.md:59
        for (Row r : table.rows()) {
            while (r.remaining > θ["p.phase3d_sweep.sweep_remaining_must_be_zero"]) triageRemaining(r, vulnhuntDir, confirmed, θ); // src: vulnhunt/phases/phase3d_sweep.md:119
        }
        writeFile(θ["p.phase3d_sweep.sweep_output_filename"], table);                            // src: vulnhunt/phases/phase3d_sweep.md:82
        return table;
    }

    // ---------------- prompt sections, in file order ----------------

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context("all confirmed findings have passing exploit tests and proposed fixes");       // src: vulnhunt/phases/phase3d_sweep.md:3
        p.include(VulnhuntInvestigationDiscipline.prompt(θ));                                    // src: vulnhunt/phases/phase3d_sweep.md:4
        p.include(mandateText(θ));
        p.include(perRootCauseText(θ));
        p.include(relatedPatternsText(θ));
        p.include(outputText(θ));
        p.include(instanceValidationText(θ));
        p.include(pipelineReferenceText(θ));
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt mandateText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.sweep.enabled"]) p.must("Phase 3d: Sweep Verification (MANDATORY - DO NOT SKIP)"); // src: vulnhunt/phases/phase3d_sweep.md:6
        if (θ["p.phase3d_sweep.sweep_after_exploit_tests_every_root_cause"]) p.rule("after exploit tests, verify every root cause is fully enumerated across the codebase"); // src: vulnhunt/phases/phase3d_sweep.md:8
        if (θ["p.phase3d_sweep.sweep_full_codebase_regardless_of_partitions"]) p.must("sweep operates on the FULL codebase regardless of subgraph partitions"); // src: vulnhunt/phases/phase3d_sweep.md:12
        if (θ["p.phase3d_sweep.sweep_not_limited_to_originating_subgraph"]) p.forbid("do NOT limit sweep searches to the originating subgraph's files"); // src: vulnhunt/phases/phase3d_sweep.md:14
        if (θ["p.phase3d_sweep.sweep_targets_non_inventoried_paths"]) p.rule("value: instances not reached by any inventoried input (cron, workers, internal RPC)"); // src: vulnhunt/phases/phase3d_sweep.md:18
        if (θ["p.phase3d_sweep.pre_sweep_distinct_sink_count"]) p.step(0, "count distinct sink file:line values across confirmed findings"); // src: vulnhunt/phases/phase3d_sweep.md:23
        if (θ["p.phase3d_sweep.pre_sweep_expand_collapsed_findings"]) p.must("if that count exceeds the VULN-NNN count, expand collapsed findings first"); // src: vulnhunt/phases/phase3d_sweep.md:24
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt perRootCauseText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase3d_sweep.sweep_step1_list_root_cause_pattern"]) p.step(1, "list the root cause function/pattern"); // src: vulnhunt/phases/phase3d_sweep.md:29
        p.threshold(θ["p.phase3d_sweep.sweep_grep_pattern_not_just_sink"]);                      // src: vulnhunt/phases/phase3d_sweep.md:32
        if (θ["p.phase3d_sweep.sweep_source_pattern"]) p.rule("Source pattern: the vulnerable construction"); // src: vulnhunt/phases/phase3d_sweep.md:33
        if (θ["p.phase3d_sweep.sweep_sink_pattern"]) p.rule("Sink pattern: the dangerous operation"); // src: vulnhunt/phases/phase3d_sweep.md:35
        p.step(2, "search the entire codebase for both patterns with " + θ["p.phase3d_sweep.sweep_use_grep_tool_entire_codebase"]); // src: vulnhunt/phases/phase3d_sweep.md:39
        if (θ["p.phase3d_sweep.sweep_glob_by_file_extension"]) p.rule("use the glob parameter to target relevant file extensions"); // src: vulnhunt/phases/phase3d_sweep.md:40
        if (θ["p.phase3d_sweep.sweep_trace_callers_transitively"]) p.step(3, "trace callers transitively: importers/callers, then their importers"); // src: vulnhunt/phases/phase3d_sweep.md:42
        p.rule(θ["p.phase3d_sweep.sweep_transitive_stop_condition"]);                           // src: vulnhunt/phases/phase3d_sweep.md:44
        p.step(4, θ["prompt.sweep.reentry"]);                                                    // src: vulnhunt/phases/phase3d_sweep.md:48
        if (θ["p.phase3d_sweep.sweep_verify_receiver_type"]) p.step(5, "verify the receiver type of the method call by tracing the variable declaration"); // src: vulnhunt/phases/phase3d_sweep.md:51
        if (θ["p.phase3d_sweep.sweep_no_type_inference_from_siblings"]) p.forbid("do NOT infer the type from surrounding code or sibling variables"); // src: vulnhunt/phases/phase3d_sweep.md:55
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt relatedPatternsText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase3d_sweep.related_sweep_unprotected_mgmt_endpoints"]) p.rule("unauthenticated management/debug endpoint finding -> sweep ALL listeners/routes binding without auth"); // src: vulnhunt/phases/phase3d_sweep.md:61
        if (θ["p.phase3d_sweep.related_sweep_each_unprotected_instance_separate"]) p.rule("each unprotected instance is a separate finding"); // src: vulnhunt/phases/phase3d_sweep.md:63
        if (θ["p.phase3d_sweep.related_sweep_hardcoded_secrets"]) p.rule("one hardcoded key -> grep ALL hardcoded keys, tokens, passwords, license keys"); // src: vulnhunt/phases/phase3d_sweep.md:66
        p.checklist(θ["p.phase3d_sweep.related_sweep_secret_name_patterns"]);                    // src: vulnhunt/phases/phase3d_sweep.md:69
        if (θ["p.phase3d_sweep.related_sweep_weak_crypto"]) p.rule("one weak algorithm -> audit ALL crypto usage"); // src: vulnhunt/phases/phase3d_sweep.md:72
        p.checklist(θ["p.phase3d_sweep.related_sweep_crypto_parameters"]);                       // src: vulnhunt/phases/phase3d_sweep.md:73
        if (θ["p.phase3d_sweep.related_sweep_sanitizer_misuse"]) p.rule("one mismatched sanitizer -> verify ALL calls to it match their sink context"); // src: vulnhunt/phases/phase3d_sweep.md:77
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt outputText(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.phase3d_sweep.sweep_output_filename"]);                                    // src: vulnhunt/phases/phase3d_sweep.md:82
        if (θ["p.phase3d_sweep.sweep_output_not_prompt_filename"]) p.forbid("do NOT use phase3d_sweep.md as the output filename"); // src: vulnhunt/phases/phase3d_sweep.md:83
        if (θ["p.phase3d_sweep.sweep_present_table_before_proceeding"]) p.must("present this table before proceeding"); // src: vulnhunt/phases/phase3d_sweep.md:86
        p.format(θ["p.phase3d_sweep.sweep_table_columns"]);                                      // src: vulnhunt/phases/phase3d_sweep.md:88
        if (θ["p.phase3d_sweep.sweep_table_uses_total_grep_count"]) p.rule("use the total count from grepping, not the instances you chose to highlight"); // src: vulnhunt/phases/phase3d_sweep.md:94
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt instanceValidationText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase3d_sweep.sweep_triage_every_instance"]) p.must("triage EVERY instance found by the sweep grep"); // src: vulnhunt/phases/phase3d_sweep.md:100
        if (θ["p.phase3d_sweep.sweep_triage_record_location_and_vars"]) p.format("file:line and the interpolated variable(s)"); // src: vulnhunt/phases/phase3d_sweep.md:101
        if (θ["p.phase3d_sweep.sweep_triage_trace_origin_backward"]) p.rule("trace backward through state services, storage reads and property getters to the ultimate origin"); // src: vulnhunt/phases/phase3d_sweep.md:102
        if (θ["p.phase3d_sweep.sweep_looks_server_controlled_insufficient"]) p.forbid("looks server-controlled at the immediate call site is not sufficient"); // src: vulnhunt/phases/phase3d_sweep.md:104
        p.checklist(θ["p.phase3d_sweep.sweep_triage_record_mitigation"]);                        // src: vulnhunt/phases/phase3d_sweep.md:105
        p.choose(θ["p.phase3d_sweep.sweep_triage_verdicts"]);                                    // src: vulnhunt/phases/phase3d_sweep.md:106
        p.must(θ["p.phase3d_sweep.sweep_candidate_full_pipeline"]);                              // src: vulnhunt/phases/phase3d_sweep.md:108
        if (θ["p.phase3d_sweep.sweep_instance_needs_own_passing_test"]) p.evidence("its own exploit test with a PASS result"); // src: vulnhunt/phases/phase3d_sweep.md:110
        if (θ["p.phase3d_sweep.sweep_no_exploitability_by_shared_root_cause"]) p.forbid("do NOT assume exploitable because it shares a root cause with a confirmed finding"); // src: vulnhunt/phases/phase3d_sweep.md:111
        if (θ["p.phase3d_sweep.sweep_passing_instances_separate_vulns"]) p.rule("passing instances become separate VULN-NNN findings"); // src: vulnhunt/phases/phase3d_sweep.md:115
        if (θ["p.phase3d_sweep.sweep_failing_instances_smell_or_eliminated"]) p.rule("failing instances become Code Smells or are eliminated"); // src: vulnhunt/phases/phase3d_sweep.md:116
        p.threshold(θ["p.phase3d_sweep.sweep_remaining_must_be_zero"]);                          // src: vulnhunt/phases/phase3d_sweep.md:119
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt pipelineReferenceText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase3d_sweep.sweep_pipeline_read_shared_gates"]) p.step(1, "HARD GATES (Gate 0-3): read phase2_shared.md"); // src: vulnhunt/phases/phase3d_sweep.md:125
        if (θ["p.phase3d_sweep.sweep_pipeline_class_files_only_for_confirmed_classes"]) p.rule("read phase2_class_<class>.md ONLY for classes in your confirmed findings"); // src: vulnhunt/phases/phase3d_sweep.md:126
        p.checklist(θ["p.phase3d_sweep.sweep_pipeline_apply_class_refinements"]);                // src: vulnhunt/phases/phase3d_sweep.md:128
        p.step(2, "PoC (Phase 3a format) -> " + θ["p.phase3d_sweep.sweep_pipeline_poc_path"]);   // src: vulnhunt/phases/phase3d_sweep.md:131
        p.step(3, "Exploit test (Phase 3b format) -> " + θ["p.phase3d_sweep.sweep_pipeline_exploit_test_path"]); // src: vulnhunt/phases/phase3d_sweep.md:132
        if (θ["p.phase3d_sweep.sweep_only_pass_becomes_vuln"]) p.rule("only instances with PASS exploit test results become VULN-NNN findings"); // src: vulnhunt/phases/phase3d_sweep.md:134
        return p;
    }

    // ---------------- procedures ----------------

    @executedBy(MODEL)
    List<Finding> preSweepValidation(List<Finding> confirmed, Theta θ) {
        int sinkCount = θ["p.phase3d_sweep.pre_sweep_distinct_sink_count"] ? confirmed.distinctSinkFileLines().size() : 0; // src: vulnhunt/phases/phase3d_sweep.md:23
        if (sinkCount > confirmed.vulnIds().size() && θ["p.phase3d_sweep.pre_sweep_expand_collapsed_findings"]) confirmed = expandCollapsed(confirmed); // src: vulnhunt/phases/phase3d_sweep.md:24
        return confirmed;
    }

    // Steps 1-5 for one root cause, then triage of every instance found.
    @executedBy(MODEL)
    Row sweepRootCause(RootCause rc, String dir, List<Finding> confirmed, Theta θ) {
        Pattern src = rc.sourcePattern();                                                        // src: vulnhunt/phases/phase3d_sweep.md:33
        Pattern sink = rc.sinkPattern();                                                         // src: vulnhunt/phases/phase3d_sweep.md:35
        String scope = θ["p.phase3d_sweep.sweep_full_codebase_regardless_of_partitions"] ? "**" : rc.originSubgraphFiles(); // src: vulnhunt/phases/phase3d_sweep.md:12
        List<Instance> found = grep(List.of(src, sink), scope, rc.extensionsGlob());             // src: vulnhunt/phases/phase3d_sweep.md:39
        if (θ["p.phase3d_sweep.sweep_trace_callers_transitively"]) {                             // src: vulnhunt/phases/phase3d_sweep.md:42
            Worklist w = new Worklist(found);
            while (!w.isEmpty()) {                                                               // src: vulnhunt/phases/phase3d_sweep.md:44
                Instance i = w.pop();
                if (i.isEntryPoint()) continue;
                for (Instance caller : grepImportersAndCallers(i)) { if (found.addIfNew(caller)) w.push(caller); }
            }
        }
        Row row = new Row(rc, found.size());                                                     // src: vulnhunt/phases/phase3d_sweep.md:94
        for (Instance i : found) {                                                               // src: vulnhunt/phases/phase3d_sweep.md:100
            if (!i.flowsIntoSameSinkKind(rc)) { row.mitigated += 1; continue; }                  // src: vulnhunt/phases/phase3d_sweep.md:48
            if (θ["p.phase3d_sweep.sweep_verify_receiver_type"] && !i.receiverTypeFromDeclaration().equals(rc.receiverType)) { row.mitigated += 1; continue; } // src: vulnhunt/phases/phase3d_sweep.md:51
            String verdict = triage(i, θ);                                                       // src: vulnhunt/phases/phase3d_sweep.md:106
            if (verdict == "CANDIDATE") { row.candidates += 1; runFullPipeline(i, dir, confirmed, θ); }
            else if (verdict == "MITIGATED") row.mitigated += 1;
            else row.devOnly += 1;
        }
        row.remaining = row.total - row.candidates - row.mitigated - row.devOnly;               // src: vulnhunt/phases/phase3d_sweep.md:119
        return row;
    }

    @executedBy(MODEL)
    String triage(Instance i, Theta θ) {
        Origin o = θ["p.phase3d_sweep.sweep_triage_trace_origin_backward"] ? traceBackward(i) : i.immediateOrigin(); // src: vulnhunt/phases/phase3d_sweep.md:102
        Mitigation m = i.mitigation(θ["p.phase3d_sweep.sweep_triage_record_mitigation"]);         // src: vulnhunt/phases/phase3d_sweep.md:105
        if (m != null && m.kind == "dev-only route") return "DEV-ONLY";
        if (m != null) return "MITIGATED";
        return o.userControlled() ? "CANDIDATE" : "MITIGATED";                                   // src: vulnhunt/phases/phase3d_sweep.md:106
    }

    // Pipeline Reference: gates (2b), PoC (3a), exploit test (3b); only PASS becomes a VULN-NNN.
    @executedBy(MODEL)
    void runFullPipeline(Instance i, String dir, List<Finding> confirmed, Theta θ) {
        Candidate c = new Candidate(i);
        ClassGroupRules rules = confirmed.classes().contains(c.cls) ? classRulesFor(c.cls) : null; // src: vulnhunt/phases/phase3d_sweep.md:126
        c = Phase2Shared.applyHardGates(c, c.cls, rules, θ);                                     // src: vulnhunt/phases/phase3d_sweep.md:125
        if (c == null) return;
        Poc poc = Phase3aReproduce.reproduce(c, null, θ);                                        // src: vulnhunt/phases/phase3d_sweep.md:131
        writeFile(θ["p.phase3d_sweep.sweep_pipeline_poc_path"], poc);
        TestResult r = runOrWrite(θ["p.phase3d_sweep.sweep_pipeline_exploit_test_path"], poc);  // src: vulnhunt/phases/phase3d_sweep.md:132
        if (r == PASS && θ["p.phase3d_sweep.sweep_only_pass_becomes_vuln"]) addVuln(c, poc);     // src: vulnhunt/phases/phase3d_sweep.md:134
        else markCodeSmellOrEliminated(c);                                                       // src: vulnhunt/phases/phase3d_sweep.md:116
    }

    // "Also sweep for related patterns": triggered by what the confirmed findings contain.
    @executedBy(MODEL)
    List<RootCause> relatedPatterns(List<Finding> confirmed, Theta θ) {
        List<RootCause> out = new List();
        if (confirmed.any(f -> f.isUnauthManagementEndpoint()) && θ["p.phase3d_sweep.related_sweep_unprotected_mgmt_endpoints"]) out.add(RootCause.unauthListeners()); // src: vulnhunt/phases/phase3d_sweep.md:61
        if (confirmed.any(f -> f.isHardcodedSecret()) && θ["p.phase3d_sweep.related_sweep_hardcoded_secrets"]) out.add(RootCause.secrets(θ["p.phase3d_sweep.related_sweep_secret_name_patterns"])); // src: vulnhunt/phases/phase3d_sweep.md:66
        if (confirmed.any(f -> f.isWeakCrypto()) && θ["p.phase3d_sweep.related_sweep_weak_crypto"]) out.add(RootCause.crypto(θ["p.phase3d_sweep.related_sweep_crypto_parameters"])); // src: vulnhunt/phases/phase3d_sweep.md:72
        if (confirmed.any(f -> f.isSanitizerMismatch()) && θ["p.phase3d_sweep.related_sweep_sanitizer_misuse"]) out.add(RootCause.sanitizerCalls()); // src: vulnhunt/phases/phase3d_sweep.md:77
        return out;
    }

    @executedBy(MODEL)
    void triageRemaining(Row r, String dir, List<Finding> confirmed, Theta θ) {
        for (Instance i : r.unaccounted()) { String v = triage(i, θ); r.account(v); if (v == "CANDIDATE") runFullPipeline(i, dir, confirmed, θ); } // src: vulnhunt/phases/phase3d_sweep.md:120
    }
}
