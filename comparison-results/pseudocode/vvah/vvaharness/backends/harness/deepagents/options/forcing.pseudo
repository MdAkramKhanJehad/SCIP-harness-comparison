// file: vvaharness/backends/harness/deepagents/options/forcing.py
// ForcingChatAnthropic: restores the forced tool_choice that langchain_anthropic drops under ADAPTIVE thinking
// (the API allows it there), so S2/S4/S6 sessions cannot end on prose and lose their structured output.

@executedBy(CODE) @role(backend)
class Forcing {

    // The API-shaped forced tool_choice, or null when it forces nothing.
    Map<String, Object> forcedChoice(Object toolChoice, Theta θ) {
        List<String> forcedTypes = θ["code.backends.harness.deepagents.options.forcing.forced_types"];   // ("any", "tool") // src: vvaharness/backends/harness/deepagents/options/forcing.py:29
        if (toolChoice instanceof Map) return forcedTypes.contains(toolChoice.get("type")) ? toolChoice : null; // src: vvaharness/backends/harness/deepagents/options/forcing.py:35
        if (forcedTypes.contains(toolChoice)) return Map.of("type", toolChoice);                         // src: vvaharness/backends/harness/deepagents/options/forcing.py:37
        if (toolChoice instanceof String) return Map.of("type", "tool", "name", toolChoice);             // src: vvaharness/backends/harness/deepagents/options/forcing.py:39
        return null;
    }

    // Re-apply the forced choice, carrying over disable_parallel_tool_use if langchain set it.
    Runnable reforce(Runnable bound, Map<String, Object> forced, Theta θ) {
        Object held = bound.kwargs;                                                                      // src: vvaharness/backends/harness/deepagents/options/forcing.py:71
        if (!(held instanceof Map)) return bound;                                                        // src: vvaharness/backends/harness/deepagents/options/forcing.py:72
        if (θ["code.backends.harness.deepagents.options.forcing.forced_types"].contains(held.get("tool_choice").get("type"))) return bound; // already forced // src: vvaharness/backends/harness/deepagents/options/forcing.py:74
        Map existing = held.get("tool_choice") != null ? held.get("tool_choice") : Map.of();             // src: vvaharness/backends/harness/deepagents/options/forcing.py:76
        if (existing.containsKey("disable_parallel_tool_use")) forced.put("disable_parallel_tool_use", existing.get("disable_parallel_tool_use")); // src: vvaharness/backends/harness/deepagents/options/forcing.py:78
        COUNTERS.bump("deepagents_tool_choice_reforced_under_adaptive_thinking");                        // src: vvaharness/backends/harness/deepagents/options/forcing.py:79
        return bound.bind(forced);                                                                       // src: vvaharness/backends/harness/deepagents/options/forcing.py:80
    }
}

@executedBy(CODE) @role(backend)
class ForcingChatAnthropic {
    // false binds every tool_choice as auto (ForceVerdictOnly's working calls).
    boolean forceToolChoice = true;                                                                      // src: vvaharness/backends/harness/deepagents/options/forcing.py:47

    Runnable bindTools(List<Tool> tools, Object toolChoice, Theta θ) {
        if (!forceToolChoice) return superBindTools(tools, null);                                        // src: vvaharness/backends/harness/deepagents/options/forcing.py:53
        Map<String, Object> forced = Forcing.forcedChoice(toolChoice, θ);                                // src: vvaharness/backends/harness/deepagents/options/forcing.py:59
        boolean adaptive = "adaptive".equals(this.thinking.get("type"));                                 // src: vvaharness/backends/harness/deepagents/options/forcing.py:60
        // only manual "enabled" thinking is restricted to auto/none; adaptive accepts tool/any
        if (forced == null || !adaptive || !θ["code.backends.harness.deepagents.options.forcing.reforce_under_adaptive_thinking"]) { // src: vvaharness/backends/harness/deepagents/options/forcing.py:61
            return superBindTools(tools, toolChoice);                                                    // src: vvaharness/backends/harness/deepagents/options/forcing.py:62
        }
        Runnable bound = superBindTools(tools, toolChoice);          // drop warning suppressed         // src: vvaharness/backends/harness/deepagents/options/forcing.py:65
        return Forcing.reforce(bound, forced, θ);                                                        // src: vvaharness/backends/harness/deepagents/options/forcing.py:66
    }
}
