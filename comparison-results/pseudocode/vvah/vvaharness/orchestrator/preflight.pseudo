// file: vvaharness/orchestrator/preflight.py
// Startup readiness: push transport/TLS/cache settings to the backend clients, check credentials per route,
// then live-probe every (model, via, provider) with a ping and the agentic roles with a forced tool round-trip.

@executedBy(CODE) @role(step)
class OrchestratorPreflight {

    /** Apply cfg.sdk / cfg.openai / cache settings to the backend clients (the cli: block is pushed by OrchestratorEntry). */
    @src("vvaharness/orchestrator/preflight.py:99")
    void configureBackends(Config cfg, Path cfgDir, Theta θ) {
        Set<String> vias = ConfigPaths.iterModelRoles(cfg).map(r -> LlmRegistry.resolve(r.model, θ).via);   // src: vvaharness/orchestrator/preflight.py:102
        // one credential serves sdk+deepagents; the ANTHROPIC_API_KEY fallback is allowed only when no cli role shares the run
        boolean sdkSole = Set.of("sdk", "deepagents").containsAll(vias);                                    // src: vvaharness/orchestrator/preflight.py:103
        LlmRegistryConfig.configureCache(θ);                                                                // pushed UNCONDITIONALLY // src: vvaharness/orchestrator/preflight.py:106
        if (cfg.sdk != null) LlmRegistryConfig.configureSdk(cfgDir, sdkSole, θ);                           // src: vvaharness/orchestrator/preflight.py:115
        if (cfg.openai != null) LlmRegistryConfig.configureOpenai(cfgDir, θ);                              // src: vvaharness/orchestrator/preflight.py:128
        // via cli shells out to claude: push gateway TLS/proxy into its env (auth stays with the CLI)
        if (cfg.cli != null) {
            String caCert = cfg.cli.caCert != null && !cfg.cli.caCert.isEmpty() ? cfg.cli.caCert : null;   // src: vvaharness/orchestrator/preflight.py:144
            Object clientCert = cfg.cli.clientCert != null && !cfg.cli.clientCert.isEmpty() ? cfg.cli.clientCert : null; // src: vvaharness/orchestrator/preflight.py:145
            LlmCli.configure(resolveVerifyPath(cfgDir, θ["cli.verify_ssl"]),                                // src: vvaharness/orchestrator/preflight.py:147
                caCert != null ? ConfigPaths.resolveAgainst(cfgDir, caCert) : null,                         // src: vvaharness/orchestrator/preflight.py:148
                resolveCertChain(cfgDir, clientCert),                                                       // src: vvaharness/orchestrator/preflight.py:149
                cfg.cli.noProxy,                                                                            // src: vvaharness/orchestrator/preflight.py:150
                θ["cli.effort"],                                                                            // src: vvaharness/orchestrator/preflight.py:151
                θ["cli.restricted"]);                                                                       // default True: an omitted key must get the jail, not lose it // src: vvaharness/orchestrator/preflight.py:153
        }
        // No deepagents branch: that route holds no process-global config (build_harness_env, per call)
    }

    /** Anchor a CA-bundle path supplied via verify_ssl at the profile dir (PATH form only). */
    @src("vvaharness/orchestrator/preflight.py:71")
    Object resolveVerifyPath(Path cfgDir, Object value) {
        Object coerced = Tls.coerceVerify(value);                                                           // "false" becomes cfgDir/false; empty becomes the profile dir as CA; UNC refused // src: vvaharness/orchestrator/preflight.py:74
        if (coerced instanceof String && !coerced.strip().isEmpty()) return ConfigPaths.resolveAgainst(cfgDir, coerced); // src: vvaharness/orchestrator/preflight.py:75
        return value;                                                                                       // booleans pass through unchanged // src: vvaharness/orchestrator/preflight.py:77
    }

    /** Anchor a client chain at the profile dir, for both accepted shapes. */
    @src("vvaharness/orchestrator/preflight.py:80")
    Object resolveCertChain(Path cfgDir, Object cert) {
        if (cert instanceof String) return ConfigPaths.resolveAgainst(cfgDir, cert);                        // src: vvaharness/orchestrator/preflight.py:83
        if (cert instanceof Tuple || cert instanceof List) {
            // only the first 2 members are paths (the 3rd is the key PASSWORD); positional, never filtered
            return cert.mapIndexed((i, m) -> i < 2 && m instanceof String && !m.strip().isEmpty() ? ConfigPaths.resolveAgainst(cfgDir, m) : m); // src: vvaharness/orchestrator/preflight.py:86
        }
        return cert;                                                                                        // src: vvaharness/orchestrator/preflight.py:91
    }

    /** Credential PRESENCE only: never key material, a prefix, or the length. */
    @src("vvaharness/orchestrator/preflight.py:94")
    String mask(String v) {
        return v != null && !v.isEmpty() ? "set" : "<unset>";                                               // src: vvaharness/orchestrator/preflight.py:96
    }

    /** A probe error that still proves reachability: a terse reply (typed DegenerateResponseError). */
    @src("vvaharness/orchestrator/preflight.py:158")
    boolean reachableDespiteDegenerateReply(Exception e) {
        return e instanceof DegenerateResponseError;                                                        // src: vvaharness/orchestrator/preflight.py:160
    }

    /** A reply cut off by the probe's own output budget proves reachability (thinking counts against max_tokens, so no budget is safe). */
    @src("vvaharness/orchestrator/preflight.py:163")
    boolean reachableDespiteTruncatedReply(Exception e) {
        return e instanceof TruncatedResponseError;                                                         // src: vvaharness/orchestrator/preflight.py:166
    }

    /** LEGACY BACKSTOP: a probe error string that still proves reachability (covers a claude cap message the typed path misses). */
    @src("vvaharness/orchestrator/preflight.py:169")
    boolean reachableDespiteTokenCap(String errMsg) {
        String low = (errMsg == null ? "" : errMsg).lower();                                                // src: vvaharness/orchestrator/preflight.py:172
        return low.contains("exceeded") && low.contains("output token");                                    // src: vvaharness/orchestrator/preflight.py:173
    }

    /** A forced tool round-trip that stumbled on tool MECHANICS (malformed tool_use), not connectivity. NotImplementedError stays fatal by design. */
    @src("vvaharness/orchestrator/preflight.py:479")
    boolean reachableDespiteToolDispatchError(Exception e) {
        return e instanceof HarnessJSONDecodeError || e instanceof HarnessMessageParseError;                // src: vvaharness/orchestrator/preflight.py:482
    }

    /** Combined test used where a caller does not need to know which of the three prompt-probe backstops fired. */
    boolean reachableDespite(Exception e) {
        return reachableDespiteTokenCap(e.message) || reachableDespiteDegenerateReply(e) || reachableDespiteTruncatedReply(e); // src: vvaharness/orchestrator/preflight.py:788
    }

    /** True when every role runs after detection (S10/S11). Empty is False: an unattributed gap is never assumed harmless. */
    @src("vvaharness/orchestrator/preflight.py:176")
    boolean postScanOnly(Collection<String> roles) {
        return !roles.isEmpty() && LlmRegistry.POST_SCAN_ROLES.containsAll(roles);                         // src: vvaharness/orchestrator/preflight.py:179
    }

    /** A gap only S10/S11 roles need is a WARN (that stage self-disables); any detection role makes it fatal. */
    @src("vvaharness/orchestrator/preflight.py:182")
    boolean reportCredentialGap(String message, Collection<String> roles) {
        if (postScanOnly(roles)) {                                                                          // src: vvaharness/orchestrator/preflight.py:185
            log.warning(Events.PREFLIGHT_CREDENTIAL_GAP, message, roles.sorted());                         // src: vvaharness/orchestrator/preflight.py:186
            Console.write("required only by the post-scan roles; that stage will be skipped");              // src: vvaharness/orchestrator/preflight.py:187
            return false;                                                                                   // src: vvaharness/orchestrator/preflight.py:189
        }
        log.error(Events.PREFLIGHT_CREDENTIAL_GAP, message);                                               // src: vvaharness/orchestrator/preflight.py:190
        // the remedy lines are printed to the console
        return true;                                                                                        // src: vvaharness/orchestrator/preflight.py:193
    }

    /** Warn per stage whose max_turns hard-caps its route yet carries a small (deepagents-tuned) value. */
    @src("vvaharness/orchestrator/preflight.py:205")
    void warnDeepagentsTunedMaxTurns(Config cfg, Theta θ) {
        // stage block and role pairs: step2/threatmodel, step4/deepdive, step6_verify/verify
        List<Pair<String, String>> capped = θ["code.orchestrator.preflight.turn_capped_stages"];            // src: vvaharness/orchestrator/preflight.py:198
        for (Pair<String, String> sr : capped) {                                                            // src: vvaharness/orchestrator/preflight.py:207
            Object block = cfg.get(sr.first);                                                               // src: vvaharness/orchestrator/preflight.py:208
            Object model = cfg.models == null ? null : cfg.models.get(sr.second);                           // src: vvaharness/orchestrator/preflight.py:209
            Object turns = block == null ? null : block.get("max_turns");                                   // read as θ step2.max_turns / step4.max_turns / step6_verify.max_turns // src: vvaharness/orchestrator/preflight.py:210
            if (block == null || model == null || !(turns instanceof Integer) || turns <= 0) continue;     // src: vvaharness/orchestrator/preflight.py:211
            String via = LlmRegistry.resolve(model, θ).via;                                                 // src: vvaharness/orchestrator/preflight.py:213
            // only hard-cap vias are affected; a value above the starved ceiling is fine
            if (!θ["code.orchestrator.preflight.hard_turn_cap_vias"].contains(via) || turns > θ["code.orchestrator.preflight.starved_turn_ceiling"]) continue; // src: vvaharness/orchestrator/preflight.py:214
            log.warning(Events.PREFLIGHT_MAX_TURNS_HARD_CAPPED, sr.first, sr.second, via, turns);          // advice: raise max_turns (for example to 60) or route the role via deepagents // src: vvaharness/orchestrator/preflight.py:216
        }
    }

    /** Verify whichever backends the config uses; returns false to abort the run. */
    @src("vvaharness/orchestrator/preflight.py:227")
    boolean checkBackends(Config cfg, Set<String> skipRoles, Theta θ) {
        List<Role> roles = ConfigPaths.iterModelRoles(cfg).filter(r -> !skipRoles.contains(r.name));       // skip_roles drops roles this invocation cannot reach // src: vvaharness/orchestrator/preflight.py:231
        Set<String> vias = roles.map(r -> LlmRegistry.resolve(r.model, θ).via);                             // src: vvaharness/orchestrator/preflight.py:232
        // S4 tools must REACH the model or sessions run tool-less
        if (cfg.models.deepdive != null) {                                                                  // src: vvaharness/orchestrator/preflight.py:236
            String ddVia = LlmRegistry.resolve(cfg.models.deepdive, θ).via;                                 // src: vvaharness/orchestrator/preflight.py:237
            if (!Deepagents.routeCarriesTools(cfg, ddVia, θ)) {                                             // src: vvaharness/orchestrator/preflight.py:242
                log.error(Events.PREFLIGHT_DEEPDIVE_ROUTE_TOOLLESS, ddVia);                                // src: vvaharness/orchestrator/preflight.py:244
                return false;                                                                               // src: vvaharness/orchestrator/preflight.py:246
            }
        }
        // which roles depend on each backend: decides fatal (a detection role) vs skip-stage WARN
        Map<String, Set<String>> rolesByVia = roles.groupBy(r -> LlmRegistry.resolve(r.model, θ).via);     // src: vvaharness/orchestrator/preflight.py:248
        // an unknown model-node key is read by no consumer, so a typo changes nothing: warn, never fail
        List<String> unknownKeys = roles.flatMap(r -> LlmRegistry.unrecognizedModelKeys(r.model).map(k -> "models." + r.name + "." + k)); // src: vvaharness/orchestrator/preflight.py:253
        if (!unknownKeys.isEmpty()) log.warning(Events.MODEL_KEY_UNRECOGNIZED, unknownKeys);               // src: vvaharness/orchestrator/preflight.py:258
        warnDeepagentsTunedMaxTurns(cfg, θ);                                                                // src: vvaharness/orchestrator/preflight.py:261
        Console.write("active backends: " + vias.sorted().join(", "));                                      // src: vvaharness/orchestrator/preflight.py:263
        // WARN-only: LangSmith tracing uploads every prompt (repo source); never mutates the environment
        Check tracing = Environment.langsmithTracingCheck();                                                // src: vvaharness/orchestrator/preflight.py:268
        if (tracing.status == WARN) log.warning(Events.TRACING_UPLOADS_PROMPTS, tracing.detail);           // src: vvaharness/orchestrator/preflight.py:269
        // CLI auth is validated by the live probe, not env presence: Claude Code can use its keychain
        if (vias.contains("cli")) {                                                                         // display only: notes about passed-through ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / CLAUDE_CODE_OAUTH_TOKEN // src: vvaharness/orchestrator/preflight.py:273
            Console.write("cli: delegated to configured CLI; live probe verifies login");                   // src: vvaharness/orchestrator/preflight.py:274
        }
        if (vias.contains("sdk")) Console.write("sdk credential sources (presence only): " + mask(os.environ.get("ANTHROPIC_SDK_API_KEY")) + " " + mask(θ["sdk.api_key"]) + " " + mask(θ["sdk.base_url"])); // src: vvaharness/orchestrator/preflight.py:285
        if (vias.contains("openai")) Console.write("openai credential sources (presence only): " + mask(os.environ.get("OPENAI_API_KEY")) + " " + mask(θ["openai.api_key"]) + " " + mask(θ["openai.base_url"])); // src: vvaharness/orchestrator/preflight.py:295
        boolean ok = true;
        // via deepagents only for roles in DEEPAGENTS_ROLES
        List<String> invalidDeepagents = roles.filter(r -> LlmRegistry.resolve(r.model, θ).via == "deepagents" && !LlmRegistry.DEEPAGENTS_ROLES.contains(r.name)).map(r -> r.name).sorted(); // src: vvaharness/orchestrator/preflight.py:307
        if (!invalidDeepagents.isEmpty()) {                                                                 // src: vvaharness/orchestrator/preflight.py:311
            log.error(Events.PREFLIGHT_ROUTE_UNSUPPORTED, "deepagents", LlmRegistry.DEEPAGENTS_ROLES.sorted(), invalidDeepagents); // src: vvaharness/orchestrator/preflight.py:314
            ok = false;                                                                                     // src: vvaharness/orchestrator/preflight.py:316
        }
        if (vias.contains("cli")) {                                                                         // src: vvaharness/orchestrator/preflight.py:317
            if (!(Shell.which("claude") || Shell.which("claude.cmd"))) {                                    // src: vvaharness/orchestrator/preflight.py:318
                if (reportCredentialGap("claude CLI not on PATH", rolesByVia.get("cli"))) ok = false;       // src: vvaharness/orchestrator/preflight.py:319
            } else {
                Console.mark("ok", "claude found on PATH");                                                 // src: vvaharness/orchestrator/preflight.py:325
            }
        }
        if (vias.contains("sdk")) {
            String key = θ["sdk.api_key"] != null ? θ["sdk.api_key"] : os.environ.get("ANTHROPIC_SDK_API_KEY");   // src: vvaharness/orchestrator/preflight.py:328
            // same sdk_sole predicate as configureBackends
            boolean sdkSole = Set.of("sdk", "deepagents").containsAll(vias);                                // src: vvaharness/orchestrator/preflight.py:331
            boolean usedFallback = false;                                                                   // src: vvaharness/orchestrator/preflight.py:332
            if (key == null && sdkSole) {                                                                   // src: vvaharness/orchestrator/preflight.py:333
                key = os.environ.get("ANTHROPIC_API_KEY") != null ? os.environ.get("ANTHROPIC_API_KEY") : os.environ.get("ANTHROPIC_AUTH_TOKEN"); // src: vvaharness/orchestrator/preflight.py:334
                usedFallback = key != null;                                                                 // src: vvaharness/orchestrator/preflight.py:336
            }
            if (key == null) {                                                                              // src: vvaharness/orchestrator/preflight.py:337
                if (reportCredentialGap("ANTHROPIC_SDK_API_KEY not set", rolesByVia.get("sdk"))) ok = false; // src: vvaharness/orchestrator/preflight.py:342
            } else if (usedFallback) {
                Console.mark("ok", "sdk: using the ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN fallback");     // src: vvaharness/orchestrator/preflight.py:347
            } else {
                Console.mark("ok", "sdk: ANTHROPIC_SDK_API_KEY present");                                   // src: vvaharness/orchestrator/preflight.py:351
            }
        }
        if (vias.contains("openai")) {
            String key = θ["openai.api_key"] != null ? θ["openai.api_key"] : os.environ.get("OPENAI_API_KEY");     // src: vvaharness/orchestrator/preflight.py:354
            if (key == null) {                                                                              // src: vvaharness/orchestrator/preflight.py:356
                if (reportCredentialGap("OPENAI_API_KEY not set", rolesByVia.get("openai"))) ok = false;    // src: vvaharness/orchestrator/preflight.py:357
            } else {
                Console.mark("ok", "openai: OPENAI_API_KEY present");                                       // src: vvaharness/orchestrator/preflight.py:362
            }
        }
        if (vias.contains("deepagents")) {
            // credentials are per (model_id, provider), not per via, so fatal/WARN needs per-target roles
            Map<Pair<String, String>, Set<String>> deepSpecs = roles.filter(x -> LlmRegistry.resolve(x.model, θ).via == "deepagents").groupBy(x -> Pair.of(LlmRegistry.resolve(x.model, θ).modelId, x.model.provider)); // src: vvaharness/orchestrator/preflight.py:368
            // total order: provider is None for inferred targets, so it sorts as the empty string
            for (Entry<Pair<String, String>, Set<String>> d : deepSpecs.sortedBy(kv -> Pair.of(kv.key.first, kv.key.second == null ? "" : kv.key.second))) { // src: vvaharness/orchestrator/preflight.py:375
                Pair<Boolean, String> ready = Environment.backendCredentialOk("deepagents", d.key.first, d.key.second, cfg); // cfg travels so a profile-bound api_key satisfies preflight // src: vvaharness/orchestrator/preflight.py:378
                if (ready.first) Console.mark("ok", "deepagents " + d.key.first + ": " + ready.second);     // src: vvaharness/orchestrator/preflight.py:380
                else if (reportCredentialGap("DeepAgents " + d.key.first + ": " + ready.second, d.value)) ok = false; // src: vvaharness/orchestrator/preflight.py:382
            }
        }
        // skipped when credential checks already failed (nothing to probe)
        if (!ok) {
            Console.write("probe skipped: fix credential errors above first");                              // src: vvaharness/orchestrator/preflight.py:387
            return ok;                                                                                      // src: vvaharness/orchestrator/preflight.py:388
        }
        // JWT ANTHROPIC_API_KEY with no BASE_URL is caught pre-probe on Anthropic routes (else a 60s+ proxy hang)
        boolean anthropicRoute = !(vias.intersect(Set.of("sdk", "cli")).isEmpty()) || roles.any(r -> LlmRegistry.resolve(r.model, θ).via == "deepagents" && ProviderRouting.routesToAnthropic(LlmRegistry.resolve(r.model, θ).modelId, r.model.provider)); // src: vvaharness/orchestrator/preflight.py:391
        if (anthropicRoute) {                                                                               // src: vvaharness/orchestrator/preflight.py:396
            Check gw = Environment.gatewayCheck();                                                          // src: vvaharness/orchestrator/preflight.py:399
            if (gw.status == FAIL) {                                                                        // src: vvaharness/orchestrator/preflight.py:400
                log.error(Events.PREFLIGHT_GATEWAY_UNUSABLE, gw.detail);                                   // src: vvaharness/orchestrator/preflight.py:401
                return false;                                                                               // src: vvaharness/orchestrator/preflight.py:402
            }
        }
        return probeBackends(cfg, skipRoles, θ);                                                            // src: vvaharness/orchestrator/preflight.py:403
    }

    /** The roles this config will actually call agentic() for: S4 deepdive is NOT here (no step4.allowed_tools key to resolve). */
    @src("vvaharness/orchestrator/preflight.py:410")
    List<String> agenticRoles(Config cfg, Theta θ) {
        return θ["code.orchestrator.preflight.agentic_roles"];                                              // preprocess, verify, threatmodel // src: vvaharness/orchestrator/preflight.py:412
    }

    /** The allowed_tools each agentic role passes to agentic(), validated exactly as the stage does (ValueError for a doomed config). */
    @src("vvaharness/orchestrator/preflight.py:415")
    List<String> agenticRoleTools(Config cfg, String role, String via, Theta θ) {
        if (role == "preprocess") return llmModels.validateDetectionTools(θ["step1.allowed_tools"], "step1.allowed_tools", via); // src: vvaharness/orchestrator/preflight.py:418
        if (role == "verify") return llmModels.validateDetectionTools(θ["step6_verify.allowed_tools"], "step6_verify.allowed_tools", via); // src: vvaharness/orchestrator/preflight.py:421
        if (role == "threatmodel") return llmModels.validateDetectionTools(θ["step2.allowed_tools"], "step2.allowed_tools", via); // src: vvaharness/orchestrator/preflight.py:425
        return List.of();                                                                                   // src: vvaharness/orchestrator/preflight.py:429
    }

    /** A short unguessable token proving a reply came from the ACTUAL round trip, not a guess or hallucination. */
    @src("vvaharness/orchestrator/preflight.py:451")
    String probeRoundtripNonce() {
        return Secrets.tokenHex(8);                                                                         // 8 random bytes, 16 hex chars // src: vvaharness/orchestrator/preflight.py:454
    }

    /** Write the nonce marker file the round-trip prompt asks the model to read; returns its file name. */
    @src("vvaharness/orchestrator/preflight.py:457")
    String writeProbeMarker(String workdir, String nonce) {
        Files.write(Path.of(workdir).resolve("vva_preflight_probe_marker.txt"), nonce);                     // src: vvaharness/orchestrator/preflight.py:460
        return "vva_preflight_probe_marker.txt";                                                            // src: vvaharness/orchestrator/preflight.py:461
    }

    /** The round-trip prompt text (the model-facing rules live in PreflightProbePrompt). */
    @src("vvaharness/orchestrator/preflight.py:464")
    Prompt nativeRoundtripPrompt(String markerName, Theta θ) {
        return PreflightProbePrompt.nativeRoundtrip(markerName, θ);                                         // src: vvaharness/orchestrator/preflight.py:466
    }

    /** Whether via cli sessions would route tools through the in-process MCP bridge: asked of the same predicate the stage uses. */
    @src("vvaharness/orchestrator/preflight.py:472")
    boolean cliBridgeEnabled(Config cfg, Theta θ) {
        return Deepagents.routeCarriesTools(cfg, "cli", θ);                                                 // first member of the (carries, reason) pair // src: vvaharness/orchestrator/preflight.py:475
    }

    /** The unwrapped upstream rejection text, plus our own wrapper line when it adds a hint. */
    @src("vvaharness/orchestrator/preflight.py:490")
    String upstreamMessage(Exception e) {
        // first link in the cause chain that carries an HTTP status_code, else e itself
        Exception link = Exceptions.exceptionChain(e).firstOrDefault(lk -> lk.statusCode != null, e);      // src: vvaharness/orchestrator/preflight.py:499
        // body first: openai re-wraps .body in .message, so an anchored strip on .message never matches
        String body = link.body instanceof String && !link.body.isEmpty() ? link.body : llmModels.rejectionText(link); // src: vvaharness/orchestrator/preflight.py:502
        body = body.replaceFirst("^Could not process the query for model \\S+\\. Error: Error code: \\d+ - ?", ""); // gateway wrapper text // src: vvaharness/orchestrator/preflight.py:503
        List<String> lines = body.splitlines();                                                             // src: vvaharness/orchestrator/preflight.py:504
        String upstream = (lines.isEmpty() ? "" : lines.get(0)).strip();                                    // src: vvaharness/orchestrator/preflight.py:505
        if (upstream.isEmpty()) upstream = "(no message)";                                                  // src: vvaharness/orchestrator/preflight.py:505
        if (link == e) return upstream;                                                                     // src: vvaharness/orchestrator/preflight.py:506
        // a wrapper exception (for example the openai fail-fast) carries routing info the upstream body never does
        String wrapper = e.toString().collapseWhitespace();                                                 // src: vvaharness/orchestrator/preflight.py:508
        return wrapper.isEmpty() || wrapper == upstream ? upstream : wrapper + " | upstream: " + upstream;  // src: vvaharness/orchestrator/preflight.py:509
    }

    /** Smoke-probe the agentic() backend path for the preprocess, verify and threatmodel roles (forced tool round-trip with a nonce). */
    @src("vvaharness/orchestrator/preflight.py:512")
    boolean probeAgenticRoles(Config cfg, Theta θ) {
        // provider is in the key so two providers sharing a model id are both tested
        Map<Tuple, Triple<Object, List<String>, List<String>>> targets = new Map();                         // src: vvaharness/orchestrator/preflight.py:519
        List<String> agenticRolesList = agenticRoles(cfg, θ);                                               // src: vvaharness/orchestrator/preflight.py:520
        boolean ok = true;
        for (Role r : ConfigPaths.iterModelRoles(cfg)) {                                                    // src: vvaharness/orchestrator/preflight.py:522
