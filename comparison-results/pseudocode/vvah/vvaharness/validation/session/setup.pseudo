// file: vvaharness/validation/session/setup.py
// Validation-specific values injected into the shared harness: skill root, write gate, tool policy,
// fact-tool grant, output schema and the DeepAgents validation tools.

@executedBy(CODE) @role(config) @stage("S11")
class SessionSetup {

    String VALIDATION_GRAPH_NAME = "validation";                                                     // cosmetic  // src: vvaharness/validation/session/setup.py:31

    Path validationSkillRoot(Path workspace) {
        return workspace.resolve(".claude").resolve("skills");                                       // src: vvaharness/validation/session/setup.py:39
    }

    PermissionsPolicy validationWriteGate(Path workspace, Theta θ) {
        return new PermissionsPolicy(workspace, ConstantsPolicy.defaultAllowedOutputFiles(θ));       // src: vvaharness/validation/session/setup.py:44
    }

    ToolPolicy validationPolicy(Theta θ) {
        return ConstantsPolicy.validationPolicy(θ);                                                  // src: vvaharness/validation/session/setup.py:24
    }

    List<String> defaultFactTools(Theta θ) {
        return ConstantsTools.defaultFactTools(θ);                                                   // src: vvaharness/validation/session/setup.py:26
    }

    List<Tool> buildValidationTools(Path workspace, Theta θ) {
        return DeepTools.buildValidationTools(workspace, θ);                                         // src: vvaharness/validation/session/setup.py:28
    }
}
