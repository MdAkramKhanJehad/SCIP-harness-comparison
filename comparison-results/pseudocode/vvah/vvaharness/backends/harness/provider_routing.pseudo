// file: vvaharness/backends/harness/provider_routing.py
// Which vendor a (model, provider) pair resolves to, and the credential env overrides for that vendor.
// Must not import deepagents/langchain/anthropic/openai (preflight and manifest rely on that).

@executedBy(CODE) @role(config)
class ProviderRouting {

    // Manifest/telemetry names for the OpenAI-branch transport.
    List<String> transports() {
        return List.of("responses", "chat_completions");                                                 // src: vvaharness/backends/harness/provider_routing.py:33
    }

    // Explicit provider wins (anything other than "anthropic" is OpenAI-compatible, including unknown values);
    // otherwise route on the model name.
    boolean routesToAnthropic(String modelId, String provider, Theta θ) {
        if (provider != null && !provider.isEmpty()) return provider.equals("anthropic");                // src: vvaharness/backends/harness/provider_routing.py:41
        return modelId.toLowerCase().contains(θ["code.backends.harness.provider_routing.anthropic_name_marker"]); // src: vvaharness/backends/harness/provider_routing.py:42
    }

    Map<String, String> credentialEnvOverrides(String modelId, String provider, Object sdkCfg, Object openaiCfg, Theta θ) {
        boolean isAnthropic = routesToAnthropic(modelId, provider, θ);                                   // src: vvaharness/backends/harness/provider_routing.py:49
        Object block = isAnthropic ? sdkCfg : openaiCfg;                                                 // src: vvaharness/backends/harness/provider_routing.py:50
        String prefix = isAnthropic ? "ANTHROPIC" : "OPENAI";                                            // src: vvaharness/backends/harness/provider_routing.py:51
        Map<String, String> overrides = new Map();
        if (block.apiKey != null) overrides.put(prefix + "_API_KEY", block.apiKey.strip());   // strip: trailing newline is an illegal header // src: vvaharness/backends/harness/provider_routing.py:57
        if (block.baseUrl != null) overrides.put(prefix + "_BASE_URL", block.baseUrl.strip());           // src: vvaharness/backends/harness/provider_routing.py:59
        return overrides;
    }
}
