// file: vvaharness/backends/llm/cli/session.py
// via: cli agentic session (the `claude` subprocess): turn watchdog, wall-clock kill, and a tool-less
// resume of the killed session that asks for its final answer.

@executedBy(CODE) @role(backend)
class CliSession {

    /** Ask the killed session for its final answer via `claude -p --resume <id> --tools ""`; None when not possible. */
    @src("vvaharness/backends/llm/cli/session.py:152")
    String finalizeViaResume(String sessionId, String model, Path cwd, int timeout, Schema jsonSchema, Prompt instruction, Theta θ) {
        if (instruction == null) instruction = CliFinalAnswerPrompt.finalAnswer(θ);                         // default for watchdog and wall-clock salvage // src: vvaharness/backends/llm/cli/session.py:145
        List<String> cmd = List.of("claude", "-p", "--resume", sessionId, "--model", model, "--tools", "", "--output-format", "json"); // src: vvaharness/backends/llm/cli/session.py:166
        if (jsonSchema != null && CliDiscovery.supportsJsonSchema()) cmd.add("--json-schema");               // src: vvaharness/backends/llm/cli/session.py:169
        Result result;
        try {
            result = Process.run(cmd, instruction, cwd, timeout);                                           // src: vvaharness/backends/llm/cli/session.py:173
        } catch (Exception exc) {
            return null;                                                                                    // src: vvaharness/backends/llm/cli/session.py:176
        }
        if (result.returncode != 0) {
            Envelope.raiseIfRefusedExit(result.stdout);                                                     // a refused resume must raise // src: vvaharness/backends/llm/cli/session.py:181
            return null;                                                                                    // src: vvaharness/backends/llm/cli/session.py:184
        }
        Envelope text = Envelope.parse(result.stdout);                                                      // src: vvaharness/backends/llm/cli/session.py:185
        Envelope.raiseIfRefused(text.stopReason);                                                           // src: vvaharness/backends/llm/cli/session.py:189
        return text.text;                                                                                   // src: vvaharness/backends/llm/cli/session.py:190
    }

    /** Watchdog: stop the run once assistant events (or message ids) reach max_turns, then resume for a final answer. */
    @src("vvaharness/backends/llm/cli/session.py:96")
    boolean turnWatchdog(String line, int cap, boolean byMessage) { }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/cli/session.py:145")
class CliFinalAnswerPrompt {

    Prompt finalAnswer(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.session.turn_limit_final_answer"]);                                                     // "Your turn limit was reached. Give your final answer now" // src: vvaharness/backends/llm/cli/session.py:146
        p.format(θ["p.session.final_answer_original_format"]);                                              // "in the exact format the original instructions asked for, using only what you already have." // src: vvaharness/backends/llm/cli/session.py:147
        p.forbid(θ["p.session.final_answer_no_tools"]);                                                     // "Do not use any tool." // src: vvaharness/backends/llm/cli/session.py:148
        return p;
    }
}
