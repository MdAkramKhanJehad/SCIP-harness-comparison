// file: vvaharness/validation/scoring/_configs.py
// The fix-validation ScoringConfig, derived from the engine's FIX_POLICY (gates, weights, critical gates, bands).

@executedBy(CODE) @role(config) @stage("S11")
class ScoringConfigs {

    ScoringConfig fixConfig(Theta θ) {
        ScoringPolicy fixPolicy = new ScoringPolicy(Models.FIX_VALIDATION_GATES,                     // FIX_POLICY (constants/scoring.py)
            θ["code.s11.gate_weights"],                                                              // src: vvaharness/validation/constants/scoring.py:35
            θ["code.validation.constants.scoring.critical_gates"],                                   // src: vvaharness/validation/constants/scoring.py:43
            θ["code.s11.score_thresholds"].get("fixed"),                                             // ready_at 0.80  // src: vvaharness/validation/constants/scoring.py:50
            θ["code.s11.score_thresholds"].get("partially_fixed"));                                  // conditional_at 0.50  // src: vvaharness/validation/constants/scoring.py:51
        return Scoring.fromPolicy(fixPolicy, "fix", "gate_name",                                     // src: vvaharness/validation/scoring/_configs.py:33
                                  θ["code.validation.constants.scoring.status_multiplier"],          // src: vvaharness/validation/scoring/_configs.py:37
                                  Justify.buildFixJustification);                                    // src: vvaharness/validation/scoring/_configs.py:38
    }
}
