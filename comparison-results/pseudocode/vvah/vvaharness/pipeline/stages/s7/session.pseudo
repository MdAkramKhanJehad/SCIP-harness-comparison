// file: vvaharness/pipeline/stages/s7/session.py
// Step 7's one model call: the semantic dedup pass, degrading to no-collapse on any failure.

@executedBy(CODE) @role(step) @stage("S7")
class S7Session {

    // VVAH-E003 response floors (code constants): MIN_RESPONSE_CHARS = 90, MIN_RESPONSE_TOKENS = 15.

    List<DedupRow> semanticDedup(List<Finding> verified, List<Integer> unresolved, Theta θ, ContextPackage ctx, String label) {
        String tag = label.replace("-", " ");                                                   // src: vvaharness/pipeline/stages/s7/session.py:41
        Effort effort = θ["step7_dedup.effort"];                                                // src: vvaharness/pipeline/stages/s7/session.py:42
        String raw;
        try {
            // Floors: a reply shorter than 90 chars / 15 tokens is a quality failure (VVAH-E003).
            raw = ResponseQuality.dispatchOrRetryUnforced(
                dropThinking -> dispatch(verified, unresolved, θ, ctx, tag, dropThinking ? null : effort),
                "semantic", mayRetry = effort != null,
                resendRefusal = LlmRegistry.refusalResendAllowed(θ, θ["models.dedup.id"]));          // src: vvaharness/pipeline/stages/s7/session.py:63
        } catch (Exception e) {
            if (Harness.isHaltError(e)) throw e;                                                // src: vvaharness/pipeline/stages/s7/session.py:69
            Console.write("[" + label + "] semantic dedup call failed (non-fatal)");            // src: vvaharness/pipeline/stages/s7/session.py:71
            Errlog.log(label, "semantic", e);
            return List.of();                                                                    // src: vvaharness/pipeline/stages/s7/session.py:74
        }
        return S7Outcomes.parseDecisions(raw, unresolved.size(), label);                        // src: vvaharness/pipeline/stages/s7/session.py:75
    }

    String dispatch(List<Finding> verified, List<Integer> unresolved, Theta θ, ContextPackage ctx, String tag, Effort effort) {
        ModelSpec model = new ModelSpec(θ["models.dedup.id"], θ["models.dedup.via"], θ["models.dedup.provider"], effort, θ["step7_dedup.max_tokens"]); // src: vvaharness/pipeline/stages/s7/session.py:52
        // cwd roots the virtual filesystem at the repo; one structured call, no tools needed.
        return Runtime.llm(model, S7Prompts.system(θ), S7Prompts.buildPayload(verified, unresolved, θ), S7Outcomes.schema(θ)); // src: vvaharness/pipeline/stages/s7/session.py:46
    }
}
