// file: vvaharness/remediation_agent/artifacts/writer.py
// Persists one remediation attempt: finding_case.json at the root plus evidence/ (triage.json, summary.md, diff.patch),
// with secrets redacted at persistence; the diff is masked hunk-by-hunk preserving diff framing and line endings.

@executedBy(CODE) @role(io) @stage("S10")
class Writer {

    void writeCase(Path outDir, RemediationVerdict verdict, Remediation remediation, Map meta, RemediationTarget target, List<String> revertedPaths, Theta θ) {
        outDir.mkdirs();                                                                            // src: vvaharness/remediation_agent/artifacts/writer.py:104
        Path evidenceDir = outDir.join(Layout.EVIDENCE_DIR);                                        // src: vvaharness/remediation_agent/artifacts/writer.py:105
        evidenceDir.mkdirs();
        Map payload = verdict.dump().plus(meta).with("diff_captured", remediation.diff != null && !remediation.diff.isEmpty()); // src: vvaharness/remediation_agent/artifacts/writer.py:107
        // Redact string leaves BEFORE serialising so a secret match cannot corrupt JSON escapes.
        evidenceDir.join(Layout.TRIAGE_JSON).writeText(Json.dump(Redact.redactTree(payload)));     // src: vvaharness/remediation_agent/artifacts/writer.py:110
        evidenceDir.join(Layout.SUMMARY_MD).writeText(Redact.redact(Summary.renderSummary(verdict, meta))); // src: vvaharness/remediation_agent/artifacts/writer.py:112
        if (remediation.diff != null && !remediation.diff.isEmpty()) {                              // src: vvaharness/remediation_agent/artifacts/writer.py:114
            evidenceDir.join(Layout.DIFF_PATCH).writeText(redactDiff(remediation.diff, θ));         // src: vvaharness/remediation_agent/artifacts/writer.py:115
        }
        if (target != null) {                                                                       // src: vvaharness/remediation_agent/artifacts/writer.py:118  (case file only with a target)
            FindingCase c = ArtifactsReport.buildReport(target, remediation, revertedPaths);        // src: vvaharness/remediation_agent/artifacts/writer.py:119
            writeJson(outDir.join(Layout.FINDING_CASE_JSON), redactedCase(c, θ));                   // src: vvaharness/remediation_agent/artifacts/writer.py:120
        }
    }

    Map redactedCase(FindingCase c, Theta θ) {
        Map payload = Redact.redactTree(c.dumpJson());                                              // src: vvaharness/remediation_agent/artifacts/writer.py:125
        for (int i = 0; i < c.attempts.size(); i++) {                                               // src: vvaharness/remediation_agent/artifacts/writer.py:126
            payload.get("attempts").get(i).get("remediation").put("diff", redactDiff(c.attempts.get(i).remediation.diff, θ)); // src: vvaharness/remediation_agent/artifacts/writer.py:127
        }
        return payload;
    }

    Pair<String, String> lineParts(String line) {
        if (line.endsWith("CRLF")) return new Pair(line.dropLast(2), "CRLF");                       // src: vvaharness/remediation_agent/artifacts/writer.py:133
        if (line.endsWith("CR") || line.endsWith("LF")) return new Pair(line.dropLast(1), line.last(1)); // src: vvaharness/remediation_agent/artifacts/writer.py:135
        return new Pair(line, "");                                                                  // src: vvaharness/remediation_agent/artifacts/writer.py:137
    }

    List<Span> privateKeyPayloads(String body) {
        // A bare base64 line, or base64 wrapped in quotes / XML element text.
        List<Span> matches = new List();
        Match bare = Regex.fullmatch("quote? base64(2+) quote? sep?", body);                        // src: vvaharness/remediation_agent/artifacts/writer.py:142
        if (bare != null) matches.add(bare.span("body"));                                           // src: vvaharness/remediation_agent/artifacts/writer.py:144
        matches.addAll(Regex.finditer("quote-or-gt base64(2+) before-quote-or-lt", body).map(m -> m.span("body"))); // src: vvaharness/remediation_agent/artifacts/writer.py:145
        return matches.distinct();                                                                  // src: vvaharness/remediation_agent/artifacts/writer.py:149
    }

    boolean shortPrivateKeyFragment(String body) {
        return privateKeyPayloads(body).any(p -> p.text.length() >= 4 && p.text.length() % 4 == 0); // src: vvaharness/remediation_agent/artifacts/writer.py:153
    }

    boolean privateKeyFragment(String body, boolean continuation, Theta θ) {
        // Conservative PEM payload recognition without local delimiters.
        boolean explicitContext = Regex.search("private_key / pem / key-data element or assignment with base64 value", body); // src: vvaharness/remediation_agent/artifacts/writer.py:161
        if (Regex.match("^(Proc-Type|DEK-Info):", body.strip())) return true;                       // src: vvaharness/remediation_agent/artifacts/writer.py:162
        return privateKeyPayloads(body).any(p ->
            θ["code.remediation_agent.artifacts.writer.pem_payload_prefixes"].any(pre -> p.text.startsWith(pre))   // src: vvaharness/remediation_agent/artifacts/writer.py:165
            || p.text.length() >= θ["code.remediation_agent.artifacts.writer.pem_fragment_min_len"]                // src: vvaharness/remediation_agent/artifacts/writer.py:166
            || ((continuation || explicitContext) && p.text.length() % 4 == 0));                    // src: vvaharness/remediation_agent/artifacts/writer.py:167
    }

    String replaceSpans(String text, List<Span> spans) {
        for (Span s : spans.distinct().sortedDescending()) {                                        // src: vvaharness/remediation_agent/artifacts/writer.py:173
            text = text.substring(0, s.start) + "[REDACTED-PRIVATE-KEY]" + text.substring(s.end);   // src: vvaharness/remediation_agent/artifacts/writer.py:174
        }
        return text;
    }

    String maskPrivateKeyBody(String body) {
        List<Span> spans = Regex.finditer("-----(BEGIN|END) ... PRIVATE KEY-----", body).map(m -> m.span()); // src: vvaharness/remediation_agent/artifacts/writer.py:179
        spans.addAll(privateKeyPayloads(body));                                                     // src: vvaharness/remediation_agent/artifacts/writer.py:180
        return spans.isEmpty() ? "[REDACTED-PRIVATE-KEY]" : replaceSpans(body, spans);              // src: vvaharness/remediation_agent/artifacts/writer.py:181
    }

    String maskDiffLine(String line) {
        Pair<String, String> lp = lineParts(line);                                                  // src: vvaharness/remediation_agent/artifacts/writer.py:185
        return lp.first.substring(0, 1) + maskPrivateKeyBody(lp.first.substring(1)) + lp.second;   // src: vvaharness/remediation_agent/artifacts/writer.py:186
    }

    String redactDiffText(String text, Theta θ) {
        // Keep complete credential reads from safe sources (os.environ[...], getenv, config/settings/secrets[...], process.env)
        // when they are the right-hand side of a secret-named assignment, so a correct fix is not masked into nonsense.
        if (!θ["code.remediation_agent.artifacts.writer.preserve_safe_config_reads"]) return Redact.redact(text);
        List<Match> safeReads = Regex.finditer("safe config read", text).filter(m -> Regex.search("secret-named assignment prefix", text.substring(0, m.start)) && Regex.fullmatch("closing punct/comment suffix", text.substring(m.end))); // src: vvaharness/remediation_agent/artifacts/writer.py:191
        if (safeReads.isEmpty()) return Redact.redact(text);                                        // src: vvaharness/remediation_agent/artifacts/writer.py:198
        String prot = text;
        List<Pair<String, String>> replacements = new List();
        for (int index = safeReads.size() - 1; index >= 0; index--) {                               // src: vvaharness/remediation_agent/artifacts/writer.py:202
            String marker = "VVAHARNESS_SAFE_CONFIG_READ_" + index;                                 // src: vvaharness/remediation_agent/artifacts/writer.py:203
            while (text.contains(marker)) marker = marker + "_";                                    // src: vvaharness/remediation_agent/artifacts/writer.py:204
            replacements.add(new Pair(marker, safeReads.get(index).group(0)));
            prot = prot.substring(0, safeReads.get(index).start) + marker + prot.substring(safeReads.get(index).end); // src: vvaharness/remediation_agent/artifacts/writer.py:207
        }
        String masked = Redact.redact(prot);                                                        // src: vvaharness/remediation_agent/artifacts/writer.py:209
        for (Pair<String, String> r : replacements) masked = masked.replace(r.first, r.second);     // src: vvaharness/remediation_agent/artifacts/writer.py:211
        return masked;
    }

    String redactUnstructuredDiffText(String text, boolean continuation, Theta θ) {
        if (Regex.search("PEM boundary", text) || privateKeyFragment(text, continuation, θ)) text = maskPrivateKeyBody(text); // src: vvaharness/remediation_agent/artifacts/writer.py:216
        return redactDiffText(text, θ);                                                             // src: vvaharness/remediation_agent/artifacts/writer.py:221
    }

    String redactDiff(String diff, Theta θ) {
        // Mask hunk payloads while preserving diff framing and line endings exactly.
        List<String> redacted = new List();
        int oldRemaining = 0;
        int newRemaining = 0;
        boolean oldPrivateKey = false;
        boolean newPrivateKey = false;
        boolean oldFragment = false;
        boolean newFragment = false;
        Integer oldPending = null;
        Integer newPending = null;
        for (String physicalLine : diff.splitlinesKeepends()) {                                     // src: vvaharness/remediation_agent/artifacts/writer.py:233
            Pair<String, String> lp = lineParts(physicalLine);
            String line = lp.first;
            String ending = lp.second;
            Match header = Regex.match("^@@ -N(,old_count)? +N(,new_count)? @@", line);             // src: vvaharness/remediation_agent/artifacts/writer.py:235
            if (header != null) {                                                                   // src: vvaharness/remediation_agent/artifacts/writer.py:236
                oldPrivateKey = false; newPrivateKey = false; oldFragment = false; newFragment = false; oldPending = null; newPending = null;
                oldRemaining = header.groupInt("old_count", 1);                                     // src: vvaharness/remediation_agent/artifacts/writer.py:240
                newRemaining = header.groupInt("new_count", 1);                                     // src: vvaharness/remediation_agent/artifacts/writer.py:241
                redacted.add(line.substring(0, header.end) + redactUnstructuredDiffText(line.substring(header.end), false, θ) + ending); // src: vvaharness/remediation_agent/artifacts/writer.py:242
                continue;
            }
            boolean inHunk = oldRemaining > 0 || newRemaining > 0;                                  // src: vvaharness/remediation_agent/artifacts/writer.py:249
            if (line.startsWith("\\")) {                                                            // src: vvaharness/remediation_agent/artifacts/writer.py:250  (no-newline marker)
                redacted.add("\\" + redactDiffText(line.substring(1), θ) + ending);
                continue;
            }
            String prefix = line.substring(0, 1);
            if (!inHunk) {                                                                          // src: vvaharness/remediation_agent/artifacts/writer.py:255
                oldPrivateKey = false; newPrivateKey = false; oldFragment = false; newFragment = false; oldPending = null; newPending = null;
                // diff --git, index, ---, +++, mode, similarity, rename, copy, Binary, GIT binary patch, literal, delta, synth header
                if (θ["code.remediation_agent.artifacts.writer.diff_structure_prefixes"].any(p -> line.startsWith(p))) { // src: vvaharness/remediation_agent/artifacts/writer.py:259
                    redacted.add(physicalLine);                                                     // src: vvaharness/remediation_agent/artifacts/writer.py:260  (framing passes raw)
                } else {
                    redacted.add(redactUnstructuredDiffText(line, false, θ) + ending);              // src: vvaharness/remediation_agent/artifacts/writer.py:262
                }
                continue;
            }
            if (!List.of(" ", "+", "-").contains(prefix)) {                                         // src: vvaharness/remediation_agent/artifacts/writer.py:265
                if (θ["code.remediation_agent.artifacts.writer.diff_structure_prefixes"].any(p -> line.startsWith(p))) { // src: vvaharness/remediation_agent/artifacts/writer.py:266
                    oldRemaining = 0; newRemaining = 0;
                    oldPrivateKey = false; newPrivateKey = false; oldFragment = false; newFragment = false; oldPending = null; newPending = null;
                    redacted.add(physicalLine);                                                     // src: vvaharness/remediation_agent/artifacts/writer.py:271
                } else {
                    // Unknown in-hunk input is content: stay safe, no raw passthrough.
                    redacted.add(redactUnstructuredDiffText(line, oldPrivateKey || newPrivateKey, θ) + ending); // src: vvaharness/remediation_agent/artifacts/writer.py:274
                }
                continue;
            }
            String body = line.substring(1);                                                        // src: vvaharness/remediation_agent/artifacts/writer.py:281
            boolean oldLine = prefix.equals(" ") || prefix.equals("-");                             // src: vvaharness/remediation_agent/artifacts/writer.py:282
            boolean newLine = prefix.equals(" ") || prefix.equals("+");                             // src: vvaharness/remediation_agent/artifacts/writer.py:283
            boolean boundary = Regex.search("PEM boundary", body);                                  // src: vvaharness/remediation_agent/artifacts/writer.py:284
            boolean begins = body.contains("-----BEGIN ") && body.contains("PRIVATE KEY-----");      // src: vvaharness/remediation_agent/artifacts/writer.py:285
            boolean ends = body.contains("-----END ") && body.contains("PRIVATE KEY-----");          // src: vvaharness/remediation_agent/artifacts/writer.py:286
            if (ends) {                                                                             // src: vvaharness/remediation_agent/artifacts/writer.py:287
                // Retro-mask the pending short fragment lines of this key block.
                if (oldLine && oldPending != null) redacted.set(oldPending, maskDiffLine(redacted.get(oldPending))); // src: vvaharness/remediation_agent/artifacts/writer.py:295
                if (newLine && newPending != null) redacted.set(newPending, maskDiffLine(redacted.get(newPending)));
            }
            boolean fragment = privateKeyFragment(body, (oldLine && oldFragment) || (newLine && newFragment), θ); // src: vvaharness/remediation_agent/artifacts/writer.py:297
            boolean mask = boundary || fragment || (oldLine && oldPrivateKey) || (newLine && newPrivateKey); // src: vvaharness/remediation_agent/artifacts/writer.py:301
            String safeBody = mask ? maskPrivateKeyBody(body) : redactDiffText(body, θ);            // src: vvaharness/remediation_agent/artifacts/writer.py:307
            redacted.add(prefix + safeBody + ending);                                               // src: vvaharness/remediation_agent/artifacts/writer.py:308
            int outputIndex = redacted.size() - 1;
            boolean shortFragment = shortPrivateKeyFragment(body);                                  // src: vvaharness/remediation_agent/artifacts/writer.py:310
            if (oldLine) {                                                                          // src: vvaharness/remediation_agent/artifacts/writer.py:312
                oldPrivateKey = (oldPrivateKey || begins) && !ends;
                oldFragment = fragment && !ends;
                oldPending = (shortFragment && !ends) ? outputIndex : null;
                if (oldRemaining > 0) oldRemaining = oldRemaining - 1;                              // src: vvaharness/remediation_agent/artifacts/writer.py:316
            }
            if (newLine) {                                                                          // src: vvaharness/remediation_agent/artifacts/writer.py:318
                newPrivateKey = (newPrivateKey || begins) && !ends;
                newFragment = fragment && !ends;
                newPending = (shortFragment && !ends) ? outputIndex : null;
                if (newRemaining > 0) newRemaining = newRemaining - 1;                              // src: vvaharness/remediation_agent/artifacts/writer.py:322
            }
            if (oldRemaining == 0 && newRemaining == 0) {                                           // src: vvaharness/remediation_agent/artifacts/writer.py:325  (hunk finished)
                oldPrivateKey = false; newPrivateKey = false; oldFragment = false; newFragment = false; oldPending = null; newPending = null;
            }
        }
        return redacted.join("");                                                                   // src: vvaharness/remediation_agent/artifacts/writer.py:330
    }

    void writeJson(Path path, Map payload) {
        // Atomic write so a concurrent reader never sees a partial file.
        Path tmp = path.withSuffix(path.suffix + ".tmp");                                           // src: vvaharness/remediation_agent/artifacts/writer.py:335
        tmp.writeText(Json.dump(payload) + "\n");                                                   // src: vvaharness/remediation_agent/artifacts/writer.py:336
        tmp.replace(path);                                                                          // src: vvaharness/remediation_agent/artifacts/writer.py:337
    }
}
