Executor: code
Called from: `vvaharness/orchestrator/store/_db.py` connect (`_migrate`)

// src: vvaharness/orchestrator/store/_schema.py:18-150
_DDL {
  // auto_vacuum must precede the first CREATE TABLE; WAL journal mode persists once set
  pragmas: "auto_vacuum = INCREMENTAL", "journal_mode = WAL"
  runs { run_id: primary key; repo_root; repo_name; app_id; started_at; updated_at }
  checkpoints { run_id -> runs ON DELETE CASCADE; step; payload: BLOB; size: CHECK (size <= 104857600); created_at; primary key (run_id, step) }
  ev_replays { run_id -> runs ON DELETE CASCADE; finding_key; payload; size: CHECK (size <= 1048576); primary key (run_id, finding_key) }
  // ev_replays is deliberately not a checkpoints row: it must survive a fresh rescan's reset_run so a later ev-replay works after remediation
  ev_probes { id; run_id -> runs ON DELETE CASCADE; finding_key; finding fields; request and response fields (credential material redacted by the caller); auth_applied holds channel names only }
  // ev_probes is written only when step6_exploit_verification.store_probes is on
  callgraph_snapshots { run_id -> runs; graph_id; node_count; edge_count; entry_point_count; sink_count; primary key (run_id, graph_id) }
  callgraph_nodes { run_id; graph_id; qnode; file_path; function_name; start_line; end_line; is_entry_point; entry_kind; reachable_from_unauth; is_sink; sink_line; -> callgraph_snapshots ON DELETE CASCADE }
  callgraph_edges { run_id; graph_id; caller_qnode; callee_qnode; -> callgraph_snapshots ON DELETE CASCADE }
  callgraph_stage_refs { run_id -> runs; step; graph_id -> callgraph_snapshots; primary key (run_id, step) }
  indexes: runs(updated_at), stage refs by graph, nodes by file and function, edges by caller, edges by callee
}

// src: vvaharness/orchestrator/store/_schema.py:152-210
_DDL_V2 { the four callgraph tables and their indexes, as in _DDL }   // migration from version 1

// src: vvaharness/orchestrator/store/_schema.py:213-253
_DDL_V3 { ev_replays and ev_probes with their indexes, as in _DDL }   // migration from version 2; idempotent

