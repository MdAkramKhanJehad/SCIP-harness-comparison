                    if (!ScanProgress.isStageOnly()) Console.write("tool " + b.name + "(" + LlmTools.summarizeArgs(b.input) + ") -> " + out.length() + " chars"); // src: vvaharness/backends/llm/sdk.py:1557
                }
                results.add(Map.of("type", "tool_result", "tool_use_id", b.id, "content", out));            // src: vvaharness/backends/llm/sdk.py:1560
            }
            messages.add(Map.of("role", "user", "content", results));                                       // cache_control is applied at request time; history stays marker-free under the 4-block cap // src: vvaharness/backends/llm/sdk.py:1564
        }
        return forceFinalAnswer(client, messages, baseKw, tools, model, systemPrompt, responseModel, turnsCap, outCap, tag, effort, requestTimeout, sessionT0, sessionBudget, θ); // budget exhausted // src: vvaharness/backends/llm/sdk.py:1566
    }

    /** One agentic turn's request with its inner retry ladder (context eviction, tool_choice and thinking param-drops, bounded transients). */
    @src("vvaharness/backends/llm/sdk.py:1352")
    Message sendAgenticTurn(Object client, List<Map> messages, Map baseKw, String model, String systemPrompt, Schema responseModel, String toolsText, int turn, String tag, String effort, double requestTimeout, double sessionT0, Double sessionBudget) {
        Message msg = null;
        int transients = 0;                                                                                 // src: vvaharness/backends/llm/sdk.py:1352
        int shrinks = 0;                                                                                    // src: vvaharness/backends/llm/sdk.py:1353
        while (msg == null) {                                                                               // src: vvaharness/backends/llm/sdk.py:1354
            try {
                double t0 = Clock.monotonic();                                                              // src: vvaharness/backends/llm/sdk.py:1356
                Map send = LlmModels.turnOptions(sessionT0, sessionBudget, requestTimeout);                 // src: vvaharness/backends/llm/sdk.py:1357
                msg = drainWithinDeadline(client.withOptions(send).messages.stream(withCacheMarker(client, messages), baseKw), t0 + send.get("timeout"), tag, effort, requestTimeout); // src: vvaharness/backends/llm/sdk.py:1359
                LlmModels.noteBudgetUse(Clock.monotonic() - t0, requestTimeout, effort);                    // src: vvaharness/backends/llm/sdk.py:1366
            } catch (ApiStatusError e) {
                // auth FIRST, same rule as prompt(): a mid-scan expired credential is unhealable and must not spend the transient ladder
                if (authFailureSdk(e)) throw new AuthenticationError(Redact.redact(e.message, false, null).substring(0, 400), e.statusCode, "sdk"); // src: vvaharness/backends/llm/sdk.py:1370
                String low = LlmModels.rejectionText(e).lower();                                            // src: vvaharness/backends/llm/sdk.py:1374
                // context-window overflow: evict the oldest oversized tool result and retry, as the openai loop always did; bounded at 16 evictions
                if (LlmModels.PARAM_REJECTION_STATUS.contains(e.statusCode) && CTX_OVERFLOW_RX.search(low) && shrinks < θ["code.backends.llm.sdk.max_history_evictions"] && shrinkHistory(messages)) { // src: vvaharness/backends/llm/sdk.py:1377
                    shrinks += 1;                                                                           // src: vvaharness/backends/llm/sdk.py:1379
                    continue;                                                                               // src: vvaharness/backends/llm/sdk.py:1382
                }
                // tool_choice BEFORE thinking, as in prompt(): bounded, since the memo unforces
                if (unforceRejectedToolChoice(baseKw, e, low, client, model, systemPrompt, responseModel, toolsText)) continue; // src: vvaharness/backends/llm/sdk.py:1384
                // only memoise the model as thinking-incapable when the body names the FEATURE
                if (LlmModels.PARAM_REJECTION_STATUS.contains(e.statusCode) && baseKw.containsKey("thinking") && low.contains("thinking")) { // src: vvaharness/backends/llm/sdk.py:1391
                    List<String> markers = θ["code.backends.llm.sdk.thinking_unsupported_markers"];
                    boolean unsupported = markers.any(m -> low.contains(m));                                // src: vvaharness/backends/llm/sdk.py:1394
                    if (unsupported) NO_THINK_MODELS.add(model);                                            // src: vvaharness/backends/llm/sdk.py:1398
                    baseKw.remove("thinking");                                                              // src: vvaharness/backends/llm/sdk.py:1399
                    baseKw.remove("output_config");                                                         // src: vvaharness/backends/llm/sdk.py:1400
                    reforceToolChoice(baseKw, Map.of("type", "any"), client, model, systemPrompt, responseModel, toolsText); // src: vvaharness/backends/llm/sdk.py:1401
                    continue;                                                                               // src: vvaharness/backends/llm/sdk.py:1406
                }
                if (isTransientSdk(e) && transients < θ["code.backends.llm.sdk.agentic_transient_retries"]) { // src: vvaharness/backends/llm/sdk.py:1408
                    transients += 1;                                                                        // src: vvaharness/backends/llm/sdk.py:1409
                    double wait = LlmModels.jitteredDelay(Math.min(θ["code.backends.llm.sdk.agentic_backoff_cap_s"], θ["code.backends.llm.sdk.agentic_backoff_step_s"] * transients)); // src: vvaharness/backends/llm/sdk.py:1410
                    Exception overrun = LlmModels.waitOverrun(wait, sessionT0, sessionBudget, tag != null ? tag : "", "sdk", effort); // src: vvaharness/backends/llm/sdk.py:1411
                    if (overrun != null) throw overrun;                                                     // src: vvaharness/backends/llm/sdk.py:1413
                    Thread.sleep(wait);                                                                     // src: vvaharness/backends/llm/sdk.py:1419
                    continue;                                                                               // src: vvaharness/backends/llm/sdk.py:1420
                }
                throw new RuntimeError(Redact.redact("Anthropic SDK agentic call failed (status=" + e.statusCode + ", turn=" + turn + ")", false, null)); // src: vvaharness/backends/llm/sdk.py:1421
            } catch (ApiConnectionError | TransportError e) {                                               // src: vvaharness/backends/llm/sdk.py:1423
                if (ResponseQuality.isTimeoutFailure(e, null)) throw LlmModels.callTimeoutError(tag != null ? tag : "", "sdk", requestTimeout, effort, "Anthropic SDK agentic call exceeded the request timeout"); // src: vvaharness/backends/llm/sdk.py:1424
                Exception proxy = LlmModels.proxyError(e, "sdk");                                           // src: vvaharness/backends/llm/sdk.py:1429
                if (proxy != null) throw proxy;                                                             // src: vvaharness/backends/llm/sdk.py:1430
                if (transients < θ["code.backends.llm.sdk.agentic_transient_retries"]) {                    // src: vvaharness/backends/llm/sdk.py:1431
                    transients += 1;                                                                        // src: vvaharness/backends/llm/sdk.py:1432
                    double wait = LlmModels.jitteredDelay(Math.min(θ["code.backends.llm.sdk.agentic_backoff_cap_s"], θ["code.backends.llm.sdk.agentic_backoff_step_s"] * transients)); // src: vvaharness/backends/llm/sdk.py:1433
                    Exception overrun = LlmModels.waitOverrun(wait, sessionT0, sessionBudget, tag != null ? tag : "", "sdk", effort); // src: vvaharness/backends/llm/sdk.py:1434
                    if (overrun != null) throw overrun;                                                     // src: vvaharness/backends/llm/sdk.py:1436
                    Thread.sleep(wait);                                                                     // src: vvaharness/backends/llm/sdk.py:1441
                    continue;                                                                               // src: vvaharness/backends/llm/sdk.py:1442
                }
                throw new RuntimeError(Redact.redact("Anthropic SDK agentic connection error (turn=" + turn + ")", false, null)); // src: vvaharness/backends/llm/sdk.py:1443
            }
        }
        return msg;
    }

    /** Turn budget exhausted: append the forcing instruction and make one last request (forced tool, tools forbidden, or unforced). */
    @src("vvaharness/backends/llm/sdk.py:1566")
    String forceFinalAnswer(Object client, List<Map> messages, Map baseKw, List<Map> tools, String model, String systemPrompt, Schema responseModel, int turnsCap, int outCap, String tag, String effort, double requestTimeout, double sessionT0, Double sessionBudget, Theta θ) {
        // unlike oai.agentic() the full tools list stays: the memo arm only catches a rejection naming tool_choice, not one of a rewritten list
        log.warning(Events.LLM_TURN_CAP_EXHAUSTED);                                                        // src: vvaharness/backends/llm/sdk.py:1568
        Counters.bump("llm_turn_cap_exhausted", 1);                                                         // src: vvaharness/backends/llm/sdk.py:1569
        // block-shaped, not a bare string, so the tail marker can land on it
        messages.add(Map.of("role", "user", "content", List.of(Map.of("type", "text", "text", TurnCapPrompt.finalAnswer(responseModel != null, θ))))); // src: vvaharness/backends/llm/sdk.py:1572
        Map finalKw = baseKw.withoutKey("tools");                                                           // src: vvaharness/backends/llm/sdk.py:1587
        // forced (or tools forbidden) unless the model rejects forcing or thinking is manual; none is never withheld (every model accepts it)
        if (responseModel == null) finalKw.put("tool_choice", Map.of("type", "none"));                      // src: vvaharness/backends/llm/sdk.py:1594
        else if (forcingBlocked(model, finalKw.get("thinking"))) finalKw.remove("tool_choice");             // src: vvaharness/backends/llm/sdk.py:1595
        else finalKw.put("tool_choice", Map.of("type", "tool", "name", RESPONSE_MODEL_TOOL_NAME));          // src: vvaharness/backends/llm/sdk.py:1598
        finalKw.put("tools", tools);                                                                        // API requires tools when tool_choice is set // src: vvaharness/backends/llm/sdk.py:1599
        int finalTransients = 0;                                                                            // src: vvaharness/backends/llm/sdk.py:1603
        Message msg;
        while (true) {                                                                                      // src: vvaharness/backends/llm/sdk.py:1604
            try {
                double t0 = Clock.monotonic();                                                              // src: vvaharness/backends/llm/sdk.py:1606
                Map send = LlmModels.turnOptions(sessionT0, sessionBudget, requestTimeout);                 // src: vvaharness/backends/llm/sdk.py:1607
                msg = drainWithinDeadline(client.withOptions(send).messages.stream(withCacheMarker(client, messages), finalKw), t0 + send.get("timeout"), tag, effort, requestTimeout); // src: vvaharness/backends/llm/sdk.py:1609
                LlmModels.noteBudgetUse(Clock.monotonic() - t0, requestTimeout, effort);                    // src: vvaharness/backends/llm/sdk.py:1614
                break;                                                                                      // src: vvaharness/backends/llm/sdk.py:1615
            } catch (ApiStatusError e) {
                if (authFailureSdk(e)) throw new AuthenticationError(Redact.redact(e.message, false, null).substring(0, 400), e.statusCode, "sdk"); // auth-first, same rule as the turn loop // src: vvaharness/backends/llm/sdk.py:1617
                // bounded: the memo pops tool_choice, so the resend cannot fail the same way
                if (unforceRejectedToolChoice(finalKw, e, LlmModels.rejectionText(e).lower(), client, model, systemPrompt, responseModel, Json.dumps(finalKw.get("tools")))) continue; // src: vvaharness/backends/llm/sdk.py:1622
                if (isTransientSdk(e) && finalTransients < θ["code.backends.llm.sdk.agentic_transient_retries"]) { // src: vvaharness/backends/llm/sdk.py:1629
                    finalTransients += 1;                                                                   // src: vvaharness/backends/llm/sdk.py:1630
                    double wait = LlmModels.jitteredDelay(Math.min(θ["code.backends.llm.sdk.agentic_backoff_cap_s"], θ["code.backends.llm.sdk.agentic_backoff_step_s"] * finalTransients)); // src: vvaharness/backends/llm/sdk.py:1631
                    Exception overrun = LlmModels.waitOverrun(wait, sessionT0, sessionBudget, tag != null ? tag : "", "sdk", effort); // src: vvaharness/backends/llm/sdk.py:1632
                    if (overrun != null) throw overrun;                                                     // src: vvaharness/backends/llm/sdk.py:1634
                    Thread.sleep(wait);                                                                     // src: vvaharness/backends/llm/sdk.py:1639
                    continue;                                                                               // src: vvaharness/backends/llm/sdk.py:1640
                }
                throw new RuntimeError(Redact.redact("Anthropic SDK agentic forced-final failed (status=" + e.statusCode + ")", false, null)); // src: vvaharness/backends/llm/sdk.py:1641
            } catch (ApiConnectionError | TransportError e) {                                               // src: vvaharness/backends/llm/sdk.py:1645
                if (ResponseQuality.isTimeoutFailure(e, θ)) throw LlmModels.callTimeoutError(tag != null ? tag : "", "sdk", requestTimeout, effort, "Anthropic SDK agentic forced-final exceeded the request timeout"); // src: vvaharness/backends/llm/sdk.py:1646
                Exception proxy = LlmModels.proxyError(e, "sdk");                                           // src: vvaharness/backends/llm/sdk.py:1651
                if (proxy != null) throw proxy;                                                             // src: vvaharness/backends/llm/sdk.py:1652
                if (finalTransients < θ["code.backends.llm.sdk.agentic_transient_retries"]) {               // src: vvaharness/backends/llm/sdk.py:1653
                    finalTransients += 1;                                                                   // src: vvaharness/backends/llm/sdk.py:1654
                    double wait = LlmModels.jitteredDelay(Math.min(θ["code.backends.llm.sdk.agentic_backoff_cap_s"], θ["code.backends.llm.sdk.agentic_backoff_step_s"] * finalTransients)); // src: vvaharness/backends/llm/sdk.py:1655
                    Exception overrun = LlmModels.waitOverrun(wait, sessionT0, sessionBudget, tag != null ? tag : "", "sdk", effort); // src: vvaharness/backends/llm/sdk.py:1656
                    if (overrun != null) throw overrun;                                                     // src: vvaharness/backends/llm/sdk.py:1658
                    Thread.sleep(wait);                                                                     // src: vvaharness/backends/llm/sdk.py:1662
                    continue;                                                                               // src: vvaharness/backends/llm/sdk.py:1663
                }
                throw new RuntimeError(Redact.redact("Anthropic SDK agentic forced-final connection error", false, null)); // src: vvaharness/backends/llm/sdk.py:1664
            }
        }
        if (msg.usage != null) {                                                                            // src: vvaharness/backends/llm/sdk.py:1668
            Map finalUsage = msg.usage.modelDump();                                                         // src: vvaharness/backends/llm/sdk.py:1669
            noteUnparsedCacheKeys(finalUsage);                                                              // src: vvaharness/backends/llm/sdk.py:1670
            TokenCounter.add(finalUsage, null, null);                                                       // src: vvaharness/backends/llm/sdk.py:1671
        }
        Pair r = checkAgenticStop(msg, client, messages, finalKw, model, tag, outCap, responseModel, false, effort, requestTimeout, sessionT0, sessionBudget); // dispatchable false: no turn loop left // src: vvaharness/backends/llm/sdk.py:1672
        msg = r.first;
        if (r.second != null) return r.second;                                                              // src: vvaharness/backends/llm/sdk.py:1677
        raiseIfRefused(msg, tag);                                                                           // before the response_model branch, so the text-mode final is covered too // src: vvaharness/backends/llm/sdk.py:1680
        if (responseModel != null) return extractResponseModel(responseModel, msg, model).modelDumpJson();  // src: vvaharness/backends/llm/sdk.py:1682
        return msg.content.filter(b -> b.type == "text").map(b -> b.text).join("").strip();                 // src: vvaharness/backends/llm/sdk.py:1683
    }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/sdk.py:1572")
class TurnCapPrompt {

    Prompt finalAnswer(boolean hasResponseModel, Theta θ) {
        Prompt p = new Prompt();
        if (hasResponseModel) p.must(θ["p.sdk.turn_cap_forced_structured_answer"]);                         // "Tool budget exhausted. Call emit_structured_response now with your best answer based on what you have read so far." // src: vvaharness/backends/llm/sdk.py:1575
        else p.must(θ["p.sdk.turn_cap_forced_text_answer"]);                                                // "Tool budget exhausted. Reply now with your final answer ...; do not call any tool." // src: vvaharness/backends/llm/sdk.py:1583
        return p;
    }
}
