// file: vulnhunter-fix/scripts/pr-body-check.py
// Dev-time honesty check for the skill's own PRs: runs the skill's pytest suite with coverage and compares
// the passed count and coverage percentage claimed in a PR body against the live numbers.

@executedBy(CODE) @role(evaluation) @stage("fix")
class PrBodyCheck {

    int run(List<String> argv) {
        return main(argv);
    }

    Map runSuite() {
        String pytest = Shutil.which("pytest");
        if (pytest == null) return Map.of("error", "pytest not on PATH");                                  // src: vulnhunter-fix/scripts/pr-body-check.py:52
        Proc proc = Subprocess.run(List.of(pytest, "--tb=no", "-q", "--cov=scripts", "--cov=vulnhunter_fix", "--cov-report=term"), skillRoot(), 300); // src: vulnhunter-fix/scripts/pr-body-check.py:61
        String combined = proc.stdout + "\n" + proc.stderr;
        Match summary = null;
        // last line carrying "N passed[, N failed][, N skipped]..." wins
        for (String line : combined.lines()) {
            Match m = Regex.search("(?P<passed>\\d+)\\s+passed(, N failed)?(, N skipped)?(, N xfailed)?(, N xpassed)?", line); // src: vulnhunter-fix/scripts/pr-body-check.py:31
            if (m != null && line.contains("passed")) summary = m;                                          // src: vulnhunter-fix/scripts/pr-body-check.py:68
        }
        Match cov = Regex.searchMultiline("^TOTAL\\s+\\d+\\s+\\d+\\s+\\d+\\s+\\d+\\s+(?P<pct>\\d+(?:\\.\\d+)?)%", combined); // src: vulnhunter-fix/scripts/pr-body-check.py:38
        return Map.of("passed", summary != null ? summary.intGroup("passed") : null, "failed", summary != null ? summary.intGroupOr0("failed") : null, "coverage_pct", cov != null ? cov.floatGroup("pct") : null, "returncode", proc.rc); // src: vulnhunter-fix/scripts/pr-body-check.py:71
    }

    Map parseBodyClaims(String body) {
        Match p = Regex.searchIgnoreCase("(?P<n>\\d+)\\s+passed", body);                                    // src: vulnhunter-fix/scripts/pr-body-check.py:44
        Match c = Regex.searchIgnoreCase("(?P<pct>\\d+(?:\\.\\d+)?)\\s*%\\s*(?:coverage|cov)", body);       // src: vulnhunter-fix/scripts/pr-body-check.py:45
        return Map.of("claimed_passed", p != null ? p.intGroup("n") : null, "claimed_coverage", c != null ? c.floatGroup("pct") : null); // src: vulnhunter-fix/scripts/pr-body-check.py:87
    }

    int cmdStats(Args args) {
        Map stats = runSuite();                                                                             // src: vulnhunter-fix/scripts/pr-body-check.py:94
        print(Json.dump(stats));
        return stats.get("returncode") == 0 ? 0 : 1;                                                       // src: vulnhunter-fix/scripts/pr-body-check.py:96
    }

    int cmdCheck(Args args) {
        String body;
        if (args.bodyStdin) body = Stdin.read();                                                           // src: vulnhunter-fix/scripts/pr-body-check.py:101
        else if (args.body != null) body = Files.read(args.body);                                          // src: vulnhunter-fix/scripts/pr-body-check.py:103
        else return 2;                                                                                     // src: vulnhunter-fix/scripts/pr-body-check.py:106
        Map claims = parseBodyClaims(body);                                                                // src: vulnhunter-fix/scripts/pr-body-check.py:107
        Map reality = runSuite();                                                                          // src: vulnhunter-fix/scripts/pr-body-check.py:108
        if (reality.get("error") != null) return 2;                                                        // src: vulnhunter-fix/scripts/pr-body-check.py:111
        List<String> drift = List.of();
        if (claims.claimed_passed != null && reality.passed != null && claims.claimed_passed != reality.passed) drift.add("passed count"); // src: vulnhunter-fix/scripts/pr-body-check.py:114
        // 1-point tolerance on coverage for rounding
        if (claims.claimed_coverage != null && reality.coverage_pct != null && Math.abs(claims.claimed_coverage - reality.coverage_pct) > 1.0) drift.add("coverage"); // src: vulnhunter-fix/scripts/pr-body-check.py:121
        if (!drift.isEmpty()) return 1;                                                                    // src: vulnhunter-fix/scripts/pr-body-check.py:130
        return 0;
    }

    int main(List<String> argv) {
        Args args = parseArgs(argv);                                                                       // subcommands: stats | check
        if (args.cmd == "stats") return cmdStats(args);                                                    // src: vulnhunter-fix/scripts/pr-body-check.py:142
        return cmdCheck(args);                                                                             // src: vulnhunter-fix/scripts/pr-body-check.py:146
    }
}
