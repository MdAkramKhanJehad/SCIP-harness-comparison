# vvaharness/models/scan/report.py

`FinalReport`: the Stage 8 output persisted as findings.json and rendered to Markdown. It holds the hollowness predicate shared with SARIF, the coverage-degradation reason codes, and the Markdown layout (posture findings split out, lower-confidence chains split out, dropped-finding tags).

Source: `vvaharness/models/scan/report.py` (lines 1-282)
Executor: code
Called from: `vvaharness/pipeline/stages/s8_chain.py` (producer), `vvaharness/orchestrator/scan.py`, Stage 9 (`s9/health.py` calls is_hollow), Stage 10

// src: vvaharness/models/scan/report.py:58-88
FinalReport {
  schema_version: String = "1.0"   // findings.json shape; bump on any breaking change
  repo_root: String
  repo_name: String | null = null  // used for the report title
  git_sha: String | null = null    // HEAD at scan time; Stage 10 refuses on mismatch
  findings: RankedFinding[]
  chains: Chain[]
  chains_dropped: Number = 0       // proposed chains resolving to fewer than 2 distinct findings
  chains_deduped: Number = 0       // byte-identical chains collapsed by Stage 8 deduplication
  chains_invalid: Number = 0       // unreadable at parse time
  unpromoted_links: [Number, Number][] = []   // (owner, target) "feeds" links no shipped chain carries; disclosed, never promoted
  dropped: DroppedFinding[] = []
  raw_findings_count: Number = 0   // pre-verification count
  metrics: ScanMetrics | null = null
  threat_model: ThreatModel | null = null
  app_profile: AppProfile | null = null
  unreachable_files: String[] | null = null      // null = knob off; [] = Stage 3 found zero
  threats_without_unit: String[] | null = null
  summary: String
  degraded: Boolean = false
  degraded_reason: String = ""
  enrichment_unavailable: Boolean = false        // true only when chains=[] is not a trustworthy "zero chains found"
}

// src: vvaharness/models/scan/report.py:90-102 — the one hollowness predicate (report and SARIF cannot disagree)
fn FinalReport.is_hollow():executor=code {
  if (metrics == null || findings is not empty) return false
  raw = max(raw_findings_count || 0, metrics.raw_findings_count || 0)   // different builders stamp each; either can default on an old payload
  return raw == 0 && metrics.total_files_in_scope > 0 && metrics.s2_degraded
}

// src: vvaharness/models/scan/report.py:104-107
fn FinalReport._undetermined_drop_count():executor=code {
  return count of dropped where reason in ["VERIFY_ERROR", "GUARDRAIL_BLOCKED", "INCONCLUSIVE"]
}

// src: vvaharness/models/scan/report.py:109-132
fn FinalReport.unranked_split():executor=code {
  feeders = { every step except the last, of every chain }
  unranked = positions of findings whose exploitability_notes == NOT_RANKED_NOTE
  feeder_missed = count of unranked positions in feeders   // the chain prompt's rule ("an entry for a finding that feeds another") was broken: a reply defect
  by_design = length(unranked) - feeder_missed
  ranked = length(findings) - length(unranked)
  return [ranked, by_design, feeder_missed]   // they always sum to length(findings)
}

// src: vvaharness/models/scan/report.py:134-142
fn FinalReport._verified_tp_fp():executor=code {
  if (metrics != null) return [metrics.true_positive_count, metrics.false_positive_count]   // never raw_findings_count
  return [length(findings), count of dropped where reason == "FALSE_POSITIVE"]   // hand-built report without metrics
}

// src: vvaharness/models/scan/report.py:144-157
fn FinalReport.coverage_degraded():executor=code {
  if (metrics == null) return []
  reasons = []
  if (_undetermined_drop_count() > 0) reasons += "s6_undetermined"
  if (metrics.total_files_in_scope > 0 && metrics.analyzed_files_unique == 0) reasons += "zero_analysis"
  if (metrics.llm_turn_cap_exhausted > 0) reasons += "llm_turn_cap_exhausted"
  return reasons   // s3_unreachable_files is excluded by design: nonzero in most healthy scans
}

// src: vvaharness/models/scan/report.py:159-282
fn FinalReport.to_markdown(posture_channel=true, unreachable_appendix=true):executor=code {
  // posture_channel defaults true to match build_sarif, so Markdown and SARIF agree
  safe_title = (repo_name || repo_root) with characters < > ` | [ ] removed
  out = ["# Agentic SAST — $safe_title", "## Summary", _demote_md_headings(summary, escape_angles=true), ..._summary_reconciliation_note(this)]

  // src: report.py:171-179 — no configuration-management database context: P1/P2 are structurally unreachable
  if (app_profile == null) out += "_No CMDB/application context was supplied for this scan — OffensivePriority is capped at its lowest reachable tier (P3/P4) for every finding below; it is not an individual low-priority assessment._"

  if (metrics) out += _render_metrics(this, unreachable_appendix)
  out += _render_scan_health(this)
  if (threat_model) out += _render_threat_model(this)
  else if (app_profile) out += ["## Threat Model", ..._app_profile_lines(this)]
  out += _render_verification(this, posture_channel)

  // src: report.py:189-225 — 1-based finding numbers survive the split (chain step indices use them)
  [main, posture] = split numbered findings by (posture_channel && finding.channel == "posture")
  out += "## Findings (${ length(main) })"
  if (posture) out += "_Application-defect findings only — ${ length(posture) } posture finding(s) are listed separately under Posture Findings below (${ length(findings) } in total)._"
  for each (i, rf) in main, out += finding_section_lines(i, rf)
  if (posture) {
    out += ["## Posture Findings (${ length(posture) })", "_Build, deploy, and dependency-posture findings the verifier routed out of the application-defect list. They keep their original finding numbers (the exploit-chain step indices reference them) and their severity; remediation skips them by default._"]
    for each (i, rf) in posture, out += finding_section_lines(i, rf)
  }

  // src: report.py:226-254 — chains: two or more quality notes moves a chain to "Lower-confidence chains"
  if (chains) {
    out += ["## Exploit Chains", ..._chain_removal_leadins(this), ..._terminal_diversity_leadin(this), ..._unpromoted_link_leadin(this), ..._chain_pass_caveat(this)]
    numbered = chains numbered from 1 over the full list
    for each (n, c) in numbered where length(c.quality_notes) < 2, out += _chain_lines(this, n, c)
    lower = numbered where length(c.quality_notes) >= 2
    if (lower) {
      out += ["### Lower-confidence chains", "_These chains did not clear two or more of the deterministic quality checks noted on each; they are shown in full and keep their chain numbers, but weigh those notes before relying on them._"]
      for each (n, c) in lower, out += _chain_lines(this, n, c)
    }
  } else if (!enrichment_unavailable) {
    out += ["## Exploit Chains", ..._empty_chain_section_copy(this), ..._chain_pass_caveat(this)]
  }
  // when enrichment_unavailable and there are no chains, the section is omitted

  // src: report.py:255-277 — dropped findings
  out += "## Dropped Findings"
  tag = { FALSE_POSITIVE: "FP", UNCONFIRMED: "UNCONFIRMED", VERIFY_ERROR: "VERIFY-ERR", EXCLUDED: "EXCLUDED", GUARDRAIL_BLOCKED: "GUARDRAIL", INCONCLUSIVE: "INCONCLUSIVE" }
  for each d in dropped {
    t = if (d.reason == "DUPLICATE") (if (d.canonical_idx != null) "DUP of #${ d.canonical_idx + 1 }" else "DUP (pre-verify)") else tag[d.reason] || d.reason
    out += "- **[$t]** `<_md_cell(file), backticks replaced by U+02CB>:$line` ${ d.vuln_class } (<_md_cell(chunk_id)>) — <_md_cell(detail)>"
  }
  if (dropped is empty) out += "_None._"
  if (metrics) out += _render_scope_appendix(this)
  if (unreachable_files && unreachable_appendix) out += _render_unreachable_appendix(this)
  return join(out, newline)
}
