// file: vvaharness/util/pricing.py
// Operator-supplied model price table (USD per Mtok by exact model id) used to cost a run's token counts.
// Must never fail a scan: any problem yields null costs. VVAHARNESS_PRICING_FILE overrides pricing.file.

@executedBy(CODE) @role(types)
record CacheRateDefaults(double readFraction, double writeMultiplier, boolean isFallback) { }

@executedBy(CODE) @role(types)
record TokenBucket(int prompt, int completion, int cacheRead, int cacheWrite, int calls) { }

@executedBy(CODE) @role(types)
record ModelPricing(double inputPerMtok, double outputPerMtok, Double cacheReadPerMtok, Double cacheCreationPerMtok) { }

@executedBy(CODE) @role(types)
record PricingTable(Map<String, ModelPricing> models, String path, String sha256, String source, CacheRateDefaults cacheDefaults) { }

@executedBy(CODE) @role(config)
class Pricing {

    static final String PRICING_FILE_ENV = "VVAHARNESS_PRICING_FILE";        // src: vvaharness/util/pricing.py:31
    static final double PER_MTOK = 1000000.0;                                  // src: vvaharness/util/pricing.py:32
    Map<Pair<String, String>, PricingTable> pricingCache;                      // keyed on resolved (path, source) // src: vvaharness/util/pricing.py:187

    CacheRateDefaults fallbackDefaults(Theta θ) {
        // Anthropic 5-min-TTL economics; wrong for most OpenAI models
        return new CacheRateDefaults(θ["code.util.pricing.fallback_cache_read_fraction"], θ["code.util.pricing.fallback_cache_write_multiplier"], true); // src: vvaharness/util/pricing.py:35
    }

    Double rate(Map<String, Object> raw, String key) {
        Object v = raw.get(key);
        if (v instanceof Boolean || !(v instanceof Number)) return null;       // src: vvaharness/util/pricing.py:82
        return (double) v;
    }

    ModelPricing modelPricing(Object raw) {
        if (!(raw instanceof Map)) return null;                                // src: vvaharness/util/pricing.py:88
        Double inp = rate(raw, "input_per_mtok"); Double out = rate(raw, "output_per_mtok");
        if (inp == null || out == null) return null;                           // both required // src: vvaharness/util/pricing.py:92
        return new ModelPricing(inp, out, rate(raw, "cache_read_per_mtok"), rate(raw, "cache_creation_per_mtok")); // src: vvaharness/util/pricing.py:94
    }

    CacheRateDefaults parseCacheDefaults(Object data, Theta θ) {
        if (!(data instanceof Map)) return fallbackDefaults(θ);                // src: vvaharness/util/pricing.py:104
        Object raw = data.get("cache_rate_defaults");
        if (!(raw instanceof Map)) return fallbackDefaults(θ);                 // src: vvaharness/util/pricing.py:107
        Double read = rate(raw, "read_fraction"); Double write = rate(raw, "write_multiplier");
        if (read == null && write == null) return fallbackDefaults(θ);         // src: vvaharness/util/pricing.py:111
        return new CacheRateDefaults(read == null ? θ["code.util.pricing.fallback_cache_read_fraction"] : read,
                                     write == null ? θ["code.util.pricing.fallback_cache_write_multiplier"] : write, false); // src: vvaharness/util/pricing.py:113
    }

    Map<String, ModelPricing> parseModels(Object data) {
        if (!(data instanceof Map)) return Map.of();                           // src: vvaharness/util/pricing.py:122
        Object rawModels = data.get("models");
        if (!(rawModels instanceof Map)) return Map.of();                      // src: vvaharness/util/pricing.py:125
        Map<String, ModelPricing> out = Map.of();
        for (Entry e : rawModels) {                                            // src: vvaharness/util/pricing.py:128
            ModelPricing priced = modelPricing(e.value);
            if (e.key instanceof String && priced != null) out.put(e.key, priced); // malformed rows dropped silently // src: vvaharness/util/pricing.py:130
        }
        return out;
    }

    PricingTable tableFromFile(Path path, String source, Theta θ) {
        Object data; byte[] blob;
        try { blob = path.readBytes(); data = Yaml.safeLoad(blob.decode("utf-8")); } // src: vvaharness/util/pricing.py:137
        catch (OSError | UnicodeDecodeError | YAMLError e) { Console.write("[pricing] WARNING: ignoring price table"); return null; } // src: vvaharness/util/pricing.py:139
        Map<String, ModelPricing> models = parseModels(data);
        if (models.isEmpty()) { Console.write("[pricing] WARNING: no usable model rates; costs will be reported as null"); return null; } // src: vvaharness/util/pricing.py:143
        CacheRateDefaults defaults = parseCacheDefaults(data, θ);              // src: vvaharness/util/pricing.py:147
        for (Entry<String, ModelPricing> m : models) {                         // src: vvaharness/util/pricing.py:149
            if (m.value.cacheReadPerMtok != null && m.value.cacheCreationPerMtok != null) continue; // src: vvaharness/util/pricing.py:154
            Console.write("[pricing] NOTE: model omits cache rates; deriving from input_per_mtok"); // only sign of derived rates // src: vvaharness/util/pricing.py:159
        }
        return new PricingTable(models, str(path), sha256(blob), source, defaults); // src: vvaharness/util/pricing.py:162
    }

    Pair<String, String> selectedSource(String cfgPricingFile) {
        String envPath = env(PRICING_FILE_ENV, "").strip();                    // env overrides config // src: vvaharness/util/pricing.py:168
        if (!envPath.isEmpty()) return Pair.of(envPath, "env");                // src: vvaharness/util/pricing.py:169
        if (cfgPricingFile != null) return Pair.of(cfgPricingFile, "config");  // src: vvaharness/util/pricing.py:171
        return null;                                                           // costing unavailable // src: vvaharness/util/pricing.py:173
    }

    PricingTable loadPricing(String cfgPricingFile, Theta θ) {
        Pair<String, String> selected = selectedSource(θ["pricing.file"]);     // src: vvaharness/util/pricing.py:179
        if (selected == null) return null;                                     // src: vvaharness/util/pricing.py:180
        return tableFromFile(Path.of(selected.first).expanduser(), selected.second, θ); // src: vvaharness/util/pricing.py:183
    }

    PricingTable loadPricingCached(String cfgPricingFile, Theta θ) {
        // memoized load_pricing: one disk read per distinct resolved table
        Pair<String, String> selected = selectedSource(cfgPricingFile);        // src: vvaharness/util/pricing.py:193
        synchronized (pricingCache) {
            if (!pricingCache.containsKey(selected))                           // src: vvaharness/util/pricing.py:195
                pricingCache.put(selected, selected != null ? tableFromFile(Path.of(selected.first).expanduser(), selected.second, θ) : null); // src: vvaharness/util/pricing.py:196
            return pricingCache.get(selected);
        }
    }

    // caller alias (pass-1 files call Pricing.loadCached) for load_pricing_cached
    PricingTable loadCached(String cfgPricingFile, Theta θ) {
        return loadPricingCached(cfgPricingFile, θ);
    }

    double bucketCostUsd(TokenBucket bucket, ModelPricing pricing, CacheRateDefaults cacheDefaults, Theta θ) {
        CacheRateDefaults d = cacheDefaults != null ? cacheDefaults : fallbackDefaults(θ); // src: vvaharness/util/pricing.py:206
        int cacheWrite = bucket.cacheWrite;
        int fresh = max(bucket.prompt - cacheWrite, 0);                        // prompt already includes cache writes // src: vvaharness/util/pricing.py:208
        double writeRate = pricing.cacheCreationPerMtok == null ? pricing.inputPerMtok * d.writeMultiplier : pricing.cacheCreationPerMtok; // src: vvaharness/util/pricing.py:209
        double readRate = pricing.cacheReadPerMtok == null ? pricing.inputPerMtok * d.readFraction : pricing.cacheReadPerMtok; // src: vvaharness/util/pricing.py:212
        double total = fresh * pricing.inputPerMtok + cacheWrite * writeRate + bucket.cacheRead * readRate + bucket.completion * pricing.outputPerMtok; // src: vvaharness/util/pricing.py:215
        return total / PER_MTOK;                                               // src: vvaharness/util/pricing.py:219
    }
}
