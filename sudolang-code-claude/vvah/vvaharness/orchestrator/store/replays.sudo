# vvaharness/orchestrator/store/replays.py

Storage for exploit verification replay bundles (the confirming exchange per verified finding) and the optional probe log. These rows survive `reset_run` so a later replay works after a fix and rescan.

Source: `vvaharness/orchestrator/store/replays.py` (lines 1-142)
Executor: code
Called from: the exploit verification package (external to this rendering), `vvaharness/orchestrator/scan.py` `_prune_ev_replays`

// src: vvaharness/orchestrator/store/replays.py:26-49
fn save_replays(run_id, items):executor=code {
  // replaces the whole set; to be called only when exploit verification ran
  in one transaction {
    insert runs(run_id) if absent; set updated_at = now
    delete every ev_replays row for run_id
    for each [key, blob] in items {
      require length(blob) <= _REPLAY_MAX_BYTES => { warn REPLAY_TOO_LARGE; continue }   // 1 MiB; that bundle is skipped
      insert or replace ev_replays(run_id, key, blob)
    }
  }
  return number written
}

// src: vvaharness/orchestrator/store/replays.py:52-68
fn prune_replays(run_id, keep_keys):executor=code {
  // to be called after Stage 7 deduplication; an empty keep_keys clears every bundle
  delete ev_replays rows of run_id whose finding_key is not in keep_keys
  return number deleted
}

// src: vvaharness/orchestrator/store/replays.py:71-86
fn load_replays(run_id):executor=code {
  rows ordered by (created_at, finding_key)
  return rows where size <= _REPLAY_MAX_BYTES   // oversized rows are skipped with REPLAY_STORED_TOO_LARGE
}
// src: vvaharness/orchestrator/store/replays.py:89-97
fn delete_replays(run_id):executor=code { delete every ev_replays row of run_id; return count }

// src: vvaharness/orchestrator/store/replays.py:100-105
_EV_PROBE_COLS = ["finding_key", "finding_title", "file", "line_start", "line_end", "cwe", "vuln_class", "ev_class", "ev_subtype", "ev_verdict", "endpoint_method", "endpoint_path", "payload_label", "injection_point", "req_method", "req_url", "req_query", "req_body", "authed", "auth_applied", "resp_status", "resp_ms", "resp_snippet"]   // the caller is not trusted: only these columns are written

// src: vvaharness/orchestrator/store/replays.py:108-129
fn save_ev_probes(run_id, rows):executor=code {
  // replaces the set; only the fixed _EV_PROBE_COLS columns are written (missing becomes NULL, extra keys are ignored)
  in one transaction { ensure runs row; delete run_id probes; insert each row }
  return number written
}
// src: vvaharness/orchestrator/store/replays.py:132-142
fn load_ev_probes(run_id):executor=code { return every probe row of run_id ordered by id }
