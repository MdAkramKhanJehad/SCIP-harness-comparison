# vvaharness/util/status.py

Per-stage status lines on standard error (standard output stays clean for reports). Wraps a stage body, records its outcome in the stage telemetry, and marks a stage "completed_with_errors" when unrecovered error-log records appeared during it.

Source: `vvaharness/util/status.py` (lines 1-192)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` and stage drivers (`with status.stage(label, stage_id=...)`)

// src: vvaharness/util/status.py:39-50
OK_MARK = "✓"; WARN_MARK = "⚠"; FAIL_MARK = "✗"   // WARN_MARK means "finished, coverage lost", which the exit code cannot say
StageResult { incomplete_detail = ""; fn mark_incomplete(detail) }

// src: vvaharness/util/status.py:99-111
fn json_logs_enabled() { return lower-case env VVAHARNESS_JSON_LOGS in ("1", "true", "yes") }
fn emit_event(event, stream?, ...fields);   // one JSON line, only when JSON logs are enabled

// src: vvaharness/util/status.py:114-192
fn stage(label, n?, total?, stream?, animate?, stage_id?):executor=code {
  // context manager; never swallows an exception
  err0 = if (stage_id) errlog.count_for_stage(stage_id, include_recovered=false) else 0
  if (stage_id) STAGES.start(stage_id, label)
  // abstracted: start line, spinner on a terminal (not in JSON mode), timing
  try yield StageResult;
  catch any => {
    if (stage_id) STAGES.done(stage_id, outcome="error", duration)
    print "failed after Ns: <redacted error>"
    rethrow
  }
  n_err = if (stage_id) errlog.count_for_stage(stage_id, include_recovered=false) - err0 else 0
  if (stage_id) STAGES.done(stage_id, outcome = if (n_err > 0) "completed_with_errors" else "completed", duration)
  // printed mark: WARN_MARK with ", N unrecovered error(s) — see errors.jsonl" when n_err > 0, else OK_MARK; "○ <incomplete_detail>" when the body marked itself incomplete
  // preserved: an incomplete stage is only rendered differently; its telemetry outcome is still "completed" or "completed_with_errors"
}
