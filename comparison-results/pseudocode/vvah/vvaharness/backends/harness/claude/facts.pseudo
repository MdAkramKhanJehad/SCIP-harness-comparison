// file: vvaharness/backends/harness/claude/facts.py
// S11's fact tools and report channel for the Claude-harness route, exposed as an in-process MCP server
// ("facts"): tools arrive as mcp__facts__X; SubmitPersonaReport validates a persona's report on submission.

@executedBy(CODE) @role(tool)
class ClaudeFacts {

    String mcpName(String bare) {
        return "mcp__facts__" + bare;                                                                    // src: vvaharness/backends/harness/claude/facts.py:44
    }

    // Rewrite bare bridged names in a tool grant to their mcp__facts__ form (a bare grant matches nothing).
    List<String> rewriteToolNames(List<String> names, List<String> bridged) {
        if (names == null) return null;                                                                  // src: vvaharness/backends/harness/claude/facts.py:51
        return names.map(n -> bridged.contains(n) ? mcpName(n) : n);                                     // src: vvaharness/backends/harness/claude/facts.py:54
    }

    // Wrap one fact spec as an SDK tool; exceptions come back as error results.
    ToolResult factTool(FactToolSpec spec, Map<String, Object> args) {
        try {
            return ToolResult.text(serialize(spec.fn.call(args)));                                       // src: vvaharness/backends/harness/claude/facts.py:109
        } catch (Exception exc) {
            return ToolResult.error(exc.toString());                                                     // src: vvaharness/backends/harness/claude/facts.py:111
        }
    }

    // SubmitPersonaReport: validate; on failure name the invalid fields so the persona can retry.
    ToolResult submitTool(Schema reportModel, PersonaReportCollector collector, Map<String, Object> args) {
        Report report;
        try {
            report = reportModel.validate(args);                                                         // src: vvaharness/backends/harness/claude/facts.py:133
        } catch (Exception exc) {
            return ToolResult.error("Report rejected -- not a valid report: " + exc + ". Fix the fields named above and call SubmitPersonaReport again."); // src: vvaharness/backends/harness/claude/facts.py:136
        }
        collector.add(report);      // newest wins per (persona, tracking_id)                            // src: vvaharness/backends/harness/claude/facts.py:140
        return ToolResult.text("Report accepted.");                                                      // src: vvaharness/backends/harness/claude/facts.py:141
    }

    Triple<List<Tool>, List<String>, PersonaReportCollector> buildFactTools(List<FactToolSpec> specs, Schema reportModel) {
        PersonaReportCollector collector = new PersonaReportCollector();
        List<Tool> tools = specs.map(s -> sdkTool(s));                                                   // src: vvaharness/backends/harness/claude/facts.py:155
        List<String> names = specs.map(s -> mcpName(s.name));                                            // src: vvaharness/backends/harness/claude/facts.py:156
        if (reportModel != null) {                                                                       // src: vvaharness/backends/harness/claude/facts.py:158
            tools.add(sdkSubmitTool(reportModel, collector));
            names.add(mcpName("SubmitPersonaReport"));                                                   // src: vvaharness/backends/harness/claude/facts.py:160
        }
        return Triple.of(tools, names, collector);
    }
}

@executedBy(MODEL) @role(prompt)
class SubmitPromptSuffix {

    // SUBMIT_PROMPT_SUFFIX: appended to each persona prompt on this backend only.
    Prompt submitPromptSuffix(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.facts.submit_report_via_tool"]);                    // call mcp__facts__SubmitPersonaReport with the report object // src: vvaharness/backends/harness/claude/facts.py:180
        p.rule(θ["p.facts.submit_validated_with_field_feedback"]);      // validated on submission; told which fields to fix // src: vvaharness/backends/harness/claude/facts.py:181
        p.format(θ["p.facts.also_print_json_block"]);                   // also print the report as a json block // src: vvaharness/backends/harness/claude/facts.py:182
        p.context(θ["p.facts.fact_tool_prefix_names"]);                 // DiffTouched, ChangedLines, DiffImpactMap, PatternScan, TestInventory // src: vvaharness/backends/harness/claude/facts.py:184
        return p;
    }
}
