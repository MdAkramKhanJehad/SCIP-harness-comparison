// file: vvaharness/sdk/handoff.py
// Bring your own findings: seed the S4 checkpoint (and empty S2/S3) so a resumed scan runs S5 onward on them.

@executedBy(CODE) @role(types) @stage("S4")
record Handoff(String runId, String stage, int findingCount, List<String> skipped) {
    // skipped defaults to the empty tuple.
    // resumeArgv property: always the single flag --resume.
    List<String> resumeArgv() {
        return List.of("--resume");                                                                  // src: vvaharness/sdk/handoff.py:49
    }
}

@executedBy(CODE) @role(types)
class HandoffError {
    // ValueError subclass raised when findings cannot be handed to the pipeline.
}

@executedBy(CODE) @role(step) @stage("S4")
class SdkHandoff {

    // Cap on how many findings one call may inject.
    int MAX_INJECTED_FINDINGS = θ["code.sdk.handoff.max_injected_findings"];                         // src: vvaharness/sdk/handoff.py:26

    // Stages whose checkpoint must also be seeded so a resumed run skips discovery. s0 and s1 are not seeded: deterministic and free, and s1 builds the graph S6 reads.
    List<String> DISCOVERY_STAGES = θ["code.sdk.handoff.discovery_stages"];                          // src: vvaharness/sdk/handoff.py:32

    Handoff injectFindings(Path repo, List<Finding> findings, boolean skipDiscovery, Theta θ) {      // skipDiscovery defaults true
        if (findings.isEmpty()) throw new HandoffError("no findings to inject");                     // src: vvaharness/sdk/handoff.py:54
        if (findings.size() > θ["code.sdk.handoff.max_injected_findings"]) throw new HandoffError("findings exceed MAX_INJECTED_FINDINGS"); // src: vvaharness/sdk/handoff.py:56
        List bad = findings.filter(f -> !(f instanceof Finding));                                    // src: vvaharness/sdk/handoff.py:58
        if (!bad.isEmpty()) throw new HandoffError("every item must be a Finding");                  // src: vvaharness/sdk/handoff.py:60
        Path repoPath = Path.of(repo).expanduser().resolve();                                        // src: vvaharness/sdk/handoff.py:62
        if (!repoPath.isDir()) throw new HandoffError("repo is not a directory");                    // src: vvaharness/sdk/handoff.py:64
        String runId = Checkpoints.runIdFor(repoPath);                                               // src: vvaharness/sdk/handoff.py:65
        Path ckptDir = Store.stateRoot(θ).join("checkpoints").join(runId);                           // src: vvaharness/sdk/handoff.py:67
        Store.registerRun(runId, repoPath, repoPath.name, null);                                     // app id null // src: vvaharness/sdk/handoff.py:69
        Checkpoints.saveCkpt(ckptDir, runId, "s4", Map.of("findings", List.copyOf(findings), "outcomes", outcomes(findings), "input_kind", "external"), θ); // src: vvaharness/sdk/handoff.py:71
        List<String> skipped = skipDiscovery ? seedDiscovery(ckptDir, runId, θ) : List.of();         // src: vvaharness/sdk/handoff.py:73
        return new Handoff(runId, "s4", findings.size(), skipped);                                   // src: vvaharness/sdk/handoff.py:75
    }

    List<String> seedDiscovery(Path ckptDir, String runId, Theta θ) {
        Checkpoints.saveCkpt(ckptDir, runId, "s2", new ThreatModel(), θ);                            // empty threat model // src: vvaharness/sdk/handoff.py:78
        Checkpoints.saveCkpt(ckptDir, runId, "s3", new TaskManifest(List.of()), θ);                  // empty manifest // src: vvaharness/sdk/handoff.py:80
        return θ["code.sdk.handoff.discovery_stages"];                                               // src: vvaharness/sdk/handoff.py:82
    }

    Map<String, String> outcomes(List<Finding> findings) {
        Set<String> origins = findings.map(f -> f.origin != null && !f.origin.isEmpty() ? f.origin : "external").toSet(); // src: vvaharness/sdk/handoff.py:85
        return origins.sorted().toMap(o -> o, o -> "injected");                                      // one outcome per distinct origin // src: vvaharness/sdk/handoff.py:88
    }
}
