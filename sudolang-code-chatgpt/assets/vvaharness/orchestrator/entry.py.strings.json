    {
      "source": "vvaharness/orchestrator/entry.py",
      "line_start": 147,
      "line_end": 152,
      "text": "batch input: either a .txt with one 'application_id,repository_name,path' per line, or a .csv with header columns AppID,RepoName[,Path] (Path derived from batch.git_base_url when absent); each entry is cloned/scanned in sequence with a fresh context",
