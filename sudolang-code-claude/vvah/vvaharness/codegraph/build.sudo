# vvaharness/codegraph/build.py

Builds the one code graph a scan analyses and queries (ArcadeDB backend through context-graph-sdk), and decides whether a graph is too degenerate to back a `require_graph` evidence demand.

Source: `vvaharness/codegraph/build.py` (lines 1-83)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (build_graph, after Stage 0); graph_is_degenerate from the evidence-gate code of the model routes and Stages 2, 4 and 6

// src: vvaharness/codegraph/build.py:30-31
_MIN_GRAPH_NODES_FOR_GATE = 10   // below 10 nodes a graph cannot answer GraphContext usefully

// src: vvaharness/codegraph/build.py:34-48
fn _analyze(workspace, repo_root, project_id, enrichers):executor=code {
  try return workspace.analyze(repo_root, project_id, enrichers);   // external: context_graph_sdk
  catch any error => { workspace.close(); throw error }
}
fn _enricher_names(plugins):executor=code { names from plugin.metadata.name; on any error every name is "?" }   // logging only

// src: vvaharness/codegraph/build.py:51-68
fn build_graph(repo_root, project_id, workspace_dir, enrichers=[]):executor=code {
  // any backend or plugin failure propagates: Stages 2, 4 and 6 ground their verdicts in this graph, so a scan
  // without one is a different product, and failing here is cheapest before any model spend
  workspace = Workspace(workspace_dir, ArcadeDBBackendFactory())   // external: context_graph_sdk
  graph = _analyze(workspace, repo_root, project_id, enrichers)
  for each name in _enricher_names(enrichers), COUNTERS.bump("s0_graph_enricher_ran:$name")
  info = graph.info()
  return GraphHandle({ workspace, graph, project_id, node_count: info.node_count, edge_count: info.edge_count, enrichers: names })
}

// src: vvaharness/codegraph/build.py:71-83
fn graph_is_degenerate(ctx, cfg?):executor=code {
  handle = ctx.graph_handle
  if (handle == null) return true
  if (handle.edge_count == 0) return true
  if (handle.node_count == null) return false   // unmeasured is NOT degenerate
  return handle.node_count < integer(knob("step0.min_graph_nodes_for_gate", default=10))
}
