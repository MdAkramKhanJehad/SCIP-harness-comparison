// file: vvaharness/pipeline/stages/s2_planning.py
// S2's todo-list planning prompts (TodoListMiddleware system prompt + write_todos tool description).
// Installed by S2Session.threatmodelCall only when step2.planning is on and graph tools are mounted.

@executedBy(MODEL) @role(prompt) @stage("S2")
class S2Planning {

    /** PLAN_SYSTEM_PROMPT: "## Planning is mandatory here". */
    Prompt run(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s2_planning.planning_mandatory_first_action"]);              // src: vvaharness/pipeline/stages/s2_planning.py:21
        p.evidence(θ["p.s2_planning.threats_rest_on_opened_code"]);              // src: vvaharness/pipeline/stages/s2_planning.py:22
        p.persona(θ["p.s2_planning.stage_sets_ceiling_stance"]);                 // src: vvaharness/pipeline/stages/s2_planning.py:23
        p.rule(θ["p.s2_planning.no_subagents_todo_is_coverage"]);                // src: vvaharness/pipeline/stages/s2_planning.py:25
        p.include(planItems(θ));                                                 // "Every plan covers at least:"  // src: vvaharness/pipeline/stages/s2_planning.py:27
        p.rule(θ["p.s2_planning.todo_status_discipline"]);                       // src: vvaharness/pipeline/stages/s2_planning.py:51
        p.rule(θ["p.s2_planning.add_todos_on_discovery"]);                       // src: vvaharness/pipeline/stages/s2_planning.py:51
        p.must(θ["p.s2_planning.emit_only_when_all_completed"]);                 // src: vvaharness/pipeline/stages/s2_planning.py:52
        return p;
    }

    Prompt planItems(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.s2_planning.plan_item1_partition_inventory"]);            // src: vvaharness/pipeline/stages/s2_planning.py:28
        p.forbid(θ["p.s2_planning.plan_no_reenumerate_inventory"]);              // src: vvaharness/pipeline/stages/s2_planning.py:30
        p.step(2, θ["p.s2_planning.plan_item2_group_priority_order"]);           // src: vvaharness/pipeline/stages/s2_planning.py:32
        p.step(3, θ["p.s2_planning.plan_item3_entry_points_unauth"]);            // src: vvaharness/pipeline/stages/s2_planning.py:36
        p.step(4, θ["p.s2_planning.plan_item4_graph_structure"]);                // src: vvaharness/pipeline/stages/s2_planning.py:37
        p.rule(θ["p.s2_planning.plan_graphcontext_over_reads"]);                 // src: vvaharness/pipeline/stages/s2_planning.py:40
        p.step(5, θ["p.s2_planning.plan_item5_read_infra_files"]);               // src: vvaharness/pipeline/stages/s2_planning.py:42
        p.step(6, θ["p.s2_planning.plan_item6_read_templates_client"]);          // src: vvaharness/pipeline/stages/s2_planning.py:44
        p.step(7, θ["p.s2_planning.plan_item7_surface_files_from_read"]);        // src: vvaharness/pipeline/stages/s2_planning.py:46
        p.step(8, θ["p.s2_planning.plan_item8_reconcile"]);                      // src: vvaharness/pipeline/stages/s2_planning.py:48
        return p;
    }

    /** PLAN_TOOL_DESCRIPTION: the write_todos tool's description. */
    Prompt toolDescription(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s2_planning.tool_call_first"]);                              // src: vvaharness/pipeline/stages/s2_planning.py:57
        p.must(θ["p.s2_planning.tool_not_optional"]);                            // src: vvaharness/pipeline/stages/s2_planning.py:59
        p.choose(θ["p.s2_planning.todo_statuses"]);                              // pending, in_progress, completed  // src: vvaharness/pipeline/stages/s2_planning.py:60
        p.forbid(θ["p.s2_planning.tool_once_per_turn"]);                         // never twice in one turn  // src: vvaharness/pipeline/stages/s2_planning.py:60
        return p;
    }

    /** The procedure the planning prompt asks the S2 model to follow. */
    @executedBy(MODEL)
    ThreatModel plan(Inventory inv, Theta θ) {
        Todos todos = writeTodos(partitionByDirectory(inv));                     // FIRST action; no ls/Glob re-enumeration  // src: vvaharness/pipeline/stages/s2_planning.py:21
        // templates/views -> container/CI/IaC -> models/persistence -> utils -> request handlers last
        todos.sortBy(θ["p.s2_planning.plan_item2_group_priority_order"]);        // src: vvaharness/pipeline/stages/s2_planning.py:32
        for (Todo t : todos) {
            t.markInProgress();                                                  // src: vvaharness/pipeline/stages/s2_planning.py:51
            readGroup(t);                                                        // entry points, graph tools, infra, templates
            if (opensSomethingNew(t)) todos.add(newTodo());                      // src: vvaharness/pipeline/stages/s2_planning.py:51
            t.markCompleted();
        }
        List<String> left = inv.minus(namedSurfaceFiles());                      // reconcile  // src: vvaharness/pipeline/stages/s2_planning.py:48
        for (String f : left) {
            if (canCarryWeakness(f)) addThreat(f); else openQuestion("unreviewed: <n> file(s) — <reason>"); // src: vvaharness/pipeline/stages/s2_planning.py:49
        }
        if (!todos.allCompleted()) return null;                                  // emit only once every todo is completed  // src: vvaharness/pipeline/stages/s2_planning.py:52
        return emitThreatModel();
    }
}
