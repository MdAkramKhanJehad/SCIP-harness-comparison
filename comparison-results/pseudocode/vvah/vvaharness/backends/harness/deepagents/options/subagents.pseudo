// file: vvaharness/backends/harness/deepagents/options/subagents.py
// Subagent tool resolution and native DeepAgents subagent specs (one per persona + a gated general-purpose
// spec that shadows deepagents' ungated, unredacted builtin), each with its own middleware stack.

@executedBy(CODE) @role(backend)
class Subagents {

    String generalPurposeName() {
        return "general-purpose";                                                                        // src: vvaharness/backends/harness/deepagents/options/subagents.py:58
    }

    ToolPolicy toolPolicy(Object options) {
        return options.base.toolPolicy != null ? options.base.toolPolicy : new ToolPolicy(List.of(), List.of()); // src: vvaharness/backends/harness/deepagents/options/subagents.py:63
    }

    // The caller's injected tool_builder, else the generic readers (which build nothing).
    List<Tool> buildSessionTools(Object options, List<String> allowedTools, Theta θ) {
        if (options.base.toolBuilder != null) return options.base.toolBuilder.build(options, allowedTools); // src: vvaharness/backends/harness/deepagents/options/subagents.py:70
        return DeepagentsTools.buildTools(options, allowedTools, θ);                                     // src: vvaharness/backends/harness/deepagents/options/subagents.py:71
    }

    // Allow-list (subagent's own, else policy) minus denied tools; mutating tools denied unless allow_writes.
    List<String> subagentTools(SubagentDefinition subagent, StreamingOptions options, Theta θ) {
        ToolPolicy policy = toolPolicy(options);                                                         // src: vvaharness/backends/harness/deepagents/options/subagents.py:76
        List<String> allowed = subagent.tools != null ? subagent.tools : policy.allowedTools;            // src: vvaharness/backends/harness/deepagents/options/subagents.py:77
        Set<String> denied = new Set(subagent.disallowedTools != null && !subagent.disallowedTools.isEmpty() ? subagent.disallowedTools : policy.disallowedTools); // src: vvaharness/backends/harness/deepagents/options/subagents.py:78
        if (!options.base.allowWrites) denied = denied.union(HarnessModels.mutatingTools(θ));            // src: vvaharness/backends/harness/deepagents/options/subagents.py:80
        return allowed.filter(t -> !denied.contains(t));                                                 // src: vvaharness/backends/harness/deepagents/options/subagents.py:81
    }

    // Allow-list plus fact tools (deduped, ordered), minus the legacy Agent tool and (read-only) mutating tools.
    List<String> subagentToolNames(SubagentDefinition subagent, StreamingOptions options, Theta θ) {
        List<String> granted = dedupe(subagentTools(subagent, options, θ).plus(options.base.factTools));  // src: vvaharness/backends/harness/deepagents/options/subagents.py:88
        Set<String> excluded = Set.of(HarnessModels.legacyAgentTool());                                  // src: vvaharness/backends/harness/deepagents/options/subagents.py:89
        if (!options.base.allowWrites) excluded = excluded.union(HarnessModels.mutatingTools(θ));        // src: vvaharness/backends/harness/deepagents/options/subagents.py:91
        return granted.filter(t -> !excluded.contains(t));                                               // src: vvaharness/backends/harness/deepagents/options/subagents.py:92
    }

    // Gated replacement for the builtin general-purpose subagent: read tools only, stock description/prompt.
    SubagentDefinition generalPurposeAgent(StreamingOptions options, Theta θ) {
        List<String> readTools = toolPolicy(options).allowedTools.filter(t -> HarnessModels.readTools(θ).contains(t)); // src: vvaharness/backends/harness/deepagents/options/subagents.py:97
        return new SubagentDefinition(generalPurposeName(), DEFAULT_GENERAL_PURPOSE_DESCRIPTION, DEFAULT_SUBAGENT_PROMPT, readTools, null, null, null, null, null); // src: vvaharness/backends/harness/deepagents/options/subagents.py:98
    }

    // Executor-permitted NATIVE names for one subagent; any read grant implies ls.
    Set<String> permittedForSpec(List<String> toolNames, List<Tool> tools, Theta θ) {
        Set<String> nativeNames = toolNames.map(t -> HarnessModels.logicalToNative(θ).getOrDefault(t, t)); // src: vvaharness/backends/harness/deepagents/options/subagents.py:110
        Set<String> nativeReads = HarnessModels.readTools(θ).map(r -> HarnessModels.logicalToNative(θ).get(r));
        if (!nativeNames.intersect(nativeReads).isEmpty()) nativeNames = nativeNames.union(HarnessModels.nativeImpliedReads(θ)); // src: vvaharness/backends/harness/deepagents/options/subagents.py:111
        return nativeNames.union(tools.map(t -> t.name));                                                // src: vvaharness/backends/harness/deepagents/options/subagents.py:113
    }

    // A fresh per-session model-call cap (subagent.max_model_calls), or null when unset / <= 0.
    ModelCallBudget subagentBudget(SubagentDefinition subagent) {
        int limit = subagent.maxModelCalls != null ? subagent.maxModelCalls : 0;                          // src: vvaharness/backends/harness/deepagents/options/subagents.py:118
        if (limit <= 0) return null;                                                                     // src: vvaharness/backends/harness/deepagents/options/subagents.py:119
        Set<String> outcome = subagent.responseModel != null ? Set.of(toolNameFor(subagent.responseModel)) : Set.of(); // options/response_format // src: vvaharness/backends/harness/deepagents/options/subagents.py:121
        return new ModelCallBudget(limit, outcome, "subagent_model_call_budget_final_turn[" + subagent.name + "]"); // src: vvaharness/backends/harness/deepagents/options/subagents.py:123
    }

    // Middleware per subagent spec, in order: redaction/exclusion, PermitTools, budget, ForceVerdictOnly,
    // cache markers, connection retry (outermost of budget/verdict-only sits outside the retry).
    List<Middleware> specMiddleware(List<String> toolNames, List<Tool> tools, Object options, ModelCallBudget budget, Theta θ) {
        List<Middleware> middleware;
        // redaction keyed per subagent (its own tools), never on session allow_writes
        if (!new Set(toolNames).intersect(HarnessModels.mutatingTools(θ)).isEmpty()) {                   // src: vvaharness/backends/harness/deepagents/options/subagents.py:136
            middleware = List.of(new ExcludeTools(Set.of(DeepagentsModels.deleteToolName())));           // src: vvaharness/backends/harness/deepagents/options/subagents.py:137
        } else {
            middleware = Redaction.readOnlyMiddleware(Set.of(), θ);                                      // src: vvaharness/backends/harness/deepagents/options/subagents.py:139
        }
        if (options.permittedToolCalls != null) middleware.add(new PermitTools(permittedForSpec(toolNames, tools, θ))); // src: vvaharness/backends/harness/deepagents/options/subagents.py:140
        ForceVerdictOnly verdictOnly = options.base.forceVerdictOnly ? new ForceVerdictOnly() : null;    // src: vvaharness/backends/harness/deepagents/options/subagents.py:144
        if (budget != null) middleware.add(budget);                                                      // src: vvaharness/backends/harness/deepagents/options/subagents.py:145
        if (verdictOnly != null) middleware.add(verdictOnly);                                            // src: vvaharness/backends/harness/deepagents/options/subagents.py:145
        middleware.add(new BlockMarkerPromptCaching(options.base.cacheMarkers, true, θ));                // every persona gets the markers // src: vvaharness/backends/harness/deepagents/options/subagents.py:147
        middleware.add(CONNECTION_RETRY_MIDDLEWARE);                       // options/graph_builder      // src: vvaharness/backends/harness/deepagents/options/subagents.py:150
        return middleware;
    }

    List<SubagentSpec> getSubagentSpecs(StreamingOptions options, Map<String, SubagentDefinition> agents, Theta θ) {
        Map<String, SubagentDefinition> configured = new Map(agents == null ? options.agents : agents);  // src: vvaharness/backends/harness/deepagents/options/subagents.py:161
        // always include a general-purpose spec so the builtin never dispatches ungated
        if (θ["code.backends.harness.deepagents.options.subagents.shadow_general_purpose"]) {
            configured.putIfAbsent(generalPurposeName(), generalPurposeAgent(options, θ));               // src: vvaharness/backends/harness/deepagents/options/subagents.py:164
        }
        List<SubagentSpec> specs = new List();
        for (String name : configured.keySet()) {                                                        // src: vvaharness/backends/harness/deepagents/options/subagents.py:166
            SubagentDefinition subagent = configured.get(name);
            List<String> toolNames = subagentToolNames(subagent, options, θ);                            // src: vvaharness/backends/harness/deepagents/options/subagents.py:167
            List<Tool> tools = buildSessionTools(options, toolNames, θ);                                 // src: vvaharness/backends/harness/deepagents/options/subagents.py:168
            // resolve to configured Chat* instances; bare strings would bypass transport resolution
            String subagentModelId = subagent.model != null ? subagent.model : options.base.model;       // src: vvaharness/backends/harness/deepagents/options/subagents.py:170
            ChatModel subagentModel = buildModelCached(subagentModelId, options.base.env, options.base.modelProvider, options.base.useResponsesApi, options.base.thinkInPrompt); // options/model_building // src: vvaharness/backends/harness/deepagents/options/subagents.py:171
            SubagentSpec spec = new SubagentSpec(name, subagent.description, subagent.prompt, subagentModel, tools, null, null, null); // src: vvaharness/backends/harness/deepagents/options/subagents.py:178
            spec.middleware = specMiddleware(toolNames, tools, options, subagentBudget(subagent), θ);     // src: vvaharness/backends/harness/deepagents/options/subagents.py:185
            List<String> sources = Filesystem.skillSources(options.base.skillRoot, options.base.cwd);    // src: vvaharness/backends/harness/deepagents/options/subagents.py:188
            if (!sources.isEmpty()) spec.skills = sources;                                               // src: vvaharness/backends/harness/deepagents/options/subagents.py:190
            if (subagent.responseModel != null) spec.responseFormat = ResponseFormat.strategyFor(subagent.responseModel, subagentModelId, options.base.modelProvider); // src: vvaharness/backends/harness/deepagents/options/subagents.py:192
            specs.add(spec);
        }
        return specs;
    }
}
