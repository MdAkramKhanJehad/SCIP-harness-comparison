CLI_CONTINUED_REPLIES_COUNTER = "cli_continued_replies"

// src: vvaharness/backends/llm/models.py:233-238
fn truncation_retry_max(requested, cap?):executor=code {
  if (cap != null && requested >= cap) return null   // a retry at the cap is useless
  doubled = requested * TRUNCATION_RETRY_MULTIPLIER
  return if (cap == null) doubled else min(doubled, cap)
}

## Backoff jitter and timeouts

// src: vvaharness/backends/llm/models.py:241-251
RETRY_JITTER_SPREAD = 0.2
fn jittered_delay(seconds, spread = RETRY_JITTER_SPREAD):executor=code {
  return max(0.0, seconds * uniform random factor in [1 - spread, 1 + spread])   // breaks lockstep of s4/s6 pool workers
}

// src: vvaharness/backends/llm/models.py:254-285
ClockKind { REQUEST = "request"; SESSION = "session" }
EFFORT_TIME_FACTOR {
  REQUEST: { LOW: 1.0, MEDIUM: 1.0, HIGH: 1.0, XHIGH: 1.1, MAX: 1.2 }
  SESSION: { LOW: 1.0, MEDIUM: 1.0, HIGH: 1.0, XHIGH: 1.1, MAX: 1.5 }
}
fn effort_scaled_seconds(seconds, effort, kind):executor=code {
  if (seconds == null || seconds <= 0) return seconds
  tier = EffortLevel.parse(effort); if (tier == null) return seconds
  scaled = seconds * EFFORT_TIME_FACTOR[kind][tier]
  return if (seconds is an integer) ceil(scaled) else scaled
}

// src: vvaharness/backends/llm/models.py:288-307
DEFAULT_REQUEST_TIMEOUT_SECONDS = 900   // per-HTTP-request hang stop for `sdk` and `openai` when no stage timeout was passed
TIMEOUT_STOP_GRACE_SECONDS = 20
TIMEOUT_MAX_RETRIES = 1   // a timed-out call is re-sent at most once by the harness
BUDGET_NEAR_RATIO = 0.75
LLM_CALL_TIMEOUTS_COUNTER = "llm_call_timeouts"; LLM_CALL_BUDGET_NEAR_COUNTER = "llm_call_budget_near"
_BUDGET_NEAR_TIERS = {XHIGH, MAX}

// src: vvaharness/backends/llm/models.py:342-356
fn call_timeout_error(stage, route, budget_s, effort, cause_text):executor=code {
  COUNTERS.bump(LLM_CALL_TIMEOUTS_COUNTER)
  return CallTimeoutError(cause_text, stage, route, budget_s, effort)   // VVAH-E008; callers raise it
}
fn note_budget_use(elapsed, budget_s, effort):executor=code {
  if (budget_s > 0 && EffortLevel.parse(effort) in _BUDGET_NEAR_TIERS && elapsed >= BUDGET_NEAR_RATIO * budget_s) { COUNTERS.bump(LLM_CALL_BUDGET_NEAR_COUNTER) }
}

// src: vvaharness/backends/llm/models.py:884-917
fn turn_timeout(session_t0, session_budget, request_timeout):executor=code {
  if (session_budget == null) return request_timeout
  remaining = session_budget - (now - session_t0)
  return min(request_timeout, max(1.0, remaining))   // floor 1.0 second: a send past its deadline still gets one short try
}
fn turn_options(session_t0, session_budget, request_timeout):executor=code {
  clocked = turn_timeout(session_t0, session_budget, request_timeout)
  options = { timeout: clocked }
  if (session_budget != null && request_timeout - clocked >= 1.0) { options.max_retries = 0 }   // a clock-clamped send gets no client-library retries
  return options
}
fn wait_overrun(wait, session_t0, session_budget, stage, route, effort):executor=code {
  if (session_budget == null || now - session_t0 + wait < session_budget) return null
  return call_timeout_error(stage, route, budget_s=session_budget, effort, cause_text="retry wait of ${wait}s would cross the ${session_budget}s session clock")
}

## Proxy and TLS failures

// src: vvaharness/backends/llm/models.py:310-339
PROXY_CAUSE_RX = /\b407\b|proxy[_ ]auth|tunnel[_ ](?:connection[_ ])?(?:failed|error)|(?-i:\bCONNECT\b).*failed|SSL.*CERTIFICATE|CERTIFICATE.*VERIFY.*FAILED|CERT_VERIFY_FAILED|certificate[_ ]verify[_ ]failed/i
fn proxy_error(e, backend):executor=code {
  detail = the flattened cause chain of e when it or str(e) matches PROXY_CAUSE_RX, else null
  if (detail == null) return null
  return ProxyError(redact(detail) first 400 characters, status_code = if (detail contains 407) 407 else null, backend)   // VVAH-E002, never retried
}

## Detection-stage tool allowlist

// src: vvaharness/backends/llm/models.py:359-379
fn _named_tools(tools, config_key):executor=code {
  if (tools == null) return DEFAULT_READ_TOOLS
  require tools is not a bare string => throw ValueError("$config_key must be a YAML list of tool names ...")
  require tools is not empty => throw ValueError("$config_key is an empty list, which would silently grant a default toolset instead of none ...")
  require every tool is a string => throw ValueError
  return list(tools)
}

// src: vvaharness/backends/llm/models.py:382-400
fn validate_detection_tools(tools, config_key, via?):executor=code {
  named = _named_tools(tools, config_key)
  if (via == "cli") return named   // the only route whose agentic() honours the allowlist itself
  bad = named where tool not in DEFAULT_READ_TOOLS
  require bad is empty => throw ValueError("$config_key contains disallowed tool(s) ... only read-only tools ['Glob', 'Grep', 'Read'] are permitted ... (on `via: sdk` an unsupported or mutating tool delegates to the Agent SDK backend, which could modify the scanned repository ...)")
  return named
}

