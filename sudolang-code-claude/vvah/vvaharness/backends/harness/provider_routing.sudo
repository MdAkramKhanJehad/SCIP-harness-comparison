// src: vvaharness/backends/harness/provider_routing.py:32-34
TRANSPORT_RESPONSES = "responses"
TRANSPORT_CHAT_COMPLETIONS = "chat_completions"   // manifest and telemetry names for the OpenAI-branch transport

// src: vvaharness/backends/harness/provider_routing.py:37-42
fn routes_to_anthropic(model_id, provider):executor=code {
  if (provider) return provider == "anthropic"   // any other value, including an unrecognized one, is OpenAI-compatible
  return "claude" is a substring of lowercase(model_id)
}

// src: vvaharness/backends/harness/provider_routing.py:45-60
fn credential_env_overrides(model_id, provider, sdk_cfg, openai_cfg):executor=code {
  is_anthropic = routes_to_anthropic(model_id, provider)
  block = if (is_anthropic) sdk_cfg else openai_cfg
  prefix = if (is_anthropic) "ANTHROPIC" else "OPENAI"
  overrides = {}
  if (block.api_key) overrides["${prefix}_API_KEY"] = strip(block.api_key)   // must strip: a trailing newline from a key file is an illegal header value
  if (block.base_url) overrides["${prefix}_BASE_URL"] = strip(block.base_url)
  return overrides
}
