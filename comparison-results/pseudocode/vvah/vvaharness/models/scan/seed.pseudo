// SeedPackage: S0's deterministic seed (entry points, sinks, taint paths, languages, full walk), merged into S1's output.

@executedBy(CODE) @role(types)
record SeedPackage(List<EntryPoint> entryPoints, List<Sink> unsafeSinks, List<List<String>> taintPaths, List<String> languages,
                   List<String> allFiles, Map excluded) {
    // taintPaths: no producer fills this, so it is always empty                                    // src: vvaharness/models/scan/seed.py:29

    boolean truthy() {
        // true if S0 found anything worth merging into S1's output
        return !entryPoints.isEmpty() || !unsafeSinks.isEmpty() || !taintPaths.isEmpty();           // src: vvaharness/models/scan/seed.py:37
    }
}

