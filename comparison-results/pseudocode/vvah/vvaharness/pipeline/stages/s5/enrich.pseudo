// file: vvaharness/pipeline/stages/s5/enrich.py
// The fields S4 cannot produce (code snippet, sink/source refs), filled from the repo on disk.

@executedBy(CODE) @role(step) @stage("S5")
class S5Enrich {

    // MAX_SNIPPET_LINES = 40 (code constant, no knob): s4 spans whole handlers and the snippet rides in s6's prompt.

    String snippet(Finding f, List<String> lines) {
        int start = max(1, f.lineStart);                                                        // src: vvaharness/pipeline/stages/s5/enrich.py:78
        if (start > lines.size()) return "";                                                    // src: vvaharness/pipeline/stages/s5/enrich.py:79
        int want = max(start, f.lineEnd);
        int end = min(want, start + 40 - 1, lines.size());                                      // src: vvaharness/pipeline/stages/s5/enrich.py:82
        String body = lines.slice(start - 1, end).join("\n");
        return want > end ? body + "\n... (span continues past line " + end + ")" : body;       // src: vvaharness/pipeline/stages/s5/enrich.py:84
    }

    String sinkRef(Finding f) {
        return notBlank(f.sinkRef) ? f.sinkRef : f.file + ":" + max(1, f.lineStart);            // src: vvaharness/pipeline/stages/s5/enrich.py:89
    }

    String originRef(Finding f, String sink, Map anchors, Map seeds) {
        if (notBlank(f.sourceRef)) return f.sourceRef;                                          // src: vvaharness/pipeline/stages/s5/enrich.py:96
        if (f.vulnClass == VulnClass.INFO_LEAK) return sink;                                    // src: vvaharness/pipeline/stages/s5/enrich.py:98
        List<Integer> near = anchors.get(f.file);
        if (!near.isEmpty()) return f.file + ":" + near.minBy(ln -> abs(ln - f.lineStart));     // src: vvaharness/pipeline/stages/s5/enrich.py:102
        return CallgraphConsumer.bestSourceFromSeed(seeds.get(f.file));                          // src: vvaharness/pipeline/stages/s5/enrich.py:103
    }

    Map refs(Finding f, Map anchors, Map seeds) {
        String sink = sinkRef(f);
        String origin = originRef(f, sink, anchors, seeds);
        List<String> empty = names of ("sink_ref","source_ref") whose own value is blank;      // src: vvaharness/pipeline/stages/s5/enrich.py:111
        List<String> filled = empty.filter(n -> newValue(n) != null);                           // src: vvaharness/pipeline/stages/s5/enrich.py:115
        if (filled.isEmpty()) return Map.of();                                                  // src: vvaharness/pipeline/stages/s5/enrich.py:117
        return update(empty fields) + Map.of("backfilled_refs", f.backfilledRefs.union(filled)); // src: vvaharness/pipeline/stages/s5/enrich.py:118
    }

    Finding enrich(Finding f, FileCache cache, Map anchors, Map seeds, Reanchorer reanchorer) {
        if (reanchorer != null) f = S5Reanchor.apply(reanchorer, f);                            // src: vvaharness/pipeline/stages/s5/enrich.py:126
        Map update = new Map();
        List<String> lines = cache.lines(f.file);
        if (lines != null && f.codeSnippet.isBlank()) {                                         // src: vvaharness/pipeline/stages/s5/enrich.py:129
            String body = snippet(f, lines);
            if (!body.isEmpty()) { update.put("code_snippet", body); Counters.bump("s5_snippet_filled"); } // src: vvaharness/pipeline/stages/s5/enrich.py:133
        }
        update.putAll(refs(f, anchors, seeds));                                                 // src: vvaharness/pipeline/stages/s5/enrich.py:134
        return update.isEmpty() ? f : f.copy(update);
    }
}

@executedBy(CODE) @role(io) @stage("S5")
class FileCache {

    List<String> lines(String rel) {
        // Each file read at most once; None (unreadable) is cached too.
        if (!cache.contains(rel)) cache.put(rel, readLines(safePath(rel)));                    // src: vvaharness/pipeline/stages/s5/enrich.py:67
        return cache.get(rel);
    }

    Path safePath(String rel) {
        if (Path.isAbsolute(rel)) return null;                                                  // src: vvaharness/pipeline/stages/s5/enrich.py:53
        Path target = root.resolve(rel);
        if (!target.isWithin(root)) return null;                                                // src: vvaharness/pipeline/stages/s5/enrich.py:56
        if (!target.isRegularFile() || target.size() > maxKb * 1024) return null;               // src: vvaharness/pipeline/stages/s5/enrich.py:58
        return target;
    }
}
