// file: vvaharness/orchestrator/preflight.py
// Startup readiness: push transport/TLS/cache settings to the backend clients, check credentials per route,
// then live-probe every (model, via, provider) with a ping and the agentic roles with a forced tool round-trip.

@executedBy(CODE) @role(step)
class OrchestratorPreflight {

    /** Apply cfg.sdk / cfg.openai / cache settings to the backend clients (the cli: block is pushed by OrchestratorEntry). */
    @src("vvaharness/orchestrator/preflight.py:99")
    void configureBackends(Config cfg, Path cfgDir, Theta θ) {
        Set<String> vias = ConfigPaths.iterModelRoles(cfg).map(r -> LlmRegistry.resolve(r.model, θ).via);   // src: vvaharness/orchestrator/preflight.py:102
        // one credential serves sdk+deepagents; the ANTHROPIC_API_KEY fallback is allowed only when no cli role shares the run
        boolean sdkSole = Set.of("sdk", "deepagents").containsAll(vias);                                    // src: vvaharness/orchestrator/preflight.py:103
        LlmRegistryConfig.configureCache(θ);                                                                // pushed UNCONDITIONALLY // src: vvaharness/orchestrator/preflight.py:106
        if (cfg.sdk != null) LlmRegistryConfig.configureSdk(cfgDir, sdkSole, θ);                           // src: vvaharness/orchestrator/preflight.py:115
        if (cfg.openai != null) LlmRegistryConfig.configureOpenai(cfgDir, θ);                              // src: vvaharness/orchestrator/preflight.py:128
        // No deepagents branch: that route holds no process-global config
    }

    /** Verify whichever backends the config uses; returns false to abort the run. */
    @src("vvaharness/orchestrator/preflight.py:227")
    boolean checkBackends(Config cfg, Set<String> skipRoles, Theta θ) {
        List<Role> roles = ConfigPaths.iterModelRoles(cfg).filter(r -> !skipRoles.contains(r.name));       // src: vvaharness/orchestrator/preflight.py:231
        Set<String> vias = roles.map(r -> LlmRegistry.resolve(r.model, θ).via);                             // src: vvaharness/orchestrator/preflight.py:232
        // S4 tools must REACH the model or sessions run tool-less
        if (cfg.models.deepdive != null) {
            String ddVia = LlmRegistry.resolve(cfg.models.deepdive, θ).via;                                 // src: vvaharness/orchestrator/preflight.py:236
            if (!Deepagents.routeCarriesTools(cfg, ddVia, θ)) return false;                                // src: vvaharness/orchestrator/preflight.py:242
        }
        boolean ok = true;
        // via deepagents only for roles in DEEPAGENTS_ROLES
        if (roles.any(r -> LlmRegistry.resolve(r.model, θ).via == "deepagents" && !LlmRegistry.DEEPAGENTS_ROLES.contains(r.name))) ok = false; // src: vvaharness/orchestrator/preflight.py:300
        if (vias.contains("cli") && !Shell.which("claude")) {
            if (reportCredentialGap("claude CLI not on PATH", rolesFor(roles, "cli"))) ok = false;         // src: vvaharness/orchestrator/preflight.py:315
        }
        if (vias.contains("sdk")) {
            String key = θ["sdk.api_key"] != null ? θ["sdk.api_key"] : Env.get("ANTHROPIC_SDK_API_KEY");   // src: vvaharness/orchestrator/preflight.py:323
            if (key == null && Set.of("sdk", "deepagents").containsAll(vias)) key = Env.get("ANTHROPIC_API_KEY"); // src: vvaharness/orchestrator/preflight.py:328
            if (key == null && reportCredentialGap("ANTHROPIC_SDK_API_KEY not set", rolesFor(roles, "sdk"))) ok = false; // src: vvaharness/orchestrator/preflight.py:337
        }
        if (vias.contains("openai")) {
            String key = θ["openai.api_key"] != null ? θ["openai.api_key"] : Env.get("OPENAI_API_KEY");     // src: vvaharness/orchestrator/preflight.py:350
            if (key == null && reportCredentialGap("OPENAI_API_KEY not set", rolesFor(roles, "openai"))) ok = false; // src: vvaharness/orchestrator/preflight.py:353
        }
        if (vias.contains("deepagents")) {
            for (Role r : roles.filter(x -> LlmRegistry.resolve(x.model, θ).via == "deepagents")) {        // per (model_id, provider) // src: vvaharness/orchestrator/preflight.py:364
                if (!Environment.backendCredentialOk("deepagents", r.model.id, r.model.provider) && reportCredentialGap("DeepAgents credential", Set.of(r.name))) ok = false; // src: vvaharness/orchestrator/preflight.py:376
            }
        }
        if (!ok) return ok;                                                                                 // nothing to probe // src: vvaharness/orchestrator/preflight.py:383
        // JWT ANTHROPIC_API_KEY with no BASE_URL is caught pre-probe on Anthropic routes
        if (Environment.gatewayCheck() == FAIL) return false;                                               // src: vvaharness/orchestrator/preflight.py:398
        return probeBackends(cfg, skipRoles, θ);                                                            // src: vvaharness/orchestrator/preflight.py:407
    }

    /** A gap only S10/S11 roles need is a WARN (that stage self-disables); any detection role makes it fatal. */
    @src("vvaharness/orchestrator/preflight.py:182")
    boolean reportCredentialGap(String message, Set<String> roles) {
        if (!roles.isEmpty() && Set.of("remediate", "validate").containsAll(roles)) return false;           // src: vvaharness/orchestrator/preflight.py:185
        return true;                                                                                        // src: vvaharness/orchestrator/preflight.py:194
    }

    /** One minimal "ping" per unique (model_id, via, provider), then the agentic round-trip probe. */
    @src("vvaharness/orchestrator/preflight.py:740")
    boolean probeBackends(Config cfg, Set<String> skipRoles, Theta θ) {
        boolean ok = true;
        for (ProbeTarget t : probeTargets(cfg, skipRoles, θ)) {                                             // src: vvaharness/orchestrator/preflight.py:763
            Effort effort = highestEffort(t.roles.map(r -> Config.roleEffort(cfg, r)));                    // src: vvaharness/orchestrator/preflight.py:765
            try {
                if (t.via == "deepagents") Deepagents.probeHarness(cfg, t.modelId, t.provider, effort, θ);  // src: vvaharness/orchestrator/preflight.py:770
                // cli.prompt's own effort would replace the global cli.effort, so effort is not passed on cli
                else LlmRegistry.prompt("ping", t.model, t.via != "cli" ? effort : null, θ);               // src: vvaharness/orchestrator/preflight.py:782
            } catch (Exception e) {
                // a terse, token-capped or truncated reply still proves reachability
                if (reachableDespite(e)) continue;                                                          // src: vvaharness/orchestrator/preflight.py:790
                if (Set.of("remediate", "validate").containsAll(t.roles)) continue;                         // post-scan only: stage skipped // src: vvaharness/orchestrator/preflight.py:796
                ok = false;                                                                                 // src: vvaharness/orchestrator/preflight.py:808
            }
        }
        // runs even when a ping failed: more complete diagnostics in one pass
        ok = probeAgenticRoles(cfg, θ) && ok;                                                               // src: vvaharness/orchestrator/preflight.py:810
        return ok;
    }

    /** Forced tool round-trip for preprocess/verify/threatmodel: a nonce file the model must read and echo. */
    @src("vvaharness/orchestrator/preflight.py:512")
    boolean probeAgenticRoles(Config cfg, Theta θ) {
        boolean ok = true;
        for (ProbeTarget t : agenticTargets(cfg, List.of("preprocess", "verify", "threatmodel"), θ)) {     // src: vvaharness/orchestrator/preflight.py:407
            if (t.tools.isEmpty()) continue;                                                                // nothing to round-trip // src: vvaharness/orchestrator/preflight.py:536
            Path workdir = Files.mkdtemp("vva-preflight-");                                                 // src: vvaharness/orchestrator/preflight.py:552
            String nonce = Secrets.tokenHex(8);                                                             // src: vvaharness/orchestrator/preflight.py:454
            Files.write(workdir.resolve("vva_preflight_probe_marker.txt"), nonce);                          // src: vvaharness/orchestrator/preflight.py:459
            Prompt prompt = PreflightProbePrompt.nativeRoundtrip("vva_preflight_probe_marker.txt", θ);      // src: vvaharness/orchestrator/preflight.py:557
            try {
                String reply;
                if (t.via == "deepagents") {
                    reply = Deepagents.agentic(prompt, t.model, t.tools, workdir, 2, 300, θ["think_in_prompt"], θ); // max_turns=2, timeout 300s // src: vvaharness/orchestrator/preflight.py:563
                } else {
                    reply = LlmRegistry.agentic(prompt, t.model, t.tools, workdir, 2, 300, θ);              // src: vvaharness/orchestrator/preflight.py:574
                    // ADDITIONALLY probe the cli MCP bridge when cli.mcp_tools carries tools on this route
                    if (t.via == "cli" && θ["cli.mcp_tools"]) probeAgenticViaCliBridge(prompt, nonce, t, workdir); // src: vvaharness/orchestrator/preflight.py:582
                }
                // nonce never echoed: reachable but tool round-trip unconfirmed (WARN, not fatal)
                boolean confirmed = reply != null && reply.contains(nonce);                                 // src: vvaharness/orchestrator/preflight.py:587
            } catch (ToolStateNotRoundTrippedError e) {
                if (reportCredentialGap(e.message, t.roles)) ok = false;                                    // deterministic: real sessions fail the same // src: vvaharness/orchestrator/preflight.py:600
            } catch (Exception e) {
                if (reachableDespite(e)) continue;                                                          // src: vvaharness/orchestrator/preflight.py:603
                ok = false;                                                                                 // src: vvaharness/orchestrator/preflight.py:616
            } finally {
                Files.rmtree(workdir);                                                                      // src: vvaharness/orchestrator/preflight.py:618
            }
        }
        return ok;
    }

    void probeAgenticViaCliBridge(Prompt prompt, String nonce, ProbeTarget t, Path workdir) { }
    Effort highestEffort(List<Effort> efforts) { }

    boolean reachableDespite(Exception e) {
        return e instanceof DegenerateResponseError || e instanceof TruncatedResponseError || e.message.contains("exceeded") && e.message.contains("output token"); // src: vvaharness/orchestrator/preflight.py:158
    }

    List<ProbeTarget> probeTargets(Config cfg, Set<String> skipRoles, Theta θ) { }
    List<ProbeTarget> agenticTargets(Config cfg, List<String> roles, Theta θ) { }
    Set<String> rolesFor(List<Role> roles, String via) { }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/orchestrator/preflight.py:464")
class PreflightProbePrompt {

    /** The probe forces a genuine tool call (Read) followed by a final answer turn. */
    Prompt nativeRoundtrip(String markerName, Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.preflight.probe_read_marker_file"]);                                                    // "Use your file-reading tool to read the file <marker_name> in the current directory" // src: vvaharness/orchestrator/preflight.py:467
        p.format(θ["p.preflight.probe_reply_exact_contents"]);                                              // "reply with exactly its contents and nothing else." // src: vvaharness/orchestrator/preflight.py:468
        return p;
    }
}
