// file: vvaharness/pipeline/stages/s2/baseline.py
// S2's minimum-baseline audit: which required baseline items a threat model left undisposed,
// and whether an undisposed item's category is still covered by some other threat's wording.

@executedBy(CODE) @role(rule_set) @stage("S2")
class S2Baseline {

    int MIN_CATEGORY_TERM_MATCHES = 2;   // literal: one shared word is noise  // src: vvaharness/pipeline/stages/s2/baseline.py:80

    Set<String> requiredBaselines(Set<String> kinds, Theta θ) {
        Set<String> ids = new Set();
        for (String k : kinds) ids.addAll(RepoKinds.baselines(k, θ).map(b -> b.first));       // src: vvaharness/pipeline/stages/s2/baseline.py:31
        return ids;
    }

    /** Required ids given neither a threat whose evidence starts "baseline: <ID>" nor an open_questions "BL-..." entry. */
    Set<String> baselineAudit(ThreatModel tm, Set<String> kinds, Theta θ) {
        Set<String> required = requiredBaselines(kinds, θ);                                   // src: vvaharness/pipeline/stages/s2/baseline.py:36
        Set<String> asThreat = tm.threats.mapNotNull(t -> Regex.match("baseline:\\s*(BL-[A-Z]+-\\w+)", t.evidence)); // src: vvaharness/pipeline/stages/s2/baseline.py:37
        Set<String> asQuestion = tm.openQuestions.filter(q -> q.startsWith("BL-")).map(q -> q.split(":")[0].strip()); // src: vvaharness/pipeline/stages/s2/baseline.py:39
        return required.minus(asThreat).minus(asQuestion);                                    // src: vvaharness/pipeline/stages/s2/baseline.py:41
    }

    /** Lowercase word-stems (len >= 3, minus stopwords) of bid's own BASELINES text. */
    Set<String> categoryTerms(String bid, Theta θ) {
        return words(baselineText(bid, θ)).filter(w -> w.length() >= 3 && !STOPWORDS.contains(w)).map(w -> stem(w)); // src: vvaharness/pipeline/stages/s2/baseline.py:75
    }

    boolean categoryCoveredElsewhere(String bid, List<Threat> threats, Set<String> disposed, Theta θ) {
        Set<String> own = categoryTerms(bid, θ);                                              // src: vvaharness/pipeline/stages/s2/baseline.py:86
        Set<String> alias = new Set();
        // BL-IAC-TLS may be covered by a disposed BL-WEB-A02's terms
        for (String a : COVERED_BY_ALIAS.get(bid)) if (disposed.contains(a)) alias.addAll(categoryTerms(a, θ)); // src: vvaharness/pipeline/stages/s2/baseline.py:88
        Set<String> terms = own.union(alias);
        if (terms.size() < MIN_CATEGORY_TERM_MATCHES) return false;                           // src: vvaharness/pipeline/stages/s2/baseline.py:92
        for (Threat t : threats) {                                                            // src: vvaharness/pipeline/stages/s2/baseline.py:94
            Set<String> matched = terms.filter(term -> t.threat.lower().contains(term));      // src: vvaharness/pipeline/stages/s2/baseline.py:96
            if (matched.size() >= MIN_CATEGORY_TERM_MATCHES && matched.intersects(own)) return true; // src: vvaharness/pipeline/stages/s2/baseline.py:98
        }
        return false;
    }
}
