// file: vvaharness/util/net.py
// Host-literal predicates (spelling only, no DNS lookups), shared so copies cannot disagree.

@executedBy(CODE) @role(rule_set)
class Net {

    static final Set<String> LOCAL_NAMES = Set.copyOf(θ["code.util.net.local_names"]); // src: vvaharness/util/net.py:22

    IpAddress ipLiteral(String host) {
        try { return IpAddress.parse(host.strip().strip("[]")); }             // src: vvaharness/util/net.py:28
        catch (ValueError e) { return null; }                                  // a name, not an IP // src: vvaharness/util/net.py:29
    }

    boolean isLoopbackHost(String host) {
        if (host == null || host.isEmpty()) return false;                      // src: vvaharness/util/net.py:35
        String h = host.strip().strip("[]");                                   // src: vvaharness/util/net.py:37
        if (LOCAL_NAMES.contains(h.lower())) return true;                      // src: vvaharness/util/net.py:38
        IpAddress ip = ipLiteral(h);                                           // src: vvaharness/util/net.py:40
        return ip != null && ip.isLoopback();                                  // src: vvaharness/util/net.py:41
    }

    // caller alias (pass-1 files call Net.isLoopback) for is_loopback_host
    boolean isLoopback(String host) {
        return isLoopbackHost(host);
    }
}
