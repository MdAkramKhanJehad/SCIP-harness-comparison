                        // cli.prompt's own effort would replace the global cli.effort, so effort is not passed on cli
                        LlmRegistry.prompt(θ["code.orchestrator.preflight.probe_ping_prompt"], mcfg, via != "cli" ? effort : null, θ)); // src: vvaharness/orchestrator/preflight.py:781
