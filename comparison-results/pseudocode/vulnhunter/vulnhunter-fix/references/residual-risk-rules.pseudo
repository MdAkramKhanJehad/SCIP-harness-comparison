// file: vulnhunter-fix/references/residual-risk-rules.md
// Rule book (REQ-HON-005..010): residual_vectors[] formatting and delivery rules R-1..R-8 for MITIGATION/WORKAROUND tiers.
// Consumed by vulnhunter_fix/delivery.py (residual rendering, hand-wave + empty-residual guards), the follow-up-issue renderer,
// and prompts/worker_agent_crypto.md (R-5 trust-chain residuals) during Phase 3 implement / Phase 5 deliver.

@executedBy(MODEL) @role(rule_set) @stage("fix.deliver")
class ResidualRiskRules {

    // Entry: validate residuals, then render body section, follow-ups and PR state.
    DeliveryPlan apply(Result result, Finding f, Theta θ) {
        if (f.routedTo == "worker_agent_crypto.md") r5CryptoResiduals(result, f, θ);
        r1NonEmptyWhenNotFull(result, θ);
        r2EmptyWhenFull(result, θ);
        r3HandWaveGuard(result, θ);
        r4OneVectorPerEntry(result, θ);
        DeliveryPlan plan = new DeliveryPlan();
        plan.residualSection = r6ResidualSection(result, θ);
        plan.followups = r7FollowupIssues(result, f, θ);
        plan.prState = r8PrState(result, θ);
        return plan;
    }

    @executedBy(CODE)
    void r1NonEmptyWhenNotFull(Result r, Theta θ) {
        if (r.completenessTier == MITIGATION || r.completenessTier == WORKAROUND) {                   // src: vulnhunter-fix/references/residual-risk-rules.md:13
            if (r.residualVectors.size() < θ["p.residual-risk-rules.r1_non_empty_when_not_full"]) {   // src: vulnhunter-fix/references/residual-risk-rules.md:14
                throw new EmptyResidualError("empty residuals for non-FULL tier");      // delivery.py: EmptyResidualError                                    // src: vulnhunter-fix/references/residual-risk-rules.md:15
            }
        }
    }

    @executedBy(CODE)
    void r2EmptyWhenFull(Result r, Theta θ) {
        if (r.completenessTier == FULL && θ["p.residual-risk-rules.r2_empty_when_full"]) {           // src: vulnhunter-fix/references/residual-risk-rules.md:19
            if (!r.residualVectors.isEmpty()) throw new FullTierWithResidualsError("result-schema.json allOf: FULL with residuals");      // delivery.py: FullTierWithResidualsError // src: vulnhunter-fix/references/residual-risk-rules.md:21
        }
    }

    @executedBy(CODE)
    void r3HandWaveGuard(Result r, Theta θ) {
        List<String> phrases = θ["p.residual-risk-rules.r3_hand_wave_guard"];                         // src: vulnhunter-fix/references/residual-risk-rules.md:26
        for (String entry : r.residualVectors) {
            for (String ph : phrases) {
                boolean hit;
                if (θ["p.residual-risk-rules.r3_match_mode"] == "case-insensitive substring") {        // src: vulnhunter-fix/references/residual-risk-rules.md:27
                    hit = entry.toLowerCase().contains(ph.toLowerCase());
                } else {
                    hit = entry.contains(ph);
                }
                if (hit) throw new HandWaveResidualError(entry);      // delivery.py: HandWaveResidualError; the PR body is not rendered                                       // src: vulnhunter-fix/references/residual-risk-rules.md:26
            }
        }
    }

    void r4OneVectorPerEntry(Result r, Theta θ) {
        for (String entry : r.residualVectors) {
            // each entry names exactly one open vector; "multiple issues remain" is not permitted
            assert countVectors(entry) == θ["p.residual-risk-rules.r4_one_vector_per_entry"];        // src: vulnhunter-fix/references/residual-risk-rules.md:41
            String fmt = θ["p.residual-risk-rules.r4_format_recommendation"];                        // src: vulnhunter-fix/references/residual-risk-rules.md:48
            // fmt is a recommendation only; not enforced
        }
    }

    void r5CryptoResiduals(Result r, Finding f, Theta θ) {
        // four crypto trust-chain booleans (REQ-CWE-007), in the order of the texts list
        List<String> texts = θ["p.residual-risk-rules.r5_trust_chain_entry_texts"];                  // src: vulnhunter-fix/references/residual-risk-rules.md:62
        List<Boolean> chain = List.of(r.algorithmApproved, r.keySourceApproved, r.rotationDetected, r.transportEncryptionDetected);
        for (int i = 0; i < chain.size(); i++) {
            if (!chain.get(i) && r.completenessTier == MITIGATION) {
                r.residualVectors.add(θ["p.residual-risk-rules.r5_crypto_trust_chain_prefix"] + " " + texts.get(i)); // src: vulnhunter-fix/references/residual-risk-rules.md:60
                if (!θ["p.residual-risk-rules.r5_one_entry_per_false_boolean"]) break;              // src: vulnhunter-fix/references/residual-risk-rules.md:67
            }
        }
    }

    @executedBy(CODE)
    Section r6ResidualSection(Result r, Theta θ) {
        if (r.completenessTier == FULL) return null;
        if (!θ["p.residual-risk-rules.r6_residual_section_mandatory"]) return null;                   // src: vulnhunter-fix/references/residual-risk-rules.md:73
        List<String> entries = r.residualVectors;
        if (!θ["p.residual-risk-rules.r6_bullet_order"]) entries = entries.anyOrder();                // src: vulnhunter-fix/references/residual-risk-rules.md:74
        return Section.of("## Residual Risk", entries.map(e -> "- " + e));                           // PR body AND per-finding issue body
    }

    @executedBy(CODE)
    List<Issue> r7FollowupIssues(Result r, Finding f, Theta θ) {
        List<Issue> out = new List();
        for (String entry : r.residualVectors) {
            for (int k = 0; k < θ["p.residual-risk-rules.r7_followup_issue_per_residual"]; k++) {    // src: vulnhunter-fix/references/residual-risk-rules.md:78
                Issue i = new Issue();
                i.label = θ["p.residual-risk-rules.r7_followup_label"];                              // src: vulnhunter-fix/references/residual-risk-rules.md:79
                i.body = Body.of(θ["p.residual-risk-rules.r7_followup_body_contents"], entry, f.vulnId, f.issueLink); // src: vulnhunter-fix/references/residual-risk-rules.md:80
                String keyFormula = θ["p.residual-risk-rules.r7_followup_key"];                       // src: vulnhunter-fix/references/residual-risk-rules.md:83
                i.body += "<!-- vulnfix-followup-key: " + Hash.sha256(f.id + entry) + " -->";
                out.add(i);
            }
        }
        return out;
    }

    @executedBy(CODE)
    String r8PrState(Result r, Theta θ) {
        if (r.completenessTier == WORKAROUND) return θ["p.residual-risk-rules.r8_workaround_draft"];  // src: vulnhunter-fix/references/residual-risk-rules.md:88
        return θ["p.residual-risk-rules.r8_mitigation_full_ready"];                                   // src: vulnhunter-fix/references/residual-risk-rules.md:89
    }
}
