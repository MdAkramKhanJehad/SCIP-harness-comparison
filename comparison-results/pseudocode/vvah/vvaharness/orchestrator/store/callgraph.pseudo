// file: vvaharness/orchestrator/store/callgraph.py
// Per-run entry-point and sink snapshots: an entry/sink qnode index (no edges) written as rows and bound
// to the stage that produced it, and read back as isolated call_graph nodes.

@executedBy(CODE) @role(io)
class Callgraph {

    String qnode(String filePath, String functionName) {
        String filePart = filePath.replace("\\", "/");                                                // src: vvaharness/orchestrator/store/callgraph.py:24
        String fnPart = functionName;                                                                  // src: vvaharness/orchestrator/store/callgraph.py:25
        return (!filePart.isEmpty() || !fnPart.isEmpty()) ? filePart + "::" + fnPart : "";             // src: vvaharness/orchestrator/store/callgraph.py:26
    }

    /** Split on the LAST "::" (C++/C# names may contain "::"). */
    Pair<String, String> splitQnode(String qnode) {
        if (!qnode.contains("::")) return Pair.of("", qnode);                                         // src: vvaharness/orchestrator/store/callgraph.py:31
        return qnode.rpartition("::");                                                                 // src: vvaharness/orchestrator/store/callgraph.py:33
    }

    /** One node row per qnode named by obj.entry_points / obj.unsafe_sinks; null when there are none. */
    List<Map> graphRows(Object obj) {
        List entryPoints = obj.entryPoints; List unsafeSinks = obj.unsafeSinks;                        // src: vvaharness/orchestrator/store/callgraph.py:39
        if (entryPoints.isEmpty() && unsafeSinks.isEmpty()) return null;                               // src: vvaharness/orchestrator/store/callgraph.py:41
        Map<String, Pair> entryMeta = new Map();
        for (EntryPoint ep : entryPoints) {
            String qn = qnode(ep.file, ep.function);                                                   // src: vvaharness/orchestrator/store/callgraph.py:46
            if (!qn.isEmpty()) entryMeta.put(qn, Pair.of(ep.kind, ep.reachableFromUnauth ? 1 : 0));    // src: vvaharness/orchestrator/store/callgraph.py:48
        }
        Map<String, Integer> sinkMeta = new Map();
        for (Sink sink : unsafeSinks) {
            String qn = qnode(sink.file, sink.function);                                               // src: vvaharness/orchestrator/store/callgraph.py:55
            if (!qn.isEmpty()) {
                int line = sink.line;                                                                  // src: vvaharness/orchestrator/store/callgraph.py:57
                Integer prev = sinkMeta.get(qn);
                sinkMeta.put(qn, (prev == null || (line > 0 && line < prev)) ? line : prev);           // lowest non-zero line wins // src: vvaharness/orchestrator/store/callgraph.py:59
            }
        }
        List<Map> rows = new List();
        for (String qn : entryMeta.keys().union(sinkMeta.keys()).sorted()) {                           // src: vvaharness/orchestrator/store/callgraph.py:62
            Pair<String, String> fn = splitQnode(qn);                                                  // src: vvaharness/orchestrator/store/callgraph.py:63
            rows.add(Map.of("qnode", qn, "file_path", fn.first, "function_name", fn.second,
                "is_entry_point", entryMeta.containsKey(qn) ? 1 : 0, "is_sink", sinkMeta.containsKey(qn) ? 1 : 0,
                "sink_line", sinkMeta.getOrDefault(qn, 0)));                                           // src: vvaharness/orchestrator/store/callgraph.py:66
        }
        return rows;                                                                                   // src: vvaharness/orchestrator/store/callgraph.py:77
    }

    /** Persist obj's qnode index (content-addressed graph_id) and bind step to it. */
    String saveCallgraph(String runId, String step, Object obj) {
        List<Map> rows = graphRows(obj);                                                               // src: vvaharness/orchestrator/store/callgraph.py:82
        if (rows == null) return null;                                                                 // src: vvaharness/orchestrator/store/callgraph.py:84
        String graphId = Sha256.hex(Json.dumpSorted(Map.of("nodes", rows))).substring(0, 32);          // src: vvaharness/orchestrator/store/callgraph.py:88
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/callgraph.py:90
        try {
            con.transaction(() -> {
                con.execute("INSERT OR IGNORE INTO runs ...; UPDATE runs SET updated_at", runId);     // src: vvaharness/orchestrator/store/callgraph.py:93
                if (con.query("SELECT 1 FROM callgraph_snapshots WHERE run_id=? AND graph_id=?", runId, graphId).isEmpty()) { // src: vvaharness/orchestrator/store/callgraph.py:101
                    con.execute("INSERT INTO callgraph_snapshots", runId, graphId, rows.size(), 0, rows.sum("is_entry_point"), rows.sum("is_sink")); // src: vvaharness/orchestrator/store/callgraph.py:102
                    con.executeMany("INSERT INTO callgraph_nodes", rows);                             // src: vvaharness/orchestrator/store/callgraph.py:115
                }
                con.execute("INSERT OR REPLACE INTO callgraph_stage_refs(run_id, step, graph_id)", runId, step, graphId); // src: vvaharness/orchestrator/store/callgraph.py:133
            });
            return graphId;                                                                            // src: vvaharness/orchestrator/store/callgraph.py:137
        } finally { con.close(); }
    }

    /** Index bound to (run_id, step) as isolated call_graph nodes, or null when the step has no bound graph. */
    Map loadCallgraph(String runId, String step) {
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/callgraph.py:144
        String graphId; List<String> nodes;
        try {
            Row ref = con.query("SELECT graph_id FROM callgraph_stage_refs WHERE run_id=? AND step=?", runId, step).fetchOne(); // src: vvaharness/orchestrator/store/callgraph.py:146
            if (ref == null) return null;                                                              // src: vvaharness/orchestrator/store/callgraph.py:150
            graphId = ref.get(0);
            nodes = con.query("SELECT qnode FROM callgraph_nodes WHERE run_id=? AND graph_id=?", runId, graphId); // src: vvaharness/orchestrator/store/callgraph.py:153
        } finally { con.close(); }
        return Map.of("graph_id", graphId, "call_graph", nodes.toMap(qn -> qn, qn -> List.of()), "node_count", nodes.size()); // src: vvaharness/orchestrator/store/callgraph.py:160
    }
}
