// file: vvaharness/evidence/render.py
// ThreatEvidence -> prompt-ready text blocks for the S2 threat-model prompt.

@executedBy(CODE) @role(step) @stage("S2")
class Render {

    String renderLanguageBlock(ThreatEvidence ev) {
        String b = join("\n", ev.languages.map(ln -> "  - " + ln.lang + ": " + ln.n + " files"));  // src: vvaharness/evidence/render.py:23
        return b.isEmpty() ? "  (none detected)" : b;
    }

    String renderComponentsBlock(ThreatEvidence ev) {
        String b = join("\n", ev.topDirs.map(d -> "  - " + d + "/"));                             // src: vvaharness/evidence/render.py:28
        return b.isEmpty() ? "  (flat repo)" : b;
    }

    /** Every in-scope path grouped by directory, dirs sorted, names sorted. */
    String renderInventoryBlock(ThreatEvidence ev) {
        Map<String, List<String>> byDir = new Map();
        for (String rel : ev.inventory) byDir.get(dirOrDot(rel)).add(basename(rel));             // src: vvaharness/evidence/render.py:34
        String block = join("\n", sorted(byDir.keys()).map(d -> pad(d, 30) + " " + join("  ", sorted(byDir.get(d))))); // src: vvaharness/evidence/render.py:37
        if (block.isEmpty()) block = "  (no files in scope)";
        if (ev.inventoryTruncated) block += "\n  ...(truncated)";                                 // src: vvaharness/evidence/render.py:41
        return block;
    }

    String renderModulesBlock(ThreatEvidence ev) {
        String block = join("\n", ev.modules.map(m -> "  - " + m.name + "  (" + m.loc + " LOC) - " + m.purpose)); // src: vvaharness/evidence/render.py:48
        if (block.isEmpty()) block = "  (s1 emitted no modules)";
        if (ev.modulesTruncated) block += "\n  ...(truncated)";                                   // src: vvaharness/evidence/render.py:51
        return block;
    }

    /** Entry points as trust boundaries: kind, UNAUTH/auth flag, STRIDE hint per kind, file::func. */
    String renderEntryPointsBlock(ThreatEvidence ev, Map<String, String> strideByKind, Theta θ) {
        String block = join("\n", ev.entryPoints.map(e ->                                         // src: vvaharness/evidence/render.py:58
            "  - [" + e.kind + "] " + (e.unauth ? "UNAUTH" : "auth  ") +                          // src: vvaharness/evidence/render.py:59
            "  STRIDE:" + strideByKind.getOrDefault(e.kind, θ["code.evidence.render.default_stride_hint"]) + "  " + e.file + "::" + e.func)); // src: vvaharness/evidence/render.py:60
        if (block.isEmpty()) block = "  (s1 emitted no entry points)";
        if (ev.entryPointsTruncated) block += "\n  ...(truncated)";                               // src: vvaharness/evidence/render.py:63
        return block;
    }

    /** Reps with a body get a header block; the rest are a bare path. */
    String renderConfigRepsBlock(ThreatEvidence ev) {
        String b = join("\n", ev.configReps.map(r -> r.body.isEmpty() ? "  - " + r.rel : "  === " + r.rel + " ===\n" + r.body)); // src: vvaharness/evidence/render.py:70
        return b.isEmpty() ? "  (none)" : b;
    }

    String renderApiArtefactsBlock(ThreatEvidence ev) {
        String b = join("\n", ev.apiArtefacts.map(p -> "  - " + p));                              // src: vvaharness/evidence/render.py:77
        return b.isEmpty() ? "  (none)" : b;
    }

    String renderDocsBlock(ThreatEvidence ev) {
        String b = join("\n\n", ev.docs.map(d -> "=== " + d.name + " ===\n" + d.body));           // src: vvaharness/evidence/render.py:82
        return b.isEmpty() ? "(no README / SECURITY / ARCHITECTURE docs found)" : b;
    }

    String renderManifestsBlock(ThreatEvidence ev) {
        String b = join("\n\n", ev.manifests.map(m -> "=== " + m.name + " ===\n" + m.body));      // src: vvaharness/evidence/render.py:89
        return b.isEmpty() ? "(no build/dependency manifests found)" : b;
    }
}
