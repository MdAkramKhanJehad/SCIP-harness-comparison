# vvaharness/validation/scoring/_justify.py

Builds the host's justification text for a scored decision from the gate summaries and evidence. The phrasings are embedded in tracker templates.

Source: `vvaharness/validation/scoring/_justify.py` (lines 1-124)
Executor: code
Called from: `vvaharness/validation/scoring/_engine.sudo` score (as config.justify)

// src: vvaharness/validation/scoring/_justify.py:88-96
fn build_fix_justification(result, gates, _extra):executor=code {
  if (result.decision == INCONCLUSIVE) return result.justification || ""
  return match (result.decision) {
    case FIXED => "Fix verified: <summaries of pass gates>. Fix confidence: <round(raw_score * 100)>%. Evidence: <first 5 anchors>."
    case PARTIALLY_FIXED => "Partial fix: <summaries of pass gates>. Gaps: <summaries of fail and partial gates>. Fix confidence: <pct>%. Files needing fixes: <files or N/A>."
    default => "Fix insufficient: <summaries of fail gates>. Vulnerable pattern remains in <files or affected files>. Fix confidence: <pct>%. Recommended action: <actions joined by "; ">."
  }
}

// src: vvaharness/validation/scoring/_justify.py:99-124
fn _collect_evidence_anchors(criteria):executor=code = every evidence item as "file:line" (or "file" when line is null)   // capped at MAX_EVIDENCE_ANCHORS = 5 by _anchors_str
fn _files_needing_fixes(criteria):executor=code = sorted non-empty evidence files of gates with status fail or partial
fn _recommended_actions(gates):executor=code = for each fail gate "Address <name>: <summary>", or ["Review all failing gates and apply fixes"] when none
