// file: vvaharness/validation/synthesis/_consensus.py, vvaharness/validation/constants/synthesis.py
// Deterministic host synthesis of the three persona gate reports into one gate status per gate.
// 2+ agreeing votes (unique top) win at HIGH confidence; otherwise the most conservative top status wins, FLAGGED.

@executedBy(CODE) @role(types)
enum GateStatus { FAIL, PARTIAL, PASS, SKIP, INVALID }

@executedBy(CODE) @role(evaluation) @stage("S11")
class SynthesisConsensus {

    GateStatus mostConservative(Set<GateStatus> statuses) {
        for (GateStatus s : List.of(FAIL, PARTIAL, PASS, SKIP, INVALID)) {                          // src: vvaharness/validation/synthesis/_consensus.py:37
            if (statuses.contains(s)) return s;                                                     // src: vvaharness/validation/synthesis/_consensus.py:72
        }
        return INVALID;                                                                             // src: vvaharness/validation/synthesis/_consensus.py:74
    }

    Map<String, GateStatus> personaVotes(List<Entry> entries) {
        Map<String, GateStatus> votes = new Map();
        for (Entry e : entries) {                                                                   // src: vvaharness/validation/synthesis/_consensus.py:85
            GateStatus prior = votes.get(e.persona);
            // A duplicate vote from one persona merges to the most conservative, never a second vote.
            votes.put(e.persona, prior != null ? mostConservative(Set.of(prior, e.status)) : e.status); // src: vvaharness/validation/synthesis/_consensus.py:97
        }
        return votes;
    }

    List<SynthesizedGate> synthesizeGatesForFinding(List<PersonaReport> reports, String trackingId, Theta θ) {
        String rule = θ["code.s11.consensus_rule"];                                                 // src: vvaharness/validation/synthesis/_consensus.py:134
        Map<String, List<Entry>> byGate = new Map();
        for (PersonaReport r : reports) {                                                           // src: vvaharness/validation/synthesis/_consensus.py:136
            if (!r.trackingId.equals(trackingId)) continue;                                         // src: vvaharness/validation/synthesis/_consensus.py:137
            for (Gate g : r.gates) byGate.getOrPut(g.gateName).add(new Entry(r.persona, g));        // src: vvaharness/validation/synthesis/_consensus.py:140
        }
        List<SynthesizedGate> out = new List();
        for (String gateName : sorted(byGate.keys())) {                                             // src: vvaharness/validation/synthesis/_consensus.py:143
            Map<String, GateStatus> votes = personaVotes(byGate.get(gateName));                     // src: vvaharness/validation/synthesis/_consensus.py:144
            List<GateStatus> evaluated = votes.values().filter(s -> s != SKIP);                     // src: vvaharness/validation/synthesis/_consensus.py:146
            GateStatus chosen;
            String confidence;
            if (evaluated.isEmpty()) {                                                              // src: vvaharness/validation/synthesis/_consensus.py:147
                chosen = SKIP;
                confidence = "FLAGGED";                                                             // src: vvaharness/validation/synthesis/_consensus.py:148
            } else {
                Counter counter = Counter.of(evaluated);                                            // src: vvaharness/validation/synthesis/_consensus.py:150
                int topFreq = counter.max();                                                        // src: vvaharness/validation/synthesis/_consensus.py:151
                List<GateStatus> top = counter.keysWith(topFreq);                                   // src: vvaharness/validation/synthesis/_consensus.py:152
                if (top.size() == 1 && topFreq >= 2) {                                              // src: vvaharness/validation/synthesis/_consensus.py:153  (MIN_CONSENSUS_VOTES = 2)
                    chosen = top.get(0);
                    confidence = "HIGH";                                                            // src: vvaharness/validation/synthesis/_consensus.py:154
                } else {
                    chosen = mostConservative(top);                                                 // src: vvaharness/validation/synthesis/_consensus.py:156
                    confidence = "FLAGGED";                                                         // src: vvaharness/validation/synthesis/_consensus.py:157
                }
            }
            // Summaries, details and file/line evidence of every persona are carried onto the verdict.
            out.add(new SynthesizedGate(trackingId, gateName, chosen, confidence, votes));          // src: vvaharness/validation/synthesis/_consensus.py:172
        }
        // A required gate (of the four) that no persona answered -> INVALID / FLAGGED (only when some gate was answered).
        if (!byGate.isEmpty()) {                                                                    // src: vvaharness/validation/synthesis/_consensus.py:110
            for (String g : FIX_VALIDATION_GATES) {                                                 // src: vvaharness/validation/synthesis/_consensus.py:124
                if (!byGate.containsKey(g)) out.add(new SynthesizedGate(trackingId, g, INVALID, "FLAGGED", Map.of())); // src: vvaharness/validation/synthesis/_consensus.py:114
            }
        }
        return out;
    }
}
