# vvaharness/remediation_agent/policy/postgate.py

The policy post-gate, run after the model session on the enforced, allowed path. It observes the whole working tree (not just the files the model reported), captures the diff against the pre-call snapshot, and rejects the patch when it touches forbidden or sensitive paths, introduces unverified reusable-workflow references, or adds forbidden code constructs. A rejection reverts the offending files on disk and rewrites the verdict. A clean patch gets ACCEPT only when it is non-empty, the model claimed a fix, and all three self-reported evidence gates read "pass".

Source: `vvaharness/remediation_agent/policy/postgate.py` (lines 1-222)
Executor: code
Called from: `plugin_runner/run.sudo` harness_amend (enforce_post), _snapshot_targets (worktree_forbidden_matches)

// src: vvaharness/remediation_agent/policy/postgate.py:43-46
_WORKTREE_SCAN_MAX = 20000   // files
_WORKTREE_DIR_MAX = 20000   // folders

// src: vvaharness/remediation_agent/policy/postgate.py:84-91
PostResult {
  reverted: [String]   // repository-relative files reverted on disk
  matched_globs: [String]
  downgraded: Boolean
  final_verdict: "ACCEPT" | "REJECT"
  reason: String | null = null
}

// src: vvaharness/remediation_agent/policy/postgate.py:103-222
fn enforce_post(ctx, target, verdict, pre, repo, before_snapshot?, all_gates_passed=true):executor=code {
  changed = verdict.changes where file non-empty |> map(c => c.file)   // the model's claim

  // src: postgate.py:111-118 — ground truth from the whole tree, so an omitted forbidden edit is still caught
  whole_tree = artifacts.diff.gitcapture.changed_files_whole_tree(repo)
  worktree_forbidden = []
  if (!whole_tree) worktree_forbidden = worktree_forbidden_matches(repo, ctx.gate.forbid_patch_paths + ctx.gate.deny_paths)   // non-git fallback (or a clean git tree)

  // src: postgate.py:120-131 — a path present AND unchanged in the snapshot pre-dates this attempt
  if (before_snapshot) {
    unchanged = keys(before_snapshot) minus changed_since_snapshot(repo, before_snapshot)
    whole_tree = whole_tree where path not in unchanged
    worktree_forbidden = worktree_forbidden where path not in unchanged
    changed = changed where is_git_metadata(path) || path not in unchanged   // a name the verdict merely claims is not an edit; .git names stay a policy hit
  }

  // src: postgate.py:133-141 — diff scoped to reported + whole-tree paths, against the snapshot baseline
  diff_scope = unique(changed + whole_tree)
  diff = artifacts.diff.gitcapture.capture_git_diff(repo, diff_scope, baseline=before_snapshot)
  if (!diff && before_snapshot != null) diff = artifacts.diff.synth.synth_unified_diff(repo, before_snapshot, extra_files=diff_scope)
  diff_files = policy_gate.diffscan.inspect_diff(diff)
  candidates = unique(diff_files + changed + whole_tree + worktree_forbidden)

  // src: postgate.py:143-149 — path gate
  forbidden = ctx.gate.forbidden_files(candidates)   // hits forbid_patch_paths or deny_paths
  matched = forbidden |> map(f => ctx.gate.patch_touches_forbidden([f]) or ctx.gate.changed_paths_hit_deny([f])) |> filter(non-empty)

  // src: postgate.py:151 — workflow-reference gate (policy/workflow_refs.sudo)
  unsafe_refs = policy.workflow_refs.introduced_unsafe_workflow_refs(repo, before_snapshot)

  // src: postgate.py:153-156 — content gate: the path gates bound only WHERE the fixer wrote and the gates are a self-report; this looks at WHAT was added
  unsafe_content = policy.patch_content.scan_added_lines(diff)
  bad = unique(forbidden + keys(unsafe_refs) + keys(unsafe_content))

  // src: postgate.py:158-166 — clean patch
  ceiling = pre.decision.action
  if (!bad) {
    patch_applied = diff is non-blank
    gates_passed = all_gates_passed && _gates_ok(verdict) && patch_applied && verdict.verdict in ["Fixed", "Partially Fixed"]   // a no-op must never read ACCEPT
    return PostResult(reverted=[], matched_globs=[], downgraded=false, final_verdict=policy_gate.diffscan.cap_verdict(ceiling, gates_passed))
    // the verdict itself is not changed on this path; a REJECT here is recorded only in the audit metadata (final_verdict)
  }

  // src: postgate.py:168-171 — rejection: revert every bad file, drop them from the claimed changes
  reverted = policy.revert.revert_files(repo, bad, before_snapshot)
  verdict.changes = verdict.changes where file not in bad
  // preserved: the WHOLE file is reverted for a content or workflow hit, including any legitimate part of the fix in that file; files outside "bad" keep their edits

  // src: postgate.py:173-202 — note appended to remaining_risks and summary
  notes = []
  if (forbidden) append "Policy post-gate reverted edits to forbidden/sensitive paths (<sorted matched globs>)."
  if (unsafe_refs) append "Policy post-gate rejected unverified reusable-workflow refs (<path: refs; ...>). S10 must use a commit already established by the repository or decline the fix; it must never invent a SHA."
  if (unsafe_content) append "Policy post-gate rejected patch content that added forbidden constructs (<path: hits; ...>). A remediation patch must not introduce auth bypasses, dynamic code execution, network egress, credential reads, or shells; this may indicate prompt injection from the scanned source."
  refused = bad where is_git_metadata(path)
  if (refused) append "Refused to revert version-control metadata, inspect manually: <refused>."
  note = "<notes joined> Reverted <n> file(s): <reverted>. Route to a human."
  append note to verdict.remaining_risks

  // src: postgate.py:204-211 — verdict rewrite; the pre-gate owns "Denied", so a post-gate hit routes to a human instead
  if (unsafe_refs || unsafe_content) verdict.verdict = "Not Fixed"   // untrustworthy content is terminal
  else if (verdict.verdict in ["Fixed", "Partially Fixed"]) verdict.verdict = "Needs Review"
  verdict.summary = (verdict.summary + " " if non-empty) + note
  console "[policy] post-gate rejected and reverted <n> unsafe edit(s): <reverted>"
  // preserved: the policy file comments say a post-gate hit "downgrades to guidance"; the code sets "Needs Review" or "Not Fixed", never "Denied"

  // src: postgate.py:214-222
  reason = if (unsafe_refs) "unsafe_workflow_reference" else if (unsafe_content) "unsafe_patch_content" else null
  return PostResult(reverted, matched_globs=sorted unique matched, downgraded=true, final_verdict="REJECT", reason)
}

// src: vvaharness/remediation_agent/policy/postgate.py:94-100
fn _gates_ok(verdict) = verdict.gates exists && gates.source == "pass" && gates.sink == "pass" && gates.missing_control == "pass"   // the model's own self-report

// src: vvaharness/remediation_agent/policy/postgate.py:49-80
fn worktree_forbidden_matches(repo, patterns):executor=code {
  if (!patterns) return []
  out = []; seen = 0; dirs_seen = 0
  try {
    for each folder in walk(repo, follow links = false) {
      dirs_seen += 1
      if (dirs_seen > _WORKTREE_DIR_MAX) break
      for each regular file p in folder {
        seen += 1   // only files count toward the cap, so vendored folders cannot consume it
        if (seen > _WORKTREE_SCAN_MAX) return out
        rel = p relative to repo (posix)
        if (any pattern matches rel by policy_gate.matching._glob_match) append rel to out
      }
    }
  } catch => return out   // best effort, never raises
  return out
  // preserved: past either cap the scan silently stops; forbidden files beyond it are neither snapshotted nor checked off git
}
