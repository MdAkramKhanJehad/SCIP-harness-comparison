// file: vvaharness/validation/tools/pattern_scanner.py
// Deterministic PatternScan fact tool: runs one built-in pattern set over in-scope workspace files with
// byte/file/match caps, returning secret-free match metadata (file, line) plus one summary entry.

@executedBy(CODE) @role(types) @stage("S11")
record ReadResult(byte[] data, boolean unreadable, boolean tooLarge, boolean binary, boolean hasMore) { }

@executedBy(CODE) @role(types) @stage("S11")
record ScanPattern(String name, String description, Regex regex) { }

@executedBy(CODE) @role(types) @stage("S11")
record ScanState(List<Map> matches, int matchesSeen, int filesConsidered, int filesScanned, int filesTooLarge, int filesUnreadable,
                 int binaryFiles, int bytesScanned, boolean fileCountTruncated, boolean byteLimitTruncated, boolean perFileTruncated, boolean overallTruncated) { }

@executedBy(CODE) @role(tool) @stage("S11")
class PatternScanner {

    ReadResult readBounded(Path path, int maxBytes, Theta θ) {
        long size;
        byte[] raw;
        try {
            size = path.fstatSize();                                                                 // src: vvaharness/validation/tools/pattern_scanner.py:73
            raw = path.readBytes(maxBytes);                                                          // src: vvaharness/validation/tools/pattern_scanner.py:74
        } catch (OSError e) {
            return new ReadResult(new byte[0], true, false, false, false);                           // src: vvaharness/validation/tools/pattern_scanner.py:76
        }
        long observed = Math.max(size, raw.length);                                                  // src: vvaharness/validation/tools/pattern_scanner.py:77
        return new ReadResult(raw, false,
            observed > θ["code.validation.tools.pattern_scanner.max_file_bytes"],                    // too large -> not scanned  // src: vvaharness/validation/tools/pattern_scanner.py:80
            raw.contains(PatternSets.NUL_BYTE),                                                      // binary -> not scanned  // src: vvaharness/validation/tools/pattern_scanner.py:81
            observed > maxBytes);                                                                    // src: vvaharness/validation/tools/pattern_scanner.py:82
    }

    void scanText(ScanState state, String text, String relativePath, ScanPattern pattern, Theta θ) {
        int fileMatches = 0;
        for (Match m : pattern.regex.finditer(text)) {                                               // src: vvaharness/validation/tools/pattern_scanner.py:94
            state.matchesSeen += 1;
            fileMatches += 1;
            if (fileMatches > θ["code.validation.tools.pattern_scanner.max_matches_per_file"]) {     // src: vvaharness/validation/tools/pattern_scanner.py:97
                state.perFileTruncated = true;
                continue;
            }
            if (state.matches.size() >= θ["code.validation.tools.pattern_scanner.max_matches"]) {    // src: vvaharness/validation/tools/pattern_scanner.py:100
                state.overallTruncated = true;
                continue;
            }
            state.matches.add(Map.of("kind", "match", "file", relativePath, "line", text.countNewlines(0, m.start()) + 1, // no matched text: secret-free  // src: vvaharness/validation/tools/pattern_scanner.py:103
                                     "pattern_set", pattern.name, "rule", PatternSets.BUILTIN_RULE, "description", pattern.description));
        }
    }

    List<Map> result(ScanState state, String patternSet, Theta θ) {
        state.matches.sortBy(m -> Pair.of(m.get("file"), m.get("line")));                            // src: vvaharness/validation/tools/pattern_scanner.py:114
        List<String> reasons = new List();
        if (state.filesTooLarge > 0) reasons.add("file_size_limit");                                 // src: vvaharness/validation/tools/pattern_scanner.py:118
        if (state.filesUnreadable > 0) reasons.add("unreadable_files");                              // src: vvaharness/validation/tools/pattern_scanner.py:119
        if (state.binaryFiles > 0) reasons.add("binary_files");                                      // src: vvaharness/validation/tools/pattern_scanner.py:120
        if (state.fileCountTruncated) reasons.add("overall_file_limit");                             // src: vvaharness/validation/tools/pattern_scanner.py:121
        if (state.byteLimitTruncated) reasons.add("overall_byte_limit");                             // src: vvaharness/validation/tools/pattern_scanner.py:122
        if (state.perFileTruncated) reasons.add("per_file_match_limit");                             // src: vvaharness/validation/tools/pattern_scanner.py:123
        if (state.overallTruncated) reasons.add("overall_match_limit");                              // src: vvaharness/validation/tools/pattern_scanner.py:124
        state.matches.add(Map.of("kind", "summary", "pattern_set", patternSet, "matches_seen", state.matchesSeen, // src: vvaharness/validation/tools/pattern_scanner.py:128
            "matches_returned", state.matches.size(), "files_scanned", state.filesScanned, "bytes_scanned", state.bytesScanned,
            "truncated", !reasons.isEmpty(), "truncation_reasons", reasons, "limits", "max_file_bytes/max_total_bytes/max_files/max_matches_per_file/max_matches")); // src: vvaharness/validation/tools/pattern_scanner.py:139
        return state.matches;
    }

    void consumeFile(ScanState state, Path filePath, Path workspace, ScanPattern pattern, Theta θ) {
        state.filesConsidered += 1;                                                                  // src: vvaharness/validation/tools/pattern_scanner.py:155
        int remaining = θ["code.validation.tools.pattern_scanner.max_total_bytes"] - state.bytesScanned; // src: vvaharness/validation/tools/pattern_scanner.py:156
        int readLimit = Math.min(θ["code.validation.tools.pattern_scanner.max_file_bytes"], remaining); // src: vvaharness/validation/tools/pattern_scanner.py:157
        ReadResult r = readBounded(filePath, readLimit, θ);                                          // src: vvaharness/validation/tools/pattern_scanner.py:158
        state.bytesScanned += r.data.length;                                                         // src: vvaharness/validation/tools/pattern_scanner.py:159
        state.filesUnreadable += r.unreadable ? 1 : 0;
        state.filesTooLarge += r.tooLarge ? 1 : 0;
        state.binaryFiles += r.binary ? 1 : 0;
        boolean budgetExhausted = readLimit == remaining && r.hasMore;                               // src: vvaharness/validation/tools/pattern_scanner.py:163
        state.byteLimitTruncated |= budgetExhausted;
        if (!(r.unreadable || r.tooLarge || r.binary || budgetExhausted)) {                          // src: vvaharness/validation/tools/pattern_scanner.py:165
            state.filesScanned += 1;
            scanText(state, r.data.decode("utf-8", "replace"), filePath.relativeTo(workspace).toString(), pattern, θ); // src: vvaharness/validation/tools/pattern_scanner.py:168
        }
    }

    void scanWorkspace(ScanState state, Path workspace, ScanPattern pattern, Theta θ) {
        for (Path filePath : ToolsScope.iterInScopeFiles(workspace, false, θ)) {                     // tests excluded  // src: vvaharness/validation/tools/pattern_scanner.py:179
            if (PatternSets.skipInScan(θ).contains(filePath.name())) continue;                       // src: vvaharness/validation/tools/pattern_scanner.py:180
            if (state.filesConsidered >= θ["code.validation.tools.pattern_scanner.max_files"]) {     // src: vvaharness/validation/tools/pattern_scanner.py:182
                state.fileCountTruncated = true;
                break;                                                                               // src: vvaharness/validation/tools/pattern_scanner.py:184
            }
            consumeFile(state, filePath, workspace, pattern, θ);                                     // src: vvaharness/validation/tools/pattern_scanner.py:185
            if (state.byteLimitTruncated) break;                                                     // src: vvaharness/validation/tools/pattern_scanner.py:186
        }
    }

    List<Map> patternScan(Path workspace, String patternSet, Theta θ) {
        Map<String, PatternSet> sets = PatternSets.defaultPatternSets(θ);
        if (!sets.containsKey(patternSet)) return List.of(Map.of("kind", "error", "error", "unknown pattern_set; available: " + sets.keys().sorted())); // no raise  // src: vvaharness/validation/tools/pattern_scanner.py:192
        PatternSet ps = sets.get(patternSet);                                                        // src: vvaharness/validation/tools/pattern_scanner.py:199
        ScanPattern pattern = new ScanPattern(patternSet, ps.description, ps.pattern);               // src: vvaharness/validation/tools/pattern_scanner.py:200
        ScanState state = new ScanState();
        scanWorkspace(state, workspace, pattern, θ);                                                 // src: vvaharness/validation/tools/pattern_scanner.py:202
        return result(state, patternSet, θ);                                                         // src: vvaharness/validation/tools/pattern_scanner.py:203
    }
}
