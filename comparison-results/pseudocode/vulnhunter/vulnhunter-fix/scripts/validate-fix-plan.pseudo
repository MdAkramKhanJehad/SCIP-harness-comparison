// file: vulnhunter-fix/scripts/validate-fix-plan.py
// Validates a fix_plan artifact against references/fix_plan-schema.json, with result-schema.json registered for cross-file refs (REQ-SCH-003).

@executedBy(CODE) @role(evaluation) @stage("fix")
class ValidateFixPlan {

    // callers use run(path); returns ok plus the exit code
    Map run(String path) {
        int rc = validateFile(path);
        return Map.of("ok", rc == 0, "rc", rc);
    }

    // registers the sibling schemas under their file names so cross-file refs resolve
    Registry buildRegistry() {
        Registry registry = Registry.empty();
        for (String sibling : List.of("result-schema.json", "fix_plan-schema.json")) {                        // src: vulnhunter-fix/scripts/validate-fix-plan.py:35
            Map contents = Json.parse(Files.read(referencesDir().join(sibling)));                             // src: vulnhunter-fix/scripts/validate-fix-plan.py:36
            registry = registry.withResource(sibling, Resource.fromContents(contents, DRAFT202012));          // src: vulnhunter-fix/scripts/validate-fix-plan.py:38
        }
        return registry;
    }

    // one diagnostic line per schema error: path, json-path joined with slash (or the root marker when empty), message
    String formatError(String path, Error err) {
        String loc = err.absolutePath.map(p -> str(p)).join("/");                  // src: vulnhunter-fix/scripts/validate-fix-plan.py:42
        if (loc.isEmpty()) loc = "<root>";
        return path + ": " + loc + ": " + err.message;
    }

    int validateFile(String path) {
        Map schema = Json.parse(Files.read(skillRoot().join("references", "fix_plan-schema.json")));          // src: vulnhunter-fix/scripts/validate-fix-plan.py:48
        Draft202012Validator.checkSchema(schema);
        Object payload;
        try {
            payload = Json.parse(Files.read(path));                                                           // src: vulnhunter-fix/scripts/validate-fix-plan.py:52
        } catch (OSError e) {
            return 2;                                                                                         // src: vulnhunter-fix/scripts/validate-fix-plan.py:55
        } catch (JSONDecodeError e) {
            return 3;                                                                                         // src: vulnhunter-fix/scripts/validate-fix-plan.py:58
        }
        // fix_plan-schema refs result-schema.json#/$defs/tierJudgment
        Validator v = Draft202012Validator.of(schema, buildRegistry());// src: vulnhunter-fix/scripts/validate-fix-plan.py:60
        List<Error> errors = v.iterErrors(payload).sortedBy(e -> e.absolutePath);                             // src: vulnhunter-fix/scripts/validate-fix-plan.py:61
        if (errors.isEmpty()) return 0;                                                                       // src: vulnhunter-fix/scripts/validate-fix-plan.py:63
        for (Error err : errors) Stderr.print(formatError(path, err));
        return 1;                                                                                             // src: vulnhunter-fix/scripts/validate-fix-plan.py:66
    }

    int main(List<String> argv) {
        if (argv.size() != 2) return 64;                                                                      // src: vulnhunter-fix/scripts/validate-fix-plan.py:70
        return validateFile(argv.get(1));
    }
}
