@src("vvaharness/backends/llm/models.py:940")
interface LlmBackend {
    String prompt(String userPrompt, String model, Map kwargs);                                             // single-turn completion returning its text // src: vvaharness/backends/llm/models.py:943
    String agentic(String userPrompt, String model, Map kwargs);                                            // tool-using loop returning its final text; the deepagents adapter has prompt but NOT agentic // src: vvaharness/backends/llm/models.py:947
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/models.py:159")
class StructuredOutputPrompts {

    /** Once-only in-loop re-ask both raw loops (sdk, openai) send when a structured reply came back as prose. */
    Prompt proseReask(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.models.structured_prose_reask"]);                                                       // "Call the emit_structured_response tool now with your findings as its arguments." // src: vvaharness/backends/llm/models.py:161
        p.forbid(θ["p.models.structured_prose_reask_no_prose"]);                                            // "Do not reply with prose; the result is only accepted through that tool." // src: vvaharness/backends/llm/models.py:162
        return p;
    }

    /** System-prompt line for requests that cannot FORCE the tool (memoised rejection, manual thinking, deepagents under thinking). */
    @src("vvaharness/backends/llm/models.py:165")
    Prompt withSubmitInstruction(Prompt systemPrompt, Schema responseModel, String toolName, Theta θ) {
        Prompt p = new Prompt();
        if (systemPrompt != null) p.include(systemPrompt);                                                  // src: vvaharness/backends/llm/models.py:175
        p.must(θ["p.models.submit_instruction_call_tool"]);                                                 // "When you have your final <ResponseModel>, call the <tool_name> tool with it" // src: vvaharness/backends/llm/models.py:172
        p.forbid(θ["p.models.submit_instruction_no_plain_text"]);                                           // "a plain-text reply is not accepted." // src: vvaharness/backends/llm/models.py:173
        return p;
    }
}
