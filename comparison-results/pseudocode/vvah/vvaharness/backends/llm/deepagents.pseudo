        if (!natives.intersect(HarnessModels.readTools(null).map(r -> HarnessModels.logicalToNative(null).get(r))).isEmpty()) natives.addAll(HarnessModels.nativeImpliedReads(null)); // reads implied only when a read tool is granted // src: vvaharness/backends/llm/deepagents.py:150
        if (allowShell) natives.add(HarnessModels.nativeShellTool(null));                                   // opt-in only // src: vvaharness/backends/llm/deepagents.py:152
