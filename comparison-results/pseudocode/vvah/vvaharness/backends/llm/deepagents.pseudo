    @src("vvaharness/backends/llm/deepagents.py:492")
    Map buildHarnessEnv(String modelId, String provider, Object sdkCfg, Object openaiCfg, Path cfgDir) {
        return System.environ() + ProviderRouting.credentialEnvOverrides(modelId, provider, sdkCfg, openaiCfg) + DeepagentsModelBuilding.tlsCarriersFor(modelId, provider, sdkCfg, openaiCfg, cfgDir); // later maps win // src: vvaharness/backends/llm/deepagents.py:506
    }

    /** Split a legacy tool list into (granted, stripped) against the read-tool set. */
    @src("vvaharness/backends/llm/deepagents.py:517")
    Pair mapAllowedTools(List<String> allowedTools) {
        // None grants the default read set; a stripped name is never an error here, the caller warns
        if (allowedTools == null) return Pair.of(DEFAULT_TOOLS, List.of());                                 // src: vvaharness/backends/llm/deepagents.py:521
        List<String> names = allowedTools.distinctKeepOrder();                                              // src: vvaharness/backends/llm/deepagents.py:522
        List<String> granted = names.filter(n -> HarnessModels.readTools(null).contains(n));                // src: vvaharness/backends/llm/deepagents.py:523
        List<String> stripped = names.filter(n -> !HarnessModels.readTools(null).contains(n));              // src: vvaharness/backends/llm/deepagents.py:524
        return Pair.of(granted, stripped);                                                                  // src: vvaharness/backends/llm/deepagents.py:525
    }

    /** Stream the session, appending terminals to seen and every message to the transcript. */
    @src("vvaharness/backends/llm/deepagents.py:530")
    void consume(String userPrompt, StreamingOptions options, Transcript transcript, List<HarnessResult> seen) {
        // caller-owned list, not a return: the GraphRecursionError path needs the pre-raise snapshot
        for (Object message : Harness.get("deepagents").runStreaming(userPrompt, options)) {                // src: vvaharness/backends/llm/deepagents.py:537
            if (transcript != null) transcript.add(message);                                                // src: vvaharness/backends/llm/deepagents.py:538
            if (message instanceof HarnessResult) seen.add(message);                                        // src: vvaharness/backends/llm/deepagents.py:540
        }
    }

