{
  "build-system": {
    "requires": [
      "setuptools>=77"
    ],
    "build-backend": "setuptools.build_meta"
  },
  "project": {
    "name": "context-graph-sdk",
    "version": "0.1.0",
    "description": "Python-native code graph SDK",
    "readme": "README.md",
    "license": "Apache-2.0",
    "license-files": [
      "LICENSE"
    ],
    "requires-python": ">=3.11",
    "keywords": [
      "code-graph",
      "cypher",
      "sdk"
    ],
    "classifiers": [
      "Development Status :: 2 - Pre-Alpha",
      "Programming Language :: Python :: 3",
      "Programming Language :: Python :: 3.11",
      "Programming Language :: Python :: 3.12",
      "Typing :: Typed"
    ],
    "dependencies": [
      "arcadedb-embedded==26.10.1",
      "tree-sitter==0.25.2",
      "tree-sitter-go==0.25.0",
      "tree-sitter-python==0.25.0",
      "tree-sitter-javascript==0.25.0",
      "tree-sitter-typescript==0.23.2",
      "tree-sitter-java==0.23.5",
      "tree-sitter-c-sharp==0.23.5",
      "tree-sitter-scala==0.26.2",
      "tree-sitter-c==0.24.2",
      "tree-sitter-cpp==0.23.4",
      "tree-sitter-rust==0.24.2",
      "tree-sitter-ruby==0.23.1",
      "tree-sitter-php==0.24.1",
      "tree-sitter-swift==0.7.3",
      "tree-sitter-dart==0.1.0",
      "tree-sitter-solidity==1.2.13",
      "tree-sitter-language-pack==1.15.8"
    ],
    "optional-dependencies": {
      "mcp": [
        "mcp>=1.30,<2"
      ]
    }
  },
  "dependency-groups": {
    "dev": [
      "mcp>=1.30,<2",
      "pyright>=1.1.400",
      "pytest>=8.3",
      "ruff>=0.11"
    ]
  },
  "tool": {
    "setuptools": {
      "packages": {
        "find": {
          "where": [
            "src"
          ],
          "include": [
            "context_graph_sdk*"
          ]
        }
      },
      "package-data": {
        "context_graph_sdk": [
          "py.typed",
          "extractors/queries/*.scm"
        ]
      }
    },
    "ruff": {
      "target-version": "py311",
      "line-length": 100,
      "exclude": [
        ".venv",
        "**/.venv"
      ],
      "lint": {
        "select": [
          "E",
          "F",
          "I",
          "UP",
          "B",
          "SIM",
          "RUF"
        ]
      }
    },
    "pyright": {
      "include": [
        "src",
        "tests",
        "example"
      ],
      "exclude": [
        ".venv",
        "**/.venv"
      ],
      "pythonVersion": "3.11",
      "typeCheckingMode": "strict"
    },
    "pytest": {
      "ini_options": {
        "testpaths": [
          "tests"
        ],
        "addopts": "-q"
      }
    }
  }
}
