  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Process-global CLI config and the per-call subprocess environment.\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nfrom vvaharness.backends.harness.models import (\n    EffortLevel,\n)\nfrom vvaharness.backends.llm.cli import discovery as _discovery\nfrom vvaharness.backends.llm.models import (\n    CliConfig,\n)\nfrom vvaharness.backends.llm.tls import coerce_verify\nfrom vvaharness.util import logs\nfrom vvaharness.util.events import Event\n\nlog = logs.get_logger(__name__)\n\n# CLI reaches Node via env vars (ca_cert, verify_ssl, no_proxy); mTLS unsupported, no env path.\n\n_cfg: CliConfig = {\"verify_ssl\": True, \"ca_cert\": None,\n              \"client_cert\": None, \"no_proxy\": None, \"effort\": \"high\",\n              \"restricted\": True}\n_tls_extra: dict = {}\n\n\ndef _build_tls_env() -> dict:\n    \"\"\"Translate the stored TLS/proxy config into subprocess env vars.\"\"\"\n    out: dict = {}\n    ca = _cfg[\"ca_cert\"]\n    verify = _cfg[\"verify_ssl\"]\n    # A CA bundle may arrive as ca_cert or string verify_ssl (mirrors sdk.py precedence).\n    bundle = ca or (verify if isinstance(verify, str) else None)\n    if bundle:\n        if os.path.exists(bundle):\n            out[\"NODE_EXTRA_CA_CERTS\"] = bundle\n        else:\n            log.warning(Event.TLS_CA_NOT_FOUND, path=bundle)\n    if verify is False:\n        out[\"NODE_TLS_REJECT_UNAUTHORIZED\"] = \"0\"\n        log.warning(\"TLS verification disabled (verify_ssl=false) for the \"\n              \"claude subprocess\")\n    np = _cfg[\"no_proxy\"]\n    if np:\n        out[\"NO_PROXY\"] = np\n        out[\"no_proxy\"] = np\n    if _cfg[\"client_cert\"]:\n        log.warning(\"client_cert/mTLS is configured but the `claude` CLI \"\n              \"backend cannot present a client certificate (Node exposes no \"\n              \"env-var path for it). Use a `via: sdk` or `via: deepagents` \"\n              \"role for mTLS gateways.\")\n    return out\n\n\ndef configure(*, verify_ssl: bool | str | None = None,\n              ca_cert: str | None = None,\n              client_cert: str | tuple | None = None,\n              no_proxy: str | None = None,\n              effort: str | None = None,\n              restricted: bool | None = None) -> None:\n    \"\"\"Push gateway TLS/proxy settings into the `claude` subprocess environment; mTLS is unsupported here.\"\"\"\n    if verify_ssl is not None:\n        _cfg[\"verify_ssl\"] = coerce_verify(verify_ssl)\n    if ca_cert:\n        _cfg[\"ca_cert\"] = ca_cert\n    if client_cert:\n        _cfg[\"client_cert\"] = client_cert\n    if no_proxy:\n        _cfg[\"no_proxy\"] = no_proxy\n    if effort:\n        _cfg[\"effort\"] = effort\n    # `is not None`, not truthiness: False is the meaningful value here.\n    if restricted is not None:\n        _cfg[\"restricted\"] = bool(restricted)\n    _tls_extra.clear()\n    _tls_extra.update(_build_tls_env())\n\n\ndef _effective_effort(effort: str | None) -> str | None:\n    \"\"\"Per-call *effort* if it parses to a known tier, else the process-global ``cli.effort``.\"\"\"\n    parsed = EffortLevel.parse(effort) if effort is not None else None\n    return parsed.value if parsed is not None else _cfg.get(\"effort\")\n\n\ndef _effort_argv(effort: str | None) -> list[str]:\n    \"\"\"The ``--effort <tier>`` argv for one call, or ``[]`` (probe-gated).\"\"\"\n    tier = _effective_effort(effort)\n    if tier and _discovery._cli_capabilities()[\"effort\"]:\n        return [\"--effort\", tier]\n    return []\n\n\n# By default the CLI re-sends a refused turn once and can switch to a fallback model, so flagged\n# content would be sent again; set, the refusal ends the turn and ModelRefusal takes over.\n_NO_REFUSAL_RESEND_ENV = {\n    \"CLAUDE_CODE_DISABLE_REFUSAL_RETRY\": \"1\",\n    \"CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK\": \"1\",\n}\n\n\ndef _session_pins(effort: str | None) -> dict[str, str]:\n    \"\"\"Env pinned on every ``claude`` session: the effort tier (or blank), no refusal resend.\"\"\"\n    # An exported CLAUDE_CODE_EFFORT_LEVEL overrides `--effort`, and os.environ is always spread\n    # underneath, so an ambient value can only be overridden; blank reads as unset.\n    effort_argv = _effort_argv(effort)\n    return {\"CLAUDE_CODE_EFFORT_LEVEL\": effort_argv[1] if effort_argv else \"\",\n            **_NO_REFUSAL_RESEND_ENV}\n\n\ndef _call_env(*, max_tokens: int | None, effort: str | None) -> dict[str, str]:\n    \"\"\"Per-call env overrides for one ``claude`` subprocess: the session pins plus any token cap.\"\"\"\n    env = _session_pins(effort)\n    if max_tokens:\n        env[\"CLAUDE_CODE_MAX_OUTPUT_TOKENS\"] = str(max_tokens)\n    return env\n",
