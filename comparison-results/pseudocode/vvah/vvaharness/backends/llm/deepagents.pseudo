    }

    /** The stage name a WARN key is scoped to, from the caller's own tag convention. */
    @src("vvaharness/backends/llm/deepagents.py:1077")
    String stageOf(String tag) {
        return tag != null ? tag.split(" ", 2)[0] : "";                                                     // src: vvaharness/backends/llm/deepagents.py:1079
    }

    /** Name a dropped ModelCallBudget or EvidenceGate; a lone RecordTranscript stays silent. */
    @src("vvaharness/backends/llm/deepagents.py:1082")
    void warnDroppedMiddleware(List<Middleware> parentMiddleware, String via, String tag) {
        if (parentMiddleware.isEmpty()) return;                                                             // src: vvaharness/backends/llm/deepagents.py:1086
        List<Middleware> gated = parentMiddleware.filter(mw -> mw instanceof ModelCallBudget || mw instanceof EvidenceGate); // src: vvaharness/backends/llm/deepagents.py:1095
        if (gated.isEmpty()) return;                                                                        // src: vvaharness/backends/llm/deepagents.py:1096
        List<String> classes = gated.map(mw -> mw.typeName()).distinct().sorted();                          // src: vvaharness/backends/llm/deepagents.py:1098
        String tail = String.join("; ", classes.map(c -> DROP_CLAUSES.get(c)));                             // src: vvaharness/backends/llm/deepagents.py:1100
        WarnOnce.warnOnce(WARNED_LEGACY_KW, "middleware_dropped:" + via + ":" + stageOf(tag), "via drops the named middleware (no tool stack on this leg); " + tail); // src: vvaharness/backends/llm/deepagents.py:1101
    }

    /** Once per (via, stage): a tool stack meters EvidenceGate but never ModelCallBudget. */
    @src("vvaharness/backends/llm/deepagents.py:1106")
    void warnModelCallBudgetNotMetered(List<Middleware> parentMiddleware, String via, String tag) {
        if (!parentMiddleware.any(mw -> mw instanceof ModelCallBudget)) return;                             // src: vvaharness/backends/llm/deepagents.py:1114
        WarnOnce.warnOnce(WARNED_LEGACY_KW, "middleware_dropped_with_stack:" + via + ":" + stageOf(tag), "via does not meter ModelCallBudget on this leg; " + MODEL_CALL_BUDGET_CLAUSE); // src: vvaharness/backends/llm/deepagents.py:1116
    }

    /** Materialise the caller's fact tools into sdk/openai agentic kwargs; returns the adapter stack or None (None warns, never silent). */
    @src("vvaharness/backends/llm/deepagents.py:1121")
    Object adaptTools(ToolBuilder toolBuilder, String modelId, Path cwd, List<String> factTools, List<Middleware> parentMiddleware, Map legacyKw, String tag, String via) {
