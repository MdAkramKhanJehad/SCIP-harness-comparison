Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/model_building.sudo` build_model (OpenAI-compatible arm)

// src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:34-38
TOOL_CALL_STATE_KEY = "__vvaharness_tool_call_state__"   // stored in message.additional_kwargs; never sent on the wire
TOOL_STATE_CAPTURED_COUNTER = "deepagents_tool_state_captured"
_WIRE_TOOL_CALL_KEYS = ["id", "type", "function", "custom", "index"]   // keys langchain-openai already round-trips, plus index

// src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:71-87
fn ToolCallStateChatOpenAI._create_chat_result(response, generation_info?):executor=code {
  // external: subclass of langchain_openai.ChatOpenAI; non-streaming only
  result = ChatOpenAI._create_chat_result(response, generation_info)
  for each (generation, choice) in zip(result.generations, response.choices) {
    state = _state_by_id(tool calls of choice)
    if (state && generation.message is an AIMessage) {
      generation.message.additional_kwargs[TOOL_CALL_STATE_KEY] = state
      COUNTERS.bump(TOOL_STATE_CAPTURED_COUNTER)
    }
  }
  return result
}

// src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:89-96
fn ToolCallStateChatOpenAI._get_request_payload(input, stop?, ...kwargs):executor=code {
  payload = ChatOpenAI._get_request_payload(input, stop, ...kwargs)
  if (payload.messages is a list) _replay_all(input converted to messages, payload.messages)
  return payload
}

// src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:41-47
fn _state_by_id(tool_calls):executor=code {
  // per call id: every field not in _WIRE_TOOL_CALL_KEYS whose value is not null; calls without an id or without extra fields are skipped
}

// src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:62-68, 56-59
fn _replay_all(messages, wire):executor=code {
  if (length(messages) != length(wire)) return   // misaligned: replay nothing
  for each (message, sent) in zip(messages, wire) {
    state = message.additional_kwargs[TOOL_CALL_STATE_KEY]
    if (state) for each call in sent.tool_calls, set each captured field on call unless already present
  }
}

