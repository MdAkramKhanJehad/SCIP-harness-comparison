record FetchedRecord(IssueRef ref, FetchedIssue issue, VerifyMarkers markers, boolean bodyTampered,
                     String originalBody, List<IssueComment> comments, List<IssueEvent> events) { }

@executedBy(CODE) @role(types)
record RunState(List<Path> additionalRepos, Set<String> ignoredHints) { }

@executedBy(CODE) @role(types)
record PostOutcome(List<PostResult> succeeded, List<String> failed) { }
