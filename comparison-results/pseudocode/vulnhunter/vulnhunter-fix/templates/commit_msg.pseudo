// file: vulnhunter-fix/templates/commit_msg.md
// Per-finding fix commit message the implementing model fills in (one commit per finding).

@executedBy(CODE) @role(types)
record CommitMsgVars(String VULN_ID, String SHORT_TITLE, String CWE, String CWE_NAME, String EXPLOIT_SUMMARY,
                     String FIX_STRATEGY_ONE_LINER, String LOCATION, String SEVERITY) { }

@executedBy(MODEL) @role(prompt) @stage("fix")
class CommitMsg {

    Prompt run(CommitMsgVars v, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.implement.commit_message_format"]);                            // src: vulnhunter-fix/templates/commit_msg.md:1 (fix(security): <VULN_ID> <SHORT_TITLE>)
        p.format("Remediate <CWE>: <CWE_NAME>");                                     // src: vulnhunter-fix/templates/commit_msg.md:3
        p.format(List.of("Exploit: <EXPLOIT_SUMMARY>", "Fix: <FIX_STRATEGY_ONE_LINER>", "Location: <LOCATION>")); // src: vulnhunter-fix/templates/commit_msg.md:5
        if (θ["code.templates.commit_msg.severity_line"]) p.format("Severity: <SEVERITY>"); // src: vulnhunter-fix/templates/commit_msg.md:8
        // unclear: fork-mode severity masking (θ["p.implement.severity_mask_everywhere"]) must still rewrite this line
        p.checklist(List.of("Exploit demo confirms vulnerability is real",
                            "Security test FAILS before fix (vulnerable)",
                            "Security test PASSES after fix (secure)"));          // src: vulnhunter-fix/templates/commit_msg.md:10
        p.must(θ["p.implement.commit_trailers"]);                                    // src: vulnhunter-fix/templates/commit_msg.md:15
        return p;
    }
}
