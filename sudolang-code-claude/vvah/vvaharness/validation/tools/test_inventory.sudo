// src: vvaharness/validation/tools/test_inventory.py:51-75
fn test_inventory(workspace):executor=code {
  for each file_path in tools._scope.iter_in_scope_files(workspace, include_tests=true) {
    if (!_is_test_file(file name)) continue
    try text = read file (errors replaced); catch OSError => continue
    markers = sorted NEGATIVE_TEST_MARKERS found case-insensitively with word boundaries
    collect { file: relative path, lines: line count, negative_test_markers: markers, has_negative_tests: markers non-empty }
  }
  return { test_files: sorted by file, total_test_files, files_with_negative_tests }
}

// src: vvaharness/validation/tools/test_inventory.py:37-44
fn _is_test_file(name):executor=code {
  return name in PY_TEST_EXACT_NAMES
    || (name ends with ".py" && (name starts with "test_" || name ends with "_test.py"))
    || name ends with any JS_TEST_SUFFIXES
}
