// src: vvaharness/pipeline/stages/replay.py:237-264
fn run_with_deadline(call, seconds?, stage, effort?):executor=code {
  if (!seconds || seconds <= 0) return call()   // no clock
  fut = start_daemon(call, "deadline-$stage")   // daemon thread, never joined
  try return fut.result(timeout=seconds);
  catch TimeoutError => {
    if (fut is done) return fut.result()   // the call's own timeout error is re-raised unchanged, counted once
    on later settlement: COUNTERS.bump("${first word of stage}_orphan_settled")
    fut.cancel()   // a no-op on a running future; the abandoned call may keep running
    throw call_timeout_error(stage, route="stage", budget_s=seconds, effort, cause_text="stage deadline exceeded ${seconds}s")   // a CallTimeoutError
  }
}

// src: vvaharness/pipeline/stages/replay.py:267-280
fn deadline_bound(existing?, deadline, effort?, via):executor=code {
  // the session timeout handed to a route so its own clock stops before the stage deadline
  if (!deadline || deadline <= TIMEOUT_STOP_GRACE_SECONDS) return existing
  tier = if (via == "cli") cli._effective_effort(effort) else effort
  net = deadline - TIMEOUT_STOP_GRACE_SECONDS
  scaled = effort_scaled_seconds(net, tier, kind=SESSION) || net
  bound = net * (net / scaled)
  return if (existing == null || existing > bound) bound else existing   // the smaller of the two
}

// src: vvaharness/pipeline/stages/replay.py:312-336
fn resume_or_replay(session_id, replay, model, cfg, instruction, stage, tag, timeout):executor=mixed {
  COUNTERS.bump("${stage}_deadline_resume")
  constraint OnEveryExit { release_pinned_session(session_id) }   // src: replay.py:333-334
  try {
    out = callModel({ role: model, route: "deepagents", system: the live session's, prompt: instruction appended as one user turn to session_id, tools: the live session's, limits: { timeout }, output: the stage's output })
      // external: vvaharness/backends/llm/deepagents.py resume_agentic
  } catch ModelRefusal => throw   // dispatch_or_retry_unforced owns the single refusal resend
  catch error => {
    COUNTERS.bump("${stage}_deadline_resume_unavailable"); warn REPLAY_NO_LIVE_SESSION
    return replay()   // any other failure degrades to the transcript re-ask
  }
  return out
}
// settled: resume_agentic continues a session only on via "cli" and via "deepagents"; any other via raises SessionNotResumableError, so resume_or_replay falls back to replay()
// src: vvaharness/backends/llm/deepagents.py:1186-1200

// src: vvaharness/pipeline/stages/replay.py:283-291
fn replay_prompt(transcript, original_prompt, instruction, stage):executor=code {
  if (!transcript.captured) {
    COUNTERS.bump("${stage}_replay_without_transcript")
    return instruction + "\n\nNo transcript was recoverable on this route. The original request follows; answer it directly.\n\n" + original_prompt
  }
  COUNTERS.bump("${stage}_replay_from_transcript")
  return instruction + "\n\n=== SESSION TRANSCRIPT ===\n\n" + transcript.render()
}

// src: vvaharness/pipeline/stages/replay.py:137-179
Transcript {
  _messages = []; _lock   // a lock guards the shared message list
  record(messages) { with _lock: if (length(messages) >= length(_messages)) _messages = messages }   // keeps the most complete capture
  captured = _messages is non-empty
  render(max_chars=120_000) {
    for each message with text or tool calls: "[ROLE]\n" + body cut to _MAX_ENTRY_CHARS (+ "[... N chars cut]") + one line per tool call "  -> called name(first 400 characters of args)"
    if (total > max_chars) return "[... earlier turns cut to fit the window ...]\n\n" + last max_chars characters   // oldest turns trimmed first
  }
}

// src: vvaharness/pipeline/stages/replay.py:182-203
RecordTranscript {
  // agent middleware: records each model request's messages into the Transcript, never alters the request
}

// src: vvaharness/pipeline/stages/replay.py:294-309
fn session_id_for(stage, key):executor=code = "$stage-$key-<random uuid hex>"
fn pinned_session(stage, key):executor=code {
  session_id = session_id_for(stage, key)
  constraint OnEveryExit { release_pinned_session(session_id) }   // resume_or_replay only covers the timeout path
  yield session_id
}

