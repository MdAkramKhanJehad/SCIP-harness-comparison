// Source comment (17): nothing else bounds tool-call volume; turn and token ceilings bound the conversation, not calls.

// src: vvaharness/backends/harness/deepagents/tool_budget.py:37-41
// prompt-src: vvaharness/backends/harness/deepagents/tool_budget.py:37-41
_BUDGET_MESSAGE {
  // Content of the error ToolMessage returned for a refused call
  Constraints {
    "Your tool-call budget for this session is exhausted. Do not call any further tool in the metered set; finish from the evidence you already have. Calling one again will not run and only spends a turn."
  }
}

// src: vvaharness/backends/harness/deepagents/tool_budget.py:43-61
_DEFAULT_COUNTER = "tool_call_budget_exhausted"
_KNOB_NAMES = {   // counter -> scan-config key named in the warning; others get "its scan-config budget knob"
  "s2_graph_tool_budget_exhausted": "step2.graph_tool_budget",
  "s4_graph_tool_budget_exhausted": "step4.graph_tool_budget",
  "s4_cwe_tool_budget_exhausted": "step4.cwe_tool_budget",
  "s6_graph_tool_budget_exhausted": "step6_verify.graph_tool_budget"
}
fn _calls_counter_name(counter, tool):executor=code {
  return if (counter == _DEFAULT_COUNTER) "tool_calls_$tool" else "${counter without suffix "_budget_exhausted"}_calls_$tool"
}

// src: vvaharness/backends/harness/deepagents/tool_budget.py:64-74
fn _exhaustion_warning(counter, limit, tool_names):executor=code {
  // abstracted: console WARN text naming the knob, the limit per session, the tool names and the counter; printed once per counter per run
}

// src: vvaharness/backends/harness/deepagents/tool_budget.py:83-89
// prompt-src: vvaharness/backends/harness/deepagents/tool_budget.py:85-89
WithdrawnNotice {
  Constraints {
    "Your budget for ${sorted(tool_names) joined by ", "} is exhausted; it/they have been withdrawn from your available tools for the rest of this session -- finish from the evidence you already have rather than asking for it/them again."
  }
}

// src: vvaharness/backends/harness/deepagents/tool_budget.py:92-189
ToolCallBudget {
  // Source comment (94): never meter every tool — a structured-output call is a tool call, and blocking it strands the session
  // src: tool_budget.py:96-105
  State {
    _tool_names = tool_names
    _limit = limit                // no default; total across all metered tools in the session
    _counter = counter            // default "tool_call_budget_exhausted"
    _spent = 0
    _withdrawal_announced = false
    _lock
  }
  name = "ToolCallBudget[$_counter]"   // src: tool_budget.py:107-111

  // src: tool_budget.py:113-119
  fn _claim():executor=code {
    with _lock {
      if (_spent >= _limit) return false
      _spent += 1; return true
    }
  }

  // src: tool_budget.py:121-131
  fn _gate(tool_call):executor=code {
    if (tool_call.name not in _tool_names) return null   // unmetered tools always run
    if (_claim()) { COUNTERS.bump(_calls_counter_name(_counter, tool_call.name)); return null }
    COUNTERS.bump(_counter)
    warn once per counter: _exhaustion_warning(_counter, _limit, _tool_names)
    return ToolMessage(content=_BUDGET_MESSAGE, name=tool_call.name, tool_call_id=tool_call.id, status="error")
  }

  // src: tool_budget.py:133-136
  fn exhausted_tools():executor=code {
    with _lock { return if (_spent >= _limit) _tool_names else {} }
  }

  // src: tool_budget.py:138-142 — out-of-loop gate for non-langchain backends, same counters
  fn refusal_for(tool_name):executor=code {
    refusal = _gate({ name: tool_name, id: "out-of-loop", args: {} })
    return (refusal.content if refusal exists, else null)
  }

  // src: tool_budget.py:144-159 (async twin identical)
  fn wrap_tool_call(request, handler):executor=code {
    require budget remains for a metered tool => return the refusal without running the tool
    return _gate(request.tool_call) or handler(request)
  }

  // src: tool_budget.py:161-169
  fn _withdraw(request):executor=code {
    kept = [ t for each t in request.tools where t.name not in _tool_names ]
    messages = request.messages
    if (!_withdrawal_announced) { _withdrawal_announced = true; messages += [WithdrawnNotice(_tool_names)] }
    return request with tools = kept, messages
  }

  // src: tool_budget.py:171-189 (async twin identical)
  fn wrap_model_call(request, handler):executor=code {
    if (exhausted_tools() is non-empty) request = _withdraw(request)
    return handler(request)
  }
}
