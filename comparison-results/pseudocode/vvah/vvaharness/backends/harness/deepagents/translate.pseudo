// file: vvaharness/backends/harness/deepagents/translate.py
// Translate DeepAgents / LangGraph state and stream events into HarnessMessage types: final text,
// structured response (wins over an earlier refusal), truncation and refusal flags, token usage.

@executedBy(CODE) @role(backend)
class DeepagentsTranslate {

    String extractText(AIMessage message) {
        if (message.content instanceof String) return message.content;                                   // src: vvaharness/backends/harness/deepagents/translate.py:49
        return String.join("", message.content.filter(b -> b instanceof Map && "text".equals(b.get("type"))).map(b -> b.get("text"))); // src: vvaharness/backends/harness/deepagents/translate.py:51
    }

    List<ToolCall> toolCalls(AIMessage message) {
        return message.toolCalls;                                                                        // src: vvaharness/backends/harness/deepagents/translate.py:60
    }

    String lastAiText(List<Message> messages) {
        for (Message m : messages.reversed()) {                                                          // src: vvaharness/backends/harness/deepagents/translate.py:65
            if (m instanceof AIMessage) {
                String text = extractText(m).strip();                                                    // src: vvaharness/backends/harness/deepagents/translate.py:67
                if (!text.isEmpty()) return text;                                                        // src: vvaharness/backends/harness/deepagents/translate.py:69
            }
        }
        return null;
    }

    AIMessage lastAiMessage(List<Message> messages) {
        for (Message m : messages.reversed()) {                                                          // src: vvaharness/backends/harness/deepagents/translate.py:75
            if (m instanceof AIMessage) return m;
        }
        return null;
    }

    boolean replyTruncated(List<Message> messages) {
        AIMessage m = lastAiMessage(messages);                                                           // src: vvaharness/backends/harness/deepagents/translate.py:83
        return m != null && finishTruncated(replyFinish(m.responseMetadata));  // backends/llm/models    // src: vvaharness/backends/harness/deepagents/translate.py:84
    }

    // The first refused assistant turn wins (a refusal can cut a tool_use whose tool still runs).
    Pair<Boolean, String> replyRefusal(List<Message> messages) {
        for (Message m : messages) {                                                                     // src: vvaharness/backends/harness/deepagents/translate.py:91
            if (m instanceof AIMessage) {
                Pair<Boolean, String> r = aiMessageRefused(m);                    // backends/llm/models  // src: vvaharness/backends/harness/deepagents/translate.py:93
                if (r.first) return Pair.of(true, r.second);                                             // src: vvaharness/backends/harness/deepagents/translate.py:95
            }
        }
        return Pair.of(false, null);
    }

    OneShotResult translateFinalState(DeepAgentsGraphState state, boolean oneshot) {
        List<Message> messages = state.messages;                                                         // src: vvaharness/backends/harness/deepagents/translate.py:101
        SessionUsage usage = Usage.aggregateUsageMetadata(messages);   // state.usage is never populated here // src: vvaharness/backends/harness/deepagents/translate.py:103
        if (usage != null) TOKENS.add(usage, usage.turns);                                               // src: vvaharness/backends/harness/deepagents/translate.py:105
        boolean truncated = replyTruncated(messages);                                                    // src: vvaharness/backends/harness/deepagents/translate.py:106
        Object structured = state.structuredResponse;
        if (structured instanceof BaseModel) {                                                           // src: vvaharness/backends/harness/deepagents/translate.py:108
            // a valid structured answer wins over an earlier refused turn
            return new OneShotResult(false, "", structured.modelDumpJson(), structured, usage, null, truncated, false, null); // src: vvaharness/backends/harness/deepagents/translate.py:110
        }
        Pair<Boolean, String> refusal = replyRefusal(messages);                                          // src: vvaharness/backends/harness/deepagents/translate.py:116
        return new OneShotResult(false, "", lastAiText(messages), null, usage, null, truncated, refusal.first, refusal.second); // src: vvaharness/backends/harness/deepagents/translate.py:117
    }

    List<Message> messagesFromEvent(Map<String, DeepAgentsGraphState> payload) {
        List<Message> messages = new List();
        for (Object update : payload.values()) {                                                         // src: vvaharness/backends/harness/deepagents/translate.py:126
            if (!(update instanceof Map)) continue;                                                      // src: vvaharness/backends/harness/deepagents/translate.py:127
            if (update.get("messages") instanceof List) messages.addAll(update.get("messages"));        // src: vvaharness/backends/harness/deepagents/translate.py:130
        }
        return messages;
    }

    // One LangGraph stream event -> HarnessMessages; tool uses are deduped by call id; subagent names tracked per namespace.
    Iterator<HarnessMessage> translateStreamEvents(Object event, Set<String> seenToolCallIds, Map<List<String>, String> nsToAgent) {
        if (nsToAgent == null) nsToAgent = new Map();                                                    // src: vvaharness/backends/harness/deepagents/translate.py:142
        List<String> namespace = event instanceof StreamEvent ? event.namespace : List.of();             // src: vvaharness/backends/harness/deepagents/translate.py:143
        Map payload = event instanceof StreamEvent ? event.payload : event;
        List<String> namespaceTag = namespace.isEmpty() ? null : namespace;                              // src: vvaharness/backends/harness/deepagents/translate.py:144
        for (Message message : messagesFromEvent(payload)) {                                             // src: vvaharness/backends/harness/deepagents/translate.py:145
            if (message instanceof AIMessage) {
                String name = message.name;
                if (name != null) nsToAgent.put(namespace, name);                                        // src: vvaharness/backends/harness/deepagents/translate.py:149
                String agent = name != null ? name : nsToAgent.get(namespace);                           // src: vvaharness/backends/harness/deepagents/translate.py:150
                String text = extractText(message);
                if (!text.strip().isEmpty()) yield(new HarnessAssistantText("assistant_text", text, agent, namespaceTag)); // src: vvaharness/backends/harness/deepagents/translate.py:153
                for (ToolCall call : toolCalls(message)) {                                               // src: vvaharness/backends/harness/deepagents/translate.py:154
                    String toolCallId = call.getOrDefault("id", "");
                    if (toolCallId.isEmpty()) continue;                                                  // src: vvaharness/backends/harness/deepagents/translate.py:157
                    if (seenToolCallIds.contains(toolCallId)) continue;                                  // src: vvaharness/backends/harness/deepagents/translate.py:159
                    seenToolCallIds.add(toolCallId);
                    yield(new HarnessToolUse("tool_use", toolCallId, call.get("name"), call.get("args"), agent, namespaceTag)); // src: vvaharness/backends/harness/deepagents/translate.py:161
                }
            } else if (message instanceof ToolMessage) {
                yield(new HarnessToolResult("tool_result", "error".equals(message.status), message.content, nsToAgent.get(namespace), namespaceTag)); // src: vvaharness/backends/harness/deepagents/translate.py:169
            }
        }
        return null;
    }

    // Terminal HarnessResult from the final state. Usage ladder: state.usage, else stream usage (includes persona
    // subagent turns), else aggregate over the final messages.
    HarnessResult makeTerminalResult(DeepAgentsGraphState state, String sessionId, SessionUsage streamUsage) {
        List<Message> messages = state.messages;
        String finalText = lastAiText(messages);                                                         // src: vvaharness/backends/harness/deepagents/translate.py:185
        Object structured = state.structuredResponse;
        Pair<Boolean, String> refusal = Pair.of(false, null);
        if (structured instanceof BaseModel) {                                                           // src: vvaharness/backends/harness/deepagents/translate.py:188
            finalText = structured.modelDumpJson();                                                      // src: vvaharness/backends/harness/deepagents/translate.py:189
        } else {
            structured = null;
            refusal = replyRefusal(messages);                                                            // src: vvaharness/backends/harness/deepagents/translate.py:192
        }
        Object usage = state.usage instanceof Map ? state.usage : null;                                  // src: vvaharness/backends/harness/deepagents/translate.py:195
        if (usage == null) usage = streamUsage != null ? streamUsage : Usage.aggregateUsageMetadata(messages); // src: vvaharness/backends/harness/deepagents/translate.py:197
        if (usage != null) TOKENS.add(usage, usage.turns);                                               // src: vvaharness/backends/harness/deepagents/translate.py:199
        return new HarnessResult("result", "success", false, sessionId, finalText, structured, null, usage, null, state, replyTruncated(messages), refusal.first, refusal.second); // src: vvaharness/backends/harness/deepagents/translate.py:201
    }
}
