// src: vvaharness/remediation_agent/policy/context.py:41-47
PolicyContext { gate: RemediationGate; playbook: Playbook; frameworks: Set; enabled: Boolean = true }

// src: vvaharness/remediation_agent/policy/context.py:70-81
fn build_context(cfg, repo_root):executor=code {
  policy_file = _resolve_input(cfg, knob("step_remediate.policy_file", default=null))
  playbook_file = _resolve_input(cfg, knob("step_remediate.playbook_file", default=null))
  gate = policy_gate.gate.RemediationGate(policy_file)   // null -> bundled inputs/remediation_policy.yaml
  pb = playbook.Playbook(playbook_file)   // null -> bundled inputs/remediation_playbook.yaml
  try fw = frameworks.detect_frameworks(repo_root); catch => fw = {}
  return PolicyContext(gate, playbook=pb, frameworks=fw, enabled=policy_enabled(cfg))
  // the gate and playbook are loaded even when enforcement is off; they are then unused
}

// src: vvaharness/remediation_agent/policy/context.py:36-38
fn policy_enabled(cfg) = boolean(knob("step_remediate.enforce_policy", default=true))   // true when the key or the whole step_remediate block is absent; false only when set to a falsy value

// src: vvaharness/remediation_agent/policy/context.py:51-67
fn _resolve_input(cfg, raw?):executor=code {
  if (!raw) return null   // null -> bundled default; a missing bundled policy then fails closed and denies EVERY finding
  require !is_network_path(raw) => throw ValueError("refusing network/UNC remediation input path <raw> (reading it could leak credentials over SMB)")
  cfg_dir = cfg._data._config_dir
  resolved = if (cfg_dir) _resolve_against(cfg_dir, raw) else raw   // external: orchestrator/config_paths.py
  if (resolved && resolved does not exist) {
    warn "configured remediation input <raw> not found at <resolved> — falling back to bundled default"
    return null
  }
  return resolved
  // preserved: a misspelled override path silently (with a warning) falls back to the bundled file rather than failing
}
