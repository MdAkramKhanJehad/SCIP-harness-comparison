# vvaharness/validation/config/validate_role.py

Resolves the `models.validate` role from a harness profile and reroutes the legacy `via: openai` backend onto DeepAgents with the OpenAI provider.

Source: `vvaharness/validation/config/validate_role.py` (lines 1-63)
Executor: code
Called from: `vvaharness/validation/cli/_model.sudo`

// src: vvaharness/validation/config/validate_role.py:35-39
BackendRoute { via: String; provider: String | null }

// src: vvaharness/validation/config/validate_role.py:42-50
fn validate_model_spec(cfg):executor=code = cfg.models.validate.orchestrator, or null when any level is undefined

// src: vvaharness/validation/config/validate_role.py:31-32, 53-63
fn normalize_validate_backend(via, provider?):executor=code {
  if (via != "openai") return BackendRoute(via, provider)   // BACKEND_OPENAI
  warn once per process "  [validate] models.validate declared via: openai; routing to via: deepagents (provider: openai) since openai has no agentic Harness. The manifest records both as declared_via/via."
  return BackendRoute("deepagents", provider || "openai")   // BACKEND_DEEPAGENTS, PROVIDER_OPENAI
}
