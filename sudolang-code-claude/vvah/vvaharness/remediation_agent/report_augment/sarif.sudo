# vvaharness/remediation_agent/report_augment/sarif.py

Adds a `properties.remediation` block to every result of the SARIF report copy, matching each case to a result by fingerprint, then by location, then by title. Returns the ordinal-to-case map the Markdown augmenter reuses.

Source: `vvaharness/remediation_agent/report_augment/sarif.py` (lines 1-137)
Executor: code
Called from: `report_augment/__init__.sudo` _augment

// src: vvaharness/remediation_agent/report_augment/sarif.py:61-63
BLOCK_KEY = "remediation"   // under properties: SARIF 2.1.0 forbids extra result keys
ALIAS_BLOCK_KEY = "remediationAliases"   // keys Stage 9-folded twins by case id

// src: vvaharness/remediation_agent/report_augment/sarif.py:73-92
fn _match_sarif(results, record):executor=code {
  finding = record.case.finding; if (finding == null) return null
  case_id = record.case.case_id or finding.case_id or ""
  // 1. fingerprint wins
  if (case_id) for each r in results { if (typed_sarif.result_identifies(r, case_id)) return r }   // external: pipeline/stages/s9/typed_sarif.py
  // 2-3. location then title, excluding results that carry another case's fingerprint
  candidates = results where !case_id || r has no fingerprint || result_identifies(r, case_id)
  if (finding.file) { r = first candidate whose first location is exactly (finding.file, finding.line_start); if (r) return r }
  return if (trimmed finding.title) first candidate whose message text starts with the title else null
}

// src: vvaharness/remediation_agent/report_augment/sarif.py:95-137
fn _augment_sarif(path, records):executor=code {
  doc = JSON of path; results = doc.runs[0].results   // only the first run
  matched = {}; ordinal_matches = {}; collisions = {}
  for each record in records {
    match = _match_sarif(results, record); if (match == null) continue
    ordinal = 1-based position of match
    if (ordinal_matches[ordinal] exists for a different record) add ordinal to collisions else ordinal_matches[ordinal] = record
    if (!typed_sarif.record_result_block(match, case_id, dto._remediation_block(record), key=BLOCK_KEY, alias_key=ALIAS_BLOCK_KEY)) continue   // recorded under the alias key instead; counted as aliased
    add match to matched
  }
  remove every collided ordinal from ordinal_matches   // a result claimed by two records is unsafe for either
  // abstracted: sarif.py:128-130 — console count line
  for each r in results not in matched: r.properties.remediation = { remediationStatus: "skipped", remediationReason: "finding not processed for remediation" }
  write doc
  return ordinal_matches
  // preserved: a result whose block went only to the alias key is not in "matched", so it also receives the plain skipped block under properties.remediation
}
