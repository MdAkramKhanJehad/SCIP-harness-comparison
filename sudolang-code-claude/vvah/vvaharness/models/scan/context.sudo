# vvaharness/models/scan/context.py

`ContextPackage`: what Stage 1 emits and every later stage reads (files, entry points, sinks, modules, injected CVEs, controls, application profile, threat model, live graph handle), plus a capped "AST context" view used to keep prompts bounded.

Source: `vvaharness/models/scan/context.py` (lines 1-116)
Executor: code
Called from: `vvaharness/pipeline/stages/s1_preprocess.py` (producer); `vvaharness/orchestrator/scan.py` attaches app_profile, ev_collection, graph_handle and threat_model; Stages 2 to 8 read it

// src: vvaharness/models/scan/context.py:29-47
ContextPackage {
  repo_root: String
  language: String                  // primary language detected
  seed_taint_paths: String[][] = [] // Stage 0 semgrep codeFlows, source to sink; s3._reachable_files never drops these files
  entry_points: EntryPoint[] = []
  unsafe_sinks: Sink[] = []
  modules: ModuleInfo[] = []
  all_files: String[] = []          // injected: deterministic repository walk (relative paths)
  excluded: {} = {}                 // injected: { dirs: {path: n}, exts: {ext: n}, globs: {pattern: n}, oversize: n }
  known_cves: CVE[] = []            // injected
  design_controls: Control[] = []   // injected
  app_profile: AppProfile | null = null       // injected (configuration-management database)
  threat_model: ThreatModel | null = null     // Stage 2 output, attached after Stage 2
  notes: String = ""                // free-form model observations
  ev_collection: {} | null = null   // dumped exploit verification collection; null = exploit verification off
  graph_handle: GraphHandle | null = null     // live handle attached after Stage 1; excluded from serialization, so --resume rebuilds it
}

// src: vvaharness/models/scan/context.py:49-115
fn ContextPackage.ast_context_view(max_files=250, max_entry_points=120, max_sinks=160, max_modules=40, max_edges=120):executor=code {
  // preserved: max_edges is accepted but never used

  // src: context.py:52-72 — seed files, in priority order, normalized ("\" => "/", leading "./" stripped), deduplicated
  seed_files = files of first max_entry_points of entry_points
             + files of first max_sinks of unsafe_sinks
             + the file part (before the first ":") of every node of every seed_taint_paths entry
             + the first 5 files of each of first max_modules of modules

  // src: context.py:74-89 — seed files that exist in all_files come first, then the rest of all_files, up to max_files
  all_files_out = []
  for each path in seed_files { if (path in all_files && not already taken) append; if (length >= max_files) break }
  if (length < max_files) { for each path in all_files { if (not already taken) append; if (length >= max_files) break } }

  // src: context.py:91-107 — every list is filtered to the allowed files and capped
  allowed = set(all_files_out)
  entry_points_out = first max_entry_points of (entry_points where file in allowed)
  unsafe_sinks_out = first max_sinks of (unsafe_sinks where file in allowed)
  modules_out = for each module: kept = first 10 of (module.files where file in allowed); keep the module only if kept is non-empty; stop at max_modules modules
  trimmed_paths = for each seed taint path: kept = nodes whose file is allowed; keep first 8 of kept if non-empty

  return copy with { all_files: all_files_out, entry_points: entry_points_out, unsafe_sinks: unsafe_sinks_out, modules: modules_out, seed_taint_paths: trimmed_paths }
}
