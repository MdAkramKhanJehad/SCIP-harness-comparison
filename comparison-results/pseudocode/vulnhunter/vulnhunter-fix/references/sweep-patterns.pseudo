// file: vulnhunter-fix/references/sweep-patterns.md
// Rule book (REQ-SWP-002): CWE-class regex table for Sweep Pass 2 (pattern pass over files Pass 1 did not cover).
// Consumed by scripts/sweep-root-causes.py and prompts/sweep.md (Sweep phase); also cited by prompts/verify.md.

@executedBy(MODEL) @role(rule_set) @stage("fix.sweep")
class SweepPatterns {

    // Entry: apply the matching class row to every source file; hits are candidate siblings.
    List<Hit> run(RootCause root, List<File> files, boolean graphFallback, Theta θ) {
        List<Regex> patterns = patternsFor(classOf(root.cwe, θ), θ);
        List<Hit> hits = new List();
        if (θ["p.sweep-patterns.patterns_applied_to_every_source_file"]) {                              // src: vulnhunter-fix/references/sweep-patterns.md:18
            for (File f : files) for (Regex p : patterns) hits.addAll(f.grep(p));
        }
        for (Hit h : hits) h.confidence = θ["p.sweep-patterns.pass2_always_low_confidence"];             // src: vulnhunter-fix/references/sweep-patterns.md:91
        if (θ["p.sweep-patterns.pass2_regex_only_fp_reviewed"]) hits = reviewBeforeAmendment(hits);      // src: vulnhunter-fix/references/sweep-patterns.md:12
        annotate(hits, graphFallback, θ);
        return hits;
    }

    String classOf(String cwe, Theta θ) {
        if (cwe == θ["p.sweep-patterns.config_cwes_empty"]) return "config";                             // src: vulnhunter-fix/references/sweep-patterns.md:82
        int n = Cwe.number(cwe);
        if (θ["p.sweep-patterns.authz_cwes"].contains(n)) return "authz";                                 // src: vulnhunter-fix/references/sweep-patterns.md:25
        if (θ["p.sweep-patterns.injection_cwes"].contains(n)) return "injection";                         // src: vulnhunter-fix/references/sweep-patterns.md:43
        if (θ["p.sweep-patterns.crypto_cwes"].contains(n)) return "crypto";                               // src: vulnhunter-fix/references/sweep-patterns.md:57
        if (θ["p.sweep-patterns.resource_cwes"].contains(n)) return "resource";                           // src: vulnhunter-fix/references/sweep-patterns.md:71
        return null;
    }

    List<Regex> patternsFor(String cls, Theta θ) {
        if (cls == "authz") return authz(θ);
        if (cls == "injection") return injection(θ);
        if (cls == "crypto") return crypto(θ);
        if (cls == "resource") return resource(θ);
        if (cls == "config") return config(θ);
        return List.of();
    }

    List<Regex> authz(Theta θ) {
        List<Regex> p = new List();
        if (θ["p.sweep-patterns.authz_unguarded_flask_route"]) {                                         // src: vulnhunter-fix/references/sweep-patterns.md:28
            // @app.route(...) then decorator lines with no *_required guard, then def; no DOTALL
            p.add(Regex.literalFromSource("vulnhunter-fix/references/sweep-patterns.md:34"));               // src: vulnhunter-fix/references/sweep-patterns.md:34
            if (θ["p.sweep-patterns.authz_guard_above_route_not_seen"]) {                                 // src: vulnhunter-fix/references/sweep-patterns.md:32
                // accepted limitation: guards placed above @app.route are not inspected
            }
        }
        p.add(θ["p.sweep-patterns.authz_is_admin_fallback"]);                                             // src: vulnhunter-fix/references/sweep-patterns.md:35
        if (θ["p.sweep-patterns.authz_header_identity"]) {                                                // src: vulnhunter-fix/references/sweep-patterns.md:36
            p.add(Regex.literalFromSource("vulnhunter-fix/references/sweep-patterns.md:36"));               // request.headers.get('X-User-Id' without server verify
        }
        return p;
    }

    List<Regex> injection(Theta θ) {
        List<Regex> p = new List();
        if (θ["p.sweep-patterns.injection_sql_interpolation"]) p.add(Regex.literalFromSource("vulnhunter-fix/references/sweep-patterns.md:45")); // src: vulnhunter-fix/references/sweep-patterns.md:45
        p.add(θ["p.sweep-patterns.injection_os_system"]);                                                 // src: vulnhunter-fix/references/sweep-patterns.md:46
        p.add(θ["p.sweep-patterns.injection_shell_true"]);                                                // src: vulnhunter-fix/references/sweep-patterns.md:47
        p.add(θ["p.sweep-patterns.injection_pickle_loads"]);                                              // src: vulnhunter-fix/references/sweep-patterns.md:48
        p.add(θ["p.sweep-patterns.injection_inner_html"]);                                                // src: vulnhunter-fix/references/sweep-patterns.md:49
        p.add(θ["p.sweep-patterns.injection_xxe_entity"]);                                                // src: vulnhunter-fix/references/sweep-patterns.md:50
        return p;
    }

    List<Regex> crypto(Theta θ) {
        List<Regex> p = new List();
        p.add(θ["p.sweep-patterns.crypto_aes_modes"]);                                                    // src: vulnhunter-fix/references/sweep-patterns.md:59
        p.addAll(θ["p.sweep-patterns.crypto_weak_primitives"]);                                           // src: vulnhunter-fix/references/sweep-patterns.md:60
        p.add(θ["p.sweep-patterns.crypto_verify_false"]);                                                 // src: vulnhunter-fix/references/sweep-patterns.md:62
        p.add(θ["p.sweep-patterns.crypto_insecure_skip_verify"]);                                         // src: vulnhunter-fix/references/sweep-patterns.md:63
        return p;
    }

    List<Regex> resource(Theta θ) {
        List<Regex> p = new List();
        p.add(θ["p.sweep-patterns.resource_unbounded_loop_read"]);                                        // src: vulnhunter-fix/references/sweep-patterns.md:73
        List<String> names = θ["p.sweep-patterns.resource_sensitive_logging"];                            // src: vulnhunter-fix/references/sweep-patterns.md:74
        p.add(Regex.of("logger?\\.\\w+\\([^)]*(" + names.join("|") + ")"));                                 // src: vulnhunter-fix/references/sweep-patterns.md:74
        p.add(θ["p.sweep-patterns.resource_readlines"]);                                                  // src: vulnhunter-fix/references/sweep-patterns.md:75
        return p;
    }

    List<Regex> config(Theta θ) {
        List<Regex> p = new List();
        if (θ["p.sweep-patterns.config_iam_wildcard"]) p.add(Regex.literalFromSource("vulnhunter-fix/references/sweep-patterns.md:84")); // src: vulnhunter-fix/references/sweep-patterns.md:84
        p.add(θ["p.sweep-patterns.config_publicly_accessible"]);                                          // src: vulnhunter-fix/references/sweep-patterns.md:85
        p.add(Regex.of("\"cidr\":\\s*\"" + Regex.escape(θ["p.sweep-patterns.config_open_cidr"]) + "\"")); // src: vulnhunter-fix/references/sweep-patterns.md:86
        return p;
    }

    void annotate(List<Hit> hits, boolean graphFallback, Theta θ) {
        if (graphFallback) {
            for (Hit h : hits) h.captured = "Captured (regex-only)";                                      // REQ-SWP-007
        } else if (θ["p.sweep-patterns.mixed_run_no_annotation"]) {                                       // src: vulnhunter-fix/references/sweep-patterns.md:93
            for (Hit h : hits) h.captured = "Captured";
        }
    }
}
