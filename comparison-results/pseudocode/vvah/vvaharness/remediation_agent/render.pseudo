// file: vvaharness/remediation_agent/render.py
// Renders one typed Finding as the "### N. [SEV] title" markdown block embedded in the remediation prompt.
// Model/repo-supplied prose is heading-demoted and snippets get a safe fence so they cannot forge prompt structure.

@executedBy(CODE) @role(io) @stage("S10")
class RemediationAgentRender {

    String renderFindingMd(Finding finding, int index, Theta θ) {
        List<String> lines = new List();
        lines.add("### " + index + ". [" + finding.severity.value.upper() + "] " + ModelsMd.mdCell(finding.title)); // src: vvaharness/remediation_agent/render.py:34
        lines.addAll(metadataLines(finding));                                                       // src: vvaharness/remediation_agent/render.py:35
        lines.add("");
        lines.addAll(narrativeLines(finding, θ));                                                   // src: vvaharness/remediation_agent/render.py:38
        return lines.join("\n").rstrip() + "\n";                                                    // src: vvaharness/remediation_agent/render.py:39
    }

    Pair<String, String> cweLabel(Finding finding) {
        String cwe = Cwe.cweFor(finding.cwe, finding.vulnClass);                                    // src: vvaharness/remediation_agent/render.py:44
        if (cwe == null || cwe.isEmpty()) return new Pair("", "");                                  // src: vvaharness/remediation_agent/render.py:46
        String name = Cwe.cweName(cwe);                                                             // src: vvaharness/remediation_agent/render.py:47
        return new Pair(cwe, name != null ? cwe + ": " + name : cwe);                               // src: vvaharness/remediation_agent/render.py:48
    }

    String cvssText(Finding finding) {
        if (finding.cvssScore != null) return "**" + finding.cvssScore + "** (" + finding.cvssRating + ") - " + ModelsMd.vectorSpan(finding.cvssVector); // src: vvaharness/remediation_agent/render.py:53
        if (finding.cvssVector != null) return ModelsMd.vectorSpan(finding.cvssVector);               // src: vvaharness/remediation_agent/render.py:56
        return "_not computed_";                                                                    // src: vvaharness/remediation_agent/render.py:58
    }

    List<String> metadataLines(Finding finding) {
        Pair<String, String> cl = cweLabel(finding);                                                // src: vvaharness/remediation_agent/render.py:63
        List<String> lines = List.of("**Class:** " + (cl.second.isEmpty() ? finding.vulnClass.value : cl.second)); // src: vvaharness/remediation_agent/render.py:64
        if (!cl.first.isEmpty()) lines.add("**CWE:** " + cl.second + " - https://cwe.mitre.org/data/definitions/" + cl.first.split("-").last() + ".html"); // src: vvaharness/remediation_agent/render.py:65
        lines.add("**File:** " + finding.file + ":" + finding.lineStart + "-" + finding.lineEnd);   // src: vvaharness/remediation_agent/render.py:69
        lines.add("**CVSS 3.1:** " + cvssText(finding));                                            // src: vvaharness/remediation_agent/render.py:70
        // Taint refs are the S4 evidence gate; kept so the gate assessment can cite them.
        if (finding.sourceRef != null) lines.add("**Source:** " + finding.sourceRef);               // src: vvaharness/remediation_agent/render.py:72
        if (finding.sinkRef != null) lines.add("**Sink:** " + finding.sinkRef);                     // src: vvaharness/remediation_agent/render.py:74
        lines.addAll(duplicateLines(finding));                                                      // src: vvaharness/remediation_agent/render.py:76
        return lines;
    }

    List<String> duplicateLines(Finding finding) {
        if (finding.duplicates.isEmpty()) return List.of();                                         // src: vvaharness/remediation_agent/render.py:82
        String refs = finding.duplicates.map(d -> d.file + ":" + d.lineStart + ((d.lineEnd != null && d.lineEnd != d.lineStart) ? "-" + d.lineEnd : "")).join(", "); // src: vvaharness/remediation_agent/render.py:84
        return List.of("**Also at:** " + refs);                                                     // src: vvaharness/remediation_agent/render.py:89  (each site needs the same fix)
    }

    List<String> narrativeLines(Finding finding, Theta θ) {
        // Which finding sections reach the fix prompt; each is omitted when empty.
        List<String> sections = θ["code.remediation_agent.render.prompt_finding_sections"];         // src: vvaharness/remediation_agent/render.py:94
        List<String> lines = List.of("#### Description", ModelsMd.demoteMdHeadings(finding.description), ""); // src: vvaharness/remediation_agent/render.py:94
        if (sections.contains("impact") && finding.impact != null) lines.addAll(List.of("#### Impact", ModelsMd.demoteMdHeadings(finding.impact), "")); // src: vvaharness/remediation_agent/render.py:97
        if (sections.contains("exploit_scenario") && finding.exploitScenario != null) lines.addAll(List.of("#### Exploit scenario", ModelsMd.demoteMdHeadings(finding.exploitScenario), "")); // src: vvaharness/remediation_agent/render.py:97
        if (sections.contains("preconditions") && !finding.preconditions.isEmpty()) {               // src: vvaharness/remediation_agent/render.py:99
            lines.add("#### Preconditions");
            for (String p : finding.preconditions) lines.add("- " + ModelsMd.mdCell(p));              // src: vvaharness/remediation_agent/render.py:101
            lines.add("");
        }
        if (sections.contains("code_snippet") && finding.codeSnippet != null) {                     // src: vvaharness/remediation_agent/render.py:103
            // Repo bytes: a backtick line would close a bare fence and forge prompt structure.
            String fence = ModelsMd.snippetFence(finding.codeSnippet);                                // src: vvaharness/remediation_agent/render.py:105
            lines.addAll(List.of(fence, finding.codeSnippet, fence, ""));                           // src: vvaharness/remediation_agent/render.py:106
        }
        if (sections.contains("recommendation") && finding.recommendation != null) lines.addAll(List.of("#### How to fix", ModelsMd.demoteMdHeadings(finding.recommendation), "")); // src: vvaharness/remediation_agent/render.py:107
        if (sections.contains("verification")) lines.addAll(verificationLines(finding));            // src: vvaharness/remediation_agent/render.py:110
        if (sections.contains("exploitability")) lines.addAll(exploitabilityLines(finding));        // src: vvaharness/remediation_agent/render.py:111
        return lines;
    }

    List<String> exploitabilityLines(Finding finding) {
        if (finding.exploitabilityNotes == null) return List.of();                                  // src: vvaharness/remediation_agent/render.py:117
        // S8 chain-pass commentary, incl. mitigations that may make the fix unnecessary.
        return List.of("**Exploitability:** " + ModelsMd.demoteMdHeadings(finding.exploitabilityNotes), ""); // src: vvaharness/remediation_agent/render.py:119
    }

    List<String> verificationLines(Finding finding) {
        if (finding.verdict == null) return List.of();                                              // src: vvaharness/remediation_agent/render.py:127
        // The adversarial-verification block, so the agent sees why this survived triage.
        return List.of("#### Adversarial verification", "**Verdict:** " + finding.verdict + " (confidence: " + ScanRender.confidenceLabel(finding.verdictConfidence) + ") - " + ModelsMd.demoteMdHeadings(finding.verdictReason), ""); // src: vvaharness/remediation_agent/render.py:129
    }
}
