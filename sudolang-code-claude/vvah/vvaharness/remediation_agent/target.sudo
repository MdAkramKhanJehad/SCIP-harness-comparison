# vvaharness/remediation_agent/target.py

One finding queued for remediation: a thin wrapper around the typed scan `Finding` plus its position in this run and a `done` flag that the interactive picker flips.

Source: `vvaharness/remediation_agent/target.py` (lines 1-73)
Executor: code
Called from: `discovery.sudo`, `report_parser/parse.sudo`, `orchestrator/scan.py` `_run_remediation`; read throughout the package

// src: vvaharness/remediation_agent/target.py:27-66
RemediationTarget {
  finding: Finding   // vvaharness.models.Finding
  index: Number
  done: Boolean = false   // not frozen: the interactive picker sets it

  // src: target.py:35-38 — stable identity across attempts
  case_id = finding.case_id or _derive_case_id(finding)
  severity = upper case of finding.severity.value
  title = finding.title
  file = finding.file   // repository-relative path, no line suffix
  label = "[$severity] ${finding.title}" + (if (finding.file) " (${finding.file})" else "")

  // src: target.py:61-66 — artifact folder name, for example "01_stored-jql-injection"
  slug {
    base = lower-cased title with every run of characters outside [a-z0-9] replaced by "-", then trimmed of "-"
    base = first 60 characters of base, trailing "-" removed, or "finding" when empty
    return "${index as two digits}_$base"   // case_id is not used: it can contain path separators
  }
}

// src: vvaharness/remediation_agent/target.py:69-73
fn _derive_case_id(finding):executor=code {
  digest = first 6 hex characters of sha1("${finding.title}|${finding.file}|${finding.line_start}")
  return "$digest-${finding.vuln_class.value}-${finding.file or "unknown"}-${finding.line_start}"
}
