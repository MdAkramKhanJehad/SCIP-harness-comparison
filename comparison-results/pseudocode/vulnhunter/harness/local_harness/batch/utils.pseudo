// file: harness/local_harness/batch/utils.py
// Batch-scan utilities: REPO_LIST parsing, symlink-safe collection of each repo's own results dirs
// into a flat upload dir, and status reporting from each clone's JSONL scan log.

@executedBy(CODE) @role(io) @stage("benchmark")
class Utils {

    List<String> ignoreSymlinks(String dirpath, List<String> names) {
        // copytree ignore: keep only real regular files and directories (clones are untrusted)
        List<String> ignored = new List();
        for (String name : names) {                                                  // src: harness/local_harness/batch/utils.py:35
            String path = dirpath + "/" + name;
            Mode mode;
            try { mode = Fs.lstat(path).mode; } catch (OSError e) { ignored.add(name); continue; } // src: harness/local_harness/batch/utils.py:38
            if (LocalHarnessScan.isLink(path) || !(mode.isReg() || mode.isDir())) ignored.add(name); // src: harness/local_harness/batch/utils.py:42
        }
        return ignored;
    }

    boolean ownsResultsDir(String repoEntry, String rdir) {
        return rdir.startsWith(repoEntry + "_VULNHUNT_RESULTS_");                    // src: harness/local_harness/batch/utils.py:56
    }

    List<String> parseRepoList(String repoListFile) {
        if (repoListFile == null) repoListFile = "harness/local_harness/batch/REPO_LIST.txt"; // src: harness/local_harness/batch/utils.py:65
        List<String> urls = new List();
        for (String line : Fs.readLines(repoListFile)) {                             // src: harness/local_harness/batch/utils.py:69
            line = line.strip();
            if (!line.isEmpty() && !line.startsWith("#")) urls.add(line);            // src: harness/local_harness/batch/utils.py:71
        }
        return urls;
    }

    Map collectResults(String cloneBase, String uploadDir) {
        if (cloneBase == null) cloneBase = "repos_being_scanned";                    // src: harness/local_harness/batch/utils.py:82
        if (uploadDir == null) uploadDir = "to_upload";                              // src: harness/local_harness/batch/utils.py:84
        if (!Fs.isdir(cloneBase)) return Map.of("copied", List.of(), "missing", List.of()); // src: harness/local_harness/batch/utils.py:86
        Fs.makedirs(uploadDir);                                                      // src: harness/local_harness/batch/utils.py:90
        List<String> copied = new List();
        List<String> missing = new List();
        Map<String, String> producedBy = new Map();                                  // src: harness/local_harness/batch/utils.py:96
        for (String entry : Fs.listdir(cloneBase).sorted()) {                        // src: harness/local_harness/batch/utils.py:98
            String entryPath = cloneBase + "/" + entry;
            if (LocalHarnessScan.isLink(entryPath) || !Fs.isdir(entryPath)) continue; // src: harness/local_harness/batch/utils.py:103
            if (entry.contains("_VULNHUNT_RESULTS_")) continue;                      // src: harness/local_harness/batch/utils.py:105
            List<String> resultsDirs = new List();
            for (String d : Fs.listdir(entryPath).sorted()) {                        // src: harness/local_harness/batch/utils.py:115
                if (!LocalHarnessScan.isScanResultsDir(entryPath, d)) continue;      // src: harness/local_harness/batch/utils.py:116 (rejects symlinked / git-committed results)
                if (!ownsResultsDir(entry, d)) continue;                             // src: harness/local_harness/batch/utils.py:118 (warn: named for another repo)
                resultsDirs.add(d);
            }
            if (resultsDirs.isEmpty()) { missing.add(entry); continue; }             // src: harness/local_harness/batch/utils.py:123
            for (String rdir : resultsDirs) {                                        // src: harness/local_harness/batch/utils.py:127
                String dst = uploadDir + "/" + rdir;
                String key = Fs.normcase(rdir);                                      // src: harness/local_harness/batch/utils.py:130
                String owner = producedBy.get(key);
                if (owner != null && owner != entry) continue;                       // src: harness/local_harness/batch/utils.py:132 (never clobber another repo's upload)
                if (Fs.lexists(dst)) LocalHarnessScan.removeResultsEntry(dst);       // src: harness/local_harness/batch/utils.py:135
                Fs.copytree(entryPath + "/" + rdir, dst, this::ignoreSymlinks);      // src: harness/local_harness/batch/utils.py:137
                producedBy.put(key, entry);
                copied.add(rdir);                                                    // src: harness/local_harness/batch/utils.py:139
            }
        }
        // prints COLLECT RESULTS FOR UPLOAD summary
        return Map.of("copied", copied, "missing", missing);                         // src: harness/local_harness/batch/utils.py:161
    }

    Map scanStatus(String cloneBase, String logFilename) {
        if (cloneBase == null) cloneBase = "repos_being_scanned";                    // src: harness/local_harness/batch/utils.py:170
        if (logFilename == null) logFilename = "batch_scan.log";                     // src: harness/local_harness/batch/utils.py:172
        if (!Fs.isdir(cloneBase)) return Map.of();                                   // src: harness/local_harness/batch/utils.py:174
        List complete = new List(); List errored = new List(); List running = new List(); List notStarted = new List();
        for (String entry : Fs.listdir(cloneBase).sorted()) {                        // src: harness/local_harness/batch/utils.py:183
            String entryPath = cloneBase + "/" + entry;
            if (!Fs.isdir(entryPath)) continue;                                      // src: harness/local_harness/batch/utils.py:185
            if (entry.contains("_VULNHUNT_RESULTS_")) continue;                      // src: harness/local_harness/batch/utils.py:187
            String logPath = entryPath + "/" + logFilename;
            File f = LocalHarnessScan.openLogForRead(logPath);                       // src: harness/local_harness/batch/utils.py:193 (symlink / FIFO treated as absent)
            if (f == null) { notStarted.add(entry); continue; }                      // src: harness/local_harness/batch/utils.py:194
            List<String> lines = f.read().decode().splitlines();                     // src: harness/local_harness/batch/utils.py:199
            if (lines.isEmpty()) { notStarted.add(entry); continue; }                // src: harness/local_harness/batch/utils.py:201
            Map ev;
            try { ev = Json.parse(lines.last().strip()); } catch (JSONDecodeError e) { running.add(entry, "unparseable last line"); continue; } // src: harness/local_harness/batch/utils.py:207
            if (ev.type == "result") {                                               // src: harness/local_harness/batch/utils.py:212
                if (ev.is_error) errored.add(entry, "api_error_status=" + ev.getOrDefault("api_error_status", "unknown")); // src: harness/local_harness/batch/utils.py:213
                else complete.add(entry, ev.getOrDefault("duration_ms", 0) / 1000, LocalHarnessScan.extractCostFromLog(logPath)); // src: harness/local_harness/batch/utils.py:217
            } else {
                running.add(entry, ev.getOrDefault("subtype", ev.getOrDefault("type", "?"))); // src: harness/local_harness/batch/utils.py:221
            }
        }
        // prints BATCH SCAN STATUS summary; lists at most 10 not-started entries (display only)
        return Map.of("complete", complete, "errored", errored, "running", running, "not_started", notStarted); // src: harness/local_harness/batch/utils.py:264
    }
}
