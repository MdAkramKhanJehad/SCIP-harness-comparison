// src: vvaharness/pipeline/stages/s2/outcomes.py:31-41
fn _parse_threat_model(raw):executor=code {
  data = util.json_extract.extract_json(raw)
  require !(data is a non-empty dict && data has none of the ThreatModel field names) => throw ValueError("extracted JSON object has none of the threat-model fields ... likely a sub-object of a truncated or malformed response")
  return ThreatModel.model_validate(data)   // every field has a default, so a bare {} is accepted
}

// src: vvaharness/pipeline/stages/s2/outcomes.py:42-70
fn _finalize_threats(tm, ctx?):executor=code {
  for each [i, t] in tm.threats (from 1), t.id = "T$i"   // ids are reassigned by list position, whatever the model wrote
  if (ctx == null || !tm.threats) return
  valid = set(ctx.all_files)
  for each t in tm.threats {
    pairs = for each raw in t.surface_files: [raw, scope.resolve_inventory_path(ctx.repo_root, raw, valid)]
    t.surface_files = unique resolved paths that are in valid, first-seen order
    dropped += raw paths whose resolution is not in valid
  }
  if (!dropped) return
  COUNTERS.bump("s2_surface_files_dropped", length(dropped)); warn S2_SURFACE_FILES_DROPPED   // sample redacted, then cut to 300 characters
  if (length(dropped) == number of emitted paths) {
    errlog.log("s2", "threatmodel", "every surface_files path was rejected — no threat keeps a validated surface; s3 will mint no investigation unit")   // deliberately unmarked
  }
}

// src: vvaharness/pipeline/stages/s2/outcomes.py:74-91
fn _warn_output_caps(raw, tm, limits):executor=code {
  for each (kind, key, counter) in [("threats", "max_threats", null), ("assets", "max_assets", "s2_assets_truncated"), ("trust_boundaries", "max_trust_boundaries", "s2_trust_boundaries_truncated")] {
    if (kept count < raw count) { if (counter) COUNTERS.bump(counter, raw - kept); warn S2_CAP_TRUNCATED naming "step2.$key" }
  }
}
