// src: vvaharness/evidence/_grouping.py:25-36
fn _round_robin_select(groups, max_total, keys?):executor=code {
  ordered_keys = keys or, when absent, groups in insertion order
  selected = []
  for each round r (0, 1, 2, ...) {
    for each k in ordered_keys where groups[k] has an item at position r, selected += (k, that item)
    if (length(selected) >= max_total) stop
  }
  return first max_total of selected
}
