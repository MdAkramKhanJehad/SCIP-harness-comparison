    int RESUME_EXIT_GRACE_S = θ["code.backends.llm.cli.session.resume_exit_grace_s"];                       // src: vvaharness/backends/llm/cli/session.py:78
    // never-read dirs; a literal copy of tools._ALWAYS_EXCLUDED_DIRS, pinned by a test
    List<String> READ_DENY_DIRS = θ["code.backends.llm.cli.session.read_deny_dirs"];                        // src: vvaharness/backends/llm/cli/session.py:81
    // a .git/config write is RCE; the CLI rule matcher is case-sensitive, so every spelling of .git is listed:
    // (Edit, Write) x (./, **/) x ("", /**) for each case spelling
    List<String> GIT_WRITE_DENY_RULES = θ["code.backends.llm.cli.session.git_write_deny_rules"];            // src: vvaharness/backends/llm/cli/session.py:85
    // fallback wall clock only: hardcoding it once made step2.timeout never apply
    int AGENTIC_TIMEOUT = θ["code.backends.llm.cli.session.agentic_timeout_s"];                             // src: vvaharness/backends/llm/cli/session.py:93

    /** Ask the killed session for its final answer via `claude -p --resume <id> --tools ""`; None when not possible. */
    @src("vvaharness/backends/llm/cli/session.py:152")
    String finalizeViaResume(String sessionId, String model, Path cwd, int timeout, String tag, Map env, Schema jsonSchema, Prompt instruction, Map failDetail, Theta θ) {
        if (failDetail == null) failDetail = new Map();                                                     // src: vvaharness/backends/llm/cli/session.py:163
        if (instruction == null) instruction = CliFinalAnswerPrompt.finalAnswer(θ);                         // default for watchdog and wall-clock salvage; a stage-deadline resume passes its own // src: vvaharness/backends/llm/cli/session.py:156
        List<String> cmd = Discovery.CLAUDE_CMD + List.of("-p", "--resume", sessionId, "--model", model, "--tools", "", "--output-format", "json"); // src: vvaharness/backends/llm/cli/session.py:165
        // without --json-schema a resume answers in free text; --tools "" does not prevent it
        if (jsonSchema != null && Discovery.cliCapabilities().get("json_schema")) cmd.addAll(List.of("--json-schema", Json.dumps(jsonSchema))); // src: vvaharness/backends/llm/cli/session.py:168
        cmd.addAll(confinementArgv(null, null, null));                                                   // src: vvaharness/backends/llm/cli/session.py:170
        Result result;
        try {
            result = Process.run(cmd, instruction, cwd, timeout, env, null, 0, null, null);                 // src: vvaharness/backends/llm/cli/session.py:173
        } catch (Exception exc) {
            failDetail.put("cause", exc.typeName());                                                        // src: vvaharness/backends/llm/cli/session.py:175
            return null;                                                                                    // src: vvaharness/backends/llm/cli/session.py:176
        }
        if (result.returncode != 0) {
            Envelope.raiseIfRefusedExit(result.stdout, tag);                                                // a refused resume must raise, never degrade to "resume failed" and fall back to partial streamed text // src: vvaharness/backends/llm/cli/session.py:181
            failDetail.put("rc", result.returncode);                                                        // src: vvaharness/backends/llm/cli/session.py:182
            failDetail.put("stderr", result.stderr);                                                        // src: vvaharness/backends/llm/cli/session.py:183
            return null;                                                                                    // src: vvaharness/backends/llm/cli/session.py:184
        }
        EnvelopeResult text = Envelope.parse(result.stdout, false, tag);                                    // src: vvaharness/backends/llm/cli/session.py:185
        Envelope.noteUnparsedCacheKeys(text.usage);                                                         // src: vvaharness/backends/llm/cli/session.py:186
        TokenCounter.add(text.usage, text.usd, text.turns);                                                 // src: vvaharness/backends/llm/cli/session.py:187
        Envelope.raiseIfRefused(text.stopReason, tag, result.stdout);                                       // raise, never None: a refused salvage must not fall back to streamed partial text // src: vvaharness/backends/llm/cli/session.py:189
        return text.text != null && !text.text.isEmpty() ? text.text : null;                                // src: vvaharness/backends/llm/cli/session.py:190
    }

    /** Ask a wall-clock-killed session for its final answer; None when the resume failed too. */
    @src("vvaharness/backends/llm/cli/session.py:193")
    String recoverTimedOutSession(String sessionId, String model, Path cwd, int wallClock, String tag, Map env, Schema jsonSchema, Theta θ) {
        Console.write("turn deadline reached; asking the session for a final answer");                      // src: vvaharness/backends/llm/cli/session.py:199
        String finalText = finalizeViaResume(sessionId, model, cwd, Math.min(θ["code.backends.llm.cli.session.finalize_timeout_cap_s"], wallClock), tag, env, jsonSchema, null, null, θ); // src: vvaharness/backends/llm/cli/session.py:201
        if (finalText == null) return null;                                                                 // src: vvaharness/backends/llm/cli/session.py:204
        Counters.bump("cli_timeout_finalized", 1);                                                          // src: vvaharness/backends/llm/cli/session.py:206
        Errlog.log(tag != null ? tag : "cli", tag != null ? tag : "timeout", "VVAH-E008 warning: session exceeded the wall clock; final answer recovered by resuming the session", true, Map.of("error_code", CallTimeoutError.errorCode)); // src: vvaharness/backends/llm/cli/session.py:207
        return finalText;
    }

    /** Forget stageId's pinned cli attempt; a late `exited` set then finds no entry. */
    @src("vvaharness/backends/llm/cli/session.py:215")
    void releasePinnedSession(String stageId) {
        synchronized (PINNED_CLI_LOCK) {
            PINNED_CLI.remove(stageId);                                                                     // src: vvaharness/backends/llm/cli/session.py:218
        }
    }

    /** A short, redacted diagnostic suffix: the rc/stderr tail, or the exception type. */
    @src("vvaharness/backends/llm/cli/session.py:221")
    String resumeFailDetail(Map failDetail) {
        if (failDetail.containsKey("rc")) return " (rc=" + failDetail.get("rc") + ", stderr: " + Discovery.tail(Redact.redact(failDetail.get("stderr"), false, null), 0) + ")"; // src: vvaharness/backends/llm/cli/session.py:223
        if (failDetail.containsKey("cause")) return " (" + failDetail.get("cause") + ")";                   // src: vvaharness/backends/llm/cli/session.py:226
        return "";                                                                                          // src: vvaharness/backends/llm/cli/session.py:228
    }

    /** Continue sessionId's stopped cli attempt with the instruction; the stage's own resume. */
    @src("vvaharness/backends/llm/cli/session.py:231")
    String resumeAgentic(String sessionId, Prompt instruction, Double timeout, String tag, Theta θ) {
        CliPin pin;
        synchronized (PINNED_CLI_LOCK) {
            pin = PINNED_CLI.get(sessionId);                                                                // src: vvaharness/backends/llm/cli/session.py:235
        }
        if (pin == null) throw new SessionNotResumableError("cli session was never pinned or has been released"); // src: vvaharness/backends/llm/cli/session.py:237
        // free and memoised: check it before paying the exit-wait grace below
        if (!Discovery.cliCapabilities().getOrDefault("resume", false)) throw new SessionNotResumableError("this claude build does not support --resume"); // src: vvaharness/backends/llm/cli/session.py:240
        // the wait prevents a silent interleave of two processes writing one transcript
        if (!pin.exited.await(RESUME_EXIT_GRACE_S)) throw new SessionNotResumableError("has not exited yet; refusing to resume it"); // src: vvaharness/backends/llm/cli/session.py:244
        // 0 or None is "no clock"; unlike effort_scaled_seconds(0), the fallback is not an instant kill
        double raw = (timeout != null && timeout > 0) ? timeout : AGENTIC_TIMEOUT;                          // src: vvaharness/backends/llm/cli/session.py:248
        double budget = LlmModels.effortScaledSeconds(raw, pin.tier, ClockKind.SESSION);                    // src: vvaharness/backends/llm/cli/session.py:249
        String liveId = pin.cmd.get(pin.cmd.indexOf("--session-id") + 1);                                   // the id that actually ran, after any in-place rotation // src: vvaharness/backends/llm/cli/session.py:250
        Map failDetail = new Map();
        String finalText = finalizeViaResume(liveId, pin.model, pin.cwd, budget, tag, pin.env, pin.jsonSchema, instruction, failDetail, θ); // src: vvaharness/backends/llm/cli/session.py:252
        if (finalText == null) throw new SessionNotResumableError("cli session could not be resumed" + resumeFailDetail(failDetail)); // src: vvaharness/backends/llm/cli/session.py:255
        return finalText;
    }

    /** Strip `Name(spec)` scoping so a permission RULE can be reused as an availability name. */
    @src("vvaharness/backends/llm/cli/session.py:261")
    List<String> bareToolNames(List<String> allowedTools) {
        List<String> out = new List();
        for (String raw : allowedTools != null ? allowedTools : List.of()) {                                // src: vvaharness/backends/llm/cli/session.py:264
            String bare = raw.toString().split("(", 2)[0].strip();                                          // src: vvaharness/backends/llm/cli/session.py:265
            if (!bare.isEmpty() && !out.contains(bare)) out.add(bare);                                      // de-duplicated, order kept // src: vvaharness/backends/llm/cli/session.py:266
        }
        return out;
    }

    /** One probe-gated flag group: added when the build advertises the capability, else warn once and lose it. */
    @src("vvaharness/backends/llm/cli/session.py:278")
    void gate(Map caps, String cap, List<String> flags, String lost, List<String> argv) {
        if (caps.get(cap)) {
            argv.addAll(flags);                                                                             // src: vvaharness/backends/llm/cli/session.py:279
            return;
        }
        WarnOnce.warnOnce(WARNED_CAPS, cap, "this claude build does not advertise --" + cap.replace("_", "-") + "; " + lost); // src: vvaharness/backends/llm/cli/session.py:282
    }

    /** Flags that keep a `claude` loop from being steered by the repo it is scanning. */
    @src("vvaharness/backends/llm/cli/session.py:271")
    List<String> confinementArgv(List<String> allowedTools, List<String> disallowedTools, String permissionPrompts) {
        // probe-gated; --allowedTools alone left 28 tools incl Bash on 2.1.270 - --tools is the jail
        Map caps = Discovery.cliCapabilities();                                                             // src: vvaharness/backends/llm/cli/session.py:275
        List<String> argv = new List();
        List<String> nativeTools = bareToolNames(allowedTools);                                             // src: vvaharness/backends/llm/cli/session.py:286
        if (!nativeTools.isEmpty()) {
            gate(caps, "tools", List.of("--tools", String.join(",", nativeTools)), "tool availability is NOT restricted to the allowlist", argv); // src: vvaharness/backends/llm/cli/session.py:288
        } else if (allowedTools != null) {
            // an explicit empty allowlist means zero tools, not "no restriction requested"
            gate(caps, "tools", List.of("--tools", ""), "tool availability is NOT confined to zero tools", argv); // src: vvaharness/backends/llm/cli/session.py:294
        }
        // --restricted cannot exclude in-repo .git; Read() rules only, so Grep can still match there
        List<String> deny = new List();
        for (Object t : disallowedTools != null ? disallowedTools : List.of()) deny.add(t.toString());      // caller deny rules first // src: vvaharness/backends/llm/cli/session.py:299
        for (String d : READ_DENY_DIRS) deny.add("Read(./" + d + "/**)");                                   // src: vvaharness/backends/llm/cli/session.py:300
        deny.addAll(GIT_WRITE_DENY_RULES);                                                                  // src: vvaharness/backends/llm/cli/session.py:301
        if (!deny.isEmpty()) gate(caps, "disallowed_tools", Stream.concat(List.of("--disallowedTools"), deny), "cannot deny the listed rules explicitly", argv); // src: vvaharness/backends/llm/cli/session.py:303
        if (permissionPrompts != null && !permissionPrompts.isEmpty()) gate(caps, "permission_prompts", List.of("--permission-prompts", permissionPrompts), "an action that would raise a permission prompt is not auto-denied", argv); // src: vvaharness/backends/llm/cli/session.py:305
        if (θ["cli.restricted"]) gate(caps, "restricted", List.of("--restricted"), "the file tools are NOT confined to the working directory", argv); // cfg.get("restricted", True) // src: vvaharness/backends/llm/cli/session.py:308
        gate(caps, "setting_sources", List.of("--setting-sources", "user"), "the SCANNED repository's .claude/settings.json and .claude/commands are loaded", argv); // src: vvaharness/backends/llm/cli/session.py:313
        gate(caps, "strict_mcp_config", List.of("--strict-mcp-config"), "the SCANNED repository's .mcp.json servers can be started", argv); // src: vvaharness/backends/llm/cli/session.py:316
        gate(caps, "disable_slash_commands", List.of("--disable-slash-commands"), "skills and slash commands remain loaded as prompt-injection surface", argv); // src: vvaharness/backends/llm/cli/session.py:318
        return argv;
    }

    /** Agentic mode: Claude gets tools to explore the repo; one subprocess loop with timeout, watchdog, truncation and pending retries. */
