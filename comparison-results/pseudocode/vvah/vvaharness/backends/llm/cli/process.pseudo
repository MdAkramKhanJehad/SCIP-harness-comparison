// file: vvaharness/backends/llm/cli/process.py
// Running the `claude` subprocess, buffered (with heartbeat) or streaming (line callback + turn watchdog);
// registers the process for Ctrl-C, stops it gracefully on timeout, and renders --verbose traces.

@executedBy(CODE) @role(backend)
class Process {

    // ids of results the turn watchdog killed (CompletedProcess cannot be subclassed)
    Set<Integer> WATCHDOG_STOPPED = new Set();                                                              // src: vvaharness/backends/llm/cli/process.py:206
    // C0, DEL and C1 control chars: any can drive or forge the terminal
    Regex TERMINAL_CONTROL_RX = Regex.compile("[\\x00-\\x1f\\x7f-\\x9f]");                                  // src: vvaharness/backends/llm/cli/process.py:219

    /** Central subprocess runner with an optional periodic progress heartbeat. */
    @src("vvaharness/backends/llm/cli/process.py:37")
    Result run(List<String> cmd, String input, Path cwd, double timeout, Map env, String heartbeatLabel, int heartbeatInterval, Consumer streamCb, Predicate shouldStop) {
        // defaults: timeout 600 s, heartbeat every 300 s
        Map procEnv = System.environ() + Env.tlsExtra + env;                                                // src: vvaharness/backends/llm/cli/process.py:45
        if (streamCb != null || shouldStop != null) {                                                       // the watchdog needs the line reader // src: vvaharness/backends/llm/cli/process.py:47
            return runStreaming(cmd, input, cwd, timeout, procEnv, streamCb, shouldStop);                   // src: vvaharness/backends/llm/cli/process.py:49
        }
        double start = Clock.monotonic();
        double deadline = start + timeout;                                                                  // src: vvaharness/backends/llm/cli/process.py:55
        String pendingInput = input;
        Proc proc = Subprocess.popen(cmd, cwd, procEnv, Cancel.NEW_GROUP_KW);                               // src: vvaharness/backends/llm/cli/process.py:58
        Cancel.LIVE.add(proc);                                                                              // src: vvaharness/backends/llm/cli/process.py:71
        try {
            while (true) {                                                                                  // src: vvaharness/backends/llm/cli/process.py:73
                if (Cancel.aborted()) {                                                                     // src: vvaharness/backends/llm/cli/process.py:74
                    Cancel.killTree(proc);
                    proc.communicate();
                    throw new RuntimeError("aborted by user (Ctrl-C)");                                     // src: vvaharness/backends/llm/cli/process.py:77
                }
                double remaining = deadline - Clock.monotonic();                                            // src: vvaharness/backends/llm/cli/process.py:78
                if (remaining <= 0) {
                    Cancel.stopTree(proc, LlmModels.TIMEOUT_STOP_GRACE_SECONDS);                            // SIGINT first: session stays resumable // src: vvaharness/backends/llm/cli/process.py:80
                    proc.communicate();
                    throw new TimeoutExpired(cmd, timeout);                                                 // src: vvaharness/backends/llm/cli/process.py:82
                }
                try {
                    proc.communicate(pendingInput, min(heartbeatInterval, remaining));                      // src: vvaharness/backends/llm/cli/process.py:85
                    break;
                } catch (TimeoutExpired e) {
                    if (heartbeatLabel != null) Console.write(heartbeatLabel + " still running...");        // src: vvaharness/backends/llm/cli/process.py:91
                    pendingInput = null;                                                                    // src: vvaharness/backends/llm/cli/process.py:95
                }
            }
        } catch (KeyboardInterrupt e) {
            Cancel.ABORT.set();                                                                             // src: vvaharness/backends/llm/cli/process.py:97
            Cancel.killTree(proc);
            throw e;
        } finally {
            Cancel.LIVE.discard(proc);                                                                      // src: vvaharness/backends/llm/cli/process.py:106
        }
        return new Result(proc.args, proc.returncode, proc.out, proc.err);                                  // src: vvaharness/backends/llm/cli/process.py:108
    }

    /** Forward each stdout line live to streamCb while capturing full output; shouldStop kills per line. */
    @src("vvaharness/backends/llm/cli/process.py:111")
    Result runStreaming(List<String> cmd, String input, Path cwd, double timeout, Map procEnv, Consumer streamCb, Predicate shouldStop) {
        // drain BOTH pipes in threads, or the 64KB stderr buffer deadlocks
        List<String> chunks = new List();
        List<String> errChunks = new List();
        boolean stopped = false;
        Proc proc = Subprocess.popen(cmd, cwd, procEnv, Cancel.NEW_GROUP_KW);                               // line-buffered // src: vvaharness/backends/llm/cli/process.py:152
        Cancel.LIVE.add(proc);                                                                              // src: vvaharness/backends/llm/cli/process.py:166
        Thread reader = Thread.start(() -> readStdout(proc, chunks, streamCb, shouldStop));                 // src: vvaharness/backends/llm/cli/process.py:167
        Thread errThread = Thread.start(() -> errChunks.addAll(proc.stderr.lines()));                       // src: vvaharness/backends/llm/cli/process.py:168
        try {
            if (input != null) {
                try { proc.stdin.write(input); proc.stdin.close(); } catch (BrokenPipeError e) { }          // src: vvaharness/backends/llm/cli/process.py:175
            }
            try {
                proc.wait(timeout);                                                                         // src: vvaharness/backends/llm/cli/process.py:180
            } catch (TimeoutExpired e) {
                Cancel.stopTree(proc, LlmModels.TIMEOUT_STOP_GRACE_SECONDS);                                // src: vvaharness/backends/llm/cli/process.py:182
                reader.join(2);
                errThread.join(2);
                throw new TimeoutExpired(cmd, timeout, String.join("", chunks), String.join("", errChunks)); // partial stream kept for salvage // src: vvaharness/backends/llm/cli/process.py:185
            }
        } catch (KeyboardInterrupt e) {
            Cancel.ABORT.set();                                                                             // src: vvaharness/backends/llm/cli/process.py:189
            Cancel.killTree(proc);
            throw e;
        } finally {
            Cancel.LIVE.discard(proc);                                                                      // src: vvaharness/backends/llm/cli/process.py:194
        }
        reader.join(5);                                                                                     // src: vvaharness/backends/llm/cli/process.py:195
        errThread.join(5);
        Result result = new Result(cmd, proc.returncode, String.join("", chunks), String.join("", errChunks));
        if (proc.watchdogStopped) WATCHDOG_STOPPED.add(result.id());                                        // mark before any returncode check // src: vvaharness/backends/llm/cli/process.py:199
        return result;
    }

    /** The stdout reader thread: callback per line, then the stop predicate (first true kills the tree). */
    @src("vvaharness/backends/llm/cli/process.py:121")
    void readStdout(Proc proc, List<String> chunks, Consumer streamCb, Predicate shouldStop) {
        for (String line : proc.stdout.lines()) {                                                           // src: vvaharness/backends/llm/cli/process.py:122
            chunks.add(line);
            try { streamCb.accept(line); } catch (Exception e) { }                                          // src: vvaharness/backends/llm/cli/process.py:125
            if (shouldStop != null && !proc.watchdogStopped) {                                              // src: vvaharness/backends/llm/cli/process.py:128
                try {
                    if (shouldStop.test(line)) {                                                            // src: vvaharness/backends/llm/cli/process.py:130
                        proc.watchdogStopped = true;
                        Cancel.killTree(proc);                                                              // src: vvaharness/backends/llm/cli/process.py:132
                    }
                } catch (Exception e) { }
            }
        }
    }

    /** Whether the turn watchdog killed result's process, consuming the mark. */
    @src("vvaharness/backends/llm/cli/process.py:209")
    boolean wasStopped(Result result) {
        if (WATCHDOG_STOPPED.contains(result.id())) {                                                       // src: vvaharness/backends/llm/cli/process.py:212
            WATCHDOG_STOPPED.discard(result.id());
            return true;
        }
        return false;                                                                                       // src: vvaharness/backends/llm/cli/process.py:215
    }

    @src("vvaharness/backends/llm/cli/process.py:222")
    void tracePrint(String text, Stream out) {
        out.println(TERMINAL_CONTROL_RX.sub(" ", text));                                                    // src: vvaharness/backends/llm/cli/process.py:223
    }

    /** Render one stream-json event as a concise --verbose trace (tool calls, text, result). */
    @src("vvaharness/backends/llm/cli/process.py:226")
    void streamTrace(String line, Stream out) {
        line = line == null ? "" : line.strip();
        if (line.isEmpty()) return;                                                                         // src: vvaharness/backends/llm/cli/process.py:230
        Map evt;
        try { evt = Json.loads(line); } catch (JsonError e) { return; }                                     // src: vvaharness/backends/llm/cli/process.py:233
        if (evt.type == "assistant") {                                                                      // src: vvaharness/backends/llm/cli/process.py:237
            for (Map blk : evt.message.content) {
                if (blk.type == "text" && !blk.text.strip().isEmpty()) tracePrint("[agent] " + Redact.redact(blk.text.strip()).substring(0, 400), out); // src: vvaharness/backends/llm/cli/process.py:242
                else if (blk.type == "tool_use") tracePrint("[agent] tool " + blk.name + "(" + truncate(Redact.redact(blk.input.toString()), 160) + ")", out); // src: vvaharness/backends/llm/cli/process.py:250
            }
        } else if (evt.type == "user") {                                                                    // src: vvaharness/backends/llm/cli/process.py:251
            for (Map blk : evt.message.content) if (blk.type == "tool_result") tracePrint("[agent] tool result (" + blk.content.length() + " chars)", out); // src: vvaharness/backends/llm/cli/process.py:261
        } else if (evt.type == "result") {                                                                  // src: vvaharness/backends/llm/cli/process.py:262
            if (evt.isError) tracePrint("[agent] error " + Redact.redact(evt.result).substring(0, 200), out); // src: vvaharness/backends/llm/cli/process.py:264
        }
    }
}
