// file: harness/local_harness/config.py
// Shared constants for the local VulnHunter benchmark harness: paths, scan/judge worker counts, timeouts,
// model, 429 retry/backoff settings, and an atomic JSON writer.

@executedBy(CODE) @role(config)
class LocalHarnessConfig {

    String BENCHMARK_DIR() { return HARNESS_DIR + "/benchmark/ground_truth"; }               // src: harness/local_harness/config.py:10
    String CLONE_BASE_DIR() { return HARNESS_DIR + "/benchmark_repos"; }                       // src: harness/local_harness/config.py:11
    String RESULTS_DIR() { return HARNESS_DIR + "/benchmark_results"; }                        // src: harness/local_harness/config.py:12
    String HISTORY_FILE() { return HARNESS_DIR + "/finding_history.json"; }                    // src: harness/local_harness/config.py:44

    int MAX_SCAN_WORKERS(Theta θ) {
        return θ["harness.MAX_SCAN_WORKERS"];                                                  // src: harness/local_harness/config.py:17
    }

    int SCAN_TIMEOUT(Theta θ) {
        return θ["harness.SCAN_TIMEOUT"];                                                      // src: harness/local_harness/config.py:18
    }

    int JUDGE_TIMEOUT(Theta θ) {
        return θ["harness.JUDGE_TIMEOUT"];                                                     // src: harness/local_harness/config.py:19
    }

    int CLONE_TIMEOUT() { return 300; }  // literal, no knob                                   // src: harness/local_harness/config.py:20

    String MODEL(Theta θ) {
        return θ["harness.MODEL"];                                                             // src: harness/local_harness/config.py:21
    }

    // 429 retry: initial backoff 60 s, multiplier 2.0, max 300 s (literals, no knobs)
    int SCAN_MAX_RETRIES(Theta θ) {
        return θ["harness.SCAN_MAX_RETRIES"];                                                  // src: harness/local_harness/config.py:24
    }

    // 429 retry: initial backoff 30 s, multiplier 2.0, max 180 s (literals, no knobs)
    int JUDGE_MAX_RETRIES(Theta θ) {
        return θ["harness.JUDGE_MAX_RETRIES"];                                                 // src: harness/local_harness/config.py:29
    }

    String SKILLS_DIR() { return "~/.claude/skills/vulnhunt"; }                                // src: harness/local_harness/config.py:34
    String PHASES_DIR() { return SKILLS_DIR() + "/phases"; }                                   // src: harness/local_harness/config.py:35

    // Write to a temp file in the same dir, then os.replace, so readers never see a truncated file.
    void atomicWriteJson(String path, Object obj) {
        String dir = dirname(path);                                                            // src: harness/local_harness/config.py:53
        Fs.makedirs(dir);
        String tmp = Fs.mkstemp(dir, ".tmp-", ".json");                                        // src: harness/local_harness/config.py:55
        try {
            Json.dump(obj, tmp);
            Fs.replace(tmp, path);                                                             // src: harness/local_harness/config.py:59
        } catch (Throwable e) {
            Fs.removeQuietly(tmp);
            throw e;
        }
    }
}
