@executedBy(CODE) @role(stub)
@src("vvaharness/exploit_verification/options.py:1")
class EvGateStub {
    String resolutionError(Config cfg, Args args, Theta θ) { }
    boolean mayRun(Config cfg, Theta θ) { }
    boolean profileDisabled(Config cfg, Theta θ) { }
    boolean required(Config cfg, Theta θ) { }
    Options loadOptions(Config cfg, Object targetOrResumed, Object authStrategy, Theta θ) { }
    Options loadOptions(Config cfg, boolean resumed, Theta θ) { }
    GateResult runGate(Options opts, Theta θ) { }
    Collection runProbe(Collection col, Options opts, Theta θ) { }
}
