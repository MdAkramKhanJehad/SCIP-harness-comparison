# vvaharness/validation/ingest/workspace.py

Stages a by-value copy of the (already patched) repository into the workspace, excluding version control, build outputs, prior scan and remediation folders, MCP configuration and every agent instruction file, and skipping symlinks that dangle or escape the repository. Writes the remediation diff as `diff.patch` at the workspace root. Also provides the gate that refuses validation when no file the remediation claims to have touched exists.

Source: `vvaharness/validation/ingest/workspace.py` (lines 1-137)
Executor: code
Called from: `vvaharness/validation/cli/_run.sudo` (_validate_one, _run_plan), `vvaharness/validation/case_api.sudo` _judge

// src: vvaharness/validation/ingest/workspace.py:34-46
_IGNORE = [".git", "venv", ".venv", "checkpoints", "security-scan", "security-remediation", "__pycache__", "*.pyc", "node_modules",
           ".mcp.json", "CLAUDE.md", "CLAUDE.local.md", "AGENTS.md", "GEMINI.md", ".cursorrules"]
// preserved: a repository's own .claude/ folder is not in this list; for cli/sdk it is replaced by inject_claude_config, for deepagents it stays in the staged copy.

// src: vvaharness/validation/ingest/workspace.py:100-105
fn stage_workspace(repo, workspace, diff):executor=code {
  if (workspace exists) delete it
  copy repo to workspace by value (symlinks dereferenced), with ignore = _ignore_escaping_links(repo)
  write diff to "$workspace/diff.patch" (no newline translation)
  // the repository is the patched tree; the diff is the record of what the remediation changed
}

// src: vvaharness/validation/ingest/workspace.py:73-97
fn _ignore_escaping_links(repo):executor=code {
  root = resolved repo
  return (src_dir, names) => {
    skip = names matching _IGNORE
    for each remaining name that is a symlink {
      reason = _link_escape_reason(candidate, root)   // "dangling (missing target)" or "outside repository" or null
      if (reason) { console: "  [s11] staging: skipped link <rel> -> <reason>"; add name to skip }
    }
    return skip
  }
  // a link that resolves inside the repository is copied by value
}

// src: vvaharness/validation/ingest/workspace.py:134-137
fn assert_remediation_applied(repo, files_touched):executor=code {
  require any touched path resolves via _resolve_touched(repo, touched) => throw IngestError("no touched files found under <repo>: <files_touched>")
}

// src: vvaharness/validation/ingest/workspace.py:108-126
fn _resolve_touched(repo, touched):executor=code {
  if (touched is an absolute path) return null
  for each base in ["$repo/$touched", "$repo/app/$touched"] {
    candidate = resolved base if it stays inside the resolved repo, else null   // CWE-22 guard, fails closed
    if (candidate && candidate exists) return candidate
  }
  return null
}
// abstracted: workspace.py:49-70 (_link_rel, _link_escape_reason) only format the skip message and test the resolved target.
