        p.step(4, θ["p.implement.ambiguous_strategy_conservative"]);                                    // src: vulnhunter-fix/prompts/implement.md:271
        p.checklist(θ["p.implement.placeholder_scan"]);                                                 // src: vulnhunter-fix/prompts/implement.md:273
        p.must(θ["p.implement.placeholder_found_revert"]);                                              // src: vulnhunter-fix/prompts/implement.md:278
        p.rule(θ["p.implement.commit_even_if_test_fails"]);                                             // src: vulnhunter-fix/prompts/implement.md:408
        return p;
