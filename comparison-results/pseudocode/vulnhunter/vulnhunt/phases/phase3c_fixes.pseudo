// file: vulnhunt/phases/phase3c_fixes.md
// Phase 3c: for each finding with a passing exploit test, document a fix strategy for the report
// (no source edits). Includes the CWE-639 / platform-auth caller-scope fix guidance.

@executedBy(MODEL) @role(prompt) @stage("phase3c")
class Phase3cFixes {

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context("confirmed findings with passing exploit tests");                       // src: vulnhunt/phases/phase3c_fixes.md:3
        if (θ["prompt.fix_strategies_only"] == "describe, do not edit") p.forbid("Do NOT edit the source files - just describe the fix strategy"); // src: vulnhunt/phases/phase3c_fixes.md:8
        p.include(principles(θ));
        p.include(documentation(θ));
        return p;
    }

    Prompt principles(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase3c_fixes.principle_fix_at_right_layer"]) p.step(1, "Fix at the right layer: boundary validation, parameterized queries, safe APIs"); // src: vulnhunt/phases/phase3c_fixes.md:13
        if (θ["p.phase3c_fixes.principle_fix_root_cause"]) p.step(2, "Fix the root cause, not the instance"); // src: vulnhunt/phases/phase3c_fixes.md:15
        if (θ["p.phase3c_fixes.principle_defense_in_depth"]) p.step(3, "Defense in depth where severity warrants"); // src: vulnhunt/phases/phase3c_fixes.md:18
        if (θ["p.phase3c_fixes.principle_minimal_blast_radius"]) p.step(4, "Minimal blast radius while covering all instances"); // src: vulnhunt/phases/phase3c_fixes.md:19
        return p;
    }

    Prompt documentation(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.phase3c_fixes.fix_doc_strategy_length"]);                            // src: vulnhunt/phases/phase3c_fixes.md:25
        if (θ["p.phase3c_fixes.fix_doc_files_to_change"]) p.format("Files to change: file:line list"); // src: vulnhunt/phases/phase3c_fixes.md:26
        if (θ["p.phase3c_fixes.fix_doc_why_this_works"]) p.format("Why this works: why the fix eliminates the class"); // src: vulnhunt/phases/phase3c_fixes.md:27
        return p;
    }

    // ---------------------------------------------------------------- procedure

    @executedBy(MODEL)
    List<FixStrategy> run(List<Finding> passed, Theta θ) {
        List<FixStrategy> out = new List();
        for (Finding f : passed) {                                                         // src: vulnhunt/phases/phase3c_fixes.md:8
            FixStrategy s = new FixStrategy(f);
            if (f.isPlatformAuth() && θ["p.phase3c_fixes.platform_findings_use_cwe639_guidance"]) platformFix(f, s, θ); // src: vulnhunt/phases/phase3c_fixes.md:63
            else if (f.cwe == 639 && f.landedAtMediumOrOriginalUnderLadder()) cwe639Fix(f, s, θ); // src: vulnhunt/phases/phase3c_fixes.md:31
            else genericFix(f, s, θ);
            document(s, θ);
            out.add(s);
        }
        return out;                                                                        // no source edits: describe only
    }

    @executedBy(MODEL)
    void genericFix(Finding f, FixStrategy s, Theta θ) {
        Layer layer = f.sinkLayer();
        if (θ["p.phase3c_fixes.principle_fix_at_right_layer"]) layer = rightLayer(f);     // src: vulnhunt/phases/phase3c_fixes.md:13
        List<Location> targets = f.instances();
        if (θ["p.phase3c_fixes.principle_fix_root_cause"]) targets = List.of(f.rootCause()); // src: vulnhunt/phases/phase3c_fixes.md:15
        s.change(layer, targets);
        if (θ["p.phase3c_fixes.principle_defense_in_depth"] && f.severityWarrantsLayers()) s.addLayers(); // src: vulnhunt/phases/phase3c_fixes.md:18
        if (θ["p.phase3c_fixes.principle_minimal_blast_radius"]) s.minimizeWhileCoveringAll(f.instances()); // src: vulnhunt/phases/phase3c_fixes.md:19
    }

    // Class-specific guidance: CWE-639 / Authorization Delegation
    @executedBy(MODEL)
    void cwe639Fix(Finding f, FixStrategy s, Theta θ) {
        if (!θ["p.phase3c_fixes.cwe639_fix_minimal_caller_scope_check"]) { genericFix(f, s, θ); return; } // src: vulnhunt/phases/phase3c_fixes.md:32
        if (f.authGateBypassable() && θ["p.phase3c_fixes.cwe639_fix_bypassable_gate_prerequisite"]) s.prerequisite("make the auth gate unconditional first"); // src: vulnhunt/phases/phase3c_fixes.md:45
        boolean uidAvailable = f.requestHas(θ["p.phase3c_fixes.cwe639_fix_public_api_assert_uid_header"]); // src: vulnhunt/phases/phase3c_fixes.md:42
        if (f.isPubliclyAccessibleApi() || (uidAvailable && θ["p.phase3c_fixes.cwe639_fix_uid_priority_over_app_id"])) { // src: vulnhunt/phases/phase3c_fixes.md:44
            s.propose("assert " + θ["p.phase3c_fixes.cwe639_fix_public_api_assert_uid_header"] + " present; reject requests without it"); // src: vulnhunt/phases/phase3c_fixes.md:42
        } else if (f.isInternalServiceToService()) {                                      // src: vulnhunt/phases/phase3c_fixes.md:36
            if (!(θ["p.phase3c_fixes.cwe639_fix_allowlist_only_when_uid_absent"] && uidAvailable)) { // src: vulnhunt/phases/phase3c_fixes.md:39
                s.propose(θ["p.phase3c_fixes.cwe639_fix_internal_api_app_id_allowlist"]);  // src: vulnhunt/phases/phase3c_fixes.md:36
                if (θ["p.phase3c_fixes.cwe639_fix_reject_unknown_app_ids"]) s.propose("reject unknown app IDs"); // src: vulnhunt/phases/phase3c_fixes.md:38
            }
        }
        if (!f.hasPopOrMtls() && θ["p.phase3c_fixes.cwe639_fix_alternative_pop_validation"]) s.alternative("service-level PoP token validation with trusted-caller allow-list"); // src: vulnhunt/phases/phase3c_fixes.md:48
        for (String anti : θ["p.phase3c_fixes.cwe639_fix_forbidden_proposals"]) s.forbid(anti); // src: vulnhunt/phases/phase3c_fixes.md:54
        if (θ["p.phase3c_fixes.platform_investments_as_follow_on_only"]) s.whyThisWorks.addFollowOn("signed entitlements claim consumption; cryptographic caller-identity propagation"); // src: vulnhunt/phases/phase3c_fixes.md:60
    }

    @executedBy(MODEL)
    void platformFix(Finding f, FixStrategy s, Theta θ) {
        cwe639Fix(f, s, θ);                                                                // src: vulnhunt/phases/phase3c_fixes.md:63
        if (f.id == "VULN-PLATFORM-AUTHN") s.requireAll(θ["p.phase3c_fixes.platform_authn_fix_needs_both"]); // src: vulnhunt/phases/phase3c_fixes.md:64
        if (f.id == "VULN-PLATFORM-AUTHZ") s.requireAll(θ["p.phase3c_fixes.platform_authz_fix_needs_caller_scope_only"]); // src: vulnhunt/phases/phase3c_fixes.md:65
    }

    @executedBy(MODEL)
    void document(FixStrategy s, Theta θ) {
        s.strategy = summarize(s, θ["p.phase3c_fixes.fix_doc_strategy_length"]);          // src: vulnhunt/phases/phase3c_fixes.md:25
        if (θ["p.phase3c_fixes.fix_doc_files_to_change"]) s.filesToChange = s.fileLines(); // src: vulnhunt/phases/phase3c_fixes.md:26
        if (θ["p.phase3c_fixes.fix_doc_why_this_works"]) s.whyThisWorks.explainClassEliminated(); // src: vulnhunt/phases/phase3c_fixes.md:27
    }
}
