// src: vvaharness/validation/cli/_parser.py:27-28
_VALIDATABLE_HELP = sorted values of VALIDATABLE_STATES joined with " / "

// src: vvaharness/validation/cli/_parser.py:31-87
fn _build_parser():executor=code {
  // prog "vvaharness validate"; description "s11 — agentic validation agent (invoke as `validate` or `s11`)."
  Options {
    --repo: Path, required                // "Target repository root"
    --config: String = null               // "Config profile path (else default)"
    --finding (dest findings): repeatable // "Finding id to validate (repeatable)"
    --all: flag                           // "Validate ALL validatable findings ($_VALIDATABLE_HELP); bypasses the max_findings cap"
    --max-findings: Number = null         // "Cap to the top-N validatable findings ($_VALIDATABLE_HELP) by CVSS; overrides step_validate.max_findings"
    --workspace: Path = null              // "Workspace root for staged copies. Treated as ephemeral and removed on completion — pass a new or empty path (a non-empty directory is refused). Defaults to a fresh OS temp directory outside --repo; any path under --repo is refused, since Claude Code's ancestor-directory walk would load the target's own CLAUDE.md from there"
    --resume: flag                        // "Skip findings already validated in a prior run (cached verdict reprinted)"
    --scan-report (dest scan_report): Path = null   // "Combined report (.md) to enrich; else the newest in security-remediation/"
  }
}

// src: vvaharness/validation/cli/_parser.py:90-94
_TUNABLE_ATTRS = ["effort", "max_turns", "max_budget_usd", "max_findings", "timeout", "max_model_calls", "orchestrator_max_model_calls"]

// src: vvaharness/validation/cli/_parser.py:97-107
fn _tunable_overrides(cfg):executor=code {
  block = cfg.step_validate
  if (block == null) return ValidateOverrides {}
  return ValidateOverrides with each attribute in _TUNABLE_ATTRS whose knob("step_validate.<attr>", default=null) is not null
}
