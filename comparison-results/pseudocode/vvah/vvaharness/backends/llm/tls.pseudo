// file: vvaharness/backends/llm/tls.py
// Shared TLS-config coercion, Anthropic auth kwargs (static key vs OAuth token) and mTLS client-chain
// handling for the backend clients. Stdlib only; warnings carry no file contents.

@executedBy(CODE) @role(backend)
class Tls {

    Set<String> TRUE = Set.of("true", "1", "yes", "on");                                                    // src: vvaharness/backends/llm/tls.py:30
    Set<String> FALSE = Set.of("false", "0", "no", "off");                                                  // src: vvaharness/backends/llm/tls.py:31
    List<String> NO_PROXY_KEYS = List.of("NO_PROXY", "no_proxy");                                           // src: vvaharness/backends/llm/tls.py:32
    String OAUTH_TOKEN_PREFIX = θ["code.backends.llm.tls.oauth_token_prefix"];                               // src: vvaharness/backends/llm/tls.py:33
    String OAUTH_BETA_HEADER = θ["code.backends.llm.tls.oauth_beta_header"];                                 // src: vvaharness/backends/llm/tls.py:34

    /** Anthropic client auth kwargs for a static key or an OAuth token. */
    @src("vvaharness/backends/llm/tls.py:37")
    Map anthropicAuthKwargs(String token) {
        token = token == null ? "" : token.strip();                                                         // src: vvaharness/backends/llm/tls.py:39
        if (token.startsWith(OAUTH_TOKEN_PREFIX)) {                                                          // src: vvaharness/backends/llm/tls.py:40
            return Map.of("auth_token", token, "default_headers", Map.of("anthropic-beta", OAUTH_BETA_HEADER)); // src: vvaharness/backends/llm/tls.py:41
        }
        return token.isEmpty() ? Map.of() : Map.of("api_key", token);                                       // src: vvaharness/backends/llm/tls.py:45
    }

    @src("vvaharness/backends/llm/tls.py:48")
    boolean isAnthropicOauthToken(String token) {
        return token != null && token.strip().startsWith(OAUTH_TOKEN_PREFIX);                               // src: vvaharness/backends/llm/tls.py:50
    }

    /** String booleans become real bools; any other string is a CA bundle path. */
    @src("vvaharness/backends/llm/tls.py:53")
    Object coerceVerify(Object value) {
        // quoted YAML "false" is truthy: un-coerced it would leave verification ON
        if (value == null || value instanceof Boolean) return value;                                        // src: vvaharness/backends/llm/tls.py:56
        if (value instanceof String) {
            String low = value.strip().lower();                                                             // src: vvaharness/backends/llm/tls.py:59
            if (FALSE.contains(low)) return false;                                                          // src: vvaharness/backends/llm/tls.py:60
            if (TRUE.contains(low)) return true;                                                            // src: vvaharness/backends/llm/tls.py:62
        }
        return value;                                                                                       // src: vvaharness/backends/llm/tls.py:64
    }

    @src("vvaharness/backends/llm/tls.py:67")
    List<String> chainPaths(Object cert) {
        return (cert instanceof List) ? cert : List.of(cert);                                               // YAML gives a list, not a tuple // src: vvaharness/backends/llm/tls.py:70
    }

    /** The configured client chain, or null (warned) when a file is missing: mTLS is then disabled. */
    @src("vvaharness/backends/llm/tls.py:73")
    Object resolveClientChain(Object cert, String label, String noun) {
        // absent cert/key warns and disables mTLS; a malformed CA bundle fails closed elsewhere
        if (cert == null || cert.isEmpty()) return null;                                                    // src: vvaharness/backends/llm/tls.py:79
        List<String> paths = chainPaths(cert);
        String missing = paths.firstWhere(p -> p != null && !Files.exists(p));                              // src: vvaharness/backends/llm/tls.py:82
        if (missing != null) {
            Log.warning(Event.TLS_CLIENT_CHAIN_MISSING, label, noun, missing);                              // src: vvaharness/backends/llm/tls.py:84
            return null;                                                                                    // src: vvaharness/backends/llm/tls.py:85
        }
        return cert;                                                                                        // src: vvaharness/backends/llm/tls.py:86
    }

    /** Load the client chain onto an SSL context; warn and return false on failure. */
    @src("vvaharness/backends/llm/tls.py:89")
    boolean loadClientChain(SslContext context, Object cert, String label) {
        List<String> args = chainPaths(cert);                                                               // src: vvaharness/backends/llm/tls.py:94
        try {
            context.loadCertChain(args);                                                                    // src: vvaharness/backends/llm/tls.py:96
        } catch (Exception exc) {
            Log.warning(Event.TLS_CLIENT_CHAIN_UNLOADABLE, label, args.get(0));                             // src: vvaharness/backends/llm/tls.py:98
            return false;                                                                                   // src: vvaharness/backends/llm/tls.py:100
        }
        return true;                                                                                        // src: vvaharness/backends/llm/tls.py:101
    }

    @src("vvaharness/backends/llm/tls.py:104")
    void warnVerifyDisabled(String base, String label, String defaultEndpoint, String caHint) {
        Log.warning(Event.TLS_VERIFY_DISABLED, label, base != null ? base : defaultEndpoint, caHint);       // src: vvaharness/backends/llm/tls.py:109
    }

    @src("vvaharness/backends/llm/tls.py:113")
    void restoreEnvValue(String key, String value) {
        if (value == null) Env.environ.pop(key);                                                            // src: vvaharness/backends/llm/tls.py:115
        else Env.environ.put(key, value);                                                                   // src: vvaharness/backends/llm/tls.py:118
    }

    /** Set NO_PROXY/no_proxy only for httpx's one-time env read at client construction. */
    @src("vvaharness/backends/llm/tls.py:121")
    void scopedNoProxyEnv(String noProxy, Runnable body) {
        if (noProxy == null || noProxy.isEmpty()) {                                                         // src: vvaharness/backends/llm/tls.py:124
            body.run();
            return;
        }
        Map prior = NO_PROXY_KEYS.toMap(k -> System.getenv(k));                                             // src: vvaharness/backends/llm/tls.py:127
        try {
            for (String k : NO_PROXY_KEYS) System.setenv(k, noProxy);                                       // src: vvaharness/backends/llm/tls.py:129
            body.run();
        } finally {
            for (String k : prior.keys()) restoreEnvValue(k, prior.get(k));                                 // src: vvaharness/backends/llm/tls.py:132
        }
    }
}
