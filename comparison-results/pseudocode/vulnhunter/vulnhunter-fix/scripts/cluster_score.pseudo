// file: vulnhunter-fix/scripts/cluster_score.py
// Canonical cluster scorer for parse_issues Step 3: rejects generic cluster names, scores each cluster by
// weighted severity counts, sorts by score then member count, and marks the top cluster recommended.

@executedBy(CODE) @role(types)
record Cluster(String name, List<Map> members, Map<String, Integer> severityBreakdown) { }

@executedBy(CODE) @role(tool) @stage("fix")
class ClusterScore {

    // parse_issues calls this with the clusters.json path; returns the annotated payload
    Map run(String clustersPath, Theta θ) {
        Map payload = Json.parse(Files.read(clustersPath));                                               // src: vulnhunter-fix/scripts/cluster_score.py:161
        return annotateClustersJson(payload, θ);                                                          // src: vulnhunter-fix/scripts/cluster_score.py:166
    }

    boolean isGenericClusterName(String name, Theta θ) {
        return Regex.matchIgnoreCase(θ["code.fix.scripts.cluster_score.generic_name_regex"], name);       // src: vulnhunter-fix/scripts/cluster_score.py:52
    }

    int weightFor(String severity, Theta θ) {
        switch (severity.strip().lower()) {
            case "critical": return θ["p.parse_issues.weight_critical"];                                  // src: vulnhunter-fix/scripts/cluster_score.py:35
            case "high+": return θ["p.parse_issues.weight_critical"];                                     // src: vulnhunter-fix/scripts/cluster_score.py:36
            case "high": return θ["p.parse_issues.weight_high"];                                          // src: vulnhunter-fix/scripts/cluster_score.py:37
            case "medium": return θ["p.parse_issues.weight_medium"];                                      // src: vulnhunter-fix/scripts/cluster_score.py:38
            case "low": return 1;                                                                         // src: vulnhunter-fix/scripts/cluster_score.py:39
            default: return θ["p.parse_issues.weight_unknown"];                                           // src: vulnhunter-fix/scripts/cluster_score.py:70
        }
    }

    int scoreBreakdown(Map<String, Integer> breakdown, Theta θ) {
        int total = 0;
        for (Entry e : breakdown.entries()) total += weightFor(e.key, θ) * e.value;                      // src: vulnhunter-fix/scripts/cluster_score.py:77
        return total;
    }

    List<Cluster> sortClusters(List<Cluster> clusters, Theta θ) {
        // score desc, tiebreak member count desc
        if (θ["p.parse_issues.cluster_tiebreak_member_count"]) return clusters.sortedBy(c -> Pair.of(-scoreBreakdown(c.severityBreakdown, θ), -c.members.size())); // src: vulnhunter-fix/scripts/cluster_score.py:98
        return clusters.sortedBy(c -> -scoreBreakdown(c.severityBreakdown, θ));
    }

    Map annotateClustersJson(Map payload, Theta θ) {
        List<Map> raw = payload.getOr("clusters", List.of());                                             // src: vulnhunter-fix/scripts/cluster_score.py:120
        List<String> generic = raw.filter(c -> isGenericClusterName(c.getOr("name", ""), θ)).map(c -> c.name); // src: vulnhunter-fix/scripts/cluster_score.py:121
        if (!generic.isEmpty()) throw new ValueError("generic placeholder cluster names; re-invoke clustering"); // src: vulnhunter-fix/scripts/cluster_score.py:123
        List<Cluster> clusters = raw.map(c -> new Cluster(c.getOr("name", ""), c.getOr("members", List.of()), c.getOr("severity_breakdown", Map.of()))); // src: vulnhunter-fix/scripts/cluster_score.py:129
        // pair sorted clusters with their source dicts by identity (names are not unique)
        Map originalById = zipByIdentity(clusters, raw);                                                  // src: vulnhunter-fix/scripts/cluster_score.py:140
        List<Cluster> sorted = sortClusters(clusters, θ);                                                 // src: vulnhunter-fix/scripts/cluster_score.py:141
        List<Map> out = List.of();
        for (int i = 0; i < sorted.size(); i++) {
            Map annotated = Map.copyOf(originalById.get(sorted.get(i)));
            annotated.put("score", scoreBreakdown(sorted.get(i).severityBreakdown, θ));                   // src: vulnhunter-fix/scripts/cluster_score.py:146
            annotated.put("recommended", i == 0);                                                         // src: vulnhunter-fix/scripts/cluster_score.py:147
            out.add(annotated);
        }
        return payload.with("clusters", out);                                                             // src: vulnhunter-fix/scripts/cluster_score.py:149
    }

    int mainWithArgv(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/cluster_score.py:159
        Map payload;
        try {
            payload = Json.parse(Files.read(args.clustersPath));                                          // src: vulnhunter-fix/scripts/cluster_score.py:161
        } catch (OSError | JSONDecodeError e) {
            return 1;                                                                                     // src: vulnhunter-fix/scripts/cluster_score.py:164
        }
        Map annotated;
        try {
            annotated = annotateClustersJson(payload, θ);                                                 // src: vulnhunter-fix/scripts/cluster_score.py:166
        } catch (ValueError e) {
            return 1;                                                                                     // src: vulnhunter-fix/scripts/cluster_score.py:169
        }
        print(Json.dump(annotated));                                                                      // src: vulnhunter-fix/scripts/cluster_score.py:170
        return 0;
    }

    int main(List<String> argv, Theta θ) {
        return mainWithArgv(argv.subList(1), θ);                                                          // src: vulnhunter-fix/scripts/cluster_score.py:176
    }
}
