            double cvssScore = scores.get(i - 1); String msg = msgs.get(i - 1);                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:220
            String ruleId = !category.isEmpty() ? category : sev.lower();                       // src: vvaharness/pipeline/stages/s9/typed_sarif.py:222
            if (!ruleId.isEmpty() && !ruleIds.contains(ruleId)) ruleIds.add(ruleId);            // src: vvaharness/pipeline/stages/s9/typed_sarif.py:223
