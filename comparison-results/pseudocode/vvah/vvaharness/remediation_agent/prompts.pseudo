// file: vvaharness/remediation_agent/prompts.py
// S10 prompt text: single-agent SYSTEM (3 evidence gates, minimal-diff fix, structured verdict), the FIXER subagent prompt,
// the deepagents ORCHESTRATOR prompt (plan, dispatch fixer, collect), and the per-finding user prompt with policy/strategy blocks.

@executedBy(MODEL) @role(prompt) @stage("S10")
class RemediationAgentPrompts {

    // ---- SYSTEM (single-agent: via cli/sdk/openai, and deepagents report mode) ----
    Prompt buildSystem(Theta θ) {
        // The SYSTEM prompt text with the RemediationVerdict compact JSON schema embedded so every backend is told the exact output shape. Built once at import (the schema is static); the module constant SYSTEM holds the result.
        Prompt p = system(θ);                                                                       // src: vvaharness/remediation_agent/prompts.py:25
        p.context(ModelsVerdict.schemaJsonCompact());                                               // src: vvaharness/remediation_agent/prompts.py:66
        return p;                                                                                   // src: vvaharness/remediation_agent/prompts.py:79
    }

    Prompt system(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.remediation_prompts.persona"]);                                                      // src: vvaharness/remediation_agent/prompts.py:26
        p.threshold(θ["p.remediation_prompts.one_finding_per_run"]);                                        // src: vvaharness/remediation_agent/prompts.py:26
        p.context(θ["p.remediation_prompts.tools_scoped_to_repo"]);                                         // src: vvaharness/remediation_agent/prompts.py:27
        if (θ["p.remediation_prompts.confirm_before_fix"]) p.must("confirm the finding via evidence");      // src: vvaharness/remediation_agent/prompts.py:28
        if (θ["p.remediation_prompts.minimal_safe_change_root_cause"]) p.must("then apply the MINIMAL safe code change that removes the root cause"); // src: vvaharness/remediation_agent/prompts.py:29
        p.include(evidenceGates(θ));
        p.include(remediationRules(θ));
        p.include(structuredOutput(θ));
        return p;
    }

    Prompt evidenceGates(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.remediation_prompts.assess_all_three_gates"]);                                     // src: vvaharness/remediation_agent/prompts.py:31  (assess all three before fixing)
        if (θ["p.remediation_prompts.gate_a_source"]) p.step(1, "Gate A - Source: attacker/user-controlled input with file:line"); // src: vvaharness/remediation_agent/prompts.py:32
        if (θ["p.remediation_prompts.gate_b_sink"]) p.step(2, "Gate B - Sink: security-relevant sink reachable from the source"); // src: vvaharness/remediation_agent/prompts.py:33
        if (θ["p.remediation_prompts.gate_b_requires_file_line"]) p.evidence("sink with file:line");       // src: vvaharness/remediation_agent/prompts.py:34
        if (θ["p.remediation_prompts.gate_c_missing_control"]) p.step(3, "Gate C - Missing control: why existing validation/sanitization does not constrain the source, or that none exists"); // src: vvaharness/remediation_agent/prompts.py:35
        return p;
    }

    Prompt remediationRules(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.remediation_prompts.rules_authoritative"]) p.must("REMEDIATION RULES (authoritative)");    // src: vvaharness/remediation_agent/prompts.py:38
        if (θ["p.remediation_prompts.least_change"]) p.must("LEAST-CHANGE: minimal diff at the vulnerable site(s)"); // src: vvaharness/remediation_agent/prompts.py:39
        p.forbid(θ["p.remediation_prompts.no_refactor_rename_cleanup"]);                                    // src: vvaharness/remediation_agent/prompts.py:40
        if (θ["p.remediation_prompts.preserve_legitimate_behaviour"]) p.must("Preserve behaviour for legitimate inputs"); // src: vvaharness/remediation_agent/prompts.py:40
        if (θ["p.remediation_prompts.root_cause_not_symptom"]) p.must("ROOT CAUSE: fix the actual flaw, not a symptom"); // src: vvaharness/remediation_agent/prompts.py:41
        p.context(θ["p.remediation_prompts.root_cause_fix_idioms"]);                                        // src: vvaharness/remediation_agent/prompts.py:42
        p.must(θ["prompt.s10.playbook_rule"]);                                                              // src: vvaharness/remediation_agent/prompts.py:44  (when user prompt has "Required fix strategy", follow it exactly)
        if (θ["p.remediation_prompts.policy_do_not_edit_globs"]) p.forbid("when the user prompt includes a Remediation policy section, never edit files matching its do-not-edit globs"); // src: vvaharness/remediation_agent/prompts.py:46
        if (θ["p.remediation_prompts.instance_coverage"]) p.must("INSTANCE COVERAGE: fix every instance of the same root cause the finding references"); // src: vvaharness/remediation_agent/prompts.py:48
        p.rule(θ["p.remediation_prompts.note_sibling_instances"]);                                          // src: vvaharness/remediation_agent/prompts.py:49
        if (θ["p.remediation_prompts.no_new_vulnerabilities"]) p.forbid("introducing new issues");          // src: vvaharness/remediation_agent/prompts.py:50
        if (θ["p.remediation_prompts.framework_secure_idiom"]) p.rule("use the framework's standard secure idiom"); // src: vvaharness/remediation_agent/prompts.py:51
        if (θ["p.remediation_prompts.code_level_signals_only"]) p.forbid("relying on or recommending operational controls as the fix"); // src: vvaharness/remediation_agent/prompts.py:52
        p.forbid(θ["p.remediation_prompts.operational_controls_excluded"]);                                 // src: vvaharness/remediation_agent/prompts.py:53
        if (θ["p.remediation_prompts.never_echo_secrets"]) p.forbid("echo plaintext secrets/tokens/keys; refer by file:line or redact"); // src: vvaharness/remediation_agent/prompts.py:54
        p.format(θ["p.remediation_prompts.secret_redaction_format"]);                                       // src: vvaharness/remediation_agent/prompts.py:55
        p.threshold(θ["p.remediation_prompts.secret_redaction_max_chars"]);                                 // src: vvaharness/remediation_agent/prompts.py:55
        if (θ["p.remediation_prompts.hardcoded_secret_move_to_config"]) p.rule("hardcoded-secret findings: move the value to a config/env/secret-manager read"); // src: vvaharness/remediation_agent/prompts.py:56
        if (θ["p.remediation_prompts.note_rotation_required"]) p.must("note that rotation is required");    // src: vvaharness/remediation_agent/prompts.py:57
        p.threshold(θ["p.remediation_prompts.snippet_max_lines"]);                                          // src: vvaharness/remediation_agent/prompts.py:58
        if (θ["p.remediation_prompts.workflow_pin_no_invented_sha"]) p.forbid("invent a commit SHA or write a placeholder SHA"); // src: vvaharness/remediation_agent/prompts.py:59
        if (θ["p.remediation_prompts.workflow_pin_only_evidenced_commit"]) p.rule("pin a remote reusable workflow only to an exact commit already evidenced in the repository"); // src: vvaharness/remediation_agent/prompts.py:60
        p.tiebreak(θ["p.remediation_prompts.workflow_pin_no_sha_not_fixed"]);                               // src: vvaharness/remediation_agent/prompts.py:61  (no such SHA -> no edit, report Not Fixed)
        return p;
    }

    Prompt structuredOutput(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.remediation_prompts.output_single_json_object"]) p.format("ONLY a single JSON object, no prose, no markdown fences"); // src: vvaharness/remediation_agent/prompts.py:64
        if (θ["p.remediation_prompts.schema_embedded_in_prompt"]) p.context("RemediationVerdict JSON Schema (compact)"); // src: vvaharness/remediation_agent/prompts.py:66
        if (θ["p.remediation_prompts.all_fields_required"]) p.must("Every field is REQUIRED");              // src: vvaharness/remediation_agent/prompts.py:68
        p.format(θ["p.remediation_prompts.summary_sentence_range"]);                                        // src: vvaharness/remediation_agent/prompts.py:69
        if (θ["p.remediation_prompts.summary_never_blank"]) p.forbid("leave summary blank or omit it");     // src: vvaharness/remediation_agent/prompts.py:70
        if (θ["p.remediation_prompts.fix_mode_must_apply_edits"]) p.must("in fix mode actually apply the edits before responding; changes lists the diffs made"); // src: vvaharness/remediation_agent/prompts.py:72
        if (θ["p.remediation_prompts.report_only_no_edits"]) p.forbid("in report-only mode, edit files; changes lists the edits you WOULD make"); // src: vvaharness/remediation_agent/prompts.py:73
        return p;
    }

    // ---- FIXER subagent (deepagents fix mode only) ----
    Prompt fixerSystem(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.remediation_prompts.fixer_persona"]);                                                // src: vvaharness/remediation_agent/prompts.py:83
        if (θ["p.remediation_prompts.fixer_edit_prespecified"]) p.context("orchestrator has diagnosed the vulnerability and specified an exact edit"); // src: vvaharness/remediation_agent/prompts.py:84
        if (θ["p.remediation_prompts.fixer_read_first"]) p.step(1, "Read the target file with read_file to confirm the current state"); // src: vvaharness/remediation_agent/prompts.py:87
        if (θ["p.remediation_prompts.fixer_apply_exactly"]) p.step(2, "Apply the minimal edit with edit_file exactly as instructed"); // src: vvaharness/remediation_agent/prompts.py:88
        if (θ["p.remediation_prompts.fixer_return_structured_result"]) p.step(3, "Return a structured result describing whether the edit was applied"); // src: vvaharness/remediation_agent/prompts.py:89
        if (θ["p.remediation_prompts.fixer_minimal_diff"]) p.must("MINIMAL DIFF: change only what the orchestrator specified"); // src: vvaharness/remediation_agent/prompts.py:92
        p.choose(List.of(θ["p.remediation_prompts.fixer_already_applied"], θ["p.remediation_prompts.fixer_not_applied"], θ["p.remediation_prompts.fixer_tool_error_transient_only"], "applied")); // src: vvaharness/remediation_agent/prompts.py:93
        if (θ["p.remediation_prompts.fixer_retryable_flag"]) p.rule("retryable=true only when repeating the same operation could succeed without a new plan"); // src: vvaharness/remediation_agent/prompts.py:96
        if (θ["p.remediation_prompts.fixer_no_secrets_in_reply"]) p.forbid("echo raw credentials, tokens, or secrets"); // src: vvaharness/remediation_agent/prompts.py:98
        if (θ["p.remediation_prompts.fixer_no_invented_sha"]) p.forbid("invent a commit SHA or write a placeholder SHA"); // src: vvaharness/remediation_agent/prompts.py:99
        p.tiebreak(θ["p.remediation_prompts.fixer_no_sha_not_applied"]);                                    // src: vvaharness/remediation_agent/prompts.py:101
        if (θ["p.remediation_prompts.fixer_structured_response_format"]) p.format("FixerResult via configured response format"); // src: vvaharness/remediation_agent/prompts.py:102
        return p;
    }

    @executedBy(MODEL)
    FixerResult fixerProcedure(String description, Theta θ) {
        String current = Tools.readFile(target);                                                            // src: vvaharness/remediation_agent/prompts.py:87
        if (alreadyPatched(current)) return new FixerResult(θ["p.remediation_prompts.fixer_already_applied"]); // src: vvaharness/remediation_agent/prompts.py:93
        if (needsWorkflowPin && !shaEvidenced) return new FixerResult(θ["p.remediation_prompts.fixer_no_sha_not_applied"]); // src: vvaharness/remediation_agent/prompts.py:101
        try {
            Tools.editFile(target, oldCode, newCode);                                                       // src: vvaharness/remediation_agent/prompts.py:88
        } catch (ToolFailure e) {
            return new FixerResult(θ["p.remediation_prompts.fixer_tool_error_transient_only"], retryable);  // src: vvaharness/remediation_agent/prompts.py:96
        }
        if (noChange) return new FixerResult(θ["p.remediation_prompts.fixer_not_applied"]);                 // src: vvaharness/remediation_agent/prompts.py:95
        return new FixerResult("applied", filesChanged);                                                    // src: vvaharness/remediation_agent/prompts.py:89
    }

    // ---- ORCHESTRATOR (deepagents fix mode: read tools only, dispatches the fixer) ----
    Prompt buildOrchestratorSystem(Theta θ) {
        // The SYSTEM prompt for the DeepAgents orchestrator parent in multi-agent fix mode; the orchestrator plans from redacted context and dispatches via the task tool, it has only read tools. Built once at import into ORCHESTRATOR_SYSTEM; no schema embedded (the verdict goes through the configured structured response format).
        return orchestratorSystem(θ);                                                               // src: vvaharness/remediation_agent/prompts.py:109
    }

    Prompt orchestratorSystem(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.remediation_prompts.orch_persona"]);                                                 // src: vvaharness/remediation_agent/prompts.py:110
        if (θ["p.remediation_prompts.orch_fixer_applies_edits"]) p.context("a fixer subagent (with write tools) will apply edits you plan"); // src: vvaharness/remediation_agent/prompts.py:111
        p.threshold(θ["p.remediation_prompts.orch_gates_before_planning"]);                                 // src: vvaharness/remediation_agent/prompts.py:113
        p.step(1, "Gate A - Source with file:line");                                                        // src: vvaharness/remediation_agent/prompts.py:114
        p.step(2, θ["p.remediation_prompts.orch_gate_b_no_file_line"]);                                     // src: vvaharness/remediation_agent/prompts.py:115
        p.step(3, θ["p.remediation_prompts.orch_gate_c_validation_only"]);                                  // src: vvaharness/remediation_agent/prompts.py:116
        if (θ["p.remediation_prompts.orch_least_change"]) p.must("LEAST-CHANGE: minimal diff at the vulnerable site(s) only. No refactors"); // src: vvaharness/remediation_agent/prompts.py:120
        if (θ["p.remediation_prompts.orch_root_cause_idioms"]) p.must("ROOT CAUSE: parameterized query, output encoding, constant-time compare, TLS on, auth dependency, input allow-list"); // src: vvaharness/remediation_agent/prompts.py:121
        p.must(θ["prompt.s10.playbook_rule"]);                                                              // src: vvaharness/remediation_agent/prompts.py:123
        if (θ["p.remediation_prompts.orch_policy_never_instruct_fixer"]) p.forbid("instruct the fixer to edit files matching do-not-edit globs"); // src: vvaharness/remediation_agent/prompts.py:126
        if (θ["p.remediation_prompts.orch_instance_coverage"]) p.must("fix every instance of the same root cause; note sibling instances"); // src: vvaharness/remediation_agent/prompts.py:127
        if (θ["p.remediation_prompts.orch_no_new_vulns_idiom"]) p.rule("use the framework's standard secure idiom"); // src: vvaharness/remediation_agent/prompts.py:129
        if (θ["p.remediation_prompts.orch_redacted_values_expected"]) p.context("values may appear as [REDACTED_*] in your reads, this is expected"); // src: vvaharness/remediation_agent/prompts.py:130
        if (θ["p.remediation_prompts.orch_hardcoded_secret_instruction"]) p.rule("hardcoded secrets: instruct the fixer to use an env-var or secrets-manager read"); // src: vvaharness/remediation_agent/prompts.py:131
        p.threshold(θ["p.remediation_prompts.orch_snippet_max_lines"]);                                     // src: vvaharness/remediation_agent/prompts.py:133
        p.forbid(θ["p.remediation_prompts.orch_code_level_only"]);                                          // src: vvaharness/remediation_agent/prompts.py:134
        if (θ["p.remediation_prompts.orch_workflow_pin_all_zero_sha"]) p.forbid("invent a commit SHA or use a placeholder (including an all-zero SHA)"); // src: vvaharness/remediation_agent/prompts.py:135
        p.tiebreak(θ["p.remediation_prompts.orch_workflow_pin_no_dispatch"]);                               // src: vvaharness/remediation_agent/prompts.py:137
        p.checklist(θ["p.remediation_prompts.orch_procedure_order"]);                                       // src: vvaharness/remediation_agent/prompts.py:139
        if (θ["p.remediation_prompts.orch_step1_read_and_understand"]) p.step(1, "locate and understand the vulnerable code with read tools"); // src: vvaharness/remediation_agent/prompts.py:140
        p.step(2, θ["p.remediation_prompts.orch_step2_plan_contents"]);                                     // src: vvaharness/remediation_agent/prompts.py:141
        p.step(3, θ["p.remediation_prompts.orch_dispatch_subagent_type"]);                                  // src: vvaharness/remediation_agent/prompts.py:143
        p.format(θ["p.remediation_prompts.orch_dispatch_template_sections"]);                               // src: vvaharness/remediation_agent/prompts.py:144
        if (θ["p.remediation_prompts.orch_template_context_content"]) p.format("VULNERABILITY CONTEXT: why the reachable source-to-sink flow is vulnerable"); // src: vvaharness/remediation_agent/prompts.py:145
        if (θ["p.remediation_prompts.orch_template_target_files"]) p.format("TARGET FILES: repo-relative paths incl. the primary file"); // src: vvaharness/remediation_agent/prompts.py:147
        if (θ["p.remediation_prompts.orch_template_edit_instructions"]) p.format("EDIT INSTRUCTIONS: precise old code or locator and exact replacement"); // src: vvaharness/remediation_agent/prompts.py:149
        if (θ["p.remediation_prompts.orch_template_success_criteria"]) p.format("SUCCESS CRITERIA: observable conditions proving the vulnerability is removed"); // src: vvaharness/remediation_agent/prompts.py:151
        p.threshold(θ["p.remediation_prompts.orch_all_sections_mandatory"]);                                // src: vvaharness/remediation_agent/prompts.py:152
        if (θ["p.remediation_prompts.orch_fixer_has_no_conversation"]) p.context("the fixer has no access to this conversation; description is its task"); // src: vvaharness/remediation_agent/prompts.py:153
        p.threshold(θ["p.remediation_prompts.orch_retry_once_on_retryable_tool_error"]);                    // src: vvaharness/remediation_agent/prompts.py:154
        if (θ["p.remediation_prompts.orch_never_retry_not_or_already_applied"]) p.forbid("retry not_applied or already_applied"); // src: vvaharness/remediation_agent/prompts.py:155
        if (θ["p.remediation_prompts.orch_no_second_fixer_after_applied"]) p.forbid("dispatch a second fixer after applied"); // src: vvaharness/remediation_agent/prompts.py:156
        if (θ["p.remediation_prompts.orch_changes_from_fixer_report"]) p.step(5, "use the fixer's report to populate changes"); // src: vvaharness/remediation_agent/prompts.py:157
        if (θ["p.remediation_prompts.orch_fixed_claim_requires_applied"]) p.evidence("Fixed/Partially Fixed only after status applied with non-empty files_changed"); // src: vvaharness/remediation_agent/prompts.py:158
        p.tiebreak(θ["p.remediation_prompts.orch_otherwise_not_fixed"]);                                    // src: vvaharness/remediation_agent/prompts.py:159
        if (θ["p.remediation_prompts.orch_no_edit_tools"]) p.context("You have NO edit tools; only the fixer subagent can write files"); // src: vvaharness/remediation_agent/prompts.py:160
        if (θ["p.remediation_prompts.orch_structured_response"]) p.format("verdict through the configured structured response format"); // src: vvaharness/remediation_agent/prompts.py:163
        p.format(θ["p.remediation_prompts.orch_summary_sentence_range"]);                                   // src: vvaharness/remediation_agent/prompts.py:164
        if (θ["p.remediation_prompts.orch_changes_reflect_applied"]) p.must("changes must reflect what the fixer actually applied"); // src: vvaharness/remediation_agent/prompts.py:165
        return p;
    }

    @executedBy(MODEL)
    Verdict orchestratorProcedure(String finding, Theta θ) {
        Location src = locate(finding);                                                                     // src: vvaharness/remediation_agent/prompts.py:140
        boolean gatesOk = gateA(src) && gateB(src) && gateC(src);                                           // src: vvaharness/remediation_agent/prompts.py:113
        if (needsWorkflowPin && !shaEvidenced) return new Verdict(θ["p.remediation_prompts.orch_workflow_pin_no_dispatch"]); // src: vvaharness/remediation_agent/prompts.py:137
        EditPlan plan = planEdit(src, θ["p.remediation_prompts.orch_step2_plan_contents"]);                 // src: vvaharness/remediation_agent/prompts.py:141
        String description = render(plan, θ["p.remediation_prompts.orch_dispatch_template_sections"]);      // src: vvaharness/remediation_agent/prompts.py:144
        FixerResult r = Runtime.subagent(fixerSystem(θ), description);                                      // src: vvaharness/remediation_agent/prompts.py:143  (subagent_type=fixer)
        int retries = 0;
        while (r.status == "tool_error" && r.retryable && retries < θ["p.remediation_prompts.orch_retry_once_on_retryable_tool_error"]) { // src: vvaharness/remediation_agent/prompts.py:154
            r = Runtime.subagent(fixerSystem(θ), description);
            retries = retries + 1;
        }
        if (r.status == "applied" && !r.filesChanged.isEmpty()) return new Verdict("Fixed", r.changes);     // src: vvaharness/remediation_agent/prompts.py:158
        return new Verdict(θ["p.remediation_prompts.orch_otherwise_not_fixed"]);                            // src: vvaharness/remediation_agent/prompts.py:159
    }

    // ---- per-finding user prompt (CODE renders it) ----
    @executedBy(CODE)
    Prompt policyBlock(List<String> denyPaths, List<String> forbidPaths, Theta θ) {
        Prompt p = new Prompt();
        if (denyPaths.isEmpty() && forbidPaths.isEmpty()) return p;                                         // src: vvaharness/remediation_agent/prompts.py:174
        if (θ["p.remediation_prompts.policy_block_header"]) p.must("## Remediation policy (authoritative)"); // src: vvaharness/remediation_agent/prompts.py:176
        List<String> paths = sorted(denyPaths.plus(forbidPaths));                                           // src: vvaharness/remediation_agent/prompts.py:177
        List<String> shown = paths.take(θ["p.remediation_prompts.policy_glob_display_cap"]);                // src: vvaharness/remediation_agent/prompts.py:179  (more -> ellipsis)
        p.forbid(shown);                                                                                    // src: vvaharness/remediation_agent/prompts.py:181
        if (θ["p.remediation_prompts.policy_glob_reason"]) p.context("sensitive subsystems / build & CI infrastructure"); // src: vvaharness/remediation_agent/prompts.py:181
        if (θ["p.remediation_prompts.policy_auto_revert_notice"]) p.context("Any such edit is automatically reverted on disk after you finish"); // src: vvaharness/remediation_agent/prompts.py:182
        return p;
    }

    @executedBy(CODE)
    Prompt buildUser(RemediationTarget target, String repo, String mode, Prompt strategyBlock, List<String> denyPaths, List<String> forbidPaths, Theta θ) {
        String action = mode.equals("fix") ? θ["p.remediation_prompts.user_action_fix"] : θ["p.remediation_prompts.user_action_report_only"]; // src: vvaharness/remediation_agent/prompts.py:193
        Prompt p = new Prompt();
        if (θ["p.remediation_prompts.user_repo_root_line"]) p.context("REPOSITORY ROOT: " + repo);          // src: vvaharness/remediation_agent/prompts.py:197
        p.context(θ["p.remediation_prompts.user_mode_line"]);                                               // src: vvaharness/remediation_agent/prompts.py:198
        p.context("FINDING INDEX: " + target.index);                                                        // src: vvaharness/remediation_agent/prompts.py:199
        p.context("PRIMARY FILE: " + (target.file != null ? target.file : θ["p.remediation_prompts.user_primary_file"])); // src: vvaharness/remediation_agent/prompts.py:200
        if (θ["p.remediation_prompts.user_finding_delimiters"]) p.context("=== SAST FINDING === " + RemediationAgentRender.renderFindingMd(target.finding, target.index) + " === END FINDING ==="); // src: vvaharness/remediation_agent/prompts.py:202
        if (θ["p.remediation_prompts.user_strategy_block"] && strategyBlock != null) p.include(strategyBlock); // src: vvaharness/remediation_agent/prompts.py:195
        p.include(policyBlock(denyPaths, forbidPaths, θ));                                                  // src: vvaharness/remediation_agent/prompts.py:196
        if (θ["p.remediation_prompts.user_closing_gate_instruction"]) p.step(1, "Locate the code referenced above, assess Evidence Gates A/B/C, and " + action); // src: vvaharness/remediation_agent/prompts.py:206
        if (θ["p.remediation_prompts.user_set_finding_index"]) p.format("Set finding_index to " + target.index + ". Return the required structured verdict."); // src: vvaharness/remediation_agent/prompts.py:207
        return p;
    }

    @executedBy(CODE)
    Prompt buildUserFromPolicy(RemediationTarget target, String repo, String mode, PreResult pre, PolicyContext ctx, Theta θ) {
        // Strategy + do-not-edit globs are injected only on the policy ALLOW path.
        if (pre != null && ctx != null && pre.strategy != null) {                                           // src: vvaharness/remediation_agent/plugin_runner/helpers.py:39
            return buildUser(target, repo, mode, PlaybookStrategyBlock.asPromptBlock(pre.strategy), ctx.gate.denyPaths, ctx.gate.forbidPatchPaths, θ); // src: vvaharness/remediation_agent/plugin_runner/helpers.py:40
        }
        return buildUser(target, repo, mode, null, List.of(), List.of(), θ);                               // src: vvaharness/remediation_agent/plugin_runner/helpers.py:45
    }
}
