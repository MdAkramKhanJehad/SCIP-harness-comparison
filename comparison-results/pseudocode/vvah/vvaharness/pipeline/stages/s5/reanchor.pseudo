// file: vvaharness/pipeline/stages/s5/reanchor.py
// Deterministic sink-line re-anchor: a Python finding anchored on a function/class header is moved
// to the nearest in-scope sink call (own same-file sink_ref, else detect/ sink patterns for its CWE).

@executedBy(CODE) @role(step) @stage("S5")
class S5Reanchor {

    Map<String, List<Regex>> sinkPatternsByCwe() {
        Map byCwe = new Map();
        for (PatternSpec spec : Patterns.defaultCorpus()) {                                     // src: vvaharness/pipeline/stages/s5/reanchor.py:32
            if (spec.role != "sink") continue;                                                  // src: vvaharness/pipeline/stages/s5/reanchor.py:33
            String cwe = RulesCwe.weaknessKey(spec.cwe);
            if (cwe != null) byCwe.append(cwe, Regex.compile(spec.pattern));                    // src: vvaharness/pipeline/stages/s5/reanchor.py:37
        }
        return byCwe;
    }

    Integer ownSinkLine(Reanchorer r, Finding f) {
        // A same-file sink_ref is a CANDIDATE, never a veto.
        Pair pl = f.sinkRef.rpartition(":");
        if (pl.path != f.file || !pl.line.isDigit()) return null;                               // src: vvaharness/pipeline/stages/s5/reanchor.py:164
        List<String> lines = r.cache.lines(f.file);
        if (lines == null || !(1 <= pl.line && pl.line <= lines.size())) return null;           // src: vvaharness/pipeline/stages/s5/reanchor.py:168
        return pl.line;
    }

    Finding apply(Reanchorer r, Finding f) {
        Integer ownSink = ownSinkLine(r, f);                                                    // src: vvaharness/pipeline/stages/s5/reanchor.py:175
        List<Regex> patterns = null;
        if (ownSink == null) {
            patterns = r.byCwe.get(RulesCwe.weaknessKey(f.cwe));                                     // src: vvaharness/pipeline/stages/s5/reanchor.py:178
            if (patterns.isEmpty()) { Counters.bump("s5_reanchor_no_pattern"); return f; }      // src: vvaharness/pipeline/stages/s5/reanchor.py:181
        }
        ParsedFile parsed = f.file.endsWith(".py") ? r.parsedFile(f.file) : null;               // src: vvaharness/pipeline/stages/s5/reanchor.py:182
        if (parsed == null) { Counters.bump("s5_reanchor_unparsed"); return f; }               // src: vvaharness/pipeline/stages/s5/reanchor.py:185
        int line = max(1, f.lineStart);
        Pair sh = innermostScope(parsed.scopes, line);                                          // src: vvaharness/pipeline/stages/s5/reanchor.py:187
        if (sh.scope == null) { Counters.bump("s5_reanchor_no_scope"); return f; }             // src: vvaharness/pipeline/stages/s5/reanchor.py:190
        // Only header-anchored findings move (upper bound exclusive: first body stmt is deliberate).
        if (!(sh.header <= line && line < max(firstBodyLine(sh.scope), sh.header + 1))) {      // src: vvaharness/pipeline/stages/s5/reanchor.py:192
            Counters.bump("s5_reanchor_body_anchored");
            return f;
        }
        // own_sink on a header IS the mis-anchor to fix: fall back to patterns.
        if (ownSink != null && ownSink == line && line < firstBodyLine(sh.scope)) {             // src: vvaharness/pipeline/stages/s5/reanchor.py:196
            Counters.bump("s5_reanchor_own_sink_is_header");
            ownSink = null;
            patterns = r.byCwe.get(RulesCwe.weaknessKey(f.cwe));                                     // src: vvaharness/pipeline/stages/s5/reanchor.py:199
            if (patterns.isEmpty()) { Counters.bump("s5_reanchor_no_pattern"); return f; }
        }
        List<Integer> candidates;
        if (ownSink != null) {
            Counters.bump("s5_reanchor_own_sink_ref");                                          // src: vvaharness/pipeline/stages/s5/reanchor.py:204
            candidates = List.of(ownSink);
        } else {
            candidates = sinkLines(r.calls(parsed, sh.scope), patterns);                        // src: vvaharness/pipeline/stages/s5/reanchor.py:207
        }
        if (candidates.isEmpty()) { Counters.bump("s5_reanchor_no_sink"); return f; }          // src: vvaharness/pipeline/stages/s5/reanchor.py:210
        int sink = candidates.minBy(ln -> Pair.of(abs(ln - line), ln));                         // src: vvaharness/pipeline/stages/s5/reanchor.py:211
        if (sink == line) { Counters.bump("s5_reanchor_already_at_sink"); return f; }          // src: vvaharness/pipeline/stages/s5/reanchor.py:214
        if (abs(sink - line) > r.maxMove) {                                                     // src: vvaharness/pipeline/stages/s5/reanchor.py:215  (maxMove = step5_prefilter.sink_reanchor_max_move_lines)
            Counters.bump("s5_reanchor_capped");
            return f;
        }
        Finding moved = f.copy(lineStart = sink, lineEnd = max(f.lineEnd, sink));               // src: vvaharness/pipeline/stages/s5/reanchor.py:218
        if (f.sinkRef.isBlank()) {
            moved.sinkRef = f.file + ":" + sink;                                                // src: vvaharness/pipeline/stages/s5/reanchor.py:221
            moved.backfilledRefs.add("sink_ref");
        }
        moved.codeSnippet = S5Enrich.snippet(moved, r.cache.lines(f.file));                     // src: vvaharness/pipeline/stages/s5/reanchor.py:225
        Counters.bump("s5_sink_reanchored");
        return moved;
    }

    Pair innermostScope(List<Scope> scopes, int line) {
        // The innermost function/class whose header..end range contains line.
        Scope best = null;
        for (Scope s : scopes) {                                                                // src: vvaharness/pipeline/stages/s5/reanchor.py:63
            if (s.header <= line && line <= s.end && (best == null || s.header >= best.header)) best = s; // src: vvaharness/pipeline/stages/s5/reanchor.py:64
        }
        return Pair.of(best, best.header);
    }

    List<Integer> sinkLines(List<Call> calls, List<Regex> patterns) {
        // Distinct call lines whose rendered callee (never the raw line) matches a sink pattern.
        return calls.filter(c -> !c.callee.isEmpty() && patterns.any(rx -> rx.search(c.callee))).lines().distinct().sorted(); // src: vvaharness/pipeline/stages/s5/reanchor.py:102
    }

    int firstBodyLine(Scope scope) {
        return headerStart(scope.body[0]);                                                      // src: vvaharness/pipeline/stages/s5/reanchor.py:50
    }

    int headerStart(Node node) {
        return min(node.decorators.lines() + node.lineno);                                      // src: vvaharness/pipeline/stages/s5/reanchor.py:45
    }
}

@executedBy(CODE) @role(io) @stage("S5")
class Reanchorer {
    // Per-run caches: an LRU of at most 16 parsed .py files (_MAX_PARSED_FILES, code constant).
    ParsedFile parsedFile(String rel) {
        if (parsed.contains(rel)) return parsed.touch(rel);                                     // src: vvaharness/pipeline/stages/s5/reanchor.py:133
        List<String> lines = cache.lines(rel);
        ParsedFile pf = null;
        if (lines != null) {
            try { pf = Ast.parse(lines).scopesOf(FunctionDef, AsyncFunctionDef, ClassDef); }    // src: vvaharness/pipeline/stages/s5/reanchor.py:140
            catch (SyntaxError e) { pf = null; }                                                 // src: vvaharness/pipeline/stages/s5/reanchor.py:147
        }
        parsed.put(rel, pf);
        if (parsed.size() > 16) parsed.evictOldest();                                           // src: vvaharness/pipeline/stages/s5/reanchor.py:150
        return pf;
    }

    List<Call> calls(ParsedFile parsed, Scope scope) {
        // Every Call in the scope's OWN body, pruned at nested scopes/lambdas; memoized per scope.
        return parsed.memo(scope, () -> Ast.ownCalls(scope));                                    // src: vvaharness/pipeline/stages/s5/reanchor.py:158
    }
}
