// file: vulnhunt/phases/phase2_class_log.md
// LOG (logic / crypto) class-group reference read by every LOG trace agent in Phase 2.
// Renders the sink reference, crypto / memory-safety / logic / resource-exhaustion / prototype-pollution hunts,
// the non-exhaustive "other patterns" sweep and the LOG Gate 3 do-not-eliminate rule as MODEL control flow.

@executedBy(MODEL) @role(prompt) @stage("phase2")
class Phase2ClassLog {

    // Entry: one LOG trace agent working one partition (spawned by Phase2Hunt with this file + partition data).
    List<Disposition> run(Partition sg, ReconContext recon, Theta θ) {
        Prompt p = prompt(θ);
        List<Disposition> out = new List();
        for (Input in : sg.inputs) {                                            // iteration rules come from Phase2Shared
            out.addAll(traceInput(in, recon, θ));
        }
        for (Finding f : codebaseWideHunts(sg, recon, θ)) {                     // class checks not driven by one input (secrets, TLS, logs)
            Disposition d = applyGates(f, θ);
            if (d != null) out.add(d);
        }
        return out;
    }

    // ---------------- prompt sections, in file order ----------------

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(List.of(θ["p.phase2_class_log.sink_cryptographic_operations"], θ["p.phase2_class_log.sink_deserialization"])); // src: vulnhunt/phases/phase2_class_log.md:3
        p.rule(θ["p.phase2_class_log.adapt_api_names"]);                                                // src: vulnhunt/phases/phase2_class_log.md:10
        p.checklist(List.of(θ["p.phase2_class_log.class_hardcoded_secrets"], θ["p.phase2_class_log.class_weak_algorithms"],
            θ["p.phase2_class_log.class_insecure_rng"], θ["p.phase2_class_log.class_disabled_tls_validation"]));        // src: vulnhunt/phases/phase2_class_log.md:14
        p.context(θ["p.phase2_class_log.memory_safety_language_scope"]);                                // src: vulnhunt/phases/phase2_class_log.md:23
        p.threshold(θ["p.phase2_class_log.race_condition_pattern_count"]);                              // src: vulnhunt/phases/phase2_class_log.md:29
        p.must(θ["p.phase2_class_log.fire_and_forget_full_pipeline_before_downgrade"]);                 // src: vulnhunt/phases/phase2_class_log.md:40
        p.must(θ["p.phase2_class_log.access_type_leakage_mandatory"]);                                  // src: vulnhunt/phases/phase2_class_log.md:88
        p.must(θ["p.phase2_class_log.request_dto_collection_size_check"]);                              // src: vulnhunt/phases/phase2_class_log.md:105
        p.context(θ["p.phase2_class_log.class_prototype_pollution_js_only"]);                           // src: vulnhunt/phases/phase2_class_log.md:116
        p.checklist(θ["p.phase2_class_log.class_list_not_exhaustive_extras"]);                          // src: vulnhunt/phases/phase2_class_log.md:123
        p.rule(θ["p.phase2_class_log.report_any_pattern_passing_gates"]);                               // src: vulnhunt/phases/phase2_class_log.md:128
        p.forbid(θ["p.phase2_class_log.gate3_no_self_only_impact_elimination"]);                        // src: vulnhunt/phases/phase2_class_log.md:133
        p.context(θ["p.phase2_class_log.gate3_invariant_violation_examples"]);                          // src: vulnhunt/phases/phase2_class_log.md:134
        return p;
    }

    // ---------------- procedure the prompt asks the agent to carry out ----------------

    @executedBy(MODEL)
    List<Disposition> traceInput(Input in, ReconContext recon, Theta θ) {
        List<Disposition> out = new List();
        List<Sink> sinks = Phase2Shared.traceForward(in, null, θ);
        for (Sink s : sinks) {
            if (!isLogSink(s, θ) && s.classGroup != LOG) { out.add(new Disposition(TraceDisposition.CROSS_CLASS, in, s)); continue; }
            List<Finding> fs = new List();
            fs.addAll(huntCrypto(in, s, θ));
            fs.addAll(huntMemorySafety(in, s, recon, θ));
            fs.addAll(huntLogicFlaws(in, s, θ));
            fs.addAll(huntResourceExhaustion(in, s, θ));
            fs.addAll(huntPrototypePollution(in, s, recon, θ));
            fs.addAll(huntOther(in, s, θ));
            for (Finding f : fs) {
                Disposition d = applyGates(f, θ);
                if (d != null) out.add(d);
            }
        }
        if (in.isRequestBody()) for (Finding f : dtoCollectionSizeCheck(in, θ)) { Disposition d = applyGates(f, θ); if (d != null) out.add(d); }
        if (out.isEmpty()) out.add(new Disposition(TraceDisposition.NO_MATCH, in));
        return out;
    }

    // ---- Dangerous Sink Reference ----
    @executedBy(MODEL)
    boolean isLogSink(Sink s, Theta θ) {
        if (θ["p.phase2_class_log.sink_cryptographic_operations"] && (s.isCipher() || s.isHash() || s.isKdf() || s.isRng())) return true; // src: vulnhunt/phases/phase2_class_log.md:5
        if (θ["p.phase2_class_log.sink_deserialization"] && s.reconstructsObjectsFromUntrustedBytes()) return true;                         // src: vulnhunt/phases/phase2_class_log.md:7
        if (θ["p.phase2_class_log.adapt_api_names"]) { /* sink API names adapted to the detected language/framework */ }                    // src: vulnhunt/phases/phase2_class_log.md:10
        return false;
    }

    // ---- Cryptographic Issues ----
    @executedBy(MODEL)
    List<Finding> huntCrypto(Input in, Sink s, Theta θ) {
        List<Finding> fs = new List();
        if (θ["p.phase2_class_log.class_weak_algorithms"].contains(s.algorithm())) fs.add(Finding.of(s, "weak algorithm"));     // src: vulnhunt/phases/phase2_class_log.md:16
        if (θ["p.phase2_class_log.class_insecure_rng"] && s.isRng() && !s.isCryptographicallySecure()) fs.add(Finding.of(s, "insecure RNG")); // src: vulnhunt/phases/phase2_class_log.md:17
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> codebaseWideHunts(Partition sg, ReconContext recon, Theta θ) {
        List<Finding> fs = new List();
        if (θ["p.phase2_class_log.class_hardcoded_secrets"]) fs.addAll(grep(sg.files, HARDCODED_SECRET_PATTERNS)); // src: vulnhunt/phases/phase2_class_log.md:15
        for (String marker : θ["p.phase2_class_log.class_disabled_tls_validation"]) {                   // src: vulnhunt/phases/phase2_class_log.md:18
            for (Location loc : grep(sg.files, marker)) fs.add(Finding.of(loc, "CWE-295"));
        }
        for (Location loc : grep(sg.files, logCallsAdjacentTo(θ["p.phase2_class_log.sensitive_log_output_grep"]))) fs.add(Finding.of(loc, "CWE-532")); // src: vulnhunt/phases/phase2_class_log.md:125
        if (θ["p.phase2_class_log.class_credential_policy_over_permissioning"]) fs.addAll(huntCredentialPolicy(sg, θ)); // src: vulnhunt/phases/phase2_class_log.md:75
        return fs;
    }

    // ---- Memory Safety (C/C++/Rust unsafe) ----
    @executedBy(MODEL)
    List<Finding> huntMemorySafety(Input in, Sink s, ReconContext recon, Theta θ) {
        List<Finding> fs = new List();
        if (!s.languageIn(θ["p.phase2_class_log.memory_safety_language_scope"])) return fs;             // src: vulnhunt/phases/phase2_class_log.md:23
        if (θ["p.phase2_class_log.class_buffer_overflow_uaf_double_free"] && (s.bufferOverflow() || s.useAfterFree() || s.doubleFree())) fs.add(Finding.of(s, "memory corruption")); // src: vulnhunt/phases/phase2_class_log.md:24
        if (θ["p.phase2_class_log.class_integer_overflow_undersized_alloc"] && s.intOverflowIntoAllocSize()) fs.add(Finding.of(s, "undersized allocation")); // src: vulnhunt/phases/phase2_class_log.md:25
        if (θ["p.phase2_class_log.class_unsound_unsafe_rust"] && s.inUnsafeRustBlock() && s.isUnsound()) fs.add(Finding.of(s, "unsound unsafe Rust")); // src: vulnhunt/phases/phase2_class_log.md:26
        return fs;
    }

    // ---- Logic Flaws ----
    @executedBy(MODEL)
    List<Finding> huntLogicFlaws(Input in, Sink s, Theta θ) {
        List<Finding> fs = new List();
        fs.addAll(huntRaceConditions(in, s, θ));                                // race_condition_pattern_count patterns below
        if (θ["p.phase2_class_log.class_rate_limit_counter_scope_bypass"] && s.isRateLimitOrAttemptCounter()) {  // src: vulnhunt/phases/phase2_class_log.md:48
            if (s.counterBindingIdentifierRotatable() && !s.endpointRequiresPriorAuth()) {              // bypassable regardless of atomicity
                Finding f = Finding.of(s, θ["p.phase2_class_log.rotatable_counter_is_cwe307_not_race"]); // src: vulnhunt/phases/phase2_class_log.md:52
                if (θ["p.phase2_class_log.rate_limit_severity_by_protected_asset"]) f.severityBasis = s.whatLimitProtects(); // src: vulnhunt/phases/phase2_class_log.md:54
                fs.add(f);
            }
        }
        if (θ["p.phase2_class_log.class_integer_overflow_business_logic"] && s.arithmeticOnUserValueIn(List.of("allocation size", "array index", "financial calculation", "loop bound"))) fs.add(Finding.of(s, "CWE-190")); // src: vulnhunt/phases/phase2_class_log.md:56
        if (θ["p.phase2_class_log.class_incorrect_access_control_logic"] && (s.orInsteadOfAnd() || s.negationError())) fs.add(Finding.of(s, "incorrect access-control logic")); // src: vulnhunt/phases/phase2_class_log.md:59
        if (θ["p.phase2_class_log.class_missing_null_error_checks"] && s.onSecurityCriticalPath() && s.missingNullOrErrorCheck()) fs.add(Finding.of(s, "missing null/error check")); // src: vulnhunt/phases/phase2_class_log.md:60
        if (θ["p.phase2_class_log.class_cache_state_isolation"] && s.cachesAuthzCredentialsOrSession()) fs.addAll(huntCacheIsolation(s, θ)); // src: vulnhunt/phases/phase2_class_log.md:61
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> huntRaceConditions(Input in, Sink s, Theta θ) {
        List<Finding> fs = new List();
        int patterns = θ["p.phase2_class_log.race_condition_pattern_count"];                            // src: vulnhunt/phases/phase2_class_log.md:29
        if (θ["p.phase2_class_log.race_pattern_check_then_act"] && s.checkSeparateFromAct()) fs.add(Finding.of(s, "race: check-then-act"));        // src: vulnhunt/phases/phase2_class_log.md:31
        if (θ["p.phase2_class_log.race_pattern_read_modify_write"] && s.readModifyWriteWithoutCas()) fs.add(Finding.of(s, "race: read-modify-write")); // src: vulnhunt/phases/phase2_class_log.md:34
        if (θ["p.phase2_class_log.race_pattern_fire_and_forget_async"] && s.securityOpDispatchedAsyncBeforeResponse()) {                             // src: vulnhunt/phases/phase2_class_log.md:38
            Finding f = Finding.of(s, "race: fire-and-forget async");
            if (θ["p.phase2_class_log.fire_and_forget_full_pipeline_before_downgrade"]) f.noDowngradeUntil(List.of("PoC", "exploit test")); // src: vulnhunt/phases/phase2_class_log.md:40
            if (θ["p.phase2_class_log.fire_and_forget_concurrent_scenario_required"]) f.scenario = constructConcurrentRequestScenario(s);   // src: vulnhunt/phases/phase2_class_log.md:41
            fs.add(f);
        }
        if (θ["p.phase2_class_log.race_pattern_toctou_across_api"] && s.validatedStateConsumedByLaterApiCall()) fs.add(Finding.of(s, "race: TOCTOU across API")); // src: vulnhunt/phases/phase2_class_log.md:45
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> huntCacheIsolation(Sink s, Theta θ) {
        List<Finding> fs = new List();
        Cache c = s.cache();
        if (θ["p.phase2_class_log.cache_key_completeness_check"] && !c.key.containsAll(c.authzDecisionFields())) fs.add(Finding.of(c, "cache key incomplete")); // src: vulnhunt/phases/phase2_class_log.md:64
        if (θ["p.phase2_class_log.cache_key_collision_check"] && c.key.concatenatesUserFields()) {     // src: vulnhunt/phases/phase2_class_log.md:68
            if (θ["p.phase2_class_log.delimiterless_concat_is_collision_vuln"] && !c.key.hasDelimiter()) fs.add(Finding.of(c, "cache key collision")); // src: vulnhunt/phases/phase2_class_log.md:70
        }
        if (θ["p.phase2_class_log.cache_revocation_window_check"] && c.authzRevocable() && !c.checksRevocation()) fs.add(Finding.of(c, "revocation window")); // src: vulnhunt/phases/phase2_class_log.md:72
        return fs;
    }

    // ---- Credential/Policy Scope Over-Permissioning ----
    @executedBy(MODEL)
    List<Finding> huntCredentialPolicy(Partition sg, Theta θ) {
        List<Finding> fs = new List();
        for (Generator g : sg.authzArtifactGenerators()) {                       // IAM policies, scoped tokens, OAuth scopes, capability grants
            if (θ["p.phase2_class_log.action_wildcard_grep"]) {                                         // src: vulnhunt/phases/phase2_class_log.md:79
                for (Wildcard w : grep(g, List.of("All*Actions", "\"*\" in action arrays"))) {
                    if (g.parallelBranchUsesRestrictedSet(w)) fs.add(Finding.of(w, "over-permissioned wildcard"));
                    if (θ["p.phase2_class_log.wildcard_destructive_operations_check"] && w.includesDestructiveBeyondFeatureNeeds()) fs.add(Finding.of(w, "destructive wildcard")); // src: vulnhunt/phases/phase2_class_log.md:82
                }
            }
            if (θ["p.phase2_class_log.per_branch_invariant_consistency"] && !g.allBranchesEnforceSameInvariants()) fs.add(Finding.of(g, "branch inconsistency")); // src: vulnhunt/phases/phase2_class_log.md:84
            if (θ["p.phase2_class_log.access_type_leakage_mandatory"] && g.gatedByRequestTypeDiscriminator()) { // src: vulnhunt/phases/phase2_class_log.md:88
                List<Caller> callers = new List();
                if (θ["p.phase2_class_log.access_type_grep_all_callers"]) callers = grep.callersOf(g.credentialIssuingFunction()); // src: vulnhunt/phases/phase2_class_log.md:90
                for (Caller c : callers) {
                    if (θ["p.phase2_class_log.access_type_verify_each_caller_branches"] && !c.branchesOnRequestTypeBeforeCall()) {  // src: vulnhunt/phases/phase2_class_log.md:91
                        fs.add(Finding.of(c, "access-type leakage").disposition(θ["p.phase2_class_log.access_type_non_branching_caller_candidate"])); // src: vulnhunt/phases/phase2_class_log.md:92
                    }
                }
                if (θ["p.phase2_class_log.access_type_indirect_activation_check"] && g.requestTypeSettableBySecondaryInputs()) fs.add(Finding.of(g, "indirect access-type activation")); // src: vulnhunt/phases/phase2_class_log.md:93
            }
            if (θ["p.phase2_class_log.supplemental_resource_grant_scope_check"]) {                      // src: vulnhunt/phases/phase2_class_log.md:95
                for (Statement st : g.supplementalStatementsFromRequestParams()) if (!st.scopeMatchesAccessType()) fs.add(Finding.of(st, "privilege escalation"));
            }
        }
        return fs;
    }

    // ---- Resource Exhaustion (CWE-400) ----
    @executedBy(MODEL)
    List<Finding> huntResourceExhaustion(Input in, Sink s, Theta θ) {
        List<Finding> fs = new List();
        if (θ["p.phase2_class_log.class_redos"] && s.isRegexMatch() && s.regexHasCatastrophicBacktracking()) fs.add(Finding.of(s, "ReDoS")); // src: vulnhunt/phases/phase2_class_log.md:101
        if (θ["p.phase2_class_log.class_unbounded_allocation"] && in.isSizeOrCount() && s.isAllocationOrLimitOffset() && !s.hasCap()) fs.add(Finding.of(s, "CWE-400")); // src: vulnhunt/phases/phase2_class_log.md:103
        if (θ["p.phase2_class_log.class_recursive_parsing"] && s.isXmlOrJsonParse() && !s.hasDepthLimit()) fs.add(Finding.of(s, "recursive parsing")); // src: vulnhunt/phases/phase2_class_log.md:113
        if (θ["p.phase2_class_log.class_archive_extraction_bombs"] && s.isArchiveExtraction() && !s.hasSizeLimit()) fs.add(Finding.of(s, "zip bomb")); // src: vulnhunt/phases/phase2_class_log.md:114
        return fs;
    }

    @executedBy(MODEL)
    List<Finding> dtoCollectionSizeCheck(Input body, Theta θ) {
        List<Finding> fs = new List();
        if (!θ["p.phase2_class_log.request_dto_collection_size_check"]) return fs;                      // src: vulnhunt/phases/phase2_class_log.md:105
        for (Field fld : body.type.collectionFields()) {                        // List, Array, Set, repeated protobuf
            if (!fld.hasSizeConstraint()) {                                     // @Size, maxItems, @Length, custom length validation
                Finding f = Finding.of(fld, "CWE-400");
                if (θ["p.phase2_class_log.dto_collection_dos_separate_from_other_class"]) f.separateFromOtherClassFindings(); // src: vulnhunt/phases/phase2_class_log.md:110
                fs.add(f);
            }
        }
        return fs;
    }

    // ---- Prototype Pollution (CWE-1321, JS only) ----
    @executedBy(MODEL)
    List<Finding> huntPrototypePollution(Input in, Sink s, ReconContext recon, Theta θ) {
        List<Finding> fs = new List();
        if (!s.languageIn(θ["p.phase2_class_log.class_prototype_pollution_js_only"])) return fs;        // src: vulnhunt/phases/phase2_class_log.md:116
        if (θ["p.phase2_class_log.prototype_pollution_merge_functions"].contains(s.mergeFunction()) && s.canWriteProtoOrConstructorPrototype()) fs.add(Finding.of(s, "CWE-1321")); // src: vulnhunt/phases/phase2_class_log.md:118
        return fs;
    }

    // ---- Other Vulnerability Patterns (list is not exhaustive) ----
    @executedBy(MODEL)
    List<Finding> huntOther(Input in, Sink s, Theta θ) {
        List<Finding> fs = new List();
        for (String extra : θ["p.phase2_class_log.class_list_not_exhaustive_extras"]) {                 // src: vulnhunt/phases/phase2_class_log.md:123
            if (s.matches(extra)) fs.add(Finding.of(s, extra));
        }
        if (θ["p.phase2_class_log.report_any_pattern_passing_gates"] && fs.isEmpty() && s.attackerDataReachesDangerousOp()) fs.add(Finding.of(s, "other")); // src: vulnhunt/phases/phase2_class_log.md:128
        return fs;
    }

    // ---- shared gates + LOG Gate 3 do-not-eliminate ----
    @executedBy(MODEL)
    Disposition applyGates(Finding f, Theta θ) {
        if (Phase2Shared.gate0(f, θ) == ELIMINATE) return new Disposition(TraceDisposition.DESIGN_INTENT, f);
        if (Phase2Shared.gate1(f, θ) == ELIMINATE) return null;
        if (Phase2Shared.gate2a(f, θ) == ELIMINATE) return null;
        if (Phase2Shared.gate2b(f, θ) == ELIMINATE) return new Disposition(TraceDisposition.SAFE, f);
        if (!logGate3KeepsFinding(f, θ) && Phase2Shared.gate3(f, θ) == ELIMINATE) return null;
        f.severity = Phase2Shared.classifySeverity(f, θ);
        return new Disposition(TraceDisposition.CANDIDATE, f);
    }

    @executedBy(MODEL)
    boolean logGate3KeepsFinding(Finding f, Theta θ) {
        if (θ["p.phase2_class_log.gate3_business_logic_invariant_is_new_capability"] && f.violatesAppEnforcedInvariant()) {  // src: vulnhunt/phases/phase2_class_log.md:132
            if (θ["p.phase2_class_log.gate3_no_self_only_impact_elimination"]) f.ignoreEliminationReason("self-only impact"); // src: vulnhunt/phases/phase2_class_log.md:133
            if (θ["p.phase2_class_log.gate3_invariant_violation_examples"].contains(f.invariantViolationKind())) return true; // src: vulnhunt/phases/phase2_class_log.md:134
            return true;
        }
        return false;
    }
}
