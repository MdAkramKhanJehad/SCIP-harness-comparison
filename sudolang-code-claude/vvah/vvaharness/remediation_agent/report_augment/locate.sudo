// src: vvaharness/remediation_agent/report_augment/locate.py:30-31
SCAN_REPORT_GLOB = "*_report.sarif"

// src: vvaharness/remediation_agent/report_augment/locate.py:34-61
fn _locate_scan_report(repo, report_md?):executor=code {
  if (report_md != null) {
    require report_md exists => { warn "explicit scan report ... not found — skipping augmentation"; return null }
    sarif = report_md with suffix ".sarif"
    require sarif exists => { warn "sibling SARIF ... not found — skipping augmentation"; return null }
    return [sarif, report_md]
  }
  // no explicit report: the glob fallback refuses to guess rather than take the newest (newest-wins is tamperable)
  sarifs = sorted files matching SCAN_REPORT_GLOB in repo/security-scan
  if (!sarifs) return null
  require length(sarifs) == 1 => { warn "<n> scan SARIF reports ... refusing to guess which is canonical"; return null }
  md = sarifs[0] with suffix ".md"
  return if (md exists) [sarifs[0], md] else null
}

// src: vvaharness/remediation_agent/report_augment/locate.py:64-76
fn _ensure_combined(repo, sarif_src, md_src):executor=code {
  dst_dir = artifact_dir(repo, REMEDIATION_DIR_NAME); create it if missing   // raises UnsafeArtifactDir on a symlink
  copy sarif_src and md_src into dst_dir, each only when the copy does not exist yet
  return [sarif copy, md copy]
  // a later run augments the existing copies again (both augmenters replace their earlier blocks)
}
