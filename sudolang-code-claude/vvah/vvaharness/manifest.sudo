# vvaharness/manifest.py

The run manifest. A context manager around a command captures the tool version, scrubbed command line, configuration hashes, model roles with their resolved routes, the effective scan controls, and the target git SHA, then on exit adds timing, per-stage telemetry, error counts, the remediation roll-up and counters, and writes `run_manifest_<timestamp>.json`. It is the only output that sees Stage 10 and 11 spend.

Source: `vvaharness/manifest.py` (lines 1-624)
Executor: code
Called from: `vvaharness/cli/__init__.py` `_dispatch` (scan path only; other subcommands write no manifest)

// src: vvaharness/manifest.py:542-624
fn capture(cfg_path, args, out?):executor=code {
  m = {
    tool: "vvaharness", version: __version__, started: now (UTC),
    argv: _scrub_argv(args),
    config_profile: cfg_path,
    config_sha256: _config_sha256(cfg_path),
    config_local_sha256: _config_sha256(sibling "config.local.yaml"),   // a local file silently overrides the profile, so it is hashed too
    ev_api_collection, ev_api_collection_sha256,   // from EV_API_COLLECTION: configured, not whether exploit verification ran
    models: _models(cfg_path),
    effective_scan_controls: _effective_scan_controls(cfg_path),
    target_git_sha: _git_sha(args),
    exit_code: null
  }
  try { yield m }   // the command runs here and sets m.exit_code
  catch (KeyboardInterrupt | _Terminated) => {
    if (m.exit_code == null) m.exit_code = if (KeyboardInterrupt) 130 else 143
    m.exit_cause = "SIGINT" or "SIGTERM"; throw
  }
  constraint OnEveryExit {
    // src: manifest.py:578-624
    if (m.exit_code != null) {   // a null exit code means nothing is written
      m.ended, m.duration_sec
      _refresh_resolved_transport(m)   // a mid-run transport hop is reported, best effort
      m += _telemetry_fields(cfg_path, m.models)
      m.errors_by_stage = errlog.counts_by_stage() if non-empty
      m.remediation = case_rollup.totals() if non-empty   // omitted when Stage 11 did not run: no validation is unknown, not clean
      m.counters = redact_tree(COUNTERS.snapshot_cumulative()) if non-empty   // cumulative across a batch
      // abstracted: manifest.py:583-615 — each of transport refresh, error counts, roll-up and counters is wrapped so its failure is ignored
      dest = out || _default_manifest_dest(m.started)
      write m as JSON to dest   // OSError only warns
    }
  }
}

// src: vvaharness/manifest.py:493-511
fn _telemetry_fields(cfg_path, models):executor=code {
  return stage_telemetry.compose_stage_section(STAGES.snapshot(), TOKENS.snapshot(), role ids, load_pricing_cached(pricing.file), CACHED_PROVENANCE.snapshot())
  // a resumed stage reports the model and tokens it was produced under (provenance rows)
  // preserved: batch.py resets STAGES and TOKENS before each repository, so in batch mode this section covers only the last repository, while counters are cumulative
  // any failure returns {} with a warning; the manifest is still written
}

// src: vvaharness/manifest.py:231-302
fn _models(cfg_path):executor=code {
  // src: manifest.py:143-145
  _MODEL_ROLES = ["graph_annotate", "callgraph_creation", "autoexclude", "preprocess", "threatmodel", "decompose", "deepdive", "verify", "dedup", "chain", "remediate", "validate"]   // exploit_verification omitted; its sub-roles are added below
  for each name in _MODEL_ROLES {
    r = cfg.models[name]; if (name == "validate") r = r.orchestrator
    if (r) roles[name] = { id, via: r.via || "cli" /* a missing or null via counts as cli */, provider, resolved_route: _resolved_route(...), resolved_transport: _resolved_transport(...), use_responses_api, declared_via, effective_effort: config_paths.role_effort(cfg, name) }
    // validate's via and provider pass through normalize_validate_backend; declared_via keeps what the profile said
  }
  for each sub in EV_MODULES where cfg.models.exploit_verification[sub] is set { roles["exploit_verification.$sub"] = same shape, effort from ev_effort }
  return roles   // any failure returns {}
}

// src: vvaharness/manifest.py:150-222
fn _resolved_route(via, model_id, provider):executor=code {
  match (via) {
    case "cli" | "sdk" => return "anthropic"
    case "openai" => return "openai"
    case "deepagents" => return if (routes_to_anthropic(model_id, provider)) "anthropic" else "openai"
    default => return null
  }
}
fn _resolved_transport(via, model_id, provider, node):executor=code {
  // src: manifest.py:172-194 — openai: a model learned to be chat-only gets Chat Completions (this beats a pin); else pinned use_responses_api: true gets Responses; else a model in the learned tools-off set for which resolve_use_responses_api allows Responses gets Responses; otherwise Chat Completions
  // deepagents: resolve_use_responses_api(model_id, provider, override) -> Responses, Chat Completions, or null
  // other routes: null
}

// src: vvaharness/manifest.py:389-480
fn _effective_scan_controls(cfg_path):executor=code {
  // the non-secret settings that materially change scan output, picked by name per section
  return { cache, thinking, refusals, step0, step1, step2, step4, step5_prefilter, step5_detectors, step6_verify, step7_dedup, step8, step9, output, cli, step_remediate, remediation_model, step_validate, validation_panel: _validation_panel(cfg.models.validate), input_hashes: sha256 of cve_file, controls_file, cmdb_file, policy_file, playbook_file }
  // abstracted: manifest.py:399-474 lists the exact keys picked per section; reporting only
  // any failure returns {}
}

// src: vvaharness/manifest.py:350-371
fn _validation_panel(validate):executor=code {
  if (validate == null) return {}
  // every panel entry (orchestrator, security_architect, penetration_tester, cross_repo_analyzer) is reported on the orchestrator's normalized route; persona via and provider are dead configuration
  if (no orchestrator) return { name: { id } } for each present entry
  via = orchestrator.via || "cli"; declared_via = via
  [via, provider] = normalize_validate_backend(via, orchestrator.provider)
  return { name: { id, via, provider, resolved_route: _resolved_route(via, id, provider), declared_via } } for each present entry
}

// src: vvaharness/manifest.py:45-47, 77-99
_SECRET_FLAG_RX = case-insensitive "token|password|passwd|pwd|secret|api[_-]?key|access[_-]?key|client[_-]?secret|auth|credential|bearer|private[_-]?key"   // bare "key" excluded so --keep-clones is untouched
fn _scrub_argv(argv):executor=code {
  // "--flag=VALUE" with a secret-looking flag becomes "--flag=***"; "--flag VALUE" with a secret-looking flag replaces the next token (if it does not start with "-") with "***"
  return redact_tree(result)   // second, shape-based pass
}

// src: vvaharness/manifest.py:111-139
fn _git_sha(args):executor=code {
  repo = value of --repo (or --repo=) in args; if (!repo || not a directory) return null
  run "git rev-parse HEAD" in repo with a 10-second timeout; return stdout or null on any failure
}

