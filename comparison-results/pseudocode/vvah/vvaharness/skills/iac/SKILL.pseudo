// file: vvaharness/skills/iac/SKILL.md
// S4 skill playbook "iac": Terraform / Docker / k8s / compose / CI / CloudFormation / Ansible misconfiguration.
// Probe inventory first, invert empty-means-absent sections, then judgement the grep cannot make.

@executedBy(MODEL) @role(skill) @stage("S4")
class IacSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        if (!repo.taskMatches(θ["p.skill_iac.trigger"])) return List.of();                         // src: vvaharness/skills/iac/SKILL.md:3
        String scope = θ["p.skill_iac.hunt_scope"];                                                 // src: vvaharness/skills/iac/SKILL.md:24
        ProbeOutput po = runProbe(repo, θ);
        Set<String> platforms = po.inventoryPlatforms();
        List<Candidate> cands = new List<Candidate>();
        cands.addAll(polarity(po, platforms, θ));
        cands.addAll(judgeCi(po, repo, θ));
        cands.addAll(judgeContainersAndSecrets(po, repo, θ));
        cands.addAll(po.directiveHits().filter(h -> platforms.contains(h.platform)).map(h -> Candidate.fromHit(h)));
        List<Finding> out = new List<Finding>();
        for (Candidate c : cands) {
            // absent platform is not a finding
            if (θ["p.skill_iac.read_inventory_first"] && !platforms.contains(c.platform)) continue; // src: vvaharness/skills/iac/SKILL.md:39
            if (!hardGate(c, θ)) continue;
            Finding f = c.asFinding();
            f.severity = severity(c, θ);
            if (θ["p.skill_iac.concrete_remediation_required"]) f.remediation = c.exactDirectiveToAddOrRemove(); // src: vvaharness/skills/iac/SKILL.md:94
            out.add(f);
        }
        return out;
    }

    ProbeOutput runProbe(Repo repo, Theta θ) {
        if (!θ["p.skill_iac.run_probe_first"]) return ProbeOutput.empty();                           // src: vvaharness/skills/iac/SKILL.md:35
        return Tools.Bash("sh .vvaharness/skills/iac/probe.sh " + repo.root);                       // calls IacProbe.run  // src: vvaharness/skills/iac/SKILL.md:35
    }

    boolean hardGate(Candidate c, Theta θ) {
        if (θ["p.skill_iac.gate_cite_resource_file_line"] && !c.citesResourceFileLine()) return false; // src: vvaharness/skills/iac/SKILL.md:27
        if (!c.violatesOneOf(θ["p.skill_iac.gate_violated_security_property"])) return false;        // src: vvaharness/skills/iac/SKILL.md:28
        if (θ["p.skill_iac.vendor_defaults_not_findings"] && c.matchesPlatformBaselineDefault()) return false; // src: vvaharness/skills/iac/SKILL.md:30
        // placeholders are indirection, but check committed values.yaml / *.tfvars defaults
        if (θ["p.skill_iac.placeholders_not_literals"] && c.isPlaceholderInCredentialPosition()) { // src: vvaharness/skills/iac/SKILL.md:87
            if (!(θ["p.skill_iac.check_placeholder_defaults"] && c.committedDefaultIsLiteral())) return false; // src: vvaharness/skills/iac/SKILL.md:88
        }
        return true;
    }

    List<Candidate> polarity(ProbeOutput po, Set<String> platforms, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        // sections where (none) IS the finding: no USER, no securityContext, no NetworkPolicy, no audit logging
        for (String sec : θ["p.skill_iac.polarity_empty_sections_are_findings"]) {                  // src: vvaharness/skills/iac/SKILL.md:45
            if (po.section(sec).isEmpty() && platforms.contains(po.platformOf(sec))) out.add(Candidate.absence(sec));
        }
        // cross-account trust hits without a matching ExternalId in the same policy: confused deputy
        if (θ["p.skill_iac.cross_account_without_externalid"]) for (Hit h : po.section("cross-account trust")) if (!h.policyHas("ExternalId")) out.add(Candidate.at(h)); // src: vvaharness/skills/iac/SKILL.md:51
        return out;
    }

    List<Candidate> judgeCi(ProbeOutput po, Repo repo, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        for (Workflow w : repo.workflowsWith("pull_request_target")) {
            // conjunction of 3: pull_request_target AND checkout of PR head ref AND executes from checkout
            int conds = (w.trigger("pull_request_target") ? 1 : 0) + (w.checksOutPrHead() ? 1 : 0) + (w.executesFromCheckout() ? 1 : 0);
            if (θ["p.skill_iac.ci_verify_all_three_same_workflow"] && conds < θ["p.skill_iac.ci_pull_request_target_conjunction"]) continue; // src: vvaharness/skills/iac/SKILL.md:59
            out.add(Candidate.at(w));                                                                // src: vvaharness/skills/iac/SKILL.md:56
        }
        for (Hit h : po.section("event interpolation")) {
            // event data is attacker-authored; run: = shell injection, if: or quoted env: = not
            if (θ["p.skill_iac.event_data_is_attacker_authored"] && (!θ["p.skill_iac.event_interpolation_run_vs_if_env"] || h.inRunBlock())) out.add(Candidate.at(h)); // src: vvaharness/skills/iac/SKILL.md:60
        }
        assert θ["p.skill_iac.event_interpolation_run_vs_if_env"] != null;                          // src: vvaharness/skills/iac/SKILL.md:61
        for (Hit h : po.section("secrets in steps")) {
            // a secrets.* reference is not a finding by itself
            if (θ["p.skill_iac.secrets_reference_not_finding"] && !h.meetsAny(θ["p.skill_iac.secrets_finding_conditions"])) continue; // src: vvaharness/skills/iac/SKILL.md:63
            if (θ["p.skill_iac.secret_to_sha_pinned_action_ok"] && h.passedStraightToShaPinnedAction()) continue; // src: vvaharness/skills/iac/SKILL.md:67
            out.add(Candidate.at(h));                                                                // src: vvaharness/skills/iac/SKILL.md:65
        }
        for (Hit h : po.section("self-hosted runner")) {
            // needs both: public repo AND no per-job isolation
            if (θ["p.skill_iac.self_hosted_private_or_ephemeral_ok"] && (repo.isPrivate() || h.ephemeralRunners())) continue; // src: vvaharness/skills/iac/SKILL.md:72
            if (h.satisfiesAll(θ["p.skill_iac.self_hosted_runner_both_qualifiers"])) out.add(Candidate.at(h)); // src: vvaharness/skills/iac/SKILL.md:69
        }
        for (Hit h : po.section("GitLab job rules")) {
            Set<String> protectedBranches = θ["p.skill_iac.gitlab_read_protected_branches"] ? repo.approvalGateBranches() : Set.empty(); // src: vvaharness/skills/iac/SKILL.md:77
            if (h.deployJobRunsOnBranchOutside(protectedBranches)) out.add(Candidate.at(h).kind(θ["p.skill_iac.gitlab_rules_approval_bypass"])); // src: vvaharness/skills/iac/SKILL.md:74
        }
        return out;
    }

    List<Candidate> judgeContainersAndSecrets(ProbeOutput po, Repo repo, Theta θ) {
        List<Candidate> out = new List<Candidate>();
        // Ansible Vault: exposure only when the vault password/key file is committed beside it
        if (θ["p.skill_iac.ansible_vault_key_committed"] && !po.section("vault-encrypted material").isEmpty() && !po.section("vault password / key file").isEmpty()) out.add(Candidate.at(po.section("vault password / key file").first())); // src: vvaharness/skills/iac/SKILL.md:78
        // base-image pinning tiers per FROM
        for (Hit h : po.section("every FROM")) {
            PinTier t = h.pinTier(θ["p.skill_iac.base_image_pinning_tiers"]);                        // src: vvaharness/skills/iac/SKILL.md:82
            if (t == PinTier.UNPINNED || (t == PinTier.MOVING_MINOR && h.isProd())) out.add(Candidate.at(h));
        }
        // k8s data:/stringData: is base64, not encryption; sealed/external-secret refs are not
        if (θ["p.skill_iac.k8s_data_base64_is_secret"]) for (Hit h : po.section("plaintext secrets")) if (!h.isSealedOrExternalSecretRef()) out.add(Candidate.at(h)); // src: vvaharness/skills/iac/SKILL.md:84
        return out;
    }

    Severity severity(Candidate c, Theta θ) {
        // environment decides: prod public bucket / 0.0.0.0/0 on a sensitive port is HIGH; dev log retention LOW
        if (c.isProd() && (c.isPublicBucket() || c.openIngressOnAny(θ["p.skill_iac.sensitive_open_ports"]))) return Severity.of(θ["p.skill_iac.sev_environment_decides"]); // src: vvaharness/skills/iac/SKILL.md:90
        if (!c.hasConcreteAttackPath()) return θ["p.skill_iac.sev_best_practice_no_attack_path_low"]; // src: vvaharness/skills/iac/SKILL.md:29
        return c.severityByImpact();
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_iac.trigger"]);                                                           // src: vvaharness/skills/iac/SKILL.md:3
        p.persona(θ["p.skill_iac.hunt_scope"]);                                                     // src: vvaharness/skills/iac/SKILL.md:24
        p.evidence(θ["p.skill_iac.gate_cite_resource_file_line"]);                                  // src: vvaharness/skills/iac/SKILL.md:27
        p.choose(θ["p.skill_iac.gate_violated_security_property"]);                                 // src: vvaharness/skills/iac/SKILL.md:28
        p.rule(θ["p.skill_iac.sev_best_practice_no_attack_path_low"]);                              // src: vvaharness/skills/iac/SKILL.md:29
        p.exemption(θ["p.skill_iac.vendor_defaults_not_findings"]);                                 // src: vvaharness/skills/iac/SKILL.md:30
        return p;
    }

    Prompt probeSection(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.skill_iac.run_probe_first"]);                                               // src: vvaharness/skills/iac/SKILL.md:35
        p.step(2, θ["p.skill_iac.read_inventory_first"]);                                          // src: vvaharness/skills/iac/SKILL.md:39
        return p;
    }

    Prompt polaritySection(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.skill_iac.polarity_empty_sections_are_findings"]);                         // src: vvaharness/skills/iac/SKILL.md:45
        p.rule(θ["p.skill_iac.cross_account_without_externalid"]);                                  // src: vvaharness/skills/iac/SKILL.md:51
        return p;
    }

    Prompt judgementSection(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.skill_iac.ci_pull_request_target_conjunction"]);                           // src: vvaharness/skills/iac/SKILL.md:56
        p.must(θ["p.skill_iac.ci_verify_all_three_same_workflow"]);                                 // src: vvaharness/skills/iac/SKILL.md:59
        p.rule(θ["p.skill_iac.event_data_is_attacker_authored"]);                                   // src: vvaharness/skills/iac/SKILL.md:60
        p.rule(θ["p.skill_iac.event_interpolation_run_vs_if_env"]);                                 // src: vvaharness/skills/iac/SKILL.md:61
        p.exemption(θ["p.skill_iac.secrets_reference_not_finding"]);                                // src: vvaharness/skills/iac/SKILL.md:63
        p.checklist(θ["p.skill_iac.secrets_finding_conditions"]);                                   // src: vvaharness/skills/iac/SKILL.md:65
        p.exemption(θ["p.skill_iac.secret_to_sha_pinned_action_ok"]);                               // src: vvaharness/skills/iac/SKILL.md:67
        p.checklist(θ["p.skill_iac.self_hosted_runner_both_qualifiers"]);                           // src: vvaharness/skills/iac/SKILL.md:69
        p.exemption(θ["p.skill_iac.self_hosted_private_or_ephemeral_ok"]);                          // src: vvaharness/skills/iac/SKILL.md:72
        p.rule(θ["p.skill_iac.gitlab_rules_approval_bypass"]);                                      // src: vvaharness/skills/iac/SKILL.md:74
        p.must(θ["p.skill_iac.gitlab_read_protected_branches"]);                                    // src: vvaharness/skills/iac/SKILL.md:77
        p.rule(θ["p.skill_iac.ansible_vault_key_committed"]);                                       // src: vvaharness/skills/iac/SKILL.md:78
        p.choose(θ["p.skill_iac.base_image_pinning_tiers"]);                                        // src: vvaharness/skills/iac/SKILL.md:82
        p.rule(θ["p.skill_iac.k8s_data_base64_is_secret"]);                                         // src: vvaharness/skills/iac/SKILL.md:84
        p.exemption(θ["p.skill_iac.placeholders_not_literals"]);                                    // src: vvaharness/skills/iac/SKILL.md:87
        p.must(θ["p.skill_iac.check_placeholder_defaults"]);                                        // src: vvaharness/skills/iac/SKILL.md:88
        p.rule(θ["p.skill_iac.sev_environment_decides"]);                                           // src: vvaharness/skills/iac/SKILL.md:90
        p.checklist(θ["p.skill_iac.sensitive_open_ports"]);                                         // src: vvaharness/skills/iac/SKILL.md:91
        p.must(θ["p.skill_iac.concrete_remediation_required"]);                                     // src: vvaharness/skills/iac/SKILL.md:94
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(probeSection(θ));
        p.include(polaritySection(θ));
        p.include(judgementSection(θ));
        return p;
    }
}

@executedBy(MODEL) @role(types)
enum PinTier { PINNED, UNPINNED, MOVING_MINOR }
