# vvaharness/skills/injection/probe.sh

Candidate sweep for injection sinks, one labelled section per class, then a census of files carrying each defence.

Source: `vvaharness/skills/injection/probe.sh` (lines 1-92)
Executor: code (POSIX shell; read-only greps; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/injection/probe.sh [root]`, because the lens SKILL.md or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 4-16 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints `path:line` hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/injection/probe.sh:18-92
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/injection/probe.sh:18-40 — setup and the two helpers
  CAP = 20   // lines shown per section
  XD = exclude directories .git, node_modules, .venv, venv, __pycache__, dist, build, .vvaharness, vendor
  // preserved: unlike the missing-controls, ssrf, client-side and templates probes, this one does not exclude files named SKILL.md or probe.sh; the injected copy is still skipped because .vvaharness is excluded.

  hits(label, pattern, ...extraGrepArgs) {
    // grep -rEn (case-sensitive extended regex, binary files skipped) over ROOT
    if (no match) print "(none)"
    else print "<total> match(es); showing up to 20" then the first CAP lines
  }
  count(label, pattern) {
    print label and the number of FILES containing pattern   // grep -rEl
  }

  print "Every line below is a CANDIDATE. Apply the hard gate before reporting anything."

  // src: vvaharness/skills/injection/probe.sh:45-46
  hits("SQL text with interpolation or concatenation")
  // pattern and arguments, verbatim:  '(SELECT|INSERT[[:space:]]+INTO|UPDATE|DELETE[[:space:]]+FROM)[^;]*(\+|%s|%d|\.format\(|\{[A-Za-z_])'
  // src: vvaharness/skills/injection/probe.sh:47-48
  hits("execute/query/raw on a non-literal argument")
  // pattern and arguments, verbatim:  '\.(execute|executemany|executeQuery|executeUpdate|query|raw|queryRaw)[[:space:]]*\(([A-Za-z_]|f["'"'"'])'
  // src: vvaharness/skills/injection/probe.sh:49-50
  hits("ORM raw-query escape hatches")
  // pattern and arguments, verbatim:  '\.(extra|raw)\(|[^A-Za-z_]text\(|createNativeQuery|\$queryRaw|\$executeRaw|where\([^)]*#\{'
  // src: vvaharness/skills/injection/probe.sh:51-52
  hits("NoSQL operator / server-side JS")
  // pattern and arguments, verbatim:  '\$where|\$function|\$accumulator|mapReduce\(|\.aggregate\('
  // src: vvaharness/skills/injection/probe.sh:53-54
  hits("OS command execution")
  // pattern and arguments, verbatim:  'os\.system|os\.popen|shell[[:space:]]*=[[:space:]]*True|subprocess\.(run|call|Popen|check_output)|Runtime\.getRuntime\(\)\.exec|ProcessBuilder|child_process|execSync|spawnSync|Kernel\.(system|exec)|%x\{|qx[({/#|]|(open|system|exec)[[:space:]]*\([[:space:]]*['"'"'"]?[^)]*\|'
  // src: vvaharness/skills/injection/probe.sh:57-59
  hits("backtick command execution with interpolation (Ruby / Perl / shell)")
  // pattern and arguments, verbatim:  '`[^`]*(\$\{?[A-Za-z_@]|#\{)[^`]*`' --include='*.rb' --include='*.pl' --include='*.pm' --include='*.sh' --include='*.bash' --include='Rakefile'
  // src: vvaharness/skills/injection/probe.sh:60-61
  hits("dynamic code evaluation")
  // pattern and arguments, verbatim:  '[^A-Za-z_](eval|exec)\(|new Function\(|Function\([^)]*\)[[:space:]]*\(|set(Timeout|Interval)\([[:space:]]*["'"'"']|__import__\(|pickle\.loads|yaml\.load\('
  // src: vvaharness/skills/injection/probe.sh:62-63
  hits("LDAP / XPath queries")
  // pattern and arguments, verbatim:  'DirContext|InitialLdapContext|ldap3|python-ldap|\.search_s?\(|XPathExpression|selectSingleNode|selectNodes|\.xpath\('
  // src: vvaharness/skills/injection/probe.sh:64-65
  hits("XML parser factories (check hardening flags yourself)")
  // pattern and arguments, verbatim:  'DocumentBuilderFactory|SAXParserFactory|XMLInputFactory|TransformerFactory|SAXReader|XmlPullParser|etree\.(parse|fromstring|XMLParser)|xml\.dom\.minidom|expatreader|XmlDocument'
  // src: vvaharness/skills/injection/probe.sh:66-67
  hits("outbound HTTP clients (SSRF sinks)")
  // pattern and arguments, verbatim:  'requests\.(get|post|put|delete|head|request)|urlopen|urllib[0-9]?\.|http\.client|HttpURLConnection|OkHttpClient|HttpClient|WebClient|RestTemplate|Net::HTTP|axios\.|[^A-Za-z_]fetch\('
  // src: vvaharness/skills/injection/probe.sh:68-69
  hits("filesystem open / archive extraction")
  // pattern and arguments, verbatim:  '[^A-Za-z_.]open\([^)]*(\+|%s|\.format\(|f["'"'"'])|os\.path\.join\(|fs\.(read|write|create)File|new File\(|Path(s)?\.(of|get)\(|extractall|\.extract\(|TarFile|ZipFile|send_file|sendFile|static_file'
  // src: vvaharness/skills/injection/probe.sh:70-71
  hits("template autoescape bypass (server-emitted XSS)")
  // pattern and arguments, verbatim:  '\|[[:space:]]*safe|autoescape[[:space:]]*=[[:space:]]*False|mark_safe|html_safe|[^A-Za-z_]raw\(|\{\{\{|dangerouslySetInnerHTML|innerHTML[[:space:]]*='
  // src: vvaharness/skills/injection/probe.sh:72-73
  hits("SSTI — input rendered AS a template")
  // pattern and arguments, verbatim:  'render_template_string|Template[[:space:]]*\(|new SimpleTemplateEngine|ERB\.new|Velocity\.evaluate|Jinja2?\(|from_string\('
  // src: vvaharness/skills/injection/probe.sh:74-75
  hits("redirect writers (open redirect)")
  // pattern and arguments, verbatim:  'redirect\([^)]*(request|req|params|query|next|url|returnUrl)|res\.redirect\(|sendRedirect\(|Response\.Redirect|redirect_to[[:space:]]'
  // src: vvaharness/skills/injection/probe.sh:76-77
  hits("response header / cookie writes (CRLF)")
  // pattern and arguments, verbatim:  'headers?\[[^]]*\][[:space:]]*=|setHeader\(|add_header\(|set_cookie\(|addCookie\(|Set-Cookie'
  // src: vvaharness/skills/injection/probe.sh:78-79
  hits("regex compiled from a variable")
  // pattern and arguments, verbatim:  '(re\.compile|Pattern\.compile|new RegExp|Regexp\.new|regexp\.MustCompile)\([[:space:]]*[A-Za-z_][A-Za-z_0-9.]*[[:space:]]*[,)]'
  // src: vvaharness/skills/injection/probe.sh:80-81
  hits("nested-quantifier regex literals (ReDoS)")
  // pattern and arguments, verbatim:  '\([^)]*[*+][^)]*\)[*+]|\([^|)]+\|[^|)]+\)[*+][^?]'
  // src: vvaharness/skills/injection/probe.sh:83 — printf '\n== DEFENCE CENSUS (files containing each marker) ==\n'
  // src: vvaharness/skills/injection/probe.sh:84-84
  count("parameter placeholders (?, :name, \$1)")
  // pattern and arguments, verbatim: '(execute|query)\([^)]*(\?|:[a-z_]+|\$[0-9])'
  // src: vvaharness/skills/injection/probe.sh:85-85
  count("shlex.quote / escapeshellarg / Shellwords")
  // pattern and arguments, verbatim: 'shlex\.quote|escapeshellarg|Shellwords|quote_plus'
  // src: vvaharness/skills/injection/probe.sh:86-86
  count("allow-list vocabulary")
  // pattern and arguments, verbatim: '(allow|white)_?list|ALLOW(ED)?_(HOSTS|SCHEMES|ORIGINS)|in[[:space:]]+\{?["'"'"']'
  // src: vvaharness/skills/injection/probe.sh:87-87
  count("context escapers")
  // pattern and arguments, verbatim: 'escape\(|html\.escape|escapeHtml|quote_ident|urlencode|encodeURIComponent'
  // src: vvaharness/skills/injection/probe.sh:88-88
  count("XXE hardening flags")
  // pattern and arguments, verbatim: 'disallow-doctype-decl|FEATURE_SECURE_PROCESSING|external-general-entities|resolve_entities|no_network'
  // src: vvaharness/skills/injection/probe.sh:89-89
  count("canonical-path checks")
  // pattern and arguments, verbatim: 'realpath|resolve\(\)|abspath|normpath|Canonical'

  // src: vvaharness/skills/injection/probe.sh:91-92
  print "(end of sweep)"; exit 0
}
