// file: vvaharness/backends/harness/deepagents/force_verdict_only.py
// ForceVerdictOnly middleware: leaves tool_choice on auto while a session works; when the model stops without
// reporting, re-issues the call with only the outcome tool, forced. Installed only when force_verdict_only is set
// (S10 validation launcher and the remediation plugin runner); S4 sessions do not install it.

@executedBy(CODE) @role(rule_set)
class ForceVerdictOnly {

    // Per-instance cache of auto-binding model copies keyed by model identity, guarded by a lock.
    Map<Integer, ChatModel> auto = new Map();                                                            // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:79

    // The request model, which applies() already checked is a ForcingChatAnthropic (typed accessor only).
    ForcingChatAnthropic forcing(ModelRequest request) {                                                 // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:57
        return request.model;                                                                            // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:59
    }

    // The AI message a wrap_model_call handler result ends on, if any: unwrap an extended response, take the result list of a
    // ModelResponse (else the bare result as a one-item list), then its last element if that is an AIMessage.
    AIMessage reply(ModelCallResult result) {                                                            // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:62
        if (result instanceof ExtendedModelResponse) result = result.modelResponse;                      // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:64
        List messages = result instanceof ModelResponse ? result.result : [result];                      // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:66
        last = messages.nonEmpty() ? messages.last() : null;                                             // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:67
        return last instanceof AIMessage ? last : null;                                                  // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:68
    }

    // The model, copied once (per model identity, under the lock) with force_tool_choice false so tool_choice binds as auto.
    ChatModel autoModel(ForcingChatAnthropic model) {                                                    // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:86
        copy = auto.get(identity(model));                                                                // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:89
        if (copy == null) {
            copy = model.copyWith("force_tool_choice", false);
            auto.put(identity(model), copy);                                                             // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:91
        }
        return copy;
    }

    // Learn the request model when exc is its forced-tool_choice 400; true to re-issue on auto.
    boolean learnRejection(ModelRequest request, Exception exc) {                                        // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:105
        if (!isToolChoiceUnsupportedRejection(exc)) return false;                                        // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:107
        learnToolChoiceUnsupported(forcing(request).model);                                              // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:109
        return true;
    }

    // Whether the request forces an outcome (ToolStrategy) on a model that can bind auto.
    boolean applies(ModelRequest request) {
        return request.responseFormat instanceof ToolStrategy && request.model.forceToolChoice == true;  // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:98
    }

    ModelRequest unforced(ModelRequest request) {
        return request.overrideModel(autoModel(forcing(request)));                                        // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:103
    }

    // Re-issue after the reply with only the outcome tool, plus the report-now turn.
    ModelRequest forced(ModelRequest request, AIMessage reply, Theta θ) {
        List<String> names = request.responseFormat.schemaNames();                                       // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:116
        Counters.bump("deepagents_verdict_forced_after_auto");                                           // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:118
        return request.override(List.of(), concat(request.messages, reply, ForceVerdictPrompts.reportNow(names, θ))); // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:119
    }

    ModelResponse force(ModelRequest request, Handler handler) {
        if (UNSUPPORTED_MODELS.contains(request.model.id)) return handler.call(unforced(request));        // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:126
        try {
            return handler.call(request);                                                                // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:129
        } catch (Exception exc) {
            if (!learnRejection(request, exc)) throw exc;     // learned for the rest of the process        // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:131
        }
        return handler.call(unforced(request));                                                          // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:133
    }

    ModelResponse wrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        if (!applies(request)) return handler.call(request);                                             // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:155
        // no regular tools: already outcome-only (ModelCallBudget's final turn), forced as it is
        if (!request.tools.isEmpty()) {                                                                  // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:158
            ModelResponse result = handler.call(unforced(request));                                      // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:159
            AIMessage reply = reply(result);
            if (reply == null || !reply.toolCalls.isEmpty()) return result;   // still working           // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:161
            request = forced(request, reply, θ);                                                         // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:163
        }
        return force(request, handler);                                                                  // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:164
    }

    // Async counterpart of force: same unsupported-model shortcut, forced call, and learn-then-reissue on auto.
    ModelResponse aforce(ModelRequest request, Handler handler) {                                        // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:135
        if (UNSUPPORTED_MODELS.contains(forcing(request).model)) return await handler.call(unforced(request)); // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:141
        try {
            return await handler.call(request);                                                          // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:144
        } catch (Exception exc) {
            if (!learnRejection(request, exc)) throw exc;                                                // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:146
        }
        return await handler.call(unforced(request));                                                    // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:148
    }

    // Async counterpart of wrapModelCall.
    ModelResponse awrapModelCall(ModelRequest request, Handler handler, Theta θ) {                       // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:166
        if (!applies(request)) return await handler.call(request);                                       // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:173
        if (!request.tools.isEmpty()) {                                                                  // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:174
            ModelResponse result = await handler.call(unforced(request));                                // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:175
            AIMessage reply = reply(result);
            if (reply == null || !reply.toolCalls.isEmpty()) return result;                              // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:177
            request = forced(request, reply, θ);                                                         // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:179
        }
        return aforce(request, handler);                                                                 // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:180
    }
}

@executedBy(MODEL) @role(prompt)
class ForceVerdictPrompts {

    Prompt reportNow(List<String> toolNames, Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.force_verdict_only.report_now_message"]);          // "You have finished working. Report your outcome NOW by calling <tools>" // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:52
        p.context(toolNames);
        p.rule(θ["p.force_verdict_only.other_tools_withdrawn"]);       // "Every other tool has been withdrawn." // src: vvaharness/backends/harness/deepagents/force_verdict_only.py:53
        return p;
    }
}
