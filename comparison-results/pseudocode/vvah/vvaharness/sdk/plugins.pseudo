// What an outside plugin implements (identity plus one Contribution) and how a scan receives a bounded, ordered PluginSet.

@executedBy(CODE) @role(types)
record PluginInfo(String name, String version, int priority) {
    // priority defaults to 100 (lower runs first). Frozen dataclass; two plugins may not share a name.
}

@executedBy(CODE) @role(types)
record Contribution(List<GraphEnricher> enrichers, Map<String, ToolFactory> graphTools, List<SubagentDefinition> subagents) {
    // Every field optional (empty tuple, empty mapping, empty tuple) so a plugin fills only its seams.
}

@executedBy(CODE) @role(types)
interface VvahPlugin {
    // Protocol, runtime-checkable: info() yields identity and ordering, contribute() yields everything the plugin adds.
    PluginInfo info();
    Contribution contribute();
}

@executedBy(CODE) @role(types)
interface GraphEnricher {
    // Re-exported from context_graph_sdk.plugins; defined outside this repo.
}

@executedBy(CODE) @role(step) @stage("S0")
class Plugins {

    int MAX_PLUGINS = θ["code.sdk.plugins.max_plugins"];                                             // src: vvaharness/sdk/plugins.py:31
    int MAX_PLUGIN_GRAPH_TOOLS = θ["code.sdk.plugins.max_plugin_graph_tools"];                       // src: vvaharness/sdk/plugins.py:32
    int MAX_NAME_LENGTH = θ["code.sdk.plugins.max_name_length"];                                     // src: vvaharness/sdk/plugins.py:33

    // PluginInfo.__post_init__: rejects an unnamed or unversioned plugin and an over-long name.
    void postInitPluginInfo(PluginInfo info, Theta θ) {
        if (info.name.isEmpty() || info.version.isEmpty()) throw new ValueError("plugin name and version are required"); // src: vvaharness/sdk/plugins.py:41
        if (info.name.length() > θ["code.sdk.plugins.max_name_length"]) throw new ValueError("plugin name too long"); // src: vvaharness/sdk/plugins.py:43
    }

    // PluginInfo.ordering_key: priority then name, so a set has one deterministic order.
    Tuple orderingKey(PluginInfo info) {
        return Tuple.of(info.priority, info.name);                                                   // src: vvaharness/sdk/plugins.py:52
    }

    // Contribution.merge: this contribution followed by other; graph-tool name collisions raise.
    Contribution merge(Contribution self, Contribution other) {
        Set clashes = self.graphTools.keys().intersect(other.graphTools.keys());                     // src: vvaharness/sdk/plugins.py:65
        if (!clashes.isEmpty()) throw new ValueError("two plugins register the same graph tool");    // src: vvaharness/sdk/plugins.py:70
        return new Contribution(self.enrichers.concat(other.enrichers), Map.merge(self.graphTools, other.graphTools), self.subagents.concat(other.subagents)); // enrichers and subagents concatenated in order // src: vvaharness/sdk/plugins.py:75
    }

    // Conforming, name-unique plugins in deterministic order, or a raised ValueError / TypeError.
    List<VvahPlugin> validated(List<Object> plugins, Theta θ) {
        if (plugins.size() > θ["code.sdk.plugins.max_plugins"]) throw new ValueError("too many plugins"); // src: vvaharness/sdk/plugins.py:92
        Set<String> seen = new HashSet();
        List<VvahPlugin> checked = new ArrayList();
        for (Object plugin : plugins) {                                                              // src: vvaharness/sdk/plugins.py:96
            if (!(plugin instanceof VvahPlugin)) throw new TypeError("not a VvahPlugin");            // src: vvaharness/sdk/plugins.py:99
            String name = plugin.info().name;
            if (seen.contains(name)) throw new ValueError("duplicate plugin name");                  // src: vvaharness/sdk/plugins.py:102
            seen.add(name);
            checked.add(plugin);
        }
        return checked.sortedBy(p -> orderingKey(p.info()));                                         // priority, then name // src: vvaharness/sdk/plugins.py:106
    }
}

@executedBy(CODE) @role(step) @stage("S0")
class PluginSet {
    List<VvahPlugin> plugins;
    Contribution contribution;

    // Constructor: validates, orders and merges plugins, raising rather than silently dropping any.
    PluginSet(List<Object> input, Theta θ) {
        this.plugins = Plugins.validated(input, θ);                                                  // src: vvaharness/sdk/plugins.py:115
        Contribution merged = new Contribution(List.of(), Map.of(), List.of());                      // src: vvaharness/sdk/plugins.py:116
        for (VvahPlugin plugin : this.plugins) merged = Plugins.merge(merged, plugin.contribute());  // src: vvaharness/sdk/plugins.py:117
        if (merged.graphTools.size() > θ["code.sdk.plugins.max_plugin_graph_tools"]) throw new ValueError("too many plugin graph tools"); // src: vvaharness/sdk/plugins.py:119
        this.contribution = merged;                                                                  // src: vvaharness/sdk/plugins.py:121
    }

    int len() {
        return plugins.size();                                                                       // src: vvaharness/sdk/plugins.py:122
    }

    boolean bool() {
        return !plugins.isEmpty();                                                                   // True when this set contributes anything // src: vvaharness/sdk/plugins.py:126
    }

    List<String> names() {
        return plugins.map(p -> p.info().name);                                                      // contribution order // src: vvaharness/sdk/plugins.py:131
    }

    Contribution contribution() {
        return contribution;                                                                         // enrichers run in this order and tools keep these names // src: vvaharness/sdk/plugins.py:58
    }

    List<String> installGraphTools(Theta θ) {
        CodegraphTools.clearPluginGraphTools();                                                      // set becomes the only registered one // src: vvaharness/sdk/plugins.py:140
        CodegraphTools.registerGraphTools(contribution.graphTools, θ);                         // real name register_graph_tools // src: vvaharness/sdk/plugins.py:142
        return contribution.graphTools.keys();                                                       // src: vvaharness/sdk/plugins.py:144
    }
}
