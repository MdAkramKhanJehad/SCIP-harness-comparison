// file: vulnhunter-fix/vulnhunter_fix/delivery.py
// Delivery-time honesty guards (hand-wave, tier/residual consistency), Residual Risk and verification-table
// renderers, Draft-state rule, and the masked branch-name / idempotency-key helpers used by implement/plan prompts.

@executedBy(CODE) @role(types)
enum HonestyGuardError { HAND_WAVE_RESIDUAL, EMPTY_RESIDUAL, FULL_TIER_WITH_RESIDUALS }

// Exception hierarchy: HonestyGuardError is the base (Exception); the three subclasses below are what the guards raise.
// The enum above names the same three outcomes; each record carries the exception message.
@executedBy(CODE) @role(types)
record HandWaveResidualError(String message) { }         // src: vulnhunter-fix/vulnhunter_fix/delivery.py:83 (REQ-HON-006: residual entry matches the hand-wave regex)

@executedBy(CODE) @role(types)
record EmptyResidualError(String message) { }            // src: vulnhunter-fix/vulnhunter_fix/delivery.py:87 (REQ-HON-007: non-FULL tier with empty residual_vectors)

@executedBy(CODE) @role(types)
record FullTierWithResidualsError(String message) { }    // src: vulnhunter-fix/vulnhunter_fix/delivery.py:91 (result-schema R-2: FULL tier with non-empty residual_vectors)

@executedBy(CODE) @role(types)
record VerificationRowInput(int index, String vulnId, String statedClosed, String testReal, String failClosed,
                            String residualDoc, String sweepOk, List<String> graphCallers, List<String> routedCallers,
                            String sidecarConfidence) { }

@executedBy(CODE) @role(rule_set) @stage("fix")
class Delivery {

    // ---- constants ----

    List<String> handWavePatterns(Theta θ) {
        List<String> pats = new List();
        pats.addAll(θ["p.residual-risk-rules.r3_hand_wave_guard"]);                 // src: vulnhunter-fix/vulnhunter_fix/delivery.py:34
        pats.addAll(θ["code.vulnhunter_fix.delivery.vague_assurance_patterns"]);      // src: vulnhunter-fix/vulnhunter_fix/delivery.py:37
        return pats;
    }

    Regex handWaveRe(Theta θ) {
        return Regex.union(escapeAll(handWavePatterns(θ)), IGNORECASE);              // src: vulnhunter-fix/vulnhunter_fix/delivery.py:40
    }

    Map<String, String> tierOneLiners() {
        return Map.of("MITIGATION", "partially blocked; residual exposure remains",  // src: vulnhunter-fix/vulnhunter_fix/delivery.py:45
                      "WORKAROUND", "not blocked; a compensating control was applied instead"); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:46
    }

    List<String> safePhrasePatterns(Theta θ) {
        // byte-compared against scripts/check-severity-mask.py by safe-phrase-sync-lint.py in CI
        return θ["p.severity-mask-rule.safe_phrase_list"];                          // src: vulnhunter-fix/vulnhunter_fix/delivery.py:54
    }

    List<String> verificationTableHeaders(Theta θ) {
        return θ["p.verification-table-rules.column_headers"];                      // src: vulnhunter-fix/vulnhunter_fix/delivery.py:66
    }

    // ---- guards ----

    void checkHandWave(List<String> residualVectors, Theta θ) {
        if (!θ["p.deliver.honesty_guard_hand_wave"]) return;                         // src: vulnhunter-fix/vulnhunter_fix/delivery.py:95
        for (String entry : residualVectors) {                                       // src: vulnhunter-fix/vulnhunter_fix/delivery.py:100
            if (handWaveRe(θ).search(entry)) throw HonestyGuardError.HAND_WAVE_RESIDUAL; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:101
        }
    }

    void checkTierResidualConsistency(String tier, List<String> residualVectors, Theta θ) {
        boolean isFull = tier == "FULL";                                             // src: vulnhunter-fix/vulnhunter_fix/delivery.py:113
        boolean hasResiduals = !residualVectors.isEmpty();                           // src: vulnhunter-fix/vulnhunter_fix/delivery.py:114
        if (θ["p.residual-risk-rules.r2_empty_when_full"] && isFull && hasResiduals) throw HonestyGuardError.FULL_TIER_WITH_RESIDUALS; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:115
        if (θ["p.residual-risk-rules.r1_non_empty_when_not_full"] && !isFull && !hasResiduals) throw HonestyGuardError.EMPTY_RESIDUAL; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:120
    }

    // ---- renderers ----

    String renderResidualRiskSection(String vulnId, String tier, List<String> residualVectors, Integer issueNumber, Theta θ) {
        checkTierResidualConsistency(tier, residualVectors, θ);                      // src: vulnhunter-fix/vulnhunter_fix/delivery.py:134
        if (tier == "FULL") return "";                                               // src: vulnhunter-fix/vulnhunter_fix/delivery.py:135
        checkHandWave(residualVectors, θ);                                           // src: vulnhunter-fix/vulnhunter_fix/delivery.py:137
        String bullets = residualVectors.map(e -> "- " + e).join("\n");              // src: vulnhunter-fix/vulnhunter_fix/delivery.py:139
        String oneLiner = tierOneLiners().getOrDefault(tier, "not fully closed");    // src: vulnhunter-fix/vulnhunter_fix/delivery.py:140
        String issueRef = issueNumber != null ? " (see #" + issueNumber + ")" : "";  // src: vulnhunter-fix/vulnhunter_fix/delivery.py:141
        return "## Residual Risk ... ships as **" + tier + "** ... " + oneLiner + issueRef + bullets; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:142
    }

    String renderPrBodyWithResiduals(String vulnId, String tier, List<String> residualVectors, String baseBody, Theta θ) {
        String section = renderResidualRiskSection(vulnId, tier, residualVectors, null, θ); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:158
        if (section.isEmpty()) return baseBody;                                      // src: vulnhunter-fix/vulnhunter_fix/delivery.py:159
        if (baseBody.isEmpty()) return section;                                      // src: vulnhunter-fix/vulnhunter_fix/delivery.py:161
        return baseBody.rstrip() + "\n\n" + section;                                 // src: vulnhunter-fix/vulnhunter_fix/delivery.py:163
    }

    boolean prDraftStateForTier(String tier, Theta θ) {
        // WORKAROUND opens Draft, FULL and MITIGATION open Ready
        return θ["p.deliver.draft_state_by_tier"] && tier == θ["p.residual-risk-rules.r8_workaround_draft"]; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:168
    }

    // ---- verification table ----

    String column7Cell(List<String> graphCallers, List<String> routedCallers, String sidecarConfidence, Theta θ) {
        Set<String> routed = Set.of(routedCallers);                                  // src: vulnhunter-fix/vulnhunter_fix/delivery.py:181
        List<String> graph = graphCallers;                                           // src: vulnhunter-fix/vulnhunter_fix/delivery.py:182
        if (graph.isEmpty()) return "n/a";                                           // src: vulnhunter-fix/vulnhunter_fix/delivery.py:183
        boolean superset = routed.containsAll(graph);
        if (θ["p.verification-table-rules.col7_superset_for_yes"] && !superset
            && (!θ["code.vulnhunter_fix.delivery.col7_superset_check_high_confidence_only"] || sidecarConfidence == "high")) return "no"; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:185
        int total = graph.size();                                                    // src: vulnhunter-fix/vulnhunter_fix/delivery.py:188
        List<String> ordered = graph.sorted();                                       // src: vulnhunter-fix/vulnhunter_fix/delivery.py:189
        String anno = (θ["p.remediation-rigor.grep_fallback_annotation_required"] && sidecarConfidence == "low") ? " (grep_fallback)" : ""; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:192
        int cap = θ["p.verification-table-rules.col7_truncation_threshold"];        // src: vulnhunter-fix/vulnhunter_fix/delivery.py:190
        if (total <= cap) {                                                          // src: vulnhunter-fix/vulnhunter_fix/delivery.py:190
            return ("yes" + anno + " " + ordered.map(c -> "(" + c + ")").join(" ")).strip(); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:193
        }
        List<String> head = ordered.subList(0, cap);                                 // src: vulnhunter-fix/vulnhunter_fix/delivery.py:195
        int remaining = total - cap;                                                 // src: vulnhunter-fix/vulnhunter_fix/delivery.py:196
        return ("yes" + anno + " " + head.map(c -> "(" + c + ")").join(" ") + " ... " + remaining + " more via callers_of()").strip(); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:199
    }

    String deriveVerdict(List<String> cells, Theta θ) {
        // cells = statedClosed, testReal, failClosed, residualDoc, callersCovered, sweepOk
        // isYes = startswith "yes"; isNo = == "no"; isNa = in ("n/a", "na")
        if (!θ["p.verification-table-rules.verdict_mechanically_computed"]) return "";
        if (isNo(cells[0]) && θ["p.verification-table-rules.needs_rework_vector_not_closed"]) return "NEEDS_REWORK — stated vector not closed"; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:215
        if (isNo(cells[1]) && θ["p.verification-table-rules.needs_rework_test_not_real_attack"]) return "NEEDS_REWORK — test does not exercise real attack"; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:217
        if (isNo(cells[3]) && θ["p.verification-table-rules.needs_rework_missing_residual_docs"]) return "NEEDS_REWORK — non-FULL tier missing residual documentation"; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:219
        if (isYes(cells[0]) && isYes(cells[1]) && isYes(cells[2]) && yesOrNa(cells[3]) && yesOrNa(cells[4]) && yesOrNa(cells[5])) return θ["p.verification-table-rules.verdict_full_row"]; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:223
        if (isYes(cells[0]) && isYes(cells[1]) && isYes(cells[2]) && isYes(cells[3])) return θ["p.verification-table-rules.verdict_mitigation_row"]; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:226
        if (isYes(cells[0]) && isYes(cells[1]) && isNo(cells[2]) && isYes(cells[3])) return θ["p.verification-table-rules.verdict_workaround_row"]; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:229
        return "NEEDS_REWORK";                                                       // src: vulnhunter-fix/vulnhunter_fix/delivery.py:231
    }

    boolean isYes(String v) {
        return v.strip().lower().startsWith("yes");                                  // src: vulnhunter-fix/vulnhunter_fix/delivery.py:207
    }

    boolean isNo(String v) {
        return v.strip().lower() == "no";                                            // src: vulnhunter-fix/vulnhunter_fix/delivery.py:210
    }

    boolean yesOrNa(String v) {
        return isYes(v) || List.of("n/a", "na").contains(v.strip().lower());         // src: vulnhunter-fix/vulnhunter_fix/delivery.py:222
    }

    String renderVerificationRow(int index, String vulnId, List<String> cells6, List<String> graphCallers, List<String> routedCallers, String sidecarConfidence, Theta θ) {
        String col7 = column7Cell(graphCallers, routedCallers, sidecarConfidence, θ); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:243
        List<String> data = List.of(cells6[0], cells6[1], cells6[2], cells6[3], col7, cells6[4]); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:244
        String verdict = deriveVerdict(data, θ);                                     // src: vulnhunter-fix/vulnhunter_fix/delivery.py:245
        return "| " + List.of(index, vulnId, data, verdict).join(" | ") + " |";      // src: vulnhunter-fix/vulnhunter_fix/delivery.py:246
    }

    String renderVerificationTable(List<VerificationRowInput> rows, Theta θ) {
        String header = "| " + verificationTableHeaders(θ).join(" | ") + " |";       // src: vulnhunter-fix/vulnhunter_fix/delivery.py:257
        List<String> body = new List();
        for (VerificationRowInput r : rows) {                                        // src: vulnhunter-fix/vulnhunter_fix/delivery.py:259
            // missing cells default to "n/a"; missing confidence defaults to "high"
            body.add(renderVerificationRow(r.index, r.vulnId, List.of(r.statedClosed, r.testReal, r.failClosed, r.residualDoc, r.sweepOk, ""),
                                           r.graphCallers, r.routedCallers, r.sidecarConfidence, θ)); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:271
        }
        return List.of(header, "| --- ... |", body).join("\n");                     // src: vulnhunter-fix/vulnhunter_fix/delivery.py:275
    }

    // ---- branch naming / idempotency ----

    String cweToDescriptor(String cwe, Theta θ) {
        Match m = Regex.match("CWE-(\\d+)$", cwe);                                   // src: vulnhunter-fix/vulnhunter_fix/delivery.py:323
        if (m == null) return "general-hardening";                                   // src: vulnhunter-fix/vulnhunter_fix/delivery.py:325
        Map<Integer, String> map = θ["code.vulnhunter_fix.delivery.cwe_descriptor_map"]; // src: vulnhunter-fix/vulnhunter_fix/delivery.py:286
        return map.getOrDefault(int(m.group(1)), "general-hardening");               // src: vulnhunter-fix/vulnhunter_fix/delivery.py:326
    }

    String computeIdempotencyKey(String location, String cwe, String rootCause) {
        // primary CWE = first CWE-N match, as in scripts/parse_results.py
        Match m = Regex.search("CWE-\\d+", cwe);                                     // src: vulnhunter-fix/vulnhunter_fix/delivery.py:339
        String primary = m != null ? m.group(0) : "";                                // src: vulnhunter-fix/vulnhunter_fix/delivery.py:340
        return sha256(location + "|" + primary + "|" + rootCause).hex().substring(0, 16); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:342 (p.idempotency-key-rule.key_derivation)
    }

    String computeMaskedBranchName(String cwe, String idempotencyKey, Theta θ) {
        // implement.md states the pattern and descriptor set; the code hard-codes them here
        String descriptor = cweToDescriptor(cwe, θ);                                 // src: vulnhunter-fix/vulnhunter_fix/delivery.py:353
        String keyPrefix = idempotencyKey.substring(0, θ["code.vulnhunter_fix.delivery.branch_key_prefix_len"]); // src: vulnhunter-fix/vulnhunter_fix/delivery.py:354
        return "fix/code-quality-" + descriptor + "-" + keyPrefix;                   // src: vulnhunter-fix/vulnhunter_fix/delivery.py:355
    }
}
