// file: vvaharness/evidence/_grouping.py
// Breadth-before-depth selection shared by manifest and config-rep discovery:
// one item per group per round, so every group is represented before any group gets a second item.

@executedBy(CODE) @role(step) @stage("S2")
class Grouping {

    <T> List<Pair<String, T>> roundRobinSelect(Map<String, List<T>> groups, int maxTotal, List<String> keys) {
        List<String> orderedKeys = (keys != null) ? keys : groups.keys();                        // src: vvaharness/evidence/_grouping.py:28
        List<List<T>> rows = zipLongest(orderedKeys.map(k -> groups.get(k)));                    // src: vvaharness/evidence/_grouping.py:29
        List<Pair<String, T>> selected = new List();
        for (List<T> row : rows) {                                                               // src: vvaharness/evidence/_grouping.py:31
            for (int i = 0; i < orderedKeys.size(); i++) {                                       // src: vvaharness/evidence/_grouping.py:32
                if (row.get(i) != null) selected.add(new Pair(orderedKeys.get(i), row.get(i)));  // src: vvaharness/evidence/_grouping.py:33
            }
            if (selected.size() >= maxTotal) break;                                              // src: vvaharness/evidence/_grouping.py:34
        }
        return selected.head(maxTotal);                                                          // src: vvaharness/evidence/_grouping.py:36
    }
}
