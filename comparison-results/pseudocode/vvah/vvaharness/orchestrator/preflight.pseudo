    Map<Tuple, Pair<Object, List<String>>> probeTargets(Config cfg, Set<String> skipRoles, Theta θ) {
        Map<Tuple, Pair<Object, List<String>>> targets = new Map();                                         // src: vvaharness/orchestrator/preflight.py:669
        for (Role r : ConfigPaths.iterModelRoles(cfg)) {                                                    // src: vvaharness/orchestrator/preflight.py:670
