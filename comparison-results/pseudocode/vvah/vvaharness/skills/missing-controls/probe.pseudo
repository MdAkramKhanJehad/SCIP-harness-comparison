// file: vvaharness/skills/missing-controls/probe.sh
// Read-only absent-control probe: (1) enumerate the sites each control belongs to, (2) where each control
// is actually present, (3) posture holes that are usually findings on sight. Capped per section; exits 0.

@executedBy(CODE) @role(tool) @stage("S4")
class MissingControlsProbe {

    String run(String root, Theta θ) {
        Out out = new Out();
        int cap = Env.getInt("MC_PROBE_CAP", 12);                                                   // src: vvaharness/skills/missing-controls/probe.sh:21
        out.line("### MISSING-CONTROLS PROBE root=" + root);                                         // src: vvaharness/skills/missing-controls/probe.sh:91
        // --- SITES: enumerate these, then judge each ---
        cap = 15;                                                                                    // src: vvaharness/skills/missing-controls/probe.sh:94
        for (String s : θ["p.skill_missing-controls.probe_site_enumeration"]) {                     // src: vvaharness/skills/missing-controls/probe.sh:98
            if (s.equals("seed/fixture files") || s.equals("config and deployment files")) filesOnly(root, s, out); // src: vvaharness/skills/missing-controls/probe.sh:116
            else if (s.equals("all route/handler sites") || s.equals("cookie write sites") || s.equals("session/token config")) scan(root, s, Patterns.of(s), null, cap, out); // src: vvaharness/skills/missing-controls/probe.sh:98
            else scan(root, s, Patterns.ROUTE_OR_STORAGE(s), Patterns.keyword(s), cap, out);        // scan2: site AND keyword  // src: vvaharness/skills/missing-controls/probe.sh:100
        }
        // --- CONTROLS: where each is actually present (cap 6) ; --- POSTURE HOLES (cap 12)
        for (String c : θ["p.skill_missing-controls.probe_control_presence_and_posture"]) {         // src: vvaharness/skills/missing-controls/probe.sh:128
            int capHere = Patterns.isPostureHole(c) ? 12 : 6;                                        // src: vvaharness/skills/missing-controls/probe.sh:124
            scan(root, c, Patterns.of(c), null, capHere, out);
        }
        out.line("### END MISSING-CONTROLS PROBE");                                                  // src: vvaharness/skills/missing-controls/probe.sh:162
        return out.exit0();
    }

    void scan(String root, String label, String pat, String pat2, int cap, Out out) {
        out.section(label);
        List<String> hits = Grep.rEn(pat, root, Excludes.MC);                                        // src: vvaharness/skills/missing-controls/probe.sh:37
        if (pat2 != null) hits = hits.filter(h -> h.matchesIgnoreCase(pat2));                        // src: vvaharness/skills/missing-controls/probe.sh:58
        if (hits.isEmpty()) { out.line("(none)"); return; }
        out.lines(hits.head(cap).map(h -> h.truncate(140)));                                         // src: vvaharness/skills/missing-controls/probe.sh:42
        if (hits.size() > cap) out.line("... hits total, showing cap - grep this pattern yourself for the rest"); // src: vvaharness/skills/missing-controls/probe.sh:43
    }

    void filesOnly(String root, String label, Out out) {
        // existence is the answer, not the lines
        List<String> files = Grep.filesMatching(Patterns.of(label), Patterns.globsOf(label), Excludes.MC); // src: vvaharness/skills/missing-controls/probe.sh:77
        out.section(label);
        if (files.isEmpty()) out.line("(none)"); else out.lines(files.head(15));                    // src: vvaharness/skills/missing-controls/probe.sh:82
    }
}
