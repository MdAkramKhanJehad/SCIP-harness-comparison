# vvaharness/remediation_agent/select/topspec.py

Parses and resolves the `--top N` cap on how many findings are remediated, from the command-line flag or the profile key `step_remediate.top_n_findings`.

Source: `vvaharness/remediation_agent/select/topspec.py` (lines 1-83)
Executor: code
Called from: `vvaharness/remediation_agent/options.sudo` parse_options (parse_top_arg); `remediate.sudo` remediate and `orchestrator/scan.py` (resolve_top)

// src: vvaharness/remediation_agent/select/topspec.py:20-22
ALL_FINDINGS = "all"   // wildcard "no cap", distinct from null so a command-line "--top all" overrides a profile cap
_ALL_TOKENS = ["all", "*"]

// src: vvaharness/remediation_agent/select/topspec.py:25-38
fn _coerce_top_value(raw, source):executor=code {
  token = lower case of trimmed raw
  if (token in _ALL_TOKENS) return ALL_FINDINGS
  require token is an integer => throw ValueError("$source expects a positive integer or 'all'/'*', got $raw")
  require n > 0 => throw ValueError("$source must be a positive integer or 'all'/'*', got $n")
  return n
}

// src: vvaharness/remediation_agent/select/topspec.py:41-56
fn parse_top_arg(args):executor=code {
  // the first "--top VALUE" or "--top=VALUE" wins
  for each a in args {
    if (a == "--top") {
      require a following argument exists => throw ValueError("--top requires a value, e.g. --top 5 or --top all")
      raw = next argument; break
    }
    if (a starts with "--top=") { raw = text after "="; break }
  }
  if (raw == null) return null
  return _coerce_top_value(raw, source="--top")
}

// src: vvaharness/remediation_agent/select/topspec.py:59-73
fn cfg_top_n_findings(cfg):executor=code {
  if (cfg.step_remediate is absent) return null
  raw = knob("step_remediate.top_n_findings", default=null)
  if (raw == null) return ALL_FINDINGS   // block present, key absent: no cap
  try return _coerce_top_value(string(raw), source="top_n_findings");
  catch ValueError => return ALL_FINDINGS   // 0, negative or unparseable in a profile: no cap rather than a crash
}

// src: vvaharness/remediation_agent/select/topspec.py:76-83
fn resolve_top(cli_top, cfg):executor=code {
  chosen = if (cli_top != null) cli_top else cfg_top_n_findings(cfg)   // the command line wins
  return if (chosen is an integer) chosen else null   // null and ALL_FINDINGS both mean no cap
}
