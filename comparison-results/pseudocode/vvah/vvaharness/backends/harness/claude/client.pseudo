// file: vvaharness/backends/harness/claude/client.py
// ClaudeHarness: the Claude Agent SDK (cli/sdk via) implementation of Harness. One-shot and streaming sessions,
// persona-report collection (submit tool first, transcript scrape as fallback), whole-session deadline with interrupt + grace drain.

@executedBy(CODE) @role(backend)
class ClaudeClient {

    // PersonaReport model for the validated submission tool; null when the validation package is unavailable.
    Schema personaReportModel() {
        try {
            return importPersonaReport();                                                                 // src: vvaharness/backends/harness/claude/client.py:61
        } catch (Exception e) {
            return null;                                                                                 // src: vvaharness/backends/harness/claude/client.py:65
        }
    }

    // Fallback: scrape each subagent transcript's LAST assistant message for a fenced json block holding a report.
    List<Map<String, Object>> extractSdkPersonaReports(String sessionId, Path cwd, Theta θ) {
        if (!sdkHas("list_subagents")) return List.of();                                                 // src: vvaharness/backends/harness/claude/client.py:77
        try {
            List<String> agentIds = listSubagents(sessionId, cwd);                                       // src: vvaharness/backends/harness/claude/client.py:79
            List<Map<String, Object>> reports = new List();
            Set<Pair> seen = new Set();
            for (String agentId : agentIds) {                                                            // src: vvaharness/backends/harness/claude/client.py:82
                List<Message> messages = getSubagentMessages(sessionId, agentId, cwd);                   // src: vvaharness/backends/harness/claude/client.py:83
                if (messages.isEmpty()) continue;                                                        // src: vvaharness/backends/harness/claude/client.py:84
                for (Message msg : messages.reversed()) {                                                // src: vvaharness/backends/harness/claude/client.py:86
                    String text = firstTextBlock(msg);                                                   // src: vvaharness/backends/harness/claude/client.py:89
                    int start = text.find("```json");                                                 // src: vvaharness/backends/harness/claude/client.py:94
                    int end = start >= 0 ? text.find("```", start + 7) : -1;                         // src: vvaharness/backends/harness/claude/client.py:95
                    if (start < 0 || end <= start) continue;      // keep walking back to an earlier message // src: vvaharness/backends/harness/claude/client.py:96
                    try {
                        Map<String, Object> data = parseJson(text.substring(start + 7, end));            // src: vvaharness/backends/harness/claude/client.py:99
                        // a report must carry these keys; dedup by (persona, tracking_id)
                        if (data.keySet().containsAll(θ["code.backends.harness.claude.client.persona_report_required_keys"])) { // src: vvaharness/backends/harness/claude/client.py:100
                            Pair key = Pair.of(data.get("persona"), data.get("tracking_id"));            // src: vvaharness/backends/harness/claude/client.py:101
                            if (!seen.contains(key)) {
                                seen.add(key);
                                reports.add(data);                                                       // src: vvaharness/backends/harness/claude/client.py:104
                            }
                        }
                    } catch (JSONDecodeError e) {
                        // ignored
                    }
                    break;                                       // only the last json-bearing message counts // src: vvaharness/backends/harness/claude/client.py:107
                }
            }
            return reports;                                                                              // src: vvaharness/backends/harness/claude/client.py:111
        } catch (Exception e) {
            return List.of();                                                                            // src: vvaharness/backends/harness/claude/client.py:109
        }
    }

    // Submitted reports plus scraped ones for personas that did not submit.
    List<Map<String, Object>> mergePersonaReports(List<Map<String, Object>> submitted, List<Map<String, Object>> scraped) {
        Set<Pair> have = submitted.map(r -> Pair.of(r.get("persona"), r.get("tracking_id")));           // src: vvaharness/backends/harness/claude/client.py:119
        return submitted.plus(scraped.filter(r -> !have.contains(Pair.of(r.get("persona"), r.get("tracking_id"))))); // src: vvaharness/backends/harness/claude/client.py:120
    }

    Exception wrapSdkError(Exception e) {
        if (e instanceof ProcessError) return new HarnessProcessError(e.message, e.exitCode, e.stderr, false); // src: vvaharness/backends/harness/claude/client.py:126
        for (Pair p : ClaudeModels.sdkErrorMap()) {                                                      // src: vvaharness/backends/harness/claude/client.py:131
            if (p.first.isInstance(e)) return p.second.wrap(e.message);                                  // src: vvaharness/backends/harness/claude/client.py:133
        }
        return e;                                                                                        // src: vvaharness/backends/harness/claude/client.py:134
    }

    OneShotResult runOneshot(String prompt, OneShotOptions options, Theta θ) {
        if (options.cachePrefix != null) prompt = options.cachePrefix + prompt;   // no marker seam on the SDK path: prefix is content // src: vvaharness/backends/harness/claude/client.py:146
        ClaudeAgentOptions sdkOpts = ClaudeOptions.buildOneshotSdkOptions(options, θ);                   // src: vvaharness/backends/harness/claude/client.py:147
        OneShotResult r = new OneShotResult();
        try {
            SdkClient client = new SdkClient(sdkOpts);                                                   // src: vvaharness/backends/harness/claude/client.py:155
            client.query(prompt);                                                                        // src: vvaharness/backends/harness/claude/client.py:156
            for (Message message : client.receiveResponse()) {                                           // src: vvaharness/backends/harness/claude/client.py:157
                if (message instanceof ResultMessage) {                                                  // src: vvaharness/backends/harness/claude/client.py:158
                    r.subtype = message.subtype;
                    r.isError = message.isError;
                    r.resultText = message.result;
                    r.structured = Translate.validateStructured(message.structuredOutput, options.base.responseModel); // src: vvaharness/backends/harness/claude/client.py:162
                    r.usage = message.usage;
                    r.totalCostUsd = message.totalCostUsd;
                    TOKENS.add(r.usage, r.totalCostUsd);          // cumulative per session: added exactly once // src: vvaharness/backends/harness/claude/client.py:168
                    break;                                                                               // src: vvaharness/backends/harness/claude/client.py:169
                }
            }
        } catch (CLINotFoundError e) {
            throw new HarnessCLINotFoundError("Claude CLI binary not found");                            // src: vvaharness/backends/harness/claude/client.py:171
        } catch (ProcessError | CLIConnectionError | CLIJSONDecodeError | MessageParseError e) {
            throw wrapSdkError(e);                                                                       // src: vvaharness/backends/harness/claude/client.py:175
        }
        return r;                                                                                        // src: vvaharness/backends/harness/claude/client.py:177
    }

    Iterator<HarnessMessage> runStreaming(String prompt, StreamingOptions options, Theta θ) {
        Object factServer = null;
        List<String> factToolNames = List.of();
        PersonaReportCollector collector = null;
        if (!options.base.factToolSpecs.isEmpty()) {                                                     // src: vvaharness/backends/harness/claude/client.py:194
            // facts.build_fact_mcp: in-process MCP server + submit tool validated against PersonaReport
            Triple t = ClaudeFacts.buildFactTools(options.base.factToolSpecs, personaReportModel());       // src: vvaharness/backends/harness/claude/client.py:195
            factServer = t.first; factToolNames = t.second; collector = t.third;
        }
        ClaudeAgentOptions sdkOpts = ClaudeOptions.buildStreamingSdkOptions(options, factServer, factToolNames, θ); // src: vvaharness/backends/harness/claude/client.py:197
        if (options.cachePrefix != null) prompt = options.cachePrefix + prompt;                          // src: vvaharness/backends/harness/claude/client.py:201
        return gen(prompt, sdkOpts, options, collector, θ);                                              // src: vvaharness/backends/harness/claude/client.py:279
    }

    // Translate one SDK message; on the terminal result attach persona reports (collector first, scraper as fallback).
    List<HarnessMessage> translateMessage(Object message, StreamingOptions options, PersonaReportCollector collector, Theta θ) {
        List<HarnessMessage> out = new List();
        for (HarnessMessage translated : Translate.translate(message, options.base.responseModel)) {     // src: vvaharness/backends/harness/claude/client.py:206
            if (translated instanceof HarnessResult) {                                                   // src: vvaharness/backends/harness/claude/client.py:207
                List<Map<String, Object>> personaDicts = collector != null ? collector.reports() : List.of(); // src: vvaharness/backends/harness/claude/client.py:209
                int expected = options.agents.isEmpty() ? 1 : options.agents.size();                    // src: vvaharness/backends/harness/claude/client.py:210
                if (personaDicts.size() < expected && translated.sessionId != null) {                    // src: vvaharness/backends/harness/claude/client.py:211
                    personaDicts = mergePersonaReports(personaDicts, extractSdkPersonaReports(translated.sessionId, options.base.cwd, θ)); // src: vvaharness/backends/harness/claude/client.py:212
                }
                if (!personaDicts.isEmpty()) translated.state = Map.of("sdk_persona_reports", personaDicts); // src: vvaharness/backends/harness/claude/client.py:218
            }
            out.add(translated);
        }
        return out;
    }

    Iterator<HarnessMessage> gen(String prompt, ClaudeAgentOptions sdkOpts, StreamingOptions options, PersonaReportCollector collector, Theta θ) {
        boolean expired = false;                         // set only when OUR deadline fires          // src: vvaharness/backends/harness/claude/client.py:226
        try {
            SdkClient client = new SdkClient(sdkOpts);                                                   // src: vvaharness/backends/harness/claude/client.py:228
            client.query(prompt);                                                                        // src: vvaharness/backends/harness/claude/client.py:229
            if (options.timeout != null && options.timeout > 0) {                                        // src: vvaharness/backends/harness/claude/client.py:230
                double deadline = now() + options.timeout;                                               // src: vvaharness/backends/harness/claude/client.py:232
                Iterator<Message> it = client.receiveResponse();
                while (true) {
                    Message message;
                    try {
                        // a fresh timeout per next(): bounds only the await, never the yield to the caller
                        message = awaitUntil(it.next(), deadline);                                       // src: vvaharness/backends/harness/claude/client.py:241
                    } catch (StopIteration e) {
                        break;                                                                           // src: vvaharness/backends/harness/claude/client.py:243
                    } catch (TimeoutError e) {
                        if (!deadlineExpired(deadline)) throw e;   // an inner TimeoutError passes through  // src: vvaharness/backends/harness/claude/client.py:247
                        expired = true;                                                                  // src: vvaharness/backends/harness/claude/client.py:249
                        break;
                    }
                    for (HarnessMessage m : translateMessage(message, options, collector, θ)) yield(m);  // src: vvaharness/backends/harness/claude/client.py:251
                }
                if (expired) {
                    try { client.interrupt(); } catch (Exception e) { }                                  // src: vvaharness/backends/harness/claude/client.py:255
                    // grace drain so the interrupted session settles before the client closes
                    try {
                        drainFor(client.receiveResponse(), TIMEOUT_STOP_GRACE_SECONDS);   // backends/llm/models constant // src: vvaharness/backends/harness/claude/client.py:259
                    } catch (TimeoutError e) { }
                }
            } else {
                for (Message message : client.receiveResponse()) {                                       // src: vvaharness/backends/harness/claude/client.py:263
                    for (HarnessMessage m : translateMessage(message, options, collector, θ)) yield(m);  // src: vvaharness/backends/harness/claude/client.py:264
                }
            }
        } catch (CLINotFoundError e) {
            throw new HarnessCLINotFoundError("Claude CLI binary not found");                            // src: vvaharness/backends/harness/claude/client.py:267
        } catch (ProcessError | CLIConnectionError | CLIJSONDecodeError | MessageParseError e) {
            throw wrapSdkError(e);                                                                       // src: vvaharness/backends/harness/claude/client.py:271
        }
        if (expired) {
            // raised outside the client context so its exit already ran clean; VVAH-E008, non-halt
            throw callTimeoutError(options.base.graphName, "claude", options.timeout, options.base.effort); // backends/llm/models.call_timeout_error // src: vvaharness/backends/harness/claude/client.py:274
        }
        return null;
    }
}
