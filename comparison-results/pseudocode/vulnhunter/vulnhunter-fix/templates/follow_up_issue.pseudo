// file: vulnhunter-fix/templates/follow_up_issue.md
// Follow-up issue body, one per residual vector of a non-FULL fix (REQ-HON-010), deduped by a follow-up key marker.

@executedBy(CODE) @role(types)
record FollowUpIssueVars(String VULN_ID, int PARENT_ISSUE_NUMBER, String COMPLETENESS_TIER, String CWE, String RESIDUAL_TEXT,
                         String SUGGESTED_NEXT_STEP, String REPRO_BLOCK_OR_NONE, String FOLLOWUP_KEY) { }

@executedBy(MIXED) @role(prompt) @stage("fix")
class FollowUpIssue {

    Prompt run(FollowUpIssueVars v, Theta θ) {
        Prompt p = new Prompt();
        if (!θ["p.residual-risk-rules.r7_followup_issue_per_residual"]) return p;    // one issue per residual entry
        p.format("## Follow-up: Residual Vector — <VULN_ID>");                       // src: vulnhunter-fix/templates/follow_up_issue.md:1
        p.format(List.of("Parent finding: <VULN_ID> — see #<PARENT_ISSUE_NUMBER>", "Completeness tier applied", "CWE")); // src: vulnhunter-fix/templates/follow_up_issue.md:3
        p.context(θ["p.residual-risk-rules.r7_followup_body_contents"]);             // src: vulnhunter-fix/templates/follow_up_issue.md:7 (Residual Vector / Context / Suggested Next Step / Reproduction)
        // closure paths stated in Context: later fix bumps parent to FULL; risk acceptance recorded; scanner re-detects (dedup closes)
        p.rule("track the residual until fixed, risk-accepted, or re-detected as a distinct finding"); // src: vulnhunter-fix/templates/follow_up_issue.md:15
        p.rule("reproduce the parent PoC if known so the issue is actionable in isolation, else none"); // src: vulnhunter-fix/templates/follow_up_issue.md:29
        p.format(θ["code.templates.follow_up_issue.labels"]);                        // src: vulnhunter-fix/templates/follow_up_issue.md:36
        p.must(θ["p.residual-risk-rules.r7_followup_key"]);                          // src: vulnhunter-fix/templates/follow_up_issue.md:39 (vulnfix-followup-key marker)
        return p;
    }
}
