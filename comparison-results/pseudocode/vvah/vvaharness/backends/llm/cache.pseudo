// file: vvaharness/backends/llm/cache.py
// Prompt-cache policy shared by the cli/sdk/openai backends: which caching mechanism a route uses,
// whether cache_markers permits markers, and reporting of cache usage keys the parser does not cover.

@executedBy(CODE) @role(types)
enum PrefixCacheClass { BREAKPOINT, IMPLICIT, NONE }

@executedBy(CODE) @role(backend)
class Cache {

    // Margin on the ESTIMATE, not the floor: the estimator under-counts
    double CACHE_EST_MARGIN = θ["code.backends.llm.cache.est_margin"];                                    // src: vvaharness/backends/llm/cache.py:26
    // Falsey kill-switch spellings: unquoted `cache_markers: off` parses as False
    List<String> DISABLED_SPELLINGS = θ["code.backends.llm.cache.disabled_spellings"];                    // src: vvaharness/backends/llm/cache.py:29
    Set<String> ANTHROPIC_PARSED_CACHE_KEYS = Set.of("cache_creation_input_tokens", "cache_read_input_tokens", "cache_creation"); // src: vvaharness/backends/llm/cache.py:60

    /** The prompt-prefix caching mechanism a route's requests can use. */
    @src("vvaharness/backends/llm/cache.py:37")
    PrefixCacheClass prefixCacheClass(String via, String modelId, String provider) {
        if (via == "sdk") return BREAKPOINT;                                                                 // src: vvaharness/backends/llm/cache.py:40
        if (via == "openai") return IMPLICIT;                                                                // src: vvaharness/backends/llm/cache.py:42
        if (via == "deepagents") {                                                                           // src: vvaharness/backends/llm/cache.py:44
            if (ProviderRouting.routesToAnthropic(modelId, provider)) return BREAKPOINT;                     // src: vvaharness/backends/llm/cache.py:45
            return IMPLICIT;                                                                                 // src: vvaharness/backends/llm/cache.py:47
        }
        return NONE;                                                                                         // cli: no prefix caching hook // src: vvaharness/backends/llm/cache.py:48
    }

    /** Whether cfg's cache_markers switch permits this route to emit cache markers/hints. */
    @src("vvaharness/backends/llm/cache.py:51")
    boolean markersEnabled(Map cfg, Theta θ) {
        Object v = cfg.containsKey("cache_markers") ? θ["cache_markers"] : "on";                                // value pushed by preflight // src: vvaharness/backends/llm/cache.py:53
        if (v instanceof Boolean) return v;                                                                  // src: vvaharness/backends/llm/cache.py:55
        return !DISABLED_SPELLINGS.contains(v.toString().strip().lower());                                   // src: vvaharness/backends/llm/cache.py:56
    }

    /** Flag cache accounting reported under key names the Anthropic-shaped set does not cover. */
    @src("vvaharness/backends/llm/cache.py:65")
    void noteUnparsedCacheKeys(Map usage, String via) {
        reportUnparsedCacheKeys(usage, ANTHROPIC_PARSED_CACHE_KEYS, via, via);                               // src: vvaharness/backends/llm/cache.py:67
    }

    @src("vvaharness/backends/llm/cache.py:70")
    void reportUnparsedCacheKeys(Map usage, Set<String> parsed, String via, String label) {
        // without this a working cache reads 0/0 (tokens coerces missing keys to 0)
        List<String> keys = Tokens.unparsedCacheKeys(usage, parsed);                                         // src: vvaharness/backends/llm/cache.py:74
        Object note = Tokens.TOKENS.noteCacheUnparsed;                                                       // tolerate a stand-in with only add() // src: vvaharness/backends/llm/cache.py:76
        if (note != null && note.call(keys, via)) {                                                          // src: vvaharness/backends/llm/cache.py:77
            Console.write("note: usage reports cache accounting under unparsed keys; counted in cache_unparsed"); // src: vvaharness/backends/llm/cache.py:78
        }
    }
}
