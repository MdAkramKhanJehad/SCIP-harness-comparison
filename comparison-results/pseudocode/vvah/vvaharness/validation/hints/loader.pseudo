// file: vvaharness/validation/hints/loader.py
// Loads per-CWE adversarial bypass hints from the operator-supplied inputs/validator_hints.yaml.
// No bundled fallback: absent file = no hints; malformed = warn and ignore.

@executedBy(CODE) @role(io) @stage("S11")
class Loader {

    CweHints REGISTRY = null;                                                                        // lazy singleton  // src: vvaharness/validation/hints/loader.py:77

    Path hintsPath(Theta θ) {
        return Path.cwd().resolve(θ["code.validation.hints.loader.hints_path"]);                    // inputs/validator_hints.yaml, cwd-relative  // src: vvaharness/validation/hints/loader.py:32
    }

    Map<String, Object> parseHints(Path path) {
        Object loaded;
        try {
            loaded = Yaml.safeLoad(path.readText());                                                 // src: vvaharness/validation/hints/loader.py:38
        } catch (OSError | YAMLError e) {
            return null;                                                                             // src: vvaharness/validation/hints/loader.py:40
        }
        return loaded instanceof Map ? loaded : new Map();                                           // src: vvaharness/validation/hints/loader.py:41
    }

    Map<String, Object> resolveRaw(Theta θ) {
        Path path = hintsPath(θ);                                                                    // src: vvaharness/validation/hints/loader.py:46
        if (!path.exists()) return new Map();                                                        // optional operator input  // src: vvaharness/validation/hints/loader.py:47
        Map<String, Object> raw = parseHints(path);                                                  // src: vvaharness/validation/hints/loader.py:49
        if (raw == null) {
            Log.print("validate: ignoring malformed hints file");                                    // src: vvaharness/validation/hints/loader.py:51
            return new Map();                                                                        // src: vvaharness/validation/hints/loader.py:55
        }
        return raw;
    }

    CweHints load(Theta θ) {
        Map<String, Object> raw = resolveRaw(θ);                                                     // src: vvaharness/validation/hints/loader.py:69
        Map<String, List<String>> cleaned = new Map();
        for (Entry e : raw.entries()) {                                                              // src: vvaharness/validation/hints/loader.py:71
            if (e.key instanceof String && e.value instanceof List) cleaned.put(e.key.strip(), e.value.map(h -> str(h))); // src: vvaharness/validation/hints/loader.py:72
        }
        return new CweHints(cleaned);                                                                // src: vvaharness/validation/hints/loader.py:74
    }

    CweHints registry(Theta θ) {
        if (REGISTRY == null) REGISTRY = load(θ);                                                    // src: vvaharness/validation/hints/loader.py:83
        return REGISTRY;
    }

    List<String> hintsFor(String category, Theta θ) {
        CweHints reg = registry(θ);                                                                  // src: vvaharness/validation/hints/loader.py:90
        List<String> direct = reg.hints.get(category.strip());                                       // src: vvaharness/validation/hints/loader.py:91
        if (direct != null) return direct;                                                           // src: vvaharness/validation/hints/loader.py:93
        if (!θ["code.validation.hints.loader.cwe_prefix_fallback"]) return List.of();
        String prefix = category.split(":")[0].strip();                                              // "CWE-89: SQL Injection" -> "CWE-89"  // src: vvaharness/validation/hints/loader.py:95
        return reg.hints.getOrDefault(prefix, List.of());                                            // src: vvaharness/validation/hints/loader.py:96
    }
}

@executedBy(CODE) @role(types)
record CweHints(Map<String, List<String>> hints) { }
