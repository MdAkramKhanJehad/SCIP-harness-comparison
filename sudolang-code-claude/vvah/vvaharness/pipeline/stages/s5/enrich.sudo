# vvaharness/pipeline/stages/s5/enrich.py

Fills the fields Stage 4 cannot produce from the repository on disk: the real code snippet of the finding's span, and the sink and source evidence references (with provenance when synthesized). Also provides the path-safe, size-capped file cache that Stage 5 and Stage 6 share.

Source: `vvaharness/pipeline/stages/s5/enrich.py` (lines 1-137)
Executor: code
Called from: `vvaharness/pipeline/stages/s5/__init__.py` run; `FileCache` also from `vvaharness/pipeline/stages/s6_verify.py` _file_cache

// src: vvaharness/pipeline/stages/s5/enrich.py:122-137
fn enrich(f, cache, anchors, seeds, reanchorer?):executor=code {
  if (reanchorer != null) f = reanchorer.apply(f)   // s5/reanchor.sudo
  update = {}
  lines = cache.lines(f.file)
  if (lines != null && f.code_snippet is blank) {
    body = snippet(f, lines)
    if (body) update.code_snippet = body
  }
  update += refs(f, anchors, seeds)
  return copy of f with update (or f unchanged when update is empty)
}

// src: vvaharness/pipeline/stages/s5/enrich.py:27
MAX_SNIPPET_LINES = 40   // Stage 4 spans whole handlers, and the snippet rides in the checkpoint and the Stage 6 prompt

// src: vvaharness/pipeline/stages/s5/enrich.py:76-84
fn snippet(f, lines):executor=code {
  start = max(1, f.line_start)
  if (start > length(lines)) return ""
  want = max(start, f.line_end or start)
  end = min(want, start + 40 - 1, length(lines))
  body = lines start..end joined by newlines
  return if (want > end) body + "\n… (span continues past line $end)" else body
}

// src: vvaharness/pipeline/stages/s5/enrich.py:106-119
fn refs(f, anchors, seeds):executor=code {
  sink = (f.sink_ref trimmed) or "${f.file}:${max(1, f.line_start)}"                  // _sink_ref
  origin = _origin_ref(f, sink, anchors, seeds)
  empty = which of [sink_ref, source_ref] are blank on f
  filled = names in empty whose new value is non-empty
  if (filled is empty) return {}
  // provenance only for synthesized values; a source_ref that stays empty is not marked backfilled
  return { each name in empty: new value or null, backfilled_refs: sorted(f.backfilled_refs union filled) }
}

// src: vvaharness/pipeline/stages/s5/enrich.py:92-103
fn _origin_ref(f, sink, anchors, seeds):executor=code {
  if (f.source_ref trimmed) return it
  if (f.vuln_class == VulnClass.INFO_LEAK) return sink   // an information leak's origin is its sink
  near = anchors[f.file]
  if (near) return "${f.file}:" + the entry anchor line nearest f.line_start
  return best_source_from_seed(seeds[f.file]) or ""   // external to this batch: pipeline/callgraph_consumer
}

// src: vvaharness/pipeline/stages/s5/enrich.py:41-73
FileCache {
  root; max_bytes = max(1, max_kb) * 1024
  // src: :50-62
  fn _safe_path(rel):executor=code {
    require rel is not absolute => return null
    target = resolve(root / rel)
    require target is inside the resolved root => return null       // symlink escapes refused
    require target is a regular file && size <= max_bytes => return null   // stat first: opening a FIFO would block
    return target   // any OSError, ValueError or RuntimeError also returns null
  }
  // src: :64-68 — each file read at most once; a failure is cached as null too
  fn lines(rel):executor=code { return cached split_lines(read text with replacement) of _safe_path(rel), or null on OSError, ValueError or MemoryError }
  // src: :70-73
  fn line_count(rel):executor=code { return length(lines(rel)) or null }   // Stage 6's end-of-file gate
}
