// src: vvaharness/models/derive.py:37-57
_KIND_STATE = {   // an unvalidated attempt follows what the engine did
  edits_applied: "remediated", diff_proposed: "remediated", pull_request: "remediated",
  already_resolved: "remediated", no_action: "declined"
}
_DECISION_STATE = {   // a validated attempt follows the decision; inconclusive stays re-validatable
  fixed: "validated", partially_fixed: "failed", not_fixed: "failed", inconclusive: "open"
}
_CLOSING = ["false_positive", "accepted_risk", "not_applicable"]   // dispositions that close a case without a proven fix (policy_denied is not one)

// src: vvaharness/models/derive.py:60-66
fn verdict_state(verdict):executor=code {
  if (verdict.ticket != null) return "pending"
  if (verdict.disposition in _CLOSING) return "declined"
  return _DECISION_STATE[verdict.decision]
}

// src: vvaharness/models/derive.py:69-80
fn state_of(attempts):executor=code {
  if (attempts is empty) return "open"
  last = attempts[-1]   // the LAST attempt rules, not the best one ever seen
  return if (last.verdict == null) _KIND_STATE[last.remediation.kind] else verdict_state(last.verdict)
}

// src: vvaharness/models/derive.py:83-89
fn _readiness_for_score(score, policy):executor=code {
  if (score >= policy.ready_at) return "ready"                     // default 0.85
  if (score >= policy.conditional_at) return "ready_with_conditions"   // default 0.60
  return "not_ready"
}

// src: vvaharness/models/derive.py:92-110
_DECISION_READINESS = { fixed: "ready", partially_fixed: "ready_with_conditions", not_fixed: "not_ready", inconclusive: "not_ready" }
_RANK = { not_ready: 0, ready_with_conditions: 1, ready: 2 }
fn _lowest(...readiness):executor=code { return the member with the lowest _RANK }

// src: vvaharness/models/derive.py:113-122
fn merge_readiness_for(verdict, policy?):executor=code {
  ceiling = _DECISION_READINESS[verdict.decision]
  if (verdict.conditions is not empty) ceiling = _lowest(ceiling, "ready_with_conditions")
  if (verdict.score == null) return ceiling
  return _lowest(ceiling, _readiness_for_score(verdict.score, policy || ScoringPolicy()))
  // preserved: the docstring says a failed critical gate caps the ceiling, but this function never reads gates or policy.critical
}
