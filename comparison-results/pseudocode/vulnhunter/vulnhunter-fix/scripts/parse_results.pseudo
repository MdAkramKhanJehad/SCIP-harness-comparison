// file: vulnhunter-fix/scripts/parse_results.py
// Regex parser for a VulnHunter results directory: summary-table findings (fallback path; production uses a
// model extraction), per-finding detail, PoC / exploit-test file discovery, code smells, and vulnfix keys.

@executedBy(CODE) @role(io) @stage("fix")
class ParseResults {

    // parse.pseudo calls run(resultsPath)
    Map run(String resultsPath, Theta θ) {
        return parseResults(resultsPath, θ);
    }

    String primaryCwe(String cweString) {
        Match m = Regex.search("CWE-\\d+", cweString);                                                     // src: vulnhunter-fix/scripts/parse_results.py:30
        return m != null ? m.group(0) : "";
    }

    String computeVulnfixKey(String location, String cwe, String rootCause, Theta θ) {
        // θ["code.vulnfix_key"]: sha256(location|primary_cwe|root_cause)[:16]
        return Sha256.hex(location + "|" + primaryCwe(cwe) + "|" + rootCause).substring(0, 16);            // src: vulnhunter-fix/scripts/parse_results.py:42
    }

    List<Map> parseSummaryTable(String content) {
        // | VULN-N | title | CWE list | severity(+) | exploit_test | status |
        List<Map> findings = List.of();
        for (Match m : Regex.finditer("<summary row: VULN-\\d+ | title | CWE-... | \\w+\\+? | exploit | \\w+ >", content)) { // src: vulnhunter-fix/scripts/parse_results.py:56
            findings.add(Map.of("id", m.group(1), "title", m.group(2), "cwe", m.group(3), "severity", m.group(4), "exploit_test", m.group(5), "status", m.group(6))); // src: vulnhunter-fix/scripts/parse_results.py:65
        }
        return findings;
    }

    Map parseFindingDetail(String content, String vulnId) {
        Map detail = Map.of();
        Match match = Regex.searchDotall("##\\s*\\[?" + Regex.escape(vulnId) + "\\]?[:\\s]*(.+?)(?=\\n##\\s|\\Z)", content); // src: vulnhunter-fix/scripts/parse_results.py:80
        if (match == null) match = Regex.searchDotall("##\\s*" + Regex.escape(vulnId) + "[:\\s]*(.+?)(?=\\n##\\s|\\Z)", content); // src: vulnhunter-fix/scripts/parse_results.py:86
        if (match == null) return detail;                                                                  // src: vulnhunter-fix/scripts/parse_results.py:92
        String section = match.group(0);
        detail.putIfMatch("location", "\\*\\*Location\\*\\*\\s*\\|\\s*`?([^`|]+)`?", section);             // src: vulnhunter-fix/scripts/parse_results.py:97
        detail.putIfMatch("root_cause", "\\*\\*Root Cause\\*\\*\\s*\\|\\s*(.+)", section);                 // src: vulnhunter-fix/scripts/parse_results.py:101
        detail.putIfMatch("entry_point", "\\*\\*Entry Point\\*\\*\\s*\\|\\s*(.+)", section);               // src: vulnhunter-fix/scripts/parse_results.py:105
        detail.putIfMatch("data_flow", "\\*\\*Data Flow\\*\\*\\s*\\|\\s*(.+)", section);                   // src: vulnhunter-fix/scripts/parse_results.py:109
        Match fix = Regex.searchDotall("###\\s*Proposed Fix(.+?)(?=\\n###|\\Z)", section);                  // src: vulnhunter-fix/scripts/parse_results.py:113
        if (fix != null) detail.put("proposed_fix", Map.of("strategy", fix.fieldOrEmpty("Strategy"), "files_to_change", fix.fieldOrEmpty("Files to change"), "why", fix.fieldOrEmpty("Why this works"))); // src: vulnhunter-fix/scripts/parse_results.py:120
        return detail;
    }

    Map findRelatedFiles(Path resultsDir, String vulnId) {
        String num = vulnId.replace("VULN-", "");
        Map files = Map.of();
        // first match wins in each directory
        for (Path f : resultsDir.join("poc").iterdirIfExists()) {
            if (f.name.contains("VULN-" + num) || f.name.lower().contains("vuln_" + num)) {               // src: vulnhunter-fix/scripts/parse_results.py:137
                files.put("poc", f);
                break;
            }
        }
        for (Path f : resultsDir.join("exploit_tests").iterdirIfExists()) {
            if (f.name.lower().contains("vuln_" + num) || f.name.contains("VULN-" + num)) {               // src: vulnhunter-fix/scripts/parse_results.py:144
                files.put("exploit_test", f);
                break;
            }
        }
        return files;
    }

    Map<String, Map> discoverAllVulnFiles(Path resultsDir) {
        Map<String, Map> all = Map.of();
        for (Path f : resultsDir.join("poc").iterdirIfExists()) {
            Match m = Regex.searchIgnoreCase("VULN-(\\d+)", f.name);                                       // src: vulnhunter-fix/scripts/parse_results.py:161
            if (m != null) all.getOrCreate("VULN-" + m.group(1)).put("poc", f);
        }
        for (Path f : resultsDir.join("exploit_tests").iterdirIfExists()) {
            Match m = Regex.searchIgnoreCase("VULN-(\\d+)", f.name);                                       // src: vulnhunter-fix/scripts/parse_results.py:168
            if (m != null) all.getOrCreate("VULN-" + m.group(1)).put("exploit_test", f);
        }
        return all;
    }

    String extractSmellSection(String content, Theta θ) {
        // first heading matching a smell / observation variant; body runs to the next H2
        Match match = Regex.searchMultilineIgnoreCase(θ["code.fix.scripts.parse_results.smell_heading_variants"], content); // src: vulnhunter-fix/scripts/parse_results.py:184
        if (match == null) return "";                                                                      // src: vulnhunter-fix/scripts/parse_results.py:198
        String rest = content.substring(match.end());
        Match nextH2 = Regex.searchMultiline("^##\\s+\\S", rest);                                          // src: vulnhunter-fix/scripts/parse_results.py:201
        return nextH2 != null ? rest.substring(0, nextH2.start()) : rest;
    }

    List<Map> parseSmellsPerSectionFormat(String section) {
        List<Map> smells = List.of();
        List<Match> ms = Regex.finditerMultilineIgnoreCase("^###\\s+(?:Code\\s+Smell|Smell|Observation)\\s*\\d+\\s*[:.\\-]?\\s*(.+?)$", section); // src: vulnhunter-fix/scripts/parse_results.py:210
        for (int i = 0; i < ms.size(); i++) {
            String body = section.substring(ms.get(i).end(), i + 1 < ms.size() ? ms.get(i + 1).start() : section.length());
            Map smell = Map.of("title", ms.get(i).group(1).strip());
            // field labels: Location, Pattern, Risk if conditions change, Recommendation, Downgrade reason (first match per key)
            for (Pair lk : List.of(Pair.of("Location", "location"), Pair.of("Pattern", "pattern"), Pair.of("Risk if conditions change", "risk_if_conditions_change"), Pair.of("Recommendation", "recommendation"), Pair.of("Downgrade reason", "downgrade_reason"))) { // src: vulnhunter-fix/scripts/parse_results.py:223
                Match fm = Regex.searchMultiline("\\*\\*" + Regex.escape(lk.first) + "\\*\\*\\s*\\|\\s*(...)", body); // src: vulnhunter-fix/scripts/parse_results.py:232
                if (fm != null && !smell.containsKey(lk.second)) smell.put(lk.second, fm.group(1).strip().strip("`")); // src: vulnhunter-fix/scripts/parse_results.py:237
            }
            if (smell.get("location") != null || smell.get("pattern") != null) smells.add(smell);          // src: vulnhunter-fix/scripts/parse_results.py:239
        }
        return smells;
    }

    // nested helper col_idx: first of the candidate names (lowercased) found in the header, else -1
    int colIdx(List<String> header, List<String> names) {
        for (String n : names) {                                                                           // src: vulnhunter-fix/scripts/parse_results.py:260
            if (header.contains(n.lower())) return header.indexOf(n.lower());                              // src: vulnhunter-fix/scripts/parse_results.py:262
        }
        return -1;                                                                                         // src: vulnhunter-fix/scripts/parse_results.py:265
    }

    List<Map> parseSmellsTableFormat(String section) {
        List<Map> smells = List.of();
        List<String> lines = section.lines();
        Integer tableStart = null;
        for (int i = 0; i < lines.size(); i++) {
            if (lines.get(i).contains("Location") && lines.get(i).contains("Recommendation") && lines.get(i).strip().startsWith("|")) { // src: vulnhunter-fix/scripts/parse_results.py:251
                tableStart = i;
                break;
            }
        }
        if (tableStart == null) return smells;                                                             // src: vulnhunter-fix/scripts/parse_results.py:254
        List<String> header = lines.get(tableStart).cells().map(c -> c.strip("*").lower());                // src: vulnhunter-fix/scripts/parse_results.py:257
        int locI = colIdx(header, "location");                                                          // src: vulnhunter-fix/scripts/parse_results.py:267
        int patI = colIdx(header, "pattern", "observation");                                            // src: vulnhunter-fix/scripts/parse_results.py:268
        int riskI = colIdx(header, "risk if conditions change", "risk-if-conditions-change", "risk");   // src: vulnhunter-fix/scripts/parse_results.py:269
        int recI = colIdx(header, "recommendation", "recommended action", "notes");                     // src: vulnhunter-fix/scripts/parse_results.py:270
        for (String line : lines.subList(tableStart + 2)) {
            line = line.strip();
            if (line.isEmpty() || !line.startsWith("|")) break;                                            // src: vulnhunter-fix/scripts/parse_results.py:275
            List<String> cells = line.cells();
            if (cells.size() < 2) continue;                                                                // src: vulnhunter-fix/scripts/parse_results.py:278
            Map smell = Map.of();
            if (locI >= 0 && locI < cells.size()) smell.put("location", cells.get(locI).strip("`"));
            if (patI >= 0 && patI < cells.size()) smell.put("pattern", cells.get(patI));
            if (riskI >= 0 && riskI < cells.size()) smell.put("risk_if_conditions_change", cells.get(riskI));
            if (recI >= 0 && recI < cells.size()) smell.put("recommendation", cells.get(recI));
            if (smell.get("location") != null) smells.add(smell);                                          // src: vulnhunter-fix/scripts/parse_results.py:289
        }
        return smells;
    }

    List<Map> parseCodeSmells(String content, Theta θ) {
        String section = extractSmellSection(content, θ);                                                  // src: vulnhunter-fix/scripts/parse_results.py:304
        if (section.isEmpty()) return List.of();
        List<Map> smells = parseSmellsPerSectionFormat(section);                                           // src: vulnhunter-fix/scripts/parse_results.py:309
        if (smells.isEmpty()) smells = parseSmellsTableFormat(section);                                    // src: vulnhunter-fix/scripts/parse_results.py:311
        return smells;
    }

    Map parseResults(String resultsPath, Theta θ) {
        Path resultsDir = new Path(resultsPath);
        Path readme = resultsDir.join("README.md");
        if (!readme.exists()) return Map.of("error", "README.md not found");                               // src: vulnhunter-fix/scripts/parse_results.py:327
        String content = Files.read(readme);
        List<Map> summary = parseSummaryTable(content);                                                    // src: vulnhunter-fix/scripts/parse_results.py:332
        // only rows whose status equals this value are carried into findings
        List<Map> confirmed = summary.filter(f -> f.status.lower() == θ["code.fix.scripts.parse_results.confirmed_status"]); // src: vulnhunter-fix/scripts/parse_results.py:333
        List<Map> smells = parseCodeSmells(content, θ);                                                    // src: vulnhunter-fix/scripts/parse_results.py:335
        for (Map f : confirmed) {
            f.putAll(parseFindingDetail(content, f.id));                                                   // src: vulnhunter-fix/scripts/parse_results.py:338
            f.put("files", findRelatedFiles(resultsDir, f.id));                                            // src: vulnhunter-fix/scripts/parse_results.py:340
            f.put("primary_cwe", primaryCwe(f.getOr("cwe", "")));                                          // src: vulnhunter-fix/scripts/parse_results.py:346
            // always emitted, even with empty location / root cause
            f.put("vulnfix_key", computeVulnfixKey(f.getOr("location", ""), f.getOr("cwe", ""), f.getOr("root_cause", ""), θ)); // src: vulnhunter-fix/scripts/parse_results.py:347
        }
        Map vulnFiles = discoverAllVulnFiles(resultsDir);                                                  // src: vulnhunter-fix/scripts/parse_results.py:354
        return Map.of("results_dir", resultsDir, "readme_path", readme, "total_findings", summary.size(), "confirmed_findings", confirmed.size(), "findings", confirmed, "vuln_files", vulnFiles, "code_smells_count", smells.size(), "code_smells", smells); // src: vulnhunter-fix/scripts/parse_results.py:356
    }

    int main(List<String> argv, Theta θ) {
        if (argv.size() != 2) return 1;                                                                    // src: vulnhunter-fix/scripts/parse_results.py:369
        print(Json.dump(parseResults(argv.get(1), θ)));                                                    // src: vulnhunter-fix/scripts/parse_results.py:373
        return 0;
    }
}
