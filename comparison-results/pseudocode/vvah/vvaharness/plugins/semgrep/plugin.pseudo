// file: vvaharness/plugins/semgrep/plugin.py
// Graph enricher, read-only tools and triage-agent contribution; local files are validated before use.

@executedBy(CODE) @role(config)
class SemgrepPlugin {
    List<Path> configs = List.of(); List<String> rulesets = List.of();
    String executable = θ["code.plugins.semgrep.plugin.executable"]; // src: vvaharness/plugins/semgrep/plugin.py:58
    double timeoutSeconds = θ["code.plugins.semgrep.plugin.timeout_seconds"]; // src: vvaharness/plugins/semgrep/plugin.py:59
    int priority = θ["code.plugins.semgrep.plugin.priority"]; // src: vvaharness/plugins/semgrep/plugin.py:61
    Object enricher = null;
    @src("vvaharness/plugins/semgrep/plugin.py:39")
    List<Path> validatedConfigs(List<Object> configs, Theta θ) {
        if (configs.size() > θ["code.plugins.semgrep.plugin.max_config_files"]) throw new SemgrepConfigError("too many rule files"); // src: vvaharness/plugins/semgrep/plugin.py:32
        List<Path> out = new List();
        for (Object raw : configs) {
            Path path = Path.of(raw).expanduser();
            if (!path.isFile()) throw new SemgrepConfigError("rule source must be local file");
            out.add(path.resolve());
        }
        return out;
    }
    @src("vvaharness/plugins/semgrep/plugin.py:64")
    PluginInfo info(Theta θ) {
        return new PluginInfo("semgrep", "1", priority); // src: vvaharness/plugins/semgrep/plugin.py:61
    }
    @src("vvaharness/plugins/semgrep/plugin.py:68")
    Contribution contribute(Theta θ) {
        return new Contribution(enrichers(θ), SemgrepTools.registry(), List.of(SemgrepTriage.subagent(SemgrepTools.names(), θ)));
    }
    @src("vvaharness/plugins/semgrep/plugin.py:76")
    List<Object> enrichers(Theta θ) {
        if (enricher != null) return List.of(enricher);
        if (configs.isEmpty() && rulesets.isEmpty()) { logWarning("no Semgrep rules; absent evidence"); return List.of(); }
        return List.of(SemgrepEnricher.create(configs.isEmpty() ? List.of() : validatedConfigs(configs, θ), rulesets, executable, timeoutSeconds, priority)); // src: vvaharness/plugins/semgrep/plugin.py:58 // src: vvaharness/plugins/semgrep/plugin.py:59 // src: vvaharness/plugins/semgrep/plugin.py:61
    }
}

@executedBy(CODE) @role(types)
record SemgrepConfigError(String message) { }
