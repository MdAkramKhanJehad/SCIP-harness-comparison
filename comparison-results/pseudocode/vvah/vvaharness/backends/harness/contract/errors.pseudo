// file: vvaharness/backends/harness/contract/errors.py
// Re-export of the harness exception hierarchy defined in harness.models. Never defines a class:
// a copy would compare by identity and void the VVAH-E001/E002 halt guards.

@executedBy(CODE) @role(types)
class Errors {

    List<String> exports() {
        return List.of("AuthenticationError", "DegenerateResponseError", "HarnessCLINotFoundError", "HarnessConnectionError", "HarnessError", "HarnessJSONDecodeError", "HarnessMessageParseError", "HarnessProcessError", "ProxyError", "is_halt_error", "is_token_error"); // src: vvaharness/backends/harness/contract/errors.py:28
    }

    boolean isHaltError(Exception exc) {
        return HarnessModels.isHaltError(exc);                                                           // src: vvaharness/backends/harness/contract/errors.py:29
    }

    boolean isTokenError(Exception exc) {
        return HarnessModels.isTokenError(exc);                                                          // src: vvaharness/backends/harness/contract/errors.py:30
    }
}
