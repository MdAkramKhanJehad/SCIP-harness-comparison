// file: vvaharness/orchestrator/config_paths.py
// Config file resolution and trust: default config lookup, refusal of a --config inside the scan target,
// UNC-safe path resolution, and the list of active model roles (used by preflight, doctor and the manifest).

@executedBy(CODE) @role(config)
class ConfigPaths {

    // The single definition of model roles; preflight/doctor iterate it                              // src: vvaharness/orchestrator/config_paths.py:105
    List<String> MODEL_ROLES = List.of("graph_annotate", "callgraph_creation", "autoexclude", "preprocess", "threatmodel",
        "decompose", "deepdive", "verify", "dedup", "chain", "remediate", "validate", "exploit_verification"); // src: vvaharness/orchestrator/config_paths.py:105
    Set<String> CALLGRAPH_ROLES = Set.of("graph_annotate", "callgraph_creation");                     // legacy S0 roles // src: vvaharness/orchestrator/config_paths.py:110
    Map<String, List<String>> SUB_ROLES = Map.of("validate", List.of("orchestrator"), "exploit_verification", EvSettings.EV_MODULES); // src: vvaharness/orchestrator/config_paths.py:123
    // EV_MODEL_ROLES = exploit_verification.<sub> for each EV sub-role                              // src: vvaharness/orchestrator/config_paths.py:129

    Path appRoot() {
        return Path.of(__file__).realPath().parent().parent();                                        // src: vvaharness/orchestrator/config_paths.py:33
    }

    /** ./config.yaml when present, else the packaged default profile. */
    Path defaultConfig() {
        Path cwdCfg = Path.cwd().resolve("config.yaml");                                               // src: vvaharness/orchestrator/config_paths.py:37
        if (cwdCfg.exists()) return cwdCfg;                                                            // src: vvaharness/orchestrator/config_paths.py:38
        return packagedDefault();                                                                      // src: vvaharness/orchestrator/config_paths.py:40
    }

    Path packagedDefault() {
        return appRoot().resolve("config/profiles/default.yaml");                                      // trusted fallback // src: vvaharness/orchestrator/config_paths.py:45
    }

    /** True if candidate resolves at or under root (case-insensitive filesystems handled via samestat). */
    boolean pathWithin(Path candidate, Path root) {
        Path cand; Path base;
        try { cand = candidate.realPath(); base = root.realPath(); }                                   // src: vvaharness/orchestrator/config_paths.py:51
        catch (OSError e) { return false; }                                                            // src: vvaharness/orchestrator/config_paths.py:53
        if (cand.isRelativeTo(base)) return true;                                                      // src: vvaharness/orchestrator/config_paths.py:54
        Stat baseSt;
        try { baseSt = base.stat(); } catch (OSError e) { return false; }                             // src: vvaharness/orchestrator/config_paths.py:58
        for (Path p : cand.selfAndParents()) {                                                         // src: vvaharness/orchestrator/config_paths.py:61
            try { if (Os.sameStat(p.stat(), baseSt)) return true; } catch (OSError e) { continue; }   // src: vvaharness/orchestrator/config_paths.py:63
        }
        return false;                                                                                  // src: vvaharness/orchestrator/config_paths.py:67
    }

    /** Refuse a --config inside the untrusted scan target: explicit -> error (exit 2); auto-detected -> warn and fall back. */
    String trustedConfig(String config, Path boundary, boolean explicit, boolean quiet, Theta θ) {
        if (boundary == null || θ["code.orchestrator.config_paths.allow_cwd_config_env"]) return config; // VVAHARNESS_ALLOW_CWD_CONFIG // src: vvaharness/orchestrator/config_paths.py:74
        if (!pathWithin(Path.of(config), boundary)) return config;                                     // src: vvaharness/orchestrator/config_paths.py:76
        if (explicit) throw new ConfigPolicyError("--config resolves inside the scan target; refusing"); // src: vvaharness/orchestrator/config_paths.py:78
        if (!quiet) Log.warning("CONFIG_INSIDE_TARGET");                                               // src: vvaharness/orchestrator/config_paths.py:83
        return packagedDefault().toString();                                                           // src: vvaharness/orchestrator/config_paths.py:86
    }

    /** Join p onto base, refusing network/UNC paths (raw and joined) before any read. */
    String resolveAgainst(Path base, String p) {
        if (Config.isNetworkPath(p)) throw new ValueError("refusing network/UNC input path");  // NTLM leak over SMB // src: vvaharness/orchestrator/config_paths.py:91
        Path pp = Path.of(p);                                                                          // src: vvaharness/orchestrator/config_paths.py:95
        Path resolved = pp.isAbsolute() ? pp : base.resolve(pp);                                       // src: vvaharness/orchestrator/config_paths.py:96
        if (Config.isNetworkPath(resolved)) throw new ValueError("refusing network/UNC input path"); // src: vvaharness/orchestrator/config_paths.py:97
        return resolved.toString();                                                                    // src: vvaharness/orchestrator/config_paths.py:101
    }

    /** Only step0.callgraph_detection == llm makes the S0 annotator roles live (else not preflighted). */
    boolean callgraphLlmSelected(Config cfg, Theta θ) {
        String mode = (θ["step0.callgraph_detection"] != null ? θ["step0.callgraph_detection"] : "rules").strip().lower(); // src: vvaharness/orchestrator/config_paths.py:117
        return mode == "llm";                                                                          // src: vvaharness/orchestrator/config_paths.py:119
    }

    /** Yield (role, model node) for every configured, active model role; sub-role maps expand. */
    List<Role> iterModelRoles(Config cfg, Theta θ) {
        List<Role> out = new List();
        for (String r : MODEL_ROLES) {                                                                 // src: vvaharness/orchestrator/config_paths.py:134
            if (CALLGRAPH_ROLES.contains(r) && !callgraphLlmSelected(cfg, θ)) continue;                // src: vvaharness/orchestrator/config_paths.py:135
            ModelCfg m = cfg.models.get(r);                                                            // src: vvaharness/orchestrator/config_paths.py:137
            if (m == null) continue;                                                                   // src: vvaharness/orchestrator/config_paths.py:138
            List<String> subs = SUB_ROLES.get(r);                                                      // src: vvaharness/orchestrator/config_paths.py:140
            if (subs == null) { out.add(new Role(r, m)); continue; }                                   // src: vvaharness/orchestrator/config_paths.py:142
            for (String sub : subs) {
                ModelCfg node = m.get(sub);                                                            // src: vvaharness/orchestrator/config_paths.py:145
                if (node == null) continue;                                                            // absent sub-roles are optional // src: vvaharness/orchestrator/config_paths.py:147
                out.add(new Role(subs.size() == 1 ? r : r + "." + sub, node));                         // src: vvaharness/orchestrator/config_paths.py:150
            }
        }
        return out;
    }

    /** Effort tier driving a role's calls, or null (decompose and remediate have none). */
    String roleEffort(Config cfg, String role, Theta θ) {
        if (role.startsWith("exploit_verification.")) return EvSettings.evEffort(cfg, role.split(".", 2)[1]); // src: vvaharness/orchestrator/config_paths.py:168
        if (role == "preprocess") {                                                                    // src: vvaharness/orchestrator/config_paths.py:172
            if (cfg.models.autoexclude != null) return null;                                           // shares autoexclude's effort only when models.autoexclude is unset // src: vvaharness/orchestrator/config_paths.py:175
            return θ["step1.auto_exclude_effort"];                                                     // src: vvaharness/orchestrator/config_paths.py:177
        }
        switch (role) {                                                                                // ROLE_EFFORT_KEY // src: vvaharness/orchestrator/config_paths.py:154
            case "autoexclude": return θ["step1.auto_exclude_effort"];                                 // src: vvaharness/orchestrator/config_paths.py:155
            case "threatmodel": return θ["step2.effort"];                                              // src: vvaharness/orchestrator/config_paths.py:156
            case "deepdive": return θ["step4.effort"];                                                 // src: vvaharness/orchestrator/config_paths.py:157
            case "verify": return θ["step6_verify.effort"];                                            // src: vvaharness/orchestrator/config_paths.py:158
            case "dedup": return θ["step7_dedup.effort"];                                              // src: vvaharness/orchestrator/config_paths.py:159
            case "chain": return θ["step8.effort"];                                                    // src: vvaharness/orchestrator/config_paths.py:160
            case "validate": return θ["step_validate.effort"];                                         // src: vvaharness/orchestrator/config_paths.py:161
            default: return null;                                                                      // src: vvaharness/orchestrator/config_paths.py:180
        }
    }

    /** Highest tier by EFFORT_TIME_FACTOR request order; null/unknown tiers ignored. */
    String highestEffort(List<String> tiers) {
        List<String> order = LlmModels.EFFORT_TIME_FACTOR.get(ClockKind.REQUEST).keys();               // src: vvaharness/orchestrator/config_paths.py:189
        int bestRank = -1; String best = null;
        for (String tier : tiers) {
            if (tier == null) continue;                                                                // src: vvaharness/orchestrator/config_paths.py:193
            int rank = order.indexOf(tier);                                                            // src: vvaharness/orchestrator/config_paths.py:196
            if (rank < 0) continue;                                                                    // src: vvaharness/orchestrator/config_paths.py:198
            if (rank > bestRank) { bestRank = rank; best = tier; }                                     // src: vvaharness/orchestrator/config_paths.py:199
        }
        return best;                                                                                   // src: vvaharness/orchestrator/config_paths.py:202
    }
}
