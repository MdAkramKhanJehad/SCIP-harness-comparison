# vvaharness/validation/scoring/_engine.py

The authoritative scoring engine. It refuses to score (INCONCLUSIVE) on a malformed gate set, on any FLAGGED (no consensus) gate, or on an unevaluated critical gate; otherwise it computes a weighted score renormalized over the evaluated gates, bands it into a decision, and caps FIXED to PARTIALLY_FIXED when a critical gate is partial or failed. This is host code; the model's own `raw_score` and `fix_status` are never read here.

Source: `vvaharness/validation/scoring/_engine.py` (lines 1-202)
Executor: code
Called from: `vvaharness/validation/scoring/__init__.sudo` score_fix

INCONCLUSIVE_PREFIX = "INCONCLUSIVE"   // src: _engine.py:34-35

// src: vvaharness/validation/scoring/_engine.py:184-202
fn score(config, criteria, extra?):executor=code {
  precheck_error = _precheck(config, criteria)
  if (precheck_error) return precheck_error
  scored = _renormalized_score(config, criteria)
  if (scored is a ScoreResult) return scored   // nothing evaluated
  decision = _cap_critical_fail(config, criteria, _apply_verdicts(config, scored))
  return ScoreResult { raw_score: scored, decision, justification: config.justify(partial result, criteria, extra || {}) }
}

// src: vvaharness/validation/scoring/_engine.py:167-173 — order matters: shape, then consensus, then critical gate
fn _precheck(config, criteria):executor=code = _shape_error(config, criteria) || _consensus_error(criteria) || _critical_gate_error(config, criteria)

// src: vvaharness/validation/scoring/_engine.py:90-100
fn _shape_error(config, criteria):executor=code {
  names = criteria names; provided = set of names
  require provided == config.expected_criteria   // exact string comparison, not normalised
    => return _inconclusive("Missing criterion evaluations: <expected minus provided>.")
  // preserved: an extra unexpected gate name also fails this equality, but the message lists only the missing names (possibly none)
  require length(names) == length(provided) => return _inconclusive("Duplicate criterion evaluations: <duplicates>.")
  return null
}

// src: vvaharness/validation/scoring/_engine.py:140-151
fn _consensus_error(criteria):executor=code {
  flagged = sorted names of criteria where confidence == "FLAGGED"
  require flagged is empty => return _inconclusive("Insufficient persona consensus for gate(s): <flagged>.")
  return null
  // A gate carries confidence only when the host synthesized it (synthesis/_consensus.sudo); an agent-written gate has no confidence field and passes this check.
}

// src: vvaharness/validation/scoring/_engine.py:122-137
_UNEVALUATED = { "skip", "invalid" }
_CRITICAL_NOT_CLEAN = { "partial", "fail" }
fn _critical_gate_error(config, criteria):executor=code {
  for each criterion in criteria {
    require !(criterion.name in config.critical_criteria && criterion.status in _UNEVALUATED)
      => return _inconclusive("critical gate '<name>' was not evaluated (status '<status>').")
  }
  return null   // "never waivable"
}

// src: vvaharness/validation/scoring/_engine.py:103-119
fn _renormalized_score(config, criteria):executor=code {
  earned = 0.0; active_weight = 0.0
  for each criterion in criteria {
    if (criterion.status == "skip") continue   // weight-neutral: out of numerator and denominator
    active_weight += config.weights[criterion.name]
    earned += config.weights[criterion.name] * (config.status_multiplier[criterion.status] or, when absent, SCORE_FLOOR)   // invalid has no multiplier: 0.0, weight kept
  }
  if (active_weight <= 0.0) return _inconclusive("no gates were evaluated.")
  return round(min(earned / active_weight, 1.0), 4)   // SCORE_PRECISION = 4; clamp guards a weights misconfiguration
  // preserved: there is no "coverage floor" here. The prompt rules ask the model to return UNVERIFIABLE when evaluated weights sum to less than 0.50; the host scores any positive evaluated weight. (prompt rule: vvaharness/validation/claude_config/rules/scoring-matrix.md line 75)
}

// src: vvaharness/validation/scoring/_engine.py:176-181
fn _apply_verdicts(config, raw_score):executor=code {
  for each rule in config.verdicts, if (raw_score >= rule.min_score) return rule.decision
  return INCONCLUSIVE
  // with FIX_CONFIG the last band is min_score 0.0 (NOT_FIXED), so INCONCLUSIVE is unreachable here
}

// src: vvaharness/validation/scoring/_engine.py:154-164
fn _cap_critical_fail(config, criteria, decision):executor=code {
  if (config.verdicts is empty || decision != config.verdicts[0].decision) return decision   // only FIXED is capped
  not_clean = any criterion where name in config.critical_criteria && status in _CRITICAL_NOT_CLEAN
  return if (not_clean && length(config.verdicts) > 1) config.verdicts[1].decision else decision   // FIXED becomes PARTIALLY_FIXED
}

// src: vvaharness/validation/scoring/_engine.py:81-87
fn _inconclusive(reason):executor=code = ScoreResult { raw_score: 0.0, decision: INCONCLUSIVE, justification: "INCONCLUSIVE: $reason" }

// src: vvaharness/validation/scoring/_engine.py:60-78
fn parse_raw_criterion(entry, name_field):executor=code {
  evidence = for each mapping in entry.evidence (if a list): EvidenceAnchor(file=string or "", line=integer but not boolean or null, snippet=string or "")
  return RawCriterion {
    name: entry[name_field] if a string else "",
    status: GateStatus(entry.status if a string else "").value,   // casefolded; an unrecognised value becomes "invalid" (vvaharness/models/vocab.py:160-166)
    confidence: entry.confidence if a string else "",
    summary, details, evidence
  }
}
