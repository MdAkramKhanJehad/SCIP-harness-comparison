# vvaharness/remediation_agent/policy_gate/gate.py

The deterministic eligibility gate: the only place that decides whether a finding may reach the patch model, and which changed files a patch must not touch.

Source: `vvaharness/remediation_agent/policy_gate/gate.py` (lines 1-117)
Executor: code
Called from: `policy/context.sudo` build_context (construction); `policy/decide.sudo` (decide); `policy/postgate.sudo` and `policy/revert.sudo` (patch gates)

// src: vvaharness/remediation_agent/policy_gate/gate.py:33-41
DEFAULT_POLICY_PATH = rule_paths.locate_rule("remediation_policy.yaml", this file)   // the bundled inputs/remediation_policy.yaml in a checkout or an installed wheel
RULES_DIR = parent folder of DEFAULT_POLICY_PATH
_TRUE = ["1", "true", "yes", "on"]

// src: vvaharness/remediation_agent/policy_gate/gate.py:44-117
RemediationGate {
  // src: gate.py:46-49
  __init__(policy_path?) {
    _data = loader.parse_policy(policy_path or DEFAULT_POLICY_PATH)
    _loaded = (_data != null)
  }
  deny_paths = _data.deny_paths or []
  forbid_patch_paths = _data.forbid_patch_paths or []

  // src: gate.py:60-96 — the maximum action permitted for a finding; first rule that applies wins
  fn decide(cwe_id, file_path):executor=code {
    // The caller MUST NOT invoke the patch agent unless decision.may_generate_patch is true
    if (!_loaded) return _FAIL_CLOSED   // "policy_unavailable_fail_closed"
    // 0. kill switch, checked on EVERY call
    if (_data.kill_env && lower case of trimmed environment[_data.kill_env] in _TRUE) return Decision(GUIDANCE_ONLY, "kill_switch_env")
    if (_data.kill_file && _data.kill_file exists) return Decision(GUIDANCE_ONLY, "kill_switch_file")
    cwe = loader._norm_cwe(cwe_id)
    if (!cwe) return Decision(GUIDANCE_ONLY, "unmapped_cwe")
    // 1. deny list (including descendants): absolute, wins over everything
    if (cwe in _data.deny) return Decision(GUIDANCE_ONLY, _data.deny[cwe], matched_rule="deny:$cwe")
    // 2. sensitive-path guard: blocks even allowed CWEs
    for each pat in _data.deny_paths {
      if (matching._glob_match(file_path with "\\" as "/", pat)) return Decision(GUIDANCE_ONLY, "sensitive_path:$pat", matched_rule="deny_path:$pat")
    }
    // 3. allow list
    if (cwe in _data.allow) return Decision(PATCH, "allow_list", matched_rule="allow:$cwe")
    // 4. default
    return Decision(_data.default, "default_action")
  }

  // src: gate.py:99-105
  fn patch_touches_forbidden(changed_files):executor=code { return matching._first_match(changed_files, forbid_patch_paths) }   // build, test and CI infrastructure
  fn changed_paths_hit_deny(changed_files):executor=code { return matching._first_match(changed_files, deny_paths) }   // sensitive subsystems

  // src: gate.py:107-117
  fn forbidden_files(changed_files):executor=code {
    return the non-empty files in changed_files that match a forbid_patch_paths or deny_paths pattern (original spelling kept)
  }
}
