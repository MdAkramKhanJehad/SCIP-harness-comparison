# vvaharness/validation/tools/diff_facts.py

Deterministic, read-only parsing of the workspace `diff.patch` into per-file added line ranges; backs the DiffTouched, ChangedLines and DiffImpactMap fact tools.

Source: `vvaharness/validation/tools/diff_facts.py` (lines 1-159)
Executor: code
Called from: `vvaharness/validation/tools/deep_tools.sudo`, `vvaharness/validation/tools/fact_specs.sudo`

// src: vvaharness/validation/tools/diff_facts.py:121-129
fn parse_diff_patch(workspace):executor=code {
  if ("$workspace/diff.patch" does not exist) return []
  for each line of the file (decoded with errors replaced), _DiffParser.feed(line)
  return _DiffParser.finish()   // [FileChange { path, added_ranges: [[start, length]] }]
}

// src: vvaharness/validation/tools/diff_facts.py:94-114
fn _DiffParser.feed(line):executor=code {
  match (line) {
    case starts with "diff --git " => { close the current file; if (at least 4 space-separated tokens) current_path = last token without "a/" or "b/" }
    case starts with "--- " => { close the added run; old_path = path after the marker (up to a tab) without prefix }
    case starts with "+++ " => { close the added run; new_path = same; current_path = if (new_path == "/dev/null") old_path else new_path; new_line_number = 0 }   // a deletion keeps the old path
    case matches HUNK_HEADER_RE => { close the added run; new_line_number = new-side start line }
    default => if (new_line_number) _consume_hunk_line(line)
  }
}

// src: vvaharness/validation/tools/diff_facts.py:79-92
fn _consume_hunk_line(line):executor=code {
  match (first character) {
    case "+" => { start a run at new_line_number if none; run length += 1; new_line_number += 1 }
    case "-" => close the added run
    case "\\" => nothing
    default => { close the added run; new_line_number += 1 }
  }
}

// src: vvaharness/validation/tools/diff_facts.py:132-142
fn diff_touched(workspace, file_path):executor=code {
  for each change in parse_diff_patch(workspace), if (change.path == file_path) return { touched: true, added_ranges: change.added_ranges }
  return { touched: false, added_ranges: [] }
}
fn changed_lines(workspace, file_path):executor=code = diff_touched(workspace, file_path).added_ranges

// src: vvaharness/validation/tools/diff_facts.py:153-159
fn build_diff_impact_map(workspace):executor=code {
  files = paths of parse_diff_patch(workspace)
  return { files_changed: sorted unique files, trust_boundary_touched: any file matches TRUST_BOUNDARY_RE }
}
