// file: vvaharness/pipeline/stages/s8/session.py
// Step 8's one model call: the chaining pass (no tools, one model call), with a transcript replay on
// deadline and a json-repair re-ask; raises so S8Chain.run can ship the deterministic report.

@executedBy(CODE) @role(step) @stage("S8")
class S8Session {

    // TAG = "s8 chain", _REPLAY_EFFORT = "low" (code constants); the quality floors are knobs code.s8.session.min_response_chars / min_response_tokens (90 and 15)

    ModelCallBudget callBudget(Theta θ) {
        // On the last permitted call every tool but ChainReport is withdrawn; default 1.
        int limit = θ["step8.max_model_calls"];                                                 // src: vvaharness/pipeline/stages/s8/session.py:62
        if (limit <= 0) return null;                                                            // src: vvaharness/pipeline/stages/s8/session.py:63
        return new ModelCallBudget(limit, Set.of("ChainReport"));                               // src: vvaharness/pipeline/stages/s8/session.py:65
    }

    String agenticLeg(Prompt user, ContextPackage ctx, Theta θ, List middleware, boolean dropThinking) {
        Effort effort = dropThinking ? null : θ["step8.effort"];                                // src: vvaharness/pipeline/stages/s8/session.py:74
        ModelSpec model = new ModelSpec(θ["models.chain.id"], θ["models.chain.via"], θ["models.chain.provider"], effort, θ["step8.max_tokens"]); // src: vvaharness/pipeline/stages/s8/session.py:87
        // 2 turns: turn 1 is the forced ChainReport call, turn 2 the tool result it ends on.
        Bounds bounds = new Bounds(θ["step8.max_turns"], θ["step8.max_model_calls"],            // src: vvaharness/pipeline/stages/s8/session.py:84
                                   Replay.deadlineBound(θ["step8.timeout"], θ["step8.deadline"]), null); // src: vvaharness/pipeline/stages/s8/session.py:85
        // No tools: S8 is handed its finding table whole and has nothing to look up.
        return Runtime.agent(new AgentSpec(model, List.of(), List.of(), S8Prompts.system(θ), user, bounds, S8Outcomes.schema(θ), false)); // src: vvaharness/pipeline/stages/s8/session.py:76
    }

    int replayMaxTokens(Theta θ) {
        return θ["step8.replay_max_tokens"];                                                    // src: vvaharness/pipeline/stages/s8/session.py:100
    }

    String coldCall(Prompt prompt, ContextPackage ctx, Theta θ, String tag) {
        // One no-tool re-ask (replay or json-repair), sized and clocked like the replay leg.
        ModelSpec model = new ModelSpec(θ["models.chain.id"], θ["models.chain.via"], θ["models.chain.provider"], Effort.LOW, replayMaxTokens(θ)); // src: vvaharness/pipeline/stages/s8/session.py:114
        int timeout = θ["step8.replay_timeout"];                                                // src: vvaharness/pipeline/stages/s8/session.py:117
        return Runtime.llm(model, S8Prompts.system(θ), prompt, S8Outcomes.schema(θ));          // src: vvaharness/pipeline/stages/s8/session.py:108
    }

    String replayLeg(Prompt user, ContextPackage ctx, Theta θ, Transcript transcript) {
        return coldCall(Replay.replayPrompt(transcript, user), ctx, θ, "s8 chain replay");      // src: vvaharness/pipeline/stages/s8/session.py:127
    }

    boolean repairable(Object raw) {
        // A schema key followed by a value opener: the reply tried to answer.
        return raw is String && Regex.search("(ranked_findings|chains) followed by : or = or is, then [ or open-brace", raw); // src: vvaharness/pipeline/stages/s8/session.py:134
    }

    boolean repairFits(String raw, Theta θ) {
        return Tokens.estimate(raw) <= replayMaxTokens(θ);                                      // src: vvaharness/pipeline/stages/s8/session.py:141
    }

    String repairCall(String raw, Exception err, ContextPackage ctx, Theta θ) {
        return coldCall(S8Prompts.repairPrompt(raw, err, θ), ctx, θ, "s8 chain json-repair");   // src: vvaharness/pipeline/stages/s8/session.py:146
    }

    /** Nested _dispatch(drop_thinking): one chain attempt with its own session id, transcript and budget middleware; on a deadline kill goes straight to the transcript re-ask (a resume would be a second full chain analysis at stage effort under a shorter clock); the pinned session is always released. */
    @src("vvaharness/pipeline/stages/s8/session.py:158")
    String dispatch(boolean dropThinking, Prompt user, ContextPackage ctx, Theta θ, int deadline, Effort effort, ReplayFlag replayed) {
        String sessionId = Replay.sessionIdFor("s8", "chain");                                  // src: vvaharness/pipeline/stages/s8/session.py:160
        Transcript transcript = new Transcript();                                               // src: vvaharness/pipeline/stages/s8/session.py:161
        List middleware = List.of(new RecordTranscript(transcript));                            // src: vvaharness/pipeline/stages/s8/session.py:162
        ModelCallBudget budget = callBudget(θ);                                                 // src: vvaharness/pipeline/stages/s8/session.py:163
        if (budget != null) middleware.add(budget);                                             // src: vvaharness/pipeline/stages/s8/session.py:165
        try {
            return Replay.runWithDeadline(() -> agenticLeg(user, ctx, θ, middleware, dropThinking), deadline); // src: vvaharness/pipeline/stages/s8/session.py:167
        } catch (CallTimeoutError e) {
            Console.write("deadline hit - replaying the chain analysis from the transcript");    // src: vvaharness/pipeline/stages/s8/session.py:176
            replayed.value = true;                                                              // src: vvaharness/pipeline/stages/s8/session.py:178
            return replayLeg(user, ctx, θ, transcript);                                         // src: vvaharness/pipeline/stages/s8/session.py:179
        } finally {
            Replay.releasePinnedSession(sessionId);                                             // src: vvaharness/pipeline/stages/s8/session.py:180
        }
    }

    String chainCall(List<Finding> findings, ContextPackage ctx, Theta θ, List<String> labels, boolean allowResend) {
        Effort effort = θ["step8.effort"];                                                      // src: vvaharness/pipeline/stages/s8/session.py:153
        Prompt user = S8Prompts.buildPrompt(findings, ctx, labels, θ);                          // src: vvaharness/pipeline/stages/s8/session.py:154
        int deadline = θ["step8.deadline"];                                                     // src: vvaharness/pipeline/stages/s8/session.py:155
        boolean replayed = false;
        // Only an effort can lose the forced tool_choice (memoised model or manual thinking) and shares the output budget; with none a retry just repeats.
        // A refused chain call loses only the enrichment (the deterministic report ships regardless), so the resend buys nothing: resend_refusal is False.
        // A reply from the deadline replay leg is already a cold re-ask: replayed vetoes the drop-tier resend; allow_resend=False vetoes it for the half-window caller.
        ReplayFlag replayed = new ReplayFlag(false);
        return ResponseQuality.stageFloors(TAG, θ["code.s8.session.min_response_chars"], θ["code.s8.session.min_response_tokens"], // src: vvaharness/pipeline/stages/s8/session.py:107
            () -> ResponseQuality.dispatchOrRetryUnforced(dropThinking -> dispatch(dropThinking, user, ctx, θ, deadline, effort, replayed),
            mayRetry = allowResend && effort != null && !replayed.value, resendRefusal = false)); // src: vvaharness/pipeline/stages/s8/session.py:193
    }
}
