            if (f.vsvsScore != null) {                                                          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:250
                props.put("vulContextSeverityVector", f.vsvsVector); props.put("vulContextSeverityScore", round(f.vsvsScore, 1)); props.put("vulContextSeverityRating", f.vsvsRating); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:251
            }
