  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Append one streaming session's turns and tool calls to a JSONL transcript.\"\"\"\n\n# Silently inert unless VVAHARNESS_TRANSCRIPT_DIR is set.\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport threading\nimport time\nfrom dataclasses import asdict, is_dataclass\nfrom pathlib import Path\n\n_ENV_DIR = \"VVAHARNESS_TRANSCRIPT_DIR\"\n_UNSAFE = re.compile(r\"[^A-Za-z0-9._-]+\")\n_SEQ = 0\n_SEQ_LOCK = threading.Lock()\n\n\ndef transcript_dir() -> Path | None:\n    \"\"\"The configured transcript directory, or None when transcripts are off.\"\"\"\n    raw = os.environ.get(_ENV_DIR, \"\").strip()\n    return Path(raw).expanduser() if raw else None\n\n\ndef _next_seq() -> int:\n    \"\"\"A process-unique sequence number for transcript filenames.\"\"\"\n    global _SEQ\n    with _SEQ_LOCK:\n        _SEQ += 1\n        return _SEQ\n\n\ndef _slug(text: str, *, fallback: str) -> str:\n    \"\"\"Filesystem-safe fragment of *text*, or *fallback* when nothing survives.\"\"\"\n    cleaned = _UNSAFE.sub(\"-\", (text or \"\").strip()).strip(\"-\")\n    return cleaned[:60] or fallback\n\n\ndef _jsonable(message: object) -> dict[str, object]:\n    \"\"\"A dict for *message*, whatever shape it is — never raises on odd payloads.\"\"\"\n    if is_dataclass(message) and not isinstance(message, type):\n        return asdict(message)\n    return {\"kind\": type(message).__name__, \"repr\": repr(message)[:4000]}\n\n\nclass Transcript:\n    \"\"\"A JSONL file recording every HarnessMessage of one streaming session.\"\"\"\n\n    def __init__(self, path: Path, *, meta: dict[str, object]) -> None:\n        \"\"\"Open *path* for append and write the session's metadata header line.\"\"\"\n        self.path = path\n        self._lock = threading.Lock()\n        self._start = time.monotonic()\n        self._n = 0\n        self._write({\"kind\": \"transcript_open\", **meta})\n\n    def _write(self, row: dict[str, object]) -> None:\n        \"\"\"Append one JSON row; a transcript failure must never break the scan.\"\"\"\n        try:\n            with self._lock, self.path.open(\"a\", encoding=\"utf-8\") as fh:\n                fh.write(json.dumps(row, default=str) + \"\\n\")\n        except (OSError, TypeError, ValueError):\n            return\n\n    def add(self, message: object) -> None:\n        \"\"\"Record one streamed HarnessMessage.\"\"\"\n        self._n += 1\n        self._write({\n            \"seq\": self._n,\n            \"t\": round(time.monotonic() - self._start, 3),\n            **_jsonable(message),\n        })\n\n    def close(self) -> None:\n        \"\"\"Write the closing row carrying the message count and elapsed time.\"\"\"\n        self._write({\n            \"kind\": \"transcript_close\",\n            \"messages\": self._n,\n            \"elapsed_s\": round(time.monotonic() - self._start, 3),\n        })\n\n\ndef open_transcript(*, tag: str | None, model: str, graph_name: str = \"\") -> Transcript | None:\n    \"\"\"A Transcript for this session, or None when transcripts are disabled.\"\"\"\n    root = transcript_dir()\n    if root is None:\n        return None\n    try:\n        root.mkdir(parents=True, exist_ok=True)\n    except OSError:\n        return None\n    name = f\"{_next_seq():04d}-{_slug(tag or graph_name, fallback='session')}.jsonl\"\n    return Transcript(root / name, meta={\"tag\": tag, \"model\": model,\n                                         \"graph_name\": graph_name})\n\n\n__all__ = [\"Transcript\", \"open_transcript\", \"transcript_dir\"]\n",
