// file: vvaharness/util/counters.py
// Process-wide stage counters (ints you add to, strings you overwrite), read once by util.metrics.build().
// Batch mode must reset() between repos; retired tallies keep the whole batch invocation's totals.

@executedBy(CODE) @role(types)
class Counters {

    Lock lock;
    Map<String, Integer> ints;
    Map<String, String> notes;
    Map<String, Integer> retiredInts;                                          // never cleared by reset() // src: vvaharness/util/counters.py:30
    Map<String, String> retiredNotes;

    void bump(String name, int n) {
        synchronized (lock) {
            if (notes.containsKey(name) || retiredNotes.containsKey(name))     // src: vvaharness/util/counters.py:36
                throw new ValueError("counter is already recorded as a note"); // a name is a count OR a note
            ints.put(name, ints.getOrDefault(name, 0) + n);                    // n defaults to 1 // src: vvaharness/util/counters.py:41
        }
    }

    void note(String name, String value) {
        synchronized (lock) {
            if (ints.containsKey(name) || retiredInts.containsKey(name))       // src: vvaharness/util/counters.py:46
                throw new ValueError("counter is already recorded as a count");
            notes.put(name, value);                                            // last writer wins // src: vvaharness/util/counters.py:51
        }
    }

    int get(String name) {
        synchronized (lock) { return ints.getOrDefault(name, 0); }             // src: vvaharness/util/counters.py:55
    }

    Map<String, Object> snapshot() {
        synchronized (lock) { return merge(ints, notes); }                     // src: vvaharness/util/counters.py:59
    }

    Map<String, Object> snapshotCumulative() {
        synchronized (lock) {
            Map<String, Integer> merged = copy(retiredInts);                   // src: vvaharness/util/counters.py:64
            for (String k : ints.keys()) merged.put(k, merged.getOrDefault(k, 0) + ints.get(k)); // src: vvaharness/util/counters.py:65
            return merge(merged, retiredNotes, notes);                         // src: vvaharness/util/counters.py:67
        }
    }

    void reset() {
        synchronized (lock) {
            for (String k : ints.keys()) retiredInts.put(k, retiredInts.getOrDefault(k, 0) + ints.get(k)); // src: vvaharness/util/counters.py:72
            retiredNotes.putAll(notes);                                        // src: vvaharness/util/counters.py:74
            ints.clear(); notes.clear();
        }
    }

    void resetAll() {
        synchronized (lock) { ints.clear(); notes.clear(); retiredInts.clear(); retiredNotes.clear(); } // src: vvaharness/util/counters.py:81
    }
}
