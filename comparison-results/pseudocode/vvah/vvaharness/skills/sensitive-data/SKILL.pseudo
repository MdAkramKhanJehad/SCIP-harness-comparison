// file: vvaharness/skills/sensitive-data/SKILL.md
// S4 skill playbook "sensitive-data": point-of-occurrence exposure (no injection path needed).
// Probe first, apply the sensitive-content + attacker-readable-channel gate, read polarity sections, then judgement checks.

@executedBy(MODEL) @role(skill) @stage("S4")
class SensitiveDataSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_sensitive-data.trigger"])) return List.of();                     // src: vvaharness/skills/sensitive-data/SKILL.md:3
        SensitiveDataPrompt.playbook(θ);
        List<Finding> out = new List();
        ProbeOutput probe = null;
        if (θ["p.skill_sensitive-data.run_probe_first"]) probe = SensitiveDataProbe.run(repo.root, θ);     // src: vvaharness/skills/sensitive-data/SKILL.md:42
        // polarity: three sections are findings when EMPTY
        if (θ["p.skill_sensitive-data.polarity_no_strong_kdf"] && probe.section("strong KDF present").isNone() && repo.storesPasswords()) out.add(new Finding("passwords stored with no KDF")); // src: vvaharness/skills/sensitive-data/SKILL.md:49
        if (θ["p.skill_sensitive-data.polarity_no_cache_control"] && probe.section("Cache-Control / no-store").isNone() && repo.servesAuthenticatedPages()) out.add(new Finding("PII cacheable")); // src: vvaharness/skills/sensitive-data/SKILL.md:51
        if (θ["p.skill_sensitive-data.polarity_no_hsts"] && probe.section("Strict-Transport-Security").isNone() && repo.isHttps()) out.add(new Finding("downgrade open")); // src: vvaharness/skills/sensitive-data/SKILL.md:53
        for (Candidate c : probe.allHits()) {
            if (!θ["p.skill_sensitive-data.probe_hits_are_candidates"]) continue;                           // every line is a CANDIDATE to gate // src: vvaharness/skills/sensitive-data/SKILL.md:45
            judge(c, θ);
            if (!hardGate(c, θ)) continue;
            c.severity = severity(c, θ);
            out.add(c.toFinding());
        }
        return out;
    }

    boolean hardGate(Candidate c, Theta θ) {
        // point-of-occurrence: no injection path required
        if (θ["p.skill_sensitive-data.point_of_occurrence_no_injection_path"]) c.requiresSourcePath = false; // src: vvaharness/skills/sensitive-data/SKILL.md:26
        if (!θ["p.skill_sensitive-data.gate_sensitive_data_kinds"].contains(c.dataKind)) return false;     // (a) // src: vvaharness/skills/sensitive-data/SKILL.md:30
        if (!θ["p.skill_sensitive-data.gate_attacker_readable_channel"].contains(c.channel)) return false; // (b) // src: vvaharness/skills/sensitive-data/SKILL.md:34
        if (θ["p.skill_sensitive-data.generic_print_not_finding"] && c.isGenericPrintOfNonSensitive()) return false; // src: vvaharness/skills/sensitive-data/SKILL.md:37
        return true;
    }

    /** Judgement the grep cannot make. */
    void judge(Candidate c, Theta θ) {
        if (θ["p.skill_sensitive-data.read_template_and_view"] && c.isView()) c.read(c.template());         // the leak is in the template // src: vvaharness/skills/sensitive-data/SKILL.md:57
        if (θ["p.skill_sensitive-data.serialization_field_audit"] && c.isWholeObjectSerialization()) c.dataKind = c.openModel().hiddenFieldKind(); // src: vvaharness/skills/sensitive-data/SKILL.md:61
        if (θ["p.skill_sensitive-data.settings_constants_name_then_value"] && c.isAllCapsConstant()) {      // src: vvaharness/skills/sensitive-data/SKILL.md:65
            if (c.nameContainsAny(θ["p.skill_sensitive-data.sensitive_name_keywords"])) c.dataKind = c.valueSensitivity(); // src: vvaharness/skills/sensitive-data/SKILL.md:68
        }
        if (θ["p.skill_sensitive-data.placeholders_and_reads_not_literals"] && c.isEnvOrVaultIndirection()) c.dataKind = null; // src: vvaharness/skills/sensitive-data/SKILL.md:71
        if (θ["p.skill_sensitive-data.sensitive_name_not_content"]) c.dataKind = c.readFlowingValue().kind;  // src: vvaharness/skills/sensitive-data/SKILL.md:73
        if (θ["p.skill_sensitive-data.debug_route_reachability"] && c.isDebugRoute() && (c.behindAuth || c.localhostOnly)) c.channel = null; // src: vvaharness/skills/sensitive-data/SKILL.md:76
        if (θ["p.skill_sensitive-data.django_admin_not_finding_alone"] && c.isDjangoAdmin() && !c.disclosesMoreThanExpected()) c.channel = null; // src: vvaharness/skills/sensitive-data/SKILL.md:77
    }

    Severity severity(Candidate c, Theta θ) {
        if (c.noConcreteExposurePath()) return θ["p.skill_sensitive-data.sev_no_exposure_path_low"];       // "We should encrypt this" -> LOW // src: vvaharness/skills/sensitive-data/SKILL.md:38
        return c.blastRadius(θ["p.skill_sensitive-data.sev_follows_blast_radius"]);                         // one DOB in a log MEDIUM; every PAN world-readable HIGH // src: vvaharness/skills/sensitive-data/SKILL.md:80
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class SensitiveDataPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_sensitive-data.persona"]);                                                     // src: vvaharness/skills/sensitive-data/SKILL.md:24
        p.rule(θ["p.skill_sensitive-data.point_of_occurrence_no_injection_path"]);                          // src: vvaharness/skills/sensitive-data/SKILL.md:26
        p.evidence(θ["p.skill_sensitive-data.gate_sensitive_data_kinds"]);                                  // src: vvaharness/skills/sensitive-data/SKILL.md:30
        p.evidence(θ["p.skill_sensitive-data.gate_attacker_readable_channel"]);                             // src: vvaharness/skills/sensitive-data/SKILL.md:34
        p.exemption(θ["p.skill_sensitive-data.generic_print_not_finding"]);                                 // src: vvaharness/skills/sensitive-data/SKILL.md:37
        p.threshold(θ["p.skill_sensitive-data.sev_no_exposure_path_low"]);                                  // src: vvaharness/skills/sensitive-data/SKILL.md:38
        p.step(1, θ["p.skill_sensitive-data.run_probe_first"]);                                             // src: vvaharness/skills/sensitive-data/SKILL.md:42
        p.rule(θ["p.skill_sensitive-data.probe_hits_are_candidates"]);                                      // src: vvaharness/skills/sensitive-data/SKILL.md:45
        p.rule(θ["p.skill_sensitive-data.polarity_no_strong_kdf"]);                                         // src: vvaharness/skills/sensitive-data/SKILL.md:49
        p.rule(θ["p.skill_sensitive-data.polarity_no_cache_control"]);                                      // src: vvaharness/skills/sensitive-data/SKILL.md:51
        p.rule(θ["p.skill_sensitive-data.polarity_no_hsts"]);                                               // src: vvaharness/skills/sensitive-data/SKILL.md:53
        p.must(θ["p.skill_sensitive-data.read_template_and_view"]);                                         // src: vvaharness/skills/sensitive-data/SKILL.md:57
        p.rule(θ["p.skill_sensitive-data.serialization_field_audit"]);                                      // src: vvaharness/skills/sensitive-data/SKILL.md:61
        p.rule(θ["p.skill_sensitive-data.settings_constants_name_then_value"]);                             // src: vvaharness/skills/sensitive-data/SKILL.md:65
        p.checklist(θ["p.skill_sensitive-data.sensitive_name_keywords"]);                                   // src: vvaharness/skills/sensitive-data/SKILL.md:68
        p.exemption(θ["p.skill_sensitive-data.placeholders_and_reads_not_literals"]);                       // src: vvaharness/skills/sensitive-data/SKILL.md:71
        p.exemption(θ["p.skill_sensitive-data.sensitive_name_not_content"]);                                // src: vvaharness/skills/sensitive-data/SKILL.md:73
        p.exemption(θ["p.skill_sensitive-data.debug_route_reachability"]);                                  // src: vvaharness/skills/sensitive-data/SKILL.md:76
        p.exemption(θ["p.skill_sensitive-data.django_admin_not_finding_alone"]);                            // src: vvaharness/skills/sensitive-data/SKILL.md:77
        p.tiebreak(θ["p.skill_sensitive-data.sev_follows_blast_radius"]);                                   // src: vvaharness/skills/sensitive-data/SKILL.md:80
        return p;
    }
}
