# vvaharness/backends/harness/deepagents/prompt_caching.py

`BlockMarkerPromptCaching`, the Anthropic prompt-caching middleware used in every deepagents graph. It places cache markers on the system message, the tools and (when `mark_tail`) the last eligible content block of the conversation tail, and never sets the top-level request cache parameter, because some proxies drop it. Non-Anthropic models pass through untouched.

Source: `vvaharness/backends/harness/deepagents/prompt_caching.py` (lines 1-127)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/graph_builder.sudo` _create_agent (always installed, enabled=cache_markers, mark_tail=cache_tail)

// src: vvaharness/backends/harness/deepagents/prompt_caching.py:33-42
_TTL = "5m"                                   // every marker's time to live
_UNSUPPORTED_MODEL_BEHAVIOR = "ignore"        // non-Anthropic models: no change
_INELIGIBLE_TAIL_BLOCK_TYPES = { "thinking", "redacted_thinking" }   // Anthropic rejects cache_control on these

// src: vvaharness/backends/harness/deepagents/prompt_caching.py:45-92
fn _tag_tail(messages, cache_control):executor=code {
  if (messages is empty) return null
  // Walk the last message's content from the end; the first eligible block gets cache_control.
  // A string content becomes one text block with the marker (an empty string is ineligible).
  // Thinking and redacted-thinking blocks are skipped. null when no block is eligible.
  return messages with the last message's content replaced, or null
}

// src: vvaharness/backends/harness/deepagents/prompt_caching.py:95-124
BlockMarkerPromptCaching {
  // Parent: langchain_anthropic AnthropicPromptCachingMiddleware(ttl=_TTL, unsupported_model_behavior="ignore")   // external
  _enabled = enabled       // default true
  _mark_tail = mark_tail   // default true
  name = "AnthropicPromptCachingMiddleware"   // src: prompt_caching.py:104-107 — the parent's name, so deepagents replaces its auto-attached instance in place

  // src: prompt_caching.py:109-111
  fn _should_apply_caching(request):executor=code {
    return _enabled && parent check that the model is Anthropic
  }

  // src: prompt_caching.py:113-124
  fn _apply_caching(request):executor=code {
    system_message = _tag_system_message(request.system_message, cache_control)   // external: langchain_anthropic helper
    tools = _tag_tools(request.tools, cache_control)                               // external: langchain_anthropic helper
    tail = if (_mark_tail) _tag_tail(request.messages, cache_control) else null
    return request with system_message, tools (or unchanged when null), messages = tail (or unchanged when null)
    // No model_settings cache_control: some proxies drop the top-level parameter
  }
}
