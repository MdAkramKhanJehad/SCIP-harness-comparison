// file: vulnhunter-fix/references/verification-table-rules.md
// Rule book (REQ-GRA-011..014): 9-column verification-table shape, cell grammar, column 7/8 semantics, verdict truth table.
// Read by prompts/verify.md (Phase 4) when building the table; enforced by vulnhunter_fix.delivery.render_verification_table and
// scripts/validate-verification.py (pre-deliver Gate 6); rendered in templates/pr_body.md and templates/issue_body.md.

@executedBy(MODEL) @role(rule_set) @stage("fix.verify")
class VerificationTableRules {

    // Entry: build one row per finding, compute its verdict, then validate the whole table.
    Table run(List<Finding> findings, Graph graph, Result result, Sidecar sc, Theta θ) {
        Table t = new Table(header(θ));
        for (Finding f : findings) {
            Row r = buildRow(f, graph, result, sc, θ);
            r.set(9, verdict(r, θ));
            t.add(r);
        }
        validate(t, θ);
        return t;
    }

    List<String> header(Theta θ) {
        List<String> h = θ["p.verification-table-rules.column_headers"];                                   // src: vulnhunter-fix/references/verification-table-rules.md:12
        assert h.size() == θ["p.verification-table-rules.nine_columns_fixed_order"];                       // src: vulnhunter-fix/references/verification-table-rules.md:10
        if (θ["p.verification-table-rules.hand_composed_exact_headers"]) {                                 // src: vulnhunter-fix/references/verification-table-rules.md:17
            // workers composing PR bodies by hand MUST emit these exact headers in order (no renaming, no dropping #, no Sink column)
        }
        return h;
    }

    Row buildRow(Finding f, Graph graph, Result result, Sidecar sc, Theta θ) {
        Row r = new Row();
        r.set(3, cell(f.vectorClosed, f.vectorEvidence, sc, θ));
        r.set(4, cell(f.testRealAttack, f.testEvidence, sc, θ));
        r.set(5, cell(f.failClosed, f.failClosedEvidence, sc, θ));
        r.set(6, cell(f.residualDocumented, f.residualEvidence, sc, θ));
        r.set(7, column7(graph, result, f, θ));
        r.set(8, column8(f, θ));
        return r;
    }

    String cell(Tri value, Location evidence, Sidecar sc, Theta θ) {
        List<String> allowed = θ["p.verification-table-rules.cell_value_set"];                              // src: vulnhunter-fix/references/verification-table-rules.md:23
        if (value == NO) {
            if (θ["p.verification-table-rules.no_cell_no_citation"]) return "no";                          // src: vulnhunter-fix/references/verification-table-rules.md:28
        }
        if (value == NA) {
            if (θ["p.verification-table-rules.na_cell_no_citation"]) return "n/a";                         // src: vulnhunter-fix/references/verification-table-rules.md:29
        }
        String cite = "(" + evidence.file + ":" + evidence.line + ")";
        if (θ["p.verification-table-rules.grep_fallback_annotation_condition"] == "confidence == low" && sc.confidence == "low") { // src: vulnhunter-fix/references/verification-table-rules.md:30
            return "yes (grep_fallback) " + cite;
        }
        return "yes " + cite;
    }

    String column7(Graph graph, Result result, Finding f, Theta θ) {
        List<String> callers = List.of();
        if (θ["p.verification-table-rules.col7_enumerate_every_caller"]) {                                 // src: vulnhunter-fix/references/verification-table-rules.md:40
            callers = graph.callersOf(f.sinkSymbol).map(c -> c.file + ":" + c.symbol).sortedLexByFileLine();
        }
        boolean covered = !θ["p.verification-table-rules.col7_superset_for_yes"] || result.callersRoutedThroughFix.containsAll(callers); // src: vulnhunter-fix/references/verification-table-rules.md:43
        if (!covered) return "no";
        int cap = θ["p.verification-table-rules.col7_truncation_threshold"];                               // src: vulnhunter-fix/references/verification-table-rules.md:45
        if (callers.size() > cap) {
            String suffix = θ["p.verification-table-rules.col7_truncation_suffix"].replace("N", callers.size() - cap); // src: vulnhunter-fix/references/verification-table-rules.md:47
            return "yes (" + callers.subList(0, cap).join(", ") + " " + suffix + ")";
        }
        return "yes (" + callers.join(", ") + ")";
    }

    String column8(Finding f, Theta θ) {
        List<String> values = θ["p.verification-table-rules.col8_set_by_sweep"];                            // src: vulnhunter-fix/references/verification-table-rules.md:53
        return SweepAlgorithm.column8(f.sweepRow, f.result, θ);                                              // set by scripts/sweep-root-causes.py
    }

    // Truth table; mechanically computed, never free text.
    String verdict(Row r, Theta θ) {
        assert θ["p.verification-table-rules.verdict_mechanically_computed"];                              // src: vulnhunter-fix/references/verification-table-rules.md:57
        if (θ["p.verification-table-rules.needs_rework_vector_not_closed"] && r.is(3, "no")) return "NEEDS_REWORK";       // src: vulnhunter-fix/references/verification-table-rules.md:65
        if (θ["p.verification-table-rules.needs_rework_test_not_real_attack"] && r.is(4, "no")) return "NEEDS_REWORK";    // src: vulnhunter-fix/references/verification-table-rules.md:66
        if (θ["p.verification-table-rules.needs_rework_missing_residual_docs"] && r.is(6, "no")) return "NEEDS_REWORK";   // src: vulnhunter-fix/references/verification-table-rules.md:67
        boolean c345 = r.isYes(3) && r.isYes(4) && r.isYes(5);
        boolean tail = r.isYesOrNa(7) && r.isYesOrNa(8);
        if (θ["p.verification-table-rules.verdict_full_row"] && c345 && r.isYesOrNa(6) && tail) return "FULL";            // src: vulnhunter-fix/references/verification-table-rules.md:62
        if (θ["p.verification-table-rules.verdict_mitigation_row"] && c345 && r.isYes(6) && tail) return "MITIGATION";    // src: vulnhunter-fix/references/verification-table-rules.md:63
        // unclear: rows 62 and 63 overlap when column 6 is yes; the table lists FULL first
        if (θ["p.verification-table-rules.verdict_workaround_row"] && r.isYes(3) && r.isYes(4) && r.is(5, "no") && r.isYes(6) && tail) return "WORKAROUND"; // src: vulnhunter-fix/references/verification-table-rules.md:64
        return "NEEDS_REWORK";                                                                              // unclear: combinations not in the table
    }

    @executedBy(CODE)
    void validate(Table t, Theta θ) {
        if (θ["p.verification-table-rules.header_verbatim_enforced"] && t.header != header(θ)) throw new DeliveryHalted("header drift"); // src: vulnhunter-fix/references/verification-table-rules.md:15
        for (Row r : t.rows) {
            for (Cell c : r.cells) {
                if (c.startsWith("yes")) {
                    if (θ["p.verification-table-rules.yes_requires_citation"] && c.citation == null) throw new DeliveryHalted("uncited yes"); // src: vulnhunter-fix/references/verification-table-rules.md:32
                    if (θ["p.verification-table-rules.citation_line_verified"] && !Worktree.lineExists(c.citation)) throw new DeliveryHalted("bad citation"); // src: vulnhunter-fix/references/verification-table-rules.md:33
                }
            }
            if (r.col7Truncated() && θ["p.verification-table-rules.col7_truncation_only_above_threshold"]) {                   // src: vulnhunter-fix/references/verification-table-rules.md:48
                if (r.totalCallers <= θ["p.verification-table-rules.col7_truncation_threshold"]) throw new DeliveryHalted("truncation not allowed"); // src: vulnhunter-fix/references/verification-table-rules.md:48
            }
            if (r.get(9) == "NEEDS_REWORK" && θ["p.verification-table-rules.needs_rework_halts_delivery"]) throw new DeliveryHalted("Gate 2 refuses NEEDS_REWORK"); // src: vulnhunter-fix/references/verification-table-rules.md:69
        }
    }
}
