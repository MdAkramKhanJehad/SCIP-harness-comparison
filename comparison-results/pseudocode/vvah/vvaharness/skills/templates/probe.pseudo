// file: vvaharness/skills/templates/probe.sh
// Read-only template/view probe: template inventory, layouts first, the whole sink battery across dialects,
// a per-<form> CSRF-token verdict, CSRF machinery, info disclosure, sanitizers, render sites, CSP. Exits 0.

@executedBy(CODE) @role(tool) @stage("S4")
class TemplatesProbe {

    String run(String root, Theta θ) {
        Out out = new Out();
        // skip VCS / deps / build / vendor dirs and the skill's own files
        List<String> tplFiles = Grep.nonEmptyFiles(root, Includes.TEMPLATE_DIALECTS, Excludes.SKIP).head(5000); // src: vvaharness/skills/templates/probe.sh:81
        out.line("== TEMPLATE/VIEW PROBE: root=" + root + " ==");                                    // src: vvaharness/skills/templates/probe.sh:98
        for (String section : θ["p.skill_templates.probe_sink_battery"]) {                          // src: vvaharness/skills/templates/probe.sh:117
            out.section(section);
            if (section.equals("template inventory")) emit(tplFiles.countByExtension(), 45, out);   // src: vvaharness/skills/templates/probe.sh:100
            else if (section.equals("layouts/partials")) emit(tplFiles.filter(f -> f.isLayoutOrPartialName()), 40, out); // src: vvaharness/skills/templates/probe.sh:105
            else if (section.startsWith("URL/event-handler/script")) {
                emit(tgrep(Patterns.URL_CONTEXT), 60, out);                                         // src: vvaharness/skills/templates/probe.sh:136
                emit(tgrep(Patterns.EVENT_HANDLER_CONTEXT), 45, out);                               // src: vvaharness/skills/templates/probe.sh:140
                emit(scriptContext(tplFiles), 45, out);                                              // src: vvaharness/skills/templates/probe.sh:161
                emit(tgrep(Patterns.UNQUOTED_ATTR_AND_CSS).dedup(), 40, out);                        // src: vvaharness/skills/templates/probe.sh:166
            }
            else emit(Battery.grep(section, tplFiles).dedup(), Battery.cap(section), out);          // src: vvaharness/skills/templates/probe.sh:117
        }
        if (θ["p.skill_templates.probe_csrf_form_verdict"]) csrfForms(root, out);                  // src: vvaharness/skills/templates/probe.sh:175
        out.line("== END OF PROBE (sections printing (none) are themselves findings) ==");           // src: vvaharness/skills/templates/probe.sh:268
        return out.exit0();
    }

    void emit(List<String> data, int cap, Out out) {
        if (data.isEmpty()) { out.line("(none)"); return; }                                          // src: vvaharness/skills/templates/probe.sh:68
        out.lines(data.head(cap).map(l -> l.normWhitespace().truncate(170)));                        // src: vvaharness/skills/templates/probe.sh:73
        if (data.size() > cap) out.line("... " + data.size() + " matches, showing first " + cap);    // src: vvaharness/skills/templates/probe.sh:75
    }

    List<String> tgrep(String regex) {
        return Grep.rEn(regex, Includes.TEMPLATE_DIALECTS, Excludes.SKIP);                           // src: vvaharness/skills/templates/probe.sh:90
    }

    List<String> scriptContext(List<String> tplFiles) {
        List<String> out = new List<String>();
        for (String f : tplFiles) {
            int inScript = 0;
            for (Line l : Fs.lines(f)) {
                boolean interp = l.lower().hasTemplateInterpolation();                               // src: vvaharness/skills/templates/probe.sh:148
                if (interp && (inScript > 0 || l.lower().contains("<script"))) {
                    String enc = l.lower().matches("tojson|json_script|json.stringify|escapejs|template.js|jsonify") ? "ENCODED?" : "RAW"; // src: vvaharness/skills/templates/probe.sh:151
                    out.add(f + ":" + l.no + ": [" + enc + "] " + l.text.truncate(150));
                }
                inScript = Math.max(0, inScript + l.count("<script") - l.count("</script"));        // src: vvaharness/skills/templates/probe.sh:156
            }
        }
        return out;
    }

    void csrfForms(String root, Out out) {
        List<String> forms = new List<String>();
        for (String f : Grep.filesMatching("<form", Includes.TEMPLATE_DIALECTS, Excludes.SKIP)) {   // src: vvaharness/skills/templates/probe.sh:213
            for (FormSpan span : Html.formSpans(f)) {
                String verb = span.body.matches("method=(post|put|delete|patch)") ? "STATE-CHANGING" : "GET/UNSPECIFIED"; // src: vvaharness/skills/templates/probe.sh:203
                String tok = span.body.matches("csrf|xsrf|authenticity_token|antiforgerytoken|hidden_tag|_token|requestverificationtoken") ? "token-present" : "NO-TOKEN"; // src: vvaharness/skills/templates/probe.sh:205
                forms.add(f + ":" + span.startLine + ": " + verb + " " + tok + " (" + span.action() + ")");
            }
        }
        out.line("-- verdict counts over every form found --");
        emit(forms.countBy(x -> x.verbAndToken()), 10, out);                                         // src: vvaharness/skills/templates/probe.sh:217
        out.line("-- forms with NO token field inside the form span --");
        emit(forms.filter(x -> x.contains("NO-TOKEN")), 60, out);                                    // src: vvaharness/skills/templates/probe.sh:220
        out.section("FORM HELPERS THAT EMIT A TOKEN THEMSELVES");
        emit(tgrep("form_with|form_for|form_tag|hidden_tag|csrf_meta_tags|BeginForm|csrf_token"), 25, out); // src: vvaharness/skills/templates/probe.sh:224
        out.section("CSRF MACHINERY PRESENT REPO-WIDE (zero hits => EVERY state-changing form is CWE-352)"); // src: vvaharness/skills/templates/probe.sh:228
        emit(Grep.rEn("CSRFProtect|WTF_CSRF|csrf_token|csrfmiddlewaretoken|CsrfViewMiddleware|authenticity_token|protect_from_forgery|AntiForgeryToken", Includes.ALL, Excludes.SKIP), 35, out); // src: vvaharness/skills/templates/probe.sh:230
        out.line("-- form base classes (wtforms.Form has no token; flask_wtf.FlaskForm does) --");
        out.lines(Grep.rEn("class X((wtforms.)?(Form|FlaskForm|ModelForm|forms.Form))|from flask_wtf|FlaskForm|Flask-WTF", Includes.SRC, Excludes.SKIP)); // src: vvaharness/skills/templates/probe.sh:233
    }
}
