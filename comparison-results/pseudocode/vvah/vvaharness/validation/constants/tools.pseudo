// file: vvaharness/validation/constants/tools.py
// Tool-name vocabularies for the validation agent: the deterministic fact tools and the DeepAgents default grant.

@executedBy(CODE) @role(config) @stage("S11")
class ConstantsTools {

    List<String> factTools(Theta θ) {
        return θ["code.validation.constants.tools.fact_tools"];                                     // DiffTouched, ChangedLines, DiffImpactMap, PatternScan, TestInventory  // src: vvaharness/validation/constants/tools.py:24
    }

    List<String> defaultFactTools(Theta θ) {
        if (!θ["code.validation.constants.tools.default_grant_includes_read_tools"]) return factTools(θ);
        return Harness.READ_TOOLS.sorted().concat(factTools(θ));                                     // DeepAgents grant  // src: vvaharness/validation/constants/tools.py:33
    }
}
