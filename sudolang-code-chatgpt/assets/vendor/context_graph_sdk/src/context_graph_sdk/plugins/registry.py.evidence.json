  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Explicit registry for trusted project-local graph enrichers.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Iterable, Iterator\n\nfrom context_graph_sdk.errors import ModelValidationError\n\nfrom .base import GraphEnricher, PluginMetadata, PluginPhase\n\nMAX_LOCAL_PLUGINS = 64\n_MAX_NAME_LENGTH = 128\n_MAX_VERSION_LENGTH = 64\n_MAX_PRIORITY = 10_000\n_LOCAL_PHASES = frozenset({PluginPhase.PRE_DERIVATION, PluginPhase.POST_DERIVATION})\n\n\nclass PluginRegistry:\n    def __init__(self, plugins: Iterable[object] = ()) -> None:\n        candidates = tuple(plugins)\n        if len(candidates) > MAX_LOCAL_PLUGINS:\n            raise ModelValidationError(f\"local plugin count exceeds {MAX_LOCAL_PLUGINS}\")\n        registered: list[GraphEnricher] = []\n        names: set[str] = set()\n        for plugin in candidates:\n            if not isinstance(plugin, GraphEnricher):\n                raise ModelValidationError(\"local plugin must implement GraphEnricher\")\n            metadata = plugin.metadata\n            _validate_metadata(metadata)\n            if metadata.name in names:\n                raise ModelValidationError(f\"duplicate local plugin name: {metadata.name}\")\n            names.add(metadata.name)\n            registered.append(plugin)\n        self._plugins = tuple(sorted(registered, key=lambda plugin: plugin.metadata.ordering_key))\n\n    def __bool__(self) -> bool:\n        return bool(self._plugins)\n\n    def __len__(self) -> int:\n        return len(self._plugins)\n\n    def __iter__(self) -> Iterator[GraphEnricher]:\n        return iter(self._plugins)\n\n    def for_phase(self, phase: PluginPhase) -> tuple[GraphEnricher, ...]:\n        if phase not in _LOCAL_PHASES:\n            raise ModelValidationError(f\"unsupported local plugin phase: {phase.value}\")\n        return tuple(plugin for plugin in self._plugins if plugin.metadata.phase == phase)\n\n\ndef _validate_metadata(metadata: PluginMetadata) -> None:\n    if metadata.phase not in _LOCAL_PHASES:\n        raise ModelValidationError(\n            f\"local plugin {metadata.name!r} uses unsupported phase {metadata.phase.value}\"\n        )\n    if len(metadata.name) > _MAX_NAME_LENGTH:\n        raise ModelValidationError(\"plugin name exceeds bound\")\n    if len(metadata.version) > _MAX_VERSION_LENGTH:\n        raise ModelValidationError(\"plugin version exceeds bound\")\n    if not -_MAX_PRIORITY <= metadata.priority <= _MAX_PRIORITY:\n        raise ModelValidationError(\"plugin priority exceeds bound\")\n",
