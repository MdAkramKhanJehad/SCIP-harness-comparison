    String normalizeRepoUrl(String raw) {
        String url = raw.strip();
        if (url.isEmpty()) return "";                                                            // src: vulnhunter-agent/agent/runner.py:316
        if (url.matches("^git@host:path$")) url = "https://" + host + "/" + path;                // src: vulnhunter-agent/agent/runner.py:319
