// file: vvaharness/pipeline/stages/s8/outcomes.py
// Step 8's output contract (RankedEntry / ChainEntry / ChainReport field descriptions the model reads),
// the salvaging parse, the deterministic severity floor, and the reducer onto FinalReport with the
// chain gates (step validity, same-location collapse, link evidence, severity lift gate, dedup).

@executedBy(MODEL) @role(prompt) @stage("S8")
class S8Outcomes {

    Schema schema(Theta θ) {
        // ChainReport, declaration order = property order: ranked_findings, chains, summary (last).
        Prompt p = new Prompt();
        p.must(θ["p.s8_outcomes.ranked_findings_sparse"]);                                      // src: vvaharness/pipeline/stages/s8/outcomes.py:159
        p.rule(θ["p.s8_outcomes.ranked_findings_omitted_keep_cvss"]);                           // src: vvaharness/pipeline/stages/s8/outcomes.py:160
        p.forbid(θ["p.s8_outcomes.ranked_findings_no_echo"]);                                   // src: vvaharness/pipeline/stages/s8/outcomes.py:162
        p.include(rankedEntry(θ));
        p.rule(θ["p.s8_outcomes.chains_two_or_more_empty_ok"]);                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:164
        p.forbid(θ["p.s8_outcomes.chains_invented_worse_than_none"]);                           // src: vvaharness/pipeline/stages/s8/outcomes.py:165
        p.include(chainEntry(θ));
        p.format(θ["p.s8_outcomes.summary_2_to_4_sentences_last"]);                             // src: vvaharness/pipeline/stages/s8/outcomes.py:167
        p.must(θ["p.s8_outcomes.summary_only_listed_chains"]);                                  // src: vvaharness/pipeline/stages/s8/outcomes.py:168
        p.include(LinkEvidence.schema(θ));
        return Schema.of("ChainReport", p);
    }

    Prompt rankedEntry(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s8_outcomes.ranked_finding_id_echo"]);                                    // src: vvaharness/pipeline/stages/s8/outcomes.py:73
        p.rule(θ["p.s8_outcomes.ranked_severity_leave_empty"]);                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:75
        p.rule(θ["p.s8_outcomes.ranked_severity_precedence_disclosed"]);                        // src: vvaharness/pipeline/stages/s8/outcomes.py:76
        p.choose(θ["p.s8_outcomes.ranked_severity_set"]);                                       // src: vvaharness/pipeline/stages/s8/outcomes.py:77
        p.format(θ["p.s8_outcomes.exploitability_notes_max_two_sentences"]);                    // src: vvaharness/pipeline/stages/s8/outcomes.py:79
        p.rule(θ["p.s8_outcomes.exploitability_notes_omit_when_feeds_only"]);                   // src: vvaharness/pipeline/stages/s8/outcomes.py:80
        p.rule(θ["p.s8_outcomes.feeds_definition"]);                                            // src: vvaharness/pipeline/stages/s8/outcomes.py:82
        p.must(θ["p.s8_outcomes.feeds_record_even_unevidenced"]);                               // src: vvaharness/pipeline/stages/s8/outcomes.py:84
        p.forbid(θ["p.s8_outcomes.feeds_never_same_file_line"]);                                // src: vvaharness/pipeline/stages/s8/outcomes.py:85
        p.forbid(θ["p.s8_outcomes.feeds_never_precondition_or_amplifier"]);                     // src: vvaharness/pipeline/stages/s8/outcomes.py:86
        return p;
    }

    Prompt chainEntry(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s8_outcomes.chain_title_few_words"]);                                     // src: vvaharness/pipeline/stages/s8/outcomes.py:103
        p.format(θ["p.s8_outcomes.chain_steps_min_two_ids_only"]);                              // src: vvaharness/pipeline/stages/s8/outcomes.py:105
        p.forbid(θ["p.s8_outcomes.chain_steps_same_location_one_fact"]);                        // src: vvaharness/pipeline/stages/s8/outcomes.py:106
        p.rule(θ["p.s8_outcomes.chain_severity_leave_empty"]);                                  // src: vvaharness/pipeline/stages/s8/outcomes.py:108
        p.rule(θ["p.s8_outcomes.chain_blocked_by_controls"]);                                   // src: vvaharness/pipeline/stages/s8/outcomes.py:111
        p.format(θ["p.s8_outcomes.chain_narrative_one_sentence"]);                              // src: vvaharness/pipeline/stages/s8/outcomes.py:113
        p.forbid(θ["p.s8_outcomes.chain_narrative_no_retelling"]);                              // src: vvaharness/pipeline/stages/s8/outcomes.py:114
        p.evidence(θ["p.s8_outcomes.link_evidence_one_per_adjacent_pair"]);                     // src: vvaharness/pipeline/stages/s8/outcomes.py:117
        p.format(θ["p.s8_outcomes.link_evidence_ids_left_empty"]);                              // src: vvaharness/pipeline/stages/s8/outcomes.py:118
        p.evidence(θ["p.s8_outcomes.link_evidence_mechanism_and_location"]);                    // src: vvaharness/pipeline/stages/s8/outcomes.py:119
        p.forbid(θ["p.s8_outcomes.link_unevidenced_drop_chain"]);                               // src: vvaharness/pipeline/stages/s8/outcomes.py:120
        p.evidence(θ["p.s8_outcomes.entry_reachability_cite_entry_point"]);                     // src: vvaharness/pipeline/stages/s8/outcomes.py:122
        p.rule(θ["p.s8_outcomes.chain_preconditions_non_default_state"]);                       // src: vvaharness/pipeline/stages/s8/outcomes.py:125
        p.must(θ["p.s8_outcomes.chain_preconditions_off_default_must_say"]);                    // src: vvaharness/pipeline/stages/s8/outcomes.py:127
        return p;
    }

    @executedBy(CODE)
    Map salvageEntries(Map data) {
        // An unsalvageable ranked/chain entry drops alone and is counted; chains_invalid accumulates.
        if (!data.containsKey("chains")) Counters.bump("s8_chains_key_absent");                 // src: vvaharness/pipeline/stages/s8/outcomes.py:182
        for (String field : List.of("ranked_findings", "chains")) {                             // src: vvaharness/pipeline/stages/s8/outcomes.py:185
            if (data.get(field) is List) data.put(field, salvage(data.get(field)));             // src: vvaharness/pipeline/stages/s8/outcomes.py:188
        }
        return data;
    }

    @executedBy(CODE)
    ChainReport parseChainReply(String raw) {
        try { return ChainReport.validateJson(raw); }                                           // src: vvaharness/pipeline/stages/s8/outcomes.py:204
        catch (ValueError e) { return ChainReport.validate(JsonExtract.extract(raw)); }         // src: vvaharness/pipeline/stages/s8/outcomes.py:206
    }

    @executedBy(CODE)
    List<String> findingIds(List<Finding> findings) {
        return range(findings.size()).map(i -> "f" + i);                                        // src: vvaharness/pipeline/stages/s8/outcomes.py:211
    }

    @executedBy(CODE)
    Severity finalSeverity(Finding f, Severity llmLabel) {
        // VulContextSeverity band first, else base CVSS band, else the LLM's label; OffensivePriority never folded in.
        Severity s = sevFromBand(f.vsvsRating);                                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:363
        if (s == null) s = sevFromBand(f.cvssRating);                                           // src: vvaharness/pipeline/stages/s8/outcomes.py:364
        return s != null ? s : llmLabel;                                                        // src: vvaharness/pipeline/stages/s8/outcomes.py:365
    }

    @executedBy(CODE)
    Severity sevFromBand(String rating) {
        return Map.of("critical", CRITICAL, "high", HIGH, "medium", MEDIUM, "low", LOW).get(rating.lower()); // src: vvaharness/pipeline/stages/s8/outcomes.py:358
    }

    @executedBy(CODE)
    int offensiveRank(Finding f) {
        // P1 first, unset last.
        String op = f.offensivePriority.upper();
        return (op.length() == 2 && op[0] == 'P' && op[1].isDigit()) ? op[1] : 9;               // src: vvaharness/pipeline/stages/s8/outcomes.py:392
    }

    @executedBy(CODE)
    String templatedSummary(List<RankedFinding> ranked) {
        if (ranked.isEmpty()) return "No verified findings.";                                   // src: vvaharness/pipeline/stages/s8/outcomes.py:447
        return ranked.size() + " verified finding(s): " + Counts.bySeverity(ranked);            // src: vvaharness/pipeline/stages/s8/outcomes.py:453
    }

    @executedBy(CODE)
    FinalReport deterministicReport(ContextPackage ctx, List<Finding> findings, List<DroppedFinding> dropped, int rawCount, ScanMetrics metrics, String enrichmentFailure, Theta θ) {
        // The always-computable floor: ordered report, deterministic severities, no chains, templated summary.
        for (Finding f : findings) f.severityProseMismatch = "";                                // src: vvaharness/pipeline/stages/s8/outcomes.py:462
        List<RankedFinding> ranked = findings.map(f -> rankedFinding(f, finalSeverity(f, f.severity), "(enrichment unavailable - severity from CVSS or the detection label)")); // src: vvaharness/pipeline/stages/s8/outcomes.py:464
        ranked = sortAndRemap(ranked, dropped);                                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:468
        return new FinalReport(findings = ranked, chains = List.of(), summary = templatedSummary(ranked),
                               degraded = true, enrichmentUnavailable = true,
                               degradedReason = "chain/narrative enrichment unavailable: " + enrichmentFailure); // src: vvaharness/pipeline/stages/s8/outcomes.py:470
    }

    @executedBy(CODE)
    Chain buildChain(ChainEntry item, List<RankedFinding> ranked, Map indexOf, Map origToSorted, Map proseIds, String repoRoot, Set<Integer> window, boolean gateOn, boolean checksOn) {
        Pair nh = S8Validate.annotateHedges(item.narrative);                                    // src: vvaharness/pipeline/stages/s8/outcomes.py:505
        // One link per step (origin link included) with no ids: drop the leading origin link.
        if (item.linkEvidence.size() == item.steps.size() && item.steps.size() >= 2 && allIdsEmpty(item.linkEvidence)) item.linkEvidence = item.linkEvidence.rest(); // src: vvaharness/pipeline/stages/s8/outcomes.py:508
        ChainProse prose = remapItemProse(item, nh.narrative, proseIds);                        // src: vvaharness/pipeline/stages/s8/outcomes.py:514
        List<Integer> steps = item.steps.filter(s -> indexOf.containsKey(s) && (window == null || window.contains(indexOf.get(s)))).map(indexOf::get); // src: vvaharness/pipeline/stages/s8/outcomes.py:517
        List<String> unknown = item.steps.filter(s -> !indexOf.containsKey(s) || (window != null && !window.contains(indexOf.get(s)))); // src: vvaharness/pipeline/stages/s8/outcomes.py:521
        List<Integer> named = steps.map(origToSorted::get);
        Pair rd = S8Validate.collapseSameLocation(named, ranked);                               // src: vvaharness/pipeline/stages/s8/outcomes.py:528
        List<Integer> remapped = rd.kept;
        if (remapped.size() < 2) {                                                              // src: vvaharness/pipeline/stages/s8/outcomes.py:531
            Counters.bump("s8_chain_dropped_unresolved_steps");
            return null;
        }
        if (!unknown.isEmpty()) prose.narrative += "\n\n_Note: this chain referenced finding ids that were omitted._"; // src: vvaharness/pipeline/stages/s8/outcomes.py:544
        // Links placed on adjacent path hops only; citations resolved against the repo.
        List<LinkEvidence> links = new List();
        for (LinkEvidence ln : positionallyFilled(item)) {                                      // src: vvaharness/pipeline/stages/s8/outcomes.py:555
            if (pathHops(remapped).contains(alias(ln))) links.add(resolvedLink(ln, repoRoot)); // src: vvaharness/pipeline/stages/s8/outcomes.py:558
        }
        Triple lk = S8Validate.linkOk(links, remapped, repoRoot);                               // src: vvaharness/pipeline/stages/s8/outcomes.py:572
        List<Integer> hardening = S8Validate.hardeningSteps(remapped, ranked);                  // src: vvaharness/pipeline/stages/s8/outcomes.py:574
        List<String> qualityNotes = new List();
        List<String> disclosures = new List();
        if (checksOn) qualityNotes.addAll(S8Validate.qualityAnnotations(item, remapped, ranked, repoRoot, lk.ok, lk.resolved, lk.hops, hardening)); // src: vvaharness/pipeline/stages/s8/outcomes.py:579

        // Severity gate.
        boolean explained = !prose.blocked.isEmpty() || !prose.preconditions.isEmpty();         // src: vvaharness/pipeline/stages/s8/outcomes.py:592
        List<Severity> hopSevs = remapped.map(st -> ranked[st].severity);
        Pair md = modelOrDerivedChainSeverity(item.severity, hopSevs);                          // src: vvaharness/pipeline/stages/s8/outcomes.py:594
        Severity severity = md.sev;
        Severity floor = strongest(remapped.map(st -> sevFromBand(ranked[st].finding.vsvsRating) ?: sevFromBand(ranked[st].finding.cvssRating)).nonNull()); // src: vvaharness/pipeline/stages/s8/outcomes.py:601
        Severity effective = strongest(hopSevs);                                                // src: vvaharness/pipeline/stages/s8/outcomes.py:602
        boolean allowed = !gateOn || S8Validate.liftAllowed(lk.ok, hardening, nh.hedged);      // src: vvaharness/pipeline/stages/s8/outcomes.py:604
        String decision = "";
        if (floor != null && weaker(md.sev, floor) && (md.derived || !explained)) {             // src: vvaharness/pipeline/stages/s8/outcomes.py:610
            if (allowed) { severity = floor; prose.narrative += "\n\n_Severity aligned to the highest-severity finding in this path._"; } // src: vvaharness/pipeline/stages/s8/outcomes.py:612
            else decision = "lift_withheld";                                                    // src: vvaharness/pipeline/stages/s8/outcomes.py:619
        } else if (weaker(severity, effective) && !explained) {
            Counters.bump("s8_chain_severity_under_hops");                                      // src: vvaharness/pipeline/stages/s8/outcomes.py:622
        } else if (stronger(md.sev, effective)) {
            // A model self-raise above every hop is capped unless the chain earned it.
            if (!allowed) { severity = effective; decision = "self_raise_capped"; }             // src: vvaharness/pipeline/stages/s8/outcomes.py:625
        }
        if (!decision.isEmpty()) disclosures.add(CAP_ANNOTATION);                               // src: vvaharness/pipeline/stages/s8/outcomes.py:631
        return new Chain(prose.title, remapped, severity, prose.blocked, prose.preconditions, links, prose.reachability,
                         qualityNotes, disclosures, decision, checksOn ? lk.resolved + "/" + lk.hops : "", prose.narrative); // src: vvaharness/pipeline/stages/s8/outcomes.py:634
    }

    @executedBy(CODE)
    Pair<FinalReport, Set<Integer>> hydrateReport(ChainReport data, ContextPackage ctx, List<Finding> findings, List<DroppedFinding> dropped, int rawCount, ScanMetrics metrics, Set<Integer> window, Theta θ) {
        Map indexOf = findingIds(findings).indexMap();                                          // src: vvaharness/pipeline/stages/s8/outcomes.py:657
        List<RankedFinding> ranked = new List();
        Set<Integer> covered = new Set();
        Set claims = new Set();
        for (RankedEntry item : data.rankedFindings) {                                          // src: vvaharness/pipeline/stages/s8/outcomes.py:662
            Integer idx = indexOf.get(item.findingId.strip());
            if (window != null && idx != null && !window.contains(idx)) idx = null;             // src: vvaharness/pipeline/stages/s8/outcomes.py:664
            if (idx == null || covered.contains(idx)) continue;                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:667
            covered.add(idx);
            for (String token : item.feeds) {                                                   // src: vvaharness/pipeline/stages/s8/outcomes.py:672
                Integer t = indexOf.get(token.strip());
                if (t != null && (window == null || window.contains(t)) && t != idx) claims.add(Pair.of(idx, t)); // src: vvaharness/pipeline/stages/s8/outcomes.py:677
            }
            Severity parsedSev = coerceSevOrNone(item.severity);
            // The model's word only counts when there is no CVSS/VulContext band.
            Severity shipped = finalSeverity(findings[idx], parsedSev != null ? parsedSev : findings[idx].severity); // src: vvaharness/pipeline/stages/s8/outcomes.py:684
            findings[idx].severityProseMismatch = parsedSev != null ? severityProseMismatch(parsedSev, shipped) : ""; // src: vvaharness/pipeline/stages/s8/outcomes.py:686
            ranked.add(rankedFinding(findings[idx], shipped, item.exploitabilityNotes));        // src: vvaharness/pipeline/stages/s8/outcomes.py:689
        }
        for (int i : range(findings.size())) {                                                  // src: vvaharness/pipeline/stages/s8/outcomes.py:694
            if (!covered.contains(i)) ranked.add(rankedFinding(findings[i], finalSeverity(findings[i], findings[i].severity),
                (window == null || window.contains(i)) ? ScanFindings.NOT_RANKED_NOTE : "(not sent to the enrichment pass - report windowed)")); // src: vvaharness/pipeline/stages/s8/outcomes.py:696
        }
        ranked = sortAndRemap(ranked, dropped);                                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:704
        boolean gateOn = θ["step8.severity_lift_gate"];                                         // src: vvaharness/pipeline/stages/s8/outcomes.py:708
        boolean checksOn = θ["step8.chain_quality_checks"];                                     // src: vvaharness/pipeline/stages/s8/outcomes.py:709
        boolean dedupOn = θ["step8.chain_dedup"];                                               // src: vvaharness/pipeline/stages/s8/outcomes.py:710
        // Prose fN ids become #N (sorted report positions); schema terms reworded in the summary.
        String summary = rewordSchemaTerms(remapProseIds(data.summary, proseIds));              // src: vvaharness/pipeline/stages/s8/outcomes.py:723
        List<Chain> chains = new List();
        int chainsDropped = 0;
        for (ChainEntry item : data.chains) {                                                   // src: vvaharness/pipeline/stages/s8/outcomes.py:730
            Chain c = buildChain(item, ranked, indexOf, origToSorted, proseIds, ctx.repoRoot, window, gateOn, checksOn);
            if (c == null) chainsDropped += 1; else chains.add(c);
        }
        List unpromoted = List.of();
        if (checksOn) unpromoted = S8Validate.unpromotedLinks(claims, chains, ranked);           // src: vvaharness/pipeline/stages/s8/outcomes.py:747
        int chainsDeduped = 0;
        if (dedupOn) {                                                                          // src: vvaharness/pipeline/stages/s8/outcomes.py:754
            Triple dd = S8Validate.dedupChains(chains);                                         // src: vvaharness/pipeline/stages/s8/outcomes.py:755
            chains = dd.kept; chainsDeduped = dd.merged;
            for (Pair ab : dd.pairs) chains[ab.a].disclosures.add(S8Validate.NEAR_DUPLICATE_NOTE); // src: vvaharness/pipeline/stages/s8/outcomes.py:768
        }
        chains.sortBy(c -> Pair.of(SEV_RANK[c.severity], !c.blockedByControls.isEmpty()));       // src: vvaharness/pipeline/stages/s8/outcomes.py:772
        return Pair.of(new FinalReport(findings = ranked, chains = chains, chainsDropped = chainsDropped, chainsDeduped = chainsDeduped,
                                       chainsInvalid = data.chainsInvalid, unpromotedLinks = unpromoted, summary = summary), covered); // src: vvaharness/pipeline/stages/s8/outcomes.py:774
    }

    @executedBy(CODE)
    Pair modelOrDerivedChainSeverity(String raw, List<Severity> hopSevs) {
        // A blank severity is the schema's own instruction ("the host derives it"): derive the weakest hop.
        Severity parsed = coerceSevOrNone(raw);                                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:236
        if (parsed != null) return Pair.of(parsed, false);
        Counters.bump("s8_chain_severity_derived");
        return Pair.of(weakest(hopSevs), true);                                                 // src: vvaharness/pipeline/stages/s8/outcomes.py:240
    }

    @executedBy(CODE)
    String severityProseMismatch(Severity modelLabel, Severity shipped) {
        return modelLabel == shipped ? "" : "Model-assessed severity differs from the CVSS/VulContextSeverity band that determines the shipped rating."; // src: vvaharness/pipeline/stages/s8/outcomes.py:375
    }
}
