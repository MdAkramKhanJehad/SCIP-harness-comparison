# vvaharness/detect/matcher.py

Regular-expression matching of a `MatchSpec` corpus against raw source text. Line specs (sources and sinks) match one line at a time. Detector rules match an anchor and then read a span (one line, a balanced call, or a block) and apply present, absent, file and proximity gates before producing a hit.

Source: `vvaharness/detect/matcher.py` (lines 1-300)
Executor: code
Called from: `vvaharness/detect/__init__.py` (scan_files); compile_detectors and detector_hits from the Stage 5 detector pass (`pipeline/stages/s5/detectors.py`) and from `pipeline/stages/s1_autoexclude.py`

// src: vvaharness/detect/matcher.py:24-36
_SNIPPET_MAX = 120
Hit {
  // frozen
  file: String
  line: Number
  spec: MatchSpec
  snippet: String       // stripped line, cut to _SNIPPET_MAX characters
  line_end: Number = 0  // last line of a multi-line detector span; 0 = single-line hit
}

// src: vvaharness/detect/matcher.py:43-57
fn split_lines(text):executor=code {
  // not str.splitlines(): it breaks on \f and U+2028, which no line numbering agrees with
  lines = split text on "\n"; drop one trailing empty element; strip one trailing "\r" from each line
}
fn _read_text(repo_root, rel_path):executor=code {
  try return read repo_root/rel_path as UTF-8 with replacement characters;
  catch OS error => return null   // an unreadable file yields no hits
}

// src: vvaharness/detect/matcher.py:60-83
fn scan_file(repo_root, rel_path, compiled):executor=code {
  text = _read_text(repo_root, rel_path); if (text == null) return []
  for each (line_no from 1, line) in split_lines(text) {
    for each (spec, rx) in compiled { if (rx searches line) emit Hit(rel_path, line_no, spec, first _SNIPPET_MAX of strip(line)) }
  }
  // every spec that matches a line yields its own hit; no role filter here, no comment skipping
}
fn scan_files(repo_root, rel_paths, specs):executor=code {
  compiled = for each spec: (spec, compile(spec.pattern))
  return concatenation of scan_file(repo_root, p, compiled) for each p in rel_paths   // input order
}

// src: vvaharness/detect/matcher.py:89-116
CompiledDetector { spec; pattern; present | null; absent | null; file_gate | null; near | null; span_end | null }
fn compile_detectors(specs):executor=code {
  return compiled detectors for specs where role == "detector" && enabled   // other roles and disabled rules are dropped
  // an empty gate string compiles to null (no gate)
}

// src: vvaharness/detect/matcher.py:119-159
// String literals are blanked character for character before parenthesis counting, so a parenthesis inside a literal cannot break a call span.
// Triple-quoted forms come first in the alternation; an unterminated triple quote masks to the end of the line and carries into the next line.
// Single-quote masking is per line by design.
fn _mask_strings(seg, in_triple=""):executor=code;

// src: vvaharness/detect/matcher.py:162-204
fn _call_span(lines, idx, col, max_lines):executor=code {
  depth = 0
  for each line i from idx while i < min(idx + max_lines, length(lines)) {
    seg = if (i == idx) lines[i] from col else lines[i]
    walk _mask_strings(seg): "(" => depth += 1; ")" => depth -= 1, and if depth == 0 return (text up to and including this paren, i + 1)
    // text after the balancing paren is trimmed, so a sibling call cannot satisfy a gate
  }
  return null   // never balanced within the cap
}
fn _block_span(lines, idx, col, end_rx, max_lines):executor=code {
  collect lines from (idx, col); return (text, i + 1) at the first line matching end_rx within max_lines; else null
}
fn _span_for(det, lines, idx, col):executor=code {
  match (det.spec.span) {
    case "call" => _call_span(lines, idx, col, max(1, span_max_lines))
    case "block" when det.span_end != null => _block_span(lines, idx, col, det.span_end, max(1, span_max_lines))
    default => (lines[idx], idx + 1)   // the whole anchor line (not from col)
  }
}

// src: vvaharness/detect/matcher.py:207-225
fn _guard_text(det, lines, idx, body, end_line):executor=code {
  // only the negative gate widens: present_re keeps the narrow span or a neighbour would fire it
  if (det.spec.absent_window <= 0) return body
  return lines[max(0, idx - absent_window) .. min(length, end_line + absent_window)) joined
}
fn _near_ok(det, lines, idx):executor=code {
  if (det.near == null) return true
  return det.near searches lines[max(0, idx - near_window) .. min(length, idx + near_window + 1)) joined
}

// src: vvaharness/detect/matcher.py:232-239
fn _live_detectors(lines, detectors):executor=code {
  if (no detector has a file gate) return detectors
  return detectors where file_gate == null || file_gate searches the whole file text
}

// src: vvaharness/detect/matcher.py:242-283 — one file's pass; spans are memoised per (span, span_end, span_max_lines, idx, start) so same-anchor rules share one walk
fn _FileScan.hit(det, idx, line, start):executor=code {
  span = memoised _span_for(det, lines, idx, start)
  if (span == null) return null   // never balanced or closed within the cap: do not guess
  [body, end_line] = span
  // src: vvaharness/detect/matcher.py:258-264 — rejection gates
  if (det.present != null && !(det.present searches body)) return null
  if (det.absent != null && det.absent searches _guard_text(det, lines, idx, body, end_line)) return null
  if (!_near_ok(det, lines, idx)) return null
  return Hit(rel_path, idx + 1, det.spec, first _SNIPPET_MAX of strip(line), end_line)
}
fn _FileScan.line_hits(live, idx, line):executor=code {
  for each det in live { m = det.pattern searches line; if (m) emit hit(det, idx, line, m.start) when not null }   // at most one hit per rule per line (first anchor only)
}

// src: vvaharness/detect/matcher.py:286-300
fn detector_hits(rel_path, lines, detectors):executor=code {
  live = if (detectors) _live_detectors(lines, detectors) else []
  if (live is empty) return []
  skip_comments = rel_path ends with ".py"   // Python only: "#" opens a CSS selector or an anchor href in template text
  for each (idx, line) in lines {
    if (skip_comments && line left-stripped starts with "#") continue
    hits += _FileScan.line_hits(live, idx, line)
  }
  // preserved: spec.languages is not checked here; any language filtering happens in the caller
}
