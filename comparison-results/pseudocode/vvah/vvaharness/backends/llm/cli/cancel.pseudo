// file: vvaharness/backends/llm/cli/cancel.py
// Ctrl-C propagation for the cli route: a process-global abort flag, the live `claude` process registry,
// out-of-band abort hooks, and the process-tree kill / graceful stop.

@executedBy(CODE) @role(backend)
class Cancel {

    Event ABORT = new Event();                                                                              // only the main thread sees KeyboardInterrupt; pool workers poll this // src: vvaharness/backends/llm/cli/cancel.py:33
    Set<Process> LIVE = new Set();                                                                          // in-flight claude subprocesses // src: vvaharness/backends/llm/cli/cancel.py:35
    List<Runnable> ABORT_HOOKS = new List();                                                                // for processes not in LIVE (cli_mcp bridge) // src: vvaharness/backends/llm/cli/cancel.py:94
    // own process group per `claude` so the whole tree can be signalled (posix); Windows uses taskkill /T
    Map NEW_GROUP_KW = OS.isWindows() ? Map.of() : Map.of("start_new_session", true);                       // src: vvaharness/backends/llm/cli/cancel.py:43

    @src("vvaharness/backends/llm/cli/cancel.py:38")
    boolean aborted() {
        return ABORT.isSet();                                                                               // src: vvaharness/backends/llm/cli/cancel.py:39
    }

    /** Kill proc AND the tool processes it spawned (its process group, never ours). */
    @src("vvaharness/backends/llm/cli/cancel.py:46")
    void killTree(Process proc) {
        if (proc.poll() != null) return;                                                                    // already exited // src: vvaharness/backends/llm/cli/cancel.py:49
        try {
            if (OS.isWindows()) {                                                                           // src: vvaharness/backends/llm/cli/cancel.py:52
                Subprocess.run(List.of("taskkill", "/F", "/T", "/PID", proc.pid), 10);                      // 10 s timeout // src: vvaharness/backends/llm/cli/cancel.py:53
                return;
            }
            Integer pgid = OS.getpgid(proc.pid);                                                            // null on OSError // src: vvaharness/backends/llm/cli/cancel.py:57
            if (pgid != null && pgid != OS.getpgrp()) OS.killpg(pgid, SIGKILL);                             // never signal our own group // src: vvaharness/backends/llm/cli/cancel.py:61
            else proc.kill();                                                                               // src: vvaharness/backends/llm/cli/cancel.py:64
        } catch (Exception e) {
            try { proc.kill(); } catch (Exception ignored) { }                                              // last resort: the direct child // src: vvaharness/backends/llm/cli/cancel.py:68
        }
    }

    /** SIGINT the group, wait up to grace, then killTree: a SIGINT'd session flushes its file and stays resumable. */
    @src("vvaharness/backends/llm/cli/cancel.py:73")
    void stopTree(Process proc, double grace) {
        if (proc.poll() != null) return;                                                                    // src: vvaharness/backends/llm/cli/cancel.py:76
        if (OS.isWindows()) {                                                                               // src: vvaharness/backends/llm/cli/cancel.py:78
            killTree(proc);
            return;
        }
        try {
            int pgid = OS.getpgid(proc.pid);
            if (pgid != OS.getpgrp()) OS.killpg(pgid, SIGINT);                                              // src: vvaharness/backends/llm/cli/cancel.py:84
        } catch (OSError e) { }
        try {
            proc.wait(grace);                                                                               // src: vvaharness/backends/llm/cli/cancel.py:88
        } catch (TimeoutExpired e) {
            killTree(proc);                                                                                 // src: vvaharness/backends/llm/cli/cancel.py:90
        }
    }

    @src("vvaharness/backends/llm/cli/cancel.py:97")
    void registerAbortHook(Runnable fn) {
        if (!ABORT_HOOKS.contains(fn)) ABORT_HOOKS.add(fn);                                                 // src: vvaharness/backends/llm/cli/cancel.py:99
    }

    /** Set the stop flag and kill every in-flight `claude` subprocess; returns the count signalled. */
    @src("vvaharness/backends/llm/cli/cancel.py:103")
    int abort() {
        ABORT.set();                                                                                        // src: vvaharness/backends/llm/cli/cancel.py:105
        List<Process> procs = LIVE.copy();                                                                  // under LIVE_LOCK // src: vvaharness/backends/llm/cli/cancel.py:107
        for (Process p : procs) killTree(p);                                                                // src: vvaharness/backends/llm/cli/cancel.py:109
        for (Runnable hook : ABORT_HOOKS.copy()) {                                                          // a hook may register another mid-teardown // src: vvaharness/backends/llm/cli/cancel.py:111
            try { hook.run(); } catch (Exception e) { }                                                     // hooks must never raise // src: vvaharness/backends/llm/cli/cancel.py:113
        }
        return procs.size();                                                                                // src: vvaharness/backends/llm/cli/cancel.py:116
    }

    /** Clear the flag so a programmatic abort() doesn't poison later repos in a batch run. */
    @src("vvaharness/backends/llm/cli/cancel.py:119")
    void resetAbort() {
        ABORT.clear();                                                                                      // src: vvaharness/backends/llm/cli/cancel.py:121
    }
}
