// file: vulnhunter-agent/agent/issues_fetch.py
// Paginated fetch of open issues carrying a label (the issues-stage dedup pool). Pull requests are
// dropped; each page is retried once on 429/5xx; hitting max_open_issues fails the stage.

@executedBy(CODE) @role(io) @stage("issues")
class IssuesFetch {

    boolean isRetryable(int statusCode) {
        return θ["code.agent.issues_fetch.retryable_statuses"].matches(statusCode);               // src: vulnhunter-agent/agent/issues_fetch.py:39
    }

    // fetch_open_issues_with_label: all open issues with `label`, server-paginated.
    List<OpenIssue> fetchOpenIssuesWithLabel(String targetRepoUrl, String label, boolean logRetries) {
        String token = TokenClient.getGithubToken("scan", θ["github.*"]);                         // src: vulnhunter-agent/agent/issues_fetch.py:67
        if (token == "") throw new IssuesFetchError("scan_token is required to list issues for dedup."); // src: vulnhunter-agent/agent/issues_fetch.py:68
        (String owner, String name) = Github.parseOwnerRepo(targetRepoUrl);                       // src: vulnhunter-agent/agent/issues_fetch.py:72
        String api = Github.apiBase(θ["github.*"].host);                                          // src: vulnhunter-agent/agent/issues_fetch.py:73
        List<OpenIssue> out = new List();
        int page = 1;                                                                             // src: vulnhunter-agent/agent/issues_fetch.py:82
        int perPage = θ["code.agent.issues_fetch.per_page"];                                      // src: vulnhunter-agent/agent/issues_fetch.py:83
        HttpClient client = new HttpClient(Auth.resolveVerify(config.tls), θ["issues.request_timeout_seconds"], new BrokerTokenAuth("scan", θ["github.*"])); // src: vulnhunter-agent/agent/issues_fetch.py:87
        while (true) {
            String url = api + "/repos/" + owner + "/" + name + "/issues";                       // src: vulnhunter-agent/agent/issues_fetch.py:92
            Map params = Map.of("state", "open", "labels", label, "per_page", perPage, "page", page); // src: vulnhunter-agent/agent/issues_fetch.py:93
            Response resp = getWithRetry(client, url, params, label, owner, name, page, logRetries); // src: vulnhunter-agent/agent/issues_fetch.py:99
            Object batch = resp.json();                                                           // src: vulnhunter-agent/agent/issues_fetch.py:100
            if (!(batch instanceof List)) throw new IssuesFetchError("unexpected non-list response"); // src: vulnhunter-agent/agent/issues_fetch.py:101
            if (batch.isEmpty()) break;                                                           // src: vulnhunter-agent/agent/issues_fetch.py:105
            for (Map raw : batch) {
                if (θ["code.agent.issues_fetch.skip_pull_requests"] && raw.containsKey("pull_request")) continue; // src: vulnhunter-agent/agent/issues_fetch.py:108
                out.add(coerce(raw));                                                             // src: vulnhunter-agent/agent/issues_fetch.py:111
                if (out.size() >= θ["issues.max_open_issues"]) throw new IssuesFetchError("hit max_open_issues; refine the label or raise the cap"); // src: vulnhunter-agent/agent/issues_fetch.py:112
            }
            if (batch.size() < perPage) break;                                                    // src: vulnhunter-agent/agent/issues_fetch.py:118
            page += 1;                                                                            // src: vulnhunter-agent/agent/issues_fetch.py:120
        }
        return out;
    }

    // _get_with_retry: one retry on a retryable status, after a fixed backoff; else IssuesFetchError.
    Response getWithRetry(HttpClient client, String url, Map params, String label, String owner, String name, int page, boolean logRetries) {
        Response resp = null;
        for (int attempt = 0; attempt < θ["code.agent.issues_fetch.page_attempts"]; attempt++) { // src: vulnhunter-agent/agent/issues_fetch.py:145
            resp = client.get(url, params);                                                       // src: vulnhunter-agent/agent/issues_fetch.py:146
            if (resp.statusCode == 200) return resp;                                              // src: vulnhunter-agent/agent/issues_fetch.py:147
            if (!isRetryable(resp.statusCode)) break;                                             // src: vulnhunter-agent/agent/issues_fetch.py:149
            if (attempt == 0) {                                                                   // src: vulnhunter-agent/agent/issues_fetch.py:151
                if (logRetries) log.info("retrying once after backoff");                          // src: vulnhunter-agent/agent/issues_fetch.py:152
                sleep(θ["code.agent.issues_fetch.retry_backoff_seconds"]);                       // src: vulnhunter-agent/agent/issues_fetch.py:163
            }
        }
        throw new IssuesFetchError("GET issues failed: " + resp.statusCode + " " + resp.text.take(200)); // src: vulnhunter-agent/agent/issues_fetch.py:164
    }

    // _coerce: labels may be dicts with "name" or bare strings.
    OpenIssue coerce(Map raw) {
        List<String> labels = new List();
        for (Object lab : orElse(raw.get("labels"), List.of())) {                                 // src: vulnhunter-agent/agent/issues_fetch.py:172
            if (lab instanceof Map && lab.containsKey("name")) labels.add(str(lab.get("name")));  // src: vulnhunter-agent/agent/issues_fetch.py:173
            else if (lab instanceof String) labels.add(lab);                                      // src: vulnhunter-agent/agent/issues_fetch.py:175
        }
        return new OpenIssue(int(raw.get("number")), str(raw.get("title")), str(orElse(raw.get("body"), "")), str(raw.get("html_url")), labels); // src: vulnhunter-agent/agent/issues_fetch.py:177
    }
}

@executedBy(CODE) @role(types)
record OpenIssue(int number, String title, String body, String htmlUrl, List<String> labels) { }

@executedBy(CODE) @role(types)
class IssuesFetchError extends RuntimeError { }
