# vvaharness/util/console.py

The product's human-facing output: banner, status tables and single lines on standard error. All text is redacted and terminal control characters are replaced. No pipeline decision depends on it.

Source: `vvaharness/util/console.py` (lines 1-185)
Executor: code
Called from: command-line commands, preflight and doctor tables, `vvaharness/util/pricing.py`, `warn_once.py`, `scan_progress.py`

// src: vvaharness/util/console.py:32-34, 49, 63-71
ICON = { ok: "✓", warn: "⚠", fail: "✗", skip: "–" }
NO_BANNER_ENV = "VVAHARNESS_NO_BANNER"
_PIPED_WIDTH = 200   // table width when the stream is not a terminal
// src: vvaharness/util/console.py:74-86
fn console(err=true) { return a rich Console on standard error (or standard output), colour off when NO_COLOR is set, width _PIPED_WIDTH when the stream is not a terminal }   // external: rich
// redact() is in vvaharness/report/redact.py
fn _safe(text) { return redact(text) with every control character except newline and tab (0x00-0x08, 0x0B-0x1F, 0x7F-0x9F) replaced by a space }

// src: vvaharness/util/console.py:100-125
fn banner(err=true, force=false):executor=code {
  if (!force && (VVAHARNESS_NO_BANNER set || stream is not a terminal)) return false
  // abstracted: prints the wordmark (or plain "VVAH" when the encoding cannot carry it), version and tag line
  return true
}

// src: vvaharness/util/console.py:128-185
fn write(text, err=true);                 // one line, _safe applied
fn counts(stage, label, ...fields);       // "[stage] label  k v · k v"; returns "k=v ..." for telemetry
fn status_table(title, columns);          // borderless table
fn status_row(table, outcome, ...cells);  // glyph-led row
fn mark(outcome, text, indent=2, lead="", err=true);
// abstracted: rich rendering (external: rich)
