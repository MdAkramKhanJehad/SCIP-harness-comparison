# vvaharness/rules/__init__.py

The per-CWE taint knowledge base `CweKB`. It loads `generic.kb.yaml` (and `cwe_kb.yaml` when present, plus optional overlay files), merges entries by normalized CWE id, and answers lookups of sources, sinks, sanitizers, non-sanitizers and false-positive checks, filtered by language. Stage 4 reaches it through the `CweGuidance` tool (`rules/kb_tools.py`). It never raises into the pipeline: an unreadable file degrades to no entries.

Source: `vvaharness/rules/__init__.py` (lines 1-213)
Executor: code
Called from: `vvaharness/rules/kb_tools.py` CweGuidance (`CweKB.load().for_cwes`)

// src: vvaharness/rules/__init__.py:31-36
RULES_DIR = directory of this module
_LIST_KEYS = ("sources", "sinks", "sanitizers", "non_sanitizers", "fp_checks")
_LANG_PREFIX_RX = /^([a-z][a-z0-9_+-]{0,15}):\s+(.+)$/   // "python: cursor.execute"; deliberately strict so free text with ":" is not a language tag

// src: vvaharness/rules/__init__.py:55-69
CweKB {
  _by_cwe: Map<String, Slot>   // "CWE-89" -> { cwe, title, origin[], sources[], sinks[], sanitizers[], non_sanitizers[], fp_checks[] }
  len: number of keys (aliases count)
  contains(cwe): norm_cwe(cwe) is a key
  State { _cache: CweKB | null = null }   // class-level, process-wide
}

// src: vvaharness/rules/__init__.py:71-90
fn CweKB.load(rules_dir = null, overlays = null, include_all_extras = false):executor=code {
  use_default = rules_dir == null
  overlay_list = _overlay_list(overlays)
  cacheable = use_default && overlay_list is empty && !include_all_extras
  if (cacheable && _cache != null) return _cache
  d = rules_dir or, when absent, RULES_DIR
  merged = {}
  include_extras = include_all_extras || rules_dir != null   // a custom directory loads every *.kb.yaml in it
  for each p in _kb_files(d, overlay_list, include_extras) {
    for each entry in _read(p), _merge(merged, entry)
  }
  kb = CweKB(merged)
  if (cacheable) _cache = kb
  return kb
}

// src: vvaharness/rules/__init__.py:92-98
fn _overlay_list(overlays):executor=code {
  match (overlays) {
    case null => []
    case String or Path => [overlays]
    default => [each p as string where p is not blank]
  }
}

// src: vvaharness/rules/__init__.py:100-122
fn _kb_files(d, overlays, include_all_extras):executor=code {
  if (!d is a directory) return []
  files = []
  for each name in ["cwe_kb.yaml", "generic.kb.yaml"] {   // built-ins first so their titles define the class
    if (d/name is a file) files.append(d/name)
  }
  // preserved: "cwe_kb.yaml" is listed first but no such file ships in vvaharness/rules/; only generic.kb.yaml is present
  if (include_all_extras) files += sorted(d/*.kb.yaml) not already listed
  for each raw in overlays {
    p = if (raw is relative && d/raw is a file) d/raw else raw
    if (p is a file && p not in files) files.append(p)   // a missing overlay is skipped silently
  }
  return files
}

// src: vvaharness/rules/__init__.py:124-132
fn _read(p):executor=code {
  try doc = yaml.safe_load(read p) || {};
  catch (OSError | yaml.YAMLError) => { warn RULEPACK_LOAD_FAILED; return [] }   // never abort the scan
  return [e in doc.entries where e is a dict]   // [] when doc is not a mapping or has no entries
}

// src: vvaharness/rules/__init__.py:134-155
fn _merge(acc, entry):executor=code {
  cwe = norm_cwe(entry.cwe)
  if (!cwe) return   // unparseable id: entry dropped
  slot = acc[cwe] or, when absent, new slot { cwe, title: "", origin: [], each _LIST_KEYS: [] }
  if (slot.title is empty) slot.title = entry.title   // first file to name a title wins
  if (entry.origin && entry.origin not in slot.origin) slot.origin.append(entry.origin)
  for each k in _LIST_KEYS, for each trimmed non-empty v in entry[k] not already in slot[k], slot[k].append(v)   // repeated CWE entries accumulate
  for each a in entry.aliases {
    an = norm_cwe(a)
    if (an && an not in acc) acc[an] = slot   // the alias shares the same slot object
  }
}

// src: vvaharness/rules/__init__.py:39-52
fn _filter_lang(items, lang):executor=code {
  out = []
  for each it in items {
    if (it matches _LANG_PREFIX_RX as (tag, body)) {
      if (lang != null && tag != lang) skip it   // with lang == null every tagged item is kept
      it = body                                  // prefix stripped
    }
    if (it not in out) out.append(it)
  }
  return out
}

// src: vvaharness/rules/__init__.py:157-180
fn CweKB.for_cwes(cwes, lang = null):executor=code {
  if (cwes is a string) cwes = [cwes]
  out = { cwe: [], title: [], origin: [], each _LIST_KEYS: [] }
  seen_slots = {}
  for each c in cwes {
    slot = _by_cwe[norm_cwe(c)]
    if (slot == null || slot already in seen_slots) continue   // an alias and its target contribute once
    seen_slots.add(slot)
    out.cwe.append(slot.cwe)
    if (slot.title) out.title.append(slot.title)
    out.origin += slot.origin entries not already present
    for each k in _LIST_KEYS, out[k] += items of _filter_lang(slot[k], lang) not already present
  }
  return out   // a miss still returns every key, with cwe == []
}

// src: vvaharness/rules/__init__.py:182-213
fn CweKB.prompt_block(cwes, lang = null, limit = 20):executor=code {
  ctx = for_cwes(cwes, lang)
  if (every _LIST_KEYS list in ctx is empty) return ""
  head = "TAINT KB — ${ ctx.title joined by \" / \" or ctx.cwe joined by \", \" }"
  if (ctx.origin) head += "  (origin: ${ ctx.origin joined by \", \" })"
  lines = [head]
  // label order is fixed; `sources` is never rendered
  for each [key, label] in [
    ["sanitizers",     "SANITIZERS — if ANY of these sits on the path, REFUTE:"],
    ["non_sanitizers", "NON-SANITIZERS — these look safe but are NOT; do NOT refute on their basis alone:"],
    ["fp_checks",      "FP CHECKS — if ANY is true, REFUTE:"],
    ["sinks",          "KNOWN SINKS — for reference; the candidate sink should match one of these shapes:"]
  ] {
    items = first `limit` of ctx[key]
    if (items is empty) continue
    lines.append("  $label"); lines += "    - $it" for each it
    if (length(ctx[key]) > limit) lines.append("    - …(+N more)")
  }
  return lines joined by newline + newline
}
