// file: vvaharness/backends/llm/registry.py, vvaharness/config/profiles/default.yaml, vvaharness/config/__init__.py
// Backend dispatcher: every stage calls prompt()/agentic() here; a model node (id, via, provider, extras) picks the route.
// Also holds the per-role model routing table and the route-wide transport/cache/refusal/pricing settings.

@executedBy(CODE) @role(backend)
class LlmRegistry {

    // via: deepagents is deliberately NOT a registered backend: stages branch to it themselves for these roles
    Set<String> DEEPAGENTS_ROLES = Set.of("remediate", "validate", "preprocess", "autoexclude", "threatmodel", "decompose", "deepdive", "verify", "dedup", "chain", "graph_annotate", "exploit_verification.classify", "exploit_verification.mapper", "exploit_verification.judge", "exploit_verification.attacker"); // src: vvaharness/backends/llm/registry.py:40
    Map<String, String> BACKENDS = Map.of("cli", "LlmCli", "sdk", "LlmSdk", "openai", "LlmOpenai"); // src: vvaharness/backends/llm/registry.py:137

    /** Normalize a model config: a bare string takes the default via; else its id/via/extras win. */
    @src("vvaharness/backends/llm/registry.py:112")
    ResolvedModel resolve(Object modelCfg, Theta θ) {
        if (modelCfg instanceof String) return new ResolvedModel(modelCfg, θ["code.default_llm_via"], new Extras()); // src: vvaharness/backends/llm/registry.py:114
        if (modelCfg.id == null) throw new ValueError("Model config must be a string or have an id field"); // src: vvaharness/backends/llm/registry.py:118
        String via = modelCfg.via != null ? modelCfg.via : θ["code.default_llm_via"];                       // src: vvaharness/backends/llm/registry.py:122
        Extras extras = new Extras();
        if (modelCfg.temperature != null) extras.temperature = modelCfg.temperature;                        // src: vvaharness/backends/llm/registry.py:124
        if (modelCfg.thinkingBudget != null) extras.thinkingBudget = modelCfg.thinkingBudget;               // src: vvaharness/backends/llm/registry.py:127
        if (modelCfg.betas != null) extras.betas = modelCfg.betas;                                          // src: vvaharness/backends/llm/registry.py:130
        return new ResolvedModel(modelCfg.id, via, extras);                                                 // src: vvaharness/backends/llm/registry.py:132
    }

    Backend getBackend(String via, String modelId) {
        if (!BACKENDS.containsKey(via)) throw new ValueError("Unknown backend via");                        // src: vvaharness/backends/llm/registry.py:162
        return Backend.load(BACKENDS.get(via));                                                             // imported lazily // src: vvaharness/backends/llm/registry.py:164
    }

    /** Single-turn completion routed to the selected backend. */
    @src("vvaharness/backends/llm/registry.py:219")
    String prompt(Object userPrompt, Object model, Effort effort, Theta θ) {
        ResolvedModel r = resolve(model, θ);                                                                // src: vvaharness/backends/llm/registry.py:221
        Backend backend = getBackend(r.via, r.modelId);
        int maxTokens = clampOutputTokens(model);                                                           // a model's declared max_tokens only ever lowers // src: vvaharness/backends/llm/registry.py:224
        if (r.via == "cli") {
            // the claude binary has no flag for temperature/thinking_budget/betas: dropped with a one-time WARN
            warnCliDroppedKnobs(r.modelId, r.extras);                                                       // src: vvaharness/backends/llm/registry.py:241
            userPrompt = foldForCli(userPrompt);                                                            // cache_prefix folded into the user turn // src: vvaharness/backends/llm/registry.py:242
        } else {
            // e.g. models.deepdive.temperature reaches sdk/openai only
            for (String k : r.extras.keys()) { }                                                            // extras forwarded as kwargs // src: vvaharness/backends/llm/registry.py:244
        }
        return backend.prompt(userPrompt, r.modelId, maxTokens, effort);                                    // src: vvaharness/backends/llm/registry.py:246
    }

    /** Tool-using loop routed to the selected backend. */
    @src("vvaharness/backends/llm/registry.py:249")
    String agentic(Prompt userPrompt, Object model, List<String> tools, Path cwd, int maxTurns, int timeout, Theta θ) {
        ResolvedModel r = resolve(model, θ);                                                                // src: vvaharness/backends/llm/registry.py:252
        Backend backend = getBackend(r.via, r.modelId);
        if (r.via == "cli") warnCliDroppedKnobs(r.modelId, r.extras);                                       // src: vvaharness/backends/llm/registry.py:254
        String text = backend.agentic(userPrompt, r.modelId, tools, cwd, maxTurns, timeout);               // src: vvaharness/backends/llm/registry.py:262
        ResponseQuality.check(text);                                                                        // degenerate reply -> VVAH-E003 // src: vvaharness/backends/llm/registry.py:264
        return text;
    }

    /** via deepagents: stages call Deepagents directly with these route-wide switches. */
    @src("vvaharness/backends/llm/deepagents.py:950")
    String dispatchDeepagents(Prompt userPrompt, Object model, Effort effort, Theta θ) {
        // reasoning written in the system prompt instead of native thinking (no-op on models that reject it)
        boolean thinkInPrompt = θ["think_in_prompt"];                                                       // src: vvaharness/backends/llm/deepagents.py:952
        // the ONLY cache-marker switch that reaches deepagents is the sdk block's key
        boolean markers = θ["sdk.cache_markers"] != "off";                                                  // src: vvaharness/backends/llm/deepagents.py:826
        return Deepagents.agentic(userPrompt, model, effort, markers, thinkInPrompt, θ);                    // src: vvaharness/backends/llm/deepagents.py:711
    }

    /** A refused call may be re-sent identically once, on Anthropic routes only (an OpenAI-compatible cyber filter can revoke the org). */
    @src("vvaharness/backends/llm/models.py:510")
    boolean refusalResendAllowed(Object modelCfg, Theta θ) {
        // load() refuses values outside 0..1; 0 also disables the S6 refused-batch split
        if (θ["refusal_retries"] <= 0) return false;                                                        // src: vvaharness/backends/llm/models.py:514
        ResolvedModel r = resolve(modelCfg, θ);
        return Manifest.resolvedRoute(r.via, r.modelId, modelCfg.provider) == "anthropic";                  // src: vvaharness/backends/llm/models.py:523
    }

    int clampOutputTokens(Object model) { }
    void warnCliDroppedKnobs(String modelId, Extras extras) { }
    Object foldForCli(Object userPrompt) { }
}

@executedBy(CODE) @role(config)
@src("vvaharness/config/profiles/default.yaml")
class LlmRegistryConfig {

    /** The per-role model routing table (profile layer; no builtin default). via changes what max_turns, budgets and tools mean. */
    ModelNode modelFor(String role, Theta θ) {
        switch (role) {
            case "autoexclude":   return new ModelNode(θ["models.autoexclude.id"], θ["models.autoexclude.via"], θ["models.autoexclude.provider"]);
            // S1 makes no model call
            case "preprocess":    return new ModelNode(θ["models.preprocess.id"], θ["models.preprocess.via"], θ["models.preprocess.provider"]);
            case "threatmodel":   return new ModelNode(θ["models.threatmodel.id"], θ["models.threatmodel.via"], θ["models.threatmodel.provider"]);
            // S3 makes no model call
            case "decompose":     return new ModelNode(θ["models.decompose.id"], θ["models.decompose.via"], θ["models.decompose.provider"]);
            // temperature dropped on the cli route
            case "deepdive":      return new ModelNode(θ["models.deepdive.id"], θ["models.deepdive.via"], θ["models.deepdive.provider"], θ["models.deepdive.temperature"]);
            case "verify":        return new ModelNode(θ["models.verify.id"], θ["models.verify.via"], θ["models.verify.provider"]);
            // only called when step7_dedup.semantic is true
            case "dedup":         return new ModelNode(θ["models.dedup.id"], θ["models.dedup.via"], θ["models.dedup.provider"]);
            case "chain":         return new ModelNode(θ["models.chain.id"], θ["models.chain.via"], θ["models.chain.provider"]);
            case "remediate":     return new ModelNode(θ["models.remediate.id"], θ["models.remediate.via"], θ["models.remediate.provider"]);
            case "validate.orchestrator":         return new ModelNode(θ["models.validate.orchestrator.id"], θ["models.validate.orchestrator.via"], θ["models.validate.orchestrator.provider"]);
            case "validate.security_architect":   return new ModelNode(θ["models.validate.security_architect.id"]);
            case "validate.penetration_tester":   return new ModelNode(θ["models.validate.penetration_tester.id"]);
            case "validate.cross_repo_analyzer":  return new ModelNode(θ["models.validate.cross_repo_analyzer.id"]);
            case "exploit_verification.attacker": return new ModelNode(θ["models.exploit_verification.attacker.id"], θ["models.exploit_verification.attacker.via"], θ["models.exploit_verification.attacker.provider"]);
            case "exploit_verification.judge":    return new ModelNode(θ["models.exploit_verification.judge.id"], θ["models.exploit_verification.judge.via"], θ["models.exploit_verification.judge.provider"]);
            case "exploit_verification.classify": return new ModelNode(θ["models.exploit_verification.classify.id"], θ["models.exploit_verification.classify.via"], θ["models.exploit_verification.classify.provider"]);
            case "exploit_verification.mapper":   return new ModelNode(θ["models.exploit_verification.mapper.id"], θ["models.exploit_verification.mapper.via"], θ["models.exploit_verification.mapper.provider"]);
        }
        return null;
    }

    /** Cache markers: pushed to sdk and openai unconditionally (cache_markers off suppresses them on cli/sdk/openai, not deepagents). */
    @src("vvaharness/orchestrator/preflight.py:106")
    void configureCache(Theta θ) {
        Object markers = θ["cache_markers"];                                                                // src: vvaharness/orchestrator/preflight.py:106
        Integer minBlock = θ["cache_min_block_tokens"];                                                     // null = published per-model minimums // src: vvaharness/orchestrator/preflight.py:107
        // auto detects the regime from the base_url host, failing closed to no markers
        String route = θ["cache_route"];                                                                    // src: vvaharness/orchestrator/preflight.py:109
        LlmSdk.configureCache(markers, minBlock, route);                                                    // src: vvaharness/orchestrator/preflight.py:110
        LlmOpenai.configureCache(markers);                                                                  // src: vvaharness/orchestrator/preflight.py:113
    }

    /** sdk: block -> Anthropic SDK and deepagents route credentials/TLS. */
    @src("vvaharness/orchestrator/preflight.py:115")
    void configureSdk(Path cfgDir, boolean sdkSole, Theta θ) {
        LlmSdk.configure(
            θ["sdk.api_key"],                                                                               // src: vvaharness/orchestrator/preflight.py:120
            θ["sdk.base_url"],                                                                              // src: vvaharness/orchestrator/preflight.py:121
            cfgDir.resolve(θ["sdk.verify_ssl"]),                                                            // a path form is anchored at the profile dir // src: vvaharness/orchestrator/preflight.py:122
            θ["sdk.ca_cert"],                                                                               // src: vvaharness/orchestrator/preflight.py:123
            θ["sdk.client_cert"],                                                                           // src: vvaharness/orchestrator/preflight.py:124
            sdkSole);                                                                                       // ANTHROPIC_API_KEY fallback allowed // src: vvaharness/orchestrator/preflight.py:126
    }

    /** openai: block -> OpenAI-compatible route credentials/TLS. */
    @src("vvaharness/orchestrator/preflight.py:128")
    void configureOpenai(Path cfgDir, Theta θ) {
        LlmOpenai.configure(
            θ["openai.api_key"],                                                                            // src: vvaharness/orchestrator/preflight.py:132
            θ["openai.base_url"],                                                                           // src: vvaharness/orchestrator/preflight.py:133
            cfgDir.resolve(θ["openai.verify_ssl"]),                                                         // src: vvaharness/orchestrator/preflight.py:134
            θ["openai.ca_cert"]);                                                                           // src: vvaharness/orchestrator/preflight.py:135
    }

    /** Graph plugins; the semgrep plugin adds 4 read-only tools to S2, S4 and S6. */
    @src("vvaharness/orchestrator/scan.py:585")
    PluginSet loadPluginSet(Config cfg, Theta θ) {
        return PluginSet.load(θ["sdk.plugins"]);                                                            // src: vvaharness/orchestrator/scan.py:585
    }

    /** Price table used to cost per-stage tokens; none bundled, so every cost_usd is null without it. */
    @src("vvaharness/orchestrator/scan.py:552")
    PriceTable pricingTable(Theta θ) {
        return Pricing.loadCached(θ["pricing.file"]);                                                       // src: vvaharness/orchestrator/scan.py:552
    }

    /** One WARN naming role models with no rate, only when pricing.file is set. */
    @src("vvaharness/orchestrator/entry.py:123")
    void pricingNote(Config cfg, Theta θ) {
        if (θ["pricing.file"] == null) return;                                                              // src: vvaharness/orchestrator/entry.py:126
    }
}
