# vvaharness/remediation_agent/policy_gate/diffscan.py

Extracts the changed-file set from a unified diff (git or synthesized), and maps the policy action plus gate status to an ACCEPT or REJECT verdict.

Source: `vvaharness/remediation_agent/policy_gate/diffscan.py` (lines 1-62)
Executor: code
Called from: `policy/postgate.sudo`

// src: vvaharness/remediation_agent/policy_gate/diffscan.py:22-25
_DIFF_GIT_RE = /^diff --git a\/(.+?) b\/(.+?)\s*$/
_PLUS_RE = /^\+\+\+ (?:b\/)?(.+?)\s*$/
_MINUS_RE = /^--- (?:a\/)?(.+?)\s*$/

// src: vvaharness/remediation_agent/policy_gate/diffscan.py:28-55
fn inspect_diff(diff_text):executor=code {
  if (!diff_text) return []
  // every path named in "diff --git" (the b/ side), "+++" and "---" headers, first-seen order, no duplicates, "/dev/null" ignored
  for each line in diff_text {
    match (line) {
      case _DIFF_GIT_RE => add group 2 (or group 1)
      case _PLUS_RE => add group 1
      case _MINUS_RE => add group 1
    }
  }
  return the added paths
}

// src: vvaharness/remediation_agent/policy_gate/diffscan.py:58-62
fn cap_verdict(action, all_gates_passed):executor=code {
  if (action == GUIDANCE_ONLY) return "REJECT"
  return if (all_gates_passed) "ACCEPT" else "REJECT"
}
