// file: vvaharness/models/scan/_sections_pipeline.py
// Report helpers: the chunk-kind line of Scan Metrics and the Pipeline Diagnostics block, which turns
// non-default stage counters (truncation, caps, retries, unenforced evidence gates, clamps) into disclosures.

@executedBy(CODE) @role(io) @stage("S9")
class SectionsPipeline {

    String renderChunkKindLine(FinalReport report) {
        ScanMetrics m = report.metrics;
        List<String> parts;
        if (!m.chunksByKind.isEmpty()) {
            // _CHUNK_KIND_LABELS display order: risk, catch-all, specialist, taint, threat, other; unknown kinds appended
            parts = CHUNK_KIND_LABELS.filter(k -> m.chunksByKind.has(k.key)).map(k -> k.label + "=" + m.chunksByKind.get(k.key)); // src: vvaharness/models/scan/_sections_pipeline.py:34
            parts.addAll(m.chunksByKind.filterKeys(k -> !CHUNK_KIND_LABELS.has(k)));                 // src: vvaharness/models/scan/_sections_pipeline.py:36
        } else {
            parts = List.of("risk=" + m.chunksRisk, "catch-all=" + m.chunksCatchall, "specialist=" + m.chunksSpecialist); // legacy trio // src: vvaharness/models/scan/_sections_pipeline.py:40
        }
        return "- Chunks: " + m.chunksTotal + " (" + parts.join(", ") + ")";                       // src: vvaharness/models/scan/_sections_pipeline.py:42
    }

    List<String> renderPipelineDiagnostics(FinalReport report, boolean unreachableAppendix) {
        // only a non-default counter emits: a zero cannot tell "never ran" from "ran clean"
        ScanMetrics m = report.metrics;
        List<String> lines = new List();
        if (m.s2Degraded) lines.add("- Threat model: degraded - fell back to the deterministic passes only"); // src: vvaharness/models/scan/_sections_pipeline.py:57
        if (m.s2ThreatsRaw > 0) lines.add("- Threats identified before ranking: <n>");             // src: vvaharness/models/scan/_sections_pipeline.py:63
        if (m.s2ThreatsTruncated > 0) lines.add("- Threats truncated by the prompt cap: <n>");      // src: vvaharness/models/scan/_sections_pipeline.py:65
        if (m.s2ThreatsPromoted > 0) lines.add("- Threats re-promoted after truncation to keep a trust boundary covered: <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:67
        if (anyNonZero(m.s2FrontierFilesExcluded, m.s2FrontierEntryPointsExcluded, m.s2FrontierSinksExcluded, m.s2FrontierModulesExcluded)) lines.add("- Threat-model evidence excluded by step2 caps: ..."); // src: vvaharness/models/scan/_sections_pipeline.py:77
        if (anyNonZero(m.s2InventoryFilesTruncated, m.s2PromptEntryPointsTruncated, m.s2PromptModulesTruncated)) lines.add("- Threat-model prompt truncated by step2 caps: ..."); // src: vvaharness/models/scan/_sections_pipeline.py:86
        if (m.s2AssetsTruncated > 0) lines.add("- Assets truncated by step2.max_assets: <n>");      // src: vvaharness/models/scan/_sections_pipeline.py:91
        if (m.s2TrustBoundariesTruncated > 0) lines.add("- Trust boundaries truncated by step2.max_trust_boundaries: <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:93
        if (!m.s2BaselineUndisposed.isEmpty()) lines.add("- Baseline checklist items with no threat or open question disposing of them: ..."); // src: vvaharness/models/scan/_sections_pipeline.py:96
        if (!m.s2RepoKinds.isEmpty()) lines.add("- Repository kind(s) detected: ...");              // src: vvaharness/models/scan/_sections_pipeline.py:101
        if (m.s2SurfaceFilesDropped > 0) lines.add("- Threat-model surface paths dropped (no such in-scope file): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:103
        if (m.s3UnknownFileIds > 0) lines.add("- Chunk file references that matched no known file id: <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:109
        if (m.s3DroppedPaths > 0) lines.add("- File references dropped (no matching file found): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:114
        if (m.s3RelocatedPaths > 0) lines.add("- File references repaired by a suffix match: <n> - verify they did not resolve onto the wrong file"); // src: vvaharness/models/scan/_sections_pipeline.py:116
        if (m.s3UnreachableFiles > 0) {
            // the COUNT reports regardless of output.emit_unreachable_appendix; only the list is gated
            String where = (unreachableAppendix && !report.unreachableFiles.isEmpty()) ? "listed in the appendix below" : "set output.emit_unreachable_appendix: true to list them"; // src: vvaharness/models/scan/_sections_pipeline.py:125
            lines.add("- Files named by no investigation unit: <n> of <in_scope> in-scope file(s) got no reviewer - " + where); // src: vvaharness/models/scan/_sections_pipeline.py:129
        }
        if (m.s3ThreatsWithoutUnit > 0) lines.add("- Threats with no investigation unit minted: <n> (" + report.threatsWithoutUnit.map(ScanRender.mdCell).join(", ") + ") - never reviewed."); // src: vvaharness/models/scan/_sections_pipeline.py:139
        if (m.s4FindingsTruncated > 0) lines.add("- Deep-dive findings discarded by the per-call cap (step4.max_findings_per_run): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:145
        if (m.deepagentsOversizePrompts > 0) lines.add("- Calls refused as over-ceiling on the deepagents route (VVAH-E004): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:153
        if (m.llmTruncatedReplies > 0) lines.add("- LLM replies cut off by the output-token budget (VVAH-E005): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:162
        if (m.llmTruncatedRetryAttempted > 0) lines.add("- LLM replies resent at a doubled output-token budget (attempted / recovered)"); // src: vvaharness/models/scan/_sections_pipeline.py:178
        if (m.deepagentsToolStateNotRoundtripped > 0) lines.add("- Tool-call replays rejected for missing per-turn state (VVAH-E006): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:190
        if (m.llmAdapterEvidenceGateUnenforced > 0) lines.add("- Verdicts reached without a required fact-tool call on via: sdk / via: openai (gate is deepagents-only): <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:200
        if (m.cliMcpEvidenceGateUnenforced > 0) lines.add("- Verdicts reached without a required fact-tool call on via: cli: <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:214
        if (m.s6ConfirmedWithoutVector > 0) lines.add("- Verified findings confirmed with no CVSS vector: <n> (severity from own band or detection-time label)"); // src: vvaharness/models/scan/_sections_pipeline.py:227
        if (m.s6CvssZeroImpactOnTp > 0) lines.add("- Verified findings with a zero-impact CVSS vector withheld: <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:240
        if (m.s6ConfidenceClamped > 0) lines.add("- Verifier confidence scores rewritten by the 0-10 clamp: <n>"); // src: vvaharness/models/scan/_sections_pipeline.py:250
        if (m.s6ConfidenceUniform > 0) lines.add("- Every verdict at one confidence: <n> (min_confidence admitted or dropped every TRUE_POSITIVE together)"); // src: vvaharness/models/scan/_sections_pipeline.py:261
        // _STRUCTURED_RETRY_STAGES = s2,s4,s6,s7,s8 ; _TRUNCATED_RETRY_STAGES = s1,s2,s4,s6,s7,s8,ev_classify
        int rejected = STRUCTURED_RETRY_STAGES.sum(s -> m.get(s + "_structured_retry_attempted")); // src: vvaharness/models/scan/_sections_pipeline.py:273
        int clipped = TRUNCATED_RETRY_STAGES.sum(s -> m.get(s + "_truncated_retry_attempted"));    // src: vvaharness/models/scan/_sections_pipeline.py:276
        if (rejected > 0 || clipped > 0 || m.s2EmptyRetryAttempted > 0) {                           // src: vvaharness/models/scan/_sections_pipeline.py:278
            int dropped = m.sdkToolChoiceDroppedForThinking + m.deepagentsToolChoiceDropped;        // src: vvaharness/models/scan/_sections_pipeline.py:281
            lines.add("- Primary model calls re-dispatched: <rejected> after a rejected structured reply, <clipped> after a clipped reply" // src: vvaharness/models/scan/_sections_pipeline.py:282
                + (m.llmStructuredRetryTruncated > 0 ? " ; rejected finals that hit the output budget" : "")
                + (m.s2EmptyRetryAttempted > 0 ? " ; hollow threat model re-sampled" : "")
                + (dropped > 0 ? " ; structured calls with no forced tool_choice under thinking" : ""));
        }
        int repaired = m.s2ParseRepairAttempted + m.s4OutcomeRepairedAttempt + m.s4BatchRepairedAttempt + m.s6OutcomeRepairedAttempt; // src: vvaharness/models/scan/_sections_pipeline.py:304
        if (repaired > 0 || m.llmStructuredProseReask > 0 || m.llmStructuredSubmitRejected > 0) {  // src: vvaharness/models/scan/_sections_pipeline.py:308
            lines.add("- Replies re-asked for their structured shape: json-repair calls, prose re-asks, rejected submits"); // src: vvaharness/models/scan/_sections_pipeline.py:309
        }
        if (lines.isEmpty()) return List.of();                                                      // src: vvaharness/models/scan/_sections_pipeline.py:321
        return List.of("### Pipeline Diagnostics").plus(lines);                                     // src: vvaharness/models/scan/_sections_pipeline.py:323
    }
}
