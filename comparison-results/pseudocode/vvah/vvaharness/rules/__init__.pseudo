// file: vvaharness/rules/__init__.py
// CweKB: in-memory, merge-on-load per-CWE taint knowledge (generic.kb.yaml plus optional overlays).
// Never raises into the pipeline: an unreadable pack degrades to empty. Served to S4/S6 via KbTools (for_cwes).

@executedBy(CODE) @role(types)
record KbSlot(String cwe, String title, List<String> origin, List<String> sources, List<String> sinks,
              List<String> sanitizers, List<String> nonSanitizers, List<String> fpChecks) { }

@executedBy(CODE) @role(rule_set) @stage("S4")
class Rules {

    // RULES_DIR = this package dir. src: vvaharness/rules/__init__.py:31
    // _LIST_KEYS: the per-CWE list sections merged and served. src: vvaharness/rules/__init__.py:33
    List<String> listKeys(Theta θ) {
        return θ["code.rules.kb_list_keys"];                                                      // src: vvaharness/rules/__init__.py:33
    }

    /** Keep unprefixed items and items whose "lang: " prefix matches lang (strip it); dedupe in order. lang null keeps all. */
    List<String> filterLang(List<String> items, String lang, Theta θ) {
        List<String> out = new List(); Set<String> seen = new Set();
        for (String it : items) {                                                                 // src: vvaharness/rules/__init__.py:43
            // restrictive prefix regex: lowercase tag of 1-16 chars, colon, whitespace; free text containing ':' is not a tag
            Match m = Regex.match(θ["code.rules.lang_prefix_rx"], it);                             // src: vvaharness/rules/__init__.py:44
            if (m != null) {                                                                      // src: vvaharness/rules/__init__.py:45
                if (lang != null && m.group(1) != lang) continue;                                 // src: vvaharness/rules/__init__.py:46
                it = m.group(2);                                                                  // src: vvaharness/rules/__init__.py:48
            }
            if (!seen.contains(it)) { seen.add(it); out.add(it); }                                // src: vvaharness/rules/__init__.py:49
        }
        return out;
    }
}

@executedBy(CODE) @role(rule_set) @stage("S4")
class CweKB {

    Map<String, KbSlot> byCwe;                                                                    // aliases point at the same slot object
    static CweKB cache = null;                                                                    // src: vvaharness/rules/__init__.py:69

    int len() { return byCwe.size(); }                                                            // src: vvaharness/rules/__init__.py:63

    boolean contains(Object cwe, Theta θ) {
        String c = RulesCwe.normCwe(cwe, θ);                                                         // src: vvaharness/rules/__init__.py:66
        return c != null && byCwe.containsKey(c);                                                 // src: vvaharness/rules/__init__.py:67
    }

    /** Load and merge the baseline KB and optional overlays; only the default, overlay-free load is cached. */
    static CweKB load(Path rulesDir, Object overlays, boolean includeAllExtras, Theta θ) {
        boolean useDefault = (rulesDir == null);                                                  // src: vvaharness/rules/__init__.py:75
        List<String> overlayList = overlayList(overlays);                                         // src: vvaharness/rules/__init__.py:76
        boolean cacheable = useDefault && overlayList.isEmpty() && !includeAllExtras;             // src: vvaharness/rules/__init__.py:77
        if (cacheable && cache != null) return cache;                                             // src: vvaharness/rules/__init__.py:78
        Path d = (rulesDir != null) ? rulesDir : RULES_DIR;                                       // src: vvaharness/rules/__init__.py:80
        Map<String, KbSlot> merged = new Map();
        boolean includeExtras = includeAllExtras || rulesDir != null;                             // a custom dir loads every *.kb.yaml. src: vvaharness/rules/__init__.py:82
        for (Path p : kbFiles(d, overlayList, includeExtras, θ)) {                                // src: vvaharness/rules/__init__.py:83
            for (Map entry : read(p)) merge(merged, entry, θ);                                    // src: vvaharness/rules/__init__.py:85
        }
        CweKB kb = new CweKB(merged);                                                             // src: vvaharness/rules/__init__.py:87
        if (cacheable) cache = kb;                                                                // src: vvaharness/rules/__init__.py:88
        return kb;
    }

    static List<String> overlayList(Object overlays) {
        if (overlays == null) return new List();                                                  // src: vvaharness/rules/__init__.py:94
        if (overlays instanceof String || overlays instanceof Path) return List.of(overlays.toString()); // src: vvaharness/rules/__init__.py:96
        return overlays.map(p -> p.toString()).filter(s -> !s.strip().isEmpty());               // src: vvaharness/rules/__init__.py:98
    }

    /** Built-ins first (their titles define the class), then *.kb.yaml extras (sorted) if asked, then overlays. */
    static List<Path> kbFiles(Path d, List<String> overlays, boolean includeAllExtras, Theta θ) {
        if (!d.isDir()) return new List();                                                        // src: vvaharness/rules/__init__.py:103
        List<Path> files = new List();
        for (String name : θ["code.rules.builtin_kb_files"]) {                                    // src: vvaharness/rules/__init__.py:107
            Path p = d.resolve(name);
            if (p.isFile() && !files.contains(p)) files.add(p);                                   // src: vvaharness/rules/__init__.py:109
        }
        if (includeAllExtras) {                                                                   // src: vvaharness/rules/__init__.py:111
            for (Path p : sorted(d.glob("*.kb.yaml").filter(x -> x.isFile()))) if (!files.contains(p)) files.add(p); // src: vvaharness/rules/__init__.py:112
        }
        for (String raw : overlayList(overlays)) {                                                // src: vvaharness/rules/__init__.py:115
            Path p = Path.of(raw);
            if (!p.isAbsolute()) { Path cand = d.resolve(p); if (cand.isFile()) p = cand; }       // relative: rules dir first. src: vvaharness/rules/__init__.py:117
            if (p.isFile() && !files.contains(p)) files.add(p);                                   // src: vvaharness/rules/__init__.py:120
        }
        return files;
    }

    /** Dict entries of a pack's entries list; unreadable/invalid YAML -> warning, empty (never aborts the scan). */
    static List<Map> read(Path p) {
        Object doc;
        try { doc = Yaml.safeLoad(p.readText("utf-8")); } catch (OSError | YAMLError e) {         // src: vvaharness/rules/__init__.py:127
            Log.warn("RULEPACK_LOAD_FAILED", p.name);                                             // src: vvaharness/rules/__init__.py:129
            return new List();
        }
        Object entries = (doc instanceof Map) ? doc.get("entries") : null;                        // src: vvaharness/rules/__init__.py:131
        return (entries == null ? new List() : entries).filter(e -> e instanceof Map);            // src: vvaharness/rules/__init__.py:132
    }

    /** Merge one entry into its CWE slot: first title wins, origins and list items appended deduped, aliases share the slot. */
    static void merge(Map<String, KbSlot> acc, Map entry, Theta θ) {
        String cwe = RulesCwe.normCwe(entry.get("cwe"), θ);                                          // src: vvaharness/rules/__init__.py:136
        if (cwe == null) return;                                                                  // src: vvaharness/rules/__init__.py:137
        KbSlot slot = acc.computeIfAbsent(cwe, k -> new KbSlot(cwe, "", new List(), new List(), new List(), new List(), new List(), new List())); // src: vvaharness/rules/__init__.py:139
        if (slot.title.isEmpty()) slot.title = String.valueOf(entry.get("title"));               // src: vvaharness/rules/__init__.py:141
        String origin = String.valueOf(entry.get("origin"));                                      // src: vvaharness/rules/__init__.py:143
        if (!origin.isEmpty() && !slot.origin.contains(origin)) slot.origin.add(origin);          // src: vvaharness/rules/__init__.py:144
        for (String k : Rules.listKeys(θ)) {                                                      // src: vvaharness/rules/__init__.py:146
            for (Object v : entry.getList(k)) {                                                   // src: vvaharness/rules/__init__.py:147
                String s = v.toString().strip();
                if (!s.isEmpty() && !slot.get(k).contains(s)) slot.get(k).add(s);                 // src: vvaharness/rules/__init__.py:149
            }
        }
        for (Object a : entry.getList("aliases")) {                                               // src: vvaharness/rules/__init__.py:152
            String an = RulesCwe.normCwe(a, θ);                                                      // src: vvaharness/rules/__init__.py:153
            if (an != null && !acc.containsKey(an)) acc.put(an, slot);                            // first owner of an alias keeps it. src: vvaharness/rules/__init__.py:154
        }
    }

    /** Merged title/origin/list sections for one or more CWEs, each slot once, items language-filtered. */
    Map forCwes(Object cwes, String lang, Theta θ) {
        if (cwes instanceof String) cwes = List.of(cwes);                                         // src: vvaharness/rules/__init__.py:159
        Map out = Map.of("cwe", new List(), "title", new List(), "origin", new List());           // plus one list per list key. src: vvaharness/rules/__init__.py:161
        Set<KbSlot> seenSlots = new Set();
        for (Object c : cwes) {                                                                   // src: vvaharness/rules/__init__.py:164
            String cn = RulesCwe.normCwe(c, θ);                                                      // src: vvaharness/rules/__init__.py:165
            KbSlot slot = (cn != null) ? byCwe.get(cn) : null;                                    // src: vvaharness/rules/__init__.py:166
            if (slot == null || seenSlots.contains(slot)) continue;                               // alias and canonical id count once. src: vvaharness/rules/__init__.py:167
            seenSlots.add(slot);
            out.get("cwe").add(slot.cwe);                                                         // src: vvaharness/rules/__init__.py:170
            if (!slot.title.isEmpty()) out.get("title").add(slot.title);                          // src: vvaharness/rules/__init__.py:171
            for (String o : slot.origin) out.get("origin").addDistinct(o);                        // src: vvaharness/rules/__init__.py:173
            for (String k : Rules.listKeys(θ)) {                                                  // src: vvaharness/rules/__init__.py:176
                for (String v : Rules.filterLang(slot.get(k), lang, θ)) out.get(k).addDistinct(v); // src: vvaharness/rules/__init__.py:177
            }
        }
        return out;
    }

    /** Compact TAINT KB text block for an S4 confirm/refute prompt. No pipeline caller in this version (tests only). */
    @executedBy(MODEL) @role(prompt)
    String promptBlock(Object cwes, String lang, int limit, Theta θ) {
        Map ctx = forCwes(cwes, lang, θ);                                                         // src: vvaharness/rules/__init__.py:185
        if (Rules.listKeys(θ).noneMatch(k -> !ctx.get(k).isEmpty())) return "";                   // src: vvaharness/rules/__init__.py:186
        String title = !ctx.get("title").isEmpty() ? join(" / ", ctx.get("title")) : join(", ", ctx.get("cwe")); // src: vvaharness/rules/__init__.py:188
        Prompt p = new Prompt();
        p.context("TAINT KB - " + title + (ctx.get("origin").isEmpty() ? "" : "  (origin: ...)")); // src: vvaharness/rules/__init__.py:189
        // default limit = 20 items per section; sources are never rendered
        p.rule("SANITIZERS - if ANY of these sits on the path, REFUTE");                          // src: vvaharness/rules/__init__.py:195
        p.context(ctx.get("sanitizers").head(limit));
        p.exemption("NON-SANITIZERS - these look safe but are NOT; do NOT refute on their basis alone"); // src: vvaharness/rules/__init__.py:197
        p.context(ctx.get("non_sanitizers").head(limit));
        p.rule("FP CHECKS - if ANY is true, REFUTE");                                             // src: vvaharness/rules/__init__.py:200
        p.checklist(ctx.get("fp_checks").head(limit));
        p.context("KNOWN SINKS - for reference; the candidate sink should match one of these shapes"); // src: vvaharness/rules/__init__.py:202
        p.context(ctx.get("sinks").head(limit));
        // each section skipped when empty; overflow shown as a "+N more" line. src: vvaharness/rules/__init__.py:206
        return p.toString();
    }
}
