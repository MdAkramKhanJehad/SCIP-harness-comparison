# vvaharness/pipeline/stages/s4/outcomes.py

Stage 4's output contract (the schemas a deep-dive session must return, whose field descriptions are model-facing instructions) and the code that reduces raw session replies into findings plus a per-unit verdict. One reported finding fans out into one row per repeat site and per surviving extra CWE.

Source: `vvaharness/pipeline/stages/s4/outcomes.py` (lines 1-300)
Executor: code (schema field descriptions are instructions to the model)
Called from: `vvaharness/pipeline/stages/s4/session.py` (_investigate_unit_once, investigate_batch); `fan_out` and `InvestigatedFinding` are also used by `s6/outcomes.py`

// ---------- schemas (sent to the model as the structured-output schema on routes that honour one) ----------

// src: vvaharness/pipeline/stages/s4/outcomes.py:34-109
// prompt-src: vvaharness/pipeline/stages/s4/outcomes.py:34-109
InvestigatedFinding {
  cwe: String           // "Exactly one most-specific CWE id, e.g. CWE-89."
  file: String          // "Repo-relative path, from this threat's FILES list."
  line_start: Number    // "1-indexed FIRST line of the weakness's span." ... "`sink_line`, not this field, names the dangerous statement itself."
  sink_line: Number = 0 // "Exact 1-indexed line of the single statement that embodies the defect" ... "0 when no single statement does (e.g. a missing control)."
  line_end: Number = 0  // "1-indexed LAST line of the weakness, inclusive" ... "Span the whole construct: an unguarded route runs from its decorator to the end of its function body. Use 0 only when you genuinely cannot bound it."
  also_cwes: [String] = []
  repeat_lines: [Number] = []
  preconditions: [String] = []
  vuln_class: VulnClass // "Weakness class; unrecognized labels fold to OTHER."
  title: String
  severity: Severity    // "One enum value. s6 re-scores every finding from a CVSS vector, so do not argue it here."
  description: String
  exploit_scenario: String
  recommendation: String

  Constraints {
    also_cwes: "Other DISTINCT weakness classes present at this same location, as CWE ids." "Each id here becomes its own reported finding at this line" ... "Do not list a parent or sibling of `cwe` that means the same thing — only genuinely different weaknesses."
    repeat_lines: "When this IDENTICAL defect repeats at other call sites in the SAME file, the first line of every additional site — one integer each, no prose." "Report the sites, never a summary of them" ... "Leave empty only when the defect genuinely occurs once."
    preconditions: "What must independently be true, beyond reaching this code, for the weakness to be exploitable — one concrete condition per entry, not a restatement of `description`." ... "Leave empty only when the weakness fires unconditionally on any input that reaches this code — never as a default for not having checked."
    title: "One line, at most 12 words, naming the weakness and its location. No prose."
    description: "AT MOST TWO SENTENCES: the defect and why it is one." Do not restate the code, the title, the exploit or the fix.
    exploit_scenario: "Concrete input -> impact, in at most five sentences." Every feature the scenario relies on "must be one you saw in this repository's code" ... "A consequence the code does not support is a false claim, not a stronger finding."
    recommendation: "AT MOST TWO SENTENCES: the concrete change, naming the API or control to use. No restatement of the defect, no alternatives list, no code block."
  }

  // src: :76-90 — validators run by the code on the model's reply
  require sink_line and line_end are integers => anything not integer-like folds to 0 (one bad integer cannot fail the whole outcome)
  require each repeat_lines entry is an integer => a malformed entry folds to 0, which fan_out skips; null becomes []
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:112-120
// prompt-src: vvaharness/pipeline/stages/s4/outcomes.py:112-120
InvestigationOutcome {
  unit_id: String       // "Echo the UNIT id you were given, verbatim."
  verdict: "confirmed" | "refuted" | "inconclusive"
  rationale: String     // "Why, in 1-3 sentences. Required for refuted."
  findings: [InvestigatedFinding] = []
  Constraints {
    verdict: "refuted = you read the whole surface and the claim does not hold; say why in rationale. inconclusive = you could not reach the evidence. Do NOT use confirmed as a default."
    findings: "EVERY distinct weakness class you have evidence for — a list, not one. Empty is correct and expected when verdict is refuted."
  }
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:123-126
// prompt-src: vvaharness/pipeline/stages/s4/outcomes.py:123-126
InvestigationOutcomes {
  outcomes: [InvestigationOutcome]
  Constraints {
    "ONE entry per UNIT you were given, each echoing that unit's own id. Report every unit, including the ones you refuted — a unit you omit is recorded as uninvestigated, not clean."
  }
}

// ---------- reduction (code) ----------

// src: vvaharness/pipeline/stages/s4/outcomes.py:274-300
fn reduce_outcomes(units, raw_outcomes, cfg, repo_root, inventory):executor=code {
  by_unit = every unit id -> "uninvestigated"
  findings = []
  for each [unit_id, raw] in raw_outcomes {
    require unit_id is one of units => COUNTERS.bump("s4_unit_id_invented"); skip
    if (raw == null) continue   // stays "uninvestigated"
    outcome = parse_outcome(raw)
    if (outcome == null) { by_unit[unit_id] = "failed"; continue }
    by_unit[unit_id] = outcome.verdict
    for each f in outcome.findings, findings += fan_out(f, unit_id, unit.cwes, cfg, repo_root, inventory);
    // preserved: findings are kept whatever the verdict, so a "refuted" or "inconclusive" outcome that lists findings still produces them
  }
  COUNTERS.bump("s4_unit_no_outcome", count of "uninvestigated")
  return [findings, by_unit]
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:192-201
fn parse_outcome(raw):executor=code {
  // never raises
  outcome = InvestigationOutcome validated directly from raw JSON
  if (outcome == null) outcome = InvestigationOutcome validated from extract_json(raw)   // salvage JSON embedded in prose
  if (outcome == null) {
    COUNTERS.bump(if (raw stripped is non-empty && does not end with "}") "s4_outcome_truncated" else "s4_outcome_malformed")
  }
  return outcome
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:150-174
fn split_batch_reply(raw, unit_ids):executor=code {
  // _as_batch: InvestigationOutcomes directly, else salvaged from prose, else a bare single InvestigationOutcome wrapped as a one-item batch
  batch = _as_batch(raw)
  if (batch == null) return {}
  by_unit = {}
  for each outcome in batch.outcomes {
    require outcome.unit_id in unit_ids => COUNTERS.bump("s4_batch_unit_id_invented"); skip
    by_unit[outcome.unit_id] = outcome re-serialized as JSON   // a later duplicate id overwrites an earlier one
  }
  COUNTERS.bump("s4_batch_unit_omitted", length(unit_ids) - length(by_unit))
  return by_unit
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:248-271
fn fan_out(f, chunk_id, fallback_cwes?, cfg?, repo_root, inventory):executor=code {
  f.file = resolve_inventory_path(repo_root, f.file, inventory)   // external to this batch: vvaharness/scope
  cwe = _resolved_cwe(f, fallback_cwes or [])
  width = max(f.line_end, f.line_start) - f.line_start
  anchors = [f.line_start] + (sorted distinct repeat_lines where n > 0 && n != line_start)
  // generic-parent extras never merge downstream (Stages 5 and 7 merge only weakness_key siblings), so they die here
  max_extra = knob("step4.max_extra_cwes", default=2)
  cwes = [cwe, ..._extra_cwes(f, cwe, max_extra)]
  // sink_line names ONE statement, so only the primary anchor carries it
  sink = if (f.sink_line >= 1) "${f.file}:${f.sink_line}" else null
  return for each n in anchors, for each c in cwes:
    Finding(title, file, line_start=n, line_end=n + width, vuln_class, severity, cwe=c, description, exploit_scenario, recommendation, preconditions, chunk_id, sink_ref = if (n == f.line_start) sink else null)
  // abstracted: :260-269 counters for repeat sites, extra CWEs and sink lines
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:204-212
fn _resolved_cwe(f, fallback_cwes):executor=code {
  cwe = norm_cwe(f.cwe)
  if (cwe) return cwe
  cwe = fallback_cwes[0] or null   // the unit's deterministic CWEs
  if (cwe) COUNTERS.bump("s4_finding_cwe_backfilled")
  return cwe
}

// src: vvaharness/pipeline/stages/s4/outcomes.py:228-245
fn _extra_cwes(f, primary, max_extra):executor=code {
  seen = []
  for each raw in f.also_cwes {
    c = norm_cwe(raw)
    if (!c || c == primary || c in seen) continue
    if (primary && same_weakness(primary, c)) { collapsed += 1; continue }   // a parent or sibling meaning the same weakness
    seen += c
  }
  cap = max(max_extra, 0)
  return first cap entries of seen   // overflow counted in s4_finding_extra_cwes_capped
}

// abstracted: outcomes.py:129-147, 177-189 (the direct, salvaged and batch validators wrap pydantic validation and return null on failure); 215-225 (_at_line builds the Finding as written in fan_out).
