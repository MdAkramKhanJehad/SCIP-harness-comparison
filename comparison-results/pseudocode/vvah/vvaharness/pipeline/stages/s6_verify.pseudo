// file: vvaharness/pipeline/stages/s6_verify.py
// Step 6: adversarial verification in batched agentic sessions on a daemon pool; only
// TRUE_POSITIVE findings at or above the confidence gate continue to S7. Failed batches are
// split and retried; findings the verifier discovers are re-verified in a second wave.

@executedBy(CODE) @role(stage) @stage("S6")
class S6Verify {

    // _HEARTBEAT_SECS = 60 (wake interval), _UNIFORM_CONFIDENCE_MIN = 12, _REPLAYED_LABEL = "[replayed] " (code constants)

    FileCache fileCache(String repoRoot, Theta θ) {
        // S5's FileCache: inherits S5's max_file_kb cap and path-safety.
        return new FileCache(repoRoot, θ["step1.max_file_kb"]);                                 // src: vvaharness/pipeline/stages/s6_verify.py:146
    }

    Pair<List<Finding>, List<DroppedFinding>> run(List<Finding> findings, ContextPackage ctx, Theta θ, String runId) {
        S6Progress progress = new S6Progress(findings.size(), θ, runId);                        // src: vvaharness/pipeline/stages/s6_verify.py:153
        if (findings.isEmpty()) { progress.finish(); return Pair.of(List.of(), List.of()); }    // src: vvaharness/pipeline/stages/s6_verify.py:154

        int parallel = θ["step6_verify.parallel"];                                              // src: vvaharness/pipeline/stages/s6_verify.py:159
        int minConf = θ["step6_verify.min_confidence"];                                         // src: vvaharness/pipeline/stages/s6_verify.py:160
        boolean splitRetry = θ["step6_verify.split_retry"];                                     // src: vvaharness/pipeline/stages/s6_verify.py:161
        String via = θ["models.verify.via"];                                                    // src: vvaharness/pipeline/stages/s6_verify.py:162
        Integer toolTimeoutS = θ["step6_verify.tool_timeout_s"];                                // src: vvaharness/pipeline/stages/s6_verify.py:163
        // Fail closed pre-pool: on via:sdk a mutating tool mutates the repo; only via:cli may keep Bash.
        List<Tool> tools = Models.validateDetectionTools(θ["step6_verify.allowed_tools"], via);  // src: vvaharness/pipeline/stages/s6_verify.py:165

        List<Finding> verified = new List();
        List<DroppedFinding> dropped = new List();
        List<Item> items = S6Batching.label(findings);                                          // src: vvaharness/pipeline/stages/s6_verify.py:174
        List<List<Item>> batches = S6Batching.planBatches(items, θ["step6_verify.batch_size"]); // src: vvaharness/pipeline/stages/s6_verify.py:175
        FileCache cache = fileCache(ctx.repoRoot, θ);
        Sink sink = new Sink(verified, dropped, progress, minConf, S6Batching.filedLines(items),
                             findings.map(f -> ScanFindings.canonicalKey(f, 10)),
                             θ["step6_verify.trait_stamps"],                                    // src: vvaharness/pipeline/stages/s6_verify.py:183
                             θ["step6_verify.reframe_enabled"],                                 // src: vvaharness/pipeline/stages/s6_verify.py:184
                             ctx.allFiles, cache);

        // Backstop ceiling: never fires before the backend clock it backs up.
        int ceiling = S6Batching.sweepCeilingSecs(θ, via);                                      // src: vvaharness/pipeline/stages/s6_verify.py:191
        Effort tier = S6Batching.sweepEffort(θ, via);                                           // src: vvaharness/pipeline/stages/s6_verify.py:192
        // tool_timeout_s: null keeps the vendor default; otherwise patches read timeouts for the whole pool.
        try (TimeoutOverride t = (toolTimeoutS == null) ? null : Filesystem.patchedReadTimeouts(toolTimeoutS)) { // src: vvaharness/pipeline/stages/s6_verify.py:194
            DaemonPool ex = new DaemonPool(parallel);                                           // src: vvaharness/pipeline/stages/s6_verify.py:205
            try {
                Set captive = runWave(batches, ctx, θ, tools, sink, ex, splitRetry, ceiling, parallel, tier, Set.of(), true); // src: vvaharness/pipeline/stages/s6_verify.py:208
                reverifyDiscoveries(ctx, θ, tools, sink, ex, captive, splitRetry, ceiling, parallel, tier); // src: vvaharness/pipeline/stages/s6_verify.py:211
            } finally {
                ex.shutdown(false, true);                                                       // src: vvaharness/pipeline/stages/s6_verify.py:216
            }
        }
        Console.write("[s6-verify] done: TP/FP/UNCONFIRMED/GUARDRAIL_BLOCKED/INCONCLUSIVE/errors"); // src: vvaharness/pipeline/stages/s6_verify.py:225
        flagUniformConfidence(sink.confidences, minConf);                                       // src: vvaharness/pipeline/stages/s6_verify.py:233
        return Pair.of(verified, dropped);
    }

    void flagUniformConfidence(Counter<Integer> confidences, int minConfidence) {
        // Every verdict at one score (n >= 12) means the scores carry no ranking: count and warn.
        if (confidences.total() < 12 || confidences.size() != 1) return;                        // src: vvaharness/pipeline/stages/s6_verify.py:240
        Counters.bump("s6_confidence_uniform", confidences.total());                            // src: vvaharness/pipeline/stages/s6_verify.py:243
    }

    void reverifyDiscoveries(ContextPackage ctx, Theta θ, List<Tool> tools, Sink sink, DaemonPool ex, Set captive,
                             boolean splitRetry, int ceiling, int parallel, Effort tier) {
        // Findings the verifier discovered (origin = s6_discovered) are re-verified in a fresh second-wave session.
        if (!θ["code.s6.reverify_discoveries"]) return;                                         // src: vvaharness/pipeline/stages/s6_verify.py:250
        List<Finding> toReverify = sink.verified.filter(f -> f.origin == "s6_discovered");      // src: vvaharness/pipeline/stages/s6_verify.py:256
        if (toReverify.isEmpty()) return;
        sink.verified.removeIf(f -> f.origin == "s6_discovered");                               // src: vvaharness/pipeline/stages/s6_verify.py:260
        List<List<Item>> batches = S6Batching.planBatches(S6Batching.label(toReverify), θ["step6_verify.batch_size"]); // src: vvaharness/pipeline/stages/s6_verify.py:264
        sink.mintDiscoveries = false;                                                           // src: vvaharness/pipeline/stages/s6_verify.py:265
        sink.progress.widenTotal(toReverify.size());
        for (Finding f : toReverify) sink.filed.get(f.file).add(f.lineStart);                   // src: vvaharness/pipeline/stages/s6_verify.py:270
        sink.cloneRepeats = false;                                                              // src: vvaharness/pipeline/stages/s6_verify.py:273
        try {
            // abort_on_guardrail off: raising would discard wave 1's FALSE_POSITIVE audit rows.
            runWave(batches, ctx, θ, tools, sink, ex, splitRetry, ceiling, parallel, tier, captive, false); // src: vvaharness/pipeline/stages/s6_verify.py:276
        } finally {
            sink.mintDiscoveries = true;
            sink.cloneRepeats = true;
        }
    }

    Set runWave(List<List<Item>> batches, ContextPackage ctx, Theta θ, List<Tool> tools, Sink sink, DaemonPool ex,
                boolean splitRetry, int ceiling, int parallel, Effort tier, Set captive, boolean abortOnGuardrail) {
        int guardrailHits = 0;
        int guardrailGate = max(3, parallel);                                                   // src: vvaharness/pipeline/stages/s6_verify.py:291
        boolean refusalResend = LlmRegistry.refusalResendAllowed(θ, θ["models.verify.id"]);          // src: vvaharness/pipeline/stages/s6_verify.py:296
        Map futs = batches.indexed().toMap(b -> submit(ex, b, ctx, θ, tools, refusalResend && b.size() == 1)); // src: vvaharness/pipeline/stages/s6_verify.py:310
        Set pending = futs.keys();
        while (!pending.isEmpty()) {                                                            // src: vvaharness/pipeline/stages/s6_verify.py:363
            Set done = Futures.waitFirstCompleted(pending, min(60, ceiling));                    // src: vvaharness/pipeline/stages/s6_verify.py:365
            for (Future fut : done) {                                                           // src: vvaharness/pipeline/stages/s6_verify.py:366
                Batch batch = futs.get(fut);
                if (resolved.contains(batch.idx)) continue;                                     // src: vvaharness/pipeline/stages/s6_verify.py:369
                resolved.add(batch.idx);
                Map<String, VerificationOutcome> outcomes;
                try {
                    outcomes = fut.result();
                } catch (GuardrailBlocked e) {
                    guardrailHits += 1;                                                         // src: vvaharness/pipeline/stages/s6_verify.py:379
                    // Cumulative hits trip the breaker before any split.
                    if (abortOnGuardrail && guardrailHits >= guardrailGate && sink.verified.isEmpty()) { // src: vvaharness/pipeline/stages/s6_verify.py:385
                        Cli.abort();
                        throw new RuntimeError("cumulative guardrail blocks with zero successes - aborting run"); // src: vvaharness/pipeline/stages/s6_verify.py:389
                    }
                    if (e is ModelRefusal) {
                        // A refused batch splits once (Anthropic routes only); a refused singleton is final.
                        if (refusalResend && splitRetry && batch.size() > 1 && !Cli.aborted()) { splitAndResubmit(batch, e); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:396
                        sink.fail(batch, "GUARDRAIL_BLOCKED", e);                               // src: vvaharness/pipeline/stages/s6_verify.py:402
                        continue;
                    }
                    if (splitRetry && batch.size() > 1 && !Cli.aborted()) { splitAndResubmit(batch, e); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:404
                    sink.fail(batch, "GUARDRAIL_BLOCKED", e);                                   // src: vvaharness/pipeline/stages/s6_verify.py:409
                    continue;
                } catch (TruncatedResponseError e) {
                    if (splitRetry && batch.size() > 1 && !Cli.aborted()) { splitAndResubmit(batch, e); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:413
                    sink.fail(batch, "VERIFY_ERROR", e);                                        // src: vvaharness/pipeline/stages/s6_verify.py:421
                    continue;
                } catch (Exception e) {
                    // Structured-output failure: split once per finding.
                    if (splitRetry && ResponseQuality.isStructuredOutputFailure(e) && !structuredSingletonRetried.contains(batch.idx) && !Cli.aborted()) { // src: vvaharness/pipeline/stages/s6_verify.py:425
                        structuredSingletonRetried.addAll(splitAndResubmit(batch, e));
                        continue;
                    }
                    // Out of clock is a batch-SIZE failure: split to one per call.
                    if (ResponseQuality.isTimeoutFailure(e) && timeoutSplittable(batch, splitRetry)) { timeoutSplit(batch, e); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:438
                    // Any other non-deterministic failure splits too.
                    if (splitRetry && batch.size() > 1 && !ResponseQuality.isDeterministicFailure(e) && !Cli.aborted()) { splitAndResubmit(batch, e); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:444
                    sink.fail(batch, "VERIFY_ERROR", e);                                        // src: vvaharness/pipeline/stages/s6_verify.py:453
                    continue;
                }
                // Every member the reply omitted is resubmitted once as a fresh singleton.
                List<Item> missing = batch.filter(it -> !outcomes.containsKey(it.fid));        // src: vvaharness/pipeline/stages/s6_verify.py:459
                Set skip = Set.of();
                if (splitRetry && !missing.isEmpty() && batch.size() > 1 && !memberResubmitted.contains(batch.idx) && !Cli.aborted()) { // src: vvaharness/pipeline/stages/s6_verify.py:461
                    memberResubmitted.addAll(splitAndResubmit(missing, new RuntimeError("verifier omitted members")));
                    skip = missing.ids();
                }
                sink.accept(batch, outcomes, skip);                                             // src: vvaharness/pipeline/stages/s6_verify.py:471
            }
            // Wall-clock ceiling per batch: an expired batch is abandoned (captive), then split or VERIFY_ERROR.
            if (ceiling > 0) {                                                                  // src: vvaharness/pipeline/stages/s6_verify.py:477
                for (Future fut : pending) {
                    Batch batch = futs.get(fut);
                    if (!started.containsKey(batch.idx) || now() - started.get(batch.idx) <= ceiling) continue; // src: vvaharness/pipeline/stages/s6_verify.py:481
                    resolved.add(batch.idx); pending.remove(fut); captive.add(fut); abandoned.get(batch.idx).set(); // src: vvaharness/pipeline/stages/s6_verify.py:483
                    Counters.bump("s6_batch_ceiling_expired");
                    if (timeoutSplittable(batch, splitRetry)) timeoutSplit(batch, ceilingError(ceiling)); // src: vvaharness/pipeline/stages/s6_verify.py:500
                    else sink.fail(batch, "VERIFY_ERROR", ceilingError(ceiling));               // src: vvaharness/pipeline/stages/s6_verify.py:503
                }
                captive = captive.filter(f -> !f.done());                                       // src: vvaharness/pipeline/stages/s6_verify.py:505
                // All workers held by captives for a further ceiling: never-started batches become VERIFY_ERROR.
                if (captive.size() >= parallel && !pending.isEmpty() && heldFullFor(ceiling)) { // src: vvaharness/pipeline/stages/s6_verify.py:506
                    for (Future fut : pending) {
                        if (fut.cancel()) { sink.fail(futs.get(fut), "VERIFY_ERROR", new TimeoutError("batch never started")); } // src: vvaharness/pipeline/stages/s6_verify.py:514
                    }
                }
            }
        }
        return captive.filter(f -> !f.done());                                                  // src: vvaharness/pipeline/stages/s6_verify.py:542
    }

    Future submit(DaemonPool ex, Batch batch, ContextPackage ctx, Theta θ, List<Tool> tools, boolean resendRefusal) {
        // Thread start, not submit time, starts the batch's own wall clock.
        return ex.submit(() -> { started.put(batch.idx, now()); return S6Session.verifyBatch(batch, ctx, θ, tools, abandoned.get(batch.idx), resendRefusal); }); // src: vvaharness/pipeline/stages/s6_verify.py:303
    }

    List<Integer> splitAndResubmit(List<Item> batch, Exception e) {
        // Split into one-finding batches and resubmit each.
        List<Integer> newIdx = new List();
        for (Item it : batch) { newIdx.add(nextIdx); futs.put(submit(ex, List.of(it), ctx, θ, tools, false), nextIdx++); } // src: vvaharness/pipeline/stages/s6_verify.py:324
        return newIdx;
    }

    boolean timeoutSplittable(Batch batch, boolean splitRetry) {
        return splitRetry && batch.size() > 1 && !timeoutSplitRetried.contains(batch.idx) && !Cli.aborted(); // src: vvaharness/pipeline/stages/s6_verify.py:352
    }

    void timeoutSplit(Batch batch, Exception e) {
        timeoutSplitRetried.addAll(splitAndResubmit(batch, e));                                 // src: vvaharness/pipeline/stages/s6_verify.py:356
    }

    @src("vvaharness/pipeline/stages/s6/session.py:194")
    AgentSpec verifySessionBounds(Theta θ) {
        // The per-batch session limits verifyBatch applies (real reads in s6/session.py and s6/batching.py).
        Bounds bounds = new Bounds(θ["step6_verify.max_turns"],                                 // src: vvaharness/pipeline/stages/s6/session.py:281
                                   θ["step6_verify.max_model_calls"],                           // src: vvaharness/pipeline/stages/s6/session.py:113
                                   θ["step6_verify.batch_deadline"],                            // src: vvaharness/pipeline/stages/s6/session.py:204
                                   θ["step6_verify.max_budget_usd"]);                           // src: vvaharness/pipeline/stages/s6/session.py:280
        int ceiling = θ["step6_verify.batch_wall_clock_ceiling"];                               // src: vvaharness/pipeline/stages/s6/batching.py:45
        Object replay = List.of(θ["step6_verify.replay_max_tokens"], θ["step6_verify.replay_timeout"], θ["step6_verify.resume_timeout"]); // src: vvaharness/pipeline/stages/s6/session.py:241
        Object graph = List.of(θ["step6_verify.graph_tools"], θ["step6_verify.graph_tool_budget"], θ["step6_verify.require_graph"], θ["step6_verify.evidence_gate_refusals"]); // src: vvaharness/pipeline/stages/s6/session.py:138
        boolean inline = θ["step6_verify.inline_source"];                                       // src: vvaharness/pipeline/stages/s6/session.py:166
        ModelSpec model = new ModelSpec(θ["models.verify.id"], θ["models.verify.via"], θ["models.verify.provider"], θ["step6_verify.effort"], θ["step6_verify.max_tokens"]); // src: vvaharness/pipeline/stages/s6/session.py:286
        return new AgentSpec(model, θ["step6_verify.allowed_tools"], List.of(), null, null, bounds, null, false);
    }
}

@executedBy(CODE) @role(io) @stage("S6")
class S6Progress {
    // Optional atomic on-disk progress file: one write per recorded outcome.
    void record(String outcome, Theta θ) {
        if (!θ["step6_verify.progress_file"]) return;                                           // src: vvaharness/pipeline/stages/s6_verify.py:551
        completed += 1;
        counts.inc(outcome);
        write(completed == total ? "completed" : "running");                                    // src: vvaharness/pipeline/stages/s6_verify.py:566
    }
}

@executedBy(CODE) @role(rule_set) @stage("S6")
class Sink {

    void fail(List<Item> batch, String reason, Exception exc) {
        // Drop every member of a batch whose session raised; one errlog row each.
        for (Item it : batch) { dropped.add(drop(it.f, reason, Redact.redact(exc).truncate(200))); progress.record(reason); } // src: vvaharness/pipeline/stages/s6_verify.py:727
    }

    void accept(List<Item> batch, Map<String, VerificationOutcome> outcomes, Set<String> skip) {
        for (Item it : batch) {                                                                 // src: vvaharness/pipeline/stages/s6_verify.py:743
            if (skip.contains(it.fid)) continue;
            VerificationOutcome o = outcomes.get(it.fid);
            if (o == null) { undetermined(it.fid, it.f); continue; }                            // src: vvaharness/pipeline/stages/s6_verify.py:747
            judged(it.f, o);                                                                    // src: vvaharness/pipeline/stages/s6_verify.py:750
            discoveries(it.f, o);
        }
    }

    void undetermined(String fid, Finding f) {
        // An absent verdict is undetermined (VERIFY_ERROR): FALSE_POSITIVE would flatter the confirmation rate.
        Counters.bump("s6_finding_no_outcome");                                                 // src: vvaharness/pipeline/stages/s6_verify.py:756
        dropped.add(drop(S6Outcomes.unverified(f, "verifier returned no verdict for this finding"), "VERIFY_ERROR", "no verdict")); // src: vvaharness/pipeline/stages/s6_verify.py:760
    }

    void judged(Finding f, VerificationOutcome outcome) {
        String bucket = S6Outcomes.classify(outcome, minConfidence);                            // src: vvaharness/pipeline/stages/s6_verify.py:767
        if (bucket == "FALSE_POSITIVE") {
            // A FALSE_POSITIVE whose reason claims a module is not imported, when the file imports it, is held as INCONCLUSIVE.
            String module = premiseContradicted(outcome.reason, f.file, inventory, readLines);  // src: vvaharness/pipeline/stages/s6_verify.py:769
            if (module != null) { Counters.bump("s6_fp_premise_contradicted"); bucket = "INCONCLUSIVE"; } // src: vvaharness/pipeline/stages/s6_verify.py:777
        }
        confidences.inc(outcome.confidence);
        List<Finding> results = S6Outcomes.applyOutcome(f, outcome, bucket == "TRUE_POSITIVE" ? reserver(f.file) : null,
                                                        stamps, reframe, lineCount(f.file), cloneRepeats); // src: vvaharness/pipeline/stages/s6_verify.py:780
        String label = outcome.replayed ? "[replayed] " : "";                                   // src: vvaharness/pipeline/stages/s6_verify.py:790
        for (Finding r : results) {
            r.verdictReason = S6Outcomes.remapReasonIds(r.verdictReason, display);
            if (!label.isEmpty() && bucket == "TRUE_POSITIVE") r.verdictReason = label + r.verdictReason; // src: vvaharness/pipeline/stages/s6_verify.py:794
        }
        if (bucket == "TRUE_POSITIVE") {                                                        // src: vvaharness/pipeline/stages/s6_verify.py:799
            verified.addAll(results);
            progress.record(bucket);
            return;
        }
        String detail = bucket == "UNCONFIRMED" ? "verifier confidence below gate " + minConfidence : outcome.reason; // src: vvaharness/pipeline/stages/s6_verify.py:815
        dropped.add(drop(results[0], bucket, label + detail));                                  // src: vvaharness/pipeline/stages/s6_verify.py:817
        progress.record(bucket);
    }

    boolean inRepo(Finding f) {
        // S5's coordinate rule re-applied to a discovery.
        if (inventory == null) return true;                                                     // src: vvaharness/pipeline/stages/s6_verify.py:822
        if (!inventory.contains(f.file)) return false;
        Integer eof = lineCount(f.file);
        return eof != null && 1 <= f.lineStart && f.lineStart <= eof;                           // src: vvaharness/pipeline/stages/s6_verify.py:827
    }

    void discoveries(Finding f, VerificationOutcome outcome) {
        if (!mintDiscoveries) {                                                                 // src: vvaharness/pipeline/stages/s6_verify.py:831
            // The re-verify pass must not mint more: discoveries would chain into an unverified fan-out.
            Counters.bump("s6_finding_discovered_reverify_discarded", outcome.additionalFindings.size());
            return;
        }
        if (outcome.replayed && !outcome.additionalFindings.isEmpty()) {                        // src: vvaharness/pipeline/stages/s6_verify.py:837
            // A tool-free replay never read the code, so a weakness it names is ungrounded.
            Counters.bump("s6_replayed_discoveries_dropped", outcome.additionalFindings.size());
            return;
        }
        if (outcome.confidence < minConfidence) {                                               // src: vvaharness/pipeline/stages/s6_verify.py:847
            Counters.bump("s6_finding_discovered_unconfirmed", outcome.additionalFindings.size());
            return;
        }
        for (Finding extra : S6Outcomes.discovered(outcome, f, repoRoot, inventory)) {          // src: vvaharness/pipeline/stages/s6_verify.py:853
            if (!inRepo(extra)) { Counters.bump("s6_finding_discovered_out_of_repo"); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:855
            if (seen.contains(ScanFindings.canonicalKey(extra, 10))) { Counters.bump("s6_finding_discovered_duplicate"); continue; } // src: vvaharness/pipeline/stages/s6_verify.py:862
            seen.add(ScanFindings.canonicalKey(extra, 10));
            verified.add(extra);                                                                // src: vvaharness/pipeline/stages/s6_verify.py:866
        }
    }

    String premiseContradicted(String reason, String findingFile, Set<String> inventory, Function readLines) {
        Pair found = premiseModule(reason);                                                     // src: vvaharness/pipeline/stages/s6_verify.py:663
        if (found == null) return null;
        String target = resolveModuleFile(found.module, inventory) ?: findingFile;              // src: vvaharness/pipeline/stages/s6_verify.py:669
        List<String> lines = readLines(target);
        if (lines.isEmpty()) return null;
        // "X is not imported" is refuted by import X or from X; "X is not defined" only by import X.
        Regex stmt = found.allowFrom ? "^import X|^from X" : "^import X";                     // src: vvaharness/pipeline/stages/s6_verify.py:675
        return lines.any(stmt::matches) ? found.module : null;                                 // src: vvaharness/pipeline/stages/s6_verify.py:678
    }
}
