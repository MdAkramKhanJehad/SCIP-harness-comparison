// file: vulnhunter-fix/references/approved-key-sources.yaml
// Approved / denied key-source call patterns read by scripts/crypto-trust-chain-checkers.py
// (REQ-CWE-009 key_source_approved). Deny wins over approve; false forces MITIGATION tier.

@executedBy(CODE) @role(config) @stage("fix")
class ApprovedKeySources {

    Map<String, List<String>> approvedPatterns(Theta θ) {
        // categories: chamber, aws_kms, vault, gcp_secret_manager, azure_kv, kubernetes (KUBE_SECRET_ env prefix), annotation
        return θ["code.references.approved_key_sources.approved_patterns"];         // src: vulnhunter-fix/references/approved-key-sources.yaml:10
    }

    List<String> deniedPatterns(Theta θ) {
        // literal string keys, bare env vars, filesystem reads
        return θ["code.references.approved_key_sources.denied_patterns"];           // src: vulnhunter-fix/references/approved-key-sources.yaml:59
    }

    boolean keySourceApproved(List<String> addedLines, Theta θ) {
        for (String term : deniedPatterns(θ)) if (containsIgnoreCase(addedLines, term)) return false; // src: vulnhunter-fix/references/approved-key-sources.yaml:56 (deny wins)
        for (String cat : approvedPatterns(θ).keys()) {                              // src: vulnhunter-fix/references/approved-key-sources.yaml:10
            if (cat == "annotation") continue;
            for (String term : approvedPatterns(θ).get(cat)) if (containsIgnoreCase(addedLines, term)) return true;
        }
        // "KEY_SOURCE_APPROVED: <rationale>" comment within the 2 lines preceding the key read
        for (String term : approvedPatterns(θ).get("annotation")) {                  // src: vulnhunter-fix/references/approved-key-sources.yaml:54
            if (annotationWithin(addedLines, term, θ["code.fix.scripts.crypto_trust_chain_checkers.annotation_window_lines"])) return true; // src: vulnhunter-fix/references/approved-key-sources.yaml:53
        }
        return false;                                                                // src: vulnhunter-fix/references/approved-key-sources.yaml:8 (-> MITIGATION tier)
    }
}
