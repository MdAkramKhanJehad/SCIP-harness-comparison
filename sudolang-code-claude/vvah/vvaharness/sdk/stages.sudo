# vvaharness/sdk/stages.py

The public per-stage map: for each stage, its phase, the data object it produces, the exact checkpoint envelope `--resume` reads, and which plugin seams are open there. It is descriptive data for library callers; the pipeline itself does not read it.

Source: `vvaharness/sdk/stages.py` (lines 1-146)
Executor: code
Called from: library callers through `vvaharness/sdk/__init__.py`

// src: vvaharness/sdk/stages.py:31-62
Phase: "discover" | "analyze" | "verify" | "remediate"
Seam: "enrich-graph" | "swap-graph" | "bring-dto" | "add-tools" | "add-subagents"
Stage {
  id; phase; name; dto; payload   // payload: the exact checkpoint envelope
  agentic = false
  injectable = false
  seams = []
  caveat = ""
}

// src: vvaharness/sdk/stages.py:67-102
STAGES = [
  { id: "s0",  phase: discover,  name: "Seed",          dto: SeedPackage,     payload: "SeedPackage", seams: [enrich-graph, swap-graph], caveat: "the graph is built here, so this is the only place an enricher runs" },
  { id: "s1",  phase: discover,  name: "Precompute",    dto: ContextPackage,  payload: "ContextPackage", injectable, seams: [bring-dto], caveat: "ContextPackage.graph_handle is exclude=True, so an injected one has no graph and S2/S4/S6 warn then stand down" },
  { id: "s2",  phase: analyze,   name: "Threat model",  dto: ThreatModel,     payload: "ThreatModel", agentic, injectable, seams: [bring-dto, add-tools, add-subagents] },
  { id: "s3",  phase: analyze,   name: "Decompose",     dto: TaskManifest,    payload: "TaskManifest", injectable, seams: [bring-dto], caveat: "deterministic: one InvestigationUnit per threat, zero model calls" },
  { id: "s4",  phase: analyze,   name: "Deep dive",     dto: Finding,         payload: "{\"findings\": list[Finding], \"outcomes\": dict[str, str]}", agentic, injectable, seams: [bring-dto, add-tools, add-subagents], caveat: "seed this to run S5 onward on findings you already have" },
  { id: "s5",  phase: verify,    name: "Prefilter",     dto: Finding,         payload: "{\"findings\": list[Finding], \"pre_dropped\": list[Finding]}", injectable, seams: [bring-dto] },
  { id: "s6",  phase: verify,    name: "Verify",        dto: Finding,         payload: "{\"verified\": list[Finding], \"dropped\": list[Finding]}", agentic, seams: [add-tools, add-subagents] },
  { id: "s7",  phase: verify,    name: "Dedupe",        dto: Finding,         payload: "(pre_dropped, verified, dropped, canonical, dup_dropped, s5_out_count)", caveat: "a 6-tuple, not a dict; the only stage whose envelope is positional" },
  { id: "s8",  phase: verify,    name: "Report",        dto: FinalReport,     payload: "FinalReport" },
  { id: "s9",  phase: verify,    name: "SARIF",         dto: null,            payload: "str (path to the written sarif)" },
  { id: "s10", phase: remediate, name: "Remediate",     dto: null,            payload: "not checkpointed by scan_repo", agentic, seams: [add-tools, add-subagents], caveat: "reachable as vvaharness.sdk.remediate(finding, repo=...)" },
  { id: "s11", phase: remediate, name: "Validate",      dto: null,            payload: "not checkpointed by scan_repo", agentic, caveat: "reachable as vvaharness.sdk.validate(finding, remediation, ...)" }
]
// preserved: s1 is listed as not agentic here, and so is s3 ("zero model calls"); scan.py still labels both console steps with a configured model role name (_m("preprocess"), _m("decompose"))
// preserved: s5's payload names pre_dropped as list[Finding], while checkpoints.py types it as list[DroppedFinding] (checkpoints.py:73-75)

// src: vvaharness/sdk/stages.py:104-108
CHECKPOINTED = id of each stage whose payload does not start with "not checkpointed"   // s0 to s9

// src: vvaharness/sdk/stages.py:111-133
fn stage(stage_id):executor=code {
  require stage_id is a known id => throw KeyError("no stage <id>; known: <sorted ids>")
  return that stage
}
fn stages_in(phase):executor=code { return stages of that phase, in run order }   // an unknown phase name raises (Phase(phase))
fn stages_with(seam):executor=code { return stages where seam is open, in run order }
fn injectable_stages():executor=code { return stages where injectable }   // s1 to s5
