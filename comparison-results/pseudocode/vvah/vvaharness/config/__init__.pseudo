// file: vvaharness/config/__init__.py
// Config loading overview: profile YAML (the operator's --config, ./config.yaml or a packaged profile) deep-merged over
// built-in step defaults, then an optional trusted config.local.yaml overlay, then ${VAR} expansion. Knobs are read where they act.

@executedBy(CODE) @role(config)
class Config {

    /** load(): builtin defaults < profile < config.local.yaml (unless VVAHARNESS_NO_LOCAL_CONFIG); refusal_retries capped at 0..1. */
    @src("vvaharness/config/__init__.py:873")
    Config load(String path, boolean noLocalOverlay) {
        Map raw = readPrimary(path);                                                                        // must exist, be a file, readable, a YAML mapping // src: vvaharness/config/__init__.py:875
        raw = deepMerge(STEP_DEFAULTS, raw);                                                                // user values win over builtin defaults // src: vvaharness/config/__init__.py:878
        if (!noLocalOverlay) {
            Map over = localOverlay(path);                                                                  // only when EUID/root-owned and not group/world writable // src: vvaharness/config/__init__.py:888
            if (over != null) raw = deepMerge(raw, over);                                                   // src: vvaharness/config/__init__.py:890
        }
        Map data = expandTree(raw);                                                                         // ${VAR} / ${VAR:-default} // src: vvaharness/config/__init__.py:891
        checkRefusalRetries(data.get("refusal_retries"));                                                   // int 0..1 or ConfigPolicyError // src: vvaharness/config/__init__.py:892
        return new Config(data);                                                                            // src: vvaharness/config/__init__.py:898
    }

    /** step1 overlay: top-level lists APPEND, nested dicts replace-merge. expand=false keeps an LLM-authored overlay literal. */
    @src("vvaharness/config/__init__.py:934")
    Pair<Config, Boolean> applyStep1Overlay(Config cfg, Object path, boolean expand) { }

    /** UNC / network paths are refused before any filesystem access. */
    @src("vvaharness/config/__init__.py:950")
    boolean isNetworkPath(String path) {
        return path.startsWith("\\\\") || path.startsWith("//");                                            // src: vvaharness/config/__init__.py:958
    }

    Map readPrimary(String path) { }
    Map deepMerge(Map base, Map over) { }
    Map localOverlay(String path) { }
    Map expandTree(Map raw) { }
    void checkRefusalRetries(Object value) { }
    Config deepCopy() { }
    Effort roleEffort(Config cfg, String role) { }
}
