// file: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py
// Mechanical crypto trust-chain checkers (REQ-CWE-009): from the fix diff's added lines, set the four sidecar
// booleans algorithm_approved, key_source_approved, key_rotation_present, transport_encrypted. Never calls a model.

@executedBy(CODE) @role(types)
record TrustChainResult(boolean algorithmApproved, boolean keySourceApproved, boolean keyRotationPresent, boolean transportEncrypted, String checkerVersion, String algorithmEvidence, String keySourceEvidence, String keyRotationEvidence, String transportEvidence) { }

@executedBy(CODE) @role(evaluation) @stage("fix")
class CryptoTrustChainCheckers {

    // plan.pseudo calls run(diff, vulnId): emits the sidecar crypto_trust_chain fragment
    Map run(String diff, String vulnId, Theta θ) {
        TrustChainResult r = runCheckers(diff, θ);                                                        // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:364
        if (vulnId != null) return Map.of("vuln_id", vulnId, "crypto_trust_chain", r);                  // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:367
        return r.asMap();
    }

    String unquote(String val) {
        if (val.length() >= 2 && val.first() == val.last() && (val.first() == '"' || val.first() == '\'')) return val.substring(1, val.length() - 1); // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:60
        return val;
    }

    String stripInlineComment(String val) {
        // two-space + hash delimiter so '#' inside regex classes survives
        Match m = Regex.search("\\s<2+>#\\s", val);                                                       // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:73
        return m != null ? val.substring(0, m.start()).rstrip() : val;
    }

    Map loadYamlFlat(Path path) {
        // hand-rolled loader: top-level key -> list of '- items', or nested scalar map (constants block, int-coerced)
        Map result = Map.of();
        String currentKey = null;
        for (String raw : Files.read(path).lines()) {
            String line = raw.rstrip();
            if (line.isEmpty() || line.lstrip().startsWith("#")) continue;                                // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:93
            if (!line.startsWithAny(" ", "\t") && line.contains(":")) {                                   // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:95
                currentKey = line.split(":", 1).get(0).strip();
                result.put(currentKey, List.of());
                continue;
            }
            String stripped = line.lstrip();
            if (currentKey != null && stripped.startsWith("-")) {
                String val = unquote(stripInlineComment(stripped.substring(1).strip()));                  // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:103
                if (!val.isEmpty()) result.get(currentKey).add(val);
            } else if (currentKey != null && stripped.contains(":")) {
                Pair kv = stripped.partition(":");                                                        // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:109
                if (!result.get(currentKey).isMap()) result.put(currentKey, Map.of());
                result.get(currentKey).put(kv.k.strip(), kv.v.isDigits() ? Integer.parse(kv.v) : kv.v);  // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:113
            }
        }
        return result;
    }

    String readDiff(String path) {
        if (path == "-") return Stdin.read();                                                             // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:119
        return Files.readReplacingErrors(path);
    }

    List<String> addedLines(String diff) {
        return diff.lines().filter(l -> l.startsWith("+") && !l.startsWith("+++")).map(l -> l.substring(1)); // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:126
    }

    boolean tokenPresent(String term, String textLower) {
        // word boundary only on edges that are word chars (DSA not in ECDSA; .MD5( still matches)
        String t = term.lower();
        String left = t.firstIsWordChar() ? "\\b" : "";                                                   // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:153
        String right = t.lastIsWordChar() ? "\\b" : "";                                                   // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:154
        return Regex.search(left + Regex.escape(t) + right, textLower) != null;                           // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:155
    }

    String stripLineComment(String line) {
        // '#' or '//' preceded by start or whitespace; string literals kept as evidence
        Match m = Regex.search("(?:^|\\s)(?:#|//)", line);                                                // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:165
        return m != null ? line.substring(0, m.start()) : line;
    }

    String weakKeyParameter(List<String> addedLines, Map ref, Theta θ) {
        Map consts = ref.get("constants");                                                                // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:192
        if (!consts.isMap()) return null;
        String text = String.join("\n", addedLines);
        Integer rsaMin = consts.get("rsa_min_bits");                                                      // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:196
        // diff-level context: RSA mentioned anywhere + a listed modulus anywhere
        if (rsaMin != null && Regex.searchIgnoreCase("\\brsa\\b", text)) {                                // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:197
            for (int bits : Regex.findAllInts(θ["code.fix.scripts.crypto_trust_chain_checkers.rsa_size_tokens"], text)) { // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:198
                if (bits < rsaMin) return "weak RSA key size";                                            // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:200
            }
        }
        Integer eccMin = consts.get("ecc_min_bits");                                                      // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:202
        if (eccMin != null) {
            for (Entry curve : θ["code.fix.scripts.crypto_trust_chain_checkers.ecc_curve_bits"].entries()) { // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:171
                if (curve.value < eccMin && Regex.search("(?<![a-z0-9])" + Regex.escape(curve.key) + "(?![a-z0-9])", text.lower())) return "weak ECC curve"; // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:206
            }
        }
        Integer pbkdf2Min = consts.get("pbkdf2_min_iterations");                                          // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:208
        if (pbkdf2Min != null) {
            for (String line : addedLines) {
                if (!Regex.searchIgnoreCase("pbkdf2", line)) continue;                                    // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:211
                for (int iters : Regex.findAllInts("(?i)iterations?\\s*[=:]\\s*(\\d+)", line)) {          // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:213
                    if (iters < pbkdf2Min) return "weak PBKDF2 iterations";                               // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:215
                }
            }
        }
        return null;
    }

    Pair<Boolean, String> checkAlgorithmApproved(String diff, Map ref, Theta θ) {
        List<String> lines = addedLines(diff).map(l -> stripLineComment(l));                              // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:224
        String added = String.join("\n", lines).lower();
        // denied first: any denied token fails, even next to an approved one
        List<String> denied = ref.lists("symmetric_denied", "asymmetric_denied", "hash_denied", "kdf_denied", "mac_denied"); // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:226
        for (String term : denied) if (tokenPresent(term, added)) return Pair.of(false, "denied algorithm present: " + term); // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:229
        String weak = weakKeyParameter(lines, ref, θ);                                                    // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:233
        if (weak != null) return Pair.of(false, weak);
        List<String> approved = ref.lists("symmetric", "asymmetric", "hash", "kdf", "mac");               // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:236
        for (String term : approved) if (tokenPresent(term, added)) return Pair.of(true, "approved algorithm: " + term); // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:239
        return Pair.of(false, "no approved algorithm identifier found in fix diff");                      // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:241
    }

    boolean annotationWithinWindow(List<String> addedLines, String annotationTerm, Theta θ) {
        for (int i = 0; i < addedLines.size(); i++) {
            if (addedLines.get(i).lower().contains(annotationTerm.lower())) {                             // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:259
                int w = θ["code.fix.scripts.crypto_trust_chain_checkers.annotation_window_lines"];
                for (String follow : addedLines.subList(i + 1, i + 1 + w)) {                              // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:260
                    if (Regex.searchIgnoreCase("(secret|key|token|credential|password|passphrase)", follow)) return true; // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:256
                }
            }
        }
        return false;
    }

    Pair<Boolean, String> checkKeySourceApproved(String diff, Map ref, Theta θ) {
        List<String> lines = addedLines(diff);
        String added = String.join("\n", lines).lower();
        for (String term : ref.getOr("denied", List.of())) {
            if (added.contains(term.lower())) return Pair.of(false, "denied key source: " + term);        // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:271
        }
        for (String cat : θ["code.fix.scripts.crypto_trust_chain_checkers.approved_key_source_categories"]) { // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:274
            for (String term : ref.getOr(cat, List.of())) {
                if (added.contains(term.lower())) return Pair.of(true, "approved key source: " + term);  // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:277
            }
        }
        for (String term : ref.getOr("annotation", List.of())) {
            if (annotationWithinWindow(lines, term, θ)) return Pair.of(true, "approved key source (annotation)"); // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:281
        }
        return Pair.of(false, "no approved key-source pattern found");                                    // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:283
    }

    Pair<Boolean, String> checkKeyRotationPresent(String diff, Theta θ) {
        String added = String.join("\n", addedLines(diff));
        for (String pat : θ["code.fix.scripts.crypto_trust_chain_checkers.rotation_patterns"]) {         // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:286
            Match m = Regex.search(pat, added);
            if (m != null) return Pair.of(true, "rotation pattern: " + m.group(0));                       // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:301
        }
        return Pair.of(false, "no rotation call site detected");                                          // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:302
    }

    Pair<Boolean, String> checkTransportEncrypted(String diff, Theta θ) {
        String added = String.join("\n", addedLines(diff));
        // denied checked first; one denied hit fails regardless of approved hits
        for (String pat : θ["code.fix.scripts.crypto_trust_chain_checkers.transport_denied_patterns"]) { // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:315
            Match m = Regex.search(pat, added);
            if (m != null) return Pair.of(false, "denied transport: " + m.group(0));                      // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:328
        }
        for (String pat : θ["code.fix.scripts.crypto_trust_chain_checkers.transport_approved_patterns"]) { // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:305
            Match m = Regex.search(pat, added);
            if (m != null) return Pair.of(true, "approved transport: " + m.group(0));                     // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:332
        }
        return Pair.of(false, "no transport indicator in fix diff");                                      // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:333
    }

    TrustChainResult runCheckers(String diff, Theta θ) {
        Map algoRef;
        Map keyRef;
        try {
            algoRef = loadYamlFlat(skillRoot().join("references", "approved-crypto-algorithms.yaml"));    // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:338
            keyRef = loadYamlFlat(skillRoot().join("references", "approved-key-sources.yaml"));          // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:339
        } catch (OSError e) {
            throw new SystemExit("reference YAML load failed");                                           // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:341
        }
        TrustChainResult r = new TrustChainResult();                                                      // all booleans default false, checker_version "1"
        r.setAlgorithm(checkAlgorithmApproved(diff, algoRef, θ));                                         // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:344
        r.setKeySource(checkKeySourceApproved(diff, keyRef, θ));                                          // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:345
        r.setKeyRotation(checkKeyRotationPresent(diff, θ));                                               // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:346
        r.setTransport(checkTransportEncrypted(diff, θ));                                                 // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:347
        return r;
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:352
        String diff;
        try {
            diff = readDiff(args.diff);                                                                   // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:359
        } catch (OSError e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:362
        }
        print(Json.dump(run(diff, args.emitSidecar, θ)));                                                 // src: vulnhunter-fix/scripts/crypto-trust-chain-checkers.py:368
        return 0;
    }
}
