# vvaharness/plugins/semgrep/plugin.py

`SemgrepPlugin`: the Semgrep-enhanced variant assembled through the plugin seams. It contributes the Semgrep graph enricher (built only from validated local rule files, registry rulesets, or an override), four read-only graph tools, and the triage subagent.

Source: `vvaharness/plugins/semgrep/plugin.py` (lines 1-92)
Executor: code
Called from: the plugin set loader (`load_plugin_set`, called from `vvaharness/orchestrator/scan.py`), which installs graph tools and passes enrichers to build_graph

// src: vvaharness/plugins/semgrep/plugin.py:31-32
VERSION = "1"
_MAX_CONFIG_FILES = 32

// src: vvaharness/plugins/semgrep/plugin.py:35-49
fn _validated_configs(configs):executor=code {
  require length(configs) <= _MAX_CONFIG_FILES => throw SemgrepConfigError("at most 32 rule files")
  for each raw in configs {
    path = expand user (~) in raw
    require path is an existing local file => throw SemgrepConfigError("rule file is not a local file: $raw")   // a registry name or URL is rejected, never fetched
    emit resolved path
  }
}

// src: vvaharness/plugins/semgrep/plugin.py:52-89
SemgrepPlugin {
  // frozen
  configs: Path[] = []
  rulesets: String[] = []          // registry rulesets such as "p/..."; fetched over the network by the enricher
  executable: String = "semgrep"
  timeout_seconds: Number = 120.0
  enricher: GraphEnricher | null = null
  priority: Number = 100

  info = PluginInfo({ name: "semgrep", version: VERSION, priority })

  fn contribute():executor=code {
    return Contribution({ enrichers: _enrichers(), graph_tools: SEMGREP_TOOLS, subagents: [semgrep_triage_subagent()] })
  }

  fn _enrichers():executor=code {
    if (enricher != null) return [enricher]   // an override wins
    if (configs is empty && rulesets is empty) {
      warn "vvah-semgrep: no rule files and no rulesets, so the graph carries no Semgrep evidence and the tools will report an absent subgraph. ..."
      return []
    }
    return [SemgrepEnricher({ configs: if (configs) _validated_configs(configs) else [], rulesets, executable, timeout_seconds, priority })]
  }
}
