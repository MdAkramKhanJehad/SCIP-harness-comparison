// file: vvaharness/orchestrator/cmdb.py
// CMDB lookup: resolves inject.cmdb_file and maps an application_id to an AppProfile (threaded into S1-S8)
// plus the raw AppInfo (used post-S7 for context severity).

@executedBy(CODE) @role(io)
class Cmdb {

    String CMDB_CSV = "";                                     // src: vvaharness/orchestrator/cmdb.py:26

    String cmdbPath() {
        return CMDB_CSV;                                                                               // src: vvaharness/orchestrator/cmdb.py:30
    }

    /** Resolve inject.cmdb_file to an absolute path, or "" if unset. */
    void setCmdbPath(Config cfg, Path cfgDir, Theta θ) {
        String p = θ["inject.cmdb_file"];                                                              // src: vvaharness/orchestrator/cmdb.py:36
        CMDB_CSV = (p != null && !p.isEmpty()) ? ConfigPaths.resolveAgainst(cfgDir, p) : "";            // src: vvaharness/orchestrator/cmdb.py:37
    }

    /** application_id -> (AppProfile, AppInfo); any failure or a miss yields (null, null) and the scan continues. */
    Pair<AppProfile, AppInfo> loadAppProfile(String applicationId) {
        if (applicationId == null || applicationId.isEmpty()) return Pair.of(null, null);             // src: vvaharness/orchestrator/cmdb.py:43
        AppInfo info;
        try {
            Map cmdb = Appcontext.loadCmdbCsv(cmdbPath());                                             // src: vvaharness/orchestrator/cmdb.py:46
            info = Appcontext.lookupApp(applicationId, cmdb, Map.of());                                // src: vvaharness/orchestrator/cmdb.py:47
        } catch (Exception e) {
            Console.write("[cmdb] lookup failed");                                                     // src: vvaharness/orchestrator/cmdb.py:49
            return Pair.of(null, null);                                                                // src: vvaharness/orchestrator/cmdb.py:50
        }
        if (info == null) { Console.write("[cmdb] application_id not found"); return Pair.of(null, null); } // src: vvaharness/orchestrator/cmdb.py:51
        AppProfile profile = new AppProfile(applicationId, info.name, info.externallyFacing, info.pciScoped,
            info.processesPan, info.pii, info.source);                                                 // src: vvaharness/orchestrator/cmdb.py:54
        return Pair.of(profile, info);                                                                 // src: vvaharness/orchestrator/cmdb.py:63
    }
}
