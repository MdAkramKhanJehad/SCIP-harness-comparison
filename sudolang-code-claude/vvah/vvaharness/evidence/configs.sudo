Executor: code
Called from: `vvaharness/evidence/gather.py` gather

// src: vvaharness/evidence/configs.py:26-30
_CONFIG_EXTS = [".yml", ".yaml", ".json", ".toml", ".ini", ".properties", ".conf", ".cfg", ".env"]
_CONFIG_REP_RAW_CEILING = 500_000

// src: vvaharness/evidence/configs.py:77-81
fn gather_config_reps(root, full_files, max_reps, cap_chars, max_bodies):executor=code = _config_rep_contents(root, _select_config_reps(full_files, max_reps), cap_chars, max_bodies)

// src: vvaharness/evidence/configs.py:33-53
fn _select_config_reps(full_files, max_reps):executor=code {
  by_dir = group files whose lowercase suffix is in _CONFIG_EXTS, or whose lowercase name is in _CONFIG_EXTS or in lang.detect.SECURITY_CONFIG_NAMES, by parent directory
  within each directory sort by (name not security-named, scope.configs._rep_score(f, 0) environment tier, path)
  return paths of evidence._grouping._round_robin_select(by_dir, max_reps, keys=sorted directories)
  // preserved: the docstring says "one rep per parent dir", but the round-robin takes further files from each directory in later rounds until max_reps is reached
}

// src: vvaharness/evidence/configs.py:56-74
fn _config_rep_contents(root, rel_paths, cap_chars, max_bodies):executor=code {
  read_ceiling = max(_CONFIG_REP_RAW_CEILING, cap_chars * 4)
  with_bodies = first max(max_bodies, 0) of rel_paths stably sorted security-named first
  for each rel in rel_paths {
    body = ""
    if (cap_chars > 0 && rel in with_bodies) {
      raw = evidence.read._read_capped(root, root/rel, read_ceiling, whole_or_nothing=true)   // a file over the ceiling gives no body at all
      if (raw) body = _cap_text(redact(raw), cap_chars)   // redact BEFORE cap, so no secret is bisected
    }
    reps += (rel, body)
  }
  return reps
}
