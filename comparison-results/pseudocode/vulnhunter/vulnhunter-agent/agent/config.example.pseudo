// file: vulnhunter-agent/agent/config.example.toml
// The shipped example config (copy to config.toml). Env VULNHUNT_<SECTION>_<KEY> overrides every value.
// Note: the example ships sandbox.enabled = false and issues.enabled = false, unlike the code defaults (true).

@executedBy(CODE) @role(config) @stage("agent")
class ConfigExample {

    // [anthropic]: auth mode api_key | bedrock_oauth | bedrock_sigv4
    Map anthropic(Theta θ) {
        Map s = new Map();
        s.put("auth_mode", θ["anthropic.auth_mode"]);                                               // "api_key" // src: vulnhunter-agent/agent/config.example.toml:39
        s.put("api_key", θ["anthropic.api_key"]);                                                   // "" (or ANTHROPIC_API_KEY) // src: vulnhunter-agent/agent/config.example.toml:40
        s.put("model", θ["anthropic.model"]);                                                       // "claude-opus-4-8"; --model overrides // src: vulnhunter-agent/agent/config.example.toml:42
        s.put("bedrock_base_url", θ["anthropic.bedrock_base_url"]);                                 // "" // src: vulnhunter-agent/agent/config.example.toml:48
        s.put("aws_region", θ["anthropic.aws_region"]);                                             // "us-east-1" // src: vulnhunter-agent/agent/config.example.toml:49
        s.put("aws_profile", θ["code.agent.config_example.aws_profile"]);                           // "" -> default AWS chain (sigv4 only) // src: vulnhunter-agent/agent/config.example.toml:51
        return s;
    }

    // [oauth]: bedrock_oauth only
    Map oauth(Theta θ) {
        return θ["oauth.*"];                                                                        // token_endpoint, client_id, client_secret, expiry_safety_factor 0.9, default_lifetime_seconds 3600, http_timeout_seconds 30 // src: vulnhunter-agent/agent/config.example.toml:56
    }

    Map tls(Theta θ) {
        return Map.of("ssl_cert_path", θ["tls.ssl_cert_path"]);                                     // "" = system trust // src: vulnhunter-agent/agent/config.example.toml:69
    }

    Map sandbox(Theta θ) {
        Map s = new Map();
        s.put("enabled", θ["sandbox.enabled"]);                                                     // example: false // src: vulnhunter-agent/agent/config.example.toml:73
        s.put("fail_if_unavailable", θ["sandbox.fail_if_unavailable"]);                             // true // src: vulnhunter-agent/agent/config.example.toml:74
        s.put("allow_unsandboxed_commands", θ["sandbox.allow_unsandboxed_commands"]);               // false // src: vulnhunter-agent/agent/config.example.toml:75
        return s;
    }

    Map telemetry(Theta θ) {
        return Map.of("enabled", θ["telemetry.enabled"], "otel_exporter_otlp_endpoint", "", "resource_attributes", ""); // endpoint/attributes: no knob // src: vulnhunter-agent/agent/config.example.toml:79
    }

    // [scan]: Bash cannot be enabled here (stripped by the runner; only --no-read-only --enable-bash re-adds it)
    Map scan(Theta θ) {
        Map s = new Map();
        s.put("clone_base_dir", θ["scan.clone_base_dir"]);                                          // "./clones" // src: vulnhunter-agent/agent/config.example.toml:87
        s.put("clone_timeout_seconds", θ["scan.clone_timeout_seconds"]);                            // 300 // src: vulnhunter-agent/agent/config.example.toml:88
        s.put("allowed_tools", θ["scan.allowed_tools"]);                                            // Agent, Glob, Read, Write // src: vulnhunter-agent/agent/config.example.toml:100
        s.put("permission_mode", θ["scan.permission_mode"]);                                        // "acceptEdits" // src: vulnhunter-agent/agent/config.example.toml:101
        s.put("autocompact_pct_override", θ["scan.autocompact_pct_override"]);                      // commented out; model-derived 90 / 85 // src: vulnhunter-agent/agent/config.example.toml:105
        s.put("async_agent_stall_timeout_ms", θ["scan.async_agent_stall_timeout_ms"]);              // 1200000 // src: vulnhunter-agent/agent/config.example.toml:108
        s.put("no_proxy", θ["scan.no_proxy"]);                                                      // loopback + private ranges // src: vulnhunter-agent/agent/config.example.toml:111
        return s;
    }

    // [github]: scan_token (clone + issues), reports_token (publish), broker_token_dir, host
    Map github(Theta θ) {
        return θ["github.*"];                                                                       // host "github.com" // src: vulnhunter-agent/agent/config.example.toml:131
    }

    Map publish(Theta θ) {
        Map s = θ["publish.*"];                                                                     // destination_repo, branch "main", commit author // src: vulnhunter-agent/agent/config.example.toml:143
        s.put("enabled", θ["publish.enabled"]);                                                     // false // src: vulnhunter-agent/agent/config.example.toml:142
        return s;
    }

    Map issues(Theta θ) {
        Map s = new Map();
        s.put("enabled", θ["issues.enabled"]);                                                      // example: false // src: vulnhunter-agent/agent/config.example.toml:152
        s.put("target_repo", θ["code.agent.config_example.issues_target_repo"]);                                   // "" -> scanned repo URL // src: vulnhunter-agent/agent/config.example.toml:155
        s.put("labels", θ["issues.labels"]);                                                        // security, vulnhunter // src: vulnhunter-agent/agent/config.example.toml:158
        s.put("dedup_label", θ["code.agent.issues.dedup_label"]);                                   // "vulnhunter" // src: vulnhunter-agent/agent/config.example.toml:160
        s.put("haiku_model", θ["issues.haiku_model"]);                                              // src: vulnhunter-agent/agent/config.example.toml:163
        s.put("sonnet_model", θ["issues.sonnet_model"]);                                            // src: vulnhunter-agent/agent/config.example.toml:164
        s.put("semantic_dedup", θ["issues.semantic_dedup"]);                                        // src: vulnhunter-agent/agent/config.example.toml:167
        s.put("request_timeout_seconds", θ["issues.request_timeout_seconds"]);                      // src: vulnhunter-agent/agent/config.example.toml:169
        s.put("max_open_issues", θ["issues.max_open_issues"]);                                      // src: vulnhunter-agent/agent/config.example.toml:171
        s.put("token_budget_fraction", θ["issues.token_budget_fraction"]);                          // src: vulnhunter-agent/agent/config.example.toml:174
        s.put("model_context_tokens", θ["issues.model_context_tokens"]);                            // src: vulnhunter-agent/agent/config.example.toml:176
        s.put("notify_clean_scan", θ["issues.notify_clean_scan"]);                                  // src: vulnhunter-agent/agent/config.example.toml:180
        s.put("clean_scan_label", θ["code.agent.issues.clean_scan_label"]);                         // "VulnHunter: clean-scan" // src: vulnhunter-agent/agent/config.example.toml:182
        return s;
    }

    // [logging]: -v / -vv force both on
    Map logging(Theta θ) {
        return Map.of("per_turn_usage", θ["logging.per_turn_usage"], "retries", θ["code.agent.config_example.logging_retries"]); // src: vulnhunter-agent/agent/config.example.toml:187
    }

    // [verify] + [verify.repo_aliases]: verify-only inputs; URLs are never inferred (full URL or alias)
    Map verify(Theta θ) {
        return θ["verify.*"];                                                                       // scratch_base_dir "./verify_runs", clone_timeout_seconds 300, repo_aliases empty // src: vulnhunter-agent/agent/config.example.toml:194
    }

    // [repo_properties.github_property_map]: empty -> nothing fetched or emitted
    Map repoProperties() {
        return Map.of("github_property_map", Map.of());                                             // no knob // src: vulnhunter-agent/agent/config.example.toml:210
    }
}
