# vvaharness/models/scan/_sections_pipeline.py

The "Pipeline Diagnostics" report section: one line per nonzero stage counter, so a reader sees caps that cut evidence, threats never reviewed, cut-off model replies, unenforced evidence gates, retries and re-asks. Also the chunk-kind tally line.

Source: `vvaharness/models/scan/_sections_pipeline.py` (lines 1-323)
Executor: code
Called from: `vvaharness/models/scan/_sections_metrics.py` (_render_metrics or _render_scan_health)

// src: vvaharness/models/scan/_sections_pipeline.py:24-42
_CHUNK_KIND_LABELS = [risk: "risk", catchall: "catch-all", specialist: "specialist", taint: "taint", threat: "threat", other: "other"]   // display order; unknown kinds appended after
fn _render_chunk_kind_line(report):executor=code {
  parts = if (metrics.chunks_by_kind) known kinds in label order, then unknown kinds, as "label=n"
          else ["risk=<chunks_risk>", "catch-all=<chunks_catchall>", "specialist=<chunks_specialist>"]   // legacy trio
  return "- Chunks: <chunks_total> (<join(parts, ", ")>)"
}

// src: vvaharness/models/scan/_sections_pipeline.py:45-47
_STRUCTURED_RETRY_STAGES = ["s2", "s4", "s6", "s7", "s8"]
_TRUNCATED_RETRY_STAGES = ["s1", "s2", "s4", "s6", "s7", "s8", "ev_classify"]

// src: vvaharness/models/scan/_sections_pipeline.py:50-323
fn _render_pipeline_diagnostics(report, unreachable_appendix=true):executor=code {
  // a zero counter cannot tell "never ran" from "ran clean", so only a nonzero (non-default) counter emits a line
  m = report.metrics; lines = []
  // abstracted: each line below is a fixed English sentence with the counter value; quoted text is exact source wording, "…" marks omitted wording, unquoted text is a paraphrase
  if (m.s2_degraded) lines += "- Threat model: **degraded** — the model call failed or returned no usable threats; ranking and baseline coverage for this scan fell back to the deterministic passes only."
  if (m.s2_threats_raw) "Threats identified before ranking"
  if (m.s2_threats_truncated) "Threats truncated by the prompt cap"
  if (m.s2_threats_promoted) "Threats re-promoted after truncation to keep a trust boundary covered"
  if (any s2_frontier_*_excluded) "**Threat-model evidence excluded by step2 caps:** files / entry points / sinks / modules"
  if (any s2_inventory_files_truncated, s2_prompt_entry_points_truncated, s2_prompt_modules_truncated) "**Threat-model prompt truncated by step2 caps:** ..."
  if (m.s2_assets_truncated) "Assets truncated by step2.max_assets"
  if (m.s2_trust_boundaries_truncated) "Trust boundaries truncated by step2.max_trust_boundaries"
  if (m.s2_baseline_undisposed) "Baseline checklist items with no threat or open question disposing of them: <ids>"
  if (m.s2_repo_kinds) "Repository kind(s) detected: <kinds>"
  if (m.s2_surface_files_dropped) "Threat-model surface paths dropped (no such in-scope file)"
  if (m.s3_unknown_file_ids) "Chunk file references that matched no known file id"
  if (m.s3_dropped_paths) "File references dropped (no matching file found)"
  if (m.s3_relocated_paths) "**File references repaired by a suffix match: N** — the strategist named a file that did not exist as given; verify these did not resolve onto the wrong file of the same name."
  // src: vvaharness/models/scan/_sections_pipeline.py:123-133 — the count reports regardless of output.emit_unreachable_appendix; only the list is gated
  if (m.s3_unreachable_files) "Files named by no investigation unit: N of <total_files_in_scope> in-scope file(s) got no reviewer — " +
      (if (unreachable_appendix && report.unreachable_files) "they are listed in the appendix below" else "set output.emit_unreachable_appendix: true to list them in the report") + "."
  if (m.s3_threats_without_unit) "Threats with no investigation unit minted: N (<ids from report.threats_without_unit>) — never reviewed."
  if (m.s4_findings_truncated) "**Deep-dive findings discarded by the per-call cap: N** — one or more calls produced more findings than step4.max_findings_per_run allows; only the highest-confidence findings from each call were kept."
  if (m.deepagents_oversize_prompts) "**Calls refused as over-ceiling on the deepagents route: N** (VVAH-E004) — a prompt exceeded the route's context ceiling before dispatch, so the owning unit failed loudly instead of being silently truncated; its results are absent from this report."
  if (m.llm_truncated_replies) "**LLM replies cut off by the output-token budget: N** (VVAH-E005) — …"   // paraphrase: the owning unit failed loudly, results absent; the doubled-budget retry also hit the cap or had no headroom; the errors log names stage and case
  if (m.llm_truncated_retry_attempted) "**LLM replies resent at a doubled output-token budget (attempted / recovered): A / R**"   // an unrecovered attempt is in the E005 line or failed on the resend
  if (m.deepagents_tool_state_not_roundtripped) "**Tool-call replays rejected for missing per-turn state on the deepagents route: N** (VVAH-E006) — …"   // paraphrase: endpoint rejected a replayed tool call; owning unit failed loudly; run the doctor probe
  if (m.llm_adapter_evidence_gate_unenforced) "**Verdicts reached without a required fact-tool call on via: sdk / via: openai: N** (`llm_adapter_evidence_gate_unenforced`) — … The in-loop gate that would have rejected that verdict and re-asked is deepagents-only (neither raw provider loop has the seam), so this count plus a one-time WARN is the whole enforcement: those verdicts were reached from the prompt alone. Route the stage via: deepagents if the gate must actually hold."
  if (m.cli_mcp_evidence_gate_unenforced) "**Verdicts reached without a required fact-tool call on via: cli: N** (`cli_mcp_evidence_gate_unenforced`) — …"   // paraphrase: same shortfall on the MCP-bridged loop; via: cli has no in-loop seam either; route via: deepagents if the gate must hold
  if (m.s6_confirmed_without_vector) "**Verified findings confirmed with no CVSS vector: N** (`s6_confirmed_without_vector`) — …"   // paraphrase: expected, not a failure (the prompt says leave it empty rather than invent metrics); severity comes from its own CVSS/VulContextSeverity band if one exists, else its detection-time label, "never a blanket INFO floor"
  if (m.s6_cvss_zero_impact_on_tp) "**Verified findings with a zero-impact CVSS vector withheld: N** (`s6_cvss_zero_impact_on_tp`) — …"   // paraphrase: vector and score withheld, not shipped as 0.0 (SARIF would rank it last); also counted in s6_confirmed_without_vector; severity falls back to the detection-time label
  if (m.s6_confidence_clamped) "**Verifier confidence scores rewritten by the 0-10 clamp: N** (`s6_confidence_clamped`) — …"   // paraphrase: off-scale answers saturated or truncated (95 -> 10, 0.9 -> 0); counted per clamp event; a count near the verdict count means the shipped scores carry no ranking information
  if (m.s6_confidence_uniform) "**Every verdict at one confidence: N** (`s6_confidence_uniform`) — all judged verdicts carried the same score, so `step6_verify.min_confidence` admitted or dropped every TRUE_POSITIVE together; …"

  // src: vvaharness/models/scan/_sections_pipeline.py:272-303
  rejected = sum of <stage>_structured_retry_attempted over _STRUCTURED_RETRY_STAGES (and _recovered)
  clipped = sum of <stage>_truncated_retry_attempted over _TRUNCATED_RETRY_STAGES (and _recovered)
  if (rejected || clipped || m.s2_empty_retry_attempted) {
    dropped = m.sdk_tool_choice_dropped_for_thinking + m.deepagents_tool_choice_dropped
    lines += "**Primary model calls re-dispatched: $rejected after a rejected structured reply (... recovered), $clipped after a reply clipped at a budget the route could not grow (... recovered)**"
             + optional clauses for llm_structured_retry_truncated, the hollow threat model re-sample (s2_empty_retry_*), and $dropped calls without forced tool_choice under thinking
  }
  // src: vvaharness/models/scan/_sections_pipeline.py:304-319
  repaired = s2_parse_repair_attempted + s4_outcome_repaired_attempt + s4_batch_repaired_attempt + s6_outcome_repaired_attempt (and the recovered sums)
  if (repaired || m.llm_structured_prose_reask || m.llm_structured_submit_rejected) lines += "**Replies re-asked for their structured shape: ...**"

  if (lines is empty) return []
  return ["### Pipeline Diagnostics", ...lines]
}
