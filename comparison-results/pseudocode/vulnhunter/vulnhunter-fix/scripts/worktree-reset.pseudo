// file: vulnhunter-fix/scripts/worktree-reset.py
// Algorithm only: no commands are run by this pseudocode. Guard linked-worktree identity before destructive reset/clean.
// Source preserves protected patterns from clean, not from reset --hard; probe errors for git-dir/common-dir do not themselves refuse.

@executedBy(CODE) @role(tool) @stage("fix")
class WorktreeReset {
    @src("vulnhunter-fix/scripts/worktree-reset.py:28")
    String gitBin() {
        return which("git");
    }
    @src("vulnhunter-fix/scripts/worktree-reset.py:33")
    ProcessResult git(String cwd, List<String> args, Theta θ, double timeout = θ["code.fix.scripts.worktree_reset.git_timeout"]) { // src: vulnhunter-fix/scripts/worktree-reset.py:33
        String binary = gitBin(); if (binary == null) throw new FileNotFoundError("git absent");
        List argv = concat(List.of(binary, "-C", cwd), args);
        try { return subprocess(argv, captureOutput=true, text=true, check=false, timeout=timeout); } // src: vulnhunter-fix/scripts/worktree-reset.py:33
        catch (TimeoutExpired e) { return new ProcessResult(argv, -1, e.stdout instanceof String ? truthyOr(e.stdout, "") : "", (e.stderr instanceof String ? truthyOr(e.stderr, "") : "") + " timeout"); }
    }
    @src("vulnhunter-fix/scripts/worktree-reset.py:55")
    boolean looksLikeShaOrRef(String value) {
        return !value.isEmpty() && !value.startsWith("-"); // no SHA-format validation.
    }
    @src("vulnhunter-fix/scripts/worktree-reset.py:78")
    Path abs(Path worktree, String text) {
        Path path = Path.of(text); return path.isAbsolute() ? path.resolve() : worktree.resolveChild(path).resolve();
    }
    @src("vulnhunter-fix/scripts/worktree-reset.py:60")
    String unsafeWorktreeReason(Path worktree, Theta θ) {
        ProcessResult top = git(str(worktree), List.of("rev-parse", "--show-toplevel"), θ); if (top.returncode != 0) return "not a worktree";
        if (Path.of(top.stdout.strip()).resolve() != worktree.resolve()) return "not worktree root";
        ProcessResult gitDir = git(str(worktree), List.of("rev-parse", "--git-dir"), θ); ProcessResult common = git(str(worktree), List.of("rev-parse", "--git-common-dir"), θ);
        if (gitDir.returncode == 0 && common.returncode == 0 && abs(worktree, gitDir.stdout.strip()) == abs(worktree, common.stdout.strip())) return "main checkout refused";
        return null;
    }
    @src("vulnhunter-fix/scripts/worktree-reset.py:89")
    int reset(Object args, Theta θ) {
        Path worktree = Path.of(args.worktree); if (!worktree.isDirectory() || !looksLikeShaOrRef(args.branchBaseline)) return 2;
        String unsafe = unsafeWorktreeReason(worktree, θ); if (truthy(unsafe)) { printError(unsafe); return 2; }
        ProcessResult status = git(str(worktree), List.of("status", "--porcelain=v1"), θ); List dirty = status.stdout.splitlines().filter(l -> !l.strip().isEmpty()).map(l -> l.substring(3));
        ProcessResult reset = git(str(worktree), List.of("reset", "--hard", args.branchBaseline, "--"), θ); if (reset.returncode != 0) return 2;
        List cleanArgs = concat(List.of("clean", "-fdx"), θ["code.fix.scripts.worktree_reset.protected_patterns"].map(p -> "--exclude=" + p)); // src: vulnhunter-fix/scripts/worktree-reset.py:25
        ProcessResult clean = git(str(worktree), cleanArgs, θ); if (clean.returncode != 0) return 2;
        Map entry = Map.of("ts", utcNowSeconds(), "vuln_id", args.vulnId, "retry", args.retryNumber, "worktree", str(worktree), "branch_baseline", args.branchBaseline, "reason", args.reason, "aborted_files", dirty);
        Path log = Path.of(truthyOr(args.repoWorkRoot, worktree.parent)).resolve("retry_log.jsonl"); log.parent.mkdir(parents=true, existOk=true); appendUtf8(log, Json.dump(entry) + "\n");
        printJson(Map.of("status", "ok", "reset_to", args.branchBaseline, "aborted_files", dirty.size(), "log", str(log))); return 0;
    }
    @src("vulnhunter-fix/scripts/worktree-reset.py:142")
    int main(List<String> argv, Theta θ) {
        return reset(parseArgs(argv.tail(), required=List.of("--worktree", "--branch-baseline", "--vuln-id", "--retry-number", "--reason"), optional=List.of("--repo-work-root")), θ);
    }
}
