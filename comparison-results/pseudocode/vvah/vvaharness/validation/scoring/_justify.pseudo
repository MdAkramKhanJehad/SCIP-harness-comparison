// file: vvaharness/validation/scoring/_justify.py
// Fix-path justification builder: the host's tracker-comment text per decision (Fixed / Partial / Not Fixed),
// citing gate summaries, a 0-100 confidence and evidence anchors. INCONCLUSIVE is not re-narrated.

@executedBy(CODE) @role(evaluation) @stage("S11")
class Justify {

    Set<String> FAIL_STATUSES = Set.of("fail", "partial");                                           // src: vvaharness/validation/scoring/_justify.py:30
    Set<String> PASS_STATUSES = Set.of("pass");                                                      // src: vvaharness/validation/scoring/_justify.py:31

    int confidence(ScoreResult r) {
        return round(r.rawScore * 100);                                                              // CONFIDENCE_PERCENT_SCALE  // src: vvaharness/validation/scoring/_justify.py:36
    }

    String summaries(List<RawCriterion> gates, Set<String> statuses) {
        return String.join("; ", gates.filter(c -> statuses.contains(c.status)).map(c -> c.summary)); // src: vvaharness/validation/scoring/_justify.py:41
    }

    String anchorsStr(List<RawCriterion> gates, Theta θ) {
        return String.join("; ", collectEvidenceAnchors(gates).prefix(θ["code.validation.scoring._justify.max_evidence_anchors"])); // src: vvaharness/validation/scoring/_justify.py:46
    }

    String fixedText(ScoreResult r, List<RawCriterion> gates, Theta θ) {
        return "Fix verified: " + summaries(gates, PASS_STATUSES) + ". Fix confidence: " + confidence(r) + "%. Evidence: " + anchorsStr(gates, θ) + "."; // src: vvaharness/validation/scoring/_justify.py:51
    }

    String partialText(ScoreResult r, List<RawCriterion> gates) {
        List<String> files = filesNeedingFixes(gates);                                               // src: vvaharness/validation/scoring/_justify.py:60
        return "Partial fix: " + summaries(gates, PASS_STATUSES) + ". Gaps: " + summaries(gates, FAIL_STATUSES) + ". Fix confidence: " + confidence(r) + "%. Files needing fixes: " + (files.isEmpty() ? "N/A" : String.join(", ", files)) + "."; // src: vvaharness/validation/scoring/_justify.py:61
    }

    String notFixedText(ScoreResult r, List<RawCriterion> gates) {
        List<String> files = filesNeedingFixes(gates);                                               // src: vvaharness/validation/scoring/_justify.py:71
        List<String> actions = recommendedActions(gates);                                            // src: vvaharness/validation/scoring/_justify.py:72
        return "Fix insufficient: " + summaries(gates, Set.of("fail")) + ". Vulnerable pattern remains in " + (files.isEmpty() ? "affected files" : String.join(", ", files)) + ". Fix confidence: " + confidence(r) + "%. Recommended action: " + String.join("; ", actions) + "."; // src: vvaharness/validation/scoring/_justify.py:73
    }

    String buildFixJustification(ScoreResult r, List<RawCriterion> gates, Map extra, Theta θ) {
        if (r.decision == Decision.INCONCLUSIVE) return r.justification != null ? r.justification : ""; // engine's refusal reason kept  // src: vvaharness/validation/scoring/_justify.py:94
        if (r.decision == Decision.FIXED) return fixedText(r, gates, θ);                             // src: vvaharness/validation/scoring/_justify.py:82
        if (r.decision == Decision.PARTIALLY_FIXED) return partialText(r, gates);                    // src: vvaharness/validation/scoring/_justify.py:83
        return notFixedText(r, gates);                                                               // default formatter  // src: vvaharness/validation/scoring/_justify.py:96
    }

    List<String> collectEvidenceAnchors(List<RawCriterion> criteria) {
        List<String> out = new List();
        for (RawCriterion c : criteria) {                                                            // src: vvaharness/validation/scoring/_justify.py:103
            for (EvidenceAnchor a : c.evidence) out.add(a.line != null ? a.file + ":" + a.line : a.file); // src: vvaharness/validation/scoring/_justify.py:102
        }
        return out;
    }

    List<String> filesNeedingFixes(List<RawCriterion> criteria) {
        Set<String> files = new Set();
        for (RawCriterion c : criteria) {                                                            // src: vvaharness/validation/scoring/_justify.py:111
            if (FAIL_STATUSES.contains(c.status)) files.addAll(c.evidence.map(a -> a.file));         // src: vvaharness/validation/scoring/_justify.py:112
        }
        return files.filter(f -> !f.isEmpty()).sorted();                                             // src: vvaharness/validation/scoring/_justify.py:114
    }

    List<String> recommendedActions(List<RawCriterion> gates) {
        List<String> actions = gates.filter(c -> c.status.equals("fail")).map(c -> "Address " + c.name + ": " + c.summary); // src: vvaharness/validation/scoring/_justify.py:119
        return actions.isEmpty() ? List.of("Review all failing gates and apply fixes") : actions;   // src: vvaharness/validation/scoring/_justify.py:124
    }
}
