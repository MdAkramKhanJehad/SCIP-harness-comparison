// file: vvaharness/pipeline/callgraph_consumer.py
// Shared post-S2 callgraph consumers: read-only, deterministic helpers over the entry-point/sink qnode index in ctx.call_graph.
// ctx.call_graph carries file/function membership only: no caller-callee edges, no def-site spans, so neighborhood and the reverse view are always empty by construction.

@executedBy(CODE) @role(step) @stage("S5")
class GraphView {
    Map<String, List<String>> forward;                                                               // ctx.call_graph or empty
    Map<String, List<String>> fileQnodes;                                                            // file -> qnodes
    Map<String, List<String>> rev;                                                                   // always empty

    GraphView(ContextPackage ctx) {
        this.forward = ctx.callGraph != null ? ctx.callGraph : Map.of();                             // src: vvaharness/pipeline/callgraph_consumer.py:133
        this.fileQnodes = CallgraphConsumer.graphQnodesByFile(ctx);                                  // src: vvaharness/pipeline/callgraph_consumer.py:134
        this.rev = Map.of();                                                                         // no reverse edges are ever built // src: vvaharness/pipeline/callgraph_consumer.py:135
    }
}

@executedBy(CODE) @role(step) @stage("S5")
class CallgraphConsumer {

    // Memoized GraphView per ContextPackage, keyed by object id and validated through a weak reference so a reused id cannot return a stale view.
    Map<Integer, Tuple> VIEW_CACHE = new HashMap();                                                  // src: vvaharness/pipeline/callgraph_consumer.py:132

    // File part of a qnode name: everything before the last double colon.
    String qFile(String qn) {
        return qn.rpartitionBefore("::");                                                            // empty when no separator // src: vvaharness/pipeline/callgraph_consumer.py:37
    }

    // Parse a seed/codeflow hop formatted as file:line. Line is clamped to at least 1; a hop without a numeric line gives (hop, null).
    Tuple parseHop(String hop) {
        String filePart = hop.rpartitionBefore(":");                                                 // src: vvaharness/pipeline/callgraph_consumer.py:41
        String linePart = hop.rpartitionAfter(":");
        if (hop.contains(":") && !filePart.isEmpty() && linePart.isDigit()) return Tuple.of(filePart, Math.max(1, Integer.parseInt(linePart))); // src: vvaharness/pipeline/callgraph_consumer.py:43
        return Tuple.of(hop, null);                                                                  // src: vvaharness/pipeline/callgraph_consumer.py:46
    }

    // Index seed taint paths by every file they touch; each path is listed once per file.
    Map<String, List<List<String>>> seedPathsByFile(List<List<String>> seedTaintPaths) {
        Map<String, List<List<String>>> out = new DefaultMap(List::new);
        for (List<String> path : seedTaintPaths != null ? seedTaintPaths : List.of()) {              // src: vvaharness/pipeline/callgraph_consumer.py:51
            Set<String> touched = new HashSet();
            for (String hop : path) {                                                                // src: vvaharness/pipeline/callgraph_consumer.py:54
                String f = parseHop(hop).file;                                                       // src: vvaharness/pipeline/callgraph_consumer.py:57
                if (!f.isEmpty()) touched.add(f);                                                    // src: vvaharness/pipeline/callgraph_consumer.py:59
            }
            for (String f : touched) out.get(f).add(path);                                           // src: vvaharness/pipeline/callgraph_consumer.py:62
        }
        return out;
    }

    // The first usable source hop from a set of seed paths touching a file: file:line when the hop parses, else the raw hop text; empty paths skipped.
    String bestSourceFromSeed(List<List<String>> paths) {
        for (List<String> path : paths) {                                                            // src: vvaharness/pipeline/callgraph_consumer.py:65
            if (path.isEmpty()) continue;                                                            // src: vvaharness/pipeline/callgraph_consumer.py:67
            String src = path.get(0);                                                                // src: vvaharness/pipeline/callgraph_consumer.py:69
            Tuple p = parseHop(src);                                                                 // src: vvaharness/pipeline/callgraph_consumer.py:71
            if (!p.file.isEmpty() && p.line != null) return p.file + ":" + p.line;                   // src: vvaharness/pipeline/callgraph_consumer.py:72
            if (!src.isEmpty()) return src;                                                          // src: vvaharness/pipeline/callgraph_consumer.py:74
        }
        return null;                                                                                 // src: vvaharness/pipeline/callgraph_consumer.py:76
    }

    // Entry-point def-site line anchors by file: always empty (the call graph has no def-site spans).
    Map<String, List<Integer>> entryAnchorLines(ContextPackage ctx) {
        return Map.of();                                                                             // ctx deleted unused // src: vvaharness/pipeline/callgraph_consumer.py:79
    }

    // file -> ordered unique list of every qnode ctx.call_graph places in it; qnodes with no file part are dropped.
    Map<String, List<String>> graphQnodesByFile(ContextPackage ctx) {
        Map<String, List<String>> out = new DefaultMap(List::new);
        Map<String, Set<String>> seen = new DefaultMap(Set::new);
        for (String qn : ctx.callGraph != null ? ctx.callGraph.keys() : List.of()) {                 // src: vvaharness/pipeline/callgraph_consumer.py:85
            String f = qFile(qn);                                                                    // src: vvaharness/pipeline/callgraph_consumer.py:89
            if (!f.isEmpty() && !seen.get(f).contains(qn)) { out.get(f).add(qn); seen.get(f).add(qn); } // src: vvaharness/pipeline/callgraph_consumer.py:94
        }
        return out;
    }

    // Qnodes the call graph places in file (its only resolution signal; the line range is ignored). Backslashes normalised to slashes; capped at limit.
    List<String> qnodesAt(GraphView view, String file, int lineStart, int lineEnd, Theta θ) {         // limit keyword, default 6
        String f = (file != null ? file : "").replace("\\", "/");                                    // src: vvaharness/pipeline/callgraph_consumer.py:97
        List<String> cg = view.fileQnodes.get(f);                                                    // src: vvaharness/pipeline/callgraph_consumer.py:100
        if (cg != null && !cg.isEmpty()) return cg.distinctInOrder().limit(θ["code.pipeline.callgraph_consumer.qnodes_limit"]); // src: vvaharness/pipeline/callgraph_consumer.py:102
        return List.of();                                                                            // src: vvaharness/pipeline/callgraph_consumer.py:105
    }

    // Shared callers/callees view for s6/s7/s8: per qnode, up to max_edges callers and callees (callers always empty).
    Map neighborhood(GraphView view, List<String> qnodes, Theta θ) {                                 // max_edges keyword, default 8
        Map<String, Map> around = new HashMap();
        for (String qn : qnodes) {                                                                   // src: vvaharness/pipeline/callgraph_consumer.py:108
            around.put(qn, Map.of("callers", firstOrEmpty(view.rev.get(qn)).limit(θ["code.pipeline.callgraph_consumer.neighborhood_max_edges"]), "callees", firstOrEmpty(view.forward.get(qn)).limit(θ["code.pipeline.callgraph_consumer.neighborhood_max_edges"]))); // src: vvaharness/pipeline/callgraph_consumer.py:117
        }
        return around;
    }

    // The memoized GraphView for ctx, built once per run; a cache hit requires the stored weak reference to still point at the same ctx.
    GraphView graphView(ContextPackage ctx) {
        int key = identity(ctx);                                                                     // src: vvaharness/pipeline/callgraph_consumer.py:120
        Tuple entry = VIEW_CACHE.get(key);                                                           // src: vvaharness/pipeline/callgraph_consumer.py:121
        if (entry != null && entry.ref.get() == ctx) return entry.view;                              // src: vvaharness/pipeline/callgraph_consumer.py:123
        GraphView view = new GraphView(ctx);                                                         // src: vvaharness/pipeline/callgraph_consumer.py:124
        Object ref;
        try { ref = WeakReference.of(ctx); }                                                         // src: vvaharness/pipeline/callgraph_consumer.py:125
        catch (TypeError e) { ref = () -> ctx; }                                                     // fallback strong reference when ctx is not weakref-able // src: vvaharness/pipeline/callgraph_consumer.py:127
        VIEW_CACHE.put(key, Tuple.of(ref, view));                                                    // src: vvaharness/pipeline/callgraph_consumer.py:128
        return view;
    }
}
