// file: vvaharness/skills/sibling-instances/SKILL.md
// S4 skill playbook "sibling-instances": after a CONFIRMED weakness, sweep the whole repository for the same pattern,
// report one finding per confirmed site, check the same location for other classes, and state sweep counts.

@executedBy(MODEL) @role(skill) @stage("S4")
class SiblingInstancesSkill {

    List<Finding> run(Repo repo, Lens lens, List<Finding> confirmed, Theta θ) {
        if (!lens.task.matches(θ["p.skill_sibling-instances.trigger"])) return List.of();                  // src: vvaharness/skills/sibling-instances/SKILL.md:3
        SiblingInstancesPrompt.playbook(θ);
        List<Finding> out = new List();
        for (Finding f : confirmed) {
            // only after a confirmation; never for a refuted class
            if (θ["p.skill_sibling-instances.only_after_confirmation"] && !f.confirmed) continue;           // src: vvaharness/skills/sibling-instances/SKILL.md:34
            out.addAll(sweep(repo, f, θ));
            out.addAll(otherAxis(repo, f, θ));
        }
        // no speculative sweeps for classes without evidence
        if (θ["p.skill_sibling-instances.no_speculative_sweep"]) out = out.filter(x -> x.hasEvidence());    // src: vvaharness/skills/sibling-instances/SKILL.md:35
        return out;
    }

    List<Finding> sweep(Repo repo, Finding f, Theta θ) {
        String pattern = θ["p.skill_sibling-instances.step1_name_pattern"] ? f.concretePattern() : f.title;  // 1. name the pattern // src: vvaharness/skills/sibling-instances/SKILL.md:39
        List<String> terms = recurrenceTerms(f, pattern, θ);
        List<Hit> hits = new List();
        for (String t : terms.head(θ["p.skill_sibling-instances.grep_phrasings"])) {                       // two or three phrasings // src: vvaharness/skills/sibling-instances/SKILL.md:42
            hits.addAll(θ["p.skill_sibling-instances.step2_grep_whole_repo"] ? repo.grep(t) : f.file.grep(t)); // 2. whole repository // src: vvaharness/skills/sibling-instances/SKILL.md:41
        }
        List<Finding> sites = new List();
        for (Hit h : hits) {
            if (!θ["p.skill_sibling-instances.step3_open_every_hit"]) break;                                // 3. open every hit // src: vvaharness/skills/sibling-instances/SKILL.md:45
            Evidence e = h.open();
            // test fixture, different guard, fixed literal may be fine
            if (θ["p.skill_sibling-instances.hit_may_be_fine"] && (e.inTestFixture || e.differentGuard || e.fixedLiteral)) continue; // src: vvaharness/skills/sibling-instances/SKILL.md:46
            if (e.confirms(f)) {
                // 4. one finding per confirmed site, own file and line span
                if (θ["p.skill_sibling-instances.step4_one_finding_per_site"]) sites.add(new Finding(f.vulnClass, h.file, h.lineSpan)); // src: vvaharness/skills/sibling-instances/SKILL.md:48
            }
        }
        if (θ["p.skill_sibling-instances.no_folded_multi_path_finding"]) sites = sites.noFolding();          // src: vvaharness/skills/sibling-instances/SKILL.md:49
        if (θ["p.skill_sibling-instances.step5_do_not_pad"]) sites = sites.distinctByConstruct();           // 5. near-identical at one construct = duplicate // src: vvaharness/skills/sibling-instances/SKILL.md:52
        f.rationale.add(θ["p.skill_sibling-instances.rationale_sweep_counts"], List.of(terms, hits.size(), sites.size())); // sweep term, hit count, confirmed count // src: vvaharness/skills/sibling-instances/SKILL.md:85
        return sites;
    }

    /** Patterns that recur, from most to least reliably. */
    List<String> recurrenceTerms(Finding f, String pattern, Theta θ) {
        List<String> t = new List(pattern);
        if (f.isQueryConstruction() && θ["p.skill_sibling-instances.recur_query_construction"]) t.add("every execute/query/raw call, other modules too"); // src: vvaharness/skills/sibling-instances/SKILL.md:57
        if (f.isWeakHashOrRng() && θ["p.skill_sibling-instances.recur_hashing_randomness"]) t.add("registration, login, reset, token minting"); // src: vvaharness/skills/sibling-instances/SKILL.md:60
        if (f.isRedos() && θ["p.skill_sibling-instances.recur_redos"]) t.add("every nested-quantifier regex in the file"); // src: vvaharness/skills/sibling-instances/SKILL.md:64
        if (f.isSsrf() && θ["p.skill_sibling-instances.recur_outbound_requests"]) t.add("same helper module fetches"); // src: vvaharness/skills/sibling-instances/SKILL.md:66
        if (f.isDeserialization() && θ["p.skill_sibling-instances.recur_deserialization"]) t.add("import, export and cache paths"); // src: vvaharness/skills/sibling-instances/SKILL.md:68
        if (f.isCookieOrHeader() && θ["p.skill_sibling-instances.recur_cookie_header_writes"]) t.add("every handler's cookie/header writes"); // src: vvaharness/skills/sibling-instances/SKILL.md:70
        if (f.isMissingDecorator() && θ["p.skill_sibling-instances.recur_decorator_omissions"]) t.add("every handler in the module and same-shaped modules"); // src: vvaharness/skills/sibling-instances/SKILL.md:72
        return t;
    }

    /** The other axis: the same location, a different class -- each reported separately with its own CWE. */
    List<Finding> otherAxis(Repo repo, Finding f, Theta θ) {
        List<Finding> out = new List();
        if (!θ["p.skill_sibling-instances.other_axis_same_location_other_class"]) return out;              // src: vvaharness/skills/sibling-instances/SKILL.md:79
        for (VulnClass vc : f.location.otherWeaknesses()) {
            if (θ["p.skill_sibling-instances.two_classes_two_findings"]) out.add(new Finding(vc, f.file, f.lineSpan)); // src: vvaharness/skills/sibling-instances/SKILL.md:81
        }
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class SiblingInstancesPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_sibling-instances.only_after_confirmation"]);                                     // ## When this applies // src: vvaharness/skills/sibling-instances/SKILL.md:34
        p.forbid(θ["p.skill_sibling-instances.no_speculative_sweep"]);                                      // src: vvaharness/skills/sibling-instances/SKILL.md:35
        p.step(1, θ["p.skill_sibling-instances.step1_name_pattern"]);                                       // ## The sweep // src: vvaharness/skills/sibling-instances/SKILL.md:39
        p.step(2, θ["p.skill_sibling-instances.step2_grep_whole_repo"]);                                    // src: vvaharness/skills/sibling-instances/SKILL.md:41
        p.threshold(θ["p.skill_sibling-instances.grep_phrasings"]);                                         // src: vvaharness/skills/sibling-instances/SKILL.md:42
        p.step(3, θ["p.skill_sibling-instances.step3_open_every_hit"]);                                     // src: vvaharness/skills/sibling-instances/SKILL.md:45
        p.exemption(θ["p.skill_sibling-instances.hit_may_be_fine"]);                                        // src: vvaharness/skills/sibling-instances/SKILL.md:46
        p.step(4, θ["p.skill_sibling-instances.step4_one_finding_per_site"]);                               // src: vvaharness/skills/sibling-instances/SKILL.md:48
        p.forbid(θ["p.skill_sibling-instances.no_folded_multi_path_finding"]);                              // src: vvaharness/skills/sibling-instances/SKILL.md:49
        p.step(5, θ["p.skill_sibling-instances.step5_do_not_pad"]);                                         // src: vvaharness/skills/sibling-instances/SKILL.md:52
        p.checklist(θ["p.skill_sibling-instances.recur_query_construction"]);                               // src: vvaharness/skills/sibling-instances/SKILL.md:57
        p.checklist(θ["p.skill_sibling-instances.recur_hashing_randomness"]);                               // src: vvaharness/skills/sibling-instances/SKILL.md:60
        p.checklist(θ["p.skill_sibling-instances.recur_redos"]);                                            // src: vvaharness/skills/sibling-instances/SKILL.md:64
        p.checklist(θ["p.skill_sibling-instances.recur_outbound_requests"]);                                // src: vvaharness/skills/sibling-instances/SKILL.md:66
        p.checklist(θ["p.skill_sibling-instances.recur_deserialization"]);                                  // src: vvaharness/skills/sibling-instances/SKILL.md:68
        p.checklist(θ["p.skill_sibling-instances.recur_cookie_header_writes"]);                             // src: vvaharness/skills/sibling-instances/SKILL.md:70
        p.checklist(θ["p.skill_sibling-instances.recur_decorator_omissions"]);                              // src: vvaharness/skills/sibling-instances/SKILL.md:72
        p.must(θ["p.skill_sibling-instances.other_axis_same_location_other_class"]);                        // src: vvaharness/skills/sibling-instances/SKILL.md:79
        p.rule(θ["p.skill_sibling-instances.two_classes_two_findings"]);                                    // src: vvaharness/skills/sibling-instances/SKILL.md:81
        p.format(θ["p.skill_sibling-instances.rationale_sweep_counts"]);                                    // src: vvaharness/skills/sibling-instances/SKILL.md:85
        return p;
    }
}
