// file: vvaharness/rules/generic.kb.yaml
// The generic CWE/OWASP starter knowledge base: per CWE, sources, sinks, sanitizers, non-sanitizers and FP checks.
// Served to S4/S6 sessions through the CweGuidance fact tool (KbTools) and the TAINT KB prompt block.

@executedBy(CODE) @role(rule_set) @stage("S4")
class GenericKb {

    /** The 27 entries, in file order; a repeated CWE id merges into the same slot (lists appended, deduped). */
    CweKB load(Theta θ) {
        Object pack = θ["prompt.cwe_kb"];                                // the whole starter pack  // src: vvaharness/rules/generic.kb.yaml:20
        CweKB kb = new CweKB();
        kb.merge("CWE-89", θ["p.cwe_kb.cwe_89"]);                     // SQL Injection  // src: vvaharness/rules/generic.kb.yaml:23
        kb.merge("CWE-78", θ["p.cwe_kb.cwe_78"]);                     // 'OWASP A03 Injection: command execution'  // src: vvaharness/rules/generic.kb.yaml:45
        kb.merge("CWE-79", θ["p.cwe_kb.cwe_79"]);                     // 'OWASP A03 Injection: HTML / template output'  // src: vvaharness/rules/generic.kb.yaml:62
        kb.merge("CWE-22", θ["p.cwe_kb.cwe_22"]);                     // 'OWASP A01 Broken Access Control: path traversal'  // src: vvaharness/rules/generic.kb.yaml:80
        kb.merge("CWE-918", θ["p.cwe_kb.cwe_918"]);                   // 'OWASP A10 SSRF: server-side URL fetch'  // src: vvaharness/rules/generic.kb.yaml:97
        kb.merge("CWE-502", θ["p.cwe_kb.cwe_502"]);                   // 'OWASP A08 Software / data integrity: unsafe deserialization  // src: vvaharness/rules/generic.kb.yaml:113
        kb.merge("CWE-611", θ["p.cwe_kb.cwe_611"]);                   // 'OWASP A08 software integrity: XML external entity expansion  // src: vvaharness/rules/generic.kb.yaml:130
        kb.merge("CWE-601", θ["p.cwe_kb.cwe_601"]);                   // 'OWASP A01 Broken Access Control: open redirect'  // src: vvaharness/rules/generic.kb.yaml:145
        kb.merge("CWE-117", θ["p.cwe_kb.cwe_117"]);                   // 'OWASP A09 logging / monitoring: log injection'  // src: vvaharness/rules/generic.kb.yaml:160
        kb.merge("CWE-352", θ["p.cwe_kb.cwe_352"]);                   // 'OWASP A01 / session integrity: CSRF on state-changing actio  // src: vvaharness/rules/generic.kb.yaml:176
        kb.merge("CWE-306", θ["p.cwe_kb.cwe_306"]);                   // 'OWASP A07 authentication: missing auth check'  // src: vvaharness/rules/generic.kb.yaml:191
        kb.merge("CWE-862", θ["p.cwe_kb.cwe_862"]);                   // 'OWASP A01 broken access control: missing authorization'  // src: vvaharness/rules/generic.kb.yaml:206
        kb.merge("CWE-639", θ["p.cwe_kb.cwe_639"]);                   // 'OWASP A01 broken access control: IDOR / object reference'  // src: vvaharness/rules/generic.kb.yaml:221
        kb.merge("CWE-20", θ["p.cwe_kb.cwe_20"]);                     // 'OWASP A04 insecure design: missing input validation'  // src: vvaharness/rules/generic.kb.yaml:236
        kb.merge("CWE-327", θ["p.cwe_kb.cwe_327"]);                   // 'OWASP A02 cryptographic failures: weak or broken crypto'  // src: vvaharness/rules/generic.kb.yaml:251
        kb.merge("CWE-295", θ["p.cwe_kb.cwe_295"]);                   // 'OWASP A02 transport: TLS verification disabled'  // src: vvaharness/rules/generic.kb.yaml:266
        kb.merge("CWE-798", θ["p.cwe_kb.cwe_798"]);                   // 'OWASP A02 credentials: hardcoded secret or token'  // src: vvaharness/rules/generic.kb.yaml:281
        kb.merge("CWE-434", θ["p.cwe_kb.cwe_434"]);                   // 'OWASP A05 misconfiguration: unrestricted file upload'  // src: vvaharness/rules/generic.kb.yaml:296
        kb.merge("CWE-1333", θ["p.cwe_kb.cwe_1333"]);                 // 'OWASP A04 availability: regex denial of service'  // src: vvaharness/rules/generic.kb.yaml:311
        kb.merge("CWE-400", θ["p.cwe_kb.cwe_400"]);                   // 'OWASP A04 availability: unbounded resource consumption'  // src: vvaharness/rules/generic.kb.yaml:325
        kb.merge("CWE-94", θ["p.cwe_kb.cwe_94"]);                     // 'OWASP A03 injection: code / expression evaluation'  // src: vvaharness/rules/generic.kb.yaml:340
        kb.merge("CWE-117", θ["p.cwe_kb.cwe_117_2"]);                 // 'OWASP A09 observability: sensitive data in logs'  // src: vvaharness/rules/generic.kb.yaml:356
        kb.merge("CWE-200", θ["p.cwe_kb.cwe_200"]);                   // OWASP A01 / A02 information exposure  // src: vvaharness/rules/generic.kb.yaml:371
        kb.merge("CWE-22", θ["p.cwe_kb.cwe_22_2"]);                   // 'OWASP A01 broken access control: archive / path member trav  // src: vvaharness/rules/generic.kb.yaml:386
        kb.merge("CWE-269", θ["p.cwe_kb.cwe_269"]);                   // 'OWASP A01 privilege issue: over-privileged action'  // src: vvaharness/rules/generic.kb.yaml:401
        kb.merge("CWE-306", θ["p.cwe_kb.cwe_306_2"]);                 // 'OWASP A07 auth: unauthenticated control plane action'  // src: vvaharness/rules/generic.kb.yaml:417
        kb.merge("CWE-326", θ["p.cwe_kb.cwe_326"]);                   // 'OWASP A02 cryptography: insufficient encryption strength'  // src: vvaharness/rules/generic.kb.yaml:432
        return kb;
    }

    /** CweKB.for_cwes: merged title/origin/sources/sinks/sanitizers/non_sanitizers/fp_checks for the given ids; a miss returns empty lists. */
    @src("vvaharness/rules/__init__.py:157")
    Map forCwes(CweKB kb, List<String> cwes, String lang) {
        Map out = emptyEntry();                                                       // src: vvaharness/rules/__init__.py:161
        for (String c : cwes) {                                                       // src: vvaharness/rules/__init__.py:164
            Slot slot = kb.get(normCwe(c));                                           // src: vvaharness/rules/__init__.py:166
            if (slot == null) continue;                                               // src: vvaharness/rules/__init__.py:167
            out.appendDistinct(filterLang(slot, lang));                              // src: vvaharness/rules/__init__.py:176
        }
        return out;
    }
}
