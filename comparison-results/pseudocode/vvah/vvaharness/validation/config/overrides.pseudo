// file: vvaharness/validation/config/overrides.py
// Profile-sourced tunables that seed load_config(); every absent key falls back to the shipped default,
// never to the VVAHARNESS_* environment.

// Real name ValidateOverrides (a TypedDict with total=False: a profile sets only the keys it declares; load_config reads each present key and falls back to the shipped default for each absent one).
@executedBy(CODE) @role(types) @stage("S11")
record Overrides(String model, String via, String provider, Boolean useResponsesApi, EffortLevel effort,
                 int maxTurns, Double maxBudgetUsd, Integer maxFindings, int timeout, int maxModelCalls,
                 int orchestratorMaxModelCalls, String securityArchitectModel, String penetrationTesterModel,
                 String crossRepoAnalyzerModel, String validateTools, boolean cacheMarkers) { }
