// file: vvaharness/backends/harness/deepagents/options/model_building.py
// Resolves a model id to a chat model (Anthropic or OpenAI-compatible) with timeout, retries, output ceiling and
// reasoning/thinking settings; also owns the REASON_IN_PROMPT suffix used when think_in_prompt replaces native reasoning.
// Full file: TLS-aware httpx clients (CA bundle, mTLS client chain, verify tri-state, scoped no_proxy), transport and
// reasoning-effort resolution, and the process-wide model cache keyed by TLS fingerprint and running event loop.

@executedBy(CODE) @role(backend)
class ModelBuilding {

    // True when think_in_prompt applies: every route except Anthropic models that refuse it.
    boolean reasonsInPrompt(String modelId, String provider, Theta θ) {
        if (!routesToAnthropic(modelId, provider)) return true;                                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:380
        // thinking cannot be disabled there and REASON_IN_PROMPT is refused as reasoning extraction
        return !regex(θ["p.model_building.no_reason_in_prompt_models"]).search(modelId);                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:374
    }

    Map<String, Object> anthropicThinkingKwargs(Effort effort, boolean inPrompt) {
        String mapped = ANTHROPIC_EFFORT_MAP.get(effort);                                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:388
        if (mapped == null) return inPrompt ? Map.of("thinking", "disabled") : Map.of();                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:390
        if (inPrompt) return Map.of("thinking", "disabled", "effort", mapped);                           // src: vvaharness/backends/harness/deepagents/options/model_building.py:394
        return Map.of("thinking", "adaptive", "effort", mapped);                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:395
    }

    // Resolve a model id to a chat model: Anthropic arm (ForcingChatAnthropic, optional TLS client injection) or the
    // OpenAI-compatible arm (own httpx clients, transport and effort kwargs). Env is the session env map.
    ChatModel buildModel(String modelId, Env env, String provider, Effort effort, Boolean useResponsesApi, boolean thinkInPrompt, Theta θ) { // src: vvaharness/backends/harness/deepagents/options/model_building.py:444
        warnIfVendorInferred(modelId, provider);                                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:454
        // same predicate gates the instruction in graph_builder
        thinkInPrompt = thinkInPrompt && reasonsInPrompt(modelId, provider, θ);                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:456
        boolean anthropicRoute = routesToAnthropic(modelId, provider);                                   // src: vvaharness/backends/harness/deepagents/options/model_building.py:457
        SslContext sslContext = sslContext(env, !anthropicRoute);                                        // ambient CA vars only on the OpenAI arm // src: vvaharness/backends/harness/deepagents/options/model_building.py:458
        String noProxy = configNoProxy(env);                                                             // src: vvaharness/backends/harness/deepagents/options/model_building.py:459
        // MODEL_TIMEOUT_SECONDS is the high-tier anchor; scaled once here for every client below
        Duration requestTimeout = LlmModels.effortScaledSeconds(DeepagentsLimits.modelTimeoutSeconds(θ), effort, ClockKind.REQUEST); // src: vvaharness/backends/harness/deepagents/options/model_building.py:461
        if (anthropicRoute) {                                                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:464
            String token = DeepagentsModels.anthropicKey(env);
            ChatModel chat = new ForcingChatAnthropic(modelId, token, DeepagentsModels.anthropicBase(env), requestTimeout,
                DeepagentsLimits.modelMaxRetries(θ),        // 429/5xx ladder                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:470
                DeepagentsLimits.modelMaxOutputTokens(θ),                                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:472
                anthropicThinkingKwargs(effort, thinkInPrompt));                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:473
            if (sslContext != null || Tls.isAnthropicOauthToken(token)) {                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:475
                with (Tls.scopedNoProxyEnv(noProxy)) injectAnthropicClients(chat, sslContext, token != null ? token : "", requestTimeout, θ); // src: vvaharness/backends/harness/deepagents/options/model_building.py:476
            }
            return chat;
        }
        // OpenAI-compatible endpoints. Always inject our own clients: langchain_openai shared client cache is not event-loop safe
        Map clientKwargs = Map.of("timeout", requestTimeout);                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:481
        if (sslContext != null) clientKwargs.put("verify", sslContext);                                  // src: vvaharness/backends/harness/deepagents/options/model_building.py:482
        with (Tls.scopedNoProxyEnv(noProxy)) {
            httpClient = new OpenaiHttpxClient(clientKwargs);                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:485
            httpAsyncClient = new OpenaiAsyncHttpxClient(clientKwargs);
        }
        // empty tuple silences a spurious proxy-shadow warning; our explicit clients never apply socket options
        Map socketOptionsKwargs = new Map();
        if (fieldDeclared(ToolCallStateChatOpenAI, "http_socket_options")) socketOptionsKwargs.put("http_socket_options", []); // src: vvaharness/backends/harness/deepagents/options/model_building.py:489
        boolean resolvedTransport = resolveUseResponsesApi(modelId, provider, useResponsesApi) == true; // src: vvaharness/backends/harness/deepagents/options/model_building.py:491
        Map effortKw = openaiEffortKwargs(modelId, effort, thinkInPrompt, resolvedTransport, θ);         // src: vvaharness/backends/harness/deepagents/options/model_building.py:492
        Map transportKw = transportKwargs(resolvedTransport);                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:494
        return new ToolCallStateChatOpenAI(modelId, DeepagentsModels.openaiKey(env), DeepagentsModels.openaiBase(env), requestTimeout,
            DeepagentsLimits.modelMaxRetries(θ),            // parity with the Anthropic arm              // src: vvaharness/backends/harness/deepagents/options/model_building.py:500
            httpClient, httpAsyncClient, socketOptionsKwargs, effortKw, transportKw);                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:496
    }

    // Configured CA bundle path, mirroring httpx env lookup order. Ambient CA vars (SSL_CERT_FILE, REQUESTS_CA_BUNDLE,
    // NODE_EXTRA_CA_CERTS; session env first, then process env) are ADDITIVE while httpx verify is EXCLUSIVE (it would break
    // api.anthropic.com), so ambient is read only when allowed; an absent configured file RAISES.
    String caBundle(Env env, boolean allowAmbient) {                                                     // src: vvaharness/backends/harness/deepagents/options/model_building.py:96
        String caFile;
        if (allowAmbient) {                                                                              // src: vvaharness/backends/harness/deepagents/options/model_building.py:99
            caFile = firstTruthy(env.get(SSL_CERT_FILE_VAR), env.get("REQUESTS_CA_BUNDLE"), env.get("NODE_EXTRA_CA_CERTS"),
                                 osEnv(SSL_CERT_FILE_VAR), osEnv("REQUESTS_CA_BUNDLE"), osEnv("NODE_EXTRA_CA_CERTS")); // src: vvaharness/backends/harness/deepagents/options/model_building.py:100
        } else {
            caFile = env.get(SSL_CERT_FILE_VAR);                                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:108
        }
        if (caFile && !isFile(caFile)) throw new FileNotFoundError("DeepAgents CA bundle not found or not a file: " + caFile); // src: vvaharness/backends/harness/deepagents/options/model_building.py:109
        String caDir = firstTruthy(env.get(SSL_CERT_DIR_VAR), allowAmbient ? osEnv(SSL_CERT_DIR_VAR) : null); // src: vvaharness/backends/harness/deepagents/options/model_building.py:113
        if (caDir && !isDir(caDir)) throw new FileNotFoundError("DeepAgents CA directory not found or not a directory: " + caDir); // src: vvaharness/backends/harness/deepagents/options/model_building.py:116
        return firstTruthy(caFile, caDir);                                                               // file wins over dir // src: vvaharness/backends/harness/deepagents/options/model_building.py:120
    }

    // Config-level verify_ssl tri-state. Envs inherit os.environ, so only values stamped with the config prefix disable TLS
    // verification; an unstamped (ambient) value is ignored with a warning. The remainder goes through coerce_verify.
    Object configVerify(Env env) {                                                                       // src: vvaharness/backends/harness/deepagents/options/model_building.py:124
        String raw = env.get(TLS_VERIFY_VAR);
        if (raw == null) return null;                                                                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:128
        if (!raw.startsWith(TLS_VERIFY_STAMP)) {                                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:130
            Log.warning("AMBIENT_ENV_IGNORED", TLS_VERIFY_VAR);
            return null;
        }
        return Tls.coerceVerify(raw.removePrefix(TLS_VERIFY_STAMP));                                     // src: vvaharness/backends/harness/deepagents/options/model_building.py:133
    }

    // Config-level no_proxy hosts, stamped like configVerify so an ambient carrier cannot re-route; empty remainder = null.
    String configNoProxy(Env env) {                                                                      // src: vvaharness/backends/harness/deepagents/options/model_building.py:136
        String raw = env.get(NO_PROXY_VAR);
        if (raw == null) return null;                                                                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:140
        if (!raw.startsWith(TLS_VERIFY_STAMP)) {                                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:142
            Log.warning("AMBIENT_ENV_IGNORED", NO_PROXY_VAR);
            return null;
        }
        return raw.removePrefix(TLS_VERIFY_STAMP) != "" ? raw.removePrefix(TLS_VERIFY_STAMP) : null;     // src: vvaharness/backends/harness/deepagents/options/model_building.py:145
    }

    // Effective httpx verify value, or null when only defaults apply. A CA bundle wins over the config verify; false warns
    // (verify disabled) and is returned; a string is a CA path; true or null are defaults.
    Object resolveVerify(Env env, boolean allowAmbient) {                                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:148
        Object verify = firstTruthy(caBundle(env, allowAmbient), configVerify(env));                     // note: a falsy CA bundle falls through to configVerify even when it is false // src: vvaharness/backends/harness/deepagents/options/model_building.py:150
        if (verify == false) {                                                                           // src: vvaharness/backends/harness/deepagents/options/model_building.py:151
            Tls.warnVerifyDisabled(allowAmbient ? DeepagentsModels.openaiBase(env) : DeepagentsModels.anthropicBase(env), "deepagents"); // src: vvaharness/backends/harness/deepagents/options/model_building.py:152
            return false;
        }
        return verify instanceof String ? verify : null;                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:159
    }

    // mTLS client certificate (session env, then process env). No cert = null. A missing file disables mTLS (resolve chain
    // warns and returns null).
    Object clientCert(Env env) {                                                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:161
        cert = firstTruthy(env.get(TLS_CLIENT_CERT_VAR), osEnv(TLS_CLIENT_CERT_VAR));                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:163
        if (!cert) return null;                                                                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:164
        key = firstTruthy(env.get(TLS_CLIENT_KEY_VAR), osEnv(TLS_CLIENT_KEY_VAR));                       // src: vvaharness/backends/harness/deepagents/options/model_building.py:166
        return Tls.resolveClientChain(key ? pair(cert, key) : cert, "deepagents", "client_cert/key");    // src: vvaharness/backends/harness/deepagents/options/model_building.py:167
    }

    // Resolve a profile cert path against the config dir when one is known. Must use the shared resolver for its UNC
    // refusal, or a planted config leaks credentials over SMB.
    String resolveCertPath(String path, Path cfgDir) {                                                   // src: vvaharness/backends/harness/deepagents/options/model_building.py:172
        if (cfgDir == null) return path;                                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:175
        return ConfigPaths.resolveAgainst(cfgDir, path);                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:177
    }

    // TLS env carriers build_model reads, for the resolved vendor. DETECTION seam only: an mTLS or private-CA profile never
    // reaches via: deepagents S10/S11. The block is the SDK block on an Anthropic route, else the OpenAI block; no block = none.
    Map<String, String> tlsCarriersFor(String modelId, String provider, Object sdkCfg, Object openaiCfg, Object cfgDir) { // src: vvaharness/backends/harness/deepagents/options/model_building.py:180
        block = routesToAnthropic(modelId, provider) ? sdkCfg : openaiCfg;                               // src: vvaharness/backends/harness/deepagents/options/model_building.py:190
        if (block == null) return new Map();                                                             // src: vvaharness/backends/harness/deepagents/options/model_building.py:191
        Path directory = cfgDir ? new Path(cfgDir) : null;                                               // src: vvaharness/backends/harness/deepagents/options/model_building.py:193
        Map carriers = new Map();
        if (block.caCert) carriers[SSL_CERT_FILE_VAR] = resolveCertPath(block.caCert, directory);        // src: vvaharness/backends/harness/deepagents/options/model_building.py:196
        pair = block.clientCert ? Tls.chainPaths(block.clientCert) : [];                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:199
        for ((var, path) : zip([TLS_CLIENT_CERT_VAR, TLS_CLIENT_KEY_VAR], pair)) carriers[var] = resolveCertPath(path, directory); // src: vvaharness/backends/harness/deepagents/options/model_building.py:201
        verify = Tls.coerceVerify(block.verifySsl);                                                      // src: vvaharness/backends/harness/deepagents/options/model_building.py:203
        if (verify != null && verify != true) {                                                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:204
            String value = verify == false ? "false" : resolveCertPath(verify, directory);
            carriers[TLS_VERIFY_VAR] = TLS_VERIFY_STAMP + value;                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:206
        }
        if (block.noProxy) carriers[NO_PROXY_VAR] = TLS_VERIFY_STAMP + block.noProxy;                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:209
        return carriers;
    }

    // SSL context for the configured TLS material, or null when there is none. A bad CA RAISES, a bad chain warns; never
    // passes cert= to create_ssl_context (httpx2 2.13.1). When the chain was the only configured material and failed to
    // load, stay stock (null).
    SslContext sslContext(Env env, boolean allowAmbientCa) {                                             // src: vvaharness/backends/harness/deepagents/options/model_building.py:212
        verify = resolveVerify(env, allowAmbientCa);                                                     // src: vvaharness/backends/harness/deepagents/options/model_building.py:217
        cert = clientCert(env);                                                                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:218
        if (verify == null && cert == null) return null;                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:219
        context = Httpx2.createSslContext(verify == null ? true : verify, true);                         // trust_env=true // src: vvaharness/backends/harness/deepagents/options/model_building.py:221
        if (cert != null && !Tls.loadClientChain(context, cert, "deepagents") && verify == null) return null; // src: vvaharness/backends/harness/deepagents/options/model_building.py:224
        return context;                                                                                  // src: vvaharness/backends/harness/deepagents/options/model_building.py:228
    }

    // Pre-seed the chat model anthropic clients with TLS-configured httpx clients. No http_client field exists (a kwarg
    // breaks every call), so the client attributes are seeded directly; failure is CLOSED, never unpinned.
    void injectAnthropicClients(ChatModel chat, SslContext sslContext, String token, Duration timeout, Theta θ) { // src: vvaharness/backends/harness/deepagents/options/model_building.py:231
        syncHttp = null;
        try {
            params = copy(chat.clientParams);                                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:238
            // auth_token and api_key are mutually exclusive: OAuth replaces api_key. Otherwise the explicit api_key is kept
            // so a blank token fails closed instead of falling into anthropic on-disk/env credential discovery
            if (Tls.isAnthropicOauthToken(token)) params.remove("api_key");                              // src: vvaharness/backends/harness/deepagents/options/model_building.py:244
            Map httpKwargs = Map.of("timeout", timeout);                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:245
            if (sslContext != null) httpKwargs.put("verify", sslContext);                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:246
            syncHttp = new AnthropicDefaultHttpxClient(httpKwargs);                                      // src: vvaharness/backends/harness/deepagents/options/model_building.py:248
            chat.client = new AnthropicClient(merge(params, Tls.anthropicAuthKwargs(token), Map.of("http_client", syncHttp))); // src: vvaharness/backends/harness/deepagents/options/model_building.py:249
            chat.asyncClient = new AnthropicAsyncClient(merge(params, Tls.anthropicAuthKwargs(token), Map.of("http_client", new AnthropicDefaultAsyncHttpxClient(httpKwargs)))); // src: vvaharness/backends/harness/deepagents/options/model_building.py:252
        } catch (Exception exc) {                                                                        // src: vvaharness/backends/harness/deepagents/options/model_building.py:260
            // undo a partial seed and close the already-built sync pool rather than leak it
            chat.removeClientAttrs();
            if (syncHttp != null) syncHttp.close();                                                      // src: vvaharness/backends/harness/deepagents/options/model_building.py:265
            throw new RuntimeError("TLS client injection into ChatAnthropic failed. Refusing to continue on SYSTEM TRUST: the configured ca_cert pin would not be enforced and any client_cert would not be presented."); // src: vvaharness/backends/harness/deepagents/options/model_building.py:268
        }
    }

    // Map our EffortLevel vocabulary to OpenAI reasoning_effort literal: low, medium, high, xhigh, max; unparsed = null.
    String toOpenaiReasoningEffort(String effort) {                                                      // src: vvaharness/backends/harness/deepagents/options/model_building.py:284
        parsed = EffortLevelParse.parse(effort);                                                              // src: vvaharness/backends/harness/deepagents/options/model_building.py:286
        return parsed != null ? OPENAI_EFFORT_MAP.get(parsed) : null;                                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:287
    }

    // True when the model Responses leg caps output at 4096 and drops the tool call: the id after the last gateway
    // namespace separator, lowercased, is in the broken list.
    boolean needsChatCompletions(String modelId, Theta θ) {                                              // src: vvaharness/backends/harness/deepagents/options/model_building.py:309
        return θ["code.backends.harness.deepagents.options.model_building.responses_broken_models"]      // kimi-k2.6, kimi-k2.7-code, glm-5.2 // src: vvaharness/backends/harness/deepagents/options/model_building.py:311
            .contains(lower(lastSegment(modelId, GATEWAY_NAMESPACE)));                                   // src: vvaharness/backends/harness/deepagents/options/model_building.py:311
    }

    // reasoning_effort kwarg to splice in, or empty. transport must match the one the caller builds for: a tier learned on
    // Responses is invisible under the Chat key (and vice versa). A model whose field was rejected gets nothing.
    Map<String, Object> effortKwargs(String modelId, String effort, String transport) {                  // src: vvaharness/backends/harness/deepagents/options/model_building.py:322
        if (EFFORT_REJECTIONS.field.contains(modelId)) return new Map();                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:331
        mapped = LlmModels.effortAfterRejections(modelId, toOpenaiReasoningEffort(effort), transport);   // src: vvaharness/backends/harness/deepagents/options/model_building.py:333
        return mapped == null ? new Map() : Map.of("reasoning_effort", mapped);                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:334
    }

    // reasoning_effort none for a model that must not reason natively, else empty. An absent field leaves the model at its
    // own default: kimi-k2.6 then spent most of its output tokens reasoning and truncated. Keyed exactly as a mapped tier,
    // so one 400 retires the field for this model too.
    Map<String, Object> reasoningOffKwargs(String modelId, Theta θ) {                                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:345
        if (!θ["code.backends.harness.deepagents.options.model_building.reasoning_off_models"].contains(modelId) || EFFORT_REJECTIONS.field.contains(modelId)) return new Map(); // kimi-k2.6, kimi-k2.7-code, glm-5.2 // src: vvaharness/backends/harness/deepagents/options/model_building.py:345
        if (EFFORT_REJECTIONS.tiers.contains(pair(modelId, REASONING_OFF))) return new Map();            // src: vvaharness/backends/harness/deepagents/options/model_building.py:350
        return Map.of("reasoning_effort", REASONING_OFF);                                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:351
    }

    // Transport: the override, then a model that needs chat completions, then a learned chat-only rejection, else Responses.
    // Anthropic models resolve to null (no transport choice).
    Boolean resolveUseResponsesApi(String modelId, String provider, Boolean override, Theta θ) {                  // src: vvaharness/backends/harness/deepagents/options/model_building.py:396
        if (routesToAnthropic(modelId, provider)) return null;                                           // src: vvaharness/backends/harness/deepagents/options/model_building.py:400
        if (override != null) return override;                                                           // src: vvaharness/backends/harness/deepagents/options/model_building.py:402
        if (needsChatCompletions(modelId, θ)) return false;                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:404
        return !CHAT_COMPLETIONS_ONLY_MODELS.contains(modelId);                                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:406
    }

    // WARN once when a namespaced id vendor had to be guessed from its name. A claude id routes to the Anthropic block even
    // on OpenAI gateways: NOT changed by design.
    void warnIfVendorInferred(String modelId, String provider) {                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:418
        if (provider || !modelId.contains(GATEWAY_NAMESPACE)) return;                                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:421
        String vendor = routesToAnthropic(modelId, provider) ? "anthropic" : "openai";                   // src: vvaharness/backends/harness/deepagents/options/model_building.py:422
        WarnOnce.warnOnce(INFERRED_VENDOR_WARNED, modelId, "vendor INFERRED from the name: set provider anthropic or openai to pin it"); // src: vvaharness/backends/harness/deepagents/options/model_building.py:423
    }

    // ChatOpenAI kwargs for the resolved transport. Chat: use_responses_api false only. Responses: use_responses_api true,
    // store false (no per-turn state at the endpoint), include the encrypted reasoning so it replays the state.
    Map<String, Object> transportKwargs(boolean resolved) {                                              // src: vvaharness/backends/harness/deepagents/options/model_building.py:433
        if (!resolved) return Map.of("use_responses_api", false);                                        // src: vvaharness/backends/harness/deepagents/options/model_building.py:435
        return Map.of("use_responses_api", true, "store", false, "include", list(RESPONSES_INCLUDE_ENCRYPTED_REASONING)); // src: vvaharness/backends/harness/deepagents/options/model_building.py:437
    }

    // reasoning_effort kwarg for an OpenAI-compatible build. Forcing it off wins on Chat Completions when the model is in
    // the tools-off set (every call on this leg carries tools). Under think_in_prompt dropping the tier is not reasoning
    // off: reasoning-off models need none sent explicitly. Otherwise the per-transport mapped tier.
    Map<String, Object> openaiEffortKwargs(String modelId, String effort, boolean thinkInPrompt, boolean resolvedTransport, Theta θ) { // src: vvaharness/backends/harness/deepagents/options/model_building.py:444
        if (EFFORT_REJECTIONS.toolsOff.contains(modelId) && !resolvedTransport) return Map.of("reasoning_effort", REASONING_OFF); // src: vvaharness/backends/harness/deepagents/options/model_building.py:452
        String transport = resolvedTransport ? TRANSPORT_RESPONSES : TRANSPORT_CHAT_COMPLETIONS;         // src: vvaharness/backends/harness/deepagents/options/model_building.py:455
        return thinkInPrompt ? reasoningOffKwargs(modelId, θ) : effortKwargs(modelId, effort, transport); // src: vvaharness/backends/harness/deepagents/options/model_building.py:456
    }

    // Fingerprint the TLS material env resolves (session env, then process env, else empty) over the cache-key env names:
    // cert, key, verify, no_proxy, SSL_CERT_FILE, SSL_CERT_DIR, REQUESTS_CA_BUNDLE, NODE_EXTRA_CA_CERTS.
    List<String> tlsFingerprint(Env env) {                                                               // src: vvaharness/backends/harness/deepagents/options/model_building.py:548
        return TLS_ENV_VARS.map(v -> firstTruthy(env.get(v), osEnv(v), ""));                             // src: vvaharness/backends/harness/deepagents/options/model_building.py:550
    }

    // A collision-safe identity for the running event loop, or null outside one. Each live loop gets a monotonically
    // increasing token via a weak-keyed map (id(loop) alone can be reused for the next loop in a per-finding sequence).
    // A model cached under a closed loop and reused under the next raises Event loop is closed, so the cache splits per loop.
    Integer loopToken() {                                                                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:553
        try {
            loop = getRunningLoop();
        } catch (RuntimeError e) {
            return null;                                                                                 // no running loop: all such callers share the key null // src: vvaharness/backends/harness/deepagents/options/model_building.py:581
        }
        token = LOOP_TOKENS.get(loop);
        if (token != null) return token;                                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:585
        LOOP_TOKEN_LOCK.acquire();
        token = LOOP_TOKENS.get(loop);                                                                   // double-checked under the lock // src: vvaharness/backends/harness/deepagents/options/model_building.py:588
        if (token == null) {
            token = LOOP_TOKEN_COUNTER.next();
            LOOP_TOKENS.put(loop, token);
        }
        LOOP_TOKEN_LOCK.release();
        return token;                                                                                    // src: vvaharness/backends/harness/deepagents/options/model_building.py:591
    }

    // A model instance, reusing a cached one when inputs match. The key uses the FIELD ACTUALLY SENT (none, a stepped-down
    // tier, forced REASONING_OFF after a tools-conflict, or null), never the raw effort: a tools-conflict step adds to
    // tools_off not tiers, so a key that ignored it would serve the retry its own stale rejected instance and recurse forever.
    ChatModel buildModelCached(String modelId, Env env, String provider, Effort effort, Boolean useResponsesApi, boolean thinkInPrompt, Theta θ) { // src: vvaharness/backends/harness/deepagents/options/model_building.py:592
        Boolean resolvedTransport = resolveUseResponsesApi(modelId, provider, useResponsesApi);          // src: vvaharness/backends/harness/deepagents/options/model_building.py:605
        cacheEffort = openaiEffortKwargs(modelId, effort, thinkInPrompt, resolvedTransport == true, θ).get("reasoning_effort"); // src: vvaharness/backends/harness/deepagents/options/model_building.py:606
        key = [ModelKey.of(modelId, env, provider, cacheEffort, resolvedTransport), tlsFingerprint(env), thinkInPrompt, loopToken()]; // src: vvaharness/backends/harness/deepagents/options/model_building.py:610
        cached = MODEL_CACHE.get(key);
        if (cached != null) return cached;                                                               // unlocked steady-state fast path // src: vvaharness/backends/harness/deepagents/options/model_building.py:617
        MODEL_CACHE_LOCK.acquire();                                                                      // serializes misses so concurrent first calls share one build // src: vvaharness/backends/harness/deepagents/options/model_building.py:621
        try {
            cached = MODEL_CACHE.get(key);                                                               // double-checked // src: vvaharness/backends/harness/deepagents/options/model_building.py:622
            if (cached != null) return cached;
            // note: passes the already-resolved transport as the override, not the caller original use_responses_api
            model = buildModel(modelId, env, provider, effort, resolvedTransport, thinkInPrompt, θ);     // src: vvaharness/backends/harness/deepagents/options/model_building.py:625
            MODEL_CACHE.put(key, model);                                                                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:627
            return model;
        } finally {
            MODEL_CACHE_LOCK.release();
        }
    }
}

@executedBy(MODEL) @role(prompt)
class ReasonInPromptPrompt {

    // Appended to the system prompt (graph_builder.py:408) when think_in_prompt && reasonsInPrompt.
    Prompt reasonInPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.reason_in_prompt"]);                                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:364
        p.must(θ["p.model_building.reason_in_writing_before_answer"]);   // "REASONING: think it through in writing before you answer" // src: vvaharness/backends/harness/deepagents/options/model_building.py:365
        p.rule(θ["p.model_building.name_candidate_and_refuting_control"]); // name each candidate and the refuting control; discard what does not hold // src: vvaharness/backends/harness/deepagents/options/model_building.py:366
        p.format(θ["p.model_building.reasoning_compact"]);               // no restating input, no recap       // src: vvaharness/backends/harness/deepagents/options/model_building.py:367
        return p;
    }
}
