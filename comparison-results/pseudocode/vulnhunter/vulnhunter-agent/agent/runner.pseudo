    // _build_scan_retrying: retry only RateLimitError (cold start), fixed waits, 1 + len(backoffs) attempts.
    @src("vulnhunter-agent/agent/runner.py:896")
    Retrying buildScanRetrying(List<Double> backoffs, Theta θ) {
