// src: vvaharness/pipeline/stages/s8/validate.py:176-182
fn annotate_hedges(narrative):executor=code {
  if (!(narrative && _HEDGE_RX matches narrative)) return [narrative, false]
  COUNTERS.bump("s8_chain_narrative_hedged")
  return [trimmed "$narrative\n\n$_HEDGE_NOTE", true]   // unconditional, not gated by chain_quality_checks
}

// src: vvaharness/pipeline/stages/s8/validate.py:188-192
fn hardening_steps(steps, ranked):executor=code {
  return positions i of steps, excluding the terminal step, where ranked[steps[i]].finding.control_absence   // a chain whose outcome is a missing control is legitimate
}

// src: vvaharness/pipeline/stages/s8/validate.py:249-270
fn title_divergence(title, steps, ranked):executor=code {
  // phrases = multi-word VulnClass values; heads = last word of each VulnClass value when single-word or >= 7 characters; OTHER excluded (validate.py:229-246)
  covered = words of each step's vuln_class value, vuln_class_label, title, cwe_name(cwe), and file base name
  for each phrase in sorted multi-word phrases: if (phrase in title && no word of phrase in covered) return phrase
  for each head in sorted heads: if (head in title words && head not in covered) return head
  return ""
}

// src: vvaharness/pipeline/stages/s8/validate.py:273-303
fn quality_annotations(chain, steps, ranked, repo_root, links_ok, resolved, hops, hardening):executor=code {
  // one note per failed check, worst first
  out = []
  if (hardening) { COUNTERS.bump("s8_chain_hardening_step", length(hardening)); append _HARDENING_NOTE(pos=1-based positions) to out }
  if (!links_ok) {
    COUNTERS.bump("s8_chain_link_coverage_short")
    if (links) COUNTERS.bump(if (length(links) != hops) "s8_chain_link_evidence_missing" else "s8_chain_citation_unresolved")
    append _LINK_COVERAGE_NOTE(n=resolved, m=hops) to out
  }
  comment_cites = cited_comment_lines(links, repo_root)
  if (comment_cites) { COUNTERS.bump("s8_chain_cited_line_comment", length(comment_cites)); append _COMMENT_CITATION_NOTE(where=first 3 joined) to out }
  term = title_divergence(chain.title, steps, ranked)
  if (term) { COUNTERS.bump("s8_chain_title_divergence"); append _TITLE_DIVERGENCE_NOTE(term) to out }
  return out
}

// src: vvaharness/pipeline/stages/s8/validate.py:309-312 — the severity gate
fn lift_allowed(links_ok, hardening, hedged):executor=code {
  return links_ok && !hardening && !hedged   // never lowers, only withholds a raise
}

// src: vvaharness/pipeline/stages/s8/validate.py:318-342
fn dedup_chains(chains):executor=code {
  // identical ordered step lists merge; survivor chosen by (SEV_RANK[severity], most link evidence, title), not reply position
  kept = for each distinct tuple(steps): the chain with the smallest _survivor_key, kept in original order
  // chains sharing a terminal step from a different first step are related, never merged
  related = pairs [a, b] of kept positions where kept[a].steps[-1] == kept[b].steps[-1] && kept[a].steps[0] != kept[b].steps[0]
  return [kept, length(chains) - length(kept), related]
}

// src: vvaharness/pipeline/stages/s8/validate.py:348-358
fn unpromoted_links(claims, chains, ranked):executor=code {
  // covered = (location of a, location of b) for every ordered pair a before b in any shipped chain (non-adjacent counts; direction matters)
  return claims [o, t] where location_key(o) != location_key(t) && the location pair is not covered
}
