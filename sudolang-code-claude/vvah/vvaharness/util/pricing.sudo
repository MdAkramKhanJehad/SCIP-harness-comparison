fn _parse_models(data):executor=code {
  // keep a model entry only if its name is a string and both input_per_mtok and output_per_mtok are numbers (booleans rejected); cache rates optional
}
fn _parse_cache_defaults(data):executor=code {
  // table-level cache_rate_defaults { read_fraction, write_multiplier }; if both absent -> built-in fallback (is_fallback=true); if one present, the other takes its fallback value and is_fallback=false
}

// src: vvaharness/util/pricing.py:135-164
fn _table_from_file(path, source):executor=code {
  try data = YAML parse of path as UTF-8;
  catch (read, decode or YAML error) => { warn "ignoring price table"; return null }
  models = _parse_models(data)
  if (models is empty) { warn "no usable model rates ...; costs will be reported as null"; return null }
  defaults = _parse_cache_defaults(data)
  for each model that omits a cache rate, warn NOTE that it is derived from input_per_mtok (marking "built-in fallback" when defaults.is_fallback)
  return PricingTable(models, path, sha256 of file bytes, source, defaults)
}

// src: vvaharness/util/pricing.py:167-183
fn load_pricing(cfg_pricing_file):executor=code {
  // precedence: environment variable VVAHARNESS_PRICING_FILE (non-blank) beats the configuration value
  selected = if (env VVAHARNESS_PRICING_FILE non-blank) (it, "env") else if (cfg_pricing_file) (it, "config") else null
  if (selected == null) return null   // costing unavailable
  return _table_from_file(expand home in selected path, source)
}

