# vvaharness/validation/constants/artifacts.py

Names of the files, directories and environment keys that Stage 11 (validation) uses, plus the default agent runtime values. Only constants; no logic.

Source: `vvaharness/validation/constants/artifacts.py` (lines 1-152)
Executor: code
Called from: almost every module of `vvaharness/validation/`

// src: vvaharness/validation/constants/artifacts.py:24-33
ArtifactNames {
  MANIFEST_FILENAME = "manifest.json"
  DIFF_FILENAME = "diff.patch"   // shares the name with remediation_agent's DIFF_PATCH "by design; deliberately decoupled"
  VALIDATION_REPORT_FILENAME = "validation_report.json"
  SYNTHESIZED_GATES_FILENAME = "synthesized_gates.json"
  APP_DIRNAME = "app"
  REMEDIATION_DIRNAME = "security-remediation"
  FINDING_CASE_FILENAME = "finding_case.json"
  FINDING_CASE_GLOB = "security-remediation/*/finding_case.json"
}

// src: vvaharness/validation/constants/artifacts.py:35-40
// Case states Stage 11 will attempt. DECLINED is added conditionally in ingest/case_loader.sudo (_is_validatable).
VALIDATABLE_STATES = { CaseState.OPEN, CaseState.REMEDIATED, CaseState.FAILED }

// src: vvaharness/validation/constants/artifacts.py:42-44
SCAN_DIRNAME = "security-scan"   // the validator only READS the scan report here
SCAN_REPORT_GLOB = "*_report.sarif"

// src: vvaharness/validation/constants/artifacts.py:46-67
// These names are removed from the staged workspace copy (see ingest/workspace.sudo _IGNORE).
CLAUDE_DIRNAME = ".claude"
AGENT_INSTRUCTION_FILENAMES = ["CLAUDE.md", "CLAUDE.local.md", "AGENTS.md", "GEMINI.md", ".cursorrules"]
// Reason in source: Claude Code auto-loads CLAUDE.md as project memory when setting_sources includes "project",
// so a scanned repository's own instruction file must never reach the staged workspace.
// It does NOT stop Claude Code's ancestor-directory walk; that is why the default workspace root lives outside --repo (cli/__init__.sudo).
MCP_CONFIG_FILENAME = ".mcp.json"   // "defense in depth, not the primary control" (strict_mcp_config is the primary control)
LOGGING_DIRNAME = "logging"; ORCHESTRATOR_LOG_DIRNAME = "orchestrator"; SUBAGENTS_LOG_DIRNAME = "subagents"

// src: vvaharness/validation/constants/artifacts.py:69-86
// preserved: most VVAHARNESS_* names are declared but inert. Only ENV_CLAUDE_BINARY and the two ENV_GHE_* names are read (config/settings/env.sudo).
EnvironmentNames {
  ENV_MODEL = "VVAHARNESS_MODEL"; ENV_EFFORT = "VVAHARNESS_EFFORT"; ENV_MAX_TURNS = "VVAHARNESS_MAX_TURNS"
  ENV_MAX_RETRIES = "VVAHARNESS_MAX_RETRIES"; ENV_VIA = "VVAHARNESS_VIA"; ENV_MODEL_PROVIDER = "VVAHARNESS_MODEL_PROVIDER"
  ENV_MAX_BUDGET_USD = "VVAHARNESS_MAX_BUDGET_USD"; ENV_MAX_FINDINGS = "VVAHARNESS_MAX_FINDINGS"
  ENV_VALIDATE_TOOLS = "VVAHARNESS_VALIDATE_TOOLS"
  ENV_SECURITY_ARCHITECT_MODEL, ENV_PENETRATION_TESTER_MODEL, ENV_CROSS_REPO_ANALYZER_MODEL   // inert
  ENV_CLAUDE_BINARY = "VVAHARNESS_CLAUDE_BINARY"            // read
  ENV_GHE_TOKEN = "VVAHARNESS_GHE_TOKEN"                    // read
  ENV_GHE_ARCHIVED_TOKEN = "VVAHARNESS_GHE_ARCHIVED_TOKEN"  // read
}

