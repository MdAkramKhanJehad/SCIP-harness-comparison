# vvaharness/pipeline/callgraph_consumer.py

Read-only, deterministic helpers that later stages use to consume `ctx.call_graph`. That structure is an entry-point and sink qnode index (file and function membership), not a call graph: it carries no caller-to-callee edges, so the neighborhood view is always empty by construction.

Source: `vvaharness/pipeline/callgraph_consumer.py` (lines 1-150)
Executor: code
Called from: `vvaharness/pipeline/stages/s5/__init__.py` (entry_anchor_lines, seed_paths_by_file), `vvaharness/pipeline/stages/s5/enrich.py` (best_source_from_seed), and the exploit verification mapping modules (graph_view, qnodes_at, neighborhood)

// src: vvaharness/pipeline/callgraph_consumer.py:41-46
fn parse_hop(hop):executor=code {
  // a hop is "file:line"
  [file_part, line_part] = split hop at its last ":"
  if (file_part && line_part is all digits) return [file_part, max(1, Integer(line_part))]
  return [hop, null]
}

// src: vvaharness/pipeline/callgraph_consumer.py:51-62
fn seed_paths_by_file(seed_taint_paths):executor=code {
  out = {}
  for each path in seed_taint_paths {
    for each distinct file touched by any hop in path, out[file] += path
  }
  return out
}

// src: vvaharness/pipeline/callgraph_consumer.py:65-76
fn best_source_from_seed(paths):executor=code {
  for each path in paths where path is non-empty {
    [sf, sl] = parse_hop(path[0])
    if (sf && sl != null) return "$sf:$sl"
    if (path[0]) return path[0]
  }
  return null
}

// src: vvaharness/pipeline/callgraph_consumer.py:79-82
fn entry_anchor_lines(ctx):executor=code {
  return {}   // preserved: always empty; the index carries no def-site line anchors
}

// src: vvaharness/pipeline/callgraph_consumer.py:85-94
fn graph_qnodes_by_file(ctx):executor=code {
  // file is the part of each qnode before the last "::"; per file, unique qnodes in first-seen order
  return map file => ordered unique qnodes of ctx.call_graph in that file
}

// src: vvaharness/pipeline/callgraph_consumer.py:97-105
fn qnodes_at(view, file, line_start, line_end, limit=6):executor=code {
  // line_start and line_end are ignored: file membership is the only resolution signal
  file = file with "\" replaced by "/"
  return first `limit` unique entries of view.file_qnodes[file], or []
}

// src: vvaharness/pipeline/callgraph_consumer.py:108-117
fn neighborhood(view, qnodes, max_edges=8):executor=code {
  return for each qn in qnodes: { callers: first max_edges of view.rev[qn], callees: first max_edges of view.forward[qn] }
  // preserved: view.rev is always {} and the qnode index has no edges, so both lists are empty by construction
}

// src: vvaharness/pipeline/callgraph_consumer.py:120-128
GraphView {
  forward = ctx.call_graph || {}
  file_qnodes = graph_qnodes_by_file(ctx)
  rev = {}
}

// src: vvaharness/pipeline/callgraph_consumer.py:131-150
fn graph_view(ctx):executor=code {
  // memoized per context object; the cache key is id(ctx) validated by a weak reference, so a reused id never returns a stale view
  if (cached entry for id(ctx) && its weak reference still points to ctx) return cached view
  view = GraphView(ctx); cache it; return view
}
