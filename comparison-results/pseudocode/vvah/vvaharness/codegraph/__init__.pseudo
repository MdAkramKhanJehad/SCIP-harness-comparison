// file: vvaharness/codegraph/__init__.py
// The context-graph-sdk boundary: one workspace, one graph, per scan. Facade re-exporting
// build_graph, GraphHandle and the deterministic graph queries. No logic of its own.

@executedBy(CODE) @role(io) @stage("S0")
class Codegraph {

    GraphHandle buildGraph(String repoRoot, String projectId, Path workspaceDir, List<GraphEnricher> enrichers, Theta θ) {
        return Build.buildGraph(repoRoot, projectId, workspaceDir, enrichers, θ);                    // src: vvaharness/codegraph/__init__.py:18
    }

    Map<String, List<String>> communitiesAsModules(GraphHandle handle) {
        return Queries.communitiesAsModules(handle);                                              // src: vvaharness/codegraph/__init__.py:21
    }

    String primaryLanguage(GraphHandle handle) {
        return Queries.primaryLanguage(handle);                                                   // src: vvaharness/codegraph/__init__.py:22
    }

    String systemContextNotes(GraphHandle handle, Theta θ) {
        return Queries.systemContextNotes(handle, θ);                                             // src: vvaharness/codegraph/__init__.py:23
    }

    // graph_is_degenerate, build_graph_tool_builder and GRAPH_TOOL_NAMES are NOT re-exported here:
    // they live in codegraph/build.py (Build.graphIsDegenerate) and codegraph/tools.py.
}
