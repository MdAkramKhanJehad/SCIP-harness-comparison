# vvaharness/remediation_agent/report_augment/markdown.py

Adds a `### Remediation` section under each finding of the Markdown report copy and a report-level `## Remediation Summary`, replacing earlier ones so reruns stay idempotent.

Source: `vvaharness/remediation_agent/report_augment/markdown.py` (lines 1-136)
Executor: code
Called from: `report_augment/__init__.sudo` _augment

// src: vvaharness/remediation_agent/report_augment/markdown.py:34-43
_FINDING_RE = /(?m)^### (\d+)\. \[[^\]]*\]\s*(.+?)\s*$/   // group 1 report ordinal, group 2 title
_EXISTING_REMEDIATION_RE = /(?s)\n+### Remediation\n.*\Z/
_SUMMARY_RE = /(?s)## Remediation Summary\n.*?(?=\n#{1,6} |\Z)/
_LEVEL2_HEADING_RE = /(?m)^## /   // a "## " heading ends a finding segment

// src: vvaharness/remediation_agent/report_augment/markdown.py:108-130
fn _augment_md(path, records, ordinal_matches?):executor=code {
  text = text of path with any earlier "## Remediation Summary" removed
  matches = every finding heading in text
  if (!matches) return   // nothing written
  for each heading m {
    segment = from m to the next finding heading or the first "## " heading after it, whichever is first
    // the SARIF ordinal match wins; then the title match; else a synthetic skipped record
    record = ordinal_matches[m.ordinal] or _best_md_match(m.title, records) or dto._skipped_record()
    replace segment with _augment_segment(segment, record)
  }
  append "\n" + summary._md_summary_section(records)
  write path
}

// src: vvaharness/remediation_agent/report_augment/markdown.py:82-105
fn _best_md_match(title, records):executor=code {
  // fails closed on ambiguity, to avoid attributing one case to another finding (CWE-345)
  norm = lower case of trimmed title; if (!norm) return null
  exact = records whose lower-cased finding title == norm
  if (length(exact) == 1) return exact[0]
  if (length(exact) > 1) { warn "cases share the exact title — refusing to guess; finding rendered as skipped"; return null }
  fuzzy = records whose non-empty title contains norm or is contained in it
  if (length(fuzzy) == 1) return fuzzy[0]
  if (length(fuzzy) > 1) warn "ambiguous title match ... refusing to guess"
  return null
}

// src: vvaharness/remediation_agent/report_augment/markdown.py:133-136
fn _augment_segment(segment, record):executor=code { return segment without a trailing earlier "### Remediation" block, then "\n\n" + _md_remediation_section(record) + "\n" }

// src: vvaharness/remediation_agent/report_augment/markdown.py:46-73
fn _md_remediation_section(record):executor=code {
  summary = newest attempt's summary or record.reason or "n/a"
  approach = match (record.bucket) {
    case "remediated" => "Automated fix applied by the Remediation Agent and written as a unified diff; awaiting validation."
    case "deny" => "Policy gate denied automated patching; guidance-only — a human must remediate."
    default => "No automated patch applied."
  }
  // summary and file names are model-controlled and escaped here (CWE-79)
  return "### Remediation\n- **Status:** <escaped bucket>\n- **Summary:** <escaped summary>\n- **Approach:** $approach\n- **Details of what was remediated:**\n" + (each files_touched entry as a code span, or "  - (no files changed)")
}
