# vvaharness/remediation_agent/artifacts/diff/synth.py

Synthesizes a git-style unified diff from a pre-edit snapshot for targets that are not git repositories.

Source: `vvaharness/remediation_agent/artifacts/diff/synth.py` (lines 1-85)
Executor: code
Called from: `artifacts/diff/derive.sudo` derive_diff; `policy/postgate.sudo` enforce_post

// src: vvaharness/remediation_agent/artifacts/diff/synth.py:30-31
SYNTH_HEADER = "# (synthesized diff — target is not a git repository)\n"   // tells reviewers it is not a true version-control diff

// src: vvaharness/remediation_agent/artifacts/diff/synth.py:34-85
fn synth_unified_diff(repo, before, extra_files?):executor=code {
  // src: synth.py:40-55 — extra_files come from the model: an absolute, ".." or symlink escape must not enter the diff (CWE-22)
  paths = []
  for each ref in keys(before) + extra_files {
    rel = paths._norm_path(ref); if (!rel || already taken) continue
    p = paths._safe_repo_path(repo, ref)
    require p != null => { warn "synth diff: refusing out-of-repo file reference"; continue }
    take rel -> p
  }
  if (no paths) return null

  // src: synth.py:57-85
  chunks = []
  for each rel in paths {
    old = before[rel]   // extra files without a baseline render as newly added
    try new_text = if (p is a file) UTF-8 text of p else ""; catch => continue   // binary or unreadable: skipped
    if ((old or "") == new_text) continue
    from_label = if (old == null) "/dev/null" else "a/$rel"
    to_label = if (new_text != "") "b/$rel" else "/dev/null"
    body = unified diff of the two texts (Python difflib) ending with a newline
    if (body) append "diff --git a/$rel b/$rel\n$body" to chunks
  }
  return if (chunks) SYNTH_HEADER + chunks joined else null   // never raises
}
