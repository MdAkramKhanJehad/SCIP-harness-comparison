// file: vvaharness/validation/prompts/system.md
// S11 orchestrator system prompt: read-only lead that dispatches three adversarial personas in parallel,
// waits for exactly three PersonaReports, and returns one ValidationOutput. Synthesis/Rules sections are appended by the launcher.

@executedBy(MODEL) @role(prompt) @stage("S11")
class PromptsSystem {

    Prompt run(Theta θ) {
        Prompt p = new Prompt();
        p.include(role(θ));
        p.include(inputs(θ));
        p.include(grounding(θ));
        p.include(tools(θ));
        p.include(workflow(θ));
        p.include(output(θ));
        p.include(guardrails(θ));
        return p;
    }

    Prompt role(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.validation_system.persona"]);                                                            // src: vvaharness/validation/prompts/system.md:18
        if (θ["p.validation_system.strictly_read_only"]) p.must("strictly read-only: gather context, dispatch specialist personas"); // src: vvaharness/validation/prompts/system.md:19
        if (θ["p.validation_system.single_structured_verdict"]) p.format("return a single structured verdict");  // src: vvaharness/validation/prompts/system.md:20
        if (θ["p.validation_system.accuracy_over_speed"]) p.rule("Accuracy is the top priority; take the time needed to build complete context before judging"); // src: vvaharness/validation/prompts/system.md:20
        return p;
    }

    Prompt inputs(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.validation_system.patch_already_applied"]) p.context("remediation patch is already applied to the workspace tree"); // src: vvaharness/validation/prompts/system.md:25
        if (θ["p.validation_system.no_git"]) p.forbid("git: no history, no clean base, no release branch; git neither available nor permitted"); // src: vvaharness/validation/prompts/system.md:27
        if (θ["p.validation_system.diff_authoritative_read_first"]) p.must("diff.patch is the authoritative record of what changed; read it first"); // src: vvaharness/validation/prompts/system.md:29
        if (θ["p.validation_system.read_patched_tree_freely"]) p.rule("read the full patched codebase freely for cross-file context"); // src: vvaharness/validation/prompts/system.md:31
        if (θ["p.validation_system.manifest_finding_preparsed"]) p.context("manifest.json: the finding, pre-parsed into manifest.finding"); // src: vvaharness/validation/prompts/system.md:32
        if (θ["p.validation_system.no_jira_tools_in_sandbox"]) p.context("no JIRA tools in this sandbox; the host posts results"); // src: vvaharness/validation/prompts/system.md:33
        p.context(θ["p.validation_system.sidecar_contents"]);                                                   // src: vvaharness/validation/prompts/system.md:35
        if (θ["p.validation_system.sidecar_reconstruct_history"]) p.rule("use the sidecar to reconstruct remediation history and the pre-remediation base"); // src: vvaharness/validation/prompts/system.md:37
        if (θ["p.validation_system.remediator_verdict_unverified_claim"]) p.must("remediator verdict and gate-passes are an unverified claim to independently confirm or refute"); // src: vvaharness/validation/prompts/system.md:38
        if (θ["p.validation_system.remediator_verdict_never_evidence"]) p.forbid("treat the remediator verdict as evidence"); // src: vvaharness/validation/prompts/system.md:39
        if (θ["p.validation_system.remediator_prose_is_context"]) p.rule("root_cause/remaining_risks prose is useful context"); // src: vvaharness/validation/prompts/system.md:40
        if (θ["p.validation_system.rules_before_dispatch"]) p.must("take in the validation rules before dispatching personas"); // src: vvaharness/validation/prompts/system.md:43
        return p;
    }

    Prompt grounding(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.validation_system.path_grounding_diff_canonical"]) p.rule("the diff (a/ b/ stripped) is the canonical source of file paths"); // src: vvaharness/validation/prompts/system.md:47
        if (θ["p.validation_system.finding_file_hint_only"]) p.rule("manifest.finding.file is a hint only, resolved by suffix-matching against diff paths and the tree"); // src: vvaharness/validation/prompts/system.md:48
        if (θ["p.validation_system.line_numbers_advisory"]) p.rule("line numbers are advisory only (pre-remediation)"); // src: vvaharness/validation/prompts/system.md:50
        if (θ["p.validation_system.navigate_by_hunk_and_symbol"]) p.rule("navigate by hunk content and symbol names, never by absolute line number"); // src: vvaharness/validation/prompts/system.md:51
        return p;
    }

    Prompt tools(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.validation_system.orchestrator_tools"]);                                                 // src: vvaharness/validation/prompts/system.md:56
        p.forbid(θ["p.validation_system.orchestrator_denied_tools"]);                                           // src: vvaharness/validation/prompts/system.md:57
        if (θ["p.validation_system.never_write_files"]) p.forbid("create, edit, or write files");                // src: vvaharness/validation/prompts/system.md:58
        if (θ["p.validation_system.verdict_only_via_validation_output"]) p.format("verdict leaves only as the final structured ValidationOutput response"); // src: vvaharness/validation/prompts/system.md:59
        return p;
    }

    Prompt workflow(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.validation_system.step1_minimal_context"]);                                              // src: vvaharness/validation/prompts/system.md:65
        if (θ["p.validation_system.no_deep_exploration_by_orchestrator"]) p.forbid("deep code exploration yourself; that is the personas' job"); // src: vvaharness/validation/prompts/system.md:66
        p.step(2, θ["p.validation_system.spawn_three_personas"]);                                               // src: vvaharness/validation/prompts/system.md:69
        if (θ["p.validation_system.spawn_in_single_message_parallel"]) p.must("spawn in a SINGLE message using parallel task() calls"); // src: vvaharness/validation/prompts/system.md:70
        if (θ["p.validation_system.spawn_mandatory_every_finding"]) p.must("MANDATORY: spawn all three on every finding regardless of repo count, finding type or relevance"); // src: vvaharness/validation/prompts/system.md:71
        if (θ["p.validation_system.no_sequential_no_pre_exploration"]) p.forbid("spawn sequentially or explore further first"); // src: vvaharness/validation/prompts/system.md:72
        if (θ["p.validation_system.personas_independent_readonly"]) p.context("each persona is an independent adversarial reviewer with full read-only workspace access"); // src: vvaharness/validation/prompts/system.md:74
        if (θ["p.validation_system.persona_returns_persona_report"]) p.format("each persona returns a structured PersonaReport"); // src: vvaharness/validation/prompts/system.md:75
        if (θ["p.validation_system.inapplicable_lens_returns_skip"]) p.rule("a persona with nothing applicable still returns skip on inapplicable gates; it is not omitted"); // src: vvaharness/validation/prompts/system.md:76
        if (θ["p.validation_system.task_desc_role_and_tracking_id"]) p.checklist("task: persona role and tracking_id"); // src: vvaharness/validation/prompts/system.md:80
        if (θ["p.validation_system.task_desc_finding_summary"]) p.checklist("task: concise summary copied from manifest.finding"); // src: vvaharness/validation/prompts/system.md:81
        if (θ["p.validation_system.task_desc_full_diff"]) p.checklist("task: the full diff.patch content");       // src: vvaharness/validation/prompts/system.md:82
        if (θ["p.validation_system.task_desc_gate_names"]) p.checklist("task: the relevant gate names from the scoring matrix"); // src: vvaharness/validation/prompts/system.md:83
        if (θ["p.validation_system.task_desc_evidence_instruction"]) p.checklist("task: gather evidence with granted tools and return a PersonaReport"); // src: vvaharness/validation/prompts/system.md:84
        p.context(θ["p.validation_system.base_tools_always_available"]);                                        // src: vvaharness/validation/prompts/system.md:85
        p.rule(θ["p.validation_system.fact_tools_only_when_granted"]);                                          // src: vvaharness/validation/prompts/system.md:86
        if (θ["p.validation_system.do_not_prejudge_for_personas"]) p.forbid("tell personas whether files are covered or paths are safe"); // src: vvaharness/validation/prompts/system.md:89
        p.persona(θ["p.validation_system.architect_stance"]);                                                   // src: vvaharness/validation/prompts/system.md:95
        p.persona(θ["p.validation_system.pentester_stance"]);                                                   // src: vvaharness/validation/prompts/system.md:96
        if (θ["p.validation_system.cross_repo_always_spawn"]) p.must("ALWAYS spawn cross-repo-analyzer regardless of repo count"); // src: vvaharness/validation/prompts/system.md:98
        p.threshold(θ["p.validation_system.cross_repo_all_four_gates"]);                                        // src: vvaharness/validation/prompts/system.md:100
        p.step(3, θ["p.validation_system.confirm_exactly_three_reports"]);                                      // src: vvaharness/validation/prompts/system.md:103
        if (θ["p.validation_system.respawn_missing_persona"]) p.must("if any report is missing, spawn it now; do not finish with fewer than 3"); // src: vvaharness/validation/prompts/system.md:104
        if (θ["p.validation_system.verdict_after_all_personas"]) p.step(4, "after ALL personas returned, produce a single ValidationOutput"); // src: vvaharness/validation/prompts/system.md:108
        if (θ["p.validation_system.no_tool_calls_after_verdict"]) p.forbid("write/create/edit files or make further tool calls"); // src: vvaharness/validation/prompts/system.md:110
        return p;
    }

    @executedBy(MODEL)
    ValidationOutput procedure(Workspace ws, Theta θ) {
        Context ctx = read(θ["p.validation_system.step1_minimal_context"]);                                     // src: vvaharness/validation/prompts/system.md:65
        List<String> personas = List.of("security-architect", "penetration-tester", "cross-repo-analyzer");     // src: vvaharness/validation/prompts/system.md:94
        // One message, parallel task() calls, every finding.
        List<PersonaReport> reports = Runtime.parallel(θ["p.validation_system.spawn_three_personas"], personas, name -> Runtime.subagent(personaPrompt(name), taskDescription(ctx))); // src: vvaharness/validation/prompts/system.md:70
        while (reports.size() < θ["p.validation_system.confirm_exactly_three_reports"]) {                       // src: vvaharness/validation/prompts/system.md:103
            String missing = personas.minus(reports.map(r -> r.persona)).first();
            reports.add(Runtime.subagent(personaPrompt(missing), taskDescription(ctx)));                        // src: vvaharness/validation/prompts/system.md:104
        }
        return new ValidationOutput(reports);                                                                   // src: vvaharness/validation/prompts/system.md:108
    }

    Prompt output(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.validation_system.output_shape"]);                                                        // src: vvaharness/validation/prompts/system.md:116
        p.format(θ["p.validation_system.finding_report_fields"]);                                               // src: vvaharness/validation/prompts/system.md:122
        p.format(θ["p.validation_system.justification_length"]);                                               // src: vvaharness/validation/prompts/system.md:129
        p.choose(θ["p.validation_system.gate_score_statuses_in_output"]);                                       // src: vvaharness/validation/prompts/system.md:131
        p.format(θ["p.validation_system.canonical_gate_names"]);                                                // src: vvaharness/validation/prompts/system.md:141
        p.format(θ["p.validation_system.raw_score_range"]);                                                     // src: vvaharness/validation/prompts/system.md:143
        p.format(θ["p.validation_system.recommendations_count"]);                                               // src: vvaharness/validation/prompts/system.md:144
        if (θ["p.validation_system.recommendations_not_semicolon_joined"]) p.forbid("semicolon-join recommendations into a single string"); // src: vvaharness/validation/prompts/system.md:145
        if (θ["p.validation_system.label_values_recommended_not_enforced"]) p.context("severity, fix_status, merge_readiness values shown are recommended, not enforced"); // src: vvaharness/validation/prompts/system.md:146
        if (θ["p.validation_system.target_jira_status_observability_only"]) p.context("target_jira_status is observability only; host derives transition from fix_status"); // src: vvaharness/validation/prompts/system.md:148
        return p;
    }

    Prompt guardrails(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.validation_system.never_echo_plaintext_secrets"]) p.forbid("plaintext secrets in finding_description, justification or recommendations"); // src: vvaharness/validation/prompts/system.md:153
        if (θ["p.validation_system.secret_refer_by_location"]) p.rule("refer to secrets by location");          // src: vvaharness/validation/prompts/system.md:153
        p.format(θ["p.validation_system.secret_redaction_first2_last2"]);                                       // src: vvaharness/validation/prompts/system.md:153
        if (θ["p.validation_system.no_amplify_disclosed_secret"]) p.rule("applies even when the secret was already disclosed in the finding"); // src: vvaharness/validation/prompts/system.md:153
        if (θ["p.validation_system.describe_secret_search_abstractly"]) p.rule("describe secret searches abstractly, never quoting the search term"); // src: vvaharness/validation/prompts/system.md:153
        if (θ["p.validation_system.no_jira_calls"]) p.forbid("JIRA calls; the host posts results after you exit"); // src: vvaharness/validation/prompts/system.md:154
        return p;
    }
}
