// file: vvaharness/orchestrator/enrich_findings.py
// Post-S7 enrichment: optional path prefixing (batch/monorepo), canonical CWE, vector-derived CVSS score and rating,
// CMDB-context VulContextSeverity score, and the offensive priority each verified finding carries into S8.

@executedBy(CODE) @role(step) @stage("S7")
class EnrichFindings {

    String prefixPath(String path, String prefix) {
        if (path == null || path.isEmpty() || path.startsWith(prefix + "/")) return path;             // src: vvaharness/orchestrator/enrich_findings.py:26
        return prefix + "/" + path;                                                                    // src: vvaharness/orchestrator/enrich_findings.py:28
    }

    /** source_ref / sink_ref are file:line; prefix only the file part. */
    String prefixRef(String ref, String prefix) {
        if (ref == null || ref.isEmpty()) return ref;                                                  // src: vvaharness/orchestrator/enrich_findings.py:33
        Triple parts = ref.partition(":");                                                             // src: vvaharness/orchestrator/enrich_findings.py:35
        return prefixPath(parts.first, prefix) + parts.second + parts.third;                           // src: vvaharness/orchestrator/enrich_findings.py:36
    }

    /** _enrich_findings: in place on the verified findings. */
    void enrich(List<Finding> findings, AppInfo appInfo, String pathPrefix) {
        for (Finding f : findings) {
            if (pathPrefix != null && !pathPrefix.isEmpty()) {                                         // src: vvaharness/orchestrator/enrich_findings.py:43
                f.file = prefixPath(f.file, pathPrefix);                                               // src: vvaharness/orchestrator/enrich_findings.py:44
                f.sourceRef = prefixRef(f.sourceRef, pathPrefix);                                      // src: vvaharness/orchestrator/enrich_findings.py:45
                f.sinkRef = prefixRef(f.sinkRef, pathPrefix);                                          // src: vvaharness/orchestrator/enrich_findings.py:47
                for (Duplicate d : f.duplicates) {                                                     // src: vvaharness/orchestrator/enrich_findings.py:49
                    d.file = prefixPath(d.file, pathPrefix);                                           // src: vvaharness/orchestrator/enrich_findings.py:50
                    d.sourceRef = prefixRef(d.sourceRef, pathPrefix); d.sinkRef = prefixRef(d.sinkRef, pathPrefix); // src: vvaharness/orchestrator/enrich_findings.py:51
                }
            }
            f.cwe = RulesCwe.normCwe(f.cwe);                                                           // canonical CWE // src: vvaharness/orchestrator/enrich_findings.py:54
            if (f.cvssVector != null && !f.cvssVector.isEmpty()) {                                     // the vector wins over any model-stated score // src: vvaharness/orchestrator/enrich_findings.py:55
                double score = Cvss.scoreOrSentinel(f.cvssVector);                                     // src: vvaharness/orchestrator/enrich_findings.py:56
                if (score >= 0) { f.cvssScore = score; f.cvssRating = Cvss.rating(score); }            // src: vvaharness/orchestrator/enrich_findings.py:57
            }
            if (f.cvssVector != null && !f.cvssVector.isEmpty() && appInfo != null) {                  // src: vvaharness/orchestrator/enrich_findings.py:60
                VsvsResult vr = Appcontext.vsvsScore(f.cvssVector, appInfo);                           // src: vvaharness/orchestrator/enrich_findings.py:61
                if (vr != null) { f.vsvsVector = vr.vector; f.vsvsScore = vr.score; f.vsvsRating = vr.rating; } // src: vvaharness/orchestrator/enrich_findings.py:62
            }
            Pair<String, String> op = Appcontext.offensivePriorityFor(f.title, f.vulnClass.value, f.description, f.cvssVector, appInfo); // src: vvaharness/orchestrator/enrich_findings.py:66
            f.offensivePriority = op.first; f.offensiveReason = op.second;                             // src: vvaharness/orchestrator/enrich_findings.py:66
        }
    }
}
