// file: harness/local_harness/benchmark/ground_truth/EXAMPLE.json
// Ground-truth file shape for the benchmark: a JSON array of findings. This shipped example is synthetic
// (three OWASP demo apps with placeholder commits); the judge compares each finding against a scan report.

@executedBy(CODE) @role(types) @stage("benchmark")
record GroundTruthFinding(String finding_id, String type, String source_code, String description) { }

@executedBy(CODE) @role(evaluation) @stage("benchmark")
class Example {

    List<GroundTruthFinding> findings() {
        // source_code must be https://github.com/<org>/<repo>/tree/<commit>; commit must be 7-40 hex chars
        return List.of(
            new GroundTruthFinding("VULN-001", "NoSQLInjection", "https://github.com/OWASP/NodeGoat/tree/<commit>", "user param passed unsanitized into a MongoDB query (operator injection)"), // src: harness/local_harness/benchmark/ground_truth/EXAMPLE.json:3
            new GroundTruthFinding("VULN-002", "SQLInjection", "https://github.com/juice-shop/juice-shop/tree/<commit>", "login email concatenated into SQL (auth bypass)"), // src: harness/local_harness/benchmark/ground_truth/EXAMPLE.json:9
            new GroundTruthFinding("VULN-003", "PathTraversal", "https://github.com/WebGoat/WebGoat/tree/<commit>", "user filename joined to base dir without canonicalization")); // src: harness/local_harness/benchmark/ground_truth/EXAMPLE.json:15
    }

    boolean judgedDetected(GroundTruthFinding f, String scanReport, Theta θ) {
        // the only score computed from these rows is detection rate (recall) per type and overall
        return BenchmarkJudge.judgeFindingsBatch(scanReport, List.of(f), θ["harness.MODEL"], θ).first().detected; // judge rule: θ["harness.judge_match_rule"]
    }
}
