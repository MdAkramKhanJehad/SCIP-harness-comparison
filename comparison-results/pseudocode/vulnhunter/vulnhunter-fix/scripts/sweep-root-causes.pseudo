// file: vulnhunter-fix/scripts/sweep-root-causes.py
// Root-cause sweep (REQ-SWP-001..009): for each verified finding, Pass 1 finds graph callers of the sink not routed
// through the fix, Pass 2 regex-scans the repo with the CWE class's sweep patterns; unmitigated siblings revise
// the tier to MITIGATION. A missing graph makes the sweep incomplete (exit 3).

@executedBy(CODE) @role(evaluation) @stage("fix")
class SweepRootCauses {

    // sweep.pseudo calls run(repoRoot, resultsDir, graph, patterns, triageDir, out, ...)
    Map run(String repoRoot, String resultsDir, String graph, String patterns, String triageDir, String out, Theta θ) {
        Map result = sweep(new Args(repoRoot, resultsDir, graph, patterns, triageDir), θ);                 // src: vulnhunter-fix/scripts/sweep-root-causes.py:357
        Files.write(out, Json.dump(result));                                                               // src: vulnhunter-fix/scripts/sweep-root-causes.py:358
        return result;
    }

    String cweClass(String cwe, Theta θ) {
        Integer n = cweInt(cwe);
        // unparseable CWE -> config; a parseable CWE not in the routing table -> no class (no Pass-2 patterns)
        if (n == null) return "config";                                                                    // src: vulnhunter-fix/scripts/sweep-root-causes.py:278
        if (θ["p.worker_agent_common.cwe_class_routing_authz"].contains("CWE-" + n)) return "authz";       // src: vulnhunter-fix/scripts/sweep-root-causes.py:35
        if (θ["p.worker_agent_common.cwe_class_routing_injection"].contains("CWE-" + n)) return "injection"; // src: vulnhunter-fix/scripts/sweep-root-causes.py:37
        if (θ["p.worker_agent_common.cwe_class_routing_crypto"].contains("CWE-" + n)) return "crypto";     // src: vulnhunter-fix/scripts/sweep-root-causes.py:40
        if (θ["p.worker_agent_common.cwe_class_routing_resource"].contains("CWE-" + n)) return "resource"; // src: vulnhunter-fix/scripts/sweep-root-causes.py:42
        return null;                                                                                       // src: vulnhunter-fix/scripts/sweep-root-causes.py:278
    }

    Integer cweInt(String cwe) {
        Match m = Regex.match("CWE-(\\d+)$", cwe);                                                         // src: vulnhunter-fix/scripts/sweep-root-causes.py:48
        return m != null ? Integer.parse(m.group(1)) : null;
    }

    String unquote(String val) {
        if (val.length() >= 2 && val.first() == val.last() && (val.first() == '"' || val.first() == '\'')) return val.substring(1, val.length() - 1); // src: vulnhunter-fix/scripts/sweep-root-causes.py:53
        return val;
    }

    String stripInlineComment(String val) {
        Match m = Regex.search("\\s<2+>#\\s", val);                                                        // src: vulnhunter-fix/scripts/sweep-root-causes.py:67
        return m != null ? val.substring(0, m.start()).rstrip() : val;
    }

    Map<String, List<String>> loadPatterns(Path path) {
        // fenced blocks in references/sweep-patterns.md: class:, cwes:, patterns: - '<regex>'
        Map<String, List<String>> result = Map.of();
        boolean inFence = false;
        String currentClass = null;
        boolean inPatterns = false;
        for (String raw : Files.read(path).lines()) {
            if (raw.strip().startsWith("```")) {                                                           // src: vulnhunter-fix/scripts/sweep-root-causes.py:88
                inFence = !inFence;
                if (!inFence) {
                    currentClass = null;
                    inPatterns = false;
                }
                continue;
            }
            if (!inFence) continue;
            String s = raw.strip();
            if (s.startsWith("class:")) {                                                                  // src: vulnhunter-fix/scripts/sweep-root-causes.py:97
                currentClass = s.after(":").strip();
                result.putIfAbsent(currentClass, List.of());
                inPatterns = false;
                continue;
            }
            if (s == "patterns:") {                                                                        // src: vulnhunter-fix/scripts/sweep-root-causes.py:102
                inPatterns = true;
                continue;
            }
            if (inPatterns && s.startsWith("- ")) {
                String val = unquote(stripInlineComment(s.substring(2).strip()));                          // src: vulnhunter-fix/scripts/sweep-root-causes.py:106
                if (!val.isEmpty() && currentClass != null) result.get(currentClass).add(val);
            }
        }
        return result;
    }

    Map loadGraph(Path path) {
        if (!path.isFile()) return null;                                                                   // src: vulnhunter-fix/scripts/sweep-root-causes.py:113
        try {
            return Json.parse(Files.read(path));
        } catch (OSError | JSONDecodeError e) {
            return null;                                                                                   // src: vulnhunter-fix/scripts/sweep-root-causes.py:118
        }
    }

    List<Map> loadResults(Path resultsDir, Theta θ) {
        List<Map> findings = List.of();
        if (!resultsDir.isDir()) return findings;                                                          // src: vulnhunter-fix/scripts/sweep-root-causes.py:123
        for (Path p : resultsDir.glob("*_result.json")) {
            Map data;
            try {
                data = Json.parse(Files.read(p));                                                          // src: vulnhunter-fix/scripts/sweep-root-causes.py:127
            } catch (OSError | JSONDecodeError e) {
                continue;
            }
            // only verified results are swept
            if (data.isMap() && θ["code.fix.scripts.sweep_root_causes.swept_statuses"].contains(data.get("status"))) findings.add(data); // src: vulnhunter-fix/scripts/sweep-root-causes.py:130
        }
        return findings;
    }

    Map loadTriageSidecar(Path triageDir, String vulnId) {
        if (triageDir == null || vulnId.isEmpty()) return Map.of();                                        // src: vulnhunter-fix/scripts/sweep-root-causes.py:144
        Path path = triageDir.join(vulnId + ".json");
        if (!path.isFile()) return Map.of();                                                               // src: vulnhunter-fix/scripts/sweep-root-causes.py:147
        try {
            Object data = Json.parse(Files.read(path));
            return data.isMap() ? data : Map.of();                                                         // src: vulnhunter-fix/scripts/sweep-root-causes.py:153
        } catch (OSError | JSONDecodeError e) {
            return Map.of();
        }
    }

    List<String> pass1Symbol(Map graph, String sinkSymbol, List<String> routed, Path repoRoot, Theta θ) {
        if (graph.isEmpty() || sinkSymbol.isEmpty()) return List.of();                                     // src: vulnhunter-fix/scripts/sweep-root-causes.py:166
        Set<String> routedSet = routed.toSet();
        if (graph.get("backend") == "grep") {
            // grep graphs have no call edges: delegate to the grep caller fallback
            if (repoRoot == null) return List.of();                                                        // src: vulnhunter-fix/scripts/sweep-root-causes.py:170
            String bare = sinkSymbol.afterLast(":");
            return Fallback.grepCallersOf(repoRoot, bare, θ).filter(c -> c != null && !routedSet.contains(c)).toSet().sorted(); // src: vulnhunter-fix/scripts/sweep-root-causes.py:177
        }
        // AST path: in-edges of kind "calls" into nodes matching the sink
        List<String> sinks = graph.nodes.keysWhere(n -> n.qualified_name == sinkSymbol || n.name == sinkSymbol.afterLast(":")); // src: vulnhunter-fix/scripts/sweep-root-causes.py:181
        if (sinks.isEmpty()) return List.of();                                                             // src: vulnhunter-fix/scripts/sweep-root-causes.py:183
        List<String> siblings = List.of();
        for (Map e : graph.getOr("edges", List.of())) {
            String dst = e.getOr("to", e.get("dst"));
            if (sinks.contains(dst) && e.get("kind") == "calls") {                                         // src: vulnhunter-fix/scripts/sweep-root-causes.py:188
                Map srcNode = graph.nodes.get(e.getOr("from", e.get("src")));
                if (srcNode != null) {
                    String ptr = srcNode.file + ":" + srcNode.name;                                        // src: vulnhunter-fix/scripts/sweep-root-causes.py:192
                    if (!routedSet.contains(ptr)) siblings.add(ptr);
                }
            }
        }
        return siblings.toSet().sorted();
    }

    String sweepOk(int found, int remaining) {
        // verification-table column 8 (REQ-GRA-013)
        if (found == 0) return "yes (n/a)";                                                                // src: vulnhunter-fix/scripts/sweep-root-causes.py:205
        return remaining == 0 ? "yes" : "no";                                                              // src: vulnhunter-fix/scripts/sweep-root-causes.py:207
    }

    List<Triple> pass2Pattern(Path repoRoot, List<String> patterns, Set<String> excludeFiles, Theta θ) {
        List<Triple> hits = List.of();
        for (Path path : GraphConfig.safeWalkFiles(repoRoot, θ["code.fix.scripts.sweep_root_causes.excluded_dirs"], θ)) { // src: vulnhunter-fix/scripts/sweep-root-causes.py:231
            if (!θ["code.fix.scripts.sweep_root_causes.scanned_suffixes"].contains(path.suffix())) continue; // src: vulnhunter-fix/scripts/sweep-root-causes.py:233
            String rel = path.relativeTo(repoRoot);
            if (excludeFiles.contains(rel)) continue;                                                      // src: vulnhunter-fix/scripts/sweep-root-causes.py:241
            // oversized (generated / minified / vendored) files are skipped
            if (path.size() > θ["code.fix.scripts.sweep_root_causes.max_file_bytes"]) continue;            // src: vulnhunter-fix/scripts/sweep-root-causes.py:244
            String text = Files.readReplacingErrors(path);
            for (String pat : patterns) {
                try {
                    for (Match m : Regex.finditer(pat, text)) hits.add(Triple.of(rel, text.lineOf(m.start()), pat)); // src: vulnhunter-fix/scripts/sweep-root-causes.py:254
                } catch (RegexError e) {
                    continue;                                                                              // src: vulnhunter-fix/scripts/sweep-root-causes.py:258
                }
            }
        }
        return hits;
    }

    Map sweep(Args args, Theta θ) {
        Path repoRoot = Path.resolve(args.repoRoot);
        Map graph = loadGraph(new Path(args.graph));                                                       // src: vulnhunter-fix/scripts/sweep-root-causes.py:264
        // no graph -> pass-1 impossible -> sweep incomplete (fail closed, not regex-only)
        boolean graphOk = graph != null;                                                                   // src: vulnhunter-fix/scripts/sweep-root-causes.py:268
        Map<String, List<String>> patternsByClass = loadPatterns(new Path(args.patterns));                 // src: vulnhunter-fix/scripts/sweep-root-causes.py:269
        List<Map> findings = loadResults(new Path(args.resultsDir), θ);                                    // src: vulnhunter-fix/scripts/sweep-root-causes.py:270
        Path triageDir = args.triageDir != null ? new Path(args.triageDir) : null;
        boolean fallbackOnly = graph != null && graph.get("backend") == "grep";                            // src: vulnhunter-fix/scripts/sweep-root-causes.py:273
        List<Map> rows = List.of();
        for (Map f : findings) {
            String cls = cweClass(f.getOr("cwe", ""), θ);                                                  // src: vulnhunter-fix/scripts/sweep-root-causes.py:278
            // sink: triage sidecar, then result, then a never-matching file:cwe placeholder
            Map triage = loadTriageSidecar(triageDir, f.getOr("vuln_id", ""));                             // src: vulnhunter-fix/scripts/sweep-root-causes.py:283
            String sink = triage.getOr("sink_symbol", f.getOr("sink_symbol", f.file_path + ":" + f.cwe));  // src: vulnhunter-fix/scripts/sweep-root-causes.py:284
            List<String> routed = f.getOr("callers_routed_through_fix", List.of());                        // src: vulnhunter-fix/scripts/sweep-root-causes.py:289
            Set<String> filesModified = f.getOr("files_modified", List.of()).toSet();
            // Pass 1 always runs (AST or grep backend)
            List<String> pass1 = pass1Symbol(graph != null ? graph : Map.of(), sink, routed, repoRoot, θ);  // src: vulnhunter-fix/scripts/sweep-root-causes.py:296
            Set<String> pass1Files = pass1.map(s -> s.before(":")).toSet();
            List<Triple> pass2 = pass2Pattern(repoRoot, patternsByClass.getOr(cls, List.of()), pass1Files, θ); // src: vulnhunter-fix/scripts/sweep-root-causes.py:300
            int found = pass1.size() + pass2.size();                                                       // src: vulnhunter-fix/scripts/sweep-root-causes.py:302
            // Path A: sibling in a file this fix already modifies counts as mitigated; Path B remains
            int mitigated = pass1.count(s -> filesModified.contains(s.before(":"))) + pass2.count(h -> filesModified.contains(h.first)); // src: vulnhunter-fix/scripts/sweep-root-causes.py:308
            int remaining = found - mitigated;                                                             // src: vulnhunter-fix/scripts/sweep-root-causes.py:312
            boolean revised = remaining > 0;                                                               // src: vulnhunter-fix/scripts/sweep-root-causes.py:313
            rows.add(Map.of("root_cause", f.vuln_id, "cwe", f.cwe, "cwe_class", cls, "pattern", fallbackOnly ? "regex-only" : "graph+regex", "found", found, "captured", found, "pass1_siblings", pass1, "pass2_hits", pass2, "mitigated", mitigated, "remaining", remaining, "sweep_revised", revised, "revised_tier", revised ? "MITIGATION" : null, "sweep_ok", sweepOk(found, remaining))); // src: vulnhunter-fix/scripts/sweep-root-causes.py:315
        }
        return Map.of("generated_by", "sweep-root-causes.py", "fallback_only", fallbackOnly, "graph_ok", graphOk, "sweep_incomplete", !graphOk, "rows", rows); // src: vulnhunter-fix/scripts/sweep-root-causes.py:337
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                       // src: vulnhunter-fix/scripts/sweep-root-causes.py:347
        Map result = sweep(args, θ);                                                                       // src: vulnhunter-fix/scripts/sweep-root-causes.py:357
        Files.write(args.out, Json.dump(result));                                                          // src: vulnhunter-fix/scripts/sweep-root-causes.py:358
        if (result.get("sweep_incomplete")) return 3;                                                      // src: vulnhunter-fix/scripts/sweep-root-causes.py:361
        return 0;                                                                                          // src: vulnhunter-fix/scripts/sweep-root-causes.py:370
    }
}
