// file: vulnhunter-agent/agent/manifest.py
// Producer-side writer for <results_dir>/scan_manifest.json: findings, session cost and issues-stage
// outcomes, validated against scan_manifest.schema.json and committed atomically.

@executedBy(CODE) @role(io) @stage("agent")
class Manifest {

    // write_manifest: skip on the no-manifest exit codes, validate, then tmp-write + os.replace.
    void writeManifest(Path resultsDir, String scanId, int agentExitCode, SessionTotals totals, List<Finding> findings, PostSummary postSummary) {
        if (θ["code.agent.manifest.no_manifest_exit_codes"].contains(agentExitCode)) return;     // src: vulnhunter-agent/agent/manifest.py:76
        ScanManifest manifest = new ScanManifest("1", scanId, agentExitCode, totals.costUsd,
                findings.map(f -> asdict(f)), postSummary.posted.map(p -> asdict(p)),
                postSummary.skipped.map(s -> asdict(s)), postSummary.failed.map(f -> asdict(f))); // src: vulnhunter-agent/agent/manifest.py:79
        Map schema = loadSchema();                                                                // src: vulnhunter-agent/agent/manifest.py:90
        List<Error> errors = Draft202012Validator(schema).iterErrors(manifest).sortedBy(e -> e.path); // src: vulnhunter-agent/agent/manifest.py:92
        if (!errors.isEmpty()) {                                                                  // src: vulnhunter-agent/agent/manifest.py:93
            stderr("MANIFEST_VALIDATION_FAILURE: " + join(errors));                               // src: vulnhunter-agent/agent/manifest.py:95
            throw new ValidationError("scan_manifest is not valid");                              // src: vulnhunter-agent/agent/manifest.py:100
        }
        Path finalPath = resultsDir.resolve("scan_manifest.json");                                // src: vulnhunter-agent/agent/manifest.py:102
        Path tmpPath = resultsDir.resolve("scan_manifest.json.tmp");                              // src: vulnhunter-agent/agent/manifest.py:103
        tmpPath.writeText(json.dumps(manifest, 2, true));                                         // src: vulnhunter-agent/agent/manifest.py:104
        os.replace(tmpPath, finalPath);                                                           // src: vulnhunter-agent/agent/manifest.py:105
    }

    // _load_schema: scan_manifest.schema.json at the repo root (parent of agent/).
    Map loadSchema() {
        Path schemaPath = moduleDir().parent.resolve("scan_manifest.schema.json");                // src: vulnhunter-agent/agent/manifest.py:115
        return json.loads(schemaPath.readText());                                                 // src: vulnhunter-agent/agent/manifest.py:116
    }
}

@executedBy(CODE) @role(types)
record ScanManifest(String schemaVersion, String scanId, int agentExitCode, double costUsd,
                    List<Map> findings, List<Map> posted, List<Map> skipped, List<Map> failed) { }
