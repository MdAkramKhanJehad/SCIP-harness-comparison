    }
    boolean cacheMarkers(Theta θ) {
        return θ["sdk.cache_markers"] == "on";                          // dataclass default True        // src: vvaharness/backends/harness/models.py:217
    }
    boolean forceVerdictOnly(Theta θ) {
        return θ["code.backends.harness.models.force_verdict_only_default"]; // false: force outcome tool every call // src: vvaharness/backends/harness/models.py:221
    }
    int oneShotMaxTurns(Theta θ) {
        return θ["code.backends.harness.models.oneshot_max_turns"];     // 15                             // src: vvaharness/backends/harness/models.py:228
    }
    boolean allowShell(Theta θ) {
        return θ["code.backends.harness.models.allow_shell_default"];   // false                          // src: vvaharness/backends/harness/models.py:244
    }
}

// OneShotOptions extends SessionOptions: maxTurns = 15, outputSchema = null, cachePrefix = null.
@executedBy(CODE) @role(types)
record OneShotOptions(SessionOptions base, int maxTurns, Map<String, Object> outputSchema, String cachePrefix) { }

// StreamingOptions extends SessionOptions: maxTurns = null, maxBudgetUsd = null, timeout = null (unbounded),
// allowShell = false, settingSources = null, permissions = null, agents = {}, outputSchema = null,
// permittedToolCalls = null (null installs NO PermitTools gate), cachePrefix = null (4th, last Anthropic breakpoint),
// sessionId = "" (fresh random thread, unresumable).
@executedBy(CODE) @role(types)
record StreamingOptions(SessionOptions base, Integer maxTurns, Double maxBudgetUsd, Double timeout, boolean allowShell, List<String> settingSources, PermissionsPolicy permissions, Map<String, SubagentDefinition> agents, Map<String, Object> outputSchema, Set<String> permittedToolCalls, String cachePrefix, String sessionId) { }

