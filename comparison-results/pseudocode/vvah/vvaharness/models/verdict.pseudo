// file: vvaharness/models/verdict.py
// Verdict (rendered as record FixVerdict; the name is taken elsewhere): one validator's conclusion about one remediation; Ticket: a deferred verdict handle.

@executedBy(CODE) @role(types)
record Ticket(String ref, String opaque) { }

@executedBy(CODE) @role(types)
record FixVerdict(Decision decision, String rationale, String engineRationale, Double score, List<GateAssessment> gates,
               List<String> conditions, List<String> recommendations, Disposition disposition, Ticket ticket, Provenance producedBy) {

    Double checkScore(Double score) {
        // score in [0, 1]; null (not 0.0) when unscored
        if (score != null && (score < 0.0 || score > 1.0)) throw new ValidationError("score out of range"); // src: vvaharness/models/verdict.py:51
        return score;
    }
}

@executedBy(CODE) @role(types)
class VvahModelsVerdict {
    // module holder for Ticket and Verdict
}
