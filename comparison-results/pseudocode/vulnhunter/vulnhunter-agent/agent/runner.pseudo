    // make_token_manager(config): which credential path the scan session uses.
    @src("vulnhunter-agent/agent/runner.py:539")
    TokenManager tokenManagerFor(Theta θ) {
        String mode = θ["anthropic.auth_mode"];                                                  // src: vulnhunter-agent/agent/config.py:57
        if (mode == "bedrock_oauth") {
            // OAuth client-credentials token for the Bedrock proxy; TLS trust store for the token endpoint.
            return Auth.oauthTokenManager(θ["oauth.*"], θ["tls.ssl_cert_path"], θ["anthropic.bedrock_base_url"]); // src: vulnhunter-agent/agent/config.py:69
        }
        if (mode == "bedrock_sigv4") return Auth.sigV4TokenManager(θ["anthropic.aws_region"]);  // src: vulnhunter-agent/agent/config.py:60
        return Auth.apiKeyTokenManager(θ["anthropic.api_key"]);                                  // src: vulnhunter-agent/agent/config.py:58
    }

