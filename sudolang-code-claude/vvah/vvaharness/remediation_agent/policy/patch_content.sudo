# vvaharness/remediation_agent/policy/patch_content.py

Fail-closed content scan (CWE-1427) of the lines a Stage 10 patch ADDED. The path gates bound only where the fixer writes and the evidence gates are the model's own self-report, so this scan looks at what was written. Only added lines in executable source files are scanned: pre-existing matches are the repository's own debt, and a fix that deletes an `eval` must not be penalized. Regular expressions are used rather than an external analyzer, because Stage 10 forbids `Bash` and the host must not run an analyzer chosen by model-influenced input.

Source: `vvaharness/remediation_agent/policy/patch_content.py` (lines 1-303)
Executor: code
Called from: `policy/postgate.sudo` enforce_post (scan_added_lines)

// src: vvaharness/remediation_agent/policy/patch_content.py:30-134
// (label, reason, patterns) per category; narrow on purpose: reject a backdoor, not any mention of authentication.
// A line matching any pattern of a category is reported under that category; categories are tried in this order.
_RULES = [
  { label: "auth_bypass", reason: "introduces an authentication/authorization short-circuit", patterns: [
      // `if <user/token/role/admin-like> == "<literal>"` backdoors
      /(?i)\b(?:user(?:name)?|login|account|email|token|api_?key|secret|password|passwd|pwd|role|group)\b[^\n=!<>]{0,40}==\s*['"][^'"\n]{2,}['"]/,
      // magic-value escape hatches
      /(?i)\b(?:backdoor|master_?key|magic_?(?:key|value|token)|god_?mode|skip_?auth|bypass_?auth|no_?auth|auth_?bypass|disable_?auth|allow_?all|trust_?all)\b/,
      // verification functions rewritten to succeed unconditionally
      /(?i)\b(?:is_?(?:admin|authenticated|authorized|valid)|check_?(?:auth|permission|access)|has_?(?:permission|access|role)|verify|validate|authenticate|authorize)\w*\s*\([^)]*\)\s*(?:\{\s*)?(?::\s*)?return\s+(?:True|true|1)\b/,
      // TLS or certificate verification switched off
      /(?i)(?:verify|check_?hostname|validate_?certs?|ssl_?verify|rejectUnauthorized|CURLOPT_SSL_VERIFYPEER)\s*[=:]\s*(?:False|false|0|None|null)\b/,
      /(?i)\bCERT_NONE\b|\bInsecureSkipVerify\s*:\s*true\b/ ] },
  { label: "code_execution", reason: "introduces dynamic code execution", patterns: [
      /(?<![\w.])(?:eval|exec|compile)\s*\(/,
      /(?i)(?<![\w.])(?:os\.system|os\.popen|subprocess\.(?:run|call|Popen|check_output|check_call)|commands\.getoutput|child_process\.(?:exec|execSync|spawn|spawnSync)|Runtime\.getRuntime\(\)\.exec|ProcessBuilder|shell_exec|passthru|proc_open|popen|system)\s*\(/,
      /(?<![\w.])new\s+Function\s*\(/,
      /(?i)\bpickle\.loads?\s*\(|\byaml\.load\s*\((?![^)]*Safe)/,
      /(?i)\b__import__\s*\(|\bimportlib\.import_module\s*\(/,
      /(?i)\bsetTimeout\s*\(\s*['"]/ ] },
  { label: "network_egress", reason: "introduces outbound network access", patterns: [
      /(?i)(?<![\w.])(?:requests\.(?:get|post|put|patch|delete|request)|urllib\.request\.urlopen|urlopen|httpx\.(?:get|post|Client)|http\.client\.HTTPS?Connection|aiohttp\.ClientSession|fetch|axios(?:\.\w+)?|XMLHttpRequest|WebSocket|socket\.(?:socket|create_connection))\s*\(/,
      // deliberately NO bare URL or IP:port pattern: a URL literal is not egress, egress is a CALL
      /(?i)(?<![\w.])(?:curl|wget|nc|ncat|netcat)\s+(?:-\S+\s+)*(?:https?:\/\/|\d{1,3}\.)/ ] },
  { label: "credential_exfiltration", reason: "reads credentials or secret material into a new code path", patterns: [
      /(?i)(?:open|read_text|readFile(?:Sync)?|cat)\s*\(\s*['"][^'"\n]*(?:\/\.ssh\/|\/\.aws\/|id_rsa|id_ed25519|\.pem|\.env|credentials|shadow|passwd)/,
      /(?i)\bos\.environ(?:\.get)?\s*[\[(]\s*['"][^'"\n]*(?:SECRET|TOKEN|PASSWORD|API_?KEY|PRIVATE_?KEY|CREDENTIAL)/,
      /(?i)\b(?:base64\.b64decode|atob)\s*\(\s*['"][A-Za-z0-9+\/=]{24,}/ ] },
  { label: "reverse_shell", reason: "introduces a reverse shell or interactive listener", patterns: [
      /(?i)\b(?:\/bin\/(?:ba)?sh|cmd\.exe|powershell)\b[^\n]{0,60}(?:-i|-c|\/c|-nop|-enc)\b/,
      /(?i)\bpty\.spawn\s*\(|\bsocket\.dup2\b|\bdup2\s*\(\s*s\b/,
      /(?i)\bnc\s+-\w*l\w*\b|\bbash\s+-i\s*>&/ ] }
]

// src: vvaharness/remediation_agent/policy/patch_content.py:136-158
_COMMENT_ONLY = /^\s*(?:#|\/\/|\/\*|\*|<!--|--|;|%|"""|'''|rem\s)/i   // a comment-only addition is skipped: an injected payload must become code to act
_PROSE_STRING_ONLY = a line whose whole code content is ONE string literal (optional call or collection punctuation around it, optional r/f/b/u prefixes)

// src: vvaharness/remediation_agent/policy/patch_content.py:161-170
fn _is_prose_string(text):executor=code {
  // the construct named inside a prose string is described, not performed: raise ValueError("Remove APP_TLS_VERIFY=false") is the control, not the breach
  return trimmed text matches _PROSE_STRING_ONLY && the string body contains a space   // eval("payload") has no space and is still scanned
}

// src: vvaharness/remediation_agent/policy/patch_content.py:210-218
_SHELL_EXTS = [".sh", ".bash", ".zsh", ".ksh", ".ps1", ".psm1"]   // shells execute but have no language key in frameworks._EXT_LANG
_HARNESS_OWNED_PREFIXES = ["vvaharness/", "security-scan/", "security-remediation/"]   // the harness's own output and scaffolding; matched after _fold, so ".vvaharness" arrives as "vvaharness"

// src: vvaharness/remediation_agent/policy/patch_content.py:238-271
fn scan_added_lines(diff_text, only_files?):executor=code {
  try added = added_lines_by_file(diff_text);
  catch => return {}   // never raises; note that an empty result is also what a clean patch produces
  allowed = if (only_files != null) only_files |> map(_fold) else null
  issues = {}
  for each [path, lines] in added {
    if (allowed != null && _fold(path) not in allowed) continue
    if (_fold(path) starts with one of _HARNESS_OWNED_PREFIXES) continue
    if (!_is_executable_source(path)) continue
    for each [lineno, text] in lines {
      if (text is blank || text matches _COMMENT_ONLY || _is_prose_string(text)) continue
      for each rule in _RULES {
        if (any rule.patterns searches text) {
          append "${rule.label}: ${rule.reason} (line $lineno: ${_snippet(text)})" to issues[path]
          break   // one category per line is enough to reject it
        }
      }
    }
  }
  return issues   // { path: [messages] }
}

// src: vvaharness/remediation_agent/policy/patch_content.py:221-235
fn _is_executable_source(path):executor=code {
  // logs, reports, manifests and Markdown cannot execute; they reach the diff through enforce_post's whole-tree sweep
  return lower-cased suffix of path in _SHELL_EXTS || frameworks.language_for(path) != "default"
}

// src: vvaharness/remediation_agent/policy/patch_content.py:172-207
fn added_lines_by_file(diff_text):executor=code {
  if (!diff_text) return {}
  current = null; counter = 0; out = {}
  for each raw line in diff_text {
    match (raw) {
      case /^diff --git a\/(?P<a>.+?) b\/(?P<b>.+?)\s*$/ => { current = b (or a) trimmed, or null; counter = 0 }
      case /^\+\+\+ (?:b\/)?(?P<path>.+?)\s*$/ => { current = if (path == "/dev/null") null else path; counter = 0 }
      case starts with "+++" or "---", or /^@@ / => skip
      case current && raw starts with "+" => { counter += 1; append [counter, raw without "+"] to out[current] }
    }
  }
  return out   // counter is the added-line ordinal within the file, not a post-image line number
}

// src: vvaharness/remediation_agent/policy/patch_content.py:274-290
fn undeclared_edited_files(diff_text, declared):executor=code {
  try touched = added_lines_by_file(diff_text);
  catch => return []
  return sorted paths in touched whose _fold is not among the folded declared files
  // preserved: the docstring says nothing checked that the fixer confined its edits to its declared files; this function is exported from policy/__init__.py but no module in the package calls it
}

// src: vvaharness/remediation_agent/policy/patch_content.py:293-300
fn _fold(path):executor=code { return (path with "\\" as "/") stripped of leading "." and "/" characters, case-folded }
fn _snippet(text, limit=120):executor=code { return whitespace-collapsed text, cut to limit - 1 characters plus "…" when longer }
