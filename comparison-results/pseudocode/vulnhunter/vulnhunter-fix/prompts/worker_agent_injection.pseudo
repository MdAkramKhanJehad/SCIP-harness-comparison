// file: vulnhunter-fix/prompts/worker_agent_injection.md
// CWE-class worker prompt for injection findings (CWE-22/78/79/89/94/352/434/502/601/611/918); extends the common
// preamble with per-sink structural fixes, reject-not-sanitize, exact-PoC discrimination, FULL bar and downgrades.

@executedBy(MODEL) @role(prompt) @stage("fix.implement.worker")
class WorkerAgentInjection {

    WorkerResult run(Manifest manifest, Theta θ) {
        // extends worker_agent_common.md (read that file first)
        return WorkerAgentCommon.run(manifest, prompt(θ), θ);                                       // src: vulnhunter-fix/prompts/worker_agent_injection.md:3
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(canonicalFix(θ));
        p.include(discrimination(θ));
        p.include(fullTierBar(θ));
        p.include(antiPatterns(θ));
        p.format(θ["p.worker_agent_injection.residual_template"]);                                  // src: vulnhunter-fix/prompts/worker_agent_injection.md:58
        return p;
    }

    Prompt canonicalFix(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.worker_agent_injection.fix_structural_separator"]);                             // src: vulnhunter-fix/prompts/worker_agent_injection.md:7
        p.rule(θ["p.worker_agent_injection.fix_sql"]);                                              // src: vulnhunter-fix/prompts/worker_agent_injection.md:12
        p.rule(θ["p.worker_agent_injection.fix_shell"]);                                            // src: vulnhunter-fix/prompts/worker_agent_injection.md:13
        p.rule(θ["p.worker_agent_injection.fix_html"]);                                             // src: vulnhunter-fix/prompts/worker_agent_injection.md:14
        p.rule(θ["p.worker_agent_injection.fix_path"]);                                             // src: vulnhunter-fix/prompts/worker_agent_injection.md:15
        p.rule(θ["p.worker_agent_injection.fix_deserialization"]);                                  // src: vulnhunter-fix/prompts/worker_agent_injection.md:16
        p.rule(θ["p.worker_agent_injection.fix_xml"]);                                              // src: vulnhunter-fix/prompts/worker_agent_injection.md:17
        p.rule(θ["p.worker_agent_injection.fix_url"]);                                              // src: vulnhunter-fix/prompts/worker_agent_injection.md:18
        p.must(θ["p.worker_agent_injection.reject_not_sanitize"]);                                  // src: vulnhunter-fix/prompts/worker_agent_injection.md:20
        return p;
    }

    Prompt discrimination(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.worker_agent_injection.discrimination_exact_poc"]);                             // src: vulnhunter-fix/prompts/worker_agent_injection.md:26
        p.rule(θ["p.worker_agent_injection.discrimination_post_fix_structured_error"]);             // src: vulnhunter-fix/prompts/worker_agent_injection.md:30
        p.format(".work/<repo>/discrimination/<vuln>.json");                                        // src: vulnhunter-fix/prompts/worker_agent_injection.md:33
        return p;
    }

    Prompt fullTierBar(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.worker_agent_injection.full_unsafe_api_removed"]);                         // src: vulnhunter-fix/prompts/worker_agent_injection.md:39
        p.checklist(θ["p.worker_agent_injection.full_callers_superset"]);                           // src: vulnhunter-fix/prompts/worker_agent_injection.md:41
        p.checklist(θ["p.worker_agent_injection.full_poc_verbatim"]);                               // src: vulnhunter-fix/prompts/worker_agent_injection.md:43
        return p;
    }

    Prompt antiPatterns(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.worker_agent_injection.anti_regex_sanitizer"]);                                 // src: vulnhunter-fix/prompts/worker_agent_injection.md:47
        p.rule(θ["p.worker_agent_injection.anti_blocklist"]);                                       // src: vulnhunter-fix/prompts/worker_agent_injection.md:49
        p.rule(θ["p.worker_agent_injection.anti_log_without_reject"]);                              // src: vulnhunter-fix/prompts/worker_agent_injection.md:50
        p.rule(θ["p.worker_agent_injection.anti_length_limit_only"]);                               // src: vulnhunter-fix/prompts/worker_agent_injection.md:51
        p.forbid(θ["p.worker_agent_injection.anti_comment_fix_refuse"]);                            // src: vulnhunter-fix/prompts/worker_agent_injection.md:52
        return p;
    }

    void applyCanonicalFix(Finding f, Theta θ) {
        if (!θ["p.worker_agent_injection.fix_structural_separator"]) return;                        // src: vulnhunter-fix/prompts/worker_agent_injection.md:7
        switch (f.sinkKind) {
            case "SQL": apply(θ["p.worker_agent_injection.fix_sql"]); break;                        // src: vulnhunter-fix/prompts/worker_agent_injection.md:12
            case "Shell": apply(θ["p.worker_agent_injection.fix_shell"]); break;                    // src: vulnhunter-fix/prompts/worker_agent_injection.md:13
            case "HTML": apply(θ["p.worker_agent_injection.fix_html"]); break;                      // src: vulnhunter-fix/prompts/worker_agent_injection.md:14
            case "Path": apply(θ["p.worker_agent_injection.fix_path"]); break;                      // src: vulnhunter-fix/prompts/worker_agent_injection.md:15
            case "Deserialization": apply(θ["p.worker_agent_injection.fix_deserialization"]); break; // src: vulnhunter-fix/prompts/worker_agent_injection.md:16
            case "XML": apply(θ["p.worker_agent_injection.fix_xml"]); break;                        // src: vulnhunter-fix/prompts/worker_agent_injection.md:17
            case "URL": apply(θ["p.worker_agent_injection.fix_url"]); break;                        // src: vulnhunter-fix/prompts/worker_agent_injection.md:18
        }
        // reject at the boundary; sanitizing is a MITIGATION signal
        if (θ["p.worker_agent_injection.reject_not_sanitize"]) rejectAtBoundary(f);                 // src: vulnhunter-fix/prompts/worker_agent_injection.md:20
    }

    Discrimination discriminate(Finding f, Theta θ) {
        String payload = θ["p.worker_agent_injection.discrimination_exact_poc"] ? f.pocPayload : craftPayload(f); // src: vulnhunter-fix/prompts/worker_agent_injection.md:26
        Discrimination d = new Discrimination();
        d.preFix = executesOrExfiltrates(payload) ? "fail" : "pass";                                // src: vulnhunter-fix/prompts/worker_agent_injection.md:28
        // post-fix: rejected at boundary with structured error (400 with details, or exception)
        d.postFix = (θ["p.worker_agent_injection.discrimination_post_fix_structured_error"] && rejectedWithStructuredError(payload)) ? "pass" : "fail"; // src: vulnhunter-fix/prompts/worker_agent_injection.md:30
        write(".work/<repo>/discrimination/<vuln>.json", d);                                        // src: vulnhunter-fix/prompts/worker_agent_injection.md:33
        return d;
    }

    String tier(Finding f, Diff diff, Discrimination d, Theta θ) {
        boolean removed = θ["p.worker_agent_injection.full_unsafe_api_removed"] && !diff.grep(f.unsafeApi).hasCallers(); // src: vulnhunter-fix/prompts/worker_agent_injection.md:39
        boolean superset = θ["p.worker_agent_injection.full_callers_superset"] && routedCallers(diff).supersetOf(Graph.callersOf(f.sinkSymbol)); // src: vulnhunter-fix/prompts/worker_agent_injection.md:41
        boolean verbatim = θ["p.worker_agent_injection.full_poc_verbatim"] && d.usedPayload == f.pocPayload; // src: vulnhunter-fix/prompts/worker_agent_injection.md:43
        String t = (removed && superset && verbatim) ? "FULL" : "MITIGATION";   // unclear: prompt does not name the tier when a FULL condition fails
        // anti-patterns auto-downgrade
        if (diff.regexSanitizerForStructuralLanguage()) t = θ["p.worker_agent_injection.anti_regex_sanitizer"]; // src: vulnhunter-fix/prompts/worker_agent_injection.md:47
        if (diff.blocklistOnly()) t = θ["p.worker_agent_injection.anti_blocklist"];                 // src: vulnhunter-fix/prompts/worker_agent_injection.md:49
        if (diff.logWithoutReject()) t = θ["p.worker_agent_injection.anti_log_without_reject"];     // src: vulnhunter-fix/prompts/worker_agent_injection.md:50
        if (diff.lengthLimitOnly()) t = θ["p.worker_agent_injection.anti_length_limit_only"];       // src: vulnhunter-fix/prompts/worker_agent_injection.md:51
        // comment-based "fix" is refused outright
        if (diff.commentOnlyFix()) return θ["p.worker_agent_injection.anti_comment_fix_refuse"];    // src: vulnhunter-fix/prompts/worker_agent_injection.md:52
        return t;
    }

    List<String> residuals(String tier, Finding f, Theta θ) {
        if (tier == "FULL") return List.of();
        return List.of(θ["p.worker_agent_injection.residual_template"].with("<sink>", "<specific pattern still accepted>")); // src: vulnhunter-fix/prompts/worker_agent_injection.md:58
    }
}
