// file: vvaharness/backends/harness/models.py
// The harness family's data contract: the logical/native tool vocabularies that the permission gates read,
// effort/provider enums, session/one-shot/streaming options, streamed message types and the VVAH-E00x errors.

@executedBy(CODE) @role(config)
class HarnessModels {

    // Logical tool name (profile YAML) -> native DeepAgents name.
    Map<String, String> logicalToNative(Theta θ) {
        return θ["code.backends.harness.models.logical_to_native"];   // Read->read_file, Grep->grep, Glob->glob, Edit->edit_file, Write->write_file // src: vvaharness/backends/harness/models.py:36
    }

    Set<String> readTools(Theta θ) {
        return θ["code.backends.harness.models.read_tools"];          // Read, Grep, Glob                // src: vvaharness/backends/harness/models.py:45
    }

    Set<String> orchestrationTools(Theta θ) {
        return θ["code.backends.harness.models.orchestration_tools"]; // Agent, Task, TodoWrite, Skill   // src: vvaharness/backends/harness/models.py:48
    }

    // Denied in a read-only session.
    Set<String> mutatingTools(Theta θ) {
        return θ["code.backends.harness.models.mutating_tools"];      // Bash, Edit, NotebookEdit, Write // src: vvaharness/backends/harness/models.py:51
    }

    // A read-only session may call these without a path check; Write is gated per-path instead.
    Set<String> readOnlyTools(Theta θ) {
        return readTools(θ).union(orchestrationTools(θ));                                               // src: vvaharness/backends/harness/models.py:54
    }

    // Mutating tools denied outright; Write and Bash are carved out (Write path-gated, Bash denied separately).
    Set<String> unconditionallyDeniedTools(Theta θ) {
        return mutatingTools(θ).minus(θ["code.backends.harness.models.denied_tools_carve_out"]);         // src: vvaharness/backends/harness/models.py:57
    }

    Set<String> nativeWriteTools(Theta θ) {
        Set<String> out = new Set();
        for (String name : mutatingTools(θ)) {                                                           // src: vvaharness/backends/harness/models.py:60
            if (logicalToNative(θ).containsKey(name)) out.add(logicalToNative(θ).get(name));             // src: vvaharness/backends/harness/models.py:61
        }
        return out;
    }

    // Native tools whose results carry file content (glob/ls return only paths); redaction targets these.
    Set<String> nativeContentTools(Theta θ) {
        return θ["code.backends.harness.models.native_content_tools"]; // read_file, grep                // src: vvaharness/backends/harness/models.py:65
    }

    // Not grantable via LOGICAL_TO_NATIVE (a refused ls wastes turns); granted alongside reads only.
    Set<String> nativeImpliedReads(Theta θ) {
        return θ["code.backends.harness.models.native_implied_reads"]; // ls                             // src: vvaharness/backends/harness/models.py:68
    }

    // Shell native; deliberately NOT in LOGICAL_TO_NATIVE; granted only with allow_shell.
    String nativeShellTool(Theta θ) {
        return θ["code.backends.harness.models.native_shell_tool"];    // "execute"                      // src: vvaharness/backends/harness/models.py:71
    }

    // Legacy custom dispatch tool: never granted (native subagents are used instead).
    String legacyAgentTool() {
        return "Agent";                                                                                  // src: vvaharness/backends/harness/models.py:74
    }

    // Tools from an MCP server carry this prefix; the permission gate allows them.
    String mcpToolPrefix(Theta θ) {
        return θ["code.backends.harness.models.mcp_tool_prefix"];      // "mcp__"                        // src: vvaharness/backends/harness/models.py:77
    }

    String defaultGraphName() {
        return "agent";                                                                                  // src: vvaharness/backends/harness/models.py:176
    }

    ToolBuilder composeToolBuilders(List<ToolBuilder> builders) {
        List<ToolBuilder> live = builders.filter(b -> b != null);                                        // src: vvaharness/backends/harness/models.py:164
        return (args) -> {
            List<Tool> out = new List();
            for (ToolBuilder b : live) out.addAll(b.build(args) == null ? List.of() : b.build(args));   // src: vvaharness/backends/harness/models.py:169
            return out;
        };
    }

    // Truncation below this fraction of the requested budget means a gateway cap / hidden reasoning, not long output.
    boolean truncatedBelowBudget(Integer produced, int requested, Theta θ) {
        // produced == null is "unknown", never "below budget"
        return produced != null && requested > 0 && produced < requested * θ["code.backends.harness.models.truncated_below_budget_ratio"]; // src: vvaharness/backends/harness/models.py:534
    }

    // VVAH-E001/E002 abort the whole scan immediately; every other harness error is non-halt.
    boolean isHaltError(Exception exc) {
        return exc instanceof AuthenticationError || exc instanceof ProxyError;                          // src: vvaharness/backends/harness/models.py:725
    }

    boolean isTokenError(Exception exc) {
        return exc instanceof AuthenticationError;                                                       // src: vvaharness/backends/harness/models.py:730
    }
}

@executedBy(CODE) @role(types)
enum EffortLevel { LOW, MEDIUM, HIGH, XHIGH, MAX }

@executedBy(CODE) @role(types)
class EffortLevelParse {
    // Map a string to an effort tier; null when absent or invalid (never raises).
    EffortLevel parse(String value) {
        try {
            return parseEnum(EffortLevel, value);                                                            // src: vvaharness/backends/harness/models.py:93
        } catch (ValueError e) {
            return null;                                                                                 // src: vvaharness/backends/harness/models.py:95
        }
    }
}

