// file: vvaharness/backends/harness/deepagents/evidence_gate.py
// Middleware that rejects a session's structured verdict until every todo on its plan is completed (and, when
// required_tools is set, a graph tool has been called). Relents after max_rejections and lets the verdict through.

@executedBy(CODE) @role(rule_set)
class EvidenceGate {

    int maxRejections;
    String counter;
    Set<String> required;
    boolean requireToolCall;
    Set<String> ignored;
    Set<String> called;
    int rejected;

    void init(int maxRejections, String counter, Set<String> requiredTools, boolean requireToolCall, Set<String> ignoredTools, Theta θ) {
        // S4 passes θ["step4.evidence_gate_refusals"]; the class default is 3
        this.maxRejections = maxRejections > 0 ? maxRejections : θ["p.evidence_gate.max_rejections_default"]; // src: vvaharness/backends/harness/deepagents/evidence_gate.py:83
        this.counter = counter;
        this.required = requiredTools;                                                                   // src: vvaharness/backends/harness/deepagents/evidence_gate.py:92
        this.requireToolCall = requireToolCall;
        this.ignored = ignoredTools;
        this.called = new Set();
        this.rejected = 0;
    }

    // Record every tool the session calls, then execute it.
    ToolMessage wrapToolCall(ToolCallRequest request, Handler handler) {
        called.add(request.toolCall.name);                                                               // src: vvaharness/backends/harness/deepagents/evidence_gate.py:105
        return handler.call(request);
    }

    // Record a rejection; false once the gate has used up its rejections (relent).
    boolean claim() {
        if (rejected >= maxRejections) return false;                                                     // src: vvaharness/backends/harness/deepagents/evidence_gate.py:131
        rejected += 1;
        return true;
    }

    void noteCall(String name) {
        called.add(name);                // out-of-loop routes (sdk/openai/cli) feed this                  // src: vvaharness/backends/harness/deepagents/evidence_gate.py:140
    }

    // OUT-OF-LOOP form (no wrap_model_call seam): refusal text for the submit tool, or null to accept.
    String holdForVerdict(Theta θ) {
        if (required.isEmpty() || !intersect(required, called).isEmpty()) return null;                   // src: vvaharness/backends/harness/deepagents/evidence_gate.py:144
        if (!claim()) {
            Counters.bump(counter + "_relented");                                                        // src: vvaharness/backends/harness/deepagents/evidence_gate.py:147
            WarnOnce.warnOnce(WARNED_RELENTED, counter, relentWarning(counter, maxRejections, required)); // shipped without that evidence // src: vvaharness/backends/harness/deepagents/evidence_gate.py:148
            return null;
        }
        Counters.bump(counter);
        return EvidenceGatePrompts.rejection(required, θ).text();                                        // src: vvaharness/backends/harness/deepagents/evidence_gate.py:152
    }

    List<String> toolCallItems(Theta θ) {
        if (requireToolCall && minus(called, ignored).isEmpty()) {                                       // src: vvaharness/backends/harness/deepagents/evidence_gate.py:166
            return List.of(EvidenceGatePrompts.toolCallRequiredItem(θ));                                 // src: vvaharness/backends/harness/deepagents/evidence_gate.py:167
        }
        return List.of();
    }

    // Outstanding items when the response carries a verdict prematurely, else empty.
    List<String> premature(ModelRequest request, ModelResponse response, Theta θ) {
        if (response.structuredResponse == null) return List.of();      // not a verdict             // src: vvaharness/backends/harness/deepagents/evidence_gate.py:172
        List<String> todos = request.state.todos;
        // only status "completed" counts as done
        List<String> outstanding = todos.filter(t -> !θ["p.evidence_gate.done_status_set"].contains(t.status)).map(t -> t.content); // src: vvaharness/backends/harness/deepagents/evidence_gate.py:62
        if (!required.isEmpty() && intersect(required, called).isEmpty()) {                              // src: vvaharness/backends/harness/deepagents/evidence_gate.py:175
            outstanding.add(EvidenceGatePrompts.inloopReachabilityItem(required, θ));                    // src: vvaharness/backends/harness/deepagents/evidence_gate.py:176
        }
        outstanding.addAll(toolCallItems(θ));                                                            // src: vvaharness/backends/harness/deepagents/evidence_gate.py:185
        if (outstanding.isEmpty()) return List.of();                                                     // src: vvaharness/backends/harness/deepagents/evidence_gate.py:186
        if (!claim()) {
            Counters.bump(counter + "_relented");                                                        // src: vvaharness/backends/harness/deepagents/evidence_gate.py:189
            WarnOnce.warnOnce(WARNED_RELENTED, counter, relentWarning(counter, maxRejections, required)); // src: vvaharness/backends/harness/deepagents/evidence_gate.py:190
            return List.of();             // relent: the verdict goes through without the evidence
        }
        Counters.bump(counter);
        return outstanding;
    }

    // Once-per-(stage family, run) WARN line for the first relent on the counter: the gate rejected a verdict maxRejections
    // time(s) for the missing required tools (or an unfinished plan), then relented and the stage output shipped without
    // that evidence (display only; the counter name plus _relented is the manifest key).
    String relentWarning(String counter, int maxRejections, Set<String> required) {                      // src: vvaharness/backends/harness/deepagents/evidence_gate.py:40
        String reason = !required.isEmpty() ? "missing " + sorted(required).join(", ") : "an unfinished plan"; // src: vvaharness/backends/harness/deepagents/evidence_gate.py:42
        return "WARN: the evidence gate rejected a verdict " + maxRejections + " time(s) for " + reason + ", then relented";  // src: vvaharness/backends/harness/deepagents/evidence_gate.py:43
    }

    // The request with the hold message appended. The rejected reply is deliberately dropped: Anthropic 400s on a tool_use
    // with no tool_result.
    ModelRequest retryRequest(ModelRequest request, List<String> outstanding, Theta θ) {                 // src: vvaharness/backends/harness/deepagents/evidence_gate.py:196
        return request.override(concat(request.messages, EvidenceGatePrompts.nudge(outstanding, θ)));   // src: vvaharness/backends/harness/deepagents/evidence_gate.py:199
    }

    // Async counterpart of wrapToolCall: record the tool name, then the awaited handler.
    ToolMessage awrapToolCall(ToolCallRequest request, Handler handler) {
        called.add(request.toolCall.name);                                                               // src: vvaharness/backends/harness/deepagents/evidence_gate.py:115
        return await handler.call(request);                                                              // src: vvaharness/backends/harness/deepagents/evidence_gate.py:116
    }

    // Call the model; while it reports a verdict on an unworked plan, drop the reply and re-ask with a HOLD nudge.
    ModelResponse wrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        ModelResponse response = handler.call(request);                                                  // src: vvaharness/backends/harness/deepagents/evidence_gate.py:207
        List<String> outstanding = premature(request, response, θ);
        while (!outstanding.isEmpty()) {                                                                 // src: vvaharness/backends/harness/deepagents/evidence_gate.py:208
            // rejected reply deliberately dropped (a tool_use with no tool_result 400s on Anthropic)
            request = retryRequest(request, outstanding, θ);                                             // src: vvaharness/backends/harness/deepagents/evidence_gate.py:209
            response = handler.call(request);                                                            // src: vvaharness/backends/harness/deepagents/evidence_gate.py:210
            outstanding = premature(request, response, θ);
        }
        return response;
    }

    // Async counterpart of wrapModelCall: same re-ask loop with awaited handler calls.
    ModelResponse awrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        ModelResponse response = await handler.call(request);                                            // src: vvaharness/backends/harness/deepagents/evidence_gate.py:219
        List<String> outstanding = premature(request, response, θ);
        while (!outstanding.isEmpty()) {                                                                // src: vvaharness/backends/harness/deepagents/evidence_gate.py:220
            request = retryRequest(request, outstanding, θ);                                             // src: vvaharness/backends/harness/deepagents/evidence_gate.py:221
            response = await handler.call(request);                                                      // src: vvaharness/backends/harness/deepagents/evidence_gate.py:222
            outstanding = premature(request, response, θ);
        }
        return response;
    }
}

@executedBy(MODEL) @role(prompt)
class EvidenceGatePrompts {

    // The HOLD turn handed back in place of a premature verdict.
    Prompt nudge(List<String> outstanding, Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.evidence_gate_nudge"]);                                                         // src: vvaharness/backends/harness/deepagents/evidence_gate.py:66
        p.checklist(outstanding);
        p.rule(θ["p.evidence_gate.nudge_hold_lists_todos"]);           // "HOLD. ... N todo(s) on your own plan are not completed" // src: vvaharness/backends/harness/deepagents/evidence_gate.py:69
        p.rule(θ["p.evidence_gate.nudge_verdict_not_recorded"]);       // rejected and not recorded; do the work now // src: vvaharness/backends/harness/deepagents/evidence_gate.py:71
        p.must(θ["p.evidence_gate.nudge_read_to_end_of_file"]);        // read each named file to the END     // src: vvaharness/backends/harness/deepagents/evidence_gate.py:72
        p.must(θ["p.evidence_gate.nudge_load_skill_grep_siblings"]);   // load skill, grep siblings, enumerate control sites // src: vvaharness/backends/harness/deepagents/evidence_gate.py:73
        p.must(θ["p.evidence_gate.nudge_mark_completed_with_write_todos"]); // mark each completed with write_todos, then report // src: vvaharness/backends/harness/deepagents/evidence_gate.py:74
        p.exemption(θ["p.evidence_gate.nudge_inapplicable_todo_escape"]); // inapplicable todo: completed + reason in rationale // src: vvaharness/backends/harness/deepagents/evidence_gate.py:75
        p.forbid(θ["p.evidence_gate.nudge_no_resend_without_evidence"]);                                 // src: vvaharness/backends/harness/deepagents/evidence_gate.py:76
        return p;
    }

    // Out-of-loop rejection text (sdk/openai/cli routes).
    Prompt rejection(Set<String> required, Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.evidence_gate.rejection_requires_graph_tool"]);    // "Rejected: you have not called any of <required> ..." // src: vvaharness/backends/harness/deepagents/evidence_gate.py:155
        p.context(required);
        p.checklist(θ["p.evidence_gate.rejection_suggested_tools"]);   // GraphImporters, GraphNeighbors, GraphCommunityOf, GraphSinksInCommunity // src: vvaharness/backends/harness/deepagents/evidence_gate.py:156
        p.rule(θ["p.evidence_gate.rejection_graph_tools_deterministic_claim"]);                          // src: vvaharness/backends/harness/deepagents/evidence_gate.py:159
        p.must(θ["p.evidence_gate.rejection_resend_with_evidence"]);                                     // src: vvaharness/backends/harness/deepagents/evidence_gate.py:160
        return p;
    }

    String toolCallRequiredItem(Theta θ) {
        return θ["p.evidence_gate.tool_call_required_item"];           // "read the code with a tool before you report" // src: vvaharness/backends/harness/deepagents/evidence_gate.py:167
    }

    String inloopReachabilityItem(Set<String> required, Theta θ) {
        // "establish reachability from the call graph -- you have not called any of <required>. Call one now: ..."
        return θ["p.evidence_gate.inloop_reachability_item"];                                            // src: vvaharness/backends/harness/deepagents/evidence_gate.py:177
    }
}
