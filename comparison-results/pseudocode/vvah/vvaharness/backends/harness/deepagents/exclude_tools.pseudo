// file: vvaharness/backends/harness/deepagents/exclude_tools.py
// Middleware that withholds a fixed set of tools from every model request (un-advertises only;
// a forged call to a withheld tool would still run -- PermitTools is the fail-closed gate).

@executedBy(CODE) @role(backend)
class ExcludeTools {
    Set<String> excluded;

    String toolName(Object tool) {
        Object name = tool instanceof Map ? tool.get("name") : tool.name;                                // src: vvaharness/backends/harness/deepagents/exclude_tools.py:32
        return name instanceof String ? name : null;                                                     // src: vvaharness/backends/harness/deepagents/exclude_tools.py:33
    }

    void init(Set<String> excluded) {
        this.excluded = excluded;                                                                        // src: vvaharness/backends/harness/deepagents/exclude_tools.py:42
    }

    ModelRequest filter(ModelRequest request) {
        List<Tool> kept = request.tools.filter(t -> !excluded.contains(toolName(t)));                    // src: vvaharness/backends/harness/deepagents/exclude_tools.py:45
        return kept.size() != request.tools.size() ? request.override("tools", kept) : request;         // src: vvaharness/backends/harness/deepagents/exclude_tools.py:46
    }

    ModelCallResult wrapModelCall(ModelRequest request, Handler handler) {
        return handler.call(filter(request));                                                            // src: vvaharness/backends/harness/deepagents/exclude_tools.py:52
    }
}
