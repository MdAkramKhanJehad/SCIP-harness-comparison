Called from: `vvaharness/backends/llm/deepagents.py:589` and `:615`

// src: vvaharness/backends/harness/transcript.py:99-110
fn open_transcript(tag, model, graph_name = ""):executor=code {
  root = transcript_dir()   // environment variable VVAHARNESS_TRANSCRIPT_DIR, trimmed, user-expanded; empty means off
  if (root == null) return null
  try create root and parents; catch OSError => return null
  name = "${four-digit process-unique sequence number}-${_slug(tag || graph_name, fallback=\"session\")}.jsonl"   // sequence guarded by a lock
  return Transcript(root/name, meta={ tag, model, graph_name })
}

// src: vvaharness/backends/harness/transcript.py:49-59
fn _slug(text, fallback):executor=code { return text with runs of characters outside [A-Za-z0-9._-] replaced by "-", trimmed of "-", first 60 characters, or fallback when empty }
fn _jsonable(message):executor=code { return dataclass fields of message, or { kind: type name, repr: first 4000 characters of repr } }

// src: vvaharness/backends/harness/transcript.py:62-96
Transcript {
  on open: append row { kind: "transcript_open", ...meta }
  add(message) { n += 1; append row { seq: n, t: seconds since open rounded to 3 places, ..._jsonable(message) } }
  close() { append row { kind: "transcript_close", messages: n, elapsed_s } }
  _write(row) {
    append one JSON line under a lock
    catch OSError, TypeError or ValueError => drop the row silently
  }
}
