// file: vvaharness/backends/llm/tools.py
// Sandboxed read-only Read/Glob/Grep ("localtools") for the non-CLI raw loops (sdk.py, openai.py): jailed to cwd
// and to the S1 inventory once set_scope() is called; binary/data-URI elision, size caps, redaction of content.

@executedBy(CODE) @role(tool)
class LlmTools {

    int MAX_BYTES = θ["code.backends.llm.tools.max_read_bytes"];                                            // src: vvaharness/backends/llm/tools.py:28
    int MAX_MATCHES = θ["code.backends.llm.tools.max_grep_lines"];                                          // src: vvaharness/backends/llm/tools.py:29
    int MAX_GLOB = θ["code.backends.llm.tools.max_glob_hits"];                                              // src: vvaharness/backends/llm/tools.py:30
    int MAX_GREP_LINE = θ["code.backends.llm.tools.max_grep_line_chars"];                                   // ReDoS bound on model-supplied patterns // src: vvaharness/backends/llm/tools.py:32
    // root containment alone allows .git/config; copies S1's always-excluded dirs
    Set<String> ALWAYS_EXCLUDED_DIRS = θ["code.backends.llm.tools.always_excluded_dirs"];                   // src: vvaharness/backends/llm/tools.py:35
    List<String> ALWAYS_ALLOWED_PREFIXES = θ["code.backends.llm.tools.always_allowed_prefixes"];            // harness-injected skill content // src: vvaharness/backends/llm/tools.py:38
    Map<String, Set<String>> SCOPE = new Map();                                                             // root -> in-scope inventory // src: vvaharness/backends/llm/tools.py:40
    String SCOPE_ERROR = "ERROR: path is excluded from the scan scope (not in the scanned file inventory)";  // src: vvaharness/backends/llm/tools.py:88
    String UNGRANTED_TOOL_ERROR = "ERROR: tool is not available in this session";                           // src: vvaharness/backends/llm/tools.py:92
    int BINARY_SNIFF_CHARS = θ["code.backends.llm.tools.binary_sniff_chars"];                               // src: vvaharness/backends/llm/tools.py:95
    Regex DATA_URI_RX = Regex.compile("data:([\\w.+-]+/[\\w.+-]+);base64,([A-Za-z0-9+/=]*)");               // src: vvaharness/backends/llm/tools.py:96
    Regex DATA_URI_IMAGE_RX = Regex.compile("data:image/([\\w.+-]*)");                                      // some gateways reject the bare marker // src: vvaharness/backends/llm/tools.py:100
    // ~12K-token ceiling so one Read cannot exhaust context; shared by openai/sdk/tool_adapter
    int TOOL_RESULT_CAP = θ["code.backends.llm.tools.tool_result_cap_chars"];                               // src: vvaharness/backends/llm/tools.py:131

    @src("vvaharness/backends/llm/tools.py:44")
    boolean alwaysAllowed(String rel) {
        return ALWAYS_ALLOWED_PREFIXES.anyMatch(p -> rel.startsWith(p));                                    // src: vvaharness/backends/llm/tools.py:46
    }

    /** Register the scan's in-scope inventory for root (called by S1). */
    @src("vvaharness/backends/llm/tools.py:49")
    void setScope(Path root, List<String> files) {
        SCOPE.put(root.resolve().toString(), files.map(f -> f.replace("\\", "/")).toSet());                 // src: vvaharness/backends/llm/tools.py:54
    }

    @src("vvaharness/backends/llm/tools.py:57")
    Set<String> scopeFor(Path root) {
        return SCOPE.get(root.resolve().toString());                                                        // null = no inventory registered // src: vvaharness/backends/llm/tools.py:62
    }

    /** Outside the read surface: under an always-excluded dir, or not in the inventory. */
    @src("vvaharness/backends/llm/tools.py:65")
    boolean excludedRel(String rel, Set<String> scope) {
        if (alwaysAllowed(rel)) return false;                                                               // src: vvaharness/backends/llm/tools.py:67
        List<String> parts = rel.split("/");
        if (parts.dropLast().anyMatch(part -> ALWAYS_EXCLUDED_DIRS.contains(part.lower()))) return true;    // src: vvaharness/backends/llm/tools.py:70
        return scope != null && !scope.contains(rel);                                                       // src: vvaharness/backends/llm/tools.py:72
    }

    /** excludedRel for an explicit Grep target, which may name a directory. */
    @src("vvaharness/backends/llm/tools.py:75")
    boolean excludedTarget(String rel, Set<String> scope) {
        if (alwaysAllowed(rel)) return false;                                                               // src: vvaharness/backends/llm/tools.py:77
        if (rel.split("/").anyMatch(part -> ALWAYS_EXCLUDED_DIRS.contains(part.lower()))) return true;      // src: vvaharness/backends/llm/tools.py:80
        if (scope == null || scope.contains(rel)) return false;                                             // src: vvaharness/backends/llm/tools.py:82
        return !scope.anyMatch(f -> f.startsWith(rel + "/"));                                               // dir with no in-scope file // src: vvaharness/backends/llm/tools.py:85
    }

    /** Null byte, or a high U+FFFD density, in the decoded head. */
    @src("vvaharness/backends/llm/tools.py:103")
    boolean isBinaryText(String text) {
        String head = text.substring(0, BINARY_SNIFF_CHARS);                                                // src: vvaharness/backends/llm/tools.py:105
        if (head.contains("\\x00")) return true;                                                            // src: vvaharness/backends/llm/tools.py:106
        return !head.isEmpty() && head.count("U+FFFD") / head.length() > θ["code.backends.llm.tools.binary_replacement_ratio"]; // src: vvaharness/backends/llm/tools.py:108
    }

    /** Neutralise data-URI markers (not just payloads); never restored. */
    @src("vvaharness/backends/llm/tools.py:111")
    String elideDataUris(String text) {
        text = DATA_URI_RX.sub(m -> "[data-uri " + m.group(1) + " elided]", text);                          // src: vvaharness/backends/llm/tools.py:113
        return DATA_URI_IMAGE_RX.sub(m -> "[data-uri image elided]", text);                                 // src: vvaharness/backends/llm/tools.py:117
    }

    /** Guard text before it is packed into a prompt. */
    @src("vvaharness/backends/llm/tools.py:123")
    String sanitizePackedText(String text, String rel) {
        if (isBinaryText(text)) return "[binary content elided: " + rel + " is not text]";                  // src: vvaharness/backends/llm/tools.py:126
        return elideDataUris(text);                                                                         // src: vvaharness/backends/llm/tools.py:127
    }

    /** Trim to TOOL_RESULT_CAP, telling the model what was cut and how to re-read. */
    @src("vvaharness/backends/llm/tools.py:134")
    String capToolResult(String result) {
        if (result == null || result.length() <= TOOL_RESULT_CAP) return result;                            // src: vvaharness/backends/llm/tools.py:136
        int extra = result.length() - TOOL_RESULT_CAP;
        return result.substring(0, TOOL_RESULT_CAP) + "\n\n...[truncated " + extra + " chars to fit context; re-read a specific line range with Read offset/limit]"; // src: vvaharness/backends/llm/tools.py:139
    }

    @src("vvaharness/backends/llm/tools.py:144")
    Path jail(Path root, String p) {
        Path cand;
        try { cand = Path.isAbs(p) ? Path.of(p).resolve() : root.resolve(p).realpath(); } catch (OSError e) { return null; } // src: vvaharness/backends/llm/tools.py:146
        if (!cand.isRelativeTo(root)) return null;                                                          // src: vvaharness/backends/llm/tools.py:150
        return cand;
    }

    @src("vvaharness/backends/llm/tools.py:156")
    String read(Path root, String path, int offset, int limit) {
        // limit defaults to 2000 lines
        Path fp = jail(root, path);                                                                         // src: vvaharness/backends/llm/tools.py:157
        if (fp == null) return "ERROR: path is outside the repository root";                                // src: vvaharness/backends/llm/tools.py:159
        String rel = fp.relativeTo(root).posix();
        if (excludedRel(rel, scopeFor(root))) return SCOPE_ERROR;                                           // scope BEFORE existence: no oracle // src: vvaharness/backends/llm/tools.py:162
        if (!fp.isFile()) return "ERROR: file not found";                                                   // src: vvaharness/backends/llm/tools.py:164
        List<String> lines;
        try { lines = sanitizePackedText(fp.read(MAX_BYTES * 4), rel).splitLines(); } catch (OSError e) { return "ERROR: cannot read"; } // src: vvaharness/backends/llm/tools.py:168
        int start = max(0, offset);                                                                         // src: vvaharness/backends/llm/tools.py:171
        int end = start + max(1, limit);
        String body = lines.slice(start, end).numbered(start + 1);                                          // src: vvaharness/backends/llm/tools.py:174
        if (body.length() > MAX_BYTES) body = body.substring(0, MAX_BYTES) + "\n... [truncated]";           // src: vvaharness/backends/llm/tools.py:177
        if (body.isEmpty()) body = "(file is empty or offset past EOF)";                                    // src: vvaharness/backends/llm/tools.py:180
        return body;
    }

    @src("vvaharness/backends/llm/tools.py:184")
    String glob(Path root, String pattern) {
        String pat = pattern.lstrip("/").lstrip("\\");                                                      // src: vvaharness/backends/llm/tools.py:185
        Set<String> scope = scopeFor(root);
        List<String> hits;
        try {
            // scope-check the RESOLVED target: an in-root symlink must not list an excluded file
            hits = root.glob(pat).filter(p -> p.isFile() && jail(root, p.rel()) != null && !excludedRel(jail(root, p.rel()).relativeTo(root).posix(), scope)).map(p -> p.rel()).sorted(); // src: vvaharness/backends/llm/tools.py:189
        } catch (OSError e) {
            return "ERROR: invalid glob";                                                                   // src: vvaharness/backends/llm/tools.py:199
        }
        if (hits.isEmpty()) return "No files found";                                                        // src: vvaharness/backends/llm/tools.py:201
        if (hits.size() > MAX_GLOB) return String.join("\n", hits.slice(0, MAX_GLOB)) + "\n... (" + (hits.size() - MAX_GLOB) + " more)"; // src: vvaharness/backends/llm/tools.py:202
        return String.join("\n", hits);
    }

    @src("vvaharness/backends/llm/tools.py:207")
    boolean grepWanted(String rel, String glob) {
        if (glob == null || glob.isEmpty()) return true;                                                    // src: vvaharness/backends/llm/tools.py:209
        String pat = glob.lstrip("/").lstrip("\\");
        return Fnmatch.match(rel, pat) || Fnmatch.match(rel.basename(), pat);                               // src: vvaharness/backends/llm/tools.py:212
    }

    /** Harness skill content is surfaced only when the walk named it explicitly. */
    @src("vvaharness/backends/llm/tools.py:215")
    boolean grepSkipHarness(String rel, boolean explicitHarness) {
        return !explicitHarness && (rel == ".vvaharness" || alwaysAllowed(rel));                            // src: vvaharness/backends/llm/tools.py:217
    }

    @src("vvaharness/backends/llm/tools.py:220")
    boolean grepInSurface(Path root, Path p, Set<String> scope, String glob, boolean explicitHarness) {
        Path fp = p.isFile() ? jail(root, p.toString()) : null;                                             // src: vvaharness/backends/llm/tools.py:223
        if (fp == null) return false;
        String rel = fp.relativeTo(root).posix();
        if (grepSkipHarness(rel, explicitHarness)) return false;                                            // src: vvaharness/backends/llm/tools.py:227
        return grepWanted(rel, glob) && !excludedRel(rel, scope);                                           // src: vvaharness/backends/llm/tools.py:229
    }

    /** Resolve the Grep file list, or an ERROR string on a bad/excluded path. */
    @src("vvaharness/backends/llm/tools.py:232")
    Object grepFiles(Path root, String path, String glob, Set<String> scope) {
        if (path == null || path.isEmpty()) return root.rglob("*").filter(p -> grepInSurface(root, p, scope, glob, false)).sorted(); // one recursive walk // src: vvaharness/backends/llm/tools.py:237
        Path target = jail(root, path);                                                                     // src: vvaharness/backends/llm/tools.py:239
        if (target == null) return "ERROR: path is outside the repository root";
        String rel = target.relativeTo(root).posix();
        if (rel != "." && excludedTarget(rel, scope)) return SCOPE_ERROR;                                   // src: vvaharness/backends/llm/tools.py:244
        if (!target.isDir()) return target.isFile() ? List.of(target) : List.of();                          // src: vvaharness/backends/llm/tools.py:246
        boolean explicitHarness = rel == ".vvaharness" || alwaysAllowed(rel);                               // src: vvaharness/backends/llm/tools.py:248
        return target.rglob("*").filter(p -> grepInSurface(root, p, scope, glob, explicitHarness)).sorted(); // src: vvaharness/backends/llm/tools.py:249
    }

    @src("vvaharness/backends/llm/tools.py:253")
    String clipGrepLine(String s) {
        return s.length() <= MAX_GREP_LINE ? s : s.substring(0, MAX_GREP_LINE) + " ...[line clipped]";      // src: vvaharness/backends/llm/tools.py:255
    }

    /** Append one match with its context window; returns the lines it cost. */
    @src("vvaharness/backends/llm/tools.py:258")
    int emitGrepMatch(List<String> out, String rel, int i, List<String> lines, int ctx) {
        if (ctx == 0) {                                                                                     // src: vvaharness/backends/llm/tools.py:260
            out.add(rel + ":" + (i + 1) + ":" + clipGrepLine(lines.get(i)));
            return 1;
        }
        int lo = max(0, i - ctx);
        int hi = min(lines.size(), i + ctx + 1);                                                            // src: vvaharness/backends/llm/tools.py:263
        for (int j = lo; j < hi; j++) out.add(rel + ":" + (j + 1) + (j == i ? ":" : "-") + clipGrepLine(lines.get(j))); // src: vvaharness/backends/llm/tools.py:264
        out.add("--");
        return (hi - lo) + 1;                                                                               // src: vvaharness/backends/llm/tools.py:268
    }

    @src("vvaharness/backends/llm/tools.py:271")
    String grep(Path root, String pattern, String path, String glob, boolean ignoreCase, int context) {
        Regex rx;
        try { rx = Regex.compile(pattern, ignoreCase); } catch (RegexError e) { return "ERROR: invalid regex"; } // src: vvaharness/backends/llm/tools.py:276
        Object files = grepFiles(root, path, glob, scopeFor(root));                                         // src: vvaharness/backends/llm/tools.py:280
        if (files instanceof String) return files;
        List<String> out = new List();
        int emitted = 0;
        int ctx = max(0, min(θ["code.backends.llm.tools.grep_max_context"], context));                      // src: vvaharness/backends/llm/tools.py:286
        for (Path fp : files) {                                                                             // src: vvaharness/backends/llm/tools.py:287
            String text;
            try { text = fp.readText(); } catch (OSError e) { continue; }
            if (text.length() > MAX_BYTES * 8) text = text.substring(0, MAX_BYTES * 8);                      // per-file grep cap // src: vvaharness/backends/llm/tools.py:292
            if (isBinaryText(text)) continue;                                                               // src: vvaharness/backends/llm/tools.py:295
            text = elideDataUris(text);                                                                     // src: vvaharness/backends/llm/tools.py:297
            List<String> lines = text.splitLines();
            String rel = fp.relativeTo(root).posix();
            for (int i = 0; i < lines.size(); i++) {                                                        // src: vvaharness/backends/llm/tools.py:301
                if (rx.search(lines.get(i).substring(0, MAX_GREP_LINE)) == null) continue;                  // bounded prefix only // src: vvaharness/backends/llm/tools.py:303
                emitted += emitGrepMatch(out, rel, i, lines, ctx);                                          // src: vvaharness/backends/llm/tools.py:305
                if (emitted >= MAX_MATCHES) {                                                               // src: vvaharness/backends/llm/tools.py:306
                    out.add("... (stopped at " + MAX_MATCHES + " lines; narrow pattern, path or glob)");
                    return String.join("\n", out);                                                          // src: vvaharness/backends/llm/tools.py:309
                }
            }
        }
        return out.isEmpty() ? "No matches found" : String.join("\n", out);                                 // src: vvaharness/backends/llm/tools.py:310
    }

    /** OpenAI tools=[...] entries for the requested names (Read/Glob/Grep only). */
    @src("vvaharness/backends/llm/tools.py:374")
    List<Map> schemasFor(List<String> allowed) {
        List<Map> out = new List();
        for (String name : allowed) if (LocalToolSchemas.has(name)) out.add(LocalToolSchemas.openaiShape(name)); // src: vvaharness/backends/llm/tools.py:377
        return out;
    }

    /** Anthropic Messages tools=[...] entries for the requested names. */
    @src("vvaharness/backends/llm/tools.py:385")
    List<Map> anthropicSchemasFor(List<String> allowed) {
        List<Map> out = new List();
        for (String name : allowed) if (LocalToolSchemas.has(name)) out.add(LocalToolSchemas.anthropicShape(name)); // src: vvaharness/backends/llm/tools.py:388
        return out;
    }

    /** (ok, missing): names this module implements vs names it does not (sdk delegates missing to the Agent SDK). */
    @src("vvaharness/backends/llm/tools.py:397")
    Pair supported(List<String> allowed) {
        List<String> ok = allowed.filter(t -> LocalToolSchemas.has(t));                                     // src: vvaharness/backends/llm/tools.py:398
        List<String> missing = allowed.filter(t -> !LocalToolSchemas.has(t));                              // src: vvaharness/backends/llm/tools.py:399
        return Pair.of(ok, missing);
    }

    /** Bounded, non-sensitive summary of a local-tool invocation (60-char values). */
    @src("vvaharness/backends/llm/tools.py:403")
    String summarizeArgs(Map args) {
        List<String> parts = new List();
        for (String key : List.of("path", "pattern", "glob")) if (args.get(key) != null) parts.add(key + "=" + truncate(args.get(key), 60)); // src: vvaharness/backends/llm/tools.py:406
        if (args.get("context") != null) parts.add("context=" + args.get("context"));
        if (args.get("ignore_case")) parts.add("ignore_case=True");
        return parts.isEmpty() ? "..." : String.join(", ", parts);
    }

    /** Dispatch one local tool; Read/Grep results (file CONTENT) are redacted before egress. */
    @src("vvaharness/backends/llm/tools.py:419")
    String execute(String name, Map args, Path cwd) {
        Path root = cwd.resolve();                                                                          // src: vvaharness/backends/llm/tools.py:420
        String result;
        switch (name) {
            case "Read": result = read(root, args.get("path"), args.getOrDefault("offset", 0), args.getOrDefault("limit", θ["code.backends.llm.tools.read_default_limit"])); break; // src: vvaharness/backends/llm/tools.py:364
            case "Glob": result = glob(root, args.get("pattern")); break;                                   // src: vvaharness/backends/llm/tools.py:366
            case "Grep": result = grep(root, args.get("pattern"), args.get("path"), args.get("glob"), args.getOrDefault("ignore_case", false), args.getOrDefault("context", 0)); break; // src: vvaharness/backends/llm/tools.py:367
            default: return "ERROR: tool is not available on this backend";                                 // src: vvaharness/backends/llm/tools.py:423
        }
        if ((name == "Read" || name == "Grep") && !result.startsWith("ERROR:")) result = Redact.redactCounts(result).masked; // Glob returns paths only // src: vvaharness/backends/llm/tools.py:429
        return result;
    }
}

@executedBy(MODEL) @role(tool)
@src("vvaharness/backends/llm/tools.py:315")
class LocalToolSchemas {

    // the tool descriptions the model sees on sdk/openai routes
    Map READ = Map.of("description", "Read a file from the repository. Returns numbered lines.", "params", List.of("path", "offset (default 0)", "limit (default 2000)"), "required", List.of("path")); // src: vvaharness/backends/llm/tools.py:316
    Map GLOB = Map.of("description", "List files in the repository matching a glob pattern (e.g. **/*.java).", "required", List.of("pattern")); // src: vvaharness/backends/llm/tools.py:331
    Map GREP = Map.of("description", "Search file contents for a regex. Returns file:line:text for each match.", "params", List.of("pattern (Python regex)", "path", "glob", "ignore_case", "context"), "required", List.of("pattern")); // src: vvaharness/backends/llm/tools.py:342

    boolean has(String name) {
        return List.of("Read", "Glob", "Grep").contains(name);                                              // src: vvaharness/backends/llm/tools.py:378
    }

    Map openaiShape(String name) {
        return Map.of("type", "function", "function", name);                                                // src: vvaharness/backends/llm/tools.py:380
    }

    Map anthropicShape(String name) {
        return Map.of("name", name, "input_schema", name);                                                  // src: vvaharness/backends/llm/tools.py:391
    }
}
