// file: vvaharness/manifest.py
// Run-level scan manifest: tool version, model roles (with resolved route/transport/effort), config hashes,
// effective scan controls, target git SHA, timing, per-stage telemetry, errors, S11 rollup and counters.

@executedBy(CODE) @role(io) @stage("global")
class Manifest {

    String manifestTsFromStarted(String startedIso) {
        try {
            return DateTime.fromIso(startedIso).utc().format("yyyyMMdd'T'HHmmss'Z'");                  // src: vvaharness/manifest.py:56
        } catch (Exception e) {
            return DateTime.nowUtc().format("yyyyMMdd'T'HHmmss'Z'");                                // src: vvaharness/manifest.py:58
        }
    }

    Path defaultManifestDest(String startedIso, Path cwd) {
        // reserve run_manifest_<ts>[_NN].json with O_EXCL so racing scans never share a name
        String ts = manifestTsFromStarted(startedIso);                                              // src: vvaharness/manifest.py:65
        int i = 0;
        while (true) {
            Path candidate = cwd.resolve("run_manifest_" + ts + (i == 0 ? "" : "_" + pad2(i)) + ".json"); // src: vvaharness/manifest.py:69
            try {
                Os.createExclusive(candidate);                                                      // src: vvaharness/manifest.py:71
                return candidate;
            } catch (FileExistsError e) {
                i += 1;                                                                             // src: vvaharness/manifest.py:74
            }
        }
    }

    List<String> scrubArgv(List<String> argv) {
        List<String> out = new List();
        int i = 0;
        while (i < argv.size()) {
            String tok = argv.get(i);
            if (tok.startsWith("-") && tok.contains("=")) {                                         // src: vvaharness/manifest.py:83
                String flag = tok.before("="); String val = tok.after("=");
                if (!val.isEmpty() && θ["code.manifest.secret_flag_pattern"].search(flag)) {         // src: vvaharness/manifest.py:85
                    out.add(flag + "=***"); i += 1; continue;                                       // src: vvaharness/manifest.py:86
                }
            }
            if (tok.startsWith("-") && θ["code.manifest.secret_flag_pattern"].search(tok)
                    && i + 1 < argv.size() && !argv.get(i + 1).startsWith("-")) {                   // src: vvaharness/manifest.py:89
                out.add(tok); out.add("***"); i += 2; continue;                                     // src: vvaharness/manifest.py:91
            }
            out.add(tok); i += 1;
        }
        // shape-based second pass catches secret-looking values regardless of flag
        return Redact.redactTree(out);                                                              // src: vvaharness/manifest.py:99
    }

    void metadataFailure(String phase, Exception error) {
        try {
            Console.write("[manifest] " + phase + ": " + Redact.redact(error.toString()));          // src: vvaharness/manifest.py:106
        } catch (Exception e) { }
    }

    String gitSha(List<String> args) {
        String repo = null;
        for (int i = 0; i < args.size(); i++) {
            if (args.get(i).equals("--repo") && i + 1 < args.size()) repo = args.get(i + 1);       // src: vvaharness/manifest.py:114
            else if (args.get(i).startsWith("--repo=")) repo = args.get(i).after("=");             // src: vvaharness/manifest.py:116
        }
        if (repo == null) return null;                                                              // src: vvaharness/manifest.py:118
        try {
            Path repoDir = Path.of(repo).resolve();
            if (!repoDir.isDir()) return null;                                                      // src: vvaharness/manifest.py:123
        } catch (OSError e) { return null; }
        try {
            Proc out = Subprocess.run(List.of("git", "rev-parse", "HEAD"), repoDir, θ["code.manifest.git_sha_timeout_s"]); // src: vvaharness/manifest.py:128
            if (out.returncode != 0) { metadataFailure("git revision unavailable", out); return null; } // src: vvaharness/manifest.py:130
            return out.stdout.strip().orNull();                                                     // src: vvaharness/manifest.py:133
        } catch (OSError e) {
            metadataFailure("git revision unavailable", e); return null;                           // src: vvaharness/manifest.py:135
        } catch (Exception e) {
            metadataFailure("unexpected git metadata failure", e); return null;                    // src: vvaharness/manifest.py:138
        }
    }

    String resolvedRoute(String via, String modelId, String provider) {
        // _FIXED_VIA_ROUTES: cli->anthropic, sdk->anthropic, openai->openai; only deepagents picks vendor per model
        String fixed = FIXED_VIA_ROUTES.get(via);                                                   // src: vvaharness/manifest.py:155
        if (fixed != null) return fixed;
        if (via.equals("deepagents")) {                                                             // src: vvaharness/manifest.py:158
            return ProviderRouting.routesToAnthropic(modelId, provider) ? "anthropic" : "openai";   // src: vvaharness/manifest.py:161
        }
        return null;
    }

    String resolvedTransportOpenai(String modelId, Boolean override) {
        // a learned Chat-only failure vetoes even an explicit pin
        if (TRANSPORT_MEMORY.chatOnly.contains(modelId)) return TRANSPORT_CHAT_COMPLETIONS;         // src: vvaharness/manifest.py:184
        if (override == Boolean.TRUE) return TRANSPORT_RESPONSES;                                   // src: vvaharness/manifest.py:186
        if (EFFORT_REJECTIONS.toolsOff.contains(modelId) && resolveUseResponsesApi(modelId, null, override)) { // src: vvaharness/manifest.py:191
            return TRANSPORT_RESPONSES;
        }
        return TRANSPORT_CHAT_COMPLETIONS;                                                          // src: vvaharness/manifest.py:194
    }

    String resolvedTransport(String via, String modelId, String provider, Object node) {
        Boolean override = node.useResponsesApi;                                                    // src: vvaharness/manifest.py:208
        if (via.equals("openai")) return resolvedTransportOpenai(modelId, override);                // src: vvaharness/manifest.py:210
        if (!via.equals("deepagents")) return null;                                                 // src: vvaharness/manifest.py:212
        Boolean allowed = resolveUseResponsesApi(modelId, provider, override);        // src: vvaharness/manifest.py:220
        return allowed == null ? null : (allowed ? TRANSPORT_RESPONSES : TRANSPORT_CHAT_COMPLETIONS); // src: vvaharness/manifest.py:221
    }

    Boolean resolveUseResponsesApi(String modelId, String provider, Boolean override) {
        // delegates to backends/harness/deepagents/options/model_building.resolve_use_responses_api (not rendered there as a method)
        return override;  // unclear: full resolution lives in model_building.py:398                // src: vvaharness/manifest.py:188
    }

    String effectiveEffort(Config cfg, String name) {
        return ConfigPaths.roleEffort(cfg, name);                                                   // src: vvaharness/manifest.py:228
    }

    Map models(Path cfgPath) {
        String phase = "could not load model roles";
        try {
            Config cfg = Config.load(cfgPath, false);                                               // src: vvaharness/manifest.py:235
            phase = "could not extract model roles";
            Map roles = new Map();
            // _MODEL_ROLES: graph_annotate, callgraph_creation, autoexclude, preprocess, threatmodel, decompose,
            //               deepdive, verify, dedup, chain, remediate, validate (EV omitted, added below)
            for (String name : MODEL_ROLES) {                                                       // src: vvaharness/manifest.py:238
                Object r = cfg.models.get(name);
                boolean isValidate = name.equals("validate");
                if (isValidate && r != null) r = r.orchestrator;                                    // src: vvaharness/manifest.py:242
                if (r != null) {
                    String via = r.via != null ? r.via : "cli";  // mirrors registry.resolve() coercion // src: vvaharness/manifest.py:248
                    String declaredVia = via;
                    String provider = r.provider;
                    if (isValidate) {
                        Pair vp = ValidateRole.normalizeValidateBackend(via, provider);             // src: vvaharness/manifest.py:256
                        via = vp.via; provider = vp.provider;
                    }
                    roles.put(name, Map.of("id", r.id, "via", via, "provider", provider,
                        "resolved_route", resolvedRoute(via, r.id, provider),                       // src: vvaharness/manifest.py:262
                        "resolved_transport", resolvedTransport(via, r.id, provider, r),            // src: vvaharness/manifest.py:263
                        "use_responses_api", r.useResponsesApi is Boolean ? r.useResponsesApi : null,
                        "declared_via", declaredVia,
                        "effective_effort", effectiveEffort(cfg, name)));                           // src: vvaharness/manifest.py:269
                }
            }
            Object ev = cfg.models.get("exploit_verification");                                     // src: vvaharness/manifest.py:272
            if (ev != null) {
                for (String sub : EV_MODULES) {                                                     // src: vvaharness/manifest.py:275
                    Object node = ev.get(sub);
                    if (node == null) continue;  // optional by design                              // src: vvaharness/manifest.py:277
                    String via = node.via != null ? node.via : "cli";                               // src: vvaharness/manifest.py:282
                    roles.put("exploit_verification." + sub, Map.of("id", node.id, "via", via, "provider", node.provider,
                        "resolved_route", resolvedRoute(via, node.id, node.provider),
                        "resolved_transport", resolvedTransport(via, node.id, node.provider, node),
                        "declared_via", via, "effective_effort", evEffort(cfg, sub)));              // src: vvaharness/manifest.py:297
                }
            }
            return roles;
        } catch (Exception e) {
            metadataFailure(phase, e);                                                              // src: vvaharness/manifest.py:301
            return Map.of();
        }
    }

    Map modelSpec(Object role) {
        if (role == null) return null;                                                              // src: vvaharness/manifest.py:306
        Map spec = Map.of("id", role.id, "via", role.via != null ? role.via : "cli");               // src: vvaharness/manifest.py:308
        if (role.provider != null) spec.put("provider", role.provider);                             // src: vvaharness/manifest.py:311
        if (role.useResponsesApi is Boolean) spec.put("use_responses_api", role.useResponsesApi);   // src: vvaharness/manifest.py:314
        return spec;
    }

    Map panelSpecs(Object validate) {
        // orchestrator first, then personas security_architect, penetration_tester, cross_repo_analyzer
        Map specs = new Map();
        if (validate.orchestrator != null) specs.put("orchestrator", validate.orchestrator);        // src: vvaharness/manifest.py:328
        for (String name : List.of("security_architect", "penetration_tester", "cross_repo_analyzer")) { // src: vvaharness/manifest.py:330
            if (validate.get(name) != null) specs.put(name, validate.get(name));
        }
        return specs;
    }

    Map panelEntry(Object spec, String via, String provider, String declaredVia) {
        return Map.of("id", spec.id, "via", via, "provider", provider,
                      "resolved_route", resolvedRoute(via, spec.id, provider), "declared_via", declaredVia); // src: vvaharness/manifest.py:340
    }

    Map validationPanel(Object validate) {
        // personas are orchestrator subagents: every entry is reported on the orchestrator's route
        if (validate == null) return Map.of();                                                      // src: vvaharness/manifest.py:353
        Map specs = panelSpecs(validate);
        Object orch = specs.get("orchestrator");
        if (orch == null) return specs.mapValues(s -> Map.of("id", s.id));  // no route derivable    // src: vvaharness/manifest.py:357
        String via = orch.via != null ? orch.via : "cli";                                           // src: vvaharness/manifest.py:366
        String declaredVia = via;
        Pair vp = ValidateRole.normalizeValidateBackend(via, orch.provider);                        // src: vvaharness/manifest.py:369
        return specs.mapValues(s -> panelEntry(s, vp.via, vp.provider, declaredVia));               // src: vvaharness/manifest.py:370
    }

    Map pick(Object section, List<String> names) {
        return names.toMap(n -> section.get(n));                                                    // src: vvaharness/manifest.py:375
    }

    Map inputFingerprint(Object value, Path configDir) {
        if (value == null || value.toString().strip().isEmpty()) return null;                     // src: vvaharness/manifest.py:379
        Path p = Path.of(value);
        Path resolved = p.isAbsolute() ? p : configDir.resolve(p);                                  // src: vvaharness/manifest.py:382
        return Map.of("path", p.toString(), "sha256", configSha256(resolved));                      // src: vvaharness/manifest.py:383
    }

    Map effectiveScanControls(Path cfgPath) {
        // the non-secret configuration that materially changes scan output (reporting only)
        try {
            Config cfg = Config.load(cfgPath, false);                                               // src: vvaharness/manifest.py:393
            Map panel = validationPanel(cfg.models.get("validate"));                                // src: vvaharness/manifest.py:394
            Map controls = new Map();
            controls.put("cache", pick(cfg, List.of("cache_markers", "cache_route", "cache_min_block_tokens"))); // src: vvaharness/manifest.py:400
            controls.put("step0..step9, output, cli, step_remediate, step_validate", pick(cfg, SECTION_KEYS)); // src: vvaharness/manifest.py:403
            controls.put("remediation_model", modelSpec(cfg.models.get("remediate")));              // src: vvaharness/manifest.py:462
            controls.put("validation_panel", panel);                                                // src: vvaharness/manifest.py:466
            // input_hashes: cve_file, controls_file, cmdb_file, policy_file, playbook_file
            controls.put("input_hashes", INPUT_FILES.toMap(k -> inputFingerprint(cfg.get(k), cfg.configDir))); // src: vvaharness/manifest.py:467
            return controls;
        } catch (Exception e) {
            Console.write("[manifest] could not capture effective scan controls");                  // src: vvaharness/manifest.py:477
            return Map.of();
        }
    }

    String pricingFile(Path cfgPath) {
        try {
            return Config.load(cfgPath, false).pricing.file;                                        // src: vvaharness/manifest.py:487
        } catch (Exception e) {
            Console.write("[manifest] could not read pricing.file");                                // src: vvaharness/manifest.py:489
            return null;
        }
    }

    Map telemetryFields(Path cfgPath, Map models) {
        // telemetry failure degrades the section, never loses the manifest
        try {
            Map roleModels = models.filterValues(s -> s.id != null).mapValues(s -> s.id);           // src: vvaharness/manifest.py:500
            return StageTelemetry.composeStageSection(STAGES.snapshot(), TOKENS.snapshot(), roleModels,
                Pricing.loadCached(pricingFile(cfgPath), θ), CACHED_PROVENANCE.snapshot());     // src: vvaharness/manifest.py:503
        } catch (Exception e) {
            Console.write("[manifest] WARNING: per-stage telemetry unavailable");                   // src: vvaharness/manifest.py:510
            return Map.of();
        }
    }

    String configSha256(Path cfgPath) {
        if (!cfgPath.exists()) return null;                                                         // src: vvaharness/manifest.py:515
        try {
            return Sha256.hex(cfgPath.readBytes());                                                 // src: vvaharness/manifest.py:518
        } catch (OSError e) {
            return null;                                                                            // src: vvaharness/manifest.py:521
        }
    }

    Path evCollection() {
        try {
            String path = EvOptions.collectionPath();  // EV's own resolver of EV_API_COLLECTION    // src: vvaharness/manifest.py:527
            return path != null ? Path.of(path) : null;
        } catch (Exception e) {
            return null;                                                                            // src: vvaharness/manifest.py:531
        }
    }

    void refreshResolvedTransport(Map m) {
        // recompute so a mid-run transport hop is not reported stale
        for (Map role : m.get("models").values()) {                                                 // src: vvaharness/manifest.py:536
            role.put("resolved_transport", resolvedTransport(role.via, role.id, role.provider, role)); // src: vvaharness/manifest.py:538
        }
    }

    Map capture(Path cfgPath, List<String> args, Path out, Runnable body) {
        Path ev = evCollection();                                                                   // src: vvaharness/manifest.py:550
        Map m = Map.of("tool", "vvaharness", "version", Vvaharness.version(), "started", DateTime.nowUtc(),
            "argv", scrubArgv(args),                                                                // src: vvaharness/manifest.py:555
            "config_profile", cfgPath, "config_sha256", configSha256(cfgPath),
            "config_local_sha256", configSha256(cfgPath.withName("config.local.yaml")),            // src: vvaharness/manifest.py:559
            "ev_api_collection", ev, "ev_api_collection_sha256", ev != null ? configSha256(ev) : null, // src: vvaharness/manifest.py:561
            "models", models(cfgPath),                                                              // src: vvaharness/manifest.py:564
            "effective_scan_controls", effectiveScanControls(cfgPath),                              // src: vvaharness/manifest.py:565
            "target_git_sha", gitSha(args), "exit_code", null);                                     // src: vvaharness/manifest.py:566
        long t0 = now();
        try {
            body.run(m);                                                                            // src: vvaharness/manifest.py:571
        } catch (KeyboardInterrupt e) {
            if (m.get("exit_code") == null) m.put("exit_code", 130);  // SIGINT                     // src: vvaharness/manifest.py:575
            m.put("exit_cause", "SIGINT");
            throw e;
        } catch (Terminated e) {
            if (m.get("exit_code") == null) m.put("exit_code", 143);  // SIGTERM                    // src: vvaharness/manifest.py:575
            m.put("exit_cause", "SIGTERM");                                                         // src: vvaharness/manifest.py:576
            throw e;
        } finally {
            if (m.get("exit_code") != null) {  // null exit_code = no write                          // src: vvaharness/manifest.py:580
                m.put("ended", DateTime.nowUtc());
                m.put("duration_sec", round(now() - t0, 1));                                        // src: vvaharness/manifest.py:582
                try { refreshResolvedTransport(m); } catch (Exception e) { }                        // src: vvaharness/manifest.py:584
                m.putAll(telemetryFields(cfgPath, m.get("models")));                                // src: vvaharness/manifest.py:587
                try {
                    Map errors = Errlog.countsByStage();                                            // src: vvaharness/manifest.py:591
                    if (!errors.isEmpty()) m.put("errors_by_stage", errors);
                } catch (Exception e) { }
                try {
                    Map rollup = CaseRollup.totals();  // omitted when S11 did not run               // src: vvaharness/manifest.py:599
                    if (!rollup.isEmpty()) m.put("remediation", rollup);
                } catch (Exception e) { }
                try {
                    Map snap = COUNTERS.snapshotCumulative();  // cumulative across batch repos      // src: vvaharness/manifest.py:609
                    if (!snap.isEmpty()) m.put("counters", Redact.redactTree(snap.sortedByKey()));  // src: vvaharness/manifest.py:612
                } catch (Exception e) { }
                Path dest = out != null ? out : defaultManifestDest(m.get("started"), Path.cwd());  // src: vvaharness/manifest.py:616
                try {
                    dest.writeText(Json.dumps(m, 2));                                               // src: vvaharness/manifest.py:619
                    Console.write("[manifest] wrote " + dest);
                } catch (OSError e) {
                    Console.write("[manifest] WARNING: failed to write run manifest");              // src: vvaharness/manifest.py:623
                }
            }
        }
        return m;
    }
}
