fn clean_controls(values):executor=code { return non-blank string entries, trimmed, deduplicated in order }   // a blank blocked_by_controls entry would exempt the chain from the severity floor
fn clean_preconditions(chain):executor=code {
  pre = clean_controls(chain.preconditions)
  if (pre) COUNTERS.bump("s8_chain_gated")
  return pre   // rendered as "Requires:", never folded into blocked_by_controls
