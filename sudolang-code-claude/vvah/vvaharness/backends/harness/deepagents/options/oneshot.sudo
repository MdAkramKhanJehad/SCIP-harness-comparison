# vvaharness/backends/harness/deepagents/options/oneshot.py

Compiles the one-shot (single-turn parser) graph. It decides which native tools are withheld from the model's request (advertisement) and which tool names the executor may run (the `PermitTools` gate, fail closed), and fixes the per-build switches: no tail cache marker, harness suffix stripped, recursion limit `max_turns + 5`.

Source: `vvaharness/backends/harness/deepagents/options/oneshot.py` (lines 1-128)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/client.py` (one-shot run), through `options/__init__.py` build_oneshot_options

// src: vvaharness/backends/harness/deepagents/options/oneshot.py:125-128
fn build_oneshot_options(options: OneShotOptions):executor=code {
  graph = _build_oneshot_graph(options)
  return CompiledGraph(graph, config=graph_config._make_config(options, buffer=5))   // recursion_limit = max_turns + 5 when max_turns is set
}

// src: vvaharness/backends/harness/deepagents/options/oneshot.py:85-122
fn _build_oneshot_graph(options):executor=code {
  policy = subagents._tool_policy(options)   // empty ToolPolicy when options.tool_policy is null
  tools = subagents._build_session_tools(options, policy.allowed_tools)
  // Our gated general-purpose spec displaces the deepagents builtin, which is ungated and unredacted.
  specs = subagents.get_subagent_specs(options, agents={})   // only the general-purpose spec
  return graph_builder._create_agent(
    model_id=options.model, env=options.env, think_in_prompt=options.think_in_prompt,
    system_prompt=options.system_prompt, tools,
    name="${options.graph_name}-oneshot",
    skills=filesystem._skill_sources(options.skill_root, options.cwd) or null,   // an empty list must be omitted, or SkillsMiddleware adds about 1.9k characters per call
    permissions=filesystem._filesystem_permissions(options),
    model_provider=options.model_provider,
    redact_reads=!options.allow_writes,
    backend=filesystem._session_backend(options),
    response_model=options.response_model,
    response_format=response_format._oneshot_response_format(options),
    subagents=specs,
    extra_excluded_tools=_oneshot_excluded_tools(options),
    max_output_tokens=options.max_output_tokens,   // null keeps the model ceiling (64000 Anthropic, uncapped OpenAI)
    output_cap=options.output_cap,
    permitted_tool_calls=_oneshot_permitted_tools(options, tools),   // always a set here, so PermitTools is ALWAYS installed on the one-shot path
    cache_markers=options.cache_markers,
    cache_tail=false,             // single-call requests never read a tail write back
    strip_harness_suffix=true,    // the harness-profile suffix is dropped on a single turn
    effort=options.effort, use_responses_api=options.use_responses_api,
    parent_middleware=options.parent_middleware)
}

// src: vvaharness/backends/harness/deepagents/options/oneshot.py:54-62
fn _granted_natives(options):executor=code {
  if (options.tool_policy == null) return []
  return [LOGICAL_TO_NATIVE[logical] for each logical in options.tool_policy.allowed_tools if logical in LOGICAL_TO_NATIVE]
}

// src: vvaharness/backends/harness/deepagents/options/oneshot.py:65-71
fn _oneshot_excluded_tools(options):executor=code {
  // Advertisement only; PermitTools is the enforcing gate.
  task = [SUBAGENT_DISPATCH_TOOL]   // "task"
  if (options.tool_policy == null) return task   // preserved: with no policy every native tool stays advertised
  return (ALL_NATIVE_TOOLS - _granted_natives(options)) union task
  // ALL_NATIVE_TOOLS = ls, read_file, write_file, edit_file, glob, grep, delete, execute  (deepagents/models.py:133-136)
}

// src: vvaharness/backends/harness/deepagents/options/oneshot.py:74-82
fn _oneshot_permitted_tools(options, session_tools):executor=code {
  custom = deepagents.tools.session_tool_names(session_tools)
  if (options.tool_policy == null) return ALL_NATIVE_TOOLS union custom
  return _granted_natives(options) union custom
  // "task" is never permitted on the one-shot path, even with no policy.
}
