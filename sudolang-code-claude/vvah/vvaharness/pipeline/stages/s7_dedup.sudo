# vvaharness/pipeline/stages/s7_dedup.py

Stage 7, deduplication. A deterministic same-site pass (`s7.collapse.collapse_trivial`) collapses findings first, with no model call. The findings it leaves unresolved may then go to one model call (`s7.session.semantic_dedup`), whose proposed merges are re-checked by code before they are applied. Every collapsed finding is attached to its canonical finding as an extra call site and reported as a `DUPLICATE` drop.

Source: `vvaharness/pipeline/stages/s7_dedup.py` (lines 1-138)
Executor: mixed (deterministic collapse in code; optional model grouping, checked by code)
Called from: `vvaharness/orchestrator/scan.py` scan_repo (Stage 7, `s7_dedup.run(verified, cfg, ctx=ctx)`); `prefilter` is called by Stage 5 (`vvaharness/pipeline/stages/s5/__init__.py`:96, outside this batch)

// src: vvaharness/pipeline/stages/s7_dedup.py:62-138
fn run(verified, cfg, label="s7-dedup", ctx):executor=mixed {
  // src: s7_dedup.py:65-66
  if (length(verified) <= 1) return [copy of verified, []]

  // src: s7_dedup.py:68
  line_tol = knob("step7_dedup.line_tolerance", default=3)   // read as getattr(cfg.step7_dedup, "line_tolerance", 3)

  // src: s7_dedup.py:70-73 — group on the pre-re-anchor line, never the Stage 5 re-anchored line
  group_lines = for each f in verified: int(f.pre_anchor_line or 0) || int(f.line_start)
  canonical_of = s7.collapse.collapse_trivial(verified, line_tol, group_lines)   // { duplicate index -> canonical index }, no model call
  reasoning = { j: TRIVIAL_REASON for each j in canonical_of }

  // src: s7_dedup.py:76-78
  unresolved = indices of verified not in canonical_of
  // abstracted: console count line (trivial duplicates, unresolved); no decision

  // src: s7_dedup.py:80-85
  keep_same_site = if (knob("step7_dedup.per_sink_keep", default=true)) {} else null
  // null tells attach_duplicates to discard same-site duplicate locations instead of keeping them
  if (keep_same_site != null) {
    keep_same_site = keep_same_site union keys(canonical_of)   // every trivially merged member keeps its own line when it differs
  }

  // src: s7_dedup.py:87-90
  root(i) => follow canonical_of from i until an index that is not a duplicate   // no cycle guard here (attach_duplicates has one)

  // ---------- semantic (model) pass ----------
  // src: s7_dedup.py:92-112
  if (length(unresolved) >= 2 && knob("step7_dedup.semantic", default=true)) {
    // preserved: the default at this read site is true, but the configuration defaults (vvaharness/config/__init__.py:553) and every shipped profile set step7_dedup.semantic false, so this model pass normally does not run (s7/collapse.py:207-211 relies on that)
    sem = s7.session.semantic_dedup(verified, unresolved, cfg, ctx=ctx, label=label)   // model role: dedup
    blocked = 0
    for each [local_idx, local_canon, why, independent_sites] in sem {
      // the model's rows are positions in `unresolved`, translated back to global indices
      g_idx = unresolved[local_idx]
      g_canon = unresolved[local_canon]
      require g_idx not in canonical_of && g_canon < g_idx => skip this row
      // the CWE test is made against the ROOT of g_canon, not g_canon itself
      require !s7.collapse.cwe_conflict(verified[g_idx], verified[root(g_canon)]) => { blocked += 1; skip this row }
      canonical_of[g_idx] = g_canon
      reasoning[g_idx] = why
      // fail-safe: the member's own line survives only when the model ruled the sites independent
      if (independent_sites && keep_same_site != null) { keep_same_site = keep_same_site union {g_idx} }
    }
    if (blocked > 0) {
      COUNTERS.bump("s7_dedup_cwe_conflict_blocked", blocked)
      warn S7_CWE_CONFLICT_BLOCKED
    }
  }

  // src: s7_dedup.py:114-115 — merged sites are how the Markdown report and SARIF show every call site
  s7.collapse.attach_duplicates(verified, canonical_of, reasoning, keep_same_site=keep_same_site)

  // src: s7_dedup.py:117-122 — canonical list keeps input order
  canonical = []; new_index_of = {}
  for each i, f in verified where i not in canonical_of {
    new_index_of[i] = length(canonical); append f to canonical
  }

  // src: s7_dedup.py:124-134
  dropped = []
  for each i, f in verified where i in canonical_of {
    append DroppedFinding(file=f.file, line=f.line_start, vuln_class=f.vuln_class, title=f.title,
      chunk_id=f.chunk_id, reason="DUPLICATE", detail=reasoning[i] or "duplicate",
      canonical_idx=new_index_of[root(i)]) to dropped
  }
  // abstracted: console count line (canonical, duplicates collapsed)
  return [canonical, dropped]
}

// src: vvaharness/pipeline/stages/s7_dedup.py:35-59
fn prefilter(findings, line_tol, group_lines?):executor=code {
  // Deterministic collapse only, used before Stage 6; no model call
  if (length(findings) <= 1) return [copy of findings, []]
  // src: s7_dedup.py:42-43 — group_lines must be Stage 4's anchors
  canonical_of = s7.collapse.collapse_trivial(findings, line_tol, group_lines)
  // src: s7_dedup.py:45-48 — keep_same_site not passed (null): same-site duplicate locations are discarded
  s7.collapse.attach_duplicates(findings, canonical_of, { j: TRIVIAL_REASON for each j in canonical_of })
  keep = findings whose index is not in canonical_of
  dropped = for each finding whose index is in canonical_of:
    DroppedFinding(file, line=line_start, vuln_class, title, chunk_id, reason="DUPLICATE", detail=TRIVIAL_REASON)
  // preserved: unlike run(), prefilter sets no canonical_idx on its DroppedFinding rows
  return [keep, dropped]
}
