// file: vvaharness/validation/cli/_parser.py
// Argument parser for `vvaharness validate` (alias s11) and the step_validate tunables forwarded
// as typed overrides into the validation config layer.

@executedBy(CODE) @role(config) @stage("S11")
class Parser {

    String validatableHelp() {
        return String.join(" / ", ConstantsArtifacts.VALIDATABLE_STATES.sorted());                  // src: vvaharness/validation/cli/_parser.py:28
    }

    ArgumentParser buildParser() {
        ArgumentParser p = new ArgumentParser("vvaharness validate");                                // src: vvaharness/validation/cli/_parser.py:33
        p.add("--repo", Path.class, true);                                                           // required target repo root  // src: vvaharness/validation/cli/_parser.py:37
        p.add("--config", String.class, null);                                                       // profile path, else default  // src: vvaharness/validation/cli/_parser.py:38
        p.addRepeatable("--finding", "findings");                                                    // finding ids to validate  // src: vvaharness/validation/cli/_parser.py:39
        p.addFlag("--all");                                                                          // all validatable findings; bypasses max_findings cap  // src: vvaharness/validation/cli/_parser.py:45
        p.add("--max-findings", Integer.class, null);                                                // top-N by CVSS; overrides step_validate.max_findings  // src: vvaharness/validation/cli/_parser.py:53
        p.add("--workspace", Path.class, null);                                                      // ephemeral; non-empty dir or path under --repo is refused  // src: vvaharness/validation/cli/_parser.py:63
        p.addFlag("--resume");                                                                       // skip findings already validated  // src: vvaharness/validation/cli/_parser.py:75
        p.add("--scan-report", Path.class, null);                                                    // else newest report in security-remediation/  // src: vvaharness/validation/cli/_parser.py:80
        return p;
    }

    ValidateOverrides tunableOverrides(HarnessConfig cfg, Theta θ) {
        Object block = cfg.get("step_validate");                                                     // src: vvaharness/validation/cli/_parser.py:99
        if (block == null) return new ValidateOverrides();                                           // src: vvaharness/validation/cli/_parser.py:100
        Map<String, Object> overrides = new Map();
        for (String attr : θ["code.validation.cli._parser.tunable_attrs"]) {                         // src: vvaharness/validation/cli/_parser.py:91
            Object value = block.get(attr);                                                          // src: vvaharness/validation/cli/_parser.py:104
            if (value != null) overrides.put(attr, value);                                           // src: vvaharness/validation/cli/_parser.py:105
        }
        return (ValidateOverrides) overrides;                                                        // src: vvaharness/validation/cli/_parser.py:107
    }
}
