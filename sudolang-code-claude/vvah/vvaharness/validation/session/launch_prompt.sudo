# vvaharness/validation/session/launch_prompt.py

Builds the user-turn launch prompt for one validation session: finding and session ids, the patch-under-validation instructions, the finding details, per-CWE bypass hints, and the session configuration.

Source: `vvaharness/validation/session/launch_prompt.py` (lines 1-127)
Executor: code (assembles text the model reads)
Called from: `vvaharness/validation/session/launcher.sudo` launch_session

// src: vvaharness/validation/session/launch_prompt.py:99-127
// prompt-src: vvaharness/validation/session/launch_prompt.py:101-126
VALIDATION_LAUNCH_PROMPT {
  "Finding: $case_id"
  "Session: $session_id"
  "## Patch under validation"
  Constraints {
    "The remediation patch is **already applied** to this workspace tree; the applied unified diff is at `diff.patch` in the workspace root. Read it first -- it is your primary focus -- then read the rest of the tree freely for cross-file context. Follow the grounding and independence rules in the system prompt: navigate by hunk content and symbol names, never by line number; treat the remediator's `triage.json` verdict as an unverified claim to confirm or refute, not as evidence."
  }
  if (manifest.finding) {
    $findingDetails   // _append_finding_details below
  }
  "## Session Config"
  "- post_results: ${ if (manifest.post_results) "true" else "false" }"
  if (manifest.post_results) {
    "### Post Markers"
    "- Finding $case_id: <!-- validation-session:$session_id -->"
  }
  // post_results is always false on the paths in this batch (cli/_run.sudo and case_api.sudo pass post_results=false)
}

fn build_launch_prompt(manifest):executor=code = VALIDATION_LAUNCH_PROMPT joined with newlines

// src: vvaharness/validation/session/launch_prompt.py:81-96
fn _append_finding_details(lines, finding, affected):executor=code {
  lines += ["", "## Finding Details", ""]
  "- **Title**: ${ finding.title || "N/A" }"
  "- **Category**: ${ _category(finding) || "N/A" }"
  "- **Severity**: ${ finding.cvss_rating || finding.severity.value }"
  if (finding.cvss_score != null) "- **CVSS**: ${ finding.cvss_score }" + (if (finding.cvss_vector) " (${ finding.cvss_vector })")
  if (finding.file) "- **Source**: ${ finding.file }:${ finding.line_start }"
  if (affected) "- **Affected files**: ${ join(affected, ", ") }"   // the remediation's files_touched (ingest/manifest_builder.sudo)
  for each [label, attribute] in _NARRATIVE_FIELDS, if (finding[attribute] is non-empty) "- **$label**: ${ _render(value) }"
  lines += _bypass_hint_lines(finding)
}

// src: vvaharness/validation/session/launch_prompt.py:31-37
_NARRATIVE_FIELDS = [["Description Detail", "description"], ["Impact", "impact"], ["Exploit Scenario", "exploit_scenario"],
                     ["Preconditions", "preconditions"], ["Recommendation", "recommendation"]]

// src: vvaharness/validation/session/launch_prompt.py:48-52
fn _render(value):executor=code = if (value is a list) join(value, "; ") else string(value)
// preserved: the docstring says "a list becomes one bullet per item, never a joined blob", but the code joins list items with "; "

// src: vvaharness/validation/session/launch_prompt.py:64-66
fn _category(finding):executor=code = finding.cwe || finding.vuln_class.value

// src: vvaharness/validation/session/launch_prompt.py:69-78
fn _bypass_hint_lines(finding):executor=code {
  category = _category(finding)
  hints = hints.loader.hints_for(category)   // from ./inputs/validator_hints.yaml, see inputs/validator_hints.sudo.md
  if (!hints) return []
  return ["- **Known bypass patterns for $category**:", ...hints as "  - $hint"]
}
