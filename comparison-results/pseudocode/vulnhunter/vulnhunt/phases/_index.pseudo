// file: vulnhunt/phases/
// The phase prompt file set of the /vulnhunt skill and how phases are loaded: install.sh copies vulnhunt/ to
// ~/.claude/skills/vulnhunt; the orchestrator resolves PHASES_DIR and each subagent Reads its own phase file.

@executedBy(MIXED) @role(config) @stage("orchestrator")
class PhasesIndex {

    // PHASES_DIR = <CLAUDE_SKILL_DIR>/phases/ (SKILL.md Phase Loading Instructions).
    @executedBy(MODEL)
    String phasesDir(Theta θ) {
        return θ["p.skill_vulnhunt.phases_dir"];                                                 // src: vulnhunt/SKILL.md:324
    }

    // The full phase file set, with who reads each one and the class that renders it.
    @executedBy(CODE)
    List<String> phaseFiles(Theta θ) {
        List<String> files = new List();
        files.add("phase1_recon.md");          // recon subagent -> Phase1Recon.run              // src: vulnhunt/SKILL.md:341
        files.add("phase2_hunt.md");           // orchestrator dispatch procedure -> Phase2Hunt.run // src: vulnhunt/SKILL.md:342
        files.add("phase2_shared.md");         // every trace agent -> Phase2Shared               // src: vulnhunt/SKILL.md:343
        files.addAll(classFiles(θ));           // one per class-group trace agent                 // src: vulnhunt/SKILL.md:344
        files.add("phase2b_verify.md");        // verify subagent -> Phase2bVerify.run            // src: vulnhunt/SKILL.md:345
        files.add("phase3_reproduce_test.md"); // phase 3 subagent -> Phase3ReproduceTest.run     // src: vulnhunt/SKILL.md:346
        files.add("phase3c_fixes.md");         // same phase 3 subagent -> Phase3cFixes.run       // src: vulnhunt/SKILL.md:347
        files.add("phase3d_sweep.md");         // sweep subagent -> Phase3dSweep.run              // src: vulnhunt/SKILL.md:348
        files.add("phase4_report.md");         // orchestrator report format -> Phase4Report.run  // src: vulnhunt/SKILL.md:349
        return files;
    }

    // Per-class sink references and class-specific gate rules: inj, nav, log (Phase2ClassInj/Nav/Log).
    @executedBy(CODE)
    List<String> classFiles(Theta θ) {
        return θ["prompt.class_files"];                                                          // src: vulnhunt/phases/phase2_hunt.md:20
    }

    // Loading: install copies the skill dir (no symlinks); a missing phase file is fatal to the workflow.
    @executedBy(MIXED)
    String load(String name, Theta θ) {
        String path = phasesDir(θ) + name;                                                       // src: vulnhunt/SKILL.md:324
        String text = read(path);                                                                // src: install.sh:121
        if (text == null && θ["p.skill_vulnhunt.missing_phase_file_fatal"]) stopWorkflow("Phase file not found at " + path); // src: vulnhunt/SKILL.md:329
        return text;
    }
}
