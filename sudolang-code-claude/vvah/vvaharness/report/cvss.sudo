# vvaharness/report/cvss.py

CVSS 3.1 base-score calculator (FIRST.org specification section 7) and the single home of its metric weights and coefficients. Used to score model-written vectors and by the environmental score in `appcontext.py`.

Source: `vvaharness/report/cvss.py` (lines 1-126)
Executor: code
Called from: `vvaharness/report/appcontext.py`, `vvaharness/orchestrator/enrich_findings.py`, `vvaharness/pipeline/stages/s6/outcomes.py`, `vvaharness/pipeline/stages/s8/outcomes.py`, `vvaharness/pipeline/stages/s9/typed_sarif.py`

// src: vvaharness/report/cvss.py:20-54
Options weights {
  _VECTOR_RE: /CVSS:3\.[01]\/AV:[NALP]\/AC:[LH]\/PR:[NLH]\/UI:[NR]\/S:[UC]\/C:[NLH]\/I:[NLH]\/A:[NLH]/   // 3.0 and 3.1 prefixes both accepted
  AV: { N: 0.85, A: 0.62, L: 0.55, P: 0.2 }
  AC: { L: 0.77, H: 0.44 }
  PR_SCOPE_UNCHANGED: { N: 0.85, L: 0.62, H: 0.27 }
  PR_SCOPE_CHANGED: { N: 0.85, L: 0.68, H: 0.50 }
  UI: { N: 0.85, R: 0.62 }
  CIA: { H: 0.56, L: 0.22, N: 0.0 }
  REQ: { H: 1.5, L: 0.5 }
  EXPLOIT_MATURITY: { U: 0.91, P: 0.94, F: 0.97, H: 1.0 }
  REMEDIATION_LEVEL: { O: 0.95, T: 0.96, W: 0.97, U: 1.0 }
  REPORT_CONFIDENCE: { U: 0.92, R: 0.96, C: 1.0 }
  NEUTRAL_WEIGHT: 1.0, NO_SCORE: -1.0, MAX_SCORE: 10.0, MISS_CAP: 0.915
  SEVERITY_BANDS: [[4.0, "Low"], [7.0, "Medium"], [9.0, "High"]]
  EXPLOITABILITY_COEFF: 8.22, IMPACT_SCOPE_UNCHANGED_COEFF: 6.42, IMPACT_SCOPE_CHANGED_COEFF: 7.52
  IMPACT_OFFSET: 0.029, IMPACT_PENALTY_COEFF: 3.25, IMPACT_PENALTY_OFFSET: 0.02
  BASE_IMPACT_EXPONENT: 15, MODIFIED_IMPACT_EXPONENT: 13, MODIFIED_IMPACT_MISS_CORRECTION: 0.9731
  SCOPE_CHANGED_COEFF: 1.08
  ROUNDUP_SCALE: 100000, ROUNDUP_STEP: 10000, ROUNDUP_STEPS_PER_UNIT: 10.0
}

// src: vvaharness/report/cvss.py:91-108
fn score(vector):executor=code {
  if (!vector) return null
  g = first _VECTOR_RE match in vector; if (!g) return null   // unparseable -> null
  scope_changed = g.S == "C"
  iss = 1 - (1 - CIA[g.C]) * (1 - CIA[g.I]) * (1 - CIA[g.A])
  impact = base_impact(iss, scope_changed)
  if (impact <= 0) return 0.0
  pr = (if (scope_changed) PR_SCOPE_CHANGED else PR_SCOPE_UNCHANGED)[g.PR]
  exploitability = 8.22 * AV[g.AV] * AC[g.AC] * pr * UI[g.UI]
  return combine(impact, exploitability, scope_changed)
}

// src: vvaharness/report/cvss.py:65-70
fn base_impact(iss, scope_changed):executor=code {
  return if (!scope_changed) 6.42 * iss else 7.52 * (iss - 0.029) - 3.25 * (iss - 0.02) ^ 15
}

// src: vvaharness/report/cvss.py:73-80
fn modified_impact(miss, scope_changed):executor=code {
  return if (!scope_changed) 6.42 * miss else 7.52 * (miss - 0.029) - 3.25 * (miss * 0.9731 - 0.02) ^ 13
}

// src: vvaharness/report/cvss.py:83-88
fn combine(impact, exploitability, scope_changed):executor=code {
  raw = impact + exploitability
  if (scope_changed) raw *= 1.08
  return roundup1(min(raw, MAX_SCORE))
}

// src: vvaharness/report/cvss.py:57-62
fn roundup1(x):executor=code {
  n = round(x * 100000)
  return if (n % 10000 == 0) n / 100000 else (floor(n / 10000) + 1) / 10.0   // round the scaled value, never truncate
}

// src: vvaharness/report/cvss.py:111-114
fn score_or_sentinel(vector):executor=code { return score(vector) or, when absent, NO_SCORE }

// src: vvaharness/report/cvss.py:117-126
fn rating(s):executor=code {
  // not sentinel-safe: callers guard with s >= 0 first
  if (s == null) return "Unknown"
  if (s == 0.0) return "None"
  for each [upper, label] in SEVERITY_BANDS { if (s < upper) return label }
  return "Critical"
}
