// file: vvaharness/pipeline/stages/s4/batching.py
// Groups S4 investigation units into shared sessions, preferring units whose files overlap.
// LARGE units always run alone.

@executedBy(CODE) @role(step) @stage("S4")
class S4Batching {

    List<List<InvestigationUnit>> planBatches(List<InvestigationUnit> units, int size, Theta θ) {
        size = θ["step4.batch_size"];          // units per shared session (caller passes the same capped value) // src: vvaharness/pipeline/stages/s4_deepdive.py:367
        if (size <= 1) return units.map(u -> List.of(u));                                                // src: vvaharness/pipeline/stages/s4/batching.py:36
        List<InvestigationUnit> ordered = units.sortedBy(u -> Pair.of(u.riskRank, u.id));                // src: vvaharness/pipeline/stages/s4/batching.py:38
        // LARGE units run alone: a shared session re-sends every member's code every turn
        List<List<InvestigationUnit>> large = ordered.filter(u -> u.size == UnitSize.LARGE).map(u -> List.of(u)); // src: vvaharness/pipeline/stages/s4/batching.py:40
        List<InvestigationUnit> pool = ordered.filter(u -> u.size != UnitSize.LARGE);                    // src: vvaharness/pipeline/stages/s4/batching.py:41
        List<List<InvestigationUnit>> batches = new List();
        while (!pool.isEmpty()) {                                                                        // src: vvaharness/pipeline/stages/s4/batching.py:43
            List<InvestigationUnit> batch = List.of(pool.removeFirst());                                 // src: vvaharness/pipeline/stages/s4/batching.py:44
            while (!pool.isEmpty() && batch.size() < size) {                                             // src: vvaharness/pipeline/stages/s4/batching.py:45
                InvestigationUnit partner = bestPartner(batch, pool);
                pool.remove(partner);
                batch.add(partner);                                                                      // src: vvaharness/pipeline/stages/s4/batching.py:46
            }
            batches.add(batch);
        }
        return concat(batches, large);                                                                   // src: vvaharness/pipeline/stages/s4/batching.py:48
    }

    // The pooled unit sharing most files with the seed; ties break on risk rank then id.
    InvestigationUnit bestPartner(List<InvestigationUnit> seed, List<InvestigationUnit> pool) {
        Set<String> seedFiles = seed.flatMap(u -> u.files).toSet();                                      // src: vvaharness/pipeline/stages/s4/batching.py:30
        return pool.minBy(u -> Triple.of(-intersect(seedFiles, u.files).size(), u.riskRank, u.id));      // src: vvaharness/pipeline/stages/s4/batching.py:31
    }

    int overlap(InvestigationUnit a, InvestigationUnit b) {
        return intersect(a.files, b.files).size();                                                       // src: vvaharness/pipeline/stages/s4/batching.py:24
    }
}
