# vvaharness/pipeline/stages/s11_validate.py

Stage 11 entry point. A thin wrapper that runs the validation package (`vvaharness/validation/`) against the case records Stage 10 left under `security-remediation/`, then records a case rollup on a best-effort basis.

Source: `vvaharness/pipeline/stages/s11_validate.py` (lines 1-53)
Executor: code (the validation package it invokes is outside this batch)
Called from: `vvaharness/orchestrator/scan.py` _run_validation (Stage 11)

// src: vvaharness/pipeline/stages/s11_validate.py:25-53
fn run(repo, cfg, config_path, finding_ids?, resume=false, report_md?, progress?):executor=code {
  // cfg is accepted for the orchestrator's keyword contract but is not used here
  argv = ["--repo", string(repo)]
  if (config_path) argv += ["--config", string(config_path)]
  if (report_md) argv += ["--scan-report", string(report_md)]
  for each finding_id in finding_ids or [], argv += ["--finding", finding_id];
  if (resume) append "--resume" to argv
  code = if (progress != null) validation.cli.main(argv, progress=progress) else validation.cli.main(argv)   // outside this batch: vvaharness/validation/cli.py
  // src: s11_validate.py:47-52 — best effort: neither the rollup nor its import may change the exit code
  try orchestrator.case_rollup.record(repo);
  catch any error => ignore
  return code
}
