// file: vulnhunter-fix/scripts/compute-completeness-tier.py
// Deterministic completeness-tier classifier (REQ-HON-004): walks WORKAROUND -> MITIGATION -> FULL signals on a
// diff + fix plan + result and never silently picks FULL; unresolved cases return LLM_REVIEW for tier_judgment.

@executedBy(CODE) @role(evaluation) @stage("fix")
class ComputeCompletenessTier {

    // plan.pseudo / worker_agent_common.pseudo call run(diff, plan, phase)
    Map run(String diff, Map plan, String phase, Theta θ) {
        return classify(diff, plan != null ? plan : Map.of(), phase, Map.of(), θ);                        // src: vulnhunter-fix/scripts/compute-completeness-tier.py:259
    }

    String readDiff(String path) {
        if (path == "-") return Stdin.read();                                                             // src: vulnhunter-fix/scripts/compute-completeness-tier.py:58
        return Files.readReplacingErrors(path);
    }

    Map readPlan(String path) {
        if (path == null) return Map.of();                                                                // src: vulnhunter-fix/scripts/compute-completeness-tier.py:64
        return Json.parse(Files.read(path));
    }

    List<String> diffAddedLines(String diff) {
        return diff.lines().filter(l -> l.startsWith("+") && !l.startsWith("+++")).map(l -> l.substring(1)); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:72
    }

    List<String> diffRemovedLines(String diff) {
        return diff.lines().filter(l -> l.startsWith("-") && !l.startsWith("---")).map(l -> l.substring(1)); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:82
    }

    List<String> filesChanged(String diff) {
        return diff.lines().regexGroups("^\\+\\+\\+ b/(.+)$");                                            // src: vulnhunter-fix/scripts/compute-completeness-tier.py:92
    }

    List<String> checkWorkaroundSignals(String diff, Map plan, Theta θ) {
        List<String> signals = List.of();
        String added = String.join("\n", diffAddedLines(diff)).lower();                                   // src: vulnhunter-fix/scripts/compute-completeness-tier.py:100
        List<String> files = filesChanged(diff);
        // rate limiter added but no new function / return in the added code
        if (Regex.search(θ["code.fix.scripts.compute_completeness_tier.rate_limit_regex"], added)) {      // src: vulnhunter-fix/scripts/compute-completeness-tier.py:103
            if (!Regex.search("\\bdef\\s+\\w+\\s*\\(|\\bfunc\\s+\\w+\\s*\\(|\\breturn\\s+(?:new)?", added)) signals.add("workaround.rate_limit_upstream_of_sink"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:104
        }
        // feature flag flipped and every changed file is config
        if (Regex.search(θ["code.fix.scripts.compute_completeness_tier.feature_flag_regex"], added)) {    // src: vulnhunter-fix/scripts/compute-completeness-tier.py:107
            if (!files.isEmpty() && files.all(f -> f.endsWithAny(θ["code.fix.scripts.compute_completeness_tier.config_file_exts"]))) signals.add("workaround.feature_flag_flipped_off"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:108
        }
        if (!files.isEmpty() && files.all(f -> f.endsWith(".md"))) signals.add("workaround.documentation_only"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:111
        // logging / warning header added without any reject path
        if (Regex.search(θ["code.fix.scripts.compute_completeness_tier.log_or_header_regex"], added)) {   // src: vulnhunter-fix/scripts/compute-completeness-tier.py:114
            if (!Regex.search(θ["code.fix.scripts.compute_completeness_tier.reject_regex"], added)) signals.add("workaround.log_or_header_without_reject"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:115
        }
        return signals;
    }

    List<String> checkMitigationSignals(String diff, Map plan, Theta θ) {
        List<String> signals = List.of();
        String added = String.join("\n", diffAddedLines(diff)).lower();                                   // src: vulnhunter-fix/scripts/compute-completeness-tier.py:123
        if (Regex.search("if\\s+len\\(\\w+\\)\\s*[<>]=?\\s*\\d+", added) || Regex.search("maxlength\\s*[:=]\\s*\\d+", added)) signals.add("mitigation.length_or_complexity_cap"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:125
        if (Regex.search("whitelist|allow[_ ]?list|allowed[_ ]?patterns", added) && Regex.search("else\\s*:|elif\\s", added)) signals.add("mitigation.partial_input_sanitization"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:128
        if (plan.get("crypto_trust_chain") != null) {
            Map tc = plan.get("crypto_trust_chain");                                                      // src: vulnhunter-fix/scripts/compute-completeness-tier.py:132
            // any of these explicitly false -> incomplete chain
            if (θ["code.fix.scripts.compute_completeness_tier.crypto_trust_chain_keys"].any(k -> tc.get(k) == false)) signals.add("mitigation.crypto_trust_chain_incomplete"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:133
        }
        return signals;
    }

    List<String> checkFullSignals(String diff, Map plan, Map result, Theta θ) {
        List<String> signals = List.of();
        String addedText = String.join("\n", diffAddedLines(diff));
        String removedText = String.join("\n", diffRemovedLines(diff));
        String sigRe = "^\\s*(?:def|func|public|private|protected|fn)\\s+\\w+\\s*\\([^)]*\\)";            // src: vulnhunter-fix/scripts/compute-completeness-tier.py:147
        if (Regex.searchMultiline(sigRe, addedText) && Regex.searchMultiline(sigRe, removedText)) signals.add("full.sink_signature_changed"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:149
        // superset over zero routed callers is vacuous: require a non-empty routed set in the result
        List<String> routed = result.getOr("callers_routed_through_fix", List.of());                       // src: vulnhunter-fix/scripts/compute-completeness-tier.py:157
        if (plan.get("callers_routed_coverage") == "superset" && !routed.isEmpty()) signals.add("full.callers_routed_through_fix"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:158
        // discrimination evidence from result first, plan as backward-compat fallback
        Map disc = result.getOr("discrimination_evidence", plan.getOr("discrimination_evidence", Map.of())); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:164
        if (disc.get("pre_fix_result") == "fail" && disc.get("post_fix_result") == "pass" && disc.get("method") != null && disc.get("assertion_target") != null) signals.add("full.test_discriminates"); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:168
        return signals;
    }

    Map classify(String diff, Map plan, String phase, Map result, Theta θ) {
        // conservative-first walk; the first lower tier with any signal wins
        List<String> workaround = checkWorkaroundSignals(diff, plan, θ);                                  // src: vulnhunter-fix/scripts/compute-completeness-tier.py:181
        if (!workaround.isEmpty()) return Map.of("tier", "WORKAROUND", "signals", workaround, "phase", phase); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:183
        List<String> mitigation = checkMitigationSignals(diff, plan, θ);                                  // src: vulnhunter-fix/scripts/compute-completeness-tier.py:190
        if (!mitigation.isEmpty()) return Map.of("tier", "MITIGATION", "signals", mitigation, "phase", phase); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:192
        Set<String> matched = checkFullSignals(diff, plan, result, θ).toSet();                            // src: vulnhunter-fix/scripts/compute-completeness-tier.py:199
        // FULL only when all required signals hold cumulatively
        if (matched.containsAll(θ["code.fix.scripts.compute_completeness_tier.required_full_signals"])) return Map.of("tier", "FULL", "signals", matched.sorted(), "phase", phase); // src: vulnhunter-fix/scripts/compute-completeness-tier.py:206
        // never silently FULL: escalate to prompts/tier_judgment
        return Map.of("tier", "LLM_REVIEW", "signals", matched.sorted(), "phase", phase);                 // src: vulnhunter-fix/scripts/compute-completeness-tier.py:215
    }

    // note: HAND_WAVE_PATTERNS is defined at line 47 but never used by this script
    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/compute-completeness-tier.py:228
        String phase = args.phase != null ? args.phase : "plan";                                          // src: vulnhunter-fix/scripts/compute-completeness-tier.py:232
        String diff;
        try {
            diff = readDiff(args.diff);                                                                   // src: vulnhunter-fix/scripts/compute-completeness-tier.py:236
        } catch (OSError e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/compute-completeness-tier.py:239
        }
        Map plan;
        try {
            plan = readPlan(args.plan);                                                                   // src: vulnhunter-fix/scripts/compute-completeness-tier.py:242
        } catch (OSError e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/compute-completeness-tier.py:245
        } catch (JSONDecodeError e) {
            return 3;                                                                                     // src: vulnhunter-fix/scripts/compute-completeness-tier.py:248
        }
        Map result;
        try {
            result = readPlan(args.result);                                                               // src: vulnhunter-fix/scripts/compute-completeness-tier.py:251
        } catch (OSError e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/compute-completeness-tier.py:254
        } catch (JSONDecodeError e) {
            return 3;                                                                                     // src: vulnhunter-fix/scripts/compute-completeness-tier.py:257
        }
        print(Json.dump(classify(diff, plan, phase, result, θ)));                                         // src: vulnhunter-fix/scripts/compute-completeness-tier.py:259
        return 0;
    }
}
