// file: vvaharness/remediation_agent/models/verdict.py
// The per-finding RemediationVerdict contract (frozen prompt schema), its salvage-not-raise coercion,
// and the translation to the shared RemediationEvidence contract.

@executedBy(CODE) @role(types)
enum Verdict { FIXED, PARTIALLY_FIXED, NOT_FIXED, FALSE_POSITIVE, NEEDS_REVIEW, DENIED }

@executedBy(CODE) @role(types)
record RemediationVerdict(int findingIndex, Verdict verdict, RemediationAgentModelsGates gates, String rootCause, List<Change> changes, List<String> remainingRisks, List<String> recommendations, String summary) {
    // finding_index default 0; verdict default "Needs Review"; gates default all fail;        // src: vvaharness/remediation_agent/models/verdict.py:48
    // root_cause: one paragraph citing file:line; changes: applied (fix) or proposed (report-only);  // src: vvaharness/remediation_agent/models/verdict.py:51
    // recommendations: code-level only, no operational controls; summary: 2-4 sentences.           // src: vvaharness/remediation_agent/models/verdict.py:56
}

@executedBy(CODE) @role(types) @stage("S10")
class ModelsVerdict {

    String schemaJsonCompact() {
        return Json.dumpCompact(Pydantic.jsonSchema(RemediationVerdict));                                     // src: vvaharness/remediation_agent/models/verdict.py:64  (embedded in the SYSTEM prompt)
    }

    RemediationVerdict coerce(Object data, int findingIndex, Theta θ) {
        // Salvage a possibly imperfect agent payload rather than raising.
        if (!(data instanceof Map)) return new RemediationVerdict(findingIndex, θ["code.remediation_agent.models.verdict.fallback_verdict"], null, "", List.of(), List.of(), List.of(), "agent response was not a JSON object"); // src: vvaharness/remediation_agent/models/verdict.py:69
        try {
            RemediationVerdict v = Pydantic.validate(RemediationVerdict, data);                               // src: vvaharness/remediation_agent/models/verdict.py:73
            v.findingIndex = findingIndex;
            return v;                                                                               // src: vvaharness/remediation_agent/models/verdict.py:75
        } catch (Exception e) {
            // fall through to salvage                                                              // src: vvaharness/remediation_agent/models/verdict.py:76
        }
        Map clean = data.filterKeys(k -> RemediationVerdict.fields.contains(k));                    // src: vvaharness/remediation_agent/models/verdict.py:79
        if (!θ["code.remediation_agent.models.verdict.verdict_set"].contains(clean.get("verdict"))) { // src: vvaharness/remediation_agent/models/verdict.py:81
            clean.put("verdict", θ["code.remediation_agent.models.verdict.fallback_verdict"]);      // src: vvaharness/remediation_agent/models/verdict.py:82
        }
        RemediationVerdict v;
        try {
            v = Pydantic.validate(RemediationVerdict, clean);                                                 // src: vvaharness/remediation_agent/models/verdict.py:84
        } catch (Exception e) {
            // Last resort: defaults plus whichever fields can be set one by one.
            v = new RemediationVerdict(0, θ["code.remediation_agent.models.verdict.fallback_verdict"], null, "", List.of(), List.of(), List.of(), "agent verdict could not be fully validated; salvaged available fields"); // src: vvaharness/remediation_agent/models/verdict.py:86
            for (String k : clean.keys()) {                                                         // src: vvaharness/remediation_agent/models/verdict.py:89
                try {
                    v.set(k, clean.get(k));                                                         // src: vvaharness/remediation_agent/models/verdict.py:91
                } catch (Exception e2) {
                    // skip invalid field                                                           // src: vvaharness/remediation_agent/models/verdict.py:93
                }
            }
        }
        v.findingIndex = findingIndex;                                                              // src: vvaharness/remediation_agent/models/verdict.py:94
        return v;
    }

    RemediationOutcome outcomeOf(Verdict v) {
        // Total over the Verdict set: an unmapped phrase raises rather than guessing.
        return Map.of(FIXED, RemediationOutcome.FIXED, PARTIALLY_FIXED, RemediationOutcome.PARTIALLY_FIXED, NOT_FIXED, RemediationOutcome.NOT_FIXED, FALSE_POSITIVE, RemediationOutcome.FALSE_POSITIVE, NEEDS_REVIEW, RemediationOutcome.NEEDS_REVIEW, DENIED, RemediationOutcome.DENIED).get(v); // src: vvaharness/remediation_agent/models/verdict.py:99
    }

    List<GateAssessment> gateAssessments(RemediationAgentModelsGates gates) {
        // The prompt asks for exactly these three gates, in this order.
        return List.of("source", "sink", "missing_control").map(name -> new GateAssessment(name, Pydantic.coerceEnum(GateStatus, gates.get(name)))); // src: vvaharness/remediation_agent/models/verdict.py:109
    }

    RemediationEvidence toEvidence(RemediationVerdict verdict, Provenance provenance, Theta θ) {
        List<FileChange> changes = verdict.changes.filter(c -> !c.file.isEmpty()).map(c -> new FileChange(c.file, c.summary)); // src: vvaharness/remediation_agent/models/verdict.py:127  (changes with empty file dropped)
        return new RemediationEvidence(outcomeOf(verdict.verdict), verdict.summary, verdict.rootCause, changes, gateAssessments(verdict.gates), verdict.remainingRisks, verdict.recommendations, provenance); // src: vvaharness/remediation_agent/models/verdict.py:123
    }
}
