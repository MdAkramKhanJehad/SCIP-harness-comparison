# vvaharness/pipeline/stages/s4/batching.py

Groups Stage 4 investigation units into shared sessions of at most `step4.batch_size`, preferring units whose files overlap. LARGE units always run alone.

Source: `vvaharness/pipeline/stages/s4/batching.py` (lines 1-48)
Executor: code
Called from: `vvaharness/pipeline/stages/s4_deepdive.py` run (parallel path)

// src: vvaharness/pipeline/stages/s4/batching.py:34-48
fn plan_batches(units, size):executor=code {
  if (size <= 1) return each unit as its own batch   // input order kept (run already sorted by risk_rank)
  ordered = units sorted by (risk_rank, id)
  // LARGE units run alone: a shared session re-sends every member's code every turn
  large = each unit in ordered with size == UnitSize.LARGE, as its own batch
  pool = units in ordered with size != UnitSize.LARGE
  batches = []
  while (pool is not empty) {
    batch = [take the first unit from pool]
    while (pool is not empty && length(batch) < size) {
      batch += take _best_partner(batch, pool) from pool
    }
    batches += batch
  }
  return batches + large   // LARGE singletons come after all shared batches
}

// src: vvaharness/pipeline/stages/s4/batching.py:27-31
fn _best_partner(seed, pool):executor=code {
  seed_files = union of files of every unit in seed
  return the pool unit minimizing (-count(seed_files intersection unit.files), risk_rank, id)
  // most shared files first; ties break on risk, then id
}

