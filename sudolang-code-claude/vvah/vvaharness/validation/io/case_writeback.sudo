# vvaharness/validation/io/case_writeback.py

Computes the persisted verdict for a case from the workspace artifacts and writes it back into the case file (`finding_case.json`). A session failure discards any gates, which makes the verdict INCONCLUSIVE.

Source: `vvaharness/validation/io/case_writeback.py` (lines 1-73)
Executor: code
Called from: `vvaharness/validation/cli/_run.sudo` _run_plan and _record, `vvaharness/validation/case_api.sudo` _judge

// src: vvaharness/validation/io/case_writeback.py:50-62
fn build_verdict(case, workspace, provenance, policy?, session_failed=false):executor=code {
  output_finding = _load_output_finding(workspace, case.case_id)
  gates = if (session_failed) null else io._host_score.load_synthesized_gates(workspace)[case.case_id]
  scored = io._host_score.verdict_for(output_finding, gates, provenance, policy)
  return io._host_score.conformant(scored, policy)
}

// src: vvaharness/validation/io/case_writeback.py:36-47
fn _load_output_finding(workspace, case_id):executor=code {
  try report = ValidationReport.from_file("$workspace/validation_report.json")
  catch OSError, ValueError => { warn "no readable validation report ...; recording INCONCLUSIVE"; return null }
  return first finding with tracking_id == case_id, else report.findings[0] if any, else null
  // preserved: falls back to the first finding even when its tracking_id is a different id; only the narrative is taken from it
}

// src: vvaharness/validation/io/case_writeback.py:65-73
fn write_back_verdict(case, verdict, path):executor=code {
  try { judged = case.with_verdict(verdict); judged.write(path) }   // attaches to the latest attempt; external: vvaharness/models
  catch OSError, ValueError => { warn "could not write verdict back to ..."; return null }
  return judged
}
