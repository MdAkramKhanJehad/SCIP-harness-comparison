# vvaharness/cli/__init__.py

The `vvaharness` command-line entry point. It checks the Python version, loads a trusted `.env`, strips logging flags, prints help, and dispatches to a subcommand. The `scan` path (the default when no command is named) parses arguments, applies the configuration trust gate, installs a SIGTERM handler, and runs `orchestrator.main` inside the run manifest capture.

Source: `vvaharness/cli/__init__.py` (lines 1-284)
Executor: code
Called from: `vvaharness/__main__.py`, the installed `vvaharness` console script

// src: vvaharness/cli/__init__.py:253-284
fn main(argv?):executor=code {
  try {
    err = _paths._check_python()
    require !err => { log PYTHON_UNSUPPORTED; return 2 }
    args = if (argv == null) process arguments else argv
    if (args == ["--version"]) return _version()   // loads no configuration and no environment
    _dotenv._load_dotenv(_paths._repo_from(args))   // the --repo target is the trust boundary for .env
    args = _configure_logging(args)   // removes --log-level / --log-file and applies them
    if (args is empty || args[0] in ["-h", "--help", "help"]) { _print_help(); return 0 }   // never defaults to scan with no arguments
    try return _app.run(_with_command(args));
    catch StoreError => { log STORE_UNUSABLE; return 2 }
  }
  catch KeyboardInterrupt => return 130
}

// src: vvaharness/cli/__init__.py:183-185
fn _with_command(args):executor=code { return if (args[0] in _app.COMMANDS) args else ["scan", ...args] }   // "vvaharness --repo X" means scan

// src: vvaharness/cli/__init__.py:195-250
fn _dispatch(args):executor=code {
  match (args[0]) {
    case "setup" | "init" => return _setup._setup(rest)
    case "doctor" => return _commands._doctor(rest)
    case "estimate" => return _commands._estimate(rest)
    case "gc" => return _commands._gc(rest)
    case "remediate" => return _commands._remediate(rest)
    case "ev-replay" => return _commands._ev_replay(rest)
    case VALIDATE_COMMANDS => return _commands._validate(rest)   // "validate" or "s11"
    case "scan" => args = rest
  }
  // src: cli/__init__.py:219-231 — scan path
  try entry.build_parser().parse_args(args); catch SystemExit => return its code   // argument errors and --help stop before the manifest
  [cfg_path, explicit] = _paths._config_path_from_explicit(args)
  try {
    cfg_path = config_paths.trusted_config(cfg_path, _paths._config_trust_boundary(args), explicit, quiet=true)   // feeds only the manifest record, but an explicit refusal stops here
    config.read_primary(cfg_path)
  }
  catch ConfigPolicyError => { log CONFIG_POLICY_REFUSED; return 2 }
  // src: cli/__init__.py:233-250
  install a SIGTERM handler raising manifest._Terminated(143) only when on the main thread and no non-default handler exists
  constraint OnEveryExit { restore the previous SIGTERM handler if one was installed }
  with manifest.capture(cfg_path, args) as m {
    rc = orchestrator.entry.main(args)
    m.exit_code = rc
  }
  return rc
}

// src: vvaharness/cli/__init__.py:155-181
fn _configure_logging(args):executor=code {
  // "--log-level V", "--log-level=V", "--log-file P", "--log-file=P" are removed from args and passed to logs.configure(level, path)
}

