# vvaharness/validation/execution/pipeline.py

Executes one fix-validation plan: writes the manifest, launches the session, and collects host-recomputed verdicts. Any session failure, or a session that left no readable report, becomes one fail-closed INCONCLUSIVE result with no score.

Source: `vvaharness/validation/execution/pipeline.py` (lines 1-91)
Executor: code (the session it launches contains the model calls)
Called from: `vvaharness/validation/cli/_run.sudo` _run_plan, `vvaharness/validation/case_api.sudo` _judge

// src: vvaharness/validation/execution/pipeline.py:36-40
PlanOutcome { findings: [CollectedFinding]; session_failed: Boolean = false }   // session_failed distinguishes a crash from an honest INCONCLUSIVE

// src: vvaharness/validation/execution/pipeline.py:67-91
fn execute_plan(plan, config, post_results, meta):executor=code {
  stamp = plan.provenance
  create plan.workspace_dir
  manifest = copy of plan.manifest with post_results
  manifest.write("${ plan.workspace_dir }/manifest.json")
  try session.launcher.launch_session(config, manifest, plan.workspace_dir, plan.output_dir)
  catch ValidationSessionError as exc => {
    warn "Validation session failed for <case>: <reason>"
    append "Validation session failed: <case_id>" to meta.errors
    return _unverifiable(plan, exc.reason_string(), stamp)
  }
  collected = io.result_collector.collect_and_enrich(plan.workspace_dir, provenance=stamp, policy=plan.policy)
  require collected is non-empty => return _unverifiable(plan, "Validation session produced no results", stamp)
  return PlanOutcome(findings=collected)
  // other exceptions (for example HarnessCLINotFoundError, which launcher re-raises unwrapped) propagate to the caller
}

// src: vvaharness/validation/execution/pipeline.py:43-64
fn _unverifiable(plan, reason, provenance):executor=code {
  verdict = Verdict { decision: INCONCLUSIVE, rationale: reason, score: null, recommendations: ["Manual review required: $reason"], produced_by: provenance }
  return PlanOutcome(findings=[CollectedFinding(verdict, unverifiable_row(tracking_id=plan.case_id, title=plan.case_id, reason))], session_failed=true)
  // preserved: "produced no results" (session succeeded but no report) is also marked session_failed=true
}
