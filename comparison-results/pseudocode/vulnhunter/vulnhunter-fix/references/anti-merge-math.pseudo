// file: vulnhunter-fix/references/anti-merge-math.md
// Rule book (REQ-GAT-006): the 0.6 grouped-vs-split file-ratio fence that decides whether findings may share one PR.
// Consumed by scripts/anti-merge-check.py (Gate 5, run by scripts/run-gates.py with --strict before deliver.md's gh calls)
// and by the Phase 3 executor / plan.md grouping decision.

@executedBy(MODEL) @role(rule_set) @stage("fix.plan")
class AntiMergeMath {

    // Entry: decide whether proposed group G (n findings) may ship as one PR.
    String apply(Group G, Theta θ) {
        double srcRatio = (double) totalFilesGrouped(G, false, θ) / totalFilesSplit(G, false, θ);
        double testRatio = (double) totalFilesGrouped(G, true, θ) / totalFilesSplit(G, true, θ);
        return outcome(srcRatio, testRatio, θ);
    }

    int totalFilesGrouped(Group G, boolean testFiles, Theta θ) {
        if (θ["p.anti-merge-math.grouped_metric_distinct_files"]) {                              // src: vulnhunter-fix/references/anti-merge-math.md:26
            return G.findings.flatMap(f -> f.touchedFiles(testFiles)).distinct().count();      // src: vulnhunter-fix/references/anti-merge-math.md:26
        }
        return G.findings.flatMap(f -> f.touchedFiles(testFiles)).count();
    }

    int totalFilesSplit(Group G, boolean testFiles, Theta θ) {
        if (θ["p.anti-merge-math.split_metric_sum_per_pr"]) {                                    // src: vulnhunter-fix/references/anti-merge-math.md:29
            return G.findings.sum(f -> f.touchedFiles(testFiles).distinct().count());          // src: vulnhunter-fix/references/anti-merge-math.md:29
        }
        return totalFilesGrouped(G, testFiles, θ);
    }

    // Outcome table (ratio -> action).
    String outcome(double srcRatio, double testRatio, Theta θ) {
        double fence = θ["p.anti-merge-math.group_ratio_threshold"];                            // src: vulnhunter-fix/references/anti-merge-math.md:11
        boolean srcOk = srcRatio <= fence;                                                       // src: vulnhunter-fix/references/anti-merge-math.md:19
        boolean testOk = testRatio <= fence;                                                     // src: vulnhunter-fix/references/anti-merge-math.md:21
        boolean allowed;
        if (θ["p.anti-merge-math.either_ratio_suffices"] == "source OR test ratio") {           // src: vulnhunter-fix/references/anti-merge-math.md:40
            allowed = srcOk || testOk;                                                           // src: vulnhunter-fix/references/anti-merge-math.md:20
        } else {
            allowed = srcOk && testOk;
        }
        if (allowed) {
            return θ["p.anti-merge-math.efficient_group_allowed"];                               // src: vulnhunter-fix/references/anti-merge-math.md:36
        }
        double r = Math.min(srcRatio, testRatio);
        if (r >= 1.0) {                                                                          // literal 1.0: "should be impossible" boundary
            Log.diagnostic("anti-merge ratio >= 1.0", r);
            return θ["p.anti-merge-math.ratio_ge_one_split_and_log"];                            // src: vulnhunter-fix/references/anti-merge-math.md:38
        }
        return θ["p.anti-merge-math.inefficient_group_split"];                                   // src: vulnhunter-fix/references/anti-merge-math.md:37
    }
}
