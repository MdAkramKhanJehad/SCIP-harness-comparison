// file: vvaharness/remediation_agent/report_augment/sarif.py
// Add a properties.remediation block to every result of the SARIF copy; returns the ordinal-to-case map the Markdown pass reuses.

@executedBy(CODE) @role(step) @stage("S10")
class Sarif {

    // Under properties: SARIF 2.1.0 forbids extra result keys; the alias key holds S9-folded twins keyed by case id.
    String BLOCK_KEY = "remediation";                                                                // src: vvaharness/remediation_agent/report_augment/sarif.py:62
    String ALIAS_BLOCK_KEY = "remediationAliases";                                                   // src: vvaharness/remediation_agent/report_augment/sarif.py:63

    // (uri, startLine) of the first location, or empty and -1 when unavailable.
    Tuple resultLoc(Map sarifResult) {
        try {
            Map pl = sarifResult.get("locations").get(0).get("physicalLocation");                    // src: vvaharness/remediation_agent/report_augment/sarif.py:36
            return Tuple.of(pl.get("artifactLocation").get("uri"), Integer.parseInt(pl.get("region").get("startLine"))); // src: vvaharness/remediation_agent/report_augment/sarif.py:39
        } catch (KeyError | IndexError | TypeError | ValueError e) {
            return Tuple.of("", -1);                                                                 // src: vvaharness/remediation_agent/report_augment/sarif.py:42
        }
    }

    // First result whose physical location is exactly (file, line).
    Map matchByLoc(List<Map> results, String file, int line) {
        for (Map r : results) if (resultLoc(r).equals(Tuple.of(file, line))) return r;               // src: vvaharness/remediation_agent/report_augment/sarif.py:45
        return null;
    }

    // First result whose message text starts with the title (prefix, not equality).
    Map matchByTitle(List<Map> results, String title) {
        for (Map r : results) if (String.valueOf(r.get("message", Map.of()).get("text", "")).startsWith(title)) return r; // src: vvaharness/remediation_agent/report_augment/sarif.py:53
        return null;
    }

    String caseIdOf(CaseRecord record) {
        FindingCase c = record.theCase;                                                              // src: vvaharness/remediation_agent/report_augment/sarif.py:66
        if (c == null) return "";                                                                    // src: vvaharness/remediation_agent/report_augment/sarif.py:68
        return String.valueOf(firstTruthy(c.caseId, c.finding != null ? c.finding.caseId : "", "")); // case id, then the finding's case id // src: vvaharness/remediation_agent/report_augment/sarif.py:70
    }

    // Match a SARIF result to a case. Fingerprint wins (survives multi-CWE pileups); location and title exclude results carrying a foreign fingerprint.
    Map matchSarif(List<Map> results, CaseRecord record, Theta θ) {
        Finding finding = Dto.findingOf(record);                                                     // src: vvaharness/remediation_agent/report_augment/sarif.py:73
        if (finding == null) return null;                                                            // synthetic records never match // src: vvaharness/remediation_agent/report_augment/sarif.py:75
        String caseId = caseIdOf(record);                                                            // src: vvaharness/remediation_agent/report_augment/sarif.py:78
        if (!caseId.isEmpty()) {
            for (Map r : results) if (TypedSarif.resultIdentifies(r, caseId)) return r;              // src: vvaharness/remediation_agent/report_augment/sarif.py:80
        }
        List<Map> candidates = results.filter(r -> caseId.isEmpty() || TypedSarif.resultFingerprint(r).isEmpty() || TypedSarif.resultIdentifies(r, caseId)); // src: vvaharness/remediation_agent/report_augment/sarif.py:83
        Map byLoc = !finding.file.isEmpty() ? matchByLoc(candidates, finding.file, finding.lineStart) : null; // location only when the finding has a file // src: vvaharness/remediation_agent/report_augment/sarif.py:85
        if (byLoc != null) return byLoc;                                                             // src: vvaharness/remediation_agent/report_augment/sarif.py:87
        String title = finding.title.strip();                                                        // src: vvaharness/remediation_agent/report_augment/sarif.py:90
        return !title.isEmpty() ? matchByTitle(candidates, title) : null;                            // src: vvaharness/remediation_agent/report_augment/sarif.py:92
    }

    Map<Integer, CaseRecord> augmentSarif(Path path, List<CaseRecord> records, Theta θ) {
        Map doc = Json.loads(path.readText("utf-8"));                                                // src: vvaharness/remediation_agent/report_augment/sarif.py:95
        List runs = firstTruthy(doc.get("runs"), List.of(Map.of()));                                 // src: vvaharness/remediation_agent/report_augment/sarif.py:97
        List<Map> results = !runs.isEmpty() ? runs.get(0).get("results", List.of()) : List.of();     // only the first run is augmented // src: vvaharness/remediation_agent/report_augment/sarif.py:99
        Set<Object> matchedIds = new HashSet();
        Map<Integer, CaseRecord> ordinalMatches = new HashMap();
        Set<Integer> ordinalCollisions = new HashSet();                                              // a result claimed by two different records is unsafe for either: drop both // src: vvaharness/remediation_agent/report_augment/sarif.py:100
        int byPrint = 0; int aliased = 0;                                                            // src: vvaharness/remediation_agent/report_augment/sarif.py:102
        for (CaseRecord record : records) {                                                          // src: vvaharness/remediation_agent/report_augment/sarif.py:104
            Map match = matchSarif(results, record, θ);                                              // src: vvaharness/remediation_agent/report_augment/sarif.py:105
            if (match == null) continue;                                                             // src: vvaharness/remediation_agent/report_augment/sarif.py:107
            for (int idx = 0; idx < results.size(); idx++) {                                         // identity comparison // src: vvaharness/remediation_agent/report_augment/sarif.py:109
                if (results.get(idx) == match) {
                    int ordinal = idx + 1;                                                           // 1-based // src: vvaharness/remediation_agent/report_augment/sarif.py:111
                    CaseRecord prior = ordinalMatches.get(ordinal);                                  // src: vvaharness/remediation_agent/report_augment/sarif.py:113
                    if (prior != null && prior != record) ordinalCollisions.add(ordinal);            // src: vvaharness/remediation_agent/report_augment/sarif.py:114
                    else ordinalMatches.put(ordinal, record);                                        // src: vvaharness/remediation_agent/report_augment/sarif.py:116
                    break;
                }
            }
            String caseId = caseIdOf(record);                                                        // src: vvaharness/remediation_agent/report_augment/sarif.py:118
            if (!caseId.isEmpty() && TypedSarif.resultIdentifies(match, caseId)) byPrint++;          // src: vvaharness/remediation_agent/report_augment/sarif.py:119
            if (!TypedSarif.recordResultBlock(match, caseId, Dto.remediationBlock(record, θ), BLOCK_KEY, ALIAS_BLOCK_KEY)) { // false when recorded under the alias key // src: vvaharness/remediation_agent/report_augment/sarif.py:121
                aliased++;
                continue;                                                                            // an aliased match is not counted as matched // src: vvaharness/remediation_agent/report_augment/sarif.py:123
            }
            matchedIds.add(identity(match));                                                         // src: vvaharness/remediation_agent/report_augment/sarif.py:125
        }
        for (int ordinal : ordinalCollisions) ordinalMatches.remove(ordinal);                        // src: vvaharness/remediation_agent/report_augment/sarif.py:127
        Console.write("[s10] SARIF augment: matched count, by fingerprint, aliased");                // summary line only; aliased part shown when nonzero // src: vvaharness/remediation_agent/report_augment/sarif.py:128
        Map skipped = Dto.remediationBlock(Dto.skippedRecord(), θ);                                  // unprocessed findings get an explicit skipped block // src: vvaharness/remediation_agent/report_augment/sarif.py:130
        for (Map r : results) {                                                                      // src: vvaharness/remediation_agent/report_augment/sarif.py:132
            if (!matchedIds.contains(identity(r))) r.setdefault("properties", Map.of()).put(BLOCK_KEY, Map.copyOf(skipped)); // overwrites any block already present on an aliased or unmatched result // src: vvaharness/remediation_agent/report_augment/sarif.py:133
        }
        path.writeText(Json.dumps(doc, 2) + "\n", "utf-8");                                          // src: vvaharness/remediation_agent/report_augment/sarif.py:135
        return ordinalMatches;                                                                       // src: vvaharness/remediation_agent/report_augment/sarif.py:137
    }
}
