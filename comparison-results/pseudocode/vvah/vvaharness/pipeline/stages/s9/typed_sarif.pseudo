            dupKeys = enumerate(report.findings).map((k, rf0) -> dupResultKey(rf0.finding, labels.get(k).first, msgs.get(k))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:199
            List<Tuple> ranks = report.findings.map(rf0 -> survivorRank(rf0));                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:201
            for (int i0 : range(report.findings.size())) {                                      // src: vvaharness/pipeline/stages/s9/typed_sarif.py:202
                Integer held = winnerOf.get(dupKeys.get(i0));                                   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:203
                if (held == null || ranks.get(i0) < ranks.get(held)) winnerOf.put(dupKeys.get(i0), i0); // strictly stronger replaces, a tie keeps the first // src: vvaharness/pipeline/stages/s9/typed_sarif.py:204
            }
            for (int i0 : range(report.findings.size())) {                                      // src: vvaharness/pipeline/stages/s9/typed_sarif.py:206
                RankedFinding rf0 = report.findings.get(i0);
                int wonBy = winnerOf.get(dupKeys.get(i0));                                      // src: vvaharness/pipeline/stages/s9/typed_sarif.py:207
                if (wonBy != i0 && !rf0.finding.caseId.isEmpty()) aliasIds.setdefault(wonBy, new List()).add(rf0.finding.caseId); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:208
