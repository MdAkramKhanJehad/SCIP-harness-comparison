                    log.warning(Events.PREFLIGHT_PROBE_FAILED, mid, via, effort, upstreamMessage(e));      // src: vvaharness/orchestrator/preflight.py:799
                    skipped.addAll(roles);                                                                  // src: vvaharness/orchestrator/preflight.py:801
