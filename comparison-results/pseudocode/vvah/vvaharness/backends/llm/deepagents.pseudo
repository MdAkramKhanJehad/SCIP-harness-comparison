    /** Stop the harness loop at interpreter exit and join its thread. */
    @src("vvaharness/backends/llm/deepagents.py:182")
    void shutdownLoop() {
        synchronized (LOOP_LOCK) { /* snapshot loop and thread */ }                                         // src: vvaharness/backends/llm/deepagents.py:184
        if (loop == null || loopThread == null) return;                                                     // src: vvaharness/backends/llm/deepagents.py:186
        loop.callSoonThreadsafe(loop.stop);                                                                 // src: vvaharness/backends/llm/deepagents.py:188
        loopThread.join(θ["code.backends.llm.deepagents.loop_join_timeout_s"]);                             // src: vvaharness/backends/llm/deepagents.py:189
    }

    /** The module's persistent event loop, started on a daemon thread on first use. */
    @src("vvaharness/backends/llm/deepagents.py:192")
    EventLoop harnessLoop() {
        synchronized (LOOP_LOCK) {
            if (loop != null) return loop;                                                                  // src: vvaharness/backends/llm/deepagents.py:196
            EventLoop newLoop = EventLoop.create();                                                         // src: vvaharness/backends/llm/deepagents.py:198
            Thread thread = Thread.daemon(newLoop.runForever, "vvaharness-llm-deepagents");                 // src: vvaharness/backends/llm/deepagents.py:199
            thread.start();
            Runtime.atexit(this::shutdownLoop);                                                             // src: vvaharness/backends/llm/deepagents.py:203
            loop = newLoop; loopThread = thread;                                                            // src: vvaharness/backends/llm/deepagents.py:204
            return loop;
        }
    }

    /** Run a coroutine on the persistent harness loop, blocking until it completes. */
    @src("vvaharness/backends/llm/deepagents.py:208")
    Object runSync(Coroutine awaitable, Double timeout, String tag, String effort) {
        // blocking is load-bearing for token bucketing (invariant 2); timeout is preflight's probe and the session clock
        EventLoop theLoop = harnessLoop();                                                                  // src: vvaharness/backends/llm/deepagents.py:215
        if (Thread.current() == loopThread) {
            awaitable.close();                                                                              // src: vvaharness/backends/llm/deepagents.py:217
            throw new RuntimeError("runSync called from the harness loop thread - this would deadlock");   // src: vvaharness/backends/llm/deepagents.py:218
        }
        Future future = theLoop.runCoroutineThreadsafe(awaitable);                                          // src: vvaharness/backends/llm/deepagents.py:221
        double start = Clock.monotonic();                                                                   // src: vvaharness/backends/llm/deepagents.py:222
        Object result;
        try {
            result = future.result(timeout);                                                                // src: vvaharness/backends/llm/deepagents.py:224
        } catch (BaseException exc) {
            boolean cancelled = future.cancel();                                                            // on Ctrl-C or timeout the harness call must stop billing // src: vvaharness/backends/llm/deepagents.py:227
            // TimeoutError is builtins.TimeoutError on 3.11: cancelled=True is the only way to tell the deadline was hit from the coroutine raising it; a sub-millisecond race window is accepted (bare TimeoutError, no VVAH-E008)
            if (exc instanceof TimeoutError && cancelled) throw LlmModels.callTimeoutError(tag != null ? tag : "", "deepagents", timeout, effort, "deepagents session exceeded the clock"); // src: vvaharness/backends/llm/deepagents.py:234
            throw exc;                                                                                      // src: vvaharness/backends/llm/deepagents.py:239
        }
        LlmModels.noteBudgetUse(Clock.monotonic() - start, timeout, effort);                                // src: vvaharness/backends/llm/deepagents.py:241
        return result;
    }

    /** Refuse a prompt whose estimate exceeds the route ceiling, before dispatch (VVAH-E004). */
    @src("vvaharness/backends/llm/deepagents.py:262")
    void checkPromptCeiling(String text, String tag) {
        int estimated = Tokens.estimateTokens(text, null);                                                  // src: vvaharness/backends/llm/deepagents.py:264
        if (estimated <= LlmModels.DEEPAGENTS_MAX_PROMPT_TOKENS) return;                                    // src: vvaharness/backends/llm/deepagents.py:265
        Counters.bump(OVERSIZE_PROMPT_COUNTER, 1);                                                          // src: vvaharness/backends/llm/deepagents.py:267
        throw new OversizePromptError("refused before dispatch; reduce what this call packs and re-run", tag != null ? tag : "", estimated, LlmModels.DEEPAGENTS_MAX_PROMPT_TOKENS); // src: vvaharness/backends/llm/deepagents.py:268
    }

    /** (status, body) when the exception chain carries a provider auth failure. */
    @src("vvaharness/backends/llm/deepagents.py:280")
    Pair authFailure(Throwable exc) {
        // failures arrive WRAPPED, so walk the chain; an APIStatusError carries status_code, an APIConnectionError does not: no auth misread
        for (Throwable err : ExceptionChain.exceptionChain(exc)) {                                          // src: vvaharness/backends/llm/deepagents.py:283
            Object status = err.statusCode;
            if (!(status instanceof Integer)) continue;                                                     // src: vvaharness/backends/llm/deepagents.py:285
            String body = err.message != null ? err.message.toString() : err.toString();                    // src: vvaharness/backends/llm/deepagents.py:287
            if (status == HTTP_UNAUTHORIZED || LlmSdk.AUTH_STATUS_RX.search(body)) return Pair.of(status, body); // the sdk backend is the single home of the auth signature // src: vvaharness/backends/llm/deepagents.py:288
        }
        return null;                                                                                        // src: vvaharness/backends/llm/deepagents.py:290
    }

    /** The cause detail when the chain carries a proxy/TLS connection failure. */
    @src("vvaharness/backends/llm/deepagents.py:293")
    String proxyFailure(Throwable exc) {
        for (Throwable err : ExceptionChain.exceptionChain(exc)) {                                          // src: vvaharness/backends/llm/deepagents.py:295
            String detail = err.typeName() == "APIConnectionError" ? LlmModels.proxyDetail(err) : null;     // src: vvaharness/backends/llm/deepagents.py:296
            if (detail != null && !detail.isEmpty()) return detail;                                         // src: vvaharness/backends/llm/deepagents.py:297
        }
        return null;                                                                                        // src: vvaharness/backends/llm/deepagents.py:298
    }

    /** Map a provider failure onto the VVAH taxonomy, or None when unrecognised. Order: refusal, auth, proxy, tool-state. */
    @src("vvaharness/backends/llm/deepagents.py:301")
    Exception classifyFailure(Throwable exc, String modelId, String tag) {
        // TRAP: redact BEFORE truncating (a bisected JWT stops matching); the VVAH-E006 arm must come LAST
        // refusal FIRST, before any arm that could re-send it; the one permitted resend belongs to dispatch_or_retry_unforced
        Exception refusal = LlmModels.modelRefusalFrom(exc, "deepagents", tag != null ? tag : "");          // src: vvaharness/backends/llm/deepagents.py:312
        if (refusal != null) return refusal;                                                                // src: vvaharness/backends/llm/deepagents.py:314
        String context = "model=" + modelId + (tag != null ? ", stage=" + tag : "");                        // src: vvaharness/backends/llm/deepagents.py:316
        Pair auth = authFailure(exc);                                                                       // src: vvaharness/backends/llm/deepagents.py:317
        if (auth != null) return new AuthenticationError(Redact.redact(auth.second, false, null).substring(0, 400) + " (" + context + ")", auth.first, "deepagents"); // VVAH-E001 // src: vvaharness/backends/llm/deepagents.py:319
        String detail = proxyFailure(exc);                                                                  // src: vvaharness/backends/llm/deepagents.py:326
        if (detail != null) return new ProxyError(Redact.redact(detail, false, null).substring(0, 400) + " (" + context + ")", PROXY_407_RX.search(detail) ? HTTP_PROXY_AUTH : null, "deepagents"); // VVAH-E002 // src: vvaharness/backends/llm/deepagents.py:328
        if (DeepagentsClient.isMissingThoughtSignature(exc)) {                                              // src: vvaharness/backends/llm/deepagents.py:335
            Counters.bump(TOOL_STATE_NOT_ROUNDTRIPPED_COUNTER, 1);                                          // src: vvaharness/backends/llm/deepagents.py:336
            return new ToolStateNotRoundTrippedError("provider rejected a replayed tool call (" + context + ")", tag != null ? tag : "", modelId); // VVAH-E006 // src: vvaharness/backends/llm/deepagents.py:337
        }
        return null;                                                                                        // src: vvaharness/backends/llm/deepagents.py:343
    }

    /** Whether the chain carries a transient worth one more send; an unhealable status ANYWHERE vetoes. */
    @src("vvaharness/backends/llm/deepagents.py:351")
    boolean transientFailure(Throwable exc) {
        boolean transient = false;                                                                          // src: vvaharness/backends/llm/deepagents.py:354
        for (Throwable err : ExceptionChain.exceptionChain(exc)) {                                          // src: vvaharness/backends/llm/deepagents.py:355
            Object status = err.statusCode;
            if (status instanceof Integer && UNHEALABLE_STATUS.contains(status)) return false;              // vetoes, not just on the link with the signal // src: vvaharness/backends/llm/deepagents.py:357
            String body = err.message != null ? err.message.toString() : err.toString();                    // src: vvaharness/backends/llm/deepagents.py:359
            transient = transient || (status instanceof Integer && LlmModels.RETRYABLE_STATUS.contains(status)) || LlmModels.RATE_LIMIT_TRANSIENT_RX.search(body) || LlmModels.SERVER_ERROR_TRANSIENT_RX.search(body); // src: vvaharness/backends/llm/deepagents.py:360
        }
        return transient;                                                                                   // src: vvaharness/backends/llm/deepagents.py:365
    }

    /** The chain's advertised retry-after in seconds when it carries a usable positive number, capped. */
    @src("vvaharness/backends/llm/deepagents.py:368")
    Double retryAfterSeconds(Throwable exc) {
        for (Throwable err : ExceptionChain.exceptionChain(exc)) {                                          // src: vvaharness/backends/llm/deepagents.py:370
            Object headers = err.response != null ? err.response.headers : null;                            // src: vvaharness/backends/llm/deepagents.py:371
            Object raw = headers != null && headers.hasGet() ? headers.get("retry-after") : null;           // src: vvaharness/backends/llm/deepagents.py:372
            if (raw == null) continue;                                                                      // src: vvaharness/backends/llm/deepagents.py:373
            double seconds;
            try { seconds = Double.parse(raw); } catch (TypeError | ValueError e) { continue; }             // unparseable header skipped // src: vvaharness/backends/llm/deepagents.py:376
            if (seconds > 0) return Math.min(seconds, RETRY_AFTER_MAX_SECONDS);                             // src: vvaharness/backends/llm/deepagents.py:380
        }
        return null;                                                                                        // src: vvaharness/backends/llm/deepagents.py:381
    }

    /** mapped when it is a refusal (raised later, unchained); otherwise raise it from exc. */
    @src("vvaharness/backends/llm/deepagents.py:384")
    ModelRefusal refusalOrRaise(Exception mapped, Throwable exc) {
        if (!(mapped instanceof ModelRefusal)) throw mapped;                                                // auth, proxy and tool-state errors raise chained at once // src: vvaharness/backends/llm/deepagents.py:387
        return mapped;                                                                                      // src: vvaharness/backends/llm/deepagents.py:388
    }

    /** The wait before the next transient retry; VVAH-E008 when it would cross the clock. */
    @src("vvaharness/backends/llm/deepagents.py:391")
    double transientWait(Exception exc, double sessionT0, Double budget, String tag) {
        // retry-after honoured un-jittered; the flat fallback is jittered or S4/S6 workers sync
        Double retryAfter = retryAfterSeconds(exc);                                                         // src: vvaharness/backends/llm/deepagents.py:396
        double wait = retryAfter != null ? retryAfter : LlmModels.jitteredDelay(TRANSIENT_WAIT_SECONDS);    // src: vvaharness/backends/llm/deepagents.py:397
        Exception overrun = LlmModels.waitOverrun(wait, sessionT0, budget, tag != null ? tag : "", "deepagents", null); // src: vvaharness/backends/llm/deepagents.py:398
        if (overrun != null) throw overrun;                                                                 // src: vvaharness/backends/llm/deepagents.py:400
        return wait;                                                                                        // src: vvaharness/backends/llm/deepagents.py:401
    }

    /** Run a harness call, retrying transients and re-raising the rest under the VVAH taxonomy. THE retry ladder: stacks on each SDK's 2 retries, so worst case 3x3 = 9 sends (x2 on fallback). */
    @src("vvaharness/backends/llm/deepagents.py:403")
    Object callClassified(Function<Double, Object> call, String modelId, String tag, Double budget, Theta θ) {
        int attempt = 0;
        double sessionT0 = Clock.monotonic();                                                               // src: vvaharness/backends/llm/deepagents.py:408
        Double remaining = budget;                                                                          // src: vvaharness/backends/llm/deepagents.py:409
        ModelRefusal refusal;
        while (true) {
            attempt++;                                                                                      // src: vvaharness/backends/llm/deepagents.py:412
            try {
                return call.apply(remaining);                                                               // src: vvaharness/backends/llm/deepagents.py:414
            } catch (Exception exc) {
                Exception mapped = classifyFailure(exc, modelId, tag);                                      // refusal first, then auth, proxy, tool-state // src: vvaharness/backends/llm/deepagents.py:416
                if (mapped != null) {
                    refusal = refusalOrRaise(mapped, exc);                                                  // non-refusals raise here // src: vvaharness/backends/llm/deepagents.py:418
                    break;                                                                                  // src: vvaharness/backends/llm/deepagents.py:419
                }
                if (attempt >= TRANSIENT_ATTEMPTS || !transientFailure(exc)) throw exc;                     // src: vvaharness/backends/llm/deepagents.py:420
                double wait = transientWait(exc, sessionT0, budget, tag);                                   // VVAH-E008 when the wait crosses the clock // src: vvaharness/backends/llm/deepagents.py:422
                Console.write("transient error; retrying");                                                 // src: vvaharness/backends/llm/deepagents.py:423
                Thread.sleep(wait);                                                                         // src: vvaharness/backends/llm/deepagents.py:428
                remaining = budget == null ? null : LlmModels.turnTimeout(sessionT0, budget, budget);       // the remaining clock shrinks for the next attempt // src: vvaharness/backends/llm/deepagents.py:429
            }
        }
        // raised outside the except, unchained: is_timeout_failure would read a TimeoutError link in the chain as a timeout
        throw refusal;                                                                                      // src: vvaharness/backends/llm/deepagents.py:432
    }

    /** WARN once per stage when a call finishes with no token usage recorded. */
    @src("vvaharness/backends/llm/deepagents.py:434")
    void warnNoUsage(Map usage, String modelId, String tag) {
        if (usage != null) return;                                                                          // src: vvaharness/backends/llm/deepagents.py:436
        String tagText = tag != null ? tag : "";                                                            // src: vvaharness/backends/llm/deepagents.py:438
        String stageKey = !tagText.strip().isEmpty() ? tagText.split(" ", 2)[0] : "";                       // src: vvaharness/backends/llm/deepagents.py:439
        WarnOnce.warnOnce(NO_USAGE_WARNED_TAGS, stageKey, "no token usage recorded for the stage: token accounting is unavailable for it"); // src: vvaharness/backends/llm/deepagents.py:440
    }

    /** One-time WARN naming every model-node tunable this route cannot send (all extras are ignored). */
    @src("vvaharness/backends/llm/deepagents.py:453")
    void warnDroppedModelKnobs(String modelId, Object extras) {
        if (!(extras instanceof Map)) return;                                                               // src: vvaharness/backends/llm/deepagents.py:455
        for (String name : extras.keys().sorted()) {                                                        // src: vvaharness/backends/llm/deepagents.py:457
            WarnOnce.warnOnce(WARNED_DROPPED_KNOBS, "deepagents:" + name, "models entry sets a tunable the deepagents route never sends - ignored; route via sdk or openai to have it honoured"); // src: vvaharness/backends/llm/deepagents.py:458
        }
    }

