// file: vvaharness/remediation_agent/policy/symlink_jail.py
// Pre-dispatch detection of symlinks escaping the scanned repo (CWE-59). An edit THROUGH an escaping link is invisible to
// the post-gate, so it is caught before the model gets a writer. Read-only and total: this reports, the caller refuses.

@executedBy(CODE) @role(rule_set) @stage("S10")
class SymlinkJail {

    Map<String, String> escapingSymlinks(String repo, Theta θ) {
        Path root;
        try {
            root = Path.of(repo).resolve();                                                         // src: vvaharness/remediation_agent/policy/symlink_jail.py:50
        } catch (OSError e) {
            return Map.of();                                                                        // src: vvaharness/remediation_agent/policy/symlink_jail.py:52
        }
        Map<String, String> found = new Map();
        int filesSeen = 0;
        int dirsSeen = 0;
        try {
            // followlinks=false: never descend THROUGH a link while looking for links.
            for (WalkEntry w : Os.walk(repo, false)) {                                              // src: vvaharness/remediation_agent/policy/symlink_jail.py:58
                dirsSeen = dirsSeen + 1;
                if (dirsSeen > θ["code.remediation_agent.policy.symlink_jail.scan_dir_max"]) break;  // src: vvaharness/remediation_agent/policy/symlink_jail.py:60
                for (String name : w.dirnames.copy()) {                                             // src: vvaharness/remediation_agent/policy/symlink_jail.py:63
                    // Vendored trees hold many legitimate links and S10 never patches them.
                    if (θ["code.remediation_agent.policy.symlink_jail.skip_dirs"].contains(name)) { // src: vvaharness/remediation_agent/policy/symlink_jail.py:64
                        w.dirnames.remove(name);
                        continue;
                    }
                    record(root, repo, w.dirpath.join(name), found, θ);                             // src: vvaharness/remediation_agent/policy/symlink_jail.py:67  (a symlinked dir is a candidate)
                }
                for (String name : w.filenames) {                                                   // src: vvaharness/remediation_agent/policy/symlink_jail.py:68
                    filesSeen = filesSeen + 1;
                    if (filesSeen > θ["code.remediation_agent.policy.symlink_jail.scan_file_max"]) return found; // src: vvaharness/remediation_agent/policy/symlink_jail.py:70
                    record(root, repo, w.dirpath.join(name), found, θ);                             // src: vvaharness/remediation_agent/policy/symlink_jail.py:72
                }
            }
        } catch (Exception e) {
            return found;                                                                           // src: vvaharness/remediation_agent/policy/symlink_jail.py:74  (best-effort, never breaks a run)
        }
        return found;
    }

    void record(Path root, String repo, Path path, Map<String, String> out, Theta θ) {
        try {
            if (!path.isSymlink()) return;                                                          // src: vvaharness/remediation_agent/policy/symlink_jail.py:87
        } catch (OSError e) {
            return;                                                                                 // src: vvaharness/remediation_agent/policy/symlink_jail.py:90
        }
        String rel;
        try {
            rel = path.relativeTo(repo).asPosix();                                                  // src: vvaharness/remediation_agent/policy/symlink_jail.py:92
        } catch (ValueError e) {
            return;                                                                                 // src: vvaharness/remediation_agent/policy/symlink_jail.py:94
        }
        Path target;
        try {
            target = path.resolve();                                                                // src: vvaharness/remediation_agent/policy/symlink_jail.py:96
        } catch (OSError | RuntimeError e) {
            out.put(rel, rawTarget(path));                                                          // src: vvaharness/remediation_agent/policy/symlink_jail.py:99  (resolution loop: cannot be proven in-tree)
            return;
        }
        if (!target.isRelativeTo(root)) {                                                           // src: vvaharness/remediation_agent/policy/symlink_jail.py:102
            out.put(rel, target.toString());                                                        // src: vvaharness/remediation_agent/policy/symlink_jail.py:104  (resolves outside the repo)
            return;
        }
        // Dangling in-tree link: attacker-controlled, a write would create its target (TOCTOU).
        if (!target.exists() && θ["code.remediation_agent.policy.symlink_jail.report_dangling"]) out.put(rel, rawTarget(path) + " (dangling)"); // src: vvaharness/remediation_agent/policy/symlink_jail.py:106
    }

    String rawTarget(Path path) {
        try {
            return Os.readlink(path);                                                               // src: vvaharness/remediation_agent/policy/symlink_jail.py:113
        } catch (OSError e) {
            return "<unreadable>";                                                                  // src: vvaharness/remediation_agent/policy/symlink_jail.py:115
        }
    }

    String describeEscapes(Map<String, String> escapes, int limit) {
        List<Pair<String, String>> items = escapes.items().sorted();                                // src: vvaharness/remediation_agent/policy/symlink_jail.py:120
        String shown = items.take(limit).map(it -> it.first + " -> " + it.second).join(", ");       // src: vvaharness/remediation_agent/policy/symlink_jail.py:121  (operator message, limit 5)
        if (items.size() > limit) shown = shown + ", ... (+" + (items.size() - limit) + " more)";   // src: vvaharness/remediation_agent/policy/symlink_jail.py:122
        return shown;
    }
}
