# vvaharness/pipeline/stages/s9/typed_sarif.py

The Stage 9 SARIF 2.1.0 emitter, built only from the typed `FinalReport`. Each ranked finding becomes one result (unless the duplicate-result guard folds an identical twin into a stronger one); collapsed Stage 7 call sites become related locations; CWE ids populate rules, tags and a MITRE CWE taxonomy; scan health becomes invocation notifications and run properties. The whole document is redacted before it is written.

Source: `vvaharness/pipeline/stages/s9/typed_sarif.py` (lines 1-456)
Executor: code
Called from: `vvaharness/pipeline/stages/s9_sarif.py` run

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:39-43, 80-89
FINGERPRINT_KEY = "vvaFindingId/v1"   // join key: SARIF partialFingerprints <-> findings.json case_id <-> finding_case.json
ALIAS_KEY = "aliasFindingIds"         // case ids folded in by the duplicate guard
CWE_TAXONOMY_GUID = "ec480a2c-8267-5d90-affc-401687cd64b0"   // uuid5(NAMESPACE_URL, "https://cwe.mitre.org/"), literal for cross-run joins
_DEDUP_RELATED_MSG = "Additional call site — collapsed during dedup; same root cause as the primary location and needs the same fix."
_REF_RELATED_MSG = { source: "Source — where untrusted input enters.", sink: "Sink — where the tainted value is used unsafely." }

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:445-456
fn write_sarif(report, sarif_path, application_id, app_info, cfg?):executor=code {
  doc = build_sarif(report, application_id, app_info, cfg=cfg)
  write json(report.redact.redact_tree(doc), indent=2) + "\n" to sarif_path   // every string leaf redacted at the write boundary
  // abstracted: console "SARIF written" with the emitted result count (not length(report.findings), since the guard suppresses twins)
  return sarif_path
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:170-442
fn build_sarif(report, application_id, app_info, cfg?):executor=code {
  // src: typed_sarif.py:173-175 — fallbacks must track config._STEP_DEFAULTS
  dup_guard = knob("step9.duplicate_result_guard", default=true)
  posture_channel = knob("output.posture_channel", default=true)
  results = []; rule_ids = []; rep_name = {}; eff_cwes = []; rule_cwe = {}; rule_sev = {}

  // src: typed_sarif.py:182-186 — CVSS recomputed from the vector (sentinel -1.0), never the stored cvss_score
  labels = for each rf in report.findings: _class_label(rf.finding)
  scores = for each rf: report.cvss.score_or_sentinel(rf.finding.cvss_vector)
  msgs = for each k, rf: _result_message(rf.finding, scores[k])

  // ---------- duplicate-result guard, resolved before the loop ----------
  // src: typed_sarif.py:187-207; ranks via _survivor_rank typed_sarif.py:128-131 (SEV_RANK.get(severity, 9))
  winner_of = {}; alias_ids = {}; seen_dup_sites = {}
  if (dup_guard) {
    dup_keys = for each k, rf: _dup_result_key(rf.finding, labels[k][0], msgs[k])
    // the strongest severity wins; ties keep the first
    for each i0: if (winner_of[dup_keys[i0]] == null || SEV_RANK[rf(i0).severity] < SEV_RANK[rf(winner).severity]) winner_of[dup_keys[i0]] = i0
    for each i0, rf0 {
      if (winner_of[dup_keys[i0]] != i0 && rf0.finding.case_id) append rf0.finding.case_id to alias_ids[winner_of[dup_keys[i0]]]
      add (file or "unknown", line_start, effective CWE or vuln_class value) of rf0.finding to seen_dup_sites   // every primary seeded up front
    }
  }

  // ---------- one result per surviving finding ----------
  // src: typed_sarif.py:208-328
  for each i (1-based), rf in report.findings {
    f = rf.finding
    sev = uppercase rf.severity.value
    if (dup_guard && winner_of[dup_keys[i - 1]] != i - 1) { COUNTERS.bump("s9_sarif_dup_result_suppressed"); continue }   // before any rule or taxonomy mutation
    [eff_cwe, category] = labels[i - 1]; cvss_score = scores[i - 1]
    rule_id = category or lowercase sev
    if (rule_id not in rule_ids) append rule_id to rule_ids
    if (rule_id not in rep_name && eff_cwe && cwe_name(eff_cwe)) rep_name[rule_id] = cwe_name(eff_cwe)
    if (eff_cwe) append eff_cwe to eff_cwes

    // src: typed_sarif.py:227-258 — result properties
    props = {
      severity: lowercase sev,
      "security-severity": _security_severity(sev, cvss_score),
      cvssRating: report.cvss.rating(if (cvss_score >= 0) cvss_score else float(_security_severity(sev, cvss_score))),
      category, cvssVector: f.cvss_vector
    }
    rule_cwe[rule_id] = rule_cwe[rule_id] or eff_cwe   // first seen
    rule_sev[rule_id] = numeric max of rule_sev[rule_id] (default "0.0") and props["security-severity"]   // compared as numbers: "9.0" must not beat "10.0"
    if (eff_cwe) { props.cwe = cwe_label(eff_cwe); props.cweId = eff_cwe; if (cwe_name(eff_cwe)) props.cweName = cwe_name(eff_cwe) }
    if (cvss_score >= 0) props.cvssScore = round(cvss_score, 1)
    if (f.vsvs_score != null) { props.vulContextSeverityVector = f.vsvs_vector; props.vulContextSeverityScore = round(f.vsvs_score, 1); props.vulContextSeverityRating = f.vsvs_rating }
    if (f.offensive_priority) {
      label = OFFENSIVE_LABELS[f.offensive_priority] or ""
      props.offensivePriority = f.offensive_priority; props.offensivePriorityLabel = label
      props.offensivePriorityReason = trimmed "$label | *${f.offensive_reason}*"   // Markdown asterisks match the report line verbatim
    }
    // no exploit-verification, confidence or vote keys: no stage produces a real value
    props.description = _section_description(i, rf)

    // src: typed_sarif.py:260-277
    result = { ruleId: rule_id, level: _sarif_level(sev), message: { text: msg },
      locations: [{ physicalLocation: { artifactLocation: { uri: f.file or "unknown" }, region: { startLine: f.line_start } } }],   // verbatim path
      properties: props }
    if (eff_cwe) result.taxa = [{ toolComponent: { name: "CWE", guid: CWE_TAXONOMY_GUID }, id: eff_cwe }]

    // src: typed_sarif.py:278-312 — Stage 7 duplicate call sites as related locations
    related = []
    for each d in f.duplicates {
      if (dup_guard) {
        gkey = (d.file, d.line_start, eff_cwe or f.vuln_class.value)
        if (gkey in seen_dup_sites) { COUNTERS.bump("s9_sarif_dup_site_deduped"); continue }   // own, sibling or earlier anchors collapse
        add gkey to seen_dup_sites
      }
      region = { startLine: d.line_start }; if (d.line_end && d.line_end != d.line_start) region.endLine = d.line_end
      entry = { physicalLocation: { artifactLocation: { uri: d.file }, region }, message: { text: _DEDUP_RELATED_MSG } }
      meta = non-empty of { title: d.title, vulnClass: d.vuln_class.value, sourceRef: d.source_ref, sinkRef: d.sink_ref }
      if (meta) entry.properties = meta
      append entry to related
    }
    if (related) props.dedupRelatedLocationCount = length(related)
    flow = _taint_code_flow(f.source_ref, f.sink_ref); if (flow) result.codeFlows = [flow]
    if (related) result.relatedLocations = related

    // src: typed_sarif.py:313-328
    if (f.backfilled_refs) props.backfilledRefs = list(f.backfilled_refs)
    if (posture_channel) props.channel = f.channel or "main"   // carried verbatim; s9 does no routing
    // preserved: posture-channel findings are still emitted as SARIF results; only the "channel" property marks them
    if (f.origin) props.origin = f.origin   // "detector" or "s6_discovered"; chunk_id is never emitted
    if (alias_ids[i - 1]) props[ALIAS_KEY] = alias_ids[i - 1]
    if (cvss_score >= 0) result.rank = round(cvss_score * 10.0, 1)   // SARIF rank is 0-100
    if (f.case_id) result.partialFingerprints = { FINGERPRINT_KEY: f.case_id }
    append result to results
  }

  // ---------- rules and CWE taxonomy ----------
  // src: typed_sarif.py:330-360
  rules = for each rid in rule_ids: {
    id: rid, name: rid, shortDescription: { text: rep_name[rid] } when known,
    properties: { tags: ["security"] + (if (rule_cwe[rid]) ["external/cwe/${lowercase rule_cwe[rid]}"] else []), "security-severity": rule_sev[rid] }
  }
  taxa = for each cid in distinct eff_cwes sorted by numeric id: { id: cid, helpUri: "https://cwe.mitre.org/data/definitions/<n>.html", name and shortDescription = cwe_name(cid) when known }
  taxonomy = { guid: CWE_TAXONOMY_GUID, name: "CWE", organization: "MITRE", shortDescription: { text: "The MITRE Common Weakness Enumeration" }, informationUri: "https://cwe.mitre.org/", taxa }

  // src: typed_sarif.py:362-371 — one application block: the checkpointed profile wins over CLI app_info
  prof = report.app_profile
  run_props = { applicationId: (if (prof) prof.application_id else "") or application_id or "" }
  if (prof) { run_props.cmdbSource = prof.source; run_props.applicationName = prof.name }
  else if (app_info) { run_props.cmdbSource = app_info.source; run_props.applicationName = app_info.name }

  run = { tool: { driver: { name: "Agentic SAST", version: package version, rules, supportedTaxonomies: [{ guid: CWE_TAXONOMY_GUID }] } },
    taxonomies: [taxonomy], properties: run_props, results }

  // ---------- scan health, emitted on every run ----------
  // src: typed_sarif.py:384-420
  health = s9.health.scan_health(report)
  notifications = []
  for each [stg, n] in sorted health.errors_by_stage: append warning "$stg: $n non-fatal error(s) logged"   // "non-fatal" is a wording contract with the Markdown Scan Health section
  if (health.chunks_failed) append warning "${cf} deep-dive unit(s) failed or timed out; their findings are absent"
  if (health.degraded) append warning (health.degraded_reason or "report degraded (no reason recorded)")
  if (health.threats_truncated) append warning "$truncated threat(s) exceeded the step2.max_threats cap and were never investigated; threatsTotal counts only the ${health.threats_total} that remained"
  invocation = { executionSuccessful: bool(health.executionSuccessful) }
  if (notifications) invocation.toolExecutionNotifications = notifications
  run.invocations = [invocation]

  // src: typed_sarif.py:421-436 — always emitted
  run_props += { enrichmentUnavailable, deepdiveSkipped, hollow, coverageDegraded, coverageDegradedReasons,
    threatsTotal, threatsWithoutUnit (null = predates the field, [] = full coverage), threatsBeforeCap, threatsTruncated, threatsPromoted } from health

  return { "$schema": "https://json.schemastore.org/sarif-2.1.0.json", version: "2.1.0", runs: [run] }
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:92-101
fn _sarif_level(sev):executor=code { return match (sev) { case "CRITICAL" => "error"; case "HIGH" => "error"; case "MEDIUM" => "warning"; default => "note" } }
fn _security_severity(sev, cvss_score):executor=code {
  if (cvss_score >= 0) return cvss_score formatted to one decimal
  return match (sev) { case "CRITICAL" => "9.0"; case "HIGH" => "7.0"; case "MEDIUM" => "4.0"; case "LOW" => "0.1"; default => "0.0" }
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:104-110
fn _class_label(f):executor=code {
  // exactly as the Markdown renderer derives them
  eff = rules.cwe.norm_cwe(f.cwe) or report.cwe.cwe_for(null, f.vuln_class)   // a missing CWE falls back to the vulnerability class table
  nm = if (eff) cwe_name(eff) else ""
  label = (if (eff) (if (nm) "$eff: $nm" else eff) else "") or f.vuln_class.value
  return [eff, label]   // label becomes the ruleId
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:113-117
fn _result_message(f, score):executor=code {
  return _md_cell(f.title) + (if (f.cvss_vector) "  [CVSS${ if (score >= 0) " " + score to one decimal else "" }: ${f.cvss_vector}]" else "")
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:120-131
fn _dup_result_key(f, eff, msg):executor=code {
  return (f.file or "unknown", f.line_start, eff or f.vuln_class.value, msg, f.channel or "main", f.origin or "")
  // channel and origin are part of the key, or a CRITICAL folds into its posture or detector twin
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:134-139
fn _section_description(i, rf):executor=code {
  desc = redact_counts(finding_description_lines(i, rf) joined by "\n", trimmed)   // redact before the 4000-character cut
  return if (length(desc) > 4000) first 4000 characters + "…" else desc
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:142-167
fn _taint_code_flow(source_ref, sink_ref):executor=code {
  steps = for each [role, ref] in [["source", source_ref], ["sink", sink_ref]] where ref: _ref_related_location(role, ref)
  if (!steps) return null
  return { threadFlows: [{ locations: for each s in steps: { location: s, importance: "essential" } }] }
}
fn _ref_related_location(role, ref):executor=code {
  // "file:line" splits on the last ":"; a non-numeric tail keeps the whole ref as the uri with no region
  return { physicalLocation: { artifactLocation: { uri }, region: { startLine } when numeric }, message: { text: _REF_RELATED_MSG[role] }, properties: { role } }
}

// src: vvaharness/pipeline/stages/s9/typed_sarif.py:46-77 — helpers used by later stages to join SARIF rows to case records
fn result_identifies(result, case_id):executor=code { return case_id && (result.partialFingerprints[FINGERPRINT_KEY] == case_id || case_id in result.properties[ALIAS_KEY]) }
fn result_fingerprint(result):executor=code { return string(result.partialFingerprints[FINGERPRINT_KEY] or "") }
fn record_result_block(result, case_id, block, key, alias_key):executor=code {
  // blocks go under properties (SARIF result forbids additional properties)
  own = result_fingerprint(result)
  if (!(own && case_id && own != case_id)) { result.properties[key] = block; return true }   // a fingerprint-less row keeps the primary key
  result.properties[alias_key][case_id] = block   // alias map created when absent or not a map
  return false
}
