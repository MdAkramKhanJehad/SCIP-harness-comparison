Called from: `vvaharness/remediation_agent/discovery.sudo` locate_report

// src: vvaharness/remediation_agent/report_parser/locate.py:20-23
// Must stay in lock-step with the scan output folder in orchestrator/scan.py scan_repo
SCAN_DIR_NAME = "security-scan"
REMEDIATION_DIR_NAME = "security-remediation"
REPORT_GLOB = "*_report.md"

// src: vvaharness/remediation_agent/report_parser/locate.py:26-29
fn find_scan_dir(repo):executor=code {
  scan_dir = "$repo/$SCAN_DIR_NAME"
  return if (scan_dir is a directory) scan_dir else null
}

// src: vvaharness/remediation_agent/report_parser/locate.py:32-38
fn latest_report(scan_dir):executor=code {
  reports = files in scan_dir matching REPORT_GLOB, sorted by (file name, modification time)
  return last of reports, or null when there are none
  // preserved: "newest" is decided by file name first; modification time only breaks ties between equal names (the names carry a timestamp, so name order is usually time order)
}
