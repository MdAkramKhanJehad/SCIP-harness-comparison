# vvaharness/util/json_extract.py

Pulls a JSON object or array out of a model response that may have prose or code fences around it. Every stage that parses a model's JSON answer depends on which candidate this function picks.

Source: `vvaharness/util/json_extract.py` (lines 1-140)
Executor: code
Called from: stage outcome parsers (`vvaharness/pipeline/stages/s2/outcomes.py`, `s4/outcomes.py`, `s6/outcomes.py`, `s7/outcomes.py`, `s8/outcomes.py`), `vvaharness/backends/llm/cli/envelope.py`, `vvaharness/remediation_agent/plugin_runner/`

// src: vvaharness/util/json_extract.py:25-32
_FENCE = /```(?:json)?\s*(.*?)\s*```/ (dot matches newline)
_FENCE_OPEN = /^```\w*\s*/   // leading fence opener only
_MAX_JSON_INPUT = 5_000_000   // characters; longer input is truncated, not abandoned
_VALID_ESCAPE = set of characters `" \ / n r t u`

// src: vvaharness/util/json_extract.py:83-140
fn extract_json(text):executor=code {
  if (length of text > _MAX_JSON_INPUT) {
    warn JSON_INPUT_TRUNCATED
    text = first _MAX_JSON_INPUT characters of text
  }
  stripped = trim(text)

  // Candidate order (first success wins, except the list-hold rule below):
  candidates = []
  if (stripped as a whole fully matches _FENCE) append its inner text   // a literal ``` inside a JSON string would cut the non-greedy search short
  append every _FENCE inner match in text, in order
  append text   // "ALWAYS keep the whole response as a final candidate, so JSON OUTSIDE a fence survives"

  peek = stripped with one leading fence opener removed
  want_dict = first character of peek == "{"   // a response starting with "{" prefers an object; a list inside it is only a sub-span
  held_list = null; last_err = null

  for each cand in candidates {
    i = 0
    while (i < length of cand) {
      if (cand[i] is not "{" and not "[") { i += 1; continue }
      span = _balanced_span(cand, i)
      if (span == null) { i += 1; continue }   // unbalanced opener (a stray "{" in prose): keep scanning
      val = null
      try val = parse span as JSON;
      catch decodeError => {
        last_err = decodeError
        repaired = _repair_invalid_escapes(span)   // models often emit invalid backslash escapes
        if (repaired != span) { try val = parse repaired as JSON; catch => val stays null }
      }
      if (val == null) { i += length of span; continue }
      if (want_dict && val is a list) {
        if (held_list == null) held_list = val   // first list kept as fallback
        i += length of span; continue
      }
      return val
    }
  }
  if (held_list != null) return held_list
  if (last_err) throw last_err
  throw ValueError("no JSON object found in response")
}

