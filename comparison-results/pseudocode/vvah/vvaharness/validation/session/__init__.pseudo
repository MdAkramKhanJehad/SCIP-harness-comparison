// Validation session package facade: config injection, error type, launch prompt, launcher.

@executedBy(CODE) @role(pipeline) @stage("S11")
class Session {

    void injectClaudeConfig(Path workspaceDir) {
        ConfigInject.injectClaudeConfig(workspaceDir);                                               // src: vvaharness/validation/session/__init__.py:17
    }

    Prompt buildLaunchPrompt(Manifest m, Theta θ) {
        return SessionLaunchPrompt.run(m, θ);                                                        // src: vvaharness/validation/session/__init__.py:19
    }

    AgentSpec buildValidationOptions(Manifest m, Workspace ws, Prompt system, Config cfg, Theta θ) {
        return ValidationLauncher.buildValidationOptions(m, ws, system, cfg, θ);                     // src: vvaharness/validation/session/__init__.py:21
    }

    int launchSession(Manifest m, Workspace ws, Theta θ) {
        return ValidationLauncher.launchSession(m, ws, θ);                                           // src: vvaharness/validation/session/__init__.py:22
    }
}
