// file: vvaharness/evidence/configs.py
// S2 evidence: representative config files, one per directory (security-named first, then env tier),
// with redacted, capped bodies for the first few and path-only for the rest.

@executedBy(CODE) @role(step) @stage("S2")
class Configs {

    /** One rep per parent dir, round-robin across dirs (sorted), up to maxReps. */
    List<String> selectConfigReps(List<String> fullFiles, int maxReps, Theta θ) {
        Set<String> configExts = θ["code.evidence.configs.config_exts"];                          // src: vvaharness/evidence/configs.py:26
        Set<String> secNames = Detect.securityConfigNames(θ);                                     // src: vvaharness/evidence/configs.py:22
        Map<String, List<String>> byDir = new Map();
        for (String rel : fullFiles) {                                                            // src: vvaharness/evidence/configs.py:36
            String suffix = suffix(rel).lower(); String name = basename(rel).lower();             // src: vvaharness/evidence/configs.py:38
            if (configExts.contains(suffix) || configExts.contains(name) || secNames.contains(name)) { // src: vvaharness/evidence/configs.py:40
                String parent = dirname(rel) == "." ? "" : dirname(rel);                          // src: vvaharness/evidence/configs.py:41
                byDir.computeIfAbsent(parent, new List()).add(rel);                                                       // src: vvaharness/evidence/configs.py:42
            }
        }
        for (String d : byDir.keys()) {                                                           // src: vvaharness/evidence/configs.py:44
            // security-named first, then scope's env tier (prod first), then path
            byDir.get(d).sortBy(f -> new Tuple(!secNames.contains(basename(f).lower()), ScopeConfigs.repScore(f, 0, θ).first, f)); // src: vvaharness/evidence/configs.py:46
        }
        List<Pair<String, String>> pairs = Grouping.roundRobinSelect(byDir, maxReps, sorted(byDir.keys())); // = maxReps. src: vvaharness/evidence/configs.py:52
        return pairs.map(p -> p.second);                                                          // src: vvaharness/evidence/configs.py:53
    }

    /** Body for the first maxBodies reps (security-named first), redacted then capped; the rest path-only. */
    List<Pair<String, String>> configRepContents(Path root, List<String> relPaths, int capChars, int maxBodies, Theta θ) {
        List<Pair<String, String>> reps = new List();
        // raw read ceiling, floored at a multiple of an operator-raised cap
        int readCeiling = Math.max(θ["code.evidence.configs.rep_raw_ceiling"], capChars * θ["code.evidence.configs.rep_raw_ceiling_cap_multiplier"]); // src: vvaharness/evidence/configs.py:60
        Set<String> secNames = Detect.securityConfigNames(θ);
        Set<String> withBodies = Set.copyOf(relPaths.sortedBy(r -> !secNames.contains(basename(r).lower())).head(Math.max(maxBodies, 0))); // = maxBodies. src: vvaharness/evidence/configs.py:61
        for (String rel : relPaths) {                                                             // src: vvaharness/evidence/configs.py:65
            String body = "";
            if (capChars > 0 && withBodies.contains(rel)) {                // = capChars. src: vvaharness/evidence/configs.py:67
                // redact-before-cap; whole_or_nothing so redact() never sees a bisected secret
                String raw = Read.readCapped(root, root.resolve(rel), readCeiling, true, θ);     // src: vvaharness/evidence/configs.py:69
                if (!raw.isEmpty()) body = Read.capText(Redact.redact(raw), capChars);            // src: vvaharness/evidence/configs.py:72
            }
            reps.add(new Pair(rel, body));                                                        // src: vvaharness/evidence/configs.py:73
        }
        return reps;
    }

    List<Pair<String, String>> gatherConfigReps(Path root, List<String> fullFiles, int maxReps, int capChars, int maxBodies, Theta θ) {
        return configRepContents(root, selectConfigReps(fullFiles, maxReps, θ), capChars, maxBodies, θ); // src: vvaharness/evidence/configs.py:80
    }
}
