// file: vvaharness/backends/harness/claude/translate.py
// Claude Agent SDK message -> HarnessMessage translation; the terminal ResultMessage feeds the
// process-wide token/cost counter exactly once per session.

@executedBy(CODE) @role(backend)
class Translate {

    Object validateStructured(Object raw, Schema responseModel) {
        if (responseModel == null) return null;                                                          // src: vvaharness/backends/harness/claude/translate.py:47
        if (raw instanceof Map) return responseModel.modelValidate(raw);          // raises on invalid    // src: vvaharness/backends/harness/claude/translate.py:50
        return responseModel.isInstance(raw) ? raw : null;                                               // src: vvaharness/backends/harness/claude/translate.py:51
    }

    List<HarnessMessage> translateInit(SystemMessage message) {
        Map<String, Object> data = message.data instanceof Map ? message.data : Map.of();                // src: vvaharness/backends/harness/claude/translate.py:56
        Object sid = data.get("session_id");                                                             // src: vvaharness/backends/harness/claude/translate.py:57
        return List.of(new HarnessSessionInit("session_init", sid instanceof String ? sid : "", data));  // src: vvaharness/backends/harness/claude/translate.py:58
    }

    List<HarnessMessage> translateAssistant(AssistantMessage message) {
        List<HarnessMessage> out = new List();
        for (Block block : message.content) {                                                            // src: vvaharness/backends/harness/claude/translate.py:67
            if (block instanceof ToolUseBlock) {
                out.add(new HarnessToolUse("tool_use", block.id, block.name, block.input instanceof Map ? block.input : Map.of(), null, null)); // src: vvaharness/backends/harness/claude/translate.py:70
            } else if (block instanceof TextBlock) {
                out.add(new HarnessAssistantText("assistant_text", block.text, null, null));             // src: vvaharness/backends/harness/claude/translate.py:72
            }
        }
        return out;
    }

    List<HarnessMessage> translateToolResult(UserMessage message) {
        List<Object> items = message.toolUseResult instanceof List ? message.toolUseResult : List.of(message.toolUseResult); // src: vvaharness/backends/harness/claude/translate.py:79
        List<HarnessMessage> out = new List();
        for (Object item : items) {
            if (item instanceof Map) out.add(new HarnessToolResult("tool_result", item.getOrDefault("is_error", false), item, null, null)); // src: vvaharness/backends/harness/claude/translate.py:83
            else out.add(new HarnessToolResult("tool_result", false, item, null, null));                 // src: vvaharness/backends/harness/claude/translate.py:86
        }
        return out;
    }

    List<HarnessMessage> translateResult(ResultMessage message, Schema responseModel) {
        TOKENS.add(message.usage, message.totalCostUsd);          // the SDK's own measured cost, once per session // src: vvaharness/backends/harness/claude/translate.py:95
        return List.of(new HarnessResult("result", message.subtype, message.isError, message.sessionId, message.result,
            validateStructured(message.structuredOutput, responseModel), message.errors, message.usage, message.totalCostUsd, null, false, false, null)); // src: vvaharness/backends/harness/claude/translate.py:96
    }

    List<HarnessMessage> translateSystem(Object message) {
        return message.subtype.equals("init") ? translateInit(message) : List.of();                      // src: vvaharness/backends/harness/claude/translate.py:110
    }

    List<HarnessMessage> translateUser(Object message) {
        return message.toolUseResult != null ? translateToolResult(message) : List.of();                 // src: vvaharness/backends/harness/claude/translate.py:115
    }

    List<HarnessMessage> translate(Object message, Schema responseModel) {
        if (message instanceof ResultMessage) return translateResult(message, responseModel);            // src: vvaharness/backends/harness/claude/translate.py:129
        // _TRANSLATORS: SystemMessage -> translateSystem, AssistantMessage -> translateAssistant, UserMessage -> translateUser
        if (message instanceof SystemMessage) return translateSystem(message);                          // src: vvaharness/backends/harness/claude/translate.py:119
        if (message instanceof AssistantMessage) return translateAssistant(message);                     // src: vvaharness/backends/harness/claude/translate.py:120
        if (message instanceof UserMessage) return translateUser(message);                               // src: vvaharness/backends/harness/claude/translate.py:121
        return List.of();                                                // other SDK messages dropped     // src: vvaharness/backends/harness/claude/translate.py:132
    }
}
