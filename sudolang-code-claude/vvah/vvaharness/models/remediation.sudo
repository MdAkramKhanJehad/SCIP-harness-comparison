# vvaharness/models/remediation.py

What one remediation attempt produced. Engines report `RemediationEvidence`; `finalize` turns it into a `Remediation`, choosing the `kind` from the claimed outcome and the run mode.

Source: `vvaharness/models/remediation.py` (lines 1-125)
Executor: code
Called from: Stage 10 remediation engines; `vvaharness/models/case.py`

// src: vvaharness/models/remediation.py:27-28
_REPORT_ONLY = ["report-only", "report_only"]   // both spellings circulate as the mode

// src: vvaharness/models/remediation.py:31-38
FileChange {
  // frozen; unknown keys ignored
  file: String              // repository-relative path that was edited
  summary: String = ""
}

// src: vvaharness/models/remediation.py:41-69
Remediation {
  // frozen; unknown keys ignored
  kind: RemediationKind
  summary: String
  disposition: Disposition | null = null
  diff: String = ""                 // advisory: the harness's own pre/post snapshot is authoritative
  files_touched: String[] = []      // advisory
  changes: FileChange[] = []
  gates: GateAssessment[] = []      // evidence gates asserted
  root_cause: String = ""
  remaining_risks: String[] = []
  recommendations: String[] = []
  external_ref: String = ""         // pull-request URL, for engines that open one
  produced_by: Provenance = Provenance()

  // src: vvaharness/models/remediation.py:63-69
  require !(kind == "no_action" && disposition == null) => throw "kind=no_action requires a disposition explaining why nothing was applied"
}

// src: vvaharness/models/remediation.py:72-85
RemediationEvidence {
  // frozen; unknown keys ignored; no diff, files_touched or kind (finalize sets them)
  outcome: RemediationOutcome
  summary: String
  root_cause: String = ""
  changes: FileChange[] = []
  gates: GateAssessment[] = []
  remaining_risks: String[] = []
  recommendations: String[] = []
  produced_by: Provenance = Provenance()
}

// src: vvaharness/models/remediation.py:88-102 — outcome => (kind in fix mode, kind in report-only mode, disposition)
_KIND = {
  fixed:           ["edits_applied", "diff_proposed", null],
  partially_fixed: ["edits_applied", "diff_proposed", null],
  not_fixed:       ["no_action", "no_action", "not_applicable"],
  false_positive:  ["no_action", "no_action", "false_positive"],
  needs_review:    ["no_action", "no_action", "not_applicable"],
  denied:          ["no_action", "no_action", "policy_denied"]
}

// src: vvaharness/models/remediation.py:105-125
fn finalize(evidence, mode, diff="", files_touched=[]):executor=code {
  [fix_kind, report_kind, disposition] = _KIND[evidence.outcome]
  kind = if (mode in _REPORT_ONLY) report_kind else fix_kind
  if (kind == "edits_applied" && files_touched is empty && diff is empty) kind = "already_resolved"
  return Remediation({ kind, summary: evidence.summary, disposition, diff, files_touched,
    changes, gates, root_cause, remaining_risks, recommendations, produced_by from evidence })
}
