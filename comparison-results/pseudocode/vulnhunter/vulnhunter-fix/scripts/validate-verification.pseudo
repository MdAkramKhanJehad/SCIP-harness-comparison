// file: vulnhunter-fix/scripts/validate-verification.py
// Delivery verification table: header, yes-cell citations and sidecar/result caller coverage.
// Preserve source edge cases: empty tables can pass; no VULN id skips caller check; citation line 0 is not rejected.

@executedBy(CODE) @role(tool) @stage("fix")
class ValidateVerification {
    @src("vulnhunter-fix/scripts/validate-verification.py:56")
    Pair parseTable(String text, Theta θ) {
        List lines = text.splitlines(); Integer headerIndex = null; List expected = θ["code.fix.scripts.validate_verification.expected_headers"]; // src: vulnhunter-fix/scripts/validate-verification.py:37
        for (Indexed line : enumerate(lines)) if (expected.subList(2, 6).allMatch(h -> line.value.contains(h.split("?").get(0).strip()))) { headerIndex = line.index; break; }
        if (headerIndex == null) return null;
        List header = lines.get(headerIndex).strip("|").split("|").map(c -> c.strip()); List rows = new List();
        for (String line : lines.subList(headerIndex + 2, lines.size())) {
            if (!line.strip().startsWith("|")) break;
            List cells = line.strip("|").split("|").map(c -> c.strip()); if (cells.size() == header.size()) rows.add(cells);
        }
        return new Pair(header, rows);
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:76")
    void checkHeader(List header, List errors, Theta θ) {
        List expected = θ["code.fix.scripts.validate_verification.expected_headers"]; // src: vulnhunter-fix/scripts/validate-verification.py:37
        if (header.size() != 9) { errors.add("expected nine header columns"); return; }
        for (Indexed h : enumerate(expected)) if (!header.get(h.index).contains(h.value)) errors.add("header cell mismatch");
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:85")
    String cellKind(String cell, Theta θ) {
        if (Regex.compile(θ["code.fix.scripts.validate_verification.cell_yes"], IGNORECASE).match(cell)) return "yes"; // src: vulnhunter-fix/scripts/validate-verification.py:51
        if (Regex.compile(θ["code.fix.scripts.validate_verification.cell_no"], IGNORECASE).match(cell)) return "no"; // src: vulnhunter-fix/scripts/validate-verification.py:52
        if (Regex.compile(θ["code.fix.scripts.validate_verification.cell_na"], IGNORECASE).match(cell)) return "n/a"; // src: vulnhunter-fix/scripts/validate-verification.py:53
        return "unknown";
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:95")
    List<Pair<String, Integer>> extractCitations(String cell, Theta θ) {
        return Regex.compile(θ["code.fix.scripts.validate_verification.citation_re"]).finditer(cell).map(m -> new Pair(m.group(1), toInt(m.group(2)))); // src: vulnhunter-fix/scripts/validate-verification.py:49
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:99")
    boolean checkCitationExists(Path worktree, String file, int line) {
        Path p = worktree.resolveChild(file); if (!p.isFile()) return false;
        try { with (Reader r = p.open("r", "utf-8", errors="replace")) { return line <= r.lines().count(); } } catch (OSError e) { return false; }
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:110")
    Object loadSidecarForVuln(Path dir, String id) {
        Path p = dir.resolve(id + ".json"); if (!p.isFile()) return null;
        try { return Json.parse(p.readText("utf-8")); } catch (OSError | JsonDecodeError e) { return null; }
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:120")
    Object loadResult(Path path) {
        if (path == null || !path.isFile()) return null;
        try { return Json.parse(path.readText("utf-8")); } catch (OSError | JsonDecodeError e) { return null; }
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:129")
    Pair parseColumn7Callers(String cell, Theta θ) {
        Match match = Regex.compile(θ["code.fix.scripts.validate_verification.truncation_suffix_re"]).search(cell); // src: vulnhunter-fix/scripts/validate-verification.py:50
        Integer extra = match == null ? null : toInt(match.group(1));
        List callers = Regex.compile(θ["code.fix.scripts.validate_verification.caller_pair_re"]).findall(cell).filter(pair -> !pair.second.isdigit()).map(pair -> pair.first + ":" + pair.second); // src: vulnhunter-fix/scripts/validate-verification.py:134
        return new Pair(callers, extra);
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:139")
    Pair tokenizeCaller(String caller) {
        Pair split = caller.rpartition(":"); return new Pair(Path.of(split.before).name, split.after.lower()); // only symbol lowercased; basename retains case.
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:145")
    void checkColumn7(String cell, Object sidecar, Object result, List errors, String label, Theta θ) {
        if (cellKind(cell, θ) != "yes") return;
        if (!truthy(sidecar)) { errors.add(label + ": yes without sidecar"); return; }
        List graph = iterable(truthyOr(sidecar.get("callers_of_sink"), List.of())).toList(); Object confidence = sidecar.get("confidence");
        if (!List.of("high", "low").contains(confidence)) { errors.add("invalid confidence; using low"); confidence = "low"; }
        if (graph.isEmpty() && !cell.lower().contains("(no callers)")) { errors.add("unsubstantiated coverage claim"); return; }
        Pair parsed = parseColumn7Callers(cell, θ); List listed = parsed.first; Integer extra = parsed.second; int total = listed.size() + truthyOr(extra, 0);
        int cap = θ["code.fix.scripts.validate_verification.caller_enumeration_limit"]; // src: vulnhunter-fix/scripts/validate-verification.py:191
        if (extra != null) {
            if (graph.size() <= cap) errors.add("truncation forbidden for small caller set");
            if (listed.size() != cap) errors.add("truncation must list exactly the cap");
            if (total != graph.size()) errors.add("caller count mismatch");
        } else if (graph.size() > cap) errors.add("large caller set must use truncation");
        Set routed = Set.copyOf(truthyOr(truthyOr(result, Map.of()).get("callers_routed_through_fix"), List.of()));
        // Coverage is matched against result.routed, not the textual listed caller identities; listed identities only affect counts.
        if (confidence == "high") { if (graph.anyMatch(c -> !routed.contains(c))) errors.add("strict caller match failed"); }
        else {
            if (!graph.map(c -> tokenizeCaller(c)).toSet().minus(routed.map(c -> tokenizeCaller(c)).toSet()).isEmpty()) errors.add("token caller match failed");
            if (!cell.contains("(grep_fallback)")) errors.add("missing grep_fallback annotation");
        }
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:233")
    int validate(Path body, Path worktree, Path sidecars, Path resultPath, Theta θ) {
        String text;
        try { text = body.readText("utf-8"); } catch (OSError e) { printError(e); return 2; }
        Pair parsed = parseTable(text, θ); if (parsed == null) { printError("table absent"); return 1; }
        List errors = new List(); checkHeader(parsed.first, errors, θ);
        Regex vuln = Regex.compile(θ["code.fix.scripts.validate_verification.vuln_id_re"], IGNORECASE); // src: vulnhunter-fix/scripts/validate-verification.py:249
        for (List row : parsed.second) {
            Match m = vuln.search(row.get(1)); String label = "row " + truthyOr(row.get(0), "?"); String id = m == null ? null : m.group(0).upper();
            for (int idx = 2; idx < 8; idx++) {
                String kind = cellKind(row.get(idx), θ);
                if (kind == "yes") {
                    List citations = extractCitations(row.get(idx), θ); if (citations.isEmpty() && idx != 6) errors.add("yes missing citation");
                    for (Pair citation : citations) if (!checkCitationExists(worktree, citation.first, citation.second)) errors.add("citation does not resolve");
                } else if (kind == "unknown") errors.add("unknown cell value");
            }
            if (id != null) checkColumn7(row.get(6), sidecars != null ? loadSidecarForVuln(sidecars, id) : null, loadResult(resultPath), errors, label, θ);
        }
        if (!errors.isEmpty()) { for (String e : errors) printError(body, e); return 1; } return 0;
    }
    @src("vulnhunter-fix/scripts/validate-verification.py:290")
    int main(List<String> argv, Theta θ) {
        Object args = parseArgs(argv.tail(), required=List.of("pr_body"), defaults=Map.of("--worktree", currentDirectory(), "--sidecars-dir", null, "--result", null));
        return validate(args.prBody, args.worktree, args.sidecarsDir, args.result, θ);
    }
}
