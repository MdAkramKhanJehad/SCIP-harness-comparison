// file: vvaharness/pipeline/stages/s8/facts.py
// Deterministic repo facts for the S8 prompt: redacted snippets (with decorator prologue),
// same-location groups, and deployment exposure (binds, published ports, Dockerfile USER).

@executedBy(CODE) @role(io) @stage("S8")
class S8Facts {

    // MAX_SNIPPET_CHARS = 1200, MAX_DECORATOR_LINES = 4, MAX_PROLOGUE_CHARS = 200 (code constants)

    String snippetFor(Finding f, String repoRoot, boolean includeDecorators) {
        String text = f.codeSnippet.strip();
        // Redact on BOTH paths: S5 backfills from raw text.
        if (!text.isEmpty()) text = S4Deepdive.redactSource(text, f.file, "s8");                // src: vvaharness/pipeline/stages/s8/facts.py:96
        else text = readRange(repoRoot, f.file, f.lineStart, f.lineEnd);                       // src: vvaharness/pipeline/stages/s8/facts.py:98
        if (includeDecorators) {                                                                // src: vvaharness/pipeline/stages/s8/facts.py:99
            String prologue = decoratorLines(repoRoot, f.file, f.lineStart);
            if (!prologue.isEmpty() && !text.contains(prologue.lastLine())) text = prologue + "\n" + text; // src: vvaharness/pipeline/stages/s8/facts.py:103
        }
        if (text.length() > 1200) text = text.truncate(1200) + "\n... (snippet truncated)";     // src: vvaharness/pipeline/stages/s8/facts.py:105
        return text;
    }

    List<String> sameLocationGroups(List<Finding> findings, List<String> labels) {
        Map groups = zip(labels, findings).groupBy(lf -> Pair.of(lf.f.file, lf.f.lineStart), lf -> lf.label); // src: vvaharness/pipeline/stages/s8/facts.py:173
        return groups.filter(g -> g.ids.size() > 1).map(g -> g.ids.join(", ") + " are all at " + g.key + " - ONE code fact"); // src: vvaharness/pipeline/stages/s8/facts.py:176
    }

    List<String> exposureFacts(ContextPackage ctx, List<Finding> findings, boolean userFacts) {
        List<String> facts = new List();
        List<String> names = List.of("Dockerfile", "docker-compose.yml", "docker-compose.yaml", "compose.yml", "Makefile")
                           + sorted(findings.files()).first(60);                                // src: vvaharness/pipeline/stages/s8/facts.py:206
        for (String rel : names.distinct()) {                                                   // src: vvaharness/pipeline/stages/s8/facts.py:208
            String text = Repo.readContained(ctx.repoRoot, rel);
            if (text == null) continue;
            if (userFacts && isDockerfileName(rel)) facts.addAll(userDirectiveFacts(rel, text)); // src: vvaharness/pipeline/stages/s8/facts.py:217
            for (Match m : BIND_RX.finditer(text)) {                                            // src: vvaharness/pipeline/stages/s8/facts.py:219
                if (m.host != null) { if (realHost(m.host)) facts.add(rel + " binds " + m.host + (Net.isLoopback(m.host) ? " (LOOPBACK)" : " (all interfaces - remotely reachable)")); } // src: vvaharness/pipeline/stages/s8/facts.py:221
                else if (m.port != null && rel.contains("compose")) facts.add(rel + " publishes port " + m.port + " to the host"); // src: vvaharness/pipeline/stages/s8/facts.py:233
                else if (m.to != null && realHost(m.from) && realHost(m.to)) facts.add(rel + " rewrites the bind " + m.from + " -> " + m.to); // src: vvaharness/pipeline/stages/s8/facts.py:237
            }
        }
        return facts.distinct().first(12);                                                      // src: vvaharness/pipeline/stages/s8/facts.py:241
    }
}
