    }

    Triple<Integer, Integer, String> terminalStats(HarnessResult terminal) {
        // Message count, tool-call count and trailing-message shape, for diagnostics. A trailing AIMessage that still carries tool calls means the loop was truncated.
        List<Message> messages = terminal.state != null ? terminal.state.getOr("messages", List.of()) : List.of(); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:147
        int toolCalls = messages.sum(m -> m.toolCalls.size());                                      // src: vvaharness/remediation_agent/plugin_runner/__init__.py:148
        Message last = !messages.isEmpty() ? messages.get(messages.size() - 1) : null;              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:149
        boolean pending = last != null && !last.toolCalls.isEmpty() && last.typeName.equals("AIMessage"); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:150
        String shape = pending ? "pending_tool_call(loop_truncated)" : (last != null ? last.typeName : "empty"); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:151
        return Triple.of(messages.size(), toolCalls, shape);                                        // src: vvaharness/remediation_agent/plugin_runner/__init__.py:152
    }

    void debugTerminal(HarnessResult terminal) {
        // Dump why a terminal lacks structured output (tool-call trail and state) to the debug log; only when the debug log is configured.
        if (Os.getenv("VVAHARNESS_DEBUG_LOG") == null) return;                                      // src: vvaharness/remediation_agent/plugin_runner/__init__.py:157
        Triple<Integer, Integer, String> stats = terminalStats(terminal);                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:159
        debugLog("TERMINAL.structured_is_none", String.valueOf(terminal.structured == null));       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:160
        debugLog("TERMINAL.stats", "messages=" + stats.first + " tool_calls=" + stats.second + " last=" + stats.third); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:163
        for (Message msg : terminal.state.getOr("messages", List.of()).takeLast(8)) {               // src: vvaharness/remediation_agent/plugin_runner/__init__.py:164  (display: last 8 messages)
            debugLog("STATE_MSG." + msg.typeName, "tool_calls=" + msg.toolCalls.map(c -> c.name));  // src: vvaharness/remediation_agent/plugin_runner/__init__.py:166
        }
    }

    void reportRecursionLimit(HarnessResult terminal, StreamingOptions options, Theta θ) {
        // Surface a swallowed recursion-limit truncation with actionable advice: the LangGraph recursion limit is step_remediate.max_turns plus RECURSION_HEADROOM, so raising max_turns only lengthens the loop; max_model_calls forces a final verdict turn well before it.
        Triple<Integer, Integer, String> stats = terminalStats(terminal);                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:175
        int limit = DeepagentsLimits.recursionLimit(options.maxTurns != null ? options.maxTurns : 0, θ); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:176  (max_turns or 50)
        Console.write("[deepagents] " + options.model + " HIT THE LANGGRAPH RECURSION LIMIT (recursion_limit=" + limit + "); no structured verdict. ACTION: set step_remediate.max_model_calls (e.g. 20)."); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:186
        debugLog("RECURSION_LIMIT_HIT", "limit=" + limit + " tool_calls=" + stats.second + " messages=" + stats.first + " last=" + stats.third); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:187
    }

