# vvaharness/remediation_agent/artifacts/diff/paths.py

Path normalization and repository confinement (CWE-22) shared by every diff, snapshot and revert step. File references come from findings and from model output, so each one is confined before use.

Source: `vvaharness/remediation_agent/artifacts/diff/paths.py` (lines 1-49)
Executor: code
Called from: `artifacts/diff/snapshot.sudo`, `artifacts/diff/synth.sudo`, `artifacts/diff/gitcapture.sudo`, `policy/revert.sudo`, `policy/postgate.sudo`, `policy/workflow_refs.sudo`

// src: vvaharness/remediation_agent/artifacts/diff/paths.py:25-26
_UNC_OR_DRIVE = /^(?:[\\\/]{2}|[A-Za-z]:)/   // Path.is_absolute sees UNC and drive prefixes only on Windows; on POSIX a UNC reference could leak a NetNTLMv2 hash

// src: vvaharness/remediation_agent/artifacts/diff/paths.py:29-35
fn _norm_path(ref):executor=code {
  ref = trimmed ref; if (!ref) return ""
  return ref without a trailing ":<line>" or ":<start>-<end>"   // a drive-letter colon survives
}

// src: vvaharness/remediation_agent/artifacts/diff/paths.py:38-49
fn _safe_repo_path(repo, ref):executor=code {
  rel = _norm_path(ref)
  require rel && rel is not absolute && rel does not match _UNC_OR_DRIVE => return null
  try {
    target = resolved repo/rel   // follows symbolic links
    require target is inside resolved repo => return null
  } catch (ValueError | OSError) => return null
  return target
}
