// file: vvaharness/backends/harness/deepagents/permit_tools.py
// Executor-side gate: refuses any tool call whose name is not in the permitted set (FAILS CLOSED, logs names only).
// ExcludeTools only un-advertises; this blocks forged calls too.

@executedBy(CODE) @role(backend)
class PermitTools {
    Set<String> permitted;

    void init(Set<String> permitted) {
        this.permitted = permitted;                                                                      // src: vvaharness/backends/harness/deepagents/permit_tools.py:44
    }

    ToolMessage refusal(ToolCallRequest request) {
        String name = request.toolCall.get("name") != null ? request.toolCall.get("name") : "";          // src: vvaharness/backends/harness/deepagents/permit_tools.py:49
        if (permitted.contains(name)) return null;                                                       // src: vvaharness/backends/harness/deepagents/permit_tools.py:50
        log.warning("TOOL_CALL_REFUSED", name);                                                          // src: vvaharness/backends/harness/deepagents/permit_tools.py:52
        return new ToolMessage("Error: tool <name> is not permitted in this session and was not executed.", name, request.toolCall.get("id") != null ? request.toolCall.get("id") : "", "error"); // src: vvaharness/backends/harness/deepagents/permit_tools.py:53
    }

    ToolResult wrapToolCall(ToolCallRequest request, Handler handler) {
        ToolMessage r = refusal(request);                                                                // src: vvaharness/backends/harness/deepagents/permit_tools.py:69
        return r != null ? r : handler.call(request);                                                    // src: vvaharness/backends/harness/deepagents/permit_tools.py:69
    }

    // Async counterpart of wrapToolCall: a refusal short-circuits, else the awaited handler runs.
    ToolResult awrapToolCall(ToolCallRequest request, Handler handler) {
        ToolMessage r = refusal(request);                                                                // src: vvaharness/backends/harness/deepagents/permit_tools.py:78
        return r != null ? r : await handler.call(request);                                              // src: vvaharness/backends/harness/deepagents/permit_tools.py:78
    }
}
