# vvaharness/validation/session/config_inject.py

Copies the packaged `.claude/` configuration (rules, skills, the transcript hook and settings.json) into the staged workspace for the Claude backends, and creates the log directories.

Source: `vvaharness/validation/session/config_inject.py` (lines 1-73)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` launch_session (only when the route reads injected Claude configuration: cli, sdk)

// src: vvaharness/validation/session/config_inject.py:32-33
CLAUDE_CONFIG_SOURCE = "<package>/validation/claude_config"

// src: vvaharness/validation/session/config_inject.py:47-73
fn inject_claude_config(workspace_dir):executor=code {
  // "Scoring package is deliberately NOT copied: scoring is host-side, the agent has no shell"
  dest = "$workspace_dir/.claude"
  if (dest exists) delete dest   // replaces anything the staged copy had (the staging copy keeps a repository's own .claude/)
  create dest
  require CLAUDE_CONFIG_SOURCE/rules exists => throw FileNotFoundError("required claude_config rules/ missing at ...")
  copy CLAUDE_CONFIG_SOURCE/rules to dest/rules   // scoring-matrix.md, adversarial-review.md
  if (CLAUDE_CONFIG_SOURCE/skills exists) copy it to dest/skills   // optional; validation-scoring/SKILL.md
  _inject_hooks(dest)
  copy CLAUDE_CONFIG_SOURCE/settings.json to dest/settings.json   // see claude_config/settings.sudo.md
  create "$workspace_dir/logging/orchestrator" and "$workspace_dir/logging/subagents"
  catch OSError => log and throw
}

// src: vvaharness/validation/session/config_inject.py:36-44
fn _inject_hooks(dest_claude):executor=code {
  create dest_claude/hooks/logging
  if (CLAUDE_CONFIG_SOURCE/hooks/logging/capture_transcript.sh exists) copy it there with mode 0755
}
