// file: harness/local_harness/benchmark/tally.py
// Benchmark tally: detection rate (recall) overall and per vulnerability type from judge verdicts,
// plus cost/time/token aggregates; writes tally.json and BENCHMARK_REPORT.md and prints a console summary.

@executedBy(CODE) @role(evaluation)
class BenchmarkTally {

    // seconds to "43m 12s" or "1h 23m"; zero or empty gives "0s"
    String fmtDuration(Number seconds) {
        if (!seconds) return "0s";                                                              // src: harness/local_harness/benchmark/tally.py:12
        int s = int(seconds);
        if (s < 60) return s + "s";                                                             // src: harness/local_harness/benchmark/tally.py:15
        if (s < 3600) return (s / 60) + "m " + (s % 60) + "s";                                  // src: harness/local_harness/benchmark/tally.py:17
        int h = s / 3600;
        int rem = s % 3600;
        return h + "h " + (rem / 60) + "m";   // seconds dropped in the hour form              // src: harness/local_harness/benchmark/tally.py:22
    }

    Tally generateTally(State state, Theta θ) {
        String metric = θ["harness.metric"];  // recall only; no precision / FP metric         // src: harness/local_harness/benchmark/tally.py:25
        Map judgments = state.getOr("judgments", Map.of());                                     // src: harness/local_harness/benchmark/tally.py:30
        Map scanTargets = state.getOr("scan_targets", Map.of());
        List<Row> findings = new List();
        Map byType = new DefaultMap(() -> Map.of("total", 0, "detected", 0, "missed", 0, "error", 0)); // src: harness/local_harness/benchmark/tally.py:34
        for (Entry e : judgments) {                                                             // src: harness/local_harness/benchmark/tally.py:36
            Boolean detected = e.judgment.get("detected");   // true, false or null (judge error / timeout)
            String type = e.judgment.getOr("type", "Unknown");
            byType.get(type).total++;
            if (detected == true) byType.get(type).detected++;                                  // src: harness/local_harness/benchmark/tally.py:41
            else if (detected == false) byType.get(type).missed++;
            else byType.get(type).error++;
            findings.add(Row.of(e.findingId, e.judgment.getOr("benchmark_file", ""), type, e.judgment.getOr("repo_name", ""),
                e.judgment.getOr("commit_hash", "").substring(0, 8), detected, e.judgment.get("confidence"),
                e.judgment.getOr("reasoning", ""), e.judgment.get("matched_finding_id")));      // src: harness/local_harness/benchmark/tally.py:53
        }
        int total = findings.size();
        int det = findings.count(f -> f.detected == true);
        int missed = findings.count(f -> f.detected == false);
        int errors = findings.count(f -> f.detected == null);
        double detectionRate = total > 0 ? (double) det / total : 0.0;                          // src: harness/local_harness/benchmark/tally.py:64
        int scanFailures = scanTargets.values().count(t -> t.get("status") == "scan_failed");   // src: harness/local_harness/benchmark/tally.py:66

        double totalCost = 0.0;
        double totalElapsed = 0;
        long totalIn = 0, totalOut = 0, totalCacheRead = 0, totalCacheCreate = 0, totalTurns = 0;
        List<Map> perScan = new List();
        for (Entry t : scanTargets) {                                                           // src: harness/local_harness/benchmark/tally.py:79
            // every field uses "x or 0": null and zero both count as 0
            double cost = t.data.get("scan_total_cost_usd") or 0;
            double elapsed = t.data.get("scan_elapsed_s") or 0;
            totalCost += cost;
            totalElapsed += elapsed;
            totalIn += t.data.get("scan_input_tokens") or 0;
            totalOut += t.data.get("scan_output_tokens") or 0;
            totalCacheRead += t.data.get("scan_cache_read_tokens") or 0;
            totalCacheCreate += t.data.get("scan_cache_creation_tokens") or 0;
            totalTurns += t.data.get("scan_num_turns") or 0;
            if (cost || elapsed) perScan.add(Map.of("target", t.key, "cost_usd", cost, "elapsed_s", elapsed, "input_tokens", t.data.tokens("input"), "output_tokens", t.data.tokens("output"), "cache_read_tokens", t.data.tokens("cache_read"), "cache_creation_tokens", t.data.tokens("cache_creation"), "num_turns", t.data.turns())); // src: harness/local_harness/benchmark/tally.py:90
        }
        Map cost = Map.of("total_cost_usd", round(totalCost, 2), "total_elapsed_s", totalElapsed, "total_input_tokens", totalIn,
            "total_output_tokens", totalOut, "total_cache_read_tokens", totalCacheRead, "total_cache_creation_tokens", totalCacheCreate,
            "total_num_turns", totalTurns, "scans_counted", perScan.size(),
            "avg_cost_per_scan_usd", !perScan.isEmpty() ? round(totalCost / perScan.size(), 2) : 0,
            "avg_elapsed_per_scan_s", !perScan.isEmpty() ? round(totalElapsed / perScan.size()) : 0,
            "per_scan", perScan.sortedBy(x -> x.cost_usd).reversed());                          // src: harness/local_harness/benchmark/tally.py:122
        return new Tally(Clock.nowIso(), state.getOr("model", "unknown"), total, det, missed, errors, round(detectionRate, 4), scanFailures, byType, cost, findings.sortBy("benchmark_file", "finding_id")); // src: harness/local_harness/benchmark/tally.py:100
    }

    void writeTallyJson(Tally t) {
        LocalHarnessConfig.atomicWriteJson(TALLY_FILE, t);                                      // src: harness/local_harness/benchmark/tally.py:133
        Log.print("Tally JSON written");
    }

    void writeTallyMarkdown(Tally t) {
        Fs.makedirs(RESULTS_DIR);                                                               // src: harness/local_harness/benchmark/tally.py:139
        List<String> lines = new List();
        lines.add("# VulnHunter Benchmark Report; generated, model and finding-count header");
        lines.add("## Summary table: total, detected (TP), missed (FN), judge errors, detection rate as percent with one decimal, scan failures"); // src: harness/local_harness/benchmark/tally.py:153
        lines.add("## Detection by Vulnerability Type: one row per type in sorted order");
        for (Entry c : t.summary.byType.sortedByKey()) {                                        // src: harness/local_harness/benchmark/tally.py:166
            String rate = c.total > 0 ? percent0(c.detected / c.total) : "N/A";                 // src: harness/local_harness/benchmark/tally.py:169
            lines.add(row(c.key, c.total, c.detected, c.missed, rate));
        }
        lines.add("## Per-Finding Results");
        int i = 1;
        for (Row f : t.findings) {                                                              // src: harness/local_harness/benchmark/tally.py:177
            String detStr = f.detected == true ? "YES" : (f.detected == false ? "NO" : "ERR");  // src: harness/local_harness/benchmark/tally.py:178
            String conf = f.confidence != null && f.confidence != "" ? f.confidence : "-";
            lines.add(row(i++, f.benchmarkFile, f.findingId, f.type, detStr, conf));
        }
        List<Row> missedRows = t.findings.filter(f -> f.detected == false);
        if (!missedRows.isEmpty()) {                                                            // src: harness/local_harness/benchmark/tally.py:184
            lines.add("## Missed Findings (False Negatives): finding id, type, repo and judge reasoning");
        }
        if (t.cost.total_cost_usd || t.cost.total_elapsed_s) {                                  // src: harness/local_harness/benchmark/tally.py:190
            lines.add("## Cost and Performance: cost, averages, wall time via fmtDuration, token totals, turns, scans counted");
            if (!t.cost.per_scan.isEmpty()) lines.add("### Per-Scan Breakdown: target, cost, fmtDuration time, in/out tokens with total, turns"); // src: harness/local_harness/benchmark/tally.py:211
        }
        Fs.write(TALLY_REPORT, lines.join("\n"));                                               // src: harness/local_harness/benchmark/tally.py:218
        Log.print("Benchmark report written");
    }

    void printSummary(Tally tally) {
        Map s = tally.summary;                                                                  // src: harness/local_harness/benchmark/tally.py:225
        Map cost = tally.getOr("cost", Map.of());
        Console.print("BENCHMARK RESULTS: detected/total with detection rate as percent");        // src: harness/local_harness/benchmark/tally.py:227
        Console.print("Detected, Missed, Errors, Scan fails counts");
        for (Entry c : s.by_type.sortedByKey()) {                                               // src: harness/local_harness/benchmark/tally.py:237
            Console.print(c.key + " " + c.detected + "/" + c.total + (c.total > 0 ? " (" + percent0(c.detected / c.total) + ")" : " (N/A)"));
        }
        if (cost.get("total_cost_usd") || cost.get("total_elapsed_s")) {                        // src: harness/local_harness/benchmark/tally.py:243
            long allTokens = cost.getOr("total_input_tokens", 0) + cost.getOr("total_output_tokens", 0) + cost.getOr("total_cache_read_tokens", 0) + cost.getOr("total_cache_creation_tokens", 0); // src: harness/local_harness/benchmark/tally.py:250
            Console.print("COST AND PERFORMANCE: total cost, avg cost per scan, wall time and avg time per scan via fmtDuration, token total with in/out/cache-read, turns, scans counted");
        }
        if (s.missed > 0) Console.print("hint: run local_harness.benchmark.analyze_misses for tuning suggestions"); // src: harness/local_harness/benchmark/tally.py:260
    }
}
