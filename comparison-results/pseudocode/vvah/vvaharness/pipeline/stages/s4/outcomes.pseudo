// file: vvaharness/pipeline/stages/s4/outcomes.py
// S4's output contract (Pydantic schemas whose Field descriptions are prompt text the model sees) and the
// reducer from raw session replies to findings plus a per-unit verdict (confirmed/refuted/inconclusive,
// or failed/uninvestigated for a lost reply).

@executedBy(MODEL) @role(prompt) @stage("S4")
class S4Outcomes {

    // Main entry: the schema prompt (InvestigationOutcome) handed to the model as the structured output.
    Schema run(Theta θ) {
        return investigationOutcomeSchema(θ);
    }

    // InvestigatedFinding: one finding's fields; each description is an instruction.
    Prompt investigatedFindingSchema(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.output_schema_text"]);        // much instruction lives in the Field descriptions // src: vvaharness/pipeline/stages/s4/outcomes.py:34
        p.threshold(θ["p.s4_outcomes.cwe_exactly_one_most_specific"]);       // cwe: exactly one most-specific id, e.g. CWE-89 // src: vvaharness/pipeline/stages/s4/outcomes.py:35
        p.must(θ["p.s4_outcomes.file_from_threat_files_list"]);              // file: repo-relative, from FILES  // src: vvaharness/pipeline/stages/s4/outcomes.py:36
        p.format(θ["p.s4_outcomes.line_start_first_line_of_span"]);          // line_start: 1-indexed FIRST line // src: vvaharness/pipeline/stages/s4/outcomes.py:37
        p.exemption(θ["p.s4_outcomes.line_start_may_be_decorator"]);         // may start at decorator/signature // src: vvaharness/pipeline/stages/s4/outcomes.py:38
        p.format(θ["p.s4_outcomes.sink_line_single_statement"]);             // sink_line: the one dangerous statement // src: vvaharness/pipeline/stages/s4/outcomes.py:40
        p.exemption(θ["p.s4_outcomes.sink_line_zero_when_no_statement"]);    // 0 e.g. for a missing control      // src: vvaharness/pipeline/stages/s4/outcomes.py:42
        p.format(θ["p.s4_outcomes.line_end_inclusive_not_repeat"]);          // inclusive LAST line, not line_start again // src: vvaharness/pipeline/stages/s4/outcomes.py:46
        p.must(θ["p.s4_outcomes.line_end_span_whole_construct"]);            // decorator to end of body          // src: vvaharness/pipeline/stages/s4/outcomes.py:47
        p.exemption(θ["p.s4_outcomes.line_end_zero_only_if_unboundable"]);   // 0 only when genuinely unboundable // src: vvaharness/pipeline/stages/s4/outcomes.py:48
        p.rule(θ["p.s4_outcomes.also_cwes_distinct_colocated"]);             // also_cwes: other DISTINCT classes here (1004/614, 352/862) // src: vvaharness/pipeline/stages/s4/outcomes.py:51
        p.rule(θ["p.s4_outcomes.also_cwes_each_becomes_finding"]);           // each id becomes its own finding   // src: vvaharness/pipeline/stages/s4/outcomes.py:54
        p.forbid(θ["p.s4_outcomes.also_cwes_no_parent_or_sibling"]);         // no parent/sibling meaning the same // src: vvaharness/pipeline/stages/s4/outcomes.py:56
        p.rule(θ["p.s4_outcomes.repeat_lines_same_file_sites"]);             // repeat_lines: first line of every extra site, SAME file // src: vvaharness/pipeline/stages/s4/outcomes.py:59
        p.format(θ["p.s4_outcomes.repeat_lines_integers_only"]);             // one integer each, no prose        // src: vvaharness/pipeline/stages/s4/outcomes.py:60
        p.forbid(θ["p.s4_outcomes.repeat_lines_sites_not_summary"]);         // no span swallowing several sites  // src: vvaharness/pipeline/stages/s4/outcomes.py:62
        p.forbid(θ["p.s4_outcomes.repeat_lines_no_pick_one"]);               // empty only when it occurs once    // src: vvaharness/pipeline/stages/s4/outcomes.py:64
        p.format(θ["p.s4_outcomes.preconditions_one_condition_per_entry"]);  // preconditions: one concrete condition each // src: vvaharness/pipeline/stages/s4/outcomes.py:67
        p.checklist(θ["p.s4_outcomes.preconditions_gate_types"]);            // unauth reach, flag/config, input shape, role/session // src: vvaharness/pipeline/stages/s4/outcomes.py:68
        p.forbid(θ["p.s4_outcomes.preconditions_empty_only_if_unconditional"]); // never empty as a default       // src: vvaharness/pipeline/stages/s4/outcomes.py:74
        p.choose(θ["p.s4_outcomes.vuln_class_folds_to_other"]);              // VulnClass enum; unknown -> OTHER  // src: vvaharness/pipeline/stages/s4/outcomes.py:91
        p.threshold(θ["p.s4_outcomes.title_max_12_words"]);                  // title: one line, <= 12 words      // src: vvaharness/pipeline/stages/s4/outcomes.py:93
        p.forbid(θ["p.s4_outcomes.severity_one_enum_no_argument"]);          // one enum; s6 re-scores from CVSS  // src: vvaharness/pipeline/stages/s4/outcomes.py:95
        p.threshold(θ["p.s4_outcomes.description_max_two_sentences"]);       // description <= 2 sentences        // src: vvaharness/pipeline/stages/s4/outcomes.py:97
        p.forbid(θ["p.s4_outcomes.description_no_restatement"]);             // no code, title, exploit or fix    // src: vvaharness/pipeline/stages/s4/outcomes.py:98
        p.threshold(θ["p.s4_outcomes.exploit_scenario_max_five_sentences"]); // input -> impact, <= 5 sentences  // src: vvaharness/pipeline/stages/s4/outcomes.py:101
        p.must(θ["p.s4_outcomes.exploit_scenario_only_seen_features"]);      // only features seen in this repo   // src: vvaharness/pipeline/stages/s4/outcomes.py:103
        p.tiebreak(θ["p.s4_outcomes.exploit_scenario_conditional_if_unseen"]); // word conditionally or stop at shown impact // src: vvaharness/pipeline/stages/s4/outcomes.py:104
        p.rule(θ["p.s4_outcomes.exploit_scenario_unsupported_is_false_claim"]);                          // src: vvaharness/pipeline/stages/s4/outcomes.py:106
        p.threshold(θ["p.s4_outcomes.recommendation_max_two_sentences"]);    // recommendation <= 2 sentences, name the API/control // src: vvaharness/pipeline/stages/s4/outcomes.py:108
        p.forbid(θ["p.s4_outcomes.recommendation_no_alternatives_or_code"]);                             // src: vvaharness/pipeline/stages/s4/outcomes.py:109
        return p;
    }

    Schema investigationOutcomeSchema(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s4_outcomes.unit_id_echo_verbatim"]);                     // unit_id: echo verbatim           // src: vvaharness/pipeline/stages/s4/outcomes.py:113
        p.choose(θ["p.s4_outcomes.verdict_set"]);                             // confirmed | refuted | inconclusive // src: vvaharness/pipeline/stages/s4/outcomes.py:114
        p.rule(θ["p.s4_outcomes.verdict_refuted_requires_whole_surface"]);    // refuted = whole surface read; say why // src: vvaharness/pipeline/stages/s4/outcomes.py:115
        p.rule(θ["p.s4_outcomes.verdict_inconclusive_when_unreachable"]);     // inconclusive = evidence not reached // src: vvaharness/pipeline/stages/s4/outcomes.py:116
        p.forbid(θ["p.s4_outcomes.verdict_confirmed_not_default"]);           // Do NOT use confirmed as a default // src: vvaharness/pipeline/stages/s4/outcomes.py:116
        p.format(θ["p.s4_outcomes.rationale_1_to_3_sentences"]);              // required for refuted              // src: vvaharness/pipeline/stages/s4/outcomes.py:117
        p.must(θ["p.s4_outcomes.findings_every_distinct_class"]);             // a list, not one                   // src: vvaharness/pipeline/stages/s4/outcomes.py:119
        p.exemption(θ["p.s4_outcomes.findings_empty_when_refuted"]);                                     // src: vvaharness/pipeline/stages/s4/outcomes.py:120
        p.include(investigatedFindingSchema(θ));                                                         // src: vvaharness/pipeline/stages/s4/outcomes.py:118
        return new Schema("InvestigationOutcome", p);
    }

    Schema investigationOutcomesSchema(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.s4_outcomes.outcomes_one_entry_per_unit"]);               // ONE entry per UNIT, refuted included // src: vvaharness/pipeline/stages/s4/outcomes.py:125
        p.rule(θ["p.s4_outcomes.outcomes_omitted_unit_is_uninvestigated"]);   // omitted -> uninvestigated, not clean // src: vvaharness/pipeline/stages/s4/outcomes.py:126
        p.include(investigationOutcomeSchema(θ).prompt);
        return new Schema("InvestigationOutcomes", p);
    }
}

@executedBy(CODE) @role(step) @stage("S4")
class S4OutcomeReducer {

    // Coercions on the schema: a malformed sink_line/line_end/repeat site folds to 0 instead of failing the outcome.
    int coerceLine(Object v) {
        return coerceInt(v, 0);                                                                          // src: vvaharness/pipeline/stages/s4/outcomes.py:80
    }

    // Parse one raw reply: strict JSON, then salvaged JSON, else null (counted as truncated or malformed).
    InvestigationOutcome parseOutcome(String raw) {
        InvestigationOutcome o = validateDirect(raw);                                                    // src: vvaharness/pipeline/stages/s4/outcomes.py:194
        if (o != null) return o;
        o = validateSalvaged(extractJson(raw));                                                          // src: vvaharness/pipeline/stages/s4/outcomes.py:197
        if (o != null) return o;
        if (!raw.strip().isEmpty() && !raw.strip().endsWith("}")) Counters.bump("s4_outcome_truncated"); // src: vvaharness/pipeline/stages/s4/outcomes.py:186
        else Counters.bump("s4_outcome_malformed");                                                      // src: vvaharness/pipeline/stages/s4/outcomes.py:189
        return null;
    }

    // Batched reply: {outcomes:[...]} strict, salvaged, or a bare single outcome.
    InvestigationOutcomes asBatch(String raw) {
        InvestigationOutcomes b = validateBatchDirect(raw);                                              // src: vvaharness/pipeline/stages/s4/outcomes.py:152
        if (b == null) b = validateBatchSalvaged(raw);
        if (b != null) return b;
        InvestigationOutcome lone = parseOutcome(raw);                                                   // src: vvaharness/pipeline/stages/s4/outcomes.py:155
        return lone != null ? new InvestigationOutcomes(List.of(lone)) : null;
    }

    // Fan one batched reply out to per-unit replies; invented ids dropped, omitted ids absent.
    Map<String, String> splitBatchReply(String raw, List<String> unitIds) {
        InvestigationOutcomes batch = asBatch(raw);                                                      // src: vvaharness/pipeline/stages/s4/outcomes.py:161
        if (batch == null) return Map.of();                                                              // src: vvaharness/pipeline/stages/s4/outcomes.py:163
        Map<String, String> byUnit = new Map();
        for (InvestigationOutcome o : batch.outcomes) {
            if (!unitIds.contains(o.unitId)) {                                                           // src: vvaharness/pipeline/stages/s4/outcomes.py:167
                Counters.bump("s4_batch_unit_id_invented");
                continue;
            }
            byUnit.put(o.unitId, o.toJson());                                                            // src: vvaharness/pipeline/stages/s4/outcomes.py:170
        }
        return byUnit;
    }

    String resolvedCwe(InvestigatedFinding f, List<String> fallbackCwes) {
        String cwe = normCwe(f.cwe);                                                                     // src: vvaharness/pipeline/stages/s4/outcomes.py:206
        if (cwe != null) return cwe;
        // backfill from the unit's deterministic CWEs
        return fallbackCwes.isEmpty() ? null : fallbackCwes.get(0);                                      // src: vvaharness/pipeline/stages/s4/outcomes.py:209
    }

    List<String> extraCwes(InvestigatedFinding f, String primary, int maxExtra) {
        List<String> seen = new List();
        for (String raw : f.alsoCwes) {
            String c = normCwe(raw);
            if (c == null || c == primary || seen.contains(c)) continue;                                 // src: vvaharness/pipeline/stages/s4/outcomes.py:234
            if (primary != null && sameWeakness(primary, c)) continue;   // collapsed: parent/sibling     // src: vvaharness/pipeline/stages/s4/outcomes.py:236
            seen.add(c);
        }
        return seen.take(max(maxExtra, 0));                                                              // src: vvaharness/pipeline/stages/s4/outcomes.py:245
    }

    // Fan a finding out over its repeat sites x (primary + surviving extra CWEs).
    List<Finding> fanOut(InvestigatedFinding f, String chunkId, List<String> fallbackCwes, String repoRoot, Set<String> inventory, Theta θ) {
        f.file = resolveInventoryPath(repoRoot, f.file, inventory);                                      // src: vvaharness/pipeline/stages/s4/outcomes.py:252
        String cwe = resolvedCwe(f, fallbackCwes);                                                       // src: vvaharness/pipeline/stages/s4/outcomes.py:253
        int width = max(f.lineEnd, f.lineStart) - f.lineStart;                                           // src: vvaharness/pipeline/stages/s4/outcomes.py:254
        List<Integer> anchors = concat(List.of(f.lineStart), f.repeatLines.distinctSorted().filter(n -> n > 0 && n != f.lineStart)); // src: vvaharness/pipeline/stages/s4/outcomes.py:256
        int maxExtra = θ["step4.max_extra_cwes"];                                                        // src: vvaharness/pipeline/stages/s4/outcomes.py:258
        List<String> cwes = concat(List.of(cwe), extraCwes(f, cwe, maxExtra));                           // src: vvaharness/pipeline/stages/s4/outcomes.py:259
        String sink = f.sinkLine >= 1 ? f.file + ":" + f.sinkLine : null;   // only on the primary anchor  // src: vvaharness/pipeline/stages/s4/outcomes.py:267
        List<Finding> out = new List();
        for (int n : anchors) for (String c : cwes) out.add(atLine(f, chunkId, c, n, width, n == f.lineStart ? sink : null)); // src: vvaharness/pipeline/stages/s4/outcomes.py:270
        return out;
    }

    // Every unit starts "uninvestigated"; an unparsable reply is "failed"; else the model's own verdict.
    Reduced reduceOutcomes(List<InvestigationUnit> units, Map<String, String> rawOutcomes, String repoRoot, Set<String> inventory, Theta θ) {
        Map<String, String> byUnit = units.toMap(u -> u.id, u -> "uninvestigated");                      // src: vvaharness/pipeline/stages/s4/outcomes.py:279
        List<Finding> findings = new List();
        for (String unitId : rawOutcomes.keys()) {
            if (!byUnit.containsKey(unitId)) {                                                           // src: vvaharness/pipeline/stages/s4/outcomes.py:283
                Counters.bump("s4_unit_id_invented");
                continue;
            }
            String raw = rawOutcomes.get(unitId);
            if (raw == null) continue;                                                                   // src: vvaharness/pipeline/stages/s4/outcomes.py:286
            InvestigationOutcome o = parseOutcome(raw);                                                  // src: vvaharness/pipeline/stages/s4/outcomes.py:288
            if (o == null) {
                byUnit.put(unitId, "failed");                                                            // src: vvaharness/pipeline/stages/s4/outcomes.py:290
                continue;
            }
            byUnit.put(unitId, o.verdict);    // confirmed | refuted | inconclusive                       // src: vvaharness/pipeline/stages/s4/outcomes.py:292
            // NOTE: findings are fanned out for every verdict; a refuted/inconclusive outcome's findings are not dropped here
            for (InvestigatedFinding f : o.findings) findings.addAll(fanOut(f, unitId, unitById(units, unitId).cwes, repoRoot, inventory, θ)); // src: vvaharness/pipeline/stages/s4/outcomes.py:294
        }
        return new Reduced(findings, byUnit);                                                            // src: vvaharness/pipeline/stages/s4/outcomes.py:300
    }
}
