// file: vvaharness/validation/report/augment.py
// Best-effort augmentation of the combined SARIF + Markdown report with S11 results; never fails the run.
// SARIF: match each finding to a result (fingerprint, then location, then unique title) and attach a
// properties.validation block (resultIdentifies/resultFingerprint/recordResultBlock are imported from pipeline/stages/s9/typed_sarif.py). MD: replace/append a "### Validation" section under each matched heading.

@executedBy(CODE) @role(io) @stage("S11")
class Augment {

    String BLOCK_KEY = "validation";                                                                 // under properties (SARIF 2.1.0)  // src: vvaharness/validation/report/augment.py:61
    String ALIAS_BLOCK_KEY = "validationAliases";                                                    // src: vvaharness/validation/report/augment.py:62

    void augmentReports(Path repo, List<ValidatedFinding> pairs, Path reportMd, Theta θ) {
        try {
            augment(repo, pairs, reportMd, θ);                                                        // src: vvaharness/validation/report/augment.py:70
        } catch (Exception e) {
            Log.warning("report augmentation skipped");                                              // never fails validation  // src: vvaharness/validation/report/augment.py:72
        }
    }

    void augment(Path repo, List<ValidatedFinding> pairs, Path reportMd, Theta θ) {
        CombinedReportPaths located = locateCombinedReport(repo, reportMd);                          // src: vvaharness/validation/report/augment.py:80
        if (located == null) {                                                                       // src: vvaharness/validation/report/augment.py:81
            Log.warning("no combined report; skipping report augmentation");
            return;
        }
        augmentSarif(located.sarif, pairs, θ);                                                          // src: vvaharness/validation/report/augment.py:86
        augmentMd(located.md, pairs, θ);                                                                // src: vvaharness/validation/report/augment.py:87
    }

    CombinedReportPaths locateCombinedReport(Path repo, Path reportMd) {
        if (reportMd != null) {                                                                      // explicit wins  // src: vvaharness/validation/report/augment.py:95
            Path md = repo.resolve("security-remediation").resolve(reportMd.withSuffix(".md").name()); // src: vvaharness/validation/report/augment.py:96
            Path sarif = md.withSuffix(".sarif");                                                    // src: vvaharness/validation/report/augment.py:97
            return (md.exists() && sarif.exists()) ? new CombinedReportPaths(sarif, md) : null;      // src: vvaharness/validation/report/augment.py:98
        }
        List<Path> sarifs = repo.resolve("security-remediation").glob("*_report.sarif").sorted();    // src: vvaharness/validation/report/augment.py:99
        if (sarifs.isEmpty()) return null;                                                           // src: vvaharness/validation/report/augment.py:100
        Path sarif = sarifs.last();                                                                  // newest by sorted name  // src: vvaharness/validation/report/augment.py:102
        Path md = sarif.withSuffix(".md");                                                           // src: vvaharness/validation/report/augment.py:103
        return md.exists() ? new CombinedReportPaths(sarif, md) : null;                              // src: vvaharness/validation/report/augment.py:104
    }

    String statusLabel(ValidationResult r, boolean sessionFailed) {
        if (sessionFailed) return "inconclusive";                                                    // src: vvaharness/validation/report/augment.py:112
        if (r.fixed.equals("Yes")) return "fixed";                                                   // src: vvaharness/validation/report/augment.py:114
        if (r.partiallyFixed.equals("Yes")) return "partially_fixed";                                // src: vvaharness/validation/report/augment.py:116
        if (r.notFixed.equals("Yes")) return "not_fixed";                                            // src: vvaharness/validation/report/augment.py:118
        return "inconclusive";                                                                       // src: vvaharness/validation/report/augment.py:120
    }

    String statusWord(ValidationResult r, boolean sessionFailed) {
        return Map.of("fixed", "Fixed", "partially_fixed", "Partially Fixed", "not_fixed", "Not Fixed", "inconclusive", "Inconclusive").get(statusLabel(r, sessionFailed)); // src: vvaharness/validation/report/augment.py:125
    }

    Map parseGates(String rawJson) {
        if (rawJson.isEmpty()) return new Map();                                                     // src: vvaharness/validation/report/augment.py:132
        try {
            Object parsed = Json.loads(rawJson);                                                     // src: vvaharness/validation/report/augment.py:135
            return parsed instanceof Map ? parsed : new Map();                                       // src: vvaharness/validation/report/augment.py:138
        } catch (ValueError e) {
            return new Map();                                                                        // src: vvaharness/validation/report/augment.py:137
        }
    }

    SarifValidationBlock validationBlock(ValidationResult r, boolean sessionFailed, Theta θ) {
        String reason = (r.reasonForDecision != null ? r.reasonForDecision : r.justification).strip(); // src: vvaharness/validation/report/augment.py:144
        if (sessionFailed && reason.isEmpty()) reason = "validation session failed; no verdict was reached"; // src: vvaharness/validation/report/augment.py:145
        return new SarifValidationBlock(statusLabel(r, sessionFailed),
            reason.prefix(θ["code.validation.report.augment.validation_reason_max_chars"]),          // src: vvaharness/validation/report/augment.py:149
            r.fixConfidence, r.prMergeReadiness, parseGates(r.gateResultsJson));                     // src: vvaharness/validation/report/augment.py:150
    }

    String normPath(String p) {
        return p.replace("\\", "/");                                                               // src: vvaharness/validation/report/augment.py:161
    }

    SarifLocation resultLoc(Map result) {
        try {
            Map physical = result.get("locations").get(0).get("physicalLocation");                   // src: vvaharness/validation/report/augment.py:169
            return new SarifLocation(normPath(physical.get("artifactLocation").get("uri")), int(physical.get("region").get("startLine"))); // src: vvaharness/validation/report/augment.py:172
        } catch (KeyError | IndexError | TypeError | ValueError e) {
            return null;                                                                             // src: vvaharness/validation/report/augment.py:176
        }
    }

    Map matchByLoc(List<Map> results, String file, int line) {
        SarifLocation target = new SarifLocation(normPath(file), line);                              // src: vvaharness/validation/report/augment.py:181
        for (Map r : results) if (resultLoc(r).equals(target)) return r;                             // exact (file, line)  // src: vvaharness/validation/report/augment.py:183
        return null;
    }

    String messageText(Map result) {
        return str(result.getOrDefault("message", new Map()).getOrDefault("text", ""));              // src: vvaharness/validation/report/augment.py:191
    }

    Map matchByTitle(List<Map> results, String title) {
        List<Map> hits = results.filter(r -> messageText(r).startsWith(title));                      // src: vvaharness/validation/report/augment.py:196
        return hits.size() == 1 ? hits.get(0) : null;                                                // only when unique  // src: vvaharness/validation/report/augment.py:197
    }

    Map matchByFingerprint(List<Map> results, String caseId) {
        if (caseId.isEmpty()) return null;                                                           // src: vvaharness/validation/report/augment.py:202
        for (Map r : results) if (resultIdentifies(r, caseId)) return r;                  // src: vvaharness/validation/report/augment.py:205
        return null;
    }

    Map matchSarif(List<Map> results, Finding finding, String caseId, Theta θ) {
        for (String strategy : θ["code.validation.report.augment.sarif_match_order"]) {              // fingerprint, location, title  // src: vvaharness/validation/report/augment.py:213
            if (strategy.equals("fingerprint")) {
                Map hit = matchByFingerprint(results, caseId);                                       // src: vvaharness/validation/report/augment.py:214
                if (hit != null) return hit;                                                         // src: vvaharness/validation/report/augment.py:216
            }
            List<Map> candidates = results.filter(r -> caseId.isEmpty() || resultFingerprint(r) == null || resultIdentifies(r, caseId)); // exclude foreign fingerprints  // src: vvaharness/validation/report/augment.py:217
            if (strategy.equals("location") && finding.file != null) {
                Map byLoc = matchByLoc(candidates, finding.file, finding.lineStart);                 // src: vvaharness/validation/report/augment.py:220
                if (byLoc != null) return byLoc;                                                     // src: vvaharness/validation/report/augment.py:223
            }
            if (strategy.equals("title")) {
                String title = finding.title != null ? finding.title.strip() : "";                   // src: vvaharness/validation/report/augment.py:224
                if (!title.isEmpty()) return matchByTitle(candidates, title);                        // src: vvaharness/validation/report/augment.py:225
            }
        }
        return null;
    }

    void augmentSarif(Path path, List<ValidatedFinding> pairs, Theta θ) {
        Map document = Json.loads(path.readText());                                                  // src: vvaharness/validation/report/augment.py:230
        List runs = document.getOrDefault("runs", List.of(new Map()));                               // src: vvaharness/validation/report/augment.py:231
        List<Map> results = runs.isEmpty() ? List.of() : runs.get(0).getOrDefault("results", List.of()); // first run only  // src: vvaharness/validation/report/augment.py:232
        int byPrint = 0, matched = 0, aliased = 0;
        for (ValidatedFinding p : pairs) {                                                           // src: vvaharness/validation/report/augment.py:234
            String caseId = p.finding.caseId != null ? p.finding.caseId : p.row.trackingId;          // harness id before model output  // src: vvaharness/validation/report/augment.py:236
            Map match = matchSarif(results, p.finding, caseId, θ);                                   // src: vvaharness/validation/report/augment.py:237
            if (match == null) continue;                                                             // src: vvaharness/validation/report/augment.py:238
            matched += 1;
            if (!caseId.isEmpty() && resultIdentifies(match, caseId)) byPrint += 1;        // src: vvaharness/validation/report/augment.py:241
            SarifValidationBlock block = validationBlock(p.row, p.sessionFailed, θ);                 // src: vvaharness/validation/report/augment.py:243
            if (!recordResultBlock(match, caseId, block, BLOCK_KEY, ALIAS_BLOCK_KEY)) aliased += 1; // src: vvaharness/validation/report/augment.py:244
        }
        Console.write("SARIF augment: matched " + matched + "/" + pairs.size());                     // src: vvaharness/validation/report/augment.py:248
        path.writeText(Json.dumps(document, 2) + "\n");                                              // src: vvaharness/validation/report/augment.py:251
    }

    String trimDanglingEscape(String text) {
        if ((text.length() - text.rstrip("\\").length()) % 2 == 1) return text.substring(0, text.length() - 1); // src: vvaharness/validation/report/augment.py:267
        return text;
    }

    String mdEscape(Object text, int limit) {
        if (text == null) return "";                                                                 // src: vvaharness/validation/report/augment.py:274
        String cleaned = Models.MD_LINEBREAK_RX.sub(" ", str(text));                                 // src: vvaharness/validation/report/augment.py:276
        cleaned = Models.MD_INVISIBLE_RX.sub("", cleaned);                                           // src: vvaharness/validation/report/augment.py:277
        cleaned = cleaned.mapChars(c -> MdEscape.MAP.getOrDefault(c, c));                            // markdown/html metachars  // src: vvaharness/validation/report/augment.py:278
        return trimDanglingEscape(cleaned.prefix(limit));                                            // src: vvaharness/validation/report/augment.py:279
    }

    String mdCell(Object text, Theta θ) {
        return mdEscape(text, θ["code.validation.report.augment.md_cell_max_chars"]);                // src: vvaharness/validation/report/augment.py:288
    }

    List<String> gateRows(Map gates, Theta θ) {
        List<String> rows = new List();
        for (Entry e : gates.entries()) {                                                            // src: vvaharness/validation/report/augment.py:294
            if (e.value instanceof Map) rows.add("| " + mdCell(e.key, θ) + " | " + mdCell(e.value.get("status"), θ) + " | " + mdCell(e.value.get("weight"), θ) + " | " + mdCell(e.value.get("weighted_score"), θ) + " |"); // src: vvaharness/validation/report/augment.py:299
            else rows.add("| " + mdCell(e.key, θ) + " | " + mdCell(e.value, θ) + " | | |");           // src: vvaharness/validation/report/augment.py:302
        }
        return rows;
    }

    String mdValidationSection(ValidationResult r, boolean sessionFailed, Theta θ) {
        List<String> lines = List.of("### Validation", "- Status: " + statusWord(r, sessionFailed),  // src: vvaharness/validation/report/augment.py:308
                                     "- Weighted score: " + r.fixConfidence + " (merge readiness: " + r.prMergeReadiness + ")"); // src: vvaharness/validation/report/augment.py:311
        String summary = (r.justification != null ? r.justification : r.reasonForDecision).strip();  // src: vvaharness/validation/report/augment.py:314
        if (summary.isEmpty() && sessionFailed) summary = "validation session failed; no verdict was reached"; // src: vvaharness/validation/report/augment.py:315
        if (!summary.isEmpty()) lines.add("- Summary: " + mdEscape(summary, θ["code.validation.report.augment.md_summary_max_chars"])); // src: vvaharness/validation/report/augment.py:318
        List<String> rows = gateRows(parseGates(r.gateResultsJson), θ);                              // src: vvaharness/validation/report/augment.py:320
        if (!rows.isEmpty()) lines.addAll(List.of("- Gate scores:", "| gate | status | weight | weighted |")).addAll(rows); // src: vvaharness/validation/report/augment.py:322
        return String.join("\n", lines) + "\n";
    }

    String ftitle(ValidatedFinding p) {
        return (p.finding.title != null ? p.finding.title : p.row.findingTitle).strip().lower();     // src: vvaharness/validation/report/augment.py:329
    }

    ValidatedFinding only(List<ValidatedFinding> pairs) {
        return pairs.size() == 1 ? pairs.get(0) : null;                                              // fail closed on 0 or >1  // src: vvaharness/validation/report/augment.py:334
    }

    ValidatedFinding bestMdMatch(String title, List<ValidatedFinding> pairs, Theta θ) {
        String norm = title.strip().lower();                                                         // src: vvaharness/validation/report/augment.py:339
        if (norm.isEmpty()) return null;                                                             // src: vvaharness/validation/report/augment.py:341
        List<ValidatedFinding> exact = pairs.filter(p -> ftitle(p).equals(norm));                    // src: vvaharness/validation/report/augment.py:342
        if (!exact.isEmpty()) return only(exact);                                                    // src: vvaharness/validation/report/augment.py:344
        if (!θ["code.validation.report.augment.md_title_substring_match"]) return null;
        return only(pairs.filter(p -> !ftitle(p).isEmpty() && (norm.contains(ftitle(p)) || ftitle(p).contains(norm)))); // src: vvaharness/validation/report/augment.py:345
    }

    void augmentMd(Path path, List<ValidatedFinding> pairs, Theta θ) {
        String text = path.readText();                                                              // src: vvaharness/validation/report/augment.py:353
        List<Match> matches = Regex.findAll("^### N. [SEV] title", text);                            // FINDING_RE  // src: vvaharness/validation/report/augment.py:354
        if (matches.isEmpty()) return;                                                               // src: vvaharness/validation/report/augment.py:355
        List<String> rebuilt = List.of(text.substring(0, matches.get(0).start()));                   // src: vvaharness/validation/report/augment.py:358
        for (int i = 0; i < matches.size(); i++) {                                                   // src: vvaharness/validation/report/augment.py:359
            int start = matches.get(i).start();
            int end = i + 1 < matches.size() ? matches.get(i + 1).start() : text.length();           // src: vvaharness/validation/report/augment.py:360
            Match cut = Regex.search("^## ", text, matches.get(i).end(), end);                       // level-2 heading ends the segment  // src: vvaharness/validation/report/augment.py:361
            int segEnd = cut != null ? cut.start() : end;                                            // src: vvaharness/validation/report/augment.py:362
            ValidatedFinding pair = bestMdMatch(matches.get(i).group(1), pairs, θ);                  // src: vvaharness/validation/report/augment.py:363
            rebuilt.add(augmentSegment(text.substring(start, segEnd), pair, θ));                     // src: vvaharness/validation/report/augment.py:364
            rebuilt.add(text.substring(segEnd, end));                                                // src: vvaharness/validation/report/augment.py:365
        }
        path.writeText(String.join("", rebuilt));                                                    // src: vvaharness/validation/report/augment.py:366
    }

    String augmentSegment(String segment, ValidatedFinding pair, Theta θ) {
        if (pair == null) return segment;                                                            // src: vvaharness/validation/report/augment.py:371
        String stripped = Regex.sub("\n+### Validation\n.*END", "", segment);                      // drop prior block  // src: vvaharness/validation/report/augment.py:373
        return stripped.rstrip() + "\n\n" + mdValidationSection(pair.row, pair.sessionFailed, θ) + "\n"; // src: vvaharness/validation/report/augment.py:375
    }
}

@executedBy(CODE) @role(config)
class MdEscape {
    Map<String, String> MAP = Map.of("\\", "\\\\", "`", "\\`", "*", "\\*", "_", "\\_", "[", "\\[", "]", "\\]", "|", "\\|", "#", "\\#", "<", "&lt;", ">", "&gt;", "&", "&amp;"); // src: vvaharness/validation/report/augment.py:258
}
