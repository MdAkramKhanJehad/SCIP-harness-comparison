# vvaharness/models/verdict.py

One validator's conclusion about one remediation, plus a ticket for a verdict that arrives later. `score` is null, not 0.0, when unscored.

Source: `vvaharness/models/verdict.py` (lines 1-60)
Executor: code
Called from: `vvaharness/models/case.py` (Attempt.verdict), `vvaharness/models/derive.py`, the validation stage

// src: vvaharness/models/verdict.py:28-35
Ticket {
  // frozen; unknown keys ignored
  ref: String              // the validator's identifier for the pending review
  opaque: String = ""      // validator-private state to resume with
}

// src: vvaharness/models/verdict.py:38-60
Verdict {
  // frozen; unknown keys ignored
  decision: Decision       // required; an unknown label folds to "inconclusive" (see vocab.sudo)
  rationale: String        // required; the host's account
  engine_rationale: String = ""   // the validator's own prose, verbatim
  score: Number | null = null
  require score == null || 0.0 <= score <= 1.0   // pydantic ge=0.0, le=1.0: construction raises otherwise
  gates: GateAssessment[] = []
  conditions: String[] = []        // what would make this a full fix
  recommendations: String[] = []
  disposition: Disposition | null = null   // accepted risk or false positive, when a reviewer says so
  ticket: Ticket | null = null     // set when the verdict is deferred
  produced_by: Provenance = Provenance()
}
