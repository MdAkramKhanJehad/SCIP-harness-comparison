# vvaharness/validation/ingest/case_loader.py

Discovers finding case files under `<repo>/security-remediation/*/finding_case.json`, keeps only cases this machine's Stage 10 produced (when a provenance set is given), and selects either the explicitly requested ids or the validatable cases capped to the top N by CVSS.

Source: `vvaharness/validation/ingest/case_loader.py` (lines 1-212)
Executor: code
Called from: `vvaharness/validation/cli/_run.sudo` run_validation

// src: vvaharness/validation/ingest/case_loader.py:172-193
fn select_cases(repo, case_ids?, max_findings?, owned?):executor=code {
  all_cases = _all_cases(repo)   // every readable case, any state
  if (owned != null) all_cases = _filter_owned(all_cases, owned)   // applied BEFORE id selection and BEFORE the cap
  if (case_ids != null) {
    selected = _select_by_id(all_cases, case_ids)
  } else {
    selected = _capped(all_cases where _is_validatable, max_findings)
  }
  console: "validate: selected <id> (state=<state>)" for each selected case
  return selected
}

// src: vvaharness/validation/ingest/case_loader.py:56-71
fn discover_cases(repo):executor=code {
  rem_dir = artifact_dir(repo, "security-remediation")   // external: vvaharness/orchestrator/artifacts.py; refuses a symlinked or non-directory remediation folder
  if (rem_dir is not a directory) return []
  return sorted paths matching "*/finding_case.json" where neither the file nor its parent folder is a symlink
}

// src: vvaharness/validation/ingest/case_loader.py:79-101
fn _all_cases(repo):executor=code {
  for each path in discover_cases(repo) {
    try load FindingCase from path
    catch OSError, ValueError, ValidationError => console: "validate: skipping finding '<slug>' — unreadable finding case (...)"   // one bad case cannot abort --all
  }
}

// src: vvaharness/validation/ingest/case_loader.py:149-169
fn _filter_owned(cases, owned):executor=code {
  // owned is a set of (finding_id, resolved case folder) pairs from vvaharness.remediation_agent.provenance.owned_cases
  // "Matching on both stops a planted case that reuses a real id under a different slug directory."
  keep cases where [case_id, resolved parent folder] in owned
  otherwise console: "skipping <folder>: no S10 record for this case in the state store (not written by this machine's remediation)"
}

// src: vvaharness/validation/ingest/case_loader.py:104-116
fn _is_validatable(loaded):executor=code {
  if (loaded.case.state in VALIDATABLE_STATES) return true   // OPEN, REMEDIATED, FAILED
  return loaded.case.state == DECLINED && latest attempt exists && latest attempt.remediation.disposition == NOT_APPLICABLE
  // not FALSE_POSITIVE or POLICY_DENIED declines
}

// src: vvaharness/validation/ingest/case_loader.py:119-146
fn _capped(cases, max_findings?):executor=code {
  if (max_findings == null || max_findings <= 0 || length(cases) <= max_findings) return cases
  console: "validate: capping to top <max_findings> of <total> validatable findings by CVSS (use --all to validate every finding)"
  return cases sorted by (finding.cvss_score or 0.0) descending, stable on ties, first max_findings
}

// src: vvaharness/validation/ingest/case_loader.py:196-212
fn _select_by_id(all_cases, case_ids):executor=code {
  by_id = cases keyed by case_id
  missing = case_ids not in by_id
  require missing is empty => throw IngestError("requested finding ids not found: ...")
  not_validatable = case_ids where !_is_validatable
  require not_validatable is empty => throw IngestError("validation cannot run — these findings are not in a validatable state (need ...): ...")
  return cases in the requested order
  // explicit ids bypass the max_findings cap
}

// src: vvaharness/validation/ingest/case_loader.py:91-96
fn all_case_ids(repo):executor=code {
  try return case_id of every discovered case
  catch OSError, ValueError, ValidationError => return null   // "if the set can't be fully enumerated"
}
