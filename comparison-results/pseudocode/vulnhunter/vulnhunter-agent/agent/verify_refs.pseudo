// file: vulnhunter-agent/agent/verify_refs.py
// Verify mode pre-flight: the scan model extracts unambiguous cross-repo references from developer
// comments as strict JSON; code coerces the result. Best effort: any failure returns [] (skill R2 catches the rest).

@executedBy(CODE) @role(step) @stage("verify")
class VerifyRefs {

    List<Map> extractCrossRepoReferences(String commentsText, Theta θ, TokenManager tm, CostStats cost) {
        if (commentsText.strip().isEmpty()) return List.of();                              // src: vulnhunter-agent/agent/verify_refs.py:130
        String system = VerifyRefsPrompt.system(θ).text();
        String user = VerifyRefsPrompt.user(commentsText, θ).text();
        Object parsed;
        try {
            // scan-session model only; no haiku->sonnet tiers and no escalation
            parsed = Llm.callJson(config.anthropic.model, system, user, θ, tm, cost, "verify-refs"); // src: vulnhunter-agent/agent/verify_refs.py:145
        } catch (LLMError exc) {
            log.warning("Pre-flight cross-repo extraction failed; falling back to skill-side R2 detection"); // src: vulnhunter-agent/agent/verify_refs.py:155
            return List.of();                                                              // src: vulnhunter-agent/agent/verify_refs.py:160
        }
        return coerceSources(parsed, θ);                                                   // src: vulnhunter-agent/agent/verify_refs.py:161
    }

    List<Map> coerceSources(Object parsed, Theta θ) {
        if (!(parsed instanceof Map)) return List.of();                                    // src: vulnhunter-agent/agent/verify_refs.py:173
        Object raw = parsed.get("requested_sources");
        if (!(raw instanceof List)) return List.of();                                      // src: vulnhunter-agent/agent/verify_refs.py:176
        List<Map> out = new List();
        for (Object entry : raw) {
            if (!(entry instanceof Map)) continue;                                         // src: vulnhunter-agent/agent/verify_refs.py:180
            String hint = str(entry.get("repo_hint")).strip();
            if (hint.isEmpty()) continue;                                                  // src: vulnhunter-agent/agent/verify_refs.py:183
            String excerpt = str(entry.get("claim_excerpt")).take(θ["p.verify_refs.claim_excerpt_max_chars"]); // src: vulnhunter-agent/agent/verify_refs.py:185
            String reason = str(entry.get("reason")).strip();
            if (reason.isEmpty()) reason = "Pre-flight extractor flagged a cross-repo reference; verifier cannot evaluate the claim without local access."; // src: vulnhunter-agent/agent/verify_refs.py:188
            out.add(Map.of("claim_excerpt", excerpt, "repo_hint", hint, "reason", reason)); // src: vulnhunter-agent/agent/verify_refs.py:192
        }
        // no dedup here: downstream dedups by repo_hint
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("verify")
class VerifyRefsPrompt {

    // _EXTRACTOR_SYSTEM
    Prompt system(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.verify_refs.extractor_role_json_only"]);                            // src: vulnhunter-agent/agent/verify_refs.py:53
        if (θ["p.verify_refs.context_external_source_must_be_cloned"]) p.context("A verifier checks a security fix; code referenced OUTSIDE the target repo must be cloned first"); // src: vulnhunter-agent/agent/verify_refs.py:60
        if (θ["p.verify_refs.unambiguous_only"]) p.rule("Identify every UNAMBIGUOUS cross-repository reference"); // src: vulnhunter-agent/agent/verify_refs.py:62
        p.tiebreak(θ["p.verify_refs.conservative_stance"]);                                // src: vulnhunter-agent/agent/verify_refs.py:63
        p.checklist(θ["p.verify_refs.flag_git_urls"]);                                     // src: vulnhunter-agent/agent/verify_refs.py:68
        p.checklist(θ["p.verify_refs.flag_relative_outside_paths"]);                       // src: vulnhunter-agent/agent/verify_refs.py:73
        p.threshold(θ["p.verify_refs.flag_named_reference_min_chars"]);                    // src: vulnhunter-agent/agent/verify_refs.py:76
        if (θ["p.verify_refs.skip_local_paths"]) p.forbid("Plain file paths inside the current repo (anything without ../ is local)"); // src: vulnhunter-agent/agent/verify_refs.py:84
        if (θ["p.verify_refs.skip_package_names"]) p.forbid("Package or library names - dependencies, not source repos"); // src: vulnhunter-agent/agent/verify_refs.py:85
        if (θ["p.verify_refs.skip_generic_mentions"]) p.forbid("Generic mentions without a specific identifier"); // src: vulnhunter-agent/agent/verify_refs.py:87
        if (θ["p.verify_refs.skip_structural_markers"]) p.forbid("The comments file own HTML-comment structural markers"); // src: vulnhunter-agent/agent/verify_refs.py:89
        if (θ["p.verify_refs.always_emit_requested_sources"]) p.format("always emit requested_sources even when empty"); // src: vulnhunter-agent/agent/verify_refs.py:91
        p.format("claim_excerpt verbatim, max chars:");
        p.threshold(θ["p.verify_refs.claim_excerpt_max_chars"]);                           // src: vulnhunter-agent/agent/verify_refs.py:96
        if (θ["p.verify_refs.repo_hint_verbatim"]) p.format("repo_hint: URL or identifier copied verbatim"); // src: vulnhunter-agent/agent/verify_refs.py:97
        p.format(θ["p.verify_refs.reason_one_sentence"]);                                  // src: vulnhunter-agent/agent/verify_refs.py:98
        if (θ["p.verify_refs.empty_result_shape"]) p.format("Return requested_sources: [] when nothing qualifies"); // src: vulnhunter-agent/agent/verify_refs.py:103
        if (!θ["p.verify_refs.no_dedup_in_extractor"]) p.forbid("Do not deduplicate - each distinct mention is one entry"); // src: vulnhunter-agent/agent/verify_refs.py:104
        return p;
    }

    Prompt user(String commentsText, Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.verify_refs.user_msg_instruction"]) p.rule("Extract every UNAMBIGUOUS cross-repository reference from the developer comments below. Return strict JSON"); // src: vulnhunter-agent/agent/verify_refs.py:133
        String[] delim = θ["p.verify_refs.comments_delimiters"].split(" / ");              // src: vulnhunter-agent/agent/verify_refs.py:136
        p.context(delim[0] + commentsText + delim[1]);                                     // src: vulnhunter-agent/agent/verify_refs.py:137
        return p;
    }
}
