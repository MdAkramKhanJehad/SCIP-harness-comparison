# vvaharness/validation/subagents/_frontmatter.py

Strict parser for the YAML frontmatter of the subagent `.md` files (no YAML library). Unknown keys, inline list values and orphan list items are rejected.

Source: `vvaharness/validation/subagents/_frontmatter.py` (lines 1-84)
Executor: code
Called from: `vvaharness/validation/subagents/_loader.sudo` load_agents

// src: vvaharness/validation/subagents/_frontmatter.py:24-26
_FRONTMATTER_RE = /^---\s*\n(.*?)\n---\s*\n(.*)\Z/s
_SCALAR_KEYS = ["name", "model", "description"]
_LIST_KEYS = ["allowedTools", "deniedTools", "skills"]

// src: vvaharness/validation/subagents/_frontmatter.py:74-84
fn parse_frontmatter(text):executor=code {
  require text matches _FRONTMATTER_RE => throw ValueError("subagent file missing YAML frontmatter")
  current_list_key = null
  for each line in head {
    // src: _frontmatter.py:29-71
    match (line) {
      case blank => current_list_key = null
      case starts with "  - " or "\t- " => {
        require current_list_key != null => throw ValueError("list item without parent key: ...")
        append trimmed item to meta[current_list_key]
      }
      default => {
        require line contains ":" => throw ValueError("malformed frontmatter line: ...")
        if (key in _SCALAR_KEYS) { meta[key] = value; current_list_key = null }
        else if (key in _LIST_KEYS) {
          require value is empty => throw ValueError("<key> must be a block list, got inline value")
          meta[key] = []; current_list_key = key
        }
        else throw ValueError("unknown frontmatter key: <key>")
      }
    }
  }
  return ParsedFrontmatter(meta, trimmed body)
}
