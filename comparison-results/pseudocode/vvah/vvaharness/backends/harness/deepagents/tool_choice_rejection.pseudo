// file: vvaharness/backends/harness/deepagents/tool_choice_rejection.py
// Anthropic models that reject a forced tool_choice with a 400: classified from the error, learned process-wide,
// and seeded with known rejecters so S10/S11 skip the first failed call (callers then retry without forcing).

@executedBy(CODE) @role(backend)
class ToolChoiceRejection {
    static Set<String> UNSUPPORTED_MODELS;
    static Set<String> WARNED = new Set();

    // Learned set starts from the known rejecters.
    Set<String> knownUnsupported(Theta θ) {
        return θ["code.backends.harness.deepagents.tool_choice_rejection.known_unsupported"];            // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:35
    }

    void seed(Theta θ) {
        UNSUPPORTED_MODELS = new Set(knownUnsupported(θ));                                               // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:38
    }

    boolean isToolChoiceUnsupportedRejection(Exception exc, Theta θ) {
        List<String> markers = θ["code.backends.harness.deepagents.tool_choice_rejection.markers"];      // ("tool_choice", "not supported for this model") // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:32
        for (Exception link : Exceptions.exceptionChain(exc)) {                                                     // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:45
            String body = link.message.toLowerCase();                                                    // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:47
            if (link.statusCode == 400 && markers.allMatch(m -> body.contains(m))) return true;          // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:48
        }
        String stderr = exc.stderr == null ? "" : exc.stderr.toLowerCase();                             // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:50
        return stderr.contains("400") && markers.allMatch(m -> stderr.contains(m));                      // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:51
    }

    // The model named in the rejected request's JSON body, when the SDK error still carries it.
    String rejectedModel(Exception exc) {
        for (Exception link : Exceptions.exceptionChain(exc)) {                                                     // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:57
            Object body = link.request == null ? null : link.request.content;                            // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:58
            if (body == null || body.isEmpty()) continue;                                                // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:59
            String model;
            try {
                model = parseJson(body).get("model");                                                    // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:62
            } catch (ValueError e) {
                continue;                                                                                // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:64
            }
            if (model != null && !model.isEmpty()) return model;                                         // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:66
        }
        return null;                                                                                     // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:67
    }

    void learnToolChoiceUnsupported(List<String> modelIds) {
        for (String modelId : modelIds) {                                                                // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:72
            UNSUPPORTED_MODELS.add(modelId);                                                             // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:73
            COUNTERS.bump("deepagents_tool_choice_unsupported_fallback");                                // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:74
            WarnOnce.warnOnce(WARNED, modelId, "WARN [deepagents]: model rejected a forced tool_choice outright -- retrying without forcing"); // src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:75
        }
    }
}
