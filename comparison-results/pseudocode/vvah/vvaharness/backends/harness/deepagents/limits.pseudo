// file: vvaharness/backends/harness/deepagents/limits.py
// Loop-budget constants for the DeepAgents backend. max_turns is a FLOOR on the LangGraph recursion limit
// (max_turns + headroom supersteps, ~2*turns+3 nodes per turn), not a turn cap; sdk/cli enforce it as a hard cap.

@executedBy(CODE) @role(config)
class DeepagentsLimits {

    // recursion_limit = (max_turns or 50) + RECURSION_HEADROOM; applied in options/streaming.py:141
    int recursionLimit(int maxTurns, Theta θ) {
        int headroom = θ["code.deepagents.recursion_headroom"];        // 900                            // src: vvaharness/backends/harness/deepagents/limits.py:30
        return (maxTurns > 0 ? maxTurns : 50) + headroom;              // S4: step4.max_turns 15 -> 915    // src: vvaharness/backends/harness/deepagents/options/streaming.py:141
    }

    // Per-request hang-stop timeout for every model call (scaled by effort in build_model).
    double modelTimeoutSeconds(Theta θ) {
        return θ["code.deepagents.model_timeout_seconds"];             // 1800.0                         // src: vvaharness/backends/harness/deepagents/limits.py:33
    }

    // Output-token ceiling set on the chat model (langchain's 128000 default 400s on lower-cap models).
    int modelMaxOutputTokens(Theta θ) {
        return θ["code.deepagents.model_max_output_tokens"];           // 64000                          // src: vvaharness/backends/harness/deepagents/limits.py:36
    }

    // Client-level 429/5xx retries per model call (x3 transient attempts upstream).
    int modelMaxRetries(Theta θ) {
        return θ["code.deepagents.model_max_retries"];                 // 2                              // src: vvaharness/backends/harness/deepagents/limits.py:39
    }
}
