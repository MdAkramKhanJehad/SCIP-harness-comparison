class SafePhraseSyncLint {

    int run() {
        return main();
    }

    List<String> extractConstant(Path path, String name) {
        return Ast.parse(Files.read(path)).findAssign(name).stringElementsOrNull();                        // src: vulnhunter-fix/scripts/safe-phrase-sync-lint.py:25
    }

    int main() {
        List<String> a = extractConstant(skillRoot().join("vulnhunter_fix", "delivery.py"), "SAFE_PHRASE_PATTERNS"); // src: vulnhunter-fix/scripts/safe-phrase-sync-lint.py:40
        List<String> b = extractConstant(skillRoot().join("scripts", "check-severity-mask.py"), "SAFE_PHRASE_PATTERNS"); // src: vulnhunter-fix/scripts/safe-phrase-sync-lint.py:41
        if (a == null) return 2;                                                                           // src: vulnhunter-fix/scripts/safe-phrase-sync-lint.py:44
        if (b == null) return 2;                                                                           // src: vulnhunter-fix/scripts/safe-phrase-sync-lint.py:47
        if (!a.equals(b)) return 1;                                                                        // src: vulnhunter-fix/scripts/safe-phrase-sync-lint.py:48
        return 0;
