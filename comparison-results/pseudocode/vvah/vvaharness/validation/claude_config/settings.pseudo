// file: vvaharness/validation/claude_config/settings.json
// Claude Code project settings injected into the S11 workspace (.claude/settings.json):
// session model, read-only tool permissions, and the Stop hook that captures the transcript.

@executedBy(CODE) @role(config) @stage("S11")
class ClaudeConfigSettings {

    String model(Theta θ) {
        return θ["code.validation.claude_config.settings.model"];                                   // src: vvaharness/validation/claude_config/settings.json:2
    }

    ValidationSettingsPermissions permissions(Theta θ) {
        List<String> allow = θ["code.validation.claude_config.settings.permissions_allow"];          // Read, Grep, Glob  // src: vvaharness/validation/claude_config/settings.json:5
        List<String> deny = θ["code.validation.claude_config.settings.permissions_deny"];            // Write, Edit, NotebookEdit, Bash  // src: vvaharness/validation/claude_config/settings.json:8
        return new ValidationSettingsPermissions(allow, deny);
    }

    List<Hook> hooks(Theta θ) {
        Hook stop = new Hook("Stop", "bash .claude/hooks/logging/capture_transcript.sh", θ["code.validation.claude_config.settings.stop_hook_timeout_s"]); // runs CaptureTranscript.run  // src: vvaharness/validation/claude_config/settings.json:14
        return List.of(stop);
    }
}

@executedBy(CODE) @role(types)
record ValidationSettingsPermissions(List<String> allow, List<String> deny) { }

@executedBy(CODE) @role(types)
record Hook(String event, String command, int timeoutS) { }
