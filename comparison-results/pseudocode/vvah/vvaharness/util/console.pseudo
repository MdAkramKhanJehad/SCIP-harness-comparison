// file: vvaharness/util/console.py
// The product's human-facing output: status tables, glyph lines and the banner; diagnostics go to util.logs.
// Every printed value is redacted and stripped of terminal control characters first.

@executedBy(CODE) @role(io)
class Console {

    static final Map<String, String> ICON = Map.of("ok", "✓", "warn", "⚠", "fail", "✗", "skip", "–"); // src: vvaharness/util/console.py:32
    static final Map<String, String> STATUS_STYLE = Map.of("ok", "ok", "warn", "warn", "fail", "fail", "skip", "muted"); // src: vvaharness/util/console.py:34
    static final String NO_BANNER_ENV = "VVAHARNESS_NO_BANNER";              // src: vvaharness/util/console.py:49
    static final int PIPED_WIDTH = 200;                                        // width when not a tty, so piped tables are not folded // src: vvaharness/util/console.py:63
    static final Regex CONTROL_RX = Regex.of(θ["code.util.console.control_rx"]); // ESC, DEL, C1 that rich does not strip // src: vvaharness/util/console.py:66

    String safe(Object text) {
        return CONTROL_RX.sub(" ", Redact.redact(str(text)));                  // redact, then blank control chars // src: vvaharness/util/console.py:71
    }

    RichConsole console(boolean err) {
        Stream stream = err ? stderr : stdout;                                 // resolved per call // src: vvaharness/util/console.py:76
        boolean tty = stream.isatty();
        return new RichConsole(stream, THEME, env("NO_COLOR") != null, tty ? null : PIPED_WIDTH); // src: vvaharness/util/console.py:78
    }

    boolean encodable(Stream stream, List<String> lines) {
        String enc = stream.encoding != null ? stream.encoding : "utf-8";       // src: vvaharness/util/console.py:91
        try { for (String l : lines) l.encode(enc); }
        catch (LookupError | UnicodeEncodeError e) { return false; }            // src: vvaharness/util/console.py:95
        return true;
    }

    boolean banner(boolean err, boolean force) {
        Stream stream = err ? stderr : stdout;
        if (!force && (env(NO_BANNER_ENV) != null || !stream.isatty())) return false; // suppressed; caller prints own header // src: vvaharness/util/console.py:108
        RichConsole out = console(err);
        if (!encodable(stream, WORDMARK)) out.print("VVAH");                   // plain fallback // src: vvaharness/util/console.py:113
        else for (int row = 0; row < WORDMARK.size(); row++) out.print(WORDMARK[row], row < 3 ? "wordmark" : "wordmark.shadow"); // src: vvaharness/util/console.py:116
        out.print("v" + VERSION + "  ·  agentic SAST");                        // src: vvaharness/util/console.py:120
        return true;
    }

    void write(String text) {
        console(true).print(safe(text));                                       // replacement for bare stderr print // src: vvaharness/util/console.py:132
    }

    String counts(String stage, String label, Map<String, Object> fields) {
        Map<String, String> redacted = fields.mapValues(v -> safe(v));         // src: vvaharness/util/console.py:139
        console(true).print("  [" + safe(stage) + "] " + safe(label) + "  " + redacted.join(" · ")); // src: vvaharness/util/console.py:148
        return redacted.entries().map(e -> e.key + "=" + e.value).join(" ");   // compact form for telemetry // src: vvaharness/util/console.py:149
    }

    Table statusTable(String title, List<String> columns) {
        Table table = new Table(title, borderless);                            // src: vvaharness/util/console.py:156
        for (String name : columns) table.addColumn(name, "fold");             // src: vvaharness/util/console.py:165
        return table;
    }

    void statusRow(Table table, String outcome, List<Object> cells) {
        String glyph = ICON.getOrDefault(outcome, "?");                        // src: vvaharness/util/console.py:174
        table.addRow(glyph, cells.map(c -> safe(c)));                          // src: vvaharness/util/console.py:175
    }

    void mark(String outcome, String text, int indent, String lead, boolean err) {
        console(err).print(lead + " ".repeat(indent) + ICON.getOrDefault(outcome, "?") + " " + safe(text)); // indent default 2 // src: vvaharness/util/console.py:182
    }
}
