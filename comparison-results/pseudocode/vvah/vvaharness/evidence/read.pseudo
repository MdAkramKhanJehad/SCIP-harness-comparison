// file: vvaharness/evidence/read.py
// The containment-checked, length-capped chokepoint every S2 evidence read from disk goes through.

@executedBy(CODE) @role(io) @stage("S2")
class Read {

    /** Resolve p; return it if inside root, else null (also covers dangling symlinks). */
    Path contained(Path root, Path p) {
        Path rp;
        try { rp = p.resolve(true); } catch (OSError e) { return null; }                          // src: vvaharness/evidence/read.py:26
        Path rroot;
        try { rroot = root.resolve(true); } catch (OSError e) { return null; }                    // src: vvaharness/evidence/read.py:30
        return rp.isRelativeTo(rroot) ? rp : null;                                                // src: vvaharness/evidence/read.py:33
    }

    /** Truncate to capChars and append a truncation marker naming the full length. */
    String capText(String txt, int capChars) {
        if (txt.length() > capChars) return txt.substring(0, capChars) + "\n...(truncated, N chars total)"; // src: vvaharness/evidence/read.py:37
        return txt;                                                                               // src: vvaharness/evidence/read.py:39
    }

    /** Containment-check, read, cap. wholeOrNothing: return empty instead of a truncated prefix. */
    String readCapped(Path root, Path p, int capChars, boolean wholeOrNothing, Theta θ) {
        if (θ["code.evidence.read.contain_reads"]) {
            Path rp = contained(root, p);                                                         // src: vvaharness/evidence/read.py:45
            if (rp == null) {                                                                     // src: vvaharness/evidence/read.py:46
                ErrLog.log("s2", "containment", "refused to read outside repo root", "containment_refused", true); // src: vvaharness/evidence/read.py:48
                return "";                                                                        // src: vvaharness/evidence/read.py:51
            }
            p = rp;
        }
        String txt;
        try { txt = p.readText("utf-8", "replace"); } catch (Exception e) { txt = ""; }          // src: vvaharness/evidence/read.py:53
        if (wholeOrNothing && txt.length() > capChars) return "";                                 // src: vvaharness/evidence/read.py:56
        return capText(txt, capChars);                                                            // src: vvaharness/evidence/read.py:58
    }
}
