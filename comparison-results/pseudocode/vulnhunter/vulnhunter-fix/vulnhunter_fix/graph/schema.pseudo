// file: vulnhunter-fix/vulnhunter_fix/graph/schema.py
// Public graph schema (graph.json) decoupled from graphify: Node, Edge, GraphDocument with to_dict / from_dict.

@executedBy(CODE) @role(types)
enum NodeKind { FUNCTION, CLASS, MODULE, FILE }

@executedBy(CODE) @role(types)
enum EdgeKind { CALLS, IMPORTS, DEPENDS_ON, DEFINES }

@executedBy(CODE) @role(types)
enum Backend { AST, GREP, NONE }

@executedBy(CODE) @role(types)
enum Confidence { HIGH, LOW }

@executedBy(CODE) @role(types)
record Node(String id, String kind, String name, String file, int line, String qualifiedName, String language) { }

@executedBy(CODE) @role(types)
record Edge(String src, String dst, String kind) { }

@executedBy(CODE) @role(types)
record GraphDocument(String schemaVersion, String graphifyVersion, String generatedAt, String backend, String confidence,
                     String contentHash, String rootDir, Map<String, Node> nodes, List<Edge> edges) { }

@executedBy(CODE) @role(types) @stage("fix")
class Schema {

    String schemaVersion() {
        return "1";                                                                  // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:41
    }

    Map toDict(GraphDocument d) {
        // nodes keyed by id (id itself not repeated); edges serialized as from / to / kind
        return Map.of("schema_version", d.schemaVersion, "graphify_version", d.graphifyVersion, "generated_at", d.generatedAt,
                      "backend", d.backend, "confidence", d.confidence, "content_hash", d.contentHash, "root_dir", d.rootDir,
                      "nodes", d.nodes, "edges", d.edges.map(e -> Map.of("from", e.src, "to", e.dst, "kind", e.kind))); // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:79
    }

    GraphDocument fromDict(Map data, Theta θ) {
        Map<String, Node> nodes = new Map();
        for (String nid : data.nodes.keys()) {                                       // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:104
            Map nd = data.nodes.get(nid);
            nodes.put(nid, new Node(nid, nd.kind, nd.name, nd.file, nd.getOrDefault("line", 0),
                                    nd.getOrDefault("qualified_name", nd.file + ":" + nd.name), nd.getOrDefault("language", ""))); // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:105
        }
        List<Edge> edges = data.edges.map(e -> new Edge(e.from ?: e.src, e.to ?: e.dst, e.kind)); // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:117
        // a graph.json with no backend / confidence field is read as an AST / high-confidence graph
        String backend = data.getOrDefault("backend", "ast");                        // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:124
        String confidence = data.getOrDefault("confidence", θ["code.vulnhunter_fix.graph.schema.missing_confidence_default"]); // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:125
        return new GraphDocument(data.getOrDefault("schema_version", schemaVersion()), data.get("graphify_version"),
                                 data.getOrDefault("generated_at", ""), backend, confidence,
                                 data.getOrDefault("content_hash", ""), data.getOrDefault("root_dir", ""), nodes, edges); // src: vulnhunter-fix/vulnhunter_fix/graph/schema.py:120
    }
}
