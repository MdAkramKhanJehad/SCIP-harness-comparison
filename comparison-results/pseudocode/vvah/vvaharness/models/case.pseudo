// FindingCase: the per-finding record S10 and S11 both write; `state` is derived from the attempts, never stored.

@executedBy(CODE) @role(types)
record Attempt(int ordinal, Remediation remediation, Verdict verdict, List<String> revertedPaths) {
    // frozen; extra keys ignored (rejecting would drop a persisted case)                           // src: vvaharness/models/case.py:40
    // ordinal: 1-based; verdict: null until validated; revertedPaths default () = paths rolled back after a policy breach // src: vvaharness/models/case.py:42
}

@executedBy(CODE) @role(types)
record FindingCase(String schemaVersion, String caseId, Finding finding, List<Attempt> attempts, List<String> supersededIds) {
    // schemaVersion default SCHEMA_VERSION = "2.0"                                                 // src: vvaharness/models/case.py:56

    CaseState state() {
        return Derive.stateOf(attempts);  // computed field, last attempt rules                    // src: vvaharness/models/case.py:68
    }

    Map dropDerived(Object data) {
        // before-validator: discard `state` on input so no caller can assert an unsupported state
        if (data is Map) return data.without("state");                                             // src: vvaharness/models/case.py:74
        return data;
    }

    FindingCase withAttempt(Remediation remediation, List<String> revertedPaths) {
        Attempt a = new Attempt(attempts.size() + 1, remediation, null, revertedPaths);             // src: vvaharness/models/case.py:85
        return copy(attempts.append(a));                                                            // src: vvaharness/models/case.py:90
    }

    FindingCase withVerdict(Verdict verdict) {
        if (attempts.isEmpty()) throw new ValueError("case has no attempt to attach a verdict to"); // src: vvaharness/models/case.py:94
        Attempt judged = attempts.last().copyWith(verdict);                                         // src: vvaharness/models/case.py:97
        return copy(attempts.replaceLast(judged));                                                  // src: vvaharness/models/case.py:98
    }

    FindingCase read(Path path) {
        return validate(Case.readJson(path));                                                       // src: vvaharness/models/case.py:103
    }

    void write(Path path) {
        // atomic: write <path>.tmp then rename, so a concurrent reader never sees a partial file
        String payload = Json.dumps(dump(), 2) + "\n";                                              // src: vvaharness/models/case.py:107
        Path tmp = path.withSuffix(path.suffix + ".tmp");                                           // src: vvaharness/models/case.py:108
        tmp.writeText(payload);                                                                     // src: vvaharness/models/case.py:109
        tmp.replace(path);                                                                          // src: vvaharness/models/case.py:110
    }
}

@executedBy(CODE) @role(io)
class Case {

    Object readJson(Path path) {
        try {
            return Json.loads(path.readText());                                                     // src: vvaharness/models/case.py:116
        } catch (JSONDecodeError e) {
            throw new ValueError("malformed JSON in finding case " + path);                         // src: vvaharness/models/case.py:118
        }
    }
}
