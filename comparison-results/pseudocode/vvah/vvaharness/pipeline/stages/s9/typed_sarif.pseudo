// file: vvaharness/pipeline/stages/s9/typed_sarif.py
// SARIF 2.1.0 emitter built entirely from the typed FinalReport: one result per surviving finding, the duplicate-result guard,
// rules/taxa tables, run properties and scan-health notifications; plus the join helpers other artifacts use to find a result.

@executedBy(CODE) @role(io) @stage("S9")
class TypedSarif {

    // Cross-artifact join: SARIF partialFingerprints <-> findings.json case_id <-> finding_case.json
    String FINGERPRINT_KEY = "vvaFindingId/v1";                                                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:32
    // ids the dup guard folded in: each twin is its own case, so the survivor publishes them to join
    String ALIAS_KEY = "aliasFindingIds";                                                       // src: vvaharness/pipeline/stages/s9/typed_sarif.py:35
    // uuid5(NAMESPACE_URL, "https://cwe.mitre.org/"); a literal for cross-run joins, must stay RFC-4122
    String CWE_TAXONOMY_GUID = "ec480a2c-8267-5d90-affc-401687cd64b0";                          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:78
    String DEDUP_RELATED_MSG = "Additional call site - collapsed during dedup; same root cause as the primary location and needs the same fix."; // src: vvaharness/pipeline/stages/s9/typed_sarif.py:80
    Map<String, String> REF_RELATED_MSG = Map.of("source", "Source - where untrusted input enters.", "sink", "Sink - where the tainted value is used unsafely."); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:83

    /** Whether result is the SARIF row for caseId: its own fingerprint or a folded alias. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:46")
    boolean resultIdentifies(Map result, String caseId) {
        if (caseId.isEmpty()) return false;                                                     // src: vvaharness/pipeline/stages/s9/typed_sarif.py:48
        Map prints = firstTruthy(result.get("partialFingerprints"), Map.of());                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:50
        if (str(prints.getOrDefault(FINGERPRINT_KEY, "")).equals(caseId)) return true;          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:51
        List aliases = firstTruthy(firstTruthy(result.get("properties"), Map.of()).get(ALIAS_KEY), List.of()); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:53
        return aliases.contains(caseId);                                                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:54
    }

    /** The result's OWN join key (partialFingerprints vvaFindingId/v1), or empty. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:57")
    String resultFingerprint(Map result) {
        return str(firstTruthy(result.get("partialFingerprints"), Map.of()).getOrDefault(FINGERPRINT_KEY, "")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:59
    }

    /** Attach block under properties[key]; true when it took the primary key. A SARIF result is additionalProperties false, so a block outside properties fails validation. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:62")
    boolean recordResultBlock(Map result, String caseId, Object block, String key, String aliasKey) {
        Map props = result.setdefault("properties", new Map());                                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:66
        String own = resultFingerprint(result);                                                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:67
        // a fingerprint-less row keeps the primary key, so loc/title fallback matching still resolves
        if (!(!own.isEmpty() && !caseId.isEmpty() && !own.equals(caseId))) {                    // src: vvaharness/pipeline/stages/s9/typed_sarif.py:69
            props.put(key, block);                                                              // src: vvaharness/pipeline/stages/s9/typed_sarif.py:70
            return true;
        }
        Object aliases = props.get(aliasKey);                                                   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:72
        if (!(aliases is Map)) { aliases = new Map(); props.put(aliasKey, aliases); }           // src: vvaharness/pipeline/stages/s9/typed_sarif.py:73
        aliases.put(caseId, block);                                                             // src: vvaharness/pipeline/stages/s9/typed_sarif.py:76
        return false;
    }

    /** error for CRITICAL and HIGH, warning for MEDIUM, note otherwise. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:92")
    String sarifLevel(String sev, Theta θ) {
        return θ["code.s9.typed_sarif.level_map"].getOrDefault(sev, "note");                    // src: vvaharness/pipeline/stages/s9/typed_sarif.py:93
    }

    /** The CVSS score to one decimal when known (>= 0), else a fixed band value per severity (0.0 for an unknown severity). */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:97")
    String securitySeverity(String sev, double cvssScore, Theta θ) {
        if (cvssScore >= 0) return format("%.1f", cvssScore);                                   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:98
        return θ["code.s9.typed_sarif.security_severity_fallback"].getOrDefault(sev, "0.0");    // src: vvaharness/pipeline/stages/s9/typed_sarif.py:100
    }

    /** (effective CWE, class label) exactly as the MD renderer derives them. TRAP: widening CWE_NAMES reshapes ruleIds and reopens alerts; norm_cwe saves the taxonomy sort. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:104")
    Pair<String, String> classLabel(Finding f, Theta θ) {
        String eff = firstTruthy(RulesCwe.normCwe(f.cwe, θ), Cwe.cweFor(null, f.vulnClass, θ)); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:107
        String nm = eff != null ? Cwe.cweName(eff) : "";                                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:108
        String label = eff != null ? (!nm.isEmpty() ? eff + ": " + nm : eff) : "";              // src: vvaharness/pipeline/stages/s9/typed_sarif.py:109
        if (label.isEmpty()) label = f.vulnClass.value;                                         // src: vvaharness/pipeline/stages/s9/typed_sarif.py:109
        return Pair.of(eff, label);                                                             // src: vvaharness/pipeline/stages/s9/typed_sarif.py:110
    }

    /** The message.text: the cell-folded title plus, when a vector exists, the CVSS score (when known) and the vector. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:113")
    String resultMessage(Finding f, double score) {
        String scoreTxt = score >= 0 ? " " + format("%.1f", score) : "";                        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:115
        return ScanRender.mdCell(f.title) + (!f.cvssVector.isEmpty() ? "  [CVSS" + scoreTxt + ": " + f.cvssVector + "]" : ""); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:116
    }

    /** The duplicate-emit guard's key: what makes two results identical to a reader. Channel and origin are legs: without them a CRITICAL folds into its posture or detector twin. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:120")
    Tuple dupResultKey(Finding f, String eff, String msg) {
        return Tuple.of(firstTruthy(f.file, "unknown"), f.lineStart, firstTruthy(eff, f.vulnClass.value), msg, firstTruthy(f.channel, "main"), firstTruthy(f.origin, "")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:125
    }

    /** Sort key picking the twin a reader sees: strongest severity wins (SEV_RANK, unknown 9). Severity ranks, not first-wins: a LOW twin would ship level note and 0.1 and pass an error gate. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:128")
    Tuple survivorRank(RankedFinding rf) {
        return Tuple.of(Vocab.SEV_RANK.getOrDefault(rf.severity, 9));                           // src: vvaharness/pipeline/stages/s9/typed_sarif.py:131
    }

    /** The SARIF description: the finding's narrative lines, redacted and capped. Redacts before the cut, or cutting bisects a secret and ships its raw prefix. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:134")
    String sectionDescription(int i, RankedFinding rf, Theta θ) {
        String desc = Redact.redactCounts(FindingSection.findingDescriptionLines(i, rf).join("\n").strip(), true, θ).first; // src: vvaharness/pipeline/stages/s9/typed_sarif.py:137
        return desc.length() > θ["code.s9.typed_sarif.description_max_chars"] ? desc.substring(0, θ["code.s9.typed_sarif.description_max_chars"]) + "..." : desc; // src: vvaharness/pipeline/stages/s9/typed_sarif.py:139
    }

    /** A role-annotated relatedLocation from a file:line ref string; a ref without a numeric trailing line is used whole as the uri with no region. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:142")
    Map refRelatedLocation(String role, String ref) {
        String uri = ref.rpartition(":").first; String line = ref.rpartition(":").last;        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:144
        Map region = new Map();
        if (!uri.isEmpty() && line.isDigit()) region = Map.of("startLine", int(line));          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:146
        else uri = ref;                                                                         // src: vvaharness/pipeline/stages/s9/typed_sarif.py:148
        Map physical = Map.of("artifactLocation", Map.of("uri", uri));                          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:149
        if (!region.isEmpty()) physical.put("region", region);                                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:150
        return Map.of("physicalLocation", physical, "message", Map.of("text", REF_RELATED_MSG.get(role)), "properties", Map.of("role", role)); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:152
    }

    /** The source-to-sink taint path as a SARIF codeFlow (one thread, essential importance per step), or null when neither ref exists. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:160")
    Map taintCodeFlow(String sourceRef, String sinkRef) {
        List<Map> steps = new List();
        for (Pair<String, String> rr : List.of(Pair.of("source", sourceRef), Pair.of("sink", sinkRef))) if (!rr.second.isEmpty()) steps.add(refRelatedLocation(rr.first, rr.second)); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:162
        if (steps.isEmpty()) return null;                                                       // src: vvaharness/pipeline/stages/s9/typed_sarif.py:164
        return Map.of("threadFlows", List.of(Map.of("locations", steps.map(s -> Map.of("location", s, "importance", "essential"))))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:166
    }

