# vvaharness/injectors/design_controls.py

Loads the operator's design-controls file (YAML: authentication boundaries, sandboxes, mitigations) injected as context into the scan. Any parse or validation failure degrades the whole file to no controls.

Source: `vvaharness/injectors/design_controls.py` (lines 1-53)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (`load_controls(knob("inject.controls_file"))`)

// src: vvaharness/injectors/design_controls.py:31-53
fn load_controls(path):executor=code {
  p = Path(path)
  if (!p exists) return []
  try {
    data = yaml.safe_load(read p as UTF-8) || {}
    if (data is a dict) {
      items = data.controls
      require items != null => throw ValueError("controls file is a YAML mapping without a 'controls' key — expected a list or {controls: [...]}")
    } else { items = data }
    return [Control.model_validate(item) for each item in items]   // one invalid item fails the whole file (unlike load_cves)
  }
  catch (OSError | ValueError | TypeError | yaml.YAMLError | ValidationError) => {
    warn DESIGN_CONTROLS_UNREADABLE; errlog.log("inject.controls", p, error)
    return []
  }
}
// src: vvaharness/injectors/design_controls.py:47-49
// preserved: an empty file yields data == {} (a dict without "controls"), so it is reported as unreadable rather than as no controls.
