// file: vvaharness/remediation_agent/playbook.py, inputs/remediation_playbook.yaml
// Fix-strategy resolver: the agent selects a strategy from the shipped playbook rather than inventing one.
// Resolution: CWE -> language -> framework -> default -> CWE fallback -> none.

@executedBy(CODE) @role(config) @stage("S10")
class RemediationAgentPlaybook {

    Playbook load(String path, Theta θ) {
        Map doc = Yaml.safeLoad(path != null ? path : "inputs/remediation_playbook.yaml");          // src: vvaharness/remediation_agent/playbook.py:78
        if (doc == null) return Playbook.empty();                                                   // src: vvaharness/remediation_agent/playbook.py:80  (load error -> no strategies)
        Playbook pb = new Playbook(doc.get("cwe"), doc.get("policy"));                              // src: vvaharness/remediation_agent/playbook.py:83
        pb.maxDiffLines = θ["playbook.policy.max_diff_lines"];                                      // src: vvaharness/remediation_agent/playbook.py:89
        pb.maxFilesTouched = θ["playbook.policy.max_files_touched"];                                // src: vvaharness/remediation_agent/playbook.py:93
        // unclear: max_diff_lines / max_files_touched are exposed as properties but no caller in vvaharness reads them.
        pb.allowNewDependencies = θ["playbook.policy.allow_new_dependencies"];                      // src: inputs/remediation_playbook.yaml:42
        // unclear: allow_new_dependencies is never read by code; per-strategy allowed_deps reach the prompt instead.
        pb.neverAutofixCwes = θ["playbook.policy.never_autofix_cwes"];                              // src: inputs/remediation_playbook.yaml:51
        // unclear: never_autofix_cwes is never read by code; only remediation_policy.yaml deny entries block a CWE.
        return pb;
    }

    Strategy resolve(Playbook pb, String cwe, String language, Set<String> frameworks) {
        Map entry = pb.cwe.get(cwe);                                                                // src: vvaharness/remediation_agent/playbook.py:99
        if (entry == null) return null;                                                             // src: vvaharness/remediation_agent/playbook.py:101
        Map strategies = entry.getOr("strategies", Map.of());                                       // src: vvaharness/remediation_agent/playbook.py:107
        Map langBlock = strategies.getOr(language, strategies.get("default"));                      // src: vvaharness/remediation_agent/playbook.py:108
        Map node = null;
        for (String fw : frameworks) {                                                              // src: vvaharness/remediation_agent/playbook.py:113
            if (langBlock.containsKey(fw)) {                                                        // src: vvaharness/remediation_agent/playbook.py:114
                node = langBlock.get(fw);                                                           // src: vvaharness/remediation_agent/playbook.py:115
                break;
            }
        }
        if (node == null) node = langBlock.getOr("default", langBlock.containsKey("name") ? langBlock : null); // src: vvaharness/remediation_agent/playbook.py:118
        if (node == null) node = entry.get("fallback");                                             // src: vvaharness/remediation_agent/playbook.py:121
        if (node == null) return null;                                                              // src: vvaharness/remediation_agent/playbook.py:123
        return new Strategy(node.name, node.instruction, cwe, entry.title, node.getOr("confidence", entry.confidence), node.exampleAfter, node.allowedDeps, entry.getOr("fix_location", "sink")); // src: vvaharness/remediation_agent/playbook.py:124
    }
}

// Strategy.as_prompt_block: the authoritative section injected into the user prompt on the ALLOW path.
@executedBy(MODEL) @role(prompt) @stage("S10")
class PlaybookStrategyBlock {

    Prompt asPromptBlock(Strategy s) {
        Prompt p = new Prompt();
        p.must("## Required fix strategy: " + s.name);                                              // src: vvaharness/remediation_agent/playbook.py:53
        p.context("CWE: " + s.cwe + " - " + s.cweTitle);                                            // src: vvaharness/remediation_agent/playbook.py:54
        p.context("Fix location: " + s.fixLocation);                                                // src: vvaharness/remediation_agent/playbook.py:55
        p.rule(s.instruction);                                                                      // src: vvaharness/remediation_agent/playbook.py:57
        if (s.exampleAfter != null) p.context("Reference pattern (the shape your fix should take): " + s.exampleAfter); // src: vvaharness/remediation_agent/playbook.py:60
        p.rule("Allowed new dependencies: " + (s.allowedDeps.isEmpty() ? "(none)" : s.allowedDeps)); // src: vvaharness/remediation_agent/playbook.py:63
        p.forbid("Select THIS strategy; do not invent an alternative approach.");                   // src: vvaharness/remediation_agent/playbook.py:64
        return p;
    }
}
