// file: vulnhunter-fix/references/sweep-algorithm.md
// Rule book (REQ-SWP-001..009): two-pass sibling sweep, per-ROOT summary, routing paths, tier downgrade, column-8 and PR-diff handling.
// Companion to prompts/sweep.md (Sweep phase, between Verify and Deliver); sweep.md carries invocation, details live here.

@executedBy(MODEL) @role(rule_set) @stage("fix.sweep")
class SweepAlgorithm {

    // Entry: sweep every ROOT cause, route siblings, then apply downgrade/column-8.
    List<SummaryRow> run(List<RootCause> roots, Graph graph, Result result, ScanMode mode, Theta θ) {
        List<String> passes = θ["p.sweep-algorithm.two_pass_algorithm"];                              // src: vulnhunter-fix/references/sweep-algorithm.md:7
        List<SummaryRow> rows = new List();
        for (RootCause root : roots) {
            Sidecar sc = Sidecar.read(".work/<repo>/graph_context/" + root.vulnId + ".json");
            List<Sibling> sibs = new List();
            boolean fallback = graph.backend == "grep" || sc.confidence == "low";                       // src: vulnhunter-fix/references/sweep-algorithm.md:23
            if (!(fallback && θ["p.sweep-algorithm.graph_fallback_skips_pass1"])) {                    // src: vulnhunter-fix/references/sweep-algorithm.md:23
                sibs.addAll(pass1Symbol(root, sc, graph, result, θ));
            }
            sibs.addAll(pass2Pattern(root, sibs, θ));
            if (mode == PR_DIFF) sibs = prDiffPreExisting(sibs, θ);
            SummaryRow row = summarize(root, sibs, result, θ);
            if (fallback) row.captured = θ["p.sweep-algorithm.regex_only_annotation"];                // src: vulnhunter-fix/references/sweep-algorithm.md:23
            tierDowngrade(result, row, sibs, θ);
            row.column8 = column8(row, result, θ);
            rows.add(row);
        }
        return rows;
    }

    List<Sibling> pass1Symbol(RootCause root, Sidecar sc, Graph graph, Result result, Theta θ) {
        String sink = null;
        if (θ["p.sweep-algorithm.pass1_sink_symbol_from_sidecar"]) sink = sc.sinkSymbol;            // src: vulnhunter-fix/references/sweep-algorithm.md:12
        List<Symbol> callers = new List();
        if (θ["p.sweep-algorithm.pass1_callers_of_sink"]) callers = graph.callersOf(sink);           // src: vulnhunter-fix/references/sweep-algorithm.md:13
        List<Sibling> out = new List();
        for (Symbol c : callers) {
            if (!result.callersRoutedThroughFix.contains(c)) {                                         // src: vulnhunter-fix/references/sweep-algorithm.md:14
                if (θ["p.sweep-algorithm.pass1_unrouted_caller_is_sibling"]) out.add(Sibling.of(c));  // src: vulnhunter-fix/references/sweep-algorithm.md:15
            }
        }
        return out;
    }

    List<Sibling> pass2Pattern(RootCause root, List<Sibling> pass1Hits, Theta θ) {
        List<Regex> patterns = List.of();
        if (θ["p.sweep-algorithm.pass2_patterns_by_cwe_class"]) {                                     // src: vulnhunter-fix/references/sweep-algorithm.md:21
            String cls = CweFixPatterns.classify(root.cwe, θ);                                         // src: vulnhunter-fix/references/sweep-algorithm.md:20
            patterns = SweepPatterns.patternsFor(cls, θ);                                              // src: vulnhunter-fix/references/sweep-algorithm.md:21
        }
        List<Sibling> out = new List();
        if (θ["p.sweep-algorithm.pass2_scan_unflagged_files"]) {                                      // src: vulnhunter-fix/references/sweep-algorithm.md:22
            for (File src : Repo.sourceFiles().minus(pass1Hits.files())) {
                for (Regex p : patterns) out.addAll(src.grep(p).map(h -> Sibling.candidate(h)));
            }
        }
        return out;
    }

    SummaryRow summarize(RootCause root, List<Sibling> sibs, Result result, Theta θ) {
        SummaryRow row = new SummaryRow(θ["p.sweep-algorithm.per_root_summary_columns"]);           // src: vulnhunter-fix/references/sweep-algorithm.md:30
        row.found = sibs.size();                                                                       // both passes
        List<Sibling> captured = sibs.filter(s -> executorIncludes(s));
        row.capturedCount = captured.size();
        int mitigated = 0;
        for (Sibling s : captured) {
            if (route(s, result, θ)) mitigated++;
        }
        row.mitigated = mitigated;
        if (θ["p.sweep-algorithm.remaining_definition"] == "Found − Mitigated") {                    // src: vulnhunter-fix/references/sweep-algorithm.md:38
            row.remaining = row.found - row.mitigated;
        }
        return row;
    }

    // Path A amend / Path B follow-up issue. Returns true when the sibling counts as mitigated.
    boolean route(Sibling s, Result result, Theta θ) {
        if (s.sameWorktree && result.filesModified.contains(s.file)) {
            if (θ["p.sweep-algorithm.path_a_scope_amendment"]) {                                      // src: vulnhunter-fix/references/sweep-algorithm.md:43
                Pr.amendToCover(s);
                return true;
            }
        }
        Issue.open(s, θ["p.sweep-algorithm.path_b_followup_issue"]);                                 // src: vulnhunter-fix/references/sweep-algorithm.md:44
        return true;                                                                                   // do NOT amend the PR
    }

    void tierDowngrade(Result result, SummaryRow row, List<Sibling> sibs, Theta θ) {
        if (result.tier == VERIFIED_FULL && row.found > 0) {
            result.tier = θ["p.sweep-algorithm.downgrade_full_to_mitigation"];                        // src: vulnhunter-fix/references/sweep-algorithm.md:49
            if (θ["p.sweep-algorithm.set_sweep_revised"]) result.sweepRevised = true;                // src: vulnhunter-fix/references/sweep-algorithm.md:50
            if (θ["p.sweep-algorithm.residuals_name_unmitigated_siblings"]) {                         // src: vulnhunter-fix/references/sweep-algorithm.md:51
                for (Sibling s : sibs.filter(x -> !x.mitigated)) result.residualVectors.add(s.describe());
            }
            if (θ["p.sweep-algorithm.rerender_residual_section"]) Delivery.rerunHonestyGuards(result); // src: vulnhunter-fix/references/sweep-algorithm.md:52
        }
    }

    String column8(SummaryRow row, Result result, Theta θ) {
        if (row.found == 0) return θ["p.sweep-algorithm.column8_yes_na"];                            // src: vulnhunter-fix/references/sweep-algorithm.md:57
        if (row.remaining == 0) return θ["p.sweep-algorithm.column8_yes"];                           // src: vulnhunter-fix/references/sweep-algorithm.md:58
        result.verdictCell = "MITIGATION";                                                             // FULL -> MITIGATION
        return θ["p.sweep-algorithm.column8_no_downgrades_verdict"];                                  // src: vulnhunter-fix/references/sweep-algorithm.md:59
    }

    List<Sibling> prDiffPreExisting(List<Sibling> sibs, Theta θ) {
        List<Sibling> keep = new List();
        for (Sibling s : sibs) {
            if (s.marker != "PRE-EXISTING") {
                keep.add(s);
                continue;
            }
            if (θ["p.sweep-algorithm.pr_diff_preexisting_informational"]) TrackingIssue.addInformational(s); // src: vulnhunter-fix/references/sweep-algorithm.md:64
            if (!θ["p.sweep-algorithm.pr_diff_preexisting_no_autofix"]) keep.add(s);                 // src: vulnhunter-fix/references/sweep-algorithm.md:65
            if (!θ["p.sweep-algorithm.pr_diff_preexisting_no_followup"]) Issue.open(s, "followup");  // src: vulnhunter-fix/references/sweep-algorithm.md:66
        }
        return keep;
    }
}
