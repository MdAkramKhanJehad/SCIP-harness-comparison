// file: vvaharness/report/appcontext.py
// Application context -> contextual severity: CMDB CSV loading with parent inheritance, an environmental
// CVSS 3.1 score (VulContextSeverity, "vsvs") from the app's data sensitivity and exposure, and the keyword-driven
// OffensivePriority (P1..P4) each verified finding carries.

/** One CMDB row. *_raw keep blank as null so a child inherits from parent_id. */
@executedBy(CODE) @role(types)
record AppInfo(String id, String name, boolean externallyFacing, boolean pciScoped, boolean processesPan, boolean pii,
               String extRaw, String pciRaw, String panRaw, String piiRaw, String parentAppId, String source) { } // source default "application" // src: vvaharness/report/appcontext.py:83

@executedBy(CODE) @role(types)
record VsvsResult(String vector, double score, String rating) { }                                 // src: vvaharness/report/appcontext.py:268

@executedBy(CODE) @role(rule_set) @stage("S7")
class Appcontext {

    // ---- AppInfo security requirements (CVSS environmental) ----

    /** CR: H when PCI-scoped, processes PAN or holds PII, else M. */
    String cr(AppInfo a, Theta θ) {
        return (a.pciScoped || a.processesPan || a.pii) ? θ["code.report.appcontext.security_requirement_rules"].get("CR_SENSITIVE") : "M"; // src: vvaharness/report/appcontext.py:98
    }

    /** IR: H when PCI-scoped or processes PAN, else M. */
    String ir(AppInfo a, Theta θ) {
        return (a.pciScoped || a.processesPan) ? θ["code.report.appcontext.security_requirement_rules"].get("IR_SENSITIVE") : "M"; // src: vvaharness/report/appcontext.py:101
    }

    String ar(AppInfo a, Theta θ) {
        return θ["code.report.appcontext.security_requirement_rules"].get("AR");                       // always M // src: vvaharness/report/appcontext.py:104
    }

    /** Modified AV: a non-externally-facing app downgrades AV:N to Adjacent. */
    String mav(AppInfo a, String baseAv) {
        return (!a.externallyFacing && baseAv == "N") ? "A" : baseAv;                                  // src: vvaharness/report/appcontext.py:107
    }

    String envSummary(AppInfo a, Theta θ) {
        return "CR:" + cr(a, θ) + "/IR:" + ir(a, θ) + "/AR:" + ar(a, θ) + " extFacing=" + a.externallyFacing; // src: vvaharness/report/appcontext.py:110
    }

    // ---- CMDB ----

    boolean yes(String v) { return v != null && v.strip().lower() == "yes"; }                         // src: vvaharness/report/appcontext.py:114

    String nz(String v) { return (v == null || v.strip().isEmpty()) ? null : v.strip(); }              // src: vvaharness/report/appcontext.py:117

    /** Strip leading zeros so 042 and 42 are one key. */
    String normalizeAppId(String appId) {
        if (appId == null) return null;                                                                // src: vvaharness/report/appcontext.py:125
        String s = Regex.sub("^0+", appId.strip(), "");                                                // src: vvaharness/report/appcontext.py:127
        return s.isEmpty() ? "0" : s;                                                                  // src: vvaharness/report/appcontext.py:128
    }

    int csvCol(Map<String, Integer> hdr, List<String> names) {
        for (String n : names) if (hdr.containsKey(n.lower())) return hdr.get(n.lower());             // src: vvaharness/report/appcontext.py:132
        return -1;                                                                                     // src: vvaharness/report/appcontext.py:136
    }

    boolean cmdbEnrichmentDiffers(AppInfo x, AppInfo y) {
        for (String f : List.of("externally_facing", "pci_scoped", "processes_pan", "pii")) if (x.get(f) != y.get(f)) return true; // src: vvaharness/report/appcontext.py:141
        return normalizeAppId(x.parentAppId) != normalizeAppId(y.parentAppId);                         // src: vvaharness/report/appcontext.py:144
    }

    /** Load the CMDB CSV (comment lines before the header skipped); last row wins on a key collision (warned). */
    Map<String, AppInfo> loadCmdbCsv(String path) {
        Map<String, AppInfo> out = new Map();
        if (path == null || path.isEmpty() || !Files.isFile(path)) return out;                         // no CMDB: empty map // src: vvaharness/report/appcontext.py:149
        CsvReader reader = Csv.open(path);                                                             // src: vvaharness/report/appcontext.py:151
        List<String> header = null;
        for (List<String> row : reader) {                                                              // src: vvaharness/report/appcontext.py:155
            if (row.isEmpty()) continue;
            if (row.get(0).lstrip().startsWith("#") || row.allBlank()) continue;                       // license block // src: vvaharness/report/appcontext.py:159
            header = row; break;                                                                       // src: vvaharness/report/appcontext.py:161
        }
        if (header == null) return out;                                                                // src: vvaharness/report/appcontext.py:163
        Map<String, Integer> hdr = header.indexByLower();                                              // src: vvaharness/report/appcontext.py:165
        int iId = csvCol(hdr, List.of("id"));                                                          // src: vvaharness/report/appcontext.py:166
        if (iId < 0) throw new ValueError("CMDB CSV missing 'id' column");                            // src: vvaharness/report/appcontext.py:173
        for (List<String> row : reader) {                                                              // src: vvaharness/report/appcontext.py:179
            String rid = row.at(iId);
            if (rid == null || rid.strip().isEmpty()) continue;                                        // src: vvaharness/report/appcontext.py:181
            AppInfo a = new AppInfo();
            a.id = rid.strip(); a.name = row.at(csvCol(hdr, List.of("name")));                         // src: vvaharness/report/appcontext.py:184
            a.extRaw = nz(row.at(csvCol(hdr, List.of("externally_facing")))); a.pciRaw = nz(row.at(csvCol(hdr, List.of("pci")))); // src: vvaharness/report/appcontext.py:187
            a.panRaw = nz(row.at(csvCol(hdr, List.of("pan")))); a.piiRaw = nz(row.at(csvCol(hdr, List.of("pii"))));             // src: vvaharness/report/appcontext.py:189
            a.externallyFacing = yes(a.extRaw); a.pciScoped = yes(a.pciRaw); a.processesPan = yes(a.panRaw); a.pii = yes(a.piiRaw); // only "yes" is true // src: vvaharness/report/appcontext.py:191
            a.parentAppId = nz(row.at(csvCol(hdr, List.of("parent_id"))));                            // src: vvaharness/report/appcontext.py:195
            String key = normalizeAppId(a.id);                                                         // src: vvaharness/report/appcontext.py:196
            AppInfo prior = out.get(key);
            if (prior != null && cmdbEnrichmentDiffers(prior, a)) Log.warning("APPCONTEXT_KEY_COLLISION"); // src: vvaharness/report/appcontext.py:198
            out.put(key, a);                                                                           // last wins // src: vvaharness/report/appcontext.py:203
        }
        return out;
    }

    /** Own value when set (non-blank raw), else the parent's, else own (false). */
    boolean pick(AppInfo own, AppInfo parent, String raw, String val) {
        if (own != null && own.get(raw) != null) return own.get(val);                                  // src: vvaharness/report/appcontext.py:209
        if (parent != null) return parent.get(val);                                                    // src: vvaharness/report/appcontext.py:211
        return own != null && own.get(val);                                                            // src: vvaharness/report/appcontext.py:213
    }

    AppInfo mergeWithParent(AppInfo base, AppInfo own, AppInfo parent, String source) {
        AppInfo r = new AppInfo();
        r.id = base.id; r.name = base.name; r.parentAppId = own != null ? own.parentAppId : base.parentAppId; r.source = source; // src: vvaharness/report/appcontext.py:219
        r.externallyFacing = pick(own, parent, "ext_raw", "externally_facing");                        // src: vvaharness/report/appcontext.py:223
        r.pciScoped = pick(own, parent, "pci_raw", "pci_scoped");                                      // src: vvaharness/report/appcontext.py:224
        r.processesPan = pick(own, parent, "pan_raw", "processes_pan");                                // src: vvaharness/report/appcontext.py:225
        r.pii = pick(own, parent, "pii_raw", "pii");                                                   // src: vvaharness/report/appcontext.py:226
        return r;
    }

    /** Application row first (inheriting blanks from its parent), else a component row merged with its parent. */
    AppInfo lookupApp(String appId, Map<String, AppInfo> cmdb, Map<String, AppInfo> cmdbComp) {
        if (appId == null || appId.isEmpty()) return null;                                             // src: vvaharness/report/appcontext.py:232
        String key = normalizeAppId(appId);                                                            // src: vvaharness/report/appcontext.py:234
        AppInfo a = cmdb.get(key); AppInfo c = cmdbComp.get(key);                                      // src: vvaharness/report/appcontext.py:235
        if (a != null) {
            boolean anyBlank = a.pciRaw == null || a.panRaw == null || a.piiRaw == null || a.extRaw == null; // src: vvaharness/report/appcontext.py:239
            String parentId = a.parentAppId != null ? a.parentAppId : (c != null ? c.parentAppId : null); // src: vvaharness/report/appcontext.py:241
            if (anyBlank && parentId != null) {
                AppInfo p = cmdb.get(normalizeAppId(parentId));                                        // src: vvaharness/report/appcontext.py:243
                if (p != null && normalizeAppId(p.id) != key) return mergeWithParent(a, a, p, "application->parent " + p.id); // src: vvaharness/report/appcontext.py:244
            }
            a.source = "application"; return a;                                                        // src: vvaharness/report/appcontext.py:246
        }
        if (c == null) return null;                                                                    // src: vvaharness/report/appcontext.py:249
        AppInfo p = c.parentAppId != null ? cmdb.get(normalizeAppId(c.parentAppId)) : null;            // src: vvaharness/report/appcontext.py:251
        return mergeWithParent(c, c, p, p != null ? "component->parent " + p.id : "component");        // src: vvaharness/report/appcontext.py:252
    }

    // ---- environmental CVSS ----

    Map<String, String> parseVector(String vector) {
        Map<String, String> m = new Map();
        for (String part : vector.split("/")) if (part.contains(":")) m.put(part.before(":").strip().upper(), part.after(":").strip().upper()); // src: vvaharness/report/appcontext.py:260
        return m;
    }

    String envVector(String base, String mav, AppInfo app, Theta θ) {
        String prefix = base.startsWith("CVSS:") ? base : "CVSS:3.1/" + base;                          // src: vvaharness/report/appcontext.py:275
        Map t = θ["code.report.appcontext.sast_temporal_preset"];                                      // E:P RL:O RC:C // src: vvaharness/report/appcontext.py:34
        return prefix + "/E:" + t.get("E") + "/RL:" + t.get("RL") + "/RC:" + t.get("RC") + "/CR:" + cr(app, θ) + "/IR:" + ir(app, θ) + "/AR:" + ar(app, θ) + "/MAV:" + mav; // src: vvaharness/report/appcontext.py:276
    }

    /** VulContextSeverity: environmental CVSS 3.1 from the base vector plus CMDB context; null when no app or incomplete vector. */
    VsvsResult vsvsScore(String baseVector, AppInfo app, Theta θ) {
        if (baseVector == null || baseVector.isEmpty() || app == null) return null;                   // src: vvaharness/report/appcontext.py:281
        Map<String, String> m = parseVector(baseVector);                                               // src: vvaharness/report/appcontext.py:283
        if (List.of("AV", "AC", "PR", "UI", "S", "C", "I", "A").anyMatch(k -> m.get(k) == null)) return null; // src: vvaharness/report/appcontext.py:286
        String mav = mav(app, m.get("AV"));                                                            // src: vvaharness/report/appcontext.py:288
        boolean scopeChanged = m.get("S") == "C";                                                      // src: vvaharness/report/appcontext.py:289
        Map w = θ["code.report.cvss.base_metric_weights"];                                             // weights live in report/cvss.py only // src: vvaharness/report/appcontext.py:290
        Map ew = θ["code.report.cvss.environmental_weights"];                                          // src: vvaharness/report/appcontext.py:296
        double mavV = w.AV.get(mav); double acV = w.AC.get(m.get("AC"));                               // src: vvaharness/report/appcontext.py:290
        double prV = (scopeChanged ? w.PR_SCOPE_CHANGED : w.PR_SCOPE_UNCHANGED).get(m.get("PR")); double uiV = w.UI.get(m.get("UI")); // src: vvaharness/report/appcontext.py:292
        double cV = w.CIA.get(m.get("C")); double iV = w.CIA.get(m.get("I")); double aV = w.CIA.get(m.get("A")); // src: vvaharness/report/appcontext.py:295
        double crV = ew.REQ.getOrDefault(cr(app, θ), 1.0); double irV = ew.REQ.getOrDefault(ir(app, θ), 1.0); double arV = ew.REQ.getOrDefault(ar(app, θ), 1.0); // M -> neutral 1.0 // src: vvaharness/report/appcontext.py:296
        if (Math.min(mavV, acV, prV, uiV, cV, iV, aV) < 0) return null;                                // unknown metric letter // src: vvaharness/report/appcontext.py:298
        Map t = θ["code.report.appcontext.sast_temporal_preset"];
        double eV = ew.EXPLOIT_MATURITY.get(t.get("E")); double rlV = ew.REMEDIATION_LEVEL.get(t.get("RL")); double rcV = ew.REPORT_CONFIDENCE.get(t.get("RC")); // src: vvaharness/report/appcontext.py:300
        double miss = Math.min(1 - (1 - crV * cV) * (1 - irV * iV) * (1 - arV * aV), θ["code.report.cvss.formula_coefficients"].get("MISS_CAP")); // src: vvaharness/report/appcontext.py:303
        double mImpact = Cvss.modifiedImpact(miss, scopeChanged, θ);                                   // src: vvaharness/report/appcontext.py:304
        if (mImpact <= 0) return new VsvsResult(envVector(baseVector, mav, app, θ), 0.0, "None");       // src: vvaharness/report/appcontext.py:306
        double mExploit = θ["code.report.cvss.formula_coefficients"].get("EXPLOITABILITY_COEFF") * mavV * acV * prV * uiV; // src: vvaharness/report/appcontext.py:307
        double modBase = Cvss.combine(mImpact, mExploit, scopeChanged, θ);                             // src: vvaharness/report/appcontext.py:308
        double env = Cvss.roundup1(modBase * eV * rlV * rcV, θ);                                       // src: vvaharness/report/appcontext.py:309
        return new VsvsResult(envVector(baseVector, mav, app, θ), env, Cvss.rating(env, θ));           // src: vvaharness/report/appcontext.py:310
    }

    // ---- OffensivePriority ----

    boolean containsAny(String haystack, List<String> needles) {
        return needles.anyMatch(n -> haystack.contains(n));                                            // src: vvaharness/report/appcontext.py:315
    }

    /** Pure (priority, reason), model-agnostic: P4 insider knowledge, P3 internal/privileged/unverified exposure, P1 internet + unauthenticated, P2 internet + obtainable auth. */
    Pair<String, String> offensivePriorityFor(String title, String category, String description, String cvssVector, AppInfo app, Theta θ) {
        String body = String.join(" ", title, category, description).lower();                         // src: vvaharness/report/appcontext.py:322
        Map<String, String> v = cvssVector != null ? parseVector(cvssVector) : Map.of();               // src: vvaharness/report/appcontext.py:323
        Map dflt = θ["code.report.appcontext.missing_vector_defaults"];                                // AV:N PR:L AC:L when absent // src: vvaharness/report/appcontext.py:324
        String av = v.getOrDefault("AV", dflt.get("AV")); String pr = v.getOrDefault("PR", dflt.get("PR")); // src: vvaharness/report/appcontext.py:324
        boolean prExplicit = v.containsKey("PR");                                                      // src: vvaharness/report/appcontext.py:326
        String ac = v.getOrDefault("AC", dflt.get("AC"));                                              // src: vvaharness/report/appcontext.py:327
        boolean cmdbExternal = app != null && app.externallyFacing;                                    // src: vvaharness/report/appcontext.py:329
        boolean cmdbInternal = app != null && !app.externallyFacing;                                   // src: vvaharness/report/appcontext.py:330
        boolean codeKnowledge = containsAny(body, θ["code.report.appcontext.kw_code_knowledge"]) || (category != null && category.lower().contains("hardcoded")); // src: vvaharness/report/appcontext.py:332
        boolean internalNet = cmdbInternal || List.of("A", "L", "P").contains(av) || containsAny(body, θ["code.report.appcontext.kw_internal"]); // src: vvaharness/report/appcontext.py:334
        boolean highPriv = pr == "H" || containsAny(body, θ["code.report.appcontext.kw_high_priv"]);  // src: vvaharness/report/appcontext.py:336
        boolean obtainableAuth = pr == "L" || containsAny(body, θ["code.report.appcontext.kw_obtainable_auth"]); // src: vvaharness/report/appcontext.py:337
        boolean prRequiresAuth = prExplicit && List.of("L", "H").contains(pr);                         // explicit PR:L/H vetoes a stray "unauthenticated" // src: vvaharness/report/appcontext.py:339
        boolean noAuth = !prRequiresAuth && (containsAny(body, θ["code.report.appcontext.kw_no_auth"]) || (pr == "N" && !obtainableAuth && !highPriv)); // src: vvaharness/report/appcontext.py:340
        boolean internetReachable = av == "N" && !internalNet && cmdbExternal;                         // src: vvaharness/report/appcontext.py:343
        boolean exposureUnknown = app == null && av == "N" && !internalNet;                            // src: vvaharness/report/appcontext.py:344
        List<String> why = new List(); String prio;
        if (codeKnowledge) {                                                                           // src: vvaharness/report/appcontext.py:347
            prio = "P4"; why.add("requires source-code / insider knowledge");                          // src: vvaharness/report/appcontext.py:348
            if (cmdbInternal) why.add("app not externally facing (CMDB)"); else if (av != "N") why.add("AV:" + av); // src: vvaharness/report/appcontext.py:350
        } else if (exposureUnknown && !highPriv) {                                                     // src: vvaharness/report/appcontext.py:354
            prio = "P3"; why.add("exposure unverified - no CMDB context");                             // src: vvaharness/report/appcontext.py:355
        } else if (!internetReachable || highPriv) {                                                   // src: vvaharness/report/appcontext.py:358
            prio = "P3";                                                                               // src: vvaharness/report/appcontext.py:359
            if (cmdbInternal) why.add("app not externally facing (CMDB)"); else if (av != "N") why.add("AV non-network"); else if (internalNet) why.add("internal-network position required"); // src: vvaharness/report/appcontext.py:360
            if (highPriv) why.add(pr == "H" ? "PR:H - high-privilege auth required" : "admin/privileged role required"); // src: vvaharness/report/appcontext.py:366
            if (why.isEmpty()) why.add("internal network / privileged position required");             // src: vvaharness/report/appcontext.py:369
        } else if (noAuth) {                                                                           // src: vvaharness/report/appcontext.py:371
            prio = "P1"; why.add("internet-facing"); why.add("AV:" + av + " - unauthenticated");       // src: vvaharness/report/appcontext.py:372
        } else {
            prio = "P2"; why.add("internet-facing"); why.add("PR:" + pr + " - auth required but obtainable"); // src: vvaharness/report/appcontext.py:377
        }
        if (ac == "H" && List.of("P1", "P2").contains(prio)) why.add("AC:H - complex preconditions");  // noted, not demoted // src: vvaharness/report/appcontext.py:381
        return Pair.of(prio, String.join("; ", why));                                                  // src: vvaharness/report/appcontext.py:384
    }
}
