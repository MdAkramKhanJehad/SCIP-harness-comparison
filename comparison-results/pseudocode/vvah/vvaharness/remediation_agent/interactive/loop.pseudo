// file: vvaharness/remediation_agent/interactive/loop.py
// Interactive remediation loops: arrow-key TUI on a real terminal, else a numbered prompt; both remediate
// one chosen finding at a time through remediateOne (never raises; a failure only fails that finding).

@executedBy(CODE) @role(step) @stage("S10")
class Loop {

    boolean remediateOne(RemediationTarget target, Path reportPath, Path remDir, Path ckptDir, String runId, Config cfg, String mode, boolean verbose, PolicyContext policyCtx, Theta θ) {
        String step = Runner.stepKeyOf(target, cfg);                                                // src: vvaharness/remediation_agent/interactive/loop.py:52
        String label = Redact.redact(target.label());                                               // src: vvaharness/remediation_agent/interactive/loop.py:53
        try {
            // Guarded inside the broad except: a planted symlinked slug dir fails only this finding.
            Path outDir = OrchestratorArtifacts.artifactDir(remDir, target.slug());                 // src: vvaharness/remediation_agent/interactive/loop.py:57
            Remediation remediation = PluginRunnerRun.applyPlugin(target, outDir, cfg, remDir.parent, mode, verbose, policyCtx, θ); // src: vvaharness/remediation_agent/interactive/loop.py:61
            // Bind finding identity into the checkpoint so S11 provenance can trust this case.
            Map record = PluginRunnerRun.checkpointRecord(target, outDir, remediation).with("finding_id", target.caseId()); // src: vvaharness/remediation_agent/interactive/loop.py:67
            Checkpoints.saveCkpt(ckptDir, runId, step, record);                                     // src: vvaharness/remediation_agent/interactive/loop.py:69
            // Mirror discovery.completed_case_ids so a declined attempt shows no done mark next session.
            CaseState state = Derive.stateOf(List.of(new Attempt(1, remediation)));                 // src: vvaharness/remediation_agent/interactive/loop.py:72
            target.done = θ["code.remediation_agent.discovery.done_states"].contains(state);        // src: vvaharness/remediation_agent/interactive/loop.py:73
            return true;                                                                            // src: vvaharness/remediation_agent/interactive/loop.py:75
        } catch (Exception e) {
            Log.warning("REMEDIATION_FINDING_FAILED", target.index, Redact.redact(e.message));      // src: vvaharness/remediation_agent/interactive/loop.py:77
            return false;                                                                           // src: vvaharness/remediation_agent/interactive/loop.py:78
        }
    }

    int runInteractive(List<RemediationTarget> findings, Path reportPath, Path remDir, Path ckptDir, String runId, Config cfg, String mode, boolean verbose, Theta θ) {
        int session = 0;
        // Policy context built once (no-op unless step_remediate.enforce_policy).
        PolicyContext policyCtx = Policy.buildContext(cfg, remDir.parent, θ);                       // src: vvaharness/remediation_agent/interactive/loop.py:87
        boolean interactiveTty;
        try {
            interactiveTty = Stdin.isatty() && Stderr.isatty();                                     // src: vvaharness/remediation_agent/interactive/loop.py:92
        } catch (Exception e) {
            interactiveTty = false;                                                                 // src: vvaharness/remediation_agent/interactive/loop.py:94
        }
        if (interactiveTty) {                                                                       // src: vvaharness/remediation_agent/interactive/loop.py:96
            session = loopTty(findings, reportPath, remDir, ckptDir, runId, cfg, mode, verbose, policyCtx, θ); // src: vvaharness/remediation_agent/interactive/loop.py:97
        } else {
            session = loopPrompt(findings, reportPath, remDir, ckptDir, runId, cfg, mode, verbose, policyCtx, θ); // src: vvaharness/remediation_agent/interactive/loop.py:101
        }
        int totalDone = findings.count(f -> f.done);                                                // src: vvaharness/remediation_agent/interactive/loop.py:105
        return 0;                                                                                   // src: vvaharness/remediation_agent/interactive/loop.py:108  (always exit 0)
    }

    int loopTty(List<RemediationTarget> findings, Path reportPath, Path remDir, Path ckptDir, String runId, Config cfg, String mode, boolean verbose, PolicyContext policyCtx, Theta θ) {
        int cursor = 0;
        int session = 0;
        while (true) {                                                                              // src: vvaharness/remediation_agent/interactive/loop.py:115
            InteractiveRender.clearAndDraw(findings, cursor);                                       // src: vvaharness/remediation_agent/interactive/loop.py:116
            KeyToken key;
            try {
                key = Keys.readKey();                                                               // src: vvaharness/remediation_agent/interactive/loop.py:118
            } catch (RuntimeError e) {
                // Lost the raw TTY mid-loop: degrade to the prompt path.
                return session + loopPrompt(findings, reportPath, remDir, ckptDir, runId, cfg, mode, verbose, policyCtx, θ); // src: vvaharness/remediation_agent/interactive/loop.py:121
            }
            if (key == QUIT) return session;                                                        // src: vvaharness/remediation_agent/interactive/loop.py:125
            if (key == UP) {
                cursor = (cursor - 1) % findings.size();                                            // src: vvaharness/remediation_agent/interactive/loop.py:128
            } else if (key == DOWN) {
                cursor = (cursor + 1) % findings.size();                                            // src: vvaharness/remediation_agent/interactive/loop.py:130
            } else if (key == ENTER) {                                                              // src: vvaharness/remediation_agent/interactive/loop.py:131
                if (remediateOne(findings.get(cursor), reportPath, remDir, ckptDir, runId, cfg, mode, verbose, policyCtx, θ)) session = session + 1; // src: vvaharness/remediation_agent/interactive/loop.py:134
            }
        }
    }

    int loopPrompt(List<RemediationTarget> findings, Path reportPath, Path remDir, Path ckptDir, String runId, Config cfg, String mode, boolean verbose, PolicyContext policyCtx, Theta θ) {
        int session = 0;
        while (true) {                                                                              // src: vvaharness/remediation_agent/interactive/loop.py:144
            for (String row : InteractiveRender.renderRows(findings, null)) Console.write(row);     // src: vvaharness/remediation_agent/interactive/loop.py:145
            String raw;
            try {
                raw = Stdin.input("Select issues (e.g. 1,3-5 | all | pending | q): ");             // src: vvaharness/remediation_agent/interactive/loop.py:148
            } catch (EOFError | KeyboardInterrupt e) {
                return session;                                                                     // src: vvaharness/remediation_agent/interactive/loop.py:150
            }
            List<Integer> picks = InteractiveRender.parseSelection(raw, findings);                  // src: vvaharness/remediation_agent/interactive/loop.py:151
            if (picks == null) return session;                                                      // src: vvaharness/remediation_agent/interactive/loop.py:153
            for (int i : picks) {                                                                   // src: vvaharness/remediation_agent/interactive/loop.py:154  (sequential)
                if (remediateOne(findings.get(i), reportPath, remDir, ckptDir, runId, cfg, mode, verbose, policyCtx, θ)) session = session + 1; // src: vvaharness/remediation_agent/interactive/loop.py:155
            }
        }
    }
}
