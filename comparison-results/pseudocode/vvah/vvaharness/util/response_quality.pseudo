// file: vvaharness/util/response_quality.py
// Degenerate-response detector (VVAH-E003) for LLM replies, plus the shared failure classifiers
// (structured-output, truncation, timeout, connection, deterministic) and the retry-once-unforced wrapper.

@executedBy(CODE) @role(rule_set)
class ResponseQuality {

    Lock lock;
    Map<String, Integer> consecutive;                                          // per-stage degenerate streak // src: vvaharness/util/response_quality.py:62
    Map<String, Pair<Integer, Integer>> stageFloorsMap;                        // per-stage (min_chars, min_tokens) overrides // src: vvaharness/util/response_quality.py:64
    static final int RAW_HEAD_CHARS = 300;                                     // reply head kept in the errlog record // src: vvaharness/util/response_quality.py:57
    static final int FAILURE_DETAIL_CHARS = 300;                               // log cap // src: vvaharness/util/response_quality.py:233
    static final int FINISH_MARKER_CHARS = 40;                                 // log cap // src: vvaharness/util/response_quality.py:234

    void resetCounters() {
        synchronized (lock) { consecutive.clear(); }                           // between repos in batch runs // src: vvaharness/util/response_quality.py:70
    }

    void stageFloors(String stage, Integer minChars, Integer minTokens, Runnable body) {
        Pair prev;
        synchronized (lock) { prev = stageFloorsMap.get(stage); stageFloorsMap.put(stage, Pair.of(minChars, minTokens)); } // null keeps that axis' default // src: vvaharness/util/response_quality.py:83
        try { body.run(); }
        finally {
            synchronized (lock) { if (prev == null) stageFloorsMap.remove(stage); else stageFloorsMap.put(stage, prev); } // src: vvaharness/util/response_quality.py:91
        }
    }

    Integer outputTokensForGate(Map<String, Object> usage) {
        if (usage == null) return null;                                        // not measured, never 0 // src: vvaharness/util/response_quality.py:102
        Object raw = usage.get("output_tokens");
        if (raw == null) return null;                                          // src: vvaharness/util/response_quality.py:105
        try { return Integer.parse(raw); } catch (TypeError | ValueError e) { return null; } // non-numeric is not a measurement // src: vvaharness/util/response_quality.py:111
    }

    void checkResponseQuality(String text, String stage, Integer minChars, Integer outputTokens, List<String> expectedMarkers, Theta θ) {
        Pair<Integer, Integer> ov = stageFloorsMap.getOrDefault(stage, Pair.of(null, null)); // src: vvaharness/util/response_quality.py:124
        if (minChars == null) minChars = ov.first != null ? ov.first : θ["code.util.response_quality.default_min_chars"]; // src: vvaharness/util/response_quality.py:126
        int minTokens = ov.second != null ? ov.second : θ["code.util.response_quality.default_min_tokens"]; // src: vvaharness/util/response_quality.py:127
        String stripped = (text != null ? text : "").strip();
        List<String> reasons = List.of();
        if (stripped.length() < minChars) reasons.add("response too short");  // src: vvaharness/util/response_quality.py:131
        if (outputTokens != null && outputTokens < minTokens) reasons.add("output token count too low"); // src: vvaharness/util/response_quality.py:136
        if (expectedMarkers != null && !expectedMarkers.isEmpty()) {           // src: vvaharness/util/response_quality.py:142
            List<String> missing = expectedMarkers.filter(m -> !stripped.contains(m));
            if (!missing.isEmpty()) reasons.add("expected marker(s) absent");  // src: vvaharness/util/response_quality.py:145
        }
        if (reasons.isEmpty()) {
            synchronized (lock) { consecutive.remove(stage); }                 // a good reply resets the streak // src: vvaharness/util/response_quality.py:149
            return;
        }
        int count;
        synchronized (lock) { count = consecutive.getOrDefault(stage, 0) + 1; consecutive.put(stage, count); } // src: vvaharness/util/response_quality.py:154
        String summary = reasons.join("; ");
        if (count < θ["code.util.response_quality.degenerate_max_consecutive"]) { // accept with a warning // src: vvaharness/util/response_quality.py:159
            Logs.getLogger("response_quality").warning(Events.RESPONSE_DEGENERATE_ACCEPTED, "VVAH-E003", stage, summary); // src: vvaharness/util/response_quality.py:160
            Errlog.log(stage.isEmpty() ? "quality" : stage, stage.isEmpty() ? "response_quality" : stage, "VVAH-E003 warning: " + summary, true,
                       Map.of("error_code", "VVAH-E003", "raw_head", Redact.redact(stripped).head(RAW_HEAD_CHARS))); // recovered=True // src: vvaharness/util/response_quality.py:162
            return;                                                            // the reply is still used // src: vvaharness/util/response_quality.py:172
        }
        synchronized (lock) { consecutive.put(stage, 1); }                     // restart warnings, not raise every call // src: vvaharness/util/response_quality.py:176
        boolean charAxisFailed = stripped.length() < minChars;                 // src: vvaharness/util/response_quality.py:179
        throw new DegenerateResponseError(summary, stage, stripped.length(), charAxisFailed ? minChars : 0, count); // VVAH-E003 // src: vvaharness/util/response_quality.py:180
    }

    // caller alias (pass-1 files call ResponseQuality.check) for check_response_quality
    void check(String text, Theta θ) {
        checkResponseQuality(text, "", null, null, null, θ);
    }

    boolean isStructuredOutputFailure(Throwable exc, Theta θ) {
        Set<Integer> seen = Set.of();
        Throwable cur = exc;
        while (cur != null && !seen.contains(id(cur))) {                       // walks cause OR context // src: vvaharness/util/response_quality.py:214
            seen.add(id(cur));
            if (cur instanceof GuardrailBlocked) return false;                 // refusal is final: a resend repeats the blocked prompt // src: vvaharness/util/response_quality.py:217
            if (θ["code.util.response_quality.structured_output_failure_names"].contains(typeName(cur))) return true; // src: vvaharness/util/response_quality.py:219
            if (θ["code.util.response_quality.structured_output_failure_names"].any(n -> str(cur).contains(n))) return true; // name in message text too // src: vvaharness/util/response_quality.py:221
            cur = cur.cause != null ? cur.cause : cur.context;                 // src: vvaharness/util/response_quality.py:223
        }
        return false;
    }

    boolean isTruncatedWithoutRetry(Throwable exc) {
        return exc instanceof TruncatedResponseError && !exc.retried;          // VVAH-E005 the route could not grow // src: vvaharness/util/response_quality.py:229
    }

    Pair<String, Boolean> structuredFailureDetail(Throwable exc, Theta θ) {
        List<Throwable> chain = Exceptions.exceptionChain(exc);                // src: vvaharness/util/response_quality.py:239
        Throwable link = chain.firstOr(c -> θ["code.util.response_quality.structured_output_failure_names"].contains(typeName(c)), chain.last()); // src: vvaharness/util/response_quality.py:241
        Throwable root = chain.last();
        String cause = typeName(link) + ": " + link;
        if (root != link && !str(link).contains(str(root))) cause += " <- " + typeName(root) + ": " + root; // src: vvaharness/util/response_quality.py:245
        String detail = Redact.redactCounts(cause).head(FAILURE_DETAIL_CHARS); // src: vvaharness/util/response_quality.py:248
        for (Throwable c : chain) {                                            // src: vvaharness/util/response_quality.py:252
            Object meta = getattr(getattr(c, "ai_message", null), "response_metadata", null);
            String finish = getattr(c, "finish", null) != null ? c.finish : (meta instanceof Map ? LlmModels.replyFinish(meta) : null); // src: vvaharness/util/response_quality.py:254
            if (finish != null) return Pair.of(detail + "; finish=" + Redact.redactCounts(finish).head(FINISH_MARKER_CHARS), LlmModels.finishTruncated(finish)); // src: vvaharness/util/response_quality.py:258
        }
        return Pair.of(detail, false);
    }

    Dispatch resendingRefusalOnce(Dispatch dispatch, String label, String stage, Supplier<Boolean> allowed) {
        int left = 1;                                                          // ONE identical resend across all sends (callers enable it from refusal_retries) // src: vvaharness/util/response_quality.py:265
        return dropThinking -> {
            ModelRefusal refused;
            try { return dispatch.call(dropThinking); }                        // src: vvaharness/util/response_quality.py:270
            catch (ModelRefusal exc) {
                if (left <= 0 || (allowed != null && !allowed.get())) throw exc; // read at refusal time // src: vvaharness/util/response_quality.py:273
                left -= 1; refused = exc;
            }
            Counters.bump(REFUSAL_RETRY_ATTEMPTED_COUNTER, 1);                 // src: vvaharness/util/response_quality.py:277
            Logs.getLogger("response_quality").warning(Events.MODEL_REFUSAL_RESEND, stage, label); // src: vvaharness/util/response_quality.py:279
            Errlog.log(stage, label, refused, true, Map.of("reason", "refusal_retry_attempted")); // src: vvaharness/util/response_quality.py:283
            String raw = dispatch.call(dropThinking);                          // a second refusal propagates unchained // src: vvaharness/util/response_quality.py:286
            Counters.bump(REFUSAL_RETRY_RECOVERED_COUNTER, 1);                 // src: vvaharness/util/response_quality.py:287
            return raw;
        };
    }

    String dispatchOrRetryUnforced(Dispatch dispatch, String label, String stage, Supplier<Boolean> mayRetry, String effort, boolean resendRefusal, Supplier<Boolean> mayResendRefusal, Theta θ) {
        if (resendRefusal) dispatch = resendingRefusalOnce(dispatch, label, stage, mayResendRefusal); // src: vvaharness/util/response_quality.py:307
        boolean clipped; String detail; boolean cutOff;
        try {
            return dispatch.call(false);                                       // first send, effort tier kept // src: vvaharness/util/response_quality.py:311
        } catch (Exception exc) {
            clipped = effort != null && isTruncatedWithoutRetry(exc);          // at-cap clip the route could not double // src: vvaharness/util/response_quality.py:313
            if (!(clipped || isStructuredOutputFailure(exc, θ))) throw exc;    // transport errors propagate // src: vvaharness/util/response_quality.py:314
            if (mayRetry != null && !mayRetry.get()) throw exc;                // caller veto (e.g. deadline) // src: vvaharness/util/response_quality.py:316
            Pair<String, Boolean> d = structuredFailureDetail(exc, θ);         // src: vvaharness/util/response_quality.py:319
            detail = d.first; cutOff = d.second;
        }
        String kind = clipped ? "truncated" : "structured";                    // src: vvaharness/util/response_quality.py:320
        Counters.bump(stage + "_" + kind + "_retry_attempted", 1);             // src: vvaharness/util/response_quality.py:322
        if (cutOff) Counters.bump("llm_structured_retry_truncated", 1);        // rejected final hit its budget // src: vvaharness/util/response_quality.py:323
        Logs.getLogger("response_quality").warning(clipped ? Events.REPLY_CLIPPED_RETRY : Events.STRUCTURED_REPLY_REJECTED_RETRY, stage, label, detail); // src: vvaharness/util/response_quality.py:327
        String raw = dispatch.call(true);                                      // ONE resend with the effort tier dropped // src: vvaharness/util/response_quality.py:330
        Counters.bump(stage + "_" + kind + "_retry_recovered", 1);             // src: vvaharness/util/response_quality.py:331
        return raw;
    }

    boolean isTimeoutFailure(Throwable exc, Theta θ) {
        Set<Integer> seen = Set.of();
        Throwable cur = exc;
        while (cur != null && !seen.contains(id(cur))) {                       // types only, never message text // src: vvaharness/util/response_quality.py:354
            seen.add(id(cur));
            if (cur instanceof GuardrailBlocked) return false;                 // src: vvaharness/util/response_quality.py:357
            if (cur instanceof TimeoutError || θ["code.util.response_quality.timeout_failure_names"].contains(typeName(cur))) return true; // src: vvaharness/util/response_quality.py:359
            cur = cur.cause != null ? cur.cause : cur.context;
        }
        return false;
    }

    boolean isConnectionFailure(Throwable exc, Theta θ) {
        if (isTimeoutFailure(exc, θ)) return false;                            // src: vvaharness/util/response_quality.py:374
        Set<Integer> seen = Set.of();
        Throwable cur = exc; boolean connection = false;
        while (cur != null && !seen.contains(id(cur))) {                       // src: vvaharness/util/response_quality.py:379
            seen.add(id(cur));
            if (getattr(cur, "status_code", null) instanceof Integer) return false; // an HTTP status is not a dropped connection // src: vvaharness/util/response_quality.py:381
            if (mroNames(cur).intersects(θ["code.util.response_quality.connection_failure_names"])) connection = true; // src: vvaharness/util/response_quality.py:383
            cur = cur.cause != null ? cur.cause : cur.context;
        }
        return connection;
    }

    boolean isDeterministicFailure(Throwable exc, Theta θ) {
        // fails the same way on every retry: no point retrying
        return Exceptions.exceptionChain(exc).any(err -> θ["code.util.response_quality.deterministic_failure_types"].contains(typeName(err))); // src: vvaharness/util/response_quality.py:396
    }
}

@executedBy(CODE) @role(types)
class StructuredOutputRejected extends Exception {
    String finish;                                                             // rejected final's end marker (stop_reason) // src: vvaharness/util/response_quality.py:199
}
