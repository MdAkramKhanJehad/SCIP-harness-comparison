# vvaharness/remediation_agent/remediate.py

Entry point of the standalone `vvaharness remediate` command. It finds the newest scan report under `<repo>/security-scan/`, loads and narrows the findings, prunes stale remediation checkpoint rows, then hands the findings either to the interactive picker or to the sequential per-finding loop. The in-scan path (Stage 10) skips this file and calls `runner.process_targets` directly from `orchestrator/scan.py` `_run_remediation`.

Source: `vvaharness/remediation_agent/remediate.py` (lines 1-102)
Executor: code (the loop it calls contains the model calls)
Called from: `vvaharness/cli/_commands.py` (the `remediate` subcommand)

// src: vvaharness/remediation_agent/remediate.py:38-101
fn remediate(repo?, args?, cfg?):executor=code {
  require repo => { console "usage: vvaharness remediate --repo <path>"; return 2 }
  require cfg != null => { console fail "no config loaded — internal error: remediate() requires cfg."; return 2 }

  // src: remediate.py:47-51
  try opts = options.parse_options(args or []);   // see options.sudo; a bad --mode or --top raises ValueError
  catch ValueError => { console fail error; return 2 }

  // src: remediate.py:53-60
  require repo path exists => { console fail "no such path: $repo"; return 1 }
  [report, rc] = discovery.locate_report(repo_path)   // newest *_report.md under <repo>/security-scan
  if (report == null) return rc

  // src: remediate.py:62-66 — interactive mode is a manual picker: the profile cap must not pre-truncate the list
  top = if (opts.interactive && opts.top == null) null else select.resolve_top(opts.top, cfg)

  // src: remediate.py:67-74
  try found = discovery.load_findings(repo_path, report, top);
  catch InvalidFindingsJSON => { console fail error; return 1 }   // a corrupt findings.json is an error; no Markdown fallback
  findings = found.selected

  // src: remediate.py:76-79
  if (length(findings) == 0) { console ok "identified 0 SAST issue(s) — nothing to remediate."; return 0 }

  // src: remediate.py:81-84
  layout = discovery.prepare_layout(repo_path)   // raises UnsafeArtifactDir on a symlinked security-remediation folder (uncaught)
  // Rows for every DISCOVERED finding are kept, not only the --top N subset, so unselected findings still resume later
  checkpoints.prune_stale_steps(layout.run_id, REMEDIATE_PREFIX, found.discovered |> map(t => runner.step_key_of(t, cfg)))   // external: orchestrator/checkpoints.py; at most once per (run_id, prefix) per process

  // abstracted: remediate.py:85-90 — console banner (count, model banner, mode, artifact folder, verbose note); no decisions

  // src: remediate.py:92-97
  if (opts.interactive) {
    return interactive.loop.run_interactive(findings, report_path=report, rem_dir=layout.rem_dir, ckpt_dir=layout.ckpt_dir, run_id=layout.run_id, cfg, mode=opts.mode, verbose=opts.verbose)
    // opts.resume is not passed: the interactive path never skips a cached finding
  }

  // src: remediate.py:99-101
  return runner.process_targets(findings, layout, cfg, repo_path, opts, report=report)
  // preserved: the comment at remediate.py:99 says the report's own ordinals are kept; the list itself is reordered by CVSS score whenever a top cap is in effect, even one that removes nothing (see select/pq.sudo)
}
