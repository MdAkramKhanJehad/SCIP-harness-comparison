// file: vvaharness/remediation_agent/plugin_runner/handoff.py
// FixerDispatchGuard: executor-side middleware on the orchestrator's "task" tool. It validates every fixer dispatch
// (subagent type, 4 ordered non-empty sections, primary file named), appends the authoritative finding context,
// and bounds attempts: one retry only after a transient tool error, one corrected re-dispatch after a malformed spec.

@executedBy(CODE) @role(agent) @stage("S10")
class Handoff {
    String findingContext;
    String primaryFile = "";
    int attempts = 0;
    boolean retryAllowed = false;
    boolean terminal = false;
    int malformedRejections = 0;

    Handoff init(String findingContext, String primaryFile) {
        this.findingContext = findingContext;                                                       // src: vvaharness/remediation_agent/plugin_runner/handoff.py:48
        this.primaryFile = primaryFile;                                                             // src: vvaharness/remediation_agent/plugin_runner/handoff.py:49
        return this;
    }

    ToolMessage refusal(ToolCallRequest request, String detail) {
        Log.warning("FIXER_DISPATCH_REFUSED", detail);                                              // src: vvaharness/remediation_agent/plugin_runner/handoff.py:56
        return new ToolMessage("Fixer dispatch was not executed: " + detail, "task", request.toolCall.id, "error"); // src: vvaharness/remediation_agent/plugin_runner/handoff.py:57
    }

    Object prepare(ToolCallRequest request, Theta θ) {
        Map call = request.toolCall;
        if (!call.get("name").equals("task")) return request;                                       // src: vvaharness/remediation_agent/plugin_runner/handoff.py:66
        Object args = call.get("args");
        if (!(args instanceof Map)) {                                                               // src: vvaharness/remediation_agent/plugin_runner/handoff.py:69
            terminal = true;
            return refusal(request, "task arguments were not an object; return Not Fixed");         // src: vvaharness/remediation_agent/plugin_runner/handoff.py:71
        }
        if (!args.get("subagent_type").equals(θ["p.remediation_prompts.orch_dispatch_subagent_type"])) { // src: vvaharness/remediation_agent/plugin_runner/handoff.py:72  (only "fixer")
            terminal = true;
            return refusal(request, "S10 permits only subagent_type fixer");                        // src: vvaharness/remediation_agent/plugin_runner/handoff.py:74
        }
        if (terminal) return refusal(request, "the fixer already returned a completed result; do not retry"); // src: vvaharness/remediation_agent/plugin_runner/handoff.py:75
        if (attempts > 0 && !retryAllowed) return refusal(request, "a retry is allowed only after an explicit transient tool error"); // src: vvaharness/remediation_agent/plugin_runner/handoff.py:78
        String description = args.get("description");                                               // src: vvaharness/remediation_agent/plugin_runner/handoff.py:82
        String problem = invalidSpec(description, primaryFile, θ);                                  // src: vvaharness/remediation_agent/plugin_runner/handoff.py:83
        if (!problem.isEmpty()) {                                                                   // src: vvaharness/remediation_agent/plugin_runner/handoff.py:84
            // A malformed dispatch is not a verdict: one corrected re-dispatch is allowed.
            malformedRejections = malformedRejections + 1;                                          // src: vvaharness/remediation_agent/plugin_runner/handoff.py:86
            if (malformedRejections >= θ["code.remediation_agent.plugin_runner.handoff.max_malformed_dispatches"]) { // src: vvaharness/remediation_agent/plugin_runner/handoff.py:87
                terminal = true;
                return refusal(request, "incomplete edit specification; no further attempts permitted; return Not Fixed"); // src: vvaharness/remediation_agent/plugin_runner/handoff.py:89
            }
            return refusal(request, "incomplete edit specification; one corrected re-dispatch is permitted"); // src: vvaharness/remediation_agent/plugin_runner/handoff.py:93
        }
        attempts = attempts + 1;                                                                    // src: vvaharness/remediation_agent/plugin_runner/handoff.py:99
        retryAllowed = false;                                                                       // src: vvaharness/remediation_agent/plugin_runner/handoff.py:100
        // The fixer has no conversation: the harness appends the authoritative SAST finding context to its spec.
        String enriched = description.rstrip();
        if (θ["code.remediation_agent.plugin_runner.handoff.append_finding_context"]) enriched = enriched + "\n\n=== AUTHORITATIVE SAST FINDING CONTEXT ===\n" + findingContext.strip() + "\n=== END AUTHORITATIVE CONTEXT ==="; // src: vvaharness/remediation_agent/plugin_runner/handoff.py:101
        return request.override(call.with("args", args.with("description", enriched)));            // src: vvaharness/remediation_agent/plugin_runner/handoff.py:112
    }

    void observe(Object result, Theta θ) {
        ToolMessage message = resultMessage(result);                                                // src: vvaharness/remediation_agent/plugin_runner/handoff.py:115
        if (message == null) {                                                                      // src: vvaharness/remediation_agent/plugin_runner/handoff.py:116
            terminal = true;
            return;
        }
        if (message.status.equals("error")) {                                                       // src: vvaharness/remediation_agent/plugin_runner/handoff.py:119
            recordTransient(θ);
            return;
        }
        Fixer parsed = fixerResult(message.content);                                                // src: vvaharness/remediation_agent/plugin_runner/handoff.py:122
        if (parsed != null && parsed.status == TOOL_ERROR && parsed.retryable) {                    // src: vvaharness/remediation_agent/plugin_runner/handoff.py:123
            recordTransient(θ);
            return;
        }
        // applied / already_applied / not_applied / malformed / non-retryable: all terminal, no re-dispatch.
        terminal = true;                                                                            // src: vvaharness/remediation_agent/plugin_runner/handoff.py:127
    }

    void recordTransient(Theta θ) {
        if (attempts < θ["code.remediation_agent.plugin_runner.handoff.max_fixer_attempts"]) {      // src: vvaharness/remediation_agent/plugin_runner/handoff.py:136
            retryAllowed = true;                                                                    // src: vvaharness/remediation_agent/plugin_runner/handoff.py:137  (one retry permitted)
        } else {
            terminal = true;                                                                        // src: vvaharness/remediation_agent/plugin_runner/handoff.py:142  (retry exhausted: Not Fixed)
        }
    }

    Object wrapToolCall(ToolCallRequest request, Function handler, Theta θ) {
        if (!request.toolCall.get("name").equals("task")) return handler.apply(request);            // src: vvaharness/remediation_agent/plugin_runner/handoff.py:153  (other tools pass through)
        Object prepared = prepare(request, θ);                                                      // src: vvaharness/remediation_agent/plugin_runner/handoff.py:155
        if (prepared instanceof ToolMessage) return prepared;                                       // src: vvaharness/remediation_agent/plugin_runner/handoff.py:156  (refused)
        Object result;
        try {
            result = handler.apply(prepared);                                                       // src: vvaharness/remediation_agent/plugin_runner/handoff.py:159
        } catch (Exception exc) {
            recordTransient(θ);                                                                     // src: vvaharness/remediation_agent/plugin_runner/handoff.py:161
            return refusal(request, "transient fixer tool error; " + (retryAllowed ? "retry once" : "retry exhausted")); // src: vvaharness/remediation_agent/plugin_runner/handoff.py:162
        }
        observe(result, θ);                                                                         // src: vvaharness/remediation_agent/plugin_runner/handoff.py:168
        return result;
    }

    Object awrapToolCall(ToolCallRequest request, Function handler, Theta θ) {
        // Async twin of wrapToolCall with identical logic.
        return wrapToolCall(request, handler, θ);                                                   // src: vvaharness/remediation_agent/plugin_runner/handoff.py:171
    }

    String invalidSpec(String description, String primaryFile, Theta θ) {
        if (description == null || description.strip().isEmpty()) return "missing description";    // src: vvaharness/remediation_agent/plugin_runner/handoff.py:198
        String folded = description.casefold();
        // VULNERABILITY CONTEXT:, TARGET FILES:, EDIT INSTRUCTIONS:, SUCCESS CRITERIA:
        List<String> sections = θ["p.remediation_prompts.orch_dispatch_template_sections"];         // src: vvaharness/remediation_agent/plugin_runner/handoff.py:35
        List<String> missing = sections.filter(s -> !folded.contains(s.casefold()));                // src: vvaharness/remediation_agent/plugin_runner/handoff.py:202
        if (!missing.isEmpty()) return "missing section(s): " + missing.join(", ");                 // src: vvaharness/remediation_agent/plugin_runner/handoff.py:205
        List<Integer> positions = sections.map(s -> folded.indexOf(s.casefold()));                  // src: vvaharness/remediation_agent/plugin_runner/handoff.py:206
        if (!positions.equals(positions.sorted())) return "required sections are out of order";     // src: vvaharness/remediation_agent/plugin_runner/handoff.py:207
        Map<String, String> bodies = new Map();
        for (int i = 0; i < sections.size(); i++) {                                                 // src: vvaharness/remediation_agent/plugin_runner/handoff.py:210
            int start = positions.get(i) + sections.get(i).length();
            int end = i + 1 < positions.size() ? positions.get(i + 1) : description.length();
            bodies.put(sections.get(i), description.substring(start, end).strip());                 // src: vvaharness/remediation_agent/plugin_runner/handoff.py:213
            if (bodies.get(sections.get(i)).isEmpty()) return "section is empty";                  // src: vvaharness/remediation_agent/plugin_runner/handoff.py:214
        }
        String targetFiles = bodies.get("TARGET FILES:").casefold();                                // src: vvaharness/remediation_agent/plugin_runner/handoff.py:216
        if (θ["code.remediation_agent.plugin_runner.handoff.require_primary_file_in_targets"] && !primaryFile.isEmpty() && !targetFiles.contains(primaryFile.casefold())) { // src: vvaharness/remediation_agent/plugin_runner/handoff.py:217
            return "TARGET FILES does not name " + primaryFile;                                     // src: vvaharness/remediation_agent/plugin_runner/handoff.py:218
        }
        for (String section : List.of("VULNERABILITY CONTEXT:", "EDIT INSTRUCTIONS:", "SUCCESS CRITERIA:")) { // src: vvaharness/remediation_agent/plugin_runner/handoff.py:219
            if (bodies.get(section).length() < θ["code.remediation_agent.plugin_runner.handoff.min_section_chars"]) return "section is not substantive"; // src: vvaharness/remediation_agent/plugin_runner/handoff.py:221
        }
        return "";                                                                                  // src: vvaharness/remediation_agent/plugin_runner/handoff.py:223
    }

    ToolMessage resultMessage(Object result) {
        if (result instanceof ToolMessage) return result;                                           // src: vvaharness/remediation_agent/plugin_runner/handoff.py:227
        Map update = result.update;                                                                 // src: vvaharness/remediation_agent/plugin_runner/handoff.py:229
        List messages = update instanceof Map ? update.getOr("messages", List.of()) : List.of();   // src: vvaharness/remediation_agent/plugin_runner/handoff.py:230
        return messages.reversed().firstOrNull(m -> m instanceof ToolMessage);                      // src: vvaharness/remediation_agent/plugin_runner/handoff.py:232
    }

    Fixer fixerResult(Object content) {
        if (!(content instanceof String)) return null;                                              // src: vvaharness/remediation_agent/plugin_runner/handoff.py:237
        try {
            return Pydantic.validate(Fixer, Json.parse(content));                                   // src: vvaharness/remediation_agent/plugin_runner/handoff.py:240
        } catch (ValueError | TypeError e) {
            return null;                                                                            // src: vvaharness/remediation_agent/plugin_runner/handoff.py:242  (invalid result: terminal)
        }
    }
}
