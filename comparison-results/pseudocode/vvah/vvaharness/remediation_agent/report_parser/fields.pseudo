// file: vvaharness/remediation_agent/report_parser/fields.py
// Rich per-finding field extraction from the Markdown block, and promotion to the typed scan Finding.

@executedBy(CODE) @role(step) @stage("S10")
class Fields {

    // The only two verdict labels the scan contract admits.
    Set<String> VERDICT_LABELS = θ["code.remediation_agent.report_parser.fields.verdict_labels"];     // src: vvaharness/remediation_agent/report_parser/fields.py:39

    // Promote a markdown-parsed finding onto the typed scan contract; the only markdown-to-typed step left.
    Finding toScanFinding(ReportParserFinding finding, Theta θ) {
        Map f = parseFindingFields(finding);                                                         // src: vvaharness/remediation_agent/report_parser/fields.py:42
        VulnClass vulnClass = Enum.parse(VulnClass, f.get("vuln_class"));                                     // an unknown class string raises ValueError here, uncaught // src: vvaharness/remediation_agent/report_parser/fields.py:51
        return new Finding(f.get("title"), f.get("file"), f.get("line_start"), f.get("line_end"), vulnClass,
            vulnClass == VulnClass.OTHER ? f.get("vuln_class") : "",                                 // label kept only for OTHER // src: vvaharness/remediation_agent/report_parser/fields.py:60
            severity(finding.severity, θ), f.get("cwe"), f.get("description"), f.get("recommendation"), f.get("code_snippet"),
            f.get("impact"), f.get("exploit_scenario"), f.get("preconditions"), f.get("source_ref"), f.get("sink_ref"),
            verdictLabel(f.get("verdict"), θ), f.get("verdict_confidence"), f.get("verdict_reason"),
            f.get("cvss_vector"), f.get("cvss_score"), f.get("cvss_rating"));                       // src: vvaharness/remediation_agent/report_parser/fields.py:69
    }

    // Fold the report's severity band, defaulting to MEDIUM on a label we do not know.
    Severity severity(String label, Theta θ) {
        try {
            return Enum.parse(Severity, label != null && !label.isEmpty() ? label : θ["code.remediation_agent.report_parser.fields.default_severity"]); // src: vvaharness/remediation_agent/report_parser/fields.py:72
        } catch (ValueError e) {
            return Severity.MEDIUM;                                                                  // src: vvaharness/remediation_agent/report_parser/fields.py:77
        }
    }

    // Keep the verifier verdict only when it is one the contract admits; otherwise null.
    String verdictLabel(String value, Theta θ) {
        return θ["code.remediation_agent.report_parser.fields.verdict_labels"].contains(value) ? value : null; // src: vvaharness/remediation_agent/report_parser/fields.py:80
    }

    // Extract the verbatim Finding fields from a finding's markdown body into a map, degrading missing fields to safe empty defaults.
    Map parseFindingFields(ReportParserFinding finding) {
        String body = finding.body != null ? finding.body : "";                                      // src: vvaharness/remediation_agent/report_parser/fields.py:85
        Map<String, String> secs = FieldSections.sections(body);                                     // src: vvaharness/remediation_agent/report_parser/fields.py:89
        String head = secs.getOrDefault("", "");                                                     // text before the first #### heading // src: vvaharness/remediation_agent/report_parser/fields.py:92
        String vulnClass = ""; String cwe = null;                                                    // src: vvaharness/remediation_agent/report_parser/fields.py:95
        String fileRef = finding.file != null ? finding.file : "";                                   // src: vvaharness/remediation_agent/report_parser/fields.py:99
        Tuple loc = !fileRef.isEmpty() ? FieldSections.fileLoc(fileRef) : Tuple.of("", 0, 0);        // src: vvaharness/remediation_agent/report_parser/fields.py:103
        String cvssVector = null; String cvssRating = null; Double cvssScore = null;                 // src: vvaharness/remediation_agent/report_parser/fields.py:106
        String sourceRef = null; String sinkRef = null;                                              // src: vvaharness/remediation_agent/report_parser/fields.py:109
        for (String raw : head.splitlines()) {                                                       // src: vvaharness/remediation_agent/report_parser/fields.py:113
            String line = raw.strip();
            Match m;
            if ((m = FieldSections.CLASS_RE.match(line)) != null) vulnClass = m.group(1).strip();    // first matching pattern wins per line; later lines overwrite earlier values // src: vvaharness/remediation_agent/report_parser/fields.py:117
            else if ((m = FieldSections.CWE_RE.match(line)) != null) cwe = m.group(1).strip();       // src: vvaharness/remediation_agent/report_parser/fields.py:120
            else if ((m = FieldSections.CVSS_SCORE_RE.match(line)) != null) { cvssScore = Double.parseDouble(m.group(1)); cvssRating = m.group(2).strip(); cvssVector = m.group(3).strip(); } // src: vvaharness/remediation_agent/report_parser/fields.py:123
            else if ((m = FieldSections.CVSS_VECONLY_RE.match(line)) != null) cvssVector = m.group(1).strip(); // src: vvaharness/remediation_agent/report_parser/fields.py:127
            else if ((m = FieldSections.SOURCE_RE.match(line)) != null) sourceRef = m.group(1).strip(); // src: vvaharness/remediation_agent/report_parser/fields.py:131
            else if ((m = FieldSections.SINK_RE.match(line)) != null) sinkRef = m.group(1).strip();  // src: vvaharness/remediation_agent/report_parser/fields.py:134
        }
        // The Class line may itself carry the CWE (e.g. CWE-89: SQL Injection) when no dedicated CWE line was rendered.
        if (cwe == null && !vulnClass.isEmpty()) {                                                   // src: vvaharness/remediation_agent/report_parser/fields.py:137
            Match cm = Regex.match("(CWE-\\d+)", vulnClass);                                         // src: vvaharness/remediation_agent/report_parser/fields.py:141
            if (cm != null) cwe = cm.group(1);                                                       // src: vvaharness/remediation_agent/report_parser/fields.py:145
        }
        Tuple v = verification(secs.getOrDefault("adversarial verification", ""));                   // src: vvaharness/remediation_agent/report_parser/fields.py:148
        List<String> preconds = secs.getOrDefault("preconditions", "").splitlines()
            .filter(ln -> !ln.strip().isEmpty() && (ln.strip().startsWith("-") || ln.strip().startsWith("*")))
            .map(ln -> Regex.sub("^[-*]\\s+", "", ln).strip());                                      // only bullet lines kept // src: vvaharness/remediation_agent/report_parser/fields.py:151
        return Map.of("_source", "vvaharness s8 (verbatim Finding fields)", "title", finding.title, "vuln_class", vulnClass, "cwe", cwe,
            "file", loc.file, "line_start", loc.start, "line_end", loc.end, "source_ref", sourceRef, "sink_ref", sinkRef,
            "description", secs.getOrDefault("description", ""), "recommendation", secs.getOrDefault("how to fix", ""),
            "code_snippet", FieldSections.firstCodeBlock(body), "impact", secs.getOrDefault("impact", ""),
            "exploit_scenario", secs.getOrDefault("exploit scenario", ""), "preconditions", preconds,
            "verdict", v.verdict, "verdict_confidence", v.confidence, "verdict_reason", v.reason,
            "cvss_vector", cvssVector, "cvss_score", cvssScore, "cvss_rating", cvssRating);          // code snippet is taken from the whole body, not a section // src: vvaharness/remediation_agent/report_parser/fields.py:155
    }

    // Split the adversarial-verification block into (verdict, confidence, reason); the first matching line wins.
    Tuple verification(String section) {
        for (String line : section.splitlines()) {                                                   // src: vvaharness/remediation_agent/report_parser/fields.py:158
            Match vm = FieldSections.VERDICT_RE.match(line.strip());                                 // src: vvaharness/remediation_agent/report_parser/fields.py:160
            if (vm != null) {
                Integer conf = vm.group(2) != null ? Integer.parseInt(vm.group(2)) : null;           // null when "not scored" // src: vvaharness/remediation_agent/report_parser/fields.py:162
                return Tuple.of(vm.group(1).strip(), conf, vm.group(3).strip());                     // src: vvaharness/remediation_agent/report_parser/fields.py:163
            }
        }
        return Tuple.of(null, null, "");                                                             // src: vvaharness/remediation_agent/report_parser/fields.py:165
    }
}
