# vvaharness/skills/templates/probe.sh

Template and view-layer sink battery: one read-only pass that prints `path:line` for every unescaped-output marker, dangerous interpolation context, information-disclosure expression and form without a CSRF token field, across every template dialect, plus the host-code configuration, sanitizers and render call sites the judgement needs.

Source: `vvaharness/skills/templates/probe.sh` (lines 1-269)
Executor: code (POSIX shell with grep and awk; read-only; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/templates/probe.sh [root]`, because the lens SKILL.md ("First move") or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 6-18 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/templates/probe.sh:20-269
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/templates/probe.sh:20-47 — setup
  shell globbing off (set -f), so the --include words reach grep literally
  SKIP = exclude directories .git, .hg, .svn, node_modules, bower_components, .venv, venv, env, site-packages, __pycache__, .tox, .mypy_cache, dist, build, target, out, vendor, .next, .nuxt, coverage, .vvaharness; exclude files SKILL.md, probe.sh
  TPL = *.html *.htm *.xhtml *.shtml *.jinja *.jinja2 *.j2 *.twig *.liquid *.erb *.haml *.slim *.rhtml *.ejs *.eta *.hbs *.handlebars *.mustache *.njk *.nunjucks *.pug *.jade *.marko *.jsp *.jspx *.jspf *.tag *.ftl *.vm *.cshtml *.vbhtml *.razor *.aspx *.ascx *.master *.blade.php *.phtml *.vue *.svelte *.astro *.tmpl *.tpl *.gohtml *.mako *.mak
  SRC = *.py *.js *.jsx *.mjs *.cjs *.ts *.tsx *.rb *.go *.java *.kt *.cs *.vb *.php *.pl *.ex *.exs *.config *.xml *.json *.yaml *.yml *.cfg *.ini *.toml

  // src: vvaharness/skills/templates/probe.sh:49-96 — helpers
  sec(label) { print a blank line and "== <label> ==" }
  norm() { collapse runs of spaces and tabs to one space; cut each line to 170 characters }
  dedup() { sort by file then numeric line, dropping duplicate lines }   // sort -t: -k1,1 -k2,2n -u
  emit(cap) {
    data = first 3000 lines of input
    if (data empty) print "(none)"
    else { print the first cap lines; if (total > cap) print "... <total> matches, showing first <cap>" }
  }
  TPL_FILES = names of non-empty template files under ROOT (grep -rlE '^' with SKIP and TPL), first 5000   // walked once, reused by three sections
  tgrep(pattern, flag?) { grep -rEn [flag] SKIP TPL over ROOT }   // flag "-i" makes it case-insensitive
  sgrep(pattern, flag?) { grep -rEn [flag] SKIP SRC over ROOT }

  print "== TEMPLATE/VIEW PROBE: root=<ROOT> =="

  // Each section below: label, the greps it combines, and its emit cap (the number of lines shown).
  // src: vvaharness/skills/templates/probe.sh:100-103
  sec("TEMPLATE INVENTORY (non-empty files, by extension)")
  count TPL_FILES by final extension, plus "TOTAL template files"; sorted by count descending; emit(45)

  // src: vvaharness/skills/templates/probe.sh:105-108
  sec("LAYOUTS / PARTIALS / FRAGMENTS — READ THESE BEFORE ANY LEAF PAGE")
  TPL_FILES filtered case-insensitively by
  // pattern, verbatim: '(^|/)(_?base|_?layout|_?master|_?application|_?default|_?main|_?shell|_?wrapper|_?head|_?nav|_?footer|_?header)[^/]*$|/(partials?|fragments?|includes?|shared|components|macros)/'
  norm; emit(40)

  // src: vvaharness/skills/templates/probe.sh:110-115
  sec("AUTOESCAPE OFF / UNSAFE ENGINE CONFIG -- a bare jinja2.Environment() defaults to autoescape OFF, and select_autoescape(enabled_extensions=('html',)) leaves .txt/.jinja unescaped")
  union of, then dedup; norm; emit(45):
    tgrep('autoescape[^>%}]{0,12}(false|off)', "-i")
    sgrep('autoescape[[:space:]]*[=:][[:space:]]*(false|0|None)|jinja2?\.Environment\(|Environment\(loader|select_autoescape|nunjucks\.configure|Handlebars\.compile|new[[:space:]]+Twig|escape[[:space:]]*[=:][[:space:]]*false|escapeXml[^>]{0,12}false|escapeHtml[^>]{0,12}false|ValidateRequest[^>]{0,12}false', "-i")
    tgrep('escapeXml[^>]{0,12}false|escapeHtml[^>]{0,12}false|ValidateRequest[^>]{0,12}false', "-i")

  // src: vvaharness/skills/templates/probe.sh:117-119
  sec("UNESCAPED OUTPUT MARKERS IN TEMPLATES (safe/raw/triple-stash/utext)")
  // pattern, verbatim: tgrep '\|[[:space:]]*(safe|raw|n)[[:space:]]*[}%|]|\{\{\{|\{\{&|<%-|<%==|<%=[[:space:]]*raw|\.html_safe|th:utext|\[\(\$\{|\[\[\$\{|@Html\.Raw|Html\.Raw\(|MvcHtmlString|HtmlString|\{@html|v-html|dangerouslySetInnerHTML|\[innerHTML\]|innerHTML[[:space:]]*=|outerHTML[[:space:]]*=|insertAdjacentHTML|document\.write|Handlebars\.SafeString|mark_safe|SafeString|Markup\(|\{!![[:space:]]|\{%[[:space:]]*filter[[:space:]]+safe'
  norm; emit(70)

  // src: vvaharness/skills/templates/probe.sh:121-123
  sec("UNESCAPED OUTPUT MARKERS IN HOST CODE (mark_safe / Markup / SafeString / Trust bypass)")
  // pattern, verbatim: sgrep 'mark_safe|SafeString|markupsafe|Markup\(|format_html\(|\.html_safe|Handlebars\.SafeString|bypassSecurityTrust(Html|Url|Script|Style|ResourceUrl)|dangerouslySetInnerHTML|innerHTML[[:space:]]*=|insertAdjacentHTML|document\.write\(|template\.(HTML|JS|URL|HTMLAttr|CSS)\(|Html\.Raw|new[[:space:]]+HtmlString'
  norm; emit(60)

  // src: vvaharness/skills/templates/probe.sh:125-129
  sec("MACRO KWARGS THAT MARK A COLUMN SAFE -- the {{value|safe}} sink sits in a vendored package template, not in this repo, so grepping |safe here never finds it")
  union of sgrep('safe_columns|render_table\(|render_field\(|\|safe') and tgrep('safe_columns|render_table\(|bootstrap[0-9]?/table'); dedup; norm; emit(30)

  // src: vvaharness/skills/templates/probe.sh:131-133
  sec("SSTI — TEMPLATE SOURCE BUILT AT RUNTIME (CWE-1336, a separate finding from XSS)")
  // pattern, verbatim: sgrep 'render_template_string|Template\([^)]*(\+|%|format|f["]|request|input|param)|from_string\(|env\.from_string|Twig.*createTemplate|new[[:space:]]+Template\(|template\.New\([^)]*Parse|eval_template'
  norm; emit(30)

  // src: vvaharness/skills/templates/probe.sh:135-137
  sec("URL-CONTEXT INTERPOLATION (needs a scheme allow-list; HTML-escaping does nothing here)")
  // pattern, verbatim: tgrep '(href|src|srcset|action|formaction|poster|cite|data|background|xlink:href|ng-href|:href|:src|th:href|th:src|location(\.href)?|window\.open)[[:space:]]*=[[:space:]]*[^>]{0,60}(\{\{|\{%|<%|\$\{|#\{|\[\[\$|\[\(\$)'
  norm; emit(60)

  // src: vvaharness/skills/templates/probe.sh:139-141
  sec("EVENT-HANDLER-CONTEXT INTERPOLATION (attribute body is JS; HTML entities decode first)")
  // pattern, verbatim: tgrep '(on[a-z]{3,20}|th:on[a-z]+|v-on:[a-z]+|@(click|input|change|submit|error|load))[[:space:]]*=[[:space:]]*[^>]{0,60}(\{\{|\{%|<%|\$\{|#\{|\[\[\$|\[\(\$)'
  norm; emit(45)

  // src: vvaharness/skills/templates/probe.sh:143-163
  sec("SCRIPT-CONTEXT INTERPOLATION (inside <script>; needs tojson / json_script / template.JS)")
  for each file in TPL_FILES {
    // awk, per line, lower-cased; a running <script> depth (opens minus closes, floored at 0, reset per file)
    if (line has an interpolation marker '(\{\{|\{%[[:space:]]*(if|for|print)|<%[=-]|\$\{|#\{|\[\[\$|\[\(\$)' && (inside a script block || the line opens <script)) {
      tag = if (line matches 'tojson|json_script|json\.stringify|escapejs|template\.js|jsonify|jsonencode|\|[[:space:]]*e[[:space:]]*[}|]') "ENCODED?" else "RAW"
      print "<file>:<line>: [<tag>] <first 150 characters, whitespace collapsed>"
    }
  }
  emit(45)

  // src: vvaharness/skills/templates/probe.sh:165-170
  sec("UNQUOTED-ATTRIBUTE / CSS-CONTEXT INTERPOLATION (a space starts a new attribute)")
  union of tgrep('[a-zA-Z_:-]+=(\{\{|\{%|<%|\$\{|#\{)'), tgrep('style[[:space:]]*=[[:space:]]*[^>]{0,60}(\{\{|<%|\$\{|#\{)'), tgrep('<style[^>]*>.*(\{\{|<%|\$\{|#\{)'); dedup; norm; emit(40)

  // src: vvaharness/skills/templates/probe.sh:172-173
  sec("GO TEXT/TEMPLATE (does no escaping at all) AND TYPE-CAST RE-OPENS")
  sgrep('text/template|html/template|template\.(HTML|JS|URL|HTMLAttr|CSS|Srcset)\('); norm; emit(25)

  // src: vvaharness/skills/templates/probe.sh:175-220 — per-form CSRF verdict
  sec("FORMS: CSRF TOKEN FIELD PRESENT INSIDE EACH FORM?")
  FORMS = for each template file containing '<[Ff][Oo][Rr][Mm]' {
    // awk: lower-cases each line and deletes both quote characters, then collects the text from "<form" to "</form" (across lines; a form still open at end of file is flushed)
    for each <form>...</form> span {
      verb = if (span matches 'method[ ]*=[ ]*(post|put|delete|patch)') "STATE-CHANGING" else "GET/UNSPECIFIED"
      tok = if (span matches 'csrf|xsrf|authenticity_token|antiforgerytoken|hidden_tag|_token|requestverificationtoken') "token-present" else "NO-TOKEN"
      act = the first "action = ..." text in the span, or "?"
      print "<file>:<line of <form>>: <verb> <tok> (<act>)"
    }
  } sorted by file and line, first 2000
  print "-- verdict counts over every form found --"; count FORMS by "<verb> <tok>"; emit(10)
  print "-- forms with NO token field inside the <form>...</form> span --"; FORMS lines containing NO-TOKEN; emit(60)
  // preserved: a form whose method is not post/put/delete/patch is still listed under "NO token field" when it lacks a token; the verb is printed beside it and the model is left to judge.

  // src: vvaharness/skills/templates/probe.sh:222-226
  sec("FORM HELPERS THAT EMIT A TOKEN THEMSELVES (Rails form_with, hidden_tag, form_tag)")
  union of tgrep('form_with|form_for|form_tag|hidden_tag|csrf_meta_tags|@Html\.BeginForm|\{%[[:space:]]*csrf_token') and sgrep('form_with|form_for|form_tag|hidden_tag'); dedup; norm; emit(25)

  // src: vvaharness/skills/templates/probe.sh:228-233
  sec("CSRF MACHINERY PRESENT REPO-WIDE (zero hits ⇒ EVERY state-changing form is CWE-352)")
  // pattern, verbatim (over TPL and SRC files): 'CSRFProtect|WTF_CSRF|csrf_token|csrfmiddlewaretoken|CsrfViewMiddleware|authenticity_token|protect_from_forgery|AntiForgeryToken|ValidateAntiForgeryToken|csurf|X-CSRF-Token|X-XSRF-TOKEN|csrf-token|_csrf|CsrfTokenRepository|SameSite'
  dedup; norm; emit(35)
  print "-- form base classes (wtforms.Form has no token; flask_wtf.FlaskForm does) --"
  // pattern, verbatim: sgrep 'class[[:space:]]+[A-Za-z_]+\((wtforms\.)?(Form|FlaskForm|ModelForm|forms\.Form)\)|from[[:space:]]+flask_wtf|import[[:space:]]+FlaskForm|Flask-WTF|flask-wtf'
  norm; emit(25)

  // src: vvaharness/skills/templates/probe.sh:235-237
  sec("INFO DISCLOSURE: EXCEPTION / DEBUG OBJECTS RENDERED (CWE-209)")
  // pattern, verbatim (case-insensitive): tgrep '(\{\{|\{%|<%[=-]|\$\{|#\{)[^}%]{0,40}\b(error|errors|exception|exc|traceback|stack|stacktrace|stack_trace|detailed_message|debug_info|sql|query|e\.message|err\.message)\b|@Model\.Exception|Server\.GetLastError|<%=[[:space:]]*e\.' -i
  norm; emit(40)

  // src: vvaharness/skills/templates/probe.sh:239-245
  sec("INFO DISCLOSURE: CONFIG / SECRETS / HIDDEN FIELDS SHIPPED TO THE CLIENT (CWE-200/540)")
  union of, then dedup; norm; emit(50):
    tgrep('(\{\{|\{%|<%[=-]|\$\{|#\{)[^}%]{0,40}\b(config|settings|environ|secret_key|secret|password|passwd|token|api_key|apikey|private_key|access_key|session|is_admin|is_staff|role|permissions|internal)\b', "-i")
    tgrep('<input[^>]*type[^>]{0,12}(hidden|password)[^>]*value[[:space:]]*=')
    tgrep('<!--[^>]{0,120}(\{\{|<%|\$\{|#\{|TODO|FIXME|password|secret|internal)', "-i")
    tgrep('data-[a-z-]+[[:space:]]*=[[:space:]]*[^>]{0,40}(user_id|userid|email|is_admin|role|token|secret)', "-i")

  // src: vvaharness/skills/templates/probe.sh:247-249
  sec("DEBUG MODE / STACKTRACE EXPOSURE IN CONFIG (turns any error page into CWE-209)")
  // pattern, verbatim: sgrep 'debug[[:space:]]*[=:][[:space:]]*(True|true|1)|FLASK_DEBUG|app\.run\([^)]*debug|DEBUG_PROPAGATE|traceback\.(format_exc|print_exc)|customErrors[^>]{0,20}Off|UseDeveloperExceptionPage|consider_all_requests_local|show_exceptions|ASPNETCORE_ENVIRONMENT[^ ]{0,20}Development|config\.consider'
  norm; emit(35)

  // src: vvaharness/skills/templates/probe.sh:251-255
  sec("SANITIZERS AND ENCODERS PRESENT (refutation candidates — name the one on the write path)")
  union of sgrep('bleach\.|nh3\.|DOMPurify|sanitize_html|sanitizeHtml|HtmlSanitizer|OWASP|Sanitizers\.|html\.escape|escape\(|cgi\.escape|htmlspecialchars|ERB::Util|CGI\.escapeHTML|\|tojson|json_script|escapejs|ValidationError|validators\.URL|urlparse|allowed_schemes') and tgrep('\|[[:space:]]*(e|escape|forceescape|tojson|urlencode|striptags)\b|json_script|escapejs|fn:escapeXml|<c:out'); dedup; norm; emit(40)

  // src: vvaharness/skills/templates/probe.sh:257-259
  sec("RENDER CALL SITES (template name -> route that supplies the kwargs)")
  // pattern, verbatim: sgrep 'render_template\(|render_template_string\(|render_to_string|render_to_response|res\.render\(|\.render\([^)]*(html|hbs|ejs|pug|jinja|twig|erb)|template\.Execute|ExecuteTemplate|c\.HTML\(|View\([^)]|return[[:space:]]+view\(|@Controller|@RenderPage'
  norm; emit(50)

  // src: vvaharness/skills/templates/probe.sh:261-265
  sec("CONTENT SECURITY POLICY (lowers severity; does not refute URL/attribute context)")
  union of sgrep('Content-Security-Policy|unsafe-inline|unsafe-eval|script-src|nonce|Talisman|helmet') and tgrep('Content-Security-Policy|http-equiv[^>]{0,20}Content-Security'); dedup; norm; emit(25)

  // src: vvaharness/skills/templates/probe.sh:267-269
  print "== END OF PROBE (sections printing (none) are themselves findings) =="
  exit 0
}
