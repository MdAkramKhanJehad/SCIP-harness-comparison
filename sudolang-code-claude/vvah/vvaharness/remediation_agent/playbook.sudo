# vvaharness/remediation_agent/playbook.py

Loads the remediation playbook (`inputs/remediation_playbook.yaml` by default) and resolves, for one finding, the fix strategy the model is told to follow. The strategy is rendered as an authoritative section of the per-finding user prompt. The playbook never allows or denies a finding; the policy gate alone does that (see `policy/decide.sudo`).

Source: `vvaharness/remediation_agent/playbook.py` (lines 1-145)
Executor: code
Called from: `policy/context.sudo` build_context (Playbook), `policy/decide.sudo` pre_decision (resolve), `plugin_runner/helpers.sudo` _build_user (as_prompt_block)

// src: vvaharness/remediation_agent/playbook.py:28-34
DEFAULT_PLAYBOOK_PATH = rule_paths.locate_rule("remediation_playbook.yaml", this file)   // resolved once at import
RULES_DIR = parent folder of DEFAULT_PLAYBOOK_PATH

// src: vvaharness/remediation_agent/playbook.py:37-48
Strategy {
  name; instruction; cwe
  cwe_title = ""
  confidence = "suggest"   // auto | suggest | guidance
  example_before = ""
  example_after = ""
  allowed_deps = []
  fix_location = "sink"   // sink | source | trust_boundary
  notes = ""
}

// src: vvaharness/remediation_agent/playbook.py:50-65
// prompt-src: vvaharness/remediation_agent/playbook.py:52-64
Strategy.as_prompt_block {
  // The rendered text becomes part of the user prompt (see prompts.sudo build_user); the system prompts tell the model to follow it exactly
  Template """
    ## Required fix strategy: $name
    CWE: $cwe${ if (cwe_title) " — $cwe_title" }
    Fix location: $fix_location

    ${ trimmed instruction, or "(no specific instruction)" }
    ${ if (example_after) "\nReference pattern (the shape your fix should take):\n```\n$example_after\n```" }

    Allowed new dependencies: ${ allowed_deps joined by ", ", or "(none)" }.
    Select THIS strategy; do not invent an alternative approach.
  """
  Constraints {
    "Select THIS strategy; do not invent an alternative approach."
  }
  // confidence, example_before and notes are NOT rendered into the prompt block; confidence appears only in the --verbose policy trace (plugin_runner/trace.sudo)
}

// src: vvaharness/remediation_agent/playbook.py:68-93
Playbook {
  State { _cwe = {}; _policy = {}; _loaded = false }

  // src: playbook.py:70-85
  fn _load(path?):executor=code {
    path = path or DEFAULT_PLAYBOOK_PATH
    try doc = yaml.safe_load(text of path) or {};
    catch error => { log error "playbook load failed — guidance-only for all findings"; return }   // every resolve() then returns null
    _cwe = doc.cwe or {}; _policy = doc.policy or {}; _loaded = true
  }

  // src: playbook.py:87-93
  max_diff_lines = integer(_policy.max_diff_lines, default 40)
  max_files_touched = integer(_policy.max_files_touched, default 2)
  // preserved: these two properties are never read anywhere in vvaharness (grep over the whole package, including validation); no diff-size or file-count cap is enforced on a remediation patch
}

// src: vvaharness/remediation_agent/playbook.py:96-133
fn Playbook.resolve(cwe?, language, frameworks):executor=code {
  // order: CWE -> language -> framework -> "default" -> CWE "fallback" -> null
  entry = _cwe[cwe or ""]
  if (!entry) return null   // a CWE with no playbook entry gets no strategy (the model then gets no strategy section)
  title = entry.title or ""; conf = entry.confidence or "suggest"; loc = entry.fix_location or "sink"; notes = entry.notes or ""
  strategies = entry.strategies or {}
  lang_block = strategies[language] or strategies["default"] or {}
  node = null
  if (lang_block is a mapping) {
    for each fw in frameworks { if (fw in lang_block) { node = lang_block[fw]; break } }   // set iteration order: with two matching frameworks the pick is not defined by the code
    if (node == null) node = lang_block["default"] or (if ("name" in lang_block) lang_block else null)
  }
  if (node == null) node = entry.fallback
  if (!node) return null
  return Strategy(
    name = node.name or "unnamed", instruction = trimmed node.instruction, cwe = cwe or "", cwe_title = title,
    confidence = node.confidence or conf,
    example_before = trimmed node.example_before, example_after = trimmed node.example_after,
    allowed_deps = node.allowed_deps or [], fix_location = loc, notes)
}

// src: vvaharness/remediation_agent/playbook.py:135-145
fn Playbook.guidance_for(cwe?):executor=code {
  entry = _cwe[cwe or ""] or {}
  body = entry.notes or entry.fallback.instruction or "No safe automated fix is defined for this vulnerability class. Review the source→sink trace and apply a context-appropriate mitigation manually."
  return "**${ entry.title or cwe or "this finding" }** — $body"
  // preserved: guidance_for is never called anywhere in vvaharness (grep); the denied path uses policy.decide.guidance_verdict, which carries only the deny reason, so playbook notes never reach a denied finding's output
}
