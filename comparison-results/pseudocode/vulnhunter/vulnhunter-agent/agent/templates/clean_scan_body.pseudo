// file: vulnhunter-agent/agent/templates/clean_scan_body.md
// Body of the closed "clean scan" receipt issue (no findings). Filled by IssuesRender.renderCleanScanBody;
// placeholders written as <NAME>. Read by humans, not by a model.

@executedBy(CODE) @role(io) @stage("issues")
class CleanScanBody {

    String run(Map<String, String> fields) {
        StringBuilder b = new StringBuilder();
        b.append(heading());
        b.append(scanDetails(fields));
        b.append(fields.get("REPORT_URL_LINE"));                                                  // src: vulnhunter-agent/agent/templates/clean_scan_body.md:22
        b.append(footer());
        return b.toString();
    }

    String heading() {
        // "## VulnHunter Scan Complete — No Findings" + "detected no exploitable vulnerabilities. No action is required."
        return "VulnHunter Scan Complete — No Findings";                                          // src: vulnhunter-agent/agent/templates/clean_scan_body.md:1
    }

    String scanDetails(Map<String, String> fields) {
        // table rows: Scan ID, Repository, Commit scanned, App ID, Scan started, Scan completed, Duration,
        // Findings detected (fixed 0), Model version, Skill version
        return table(List.of("SCAN_ID", "REPO_SLUG", "COMMIT_SHA", "APP_ID", "SCAN_STARTED_AT", "SCAN_COMPLETED_AT",
                "DURATION", "Findings detected = 0", "MODEL_VERSION", "SKILL_VERSION"), fields);   // src: vulnhunter-agent/agent/templates/clean_scan_body.md:9
    }

    String footer() {
        return "This issue was opened and closed automatically by VulnHunter. It is informational only."; // src: vulnhunter-agent/agent/templates/clean_scan_body.md:26
    }
}
