// file: vvaharness/backends/harness/deepagents/invalid_tool_args.py
// Middleware that repairs a tool call langchain could not parse as JSON: the call is moved into tool_calls with
// args={} and paired with an error ToolMessage, so the model sees the failure instead of the session breaking.
// request.override touches only the outgoing request, so the same unrepaired call recurs; counting dedupes by id.

@executedBy(CODE) @role(backend)
class InvalidToolArgs {

    // Clear the raw arguments string on the Responses-leg function_call block it names.
    Object repairBlock(Object block, Set<String> repairedIds) {
        if (block instanceof Map && "function_call".equals(block.get("type")) && repairedIds.contains(block.get("call_id"))) { // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:37
            return block.with("arguments", "<empty json object>");                                       // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:39
        }
        return block;
    }

    // Count once per call id; return the paired error ToolMessage, or null when one already exists.
    ToolMessage recordInvalidCall(InvalidToolCall invalid, String callId, Set<String> existingToolMessageIds, Set<String> countedIds) {
        if (!countedIds.contains(callId)) {                                                              // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:48
            countedIds.add(callId);
            COUNTERS.bump("deepagents_tool_args_invalid_json");                                          // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:50
        }
        if (existingToolMessageIds.contains(callId)) return null;                                        // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:51
        String error = invalid.get("error") != null ? invalid.get("error") : "arguments were not valid JSON"; // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:53
        return new ToolMessage("ERROR: tool arguments were not valid JSON: " + error, callId, invalid.get("name")); // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:54
    }

    Pair<AIMessage, List<ToolMessage>> repairMessage(AIMessage message, Set<String> existingToolMessageIds, Set<String> countedIds) {
        Set<String> repairedIds = new Set();
        List<ToolCall> newToolCalls = message.toolCalls.copy();                                          // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:67
        List<InvalidToolCall> remainingInvalid = new List();
        List<ToolMessage> extraToolMessages = new List();
        for (InvalidToolCall invalid : message.invalidToolCalls) {                                       // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:70
            String callId = invalid.get("id");
            if (callId == null) {                        // id-less: ToolMessage needs an id; left untouched // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:72
                remainingInvalid.add(invalid);
                continue;
            }
            newToolCalls.add(new ToolCall(invalid.get("name"), Map.of(), callId));   // args = empty      // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:75
            repairedIds.add(callId);
            ToolMessage extra = recordInvalidCall(invalid, callId, existingToolMessageIds, countedIds);  // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:78
            if (extra != null) extraToolMessages.add(extra);                                             // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:80
        }
        Object content = message.content;
        if (content instanceof List) content = content.map(b -> repairBlock(b, repairedIds));            // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:83
        AIMessage repaired = message.copyWith(newToolCalls, remainingInvalid, content);                  // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:84
        return Pair.of(repaired, extraToolMessages);
    }

    List<Message> repair(List<Message> messages, Set<String> countedIds) {
        Set<String> existingToolMessageIds = messages.filter(m -> m instanceof ToolMessage).map(m -> m.toolCallId); // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:94
        List<Message> out = new List();
        boolean changed = false;
        for (Message message : messages) {                                                               // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:98
            if (message instanceof AIMessage && !message.invalidToolCalls.isEmpty()) {                  // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:99
                Pair<AIMessage, List<ToolMessage>> r = repairMessage(message, existingToolMessageIds, countedIds); // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:100
                out.add(r.first);
                out.addAll(r.second);
                changed = true;
            } else {
                out.add(message);
            }
        }
        return changed ? out : null;                                                                     // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:106
    }
}

@executedBy(CODE) @role(backend)
class RepairInvalidToolArgs {
    Set<String> countedIds = new Set();                                                                  // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:115

    ModelRequest repairedRequest(ModelRequest request) {
        List<Message> repaired = InvalidToolArgs.repair(request.messages, countedIds);                   // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:118
        return repaired == null ? request : request.override("messages", repaired);                      // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:119
    }

    ModelCallResult wrapModelCall(ModelRequest request, Handler handler) {
        return handler.call(repairedRequest(request));                                                   // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:125
    }

    // Async counterpart of wrapModelCall: same repair, awaited handler.
    ModelCallResult awrapModelCall(ModelRequest request, Handler handler) {
        return await handler.call(repairedRequest(request));                                             // src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:134
    }
}
