// file: vvaharness/util/git_paths.py
// The single answer to "is this path version-control metadata?" for every write gate.

@executedBy(CODE) @role(rule_set)
class GitPaths {

    static final String GIT_DIR = ".git";                                     // src: vvaharness/util/git_paths.py:23

    boolean isGitMetadata(String path) {
        List<String> parts = PurePosixPath(path.replace("\\", "/")).parts();   // src: vvaharness/util/git_paths.py:28
        return parts.any(p -> p.casefold() == GIT_DIR);                        // case-folded: macOS/Windows fold case // src: vvaharness/util/git_paths.py:29
    }

    // cached (functools.cache)
    List<String> gitDirSpellings() {
        // every upper/lower-case combination of ".git", for matchers that cannot fold case
        return product(GIT_DIR.substring(1).chars().map(c -> List.of(lower(c), upper(c)))).map(combo -> "." + join(combo)); // src: vvaharness/util/git_paths.py:35
    }
}
