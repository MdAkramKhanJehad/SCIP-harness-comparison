# vvaharness/remediation_agent/models/verdict.py

The structured output the remediation model is asked to return for one finding (`RemediationVerdict`), the salvage logic that keeps a near-complete reply, and the translation into the shared evidence contract.

Source: `vvaharness/remediation_agent/models/verdict.py` (lines 1-133)
Executor: code
Called from: `prompts.sudo` (schema embedded in SYSTEM), `plugin_runner/helpers.sudo` _coerce_verdict, `plugin_runner/run.sudo` harness_amend (to_evidence)

// src: vvaharness/remediation_agent/models/verdict.py:36-37
Verdict: "Fixed" | "Partially Fixed" | "Not Fixed" | "False Positive" | "Needs Review" | "Denied"

// src: vvaharness/remediation_agent/models/verdict.py:40-59 — only verdict is strictly required; every other field has a safe default
RemediationVerdict {
  finding_index: Number = 0
  verdict: Verdict = "Needs Review"
  gates: Gates   // models/gates.sudo; each gate defaults to "fail"
  root_cause: String = ""   // "one paragraph, cites file:line"
  changes: [Change] = []   // "edits applied (fix mode) or proposed (report-only)"
  remaining_risks: [String] = []
  recommendations: [String] = []   // "code-level follow-ups only — no operational controls"
  summary: String = ""   // "2-4 sentence human-readable summary"
}

// src: vvaharness/remediation_agent/models/verdict.py:61-64 — schema_json_compact: compact JSON schema string embedded in the SYSTEM prompt

// src: vvaharness/remediation_agent/models/verdict.py:66-95
fn RemediationVerdict.coerce(data, finding_index):executor=code {
  if (data is not a dict) return RemediationVerdict(finding_index, verdict="Needs Review", summary="agent response was not a JSON object")
  try { v = validate(data); v.finding_index = finding_index; return v }
  catch => {}   // fall through to salvage
  clean = data restricted to the known field names
  if (clean.verdict not in Verdict) clean.verdict = "Needs Review"
  try v = validate(clean);
  catch => {
    v = RemediationVerdict(verdict="Needs Review", summary="agent verdict could not be fully validated; salvaged available fields")
    for each [k, val] in clean { try set v.k = val; catch => skip }
    // preserved: a salvaged field can overwrite the fallback verdict and summary set just above
  }
  v.finding_index = finding_index
  return v
}

// src: vvaharness/remediation_agent/models/verdict.py:99-133
fn to_evidence(verdict, provenance):executor=code {
  // prompt phrase -> outcome vocabulary; total over Verdict, so an unknown phrase raises
  outcome = match (verdict.verdict) {
    case "Fixed" => FIXED; case "Partially Fixed" => PARTIALLY_FIXED; case "Not Fixed" => NOT_FIXED
    case "False Positive" => FALSE_POSITIVE; case "Needs Review" => NEEDS_REVIEW; case "Denied" => DENIED
  }
  return RemediationEvidence(
    outcome, summary=verdict.summary, root_cause=verdict.root_cause,
    changes = verdict.changes where file is non-empty, as FileChange(file, summary),
    gates = [source, sink, missing_control] as GateAssessment(name, status),
    remaining_risks, recommendations, produced_by=provenance)
}
