// file: vulnhunter-fix/prompts/implement.md
// Phase 3 of vulnhunter-fix: TDD implementation of each finding (exploit demo -> RED test -> fix -> exploit blocked
// -> discrimination evidence -> regression -> scope check -> pre-existing test updates -> commit).
// In-place mode: one branch per cluster + interactive collaboration loop. Fork mode: one masked branch per finding + issue fallback.

@executedBy(MODEL) @role(prompt) @stage("implement")
class PromptsImplement {

    // ---------------------------------------------------------------------------------------------
    // Entry point.
    // ---------------------------------------------------------------------------------------------
    PhaseOutput run(Mode mode, PhaseOutput plan, Config cfg, boolean skipFork, Theta θ) {
        Prompt p = prompt(θ);
        if (mode == null) mode = exists(θ["p.implement.mode_detect_by_work_json"]) ? Mode.IN_PLACE : Mode.FORK; // src: vulnhunter-fix/prompts/implement.md:10
        if (mode == Mode.IN_PLACE) return ImplementInPlace.run(plan, cfg, θ);                      // src: vulnhunter-fix/prompts/implement.md:7
        return ImplementFork.run(plan, cfg, θ);                                                     // src: vulnhunter-fix/prompts/implement.md:8
    }

    // ---------------------------------------------------------------------------------------------
    // Prompt sections in document order.
    // ---------------------------------------------------------------------------------------------
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(modeAware(θ));
        p.include(inPlaceSetup(θ));
        p.include(inPlacePerFinding(θ));
        p.include(forkSetup(θ));
        p.include(forkBranchCreation(θ));
        p.include(stepAExploit(θ));
        p.include(stepBPatchability(θ));
        p.include(stepCSecurityTest(θ));
        p.include(stepDFix(θ));
        p.include(stepD1Interface(θ));
        p.include(stepD2CrossRepo(θ));
        p.include(stepD3DepChecks(θ));
        p.include(stepEExploitBlocked(θ));
        p.include(stepE5Discrimination(θ));
        p.include(stepFRegression(θ));
        p.include(stepGScope(θ));
        p.include(stepG5PreexistingTests(θ));
        p.include(stepHCommit(θ));
        p.include(collaborationLoop(θ));
        p.include(forkIssueFallback(θ));
        p.include(workerClassNotes(θ));
        return p;
    }

    Prompt modeAware(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.implement.in_place_one_branch_per_cluster"]);                                       // src: vulnhunter-fix/prompts/implement.md:7
        p.rule(θ["p.implement.fork_one_branch_per_finding"]);                                           // src: vulnhunter-fix/prompts/implement.md:8
        p.rule(θ["p.implement.mode_detect_by_work_json"]);                                              // src: vulnhunter-fix/prompts/implement.md:10
        return p;
    }

    Prompt inPlaceSetup(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.implement.cluster_branch_naming"]);                                               // src: vulnhunter-fix/prompts/implement.md:24
        p.threshold(θ["p.implement.cluster_key_derivation"]);                                           // src: vulnhunter-fix/prompts/implement.md:27
        p.forbid(θ["p.implement.in_place_no_masked_branch"]);                                           // src: vulnhunter-fix/prompts/implement.md:37
        return p;
    }

    Prompt inPlacePerFinding(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.implement.in_place_finding_order_and_no_new_branch"]);                            // src: vulnhunter-fix/prompts/implement.md:41
        p.step(1, θ["p.implement.ip_exploit_location_tmpdir"]);                                         // src: vulnhunter-fix/prompts/implement.md:45
        p.forbid(θ["p.implement.no_security_tests_dir_for_exploit"]);                                   // src: vulnhunter-fix/prompts/implement.md:45
        p.forbid(θ["p.implement.ip_no_terminal_cannot_auto_fix"]);                                      // src: vulnhunter-fix/prompts/implement.md:51
        p.checklist(θ["p.implement.ip_collab_trigger_criteria"]);                                       // src: vulnhunter-fix/prompts/implement.md:53
        p.forbid(θ["p.implement.ip_no_defer_or_scaffolding_framing"]);                                  // src: vulnhunter-fix/prompts/implement.md:53
        p.checklist(θ["p.implement.ip_test_requirements"]);                                             // src: vulnhunter-fix/prompts/implement.md:58
        p.format(θ["p.implement.scaffold_transient_name"]);                                             // src: vulnhunter-fix/prompts/implement.md:61
        p.must(θ["p.implement.decide_final_test_name_at_red"]);                                         // src: vulnhunter-fix/prompts/implement.md:62
        p.must(θ["p.implement.ip_run_test_confirm_fail"]);                                              // src: vulnhunter-fix/prompts/implement.md:64
        p.rule(θ["p.implement.ip_fix_per_proposed_strategy"]);                                          // src: vulnhunter-fix/prompts/implement.md:68
        p.rule(θ["p.implement.ip_breaking_change_to_collab_loop"]);                                     // src: vulnhunter-fix/prompts/implement.md:68
        p.must(θ["p.implement.ip_dep_hits_surfaced_per_hit"]);                                          // src: vulnhunter-fix/prompts/implement.md:70
        p.forbid(θ["p.implement.no_auto_bump_unapproved"]);                                             // src: vulnhunter-fix/prompts/implement.md:70
        p.rule(θ["p.implement.ip_exploit_rerun_then_delete"]);                                          // src: vulnhunter-fix/prompts/implement.md:74
        p.evidence(θ["p.implement.ip_discrimination_evidence"]);                                        // src: vulnhunter-fix/prompts/implement.md:85
        p.rule(θ["p.implement.ip_regression_policy_default"]);                                          // src: vulnhunter-fix/prompts/implement.md:89
        p.must(θ["p.implement.ip_scope_check"]);                                                        // src: vulnhunter-fix/prompts/implement.md:93
        p.evidence(θ["p.implement.ip_preexisting_test_updates"]);                                       // src: vulnhunter-fix/prompts/implement.md:97
        p.format(θ["p.implement.ip_severity_mask_commit"]);                                             // src: vulnhunter-fix/prompts/implement.md:129
        p.rule(θ["p.implement.ip_resume_partial_cluster"]);                                             // src: vulnhunter-fix/prompts/implement.md:135
        return p;
    }

