# vvaharness/remediation_agent/report_parser/fields.py

Promotes a Markdown-parsed finding block onto the typed scan `Finding` contract: reads the metadata lines (class, CWE, CVSS, taint source and sink), the `####` sections, and the adversarial verification verdict.

Source: `vvaharness/remediation_agent/report_parser/fields.py` (lines 1-166)
Executor: code
Called from: `report_parser/parse.sudo` parse_findings

// src: vvaharness/remediation_agent/report_parser/fields.py:37-39
_VERDICT_LABELS = ["TRUE_POSITIVE", "FALSE_POSITIVE"]   // the only two verdict labels the scan contract admits

// src: vvaharness/remediation_agent/report_parser/fields.py:42-69
fn to_scan_finding(finding):executor=code {
  f = parse_finding_fields(finding)
  vuln_class = VulnClass(f.vuln_class)   // an unknown label folds to OTHER (models/vocab.py VulnClass._missing_)
  return ScanFinding(
    title, file, line_start, line_end, cwe, description, recommendation, code_snippet, impact,
    exploit_scenario, preconditions, source_ref, sink_ref, verdict_confidence, verdict_reason,
    cvss_vector, cvss_score, cvss_rating  // all taken from f
    vuln_class,
    vuln_class_label = if (vuln_class == OTHER) f.vuln_class else "",
    severity = _severity(finding.severity),
    verdict = _verdict_label(f.verdict)
  )
}

// src: vvaharness/remediation_agent/report_parser/fields.py:72-77
fn _severity(label):executor=code {
  try return Severity(label or "medium");
  catch ValueError => return Severity.MEDIUM   // an unknown band defaults to MEDIUM
}

// src: vvaharness/remediation_agent/report_parser/fields.py:80-82
fn _verdict_label(value):executor=code { return if (value in _VERDICT_LABELS) value else null }

// src: vvaharness/remediation_agent/report_parser/fields.py:85-155
fn parse_finding_fields(finding):executor=code {
  body = finding.body or ""
  secs = field_sections._sections(body); head = secs[""]
  [file, line_start, line_end] = if (finding.file) field_sections._file_loc(finding.file) else ["", 0, 0]

  // src: fields.py:101-116 — first matching pattern per line, in this order; a later line overwrites an earlier value
  for each trimmed line in head {
    match (line) {
      case _CLASS_RE => vuln_class = group 1
      case _CWE_RE => cwe = group 1
      case _CVSS_SCORE_RE => { cvss_score = number(group 1); cvss_rating = group 2; cvss_vector = group 3 }
      case _CVSS_VECONLY_RE => cvss_vector = group 1
      case _SOURCE_RE => source_ref = group 1
      case _SINK_RE => sink_ref = group 1
    }
  }

  // src: fields.py:118-122 — the Class line may itself carry the CWE, for example "CWE-89: SQL Injection"
  if (cwe == null && vuln_class starts with /CWE-\d+/) cwe = that prefix

  [verdict, verdict_confidence, verdict_reason] = _verification(secs["adversarial verification"])

  // src: fields.py:127-131 — only bullet lines ("-" or "*") of the Preconditions section
  preconditions = bullet lines of secs["preconditions"] with the bullet removed

  // src: fields.py:133-155
  return {
    _source: "vvaharness s8 (verbatim Finding fields)",
    title: finding.title, vuln_class, cwe, file, line_start, line_end, source_ref, sink_ref,
    description: secs["description"], recommendation: secs["how to fix"],
    code_snippet: field_sections._first_code_block(body),
    impact: secs["impact"], exploit_scenario: secs["exploit scenario"], preconditions,
    verdict, verdict_confidence, verdict_reason, cvss_vector, cvss_score, cvss_rating
  }   // a missing section degrades to "" (or null, or [])
}

// src: vvaharness/remediation_agent/report_parser/fields.py:158-165
fn _verification(section):executor=code {
  for each trimmed line in section {
    if (line matches _VERDICT_RE) return [group 1, group 2 as integer or null, group 3 trimmed]   // first verdict line wins
  }
  return [null, null, ""]
}
