  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n# http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Pre-dispatch detection of symlinks escaping the scanned repo (CWE-59).\n\nS10's write confinement is a permission-engine scope, not a path jail. An edit\nTHROUGH an escaping link never modifies the link object, so ``git status`` and\n``changed_files_whole_tree`` see nothing and ``revert_files`` has no baseline —\nthe one S10 hazard no post-gate can observe, hence caught before the model is\nhanded a writer. Read-only and total: this reports, the caller refuses.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n#: Bounded like the post-gate's own worktree scan, so a huge tree cannot pin the pre-dispatch check\n_SCAN_FILE_MAX = 20000\n_SCAN_DIR_MAX = 20000\n\n#: Skipped: vendored trees hold thousands of legitimate links and S10 never patches them\n_SKIP_DIRS = frozenset({\n    \".git\", \"node_modules\", \".venv\", \"venv\", \"__pycache__\",\n    \".mypy_cache\", \".pytest_cache\", \".ruff_cache\", \".tox\",\n})\n\n\ndef escaping_symlinks(repo: Path) -> dict[str, str]:\n    \"\"\"Map repo-relative symlink path -> its out-of-tree resolved target.\n\n    Reported: any link resolving OUTSIDE *repo*, plus any link that cannot be\n    shown to point at a real path inside it (dangling target, resolution loop).\n    A link to an existing in-tree path is normal and is not reported.\n\n    Never raises — an unreadable subtree yields whatever was found so far.\n    \"\"\"\n    repo = Path(repo)\n    try:\n        root = repo.resolve()\n    except OSError:\n        return {}\n    found: dict[str, str] = {}\n    files_seen = 0\n    dirs_seen = 0\n    try:\n        # followlinks=False: never descend THROUGH a link while looking for links.\n        for dirpath, dirnames, filenames in os.walk(repo, followlinks=False):\n            dirs_seen += 1\n            if dirs_seen > _SCAN_DIR_MAX:\n                break\n            # A symlinked dir is itself a candidate; followlinks=False lists it without descending\n            for name in list(dirnames):\n                if name in _SKIP_DIRS:\n                    dirnames.remove(name)\n                    continue\n                _record(root, repo, Path(dirpath) / name, found)\n            for name in filenames:\n                files_seen += 1\n                if files_seen > _SCAN_FILE_MAX:\n                    return found\n                _record(root, repo, Path(dirpath) / name, found)\n    except Exception:  # noqa: BLE001 — a best-effort scan must never break a run\n        return found\n    return found\n\n\ndef _record(root: Path, repo: Path, path: Path, out: dict[str, str]) -> None:\n    \"\"\"Add *path* to *out* when it is a symlink not proven to resolve inside *root*.\n\n    ``resolve()`` is non-strict, so a dangling link yields a path that does not\n    exist and looks confined. An in-tree one is still recorded: the link is\n    attacker-controlled, a write would create its target, and the link can be\n    swapped between this check and that write (TOCTOU).\n    \"\"\"\n    try:\n        if not path.is_symlink():\n            return\n    except OSError:\n        return\n    try:\n        rel = path.relative_to(repo).as_posix()\n    except ValueError:\n        return\n    try:\n        target = path.resolve()\n    except (OSError, RuntimeError):\n        # A resolution loop (ELOOP) raises; it cannot be proven in-tree.\n        out[rel] = _raw_target(path)\n        return\n    try:\n        target.relative_to(root)\n    except ValueError:\n        out[rel] = str(target)\n        return\n    if not target.exists():\n        out[rel] = f\"{_raw_target(path)} (dangling)\"\n\n\ndef _raw_target(path: Path) -> str:\n    \"\"\"The link's literal target text, for a link we could not resolve to a real path.\"\"\"\n    try:\n        return os.readlink(path)\n    except OSError:\n        return \"<unreadable>\"\n\n\ndef describe_escapes(escapes: dict[str, str], limit: int = 5) -> str:\n    \"\"\"A bounded, single-line rendering of *escapes* for an operator message.\"\"\"\n    items = sorted(escapes.items())\n    shown = \", \".join(f\"{link} -> {target}\" for link, target in items[:limit])\n    if len(items) > limit:\n        shown += f\", … (+{len(items) - limit} more)\"\n    return shown\n\n\n__all__ = [\"describe_escapes\", \"escaping_symlinks\"]\n",
