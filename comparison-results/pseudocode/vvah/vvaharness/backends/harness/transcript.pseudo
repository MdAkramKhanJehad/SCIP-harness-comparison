// file: vvaharness/backends/harness/transcript.py
// Append one streaming session's messages to a JSONL transcript. Silently inert unless
// VVAHARNESS_TRANSCRIPT_DIR is set; a transcript failure never breaks the scan.

@executedBy(CODE) @role(io)
class HarnessTranscript {
    static int SEQ = 0;

    Path transcriptDir() {
        String raw = env("VVAHARNESS_TRANSCRIPT_DIR", "").strip();                                      // src: vvaharness/backends/harness/transcript.py:37
        return raw.isEmpty() ? null : Path.of(raw).expanduser();                                         // src: vvaharness/backends/harness/transcript.py:38
    }

    int nextSeq() {
        synchronized (SEQ_LOCK) {
            SEQ = SEQ + 1;                                                                               // src: vvaharness/backends/harness/transcript.py:45
            return SEQ;
        }
    }

    String slug(String text, String fallback) {
        String cleaned = text.strip().replaceAll("[^A-Za-z0-9._-]+", "-").strip("-");                   // src: vvaharness/backends/harness/transcript.py:51
        return cleaned.isEmpty() ? fallback : cleaned.substring(0, 60);                                  // src: vvaharness/backends/harness/transcript.py:52
    }

    Map<String, Object> jsonable(Object message, Theta θ) {
        if (isDataclass(message)) return asdict(message);                                                // src: vvaharness/backends/harness/transcript.py:57
        return Map.of("kind", typeName(message), "repr", repr(message).substring(0, θ["code.backends.harness.transcript.repr_max_chars"])); // src: vvaharness/backends/harness/transcript.py:59
    }

    TranscriptFile openTranscript(String tag, String model, String graphName) {
        Path root = transcriptDir();                                                                     // src: vvaharness/backends/harness/transcript.py:101
        if (root == null) return null;                                                                   // src: vvaharness/backends/harness/transcript.py:102
        try {
            root.mkdirs();                                                                               // src: vvaharness/backends/harness/transcript.py:105
        } catch (OSError e) {
            return null;                                                                                 // src: vvaharness/backends/harness/transcript.py:107
        }
        String name = format("%04d", nextSeq()) + "-" + slug(tag != null ? tag : graphName, "session") + ".jsonl"; // src: vvaharness/backends/harness/transcript.py:108
        return new TranscriptFile(root.resolve(name), Map.of("tag", tag, "model", model, "graph_name", graphName)); // src: vvaharness/backends/harness/transcript.py:109
    }
}

@executedBy(CODE) @role(io)
class TranscriptFile {
    Path path;
    double start;
    int n = 0;

    void init(Path path, Map<String, Object> meta) {
        this.path = path;
        this.start = monotonic();                                                                        // src: vvaharness/backends/harness/transcript.py:69
        write(Map.of("kind", "transcript_open").plus(meta));                                             // src: vvaharness/backends/harness/transcript.py:71
    }

    void write(Map<String, Object> row) {
        try {
            path.append(json(row) + "\n");                                                               // src: vvaharness/backends/harness/transcript.py:77
        } catch (OSError e) {
            return;                                                      // never break the scan          // src: vvaharness/backends/harness/transcript.py:79
        }
    }

    void add(Object message, Theta θ) {
        n = n + 1;                                                                                       // src: vvaharness/backends/harness/transcript.py:83
        write(Map.of("seq", n, "t", round(monotonic() - start, 3)).plus(HarnessTranscript.jsonable(message, θ))); // src: vvaharness/backends/harness/transcript.py:84
    }

    void close() {
        write(Map.of("kind", "transcript_close", "messages", n, "elapsed_s", round(monotonic() - start, 3))); // src: vvaharness/backends/harness/transcript.py:92
    }
}
