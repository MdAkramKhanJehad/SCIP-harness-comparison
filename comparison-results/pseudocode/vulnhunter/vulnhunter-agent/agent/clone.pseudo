// file: vulnhunter-agent/agent/clone.py
// Shallow-clones the target repo into the clone base dir (scan mode), or at a pinned commit (verify mode).
// The scan sees only the snapshot: no git history is fetched.

@executedBy(CODE) @role(io) @stage("agent")
class Clone {

    // Refuse values git would parse as an option (CWE-88).
    void rejectOptionLike(String value, String what) {
        if (value.startsWith("-")) throw new RuntimeError("refusing " + what);                   // src: vulnhunter-agent/agent/clone.py:38
    }

    String deriveRepoName(String repoUrl) {
        String last = urlPath(repoUrl).rstrip("/").lastSegment();                                // src: vulnhunter-agent/agent/clone.py:49
        if (last.endsWith(".git")) last = last.dropSuffix(".git");                               // src: vulnhunter-agent/agent/clone.py:50
        last = last.replaceAll("[^A-Za-z0-9._-]", "_");                                          // src: vulnhunter-agent/agent/clone.py:52
        return (last == "") ? "repo" : last;
    }

    Path shallowClone(String repoUrl, String cloneBaseDir, int timeoutSeconds, boolean reClone, String githubToken, String githubHost, Theta θ) {
        Path base = Path.of(cloneBaseDir).resolve();                                             // src: vulnhunter-agent/agent/clone.py:79
        Path target = base.resolve(deriveRepoName(repoUrl));                                     // src: vulnhunter-agent/agent/clone.py:81
        if (target.exists()) {                                                                   // src: vulnhunter-agent/agent/clone.py:83
            if (!reClone) return target;                                                         // src: vulnhunter-agent/agent/clone.py:84
            target.rmtree();                                                                     // src: vulnhunter-agent/agent/clone.py:88
        }
        String effectiveUrl = Url.injectToken(repoUrl, githubToken, githubHost);                 // src: vulnhunter-agent/agent/clone.py:98
        rejectOptionLike(effectiveUrl, "clone URL");                                             // src: vulnhunter-agent/agent/clone.py:109
        if (GIT_EXECUTABLE == null) throw new RuntimeError("git not on PATH");                   // src: vulnhunter-agent/agent/clone.py:111
        int depth = θ["code.clone_depth"];                                                       // src: vulnhunter-agent/agent/clone.py:119
        Proc r = subprocess("git", "clone", "--progress", "--depth", depth, "--", effectiveUrl, target, timeoutSeconds); // src: vulnhunter-agent/agent/clone.py:119
        if (r.timedOut || r.returncode != 0) {                                                   // src: vulnhunter-agent/agent/clone.py:124
            target.rmtree();
            throw new RuntimeError("git clone failed");                                          // src: vulnhunter-agent/agent/clone.py:135
        }
        if (effectiveUrl != repoUrl) subprocess("git", "remote", "set-url", "origin", repoUrl, target, 10); // src: vulnhunter-agent/agent/clone.py:145
        return target;
    }

    Path cloneAtCommit(String repoUrl, String cloneBaseDir, String commit, int timeoutSeconds, boolean reClone, String githubToken, String githubHost, Theta θ) {
        if (!commit.matches("^[0-9a-f]7..40$")) throw new ValueError("commit must be a 7-40 char hex SHA"); // src: vulnhunter-agent/agent/clone.py:205
        Path target = shallowClone(repoUrl, cloneBaseDir, timeoutSeconds, reClone, githubToken, githubHost, θ); // src: vulnhunter-agent/agent/clone.py:211
        if (gitRevParseHead(target) == commit) return target;                                    // src: vulnhunter-agent/agent/clone.py:231
        String effectiveUrl = Url.injectToken(repoUrl, githubToken, githubHost);                 // src: vulnhunter-agent/agent/clone.py:239
        rejectOptionLike(effectiveUrl, "fetch URL");                                             // src: vulnhunter-agent/agent/clone.py:249
        Proc f = subprocess("git", "fetch", "--depth", "1", "--", effectiveUrl, commit, target, timeoutSeconds); // src: vulnhunter-agent/agent/clone.py:250
        if (f.returncode != 0) throw new RuntimeError("git fetch failed");                      // src: vulnhunter-agent/agent/clone.py:266
        Proc c = subprocess("git", "checkout", "--detach", commit, target, 60);                  // src: vulnhunter-agent/agent/clone.py:275
        if (c.returncode != 0) throw new RuntimeError("git checkout failed");                   // src: vulnhunter-agent/agent/clone.py:283
        return target;
    }
}
