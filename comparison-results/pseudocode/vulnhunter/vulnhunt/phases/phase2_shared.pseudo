// file: vulnhunt/phases/phase2_shared.md
// Shared instructions every Phase 2 class-group trace agent (INJ, NAV, LOG) reads first: input-forward
// iteration rules, absent-input and auth-branch checks, HARD GATES 0/1/2a/2b/3 in order, severity tiers, output format.
// Prompt-only: all logic is carried out by the trace-agent model.

@executedBy(MODEL) @role(types)
enum TraceDisposition { CANDIDATE, SAFE, DESIGN_INTENT }

@executedBy(MODEL) @role(types)
enum Severity { HIGH_PLUS, HIGH, MEDIUM, LOW, INFORMATIONAL }

@executedBy(MODEL) @role(types)
enum GateOutcome { PASS, ELIMINATED, CODE_SMELL, DEAD_CODE }

// Hooks each class file (Phase2ClassInj / Phase2ClassNav / Phase2ClassLog) supplies on top of the shared rules.
@executedBy(MODEL) @role(types)
interface ClassGroupRules {
    boolean gate0Exemption(Candidate c) { }
    boolean gate3DoNotEliminate(Candidate c) { }
    Severity severityFloor(Candidate c) { }
}

@executedBy(MODEL) @role(rule_set) @stage("P2")
class Phase2Shared {

    // Trace-agent body: iterate the inventory input by input (input-forward), then absent-input and completeness checks.
    List<Disposition> run(List<Input> inventory, ClassGroup cls, ClassGroupRules classRules, Theta θ) {
        // These rules apply to ALL class groups; the class file is read AFTER this file.
        assert θ["p.phase2_shared.class_file_read_after_shared"];                                        // src: vulnhunt/phases/phase2_shared.md:3
        // θ["prompt.tracing_direction"] = input-forward; never switch to entry-point- or sink-driven hunting.
        assert θ["prompt.tracing_direction"] == "input-forward";                                          // src: vulnhunt/phases/phase2_shared.md:107
        List<Disposition> out = new List();
        List<List<Input>> batches = θ["p.phase2_shared.batch_by_entry_point"] != null ? inventory.groupBy(i -> i.entryPoint) : List.of(inventory); // src: vulnhunt/phases/phase2_shared.md:104
        for (List<Input> batch : batches) {
            for (Input in : batch) {
                out.addAll(traceInput(in, cls, classRules, θ));                                          // src: vulnhunt/phases/phase2_shared.md:7
            }
        }
        if (θ["p.phase2_shared.every_input_resolved"]) assert out.coversAll(inventory);                  // src: vulnhunt/phases/phase2_shared.md:105
        out.addAll(absentInputAnalysis(inventory, θ));                                                   // src: vulnhunt/phases/phase2_shared.md:62
        completenessCheck(inventory, out, θ);                                                            // src: vulnhunt/phases/phase2_shared.md:89
        out.addAll(authBranchEnumeration(inventory, θ));                                                 // src: vulnhunt/phases/phase2_shared.md:93
        for (Disposition d : out.filter(x -> x.kind == TraceDisposition.CANDIDATE)) {
            d.candidate = applyHardGates(d.candidate, cls, classRules, θ);                               // src: vulnhunt/phases/phase2_shared.md:111
        }
        return out;
    }

    // Iteration Rules, steps 1-5 for one input.
    List<Disposition> traceInput(Input in, ClassGroup cls, ClassGroupRules classRules, Theta θ) {
        List<Disposition> out = new List();
        // Mandatory input gates run BEFORE any disposition is recorded.
        Disposition pre = mandatoryInputGates(in, cls, θ);                                               // src: vulnhunt/phases/phase2_shared.md:23
        if (pre != null) out.add(pre);
        // Step 2: check all code paths, not just the first.
        List<Path> paths = θ["p.phase2_shared.check_all_code_paths"] ? in.allUses() : List.of(in.firstUse()); // src: vulnhunt/phases/phase2_shared.md:36
        for (Path path : paths) {
            // Step 1: trace forward through every assignment, call and transformation.
            List<Sink> sinks = traceForward(in, path, θ);                                                // src: vulnhunt/phases/phase2_shared.md:9
            for (Sink s : sinks) {
                out.add(recordDisposition(in, s, θ));                                                    // src: vulnhunt/phases/phase2_shared.md:43
                // Step 3: continue tracing past the first finding.
                if (!θ["prompt.continue_past_first_finding"]) break;                                     // src: vulnhunt/phases/phase2_shared.md:38
            }
        }
        out = splitSeparateCandidates(out, θ);                                                           // src: vulnhunt/phases/phase2_shared.md:40
        return out;                                                                                      // Step 5: move to next input. src: vulnhunt/phases/phase2_shared.md:60
    }

    // Step 1 outcomes (a)-(d), including second-order flows through stores.
    List<Sink> traceForward(Input in, Path path, Theta θ) {
        List<Sink> out = new List();
        if (!θ["p.phase2_shared.trace_forward_every_transformation"]) return out;                       // src: vulnhunt/phases/phase2_shared.md:9
        for (Step st : path.followAssignmentsCallsTransforms()) {
            if (st.isDangerousSink() && !st.effectivelySanitized()) {
                out.add(st.sink(θ["p.phase2_shared.outcome_sink_without_sanitization"]));               // (a) candidate src: vulnhunt/phases/phase2_shared.md:11
            } else if (st.provenSanitizedOrTypeConstrainedBeforeEverySink()) {
                out.add(st.sink(θ["p.phase2_shared.outcome_sanitized_before_every_sink"]));             // (b) safe src: vulnhunt/phases/phase2_shared.md:12
            } else if (st.exitsCodebase()) {
                out.add(st.sink(θ["p.phase2_shared.outcome_exits_codebase"]));                          // (c) safe src: vulnhunt/phases/phase2_shared.md:13
            } else if (st.isStoreIn(θ["p.phase2_shared.store_boundary_trace_all_readers"])) {           // (d) src: vulnhunt/phases/phase2_shared.md:14
                // Do NOT record NO-MATCH at a store boundary.
                if (θ["p.phase2_shared.no_no_match_at_store"]) st.forbidNoMatch();                       // src: vulnhunt/phases/phase2_shared.md:16
                for (Reader r : grepAllReaders(st.store)) {
                    out.addAll(traceForward(in, r.path, θ));  // each reader traced independently        // src: vulnhunt/phases/phase2_shared.md:15
                }
                // Every consumer exhausted before SAFE; one safe consumer does not clear others.
                if (θ["p.phase2_shared.exhaust_store_consumers"]) assert allReadersTraced(st.store);    // src: vulnhunt/phases/phase2_shared.md:17
            }
            if (st.isPresenceCheck() && θ["p.phase2_shared.boolean_gate_trap"]) {                        // src: vulnhunt/phases/phase2_shared.md:19
                // A presence check is NOT a disposition: trace the value stored inside the block.
                out.addAll(traceForward(in, st.storedValuePath(), θ));                                   // src: vulnhunt/phases/phase2_shared.md:21
            }
        }
        return out;
    }

    // MANDATORY GATES for request-body and resource-ID inputs (NAV runs class gates; INJ/LOG flag CROSS-CLASS).
    Disposition mandatoryInputGates(Input in, ClassGroup cls, Theta θ) {
        if (in.isRequestBody()) {
            if (cls == ClassGroup.NAV) {
                return Phase2ClassNav.requestBodyGate(in, θ["p.phase2_shared.request_body_gate_nav"], θ);  // unclear: method name in class file // src: vulnhunt/phases/phase2_shared.md:23
            } else if (!in.bodyTypeHasFieldLevelAuthzFiltering()) {
                return Disposition.crossClass(in, θ["p.phase2_shared.request_body_cross_class_flag"]);  // src: vulnhunt/phases/phase2_shared.md:26
            }
        }
        if (in.isPathParam() || in.isQueryParam() || in.isBodyIdField()) {
            if (cls == ClassGroup.NAV) {
                return Phase2ClassNav.resourceIdGate(in, θ["p.phase2_shared.resource_id_gate_nav"], θ);  // unclear: method name in class file // src: vulnhunt/phases/phase2_shared.md:29
            } else if (in.lacksOwnershipCheckBeforeSensitiveOp()) {
                return Disposition.crossClass(in, θ["p.phase2_shared.resource_id_cross_class_flag"]);   // src: vulnhunt/phases/phase2_shared.md:32
            }
        }
        return null;
    }

    // Step 3 tie-break: separate sinks are separate candidates.
    List<Disposition> splitSeparateCandidates(List<Disposition> ds, Theta θ) {
        for (Disposition a : ds) {
            for (Disposition b : ds) {
                boolean separate = a.sink.differsBy(θ["p.phase2_shared.separate_candidate_criteria"]);  // src: vulnhunt/phases/phase2_shared.md:40
                if (θ["p.phase2_shared.separate_fix_test"]) separate = separate || !fixOneFixesOther(a, b); // src: vulnhunt/phases/phase2_shared.md:41
                if (!separate) ds.mergeInto(a, b);
            }
        }
        return ds;
    }

    // Step 4: record the disposition, with severity-context and sanitizer-sink match checks.
    Disposition recordDisposition(Input in, Sink s, Theta θ) {
        List<TraceDisposition> allowed = θ["p.phase2_shared.trace_disposition_set"];                    // src: vulnhunt/phases/phase2_shared.md:43
        if (s.isIntendedFunction() && θ["p.phase2_shared.design_intent_definition"]) {                   // src: vulnhunt/phases/phase2_shared.md:46
            return Disposition.of(in, TraceDisposition.DESIGN_INTENT);
        }
        if (s.reason == "sanitized") {
            if (!sanitizerSinkMatch(s, θ)) return Disposition.candidate(in, s);                         // src: vulnhunt/phases/phase2_shared.md:59
        }
        if (s.isSafe()) {
            assert s.reason in θ["p.phase2_shared.safe_reason_set"];                                     // src: vulnhunt/phases/phase2_shared.md:45
            return Disposition.of(in, TraceDisposition.SAFE);
        }
        Candidate c = Candidate.of(in, s);
        c.cwe = severityContextCheck(c, θ);                                                              // src: vulnhunt/phases/phase2_shared.md:47
        return Disposition.candidate(c);
    }

    // Classify under the highest-severity context the sink accepts.
    String severityContextCheck(Candidate c, Theta θ) {
        if (!θ["prompt.severity_context_check"]) return c.cwe;                                           // src: vulnhunt/phases/phase2_shared.md:47
        if (c.sink.modeSelectedByAttacker()) {                                                           // scheme, content-type, extension, format
            if (θ["p.phase2_shared.evaluate_most_dangerous_value"]) c.context = c.sink.mostDangerousAttackerValue(); // src: vulnhunt/phases/phase2_shared.md:50
            if (θ["p.phase2_shared.cite_restriction_or_reclassify_up"] && c.citedRestrictionToLowerContext() == null) { // src: vulnhunt/phases/phase2_shared.md:52
                return c.reclassifyUpward();
            }
        }
        return c.cwe;
    }

    // Sanitizer must cover the sink's dangerous characters; mismatch -> CANDIDATE not SAFE.
    boolean sanitizerSinkMatch(Sink s, Theta θ) {
        if (!θ["p.phase2_shared.sanitizer_sink_match_check"]) return true;                               // src: vulnhunt/phases/phase2_shared.md:54
        if (θ["p.phase2_shared.mismatch_html_sanitizer_url_sink"] && s.sanitizer.isHtml() && s.isUrlSink()) return false; // src: vulnhunt/phases/phase2_shared.md:56
        if (θ["p.phase2_shared.mismatch_url_encoder_sql_cmd"] && s.sanitizer.isUrlEncoder() && (s.isSqlSink() || s.isCommandSink())) return false; // src: vulnhunt/phases/phase2_shared.md:57
        if (θ["p.phase2_shared.mismatch_format_validator_injection"] && s.sanitizer.isFormatValidator() && s.isInjectionSink()) return false; // src: vulnhunt/phases/phase2_shared.md:58
        // θ["p.phase2_shared.mismatch_becomes_candidate"]: caller turns false into CANDIDATE.          // src: vulnhunt/phases/phase2_shared.md:59
        return !θ["p.phase2_shared.mismatch_becomes_candidate"] || s.sanitizer.coversDangerousChars(s);
    }

    // MANDATORY absent-input analysis after the inventory: fail-closed vs fail-open when an input is omitted.
    List<Disposition> absentInputAnalysis(List<Input> inventory, Theta θ) {
        List<Disposition> out = new List();
        if (!θ["prompt.absent_input_analysis"]) return out;                                              // src: vulnhunt/phases/phase2_shared.md:62
        for (Input in : inventory) {
            if (!in.gatesBlockIn(θ["p.phase2_shared.absent_input_scope"])) continue;                    // src: vulnhunt/phases/phase2_shared.md:66
            // "If this input is omitted from the request, does the security check fail closed or fail open?"
            if (!θ["p.phase2_shared.fail_closed_or_open_question"]) continue;                           // src: vulnhunt/phases/phase2_shared.md:69
            CodePath missing = θ["p.phase2_shared.read_missing_input_path"] ? readPathWhenMissing(in) : null; // src: vulnhunt/phases/phase2_shared.md:72
            if (θ["p.phase2_shared.skip_without_else_is_cvb"] && missing.skipsSecurityBlockWithoutDeny()) { // src: vulnhunt/phases/phase2_shared.md:73
                Candidate cvb = Candidate.cvb(in);
                cvb.immuneToDesignIntentAndGate0 = θ["p.phase2_shared.cvb_immune_design_intent_gate0"];  // src: vulnhunt/phases/phase2_shared.md:83
                out.add(Disposition.candidate(cvb));
            }
        }
        return out;
    }

    // Every inventory row must have a disposition before verification.
    void completenessCheck(List<Input> inventory, List<Disposition> ds, Theta θ) {
        if (θ["p.phase2_shared.every_row_has_disposition"]) {                                            // src: vulnhunt/phases/phase2_shared.md:90
            for (Input in : inventory) if (!ds.has(in)) ds.addAll(traceInput(in, null, null, θ));       // src: vulnhunt/phases/phase2_shared.md:91
        }
    }

    // MANDATORY for multi-auth endpoints: each auth branch is a distinct path with four questions.
    List<Disposition> authBranchEnumeration(List<Input> inventory, Theta θ) {
        List<Disposition> out = new List();
        if (!θ["prompt.auth_branch_enumeration"]) return out;                                            // src: vulnhunt/phases/phase2_shared.md:93
        for (EntryPoint ep : inventory.entryPoints().filter(e -> e.hasMultipleAuthBranches())) {
            for (AuthBranch b : ep.authBranches()) {
                b.answer(θ["p.phase2_shared.auth_branch_four_questions"]);                               // src: vulnhunt/phases/phase2_shared.md:96
                // Weaker-credential branch is a distinct finding even behind a caller whitelist.
                if (θ["p.phase2_shared.weaker_branch_distinct_finding"] && b.weakerThanStrongest()) out.add(Disposition.candidate(Candidate.of(b))); // src: vulnhunt/phases/phase2_shared.md:101
            }
        }
        return out;
    }

    // HARD GATES, in order; the first gate that eliminates stops work on the candidate.
    Candidate applyHardGates(Candidate c, ClassGroup cls, ClassGroupRules classRules, Theta θ) {
        List<String> order = θ["prompt.hard_gates"];                                                     // src: vulnhunt/phases/phase2_shared.md:111
        assert order == θ["p.phase2_shared.gates_in_order"];                                             // src: vulnhunt/phases/phase2_shared.md:113
        // Each gate is cheap: θ["prompt.gate_cost"] / θ["p.phase2_shared.gate_cost_and_stop"] tool calls; STOP on elimination.
        int budgetPerGate = θ["p.phase2_shared.gate_cost_and_stop"];                                     // src: vulnhunt/phases/phase2_shared.md:114
        // exemptions summary: θ["prompt.gate_exemptions"]                                                 // src: vulnhunt/phases/phase2_shared.md:83
        if (gate0(c, classRules, θ) == GateOutcome.ELIMINATED) return c.eliminated("Gate 0");            // src: vulnhunt/phases/phase2_shared.md:119
        GateOutcome g1 = gate1(c, θ);                                                                    // src: vulnhunt/phases/phase2_shared.md:150
        if (g1 != GateOutcome.PASS) return c.eliminated("Gate 1");
        if (gate2a(c, θ) == GateOutcome.ELIMINATED) return c.eliminated("Gate 2a");                     // src: vulnhunt/phases/phase2_shared.md:174
        if (gate2b(c, cls, θ) == GateOutcome.ELIMINATED) return c.eliminated("Gate 2b");                // src: vulnhunt/phases/phase2_shared.md:198
        GateOutcome g3 = gate3(c, classRules, θ);                                                        // src: vulnhunt/phases/phase2_shared.md:238
        if (g3 == GateOutcome.ELIMINATED) return c.eliminated("Gate 3");
        if (g3 == GateOutcome.CODE_SMELL) return c.as(θ["p.phase2_shared.gate3_mechanism_only_code_smell"]); // src: vulnhunt/phases/phase2_shared.md:245
        completeInvestigation(c, θ);                                                                     // src: vulnhunt/phases/phase2_shared.md:290
        c.severity = classifySeverity(c, classRules, θ);                                                 // src: vulnhunt/phases/phase2_shared.md:304
        return formatCandidate(c, θ);                                                                    // src: vulnhunt/phases/phase2_shared.md:363
    }

    // When delegating to sub-agents, pass the gates and the exhaust-all-callers rules; unrecorded gates = suspect.
    Prompt delegationRules(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase2_shared.gates_passed_to_subagents"]) p.include(Phase2SharedPrompt.hardGates(θ)); // src: vulnhunt/phases/phase2_shared.md:115
        return p;
    }

    // Used by the sink-driven agent ("include gate results where applicable").
    Map<String, String> recordGateResultsWhereApplicable(Candidate c, Theta θ) {
        if (θ["p.phase2_shared.missing_gate_results_suspect"] && c.gates.isEmpty()) c.suspect = true;   // src: vulnhunt/phases/phase2_shared.md:116
        return c.gates;
    }

    // Gate 0: is this the application doing what it is designed to do?
    GateOutcome gate0(Candidate c, ClassGroupRules classRules, Theta θ) {
        if (!θ["p.phase2_shared.gate0_design_intent"]) return GateOutcome.PASS;                          // src: vulnhunt/phases/phase2_shared.md:119
        // Exemption: CVB findings are immune to DESIGN-INTENT and Gate 0 dismissal...
        if (c.isCvb() && θ["p.phase2_shared.cvb_immune_design_intent_gate0"]) {                          // src: vulnhunt/phases/phase2_shared.md:83
            // ...except a bypass gated by an env-classification var firing only for non-production values -> Gate 1.
            if (c.gatedByEnvVar(θ["p.phase2_shared.cvb_env_var_exception"]) && c.firesOnlyFor(θ["p.phase2_shared.non_production_env_values"])) { // src: vulnhunt/phases/phase2_shared.md:85
                c.forceEliminateAt = θ["p.phase2_shared.cvb_exception_via_gate1"];                       // src: vulnhunt/phases/phase2_shared.md:87
            }
            return GateOutcome.PASS;
        }
        // Gate 0 does NOT apply when designed behaviour is a security check being conditionally skipped.
        if (θ["p.phase2_shared.gate0_not_for_skipped_checks"] && c.isConditionallySkippedSecurityCheck()) return GateOutcome.PASS; // src: vulnhunt/phases/phase2_shared.md:143
        // Design purpose is evaluated before attacker control.
        assert θ["p.phase2_shared.gate0_before_attacker_control"];                                       // src: vulnhunt/phases/phase2_shared.md:121
        boolean intentional = false;
        if (θ["p.phase2_shared.gate0_proxy_forwarding"] && c.isProxyOrGatewayForwardingCallerRequest()) { // src: vulnhunt/phases/phase2_shared.md:127
            intentional = true;
            if (θ["p.phase2_shared.gate0_proxy_exception_trust_metadata"] && c.proxyAddsSpoofableTrustMetadata()) intentional = false; // src: vulnhunt/phases/phase2_shared.md:131
            if (θ["p.phase2_shared.gate0_proxy_exception_incomplete_sanitize"] && c.proxyClaimsSanitizeButIncomplete()) intentional = false; // src: vulnhunt/phases/phase2_shared.md:133
        }
        if (c.inputKindIn(θ["p.phase2_shared.gate0_caller_supplied_params"]) && c.featureForCallersOwnUse()) { // src: vulnhunt/phases/phase2_shared.md:135
            intentional = true;
            if (θ["p.phase2_shared.gate0_authz_boundary_exception"] && c.bypassesAuthorizationBoundary()) intentional = false; // src: vulnhunt/phases/phase2_shared.md:136
        }
        // Decision test: "If I removed this input, would the application lose an intentional feature?"
        if (θ["p.phase2_shared.gate0_decision_test"] && removingInputLosesIntentionalFeature(c)) intentional = true; // src: vulnhunt/phases/phase2_shared.md:140
        // Class-specific Gate 0 exemptions applied after the generic evaluation.
        if (θ["p.phase2_shared.gate0_class_specific_exemptions"] && classRules != null && classRules.gate0Exemption(c)) intentional = false; // src: vulnhunt/phases/phase2_shared.md:147
        if (intentional && θ["p.phase2_shared.gate0_eliminate_intentional_feature"]) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:126
        c.gates.put("Gate 0", "not designed behaviour");
        return GateOutcome.PASS;
    }

    // Gate 1: is the code reachable? Grep all call sites in production sources, exhaust every caller.
    GateOutcome gate1(Candidate c, Theta θ) {
        if (!θ["p.phase2_shared.gate1_reachability"]) return GateOutcome.PASS;                           // src: vulnhunt/phases/phase2_shared.md:150
        // One tool call that must never be skipped: θ["p.phase2_shared.gate1_never_skip"]               // src: vulnhunt/phases/phase2_shared.md:157
        assert θ["p.phase2_shared.gate1_never_skip"] >= 1;                                               // src: vulnhunt/phases/phase2_shared.md:157
        String glob = θ["p.phase2_shared.gate1_glob_restriction"] ? "production extensions, excluding tests" : "*"; // src: vulnhunt/phases/phase2_shared.md:152
        List<CallSite> sites = Tools.call(θ["p.phase2_shared.gate1_grep_call_sites"], c.symbol, glob).excludeTests(); // src: vulnhunt/phases/phase2_shared.md:151
        if (θ["p.phase2_shared.gate1_exhaust_all_callers"]) {                                            // src: vulnhunt/phases/phase2_shared.md:159
            // One dev-only caller plus one production caller => production-reachable.
            if (θ["p.phase2_shared.gate1_mixed_callers_reachable"] && sites.any(s -> s.isProductionReachable())) { // src: vulnhunt/phases/phase2_shared.md:161
                c.gates.put("Gate 1", sites.countProduction() + " production call sites");
                if (c.forceEliminateAt == "Gate 1") return GateOutcome.ELIMINATED;  // CVB env-var exception  // src: vulnhunt/phases/phase2_shared.md:87
                return GateOutcome.PASS;
            }
        }
        // Route registration != reachability: production unless the sink's own source has dev-only guards.
        if (θ["p.phase2_shared.gate1_route_registration_not_reachability"] && θ["p.phase2_shared.gate1_production_by_default"] && !c.sinkSourceHasExplicitDevGuard()) { // src: vulnhunt/phases/phase2_shared.md:164
            if (θ["p.phase2_shared.gate1_research_from_sink"]) {                                         // src: vulnhunt/phases/phase2_shared.md:170
                for (Importer imp : grepImportersTransitively(c.sinkFunction)) {
                    if (imp.isProductionPath()) return GateOutcome.PASS;
                }
            }
        }
        if (θ["p.phase2_shared.gate1_verify_sink_unreachable"] && !c.sinkCodeItselfUnreachable()) return GateOutcome.PASS; // src: vulnhunt/phases/phase2_shared.md:167
        if (θ["p.phase2_shared.gate1_eliminate_only_all_paths"] && !allPathsVerifiedNonProduction(c)) return GateOutcome.PASS; // src: vulnhunt/phases/phase2_shared.md:172
        if (sites.countProduction() == θ["p.phase2_shared.gate1_zero_usages_dead_code"]) {               // src: vulnhunt/phases/phase2_shared.md:155
            // Record "dead code, not a vulnerability"; no tracing, PoC or fix.
            if (θ["p.phase2_shared.gate1_no_work_on_dead_code"]) return GateOutcome.DEAD_CODE;           // src: vulnhunt/phases/phase2_shared.md:156
        }
        return GateOutcome.ELIMINATED;
    }

    // Gate 2a: is the input attacker-controlled? (origin only; no sanitization check here)
    GateOutcome gate2a(Candidate c, Theta θ) {
        if (!θ["p.phase2_shared.gate2a_attacker_controlled"]) return GateOutcome.PASS;                   // src: vulnhunt/phases/phase2_shared.md:174
        if (c.gate2aExempt) return GateOutcome.PASS;  // crypto findings from the sink-driven agent (phase2_hunt.md:176)
        assert θ["p.phase2_shared.gate2a_no_sanitization_check"];                                        // src: vulnhunt/phases/phase2_shared.md:190
        Origin o = c.origin();
        if (θ["p.phase2_shared.gate2a_user_vs_framework_origin"] && o.isFrameworkOrInternalMetadata()) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:180
        if (o.isStore() && θ["p.phase2_shared.gate2a_verify_indirect_control"]) {                        // src: vulnhunt/phases/phase2_shared.md:183
            // user input -> store A -> service -> store B -> sink is still attacker-controlled.
            while (θ["p.phase2_shared.gate2a_multi_hop"] && o.isStore()) {                               // src: vulnhunt/phases/phase2_shared.md:184
                if (o.isIn(θ["p.phase2_shared.gate2a_stop_conditions"])) break;                         // src: vulnhunt/phases/phase2_shared.md:185
                o = o.writers().first();
            }
        }
        if (o.inFramework(θ["p.phase2_shared.gate2a_data_framework_scope"])) {                           // src: vulnhunt/phases/phase2_shared.md:193
            if (θ["p.phase2_shared.gate2a_own_query_self_attack"] && o.isUsersOwnQuery()) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:194
            if (θ["p.phase2_shared.gate2a_store_privilege_check"] && o.storeWriteNeedsEqualOrHigherPrivilege()) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:195
        }
        if (!o.isAttackerControlled() && θ["p.phase2_shared.gate2a_eliminate_if_not_controlled"]) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:189
        c.gates.put("Gate 2a", o.describe());
        return GateOutcome.PASS;
    }

    // Gate 2b: effective, context-matched sanitization between source and sink? Verified empirically.
    GateOutcome gate2b(Candidate c, ClassGroup cls, Theta θ) {
        if (!θ["p.phase2_shared.gate2b_sanitization"]) return GateOutcome.PASS;                          // src: vulnhunt/phases/phase2_shared.md:198
        List<CallSite> callers = θ["p.phase2_shared.gate2b_exhaust_callers"] ? c.sink.allCallSites() : List.of(c.discoveryCaller); // src: vulnhunt/phases/phase2_shared.md:203
        boolean allSanitized = true;
        for (CallSite cs : callers) {
            boolean ok = false;
            for (Defense d : cs.defensesOnFlow()) {
                if (cls == ClassGroup.INJ && θ["p.phase2_shared.gate2b_inj_expanded_procedure"]) {       // src: vulnhunt/phases/phase2_shared.md:231
                    ok = ok || Phase2ClassInj.injGate2b(c.finding, θ);
                    continue;
                }
                ok = ok || defenseEffective(d, c, θ);
            }
            if (!ok) {
                allSanitized = false;
                if (θ["p.phase2_shared.gate2b_each_unsanitized_caller_finding"]) c.splitOff(cs);         // src: vulnhunt/phases/phase2_shared.md:205
            }
        }
        if (allSanitized && θ["p.phase2_shared.gate2b_eliminate_on_effective_defense"]) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:235
        return GateOutcome.PASS;
    }

    boolean defenseEffective(Defense d, Candidate c, Theta θ) {
        if (θ["p.phase2_shared.gate2b_empirical_verification"]) {                                       // src: vulnhunt/phases/phase2_shared.md:208
            if (!d.sourceAvailable()) return θ["p.phase2_shared.gate2b_unavailable_source_ineffective"] != "ineffective"; // (b) src: vulnhunt/phases/phase2_shared.md:214
            if (θ["p.phase2_shared.gate2b_read_defense_source"] && !readSourceConfirmsBlocks(d, c)) return false; // (a) src: vulnhunt/phases/phase2_shared.md:212
        }
        if (θ["p.phase2_shared.gate2b_context_match"] && !d.matchesSinkContext(c.sink)) return false;    // src: vulnhunt/phases/phase2_shared.md:217
        if (c.sink.isUrlConstruction() && !d.neutralizes(θ["p.phase2_shared.gate2b_url_sink_characters"])) return false; // src: vulnhunt/phases/phase2_shared.md:220
        if (d.isLanguageAutoSanitization() && θ["p.phase2_shared.gate2b_language_auto_sanitization"]) return readFrameworkSourceCovers(d, c.sink); // src: vulnhunt/phases/phase2_shared.md:224
        if (d.isDbConstraint()) return d.kindIn(θ["p.phase2_shared.gate2b_db_constraints"]) && readSchemaConfirms(d); // src: vulnhunt/phases/phase2_shared.md:228
        return true;
    }

    // Gate 3: does the attacker gain a NEW capability? Must be shown affirmatively, as an outcome.
    GateOutcome gate3(Candidate c, ClassGroupRules classRules, Theta θ) {
        if (!θ["p.phase2_shared.gate3_new_capability"]) return GateOutcome.PASS;                         // src: vulnhunt/phases/phase2_shared.md:238
        // Exemption: CWE-306/639 immune when baseline derives from all-NONE auth fields -> NAV Missing Auth Assessment.
        if (c.cweIn(θ["p.phase2_shared.gate3_exemption_cwe306_639"]) && c.baselineFromAllNoneAuth()) {   // src: vulnhunt/phases/phase2_shared.md:283
            if (θ["p.phase2_shared.route_to_missing_auth_assessment"]) Phase2ClassNav.missingAuthAssessment(c, θ); // unclear: method name in class file // src: vulnhunt/phases/phase2_shared.md:285
            return GateOutcome.PASS;
        }
        // Speculated defenses (upstream or downstream, infra, containers) never count.
        List<Defense> counted = c.claimedDefenses().filter(d -> defenseCountable(d, θ));                 // src: vulnhunt/phases/phase2_shared.md:268
        // Elimination: a specific file:line path already gives the same outcome.
        if (θ["p.phase2_shared.gate3_eliminate_same_outcome_path"]) {                                    // src: vulnhunt/phases/phase2_shared.md:249
            Location same = null;
            if (θ["p.phase2_shared.gate3_elim_config_setter"] && c.attackerIsConfigSetterWithCodeExecKey()) same = c.citeKeyAndExecCode(); // src: vulnhunt/phases/phase2_shared.md:251
            if (θ["p.phase2_shared.gate3_elim_storage_writer"] && c.attackerCanAlreadyOverwriteDataFiles()) same = c.citeWriteAndReadPath(); // src: vulnhunt/phases/phase2_shared.md:253
            if (θ["p.phase2_shared.gate3_elim_sql_submitter"] && c.attackerCanAlreadyQuerySameTables()) same = c.citeQueryInterface(); // src: vulnhunt/phases/phase2_shared.md:255
            // Same outcome = same data exfiltrated / same command / same service, via a specific existing path.
            if (same != null && θ["p.phase2_shared.gate3_same_outcome_standard"]) {                       // src: vulnhunt/phases/phase2_shared.md:262
                if (!(θ["p.phase2_shared.gate3_class_specific_no_eliminate"] && classRules != null && classRules.gate3DoNotEliminate(c))) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:265
            }
        }
        if (c.provesMechanismOnly(θ["p.phase2_shared.gate3_elim_mechanism_not_outcome"])) return GateOutcome.ELIMINATED; // src: vulnhunt/phases/phase2_shared.md:258
        // Must AFFIRMATIVELY state what the attacker GETS; "found no equivalent path" is not enough.
        if (θ["p.phase2_shared.gate3_affirmative_demonstration"]) {                                      // src: vulnhunt/phases/phase2_shared.md:240
            String gain = c.concreteNewOutcome();
            if (θ["p.phase2_shared.gate3_absence_not_sufficient"] && gain == null) return GateOutcome.CODE_SMELL; // src: vulnhunt/phases/phase2_shared.md:241
            if (θ["p.phase2_shared.gate3_test_proves_outcome"] && !c.exploitTestProvesOutcome()) return GateOutcome.CODE_SMELL; // src: vulnhunt/phases/phase2_shared.md:247
            c.gates.put("Gate 3", gain);
        }
        return GateOutcome.PASS;
    }

    boolean defenseCountable(Defense d, Theta θ) {
        if (θ["p.phase2_shared.no_speculated_defenses"] && d.isSpeculated()) return false;                // src: vulnhunt/phases/phase2_shared.md:268
        if (θ["p.phase2_shared.defenses_need_file_line"] && d.citedFileLine() == null) return false;      // src: vulnhunt/phases/phase2_shared.md:273
        if (d.kindIn(θ["p.phase2_shared.infrastructure_controls_excluded"])) return false;               // src: vulnhunt/phases/phase2_shared.md:275
        if (d.isContainerIsolation() && θ["p.phase2_shared.container_isolation_needs_manifest"] && !(d.manifestInRepo() && d.wiredIntoStartup())) return false; // src: vulnhunt/phases/phase2_shared.md:280
        return true;
    }

    // After all gates: document the flow and re-read the real source.
    void completeInvestigation(Candidate c, Theta θ) {
        if (θ["p.phase2_shared.document_full_data_flow"]) c.dataFlow = c.forwardTrace();                // src: vulnhunt/phases/phase2_shared.md:292
        if (θ["p.phase2_shared.flow_file_line_each_step"]) assert c.dataFlow.everyStepHasFileLine() && c.dataFlow.noSanitization(); // src: vulnhunt/phases/phase2_shared.md:294
        if (θ["p.phase2_shared.read_source_confirm_real"]) {                                             // src: vulnhunt/phases/phase2_shared.md:297
            Source src = θ["p.phase2_shared.read_production_variant"] && buildTimeSwapping() ? c.productionVariant() : c.source(); // src: vulnhunt/phases/phase2_shared.md:298
            src.check(θ["p.phase2_shared.final_source_check_list"]);                                     // src: vulnhunt/phases/phase2_shared.md:300
        }
    }

    // Severity: tier definitions (not CVSS), worst-case caller, one-tier adjustments, floors, narrow exception.
    Severity classifySeverity(Candidate c, ClassGroupRules classRules, Theta θ) {
        assert θ["p.phase2_shared.severity_tiers_not_cvss"];                                             // src: vulnhunt/phases/phase2_shared.md:304
        List<Severity> tiers = θ["prompt.severity_tiers"];                                               // src: vulnhunt/phases/phase2_shared.md:307
        Candidate worst = θ["p.phase2_shared.worst_case_caller_tier"] ? c.worstCaseCaller() : c;          // src: vulnhunt/phases/phase2_shared.md:305
        Severity s;
        if (worst.unauthOrLowPriv() && worst.outcomeIn(θ["p.phase2_shared.tier_high_plus"])) s = Severity.HIGH_PLUS; // src: vulnhunt/phases/phase2_shared.md:307
        else if (worst.outcomeIn(θ["p.phase2_shared.tier_high"])) s = Severity.HIGH;                     // src: vulnhunt/phases/phase2_shared.md:313
        else if (worst.outcomeIn(θ["p.phase2_shared.tier_medium"])) s = Severity.MEDIUM;                 // src: vulnhunt/phases/phase2_shared.md:320
        else if (worst.outcomeIn(θ["p.phase2_shared.tier_low"])) s = Severity.LOW;                       // src: vulnhunt/phases/phase2_shared.md:327
        else s = Severity.LOW;  // unclear: no default tier stated
        // Informational: real authz gap bounded by verifiable upstream trust control (set by phase2b_verify.md section 8).
        if (θ["p.phase2_shared.tier_informational"] && c.boundedByVerifiedUpstreamTrustControl()) {      // src: vulnhunt/phases/phase2_shared.md:333
            s = Severity.INFORMATIONAL;
            if (θ["p.phase2_shared.informational_still_full_finding"]) c.keepIdFlowAndPoc = true;        // src: vulnhunt/phases/phase2_shared.md:335
        }
        int step = θ["p.phase2_shared.adjustment_step_size"];                                            // src: vulnhunt/phases/phase2_shared.md:338
        if (θ["p.phase2_shared.adjustment_auth_axis"]) s = c.unauthenticated() ? up(s, step) : c.adminOnly() ? down(s, step) : s; // src: vulnhunt/phases/phase2_shared.md:338
        if (θ["p.phase2_shared.adjustment_complexity_axis"]) s = c.singleRequest() ? up(s, step) : c.raceOrChainRequired() ? down(s, step) : s; // src: vulnhunt/phases/phase2_shared.md:339
        if (θ["p.phase2_shared.adjustment_blast_radius_axis"]) s = c.allUsersAffected() ? up(s, step) : c.selfOnly() ? down(s, step) : s; // src: vulnhunt/phases/phase2_shared.md:339
        // Floors cannot be undercut by adjustments or speculated limitations; class file may add floors.
        if (θ["p.phase2_shared.severity_floors"]) {                                                      // src: vulnhunt/phases/phase2_shared.md:342
            if (θ["p.phase2_shared.class_specific_floors"] && classRules != null) s = max(s, classRules.severityFloor(c)); // src: vulnhunt/phases/phase2_shared.md:344
        }
        // Only defenses visible and verified in the audited codebase count for severity.
        if (θ["p.phase2_shared.severity_only_verified_defenses"]) c.defenses = c.defenses.filter(d -> defenseCountable(d, θ)); // src: vulnhunt/phases/phase2_shared.md:347
        if (θ["p.phase2_shared.trust_boundary_as_received"] && c.crossesTrustBoundaryWithServiceCreds()) c.assumeDownstreamProcessesAsReceived(); // src: vulnhunt/phases/phase2_shared.md:350
        if (θ["p.phase2_shared.config_weakening_reported"] && c.configWeakensAssumption()) c.reportConfigAsIs(); // src: vulnhunt/phases/phase2_shared.md:352
        // Narrow exception: code cryptographically authenticates the upstream caller (cited at file:line).
        if (c.isIdor() && c.upstreamAuthBy(θ["p.phase2_shared.narrow_exception_crypto_auth"])) {          // src: vulnhunt/phases/phase2_shared.md:356
            boolean qualifies = c.citedAtFileLine();
            if (c.dependencyMatches(θ["p.phase2_shared.gateway_dependency_pattern"])) qualifies = c.middlewareMountCited(); // src: vulnhunt/phases/phase2_shared.md:359
            if (θ["p.phase2_shared.header_presence_not_qualifying"] && (c.onlyHeaderPresenceCheck() || c.onlyCommentsOrNaming())) qualifies = false; // src: vulnhunt/phases/phase2_shared.md:360
            if (qualifies) c.mayDowngradeTo = θ["p.phase2_shared.idor_downgrade_targets"];               // applied by phase2b_verify.md section 8 src: vulnhunt/phases/phase2_shared.md:358
        }
        assert tiers.contains(s);
        return s;
    }

    // Candidate Output Format (unconfirmed; Phase 2b filters).
    Candidate formatCandidate(Candidate c, Theta θ) {
        if (θ["p.phase2_shared.candidates_not_confirmed"]) c.status = "candidate";                       // src: vulnhunt/phases/phase2_shared.md:365
        c.heading = θ["p.phase2_shared.candidate_title_format"];                                         // src: vulnhunt/phases/phase2_shared.md:367
        c.requireFields(θ["p.phase2_shared.candidate_output_fields"]);                                   // src: vulnhunt/phases/phase2_shared.md:368
        c.classField = θ["p.phase2_shared.candidate_class_cwe"];                                         // src: vulnhunt/phases/phase2_shared.md:369
        assert c.severity in θ["p.phase2_shared.candidate_severity_values"];                             // src: vulnhunt/phases/phase2_shared.md:370
        if (θ["p.phase2_shared.gate1_result_call_site_count"]) assert c.gates.get("Gate 1").hasCount(); // src: vulnhunt/phases/phase2_shared.md:373
        if (θ["p.phase2_shared.gate3_result_gain_vs_prereq"]) assert c.gates.get("Gate 3").statesGainVsPrereq(); // src: vulnhunt/phases/phase2_shared.md:376
        if (θ["p.phase2_shared.data_flow_field_file_line"]) assert c.dataFlow.everyStepHasFileLine();    // src: vulnhunt/phases/phase2_shared.md:378
        c.rootCause = limit(c.rootCause, θ["p.phase2_shared.root_cause_length"]);                        // src: vulnhunt/phases/phase2_shared.md:379
        return c;
    }
}

// The prompt text of phase2_shared.md, section by section.
@executedBy(MODEL) @role(prompt) @stage("P2")
class Phase2SharedPrompt {

    Prompt run(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.phase2_shared.class_file_read_after_shared"]);                                       // src: vulnhunt/phases/phase2_shared.md:3
        p.include(iterationRules(θ));
        p.include(absentInput(θ));
        p.include(authBranches(θ));
        p.include(hardGates(θ));
        p.include(severity(θ));
        p.include(outputFormat(θ));
        return p;
    }

    Prompt iterationRules(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.phase2_shared.trace_forward_every_transformation"]);                              // src: vulnhunt/phases/phase2_shared.md:9
        p.rule(θ["p.phase2_shared.outcome_sink_without_sanitization"]);                                  // src: vulnhunt/phases/phase2_shared.md:11
        p.rule(θ["p.phase2_shared.outcome_sanitized_before_every_sink"]);                                // src: vulnhunt/phases/phase2_shared.md:12
        p.rule(θ["p.phase2_shared.outcome_exits_codebase"]);                                             // src: vulnhunt/phases/phase2_shared.md:13
        p.must(θ["p.phase2_shared.store_boundary_trace_all_readers"]);                                   // src: vulnhunt/phases/phase2_shared.md:14
        p.forbid(θ["p.phase2_shared.no_no_match_at_store"]);                                             // src: vulnhunt/phases/phase2_shared.md:16
        p.must(θ["p.phase2_shared.exhaust_store_consumers"]);                                            // src: vulnhunt/phases/phase2_shared.md:17
        p.rule(θ["p.phase2_shared.boolean_gate_trap"]);                                                  // src: vulnhunt/phases/phase2_shared.md:19
        p.must(θ["p.phase2_shared.request_body_gate_nav"]);                                              // src: vulnhunt/phases/phase2_shared.md:23
        p.rule(θ["p.phase2_shared.request_body_cross_class_flag"]);                                      // src: vulnhunt/phases/phase2_shared.md:26
        p.must(θ["p.phase2_shared.resource_id_gate_nav"]);                                               // src: vulnhunt/phases/phase2_shared.md:29
        p.rule(θ["p.phase2_shared.resource_id_cross_class_flag"]);                                       // src: vulnhunt/phases/phase2_shared.md:32
        p.step(2, θ["p.phase2_shared.check_all_code_paths"]);                                            // src: vulnhunt/phases/phase2_shared.md:36
        p.step(3, θ["prompt.continue_past_first_finding"]);                                              // src: vulnhunt/phases/phase2_shared.md:38
        p.rule(θ["p.phase2_shared.separate_candidate_criteria"]);                                        // src: vulnhunt/phases/phase2_shared.md:40
        p.tiebreak(θ["p.phase2_shared.separate_fix_test"]);                                              // src: vulnhunt/phases/phase2_shared.md:41
        p.choose(θ["p.phase2_shared.trace_disposition_set"]);                                            // src: vulnhunt/phases/phase2_shared.md:43
        p.choose(θ["p.phase2_shared.safe_reason_set"]);                                                  // src: vulnhunt/phases/phase2_shared.md:45
        p.rule(θ["p.phase2_shared.design_intent_definition"]);                                           // src: vulnhunt/phases/phase2_shared.md:46
        p.must(θ["prompt.severity_context_check"]);                                                      // src: vulnhunt/phases/phase2_shared.md:47
        p.rule(θ["p.phase2_shared.evaluate_most_dangerous_value"]);                                      // src: vulnhunt/phases/phase2_shared.md:50
        p.evidence(θ["p.phase2_shared.cite_restriction_or_reclassify_up"]);                              // src: vulnhunt/phases/phase2_shared.md:52
        p.must(θ["p.phase2_shared.sanitizer_sink_match_check"]);                                         // src: vulnhunt/phases/phase2_shared.md:54
        p.rule(θ["p.phase2_shared.mismatch_html_sanitizer_url_sink"]);                                   // src: vulnhunt/phases/phase2_shared.md:56
        p.rule(θ["p.phase2_shared.mismatch_url_encoder_sql_cmd"]);                                       // src: vulnhunt/phases/phase2_shared.md:57
        p.rule(θ["p.phase2_shared.mismatch_format_validator_injection"]);                                // src: vulnhunt/phases/phase2_shared.md:58
        p.rule(θ["p.phase2_shared.mismatch_becomes_candidate"]);                                         // src: vulnhunt/phases/phase2_shared.md:59
        p.rule(θ["p.phase2_shared.batch_by_entry_point"]);                                               // src: vulnhunt/phases/phase2_shared.md:104
        p.must(θ["p.phase2_shared.every_input_resolved"]);                                               // src: vulnhunt/phases/phase2_shared.md:105
        p.forbid(θ["prompt.tracing_direction"]);                                                         // src: vulnhunt/phases/phase2_shared.md:107
        return p;
    }

    Prompt absentInput(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["prompt.absent_input_analysis"]);                                                       // src: vulnhunt/phases/phase2_shared.md:62
        p.checklist(θ["p.phase2_shared.absent_input_scope"]);                                            // src: vulnhunt/phases/phase2_shared.md:66
        p.rule(θ["p.phase2_shared.fail_closed_or_open_question"]);                                       // src: vulnhunt/phases/phase2_shared.md:69
        p.must(θ["p.phase2_shared.read_missing_input_path"]);                                            // src: vulnhunt/phases/phase2_shared.md:72
        p.rule(θ["p.phase2_shared.skip_without_else_is_cvb"]);                                           // src: vulnhunt/phases/phase2_shared.md:73
        p.exemption(θ["prompt.gate_exemptions"]);                                                        // src: vulnhunt/phases/phase2_shared.md:83
        p.exemption(θ["p.phase2_shared.cvb_immune_design_intent_gate0"]);                                // src: vulnhunt/phases/phase2_shared.md:83
        p.exemption(θ["p.phase2_shared.cvb_env_var_exception"]);                                         // src: vulnhunt/phases/phase2_shared.md:85
        p.context(θ["p.phase2_shared.non_production_env_values"]);                                       // src: vulnhunt/phases/phase2_shared.md:86
        p.rule(θ["p.phase2_shared.cvb_exception_via_gate1"]);                                            // src: vulnhunt/phases/phase2_shared.md:87
        p.must(θ["p.phase2_shared.every_row_has_disposition"]);                                          // src: vulnhunt/phases/phase2_shared.md:90
        return p;
    }

    Prompt authBranches(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["prompt.auth_branch_enumeration"]);                                                     // src: vulnhunt/phases/phase2_shared.md:93
        p.checklist(θ["p.phase2_shared.auth_branch_four_questions"]);                                    // src: vulnhunt/phases/phase2_shared.md:96
        p.rule(θ["p.phase2_shared.weaker_branch_distinct_finding"]);                                     // src: vulnhunt/phases/phase2_shared.md:101
        return p;
    }

    Prompt hardGates(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["prompt.hard_gates"]);                                                                  // src: vulnhunt/phases/phase2_shared.md:111
        p.must(θ["p.phase2_shared.gates_in_order"]);                                                     // src: vulnhunt/phases/phase2_shared.md:113
        p.threshold(θ["prompt.gate_cost"]);                                                              // src: vulnhunt/phases/phase2_shared.md:113
        p.threshold(θ["p.phase2_shared.gate_cost_and_stop"]);                                            // src: vulnhunt/phases/phase2_shared.md:114
        p.must(θ["p.phase2_shared.gates_passed_to_subagents"]);                                          // src: vulnhunt/phases/phase2_shared.md:115
        p.rule(θ["p.phase2_shared.missing_gate_results_suspect"]);                                       // src: vulnhunt/phases/phase2_shared.md:116
        p.include(gate0(θ));
        p.include(gate1(θ));
        p.include(gate2a(θ));
        p.include(gate2b(θ));
        p.include(gate3(θ));
        return p;
    }

    Prompt gate0(Theta θ) {
        Prompt p = new Prompt();
        p.step(0, θ["p.phase2_shared.gate0_design_intent"]);                                             // src: vulnhunt/phases/phase2_shared.md:119
        p.rule(θ["p.phase2_shared.gate0_before_attacker_control"]);                                      // src: vulnhunt/phases/phase2_shared.md:121
        p.rule(θ["p.phase2_shared.gate0_eliminate_intentional_feature"]);                                // src: vulnhunt/phases/phase2_shared.md:126
        p.rule(θ["p.phase2_shared.gate0_proxy_forwarding"]);                                             // src: vulnhunt/phases/phase2_shared.md:127
        p.exemption(θ["p.phase2_shared.gate0_proxy_exception_trust_metadata"]);                          // src: vulnhunt/phases/phase2_shared.md:131
        p.exemption(θ["p.phase2_shared.gate0_proxy_exception_incomplete_sanitize"]);                     // src: vulnhunt/phases/phase2_shared.md:133
        p.rule(θ["p.phase2_shared.gate0_caller_supplied_params"]);                                       // src: vulnhunt/phases/phase2_shared.md:135
        p.exemption(θ["p.phase2_shared.gate0_authz_boundary_exception"]);                                // src: vulnhunt/phases/phase2_shared.md:136
        p.tiebreak(θ["p.phase2_shared.gate0_decision_test"]);                                            // src: vulnhunt/phases/phase2_shared.md:140
        p.exemption(θ["p.phase2_shared.gate0_not_for_skipped_checks"]);                                  // src: vulnhunt/phases/phase2_shared.md:143
        p.rule(θ["p.phase2_shared.gate0_class_specific_exemptions"]);                                    // src: vulnhunt/phases/phase2_shared.md:147
        return p;
    }

    Prompt gate1(Theta θ) {
