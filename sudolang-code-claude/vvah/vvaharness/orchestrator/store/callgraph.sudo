# vvaharness/orchestrator/store/callgraph.py

Per-run snapshots of the entry-point and sink index produced by Stages 0 and 1, stored as rows and bound to the stage that produced them. `scan.py` reads them back to fill `ctx.call_graph` for later prompts.

Source: `vvaharness/orchestrator/store/callgraph.py` (lines 1-164)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (`save_callgraph` after each stage, `load_callgraph` via `_hydrate_ctx_callgraph_from_store`)

// src: vvaharness/orchestrator/store/callgraph.py:80-139
fn save_callgraph(run_id, step, obj):executor=code {
  node_rows = _graph_rows(obj)
  if (node_rows == null) return null   // obj has no entry points and no sinks: nothing is bound for this step
  graph_id = sha256(canonical JSON of { nodes: node_rows })[:32]   // content-addressed: identical graphs share one snapshot
  in one transaction {
    insert runs(run_id) if absent; set updated_at = now
    if (no snapshot (run_id, graph_id)) insert the snapshot (edge_count = 0) and its node rows
    insert or replace callgraph_stage_refs(run_id, step, graph_id)
  }
  return graph_id
}

// src: vvaharness/orchestrator/store/callgraph.py:37-77
fn _graph_rows(obj):executor=code {
  if (obj has no entry_points and no unsafe_sinks) return null
  entry_meta = for each entry point with a qnode "file::function": (kind, reachable_from_unauth as 0 or 1)
  sink_meta = for each sink with a qnode: the smallest non-zero line seen
  return one row per qnode in sorted(entry qnodes union sink qnodes) with is_entry_point, entry_kind, reachable_from_unauth, is_sink, sink_line
}

// src: vvaharness/orchestrator/store/callgraph.py:142-164
fn load_callgraph(run_id, step):executor=code {
  graph_id = callgraph_stage_refs for (run_id, step); if (none) return null
  return { graph_id, call_graph: { qnode: [] for each node row }, node_count }
  // preserved: the stored index has no edges, so a hydrated ctx.call_graph maps every node to an empty callee list; scan.py replaces ctx.call_graph with this edge-less index
}

// abstracted: callgraph.py:23-34 (_qnode joins file and function with "::" using forward slashes; _split_qnode splits on the LAST "::" so names containing "::" stay intact).
