# vvaharness/skills/ssrf/probe.sh

SSRF probe: fetch sinks across seven ecosystems, indirect fetch mechanisms, url-parameter helper contracts and their call sites, request sources, redirect and allow-list posture, and reference tables printed only when an earlier section matched.

Source: `vvaharness/skills/ssrf/probe.sh` (lines 1-174)
Executor: code (POSIX shell; read-only greps; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/ssrf/probe.sh [subtree]`, because the lens SKILL.md or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 5-17 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints `path:line` hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/ssrf/probe.sh:19-174
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/ssrf/probe.sh:19-73 — setup, the two helpers and the ecosystem include lists
  shell globbing off (set -f)
  CAP = SSRF_PROBE_CAP or 12   // line 21; used by the sections up to line 120, then reset to 8 at line 123
  WIDTH = 140
  EX = exclude directories .git, node_modules, .venv, venv, .tox, dist, build, __pycache__, site-packages, .mypy_cache, target, .next, coverage, .vvaharness, security-scan; exclude files SKILL.md, probe.sh
  FOUND = unset

  scan(label, includeGlobs, pattern) {
    // grep -rEn, case-sensitive
    if (no match) print "(none)"
    else { FOUND = 1; print first CAP hits cut to WIDTH; if (total > CAP) print "... <total> hits total, showing <CAP> - grep this pattern yourself for the rest" }
  }
  count(label, includeGlobs, pattern) {
    // prints "<n> hits; sample:" and the first 3 hits; does not set FOUND
  }
  PY = *.py *.pyi;  JS = *.js *.jsx *.ts *.tsx *.mjs *.cjs *.vue *.svelte;  JV = *.java *.kt *.kts *.scala *.groovy
  RB = *.rb *.rake *.erb Gemfile Rakefile;  PH = *.php *.phtml *.inc;  GO = *.go;  NET = *.cs *.vb *.fs *.fsx

  // src: vvaharness/skills/ssrf/probe.sh:78-79
  scan("PYTHON FETCH SINKS")
  // pattern and arguments, verbatim: "$PY" 'requests\.(get|post|put|patch|delete|head|request)|Session\(\)?\.(get|post|request)|httpx\.(get|post|request|stream|Client|AsyncClient)|urllib\.request|urlopen|urlretrieve|http\.client\.HTTP|aiohttp\.(ClientSession|request)|pycurl|socket\.(connect|create_connection)|smtplib\.|ftplib\.'
  // src: vvaharness/skills/ssrf/probe.sh:81-82
  scan("JS/TS FETCH SINKS")
  // pattern and arguments, verbatim: "$JS" '\bfetch\(|axios[.(]|node-fetch|undici|require\(.got.\)|from .got.|\bsuperagent|\bhttps?\.(get|request)\(|\.goto\(|new URL\([^)]*(url|uri|src|input|req)'
  // src: vvaharness/skills/ssrf/probe.sh:84-85
  scan("JAVA/KOTLIN FETCH SINKS")
  // pattern and arguments, verbatim: "$JV" 'OkHttpClient|Request\.Builder|HttpRequest\.newBuilder|RestTemplate|WebClient\.|HttpClient\.(send|newHttpClient)|new URL\(|openConnection\(|HttpGet|HttpPost|URI\.create|Jsoup\.connect'
  // src: vvaharness/skills/ssrf/probe.sh:87-88
  scan("RUBY FETCH SINKS")
  // pattern and arguments, verbatim: "$RB" 'Net::HTTP|URI\.(open|parse)|open-uri|Faraday|HTTParty|RestClient|Excon|Typhoeus'
  // src: vvaharness/skills/ssrf/probe.sh:90-91
  scan("PHP FETCH SINKS")
  // pattern and arguments, verbatim: "$PH" 'curl_(init|setopt|exec)|CURLOPT_URL|file_get_contents\s*\(|fopen\s*\(|GuzzleHttp|Guzzle\\|Http::(get|post)|readfile\s*\('
  // src: vvaharness/skills/ssrf/probe.sh:93-94
  scan("GO FETCH SINKS")
  // pattern and arguments, verbatim: "$GO" 'http\.(Get|Post|Head|PostForm|NewRequest|NewRequestWithContext)|\.Client\{|[Cc]lient\.Do\(|resty\.|net\.Dial'
  // src: vvaharness/skills/ssrf/probe.sh:96-97
  scan(".NET FETCH SINKS")
  // pattern and arguments, verbatim: "$NET" 'HttpClient|WebRequest\.Create|WebClient|HttpWebRequest|GetStringAsync|(Get|Post|Send)Async\(|DownloadString'
  // src: vvaharness/skills/ssrf/probe.sh:99-100
  scan("INDIRECT FETCH MECHANISMS (render/XXE/image/db)")
  // pattern and arguments, verbatim: "" 'wkhtmltopdf|WeasyPrint|puppeteer|playwright|pdfkit|imgkit|ImageMagick|wand\.image|pyvips|libvips|rsvg|cairosvg|postgres_fdw|dblink|resolve_entities|XMLResolver|DocumentBuilderFactory|SAXParser|etree\.(parse|fromstring)|libxml|xmlrpc|SimpleXML|LOAD DATA'
  // src: vvaharness/skills/ssrf/probe.sh:102-103
  scan("URL-PARAMETER CONTRACTS (opaque fetch helpers - sink even with an empty body)")
  // pattern and arguments, verbatim: "" '(def|function|func|fun|sub|public|private|protected|static)[^();]*\(([^)]*[^A-Za-z_])?(url|uri|src|source_url|endpoint|callback|callback_url|webhook|webhook_url|href|link|target_url|remote|image_url|feed_url)([^A-Za-z_][^)]*)?\)'
  // src: vvaharness/skills/ssrf/probe.sh:105-106
  scan("FETCH-NAMED HELPERS (name is the contract)")
  // pattern and arguments, verbatim: "" '(def|function|func|fun|public|private|static)[^();]*\b\w*(download|fetch|get_image|get_base64|load_url|loadUrl|import_|render_|screenshot|thumbnail|thumb|preview|unfurl|oembed|proxy_|passthrough|health_?check|test_connection|avatar|favicon|scrape|crawl|mirror|webhook)\w*\s*\('
  // src: vvaharness/skills/ssrf/probe.sh:108-117 — call sites of fetch-named helpers
  print "== CALL SITES OF FETCH-NAMED HELPERS (anchor the finding here, not at the def) =="
  calls = grep -rEn over every file (no include filter) for the pattern below, then drop lines matching '\b(def|function|func|fun|sub)\b'
  // pattern, verbatim: '\b\w*(download|fetch|get_image|get_base64|load_url|loadUrl|import_url|import_from|render_url|render_pdf|screenshot|thumbnail|thumb|preview|unfurl|oembed|proxy_|passthrough|scrape|crawl|mirror|send_webhook|call_webhook)\w*\s*\('
  if (calls empty) print "(none)" else print the first CAP lines cut to WIDTH   // no total-count line; does not set FOUND
  // src: vvaharness/skills/ssrf/probe.sh:119-120
  scan("REQUEST SOURCES ON URL-SHAPED NAMES")
  // pattern and arguments, verbatim: "" '(request\.(args|form|json|values|data|GET|POST|query_params|get_json|headers)|req\.(query|body|params)|\$_(GET|POST|REQUEST)|params\[|form\.\w+\.data|@RequestParam|@RequestBody|@PathVariable|ctx\.(query|request)|c\.Query|r\.(URL|FormValue))[^;]*(url|uri|src|endpoint|callback|webhook|host|link|href|target|image|avatar|feed|address)'
  // src: vvaharness/skills/ssrf/probe.sh:122-123
  SINKS = FOUND   // set when any scan() above printed a hit
  CAP = 8         // the posture section below shows at most 8 lines
  // src: vvaharness/skills/ssrf/probe.sh:124-125
  scan("REDIRECT / RESOLUTION / ALLOW-LIST POSTURE (empty = gate condition (c) unmet by default)")
  // pattern and arguments, verbatim: "" 'allow_redirects|follow_redirects|followRedirects|CURLOPT_FOLLOWLOCATION|redirect:\s*.(follow|manual|error)|max_redirects|getaddrinfo|gethostbyname|InetAddress\.getByName|ip_address\(|ipaddress\.|is_private|is_loopback|is_global|urlparse|urlsplit|\.hostname|allow_?list|allowed_?hosts|ALLOWED_HOSTS|whitelist|blocklist|deny_?list|blacklist|proxies\s*=|advocate|validators\.url|URLField|URLValidator'
  // src: vvaharness/skills/ssrf/probe.sh:127-128
  count("INTERNAL-TARGET AND SCHEME STRINGS PRESENT IN TREE")
  // pattern and arguments, verbatim: "" '169\.254\.169\.254|metadata\.google\.internal|100\.100\.200\.200|127\.0\.0\.1|localhost|0\.0\.0\.0|::1|svc\.cluster\.local|\.internal\b|192\.168\.|10\.[0-9]+\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.|file://|gopher://|dict://|ldap://|jar:|netdoc:'
  // preserved: SINKS is set when ANY scan() up to line 120 matched, including "URL-PARAMETER CONTRACTS", "FETCH-NAMED HELPERS" and "REQUEST SOURCES ON URL-SHAPED NAMES"; the comment at line 144 says "a sink or a url-contract helper", and the SKILL says the tables print "only when a sink exists".

  // src: vvaharness/skills/ssrf/probe.sh:130-142
  print "== DECLARED HTTP-CLIENT DEPENDENCIES (absence NEVER refutes a fetch sink) =="
  grep manifests (requirements*.txt, pyproject.toml, setup.py, Pipfile, package.json, pom.xml, build.gradle*, go.mod, Gemfile, composer.json, *.csproj) for 'requests|httpx|aiohttp|urllib3|pycurl|axios|node-fetch|got|undici|superagent|okhttp|httpclient|resttemplate|webflux|faraday|httparty|rest-client|guzzle|curl'
  if (none) print "(none) - no HTTP client declared; a url-parameter helper is STILL a sink" else print the first 12

  // src: vvaharness/skills/ssrf/probe.sh:144-171
  if (SINKS) {
    print fixed reference tables:
      "REFERENCE: bypasses to name against any host check or deny-list above"   // decimal, octal, hex, short and IPv4-mapped loopback; credentials prefix; trailing dot; mixed-case scheme; attacker DNS (127.0.0.1.nip.io); percent-encoded or IDN host; fragment trick
      "REFERENCE: redirect following (the allow-list must re-run on EVERY hop)"   // on by default: requests, urllib urlopen, JS fetch, OkHttp; commonly switched on: httpx follow_redirects, HttpClient followRedirects(ALWAYS), CURLOPT_FOLLOWLOCATION
      "REFERENCE: check-then-fetch races (TOCTOU / DNS rebinding)"
      "REFERENCE: internal targets to name, highest impact first"   // cloud metadata endpoints (AWS, Google, Azure, Alibaba), private address space, admin ports 2375 6379 9200 8500 10250 5432 3306 15672 9090, schemes file gopher dict ftp ldap jar netdoc
  }

  // src: vvaharness/skills/ssrf/probe.sh:173-174
  print "### END SSRF PROBE"; exit 0
}
