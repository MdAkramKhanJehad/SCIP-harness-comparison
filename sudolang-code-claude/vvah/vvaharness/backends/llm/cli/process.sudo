# vvaharness/backends/llm/cli/process.py

Launches one `claude` subprocess, either buffered (with a progress heartbeat) or streaming line by line (for the live trace and the turn watchdog), and enforces the wall-clock limit and Ctrl-C abort on it.

Source: `vvaharness/backends/llm/cli/process.py` (lines 1-266)
Executor: code
Called from: `cli/retry.sudo` `_run_with_retry`; `cli/session.sudo` `_finalize_via_resume` (directly, without retry)

// src: vvaharness/backends/llm/cli/process.py:37-108
fn _run(cmd, input?, cwd?, timeout=600, env?, heartbeat_label?, heartbeat_interval=300, stream_cb?, should_stop?):executor=code {
  proc_env = { ...os.environ, ...env._tls_extra, ...(env || {}) }   // ambient environment is inherited in full; later entries win
  if (stream_cb != null || should_stop != null) {
    return _run_streaming(cmd, input, cwd, timeout, proc_env, stream_cb || ignore, should_stop)   // a watchdog alone still needs the line reader
  }
  deadline = now + timeout
  pending_input = input
  proc = start cmd in cwd with proc_env, stdin piped only when input given, stdout and stderr captured as UTF-8 (invalid bytes replaced), in its own process group (cancel._NEW_GROUP_KW)
  add proc to cancel._LIVE under the lock
  constraint OnEveryExit { remove proc from cancel._LIVE under the lock }
  try {
    loop {
      if (cancel._ABORT is set) { cancel._kill_tree(proc); collect output; throw RuntimeError("aborted by user (Ctrl-C)") }
      remaining = deadline - now
      if (remaining <= 0) {
        cancel._stop_tree(proc, TIMEOUT_STOP_GRACE_SECONDS)   // 20 seconds of SIGINT grace, then SIGKILL of the tree
        collect output
        throw subprocess.TimeoutExpired(cmd, timeout, output, stderr)
      }
      try { [out, err] = proc.communicate(input=pending_input, timeout=min(heartbeat_interval, remaining)); break }
      catch TimeoutExpired => {
        if (heartbeat_label) console "[cli] $heartbeat_label still running... Ns elapsed"
        pending_input = null   // input is written only once
      }
    }
  }
  catch KeyboardInterrupt => { set cancel._ABORT; cancel._kill_tree(proc); wait up to 2 seconds; throw }
  return CompletedProcess(args, returncode, out, err)
}

// src: vvaharness/backends/llm/cli/process.py:111-202
fn _run_streaming(cmd, input, cwd, timeout, proc_env, stream_cb, should_stop?):executor=code {
  // Both pipes are drained in threads, or the 64KB stderr buffer deadlocks the child
  chunks = []; err_chunks = []; stopped = false
  proc = start cmd as in _run, line-buffered, in its own process group
  add proc to cancel._LIVE under the lock
  start stdout reader thread: for each line {
    append to chunks
    try stream_cb(line); catch => ignore
    if (should_stop != null && !stopped) {
      try { if (should_stop(line)) { stopped = true; cancel._kill_tree(proc) } } catch => ignore   // the turn watchdog kills per line
    }
  }
  start stderr reader thread appending to err_chunks
  constraint OnEveryExit { remove proc from cancel._LIVE under the lock }
  try {
    if (input != null) { write input to stdin and close it; ignore BrokenPipeError }
    try proc.wait(timeout)
    catch TimeoutExpired => {
      cancel._stop_tree(proc, TIMEOUT_STOP_GRACE_SECONDS)
      join both readers up to 2 seconds each
      throw subprocess.TimeoutExpired(cmd, timeout, output=joined chunks, stderr=joined err_chunks)
    }
  }
  catch KeyboardInterrupt => { set cancel._ABORT; cancel._kill_tree(proc); throw }
  join both readers up to 5 seconds each
  result = CompletedProcess(cmd, returncode, joined chunks, joined err_chunks)
  if (stopped) add id(result) to _WATCHDOG_STOPPED   // marked before any return-code check: the kill exits non-zero and would read as a CLI failure
  return result
  // preserved: unlike _run, this path does not poll cancel._ABORT while waiting; an abort reaches it only through cancel.abort() killing every process in _LIVE
}

// src: vvaharness/backends/llm/cli/process.py:205-215
State { _WATCHDOG_STOPPED: set of result ids }
fn _was_stopped(result):executor=code {
  if (id(result) in _WATCHDOG_STOPPED) { remove it; return true }   // consumes the mark
  return false
}

