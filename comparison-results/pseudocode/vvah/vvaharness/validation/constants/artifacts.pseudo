// file: vvaharness/validation/constants/artifacts.py
// Single source of truth for S11 artifact names, the validatable case states, files excluded from the
// staged workspace, env-key names, and the default agent runtime values (fallbacks of step_validate knobs).

@executedBy(CODE) @role(config) @stage("S11")
class ConstantsArtifacts {

    String MANIFEST_FILENAME = "manifest.json";                                                       // src: vvaharness/validation/constants/artifacts.py:24
    String DIFF_FILENAME = "diff.patch";                                                             // src: vvaharness/validation/constants/artifacts.py:26
    String VALIDATION_REPORT_FILENAME = "validation_report.json";                                    // src: vvaharness/validation/constants/artifacts.py:27
    String SYNTHESIZED_GATES_FILENAME = "synthesized_gates.json";                                    // src: vvaharness/validation/constants/artifacts.py:28
    String REMEDIATION_DIRNAME = "security-remediation";                                             // src: vvaharness/validation/constants/artifacts.py:31
    String FINDING_CASE_GLOB = "security-remediation/*/finding_case.json";                          // case discovery glob  // src: vvaharness/validation/constants/artifacts.py:33
    String SCAN_DIRNAME = "security-scan";                                                           // read-only for the validator  // src: vvaharness/validation/constants/artifacts.py:43
    String SCAN_REPORT_GLOB = "*_report.sarif";                                                      // src: vvaharness/validation/constants/artifacts.py:44
    String MCP_CONFIG_FILENAME = ".mcp.json";                                                        // src: vvaharness/validation/constants/artifacts.py:64
    String SESSION_LOG_FILENAME = "session.jsonl";                                                   // src: vvaharness/validation/constants/artifacts.py:119
    String VALIDATOR_HINTS_FILENAME = "validator_hints.yaml";                                        // src: vvaharness/validation/constants/artifacts.py:148
    String MISSING_FIELD_PLACEHOLDER = "N/A";                                                        // src: vvaharness/validation/constants/artifacts.py:152
    int CMD_PREVIEW_LEN = 80;                                                                        // log preview only  // src: vvaharness/validation/constants/artifacts.py:124
    int STDERR_TAIL_LINES = 3;                                                                       // log tail only  // src: vvaharness/validation/constants/artifacts.py:125
    String BACKEND_OPENAI = "openai";                                                                // legacy route, rerouted to deepagents  // src: vvaharness/validation/constants/artifacts.py:102
    String BACKEND_DEEPAGENTS = "deepagents";                                                        // src: vvaharness/validation/constants/artifacts.py:103
    List<String> VALIDATE_COMMANDS = List.of("validate", "s11");                                     // src: vvaharness/validation/constants/artifacts.py:112

    Set<CaseState> validatableStates(Theta θ) {
        return θ["code.validation.constants.artifacts.validatable_states"];                         // OPEN, REMEDIATED, FAILED  // src: vvaharness/validation/constants/artifacts.py:36
    }

    List<String> excludedFromStaging(Theta θ) {
        List<String> out = θ["code.validation.constants.artifacts.agent_instruction_filenames"];    // CLAUDE.md, AGENTS.md, ... never staged  // src: vvaharness/validation/constants/artifacts.py:54
        if (θ["code.validation.constants.artifacts.exclude_mcp_config"]) out.add(MCP_CONFIG_FILENAME); // defence in depth  // src: vvaharness/validation/constants/artifacts.py:64
        return out;
    }

    AgentDefaults agentDefaults(Theta θ) {
        AgentDefaults d = new AgentDefaults();
        d.binary = "claude";                                                                         // src: vvaharness/validation/constants/artifacts.py:128
        d.model = θ["models.validate.orchestrator.id"];                                              // DEFAULT_MODEL claude-opus-4-8[1m]  // src: vvaharness/validation/constants/artifacts.py:129
        d.maxTurns = θ["step_validate.max_turns"];                                                   // src: vvaharness/validation/constants/artifacts.py:130
        d.via = θ["models.validate.orchestrator.via"];                                               // src: vvaharness/validation/constants/artifacts.py:131
        d.maxBudgetUsd = θ["step_validate.max_budget_usd"];                                          // src: vvaharness/validation/constants/artifacts.py:132
        d.maxFindings = θ["step_validate.max_findings"];                                             // src: vvaharness/validation/constants/artifacts.py:133
        d.effort = θ["step_validate.effort"];                                                        // src: vvaharness/validation/constants/artifacts.py:134
        d.timeoutS = θ["step_validate.timeout"];                                                     // src: vvaharness/validation/constants/artifacts.py:136
        d.personaMaxModelCalls = θ["step_validate.max_model_calls"];                                 // 0 = unmetered  // src: vvaharness/validation/constants/artifacts.py:138
        d.orchestratorMaxModelCalls = θ["step_validate.orchestrator_max_model_calls"];               // 0 = unmetered  // src: vvaharness/validation/constants/artifacts.py:140
        return d;
    }
}

@executedBy(CODE) @role(types)
record AgentDefaults(String binary, String model, int maxTurns, String via, double maxBudgetUsd, int maxFindings, EffortLevel effort, int timeoutS, int personaMaxModelCalls, int orchestratorMaxModelCalls) { }
