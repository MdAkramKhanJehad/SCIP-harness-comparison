// file: vvaharness/orchestrator/store/replays.py
// Exploit-verification replay bundles and probe logs, per run (storage only; EV logic is out of scope).

@executedBy(CODE) @role(io)
class Replays {

    // ev_probes columns in insert order; omitted -> NULL, extra -> ignored (caller not trusted)    // src: vvaharness/orchestrator/store/replays.py:101
    List<String> EV_PROBE_COLS = List.of("finding_key", "finding_title", "file", "line_start", "line_end", "cwe", "vuln_class",
        "ev_class", "ev_subtype", "ev_verdict", "endpoint_method", "endpoint_path", "payload_label", "injection_point",
        "req_method", "req_url", "req_query", "req_body", "authed", "auth_applied", "resp_status", "resp_ms", "resp_snippet"); // src: vvaharness/orchestrator/store/replays.py:101

    /** Replace this run's replay bundles; call only when EV ran. Oversized blobs are skipped. */
    int saveReplays(String runId, List<Pair<String, byte[]>> items) {
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/replays.py:29
        int written = 0;
        try {
            con.transaction(() -> {
                con.execute("INSERT OR IGNORE INTO runs ...; UPDATE runs SET updated_at", runId);     // src: vvaharness/orchestrator/store/replays.py:33
                con.execute("DELETE FROM ev_replays WHERE run_id = ?", runId);                       // src: vvaharness/orchestrator/store/replays.py:37
                for (Pair<String, byte[]> it : items) {
                    if (it.second.length > Db.REPLAY_MAX_BYTES) { Log.warning("REPLAY_TOO_LARGE"); continue; } // 1 MiB cap (store/_db.py:30) // src: vvaharness/orchestrator/store/replays.py:39
                    con.execute("INSERT OR REPLACE INTO ev_replays", runId, it.first, it.second, it.second.length); // src: vvaharness/orchestrator/store/replays.py:43
                    written += 1;                                                                      // src: vvaharness/orchestrator/store/replays.py:46
                }
            });
        } finally { con.close(); }
        return written;                                                                                // src: vvaharness/orchestrator/store/replays.py:49
    }

    /** Drop replay bundles whose finding_key is not kept; call only post-dedup (empty keep clears all). */
    int pruneReplays(String runId, Set<String> keepKeys) {
        Set<String> keep = keepKeys != null ? keepKeys : Set.of();                                    // src: vvaharness/orchestrator/store/replays.py:55
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/replays.py:57
        List<String> stale;
        try {
            List<String> keys = con.query("SELECT finding_key FROM ev_replays WHERE run_id = ?", runId); // src: vvaharness/orchestrator/store/replays.py:60
            stale = keys.filter(k -> !keep.contains(k));                                               // src: vvaharness/orchestrator/store/replays.py:62
            for (String k : stale) con.execute("DELETE FROM ev_replays WHERE run_id = ? AND finding_key = ?", runId, k); // src: vvaharness/orchestrator/store/replays.py:64
        } finally { con.close(); }
        return stale.size();                                                                           // src: vvaharness/orchestrator/store/replays.py:68
    }

    /** Replay bundles oldest first; stored rows over the cap are skipped. */
    List<Pair<String, byte[]>> loadReplays(String runId) {
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/replays.py:73
        List<Row> rows;
        try { rows = con.query("SELECT finding_key, payload, size FROM ev_replays ORDER BY created_at, finding_key", runId); } // src: vvaharness/orchestrator/store/replays.py:75
        finally { con.close(); }
        List<Pair<String, byte[]>> out = new List();
        for (Row r : rows) {
            if (r.size > Db.REPLAY_MAX_BYTES) { Log.warning("REPLAY_STORED_TOO_LARGE"); continue; } // src: vvaharness/orchestrator/store/replays.py:82
            out.add(Pair.of(r.key, r.payload));                                                        // src: vvaharness/orchestrator/store/replays.py:85
        }
        return out;
    }

    int deleteReplays(String runId) {
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/replays.py:91
        try { return con.execute("DELETE FROM ev_replays WHERE run_id = ?", runId).rowCount(); }       // src: vvaharness/orchestrator/store/replays.py:94
        finally { con.close(); }
    }

    /** Replace this run's probe log; call only when EV ran (rows already redacted by the EV router). */
    int saveEvProbes(String runId, List<Map> rows) {
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/replays.py:113
        int written = 0;
        try {
            con.transaction(() -> {
                con.execute("INSERT OR IGNORE INTO runs ...; UPDATE runs SET updated_at", runId);     // src: vvaharness/orchestrator/store/replays.py:117
                con.execute("DELETE FROM ev_probes WHERE run_id = ?", runId);                        // src: vvaharness/orchestrator/store/replays.py:121
                for (Map r : rows) { con.execute("INSERT INTO ev_probes", runId, EV_PROBE_COLS.map(c -> r.get(c))); written += 1; } // src: vvaharness/orchestrator/store/replays.py:123
            });
        } finally { con.close(); }
        return written;                                                                                // src: vvaharness/orchestrator/store/replays.py:129
    }

    List<Map> loadEvProbes(String runId) {
        Connection con = Db.connect();                                                         // src: vvaharness/orchestrator/store/replays.py:134
        try { return con.query("SELECT id, run_id, <cols>, created_at FROM ev_probes WHERE run_id = ? ORDER BY id", runId); } // src: vvaharness/orchestrator/store/replays.py:137
        finally { con.close(); }
    }
}
