    String symlinkSafeMode(String repo, String mode, Theta θ) {
        // Return mode, downgraded to report-only when the repo has escaping symlinks. A symlink inside the repository that resolves outside it turns any write through it into a host write no post-hoc control can see (the link object never changes, so git status and the whole-tree changed-file list report nothing and revert has no baseline): unrecoverable once written, so refusing the writer is the only effective control (CWE-59).
        if (!mode.equals("fix")) return mode;                                                       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:445
        Map<String, String> escapes = SymlinkJail.escapingSymlinks(repo, θ);                        // src: vvaharness/remediation_agent/plugin_runner/__init__.py:447
        if (escapes.isEmpty()) return mode;                                                         // src: vvaharness/remediation_agent/plugin_runner/__init__.py:448
        WarnOnce.warnOnce(WARNED_SYMLINK_ESCAPE, "fix-symlink-escape", "REFUSING fix mode: " + escapes.size() + " symlink(s) resolve outside the checkout (" + SymlinkJail.describeEscapes(escapes, 5) + "). Running report-only instead."); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:450
        return θ["code.remediation_agent.plugin_runner.symlink_escape_mode"];                       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:458  (report)
    }

