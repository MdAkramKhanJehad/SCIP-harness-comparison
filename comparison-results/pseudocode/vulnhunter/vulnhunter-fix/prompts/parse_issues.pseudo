    Prompt step4Text(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.parse_issues.report_url_from_issue_body"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:336
        p.must(θ["p.parse_issues.report_url_missing_abort"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:357
        p.checklist(θ["p.parse_issues.publish_host_allowlist"]);                                        // src: vulnhunter-fix/prompts/parse_issues.md:387
        p.rule(θ["p.parse_issues.publish_clone_path"]);                                                 // src: vulnhunter-fix/prompts/parse_issues.md:405
        p.rule(θ["p.parse_issues.publish_clone_no_hooks_shallow"]);                                     // src: vulnhunter-fix/prompts/parse_issues.md:407
        p.must(θ["p.parse_issues.report_readme_sanity_check"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:415
        p.rule(θ["p.parse_issues.alias_cache_not_in_skill_dir"]);                                       // src: vulnhunter-fix/prompts/parse_issues.md:427
        p.forbid(θ["p.parse_issues.clone_fail_no_workaround"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:445
        p.forbid(θ["p.parse_issues.no_git_after_user_clone"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:456
        p.forbid(θ["p.parse_issues.user_clone_same_in_project_path"]);                                  // src: vulnhunter-fix/prompts/parse_issues.md:456
        p.rule(θ["p.parse_issues.publish_unreachable_stop"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:458
        return p;
    }

    Prompt step5Text(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.parse_issues.read_report_in_context"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:468
        p.rule(θ["p.parse_issues.fork_uses_regex_parser_fallback"]);                                    // src: vulnhunter-fix/prompts/parse_issues.md:468
        p.rule(θ["p.parse_issues.readme_extraction_sonnet_subagent"]);                                  // src: vulnhunter-fix/prompts/parse_issues.md:472
        p.must(θ["p.parse_issues.substitute_report_path_in_prompt"]);                                   // src: vulnhunter-fix/prompts/parse_issues.md:474
        p.rule(θ["p.parse_issues.hash_in_python_not_model"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:528
        p.format(θ["p.parse_issues.vulnfix_key_formula"]);                                              // src: vulnhunter-fix/prompts/parse_issues.md:528
        p.must(θ["p.parse_issues.validate_draft_before_postprocess"]);                                  // src: vulnhunter-fix/prompts/parse_issues.md:530
        p.rule(θ["p.parse_issues.draft_validation_retry_with_stderr"]);                                 // src: vulnhunter-fix/prompts/parse_issues.md:537
        p.must(θ["p.parse_issues.validate_findings_schema"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:623
        p.rule(θ["p.parse_issues.schema_fail_route_to_5a"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:629
        p.must(θ["p.parse_issues.coverage_check_issue_to_finding"]);                                    // src: vulnhunter-fix/prompts/parse_issues.md:633
        p.forbid(θ["p.parse_issues.orphan_issue_reextract_no_manual_injection"]);                       // src: vulnhunter-fix/prompts/parse_issues.md:649
        return p;
    }

    Prompt step6And7Text(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.parse_issues.work_json_join_by_key"]);                                              // src: vulnhunter-fix/prompts/parse_issues.md:653
        p.rule(θ["p.parse_issues.unselected_finding_skipped"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:673
        p.rule(θ["p.parse_issues.unmatched_issue_warn_only"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:674
        p.format(θ["p.parse_issues.final_work_table_columns"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:680
        p.rule(θ["p.parse_issues.no_second_confirmation"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:680
        return p;
    }

    Prompt outputContractAndErrors(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.parse_issues.output_contract_files"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:684
        p.must(θ["p.parse_issues.every_error_stops_phase"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:696
        p.must(θ["p.parse_issues.surface_stderr_verbatim"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:697
        p.rule(θ["p.parse_issues.keep_workdir_on_failure"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:698
        return p;
    }

    // ---------------------------------------------------------------------------------------------
    // Step 0: RESULTS_PATH short-circuit (skips Steps 1-4).
    // ---------------------------------------------------------------------------------------------
    @executedBy(MIXED)
    String step0ResultsPath(Dispatch d, Theta θ) {
        Work w = new Work();
        for (String field : θ["p.parse_issues.work_json_no_source_issues_fields"]) w.set(field);         // mode=in_place, no_source_issues=true, results_path (src: vulnhunter-fix/prompts/parse_issues.md:15)
        writeJson(".vulnhunter-fix/work.json", w);
        String rp = d.results;
        if (isLocalDirWithReadme(rp) && θ["p.parse_issues.results_path_local_dir_as_is"]) { }            // use as-is (src: vulnhunter-fix/prompts/parse_issues.md:28)
        else if (isGitUrl(rp)) {
            String dest = θ["p.parse_issues.results_path_url_shallow_clone"];                            // src: vulnhunter-fix/prompts/parse_issues.md:29
            if (!bashOk("git clone --depth 1 \"$RESULTS_PATH\" " + dest)) return gitFailure("git clone", θ); // src: vulnhunter-fix/prompts/parse_issues.md:31
            rp = dest;
        }
        if (θ["p.parse_issues.results_path_readme_required"] && !exists(rp + "/README.md")) throw new PhaseError("no README.md at RESULTS_PATH"); // src: vulnhunter-fix/prompts/parse_issues.md:34
        return rp;                                                                                       // continue at Step 5a (src: vulnhunter-fix/prompts/parse_issues.md:36)
    }

    // ---------------------------------------------------------------------------------------------
    // Step 1: fetch issues (Bash; gh with --repo).
    // ---------------------------------------------------------------------------------------------
    @executedBy(MIXED)
    List<Issue> step1FetchIssues(Dispatch d, Theta θ) {
        // all network calls in Bash blocks (TLS context)
        assert θ["p.parse_issues.network_calls_in_bash"];                                                // src: vulnhunter-fix/prompts/parse_issues.md:64
        String cmd;
        if (d.explicitIssueUrls.isEmpty() && θ["p.parse_issues.explicit_issue_urls_optional"]) {         // src: vulnhunter-fix/prompts/parse_issues.md:43
            cmd = "gh issue list --repo \"$OWNER_REPO\""                                                 // src: vulnhunter-fix/prompts/parse_issues.md:76
                + " --label " + θ["p.parse_issues.issue_label_filter"]                                   // src: vulnhunter-fix/prompts/parse_issues.md:78
                + " --state " + θ["p.parse_issues.issue_state_filter"]                                   // src: vulnhunter-fix/prompts/parse_issues.md:79
                + " --limit " + θ["p.parse_issues.issue_list_limit"]                                     // src: vulnhunter-fix/prompts/parse_issues.md:80
                + " --json " + θ["p.parse_issues.issue_fields"];                                         // src: vulnhunter-fix/prompts/parse_issues.md:81
        } else {
            cmd = "for url in <urls>: gh issue view <n> --repo \"$OWNER_REPO\" --json " + θ["p.parse_issues.issue_fields"]; // src: vulnhunter-fix/prompts/parse_issues.md:92
        }
        Bash r = bash(cmd + " > .vulnhunter-fix/raw_issues.json");                                       // src: vulnhunter-fix/prompts/parse_issues.md:82
        if (r.transportFailure()) {
            // no retry, no git ls-remote / curl, no other gh subcommand: SKILL.md failure policy
            if (θ["p.parse_issues.gh_failure_stop_in_parse"]) VulnhunterFixSkill.onGitGhFailure(cmd, θ); // src: vulnhunter-fix/prompts/parse_issues.md:66
        }
        if (r.exitCode != 0 && θ["p.parse_issues.issue_list_fail_stop"]) {                              // src: vulnhunter-fix/prompts/parse_issues.md:100
            if (r.http404() && θ["p.parse_issues.missing_label_stop"]) throw new PhaseError("vulnhunter label missing - run the scanner first"); // src: vulnhunter-fix/prompts/parse_issues.md:105
            throw new PhaseError(r.stderr);
        }
        List<Issue> raw = readJson(".vulnhunter-fix/raw_issues.json");
        if (raw.isEmpty() && θ["p.parse_issues.no_issues_stop"]) throw new PhaseError("no issues match your search"); // src: vulnhunter-fix/prompts/parse_issues.md:104
        return raw;
    }

    // ---------------------------------------------------------------------------------------------
    // Step 2: markers + homogeneity (python3 via scripts/issue_intake.py), default branch from git refs.
    // ---------------------------------------------------------------------------------------------
    @executedBy(CODE)
    Intake step2Markers(List<Issue> raw, Theta θ) {
        List<IssueRecord> records = new List();
        for (Issue issue : raw) {
            Markers m;
            try { m = IssueIntake.extractMarkers(issue.body, "issue #" + issue.number); }               // src: vulnhunter-fix/prompts/parse_issues.md:123
            catch (MarkerExtractionError e) {
                // edited bodies with markers removed are skipped (no edit-history reconstruction in v1)
                if (θ["p.parse_issues.marker_extraction_skip_on_error"] && θ["p.parse_issues.edited_issue_skipped"]) { warn(e + " - skipping"); continue; } // src: vulnhunter-fix/prompts/parse_issues.md:125
            }
            records.add(new IssueRecord(issue.url.owner(), issue.url.repo(), issue.number, issue.url, issue.title, false, issue.body, m)); // src: vulnhunter-fix/prompts/parse_issues.md:130
        }
        if (records.isEmpty() && θ["p.parse_issues.no_usable_issues_abort"]) throw new PhaseError("no usable issues - none carried valid vulnhunter markers"); // src: vulnhunter-fix/prompts/parse_issues.md:137
        Intake intake = new Intake();
        if (θ["p.parse_issues.homogeneity_enforced"]) intake.ownerRepoResultsDir = IssueIntake.enforceHomogeneity(records); // src: vulnhunter-fix/prompts/parse_issues.md:140
        intake.issues = records.map(r -> r.withMarkers("vulnfix_key", "finding_id", "results_dir"));    // src: vulnhunter-fix/prompts/parse_issues.md:149
        writeJson(".vulnhunter-fix/intake.json", intake);                                                // src: vulnhunter-fix/prompts/parse_issues.md:158
        // origin/HEAD symref -> main/master on remote -> current branch; all git-local, no gh
        for (String src : θ["p.parse_issues.default_branch_fallback_chain"]) {                          // src: vulnhunter-fix/prompts/parse_issues.md:164
            intake.defaultBranch = gitLocal(src);
            if (intake.defaultBranch != null) break;
        }
        writeJson(".vulnhunter-fix/intake.json", intake);                                                // src: vulnhunter-fix/prompts/parse_issues.md:188
        return intake;
    }

    // ---------------------------------------------------------------------------------------------
    // Step 3: annotate severities (Haiku subagent), cluster (N > 4), ask, filter intake.
    // ---------------------------------------------------------------------------------------------
    Intake step3Select(List<Issue> raw, Intake intake, Theta θ) {
        assert θ["p.parse_issues.always_ask_selection"];                                                 // src: vulnhunter-fix/prompts/parse_issues.md:199
        String table = step3aAnnotate(θ);
        if (θ["p.parse_issues.display_subagent_table_verbatim"]) say(table);                             // src: vulnhunter-fix/prompts/parse_issues.md:216
        intake = readJson(".vulnhunter-fix/intake.json");
        int n = intake.issues.size();
        Clusters cl = null;
        if (n > θ["p.parse_issues.cluster_threshold_n"]) cl = step3bCluster(raw, intake, θ);              // src: vulnhunter-fix/prompts/parse_issues.md:237
        Set<Integer> selected = step3cAsk(n, intake, cl, θ);
        return filterIntake(intake, selected, θ);
    }

    @executedBy(MODEL) @role(agent)
    String step3aAnnotate(Theta θ) {
        // cheapest model that gets it right: shape-stable transform -> Haiku general-purpose subagent with Read/Write only
        Prompt sp = new Prompt();
        sp.step(1, θ["p.parse_issues.severity_annotation_inputs"]);                                      // src: vulnhunter-fix/prompts/parse_issues.md:205
        sp.step(2, θ["p.parse_issues.severity_recognized_values"]);                                      // src: vulnhunter-fix/prompts/parse_issues.md:206
        sp.rule(θ["p.parse_issues.high_plus_normalized_to_critical"]);                                   // src: vulnhunter-fix/prompts/parse_issues.md:206
        sp.step(3, θ["p.parse_issues.severity_missing_unknown"]);                                        // src: vulnhunter-fix/prompts/parse_issues.md:207
        sp.step(4, θ["p.parse_issues.severity_sort_order"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:208
        sp.forbid(θ["p.parse_issues.intake_excludes_body"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:209
        sp.format(θ["p.parse_issues.annotation_reply_table_only"]);                                      // src: vulnhunter-fix/prompts/parse_issues.md:210
        String model = θ["p.parse_issues.severity_annotation_haiku_subagent"];                          // src: vulnhunter-fix/prompts/parse_issues.md:201
        model = θ["fix.subagent_models"].get("severity_annotation");                                     // src: vulnhunter-fix/prompts/parse_issues.md:201
        assert model == θ["p.parse_issues.haiku_for_shape_stable"];                                      // src: vulnhunter-fix/prompts/parse_issues.md:55
        return Runtime.subagent(sp, new AgentArgs(θ["p.parse_issues.tier3_subagent_type"], model, θ["p.parse_issues.annotation_subagent_tools"])); // src: vulnhunter-fix/prompts/parse_issues.md:214
    }

    @executedBy(MIXED)
    Clusters step3bCluster(List<Issue> raw, Intake intake, Theta θ) {
        // group by topic (same subsystem or fix shape), not severity; aim for 2-4 clusters, names <= 5 words
        Clusters cl = new Clusters();
        for (Issue i : raw) cl.assignByTopic(i, θ["p.parse_issues.cluster_criterion_topic"]);           // src: vulnhunter-fix/prompts/parse_issues.md:237
        assert θ["p.parse_issues.severity_not_grouping_criterion"];                                      // src: vulnhunter-fix/prompts/parse_issues.md:246
        cl.boundaryRule = θ["p.parse_issues.cluster_boundary_heuristic"];                                // same engineer would land them as one PR (src: vulnhunter-fix/prompts/parse_issues.md:246)
        cl.targetCount = θ["p.parse_issues.cluster_count_target"];                                       // src: vulnhunter-fix/prompts/parse_issues.md:237
        cl.maxNameWords = θ["p.parse_issues.cluster_name_max_words"];                                    // src: vulnhunter-fix/prompts/parse_issues.md:237
        cl.fields = θ["p.parse_issues.cluster_fields"];                                                  // name, rationale, members (src: vulnhunter-fix/prompts/parse_issues.md:242)
        cl.isDeliveryUnit = θ["p.parse_issues.cluster_is_delivery_unit"];                                // one cluster -> one PR (src: vulnhunter-fix/prompts/parse_issues.md:244)
        if (cl.size() < θ["p.parse_issues.cluster_min_fallback"]) return null;                           // fall back to severity buckets (src: vulnhunter-fix/prompts/parse_issues.md:283)
        if (θ["p.parse_issues.cluster_rank_by_risk_score"]) {                                            // src: vulnhunter-fix/prompts/parse_issues.md:248
            for (Cluster c : cl) c.score = scoreOf(c, θ);
            cl.sortDesc(c -> c.score).thenDesc(θ["p.parse_issues.cluster_tiebreak_member_count"]);       // src: vulnhunter-fix/prompts/parse_issues.md:260
        }
        writeJson(".vulnhunter-fix/clusters.json", cl.with(θ["p.parse_issues.clusters_json_fields"]));   // src: vulnhunter-fix/prompts/parse_issues.md:264
        // the model's arithmetic is not trusted: canonical scorer rewrites score + recommended flag
        if (θ["p.parse_issues.canonical_scorer_run"]) cl = ClusterScore.run(".vulnhunter-fix/clusters.json"); // src: vulnhunter-fix/prompts/parse_issues.md:288
        if (θ["p.parse_issues.top_cluster_recommended"]) cl.first().label += " (Recommended)";           // src: vulnhunter-fix/prompts/parse_issues.md:260
        return cl;
    }

    int scoreOf(Cluster c, Theta θ) {
        int s = 0;
        for (Member m : c.members) {
            String sev = m.severity == "High+" ? "Critical" : m.severity;                                // src: vulnhunter-fix/prompts/parse_issues.md:258
            if (sev == "Critical") s += θ["p.parse_issues.weight_critical"];                             // src: vulnhunter-fix/prompts/parse_issues.md:252
            else if (sev == "High") s += θ["p.parse_issues.weight_high"];                                // src: vulnhunter-fix/prompts/parse_issues.md:253
            else if (sev == "Medium") s += θ["p.parse_issues.weight_medium"];                            // src: vulnhunter-fix/prompts/parse_issues.md:254
            else if (sev == "Low") s += 1;                                                               // Low weight literal, no knob (src: vulnhunter-fix/prompts/parse_issues.md:255)
            else s += θ["p.parse_issues.weight_unknown"];                                                // src: vulnhunter-fix/prompts/parse_issues.md:256
        }
        return s;
    }

    Set<Integer> step3cAsk(int n, Intake intake, Clusters cl, Theta θ) {
        // AskUserQuestion with multiSelect checkboxes preferred over typed input
        boolean checkboxes = θ["p.parse_issues.ask_via_checkboxes"];                                     // src: vulnhunter-fix/prompts/parse_issues.md:295
        if (n == 0 && θ["p.parse_issues.zero_issues_stop"]) throw new PhaseError("nothing was harvested"); // src: vulnhunter-fix/prompts/parse_issues.md:300
        if (n == 1 && θ["p.parse_issues.single_issue_auto_proceed"]) { say("about to proceed; interrupt to stop"); return intake.allNumbers(); } // src: vulnhunter-fix/prompts/parse_issues.md:299
        Answer a;
        if (n <= θ["p.parse_issues.cluster_threshold_n"]) {
            // 2 <= N <= 4: one option per issue, label "#N - VULN-XXX - short title"
            a = askUserQuestion(true, intake.perIssueOptions(), θ["p.parse_issues.small_n_per_issue_options"]); // src: vulnhunter-fix/prompts/parse_issues.md:301
        } else if (cl != null) {
            // clusters in risk-reduction order, at most 4 (merge smallest or "Other clusters")
            a = askUserQuestion(true, cl.options().limit(θ["p.parse_issues.cluster_question_max_options"])); // src: vulnhunter-fix/prompts/parse_issues.md:302
        } else {
            a = askUserQuestion(true, intake.nonEmptyBuckets(θ["p.parse_issues.severity_bucket_fallback_question"])); // src: vulnhunter-fix/prompts/parse_issues.md:303
        }
        // N > 4: auto-included Other option accepts "42,55,71"
        if (n > θ["p.parse_issues.cluster_threshold_n"] && θ["p.parse_issues.other_option_free_text"]) a.allowOther(); // src: vulnhunter-fix/prompts/parse_issues.md:305
        // normalize to a set of issue numbers: per-issue #N / cluster members / severity bucket / Other text
        Set<Integer> sel = a.normalize(θ["p.parse_issues.answer_parse_rules"], cl, intake);              // src: vulnhunter-fix/prompts/parse_issues.md:307
        if (a.otherHasNonNumeric() && θ["p.parse_issues.other_text_reject_non_numeric"]) return step3cAsk(n, intake, cl, θ); // src: vulnhunter-fix/prompts/parse_issues.md:312
        return sel;
    }

    Intake filterIntake(Intake intake, Set<Integer> selected, Theta θ) {
        // build the filtered intake with Write, not jq
        assert θ["p.parse_issues.filter_intake_no_jq"];                                                  // src: vulnhunter-fix/prompts/parse_issues.md:316
        if (θ["p.parse_issues.snapshot_full_intake"]) bash("cp .vulnhunter-fix/intake.json .vulnhunter-fix/intake.full.json"); // src: vulnhunter-fix/prompts/parse_issues.md:320
        if (selected.isEmpty() && θ["p.parse_issues.empty_selection_exit"]) {                            // src: vulnhunter-fix/prompts/parse_issues.md:326
            intake.issues = List.of();
            writeJson(".vulnhunter-fix/intake.json", intake);
            say("nothing was done");
            return intake;
        }
        intake.issues = intake.issues.filter(i -> selected.contains(i.number));
        if (θ["p.parse_issues.filtered_intake_sanity_check"]) assert intake.hasOwnerRepoResultsDirDefaultBranch() && !intake.issues.isEmpty(); // src: vulnhunter-fix/prompts/parse_issues.md:323
        writeJson(".vulnhunter-fix/intake.json", intake);                                                // src: vulnhunter-fix/prompts/parse_issues.md:323
        return intake;
    }

    // ---------------------------------------------------------------------------------------------
    // Step 4: stage the full report from the publish repo named in the issue body.
    // ---------------------------------------------------------------------------------------------
    @executedBy(MIXED)
    String step4StageReport(List<Issue> raw, Intake intake, Theta θ) {
        // Full report URL is derivable from any one issue body: no find walk, no prompt, no alias lookup
        String url = θ["p.parse_issues.report_url_from_issue_body"] ? raw.firstCapture("Full report:[ \\t]*(https?://\\S+)") : null; // src: vulnhunter-fix/prompts/parse_issues.md:349
        if (url == null && θ["p.parse_issues.report_url_missing_abort"]) throw new PhaseError("Could not extract 'Full report:' URL"); // src: vulnhunter-fix/prompts/parse_issues.md:357
        String publishRepo = url.before("/blob/");                                                       // src: vulnhunter-fix/prompts/parse_issues.md:364
        String nested = url.after("/blob/").afterFirstSegment();                                         // src: vulnhunter-fix/prompts/parse_issues.md:366
        // security: issue body is attacker-influenced; only github.com / GHE hosts are trusted
        String host = hostOf(publishRepo);                                                               // src: vulnhunter-fix/prompts/parse_issues.md:374
        if (!host.matchesAny(θ["p.parse_issues.publish_host_allowlist"])) throw new PhaseError("publish repo host not on the allowlist"); // src: vulnhunter-fix/prompts/parse_issues.md:387
        String clone = θ["p.parse_issues.publish_clone_path"];                                           // src: vulnhunter-fix/prompts/parse_issues.md:405
        bash("rm -rf " + clone);                                                                         // src: vulnhunter-fix/prompts/parse_issues.md:406
        // -c init.templateDir= -c core.hooksPath=/dev/null clone --template= --depth 1
        Bash r = bash("git clone " + θ["p.parse_issues.publish_clone_no_hooks_shallow"] + " " + publishRepo + " " + clone); // src: vulnhunter-fix/prompts/parse_issues.md:407
        if (r.exitCode != 0) {
            // STOP: no gh repo clone, no sslVerify=false; ask the user to clone into the same in-project path
            if (θ["p.parse_issues.clone_fail_no_workaround"]) {                                          // src: vulnhunter-fix/prompts/parse_issues.md:445
                if (θ["p.parse_issues.user_clone_same_in_project_path"]) handoff("rm -rf <project_root>/" + clone + "; git clone --depth 1 <PUBLISH_REPO> <project_root>/" + clone); // src: vulnhunter-fix/prompts/parse_issues.md:450
                Answer a = waitForUser();
                if (a.realPermissionDeniedOr404() && θ["p.parse_issues.publish_unreachable_stop"]) throw new PhaseError("publish repo unreachable - request access from the security team"); // src: vulnhunter-fix/prompts/parse_issues.md:458
                // re-derive REPORT_PATH from the URL; no find walk, no further git calls
                assert θ["p.parse_issues.no_git_after_user_clone"];                                       // src: vulnhunter-fix/prompts/parse_issues.md:456
            }
        }
        String reportPath = clone + "/" + nested.withoutSuffix("/README.md");                           // src: vulnhunter-fix/prompts/parse_issues.md:412
        if (θ["p.parse_issues.report_readme_sanity_check"] && !exists(reportPath + "/README.md")) throw new PhaseError("README.md missing after clone"); // src: vulnhunter-fix/prompts/parse_issues.md:415
        writeFile(".vulnhunter-fix/.report_path", reportPath);                                           // src: vulnhunter-fix/prompts/parse_issues.md:423
        // alias cache lives in the project, never written back to SKILL_DIR/config.json
        updateJsonQuiet(θ["p.parse_issues.alias_cache_not_in_skill_dir"], intake.resultsDir, publishRepo); // src: vulnhunter-fix/prompts/parse_issues.md:431
        return reportPath;
    }

    // ---------------------------------------------------------------------------------------------
    // Step 5: extract findings (Sonnet subagent) -> validate -> hash in Python -> schema check.
    // ---------------------------------------------------------------------------------------------
    Findings step5Extract(String reportPath, Theta θ) {
        // read the report in-context (via subagent), do not shell out to parse_results.py (fork-only fallback)
        assert θ["p.parse_issues.read_report_in_context"] && θ["p.parse_issues.fork_uses_regex_parser_fallback"]; // src: vulnhunter-fix/prompts/parse_issues.md:468
        String guidance = null;
        while (true) {
            step5aDraft(reportPath, guidance, θ);
            Validation v = θ["p.parse_issues.validate_draft_before_postprocess"] ? Validation.fromExitCode(ValidateFindingsDraft.mainWithArgv(List.of(".vulnhunter-fix/findings.draft.json"), θ)) : Validation.ok(); // src: vulnhunter-fix/prompts/parse_issues.md:533
            if (!v.ok) {
                // re-invoke 5a with the validator stderr appended; never hash an invalid draft
                if (θ["p.parse_issues.draft_validation_retry_with_stderr"]) { guidance = "your prior output failed validation: " + v.stderr; continue; } // src: vulnhunter-fix/prompts/parse_issues.md:537
            }
            Findings fs = step5bPostprocess(reportPath, θ);
            Validation s = θ["p.parse_issues.validate_findings_schema"] ? ValidateFinding.run(".vulnhunter-fix/findings.json") : Validation.ok(); // src: vulnhunter-fix/prompts/parse_issues.md:626
            if (!s.ok && θ["p.parse_issues.schema_fail_route_to_5a"]) { guidance = s.stderr; continue; } // src: vulnhunter-fix/prompts/parse_issues.md:629
            return fs;
        }
    }

    @executedBy(MODEL) @role(agent)
    void step5aDraft(String reportPath, String guidance, Theta θ) {
        // shape-variable transform -> Sonnet (prefer Sonnet when unsure)
        String model = θ["p.parse_issues.readme_extraction_sonnet_subagent"];                           // src: vulnhunter-fix/prompts/parse_issues.md:472
        model = θ["fix.subagent_models"].get("readme_extraction");                                       // src: vulnhunter-fix/prompts/parse_issues.md:472
        assert model == θ["p.parse_issues.sonnet_for_shape_variable"] || model == θ["p.parse_issues.prefer_sonnet_when_unsure"]; // src: vulnhunter-fix/prompts/parse_issues.md:56
        Prompt sp = new Prompt();
        // the subagent has no shell context: substitute the real absolute path, never the literal $REPORT_PATH
        String path = θ["p.parse_issues.substitute_report_path_in_prompt"] ? absolute(reportPath) : "$REPORT_PATH"; // src: vulnhunter-fix/prompts/parse_issues.md:474
        sp.step(1, "Read " + path + "/README.md");                                                       // src: vulnhunter-fix/prompts/parse_issues.md:478
        sp.step(2, θ["p.parse_issues.extract_confirmed_rows_only"]);                                     // src: vulnhunter-fix/prompts/parse_issues.md:479
        sp.step(3, θ["p.parse_issues.scan_detail_sections_for_rollups"]);                                // src: vulnhunter-fix/prompts/parse_issues.md:480
        sp.step(4, θ["p.parse_issues.finding_fields"]);                                                  // src: vulnhunter-fix/prompts/parse_issues.md:481
        sp.rule(θ["p.parse_issues.cwe_verbatim_multi"]);                                                 // src: vulnhunter-fix/prompts/parse_issues.md:487
        sp.rule(θ["p.parse_issues.primary_cwe_first_match"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:488
        sp.rule(θ["p.parse_issues.high_plus_normalized_to_critical"]);                                   // src: vulnhunter-fix/prompts/parse_issues.md:489
        sp.forbid(θ["p.parse_issues.never_invent_field_values"]);                                        // src: vulnhunter-fix/prompts/parse_issues.md:499
        sp.step(5, θ["p.parse_issues.draft_written_via_write"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:501
        sp.step(6, θ["p.parse_issues.extraction_reply_one_line"]);                                       // src: vulnhunter-fix/prompts/parse_issues.md:502
        if (guidance != null) sp.context(guidance);                                                      // src: vulnhunter-fix/prompts/parse_issues.md:537
        Runtime.subagent(sp, new AgentArgs(θ["p.parse_issues.tier3_subagent_type"], model));             // src: vulnhunter-fix/prompts/parse_issues.md:472
    }

    @executedBy(CODE)
    Findings step5bPostprocess(String reportPath, Theta θ) {
        // SHA-256 is computed in Python, not by the model
        assert θ["p.parse_issues.hash_in_python_not_model"];                                             // src: vulnhunter-fix/prompts/parse_issues.md:528
        Map<String, Map<String, String>> filesByVuln = new Map();
        for (String sub : θ["p.parse_issues.poc_file_attachment_pattern"]) {                             // src: vulnhunter-fix/prompts/parse_issues.md:553
            for (File fp : listDir(reportPath + "/" + sub)) {
                String vid = fp.name.match("VULN[-_](\\d+)").canonicalVulnId();                         // src: vulnhunter-fix/prompts/parse_issues.md:558
                if (vid != null) filesByVuln.at(vid).put(sub, fp.path);
            }
        }
        Draft draft = readJson(".vulnhunter-fix/findings.draft.json");                                   // src: vulnhunter-fix/prompts/parse_issues.md:565
        if (draft == null || !draft.hasFindingsList()) exit(2);                                          // re-run Step 5a (src: vulnhunter-fix/prompts/parse_issues.md:581)
        List<Finding> out = new List();
        for (Finding item : draft.findings) {
            if (item.primaryCwe.isBlank()) item.primaryCwe = item.cwe.firstMatch("CWE-\\d+");            // src: vulnhunter-fix/prompts/parse_issues.md:593
            if (item.severity.lower() == "high+") item.severity = "Critical";                            // src: vulnhunter-fix/prompts/parse_issues.md:599
            // vulnfix_key = SHA-256(location|primary_cwe|root_cause)[:16]
            item.vulnfixKey = IssueIntake.computeVulnfixKey(item.location, item.primaryCwe, item.rootCause, θ["p.parse_issues.vulnfix_key_formula"]); // src: vulnhunter-fix/prompts/parse_issues.md:601
            item.files = filesByVuln.get(item.id);                                                       // src: vulnhunter-fix/prompts/parse_issues.md:604
            out.add(item);
        }
        Findings fs = new Findings(reportPath, out, filesByVuln);
        writeJson(".vulnhunter-fix/findings.json", fs);                                                  // src: vulnhunter-fix/prompts/parse_issues.md:615
        return fs;
    }

    @executedBy(MIXED)
    void step5cCoverage(Intake intake, Findings fs, Theta θ) {
        if (!θ["p.parse_issues.coverage_check_issue_to_finding"]) return;                                // src: vulnhunter-fix/prompts/parse_issues.md:633
        Set<String> orphans = intake.vulnfixKeys().minus(fs.vulnfixKeys());                              // src: vulnhunter-fix/prompts/parse_issues.md:640
        if (!orphans.isEmpty()) {
            warn("selected issue(s) with no matching finding (re-read README)");                         // src: vulnhunter-fix/prompts/parse_issues.md:643
            // go back to 5a and re-read the README more carefully; never paper over with manual injection
            if (θ["p.parse_issues.orphan_issue_reextract_no_manual_injection"]) step5aDraft(readFile(".vulnhunter-fix/.report_path"), "re-read rollup/umbrella sections for " + orphans, θ); // src: vulnhunter-fix/prompts/parse_issues.md:649
        }
    }

    // ---------------------------------------------------------------------------------------------
    // Step 6: join intake <-> findings by vulnfix_key into work.json (model + Write, no jq).
    // ---------------------------------------------------------------------------------------------
    Work step6Join(Intake intake, Findings fs, Theta θ) {
        Work w = new Work(intake.owner, intake.repo, intake.resultsDir, intake.defaultBranch);           // src: vulnhunter-fix/prompts/parse_issues.md:656
        String key = θ["p.parse_issues.work_json_join_by_key"];                                          // src: vulnhunter-fix/prompts/parse_issues.md:653
        for (Finding f : fs.findings) {
            Issue i = intake.issues.findBy(key, f.get(key));
            if (i != null) w.items.add(new WorkItem(f, i));                                              // src: vulnhunter-fix/prompts/parse_issues.md:672
            else if (θ["p.parse_issues.unselected_finding_skipped"]) continue;                           // src: vulnhunter-fix/prompts/parse_issues.md:673
        }
        for (Issue i : intake.issues) {
            if (fs.findings.findBy(key, i.markers.get(key)) == null && θ["p.parse_issues.unmatched_issue_warn_only"] == "warn") warn("issue #" + i.number + " has no matching finding"); // src: vulnhunter-fix/prompts/parse_issues.md:674
        }
        writeJson(".vulnhunter-fix/work.json", w);                                                       // src: vulnhunter-fix/prompts/parse_issues.md:653
        return w;
    }

    void step7Present(Work w, Theta θ) {
        say(w.markdownTable(θ["p.parse_issues.final_work_table_columns"]));                              // src: vulnhunter-fix/prompts/parse_issues.md:680
        // continue to Phase 2 (plan.md) with no second confirmation gate
        assert θ["p.parse_issues.no_second_confirmation"];                                               // src: vulnhunter-fix/prompts/parse_issues.md:680
    }

    // ---------------------------------------------------------------------------------------------
    // Error handling.
    // ---------------------------------------------------------------------------------------------
    PhaseOutput errorHandling(PhaseError e, Theta θ) {
        if (θ["p.parse_issues.surface_stderr_verbatim"]) say(e.stderr);                                  // src: vulnhunter-fix/prompts/parse_issues.md:697
        if (θ["p.parse_issues.keep_workdir_on_failure"]) keep(".vulnhunter-fix/");                       // src: vulnhunter-fix/prompts/parse_issues.md:698
        if (θ["p.parse_issues.every_error_stops_phase"]) return PhaseOutput.stopped(e);                  // src: vulnhunter-fix/prompts/parse_issues.md:696
        return PhaseOutput.stopped(e);
    }

    String gitFailure(String cmd, Theta θ) {
        VulnhunterFixSkill.onGitGhFailure(cmd, θ);
        throw new PhaseError(cmd + " failed");
    }
}
