// file: vulnhunter-fix/scripts/anti-merge-check.py
// Anti-merge grouping check (REQ-GAT-006): allows a multi-finding PR group only when the grouped/split file
// ratio is at or below the threshold for source or test files. Used in Plan (advisory) and as Gate 5 (--strict).

@executedBy(CODE) @role(evaluation) @stage("fix")
class AntiMergeCheck {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                     // src: vulnhunter-fix/scripts/anti-merge-check.py:38
        // negative counts would yield a trivially-passing negative ratio
        for (Pair nv : List.of(args.filesGrouped, args.filesSplit, args.testFilesGrouped, args.testFilesSplit)) {
            if (nv.val != null && nv.val < 0) {                                                          // src: vulnhunter-fix/scripts/anti-merge-check.py:58
                Stderr.print("must be non-negative");
                return 2;                                                                                // src: vulnhunter-fix/scripts/anti-merge-check.py:60
            }
        }
        double threshold = θ["code.fix.scripts.anti_merge_check.threshold"];                             // src: vulnhunter-fix/scripts/anti-merge-check.py:34
        double srcRatio = args.filesSplit != 0 ? args.filesGrouped / args.filesSplit : 1.0;              // src: vulnhunter-fix/scripts/anti-merge-check.py:62
        Double testRatio = null;
        if (args.testFilesGrouped != null && args.testFilesSplit != 0) testRatio = args.testFilesGrouped / args.testFilesSplit; // src: vulnhunter-fix/scripts/anti-merge-check.py:64
        boolean allowed;
        String reason;
        if (srcRatio <= threshold) {                                                                     // src: vulnhunter-fix/scripts/anti-merge-check.py:67
            allowed = true;
            reason = "source ratio <= threshold";
        } else if (testRatio != null && testRatio <= threshold) {                                        // src: vulnhunter-fix/scripts/anti-merge-check.py:70
            allowed = true;
            reason = "test ratio <= threshold";
        } else {
            allowed = false;                                                                             // src: vulnhunter-fix/scripts/anti-merge-check.py:74
            reason = "grouping inefficient; split into individual PRs";                                  // src: vulnhunter-fix/scripts/anti-merge-check.py:78
        }
        print(json("allowed", allowed, "source_ratio", round(srcRatio, 3), "test_ratio", testRatio, "threshold", threshold, "reason", reason)); // src: vulnhunter-fix/scripts/anti-merge-check.py:80
        if (args.strict && !allowed) return 1;                                                           // src: vulnhunter-fix/scripts/anti-merge-check.py:87
        return 0;                                                                                        // advisory mode always 0
    }
}
