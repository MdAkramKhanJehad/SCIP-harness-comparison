// file: vvaharness/models/scan/context.py
// ContextPackage: what S1 emits (entry points, sinks, modules, files, injected CVEs/controls/CMDB, threat model),
// plus astContextView, the capped "frontier" view S2 evidence gathering builds its prompt from.

@executedBy(CODE) @role(types)
record ContextPackage(String repoRoot, String language, List<List<String>> seedTaintPaths, List<EntryPoint> entryPoints,
                      List<Sink> unsafeSinks, List<ModuleInfo> modules, List<String> allFiles, Map excluded,
                      List<CVE> knownCves, List<Control> designControls, AppProfile appProfile, ThreatModel threatModel,
                      String notes, Map evCollection, Object graphHandle) {
    // seedTaintPaths: s0 semgrep codeFlows; s3 never drops these files                            // src: vvaharness/models/scan/context.py:33
    // evCollection null = exploit verification off; graphHandle excluded from checkpoint (rebuilt on --resume) // src: vvaharness/models/scan/context.py:45

    ContextPackage astContextView(int maxFiles, int maxEntryPoints, int maxSinks, int maxModules, int maxEdges) {
        // defaults 250 / 120 / 160 / 40 / 120; callers pass step2 caps. maxEdges is accepted but unused here. // src: vvaharness/models/scan/context.py:49
        return ScanContext.astContextView(this, maxFiles, maxEntryPoints, maxSinks, maxModules);
    }
}

@executedBy(CODE) @role(step) @stage("S2")
class ScanContext {

    ContextPackage astContextView(ContextPackage ctx, int maxFiles, int maxEntryPoints, int maxSinks, int maxModules) {
        // 1. Seed files, in priority order: entry points, sinks, taint-path nodes, first files of each module
        List<String> seedFiles = new List();
        for (EntryPoint e : ctx.entryPoints.take(maxEntryPoints)) addFile(seedFiles, e.file);       // src: vvaharness/models/scan/context.py:63
        for (Sink s : ctx.unsafeSinks.take(maxSinks)) addFile(seedFiles, s.file);                   // src: vvaharness/models/scan/context.py:65
        for (List<String> path : ctx.seedTaintPaths) for (String node : path) addFile(seedFiles, node.before(":")); // src: vvaharness/models/scan/context.py:67
        for (ModuleInfo m : ctx.modules.take(maxModules)) {                                         // src: vvaharness/models/scan/context.py:70
            for (String p : m.files.take(θ["code.models.scan.context.module_seed_files_cap"])) addFile(seedFiles, p); // src: vvaharness/models/scan/context.py:71
        }
        // 2. File budget: seed files that are in scope first, then fill from the full walk in walk order
        List<String> allFiles = new List();
        for (String p : seedFiles) {
            if (ctx.allFiles.contains(p) && !allFiles.contains(p)) {                                // src: vvaharness/models/scan/context.py:78
                allFiles.add(p);
                if (allFiles.size() >= maxFiles) break;                                             // src: vvaharness/models/scan/context.py:81
            }
        }
        if (allFiles.size() < maxFiles) {                                                           // src: vvaharness/models/scan/context.py:83
            for (String p : ctx.allFiles) {
                if (!allFiles.contains(p)) { allFiles.add(p); if (allFiles.size() >= maxFiles) break; } // src: vvaharness/models/scan/context.py:88
            }
        }
        // 3. Keep only surface items whose file survived the budget
        Set allowed = Set.of(allFiles);
        List<EntryPoint> eps = ctx.entryPoints.filter(e -> allowed.contains(e.file)).take(maxEntryPoints); // src: vvaharness/models/scan/context.py:92
        List<Sink> sinks = ctx.unsafeSinks.filter(s -> allowed.contains(s.file)).take(maxSinks);    // src: vvaharness/models/scan/context.py:93
        List<ModuleInfo> modules = new List();
        for (ModuleInfo m : ctx.modules) {
            List kept = m.files.filter(p -> allowed.contains(p)).take(θ["code.models.scan.context.module_files_kept_cap"]); // src: vvaharness/models/scan/context.py:97
            if (!kept.isEmpty()) modules.add(m.withFiles(kept));                                    // src: vvaharness/models/scan/context.py:98
            if (modules.size() >= maxModules) break;                                                // src: vvaharness/models/scan/context.py:100
        }
        List<List<String>> trimmed = new List();
        for (List<String> path : ctx.seedTaintPaths) {
            List kept = path.filter(n -> allowed.contains(n.before(":")));                          // src: vvaharness/models/scan/context.py:105
            if (!kept.isEmpty()) trimmed.add(kept.take(θ["code.models.scan.context.taint_path_hops_cap"])); // src: vvaharness/models/scan/context.py:107
        }
        return ctx.copyWith(allFiles, eps, sinks, modules, trimmed);                                // src: vvaharness/models/scan/context.py:109
    }

    void addFile(List<String> seedFiles, String path) {
        String norm = path.replace("\\", "/").stripLeading("./");                                 // src: vvaharness/models/scan/context.py:56
        if (!norm.isEmpty() && !seedFiles.contains(norm)) seedFiles.add(norm);                      // src: vvaharness/models/scan/context.py:59
    }
}
