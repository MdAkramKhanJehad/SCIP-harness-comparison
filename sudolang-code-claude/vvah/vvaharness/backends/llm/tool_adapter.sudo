# vvaharness/backends/llm/tool_adapter.py

Adapts the caller's in-process fact tools (graph and CWE queries built by a `ToolBuilder`) for the `sdk` and `openai` agentic loops: Anthropic-shape schemas to offer, and a dispatcher that validates arguments, applies the caller's tool budgets, runs the tool, redacts and caps its result, and reports when a verdict shipped without the evidence the caller's EvidenceGate required.

Source: `vvaharness/backends/llm/tool_adapter.py` (lines 1-245)
Executor: code (the model chooses the calls; this code executes them)
Called from: `vvaharness/backends/llm/deepagents.py` (`build`, for `via: sdk` and `via: openai` legs); the returned `ToolStack` is used inside `sdk.py` and `openai.py` loops (outside this batch)

// src: vvaharness/backends/llm/tool_adapter.py:37-41
EVIDENCE_UNENFORCED_COUNTER = "llm_adapter_evidence_gate_unenforced"
_WARNED = {}   // one entry per degradation already reported (warn_once key)

// src: vvaharness/backends/llm/tool_adapter.py:221-238
fn build(tool_builder, model, cwd, fact_tools, parent_middleware=()):executor=code {
  if (tool_builder == null || fact_tools is empty) return null   // null: the caller withholds the tool paragraph from the prompt
  lc_tools = _materialize(tool_builder, model, cwd, fact_tools)
  if (lc_tools is empty) return null
  // preserved: an empty build returns null silently here, while the cli bridge (cli_mcp.agentic_with_tools) raises for the same situation
  return ToolStack {
    schemas: [_anthropic_schema(t) for each t]   // passed to the loop as extra_tools: the tools offered
    names: tool names
    required: _required_fact_tools(parent_middleware)
    _tools: name -> tool; _middleware: parent_middleware
  }
}

// src: vvaharness/backends/llm/tool_adapter.py:44-55
fn _materialize(tool_builder, model, cwd, fact_tools):executor=code {
  if (fact_tools is empty) return []
  built = tool_builder(StreamingOptions(model, cwd, fact_tools), allowed_tools=()) || []
  return built where tool.name in fact_tools
}
// src: vvaharness/backends/llm/tool_adapter.py:58-73
fn _tool_schema(langchain_tool):executor=code { return { type: "object", properties: tool.args, required: every argument whose spec has no "default" } }
fn _anthropic_schema(langchain_tool):executor=code { return { name, description: trimmed description || name, input_schema: _tool_schema(tool) } }

// src: vvaharness/backends/llm/tool_adapter.py:108-218
ToolStack {
  // src: tool_adapter.py:154-175
  // returns a string tool result, or null when name is not adapted
  dispatch(name, args, tag?):executor=code {
    lc_tool = _tools[name]
    if (lc_tool == null) return null   // not an adapted tool: the loop's own local tools get the name
    // src: tool_adapter.py:123-152 — rejection before execution
    invalid = lc_tool.args_schema.model_validate(args || {}) error, when args_schema has model_validate; otherwise null
    require invalid == null => return _tool_fault(name, args, invalid)   // "ERROR: ValidationError: <redacted>"
    refusal = first non-empty mw.refusal_for(name) across _middleware
    require refusal == null => return refusal   // the caller's own budget is spent
    add name to _called
    for each mw in _middleware with note_call, mw.note_call(name)
    try result = lc_tool.invoke(copy of args)
    catch any error => return _tool_fault(name, args, error)
    out = tools.cap_tool_result(redact_counts(_serialize(result)).text)   // redacted, then capped at TOOL_RESULT_CAP = 48000 characters (tools.py:131)
    log "tool <name>(<summarized args>) -> <N> chars"   // abstracted: console only, suppressed in stage-only display (tool_adapter.py:177-182)
    return out
  }
  _tool_fault(name, args, exc):executor=code {
    COUNTERS.bump("llm_adapter_tool_error_<name>")
    return "ERROR: <ErrorType>: <redacted message>"   // a tool fault never ends the loop
  }
  exhausted_tools():executor=code { return union of mw.exhausted_tools() across _middleware }
  submit_guard():executor=code { return first non-empty mw.hold_for_verdict() across _middleware, else null }   // text handed back as a tool result instead of accepting the verdict
  report_evidence_degradation(tag, label):executor=code {
    if (!required || (required intersection _called)) return
    COUNTERS.bump(EVIDENCE_UNENFORCED_COUNTER)
    // src: tool_adapter.py:205-218
    warn once (key "evidence-gate:$label:$tag") "WARN [$label]: ${ tag || 'this stage' } requires graph evidence, but the session called none of ${ sorted(required) }. submit_guard already rejected this verdict's submit up to max_rejections times (the same relent every EvidenceGate performs, in-loop or out-of-loop) before letting it through. The reply was accepted as-is and counted under `$EVIDENCE_UNENFORCED_COUNTER` in Pipeline Diagnostics."
    // telemetry only: the reply is still accepted
  }
}

