// file: vulnhunter-agent/agent/_body_reconstruct.py
// Verify mode: recover an issue body's original text from GitHub's userContentEdits history.
// The oldest edit's diff field is a raw body snapshot; zero edits means the current body is the original.

@executedBy(CODE) @role(types) @stage("verify")
record DiffApplyError(String message) { }

@executedBy(CODE) @role(step) @stage("verify")
class BodyReconstruct {

    // reconstruct_original: hard stop (DiffApplyError) on missing/non-string fields; never partial.
    String reconstructOriginal(String currentBody, List<Map> edits, Theta θ) {
        if (edits == null || edits.isEmpty()) return currentBody;                                   // src: vulnhunter-agent/agent/_body_reconstruct.py:72
        List<Map> sortedEdits;
        try {
            sortedEdits = edits.sortedBy(e -> e.get("editedAt"));                                    // src: vulnhunter-agent/agent/_body_reconstruct.py:75
        } catch (KeyError exc) {
            throw new DiffApplyError("Edit missing required field");                                 // src: vulnhunter-agent/agent/_body_reconstruct.py:77
        }
        // which snapshot counts as the original: the oldest captured edit
        Map chosen = (θ["code.agent.body_reconstruct.snapshot_choice"] == "oldest") ? sortedEdits.first() : sortedEdits.last(); // src: vulnhunter-agent/agent/_body_reconstruct.py:80
        Object snapshot = chosen.get("diff");                                                        // src: vulnhunter-agent/agent/_body_reconstruct.py:81
        if (snapshot == null) throw new DiffApplyError("Oldest edit has no diff (body-snapshot) field"); // src: vulnhunter-agent/agent/_body_reconstruct.py:82
        if (!(snapshot instanceof String)) throw new DiffApplyError("Oldest edit's diff field is not a string"); // src: vulnhunter-agent/agent/_body_reconstruct.py:87
        return snapshot;                                                                             // src: vulnhunter-agent/agent/_body_reconstruct.py:92
    }
}
