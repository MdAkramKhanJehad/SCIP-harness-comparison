// file: vvaharness/backends/llm/cli/oneshot.py
// via: cli prompt() -- one request, one reply, no tools: `claude -p --tools ""` with the JSON envelope,
// probe-gated --json-schema/--max-budget-usd, one doubled-budget truncation retry, refusal and quality gates.

@executedBy(CODE) @role(backend)
class CliOneshot {

    /** Single-shot prompt with no tools; returns the model's text response. */
    @src("vvaharness/backends/llm/cli/oneshot.py:46")
    String prompt(Object userPrompt, String model, String systemPrompt, Schema jsonSchema, String outputFormat, Path cwd, Double maxBudgetUsd, Integer maxTokens, Integer timeout, String tag, String effort, Theta θ) {
        if (timeout == null) timeout = θ["code.backends.llm.cli.oneshot.default_timeout_s"];                  // src: vvaharness/backends/llm/cli/oneshot.py:56
        // flat text only: cache_control markers on list blocks are dropped (nothing to lose here)
        if (userPrompt instanceof List) userPrompt = String.join("\n\n", userPrompt.filter(b -> b.type == "text").map(b -> b.text)); // src: vvaharness/backends/llm/cli/oneshot.py:62
        if (Cancel.aborted()) throw new RuntimeError("aborted by user (Ctrl-C)");                           // src: vvaharness/backends/llm/cli/oneshot.py:67
        String tier = Env.effectiveEffort(effort);                                                          // src: vvaharness/backends/llm/cli/oneshot.py:69
        double wall = LlmModels.effortScaledSeconds(timeout, tier, REQUEST);                                // src: vvaharness/backends/llm/cli/oneshot.py:70
        List<String> cmd = Discovery.CLAUDE_CMD + List.of("-p", "--model", model) + Env.effortArgv(effort); // src: vvaharness/backends/llm/cli/oneshot.py:71
        if (systemPrompt != null) cmd.addAll("--system-prompt", systemPrompt);                              // src: vvaharness/backends/llm/cli/oneshot.py:74
        cmd.addAll("--output-format", "json");                                                              // always the envelope, for usage // src: vvaharness/backends/llm/cli/oneshot.py:76
        if (jsonSchema != null) {                                                                           // src: vvaharness/backends/llm/cli/oneshot.py:77
            if (Discovery.cliCapabilities().get("json_schema")) {
                cmd.addAll("--json-schema", Json.dumps(jsonSchema));                                        // src: vvaharness/backends/llm/cli/oneshot.py:79
            } else {
                // degrade loudly: schema embedded in the prompt, no longer validator-enforced
                Log.warning("claude build lacks --json-schema; embedding the schema in the prompt");        // src: vvaharness/backends/llm/cli/oneshot.py:82
                userPrompt = userPrompt + "\n\n" + CliSchemaFallbackPrompt.schemaInPrompt(jsonSchema, θ);   // src: vvaharness/backends/llm/cli/oneshot.py:86
            }
        }
        if (maxBudgetUsd != null && Discovery.cliCapabilities().get("max_budget")) cmd.addAll("--max-budget-usd", maxBudgetUsd); // probe-gated // src: vvaharness/backends/llm/cli/oneshot.py:91
        cmd.addAll("--tools", "");                                                                          // all tools disabled // src: vvaharness/backends/llm/cli/oneshot.py:96
        // cwd is still inside the scanned repo: drop its settings/hooks
        cmd.addAll(CliSession.confinementArgv(null, null, null));                                           // src: vvaharness/backends/llm/cli/oneshot.py:98
        Map env = Env.callEnv(maxTokens, effort);                                                           // max output tokens via env, not a flag // src: vvaharness/backends/llm/cli/oneshot.py:102

        // VVAH-E005: one doubled-budget retry then fail loud
        int truncRetried = 0;                                                                               // src: vvaharness/backends/llm/cli/oneshot.py:109
        EnvelopeResult parsed;
        Result result;
        double callStart;
        while (true) {                                                                                      // src: vvaharness/backends/llm/cli/oneshot.py:110
            callStart = Clock.monotonic();                                                                  // per attempt // src: vvaharness/backends/llm/cli/oneshot.py:113
            try {
                result = Retry.runWithRetry(cmd, "prompt(" + model + ")", userPrompt, cwd, wall, 0, env);  // timeout_retries=0 // src: vvaharness/backends/llm/cli/oneshot.py:115
            } catch (TimeoutExpired e) {
                throw LlmModels.callTimeoutError(tag, "cli", wall, tier);                                   // src: vvaharness/backends/llm/cli/oneshot.py:126
            }
            if (result.returncode != 0) {                                                                   // src: vvaharness/backends/llm/cli/oneshot.py:130
                Integer cap = Retry.truncationCap(result);                                                  // src: vvaharness/backends/llm/cli/oneshot.py:131
                if (cap == null) throw new RuntimeError(Discovery.formatCliError("claude CLI failed", cmd, result)); // src: vvaharness/backends/llm/cli/oneshot.py:133
                int requested = maxTokens != null ? maxTokens : cap;                                        // caller's value wins // src: vvaharness/backends/llm/cli/oneshot.py:136
                Integer retryAt = truncRetried != 0 ? null : LlmModels.truncationRetryMax(requested, θ["code.deepagents.model_max_output_tokens"]); // src: vvaharness/backends/llm/cli/oneshot.py:137
                if (retryAt != null) {                                                                      // src: vvaharness/backends/llm/cli/oneshot.py:140
                    Retry.logTruncationRetry(tag, requested, retryAt, "cli");
                    env = env.copy();                                                                       // keeps the effort pin // src: vvaharness/backends/llm/cli/oneshot.py:144
                    env.put("CLAUDE_CODE_MAX_OUTPUT_TOKENS", retryAt);                                      // src: vvaharness/backends/llm/cli/oneshot.py:145
                    truncRetried = retryAt;
                    continue;                                                                               // src: vvaharness/backends/llm/cli/oneshot.py:147
                }
                throw Retry.truncationError(requested, truncRetried, tag, retryAt);                         // src: vvaharness/backends/llm/cli/oneshot.py:148
            }
            // with --tools "" a multi-turn envelope can only be a split reply: stitch it
            parsed = Envelope.parse(result.stdout, true, tag);                                              // src: vvaharness/backends/llm/cli/oneshot.py:152
            if (parsed.stopReason == LlmModels.ANTHROPIC_STOP_MAX_TOKENS) {                                 // insurance // src: vvaharness/backends/llm/cli/oneshot.py:155
                int requested = maxTokens != null ? maxTokens : θ["code.deepagents.model_max_output_tokens"]; // src: vvaharness/backends/llm/cli/oneshot.py:156
                Integer retryAt = truncRetried != 0 ? null : LlmModels.truncationRetryMax(requested, θ["code.deepagents.model_max_output_tokens"]); // src: vvaharness/backends/llm/cli/oneshot.py:157
                if (retryAt != null) {
                    Retry.logTruncationRetry(tag, requested, retryAt, "cli");
                    env = env.copy();
                    env.put("CLAUDE_CODE_MAX_OUTPUT_TOKENS", retryAt);                                      // src: vvaharness/backends/llm/cli/oneshot.py:164
                    truncRetried = retryAt;
                    continue;
                }
                throw Retry.truncationError(requested, truncRetried, tag, retryAt);                         // src: vvaharness/backends/llm/cli/oneshot.py:167
            }
            if (truncRetried != 0) Counters.bump(LlmModels.TRUNCATED_RETRY_RECOVERED_COUNTER);              // src: vvaharness/backends/llm/cli/oneshot.py:170
            break;
        }
        LlmModels.noteBudgetUse(Clock.monotonic() - callStart, wall, tier);                                 // src: vvaharness/backends/llm/cli/oneshot.py:173
        Envelope.noteUnparsedCacheKeys(parsed.usage);                                                       // src: vvaharness/backends/llm/cli/oneshot.py:174
        Tokens.TOKENS.add(parsed.usage, parsed.usd, parsed.turns);                                          // src: vvaharness/backends/llm/cli/oneshot.py:175
        Retry.logUsage(parsed.usage, parsed.stopReason, parsed.modelUsage);                                 // src: vvaharness/backends/llm/cli/oneshot.py:176
        Envelope.raiseIfRefused(parsed.stopReason, tag, result.stdout);                                     // usage banked first // src: vvaharness/backends/llm/cli/oneshot.py:177
        ResponseQuality.check(parsed.text, tag, ResponseQuality.outputTokensForGate(parsed.usage));         // src: vvaharness/backends/llm/cli/oneshot.py:178
        return parsed.text;
    }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/cli/oneshot.py:86")
class CliSchemaFallbackPrompt {

    /** Used only when the claude build lacks --json-schema. */
    Prompt schemaInPrompt(Schema jsonSchema, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["code.backends.llm.cli.oneshot.schema_in_prompt_fallback"]);                             // "Respond with ONLY a JSON object conforming to this JSON Schema:" // src: vvaharness/backends/llm/cli/oneshot.py:87
        p.context(jsonSchema);                                                                              // src: vvaharness/backends/llm/cli/oneshot.py:88
        return p;
    }
}
