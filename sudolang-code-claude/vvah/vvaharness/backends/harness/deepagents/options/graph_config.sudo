# vvaharness/backends/harness/deepagents/options/graph_config.py

Builds the LangGraph invoke configuration for a graph: a fresh random thread id and, when `max_turns` is set, a recursion limit of `max_turns + buffer`.

Source: `vvaharness/backends/harness/deepagents/options/graph_config.py` (lines 1-30)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/oneshot.sudo` build_oneshot_options (buffer=5)

// src: vvaharness/backends/harness/deepagents/options/graph_config.py:25-30
fn _make_config(options, buffer):executor=code {
  config = { configurable: { thread_id: 8 random bytes as hexadecimal } }
  if (options.max_turns != null) config.recursion_limit = options.max_turns + buffer
  // No recursion_limit key when max_turns is null: the LangGraph library default applies.  // external: langgraph
  return config
}
// preserved: the streaming path does not use this helper; it builds its own config with (max_turns or 50) + RECURSION_HEADROOM (900). See streaming.sudo.
