// file: vvaharness/evidence/api_artefacts.py
// S2 evidence: API-contract artefacts (OpenAPI/Swagger/Protobuf/GraphQL/WSDL/Avro/Thrift/META-INF/AndroidManifest), paths only.

@executedBy(CODE) @role(step) @stage("S2")
class ApiArtefacts {

    /** Files matching an API-contract glob (case-sensitive or lower-cased), in file-list order, capped. */
    List<String> gatherApiArtefacts(List<String> fullFiles, int maxApiArtefacts, Theta θ) {
        List<String> globs = θ["code.evidence.api_artefacts.api_surface_globs"];                 // src: vvaharness/evidence/api_artefacts.py:20
        List<String> artefacts = new List();
        for (String rel : fullFiles) {                                                           // src: vvaharness/evidence/api_artefacts.py:32
            for (String g : globs) {                                                             // src: vvaharness/evidence/api_artefacts.py:33
                if (fnmatchCase(rel, g) || fnmatchCase(rel.lower(), g)) { artefacts.add(rel); break; } // src: vvaharness/evidence/api_artefacts.py:34
            }
        }
        return artefacts.head(maxApiArtefacts);                                     // = maxApiArtefacts. src: vvaharness/evidence/api_artefacts.py:37
    }
}
