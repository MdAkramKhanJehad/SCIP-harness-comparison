            Console.write("agentic requests mutating/Bash tools - delegating to the Claude Agent SDK backend"); // src: vvaharness/backends/llm/sdk.py:1268
            return AgentSdk.agentic(userPrompt, model, systemPrompt, allowed, cwd, maxTurns, timeout != null ? timeout.doubleValue() : null, effort); // max_budget_usd, permission_mode and tag forwarded; both knobs enforced there // src: vvaharness/backends/llm/sdk.py:1272
        }
