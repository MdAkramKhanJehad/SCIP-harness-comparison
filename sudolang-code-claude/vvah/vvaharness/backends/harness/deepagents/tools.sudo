# vvaharness/backends/harness/deepagents/tools.py

Resolves the logical tool allow-list (profile names such as `Read`) into the native deepagents tool names, and guards caller-built session tools against taking a reserved native name.

Source: `vvaharness/backends/harness/deepagents/tools.py` (lines 1-112)
Executor: code
Called from: `options/streaming.py:71` and `options/oneshot.py:79` (session_tool_names); native_tool_names from options code; build_tools from the client

// src: vvaharness/backends/harness/deepagents/tools.py:68-76
fn native_tool_names(options, allowed_tools):executor=code {
  allowed = _allowed_tool_names(options, allowed_tools)
  _warn_unknown_tools(options, allowed)
  return [native for each (logical, native) in LOGICAL_TO_NATIVE where logical in allowed]   // Read->read_file, Grep->grep, Glob->glob, Edit->edit_file, Write->write_file; nothing else maps
}

// src: vvaharness/backends/harness/deepagents/tools.py:60-65
fn _allowed_tool_names(options, allowed_tools):executor=code {
  return set(allowed_tools if not null, else options.tool_policy.allowed_tools, else [])
}

// src: vvaharness/backends/harness/deepagents/tools.py:38-57
_UNMAPPED_BY_DESIGN = ORCHESTRATION_TOOLS union MUTATING_TOOLS
fn _warn_unknown_tools(options, allowed):executor=code {
  known = keys of LOGICAL_TO_NATIVE union _UNMAPPED_BY_DESIGN union options.fact_tools
  for each name in sorted(allowed - known) {
    if (name starts with "mcp__") skip
    warn "WARN [deepagents]: unrecognised tool name $name in the allow-list — it maps to no tool on this backend and is ignored"   // once per distinct name per process; never raises
  }
}

// src: vvaharness/backends/harness/deepagents/tools.py:79-98
fn session_tool_names(tools):executor=code {
  names = { tool.name for each tool where name is a string }   // a nameless entry is dropped (fail closed)
  reserved = names intersection ALL_NATIVE_TOOLS   // see deepagents/models.sudo
  require reserved is empty => throw ValueError("session tool name(s) $reserved collide with reserved native tool names; rename them — permitting a native by way of a session tool would bypass the executor-seam gate")
  return names   // added to the PermitTools permit set
}

// src: vvaharness/backends/harness/deepagents/tools.py:101-109
fn build_tools(options, allowed_tools):executor=code {
  _warn_unknown_tools(options, _allowed_tool_names(options, allowed_tools))
  return []   // natives come from deepagents middleware; this backend builds no extra tools here
}
