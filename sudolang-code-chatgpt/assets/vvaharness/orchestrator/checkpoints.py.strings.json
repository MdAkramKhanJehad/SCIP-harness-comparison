    {
      "source": "vvaharness/orchestrator/checkpoints.py",
      "line_start": 242,
      "line_end": 242,
      "text": "Persist ``obj`` for ``(run_id, step)`` to the SQLite state store; ``ckpt_dir`` is kept only for call-site compatibility.",
