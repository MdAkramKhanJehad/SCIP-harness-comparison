# vvaharness/backends/llm/tls.py

Shared TLS helpers for the backend clients: string-to-boolean coercion of `verify_ssl`, Anthropic authentication arguments for an API key or OAuth token, mutual-TLS client-chain loading (an absent file disables mutual TLS with a warning), and a scoped `NO_PROXY` override.

Source: `vvaharness/backends/llm/tls.py` (lines 1-133)
Executor: code
Called from: `cli/env.sudo` (`coerce_verify`), `vvaharness/backends/llm/sdk.py`, `openai.py`, `vvaharness/backends/harness/deepagents/options/model_building.py`, `vvaharness/orchestrator/scan.py`, `preflight.py`

// src: vvaharness/backends/llm/tls.py:30-50
Constants {
  _TRUE = { "true", "1", "yes", "on" }; _FALSE = { "false", "0", "no", "off" }
  _NO_PROXY_KEYS = ("NO_PROXY", "no_proxy")
  _OAUTH_TOKEN_PREFIX = "sk-ant-oat"; _OAUTH_BETA_HEADER = "oauth-2025-04-20"
}
fn anthropic_auth_kwargs(token):executor=code {
  token = trimmed token or ""
  if (token starts with _OAUTH_TOKEN_PREFIX) return { auth_token: token, default_headers: { "anthropic-beta": "oauth-2025-04-20" } }
  return if (token) { api_key: token } else {}
}
fn is_anthropic_oauth_token(token):executor=code { return trimmed token starts with "sk-ant-oat" }

// src: vvaharness/backends/llm/tls.py:53-64
fn coerce_verify(value):executor=code {
  if (value == null || value is a boolean) return value
  if (value is a string) {
    if (lowercased trimmed value in _FALSE) return false   // quoted YAML "false" would otherwise be truthy and leave verification on
    if (lowercased trimmed value in _TRUE) return true
  }
  return value   // any other string is a CA bundle path
}

// src: vvaharness/backends/llm/tls.py:67-101
fn chain_paths(cert):executor=code { return tuple(cert) if a tuple or list else (cert,) }   // YAML gives a list
fn resolve_client_chain(cert, label, noun="client_cert"):executor=code {
  if (!cert) return null
  missing = first non-empty path in chain_paths(cert) that does not exist
  if (missing != null) { warn TLS_CLIENT_CHAIN_MISSING; return null }   // deliberate: an absent certificate or key disables mutual TLS (a malformed CA bundle fails closed elsewhere)
  return cert
}
fn load_client_chain(context, cert, label):executor=code {
  try context.load_cert_chain(...chain_paths(cert))
  catch any error => { warn TLS_CLIENT_CHAIN_UNLOADABLE (error type only); return false }
  return true
}

// src: vvaharness/backends/llm/tls.py:104-110
fn warn_verify_disabled(base, label, default_endpoint="<default endpoint>", ca_hint="ca_cert"):executor=code { warn TLS_VERIFY_DISABLED naming base || default_endpoint }

// src: vvaharness/backends/llm/tls.py:113-133
fn scoped_no_proxy_env(no_proxy):executor=code {
  // A context manager around client construction: httpx reads the proxy environment once, at that moment
  if (!no_proxy) { run the body; return }
  prior = current NO_PROXY and no_proxy values
  set both NO_PROXY and no_proxy = no_proxy; run the body
  constraint OnEveryExit { restore each key to its prior value, deleting it when it was unset }
  // preserved: this mutates the process-wide os.environ for the duration, so concurrent threads see the override
}
