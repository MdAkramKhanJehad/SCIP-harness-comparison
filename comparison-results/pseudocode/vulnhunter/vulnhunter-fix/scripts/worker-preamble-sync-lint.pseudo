// file: vulnhunter-fix/scripts/worker-preamble-sync-lint.py
// Byte-coherence of duplicate prompt blocks; 0 clean/no markers, 1 source drift, 2 malformed consumer or absent consumer.

@executedBy(CODE) @role(tool) @stage("fix")
class WorkerPreambleSyncLint {
    @src("vulnhunter-fix/scripts/worker-preamble-sync-lint.py:39")
    Map extractBlocks(Path path, Theta θ) {
        List<String> lines = path.readText("utf-8").splitlines(keepends=true); Map blocks = new Map(); Pair openKey = null; int openStart = -1;
        Regex startRx = Regex.compile(θ["code.fix.scripts.worker_preamble_sync_lint.start_re"]); Regex endRx = Regex.compile(θ["code.fix.scripts.worker_preamble_sync_lint.end_re"]); // src: vulnhunter-fix/scripts/worker-preamble-sync-lint.py:35 // src: vulnhunter-fix/scripts/worker-preamble-sync-lint.py:36
        for (Indexed line : enumerate(lines)) {
            Match start = startRx.search(line.value); Match end = endRx.search(line.value);
            if (start != null && end != null) { printError("start/end on same line"); return null; }
            if (start != null) {
                if (openKey != null) { printError("nested block"); return null; }
                openKey = new Pair(start.group(1), start.group(2)); openStart = line.index + 1;
            } else if (end != null) {
                if (openKey == null) { printError("end without start"); return null; }
                Pair key = new Pair(end.group(1), end.group(2)); if (key != openKey) { printError("mismatched end"); return null; }
                blocks.put(openKey, join("", lines.subList(openStart, line.index))); openKey = null;
            }
        }
        if (openKey != null) { printError("unterminated block"); return null; }
        return blocks; // duplicate keys overwrite earlier blocks.
    }
    @src("vulnhunter-fix/scripts/worker-preamble-sync-lint.py:89")
    int main(Theta θ) {
        Path prompts = skillRoot().resolve("prompts"); Path consumer = prompts.resolve("worker_agent_common.md");
        if (!consumer.exists()) return 2;
        Map blocks = extractBlocks(consumer, θ); if (blocks == null) return 2; if (blocks.isEmpty()) return 0;
        List drift = new List();
        for (Pair key : blocks.keys()) {
            Path source = prompts.resolve(key.first); if (!source.exists()) { drift.add("source absent"); continue; }
            Map originals = extractBlocks(source, θ); if (originals == null) { drift.add("malformed source"); continue; }
            String original = originals.get(key); if (original == null) { drift.add("source block absent"); continue; }
            if (original != blocks.get(key)) drift.add("byte drift");
        }
        if (!drift.isEmpty()) { printError(drift); return 1; } return 0;
    }
}
