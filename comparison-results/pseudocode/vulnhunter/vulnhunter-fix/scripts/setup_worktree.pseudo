// file: vulnhunter-fix/scripts/setup_worktree.sh
// In-place mode: create or reuse a per-finding git worktree at <repo>/.vulnhunter-fix/worktrees/<key>/ on
// branch vulnfix/<sanitized-slug>, excluding the work dir locally via .git/info/exclude.

@executedBy(CODE) @role(tool) @stage("fix")
class SetupWorktree {

    Map run(String key, String slug, String baseBranch, Theta θ) {
        if (key == null || slug == null) return usageError();                                              // src: vulnhunter-fix/scripts/setup_worktree.sh:26
        // key flows into a path: must be exactly 16 lowercase hex
        if (!Regex.fullmatch("^[0-9a-f]<16>$", key)) return exit(1);                                       // src: vulnhunter-fix/scripts/setup_worktree.sh:32
        String repoRoot = Git.revParseShowToplevel();                                                      // src: vulnhunter-fix/scripts/setup_worktree.sh:37
        String wtRoot = repoRoot + "/.vulnhunter-fix/worktrees";                                           // src: vulnhunter-fix/scripts/setup_worktree.sh:40
        String wtPath = wtRoot + "/" + key;                                                                // src: vulnhunter-fix/scripts/setup_worktree.sh:41
        // slug sanitized to [a-z0-9-], runs of dashes collapsed, edge dashes trimmed
        String sanitized = slug.lower().replaceRegex("[^a-z0-9-]", "-").collapseRuns("-").strip("-");      // src: vulnhunter-fix/scripts/setup_worktree.sh:46
        if (sanitized.isEmpty()) return exit(1);                                                           // src: vulnhunter-fix/scripts/setup_worktree.sh:47
        String branch = "vulnfix/" + sanitized;                                                            // src: vulnhunter-fix/scripts/setup_worktree.sh:51
        String exclude = repoRoot + "/.git/info/exclude";                                                  // src: vulnhunter-fix/scripts/setup_worktree.sh:56
        if (Path.isFile(exclude) && !Files.hasExactLine(exclude, ".vulnhunter-fix/")) Files.append(exclude, ".vulnhunter-fix/\n"); // src: vulnhunter-fix/scripts/setup_worktree.sh:58
        if (baseBranch == null || baseBranch.isEmpty()) baseBranch = resolveBaseBranch(repoRoot, θ);     // src: vulnhunter-fix/scripts/setup_worktree.sh:70
        Path.mkdirs(wtRoot);                                                                               // src: vulnhunter-fix/scripts/setup_worktree.sh:86
        Git.run(repoRoot, "worktree", "prune");                                                            // src: vulnhunter-fix/scripts/setup_worktree.sh:90
        // idempotent reuse
        if (Path.exists(wtPath + "/.git")) return Map.of("status", "ok", "reused", true, "path", wtPath, "branch", branch); // src: vulnhunter-fix/scripts/setup_worktree.sh:93
        if (Git.showRefVerifyQuiet(repoRoot, "refs/heads/" + branch)) {
            Git.run(repoRoot, "worktree", "add", wtPath, branch);                                          // src: vulnhunter-fix/scripts/setup_worktree.sh:102
        } else {
            // fetch base from origin when only remote; fetch failure ignored
            if (!Git.showRefVerifyQuiet(repoRoot, "refs/heads/" + baseBranch)) Git.runIgnoringFailure(repoRoot, "fetch", "origin", baseBranch + ":" + baseBranch); // src: vulnhunter-fix/scripts/setup_worktree.sh:107
            Git.run(repoRoot, "worktree", "add", "-b", branch, wtPath, baseBranch);                        // src: vulnhunter-fix/scripts/setup_worktree.sh:109
        }
        return Map.of("status", "ok", "reused", false, "path", wtPath, "branch", branch, "base", baseBranch); // src: vulnhunter-fix/scripts/setup_worktree.sh:112
    }

    String resolveBaseBranch(String repoRoot, Theta θ) {
        // local refs only (no gh network call): origin/HEAD, then main/master on origin, then current branch
        String b = Git.symbolicRefShortOrEmpty(repoRoot, "refs/remotes/origin/HEAD").removePrefix("origin/"); // src: vulnhunter-fix/scripts/setup_worktree.sh:71
        if (b.isEmpty()) {
            for (String cand : θ["code.fix.scripts.setup_worktree.fallback_base_branches"]) {              // src: vulnhunter-fix/scripts/setup_worktree.sh:74
                if (Git.revParseVerifyQuiet(repoRoot, "refs/remotes/origin/" + cand)) {                    // src: vulnhunter-fix/scripts/setup_worktree.sh:75
                    b = cand;
                    break;
                }
            }
        }
        if (b.isEmpty()) b = Git.revParseAbbrevRefHeadOr(repoRoot, "main");                                // src: vulnhunter-fix/scripts/setup_worktree.sh:82
        return b;
    }
}
