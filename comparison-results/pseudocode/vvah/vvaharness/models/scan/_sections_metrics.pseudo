// file: vvaharness/models/scan/_sections_metrics.py
// Report sections: Scan Metrics (tokens by phase, language LOC coverage), the Verification funnel
// (raw -> verified -> reported reconciliation), Scan Health warnings and the Scan Scope appendix.

@executedBy(CODE) @role(io) @stage("S9")
class SectionsMetrics {

    List<String> renderMetrics(FinalReport report, boolean unreachableAppendix) {
        ScanMetrics m = report.metrics;
        List<String> lines = List.of("## Scan Metrics", "- Scan ID, Module, Start, End, Duration, Files in scope, Files analyzed (unique)", // src: vvaharness/models/scan/_sections_metrics.py:40
            "- Coverage: <coverage_pct>% (files analyzed / files in scope)",                       // src: vvaharness/models/scan/_sections_metrics.py:49
            SectionsPipeline.renderChunkKindLine(report),                                           // src: vvaharness/models/scan/_sections_metrics.py:50
            "- Tokens (prompt/completion/total): value or 'unavailable'");                          // src: vvaharness/models/scan/_sections_metrics.py:51
        if (!m.foldersScanned.isEmpty()) lines.add("- Folders scanned: <n>");                      // src: vvaharness/models/scan/_sections_metrics.py:57
        lines.addAll(SectionsPipeline.renderPipelineDiagnostics(report, unreachableAppendix));      // src: vvaharness/models/scan/_sections_metrics.py:58
        if (!m.tokensByPhase.isEmpty()) {
            // cache-read shown separately, not included in totals
            long grand = max(1, m.tokensByPhase.values().sum(b -> b.prompt + b.completion));       // src: vvaharness/models/scan/_sections_metrics.py:70
            for (Entry e : m.tokensByPhase.sortedBy(kv -> -(kv.prompt + kv.completion))) {          // src: vvaharness/models/scan/_sections_metrics.py:72
                String label = Set.of("unlabeled", "unscoped").contains(e.key) ? "unscoped (outside stage wrapper)" : e.key; // src: vvaharness/models/scan/_sections_metrics.py:74
                lines.add("| " + label + " | calls | prompt | completion | total | " + (e.total * 100.0 / grand) + " | cache_read |"); // src: vvaharness/models/scan/_sections_metrics.py:78
            }
        }
        if (!m.locInScopeByLanguage.isEmpty()) {
            for (Entry e : m.locInScopeByLanguage.sorted()) {                                       // src: vvaharness/models/scan/_sections_metrics.py:90
                int scanned = m.locScannedByLanguage.getOrDefault(e.key, 0);
                double pct = e.value != 0 ? scanned * 100.0 / e.value : 0.0;                        // src: vvaharness/models/scan/_sections_metrics.py:92
                lines.add("| " + e.key + " | " + e.value + " | " + scanned + " | " + pct + " |");
            }
        }
        return lines;
    }

    List<String> renderVerification(FinalReport report, boolean postureChannel) {
        Counter byReason = report.dropped.countBy(d -> d.reason);                                   // src: vvaharness/models/scan/_sections_metrics.py:100
        int fp = byReason.get("FALSE_POSITIVE"); int unc = byReason.get("UNCONFIRMED"); int dup = byReason.get("DUPLICATE"); // src: vvaharness/models/scan/_sections_metrics.py:101
        // undetermined verifications are NOT confirmed FPs; counted apart
        int verr = report.undeterminedDropCount();                                                  // src: vvaharness/models/scan/_sections_metrics.py:104
        int reverifyDropped = report.dropped.count(d -> !d.reason.equals("DUPLICATE") && d.chunkId.endsWith("+s6")); // src: vvaharness/models/scan/_sections_metrics.py:108
        int dupPre = report.dropped.count(d -> d.reason.equals("DUPLICATE") && d.canonicalIdx == null); // src: vvaharness/models/scan/_sections_metrics.py:111
        Pair tpfp = report.verifiedTpFp();                                                          // src: vvaharness/models/scan/_sections_metrics.py:113
        String rate = (tpfp.tp + tpfp.fp) > 0 ? pct(tpfp.tp, tpfp.tp + tpfp.fp) : "n/a (no TRUE_POSITIVE/FALSE_POSITIVE verdicts)"; // src: vvaharness/models/scan/_sections_metrics.py:116
        int discovered = report.metrics != null ? report.metrics.discoveredTruePositiveCount : 0;   // src: vvaharness/models/scan/_sections_metrics.py:119
        int clones = report.metrics != null ? report.metrics.repeatCloneTruePositiveCount : 0;
        int nPosture = postureChannel ? report.findings.count(rf -> rf.finding.channel.equals("posture")) : 0; // src: vvaharness/models/scan/_sections_metrics.py:122
        List<String> out = List.of("## Verification", "- Raw findings (pre-verification): " + report.rawFindingsCount,
                                   "- Verified true positives: <tp> -> <n> reported after dedup" + (nPosture > 0 ? " (<app> application-defect + <posture> posture)" : "")); // src: vvaharness/models/scan/_sections_metrics.py:129
        if (discovered + clones > 0) out.add("  - of which verifier-discovered and repeat-site clones"); // src: vvaharness/models/scan/_sections_metrics.py:132
        out.add("- False positives / Unconfirmed (below the verifier confidence gate) / Verifier errors or inconclusive (undetermined)"); // src: vvaharness/models/scan/_sections_metrics.py:137
        if (reverifyDropped > 0) out.add("- Verifier-discovered findings dropped on re-verify: " + reverifyDropped); // src: vvaharness/models/scan/_sections_metrics.py:141
        out.add("- Duplicates collapsed (all passes): <dup> - <dup_pre> before verification, <dup - dup_pre> after"); // src: vvaharness/models/scan/_sections_metrics.py:145
        out.add("- Verifier confirmation rate: " + rate + " (the harness grading its own findings, not precision against ground truth)"); // src: vvaharness/models/scan/_sections_metrics.py:147
        out.addAll(evLines(report));                                                                // src: vvaharness/models/scan/_sections_metrics.py:152
        return out;
    }

    List<String> evLines(FinalReport report) {
        List ev = report.findings.map(rf -> rf.finding.evStatus);                                   // src: vvaharness/models/scan/_sections_metrics.py:159
        int tested = ev.count("CONFIRMED") + ev.count("NOT_CONFIRMED") + ev.count("INCONCLUSIVE"); // src: vvaharness/models/scan/_sections_metrics.py:163
        List<String> out = new List();
        if (tested > 0) out = List.of("- Exploit verification: confirmed / not confirmed / requiring review (<n> live-tested)", "  - " + EV_POSITIVE_ONLY_NOTE); // src: vvaharness/models/scan/_sections_metrics.py:165
        int rescued = report.metrics != null ? report.metrics.evRescuedCount : 0;                   // src: vvaharness/models/scan/_sections_metrics.py:176
        if (rescued > 0) out.add("- Kept without a true-positive verdict (exploit-verified live, dropped by the static verifier): " + rescued); // src: vvaharness/models/scan/_sections_metrics.py:177
        return out;
    }

    List<String> relentLines(ScanMetrics m) {
        // _RELENT_STAGES: s2 threat model, s4 deep-dive, s6 verification
        if (m == null) return List.of();                                                            // src: vvaharness/models/scan/_sections_metrics.py:193
        List<String> out = new List();
        for (Pair st : RELENT_STAGES) {                                                             // src: vvaharness/models/scan/_sections_metrics.py:196
            int relented = m.get(st.prefix + "_evidence_gate_rejected_relented");
            if (relented == 0) continue;                                                            // src: vvaharness/models/scan/_sections_metrics.py:198
            out.add("- WARNING " + st.label + " proceeded without graph-tool evidence after <rejected> rejected attempt(s)"); // src: vvaharness/models/scan/_sections_metrics.py:201
        }
        return out;
    }

    List<String> unrankedLines(FinalReport report) {
        Triple s = report.unrankedSplit();                                                          // src: vvaharness/models/scan/_sections_metrics.py:211
        if (s.byDesign == 0 && s.feederMissed == 0) return List.of();                               // src: vvaharness/models/scan/_sections_metrics.py:213
        String line = "- S8 ranked <ranked> of <total> finding(s)";
        if (s.byDesign > 0) line += "; <n> omitted by design (no chain role)";                      // src: vvaharness/models/scan/_sections_metrics.py:217
        if (s.feederMissed > 0) line += "; <n> feed a chain step but got no entry";                 // src: vvaharness/models/scan/_sections_metrics.py:219
        return List.of(line + ".");
    }

    List<String> renderScanHealth(FinalReport report) {
        ScanMetrics m = report.metrics;
        boolean degraded = report.degraded;                                                         // src: vvaharness/models/scan/_sections_metrics.py:228
        int failed = m != null ? m.chunksFailed : 0;
        Map errs = m != null ? m.errorsByStage : Map.of();
        boolean hollow = report.isHollow();                                                         // src: vvaharness/models/scan/_sections_metrics.py:231
        List coverage = report.coverageDegraded();                                                  // src: vvaharness/models/scan/_sections_metrics.py:232
        List relents = relentLines(m); List unranked = unrankedLines(report);
        if (!(degraded || failed > 0 || !errs.isEmpty() || hollow || !coverage.isEmpty() || !relents.isEmpty() || !unranked.isEmpty() || (m != null && m.deepdiveSkipped))) return List.of(); // src: vvaharness/models/scan/_sections_metrics.py:235
        List<String> lines = List.of("## Scan Health");
        if (m != null && m.deepdiveSkipped) lines.add("- External findings supplied; S4 deep-dive intentionally skipped."); // src: vvaharness/models/scan/_sections_metrics.py:239
        if (hollow) lines.add("- WARNING Hollow scan: threat-model pass produced no usable threats on a non-empty repository"); // src: vvaharness/models/scan/_sections_metrics.py:242
        lines.addAll(coverageDegradedLines(report, coverage));                                      // src: vvaharness/models/scan/_sections_metrics.py:248
        if (degraded) lines.add("- WARNING DEGRADED - " + (report.degradedReason != null ? report.degradedReason : "(no reason recorded)")); // src: vvaharness/models/scan/_sections_metrics.py:249
        if (failed > 0) lines.add("- WARNING Degraded coverage: <failed>/<attempted> deep-dive chunk(s) failed or timed out"); // src: vvaharness/models/scan/_sections_metrics.py:253
        if (!errs.isEmpty()) lines.add("- Non-fatal errors logged by stage: <stage=n,...>");        // src: vvaharness/models/scan/_sections_metrics.py:259
        lines.addAll(relents); lines.addAll(unranked);                                              // src: vvaharness/models/scan/_sections_metrics.py:263
        if (m != null && m.errorsLogPath != null) lines.add("- Full error log: <name>");             // src: vvaharness/models/scan/_sections_metrics.py:265
        return lines;
    }

    List<String> coverageDegradedLines(FinalReport report, List<String> reasons) {
        ScanMetrics m = report.metrics;
        List<String> out = new List();
        if (reasons.contains("s6_undetermined")) {                                                  // src: vvaharness/models/scan/_sections_metrics.py:274
            int n = report.undeterminedDropCount(); Pair tpfp = report.verifiedTpFp();
            out.add("- WARNING Verification coverage loss - <n> of <n+tp+fp> verdicts were undetermined"); // src: vvaharness/models/scan/_sections_metrics.py:279
        }
        if (reasons.contains("zero_analysis")) {                                                    // src: vvaharness/models/scan/_sections_metrics.py:283
            boolean allDetector = report.findings.all(rf -> rf.finding.origin.equals("detector"));  // src: vvaharness/models/scan/_sections_metrics.py:285
            String source = allDetector ? "from a deterministic detector" : "from detectors and the verifier's re-verify wave";
            if (m.deepdiveSkipped) source = "from external input and downstream processing";       // src: vvaharness/models/scan/_sections_metrics.py:291
            out.add("- WARNING No file reached deep-dive analysis - every finding comes " + source); // src: vvaharness/models/scan/_sections_metrics.py:293
        }
        if (reasons.contains("llm_turn_cap_exhausted")) {                                           // src: vvaharness/models/scan/_sections_metrics.py:298
            out.add("- WARNING Turn budget exhausted - <n> agentic session(s) forced to answer from partial evidence"); // src: vvaharness/models/scan/_sections_metrics.py:299
        }
        return out;
    }

    List<String> renderScopeAppendix(FinalReport report) {
        ScanMetrics m = report.metrics;
        List<String> out = List.of("## Appendix: Scan Scope");                                      // src: vvaharness/models/scan/_sections_metrics.py:310
        if (!m.foldersScanned.isEmpty()) for (String d : m.foldersScanned) out.add("- `" + foldTicks(ScanRender.mdCell(d)) + "/`"); // src: vvaharness/models/scan/_sections_metrics.py:316
        Map ex = m.excluded;
        int ddDropped = ex.get("config_dedup").getOrDefault("dropped", 0);                          // src: vvaharness/models/scan/_sections_metrics.py:321
        if (ddDropped > 0 || List.of("dirs", "exts", "globs", "oversize", "symlinks", "symlink_targets").any(k -> ex.has(k))) { // src: vvaharness/models/scan/_sections_metrics.py:322
            out.add("### Excluded from scan (<n_total> files)");                                    // src: vvaharness/models/scan/_sections_metrics.py:332
            if (ex.has("dirs")) for (Entry e : ex.get("dirs").sortedByCountDesc()) out.add("- dir/ - <n> file(s)");        // src: vvaharness/models/scan/_sections_metrics.py:337
            if (ex.has("exts")) for (Entry e : ex.get("exts").sortedByCountDesc()) out.add("- *ext - <n> file(s)");        // src: vvaharness/models/scan/_sections_metrics.py:344
            if (ex.has("globs")) for (Entry e : ex.get("globs").sortedByCountDesc()) out.add("- glob - <n> file(s)");      // src: vvaharness/models/scan/_sections_metrics.py:351
            if (ex.has("oversize")) for (Pair p : ex.get("oversize_files")) out.add("- path - <KB> KB");                  // src: vvaharness/models/scan/_sections_metrics.py:358
            if (ex.has("symlinks")) for (Entry e : ex.get("symlinks").sortedByCountDesc()) out.add("- symlink (target outside repo, not followed)"); // src: vvaharness/models/scan/_sections_metrics.py:367
            if (ex.has("symlink_targets")) for (String p : ex.get("symlink_targets").sorted()) out.add("- symlink (target excluded)"); // src: vvaharness/models/scan/_sections_metrics.py:375
            Map dd = ex.get("config_dedup");
            if (dd.get("dropped") > 0) {
                out.add("**Config dedup**: candidates -> shape-clusters; kept reps + promoted, dropped near-duplicates."); // src: vvaharness/models/scan/_sections_metrics.py:380
                for (Map c : dd.get("top_clusters")) out.add("- sample x size (kept, dropped)");    // src: vvaharness/models/scan/_sections_metrics.py:387
                for (Pair p : dd.get("promoted_files")) out.add("- promoted file - matched key/rule"); // src: vvaharness/models/scan/_sections_metrics.py:398
            }
        }
        return out;
    }
}
