// file: vvaharness/backends/harness/deepagents/prompt_caching.py
// Anthropic prompt caching via block-level cache_control markers only (some proxies DROP the stock
// middleware's top-level cache_control): marks system, tools and, on agentic sessions, the conversation tail.

@executedBy(CODE) @role(backend)
class PromptCaching {

    // The block with a marker attached, or null when ineligible (empty string, thinking blocks).
    Object taggedBlock(Object block, Map<String, String> cacheControl, Theta θ) {
        if (block instanceof String) {
            return block.isEmpty() ? null : Map.of("type", "text", "text", block, "cache_control", cacheControl); // src: vvaharness/backends/harness/deepagents/prompt_caching.py:50
        }
        if (block instanceof Map && !θ["code.backends.harness.deepagents.prompt_caching.ineligible_tail_block_types"].contains(block.get("type"))) { // src: vvaharness/backends/harness/deepagents/prompt_caching.py:56
            return block.with("cache_control", cacheControl);                                            // src: vvaharness/backends/harness/deepagents/prompt_caching.py:57
        }
        return null;
    }

    // Walk from the end; mark the last eligible block.
    List<Object> tagBlocks(List<Object> content, Map<String, String> cacheControl, Theta θ) {
        for (int index = content.size() - 1; index >= 0; index--) {                                      // src: vvaharness/backends/harness/deepagents/prompt_caching.py:65
            Object tagged = taggedBlock(content.get(index), cacheControl, θ);                            // src: vvaharness/backends/harness/deepagents/prompt_caching.py:66
            if (tagged != null) return content.replaceAt(index, tagged);                                 // src: vvaharness/backends/harness/deepagents/prompt_caching.py:68
        }
        return null;
    }

    List<Object> tagContent(Object content, Map<String, String> cacheControl, Theta θ) {
        if (content instanceof String) {
            Object block = taggedBlock(content, cacheControl, θ);                                        // src: vvaharness/backends/harness/deepagents/prompt_caching.py:77
            return block == null ? null : List.of(block);
        }
        return tagBlocks(content, cacheControl, θ);                                                      // src: vvaharness/backends/harness/deepagents/prompt_caching.py:79
    }

    List<Message> tagTail(List<Message> messages, Map<String, String> cacheControl, Theta θ) {
        if (messages.isEmpty()) return null;                                                             // src: vvaharness/backends/harness/deepagents/prompt_caching.py:86
        Message last = messages.last();
        List<Object> newContent = tagContent(last.content, cacheControl, θ);                             // src: vvaharness/backends/harness/deepagents/prompt_caching.py:89
        if (newContent == null) return null;
        return messages.replaceLast(last.copyWithContent(newContent));                                   // src: vvaharness/backends/harness/deepagents/prompt_caching.py:92
    }
}

@executedBy(CODE) @role(backend)
class BlockMarkerPromptCaching {
    boolean enabled;
    boolean markTail;

    // enabled comes from SessionOptions.cache_markers (sdk.cache_markers); markTail defaults true.
    void init(boolean enabled, boolean markTail, Theta θ) {
        this.ttl = θ["code.backends.harness.deepagents.prompt_caching.ttl"];                             // "5m" on every marker // src: vvaharness/backends/harness/deepagents/prompt_caching.py:100
        this.unsupportedModelBehavior = θ["code.backends.harness.deepagents.prompt_caching.unsupported_model_behavior"]; // non-Anthropic: pass through // src: vvaharness/backends/harness/deepagents/prompt_caching.py:100
        this.enabled = enabled && θ["sdk.cache_markers"] == "on";                                        // src: vvaharness/backends/harness/deepagents/prompt_caching.py:101
        this.markTail = markTail;                                                                        // src: vvaharness/backends/harness/deepagents/prompt_caching.py:102
    }

    // Same name as the parent so deepagents replaces its auto-attached instance in place.
    String name() {
        return "AnthropicPromptCachingMiddleware";                                                       // src: vvaharness/backends/harness/deepagents/prompt_caching.py:107
    }

    boolean shouldApplyCaching(ModelRequest request) {
        return enabled && isAnthropicModel(request.model);                                               // src: vvaharness/backends/harness/deepagents/prompt_caching.py:111
    }

    ModelRequest applyCaching(ModelRequest request, Theta θ) {
        Map<String, String> cacheControl = this.cacheControl;                                            // src: vvaharness/backends/harness/deepagents/prompt_caching.py:115
        // no top-level model_settings cache_control: some proxies drop it
        SystemMessage systemMessage = tagSystemMessage(request.systemMessage, cacheControl);             // src: vvaharness/backends/harness/deepagents/prompt_caching.py:117
        List<Tool> tools = tagTools(request.tools, cacheControl);                                        // src: vvaharness/backends/harness/deepagents/prompt_caching.py:118
        List<Message> tail = markTail ? PromptCaching.tagTail(request.messages, cacheControl, θ) : null; // src: vvaharness/backends/harness/deepagents/prompt_caching.py:119
        return request.override(systemMessage, tools == null ? request.tools : tools, tail == null ? request.messages : tail); // src: vvaharness/backends/harness/deepagents/prompt_caching.py:120
    }
}
