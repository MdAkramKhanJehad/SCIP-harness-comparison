// file: vvaharness/backends/harness/claude/facts.py
// S11's fact tools and report channel for the Claude-harness route, exposed as an in-process MCP server
// ("facts"): tools arrive as mcp__facts__X; SubmitPersonaReport validates a persona's report on submission.

@executedBy(CODE) @role(tool)
class ClaudeFacts {

    String mcpName(String bare) {
        return "mcp__facts__" + bare;                                                                    // src: vvaharness/backends/harness/claude/facts.py:44
    }

    // Rewrite bare bridged names in a tool grant to their mcp__facts__ form (a bare grant matches nothing).
    List<String> rewriteToolNames(List<String> names, List<String> bridged) {
        if (names == null) return null;                                                                  // src: vvaharness/backends/harness/claude/facts.py:51
        return names.map(n -> bridged.contains(n) ? mcpName(n) : n);                                     // src: vvaharness/backends/harness/claude/facts.py:54
    }

    // An MCP tool result payload: one text content block; is_error is set only when true.
    Map<String, Object> content(String text, boolean isError) {                                         // src: vvaharness/backends/harness/claude/facts.py:83
        Map payload = Map.of("content", [Map.of("type", "text", "text", text)]);                        // src: vvaharness/backends/harness/claude/facts.py:85
        if (isError) payload.put("is_error", true);                                                      // src: vvaharness/backends/harness/claude/facts.py:86
        return payload;
    }

    // Render a fact-tool result as text: a string as is, else JSON (default str for unknown objects); a result JSON cannot
    // encode (TypeError or ValueError) falls back to str.
    String serialize(Object result) {                                                                   // src: vvaharness/backends/harness/claude/facts.py:92
        if (result instanceof String) return result;                                                     // src: vvaharness/backends/harness/claude/facts.py:94
        try {
            return jsonDumps(result, str);                                                               // src: vvaharness/backends/harness/claude/facts.py:97
        } catch (TypeError | ValueError e) {
            return str(result);                                                                          // src: vvaharness/backends/harness/claude/facts.py:99
        }
    }

    // Wrap one fact spec as an SDK tool (name, description, input schema copied). handler is the nested async tool function.
    Tool factTool(FactToolSpec spec, Object sdkTool) {                                                  // src: vvaharness/backends/harness/claude/facts.py:102
        return sdkTool(spec.name, spec.description, copy(spec.inputSchema), args -> handler(spec, args));  // src: vvaharness/backends/harness/claude/facts.py:104
    }

    // factTool nested _handler: off-loop (to_thread) so a large diff cannot stall the event loop draining the CLI stream.
    // Any exception comes back as an error result naming the exception type, never raised.
    Map<String, Object> handler(FactToolSpec spec, Map<String, Object> args) {                         // src: vvaharness/backends/harness/claude/facts.py:105
        try {
            result = runInThread(spec.fn, copy(args));                                                   // src: vvaharness/backends/harness/claude/facts.py:109
        } catch (Exception exc) {
            return content(typeName(exc) + ": " + exc, true);                                            // src: vvaharness/backends/harness/claude/facts.py:111
        }
        return content(serialize(result), false);                                                        // src: vvaharness/backends/harness/claude/facts.py:112
    }

    // Report-submission tool, validating on submit into the collector. The options module is imported lazily here because
    // options.py imports rewrite_tool_names from this file (a top-level import cycles). The schema is sanitized.
    Tool submitTool(Schema reportModel, PersonaReportCollector collector, Object sdkTool) {             // src: vvaharness/backends/harness/claude/facts.py:117
        return sdkTool("SubmitPersonaReport", "Submit your final report. Call this exactly once, as your last action. The report is validated on submission; if it is rejected, fix the named fields and call this again.",
                       ClaudeOptions.sanitizeSchema(reportModel.modelJsonSchema()),
                       args -> submit(reportModel, collector, args));                                    // src: vvaharness/backends/harness/claude/facts.py:125
    }

    // submitTool nested _submit: validate; on failure name the invalid fields so the persona can retry (deepagents just drops
    // bad reports); on success add the JSON-mode dump to the collector.
    Map<String, Object> submit(Schema reportModel, PersonaReportCollector collector, Map<String, Object> args) { // src: vvaharness/backends/harness/claude/facts.py:131
        Report report;
        try {
            report = reportModel.modelValidate(copy(args));                                              // src: vvaharness/backends/harness/claude/facts.py:133
        } catch (Exception exc) {
            return content("Report rejected -- not a valid report: " + exc + ". Fix the fields named above and call SubmitPersonaReport again.", true); // src: vvaharness/backends/harness/claude/facts.py:136
        }
        collector.add(report.modelDump("json"));                                                         // src: vvaharness/backends/harness/claude/facts.py:140
        return content("Report accepted.", false);                                                       // src: vvaharness/backends/harness/claude/facts.py:141
    }

    Triple<List<Tool>, List<String>, PersonaReportCollector> buildFactTools(List<FactToolSpec> specs, Schema reportModel) {
        PersonaReportCollector collector = new PersonaReportCollector();
        List<Tool> tools = specs.map(s -> sdkTool(s));                                                   // src: vvaharness/backends/harness/claude/facts.py:155
        List<String> names = specs.map(s -> mcpName(s.name));                                            // src: vvaharness/backends/harness/claude/facts.py:156
        if (reportModel != null) {                                                                       // src: vvaharness/backends/harness/claude/facts.py:158
            tools.add(sdkSubmitTool(reportModel, collector));
            names.add(mcpName("SubmitPersonaReport"));                                                   // src: vvaharness/backends/harness/claude/facts.py:160
        }
        return Triple.of(tools, names, collector);
    }

    // In-process MCP server for the specs plus its report collector. The SDK is imported lazily (stays optional).
    Triple<McpServerConfig, List<String>, PersonaReportCollector> buildFactMcp(List<FactToolSpec> specs, Schema reportModel) { // src: vvaharness/backends/harness/claude/facts.py:165
        tools, names, collector = buildFactTools(specs, reportModel);                                    // src: vvaharness/backends/harness/claude/facts.py:172
        return Triple.of(createSdkMcpServer("facts", tools), names, collector);                          // src: vvaharness/backends/harness/claude/facts.py:173
    }
}

@executedBy(MODEL) @role(prompt)
class SubmitPromptSuffix {

    // SUBMIT_PROMPT_SUFFIX: appended to each persona prompt on this backend only.
    Prompt submitPromptSuffix(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.facts.submit_report_via_tool"]);                    // call mcp__facts__SubmitPersonaReport with the report object // src: vvaharness/backends/harness/claude/facts.py:180
        p.rule(θ["p.facts.submit_validated_with_field_feedback"]);      // validated on submission; told which fields to fix // src: vvaharness/backends/harness/claude/facts.py:181
        p.format(θ["p.facts.also_print_json_block"]);                   // also print the report as a json block // src: vvaharness/backends/harness/claude/facts.py:182
        p.context(θ["p.facts.fact_tool_prefix_names"]);                 // DiffTouched, ChangedLines, DiffImpactMap, PatternScan, TestInventory // src: vvaharness/backends/harness/claude/facts.py:184
        return p;
    }
}

// Holds the reports personas submit during one session, newest-wins per (persona, tracking_id). One collector serves
// exactly one session.
@executedBy(CODE) @role(io)
class PersonaReportCollector {

    List<Map> reportList;

    void init() {
        this.reportList = [];                                                                            // src: vvaharness/backends/harness/claude/facts.py:70
    }

    // Record one validated report, replacing an earlier one from the same persona and tracking id.
    void add(Map report) {                                                                              // src: vvaharness/backends/harness/claude/facts.py:64
        key = pair(report.get("persona"), report.get("tracking_id"));                                    // src: vvaharness/backends/harness/claude/facts.py:66
        this.reportList = this.reportList.filter(r -> pair(r.get("persona"), r.get("tracking_id")) != key); // src: vvaharness/backends/harness/claude/facts.py:67
        this.reportList.add(report);                                                                     // src: vvaharness/backends/harness/claude/facts.py:71
    }

    // The collected reports, in submission order (a copy).
    List<Map> reports() {                                                                               // src: vvaharness/backends/harness/claude/facts.py:74
        return copy(this.reportList);                                                                    // src: vvaharness/backends/harness/claude/facts.py:76
    }

    // How many reports have been submitted.
    int len() {                                                                                         // src: vvaharness/backends/harness/claude/facts.py:78
        return this.reportList.size();                                                                   // src: vvaharness/backends/harness/claude/facts.py:80
    }
}
