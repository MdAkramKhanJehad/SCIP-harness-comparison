// file: vvaharness/remediation_agent/policy/decide.py
// The pre-gate (before any LLM call): decide whether a finding may be patched, resolve its playbook strategy, or build a plain Denied verdict.

@executedBy(CODE) @role(types) @stage("S10")
record PreResult(PolicyDecision decision, String cwe, Strategy strategy) { }                        // src: vvaharness/remediation_agent/policy/decide.py:29  (allowed is derived: decision.may_generate_patch)

@executedBy(CODE) @role(rule_set) @stage("S10")
class Decide {

    boolean allowed(PreResult pre) {
        // Convenience: the agent may run iff this is true.
        return Action.mayGeneratePatch(pre.decision);                                               // src: vvaharness/remediation_agent/policy/decide.py:37
    }

    PreResult preDecision(PolicyContext ctx, RemediationTarget target, Theta θ) {
        // Decide whether target may be patched and, if so, resolve its strategy, from the finding's typed CWE and path.
        String cwe = target.finding.cwe;                                                            // src: vvaharness/remediation_agent/policy/decide.py:42
        String filePath = target.finding.file;                                                      // src: vvaharness/remediation_agent/policy/decide.py:43
        PolicyDecision decision = Gate.decide(ctx.gate, cwe, filePath, θ);                          // src: vvaharness/remediation_agent/policy/decide.py:44
        Strategy strategy = null;                                                                   // src: vvaharness/remediation_agent/policy/decide.py:45
        if (Action.mayGeneratePatch(decision)) {                                                    // src: vvaharness/remediation_agent/policy/decide.py:46
            String lang = Frameworks.languageFor(filePath, θ);                                      // src: vvaharness/remediation_agent/policy/decide.py:47
            // The playbook is SUPPLEMENTARY context, not a second gate: the policy gate alone owns allow and deny.
            strategy = RemediationAgentPlaybook.resolve(ctx.playbook, cwe, lang, ctx.frameworks);   // src: vvaharness/remediation_agent/policy/decide.py:49
        }
        return new PreResult(decision, cwe, strategy);                                              // src: vvaharness/remediation_agent/policy/decide.py:50
    }

    RemediationVerdict guidanceVerdict(PolicyContext ctx, RemediationTarget target, PreResult pre) {
        // A plain DENIED verdict for a policy-denied finding, carrying only the deny reason (no changes, no recommendations, empty root cause).
        String reason = pre.decision.reason;                                                        // src: vvaharness/remediation_agent/policy/decide.py:56
        return new RemediationVerdict(target.index, "Denied", "", List.of(), List.of(), "Denied by policy (" + reason + "). No patch generated."); // src: vvaharness/remediation_agent/policy/decide.py:57
    }
}
