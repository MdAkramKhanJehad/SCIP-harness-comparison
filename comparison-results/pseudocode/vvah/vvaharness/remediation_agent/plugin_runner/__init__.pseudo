    }

    void debugLog(String event, String detail) {
        // Append a debug line to the file named by the VVAHARNESS_DEBUG_LOG environment variable; no-op when unset.
        String path = Os.getenv("VVAHARNESS_DEBUG_LOG");                                            // src: vvaharness/remediation_agent/plugin_runner/__init__.py:138
        if (path == null || path.isEmpty()) return;                                                 // src: vvaharness/remediation_agent/plugin_runner/__init__.py:139
