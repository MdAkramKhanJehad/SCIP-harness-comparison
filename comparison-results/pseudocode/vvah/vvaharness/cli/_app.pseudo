// file: vvaharness/cli/_app.py
// The Typer application: command names and help; each command forwards its untouched argv to the
// existing hand-rolled dispatcher (VvaharnessCli.dispatch) and surfaces its exit code.

@executedBy(CODE) @role(pipeline)
class App {

    Set<String> COMMANDS = Set.of("setup", "init", "doctor", "estimate", "gc", "scan", "remediate", "ev-replay", "validate", "s11"); // src: vvaharness/cli/_app.py:120

    /** Hand command and argv to the existing handler; Ctrl-C is carried out as Interrupted. */
    void delegate(String command, Context ctx) {
        int code;
        try { code = VvaharnessCli.dispatch(List.of(command).plus(ctx.args), null); }                  // src: vvaharness/cli/_app.py:50
        catch (KeyboardInterrupt e) { throw new Interrupted(); }                                       // src: vvaharness/cli/_app.py:52
        throw new TyperExit(code);                                                                     // src: vvaharness/cli/_app.py:53
    }

    // One Typer command per name, each just delegate(name): setup, init (hidden alias), doctor, estimate,
    // gc, scan, remediate, validate, s11 (hidden alias), ev-replay                                    // src: vvaharness/cli/_app.py:56
    void setup(Context ctx) {
        delegate("setup", ctx);                                                                        // src: vvaharness/cli/_app.py:59
    }

    /** Alias for setup (hidden command). */
    @src("vvaharness/cli/_app.py:64")
    void init(Context ctx) {
        delegate("init", ctx);                                                                         // src: vvaharness/cli/_app.py:65
    }

    /** Credentials and live backend connectivity check, read-only; --cache-probe adds a live prompt-cache diagnostic that spends real tokens and never runs during a scan. */
    @src("vvaharness/cli/_app.py:68")
    void doctor(Context ctx) {
        delegate("doctor", ctx);                                                                       // src: vvaharness/cli/_app.py:74
    }

    /** Rough scope/cost preview for a repo, no API spend. */
    @src("vvaharness/cli/_app.py:77")
    void estimate(Context ctx) {
        delegate("estimate", ctx);                                                                     // src: vvaharness/cli/_app.py:80
    }

    /** Delete old runs: checkpoints and code-graph workspaces (--keep-runs, --max-age-days, --dry-run). */
    @src("vvaharness/cli/_app.py:83")
    void gc(Context ctx) {
        delegate("gc", ctx);                                                                           // src: vvaharness/cli/_app.py:86
    }

    /** Scan a repo (or --repo-file batch). The packaged default skips S10/S11; --remediate enables S10 only and can edit source; in-scan S11 needs step_validate.enabled; --stop-after s9 skips both. */
    @src("vvaharness/cli/_app.py:89")
    void scan(Context ctx) {
        delegate("scan", ctx);                                                                         // src: vvaharness/cli/_app.py:93
    }

    /** Walk findings from a prior scan and remediate them (Remediation Agent). */
    @src("vvaharness/cli/_app.py:96")
    void remediate(Context ctx) {
        delegate("remediate", ctx);                                                                    // src: vvaharness/cli/_app.py:99
    }

    /** Run the s11 agentic validation agent on applied remediations. */
    @src("vvaharness/cli/_app.py:102")
    void validate(Context ctx) {
        delegate("validate", ctx);                                                                     // src: vvaharness/cli/_app.py:105
    }

    /** Hidden alias for validate. */
    @src("vvaharness/cli/_app.py:108")
    void s11(Context ctx) {
        delegate("s11", ctx);                                                                          // src: vvaharness/cli/_app.py:111
    }

    /** Re-check exploit-verified findings against a REDEPLOYED target (the handler is outside this rendering's scope: exploit verification). */
    @src("vvaharness/cli/_app.py:114")
    void evReplay(Context ctx) {
        delegate("ev-replay", ctx);                                                                    // src: vvaharness/cli/_app.py:117
    }

    /** Dispatch args through Typer, returning the exit code instead of exiting. */
    int run(List<String> args) {
        Command command = Typer.getCommand(this);                                                      // src: vvaharness/cli/_app.py:128
        try { return int(command.main(args, "vvaharness", false) or 0); }                              // a missing return value counts as 0 // src: vvaharness/cli/_app.py:130
        catch (TyperExit e) { return e.exitCode; }                                                     // src: vvaharness/cli/_app.py:131
        catch (Interrupted | TyperAbort e) { throw new KeyboardInterrupt(); }                          // src: vvaharness/cli/_app.py:133
        catch (ClickException e) { e.show(); return e.exitCode; }                                      // src: vvaharness/cli/_app.py:135
    }
}

@executedBy(CODE) @role(types)
class Interrupted {
    // Carries a Ctrl-C out past Typer, which would otherwise turn it into a silent exit 130         // src: vvaharness/cli/_app.py:41
