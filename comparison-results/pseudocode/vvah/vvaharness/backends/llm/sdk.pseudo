    /** Called once by the orchestrator before any SDK step; prefers ANTHROPIC_SDK_API_KEY. */
    @src("vvaharness/backends/llm/sdk.py:146")
    void configure(String apiKey, String baseUrl, Object verifySsl, String caCert, Object clientCert, String noProxy, Boolean allowApiKeyFallback, Integer cacheMinBlockTokens, String cacheMarkers, Object cacheRoute) {
        synchronized (clientLock) {
            if (apiKey != null && !apiKey.isEmpty()) cfg.apiKey = apiKey;                                   // src: vvaharness/backends/llm/sdk.py:160
            if (baseUrl != null && !baseUrl.isEmpty()) cfg.baseUrl = baseUrl;                               // src: vvaharness/backends/llm/sdk.py:162
            if (allowApiKeyFallback != null) cfg.allowApiKeyFallback = allowApiKeyFallback;                 // src: vvaharness/backends/llm/sdk.py:164
            if (verifySsl != null) cfg.verifySsl = Tls.coerceVerify(verifySsl);                             // src: vvaharness/backends/llm/sdk.py:166
            if (caCert != null && !caCert.isEmpty()) cfg.caCert = caCert;                                   // src: vvaharness/backends/llm/sdk.py:168
            if (clientCert != null) cfg.clientCert = clientCert;                                            // src: vvaharness/backends/llm/sdk.py:170
            if (noProxy != null && !noProxy.isEmpty()) cfg.noProxy = noProxy;                               // src: vvaharness/backends/llm/sdk.py:172
            if (cacheMinBlockTokens != null) cfg.cacheMinBlockTokens = cacheMinBlockTokens;                 // src: vvaharness/backends/llm/sdk.py:174
            if (cacheMarkers != null) cfg.cacheMarkers = cacheMarkers;                                      // src: vvaharness/backends/llm/sdk.py:176
            if (cacheRoute != null) {
                // PyYAML parses an unquoted off/no as False, so accept it as the documented "none"
                String v = cacheRoute == false ? "none" : cacheRoute.toString().strip().lower();            // src: vvaharness/backends/llm/sdk.py:181
                if (!List.of("auto", "none", ROUTE_ANTHROPIC, ROUTE_VERTEX, ROUTE_BEDROCK).contains(v)) {   // src: vvaharness/backends/llm/sdk.py:182
                    log.warning(Events.CACHE_ROUTE_UNKNOWN);                                               // unrecognised: warn and fall back; the field only gates an optimisation so it never fails the run // src: vvaharness/backends/llm/sdk.py:184
                    v = "auto";                                                                             // src: vvaharness/backends/llm/sdk.py:185
                }
                cfg.cacheRoute = v;                                                                         // src: vvaharness/backends/llm/sdk.py:186
            }
            client = null;                                                                                  // force rebuild on next call // src: vvaharness/backends/llm/sdk.py:187
        }
    }

    void configureCache(Object markers, Integer minBlockTokens, String route) {
        configure(null, null, null, null, null, null, null, minBlockTokens, markers, route);                // the preflight entry point: cache_markers, cache_min_block_tokens, cache_route // src: vvaharness/backends/llm/sdk.py:146
    }

    /** verify upgraded to an SSL context carrying the configured client chain. */
    @src("vvaharness/backends/llm/sdk.py:189")
    Object mtlsVerify(Object verify) {
        // never pass cert= to the httpx client (the httpx-0.28.1 trap); EVERY chain shape is pre-checked
        Object clientCert = Tls.resolveClientChain(cfg.clientCert, "sdk", null);                            // src: vvaharness/backends/llm/sdk.py:196
        if (clientCert == null) return verify;                                                              // src: vvaharness/backends/llm/sdk.py:197
        SslContext context = Httpx.createSslContext(verify, true);                                          // trust_env=True // src: vvaharness/backends/llm/sdk.py:199
        if (!Tls.loadClientChain(context, clientCert, "sdk")) return verify;                                // src: vvaharness/backends/llm/sdk.py:200
        return context;                                                                                     // src: vvaharness/backends/llm/sdk.py:202
    }

    /** Lazy singleton Anthropic client: credential resolution, TLS, optional client cert, scoped NO_PROXY. */
    @src("vvaharness/backends/llm/sdk.py:204")
    Object getClient() {
        if (client != null) return client;                                                                  // src: vvaharness/backends/llm/sdk.py:206
        synchronized (clientLock) {
            if (client == null) {                                                                           // src: vvaharness/backends/llm/sdk.py:209
                Map kw = Map.of("max_retries", CLIENT_MAX_RETRIES);                                         // src: vvaharness/backends/llm/sdk.py:222
                // dedicated env var so sdk can target a different gateway/key than the CLI backend
                String key = cfg.apiKey != null ? cfg.apiKey : System.getenv("ANTHROPIC_SDK_API_KEY");            // src: vvaharness/backends/llm/sdk.py:224
                if (key == null && cfg.allowApiKeyFallback) {
                    // sole-sdk profile only: falls back to the shared ANTHROPIC key, not from via:cli
                    key = firstNonEmpty(System.getenv("ANTHROPIC_API_KEY"), System.getenv("ANTHROPIC_AUTH_TOKEN"));     // src: vvaharness/backends/llm/sdk.py:227
                    if (key != null) Console.write("no ANTHROPIC_SDK_API_KEY - falling back to ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN"); // src: vvaharness/backends/llm/sdk.py:230
                }
                if (key == null) {
                    // constructing with NO auth kwarg does not fail: the SDK would read ANTHROPIC_API_KEY from the ambient env itself; fail closed on the harness's own rule instead
                    throw new AuthenticationError("no sdk credential resolved: set ANTHROPIC_SDK_API_KEY or sdk.api_key; ANTHROPIC_API_KEY accepted only when sdk/deepagents are the sole backends", null, "sdk"); // src: vvaharness/backends/llm/sdk.py:238
                }
                Map authKw = Tls.anthropicAuthKwargs(key);                                                  // src: vvaharness/backends/llm/sdk.py:247
                // read the beta header off what the auth helper produced, so the per-request merge sends exactly the client's value
                clientDefaultBetas = authKw.get("default_headers") != null ? authKw.get("default_headers").getOrDefault("anthropic-beta", "") : ""; // src: vvaharness/backends/llm/sdk.py:252
                kw.putAll(authKw);                                                                          // src: vvaharness/backends/llm/sdk.py:254
                if (cfg.baseUrl != null) kw.put("base_url", cfg.baseUrl);                                   // src: vvaharness/backends/llm/sdk.py:255
                String ca = cfg.caCert;                                                                     // ca_cert (path) wins over verify_ssl (bool) // src: vvaharness/backends/llm/sdk.py:257
                if (ca != null && !Fs.exists(ca)) {
                    log.warning(Events.TLS_CA_FALLBACK);                                                   // missing CA file: warn and ignore it // src: vvaharness/backends/llm/sdk.py:259
                    ca = null;                                                                              // src: vvaharness/backends/llm/sdk.py:260
                }
                Object verify = ca != null ? ca : cfg.verifySsl;                                            // src: vvaharness/backends/llm/sdk.py:261
                if (verify == false) Tls.warnVerifyDisabled(cfg.baseUrl, "sdk", "<default Anthropic endpoint>", "sdk.ca_cert"); // src: vvaharness/backends/llm/sdk.py:262
                // httpx drops cert= whenever verify= is a str CA path or False, so a client cert is loaded onto an explicit context
                verify = mtlsVerify(verify);                                                                // src: vvaharness/backends/llm/sdk.py:271
                if (verify != true) kw.put("http_client", Anthropic.defaultHttpxClient(verify));            // src: vvaharness/backends/llm/sdk.py:272
                synchronized (Tls.scopedNoProxyEnv(cfg.noProxy)) {
                    client = Anthropic.client(kw);                                                          // src: vvaharness/backends/llm/sdk.py:275
                }
            }
        }
        return client;                                                                                      // src: vvaharness/backends/llm/sdk.py:276
    }

    /** Classify which cache-marker regime the client is talking to, from its own resolved base_url. */
    @src("vvaharness/backends/llm/sdk.py:301")
    String cacheRoute(Object client, Map config, boolean emitNote) {
        // never from the model id or from via: at this transport those are indistinguishable
        Map settings = config == null ? cfg : config;                                                       // src: vvaharness/backends/llm/sdk.py:307
        Object forced = settings.getOrDefault("cache_route", "auto");                                       // src: vvaharness/backends/llm/sdk.py:308
        if (forced == false) forced = "none";                                                               // a directly-poked cfg gets configure()'s YAML tolerance too // src: vvaharness/backends/llm/sdk.py:310
        forced = (forced != null ? forced : "auto").toString().strip().lower();                             // src: vvaharness/backends/llm/sdk.py:311
        if (forced == "none") return ROUTE_UNKNOWN;                                                         // src: vvaharness/backends/llm/sdk.py:313
        if (List.of(ROUTE_ANTHROPIC, ROUTE_VERTEX, ROUTE_BEDROCK).contains(forced)) return forced;          // an explicit route beats detection // src: vvaharness/backends/llm/sdk.py:315
        Object baseUrl = firstNonEmpty(client.baseUrl, settings.get("base_url"), "");                       // src: vvaharness/backends/llm/sdk.py:317
        String host = (Url.split(baseUrl.toString()).hostname != null ? Url.split(baseUrl.toString()).hostname : baseUrl.toString()).lower(); // src: vvaharness/backends/llm/sdk.py:318
        if (host.isEmpty()) return ROUTE_ANTHROPIC;                                                         // no host at all: treated as Anthropic direct // src: vvaharness/backends/llm/sdk.py:321
        if (BEDROCK_HOST_RX.search(host)) return ROUTE_BEDROCK;                                             // src: vvaharness/backends/llm/sdk.py:323
        if (VERTEX_HOST_RX.search(host)) return ROUTE_VERTEX;                                               // src: vvaharness/backends/llm/sdk.py:325
        if (ANTHROPIC_HOST_RX.search(host)) return ROUTE_ANTHROPIC;                                         // src: vvaharness/backends/llm/sdk.py:327
        // failing closed is correct but SILENT (prompt tokens billed uncached): the AUTO-DETECTED fallthrough notes it, an explicit cache_route none or cache_markers off does not
        if (!emitNote) return ROUTE_UNKNOWN;                                                                // src: vvaharness/backends/llm/sdk.py:338
        WarnOnce.warnOnce(CACHE_ROUTE_NOTED, ROUTE_UNKNOWN, "prompt caching enabled by default but the endpoint is not recognised as Anthropic, Vertex or Bedrock: cache markers withheld; set cache_route anthropic if the gateway is Messages-compatible"); // src: vvaharness/backends/llm/sdk.py:340
        return ROUTE_UNKNOWN;                                                                               // src: vvaharness/backends/llm/sdk.py:348
    }

    /** The kill switch: cache_markers off suppresses every marker, on every route. */
    @src("vvaharness/backends/llm/sdk.py:351")
    boolean cacheMarkersEnabled() {
        return Cache.markersEnabled(cfg, null);                                                             // src: vvaharness/backends/llm/sdk.py:353
    }

    /** Minimum cacheable prefix size (real tokens) for the model, or the operator's forced floor. */
    @src("vvaharness/backends/llm/sdk.py:371")
    int cacheMinTokensFor(String model) {
        Integer override = cfg.cacheMinBlockTokens;                                                         // src: vvaharness/backends/llm/sdk.py:373
        if (override != null) {
            // 0 disables the size gate (every marker placed; the provider silently ignores below-minimum ones); negatives clamp to 0
            return Math.max(0, override);                                                                   // src: vvaharness/backends/llm/sdk.py:377
        }
        for (Pair<Regex, Integer> row : CACHE_MIN_TOKENS_TABLE) {                                           // first match wins, specific minors before family catch-alls // src: vvaharness/backends/llm/sdk.py:378
            if (row.first.search(model != null ? model : "")) return row.second;                            // src: vvaharness/backends/llm/sdk.py:379
        }
        return CACHE_MIN_TOKENS_FALLBACK;                                                                   // src: vvaharness/backends/llm/sdk.py:381
    }

    /** Whether a breakpoint after text is estimated to clear the model's minimum cacheable size (cumulative with preceding). */
    @src("vvaharness/backends/llm/sdk.py:388")
    boolean cachePrefixMeetsMinimum(String text, String model, String preceding) {
        int floor = cacheMinTokensFor(model);                                                               // src: vvaharness/backends/llm/sdk.py:391
        double est = Tokens.estimateTokens(preceding, null) + Tokens.estimateTokens(text, null);            // src: vvaharness/backends/llm/sdk.py:392
        return est * CACHE_EST_MARGIN >= floor;                                                             // src: vvaharness/backends/llm/sdk.py:393
    }

    /** Decide how to deliver cache_prefix + user_prompt: marker block, plain prefix block, or one concatenated string. */
    @src("vvaharness/backends/llm/sdk.py:396")
    Object buildCachePrefixContent(Object client, String cachePrefix, Object userPrompt, String model, String preceding) {
        // when a marker cannot be placed the prefix is still concatenated LEADING, so an implicit cache still benefits
        if (cachePrefix == null || cachePrefix.isEmpty()) return userPrompt;                                // src: vvaharness/backends/llm/sdk.py:405
        String route = null;
        if (cacheMarkersEnabled()) {                                                                        // gate 2: kill switch // src: vvaharness/backends/llm/sdk.py:409
            String candidate = cacheRoute(client, null, true);                                              // gate 1: route accepts cache_control // src: vvaharness/backends/llm/sdk.py:410
            if (CACHE_CONTROL_ROUTES.contains(candidate) && cachePrefixMeetsMinimum(cachePrefix, model, preceding)) route = candidate; // gate 3: minimum size // src: vvaharness/backends/llm/sdk.py:411
        }
        if (userPrompt instanceof List) {
            // blocks cannot be string-concatenated: the prefix becomes its own text block, with cache_control when the gate allows
            Map prefixBlock = Map.of("type", "text", "text", cachePrefix);                                  // src: vvaharness/backends/llm/sdk.py:418
            if (route != null && !userPrompt.isEmpty()) prefixBlock.put("cache_control", Map.of("type", "ephemeral")); // src: vvaharness/backends/llm/sdk.py:419
            return List.of(prefixBlock) + userPrompt;                                                       // src: vvaharness/backends/llm/sdk.py:421
        }
        // an empty trailing text block is rejected by the API: no breakpoint when the prefix is the whole prompt
        if (route != null && !userPrompt.isEmpty()) {                                                       // src: vvaharness/backends/llm/sdk.py:425
            return List.of(Map.of("type", "text", "text", cachePrefix, "cache_control", Map.of("type", "ephemeral")), Map.of("type", "text", "text", userPrompt)); // src: vvaharness/backends/llm/sdk.py:426
        }
        // bedrock is withheld for a narrower reason: cannot sign SigV4, so the base_url is an unverified intermediary
        return cachePrefix + userPrompt;                                                                    // src: vvaharness/backends/llm/sdk.py:434
    }

    /** System block for one call: one block carrying a marker when worth placing, else the plain string. */
    @src("vvaharness/backends/llm/sdk.py:438")
    Object buildSystemContent(Object client, String systemPrompt, String model, String toolsText) {
        // every marker obeys CACHE_CONTROL_ROUTES; the minimum is CUMULATIVE and tool schemas render ahead of the system block
        if (cacheMarkersEnabled() && CACHE_CONTROL_ROUTES.contains(cacheRoute(client, null, true)) && cachePrefixMeetsMinimum(systemPrompt, model, toolsText)) { // src: vvaharness/backends/llm/sdk.py:448
            return List.of(Map.of("type", "text", "text", systemPrompt, "cache_control", Map.of("type", "ephemeral"))); // src: vvaharness/backends/llm/sdk.py:452
        }
        return systemPrompt;                                                                                // src: vvaharness/backends/llm/sdk.py:456
    }

    /** Flag cache accounting reported under key names this module does not parse. */
    @src("vvaharness/backends/llm/sdk.py:461")
    void noteUnparsedCacheKeys(Map usage) {
        Cache.noteUnparsedCacheKeys(usage, "sdk");                                                          // src: vvaharness/backends/llm/sdk.py:463
    }

    /** Bank msg's usage into the token counter (a call with none still counts) and return it. */
    @src("vvaharness/backends/llm/sdk.py:466")
    Map bankUsage(Message msg) {
        Map usage = msg.usage != null ? msg.usage.modelDump() : null;                                       // src: vvaharness/backends/llm/sdk.py:468
        noteUnparsedCacheKeys(usage);                                                                       // src: vvaharness/backends/llm/sdk.py:469
        TokenCounter.add(usage, null, null);                                                                // src: vvaharness/backends/llm/sdk.py:470
        return usage;
    }

    /** One-time WARN that max_budget_usd is accepted but never enforced on this raw loop. */
    @src("vvaharness/backends/llm/sdk.py:493")
    void warnMaxBudgetUnenforced(String fn, Double maxBudgetUsd) {
        // only the Claude-side transports (via cli, the Agent SDK, cli_mcp) enforce a spend cap; max_turns applies here instead
        if (maxBudgetUsd == null) return;                                                                   // src: vvaharness/backends/llm/sdk.py:499
        WarnOnce.warnOnce(WARNED_DROPS, "max_budget_usd:" + fn, "max_budget_usd accepted but not enforced on this route; route this role via cli for an enforced budget"); // src: vvaharness/backends/llm/sdk.py:501
    }

    @src("vvaharness/backends/llm/sdk.py:509")
    boolean supportsTemperature(String model) {
        if (NO_TEMP_MODELS.contains(model)) return false;                                                   // learned from a 400 // src: vvaharness/backends/llm/sdk.py:510
        return !NO_TEMP_RX.search(model);                                                                   // src: vvaharness/backends/llm/sdk.py:512
    }

    /** The extra_headers for a request that asks for betas, or None; re-joins the client's own default beta first. */
    @src("vvaharness/backends/llm/sdk.py:515")
    Map betaHeaders(List<String> betas) {
        // TRAP: a per-request extra_headers REPLACES a default header of the same name; on an OAuth client a role with betas would drop the OAuth beta and 401
        if (betas == null || betas.isEmpty()) return null;                                                  // src: vvaharness/backends/llm/sdk.py:521
        List<String> joined = clientDefaultBetas.split(",").filter(b -> !b.strip().isEmpty());              // src: vvaharness/backends/llm/sdk.py:522
        for (String b : betas) if (!joined.contains(b.toString())) joined.add(b.toString());                // src: vvaharness/backends/llm/sdk.py:523
        return Map.of("anthropic-beta", String.join(",", joined));                                          // src: vvaharness/backends/llm/sdk.py:526
    }

    /** True for a retryable status, or a transient a gateway reported in the message instead. */
    @src("vvaharness/backends/llm/sdk.py:530")
    boolean isTransientSdk(ApiStatusError error) {
        // a gateway can report a transient as an APIStatusError with status_code 200; dropped sockets have their own branch
