// file: vvaharness/backends/llm/cli_mcp.py
// In-process SDK-MCP bridge for via: cli with caller tools (cli.mcp_tools): the pinned `claude` binary runs through the
// Agent SDK with the stage's graph/CWE fact tools as mcp__vvah_facts__*; deny-by-default PreToolUse read jail (no --restricted).

@executedBy(CODE) @role(backend)
class CliMcp {

    String SERVER_NAME = "vvah_facts";                                                                      // src: vvaharness/backends/llm/cli_mcp.py:64
    String TOOL_PREFIX = "mcp__vvah_facts__";                                                               // admitted by permissions.MCP_TOOL_PREFIX // src: vvaharness/backends/llm/cli_mcp.py:65
    Set<String> WARNED = new Set();                                                                         // src: vvaharness/backends/llm/cli_mcp.py:68
    String EVIDENCE_UNENFORCED_COUNTER = "cli_mcp_evidence_gate_unenforced";                                // src: vvaharness/backends/llm/cli_mcp.py:71

    /** Whether the Claude Agent SDK this bridge needs is importable. */
    @src("vvaharness/backends/llm/cli_mcp.py:74")
    boolean available() {
        try { Sdk.importModule("claude_agent_sdk"); } catch (Exception e) { return false; }                 // src: vvaharness/backends/llm/cli_mcp.py:77
        return true;
    }

    @src("vvaharness/backends/llm/cli_mcp.py:83")
    String mcpName(String bare) {
        return TOOL_PREFIX + bare;                                                                          // src: vvaharness/backends/llm/cli_mcp.py:85
    }

    /** Run the caller's ToolBuilder (no reader tools: the CLI has natives) and keep only its fact tools. */
    @src("vvaharness/backends/llm/cli_mcp.py:90")
    List<LcTool> materialize(ToolBuilder toolBuilder, String model, Path cwd, List<String> factTools) {
        Set<String> wanted = Set.copyOf(factTools);
        if (wanted.isEmpty()) return List.of();                                                             // src: vvaharness/backends/llm/cli_mcp.py:98
        List<LcTool> built = toolBuilder.build(new StreamingOptions(model, cwd, factTools), List.of());      // src: vvaharness/backends/llm/cli_mcp.py:101
        return built.filter(t -> wanted.contains(t.name));                                                  // src: vvaharness/backends/llm/cli_mcp.py:102
    }

    @src("vvaharness/backends/llm/cli_mcp.py:105")
    Schema toolSchema(LcTool tool) {
        return new Schema("object", tool.args, tool.args.keys().filter(n -> !tool.args.get(n).containsKey("default"))); // src: vvaharness/backends/llm/cli_mcp.py:108
    }

    @src("vvaharness/backends/llm/cli_mcp.py:115")
    String budgetRefusal(List<Middleware> parentMiddleware, String name) {
        for (Middleware mw : parentMiddleware) {                                                            // src: vvaharness/backends/llm/cli_mcp.py:117
            if (mw.refusalFor == null) continue;
            String text = mw.refusalFor(name);
            if (text != null && !text.isEmpty()) return text;                                               // src: vvaharness/backends/llm/cli_mcp.py:123
        }
        return null;
    }

    @src("vvaharness/backends/llm/cli_mcp.py:127")
    Set<String> requiredFactTools(List<Middleware> parentMiddleware) {
        Set<String> required = new Set();
        for (Middleware mw : parentMiddleware) if (mw.requiredTools != null) required.addAll(mw.requiredTools); // src: vvaharness/backends/llm/cli_mcp.py:131
        return required;
    }

    /** Text to deny the forced StructuredOutput submit with (EvidenceGate hold), or null to allow it. */
    @src("vvaharness/backends/llm/cli_mcp.py:137")
    String submitGuard(List<Middleware> parentMiddleware) {
        for (Middleware mw : parentMiddleware) {                                                            // src: vvaharness/backends/llm/cli_mcp.py:139
            if (mw.holdForVerdict == null) continue;
            String text = mw.holdForVerdict();                                                              // src: vvaharness/backends/llm/cli_mcp.py:143
            if (text != null && !text.isEmpty()) return text;
        }
        return null;
    }

    @src("vvaharness/backends/llm/cli_mcp.py:149")
    void logToolCall(String name, Map payload, String tagSfx) {
        if (ScanProgress.isStageOnly()) return;                                                             // name and size only, never content // src: vvaharness/backends/llm/cli_mcp.py:152
        Console.write("[cli-mcp] tool " + name + " -> " + payload.content.get(0).text.length() + " chars" + tagSfx);
    }

    /** Langchain tools -> in-process SdkMcpTools with caller budget metering and redaction. */
    @src("vvaharness/backends/llm/cli_mcp.py:158")
    List<SdkTool> toSdkTools(List<LcTool> langchainTools, List<Middleware> parentMiddleware, Set<String> called, String tag) {
        List<SdkTool> out = new List();
        for (LcTool lcTool : langchainTools) {                                                              // every loop var bound (no late binding) // src: vvaharness/backends/llm/cli_mcp.py:166
            out.add(new SdkTool(lcTool.name, lcTool.description, toolSchema(lcTool), args -> handle(lcTool, args, parentMiddleware, called, tag))); // src: vvaharness/backends/llm/cli_mcp.py:170
        }
        return out;
    }

    @src("vvaharness/backends/llm/cli_mcp.py:172")
    Map handle(LcTool tool, Map args, List<Middleware> parentMiddleware, Set<String> called, String tag) {
        String refusal = budgetRefusal(parentMiddleware, tool.name);                                        // src: vvaharness/backends/llm/cli_mcp.py:173
        if (refusal != null) return content(refusal, true);                                                 // src: vvaharness/backends/llm/cli_mcp.py:175
        called.add(tool.name);                                                                              // src: vvaharness/backends/llm/cli_mcp.py:176
        for (Middleware mw : parentMiddleware) if (mw.noteCall != null) mw.noteCall(tool.name);             // src: vvaharness/backends/llm/cli_mcp.py:177
        Object result;
        try {
            result = Async.toThread(() -> tool.invoke(args));                                               // off-loop // src: vvaharness/backends/llm/cli_mcp.py:183
        } catch (Exception exc) {
            Counters.bump("cli_mcp_tool_error_" + tool.name);                                               // src: vvaharness/backends/llm/cli_mcp.py:185
            return content(exc.type + ": " + Redact.redact(exc.message), true);                             // a tool fault must not kill the loop // src: vvaharness/backends/llm/cli_mcp.py:186
        }
        Map payload = content(serialize(result), false);                                                    // src: vvaharness/backends/llm/cli_mcp.py:188
        logToolCall(tool.name, payload, tag);
        return payload;
    }

    @src("vvaharness/backends/llm/cli_mcp.py:198")
    Map schemaFor(Schema responseModel) {
        Map schema = responseModel.modelJsonSchema().copy();                                                // src: vvaharness/backends/llm/cli_mcp.py:200
        schema.remove("title");
        schema.remove("$schema");                                                                           // src: vvaharness/backends/llm/cli_mcp.py:202
        return schema;
    }

    @src("vvaharness/backends/llm/cli_mcp.py:206")
    String serialize(Object result) {
        if (result instanceof String) return result;                                                        // src: vvaharness/backends/llm/cli_mcp.py:208
        try { return Json.dumps(result); } catch (Exception e) { return result.toString(); }                // src: vvaharness/backends/llm/cli_mcp.py:211
    }

    /** MCP tool result payload, redaction-masked as on every other route. */
    @src("vvaharness/backends/llm/cli_mcp.py:216")
    Map content(String text, boolean isError) {
        Map payload = Map.of("content", List.of(Map.of("type", "text", "text", AgentSdk.redactToolOutput(text, true)))); // src: vvaharness/backends/llm/cli_mcp.py:222
        if (isError) payload.put("is_error", true);                                                         // src: vvaharness/backends/llm/cli_mcp.py:225
        return payload;
    }

    /** Ambient env + this route's TLS/proxy carriers (NOT agent_sdk's env: that would move OAuth users to API-key billing). */
    @src("vvaharness/backends/llm/cli_mcp.py:232")
    Map bridgeEnv() {
        return System.environ() + Env.tlsExtra;                                                             // src: vvaharness/backends/llm/cli_mcp.py:235
    }

    @src("vvaharness/backends/llm/cli_mcp.py:238")
    Map sessionEnv(Map extraEnv, String tier) {
        return bridgeEnv() + extraEnv + Env.sessionPins(tier);                                              // same pins as the cli route // src: vvaharness/backends/llm/cli_mcp.py:241
    }

    /** ClaudeAgentOptions for one bridged detection session. */
    @src("vvaharness/backends/llm/cli_mcp.py:244")
    AgentOptions buildOptions(String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, List<String> mcpToolNames, Integer maxTurns, Double maxBudgetUsd, String effort, boolean allowShell, Object server, Schema responseModel, List<Middleware> parentMiddleware, Map extraEnv, Theta θ) {
        if (!Sdk.has("ClaudeAgentOptions", "HookMatcher")) throw new RuntimeError("no PreToolUse hook support; reinstall, or set cli.mcp_tools: false"); // src: vvaharness/backends/llm/cli_mcp.py:259
        Path root = cwd.resolve();                                                                          // src: vvaharness/backends/llm/cli_mcp.py:271
        List<String> nativeTools = CliSession.bareToolNames(allowedTools);                                  // src: vvaharness/backends/llm/cli_mcp.py:272
        // Bash only on an explicit caller grant (step2.bash), never force-added: repos inject RCE
        if (!allowShell) nativeTools = nativeTools.filter(n -> n != "Bash");                                // src: vvaharness/backends/llm/cli_mcp.py:274
        Set<String> granted = Set.copyOf(nativeTools);                                                      // src: vvaharness/backends/llm/cli_mcp.py:276
        Set<String> denyDirsCf = CliSession.READ_DENY_DIRS.map(d -> d.casefold());                          // src: vvaharness/backends/llm/cli_mcp.py:278
        Map hooks = AgentSdk.buildRedactionHooks() != null ? AgentSdk.buildRedactionHooks() : new Map();     // masks NATIVE tool output // src: vvaharness/backends/llm/cli_mcp.py:356
        hooks.put("PreToolUse", List.of(new HookMatcher(in -> preToolUseGate(in, root, granted, denyDirsCf, responseModel, parentMiddleware, θ)))); // src: vvaharness/backends/llm/cli_mcp.py:357
        String tier = Env.effectiveEffort(effort);                                                          // unset inherits cli.effort // src: vvaharness/backends/llm/cli_mcp.py:360
        AgentOptions opts = new AgentOptions();
        opts.model = model;                                                                                 // src: vvaharness/backends/llm/cli_mcp.py:363
        opts.cwd = root;
        opts.env = sessionEnv(extraEnv, tier);                                                              // src: vvaharness/backends/llm/cli_mcp.py:365
        opts.cliPath = Discovery.CLAUDE_CMD.get(0);                                                         // same pinned binary as cli // src: vvaharness/backends/llm/cli_mcp.py:366
        opts.mcpServers = Map.of(SERVER_NAME, server);                                                      // src: vvaharness/backends/llm/cli_mcp.py:367
        opts.strictMcpConfig = true;                                                                        // repo .mcp.json never spawned // src: vvaharness/backends/llm/cli_mcp.py:369
        opts.settingSources = θ["code.backends.llm.cli_mcp.setting_sources"];                               // user keeps apiKeyHelper auth // src: vvaharness/backends/llm/cli_mcp.py:371
        if (θ["code.backends.llm.cli_mcp.disable_slash_commands"]) opts.extraArgs = Map.of("disable-slash-commands", null); // repo commands/skills = injection surface // src: vvaharness/backends/llm/cli_mcp.py:373
        opts.tools = nativeTools;                                                                           // availability, not an allowlist // src: vvaharness/backends/llm/cli_mcp.py:375
        opts.allowedTools = nativeTools + mcpToolNames;                                                     // src: vvaharness/backends/llm/cli_mcp.py:376
        opts.disallowedTools = (allowShell ? List.of() : List.of("Bash")) + CliSession.READ_DENY_DIRS.map(d -> "Read(./" + d + "/**)"); // src: vvaharness/backends/llm/cli_mcp.py:378
        opts.permissionMode = θ["code.backends.llm.cli_mcp.permission_mode"];                               // src: vvaharness/backends/llm/cli_mcp.py:382
        opts.hooks = hooks;
        opts.verbatimPrompts = true;                                                                        // no @path expansion of repo text // src: vvaharness/backends/llm/cli_mcp.py:386
        if (systemPrompt != null) opts.systemPrompt = systemPrompt;                                         // src: vvaharness/backends/llm/cli_mcp.py:388
        if (maxTurns != null) opts.maxTurns = maxTurns;                                                     // src: vvaharness/backends/llm/cli_mcp.py:390
        if (maxBudgetUsd != null) opts.maxBudgetUsd = maxBudgetUsd;                                         // src: vvaharness/backends/llm/cli_mcp.py:392
        if (tier != null) opts.effort = tier;                                                               // src: vvaharness/backends/llm/cli_mcp.py:394
        if (responseModel != null) opts.outputFormat = Map.of("type", "json_schema", "schema", schemaFor(responseModel)); // src: vvaharness/backends/llm/cli_mcp.py:396
        return opts;
    }

    /** PreToolUse hook: deny-by-default availability + read-jail path confinement; fail-closed. No write arm (detection). */
    @src("vvaharness/backends/llm/cli_mcp.py:280")
    Map preToolUseGate(Map inputData, Path root, Set<String> granted, Set<String> denyDirsCf, Schema responseModel, List<Middleware> parentMiddleware, Theta θ) {
        try {
            String toolName = inputData.getOrDefault("tool_name", "");                                      // src: vvaharness/backends/llm/cli_mcp.py:301
            Map toolInput = inputData.getOrDefault("tool_input", Map.of());
            if (toolName.startsWith(TOOL_PREFIX)) return Map.of();                                          // the bridged fact tools // src: vvaharness/backends/llm/cli_mcp.py:304
            if (toolName == LlmModels.CLI_STRUCTURED_OUTPUT_TOOL) {                                         // src: vvaharness/backends/llm/cli_mcp.py:307
                if (responseModel == null) return deny(toolName + " is not permitted: no response_model");  // src: vvaharness/backends/llm/cli_mcp.py:309
                String holdText = submitGuard(parentMiddleware);                                            // EvidenceGate nudge reaches the model as this denial // src: vvaharness/backends/llm/cli_mcp.py:313
                if (holdText != null) return deny(holdText);                                                // src: vvaharness/backends/llm/cli_mcp.py:315
                return Map.of();
            }
            if (!granted.contains(toolName)) return deny(toolName + " is not permitted in this detection session"); // src: vvaharness/backends/llm/cli_mcp.py:317
            List<String> keys = θ["code.backends.llm.cli_mcp.gate_path_keys"];                              // src: vvaharness/backends/llm/cli_mcp.py:322
            if (toolName == "Glob") keys = keys + List.of("pattern");                                       // src: vvaharness/backends/llm/cli_mcp.py:324
            else if (toolName == "Grep") keys = keys + List.of("glob");                                     // pattern is a content regex, not a path // src: vvaharness/backends/llm/cli_mcp.py:327
            boolean foundPathArg = false;
            for (String key : keys) {                                                                       // src: vvaharness/backends/llm/cli_mcp.py:329
                Object raw = toolInput.get(key);
                if (raw == null || raw.isEmpty()) continue;
                foundPathArg = true;
                Path resolved = AgentSdk.resolveWithinRoot(root, raw);                                      // src: vvaharness/backends/llm/cli_mcp.py:334
                if (resolved == null) return deny(toolName + " target is outside the repository root, unresolvable, or a symlink"); // src: vvaharness/backends/llm/cli_mcp.py:336
                List<String> parts = resolved.relativeTo(root).parts();
                if (!parts.isEmpty() && denyDirsCf.contains(parts.get(0).casefold())) return deny(toolName + " target falls under an internal directory"); // top-level only // src: vvaharness/backends/llm/cli_mcp.py:341
            }
            if (toolName == "Read" && !foundPathArg) return deny("Read requires a file path argument");     // fail closed // src: vvaharness/backends/llm/cli_mcp.py:346
            return Map.of();
        } catch (Exception exc) {
            return deny("the security gate could not evaluate this call and denies it as a precaution");    // src: vvaharness/backends/llm/cli_mcp.py:352
        }
    }

    Map deny(String reason) {
        return Map.of("hookEventName", "PreToolUse", "permissionDecision", "deny", "permissionDecisionReason", reason); // src: vvaharness/backends/llm/cli_mcp.py:294
    }

    /** Stream one bridged session to completion; trust-check the terminal ResultMessage. */
    @src("vvaharness/backends/llm/cli_mcp.py:413")
    String run(Prompt userPrompt, AgentOptions opts, Double timeout, String tag, String effort) {
        List<String> parts = new List();
        double started = Clock.monotonic();
        SdkClient client = new SdkClient(opts);                                                             // src: vvaharness/backends/llm/cli_mcp.py:442
        client.query(userPrompt);
        // onMessage: Cli.aborted() poll is the only stop path for this out-of-band process
        DrainResult drained = AgentSdk.drainUntilResult(client, m -> onMessage(m, parts), timeout, LlmModels.TIMEOUT_STOP_GRACE_SECONDS); // src: vvaharness/backends/llm/cli_mcp.py:444
        client.close();
        double elapsed = Clock.monotonic() - started;
        ResultMessage result = drained.result;
        Tokens.TOKENS.add(result == null ? null : result.usage, result == null ? null : result.totalCostUsd, result == null ? null : result.numTurns); // unconditional // src: vvaharness/backends/llm/cli_mcp.py:453
        if (drained.timedOut) throw LlmModels.callTimeoutError(tag, "cli-mcp", timeout, effort);            // src: vvaharness/backends/llm/cli_mcp.py:456
        LlmModels.noteBudgetUse(elapsed, timeout, effort);                                                  // src: vvaharness/backends/llm/cli_mcp.py:460
        String stopReason = result == null ? null : result.stopReason;
        String resultText = result == null ? null : result.result;
        checkTerminalResult(stopReason, result != null && result.isError, result == null ? null : result.subtype, result == null ? null : result.apiErrorStatus, result == null ? null : result.errors, resultText, tag); // src: vvaharness/backends/llm/cli_mcp.py:465
        Object structured = result == null ? null : result.structuredOutput;
        noteStructuredMiss(opts, structured);                                                               // src: vvaharness/backends/llm/cli_mcp.py:473
        String structuredText = Envelope.structuredText(Map.of("structured_output", structured));           // src: vvaharness/backends/llm/cli_mcp.py:474
        return firstNonEmpty(structuredText, resultText, String.join("", parts)).strip();                   // structured > result > streamed text // src: vvaharness/backends/llm/cli_mcp.py:475
    }

    @src("vvaharness/backends/llm/cli_mcp.py:427")
    void onMessage(Message message, List<String> parts) {
        if (Cancel.aborted()) throw new RuntimeError("aborted by user (Ctrl-C)");                           // src: vvaharness/backends/llm/cli_mcp.py:428
        if (message instanceof AssistantMessage) {
            for (Block block : message.content) if (block instanceof TextBlock) { parts.add(block.text); Process.streamTrace(block.text, null); } // src: vvaharness/backends/llm/cli_mcp.py:432
        }
    }

    /** A structured session ending with no structured_output is counted, not raised (stage repairs the text). */
    @src("vvaharness/backends/llm/cli_mcp.py:478")
    void noteStructuredMiss(AgentOptions opts, Object structured) {
        if (opts.outputFormat == null || structured != null) return;                                        // src: vvaharness/backends/llm/cli_mcp.py:482
        Counters.bump("cli_mcp_structured_output_missing");                                                 // src: vvaharness/backends/llm/cli_mcp.py:484
        WarnOnce.warn(WARNED, "structured_missing:" + opts.model, "structured session ended without structured_output; using the text reply");
    }

    /** Raise unless the terminal ResultMessage is a complete, trustworthy reply: refusal > max_tokens > error. */
    @src("vvaharness/backends/llm/cli_mcp.py:491")
    void checkTerminalResult(String stopReason, boolean isError, String subtype, Integer apiErrorStatus, List errors, String resultText, String tag) {
        if (stopReason == LlmModels.ANTHROPIC_STOP_REFUSAL) throw LlmModels.modelRefusal("cli-mcp", tag, null); // src: vvaharness/backends/llm/cli_mcp.py:497
        if (stopReason == LlmModels.ANTHROPIC_STOP_MAX_TOKENS) throw new SessionTruncatedError(stopReason); // src: vvaharness/backends/llm/cli_mcp.py:500
        if (isError || (subtype != null && subtype != "success")) {                                         // src: vvaharness/backends/llm/cli_mcp.py:502
            String detail = errors != null && !errors.isEmpty() ? String.join("; ", errors) : (resultText != null ? resultText.strip() : "no detail reported by the CLI"); // src: vvaharness/backends/llm/cli_mcp.py:503
            if (LlmModels.CLI_TOKEN_CAP_RX.search(detail) != null) throw new SessionTruncatedError(stopReason); // cap hit reported as prose // src: vvaharness/backends/llm/cli_mcp.py:507
            throw new SessionResultError("subtype/is_error/api_error_status: " + detail);                   // src: vvaharness/backends/llm/cli_mcp.py:509
        }
    }

    /** Map an SDK-side failure to typed transport errors using cli's own regexes. */
    @src("vvaharness/backends/llm/cli_mcp.py:514")
    void reraiseTransport(Exception exc, String tag) {
        String text = Redact.redact(exc.message).substring(0, 400);                                         // src: vvaharness/backends/llm/cli_mcp.py:517
        if (Retry.PROXY_FAILURE.search(text) != null) throw new ProxyError(text, "cli");                    // VVAH-E002 // src: vvaharness/backends/llm/cli_mcp.py:518
        if (Retry.AUTH_FAILURE.search(text) != null) throw new AuthenticationError(text, 401, "cli");       // VVAH-E001 // src: vvaharness/backends/llm/cli_mcp.py:522
        throw new RuntimeError("cli MCP bridge failed [" + tag + "]: " + text);                             // src: vvaharness/backends/llm/cli_mcp.py:524
    }

    /** (requested, retry_at) for the one doubled-budget truncation retry. */
    @src("vvaharness/backends/llm/cli_mcp.py:527")
    Pair truncationRetryBudget(int truncRetried, String tag, Integer maxTokens, Theta θ) {
        int requested;
        if (truncRetried != 0 || maxTokens != null) requested = truncRetried != 0 ? truncRetried : maxTokens; // src: vvaharness/backends/llm/cli_mcp.py:532
        else requested = System.getenvInt("CLAUDE_CODE_MAX_OUTPUT_TOKENS", θ["code.deepagents.model_max_output_tokens"]); // src: vvaharness/backends/llm/cli_mcp.py:536
        Integer retryAt = truncRetried != 0 ? null : LlmModels.truncationRetryMax(requested, θ["code.deepagents.model_max_output_tokens"]); // src: vvaharness/backends/llm/cli_mcp.py:540
        if (retryAt != null) Retry.logTruncationRetry(tag, requested, retryAt, "cli-mcp");                  // src: vvaharness/backends/llm/cli_mcp.py:543
        return Pair.of(requested, retryAt);
    }

    /** An agentic claude session that can call the caller's in-process tools. */
    @src("vvaharness/backends/llm/cli_mcp.py:548")
    String agenticWithTools(Prompt userPrompt, String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, ToolBuilder toolBuilder, List<String> factTools, List<Middleware> parentMiddleware, Integer maxTurns, Double maxBudgetUsd, Integer maxTokens, String effort, boolean allowShell, Schema responseModel, String tag, Double timeout, Theta θ) {
        if (!available()) throw new RuntimeError("via: cli with caller tools needs the Claude Agent SDK; or set cli.mcp_tools: false"); // src: vvaharness/backends/llm/cli_mcp.py:569
        if (Cancel.aborted()) throw new RuntimeError("aborted by user (Ctrl-C)");                           // src: vvaharness/backends/llm/cli_mcp.py:579
        List<LcTool> lcTools = materialize(toolBuilder, model, cwd, factTools);                             // src: vvaharness/backends/llm/cli_mcp.py:582
        if (lcTools.isEmpty()) throw new RuntimeError("tool_builder produced none of the requested tools; refusing a tool-less session"); // src: vvaharness/backends/llm/cli_mcp.py:586
        Set<String> called = new Set();
        List<SdkTool> sdkTools = toSdkTools(lcTools, parentMiddleware, called, tag);                        // src: vvaharness/backends/llm/cli_mcp.py:592
        Object server = Sdk.createSdkMcpServer(SERVER_NAME, sdkTools);                                      // src: vvaharness/backends/llm/cli_mcp.py:594
        List<String> wireNames = lcTools.map(t -> mcpName(t.name));
        String tier = Env.effectiveEffort(effort);                                                          // src: vvaharness/backends/llm/cli_mcp.py:599
        Double scaledTimeout = LlmModels.effortScaledSeconds(timeout, tier, SESSION);                       // bounds EACH attempt // src: vvaharness/backends/llm/cli_mcp.py:600
        // VVAH-E005: one doubled-budget retry then raise
        int truncRetried = 0;
        Map extraEnv = maxTokens != null ? Map.of("CLAUDE_CODE_MAX_OUTPUT_TOKENS", maxTokens) : null;        // src: vvaharness/backends/llm/cli_mcp.py:609
        String text;
        while (true) {                                                                                      // src: vvaharness/backends/llm/cli_mcp.py:610
            AgentOptions opts = buildOptions(model, systemPrompt, allowedTools, cwd, wireNames, maxTurns, maxBudgetUsd, tier, allowShell, server, responseModel, parentMiddleware, extraEnv, θ); // src: vvaharness/backends/llm/cli_mcp.py:611
            try {
                text = run(userPrompt, opts, scaledTimeout, tag, tier);                                     // src: vvaharness/backends/llm/cli_mcp.py:619
            } catch (SessionTruncatedError e) {
                Pair budget = truncationRetryBudget(truncRetried, tag, maxTokens, θ);                       // src: vvaharness/backends/llm/cli_mcp.py:622
                if (budget.second != null) {
                    extraEnv = Map.of("CLAUDE_CODE_MAX_OUTPUT_TOKENS", budget.second);                      // src: vvaharness/backends/llm/cli_mcp.py:625
                    truncRetried = budget.second;
                    continue;
                }
                throw Retry.truncationError(budget.first, truncRetried, tag, budget.second);                // src: vvaharness/backends/llm/cli_mcp.py:628
            } catch (AuthenticationError | ProxyError | RuntimeError | TimeoutError e) {
                throw e;                                                                                    // src: vvaharness/backends/llm/cli_mcp.py:631
            } catch (Exception exc) {
                reraiseTransport(exc, tag);                                                                 // src: vvaharness/backends/llm/cli_mcp.py:633
            }
            if (truncRetried != 0) Counters.bump(LlmModels.TRUNCATED_RETRY_RECOVERED_COUNTER);              // src: vvaharness/backends/llm/cli_mcp.py:636
            break;
        }
        reportEvidenceDegradation(parentMiddleware, called, tag);                                           // src: vvaharness/backends/llm/cli_mcp.py:639
        ResponseQuality.check(text, tag);                                                                   // src: vvaharness/backends/llm/cli_mcp.py:640
        return text;
    }

    /** Verdict shipped without consulting any required tool: counted + warned (submit already relented). */
    @src("vvaharness/backends/llm/cli_mcp.py:644")
    void reportEvidenceDegradation(List<Middleware> parentMiddleware, Set<String> called, String tag) {
        Set<String> required = requiredFactTools(parentMiddleware);                                         // src: vvaharness/backends/llm/cli_mcp.py:648
        if (required.isEmpty() || !required.intersect(called).isEmpty()) return;                            // src: vvaharness/backends/llm/cli_mcp.py:649
        Counters.bump(EVIDENCE_UNENFORCED_COUNTER);                                                         // src: vvaharness/backends/llm/cli_mcp.py:651
        WarnOnce.warn(WARNED, "evidence-gate:" + tag, "verdict accepted without required graph evidence");
    }
}
