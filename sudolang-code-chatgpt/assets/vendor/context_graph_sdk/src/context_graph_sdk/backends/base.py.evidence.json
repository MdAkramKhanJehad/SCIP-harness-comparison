  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Narrow backend protocols for one physical graph database.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Iterator\nfrom contextlib import AbstractContextManager\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Protocol, runtime_checkable\n\nfrom context_graph_sdk.identity import ProjectId\nfrom context_graph_sdk.models import (\n    CatalogPublication,\n    CorrelationEdge,\n    FrozenMap,\n    GraphEdge,\n    GraphNode,\n    ProjectSnapshot,\n    ProviderManifest,\n    ResolvedCorrelation,\n    SnapshotLocator,\n)\n\n\n@dataclass(frozen=True, order=True)\nclass SchemaPattern:\n    source_label: str\n    relationship_type: str\n    target_label: str\n    count: int\n\n\n@dataclass(frozen=True)\nclass GraphSchema:\n    labels: tuple[str, ...]\n    relationship_types: tuple[str, ...]\n    node_property_keys: tuple[str, ...]\n    relationship_property_keys: tuple[str, ...] = ()\n    patterns: tuple[SchemaPattern, ...] = ()\n    node_count: int = 0\n    relationship_count: int = 0\n\n    def __post_init__(self) -> None:\n        object.__setattr__(self, \"labels\", tuple(sorted(set(self.labels))))\n        object.__setattr__(self, \"relationship_types\", tuple(sorted(set(self.relationship_types))))\n        object.__setattr__(self, \"node_property_keys\", tuple(sorted(set(self.node_property_keys))))\n        object.__setattr__(\n            self,\n            \"relationship_property_keys\",\n            tuple(sorted(set(self.relationship_property_keys))),\n        )\n        object.__setattr__(self, \"patterns\", tuple(sorted(set(self.patterns))))\n\n    @property\n    def property_keys(self) -> tuple[str, ...]:\n        \"\"\"All node and relationship property keys (compatibility view).\"\"\"\n        return tuple(sorted(set(self.node_property_keys + self.relationship_property_keys)))\n\n\n@runtime_checkable\nclass GraphWriteTransaction(Protocol):\n    \"\"\"One atomic write unit inside one physical database.\"\"\"\n\n    def write_nodes(self, nodes: tuple[GraphNode, ...]) -> None: ...\n\n    def write_edges(self, edges: tuple[GraphEdge, ...]) -> None: ...\n\n    def commit(self) -> None: ...\n\n    def rollback(self) -> None: ...\n\n\n@runtime_checkable\nclass CatalogWriteTransaction(Protocol):\n    \"\"\"One authoritative accepted-snapshot and correlation publication.\"\"\"\n\n    def publish(self, publication: CatalogPublication) -> None: ...\n\n    def commit(self) -> None: ...\n\n    def rollback(self) -> None: ...\n\n\n@runtime_checkable\nclass GraphBackend(Protocol):\n    \"\"\"A single project-snapshot or correlation database handle.\"\"\"\n\n    def begin_write(self) -> AbstractContextManager[GraphWriteTransaction]: ...\n\n    def query_readonly(\n        self, cypher: str, parameters: FrozenMap, row_limit: int\n    ) -> Iterator[FrozenMap]: ...\n\n    def close(self) -> None: ...\n\n\n@runtime_checkable\nclass CatalogBackend(GraphBackend, Protocol):\n    def begin_publication(self) -> AbstractContextManager[CatalogWriteTransaction]: ...\n\n    def accepted_snapshot(self, project_id: ProjectId) -> ProjectSnapshot | None: ...\n\n    def accepted_snapshots(self) -> tuple[ProjectSnapshot, ...]: ...\n\n    def correlations_touching(self, project_id: ProjectId) -> tuple[CorrelationEdge, ...]: ...\n\n    def project_snapshot_count(self, project_id: ProjectId) -> int: ...\n\n    def node_ref_count(self, project_id: ProjectId) -> int: ...\n\n    def provider_manifests(self, project_id: ProjectId) -> tuple[ProviderManifest, ...]: ...\n\n    def resolve_correlations(\n        self, node_id: str, result_limit: int\n    ) -> tuple[ResolvedCorrelation, ...]: ...\n\n\n@runtime_checkable\nclass GraphBackendFactory(Protocol):\n    \"\"\"Creates independent physical databases without process-global pooling.\"\"\"\n\n    def create_project(self, locator: SnapshotLocator) -> GraphBackend: ...\n\n    def open_project(self, locator: SnapshotLocator) -> GraphBackend: ...\n\n    def create_catalog(self, path: Path) -> CatalogBackend: ...\n\n    def open_catalog(self, path: Path) -> CatalogBackend: ...\n\n    def delete_project(self, locator: SnapshotLocator) -> None: ...\n",
