// src: vvaharness/backends/harness/deepagents/models.py:36-45
SSL_CERT_FILE_VAR = "SSL_CERT_FILE"
SSL_CERT_DIR_VAR = "SSL_CERT_DIR"
TLS_CLIENT_CERT_VAR = "VVAHARNESS_TLS_CLIENT_CERT"   // combined PEM, or the certificate half of a split pair
TLS_CLIENT_KEY_VAR = "VVAHARNESS_TLS_CLIENT_KEY"     // optional key path for a split pair
TLS_VERIFY_VAR = "VVAHARNESS_TLS_VERIFY"             // internal verify_ssl carrier, never a user knob; value-stamped so ambient values are ignored

// src: vvaharness/backends/harness/deepagents/models.py:48-65
fn anthropic_key(env):executor=code { return env.ANTHROPIC_API_KEY or env.ANTHROPIC_AUTH_TOKEN }   // API key preferred
fn anthropic_base(env):executor=code { return env.ANTHROPIC_BASE_URL }
fn openai_key(env):executor=code { return env.OPENAI_API_KEY }
fn openai_base(env):executor=code { return env.OPENAI_BASE_URL }

// src: vvaharness/backends/harness/deepagents/models.py:68-101
ModelKey {
  // Hashable cache key for a built model; holds resolved credentials, not the env dict
  model_id: String
  provider: String              // provider or ""
  openai_key: String; openai_base: String; anthropic_key: String; anthropic_base: String   // each "" when unset
  effort: String | null = null
  use_responses_api: Boolean | null = null   // the RESOLVED transport, so a learned flip misses the cache
  fn of(model_id, env, provider, effort?, use_responses_api?):executor=code
}

// src: vvaharness/backends/harness/deepagents/models.py:104-105
READ_ONLY_HARNESS_PROFILE = HarnessProfile(excluded_tools=NATIVE_WRITE_TOOLS)   // compatibility and tests only, not registered globally

// src: vvaharness/backends/harness/deepagents/models.py:107-114
READ_ONLY_PERMISSIONS = [
  { operations: ["write"], paths: ["/**", "/.*", "/.*/**", "/**/.*", "/**/.*/**"], mode: "deny" }
  // Matching runs without DOTGLOB, so "/**" alone would leave .git and .env writable; the dot patterns close that
]

// src: vvaharness/backends/harness/deepagents/models.py:116-125
GIT_INTERNALS_DENY = [
  { operations: ["write"], paths: [ "/$d", "/$d/**", "/**/$d", "/**/$d/**" for each d in git_dir_spellings() ], mode: "deny" }
  // Applied even to write-enabled sessions: a .git/config write is remote code execution (core.fsmonitor, sshCommand).
  // Matching is case-sensitive, so every letter-case spelling of .git is listed.
]

// src: vvaharness/backends/harness/deepagents/models.py:127-136
DELETE_TOOL_NAME = "delete"   // deepagents 0.7 registers it unconditionally; write sessions withhold it explicitly
SUBAGENT_DISPATCH_TOOL = "task"   // auto-added, not in ALL_NATIVE_TOOLS, so withheld by name
ALL_NATIVE_TOOLS = { "ls", "read_file", "write_file", "edit_file", "glob", "grep", "delete", "execute" }

