// file: vvaharness/backends/llm/registry.py, vvaharness/config/profiles/default.yaml, vvaharness/config/__init__.py
// Backend dispatcher: every stage calls prompt()/agentic() here; a model node (id, via, provider, extras) picks the route.
// Also holds the per-role model routing table and the route-wide transport/cache/refusal/pricing settings.

@executedBy(CODE) @role(backend)
class LlmRegistry {

    // via: deepagents is deliberately NOT a registered backend: stages branch to it themselves for these roles
    Set<String> DEEPAGENTS_ROLES = θ["code.backends.llm.registry.deepagents_roles"];                        // not in BACKENDS by design: get_backend fails loudly; preflight/environment enforce this // src: vvaharness/backends/llm/registry.py:40
    // post-detection (S10/S11): a probe failure only WARNs; detection roles stay fatal (silent gaps)
    Set<String> POST_SCAN_ROLES = θ["code.backends.llm.registry.post_scan_roles"];                          // src: vvaharness/backends/llm/registry.py:57
    // every key a consumer reads off a model config node; preflight and doctor warn on the rest
    Set<String> KNOWN_MODEL_NODE_KEYS = θ["code.backends.llm.registry.known_model_node_keys"];               // src: vvaharness/backends/llm/registry.py:92
    // backends are named by import path and resolved on selection, so picking one never imports its SDK
    Map<String, String> BACKENDS = Map.of("cli", "LlmCli", "sdk", "LlmSdk", "openai", "LlmOpenai");         // src: vvaharness/backends/llm/registry.py:137
    String DEFAULT_LLM_VIA = θ["code.default_llm_via"];                                                     // selected when a model config names no backend // src: vvaharness/backends/llm/registry.py:137
    // model-node keys already reported as unsupported on the cli route, once per process
    Set<String> WARNED_CLI_DROPPED = new Set();                                                             // src: vvaharness/backends/llm/registry.py:173
    // keys a model node may carry that the claude binary has no way to send
    List<String> CLI_UNSUPPORTED_KEYS = θ["code.backends.llm.registry.cli_unsupported_keys"];               // src: vvaharness/backends/llm/registry.py:176

    /** Provider selector from a model config node, when it declares one (a string). */
    @src("vvaharness/backends/llm/registry.py:58")
    String providerOf(Object modelCfg) {
        return modelCfg.provider instanceof String ? modelCfg.provider : null;                              // src: vvaharness/backends/llm/registry.py:60
    }

    /** Transport override from a model config node, when it declares a boolean one. */
    @src("vvaharness/backends/llm/registry.py:64")
    Boolean useResponsesApiOf(Object modelCfg) {
        return modelCfg.useResponsesApi instanceof Boolean ? modelCfg.useResponsesApi : null;               // src: vvaharness/backends/llm/registry.py:67
    }

    /** A model's own output-token ceiling, when its config node declares one (positive number). */
    @src("vvaharness/backends/llm/registry.py:70")
    Integer outputCapOf(Object modelCfg) {
        // deliberately NOT read from ModelExtras: dropped-knob warnings would call this cap ignored
        Object value = modelCfg.maxTokens;                                                                  // src: vvaharness/backends/llm/registry.py:74
        return (value instanceof Number && value > 0) ? (int) value : null;                                 // src: vvaharness/backends/llm/registry.py:75
    }

    /** requested bounded by the model's own declared max_tokens cap, if any; only ever lowers. */
    @src("vvaharness/backends/llm/registry.py:78")
    int clampOutputTokens(int requested, Object modelCfg, String tag) {
        // a cap below the step's max_tokens 400s on the FIRST send
        Integer cap = outputCapOf(modelCfg);                                                                // src: vvaharness/backends/llm/registry.py:81
        if (cap == null || requested <= cap) return requested;                                              // src: vvaharness/backends/llm/registry.py:82
        log.warning(Events.OUTPUT_TOKENS_CLAMPED);                                                         // stage = first word of tag, else "llm" // src: vvaharness/backends/llm/registry.py:86
        return cap;                                                                                         // src: vvaharness/backends/llm/registry.py:89
    }

    /** Raw keys on a dict-backed model config node that no consumer reads, sorted. */
    @src("vvaharness/backends/llm/registry.py:97")
    List<String> unrecognizedModelKeys(Object modelCfg) {
        Object data = modelCfg._data;                                                                       // src: vvaharness/backends/llm/registry.py:99
        if (!(data instanceof Map)) return List.of();                                                       // src: vvaharness/backends/llm/registry.py:100
        return data.keys().map(k -> k.toString()).filter(k -> !KNOWN_MODEL_NODE_KEYS.contains(k)).sorted(); // src: vvaharness/backends/llm/registry.py:102
    }

    /** The registered via names, sorted. */
    @src("vvaharness/backends/llm/registry.py:140")
    List<String> available() {
        return BACKENDS.keys().sorted();                                                                    // src: vvaharness/backends/llm/registry.py:142
    }

    /** The shipped module paths, so a test can assert every one still resolves. */
    @src("vvaharness/backends/llm/registry.py:145")
    Map<String, String> targets() {
        return BACKENDS;                                                                                    // src: vvaharness/backends/llm/registry.py:145
    }

    /** Render a prompt as one string, joining the text blocks of a content-block list with a blank line. */
    @src("vvaharness/backends/llm/registry.py:162")
    String flattenBlocks(Object userPrompt) {
        if (userPrompt instanceof String) return userPrompt;                                                // src: vvaharness/backends/llm/registry.py:162
        return String.join("\n\n", userPrompt.filter(b -> b instanceof Map && b.type == "text").map(b -> b.text.toString())); // non-text blocks dropped // src: vvaharness/backends/llm/registry.py:166
    }

    /** Normalize a model config: a bare string takes the default via; else its id/via/extras win. */
    @src("vvaharness/backends/llm/registry.py:112")
    ResolvedModel resolve(Object modelCfg, Theta θ) {
        if (modelCfg instanceof String) return new ResolvedModel(modelCfg, DEFAULT_LLM_VIA, new Extras()); // src: vvaharness/backends/llm/registry.py:114
        if (modelCfg.id == null) throw new ValueError("Model config must be a string or have an id field"); // src: vvaharness/backends/llm/registry.py:118
        String via = modelCfg.via != null ? modelCfg.via : θ["code.default_llm_via"];                       // src: vvaharness/backends/llm/registry.py:122
        Extras extras = new Extras();
        if (modelCfg.temperature != null) extras.temperature = modelCfg.temperature;                        // src: vvaharness/backends/llm/registry.py:124
        if (modelCfg.thinkingBudget != null) extras.thinkingBudget = modelCfg.thinkingBudget;               // src: vvaharness/backends/llm/registry.py:127
        if (modelCfg.betas != null) extras.betas = modelCfg.betas;                                          // src: vvaharness/backends/llm/registry.py:130
        return new ResolvedModel(modelCfg.id, via, extras);                                                 // src: vvaharness/backends/llm/registry.py:132
    }

    /** Resolve via to its backend module, naming the model if unknown; imported lazily here. */
    @src("vvaharness/backends/llm/registry.py:150")
    Backend getBackend(String via, String modelId) {
        if (!BACKENDS.containsKey(via)) throw new ValueError("Unknown backend via");                        // src: vvaharness/backends/llm/registry.py:153
        Backend module = Backend.load(BACKENDS.get(via));                                                   // imported lazily // src: vvaharness/backends/llm/registry.py:155
        if (!(module has prompt and agentic)) throw new TypeError("backend module does not provide prompt() and agentic()"); // src: vvaharness/backends/llm/registry.py:156
        return module;                                                                                      // src: vvaharness/backends/llm/registry.py:159
    }

    /** Single-turn completion routed to the selected backend. kw is the caller's keyword map (max_tokens, tag, cache_prefix, system_prompt, ...). */
    @src("vvaharness/backends/llm/registry.py:208")
    String prompt(Object userPrompt, Object model, Effort effort, Theta θ, Map kw) {
        ResolvedModel r = resolve(model, θ);                                                                // src: vvaharness/backends/llm/registry.py:209
        Backend backend = getBackend(r.via, r.modelId);                                                     // src: vvaharness/backends/llm/registry.py:210
        if (kw.get("max_tokens") != null) kw.put("max_tokens", clampOutputTokens(kw.get("max_tokens"), model, kw.get("tag"))); // a model's declared max_tokens only ever lowers // src: vvaharness/backends/llm/registry.py:212
        if (r.via == "openai") {
            // by design: openai's truncation retry is bounded only by a declared cap; sdk and cli use 64k
            kw.put("output_cap", outputCapOf(model));                                                       // src: vvaharness/backends/llm/registry.py:216
        }
        ScanProgress tracker = ScanProgress.getActiveTracker();                                             // src: vvaharness/backends/llm/registry.py:217
        if (tracker != null) {
            // log the prefix too: for a specialist shard cache_prefix carries most of the request
            String prefix = kw.get("cache_prefix") != null ? kw.get("cache_prefix") : "";                  // src: vvaharness/backends/llm/registry.py:220
            String body = flattenBlocks(userPrompt);                                                        // src: vvaharness/backends/llm/registry.py:221
            tracker.llmPayload(TokenCounter.currentPhase(), r.via, r.modelId, kw.get("tag"), prefix.isEmpty() ? body : prefix + body, kw.get("system_prompt")); // src: vvaharness/backends/llm/registry.py:222
        }
        if (r.via == DEFAULT_LLM_VIA) {
            // the claude binary has no flag for temperature/thinking_budget/betas: dropped with a one-time WARN
            warnCliDroppedKnobs(r.modelId, r.extras);                                                       // src: vvaharness/backends/llm/registry.py:226
            userPrompt = foldForCli(userPrompt, kw);                                                        // cache_prefix folded into the user turn // src: vvaharness/backends/llm/registry.py:227
        } else {
            // e.g. models.deepdive.temperature reaches sdk/openai only
            for (Entry e : r.extras) kw.setdefault(e.key, e.value);                                         // caller-supplied kwargs win over model extras // src: vvaharness/backends/llm/registry.py:231
        }
        return backend.prompt(userPrompt, r.modelId, kw);                                                   // src: vvaharness/backends/llm/registry.py:236
    }

    /** Tool-using loop routed to the selected backend. */
    @src("vvaharness/backends/llm/registry.py:239")
    String agentic(Prompt userPrompt, Object model, List<String> tools, Path cwd, int maxTurns, int timeout, Theta θ, Map kw) {
        // cache_prefix is folded here (no agentic() accepts it; parity only, no cache hit); VVAH-E003 gate
        ResolvedModel r = resolve(model, θ);                                                                // src: vvaharness/backends/llm/registry.py:240
        Backend backend = getBackend(r.via, r.modelId);                                                     // src: vvaharness/backends/llm/registry.py:241
        if (r.via == DEFAULT_LLM_VIA) warnCliDroppedKnobs(r.modelId, r.extras);                             // src: vvaharness/backends/llm/registry.py:243
        if (kw.get("max_output_tokens") != null) {
            // only sdk/openai carry this key here; the cli legs are clamped in dispatch_agentic() before this call
            kw.put("max_output_tokens", clampOutputTokens(kw.get("max_output_tokens"), model, kw.get("tag"))); // src: vvaharness/backends/llm/registry.py:249
        }
        if (r.via == "openai") {
            kw.put("output_cap", outputCapOf(model));                                                       // src: vvaharness/backends/llm/registry.py:252
            kw.put("use_responses_api", useResponsesApiOf(model));                                          // src: vvaharness/backends/llm/registry.py:253
        }
        Object cachePrefix = kw.remove("cache_prefix");                                                     // src: vvaharness/backends/llm/registry.py:254
        if (cachePrefix != null && !cachePrefix.isEmpty()) userPrompt = cachePrefix + userPrompt;           // src: vvaharness/backends/llm/registry.py:255
        // stream_cb is CLI-only: dropped for sdk/openai (TypeError); timeout is forwarded to every via
        if (r.via != DEFAULT_LLM_VIA) kw.remove("stream_cb");                                               // src: vvaharness/backends/llm/registry.py:261
        String text = backend.agentic(userPrompt, r.modelId, kw);                                           // src: vvaharness/backends/llm/registry.py:262
        // no output_tokens: TOKENS holds the multi-turn aggregate, not this reply's own count
        ResponseQuality.checkResponseQuality(text, kw.get("tag"), null, null, null, θ);                     // degenerate reply -> VVAH-E003 // src: vvaharness/backends/llm/registry.py:264
        return text;
    }

    /** One-time WARN naming model-node keys the cli route cannot send. */
    @src("vvaharness/backends/llm/registry.py:179")
    void warnCliDroppedKnobs(String modelId, Extras extras) {
        // popped silently otherwise: a pinned temperature looks applied and is not
        List<String> dropped = CLI_UNSUPPORTED_KEYS.filter(k -> extras.containsKey(k));                     // src: vvaharness/backends/llm/registry.py:182
        if (dropped.isEmpty()) return;                                                                      // src: vvaharness/backends/llm/registry.py:183
        WarnOnce.warnOnce(WARNED_CLI_DROPPED, modelId + ":" + String.join(",", dropped), "models entry sets keys the claude CLI has no flag for - ignored on this route"); // once per model and key set // src: vvaharness/backends/llm/registry.py:185
    }

    /** Adapt kw in place for the CLI route, returning the (possibly prefixed) prompt. */
    @src("vvaharness/backends/llm/registry.py:194")
    Object foldForCli(Object userPrompt, Map kw) {
        // dropping temperature is NOT determinism, just a default
        kw.remove("temperature");                                                                           // src: vvaharness/backends/llm/registry.py:195
        kw.remove("thinking_budget");                                                                       // src: vvaharness/backends/llm/registry.py:196
        kw.remove("betas");                                                                                 // src: vvaharness/backends/llm/registry.py:197
        Object cachePrefix = kw.remove("cache_prefix");                                                     // src: vvaharness/backends/llm/registry.py:198
        if (cachePrefix == null || cachePrefix.isEmpty()) return userPrompt;                                // src: vvaharness/backends/llm/registry.py:201
        if (userPrompt instanceof List) return List.of(Map.of("type", "text", "text", cachePrefix)) + userPrompt; // block list: prefix becomes the first text block // src: vvaharness/backends/llm/registry.py:204
        return cachePrefix + userPrompt;                                                                    // src: vvaharness/backends/llm/registry.py:205
    }

    /** via deepagents: stages call Deepagents directly with these route-wide switches. */
    @src("vvaharness/backends/llm/deepagents.py:950")
    String dispatchDeepagents(Prompt userPrompt, Object model, Effort effort, Theta θ) {
        // reasoning written in the system prompt instead of native thinking (no-op on models that reject it)
        boolean thinkInPrompt = θ["think_in_prompt"];                                                       // src: vvaharness/backends/llm/deepagents.py:952
        // the ONLY cache-marker switch that reaches deepagents is the sdk block's key
        boolean markers = θ["sdk.cache_markers"] != "off";                                                  // src: vvaharness/backends/llm/deepagents.py:826
        return Deepagents.agentic(userPrompt, model, effort, markers, thinkInPrompt, θ);                    // src: vvaharness/backends/llm/deepagents.py:711
    }

    /** A refused call may be re-sent identically once, on Anthropic routes only (an OpenAI-compatible cyber filter can revoke the org). */
    @src("vvaharness/backends/llm/models.py:510")
    boolean refusalResendAllowed(Object modelCfg, Theta θ) {
        // load() refuses values outside 0..1; 0 also disables the S6 refused-batch split
        if (θ["refusal_retries"] <= 0) return false;                                                        // src: vvaharness/backends/llm/models.py:514
        ResolvedModel r = resolve(modelCfg, θ);
        return Manifest.resolvedRoute(r.via, r.modelId, modelCfg.provider) == "anthropic";                  // src: vvaharness/backends/llm/models.py:523
    }

}

@executedBy(CODE) @role(config)
@src("vvaharness/config/profiles/default.yaml")
class LlmRegistryConfig {

    /** The per-role model routing table (profile layer; no builtin default). via changes what max_turns, budgets and tools mean. */
    ModelNode modelFor(String role, Theta θ) {
        switch (role) {
            case "autoexclude":   return new ModelNode(θ["models.autoexclude.id"], θ["models.autoexclude.via"], θ["models.autoexclude.provider"]);
            // S1 makes no model call
            case "preprocess":    return new ModelNode(θ["models.preprocess.id"], θ["models.preprocess.via"], θ["models.preprocess.provider"]);
            case "threatmodel":   return new ModelNode(θ["models.threatmodel.id"], θ["models.threatmodel.via"], θ["models.threatmodel.provider"]);
            // S3 makes no model call
            case "decompose":     return new ModelNode(θ["models.decompose.id"], θ["models.decompose.via"], θ["models.decompose.provider"]);
            // temperature dropped on the cli route
            case "deepdive":      return new ModelNode(θ["models.deepdive.id"], θ["models.deepdive.via"], θ["models.deepdive.provider"], θ["models.deepdive.temperature"]);
            case "verify":        return new ModelNode(θ["models.verify.id"], θ["models.verify.via"], θ["models.verify.provider"]);
            // only called when step7_dedup.semantic is true
            case "dedup":         return new ModelNode(θ["models.dedup.id"], θ["models.dedup.via"], θ["models.dedup.provider"]);
            case "chain":         return new ModelNode(θ["models.chain.id"], θ["models.chain.via"], θ["models.chain.provider"]);
            case "remediate":     return new ModelNode(θ["models.remediate.id"], θ["models.remediate.via"], θ["models.remediate.provider"]);
            case "validate.orchestrator":         return new ModelNode(θ["models.validate.orchestrator.id"], θ["models.validate.orchestrator.via"], θ["models.validate.orchestrator.provider"]);
            case "validate.security_architect":   return new ModelNode(θ["models.validate.security_architect.id"]);
            case "validate.penetration_tester":   return new ModelNode(θ["models.validate.penetration_tester.id"]);
            case "validate.cross_repo_analyzer":  return new ModelNode(θ["models.validate.cross_repo_analyzer.id"]);
            case "exploit_verification.attacker": return new ModelNode(θ["models.exploit_verification.attacker.id"], θ["models.exploit_verification.attacker.via"], θ["models.exploit_verification.attacker.provider"]);
            case "exploit_verification.judge":    return new ModelNode(θ["models.exploit_verification.judge.id"], θ["models.exploit_verification.judge.via"], θ["models.exploit_verification.judge.provider"]);
            case "exploit_verification.classify": return new ModelNode(θ["models.exploit_verification.classify.id"], θ["models.exploit_verification.classify.via"], θ["models.exploit_verification.classify.provider"]);
            case "exploit_verification.mapper":   return new ModelNode(θ["models.exploit_verification.mapper.id"], θ["models.exploit_verification.mapper.via"], θ["models.exploit_verification.mapper.provider"]);
        }
        return null;
    }

    /** Cache markers: pushed to sdk and openai unconditionally (cache_markers off suppresses them on cli/sdk/openai, not deepagents). */
    @src("vvaharness/orchestrator/preflight.py:106")
    void configureCache(Theta θ) {
        Object markers = θ["cache_markers"];                                                                // src: vvaharness/orchestrator/preflight.py:106
        Integer minBlock = θ["cache_min_block_tokens"];                                                     // null = published per-model minimums // src: vvaharness/orchestrator/preflight.py:107
        // auto detects the regime from the base_url host, failing closed to no markers
        String route = θ["cache_route"];                                                                    // src: vvaharness/orchestrator/preflight.py:109
        LlmSdk.configureCache(markers, minBlock, route);                                                    // src: vvaharness/orchestrator/preflight.py:110
        LlmOpenai.configureCache(markers);                                                                  // src: vvaharness/orchestrator/preflight.py:113
    }

    /** sdk: block -> Anthropic SDK and deepagents route credentials/TLS. */
    @src("vvaharness/orchestrator/preflight.py:115")
    void configureSdk(Path cfgDir, boolean sdkSole, Theta θ) {
        LlmSdk.configure(
            θ["sdk.api_key"],                                                                               // src: vvaharness/orchestrator/preflight.py:120
            θ["sdk.base_url"],                                                                              // src: vvaharness/orchestrator/preflight.py:121
            cfgDir.resolve(θ["sdk.verify_ssl"]),                                                            // a path form is anchored at the profile dir // src: vvaharness/orchestrator/preflight.py:122
            θ["sdk.ca_cert"],                                                                               // src: vvaharness/orchestrator/preflight.py:123
            θ["sdk.client_cert"],                                                                           // src: vvaharness/orchestrator/preflight.py:124
            sdkSole);                                                                                       // ANTHROPIC_API_KEY fallback allowed // src: vvaharness/orchestrator/preflight.py:126
    }

    /** openai: block -> OpenAI-compatible route credentials/TLS. */
    @src("vvaharness/orchestrator/preflight.py:128")
    void configureOpenai(Path cfgDir, Theta θ) {
        LlmOpenai.configure(
            θ["openai.api_key"],                                                                            // src: vvaharness/orchestrator/preflight.py:132
            θ["openai.base_url"],                                                                           // src: vvaharness/orchestrator/preflight.py:133
            cfgDir.resolve(θ["openai.verify_ssl"]),                                                         // src: vvaharness/orchestrator/preflight.py:134
            θ["openai.ca_cert"]);                                                                           // src: vvaharness/orchestrator/preflight.py:135
    }

    /** Graph plugins; the semgrep plugin adds 4 read-only tools to S2, S4 and S6. */
    @src("vvaharness/orchestrator/scan.py:585")
    PluginSet loadPluginSet(Config cfg, Theta θ) {
        return PluginSet.load(θ["sdk.plugins"]);                                                            // src: vvaharness/orchestrator/scan.py:585
    }

    /** Price table used to cost per-stage tokens; none bundled, so every cost_usd is null without it. */
    @src("vvaharness/orchestrator/scan.py:552")
    PriceTable pricingTable(Theta θ) {
        return Pricing.loadCached(θ["pricing.file"]);                                                       // src: vvaharness/orchestrator/scan.py:552
    }

    /** One WARN naming role models with no rate, only when pricing.file is set. */
    @src("vvaharness/orchestrator/entry.py:123")
    void pricingNote(Config cfg, Theta θ) {
        if (θ["pricing.file"] == null) return;                                                              // src: vvaharness/orchestrator/entry.py:126
    }
}
