// file: vulnhunter-fix/scripts/check-idempotency.py
// Gate 4, idempotency (REQ-GAT-005): every artifact body must carry the vulnfix-key marker;
// tracking-issue bodies also need the vulnfix-report-id marker.

@executedBy(CODE) @role(evaluation) @stage("fix")
class CheckIdempotency {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                     // src: vulnhunter-fix/scripts/check-idempotency.py:46
        // --kind in pr | issue | tracking, default pr
        return check(args, θ);                                                                           // src: vulnhunter-fix/scripts/check-idempotency.py:50
    }

    int check(Args args, Theta θ) {
        String text;
        try {
            text = Files.read(args.body);                                                                // src: vulnhunter-fix/scripts/check-idempotency.py:26
        } catch (OSError e) {
            return 2;                                                                                    // src: vulnhunter-fix/scripts/check-idempotency.py:29
        }
        List<String> errors = List.of();
        if (!Regex.search(θ["code.fix.scripts.check_idempotency.key_marker_regex"], text)) errors.add("missing vulnfix-key marker"); // src: vulnhunter-fix/scripts/check-idempotency.py:32
        if (args.kind == "tracking" && !Regex.search(θ["code.fix.scripts.check_idempotency.report_id_marker_regex"], text)) errors.add("tracking issue missing vulnfix-report-id marker"); // src: vulnhunter-fix/scripts/check-idempotency.py:35
        if (!errors.isEmpty()) return 1;                                                                 // src: vulnhunter-fix/scripts/check-idempotency.py:41
        return 0;
    }
}
