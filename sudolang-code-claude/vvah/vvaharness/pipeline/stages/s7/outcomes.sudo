# vvaharness/pipeline/stages/s7/outcomes.py

The Stage 7 output contract: one duplicate ruling per finding, and a parse that fails open (an unparseable reply keeps every finding).

Source: `vvaharness/pipeline/stages/s7/outcomes.py` (lines 1-95)
Executor: code (schema descriptions are model-facing instructions)
Called from: `vvaharness/pipeline/stages/s7/session.py` semantic_dedup

// src: vvaharness/pipeline/stages/s7/outcomes.py:32-52
// prompt-src: vvaharness/pipeline/stages/s7/outcomes.py:32-46 (field descriptions sent as the response schema)
DedupDecision {
  index: Number
  duplicate_of: Number
  reasoning: String
  independent_sites: Boolean = false   // an absent flag defaults false, the fail-safe (discard the member's site)
  Constraints {
    index: "Echo the FINDING index you were given, verbatim."
    duplicate_of: "The index of the finding this one duplicates — always LOWER than `index`, because the lowest index of a group is always the canonical one. Use -1 when this finding is not a duplicate of anything, which is the common answer."
    reasoning: "One sentence. For a duplicate, name the single fix that closes both; for a non-duplicate, name the fix this one needs that no other finding's fix covers."
    independent_sites: "For a duplicate: true when each finding in the group is an independently fixable defect at its own dangerous operation — fixing one site would not fix the others, so the member's location must survive on the survivor as an extra call site. False when one root-cause or control fix covers every member. Always false on a non-duplicate."
  }
  // src: outcomes.py:48-52 — code coerces any non-boolean independent_sites value to a boolean, so one bad value costs only that field
}

// src: vvaharness/pipeline/stages/s7/outcomes.py:55-58
// prompt-src: vvaharness/pipeline/stages/s7/outcomes.py:55-58
DedupDecisions {
  decisions: DedupDecision[]
  Constraints {
    decisions: "ONE entry per FINDING index you were given, in ascending order. An index you omit is kept as its own separate finding — safe, but it means nobody ruled on it, so judge every one."
  }
}

// src: vvaharness/pipeline/stages/s7/outcomes.py:73-95
fn parse_decisions(raw, n, label="s7-dedup"):executor=code {
  // src: outcomes.py:61-70 — strict JSON first, then JSON extracted from surrounding prose
  parsed = try DedupDecisions from raw; catch => try DedupDecisions from extract_json(raw); catch => null
  if (parsed == null) {
    if (raw is not blank) {
      COUNTERS.bump("s7_dedup_parse_miss")   // so the miss does not read as "no duplicates"
      head = first 500 characters of redact(raw), newlines escaped   // redact before the cut, or slicing bisects a credential
      warn S7_DEDUP_UNPARSEABLE
      errlog.log(label, "semantic-parse", "reply did not parse as dedup decisions (n=$n)", raw_head=head)
    }
    return []   // keeps every finding
  }
  out = []
  for each d in parsed.decisions {
    // src: outcomes.py:88-91 — the "always LOWER" and range rules are checked by code
    require 0 <= d.duplicate_of && d.duplicate_of < d.index && d.index < n => skip this decision
    append [d.index, d.duplicate_of, trimmed d.reasoning, d.independent_sites] to out
  }
  absent = n - length(parsed.decisions)
  if (absent > 0) COUNTERS.bump("s7_dedup_index_omitted", absent)
  // preserved: repeated indices are not detected; "absent" is a count difference, not a set difference
  return out
}
