// file: vulnhunter-agent/agent/verify_extract.py
// Verify-mode inputs from a GitHub issue: the three machine markers (from the reconstructed original body),
// the post-close developer narrative, and the comments.md file handed to /vulnhunt-fix-verify (untrusted-wrapped).

@executedBy(CODE) @role(io) @stage("verify")
class VerifyExtract {

    // _neutralize_markers: replace the magic substring in user text so it cannot forge BEGIN/END markers.
    String neutralizeMarkers(String text) {
        return text.replace("vulnhunt-fix-verify", θ["code.agent.verify_extract.user_quoted_token"]); // src: vulnhunter-agent/agent/verify_extract.py:70
    }

    // extract_markers: all three markers required; results-dir constrained against path traversal.
    VerifyMarkers extractMarkers(String body, String sourceLabel) {
        List<Regex> patterns = θ["code.agent.verify_extract.marker_patterns"];                   // src: vulnhunter-agent/agent/verify_extract.py:77
        Match mKey = patterns.get(0).search(body);                                                // src: vulnhunter-agent/agent/verify_extract.py:117
        Match mId = patterns.get(1).search(body);                                                 // src: vulnhunter-agent/agent/verify_extract.py:118
        Match mDir = patterns.get(2).search(body);                                                // src: vulnhunter-agent/agent/verify_extract.py:119
        List<String> missing = new List();
        if (mKey == null) missing.add("vulnfix-key");                                             // src: vulnhunter-agent/agent/verify_extract.py:121
        if (mId == null) missing.add("vulnhunt-finding-id");                                      // src: vulnhunter-agent/agent/verify_extract.py:123
        if (mDir == null) missing.add("vulnhunt-results-dir");                                    // src: vulnhunter-agent/agent/verify_extract.py:125
        if (!missing.isEmpty()) throw new MarkerExtractionError(sourceLabel + ": missing required marker(s)"); // src: vulnhunter-agent/agent/verify_extract.py:127
        String resultsDir = mDir.group(1);                                                        // src: vulnhunter-agent/agent/verify_extract.py:133
        if (θ["code.agent.verify_extract.results_dir_forbidden_tokens"].any(tok -> resultsDir.contains(tok))) // src: vulnhunter-agent/agent/verify_extract.py:136
            throw new MarkerExtractionError(sourceLabel + ": vulnhunt-results-dir contains a forbidden path token"); // src: vulnhunter-agent/agent/verify_extract.py:137
        return new VerifyMarkers(mKey.group(1).lower(), mId.group(1).upper(), resultsDir);     // src: vulnhunter-agent/agent/verify_extract.py:141
    }

    // _parse_iso: trailing Z -> +00:00; null on failure.
    DateTime parseIso(String timestamp) {
        if (timestamp == "") return null;                                                         // src: vulnhunter-agent/agent/verify_extract.py:173
        try {
            return DateTime.fromIsoformat(timestamp.replace("Z", "+00:00"));                      // src: vulnhunter-agent/agent/verify_extract.py:176
        } catch (ValueError e) {
            return null;                                                                          // src: vulnhunter-agent/agent/verify_extract.py:178
        }
    }

    // _latest_close_timestamp: newest "closed" event, else issue.closed_at.
    String latestCloseTimestamp(FetchedIssue issue, List<IssueEvent> events) {
        List<IssueEvent> closes = events.filter(ev -> ev.event == "closed" && ev.createdAt != ""); // src: vulnhunter-agent/agent/verify_extract.py:188
        if (!closes.isEmpty()) return closes.maxBy(ev -> ev.createdAt).createdAt;                 // src: vulnhunter-agent/agent/verify_extract.py:189
        return issue.closedAt;                                                                    // src: vulnhunter-agent/agent/verify_extract.py:191
    }

    // build_narrative: comments at/after the latest close, chronological; pre-close dialogue excluded.
    IssueNarrative buildNarrative(FetchedIssue issue, List<IssueComment> comments, List<IssueEvent> events, String findingId) {
        DateTime closeTs = parseIso(latestCloseTimestamp(issue, events));                         // src: vulnhunter-agent/agent/verify_extract.py:211
        List<String> sections = new List();
        for (IssueComment comment : comments.sortedBy(c -> c.createdAt)) {                        // src: vulnhunter-agent/agent/verify_extract.py:215
            DateTime commentTs = parseIso(comment.createdAt);                                     // src: vulnhunter-agent/agent/verify_extract.py:217
            if (θ["code.agent.verify_extract.narrative_window"] == "at_or_after_latest_close"
                    && closeTs != null && commentTs != null && commentTs < closeTs) continue;     // src: vulnhunter-agent/agent/verify_extract.py:218
            // no timestamps to compare -> keep (over-inclusion preferred)
            String body = neutralizeMarkers(comment.body.strip());                                // src: vulnhunter-agent/agent/verify_extract.py:222
            if (body == "") continue;                                                             // src: vulnhunter-agent/agent/verify_extract.py:223
            String author = neutralizeMarkers(orElse(comment.author, "(unknown)"));               // src: vulnhunter-agent/agent/verify_extract.py:228
            String tsLabel = orElse(comment.createdAt, "(no timestamp)");                         // src: vulnhunter-agent/agent/verify_extract.py:229
            sections.add("### Comment from @" + author + " (" + tsLabel + ") " + body);           // src: vulnhunter-agent/agent/verify_extract.py:230
        }
        return new IssueNarrative(issue.number, findingId, sections);                             // src: vulnhunter-agent/agent/verify_extract.py:233
    }

    // render_comments_file: see CommentsFilePrompt (the file is read by the verify skill).
    String renderCommentsFile(List<IssueNarrative> narratives, List<String> ignoredHints) {
        return CommentsFilePrompt.run(narratives, ignoredHints).render();                         // src: vulnhunter-agent/agent/verify_extract.py:243
    }

    void writeCommentsFile(Path path, List<IssueNarrative> narratives, List<String> ignoredHints) {
        path.writeText(renderCommentsFile(narratives, ignoredHints));                             // src: vulnhunter-agent/agent/verify_extract.py:339
    }
}

// comments.md as the /vulnhunt-fix-verify model receives it: trusted index, untrusted narrative block, optional R6 annotations.
@executedBy(MODEL) @role(prompt) @stage("verify")
class CommentsFilePrompt {

    Prompt run(List<IssueNarrative> narratives, List<String> ignoredHints) {
        Prompt p = new Prompt();
        p.include(header(narratives));
        p.include(untrustedBlock(narratives));
        if (!ignoredHints.isEmpty()) p.include(annotations(ignoredHints));                       // src: vulnhunter-agent/agent/verify_extract.py:305
        return p;
    }

    Prompt header(List<IssueNarrative> narratives) {
        Prompt p = new Prompt();
        p.context("# Developer narrative for this verify run");                                   // src: vulnhunter-agent/agent/verify_extract.py:264
        if (!narratives.isEmpty()) p.context("Each section below is one issue's fix story; headings identify the VULN-NNN and issue number"); // src: vulnhunter-agent/agent/verify_extract.py:267
        else p.context("(No issues in this run produced any closure narrative.)");               // src: vulnhunter-agent/agent/verify_extract.py:274
        return p;
    }

    Prompt untrustedBlock(List<IssueNarrative> narratives) {
        Prompt p = new Prompt();
        List<String> delims = θ["code.agent.verify_extract.untrusted_delimiters"];                // src: vulnhunter-agent/agent/verify_extract.py:34
        p.format(delims.get(0));                                                                  // src: vulnhunter-agent/agent/verify_extract.py:278
        p.rule(θ["code.agent.verify_extract.untrusted_preamble"]);                                // src: vulnhunter-agent/agent/verify_extract.py:280
        if (narratives.isEmpty()) p.context("(No fix narrative provided by the developer.)");     // src: vulnhunter-agent/agent/verify_extract.py:291
        for (IssueNarrative n : narratives) {                                                     // src: vulnhunter-agent/agent/verify_extract.py:292
            p.context("## " + n.findingId + " — issue #" + n.issueNumber);                       // src: vulnhunter-agent/agent/verify_extract.py:295
            if (!n.sections.isEmpty()) for (String s : n.sections) p.context(s);                  // src: vulnhunter-agent/agent/verify_extract.py:299
            else p.context("(No fix narrative provided by the developer.)");                      // src: vulnhunter-agent/agent/verify_extract.py:302
        }
        p.format(delims.get(1));                                                                  // src: vulnhunter-agent/agent/verify_extract.py:304
        return p;
    }

    // R6 block: hints the agent could not resolve to clonable URLs.
    Prompt annotations(List<String> ignoredHints) {
        Prompt p = new Prompt();
        p.format("/vulnhunt-fix-verify agent annotations");                                       // src: vulnhunter-agent/agent/verify_extract.py:310
        p.rule(θ["code.agent.verify_extract.r6_unresolved_hint_rule"]);                           // src: vulnhunter-agent/agent/verify_extract.py:315
        for (String hint : ignoredHints.toSet().sorted()) p.context("- " + hint);                 // src: vulnhunter-agent/agent/verify_extract.py:323
        return p;
    }
}

// source dataclass name: ExtractedMarkers (frozen): vulnfix key is 16 lowercase hex; finding id is VULN-NNN; results dir is a basename matching the _VULNHUNT_RESULTS_ pattern
@executedBy(CODE) @role(types)
record VerifyMarkers(String vulnfixKey, String findingId, String resultsDir) { }

@executedBy(CODE) @role(types)
record IssueNarrative(int issueNumber, String findingId, List<String> sections) { }

@executedBy(CODE) @role(types)
class MarkerExtractionError extends ValueError { }
