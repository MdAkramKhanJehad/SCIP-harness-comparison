                Integer cap = Retry.truncationCap(result);                                                  // src: vvaharness/backends/llm/cli/session.py:511
                if (cap == null) throw new RuntimeError(Discovery.formatCliError("claude CLI agentic failed", attemptCmd, result)); // src: vvaharness/backends/llm/cli/session.py:513
                int requested = truncRetried != 0 ? truncRetried : (maxTokens != null && maxTokens != 0 ? maxTokens : cap); // src: vvaharness/backends/llm/cli/session.py:516
                Integer retryAt = truncRetried != 0 ? null : LlmModels.truncationRetryMax(requested, DeepagentsLimits.MODEL_MAX_OUTPUT_TOKENS); // one truncation retry only // src: vvaharness/backends/llm/cli/session.py:517
                if (retryAt != null) {
                    Retry.logTruncationRetry(tag, requested, retryAt, "cli");                               // src: vvaharness/backends/llm/cli/session.py:520
                    env = new Map(env);
                    env.put("CLAUDE_CODE_MAX_OUTPUT_TOKENS", String.valueOf(retryAt));                      // src: vvaharness/backends/llm/cli/session.py:523
                    truncRetried = retryAt;                                                                 // src: vvaharness/backends/llm/cli/session.py:524
                    continue;
                }
                throw Retry.truncationError(requested, truncRetried, tag, retryAt);                         // src: vvaharness/backends/llm/cli/session.py:526
            }
            // no stitching here, deliberately: it would concatenate the whole transcript into result
            EnvelopeResult parsed = Envelope.parse(result.stdout, false, null);                             // src: vvaharness/backends/llm/cli/session.py:531
            Envelope.noteUnparsedCacheKeys(parsed.usage);                                                   // src: vvaharness/backends/llm/cli/session.py:532
            TokenCounter.add(parsed.usage, parsed.usd, parsed.turns);                                       // src: vvaharness/backends/llm/cli/session.py:533
            Retry.logUsage(parsed.usage, parsed.stopReason, parsed.modelUsage);                             // src: vvaharness/backends/llm/cli/session.py:534
            Envelope.raiseIfRefused(parsed.stopReason, tag, result.stdout);                                 // src: vvaharness/backends/llm/cli/session.py:535
            if (!Retry.isPendingResult(parsed.text)) {
                return Retry.acceptReply(parsed.text, truncRetried);                                        // counted here, not at the parse: a pending-output resend keeps truncRetried set // src: vvaharness/backends/llm/cli/session.py:539
            }
            pendingAttempt += 1;                                                                            // src: vvaharness/backends/llm/cli/session.py:541
            if (pendingAttempt > θ["code.backends.llm.cli.retry.pending_max_retries"]) {                    // src: vvaharness/backends/llm/cli/session.py:543
                throw new RuntimeError("claude CLI agentic returned an unfinished background-subagent state; refusing to continue with partial output"); // src: vvaharness/backends/llm/cli/session.py:544
            }
            List<Integer> backoff = θ["code.backends.llm.cli.retry.pending_backoff_s"];
            int wait = backoff.get(Math.min(pendingAttempt - 1, backoff.size() - 1));                       // last entry repeats // src: vvaharness/backends/llm/cli/session.py:549
            Console.write("agentic returned pending output; retrying");                                     // src: vvaharness/backends/llm/cli/session.py:551
            int slept = 0;                                                                                  // sleep in slices so Ctrl-C is honoured // src: vvaharness/backends/llm/cli/session.py:555
            while (slept < wait) {                                                                          // src: vvaharness/backends/llm/cli/session.py:556
                if (Cancel.aborted()) throw new RuntimeError("aborted by user (Ctrl-C)");                   // src: vvaharness/backends/llm/cli/session.py:557
                int step = Math.min(θ["code.backends.llm.cli.session.pending_sleep_slice_s"], wait - slept); // src: vvaharness/backends/llm/cli/session.py:559
                Thread.sleep(step);                                                                         // src: vvaharness/backends/llm/cli/session.py:560
                slept += step;                                                                              // src: vvaharness/backends/llm/cli/session.py:561
            }
        }
    }

    /** Watchdog: stop the run once assistant events (or message ids) reach max_turns, then resume for a final answer. */
    @src("vvaharness/backends/llm/cli/session.py:96")
    boolean turnWatchdog(String line, int cap, boolean byMessage) {
        return new TurnWatchdog(cap, byMessage).call(line);                                                 // src: vvaharness/backends/llm/cli/session.py:126
    }
}

/** Cap an agentic loop by counting assistant turns, for a binary without --max-turns. */
@executedBy(CODE) @role(backend)
@src("vvaharness/backends/llm/cli/session.py:96")
class TurnWatchdog {
    // armed only when the CLI rejects --max-turns or the capability probe fails; counting every assistant event
    // over-counts on purpose (safe side); a zero-tool session counts by message.id so the cap still grants that many full turns
    int cap;
    boolean byMessage;
    int seen = 0;
    boolean tripped = false;
    int tripAt;                                                                                             // cap + 1 when byMessage, else cap // src: vvaharness/backends/llm/cli/session.py:107
    Set<String> ids = new Set();

    /** Whether the event counts: every event, or only a new message.id when byMessage. */
    @src("vvaharness/backends/llm/cli/session.py:110")
    boolean counts(Map evt) {
        Object msg = evt.get("message");                                                                    // src: vvaharness/backends/llm/cli/session.py:112
        Object msgId = (byMessage && msg instanceof Map) ? msg.get("id") : null;                            // src: vvaharness/backends/llm/cli/session.py:113
        if (!(msgId instanceof String)) return true;                                                        // no id: counts // src: vvaharness/backends/llm/cli/session.py:114
        if (ids.contains(msgId)) return false;                                                              // src: vvaharness/backends/llm/cli/session.py:116
        ids.add(msgId);                                                                                     // src: vvaharness/backends/llm/cli/session.py:118
        return true;
    }

    /** The count that tripped, in the unit and comparison this watchdog uses. */
    @src("vvaharness/backends/llm/cli/session.py:121")
    String describe() {
        // by message: unit messages with ">" ; by event: unit events with ">="
        return seen + " assistant " + (byMessage ? "messages >" : "events >=") + " max_turns=" + cap;       // src: vvaharness/backends/llm/cli/session.py:123
    }

    /** Consume one stdout line; True when the cap is reached and the run must stop. */
    @src("vvaharness/backends/llm/cli/session.py:126")
    boolean call(String line) {
        if (tripped) return false;                                                                          // src: vvaharness/backends/llm/cli/session.py:128
        Object evt;
        try {
            evt = Json.loads(line);                                                                         // src: vvaharness/backends/llm/cli/session.py:131
        } catch (JsonError | TypeError e) {
            return false;                                                                                   // src: vvaharness/backends/llm/cli/session.py:133
        }
        if (!(evt instanceof Map) || !"assistant".equals(evt.get("type")) || !counts(evt)) return false;    // src: vvaharness/backends/llm/cli/session.py:134
        seen += 1;                                                                                          // src: vvaharness/backends/llm/cli/session.py:136
        if (seen >= tripAt) {
            tripped = true;                                                                                 // src: vvaharness/backends/llm/cli/session.py:138
            return true;
        }
        return false;
    }
}

@executedBy(MODEL) @role(prompt)
@src("vvaharness/backends/llm/cli/session.py:145")
class CliFinalAnswerPrompt {

    Prompt finalAnswer(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.session.turn_limit_final_answer"]);                                                     // "Your turn limit was reached. Give your final answer now" // src: vvaharness/backends/llm/cli/session.py:146
        p.format(θ["p.session.final_answer_original_format"]);                                              // "in the exact format the original instructions asked for, using only what you already have." // src: vvaharness/backends/llm/cli/session.py:147
        p.forbid(θ["p.session.final_answer_no_tools"]);                                                     // "Do not use any tool." // src: vvaharness/backends/llm/cli/session.py:148
        return p;
    }
}
