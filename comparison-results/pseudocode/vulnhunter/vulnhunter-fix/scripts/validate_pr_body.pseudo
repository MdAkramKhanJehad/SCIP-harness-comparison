// file: vulnhunter-fix/scripts/validate_pr_body.py
// PR body must close exactly the expected issue set. Only repeated close keywords are recognized by the actual regex.
// A bare second number in 'Closes #1, #2' is not recognized, despite the help text claiming both forms count.

@executedBy(CODE) @role(tool) @stage("fix")
class ValidatePrBody {
    @src("vulnhunter-fix/scripts/validate_pr_body.py:50")
    Set<Integer> extractCloses(String body, Theta θ) {
        return Regex.compile(θ["code.fix.scripts.validate_pr_body.close_keyword_re"], IGNORECASE).finditer(body).map(m -> toInt(m.group(1))).toSet(); // src: vulnhunter-fix/scripts/validate_pr_body.py:45
    }
    @src("vulnhunter-fix/scripts/validate_pr_body.py:55")
    Pair<Boolean, String> validate(String body, Set expected, Theta θ) {
        Set found = extractCloses(body, θ); Set missing = expected.minus(found); Set extra = found.minus(expected);
        if (missing.isEmpty() && extra.isEmpty()) return new Pair(true, "all expected issues closed");
        return new Pair(false, "missing=" + sorted(missing) + "; unexpected=" + sorted(extra));
    }
    @src("vulnhunter-fix/scripts/validate_pr_body.py:84")
    Set<Integer> parseIssueList(String arg) {
        Set out = new Set();
        for (String raw : arg.split(",")) {
            String token = raw.strip().lstrip("#"); if (token.isEmpty()) continue;
            if (!token.isdigit()) throw new ArgumentTypeError("not a number");
            out.add(toInt(token));
        }
        return out;
    }
    @src("vulnhunter-fix/scripts/validate_pr_body.py:96")
    int mainWithArgv(List<String> argv, Theta θ) {
        Object args = parseArgs(argv, required=List.of("body_path", "--expected-issues"), issueParser=this::parseIssueList);
        String body;
        try { body = args.bodyPath.readText(); } catch (FileNotFoundError e) { printError(e); return 1; }
        Pair result = validate(body, args.expectedIssues, θ); if (result.first) { print(result.second); return 0; }
        printError(result.second); printError("fix PR close references before delivery"); return 1;
    }
    @src("vulnhunter-fix/scripts/validate_pr_body.py:126")
    int main(Theta θ) {
        return mainWithArgv(processArgsWithoutProgram(), θ);
    }
}
