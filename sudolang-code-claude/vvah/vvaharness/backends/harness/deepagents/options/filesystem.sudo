# vvaharness/backends/harness/deepagents/options/filesystem.py

Filesystem permissions, backend selection and skill-source resolution for deepagents sessions. Detection sessions that opt into the tool gate get a backend whose reads are confined to the Stage 1 scan scope and whose writes fail closed; one-shot parsers get a backend that refuses all writes; the frozen Stage 10 and Stage 11 streaming sessions get the stock backend with only `.git` writes refused. Every virtual-mode backend refuses paths that escape the root.

Source: `vvaharness/backends/harness/deepagents/options/filesystem.py` (lines 1-346)
Executor: code
Called from: `oneshot.sudo` and `streaming.sudo` (_filesystem_permissions, _session_backend, _skill_sources); `subagents.sudo` (_skill_sources); `vvaharness/pipeline/stages/s6_verify.py` (patched_read_timeouts)

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:56-68
fn _filesystem_permissions(options):executor=code {
  if (options.allow_writes) {
    root = resolved options.cwd
    for each raw in options.writable_paths {
      require resolved raw == root || root is an ancestor of resolved raw => throw ValueError("writable path escapes harness cwd: $raw")
    }
    return GIT_INTERNALS_DENY   // writes denied only under every letter-case spelling of ".git" (deepagents/models.py:116-125)
  }
  return READ_ONLY_PERMISSIONS   // write denied on "/**", "/.*", "/.*/**", "/**/.*", "/**/.*/**" (deepagents/models.py:108-116)
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:290-303
fn _session_backend(options):executor=code {
  _filesystem_permissions(options)   // called for its escape check only
  if (options.permitted_tool_calls != null) return _scoped_backend(options)   // keyed off the same field as the PermitTools gate
  if (options is OneShotOptions) return _NoWriteBackend(root_dir=options.cwd, virtual_mode=true)
  return _StockReadBackend(root_dir=options.cwd, virtual_mode=true)   // frozen Stage 10 / Stage 11 streaming
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:242-246, 235-239
fn _scoped_backend(options):executor=code {
  if (options.allow_shell) {
    shell = _ShellScopedReadBackend(root_dir=options.cwd, virtual_mode=true, inherit_env=false)   // scoped reads plus execute
    return CompositeBackend(default=shell, routes={ "/": shell })   // a non-empty route map is the only way execute is reachable  // external: deepagents.backends
  }
  return _ScopedReadBackend(root_dir=options.cwd, virtual_mode=true)
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:53, 115-134
_JAIL_ERROR = "ERROR: path '{path}' is outside the scan root; use a repo-relative path"
fn _PathJail._resolve_path(key):executor=code {
  if (!virtual_mode) return stock resolution   // external: deepagents FilesystemBackend
  vpath = key prefixed with "/" when missing
  require ".." not in parts of vpath && key does not start with "~" => { COUNTERS.bump("deepagents_path_jail_refused"); throw PermissionError(_JAIL_ERROR) }
  full = resolve(cwd + vpath)
  require full is inside cwd => { COUNTERS.bump("deepagents_path_jail_refused"); throw PermissionError(_JAIL_ERROR) }
  refuse a symlink loop   // external: deepagents _raise_if_symlink_loop
  return full
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:84, 87-112
_WRITE_REFUSED = "write operations are disabled on detection sessions: {path}"
_NoWriteBackend {
  // write, edit, delete and upload_files return an error result with _WRITE_REFUSED and touch no disk (also covers middleware writes such as eviction or offload)
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:137-218
_ScopedReadBackend {
  // = _PathJail + _NoWriteBackend; reads confined to the registered Stage 1 inventory for this root
  fn _scope():executor=code { return backends.llm.tools._scope_for(cwd) }   // null before Stage 1 has registered a scope

  fn read(file_path, offset=0, limit=2000):executor=code {
    rel = repository-relative path of file_path, or null if it cannot resolve
    // scope check comes BEFORE the existence check, so it is never an existence oracle
    require !(rel != null && rel != "." && backends.llm.tools._excluded_rel(rel, _scope())) => return error backends.llm.tools._SCOPE_ERROR
    return stock read(file_path, offset, limit)
  }
  fn grep(pattern, path?, glob?, max_count?, context_lines=0):executor=code {
    if (path != null) {
      rel = relative path of path
      require !(rel != null && rel != "." && rel is a file && _excluded_rel(rel, scope)) => return error _SCOPE_ERROR with no matches   // only a named excluded FILE is refused; directories fall through
    }
    result = stock grep(...)
    result.matches = matches whose path is not _excluded_rel
    return result
  }
  fn glob(pattern, path?):executor=code { result = stock glob; drop matches that are _excluded_rel; return result }
  fn ls(path):executor=code {
    result = stock ls; drop entries where (file: _excluded_rel) or (directory: _dir_excluded); return result
  }
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:221-228, 71-80
fn _dir_excluded(rel, scope):executor=code {
  if (any path part, lowercased, is in backends.llm.tools._ALWAYS_EXCLUDED_DIRS) return true
  if (backends.llm.tools._always_allowed(rel + "/")) return false   // keeps .vvaharness/skills visible, which post-dates the Stage 1 walk
  return rel != "" && scope != null && rel not in _in_scope_dirs(scope)   // _in_scope_dirs: every ancestor directory of an in-scope file (cached, 8 entries)
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:250-287
_GIT_WRITE_REFUSED = "writes into version-control metadata (.git) are refused: {path}"
_StockReadBackend {
  // = _PathJail + stock FilesystemBackend: full stock read reach and write access
  // write, edit, delete: require !is_git_metadata(file_path) => return error _GIT_WRITE_REFUSED
  // upload_files: files under git metadata get _GIT_WRITE_REFUSED; the rest are uploaded, results kept in input order
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:306-334
fn patched_read_timeouts(seconds):executor=code {
  // Temporarily replaces deepagents' hardcoded 5-second glob and 15-second grep timeouts (module globals; not safe to nest with a different value)
  if (seconds == null) { run the wrapped block; return }
  set glob timeout = seconds; grep timeout = int(seconds); async grep timeout = 2 * int(seconds) + 5; python search default timeout = int(seconds)
  run the wrapped block
  constraint OnEveryExit { restore the four original values }
}

// src: vvaharness/backends/harness/deepagents/options/filesystem.py:337-346
fn _skill_sources(skill_root, cwd):executor=code {
  if (skill_root == null || skill_root is not a directory) return []
  require resolved skill_root is under resolved cwd => throw ValueError("skill_root $root must live under the session cwd $base")
  relative = skill_root relative to cwd
  return [if (relative != ".") "/$relative" else "/"]
}
