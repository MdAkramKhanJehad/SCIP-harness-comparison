// file: vulnhunter-agent/agent/issues.py
// Issues stage: extract -> ensure labels -> fetch open issues -> dedup -> post one issue per new finding.
// Per-issue failures are recorded, not fatal. Zero findings -> clean-scan receipt issue (posted then closed).

@executedBy(CODE) @role(types) @stage("issues")
record IssuesStageError(String message) { }

@executedBy(CODE) @role(types) @stage("issues")
record IssuePostError(String message) { }

@executedBy(CODE) @role(types) @stage("issues")
record PostedIssue(String findingId, String title, String url) { }

@executedBy(CODE) @role(types) @stage("issues")
record SkippedIssue(String findingId, List<Integer> matchedIssueNumbers, String via) { }   // via: "key" | "semantic"

@executedBy(CODE) @role(types) @stage("issues")
record FailedIssue(String findingId, String title, String error) { }

// mode: created | appended | close_back_failed | skipped; state: CLOSED | OPEN | ""
@executedBy(CODE) @role(types) @stage("issues")
record CleanScanOutcome(String url, String mode, String state, String note) { }

@executedBy(CODE) @role(types) @stage("issues")
record PostSummary(List<PostedIssue> posted, List<SkippedIssue> skipped, List<FailedIssue> failed, String note, CostStats cost, CleanScanOutcome cleanScan) { }   // anyFailed = !failed.isEmpty()

@executedBy(CODE) @role(step) @stage("issues")
class Issues {

    boolean isRetryable(int statusCode) {
        return statusCode == 429 || statusCode >= 500;                                              // src: vulnhunter-agent/agent/issues.py:55
    }

    Map githubDefaultHeaders() {
        return Map.of("Accept", "application/vnd.github+json", "X-GitHub-Api-Version", "2022-11-28"); // Authorization added per request by BrokerTokenAuth // src: vulnhunter-agent/agent/issues.py:62
    }

    // ---- entry point
    PostSummary postIssues(Path resultsDir, String reportUrl, String targetRepoUrl, Theta θ, TokenManager tokenManager, AuditWriter auditWriter, String auditReportId, String auditRepoSlug, RepoProperties auditRepoProperties, ExtractedReport extracted, String commitSha) {
        PostSummary summary = new PostSummary();
        Object verify = Auth.resolveVerify(θ);                                                      // src: vulnhunter-agent/agent/issues.py:883
        if (extracted == null) extracted = IssuesExtract.extractFindings(resultsDir, θ, tokenManager, summary.cost, auditWriter); // src: vulnhunter-agent/agent/issues.py:886
        if (extracted.findings.isEmpty()) {                                                         // src: vulnhunter-agent/agent/issues.py:890
            summary.note = "no confirmed findings in report";
            if (θ["issues.notify_clean_scan"]) {                                                    // src: vulnhunter-agent/agent/issues.py:892
                summary.cleanScan = postCleanScanNotice(resultsDir, reportUrl, targetRepoUrl, θ, commitSha, auditWriter, auditReportId, auditRepoSlug); // src: vulnhunter-agent/agent/issues.py:893
            }
            return summary;                                                                         // src: vulnhunter-agent/agent/issues.py:908
        }
        ensureAllLabels(targetRepoUrl, θ, verify);                                                  // IssuesStageError aborts the stage // src: vulnhunter-agent/agent/issues.py:910
        List<OpenIssue> openIssues = IssuesFetch.fetchOpenIssuesWithLabel(targetRepoUrl, θ["code.agent.issues.dedup_label"], θ["code.agent.config_example.logging_retries"]); // dedup pool // src: vulnhunter-agent/agent/issues.py:914
        List<DedupDecision> decisions = IssuesDedup.dedup(extracted.findings, openIssues, θ, tokenManager, summary.cost, auditWriter); // src: vulnhunter-agent/agent/issues.py:920
        Map<String, DedupDecision> duplicateMap = decisions.filter(d -> !d.matchedIssues.isEmpty()).toMap(d -> d.findingId); // src: vulnhunter-agent/agent/issues.py:928
        String[] ownerName = Github.parseOwnerRepo(targetRepoUrl);                                  // src: vulnhunter-agent/agent/issues.py:932
        String api = Github.apiBase(θ["github.*"].host);                                            // src: vulnhunter-agent/agent/issues.py:933
        HttpClient client = new HttpClient(verify, θ["issues.request_timeout_seconds"], githubDefaultHeaders(), new BrokerTokenAuth("scan")); // src: vulnhunter-agent/agent/issues.py:936
        for (Finding f : extracted.findings) {                                                      // src: vulnhunter-agent/agent/issues.py:942
            if (duplicateMap.containsKey(f.id)) {                                                   // src: vulnhunter-agent/agent/issues.py:943
                DedupDecision d = duplicateMap.get(f.id);
                summary.skipped.add(new SkippedIssue(f.id, d.matchedIssues, d.via));                // src: vulnhunter-agent/agent/issues.py:945
                continue;
            }
            String title = IssuesRender.renderTitle(f);                                             // src: vulnhunter-agent/agent/issues.py:960
            String body = IssuesRender.renderBody(f, extracted, reportUrl);                         // src: vulnhunter-agent/agent/issues.py:961
            try {
                String url = createIssue(client, api, ownerName[0], ownerName[1], title, body, θ["issues.labels"], θ); // src: vulnhunter-agent/agent/issues.py:967
                summary.posted.add(new PostedIssue(f.id, title, url));                              // src: vulnhunter-agent/agent/issues.py:977
                emitFindingOpened(auditWriter, θ, f, url, resultsDir, auditReportId, auditRepoSlug, auditRepoProperties); // src: vulnhunter-agent/agent/issues.py:981
            } catch (IssuePostError exc) {
                summary.failed.add(new FailedIssue(f.id, title, exc.message));                      // continue past per-issue failures // src: vulnhunter-agent/agent/issues.py:992
            }
        }
        return summary;                                                                             // src: vulnhunter-agent/agent/issues.py:997
    }

    // ---- labels
    void ensureAllLabels(String targetRepoUrl, Theta θ, Object verify) {
        if (TokenClient.getGithubToken("scan", θ["github.*"]) == "") throw new IssuesStageError("scan_token is required to ensure labels and post issues."); // src: vulnhunter-agent/agent/issues.py:290
        String[] ownerName = Github.parseOwnerRepo(targetRepoUrl);                                  // src: vulnhunter-agent/agent/issues.py:294
        String api = Github.apiBase(θ["github.*"].host);
        HttpClient client = new HttpClient(verify, θ["issues.request_timeout_seconds"], githubDefaultHeaders(), new BrokerTokenAuth("scan")); // src: vulnhunter-agent/agent/issues.py:297
        for (String label : θ["issues.labels"]) ensureLabel(client, api, ownerName[0], ownerName[1], label, "VulnHunter scan finding", null); // src: vulnhunter-agent/agent/issues.py:303
    }

    // _ensure_label: create only if missing; existing labels left untouched; 422 re-checked as a concurrent create.
    void ensureLabel(HttpClient client, String api, String owner, String name, String label, String description, String color) {
        String encoded = urlQuote(label);                                                           // src: vulnhunter-agent/agent/issues.py:240
        Response get = client.get(api + "/repos/" + owner + "/" + name + "/labels/" + encoded);     // src: vulnhunter-agent/agent/issues.py:241
        if (get.statusCode == 200) return;                                                          // src: vulnhunter-agent/agent/issues.py:242
        if (get.statusCode != 404) throw new IssuesStageError("checking label failed");             // src: vulnhunter-agent/agent/issues.py:244
        String resolvedColor = (color != null) ? color : Map.of("security", "d73a4a", "vulnhunter", "5319e7").getOrDefault(label, "ededed"); // cosmetic // src: vulnhunter-agent/agent/issues.py:249
        Response post = client.post(api + "/repos/" + owner + "/" + name + "/labels", Map.of("name", label, "color", resolvedColor, "description", description)); // src: vulnhunter-agent/agent/issues.py:255
        if (post.statusCode == 200 || post.statusCode == 201) return;                               // src: vulnhunter-agent/agent/issues.py:258
        if (post.statusCode == 422) {                                                               // src: vulnhunter-agent/agent/issues.py:266
            Response recheck = client.get(api + "/repos/" + owner + "/" + name + "/labels/" + encoded); // src: vulnhunter-agent/agent/issues.py:267
            if (recheck.statusCode == 200) return;                                                  // created concurrently // src: vulnhunter-agent/agent/issues.py:270
        }
        throw new IssuesStageError("creating label failed");                                        // src: vulnhunter-agent/agent/issues.py:278
    }

    // ---- GitHub mutations, each with one transient retry (attempts = 2, fixed backoff)
    String createIssue(HttpClient client, String api, String owner, String name, String title, String body, List<String> labels, Theta θ) {
        int lastStatus = 0;
        for (int attempt = 0; attempt < θ["code.agent.issues.post_attempts"]; attempt++) {          // src: vulnhunter-agent/agent/issues.py:334
            Response resp = client.post(api + "/repos/" + owner + "/" + name + "/issues", Map.of("title", title, "body", body, "labels", labels)); // src: vulnhunter-agent/agent/issues.py:335
            if (resp.statusCode == 201) {                                                           // src: vulnhunter-agent/agent/issues.py:338
                String htmlUrl = resp.json().html_url;
                if (htmlUrl == null || htmlUrl == "") throw new IssuePostError("GitHub returned 201 but no html_url"); // src: vulnhunter-agent/agent/issues.py:340
                return htmlUrl;                                                                     // src: vulnhunter-agent/agent/issues.py:344
            }
            lastStatus = resp.statusCode;
            if (!isRetryable(resp.statusCode)) break;                                               // src: vulnhunter-agent/agent/issues.py:347
            if (attempt == 0) sleep(θ["code.agent.issues.retry_backoff_seconds"]);                  // src: vulnhunter-agent/agent/issues.py:357
        }
        throw new IssuePostError("POST issues failed: " + lastStatus);                              // src: vulnhunter-agent/agent/issues.py:358
    }

    // _close_issue: state_reason "completed" (receipt, not rejection)
    void closeIssue(HttpClient client, String api, String owner, String name, int number, Theta θ) {
        int lastStatus = 0;
        for (int attempt = 0; attempt < θ["code.agent.issues.post_attempts"]; attempt++) {          // src: vulnhunter-agent/agent/issues.py:380
            Response resp = client.patch(api + "/repos/" + owner + "/" + name + "/issues/" + number, Map.of("state", "closed", "state_reason", "completed")); // src: vulnhunter-agent/agent/issues.py:381
            if (resp.statusCode == 200 || resp.statusCode == 201) return;                           // src: vulnhunter-agent/agent/issues.py:384
            lastStatus = resp.statusCode;
            if (!isRetryable(resp.statusCode)) break;                                               // src: vulnhunter-agent/agent/issues.py:388
            if (attempt == 0) sleep(θ["code.agent.issues.retry_backoff_seconds"]);                  // src: vulnhunter-agent/agent/issues.py:398
        }
        throw new IssuePostError("PATCH close issue failed: " + lastStatus);                        // src: vulnhunter-agent/agent/issues.py:399
    }

    String postIssueComment(HttpClient client, String api, String owner, String name, int number, String body, Theta θ) {
        int lastStatus = 0;
        for (int attempt = 0; attempt < θ["code.agent.issues.post_attempts"]; attempt++) {          // src: vulnhunter-agent/agent/issues.py:422
            Response resp = client.post(api + "/repos/" + owner + "/" + name + "/issues/" + number + "/comments", Map.of("body", body)); // src: vulnhunter-agent/agent/issues.py:423
            if (resp.statusCode == 200 || resp.statusCode == 201) {                                 // src: vulnhunter-agent/agent/issues.py:426
                String htmlUrl = resp.json().html_url;
                if (htmlUrl == null || htmlUrl == "") throw new IssuePostError("no html_url on comment"); // src: vulnhunter-agent/agent/issues.py:428
                return htmlUrl;
            }
            lastStatus = resp.statusCode;
            if (!isRetryable(resp.statusCode)) break;                                               // src: vulnhunter-agent/agent/issues.py:436
            if (attempt == 0) sleep(θ["code.agent.issues.retry_backoff_seconds"]);                  // src: vulnhunter-agent/agent/issues.py:446
        }
        throw new IssuePostError("POST comment failed: " + lastStatus);                             // src: vulnhunter-agent/agent/issues.py:447
    }

    // ---- audit
    // _emit_finding_opened: a failing audit emit never breaks the per-finding contract.
    void emitFindingOpened(AuditWriter auditWriter, Theta θ, Finding finding, String url, Path resultsDir, String reportId, String repoSlug, RepoProperties repoProperties) {
        if (auditWriter == null || reportId == "") return;                                          // src: vulnhunter-agent/agent/issues.py:87
        String findingId = Audit.findingIdFor(reportId, finding.id);                                // src: vulnhunter-agent/agent/issues.py:89
        RepoProperties props = (repoProperties != null) ? repoProperties : new RepoProperties();
        try {
            auditWriter.emitAudit(Audit.buildFindingOpened(config.audit.appId, config.audit.actor, repoSlug, reportId, findingId, url, "", "OPEN", "", θ), θ); // src: vulnhunter-agent/agent/issues.py:92
            auditWriter.emitFinding(Audit.buildFindingEvent(config.audit.appId, repoSlug, reportId, findingId, finding.id, finding.title,
                    finding.cwe or "CWE-UNKNOWN", finding.severity, "OPEN", finding.location, finding.rootCause, finding.entryPoint, finding.dataFlow, "",
                    finding.fixStrategy, "", finding.severityRationale,
                    AuditExtract.relativize(finding.pocPath, resultsDir), AuditExtract.relativize(finding.exploitTestPath, resultsDir),
                    url, false, props.values), θ);                                                  // opened=false: transition, not initial open // src: vulnhunter-agent/agent/issues.py:103
        } catch (Exception e) {
            log.exception("Failed to emit finding_opened audit");                                   // src: vulnhunter-agent/agent/issues.py:132
        }
    }

    void emitCleanScanNotified(AuditWriter auditWriter, Theta θ, String reportId, String repoSlug, String issueUrl, String commitSha, String toStatus, String notes) {
        if (auditWriter == null) return;                                                            // src: vulnhunter-agent/agent/issues.py:531
        try {
            auditWriter.emitAudit(Audit.buildCleanScanNotified(config.audit.appId, config.audit.actor, repoSlug, reportId, issueUrl, θ["anthropic.model"], commitSha, toStatus, notes, θ), θ); // src: vulnhunter-agent/agent/issues.py:534
        } catch (Exception e) {
            log.exception("Failed to emit clean_scan_notified audit event");                        // src: vulnhunter-agent/agent/issues.py:548
        }
    }

    // ---- clean-scan receipt
    String isoFromResultsTimestamp(String resultsDirName) {
        String ts = Github.extractTimestamp(resultsDirName);                                        // src: vulnhunter-agent/agent/issues.py:458
        if (ts == "" || ts == "unknown") return "";                                                 // src: vulnhunter-agent/agent/issues.py:459
        try {
            return parseUtc(ts, "yyyy-MM-dd-HHmmss").format("yyyy-MM-ddTHH:mm:ssZ");                // src: vulnhunter-agent/agent/issues.py:462
        } catch (ValueError e) {
            return "";                                                                              // src: vulnhunter-agent/agent/issues.py:466
        }
    }

    CleanScanContext buildCleanScanCtx(Path resultsDir, String reportUrl, String repoSlug, String commitSha, Theta θ, String scanCompletedAt) {
        String startedIso = isoFromResultsTimestamp(resultsDir.name);                               // src: vulnhunter-agent/agent/issues.py:486
        Integer duration = null;
        if (startedIso != "" && scanCompletedAt != "") {
            try {
                duration = max(0, seconds(parseIso(scanCompletedAt) - parseIso(startedIso)));       // src: vulnhunter-agent/agent/issues.py:496
            } catch (ValueError e) {
                duration = null;
            }
        }
        String shortSha = (commitSha != "") ? commitSha.take(7) : "";                               // src: vulnhunter-agent/agent/issues.py:499
        return new CleanScanContext(resultsDir.name, repoSlug, shortSha, config.audit.appId, startedIso, scanCompletedAt, duration, θ["anthropic.model"], SkillVersion.resolve(), reportUrl or ""); // src: vulnhunter-agent/agent/issues.py:500
    }

    // _post_clean_scan_notice: no receipt-path failure may fail the run -> anything unexpected becomes "skipped".
    CleanScanOutcome postCleanScanNotice(Path resultsDir, String reportUrl, String targetRepoUrl, Theta θ, String commitSha, AuditWriter auditWriter, String auditReportId, String auditRepoSlug) {
        try {
            return postCleanScanNoticeInner(resultsDir, reportUrl, targetRepoUrl, θ, commitSha, auditWriter, auditReportId, auditRepoSlug); // src: vulnhunter-agent/agent/issues.py:580
        } catch (Exception exc) {
            return new CleanScanOutcome("", "skipped", "", "unexpected error");                     // src: vulnhunter-agent/agent/issues.py:598
        }
    }

    CleanScanOutcome postCleanScanNoticeInner(Path resultsDir, String reportUrl, String targetRepoUrl, Theta θ, String commitSha, AuditWriter auditWriter, String auditReportId, String auditRepoSlug) {
        if (TokenClient.getGithubToken("scan", θ["github.*"]) == "") return new CleanScanOutcome("", "skipped", "", "scan_token missing"); // src: vulnhunter-agent/agent/issues.py:618
        String[] ownerName = Github.parseOwnerRepo(targetRepoUrl);                                  // src: vulnhunter-agent/agent/issues.py:625
        String api = Github.apiBase(θ["github.*"].host);                                            // src: vulnhunter-agent/agent/issues.py:626
        String label = θ["code.agent.issues.clean_scan_label"];                                     // src: vulnhunter-agent/agent/issues.py:628
        Object verify = Auth.resolveVerify(θ);                                                      // src: vulnhunter-agent/agent/issues.py:629
        String scanCompletedAt = utcNow().format("yyyy-MM-ddTHH:mm:ssZ");                           // src: vulnhunter-agent/agent/issues.py:634
        CleanScanContext ctx = buildCleanScanCtx(resultsDir, reportUrl, auditRepoSlug, commitSha, θ, scanCompletedAt); // src: vulnhunter-agent/agent/issues.py:637
        String body = IssuesRender.renderCleanScanBody(ctx);                                        // src: vulnhunter-agent/agent/issues.py:645
        String commentBody = IssuesRender.renderCleanScanComment(ctx);                              // src: vulnhunter-agent/agent/issues.py:646
        String title = IssuesRender.renderCleanScanTitle();                                         // src: vulnhunter-agent/agent/issues.py:647
        HttpClient client = new HttpClient(verify, θ["issues.request_timeout_seconds"], githubDefaultHeaders(), new BrokerTokenAuth("scan")); // src: vulnhunter-agent/agent/issues.py:653

        // step 1: ensure the receipt label (green, informational description)
        try {
            ensureLabel(client, api, ownerName[0], ownerName[1], label, "VulnHunter clean-scan receipt (informational)", "0e8a16"); // src: vulnhunter-agent/agent/issues.py:659
        } catch (IssuesStageError exc) {
            return new CleanScanOutcome("", "skipped", "", "label-ensure failed");                  // also RequestError // src: vulnhunter-agent/agent/issues.py:668
        }
        // step 2: find already-open receipts
        List<OpenIssue> opens;
        try {
            opens = IssuesFetch.fetchOpenIssuesWithLabel(targetRepoUrl, label, θ["code.agent.config_example.logging_retries"]); // src: vulnhunter-agent/agent/issues.py:679
        } catch (IssuesFetchError exc) {
            return new CleanScanOutcome("", "skipped", "", "open-issue lookup failed");             // src: vulnhunter-agent/agent/issues.py:685
        }
        // step 3a: an open receipt means a prior close-back failed -> comment on it instead of duplicating
        if (!opens.isEmpty()) {                                                                     // src: vulnhunter-agent/agent/issues.py:700
            OpenIssue target = opens.minBy(o -> o.number);                                          // lowest number = deterministic tiebreak // src: vulnhunter-agent/agent/issues.py:704
            if (opens.size() > 1) log.warning("multiple open clean-scan issues; strays listed (max 5)"); // _MAX_STRAYS_IN_LOG // src: vulnhunter-agent/agent/issues.py:705
            String commentUrl;
            try {
                commentUrl = postIssueComment(client, api, ownerName[0], ownerName[1], target.number, commentBody, θ); // src: vulnhunter-agent/agent/issues.py:726
            } catch (IssuePostError exc) {
                return new CleanScanOutcome(target.htmlUrl, "skipped", "", "comment POST failed");  // src: vulnhunter-agent/agent/issues.py:741
            }
            emitCleanScanNotified(auditWriter, θ, auditReportId, auditRepoSlug, target.htmlUrl, commitSha, "CLOSED", "append: " + target.htmlUrl); // src: vulnhunter-agent/agent/issues.py:752
            return new CleanScanOutcome(target.htmlUrl, "appended", "", "comment: " + commentUrl);  // src: vulnhunter-agent/agent/issues.py:762
        }
        // step 3b: create the receipt, then close it immediately
        String issueUrl;
        try {
            issueUrl = createIssue(client, api, ownerName[0], ownerName[1], title, body, List.of(label), θ); // src: vulnhunter-agent/agent/issues.py:770
        } catch (IssuePostError exc) {
            return new CleanScanOutcome("", "skipped", "", "issue POST failed");                    // src: vulnhunter-agent/agent/issues.py:782
        }
        try {
            int issueNumber = issueNumberFromUrl(issueUrl);                                         // src: vulnhunter-agent/agent/issues.py:793
            closeIssue(client, api, ownerName[0], ownerName[1], issueNumber, θ);                     // src: vulnhunter-agent/agent/issues.py:794
        } catch (IssuePostError exc) {
            // left open; next scan self-heals via the open-label lookup
            emitCleanScanNotified(auditWriter, θ, auditReportId, auditRepoSlug, issueUrl, commitSha, "OPEN", "close-back failed"); // src: vulnhunter-agent/agent/issues.py:808
            return new CleanScanOutcome(issueUrl, "close_back_failed", "OPEN", exc.message);        // src: vulnhunter-agent/agent/issues.py:818
        }
        emitCleanScanNotified(auditWriter, θ, auditReportId, auditRepoSlug, issueUrl, commitSha, "CLOSED", ""); // src: vulnhunter-agent/agent/issues.py:825
        return new CleanScanOutcome(issueUrl, "created", "CLOSED", "");                             // src: vulnhunter-agent/agent/issues.py:835
    }

    int issueNumberFromUrl(String htmlUrl) {
        String tail = htmlUrl.rstrip("/").rsplit("/")[-1];                                          // src: vulnhunter-agent/agent/issues.py:847
        try {
            return int(tail);                                                                       // src: vulnhunter-agent/agent/issues.py:849
        } catch (ValueError e) {
            throw new IssuePostError("cannot parse issue number from html_url");                    // hard fail // src: vulnhunter-agent/agent/issues.py:851
        }
    }

    // ---- reporting
    void printSummary(PostSummary summary) {
        if (summary.note != "") print("Note: " + summary.note);                                     // src: vulnhunter-agent/agent/issues.py:1010
        if (summary.posted.size() <= 3) print("Posted: " + join(", ", summary.posted.map(p -> p.url))); // _POSTED_INLINE_LIMIT = 3 (layout only) // src: vulnhunter-agent/agent/issues.py:1013
        else for (PostedIssue p : summary.posted) print("- " + p.url);                              // src: vulnhunter-agent/agent/issues.py:1018
        if (summary.cleanScan != null) print("Clean: " + summary.cleanScan.mode + " " + summary.cleanScan.url); // src: vulnhunter-agent/agent/issues.py:1022
        print("Skipped: " + summary.skipped.size());                                                // src: vulnhunter-agent/agent/issues.py:1032
        print("Failed: " + summary.failed.size());                                                  // src: vulnhunter-agent/agent/issues.py:1040
        if (summary.cost.calls > 0) print("Cost: " + summary.cost.costUsd);                         // src: vulnhunter-agent/agent/issues.py:1046
    }

    String buildReportUrlForLocalScan(String publishDestinationRepo, String publishBranch, String sourceRepoUrl, String sourceCommitHash, Path resultsDir) {
        return IssuesRender.buildReportUrl(publishDestinationRepo, publishBranch, sourceRepoUrl, sourceCommitHash, Github.extractTimestamp(resultsDir.name), resultsDir.name); // src: vulnhunter-agent/agent/issues.py:1063
    }

    String buildReportUrlForRemoteReport(String publishDestinationRepo, String publishBranch, String relPathInDest) {
        String dest = publishDestinationRepo.rstrip("/");                                           // src: vulnhunter-agent/agent/issues.py:1085
        if (dest.endsWith(".git")) dest = dest.dropSuffix(".git");                                  // src: vulnhunter-agent/agent/issues.py:1086
        return dest + "/blob/" + publishBranch + "/" + relPathInDest + "/README.md";                // src: vulnhunter-agent/agent/issues.py:1088
    }
}
