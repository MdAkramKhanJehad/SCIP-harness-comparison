// Defaults: env = {}, modelProvider = null (infer from name), effort = null, thinkInPrompt = false,
// useResponsesApi = null (learned, then Responses), toolPolicy = null, responseModel = null,
// toolBuilder = null (backend's generic readers), factTools = (), factToolSpecs = () (deepagents ignores them),
// allowWrites = false, writablePaths = (), skillRoot = null, graphName = "agent",
// maxOutputTokens = null (inherits 64k on Anthropic, uncapped on OpenAI), outputCap = null,
// cacheMarkers = true (wired from sdk.cache_markers), parentMiddleware = (), forceVerdictOnly = false.
@executedBy(CODE) @role(types)
record SessionOptions(String model, Path cwd, Map<String, String> env, String modelProvider, String effort, boolean thinkInPrompt, Boolean useResponsesApi, String systemPrompt, ToolPolicy toolPolicy, String cliPath, Schema responseModel, ToolBuilder toolBuilder, List<String> factTools, List<FactToolSpec> factToolSpecs, boolean allowWrites, List<String> writablePaths, Path skillRoot, String graphName, Integer maxOutputTokens, Integer outputCap, boolean cacheMarkers, List<Middleware> parentMiddleware, boolean forceVerdictOnly) { }

