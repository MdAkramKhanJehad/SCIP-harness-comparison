// file: vvaharness/plugins/semgrep/findings.py
// Normalize bounded Semgrep JSON into ordinary Finding records before S5.
// Parsing/type errors not explicitly caught below propagate to the caller.

@executedBy(CODE) @role(io) @stage("S5")
class SemgrepFindings {
    @src("vvaharness/plugins/semgrep/findings.py:75")
    PurePath posix(String value) {
        return PurePosixPath(value.replace("\\", "/"));
    }
    @src("vvaharness/plugins/semgrep/findings.py:80")
    String under(PurePath base, PurePath candidate) {
        return candidate.isRelativeTo(base) ? candidate.relativeTo(base).toString() : "";
    }
    @src("vvaharness/plugins/semgrep/findings.py:85")
    String relativePath(String path, String root) {
        PurePath candidate = posix(path);
        if (root.isEmpty() || !candidate.isAbsolute()) return List.of(".", "").contains(candidate.toString()) ? path : candidate.toString();
        PurePath base = posix(Path.of(root).resolve().toString());
        String rel = under(base, candidate);
        if (rel.isEmpty()) rel = under(base, posix(Path.of(path).resolve().toString()));
        if (!rel.isEmpty()) return rel;
        Counters.bump("semgrep_path_outside_repo");
        logWarning("absolute path retained; inventory validation in S5 will drop it");
        return candidate.toString();
    }
    @src("vvaharness/plugins/semgrep/findings.py:101")
    List<String> cweIds(Map metadata, Theta θ) {
        Object raw = truthyOr(metadata.get("cwe"), List.of());
        List values = raw instanceof String ? List.of(raw) : iterable(raw).filter(v -> v instanceof String);
        OrderedSet<String> seen = new OrderedSet();
        Regex rx = Regex.compile(θ["code.plugins.semgrep.findings.cwe_re"]); // src: vvaharness/plugins/semgrep/findings.py:36
        for (String value : values) for (Match m : rx.finditer(value)) seen.add("CWE-" + toInt(m.group(1)));
        return seen.toList();
    }
    @src("vvaharness/plugins/semgrep/findings.py:112")
    VulnClass vulnClass(List<String> cwes, Theta θ) {
        Map mapping = θ["code.plugins.semgrep.findings.cwe_to_class"]; // src: vvaharness/plugins/semgrep/findings.py:40
        for (String cwe : cwes) if (mapping.containsKey(toInt(cwe.removePrefix("CWE-")))) return vulnClassFromValue(mapping.get(toInt(cwe.removePrefix("CWE-"))));
        return VulnClass.OTHER;
    }
    @src("vvaharness/plugins/semgrep/findings.py:121")
    String label(Map metadata, List<String> cwes) {
        Object raw = truthyOr(metadata.get("vulnerability_class"), List.of());
        List<String> values = raw instanceof String ? List.of(raw) : iterable(raw).filter(v -> v instanceof String);
        String authored = values.map(v -> v.strip()).firstOrDefault(v -> !v.isEmpty(), "");
        return authored.isEmpty() ? cwes.map(c -> cweName(c)).firstOrDefault(v -> truthy(v), "") : authored;
    }
    @src("vvaharness/plugins/semgrep/findings.py:129")
    Finding finding(Map result, String root, Theta θ) {
        Object rawPath = result.get("path"); Object start = truthyOr(result.get("start"), Map.of()).get("line");
        if (!(rawPath instanceof String) || !pythonIsInt(start)) return null;
        String path = relativePath(rawPath, root);
        Map extra = truthyOr(result.get("extra"), Map.of()); Map metadata = truthyOr(extra.get("metadata"), Map.of());
        List<String> cwes = cweIds(metadata, θ); VulnClass cls = vulnClass(cwes, θ);
        String ruleId = str(truthyOr(result.get("check_id"), "semgrep")); String message = str(truthyOr(extra.get("message"), ruleId));
        Map optional = Map.of("line_end", truthyOr(result.get("end"), Map.of()).get("line"), "cwe", cwes.isEmpty() ? null : cwes.get(0));
        optional.put("severity", θ["code.plugins.semgrep.findings.severity"].get(str(extra.getOrDefault("severity", "")).upper())); // src: vvaharness/plugins/semgrep/findings.py:68
        optional.put("code_snippet", nullIfEmpty(str(truthyOr(extra.get("lines"), "")).head(θ["code.plugins.semgrep.findings.max_snippet_chars"]))); // src: vvaharness/plugins/semgrep/findings.py:32
        optional.put("vuln_class_label", cls == VulnClass.OTHER ? label(metadata, cwes).head(θ["code.plugins.semgrep.findings.max_label_chars"]) : null); // src: vvaharness/plugins/semgrep/findings.py:34
        String title = truthyOr(message.strip().splitlines().get(0).head(θ["code.plugins.semgrep.findings.max_title_chars"]), ruleId); // src: vvaharness/plugins/semgrep/findings.py:33
        return new Finding(title, path, start, cls, message, "semgrep:" + ruleId, optional.filterValues(v -> v != null));
    }
    @src("vvaharness/plugins/semgrep/findings.py:161")
    List<Finding> findingsFromSemgrep(Object payload, Object repo, Theta θ) {
        Map document = payload instanceof Map ? payload : readSemgrepJson(Path.of(payload), θ);
        String root = repo == null ? "" : str(repo); Object results = document.get("results");
        if (!(results instanceof List)) throw new SemgrepFindingsError("missing results list");
        if (results.size() > θ["code.plugins.semgrep.findings.max_findings"]) throw new SemgrepFindingsError("too many results"); // src: vvaharness/plugins/semgrep/findings.py:30
        List<Finding> out = new List();
        for (Object r : results) if (r instanceof Map) { Finding f = finding(r, root, θ); if (f != null) out.add(f); }
        return out;
    }
    @src("vvaharness/plugins/semgrep/findings.py:176")
    Map readSemgrepJson(Path path, Theta θ) {
        Object document;
        try {
            if (path.stat().size > θ["code.plugins.semgrep.findings.max_json_bytes"]) throw new SemgrepFindingsError("oversized JSON"); // src: vvaharness/plugins/semgrep/findings.py:31
            document = Json.parse(path.readText("utf-8"));
        } catch (OSError | JsonDecodeError e) { throw new SemgrepFindingsError("cannot read JSON", e); }
        if (!(document instanceof Map)) throw new SemgrepFindingsError("JSON must be object");
        return document;
    }
}

@executedBy(CODE) @role(types)
record SemgrepFindingsError(String message, Object cause) { }
