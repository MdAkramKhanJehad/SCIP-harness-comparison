# vvaharness/models/scan/_render.py

Markdown-safety helpers shared by the report renderers. Untrusted model and repository text is neutralised so it cannot forge headings, table rows, code-span closings or hidden (bidirectional, zero-width) characters in the report.

Source: `vvaharness/models/scan/_render.py` (lines 1-159)
Executor: code
Called from: `vvaharness/models/scan/report.py`, `_finding_section.py`, `_sections_*.py`; `_vector_span` also by the remediation prompt

// src: vvaharness/models/scan/_render.py:23-43
_ATX_HEADING_RX = /^(\s{0,3})#{1,6}[ \t]+(.*)$/
_FENCE_RX = /^\s{0,3}(```|~~~)/
_SETEXT_H1_RX = /^\s{0,3}=+\s*$/
_MD_LINEBREAK_RX = /[\r\n\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029]/   // every separator splitlines() breaks on (a U+2028 would forge a table row past a \r\n filter)
_NEWLINE_RUN_RX = /\s*<_MD_LINEBREAK_RX>\s*/
_MD_INVISIBLE_RX = /[\x00-\x08\x0e-\x1f\x7f\u00ad\u061c\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u2069\ufeff]/   // C0 controls minus tab and the breaks, soft hyphen, Arabic letter mark, zero-width and bidirectional (Trojan-Source) characters, BOM
_ANGLE_ENTITY = { "<": "&lt;", ">": "&gt;" }
_INLINE_CODE_SPAN_RX = /(`+[^`]*`+)/

// src: vvaharness/models/scan/_render.py:46-87
fn _demote_md_headings(text, escape_angles=false):executor=code {
  // escape_angles is for model prose only; findings.json and SARIF keep the model's exact bytes
  if (!text) return text
  lines = splitlines(text)
  mark lines inside a closed fence as fenced (``` and ~~~ are distinct markers; a fence closes only on its own marker); remember a dangling opener
  for each unfenced line {
    if (escape_angles) entity-escape < and > outside inline code spans (code spans kept byte-identical)
    replace an ATX heading "# text" by "**text**" (indent kept)
    if (line matches _SETEXT_H1_RX && previous output line is non-blank) insert a blank line first   // "====" would forge a heading; "----" is left alone
  }
  if (dangling opener) append a closing fence of the opener's own marker run (or "```")
  return joined lines
}

// src: vvaharness/models/scan/_render.py:90-113
fn _escape_angles(text):executor=code { return string of (text || "") with < and > entity-escaped }
fn _snippet_fence(code):executor=code { return "`" repeated max(3, longest backtick run in code + 1) }   // code can never close its fence
fn _code_span(text):executor=code {
  s = text with line breaks => " ", invisible characters removed, stripped
  if (no backtick run in s) return "`$s`"
  d = "`" repeated (longest run + 1); return "$d $s $d"
}

// src: vvaharness/models/scan/_render.py:116-124
_CVSS_VECTOR_RX = /CVSS:3\.[01]\/[A-Za-z:.\/]+/
fn _vector_span(vec):executor=code { v = string of (vec || ""); return if (v fully matches _CVSS_VECTOR_RX) "`$v`" else _code_span(v) }

// src: vvaharness/models/scan/_render.py:127-135
fn _one_line(text):executor=code { return text with every newline run => " ", stripped }
fn _confidence_label(confidence):executor=code { return if (confidence != null) "$confidence/10" else "not scored" }

// src: vvaharness/models/scan/_render.py:138-148
fn _md_cell(text):executor=code {
  if (text == null) return ""
  s = line breaks => " "; invisible characters removed
  s = "&" => "&amp;" first, then < and > entity-escaped   // order matters (CWE-79)
  return s with "\" doubled, then "|" => "\|", stripped   // backslashes first, or a supplied \ re-exposes the delimiter
}

// src: vvaharness/models/scan/_render.py:151-159
fn _render_repro_block(detail):executor=code {
  try return exploit_verification.verify.repro.render_block(ReproDetail.model_validate(detail));   // external: exploit verification package
  catch any error => return []   // no block on failure
}
