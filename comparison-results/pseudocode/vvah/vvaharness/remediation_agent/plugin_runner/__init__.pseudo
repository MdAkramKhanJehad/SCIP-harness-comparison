// Run the remediation method for one finding: the single model seam (invoke) routed by backend (deepagents, cli, sdk or openai), the DeepAgents stream consumer with its wall clock, post-hoc verdict extraction and recursion-limit handling.
// Pass-1 rendered the invoke path inside remediate.pseudo (class PluginRunnerInvoke); this file renders every function of the module.

@executedBy(CODE) @role(backend) @stage("S10")
class PluginRunner {

    Object runSync(Coroutine awaitable) {
        // Run a coroutine from synchronous code, including inside a live event loop: with no running loop use asyncio.run directly, otherwise run it on a fresh daemon thread and re-raise the original failure.
        if (!EventLoop.hasRunningLoop()) return EventLoop.run(awaitable);                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:91
        List<Object> result = new List();                                                           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:96
        List<Exception> error = new List();                                                         // src: vvaharness/remediation_agent/plugin_runner/__init__.py:97
        Thread thread = Thread.startDaemon("vvaharness-remediation", () -> worker(awaitable, result, error)); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:105
        thread.join();                                                                              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:107
        if (!error.isEmpty()) throw error.get(0);                                                   // src: vvaharness/remediation_agent/plugin_runner/__init__.py:108
        return result.get(0);                                                                       // src: vvaharness/remediation_agent/plugin_runner/__init__.py:110
    }

    void worker(Coroutine awaitable, List<Object> result, List<Exception> error) {
        // Thread body of runSync (nested function flattened; captured lists are parameters). Any failure, including BaseException, is captured and propagated by the caller.
        try {
            result.add(EventLoop.run(awaitable));                                                   // src: vvaharness/remediation_agent/plugin_runner/__init__.py:101
        } catch (Throwable exc) {
            error.add(exc);                                                                         // src: vvaharness/remediation_agent/plugin_runner/__init__.py:103
        }
    }

