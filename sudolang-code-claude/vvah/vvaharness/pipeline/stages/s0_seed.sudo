# vvaharness/pipeline/stages/s0_seed.py

Stage 0 (static seed, no model). Walks the repository with the Stage 1 scope rules, detects languages, optionally narrows them to an allow list, and runs deterministic source-text matching to seed entry points and unsafe sinks.

Source: `vvaharness/pipeline/stages/s0_seed.py` (lines 1-83)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (Stage 0)

// src: vvaharness/pipeline/stages/s0_seed.py:28-37
_KIND_HINTS {
  // ruleId or message tokens mapped to an entry-point kind; unmatched tokens become "other"
  http, request, route, controller, servlet, handler, graphql, grpc, websocket => "network"
  queue, kafka, jms, amqp => "ipc"
  argv, stdin, flag => "cli"
  env, config, fileread => "file"
  deseriali, unmarshal, pickle, yaml-load => "deserialization"
}
// preserved: _KIND_HINTS is defined in this module but nothing in the module (or elsewhere in the package) reads it

// src: vvaharness/pipeline/stages/s0_seed.py:59-79
fn run(repo_root, cfg, ckpt_dir?):executor=code {
  [all_files, excluded] = scope._walk_repo(repo_root, cfg)   // see scope/walk.sudo
  in_scope = set(all_files)
  langs = _filter_step0_languages(lang.detect.detect_languages(all_files), cfg)
  // Matching is on source TEXT, because graph-node sink matching misses library calls
  result = vvaharness.detect.scan(repo_root, sorted(in_scope))   // detector package, rendered elsewhere
  seed = SeedPackage(entry_points=result.entry_points, unsafe_sinks=result.unsafe_sinks, languages=langs, all_files, excluded)
  // preserved: ckpt_dir is accepted but unused; seed.taint_paths is logged but never populated here
  return seed
  // abstracted: s0_seed.py:61, 65-66, 77-78 log lines only
}

// src: vvaharness/pipeline/stages/s0_seed.py:40-56
fn _filter_step0_languages(langs, cfg):executor=code {
  raw = knob("step0.languages", default=null)
  if (!raw) return langs   // unset: no narrowing
  allow = {}
  for each x in raw where trimmed x is non-empty {
    canon = lang.detect.canonical_lang(x); allow += canon
    if (canon not in lang.detect.VVAH_LANGUAGES) {
      warn "step0.languages entry $x is not a recognized language or alias; it will not match any file"   // console write; scope narrowing must not be silent
    }
  }
  return langs where l in allow
}
