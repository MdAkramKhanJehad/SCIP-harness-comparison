# vvaharness/validation/io/message_logger.py

Drains the streamed session messages into `session.jsonl` and derives the session's exit code from the terminal result's subtype.

Source: `vvaharness/validation/io/message_logger.py` (lines 1-150)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` _stream_session

// src: vvaharness/validation/io/message_logger.py:132-150
fn stream_and_log(messages, log_dir, session_id, live):executor=code {
  create log_dir
  exit_code = 1   // no terminal result means failure
  observed_sid = session_id
  open "$log_dir/session.jsonl" for writing
  for each message in messages {
    write JSON(message) as one line; flush
    [new_code, observed_sid] = _process_message(message, observed_sid, live)
    if (new_code != null) exit_code = new_code
  }
  return [exit_code, observed_sid]
}

// src: vvaharness/validation/io/message_logger.py:115-129
fn _process_message(message, observed_sid, live):executor=code {
  log key events (tool call names, "Agent spawned: <description>", session start, completion subtype)
  if (live) print a one-line preview
  if (message is HarnessSessionInit && message.session_id) observed_sid = message.session_id
  if (message is HarnessResult) {
    observed_sid = message.session_id || observed_sid
    if (message.subtype == "error_max_budget_usd") warn "Validation session halted: max_budget_usd exceeded"
    return [if (message.subtype == "success") 0 else 1, observed_sid]
  }
  return [null, observed_sid]
}
// abstracted: message_logger.py:39-112 are logging and live-preview formatters; the launcher passes live=false. They change no decision.
