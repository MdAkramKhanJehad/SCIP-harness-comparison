        Object callerDispatch = legacyKw.get("extra_dispatch");                                             // src: vvaharness/backends/llm/deepagents.py:1144
        legacyKw.put("extra_tools", stack.schemas + callerTools);                                           // adapter schemas first // src: vvaharness/backends/llm/deepagents.py:1145
        legacyKw.put("extra_dispatch", (name, args) -> dispatchChained(stack, callerDispatch, name, args, tag)); // src: vvaharness/backends/llm/deepagents.py:1153
