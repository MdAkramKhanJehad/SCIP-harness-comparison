  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Builds the one code graph a scan analyzes and queries.\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Iterable\nfrom pathlib import Path\n\nfrom context_graph_sdk.api import Workspace\nfrom context_graph_sdk.backends.arcadedb import ArcadeDBBackendFactory\nfrom context_graph_sdk.code_graph import CodeGraph\nfrom context_graph_sdk.plugins import GraphEnricher\n\nfrom vvaharness.codegraph.handle import GraphHandle\nfrom vvaharness.util.config import knob\nfrom vvaharness.util.counters import COUNTERS\n\n#: `step0.min_graph_nodes_for_gate`: below 10 nodes a graph cannot answer GraphContext usefully\n_MIN_GRAPH_NODES_FOR_GATE = 10\n\n\ndef _analyze(workspace: Workspace, repo_root: str, project_id: str,\n             enrichers: tuple[GraphEnricher, ...]) -> CodeGraph:\n    try:\n        return workspace.analyze(repo_root, project_id, enrichers)\n    except Exception:\n        workspace.close()\n        raise\n\n\ndef _enricher_names(plugins: tuple[object, ...]) -> tuple[str, ...]:\n    \"\"\"Plugin names, for logging only; one too malformed to name is reported as ``?``.\"\"\"\n    try:\n        return tuple(str(getattr(p.metadata, \"name\", \"?\")) for p in plugins)\n    except Exception:\n        return tuple(\"?\" for _ in plugins)\n\n\ndef build_graph(repo_root: str, project_id: str, workspace_dir: Path,\n                enrichers: Iterable[GraphEnricher] = ()) -> GraphHandle:\n    \"\"\"Analyze ``repo_root`` into a fresh workspace at ``workspace_dir``, running *enrichers*.\"\"\"\n    # Any backend or plugin failure propagates: S2/S4/S6 ground their verdicts in this graph, so a\n    # scan without one is a different product, and the failure is cheapest before any model spend.\n    plugins = tuple(enrichers)\n    names = _enricher_names(plugins)\n    workspace = Workspace(workspace_dir, ArcadeDBBackendFactory())\n    graph = _analyze(workspace, repo_root, project_id, plugins)\n    for name in names:\n        COUNTERS.bump(f\"s0_graph_enricher_ran:{name}\")\n    info = graph.info()\n    return GraphHandle(\n        workspace=workspace, graph=graph, project_id=project_id,\n        node_count=info.node_count,\n        edge_count=info.edge_count,\n        enrichers=tuple(names),\n    )\n\n\ndef graph_is_degenerate(ctx: object, cfg: object = None) -> bool:\n    \"\"\"True when *ctx*'s graph cannot back a `require_graph` evidence demand.\"\"\"\n    # No handle, zero edges, or under min_graph_nodes_for_gate; UNMEASURED is NOT degenerate\n    handle = getattr(ctx, \"graph_handle\", None)\n    if handle is None:\n        return True\n    if getattr(handle, \"edge_count\", None) == 0:\n        return True\n    nodes = getattr(handle, \"node_count\", None)\n    if nodes is None:\n        return False\n    min_nodes = int(knob(cfg, \"step0.min_graph_nodes_for_gate\", _MIN_GRAPH_NODES_FOR_GATE))\n    return nodes < min_nodes\n",
