// file: vvaharness/detect/roles.py
// S0: turns matcher hits into typed Sink and EntryPoint records for the seed package.

@executedBy(CODE) @role(step) @stage("S0")
class Roles {

    /** Sink function name = last dash-separated segment of the rule id. */
    String sinkFunction(Hit hit) {
        return hit.spec.ruleId.rsplitLast("-");                                                   // src: vvaharness/detect/roles.py:28
    }

    /** One Sink per sink-role hit, deduped by (file, line, function). */
    List<Sink> hitsToSinks(List<Hit> hits) {
        Set<Triple> seen = new Set(); List<Sink> sinks = new List();
        for (Hit hit : hits) {                                                                    // src: vvaharness/detect/roles.py:35
            if (hit.spec.role != "sink") continue;                                                // src: vvaharness/detect/roles.py:36
            String function = sinkFunction(hit);                                                  // src: vvaharness/detect/roles.py:38
            Triple key = new Triple(hit.file, hit.line, function);                                // src: vvaharness/detect/roles.py:39
            if (seen.contains(key)) continue;                                                     // src: vvaharness/detect/roles.py:40
            seen.add(key);
            sinks.add(new Sink(hit.file, hit.line, function, hit.snippet, List.of(hit.spec.cwe))); // src: vvaharness/detect/roles.py:43
        }
        return sinks;
    }

    /** One EntryPoint per source-role hit, deduped by (file, kind): later sources of the same kind in a file are dropped. */
    List<EntryPoint> hitsToEntryPoints(List<Hit> hits, Theta θ) {
        Set<String> epKinds = θ["code.detect.roles.entry_point_kinds"];                           // src: vvaharness/detect/roles.py:23
        Set<Pair> seen = new Set(); List<EntryPoint> eps = new List();
        for (Hit hit : hits) {                                                                    // src: vvaharness/detect/roles.py:57
            if (hit.spec.role != "source") continue;                                              // src: vvaharness/detect/roles.py:58
            String kind = epKinds.contains(hit.spec.kind) ? hit.spec.kind : "other";              // src: vvaharness/detect/roles.py:60
            Object key = θ["code.detect.roles.entry_point_dedup_key"] == "file_kind" ? new Pair(hit.file, kind) : new Triple(hit.file, kind, hit.line); // src: vvaharness/detect/roles.py:61
            if (seen.contains(key)) continue;                                                     // src: vvaharness/detect/roles.py:62
            seen.add(key);
            eps.add(new EntryPoint(hit.file, hit.snippet, kind));                                 // function = the matched line text. src: vvaharness/detect/roles.py:65
        }
        return eps;
    }
}
