// file: vvaharness/util/status.py
// Per-stage status reporting on stderr (stdout stays clean for reports): start line or spinner,
// timed body, then a completion / completed-with-errors / incomplete / failed line, or JSON events.

@executedBy(CODE) @role(types)
record StageResult(String incompleteDetail) { }

@executedBy(CODE) @role(io)
class Status {

    static final String OK_MARK = "✓";                                        // src: vvaharness/util/status.py:39
    static final String WARN_MARK = "⚠";                                       // finished, coverage lost
    static final String FAIL_MARK = "✗";

    boolean isTty(Stream stream) {
        try { return stream.isatty(); } catch (Exception e) { return false; }  // src: vvaharness/util/status.py:55
    }

    boolean jsonLogsEnabled() {
        return List.of("1", "true", "yes").contains(env("VVAHARNESS_JSON_LOGS", "").lower()); // src: vvaharness/util/status.py:101
    }

    void emitEvent(String event, Stream stream, Map<String, Object> fields) {
        if (!jsonLogsEnabled()) return;                                        // src: vvaharness/util/status.py:106
        Map rec = Map.of("ts", nowUtc(), "event", event);
        rec.putAll(fields.filterValues(v -> v != null));                       // src: vvaharness/util/status.py:110
        (stream != null ? stream : stderr).println(Json.dumpCompact(rec));     // src: vvaharness/util/status.py:111
    }

    void stage(String label, Integer n, Integer total, Stream stream, Boolean animate, String stageId, Function<StageResult, Void> body) {
        Stream out = stream != null ? stream : stderr;                         // src: vvaharness/util/status.py:120
        String tag = (n != null && total != null) ? "[" + n + "/" + total + "] " : "";
        boolean asJson = jsonLogsEnabled();                                    // src: vvaharness/util/status.py:122
        animate = (animate == null ? isTty(out) : animate) && !asJson;         // src: vvaharness/util/status.py:124
        double t0 = now();
        Spinner spin = null;
        int err0 = stageId != null ? Errlog.countForStage(stageId, null, false) : 0; // unrecovered baseline // src: vvaharness/util/status.py:127
        if (stageId != null) StageTelemetry.start(stageId, label);             // src: vvaharness/util/status.py:130
        if (asJson) emitEvent("stage_start", out, Map.of("stage", label, "stage_id", stageId)); // src: vvaharness/util/status.py:132
        else if (animate) spin = new Spinner(label, out, n, total).start();    // src: vvaharness/util/status.py:135
        else out.println("  ▶ " + tag + label + " …");                         // src: vvaharness/util/status.py:137
        StageResult result = new StageResult("");
        try {
            body.apply(result);                                                // src: vvaharness/util/status.py:140
        } catch (Throwable e) {
            double dt = round(now() - t0, 2);
            if (spin != null) spin.stop();
            if (stageId != null) StageTelemetry.done(stageId, "error", dt);    // src: vvaharness/util/status.py:146
            if (asJson) emitEvent("stage_fail", out, Map.of("stage", label, "duration_sec", dt, "error", Redact.redact(typeName(e) + ": " + e))); // src: vvaharness/util/status.py:148
            else out.println("  " + FAIL_MARK + " " + tag + label + " — failed after " + dt + "s: " + Redact.redact(str(e))); // src: vvaharness/util/status.py:153
            if (!asJson) out.println();
            throw e;                                                           // never swallows // src: vvaharness/util/status.py:158
        }
        double dt = round(now() - t0, 2);
        if (spin != null) spin.stop();
        int nErr = stageId != null ? Errlog.countForStage(stageId, null, false) - err0 : 0; // only unrecovered records count // src: vvaharness/util/status.py:164
        if (stageId != null) StageTelemetry.done(stageId, nErr > 0 ? "completed_with_errors" : "completed", dt); // src: vvaharness/util/status.py:167
        String note = nErr > 0 ? ", " + nErr + " unrecovered error(s) — see errors.jsonl" : ""; // src: vvaharness/util/status.py:170
        String mark = nErr > 0 ? WARN_MARK : OK_MARK;                          // src: vvaharness/util/status.py:173
        if (!result.incompleteDetail.isEmpty() && asJson) emitEvent("stage_incomplete", out, Map.of("stage", label, "detail", result.incompleteDetail)); // src: vvaharness/util/status.py:174
        else if (asJson) emitEvent("stage_ok", out, Map.of("stage", label, "duration_sec", dt, "errors", nErr > 0 ? nErr : null)); // src: vvaharness/util/status.py:178
        else if (!result.incompleteDetail.isEmpty()) out.println("  ○ " + tag + label + " — " + result.incompleteDetail + " (" + dt + "s" + note + ")"); // src: vvaharness/util/status.py:182
        else out.println("  " + mark + " " + tag + label + " (" + dt + "s" + note + ")"); // coloured when animate // src: vvaharness/util/status.py:185
        if (!asJson) out.println();
    }
}

@executedBy(CODE) @role(io)
class Spinner {
    String label; Stream out; Integer n; Integer total; Event stopEv; double t0; Thread thread;

    Spinner start() {
        thread.start();                                                        // daemon thread // src: vvaharness/util/status.py:70
        return this;
    }

    void run() {
        String tag = (n != null && total != null) ? "[" + n + "/" + total + "] " : "";
        for (String frame : cycle("⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏")) {                           // src: vvaharness/util/status.py:75
            if (stopEv.isSet()) break;
            int el = (int) (now() - t0);
            int cols = terminalColumns(80);                                    // src: vvaharness/util/status.py:80
            int budget = cols - ("  " + frame + " " + tag).length() - (" … " + el + "s").length() - 1;
            String lbl = (budget > 1 && label.length() > budget) ? label.substring(0, budget - 1) + "…" : label; // one terminal row // src: vvaharness/util/status.py:85
            out.write("\r\033[K  " + frame + " " + tag + lbl + " … " + el + "s");
            stopEv.wait(0.12);                                                 // frame interval // src: vvaharness/util/status.py:90
        }
    }

    void stop() {
        stopEv.set(); thread.join(1);                                          // src: vvaharness/util/status.py:93
        out.write("\r\033[K");                                                 // clear the spinner line // src: vvaharness/util/status.py:95
    }
}
