// file: vvaharness/validation/io/case_writeback.py
// Builds a case's verdict from workspace artifacts (agent report narrative + host-scored gates) and
// writes it back onto the case's latest attempt.

@executedBy(CODE) @role(io) @stage("S11")
class CaseWriteback {

    OutputFinding loadOutputFinding(Path workspace, String caseId, Theta θ) {
        Path reportPath = workspace.resolve("validation_report.json");                               // src: vvaharness/validation/io/case_writeback.py:38
        PersistedValidationReport report;
        try {
            report = Output.fromFile(reportPath);                                          // src: vvaharness/validation/io/case_writeback.py:40
        } catch (OSError | ValueError e) {
            Log.warning("no readable validation report; recording INCONCLUSIVE");                    // src: vvaharness/validation/io/case_writeback.py:42
            return null;
        }
        for (OutputFinding f : report.findings) {                                                    // src: vvaharness/validation/io/case_writeback.py:44
            if (f.trackingId.equals(caseId)) return f;                                               // src: vvaharness/validation/io/case_writeback.py:45
        }
        if (θ["code.validation.io.case_writeback.fallback_first_finding"] && !report.findings.isEmpty()) return report.findings.get(0); // src: vvaharness/validation/io/case_writeback.py:47
        return null;
    }

    Verdict buildVerdict(FindingCase c, Path workspace, Provenance provenance, ScoringPolicy policy, boolean sessionFailed, Theta θ) {
        OutputFinding out = loadOutputFinding(workspace, c.caseId, θ);                               // src: vvaharness/validation/io/case_writeback.py:59
        List<Map> gates = (sessionFailed && θ["code.validation.io.case_writeback.discard_gates_on_session_failure"]) ? null : HostScore.loadSynthesizedGates(workspace).get(c.caseId); // src: vvaharness/validation/io/case_writeback.py:60
        Verdict scored = HostScore.verdictFor(out, gates, provenance, policy);                       // src: vvaharness/validation/io/case_writeback.py:61
        return HostScore.conformant(scored, policy, θ);                                              // src: vvaharness/validation/io/case_writeback.py:62
    }

    FindingCase writeBackVerdict(FindingCase c, Verdict verdict, Path path) {
        try {
            FindingCase judged = c.withVerdict(verdict);                                             // attaches to latest attempt  // src: vvaharness/validation/io/case_writeback.py:68
            judged.write(path);                                                                      // src: vvaharness/validation/io/case_writeback.py:69
            return judged;
        } catch (OSError | ValueError e) {
            Log.warning("could not write verdict back");                                             // src: vvaharness/validation/io/case_writeback.py:71
            return null;                                                                             // src: vvaharness/validation/io/case_writeback.py:72
        }
    }
}
