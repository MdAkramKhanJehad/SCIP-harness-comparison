  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Cargo.toml parsing.\"\"\"\n\nfrom __future__ import annotations\n\nfrom context_graph_sdk.project.config import (\n    DependencyRecord,\n    ManifestReader,\n    ManifestRecord,\n    ProjectConfig,\n    workspace_display_name,\n)\n\nfrom ._data import as_mapping, as_str, mapping_at, parse_toml, string_list\n\n_SECTIONS = (\n    (\"dependencies\", False, \"\"),\n    (\"dev-dependencies\", True, \"dev\"),\n    (\"build-dependencies\", True, \"build\"),\n)\n\n\ndef _dependency_version(value: object) -> tuple[str, str]:\n    if isinstance(value, str):\n        return value, \"\"\n    mapping = as_mapping(value)\n    if mapping is not None:\n        return as_str(mapping.get(\"version\")), as_str(mapping.get(\"git\"))\n    return \"\", \"\"\n\n\ndef load_cargo_dependencies(reader: ManifestReader, config: ProjectConfig) -> None:\n    for relative in reader.by_base_name(\"Cargo.toml\"):\n        text = reader.read_text(relative)\n        parsed = parse_toml(text) if text is not None else None\n        if parsed is None:\n            continue\n        for section, dev, scope in _SECTIONS:\n            entries = as_mapping(parsed.get(section)) or {}\n            for name, value in entries.items():\n                version, git = _dependency_version(value)\n                if not version and not git:\n                    continue\n                config.add_dependency(DependencyRecord(name, version, relative, dev, scope))\n\n\ndef load_cargo_manifests(reader: ManifestReader, config: ProjectConfig) -> None:\n    for relative in reader.by_base_name(\"Cargo.toml\"):\n        text = reader.read_text(relative)\n        parsed = parse_toml(text) if text is not None else None\n        if parsed is None:\n            continue\n        package = mapping_at(parsed, \"package\")\n        members = string_list(mapping_at(parsed, \"workspace\").get(\"members\"))\n        manifest_name = as_str(package.get(\"name\"))\n        if not manifest_name and members:\n            manifest_name = workspace_display_name(reader.root, relative)\n        config.add_manifest(\n            ManifestRecord(\n                manifest_name,\n                relative,\n                \"rust\",\n                as_str(package.get(\"version\")),\n                members,\n            )\n        )\n",
