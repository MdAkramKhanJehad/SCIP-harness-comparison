// file: vvaharness/orchestrator/entry.py, vvaharness/orchestrator/store/_db.py, .env.exploit.example, inputs/remediation_policy.yaml
// `vvaharness scan` CLI: flags, config trust gate + load, step1 overlay resolution, backend configuration,
// exploit-verification gates, preflight, then batch or single-repo scan with exit-code mapping.

@executedBy(CODE) @role(pipeline)
class OrchestratorEntry {

    /** build_parser: the scan flags (each flag is a knob where it changes behaviour). */
    @src("vvaharness/orchestrator/entry.py:140")
    Args buildParser(List<String> argv, Theta θ) {
        Args a = new Args();
        a.repo = argv.opt("--repo");                                                                        // exclusive with --repo-file // src: vvaharness/orchestrator/entry.py:145
        a.repoFile = argv.opt("--repo-file");                                                               // src: vvaharness/orchestrator/entry.py:146
        a.config = θ["cli_flag.config"];                                                                    // src: vvaharness/orchestrator/entry.py:153
        a.repoName = argv.opt("--repo-name");                                                               // src: vvaharness/orchestrator/entry.py:156
        a.applicationId = argv.opt("--application-id");                                                     // src: vvaharness/orchestrator/entry.py:160
        a.workspace = argv.opt("--workspace", "./batch-workspace");                                         // src: vvaharness/orchestrator/entry.py:163
        a.keepClones = argv.flag("--keep-clones");                                                          // src: vvaharness/orchestrator/entry.py:165
        a.groupByApp = θ["cli_flag.group_by_app"];                                                          // src: vvaharness/orchestrator/entry.py:167
        a.resume = θ["cli_flag.resume"];                                                                    // src: vvaharness/orchestrator/entry.py:172
        a.stopAfter = θ["cli_flag.stop_after"];                                                             // one of clone, ev, s0..s11 // src: vvaharness/orchestrator/entry.py:174
        a.s6ProgressFile = argv.flag("--s6-progress-file");                                                 // src: vvaharness/orchestrator/entry.py:182
        a.remediate = θ["cli_flag.remediate"];                                                              // src: vvaharness/orchestrator/entry.py:185
        a.top = θ["cli_flag.top"];                                                                          // N or all/* // src: vvaharness/orchestrator/entry.py:191
        a.force = argv.flag("--force");                                                                     // src: vvaharness/orchestrator/entry.py:198
        a.skipPreflight = θ["cli_flag.skip_preflight"];                                                     // src: vvaharness/orchestrator/entry.py:201
        a.step1Config = θ["cli_flag.step1_config"];                                                         // src: vvaharness/orchestrator/entry.py:204
        a.autoStep1 = argv.flag("--auto-step1");                                                            // exclusive with --no-auto-step1 // src: vvaharness/orchestrator/entry.py:210
        a.noAutoStep1 = argv.flag("--no-auto-step1");                                                       // src: vvaharness/orchestrator/entry.py:217
        return a;
    }

    /** argparse type for --top: a positive integer cap or the all / * wildcard, via the same coercion the standalone remediate command uses; a ValueError becomes an argument-type error. */
    @src("vvaharness/orchestrator/entry.py:63")
    Object topArg(String raw) {
        try {
            return Topspec.coerceTopValue(raw, "--top");                                                    // src: vvaharness/orchestrator/entry.py:67
        } catch (ValueError e) {
            throw new ArgumentTypeError(e.message);                                                         // src: vvaharness/orchestrator/entry.py:69
        }
    }

    @src("vvaharness/orchestrator/entry.py:226")
    int main(List<String> argv, Theta θ) {
        Args args = buildParser(argv, θ);                                                                   // src: vvaharness/orchestrator/entry.py:228
        String repoName = null;
        if (args.repoFile == null) {
            if (!Path.of(args.repo).isDirectory()) return 2;                                               // src: vvaharness/orchestrator/entry.py:235
            repoName = (args.repoName != null && !args.repoName.strip().isEmpty()) ? args.repoName.strip() : Path.of(args.repo).name; // src: vvaharness/orchestrator/entry.py:118
        }
        // Trust gate: a config from INSIDE the scan target is attacker-influenced
        boolean configExplicit = args.config != null;                                                       // src: vvaharness/orchestrator/entry.py:244
        if (!configExplicit) args.config = ConfigPaths.defaultConfig();                                     // ./config.yaml else packaged default // src: vvaharness/orchestrator/entry.py:246
        Config cfg;
        try {
            args.config = ConfigPaths.trustedConfig(args.config, args.repo, configExplicit);                // src: vvaharness/orchestrator/entry.py:249
            cfg = Config.load(args.config, θ["env.VVAHARNESS_NO_LOCAL_CONFIG"] != null);                    // skip config.local.yaml overlay when set // src: vvaharness/config/__init__.py:868
        } catch (ConfigPolicyError e) {
            return 2;                                                                                       // src: vvaharness/orchestrator/entry.py:253
        }
        if (args.s6ProgressFile) cfg.step6Verify.progressFile = true;                                       // src: vvaharness/orchestrator/entry.py:255
        Path cfgDir = Path.of(args.config).parent();                                                        // src: vvaharness/orchestrator/entry.py:257
        Cmdb.setCmdbPath(cfg, cfgDir);                                                                      // src: vvaharness/orchestrator/entry.py:260

        // --no-auto-step1 > --auto-step1 > step1.auto_exclude
        args.autoStep1 = resolveAutoStep1(args.autoStep1, cfg, args.noAutoStep1);                           // src: vvaharness/orchestrator/entry.py:263
        if (args.step1Config != null) {
            if (Config.isNetworkPath(args.step1Config)) return 2;                                           // src: vvaharness/orchestrator/entry.py:270
            Pair<Config, Boolean> applied = Config.applyStep1Overlay(cfg, args.step1Config, true);          // lists APPEND to config step1 // src: vvaharness/orchestrator/entry.py:275
            if (!applied.second) return 2;                                                                  // src: vvaharness/orchestrator/entry.py:279
            cfg = applied.first;
            // --step1-config wins over an enabled auto-derivation
            if (args.autoStep1) args.autoStep1 = false;                                                     // src: vvaharness/orchestrator/entry.py:287
        }
        // CMDB optional: no VulContextSeverity without it
        LlmRegistryConfig.pricingNote(cfg, θ);                                                              // src: vvaharness/orchestrator/entry.py:301

        configureBackends(cfg, cfgDir, θ);                                                                  // src: vvaharness/orchestrator/entry.py:305

        // EV enabled true/false are HARD: a conflicting command line stops the run
        if (EvGateStub.resolutionError(cfg, args, θ) != null) return 2;                       // src: vvaharness/orchestrator/entry.py:308
        Pair<Integer, Collection> gate = evGate(args, cfg, θ);                                              // OFFLINE collection gate, before any model spend // src: vvaharness/orchestrator/entry.py:314
        if (gate.first != null) return gate.first;                                                          // src: vvaharness/orchestrator/entry.py:315

        // Preflight: 'clone'/'ev' need no model backend
        if (!args.skipPreflight && !List.of("clone", "ev").contains(args.stopAfter)) {                      // src: vvaharness/orchestrator/entry.py:319
            try {
                if (!OrchestratorPreflight.checkBackends(cfg, unreachableRoles(args, cfg, θ), θ)) return 1;  // src: vvaharness/orchestrator/entry.py:334
            } catch (KeyboardInterrupt e) {
                return 130;                                                                                 // src: vvaharness/orchestrator/entry.py:338
            }
        }

        if (args.repoFile != null) {
            if (!Path.of(args.repoFile).isFile()) return 2;                                                 // src: vvaharness/orchestrator/entry.py:342
            try {
                return OrchestratorBatch.runBatch(Path.of(args.repoFile), args, cfg, θ);                    // src: vvaharness/orchestrator/entry.py:346
            } catch (StoreError e) {
                return 2;                                                                                   // src: vvaharness/orchestrator/entry.py:350
            }
        }
        try {
            ScanOutcome outcome = OrchestratorScan.run(Path.of(args.repo), repoName, args.applicationId, args, cfg, null, gate.second, θ); // src: vvaharness/orchestrator/entry.py:353
            // must return outcome.exitCode: discarding remediation's code once masked an s10 failure
            return outcome.exitCode;                                                                        // src: vvaharness/orchestrator/entry.py:405
        } catch (KeyboardInterrupt e) { return 130;                                                         // src: vvaharness/orchestrator/entry.py:357
        } catch (AuthenticationError e) { return 1;                                                         // VVAH-E001 not retryable in-process // src: vvaharness/orchestrator/entry.py:366
        } catch (ProxyError e) { return 1;                                                                  // VVAH-E002 configuration fault // src: vvaharness/orchestrator/entry.py:374
        } catch (EVUnreachableError e) { return 2;                                                          // src: vvaharness/orchestrator/entry.py:378
        } catch (EVInputError e) { return 2;                                                                // src: vvaharness/orchestrator/entry.py:382
        } catch (StoreError e) { return 2;                                                                  // src: vvaharness/orchestrator/entry.py:386
        } catch (EmptyScopeError e) { return 2;                                                             // refused pre-spend // src: vvaharness/orchestrator/entry.py:393
        } catch (Exception e) { return 1;                                                                   // src: vvaharness/orchestrator/entry.py:403
        }
    }

    /** Roles this invocation cannot reach, so preflight does not demand their credentials. */
    @src("vvaharness/orchestrator/entry.py:321")
    Set<String> unreachableRoles(Args args, Config cfg, Theta θ) {
        Set<String> skip = (args.repoFile == null && EvGateStub.mayRun(cfg, θ)) ? Set.of() : Set.copyOf(ConfigPaths.EV_MODEL_ROLES); // src: vvaharness/orchestrator/entry.py:321
        boolean remOn = args.remediate || cfg.stepRemediate.enabled;                                        // src: vvaharness/orchestrator/entry.py:326
        if (!(List.of(null, "s10", "s11").contains(args.stopAfter) && remOn)) skip.add("remediate");       // src: vvaharness/orchestrator/entry.py:327
        // kill switch for the fix stage (remediation policy env var)
        if (θ["env.VVAHARNESS_REMEDIATE_DISABLE"] != null) {                                                // src: inputs/remediation_policy.yaml:42
            // unclear: the env var is read by the remediation policy gate (S10), not by entry.py; rendered here as the fix-stage kill switch
            skip.add("remediate");
        }
        boolean valOn = cfg.stepValidate.enabled;                                                           // src: vvaharness/orchestrator/entry.py:330
        if (!(List.of(null, "s11").contains(args.stopAfter) && valOn)) skip.add("validate");               // src: vvaharness/orchestrator/entry.py:331
        return skip;
    }

    @src("vvaharness/orchestrator/entry.py:103")
    boolean resolveAutoStep1(boolean flag, Config cfg, boolean disable) {
        if (disable) return false;                                                                          // src: vvaharness/orchestrator/entry.py:106
        if (flag) return true;                                                                              // src: vvaharness/orchestrator/entry.py:108
        return cfg.step1.autoExclude;                                                                       // src: vvaharness/orchestrator/entry.py:111
    }

    /** OFFLINE exploit-verification collection gate (no network, no model). Returns (exit code or null, collection). */
    @src("vvaharness/orchestrator/entry.py:72")
    Pair<Integer, Collection> evGate(Args args, Config cfg, Theta θ) {
        // Setting EV_API_COLLECTION arms exploit verification
        String path = θ["env.EV_API_COLLECTION"];                                                           // src: vvaharness/orchestrator/entry.py:75
        if (path == null) {
            if (args.stopAfter == "ev" && !args.resume) return new Pair(2, null);                          // src: vvaharness/orchestrator/entry.py:77
            return new Pair(null, null);                                                                    // src: vvaharness/orchestrator/entry.py:82
        }
        if (Config.isNetworkPath(path)) return new Pair(2, null);                                           // src: vvaharness/orchestrator/entry.py:83
        // One target URL cannot cover a batch: batch runs verify nothing
        if (args.repoFile != null) return new Pair(null, null);                                             // src: vvaharness/orchestrator/entry.py:86
        // Target is localhost only; auth strategy blank means no auth
        Options opts = EvGateStub.loadOptions(cfg, θ["env.EV_TARGET_URL"], θ["env.EV_AUTH_STRATEGY"], θ); // src: vvaharness/exploit_verification/options.py:177
        try {
            GateResult result = EvGateStub.runGate(opts, θ);                                   // src: vvaharness/orchestrator/entry.py:93
            return new Pair(null, result.collection);                                                       // src: vvaharness/orchestrator/entry.py:100
        } catch (EVInputError e) {
            return new Pair(2, null);                                                                       // src: vvaharness/orchestrator/entry.py:96
        }
    }

    /** Push the cli: gateway block to the `claude` subprocess route (delegates to OrchestratorPreflight.configureBackends). */
    @src("vvaharness/orchestrator/preflight.py:141")
    void configureBackends(Config cfg, Path cfgDir, Theta θ) {
        OrchestratorPreflight.configureBackends(cfg, cfgDir, θ);                                            // sdk/openai/cache settings // src: vvaharness/orchestrator/preflight.py:99
        if (cfg.cli != null) {
            CliRoute.configure(                                                                             // src: vvaharness/orchestrator/preflight.py:146
                θ["cli.verify_ssl"],                                                                        // src: vvaharness/orchestrator/preflight.py:147
                θ["cli.ca_cert"],                                                                           // src: vvaharness/orchestrator/preflight.py:148
                θ["cli.effort"],                                                                            // global reasoning tier for every cli call // src: vvaharness/orchestrator/preflight.py:151
                θ["cli.restricted"]);                                                                       // --restricted: the only read jail via cli has // src: vvaharness/orchestrator/preflight.py:153
        }
        // cli.mcp_tools: publish stage tools (graph, CweGuidance) to `claude` through an in-process MCP server
        CliRoute.mcpTools = θ["cli.mcp_tools"];                                                             // src: vvaharness/config/__init__.py:671
    }
}

@executedBy(CODE) @role(io)
@src("vvaharness/orchestrator/store/_db.py:72")
class StateStore {

    /** Root of checkpoints and run state; must be outside the scanned repo. */
    Path stateRoot(Theta θ) {
        String env = θ["env.VVAHARNESS_STATE_DIR"];                                                         // src: vvaharness/orchestrator/store/_db.py:72
        return env != null ? Path.of(env) : Path.of("~/.vvaharness/state");                                 // src: vvaharness/orchestrator/store/_db.py:72
    }

    void registerRun(String runId, Path repo, String repoName, String appId) { }
    int resetRun(String runId) { }
    Path ensureStateDir(String kind, String runId, String sub) { }
    void saveCallgraph(String runId, String step, Object snapshot) { }
    Graph loadCallgraph(String runId, String step) { }
    int pruneReplays(String runId, List<Finding> keep) { }
}

