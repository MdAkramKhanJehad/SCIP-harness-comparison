// file: vvaharness/backends/harness/deepagents/options/__init__.py
// Public surface of the deepagents options package (model, graph and subagent-spec builders), plus the
// import-time registration of the "openai" provider profile used by bare-string models that skip build_model.

@executedBy(CODE) @role(config)
class Options {

    // Mirrors build_model's default. The timeout stays unscaled: no effort tier is known at registration time.
    void registerOpenaiProviderProfile(Theta θ) {
        Map<String, Object> initKwargs = Map.of(
            "use_responses_api", θ["code.backends.harness.deepagents.options.openai_profile_use_responses_api"], // src: vvaharness/backends/harness/deepagents/options/__init__.py:43
            "store", θ["code.backends.harness.deepagents.options.openai_profile_store"],                 // src: vvaharness/backends/harness/deepagents/options/__init__.py:44
            "include", RESPONSES_INCLUDE_ENCRYPTED_REASONING,                 // options/model_building     // src: vvaharness/backends/harness/deepagents/options/__init__.py:45
            "timeout", θ["code.deepagents.model_timeout_seconds"]);                                      // src: vvaharness/backends/harness/deepagents/options/__init__.py:46
        registerProviderProfile("openai", new ProviderProfile(initKwargs));                              // src: vvaharness/backends/harness/deepagents/options/__init__.py:39
    }

    // Re-exports: build_model, build_model_cached, build_oneshot_options, build_streaming_agent,
    // release_session, resumable, get_subagent_specs.
    OneShotGraph buildOneshotOptions(OneShotOptions options, Theta θ) {
        return Oneshot.buildOneshotOptions(options, θ);                                                  // src: vvaharness/backends/harness/deepagents/options/__init__.py:28
    }

    List<SubagentSpec> getSubagentSpecs(StreamingOptions options, Theta θ) {
        return Subagents.getSubagentSpecs(options, θ);                                                   // src: vvaharness/backends/harness/deepagents/options/__init__.py:34
    }
}
