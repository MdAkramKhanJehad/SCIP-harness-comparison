  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Trusted, backend-neutral plugin capability protocols.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom enum import StrEnum\nfrom typing import TYPE_CHECKING, Protocol, runtime_checkable\n\nfrom context_graph_sdk.errors import ModelValidationError\nfrom context_graph_sdk.models import CorrelationEdge, GraphMutation\nfrom context_graph_sdk.pipeline.context import CorrelationContext, IndexContext, PluginContext\n\nif TYPE_CHECKING:\n    from context_graph_sdk.discovery.walker import RepositoryWalk\n    from context_graph_sdk.extractors.records import ExtractionResult\n    from context_graph_sdk.project.config import ProjectConfig\n\n\nclass PluginPhase(StrEnum):\n    EXTRACTION = \"extraction\"\n    PRE_DERIVATION = \"pre_derivation\"\n    POST_DERIVATION = \"post_derivation\"\n    CORRELATION = \"correlation\"\n    INDEX = \"index\"\n\n\n_PHASE_ORDER = {phase: index for index, phase in enumerate(PluginPhase)}\n\n\n@dataclass(frozen=True)\nclass PluginMetadata:\n    phase: PluginPhase\n    priority: int\n    name: str\n    version: str\n\n    def __post_init__(self) -> None:\n        if not self.name or not self.version:\n            raise ModelValidationError(\"plugin name and version are required\")\n\n    @property\n    def ordering_key(self) -> tuple[int, int, str]:\n        return (_PHASE_ORDER[self.phase], self.priority, self.name)\n\n\n@runtime_checkable\nclass LanguageExtractor(Protocol):\n    \"\"\"Trusted repository language-extraction capability.\"\"\"\n\n    @property\n    def metadata(self) -> PluginMetadata: ...\n\n    @property\n    def languages(self) -> tuple[str, ...]: ...\n\n    def extract(self, repository: RepositoryWalk) -> ExtractionResult: ...\n\n\n@runtime_checkable\nclass ProjectExtractor(Protocol):\n    \"\"\"Trusted repository manifest/configuration extraction capability.\"\"\"\n\n    @property\n    def metadata(self) -> PluginMetadata: ...\n\n    def extract(self, repository: RepositoryWalk) -> ProjectConfig: ...\n\n\n@runtime_checkable\nclass GraphEnricher(Protocol):\n    \"\"\"Trusted enrichment capability; deadlines are cooperative.\"\"\"\n\n    @property\n    def metadata(self) -> PluginMetadata: ...\n\n    def enrich(self, context: PluginContext) -> GraphMutation: ...\n\n\n@runtime_checkable\nclass CorrelationProvider(Protocol):\n    \"\"\"Trusted correlation capability; deadlines are cooperative.\"\"\"\n\n    @property\n    def metadata(self) -> PluginMetadata: ...\n\n    def correlate(self, context: CorrelationContext) -> tuple[CorrelationEdge, ...]: ...\n\n\n@runtime_checkable\nclass IndexProvider(Protocol):\n    @property\n    def metadata(self) -> PluginMetadata: ...\n\n    def build(self, context: IndexContext) -> None: ...\n",
