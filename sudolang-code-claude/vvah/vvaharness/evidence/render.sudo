# vvaharness/evidence/render.py

Turns `ThreatEvidence` into the text blocks of the Stage 2 user prompt.

Source: `vvaharness/evidence/render.py` (lines 1-91)
Executor: code
Called from: `vvaharness/pipeline/stages/s2/prompts.py` _build_user_prompt

// src: vvaharness/evidence/render.py:21-91
RenderBlocks {
  render_language_block(ev) = "  - $lang: $n files" per language, or "  (none detected)"
  render_components_block(ev) = "  - $dir/" per top directory, or "  (flat repo)"
  render_inventory_block(ev) = file names grouped by directory (root shown as "(repo root)"), sorted; "  (no files in scope)" when empty; "  …(truncated)" appended when ev.inventory_truncated
  render_modules_block(ev) = "  - $name  ($loc LOC) — $purpose", or "  (s1 emitted no modules)"; "  …(truncated)" when truncated
  render_entry_points_block(ev, stride_by_kind) = "  - [$kind] UNAUTH|auth  STRIDE:${stride_by_kind[kind] or \"T I\"}  $file::$func", or "  (s1 emitted no entry points)"; "  …(truncated)" when truncated
  render_config_reps_block(ev) = "  === $rel ===\n$body" when a body exists, else "  - $rel"; "  (none)" when empty
  render_api_artefacts_block(ev) = "  - $path" each, or "  (none)"
  render_docs_block(ev) = "=== $name ===\n$body" each, or "(no README / SECURITY / ARCHITECTURE docs found)"
  render_manifests_block(ev) = "=== $name ===\n$body" each, or "(no build/dependency manifests found)"
}
