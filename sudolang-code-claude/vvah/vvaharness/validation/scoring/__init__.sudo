# vvaharness/validation/scoring/__init__.py

Public scoring entry point. Parses the raw gate dictionaries from `synthesized_gates.json`, runs the scoring engine against the policy, and returns the score, the decision, the justification and the gates.

Source: `vvaharness/validation/scoring/__init__.py` (lines 1-86)
Executor: code
Called from: `vvaharness/validation/io/_host_score.sudo` verdict_for

// src: vvaharness/validation/scoring/__init__.py:73-86
fn score_fix(gates, policy?):executor=code {
  config = _config_for(policy)
  parsed = for each gate in gates: scoring._engine.parse_raw_criterion(gate, config.criterion_name_field)   // field "gate_name"
  result = scoring._engine.score(config, parsed)
  return ValidationScore {
    raw_score: result.raw_score, decision: result.decision, justification: result.justification,
    gates: for each criterion in parsed: GateAssessment(name, GateStatus(status), summary, details, evidence),
    has_critical_failure: _has_critical_failure(config, parsed)
  }
}

// src: vvaharness/validation/scoring/__init__.py:41-51
fn _config_for(policy):executor=code {
  if (policy == null || policy == FIX_POLICY) return FIX_CONFIG
  return ScoringConfig.from_policy(policy, name="fix", criterion_name_field="gate_name", status_multiplier=STATUS_MULTIPLIER, justify=build_fix_justification)
}

// src: vvaharness/validation/scoring/__init__.py:54-59
fn _has_critical_failure(config, parsed):executor=code {
  return any criterion where name in config.critical_criteria && status in { "partial", "fail" }
}
