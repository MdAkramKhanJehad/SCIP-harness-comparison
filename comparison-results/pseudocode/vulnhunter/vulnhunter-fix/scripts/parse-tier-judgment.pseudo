// file: vulnhunter-fix/scripts/parse-tier-judgment.py
// Parses the tier_judgment model output: first non-comment line is the primary JSON, validated against the
// tierJudgment $def of references/result-schema.json; an optional TIER_JUDGMENT_SIDECAR comment block is split out.

@executedBy(CODE) @role(evaluation) @stage("fix")
class ParseTierJudgment {

    // tier_judgment.pseudo calls run(rawText, phase)
    Map run(String raw, String phase, Theta θ) {
        Pair<Map, Map> ps = parse(raw);                                                                    // src: vulnhunter-fix/scripts/parse-tier-judgment.py:104
        List<Error> errors = loadTierJudgmentValidator().iterErrors(ps.first);                             // src: vulnhunter-fix/scripts/parse-tier-judgment.py:110
        return Map.of("ok", errors.isEmpty(), "primary", ps.first, "sidecar", ps.second, "errors", errors);
    }

    Validator loadTierJudgmentValidator() {
        Map schema = Json.parse(Files.read(skillRoot().join("references", "result-schema.json")));        // src: vulnhunter-fix/scripts/parse-tier-judgment.py:44
        Map defs = schema.getOr("$defs", Map.of());
        if (!defs.containsKey("tierJudgment")) throw new RuntimeError("result-schema.json missing tierJudgment $def"); // src: vulnhunter-fix/scripts/parse-tier-judgment.py:47
        // terminal tier in FULL | MITIGATION | WORKAROUND | null; rationale xor failure_reason (REQ-HON-013..016)
        return Draft202012Validator.of(Map.of("$ref", "#/$defs/tierJudgment", "$defs", defs));            // src: vulnhunter-fix/scripts/parse-tier-judgment.py:49
    }

    Pair<Map, Map> parse(String raw) {
        List<String> lines = raw.strip().lines();
        if (lines.isEmpty()) throw new ValueError("empty input");                                          // src: vulnhunter-fix/scripts/parse-tier-judgment.py:58
        String primaryLine = null;
        for (String line : lines) {
            String s = line.strip();
            if (s.isEmpty() || s.startsWith("<!--")) continue;                                             // src: vulnhunter-fix/scripts/parse-tier-judgment.py:64
            primaryLine = s;
            break;
        }
        if (primaryLine == null) throw new ValueError("no primary JSON line found");                       // src: vulnhunter-fix/scripts/parse-tier-judgment.py:69
        Map primary;
        try {
            primary = Json.parse(primaryLine);                                                             // src: vulnhunter-fix/scripts/parse-tier-judgment.py:72
        } catch (JSONDecodeError e) {
            throw new ValueError("primary line is not valid JSON");                                        // src: vulnhunter-fix/scripts/parse-tier-judgment.py:74
        }
        Map sidecar = Map.of();
        Match m = Regex.searchDotall("<!--\\s*TIER_JUDGMENT_SIDECAR:\\s*(<json object>)\\s*-->", raw);     // src: vulnhunter-fix/scripts/parse-tier-judgment.py:37
        if (m != null) {
            try {
                sidecar = Json.parse(m.group(1));                                                          // src: vulnhunter-fix/scripts/parse-tier-judgment.py:80
            } catch (JSONDecodeError e) {
                throw new ValueError("sidecar block is not valid JSON");                                   // src: vulnhunter-fix/scripts/parse-tier-judgment.py:82
            }
        }
        return Pair.of(primary, sidecar);
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                       // src: vulnhunter-fix/scripts/parse-tier-judgment.py:87
        String raw;
        if (args.input != null) {
            try {
                raw = Files.read(args.input);                                                              // src: vulnhunter-fix/scripts/parse-tier-judgment.py:96
            } catch (OSError e) {
                return 2;                                                                                  // src: vulnhunter-fix/scripts/parse-tier-judgment.py:99
            }
        } else {
            raw = Stdin.read();                                                                            // src: vulnhunter-fix/scripts/parse-tier-judgment.py:101
        }
        Pair<Map, Map> ps;
        try {
            ps = parse(raw);                                                                               // src: vulnhunter-fix/scripts/parse-tier-judgment.py:104
        } catch (ValueError e) {
            return 2;                                                                                      // src: vulnhunter-fix/scripts/parse-tier-judgment.py:107
        }
        List<Error> errors = loadTierJudgmentValidator().iterErrors(ps.first).sortedBy(e -> e.absolutePath); // src: vulnhunter-fix/scripts/parse-tier-judgment.py:110
        if (!errors.isEmpty()) return 1;                                                                   // src: vulnhunter-fix/scripts/parse-tier-judgment.py:115
        if (args.sidecarOut != null) {
            try {
                Files.write(args.sidecarOut, Json.dump(ps.second));                                        // src: vulnhunter-fix/scripts/parse-tier-judgment.py:119
            } catch (OSError e) {
                return 2;                                                                                  // src: vulnhunter-fix/scripts/parse-tier-judgment.py:124
            }
        }
        print(Json.dump(ps.first));                                                                        // src: vulnhunter-fix/scripts/parse-tier-judgment.py:126
        return 0;
    }
}
