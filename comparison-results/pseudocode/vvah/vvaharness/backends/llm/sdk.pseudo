    /** One truncation check for an agentic reply: a doubled-budget retry bounded by the model cap, else E005. Returns (msg, override text). */
    @src("vvaharness/backends/llm/sdk.py:1068")
    Pair checkAgenticStop(Message msg, Object client, List<Map> messages, Map callKw, String model, String tag, int requested, Schema responseModel, boolean dispatchable, String effort, Double requestTimeout, Double sessionT0, Double sessionBudget) {
        if (!LlmModels.finishTruncated(msg.stopReason)) return Pair.of(msg, null);                          // src: vvaharness/backends/llm/sdk.py:1077
        Integer retryAt = LlmModels.truncationRetryMax(requested, DeepagentsLimits.MODEL_MAX_OUTPUT_TOKENS); // src: vvaharness/backends/llm/sdk.py:1079
        if (retryAt != null) {                                                                              // src: vvaharness/backends/llm/sdk.py:1080
            Counters.bump(LlmModels.TRUNCATED_RETRY_ATTEMPTED_COUNTER, 1);                                  // src: vvaharness/backends/llm/sdk.py:1081
            Errlog.log(tag != null ? tag : "sdk", tag != null ? tag : "truncation", "VVAH-E005 warning: agentic reply truncated; retrying once at a doubled budget", true, Map.of("error_code", TruncatedResponseError.errorCode)); // src: vvaharness/backends/llm/sdk.py:1085
            Map retryKw = callKw.with("max_tokens", retryAt);                                               // src: vvaharness/backends/llm/sdk.py:1090
            Message retried;
            try {
                double t0 = Clock.monotonic();                                                              // src: vvaharness/backends/llm/sdk.py:1092
                Map send = LlmModels.turnOptions(sessionT0 != null ? sessionT0 : t0, sessionBudget, requestTimeout); // src: vvaharness/backends/llm/sdk.py:1093
                retried = drainWithinDeadline(client.withOptions(send).messages.stream(withCacheMarker(client, messages), retryKw), t0 + send.get("timeout"), tag, effort, requestTimeout); // src: vvaharness/backends/llm/sdk.py:1095
                LlmModels.noteBudgetUse(Clock.monotonic() - t0, requestTimeout, effort);                    // src: vvaharness/backends/llm/sdk.py:1100
            } catch (ApiStatusError e) {
                if (authFailureSdk(e)) throw new AuthenticationError(Redact.redact(e.message, false, null).substring(0, 400), e.statusCode, "sdk"); // auth-first: VVAH-E001, not a raw SDK exception // src: vvaharness/backends/llm/sdk.py:1104
                String low = LlmModels.rejectionText(e).lower();                                            // src: vvaharness/backends/llm/sdk.py:1109
                if (LlmModels.PARAM_REJECTION_STATUS.contains(e.statusCode) && CTX_OVERFLOW_RX.search(low)) { // the doubled budget pushed input+output over the context window // src: vvaharness/backends/llm/sdk.py:1110
                    Counters.bump(LlmModels.TRUNCATED_REPLIES_COUNTER, 1);                                  // src: vvaharness/backends/llm/sdk.py:1115
                    throw new TruncatedResponseError("agentic reply hit the output-token budget, and the doubled-budget retry would overflow the context window; no useful retry", tag != null ? tag : "", requested, 0, null, null, null); // not useful to retry a retry // src: vvaharness/backends/llm/sdk.py:1116
                }
                throw new RuntimeError(Redact.redact("Anthropic SDK agentic truncation-retry failed (status=" + e.statusCode + ")", false, null)); // src: vvaharness/backends/llm/sdk.py:1121
            } catch (ApiConnectionError | TransportError e) {                                               // src: vvaharness/backends/llm/sdk.py:1125
                if (ResponseQuality.isTimeoutFailure(e, null)) throw LlmModels.callTimeoutError(tag != null ? tag : "", "sdk", requestTimeout, effort, "Anthropic SDK agentic truncation-retry exceeded the request timeout"); // src: vvaharness/backends/llm/sdk.py:1126
                Exception proxy = LlmModels.proxyError(e, "sdk");                                           // src: vvaharness/backends/llm/sdk.py:1131
                if (proxy != null) throw proxy;                                                             // src: vvaharness/backends/llm/sdk.py:1133
                throw new RuntimeError(Redact.redact("Anthropic SDK agentic truncation-retry connection error", false, null)); // src: vvaharness/backends/llm/sdk.py:1135
            }
            if (retried.usage != null) {                                                                    // src: vvaharness/backends/llm/sdk.py:1139
                Map retriedUsage = retried.usage.modelDump();
                noteUnparsedCacheKeys(retriedUsage);                                                        // src: vvaharness/backends/llm/sdk.py:1141
                TokenCounter.add(retriedUsage, null, null);                                                 // src: vvaharness/backends/llm/sdk.py:1142
            }
            if (LlmModels.finishTruncated(retried.stopReason)) {                                            // src: vvaharness/backends/llm/sdk.py:1144
                Counters.bump(LlmModels.TRUNCATED_REPLIES_COUNTER, 1);                                      // src: vvaharness/backends/llm/sdk.py:1145
                throw new TruncatedResponseError("agentic reply still hit the output-token budget after the doubled retry", tag != null ? tag : "", requested, retryAt, null, null, null); // src: vvaharness/backends/llm/sdk.py:1146
