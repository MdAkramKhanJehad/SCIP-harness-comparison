// file: vvaharness/remediation_agent/policy/workflow_refs.py
// Fail-closed validation of S10 edits to reusable GitHub workflow refs ("uses: org/repo/.github/workflows/x.yml@ref"):
// a newly introduced ref must be a full, non-placeholder commit SHA already present in the pre-edit snapshot.

@executedBy(CODE) @role(rule_set) @stage("S10")
class WorkflowRefs {

    List<String> workflowSnapshotPaths(String repo, Theta θ) {
        Path root = Path.of(repo).join(θ["code.remediation_agent.policy.workflow_refs.workflow_dir"]); // src: vvaharness/remediation_agent/policy/workflow_refs.py:36
        if (!root.isDir()) return List.of();                                                        // src: vvaharness/remediation_agent/policy/workflow_refs.py:37
        try {
            return root.glob("*.yml").plus(root.glob("*.yaml")).filter(p -> p.isFile()).map(p -> p.relativeTo(repo).asPosix()).sorted(); // src: vvaharness/remediation_agent/policy/workflow_refs.py:40
        } catch (OSError e) {
            return List.of();                                                                       // src: vvaharness/remediation_agent/policy/workflow_refs.py:47
        }
    }

    Map<String, List<String>> introducedUnsafeWorkflowRefs(String repo, Map<String, String> before, Theta θ) {
        // Accept only a 40-hex SHA already in the PRE-EDIT snapshot; pre-existing unsafe refs are ignored.
        Map<String, String> snapshot = before != null ? before : Map.of();                          // src: vvaharness/remediation_agent/policy/workflow_refs.py:55
        Map<String, Set<String>> trusted = new Map();
        Map<String, Counter> prior = new Map();
        for (String rawPath : snapshot.keys()) {                                                    // src: vvaharness/remediation_agent/policy/workflow_refs.py:58
            String path = Diff.normPath(rawPath);
            String text = snapshot.get(rawPath);
            if (!isWorkflowPath(path, θ) || text == null) continue;                                 // src: vvaharness/remediation_agent/policy/workflow_refs.py:60
            List<Pair<String, String>> refs = references(text);                                     // src: vvaharness/remediation_agent/policy/workflow_refs.py:62
            prior.put(path, Counter.of(refs));                                                      // src: vvaharness/remediation_agent/policy/workflow_refs.py:63
            for (Pair<String, String> r : refs) {
                if (isNonplaceholderSha(r.second, θ)) trusted.get(r.first.casefold()).add(r.second.casefold()); // src: vvaharness/remediation_agent/policy/workflow_refs.py:65
            }
        }
        Set<String> currentPaths = Set.of(workflowSnapshotPaths(repo, θ));                          // src: vvaharness/remediation_agent/policy/workflow_refs.py:68
        currentPaths.addAll(snapshot.keys().filter(p -> isWorkflowPath(p, θ)));                     // src: vvaharness/remediation_agent/policy/workflow_refs.py:69
        Map<String, List<String>> issues = new Map();
        for (String path : currentPaths.sorted()) {                                                 // src: vvaharness/remediation_agent/policy/workflow_refs.py:71
            Path target = Diff.safeRepoPath(repo, path);                                            // src: vvaharness/remediation_agent/policy/workflow_refs.py:72
            if (target == null) continue;                                                           // src: vvaharness/remediation_agent/policy/workflow_refs.py:74
            String current;
            try {
                current = target.isFile() ? target.readText() : "";                                 // src: vvaharness/remediation_agent/policy/workflow_refs.py:76
            } catch (OSError e) {
                continue;                                                                           // src: vvaharness/remediation_agent/policy/workflow_refs.py:78
            }
            Counter previous = prior.getOr(path, new Counter());
            Counter seen = new Counter();
            for (Pair<String, String> key : references(current)) {                                  // src: vvaharness/remediation_agent/policy/workflow_refs.py:81
                seen.inc(key);
                if (seen.get(key) <= previous.get(key)) continue;                                   // src: vvaharness/remediation_agent/policy/workflow_refs.py:84  (occurrence already existed pre-edit)
                String reason = unsafeReason(key.first, key.second, trusted, θ);                    // src: vvaharness/remediation_agent/policy/workflow_refs.py:86
                if (!reason.isEmpty()) issues.getOrPut(path, new List()).add(key.first + "@" + key.second + " (" + reason + ")"); // src: vvaharness/remediation_agent/policy/workflow_refs.py:88
            }
        }
        return issues;                                                                              // src: vvaharness/remediation_agent/policy/workflow_refs.py:90
    }

    List<Pair<String, String>> references(String text) {
        // (?im)^ optional "- " uses: <owner/repo>/.github/workflows/<name>.y(a)ml@<ref>
        return Regex.finditer("uses: <workflow>/.github/workflows/<file>.ya?ml@<ref>", text).map(m -> new Pair(m.group("workflow"), m.group("ref"))); // src: vvaharness/remediation_agent/policy/workflow_refs.py:94
    }

    boolean isWorkflowPath(String path, Theta θ) {
        String folded = path.casefold();                                                            // src: vvaharness/remediation_agent/policy/workflow_refs.py:101
        return folded.startsWith(θ["code.remediation_agent.policy.workflow_refs.workflow_dir"]) && (folded.endsWith(".yml") || folded.endsWith(".yaml")); // src: vvaharness/remediation_agent/policy/workflow_refs.py:102
    }

    boolean isNonplaceholderSha(String ref, Theta θ) {
        // Placeholder = all one character (e.g. 0000...0).
        return Regex.fullmatch("[0-9a-fA-F]{40}", ref) && (!θ["code.remediation_agent.policy.workflow_refs.reject_placeholder_sha"] || Set.of(ref.casefold().chars()).size() > 1); // src: vvaharness/remediation_agent/policy/workflow_refs.py:106
    }

    String unsafeReason(String workflow, String ref, Map<String, Set<String>> trusted, Theta θ) {
        if (!Regex.fullmatch("[0-9a-fA-F]{40}", ref)) return "not an immutable 40-character commit SHA"; // src: vvaharness/remediation_agent/policy/workflow_refs.py:112
        if (!isNonplaceholderSha(ref, θ)) return "placeholder commit SHA";                          // src: vvaharness/remediation_agent/policy/workflow_refs.py:114
        if (θ["code.remediation_agent.policy.workflow_refs.require_preexisting_sha"] && !trusted.getOr(workflow.casefold(), Set.of()).contains(ref.casefold())) { // src: vvaharness/remediation_agent/policy/workflow_refs.py:116
            return "commit SHA is not established by the pre-edit repository";                      // src: vvaharness/remediation_agent/policy/workflow_refs.py:117
        }
        return "";                                                                                  // src: vvaharness/remediation_agent/policy/workflow_refs.py:118
    }
}
