// file: vvaharness/remediation_agent/interactive/keys.py
// Dependency-free terminal key input: decode a raw key sequence to UP/DOWN/ENTER/QUIT/OTHER and read one raw keypress.

@executedBy(CODE) @role(types)
enum KeyToken { UP, DOWN, ENTER, QUIT, OTHER }

@executedBy(CODE) @role(io) @stage("S10")
class Keys {

    KeyToken decodeKey(String seq) {
        if (List.of("ESC[A", "ESC OA", "k").contains(seq)) return UP;                               // src: vvaharness/remediation_agent/interactive/keys.py:26  (arrow up / vi k)
        if (List.of("ESC[B", "ESC OB", "j").contains(seq)) return DOWN;                             // src: vvaharness/remediation_agent/interactive/keys.py:28
        if (List.of("CR", "LF").contains(seq)) return ENTER;                                        // src: vvaharness/remediation_agent/interactive/keys.py:30
        if (List.of("q", "Q", "ESC", "Ctrl-C", "Ctrl-D").contains(seq)) return QUIT;                // src: vvaharness/remediation_agent/interactive/keys.py:32
        return OTHER;                                                                               // src: vvaharness/remediation_agent/interactive/keys.py:34
    }

    KeyToken readKey() {
        // Raises on a non-TTY stream: that is how the loop falls back to the numbered prompt.
        if (Sys.platform.equals("win32")) {                                                         // src: vvaharness/remediation_agent/interactive/keys.py:39
            if (!Msvcrt.available()) throw new RuntimeError("no raw keyboard input");               // src: vvaharness/remediation_agent/interactive/keys.py:43
            String ch = Msvcrt.getwch();                                                            // src: vvaharness/remediation_agent/interactive/keys.py:44
            if (List.of("NUL", "0xE0").contains(ch)) {                                              // src: vvaharness/remediation_agent/interactive/keys.py:45  (Windows arrow prefix)
                String ch2 = Msvcrt.getwch();
                return ch2.equals("H") ? UP : (ch2.equals("P") ? DOWN : OTHER);                     // src: vvaharness/remediation_agent/interactive/keys.py:47
            }
            return decodeKey(ch);                                                                   // src: vvaharness/remediation_agent/interactive/keys.py:48
        }
        if (!Stdin.isatty()) throw new RuntimeError("stdin is not a TTY");                          // src: vvaharness/remediation_agent/interactive/keys.py:52
        Object old = Termios.getattr(Stdin.fd);                                                     // src: vvaharness/remediation_agent/interactive/keys.py:55
        try {
            Tty.setraw(Stdin.fd);                                                                   // src: vvaharness/remediation_agent/interactive/keys.py:57
            String ch = Stdin.read(1);
            if (ch.equals("ESC")) ch = ch + Stdin.read(2);                                          // src: vvaharness/remediation_agent/interactive/keys.py:59  (escape sequence)
            return decodeKey(ch);                                                                   // src: vvaharness/remediation_agent/interactive/keys.py:61
        } finally {
            Termios.setattr(Stdin.fd, old);                                                         // src: vvaharness/remediation_agent/interactive/keys.py:63
        }
    }
}
