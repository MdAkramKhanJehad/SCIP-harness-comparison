// file: vulnhunt/phases/phase4_report.md
// Phase 4: compile the final report (summary table, per-finding detail, code smells, sweep table,
// README entry point with exact header, links, cross-check) and apply the What-NOT-to-Report filter.

@executedBy(MODEL) @role(prompt) @stage("phase4")
class Phase4Report {

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context("All phases complete; compile confirmed findings, code smells, resolved input inventory"); // src: vulnhunt/phases/phase4_report.md:3
        p.format(θ["prompt.report_format"]);                                               // src: vulnhunt/phases/phase4_report.md:1
        if (θ["p.phase4_report.findings_describe_scan_time_source"]) p.must("All findings describe the original source as it existed at scan time; the audit does not modify source"); // src: vulnhunt/phases/phase4_report.md:8
        p.choose(θ["p.phase4_report.report_severity_values"]);                             // src: vulnhunt/phases/phase4_report.md:32
        p.choose(θ["p.phase4_report.report_status_values"]);                               // src: vulnhunt/phases/phase4_report.md:32
        p.rule(θ["prompt.scope.dependency_cves"]);                                         // src: vulnhunt/phases/phase4_report.md:178
        return p;
    }

    // ---------------------------------------------------------------- procedure

    @executedBy(MODEL)
    Report run(Phase3Result p3, SweepTable sweep, Inventory inventory, KickoffMetadata meta, Theta θ) {
        List<Finding> findings = Phase4ReportExclusions.filter(p3.allFindings(), θ);
        findings = validate(findings, θ);
        Report r = new Report();
        r.add(summary(findings, θ));
        if (θ["p.phase4_report.per_finding_full_detail"]) {                                // src: vulnhunt/phases/phase4_report.md:35
            for (Finding f : findings) r.add(detail(f, θ));
        }
        r.add(Phase4ReportCodeSmells.section(p3.codeSmells(), inventory, θ));
        if (θ["p.phase4_report.include_sweep_table_after_smells"]) r.add(sweep.finalTable()); // src: vulnhunt/phases/phase4_report.md:101
        saveArtifacts(r, θ);
        Phase4ReportReadme.generate(r, findings, inventory, meta, θ);
        return r;
    }

    @executedBy(MODEL)
    List<Finding> validate(List<Finding> findings, Theta θ) {
        List<Finding> out = new List();
        for (Finding f : findings) {
            if (θ["p.phase4_report.cwe_required_most_specific"]) f.cwe = mostSpecificCwe(f); // src: vulnhunt/phases/phase4_report.md:57
            if (θ["p.phase4_report.validation_rule_poc_and_test_fields"]) {               // src: vulnhunt/phases/phase4_report.md:60
                boolean invalid = isEmptyNaOrSeeAbove(f.pocPath) || isEmptyNaOrSeeAbove(f.exploitTestPath); // src: vulnhunt/phases/phase4_report.md:61
                if (invalid) { f.set(θ["p.phase4_report.no_artifact_downgrade_to_potential"]); continue; } // src: vulnhunt/phases/phase4_report.md:62
            }
            out.add(f);
        }
        return out;
    }

    @executedBy(MODEL)
    Section summary(List<Finding> findings, Theta θ) {
        Section s = new Section("Summary");
        if (!θ["p.phase4_report.report_starts_with_summary_table"]) return s;             // src: vulnhunt/phases/phase4_report.md:17
        Table t = new Table(θ["p.phase4_report.summary_table_columns"]);                   // src: vulnhunt/phases/phase4_report.md:30
        Finding platform = findings.find(f -> f.isPlatformAuth());
        if (platform != null && θ["p.phase4_report.platform_row_leads_summary"]) {         // src: vulnhunt/phases/phase4_report.md:21
            t.addRow(platform);
            platform.body.listSubsumed(θ["p.phase4_report.platform_body_lists_subsumed"]); // src: vulnhunt/phases/phase4_report.md:23
        }
        for (Finding f : findings) {
            if (f == platform) continue;
            if (f.isSubsumed() && θ["p.phase4_report.subsumed_no_summary_rows"]) continue; // src: vulnhunt/phases/phase4_report.md:25
            if (θ["p.phase4_report.each_confirmed_instance_separate_finding"]) {          // src: vulnhunt/phases/phase4_report.md:11
                for (Instance i : f.confirmedInstances()) {
                    if (θ["p.phase4_report.summary_one_row_per_exploit_pass"] && i.exploitTest != PASS) continue; // src: vulnhunt/phases/phase4_report.md:18
                    t.addRow(i.asOwnVulnEntry());
                }
            } else {
                t.addRow(f);
            }
        }
        s.add(t);
        return s;
    }

    @executedBy(MODEL)
    Section detail(Finding f, Theta θ) {
        Table d = new Table("Field", "Value");
        if (θ["p.phase4_report.detail_field_title"]) d.row("Title", f.title);              // src: vulnhunt/phases/phase4_report.md:40
        if (θ["p.phase4_report.detail_field_input"]) d.row("Input", f.inventoryNumber + " " + f.inputDescription); // src: vulnhunt/phases/phase4_report.md:41
        if (θ["p.phase4_report.detail_field_cwe"]) d.row("CWE", f.cwe + ": " + f.cweName); // src: vulnhunt/phases/phase4_report.md:42
        if (θ["p.phase4_report.detail_field_severity"]) d.row("Severity", f.severity);     // src: vulnhunt/phases/phase4_report.md:43
        if (θ["p.phase4_report.detail_field_location"]) d.row("Location", f.primaryFileLine); // src: vulnhunt/phases/phase4_report.md:44
        if (θ["p.phase4_report.detail_field_entry_point"]) d.row("Entry Point", f.entryPoint); // src: vulnhunt/phases/phase4_report.md:45
        if (θ["p.phase4_report.detail_field_data_flow"]) d.row("Data Flow", f.sourceToSink()); // src: vulnhunt/phases/phase4_report.md:46
        if (θ["p.phase4_report.detail_field_poc_path"]) d.row("PoC", f.pocPath);           // src: vulnhunt/phases/phase4_report.md:47
        if (θ["p.phase4_report.detail_field_exploit_test"]) d.row("Exploit Test", f.exploitTestPath + " " + f.testResult + " " + f.testReason); // src: vulnhunt/phases/phase4_report.md:48
        if (θ["p.phase4_report.detail_field_fix"]) d.row("Fix", f.fixDiffOrLink);          // src: vulnhunt/phases/phase4_report.md:49
        if (θ["p.phase4_report.detail_field_root_cause"] && f.inSweepGroup()) d.row("Root Cause", f.sharedRootCause); // src: vulnhunt/phases/phase4_report.md:50
        if (θ["p.phase4_report.detail_field_status"]) d.row("Status", f.status);           // src: vulnhunt/phases/phase4_report.md:51
        if (θ["p.phase4_report.detail_field_trust_model_conditional"] && f.underAuthzDelegationRule() && (f.severity == INFORMATIONAL || f.severity == MEDIUM)) d.row("Trust Model", f.trustModelNote); // src: vulnhunt/phases/phase4_report.md:53
        return new Section("[" + f.id + "] " + f.title, d);
    }

    @executedBy(MODEL)
    void saveArtifacts(Report r, Theta θ) {
        Path dir = θ["p.phase4_report.artifacts_saved_under_vulnhunt_dir"];               // src: vulnhunt/phases/phase4_report.md:106
        // layout: README.md (generated last), poc/VULN-NNN_*.md, exploit_tests/test_vuln_NNN_*
        r.ensureLayout(dir, "README.md", "poc/", "exploit_tests/");                       // src: vulnhunt/phases/phase4_report.md:108
    }
}

@executedBy(MODEL) @role(step) @stage("phase4")
class Phase4ReportCodeSmells {

    @executedBy(MODEL)
    Section section(List<Finding> failedTestSmells, Inventory inv, Theta θ) {
        List<Smell> smells = new List(failedTestSmells);
        if (θ["p.phase4_report.code_smell_generation_mandatory"]) smells.addAll(generate(inv, θ)); // src: vulnhunt/phases/phase4_report.md:88
        Section s = new Section(θ["p.phase4_report.code_smell_section_heading"]);         // src: vulnhunt/phases/phase4_report.md:67
        if (!θ["p.phase4_report.code_smells_separate_section"]) s = Section.inline();      // src: vulnhunt/phases/phase4_report.md:65
        for (Smell sm : smells) {
            Table t = new Table(θ["p.phase4_report.code_smell_table_fields"]);             // src: vulnhunt/phases/phase4_report.md:80
            if (θ["p.phase4_report.code_smell_downgrade_rationale_required"]) {           // src: vulnhunt/phases/phase4_report.md:69
                if (θ["p.phase4_report.rationale_which_gate_or_defense"]) t.add("Downgrade reason", sm.failedGateOrBlockingDefense()); // src: vulnhunt/phases/phase4_report.md:70
                if (θ["p.phase4_report.rationale_specific_evidence"]) t.add("Downgrade reason", sm.mitigationFileLineOrTestOutput()); // src: vulnhunt/phases/phase4_report.md:71
                if (θ["p.phase4_report.rationale_condition_for_exploitability"]) t.add("Risk if conditions change", sm.conditionToBecomeExploitable()); // src: vulnhunt/phases/phase4_report.md:73
            }
            if (θ["p.phase4_report.code_smells_no_ids_or_poc_files"]) { sm.vulnId = null; sm.pocFile = null; } // src: vulnhunt/phases/phase4_report.md:86
            s.add(t);
        }
        return s;
    }

    // Code smell generation: systematic review of sources beyond failed exploit tests
    @executedBy(MODEL)
    List<Smell> generate(Inventory inv, Theta θ) {
        List<Smell> out = new List();
        if (θ["p.phase4_report.smell_source_gate2b_near_misses"]) out.addAll(inv.gate2bNearMisses().filter(s -> s.sanitizerFragile())); // src: vulnhunt/phases/phase4_report.md:93
        if (θ["p.phase4_report.smell_source_gate1_near_misses"]) out.addAll(inv.gate1NearMisses().filter(s -> s.onlyDevOnlyGuard())); // src: vulnhunt/phases/phase4_report.md:94
        if (θ["p.phase4_report.smell_source_security_config"]) out.addAll(securityConfigGaps("SameSite", "trust proxy", "security headers")); // src: vulnhunt/phases/phase4_report.md:95
        if (θ["p.phase4_report.smell_source_crypto_inventory"]) out.addAll(inv.cryptoInventory().filter(c -> c.weak() && !c.prerequisiteMet())); // src: vulnhunt/phases/phase4_report.md:96
        if (θ["p.phase4_report.smell_source_defense_in_depth_gaps"]) out.addAll(serviceFunctionsRelyingOnCallerSanitization()); // src: vulnhunt/phases/phase4_report.md:97
        for (Smell s : out) s.fields(θ["p.phase4_report.smell_entry_fields"]);             // src: vulnhunt/phases/phase4_report.md:99
        return out;
    }
}

@executedBy(MODEL) @role(step) @stage("phase4")
class Phase4ReportReadme {

    @executedBy(MODEL)
    void generate(Report r, List<Finding> findings, Inventory inv, KickoffMetadata meta, Theta θ) {
        if (θ["p.phase4_report.readme_generated_last"] && !r.allFindingsFinal()) return; // src: vulnhunt/phases/phase4_report.md:109
        Readme md = new Readme(θ["p.phase4_report.readme_is_entry_point"]);               // src: vulnhunt/phases/phase4_report.md:120
        md.add(header(meta, findings, θ));
        md.add(new Table(θ["p.phase4_report.readme_summary_table"], findings));            // src: vulnhunt/phases/phase4_report.md:148
        for (Finding f : findings) {
            Block b = f.block(θ["p.phase4_report.readme_per_finding_block"]);              // src: vulnhunt/phases/phase4_report.md:149
            if (θ["p.phase4_report.clickable_links_required"]) b.add(links(f, θ));        // src: vulnhunt/phases/phase4_report.md:155
            md.add(b);
        }
        md.add(inv.resolvedTable(θ["p.phase4_report.readme_resolved_input_inventory"]));   // src: vulnhunt/phases/phase4_report.md:150
        if (θ["p.phase4_report.readme_not_found_excluded_section"]) md.add(new Section("Not Found / Excluded", checkedButCleanClasses())); // src: vulnhunt/phases/phase4_report.md:152
        if (θ["p.phase4_report.readme_artifacts_table"]) md.add(artifactsTable(θ["p.phase4_report.artifacts_saved_under_vulnhunt_dir"])); // src: vulnhunt/phases/phase4_report.md:153
        if (θ["p.phase4_report.readme_report_count_cross_check"]) {                       // src: vulnhunt/phases/phase4_report.md:161
            if (md.summaryRows() != r.countVulnIds()) md.addMissingRows(r.vulnIdsNotIn(md)); // src: vulnhunt/phases/phase4_report.md:163
        }
        writeFile(md);
        if (θ["p.phase4_report.poc_footer_links"]) {                                       // src: vulnhunt/phases/phase4_report.md:165
            for (Finding f : findings) appendFooter(f.pocPath, f.exploitTestPath, "README.md");
        }
    }

    @executedBy(MODEL)
    Header header(KickoffMetadata meta, List<Finding> findings, Theta θ) {
        Header h = new Header("# VulnHunter Security Audit Report");                       // src: vulnhunt/phases/phase4_report.md:125
        h.requireExactFields(θ["p.phase4_report.readme_exact_header_structure"]);         // src: vulnhunt/phases/phase4_report.md:122
        if (θ["p.phase4_report.readme_run_id_source"] == "basename of VULNHUNT_DIR") h.set("Run ID", basename(env("VULNHUNT_DIR"))); // src: vulnhunt/phases/phase4_report.md:136
        if (θ["p.phase4_report.readme_repository_from_kickoff_metadata"]) {               // src: vulnhunt/phases/phase4_report.md:138
            if (θ["p.phase4_report.readme_repository_no_git"]) h.set("Repository", meta.repositoryUrl); // src: vulnhunt/phases/phase4_report.md:141
            else h.set("Repository", normalize(meta.repositoryUrl));
        }
        h.set("Audit Date", today().format(θ["p.phase4_report.readme_audit_date_format"])); // src: vulnhunt/phases/phase4_report.md:129
        String branch = meta.vulnhuntBranch != null ? meta.vulnhuntBranch : "unknown";
        if (!θ["p.phase4_report.readme_branch_no_git_recompute"]) branch = bash("git rev-parse --abbrev-ref HEAD"); // src: vulnhunt/phases/phase4_report.md:144
        h.set("Branch", format(θ["p.phase4_report.readme_branch_from_metadata"], branch)); // src: vulnhunt/phases/phase4_report.md:142
        if (θ["p.phase4_report.readme_model_field"]) h.set("Model", currentModelId());     // src: vulnhunt/phases/phase4_report.md:145
        h.set("Findings Summary", countByTier(findings, θ["p.phase4_report.readme_findings_summary_format"])); // src: vulnhunt/phases/phase4_report.md:132
        return h;
    }

    @executedBy(MODEL)
    Links links(Finding f, Theta θ) {
        Links l = format(θ["p.phase4_report.clickable_link_format"], f.pocPath, f.exploitTestPath); // src: vulnhunt/phases/phase4_report.md:158
        if (θ["p.phase4_report.finding_without_links_incomplete"] && (l.poc == null || l.test == null)) f.markIncomplete(); // src: vulnhunt/phases/phase4_report.md:159
        return l;
    }
}

@executedBy(MODEL) @role(rule_set) @stage("phase4")
class Phase4ReportExclusions {

    // What NOT to Report
    @executedBy(MODEL)
    List<Finding> filter(List<Finding> all, Theta θ) {
        List<Finding> out = new List();
        for (Finding f : all) {
            if (θ["p.phase4_report.exclude_test_build_vendored_generated"].contains(f.codeKind)) continue; // src: vulnhunt/phases/phase4_report.md:170
            if (f.severity == INFORMATIONAL && !f.exploitable()) {
                boolean authzException = θ["p.phase4_report.exception_authz_delegation_informational_reported"] && f.downgradedUnderAuthzDelegationRule(); // src: vulnhunt/phases/phase4_report.md:173
                if (θ["p.phase4_report.exclude_non_exploitable_informational"] && !authzException) continue; // src: vulnhunt/phases/phase4_report.md:172
            }
            if (f.disposition == SAFE || f.disposition == DESIGN_INTENT) {
                if (θ["p.phase4_report.exclude_safe_design_intent_but_keep_in_inventory"]) continue; // src: vulnhunt/phases/phase4_report.md:175
            }
            if (f.isDependencyCve()) {                                                     // src: vulnhunt/phases/phase4_report.md:178
                boolean provable = f.firstPartyCallSiteInvokesVulnerableApiWithAttackerInput();
                if (θ["p.phase4_report.dependency_cve_report_if_first_party_provable"] && provable) { f.cveRef = f.cve; out.add(f); continue; } // src: vulnhunt/phases/phase4_report.md:179
                f.set(θ["p.phase4_report.dependency_cve_else_code_smell"]);                // src: vulnhunt/phases/phase4_report.md:183
                continue;
            }
            if (θ["p.phase4_report.exclude_style_issues"] && f.isStyleWithoutSecurityImpact()) continue; // src: vulnhunt/phases/phase4_report.md:184
            if (θ["p.phase4_report.exclude_theoretical_unrealistic_preconditions"] && f.needsUnrealisticPreconditions()) continue; // src: vulnhunt/phases/phase4_report.md:185
            if (θ["p.phase4_report.exclude_auto_sanitized_injection_claims"] && f.isInjection()) { // src: vulnhunt/phases/phase4_report.md:186
                boolean autoSanitized = θ["p.phase4_report.auto_sanitize_exclusion_requires_library_read"] ? readLibrary(f).autoSanitizes() && sanitizerMatchesSinkContext(f) : f.frameworkClaimsAutoSanitize(); // src: vulnhunt/phases/phase4_report.md:187
                if (autoSanitized) continue;
            }
            out.add(f);
        }
        return out;
    }
}
