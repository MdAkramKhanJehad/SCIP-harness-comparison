// file: vvaharness/api.py
// The embeddable surface: remediate(finding) -> Remediation; validate(finding, remediation) -> Verdict.

@executedBy(CODE) @role(pipeline)
class Api {

    Remediation remediate(Finding finding, Path repo, String mode, Path config, boolean verbose) {
        // mode defaults to "fix"
        Config cfg = config(config);                                                                // src: vvaharness/api.py:60
        Layout layout = RemediationAgentDiscovery.prepareLayout(repo);                                              // src: vvaharness/api.py:61
        RemediationTarget target = new RemediationTarget(finding, 1);                               // src: vvaharness/api.py:62
        Path outDir = Artifacts.artifactDir(layout.remDir, target.slug);                            // src: vvaharness/api.py:63
        Remediation remediation = PluginRunner.applyPlugin(target, outDir, cfg, repo, mode, verbose); // src: vvaharness/api.py:64
        // Save the same remediate_<digest> provenance row the CLI writes, so S11 discovery trusts this case.
        Pair modelBackend = PluginRunner.engineModel(cfg);                                          // src: vvaharness/api.py:69
        String step = Checkpoints.stepKeyFor(REMEDIATE_PREFIX, ENGINE_ID, Vvaharness.version(), target.caseId, modelBackend); // src: vvaharness/api.py:70
        Map record = PluginRunner.checkpointRecord(target, outDir, remediation).with("finding_id", target.caseId); // src: vvaharness/api.py:72
        Checkpoints.saveCkpt(layout.ckptDir, layout.runId, step, record);                           // src: vvaharness/api.py:73
        return remediation;
    }

    Verdict validate(Finding finding, Remediation remediation, Path repo, Path config) {
        // Stages a copy, writes nothing back.
        return CaseApi.validateCase(finding, remediation, repo, validationConfig(config));         // src: vvaharness/api.py:82
    }

    Object validationConfig(Path config) {
        if (config == null) return null;  // validate_case defaults it against the repo             // src: vvaharness/api.py:88
        return ValidationConfig.loadConfig(config.parent);                                          // src: vvaharness/api.py:92
    }

    Config config(Path config) {
        // Packaged default profile when none is given.
        return Config.load(config != null ? config : defaultConfig(), false);  // src: vvaharness/api.py:100  (orchestrator._default_config when none)
    }

    Object attribute(String name) {
        // __all__: Finding, MergeReadiness, Remediation, ScoringPolicy, Verdict, merge_readiness_for, remediate, state_of, validate
        return name.equals("remediate") ? "remediate" : "validate";                                 // src: vvaharness/api.py:31
    }
}
