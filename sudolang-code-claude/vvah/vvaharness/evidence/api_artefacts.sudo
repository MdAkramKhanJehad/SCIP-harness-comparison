// src: vvaharness/evidence/api_artefacts.py:29-37
fn gather_api_artefacts(full_files, max_api_artefacts):executor=code {
  return first max_api_artefacts of full_files (in list order) where any glob matches the path or its lowercase form (case-sensitive fnmatch)
