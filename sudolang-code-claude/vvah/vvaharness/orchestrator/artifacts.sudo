SCAN_DIR_NAME = "security-scan"            // Markdown report, SARIF, error log, findings.json
CASE_DIR_NAME = "security-remediation"     // one subdirectory per finding, named by the remediation agent's slug
CASE_FILE_NAME = "finding_case.json"
FINDINGS_JSON_NAME = "findings.json"

// src: vvaharness/orchestrator/artifacts.py:44-46
UnsafeArtifactDir { kind: RuntimeError }   // raised, not worked around: artifacts would land outside the tree the operator pointed at

// src: vvaharness/orchestrator/artifacts.py:57-82
fn artifact_dir(repo, name):executor=code {
  out = "$repo/$name"
  require out is not a symlink => throw UnsafeArtifactDir("refusing to write scan artifacts through a symlink ...")   // a committed symlink would redirect writes
  require !(out exists && out is not a directory) => throw UnsafeArtifactDir("... exists and is not a directory ...")
  require out resolves (no dangling link or permission error) => throw UnsafeArtifactDir("... cannot be resolved ...")
  require resolved out is inside resolved repo => throw UnsafeArtifactDir("refusing to write scan artifacts outside the target ...")
  return out   // does not create the directory
}
