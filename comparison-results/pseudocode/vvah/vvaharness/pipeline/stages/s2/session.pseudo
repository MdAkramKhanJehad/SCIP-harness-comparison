// file: vvaharness/pipeline/stages/s2/session.py, vvaharness/evidence/gather.py
// S2's dispatch: the agentic threat-model session (graph tools, planning, evidence gate, call budget,
// deadline + resume/replay) and the tool-less hollow retry. Also the step2 evidence caps gather() reads.

@executedBy(CODE) @role(step) @stage("S2")
class S2Session {

    String REPLAY_EFFORT = "low";   // literal: replay restates a transcript  // src: vvaharness/pipeline/stages/s2/session.py:80

    /** _call_budget: on the last permitted model call every tool but ThreatModel is withdrawn. */
    ModelCallBudget callBudget(Theta θ) {
        int limit = θ["step2.max_model_calls"];                                              // src: vvaharness/pipeline/stages/s2/session.py:104
        if (limit <= 0) return null;                                                         // 0 = unmetered  // src: vvaharness/pipeline/stages/s2/session.py:105
        return new ModelCallBudget(limit, Set.of("ThreatModel"));                            // src: vvaharness/pipeline/stages/s2/session.py:107
    }

    /** _graph_tool_route_ok: whether the threatmodel route can run graph tools (warn once if not). */
    boolean graphToolRouteOk(Config cfg) {
        return Deepagents.routeCarriesTools(cfg, resolve(cfg.models.threatmodel).via);      // src: vvaharness/pipeline/stages/s2/session.py:115
    }

    /** _threatmodel_call: the primary agentic threat-model completion. */
    String threatmodelCall(Prompt user, Config cfg, String repoRoot, ContextPackage ctx, boolean dropThinking, boolean requireToolCall, Theta θ) {
        String via = resolve(cfg.models.threatmodel).via;                                    // src: vvaharness/pipeline/stages/s2/session.py:133
        ToolBuilder toolBuilder = null;
        List<String> factTools = List.of();
        Prompt graphToolsLine = null;
        List<Middleware> mw = new List();
        boolean gateInstalled = false;
        if (ctx != null && ctx.graphHandle != null && θ["step2.graph_tools"] && graphToolRouteOk(cfg)) { // src: vvaharness/pipeline/stages/s2/session.py:139
            toolBuilder = CodegraphTools.buildGraphToolBuilder(ctx, θ);                      // src: vvaharness/pipeline/stages/s2/session.py:142
            factTools = CodegraphTools.graphToolNames();                                     // src: vvaharness/pipeline/stages/s2/session.py:143
            // tools stay registered on a degenerate graph; the prompt stops selling them
            boolean degenerate = S0GraphGate.graphIsDegenerate(ctx, θ);                      // src: vvaharness/pipeline/stages/s2/session.py:145
            graphToolsLine = degenerate ? null : S2Prompts.graphToolsSystemLine(θ);          // src: vvaharness/pipeline/stages/s2/session.py:146
            mw.add(new ToolCallBudget(CodegraphTools.graphToolNames(), θ["step2.graph_tool_budget"])); // src: vvaharness/pipeline/stages/s2/session.py:147
            if (θ["step2.planning"]) {                                                       // src: vvaharness/pipeline/stages/s2/session.py:152
                mw.add(new TodoListMiddleware(S2Planning.run(θ), S2Planning.toolDescription(θ))); // src: vvaharness/pipeline/stages/s2/session.py:153
            }
            if (θ["step2.require_graph"]) {                                                  // src: vvaharness/pipeline/stages/s2/session.py:157
                Set<String> requiredTools = CodegraphTools.GRAPH_TOOL_NAMES;                 // src: vvaharness/pipeline/stages/s2/session.py:159
                if (degenerate) requiredTools = Set.of();                                    // stand down; todo gate still applies  // src: vvaharness/pipeline/stages/s2/session.py:168
                mw.add(new EvidenceGate(θ["step2.require_graph_rejections"], requiredTools, requireToolCall, Set.of("write_todos", "ThreatModel"))); // src: vvaharness/pipeline/stages/s2/session.py:169
                gateInstalled = true;
            }
        }
        if (!gateInstalled && requireToolCall && via == "deepagents") {                      // src: vvaharness/pipeline/stages/s2/session.py:177
            mw.add(new EvidenceGate(θ["step2.require_graph_rejections"], Set.of(), true, Set.of("write_todos", "ThreatModel"))); // src: vvaharness/pipeline/stages/s2/session.py:178
        }
        int maxTurns = θ["step2.max_turns"];                                                 // src: vvaharness/pipeline/stages/s2/session.py:185
        Schema threatModelArg = RESPONSE_MODEL_VIAS.contains(via) ? ThreatModel.schema() : null; // src: vvaharness/pipeline/stages/s2/session.py:187
        Prompt system = systemPrompt(graphToolsLine, θ);                                     // src: vvaharness/pipeline/stages/s2/session.py:191
        Transcript transcript = new Transcript();
        mw.add(new RecordTranscript(transcript));                                            // src: vvaharness/pipeline/stages/s2/session.py:195
        ModelCallBudget budget = callBudget(θ);                                              // src: vvaharness/pipeline/stages/s2/session.py:196
        if (budget != null) mw.add(budget);                                                  // src: vvaharness/pipeline/stages/s2/session.py:197
        int deadline = θ["step2.deadline"];                                                  // 0 = no clock  // src: vvaharness/pipeline/stages/s2/session.py:199
        try {
            return Replay.runWithDeadline(() -> agenticLeg(user, cfg, repoRoot, system, mw, toolBuilder, factTools, maxTurns, threatModelArg, dropThinking, θ), deadline); // src: vvaharness/pipeline/stages/s2/session.py:202
        } catch (CallTimeoutError e) {
            // resume the live session, else re-ask from the transcript with no tools
            return Replay.resumeOrReplay(sessionId("s2"), () -> replayLeg(user, cfg, repoRoot, system, transcript, θ), θ["step2.resume_timeout"]); // src: vvaharness/pipeline/stages/s2/session.py:210
        }
    }

    /** System prompt = SYSTEM + agentic line + graph line (if any) + shell line (if step2.bash). */
    Prompt systemPrompt(Prompt graphToolsLine, Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s2_session.system_prompt_composition"]);                              // src: vvaharness/pipeline/stages/s2/session.py:191
        p.include(S2Prompts.run(θ));                                                         // src: vvaharness/pipeline/stages/s2/session.py:191
        p.include(S2Prompts.agenticSystemLine(θ));                                           // src: vvaharness/pipeline/stages/s2/session.py:191
        if (graphToolsLine != null) p.include(graphToolsLine);                               // src: vvaharness/pipeline/stages/s2/session.py:191
        if (θ["step2.bash"]) p.include(S2Prompts.shellSystemLine(θ));                       // src: vvaharness/pipeline/stages/s2/session.py:192
        return p;
    }

    /** _replay_leg: tool-free re-ask from the killed session's transcript, LOWEST effort. */
    String replayLeg(Prompt user, Config cfg, String repoRoot, Prompt system, Transcript transcript, Theta θ) {
        Prompt replay = Replay.replayPrompt(transcript, user, "S2_REPLAY_INSTRUCTION");     // "Report the threat model NOW"  // src: vvaharness/pipeline/stages/s2/session.py:229
        ModelSpec m = new ModelSpec(cfg.models.threatmodel, REPLAY_EFFORT, θ["step2.replay_max_tokens"]); // src: vvaharness/pipeline/stages/s2/session.py:235
        int timeout = θ["step2.replay_timeout"];                                             // src: vvaharness/pipeline/stages/s2/session.py:236
        return Runtime.llm(m, system, replay, ThreatModel.schema());                         // src: vvaharness/pipeline/stages/s2/session.py:228
    }

    /** _agentic_leg: the agentic threat-model session that the stage deadline wraps. */
    String agenticLeg(Prompt user, Config cfg, String repoRoot, Prompt system, List<Middleware> mw, ToolBuilder toolBuilder, List<String> factTools, int maxTurns, Schema out, boolean dropThinking, Theta θ) {
        String via = resolve(cfg.models.threatmodel).via;
        // via:cli honours the allowlist verbatim; else validated against Read/Glob/Grep
        List<Tool> tools = Models.validateDetectionTools(θ["step2.allowed_tools"], via);    // src: vvaharness/pipeline/stages/s2/session.py:259
        // step2.timeout binds via:cli and deepagents; sdk/openai rely on max_turns alone
        Duration timeout = Replay.deadlineBound(θ["step2.timeout"], θ["step2.deadline"]);  // src: vvaharness/pipeline/stages/s2/session.py:266
        Effort effort = dropThinking ? null : θ["step2.effort"];                             // src: vvaharness/pipeline/stages/s2/session.py:277
        ModelSpec m = new ModelSpec(cfg.models.threatmodel, via, effort, θ["step2.max_tokens"]); // src: vvaharness/pipeline/stages/s2/session.py:270
        List<Skill> skills = θ["step2.skills"] ? Skills.injectSkills(repoRoot) : null;      // src: vvaharness/pipeline/stages/s2/session.py:278
        if (θ["step2.bash"]) tools.add(new Tool("execute"));                                 // not path-jailed  // src: vvaharness/pipeline/stages/s2/session.py:279
        // on deepagents max_turns is a recursion floor, not a hard cap
        return Runtime.agent(new AgentSpec(m, tools.plus(toolBuilder, factTools), skills, system, user, new Bounds(maxTurns, θ["step2.max_model_calls"], timeout, null), out, θ["step2.planning"])); // src: vvaharness/pipeline/stages/s2/session.py:253
    }

    /** _snapshot_leg: re-ask from the structural snapshot alone, no tools (SYSTEM only). */
    String snapshotLeg(Prompt user, Config cfg, String repoRoot, Theta θ) {
        ModelSpec m = new ModelSpec(cfg.models.threatmodel, θ["step2.effort"], θ["step2.max_tokens"]); // src: vvaharness/pipeline/stages/s2/session.py:302
        int timeout = θ["step2.timeout"];                                                    // src: vvaharness/pipeline/stages/s2/session.py:303
        return Runtime.llm(m, S2Prompts.run(θ), user, ThreatModel.schema());                // src: vvaharness/pipeline/stages/s2/session.py:296
    }

    /** _hollow_reason: why S3 would mint nothing from tm, or "" when a threat is actionable. */
    String hollowReason(ThreatModel tm, boolean resolved) {
        if (tm.threats.isEmpty()) return "no_threats";                                       // src: vvaharness/pipeline/stages/s2/session.py:313
        if (resolved && tm.threats.noneMatch(t -> !t.surfaceFiles.isEmpty())) return "no_validated_surface"; // src: vvaharness/pipeline/stages/s2/session.py:315
        return "";
    }

    /** _HOLLOW_RETRY_DIRECTIVES, appended to the retry prompt. */
    @executedBy(MODEL) @role(prompt)
    Prompt hollowDirective(String reason, Theta θ) {
        Prompt p = new Prompt();
        if (reason == "no_threats") {
            p.rule(θ["p.s2_session.hollow_retry_no_threats"]);                               // model from snapshot; surface_files only from FILE INVENTORY  // src: vvaharness/pipeline/stages/s2/session.py:89
            p.context(θ["p.s2_session.hollow_retry_no_tools"]);                              // "This call has no tools"  // src: vvaharness/pipeline/stages/s2/session.py:90
        } else {
            p.must(θ["p.s2_session.hollow_retry_no_validated_surface"]);                     // >= 1 surface_files path copied EXACTLY  // src: vvaharness/pipeline/stages/s2/session.py:94
        }
        return p;
    }

    /** _retry_if_hollow: one tool-less re-ask when a non-empty repo yielded nothing S3 could use, then hard fail. */
    ThreatModel retryIfHollow(ThreatModel tm, ThreatEvidence ev, Prompt user, Config cfg, String repoRoot, ContextPackage ctx, Theta θ) {
        Object policy = θ["prompt.s2.hollow_retry"];                                         // one tool-less re-ask, then hard fail  // src: vvaharness/pipeline/stages/s2/session.py:86
        if (!θ["step2.empty_retry"]) return tm;                                              // src: vvaharness/pipeline/stages/s2/session.py:325
        String reason = hollowReason(tm, ctx != null);                                       // src: vvaharness/pipeline/stages/s2/session.py:327
        if (reason.isEmpty()) return tm;                                                     // src: vvaharness/pipeline/stages/s2/session.py:328
        if (ev.fileCount == 0) return tm;                                                    // zero threats on zero files is honest  // src: vvaharness/pipeline/stages/s2/session.py:331
        ThreatModel retry;
        try {
            retry = S2Outcomes.parseThreatModel(snapshotLeg(user.plus(hollowDirective(reason, θ)), cfg, repoRoot, θ)); // src: vvaharness/pipeline/stages/s2/session.py:337
        } catch (Exception e) {
            if (isHaltError(e)) throw e;                                                     // src: vvaharness/pipeline/stages/s2/session.py:340
            return tm;                                                                       // keep the first model  // src: vvaharness/pipeline/stages/s2/session.py:344
        }
        S2Outcomes.finalizeThreats(retry, ctx);                                              // src: vvaharness/pipeline/stages/s2/session.py:345
        if (hollowReason(retry, ctx != null).isEmpty()) return retry;                        // recovered  // src: vvaharness/pipeline/stages/s2/session.py:347
        throw new S2HollowAfterRetry(hollowReason(retry, ctx != null));                      // src: vvaharness/pipeline/stages/s2/session.py:355
    }
}

/** step2.* knobs that S2.run reads outside session.py proper (baseline mode, output caps). */
@executedBy(CODE) @role(config) @stage("S2")
class S2Config {

    String baselineMode(Theta θ) {
        return θ["step2.baseline"];                                                          // auto | owasp | none  // src: vvaharness/pipeline/stages/s2/__init__.py:147
    }

    Triple<Integer, Integer, Integer> outputCaps(Theta θ) {
        int maxThreats = θ["step2.max_threats"];                                             // src: vvaharness/pipeline/stages/s2/__init__.py:235
        int maxAssets = θ["step2.max_assets"];                                               // src: vvaharness/pipeline/stages/s2/__init__.py:236
        int maxBoundaries = θ["step2.max_trust_boundaries"];                                 // src: vvaharness/pipeline/stages/s2/__init__.py:237
        return new Triple(maxThreats, maxAssets, maxBoundaries);
    }

    boolean emptyRetry(Theta θ) {
        return θ["step2.empty_retry"];                                                       // also gates dispatch_or_retry_unforced's resend  // src: vvaharness/pipeline/stages/s2/__init__.py:169
    }

    Effort effort(Theta θ) {
        return θ["step2.effort"];                                                            // src: vvaharness/pipeline/stages/s2/__init__.py:158
    }

    /** Repair re-ask keeps the full step2 caps: it re-emits the FULL model. */
    Pair<Integer, Integer> repairLimits(Theta θ) {
        return new Pair(θ["step2.max_tokens"], θ["step2.timeout"]);                         // src: vvaharness/pipeline/stages/s2/__init__.py:197
    }
}

/** evidence/gather.py: the structural snapshot S2's user prompt is built from; every cap 0 = emit none. */
@executedBy(CODE) @role(step) @stage("S2")
@src("vvaharness/evidence/gather.py:185")
class S2Evidence {

    ThreatEvidence gather(String repoRoot, ContextPackage ctx, Theta θ) {
        // AST frontier over the graph view
        ContextPackage frontier = Frontier.build(ctx, θ["step2.max_graph_files"], θ["step2.max_entry_points"], θ["step2.max_graph_sinks"], θ["step2.max_modules"], θ["step2.max_graph_edges"]); // src: vvaharness/evidence/gather.py:127
        ContextPackage active = frontier != null ? frontier : ctx;                           // src: vvaharness/evidence/gather.py:191
        List<String> fullFiles = ctx.allFiles;                                               // shape blocks read all files  // src: vvaharness/evidence/gather.py:193
        List docs = EvidenceDocs.gatherDocs(repoRoot, fullFiles, θ["step2.max_doc_chars"]); // README, SECURITY, ARCHITECTURE...  // src: vvaharness/evidence/gather.py:198
        List manifests = EvidenceManifests.gatherManifests(repoRoot, θ["step2.max_manifest_depth"], θ["step2.max_manifests"], Math.max(1, θ["step2.max_manifests_per_kind"]), θ["step2.max_manifest_chars"], θ["step2.max_manifest_total_chars"]); // src: vvaharness/evidence/gather.py:199
        // round-robin per dir; first N with redacted, capped bodies, security-named first; rest path-only
        List cfgReps = EvidenceConfigs.gatherConfigReps(repoRoot, fullFiles, θ["step2.max_config_reps"], θ["step2.max_config_rep_chars"], θ["step2.max_config_rep_bodies"]); // src: vvaharness/evidence/gather.py:202
        List api = EvidenceApi.gatherApiArtefacts(fullFiles, θ["step2.max_api_artefacts"]); // src: vvaharness/evidence/gather.py:204
        List modules = active.modules.take(θ["step2.max_prompt_modules"]);                  // marked truncated  // src: vvaharness/evidence/gather.py:224
        List eps = sortedEntryPoints(active).take(θ["step2.max_prompt_entry_points"]);      // src: vvaharness/evidence/gather.py:226
        List inventory = sorted(fullFiles).take(θ["step2.max_inventory_files"]);            // FILE INVENTORY  // src: vvaharness/evidence/gather.py:232
        return new ThreatEvidence(active.allFiles.size(), ctx.allFiles.size(), ctx.language, modules, eps, cfgReps, api, docs, manifests, inventory, ctx.notes); // src: vvaharness/evidence/gather.py:218
    }
}
