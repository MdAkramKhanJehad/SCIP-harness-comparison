# vvaharness/evidence/docs.py

Collects README, SECURITY, ARCHITECTURE and similar documents for the Stage 2 prompt within one character budget: fixed-name documents at the repository root first (breadth, then growth), then up to eight other matching Markdown or reStructuredText files.

Source: `vvaharness/evidence/docs.py` (lines 1-125)
Executor: code
Called from: `vvaharness/evidence/gather.py` gather

// src: vvaharness/evidence/docs.py:23-36
_DOC_CANDIDATES = ["THREAT_MODEL.md", "SECURITY.md", "ARCHITECTURE.md", "README.md", "README.rst", "README.txt", "README", "CHANGELOG.md", "CHANGELOG"]   // priority order
_DOC_NAME_RX = "(analysis|architecture|design|migration|specification|spec|threat|security|dataflow|data[_-]?flow|interface)"   // case-insensitive, searched in the file stem
_DOC_EXTRA_MAX = 8

// src: vvaharness/evidence/docs.py:118-125
fn gather_docs(root, full_files, doc_cap):executor=code {
  found = candidates in _DOC_CANDIDATES order that are files at the repository root   // read from the root regardless of the scope inventory
  [docs, budget] = _breadth_pass(root, found, doc_cap)
  docs = _grow_pass(root, docs, budget, doc_cap)
  budget = doc_cap - total length of doc bodies
  return docs + _extra_docs(root, full_files, names already taken, budget)
  // preserved: document bodies are not redacted here (configuration bodies are); the truncation marker text also counts against the budget
}

// src: vvaharness/evidence/docs.py:39-52
fn _breadth_pass(root, found, doc_cap):executor=code {
  budget = doc_cap
  for each (name, p) in found {
    if (budget <= 0) stop
    body = evidence.read._read_capped(root, p, min(doc_cap, max(1000, budget / 3)))   // a fair one-third-of-remaining share, at least 1000
    if (body) { docs += (name, body); budget -= length(body) }
  }
  return [docs, budget]
}

// src: vvaharness/evidence/docs.py:55-89
fn _grow_pass(root, docs, budget, doc_cap):executor=code {
  rounds = 0
  while (budget > 0 && rounds < length(docs)) {
    grew = false
    for each doc in docs while budget > 0 {
      re-read it capped at min(doc_cap, current length + budget); if longer, replace and spend the growth; grew = true
    }
    if (!grew) stop
    rounds += 1
  }
  return docs
}

// src: vvaharness/evidence/docs.py:92-115
fn _extra_docs(root, full_files, seen, budget):executor=code {
  extras = first _DOC_EXTRA_MAX of sorted in-scope .md/.rst paths not already taken whose stem matches _DOC_NAME_RX
  per_cap = max(1000, budget / max(length(extras), 1))
  for each rel in extras while budget > 0 {
    body = evidence.read._read_capped(root, root/rel, min(budget, per_cap))
    if (body) { docs += (rel, body); budget -= length(body) }
  }
  return docs
}
