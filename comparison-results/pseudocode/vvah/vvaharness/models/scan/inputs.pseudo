@executedBy(CODE) @role(types)
record Control(String name, String kind, List<String> protects, String notes) {
    // design-level mitigation the strategist/chain model uses to downrank exploitability
    // kind in auth | sandbox | input-validation | aslr | cfi | other                               // src: vvaharness/models/scan/inputs.py:54

    String vKind(Object v) {
        // _CONTROL_KIND_ALIAS e.g. authn/authz/rbac/iam/sso -> auth; waf/sanitization/encoding -> input-validation;
        // seccomp/container/isolation/chroot/jail -> sandbox; anything unknown -> other
        return Coerce.coerceEnum(v, CONTROL_KINDS, θ["code.models.scan.inputs.control_kind_alias"], "other"); // src: vvaharness/models/scan/inputs.py:61
    }
}

@executedBy(CODE) @role(types)
record AppProfile(String applicationId, String name, boolean externallyFacing, boolean pciScoped, boolean processesPan, boolean pii, String source) {
    // CMDB deployment context shared by s1/s2/s6 so actor choice and CVSS scoring agree

    String toPromptBlock() {
        List<String> sens = new List();
        if (pciScoped) sens.add("PCI-scoped");                                                      // src: vvaharness/models/scan/inputs.py:76
        if (processesPan) sens.add("processes PAN");                                                // src: vvaharness/models/scan/inputs.py:77
        if (pii) sens.add("handles PII");                                                           // src: vvaharness/models/scan/inputs.py:78
        return "CMDB APPLICATION PROFILE: Application ID, Name (or '(unnamed)'), Externally facing YES/NO, Data sensitivity "
             + (sens.isEmpty() ? "standard" : sens.join(", ")) + ", Source";                       // src: vvaharness/models/scan/inputs.py:80
    }
}

