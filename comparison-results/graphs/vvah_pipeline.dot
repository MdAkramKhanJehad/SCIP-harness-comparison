// VVAH scan pipeline (vvaharness 1.5.1, commit 0e6f00d)
// Drawn from the `pipeline:` block of vvah.knobs.yaml.
// Render: dot -Tsvg vvah_pipeline.dot -o vvah_pipeline.svg
digraph VVAH {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, bgcolor="#fcfcfb",
         nodesep=0.35, ranksep=0.32, pad=0.3,
         label=<<b>VVAH scan pipeline</b><br/><font point-size="10" color="#52514e">Python orchestrator calls each stage in order. Grey text = main knobs (ids in vvah.knobs.yaml)</font>>,
         labelloc=t, labeljust=l];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10,
         color="#a8a7a2", fillcolor="#ffffff", fontcolor="#0b0b0b", margin="0.14,0.06"];
  edge  [color="#7a7975", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9, fontcolor="#52514e"];

  // Legend
  subgraph cluster_legend {
    label=<<b>Node kinds</b>>; fontsize=10; style="rounded"; color="#e4e3df";
    lg_det [label="Deterministic code", fillcolor="#e9e8e4"];
    lg_one [label="One model call", fillcolor="#fce3d6", color="#eb6834"];
    lg_agt [label="Tool-using agent session", fillcolor="#eb6834", fontcolor="#ffffff", color="#eb6834"];
    lg_opt [label="Optional (off by default\nor flag-gated)", style="rounded,dashed", fillcolor="#ffffff"];
    lg_det -> lg_one -> lg_agt -> lg_opt [style=invis];
  }

  pre  [label=<<b>Preflight</b><br/><font point-size="9" color="#52514e">probe each model / provider · models.*</font>>, fillcolor="#e9e8e4"];
  ax   [label=<<b>S1 auto-exclude</b> (optional)<br/><font point-size="9" color="#52514e">survey repo, then code veto<br/>step1.auto_exclude · step1.auto_exclude_protect_*</font>>, fillcolor="#fce3d6", color="#eb6834", style="rounded,filled,dashed"];
  s0   [label=<<b>S0 seed</b><br/><font point-size="9" color="#52514e">entry points and sinks by pattern<br/>step0.* · step1.exclude_*</font>>, fillcolor="#e9e8e4"];
  cg   [label=<<b>Code graph</b><br/><font point-size="9" color="#52514e">tree-sitter + communities</font>>, fillcolor="#e9e8e4"];
  s1   [label=<<b>S1 context</b><br/><font point-size="9" color="#52514e">assemble context · inject.*</font>>, fillcolor="#e9e8e4"];
  s2   [label=<<b>S2 threat model</b><br/><font point-size="9" color="#ffffff">step2.allowed_tools · graph_tool_budget · require_graph<br/>planning · max_turns · max_model_calls · deadline<br/>max_threats (coverage ceiling)</font>>, fillcolor="#eb6834", fontcolor="#ffffff", color="#eb6834"];
  s3   [label=<<b>S3 work units</b><br/><font point-size="9" color="#52514e">one unit per threat, ranked</font>>, fillcolor="#e9e8e4"];
  bat  [label=<<b>Batch</b><br/><font point-size="9" color="#52514e">group by file overlap · step4.batch_size</font>>, fillcolor="#e9e8e4"];
  s4   [label=<<b>S4 hunt</b>  (× step4.parallel)<br/><font point-size="9" color="#ffffff">Read/Glob/Grep + CweGuidance + graph tools<br/>step4.skills · planning · evidence_gate<br/>max_turns · max_model_calls · deadline<br/>→ confirmed | refuted | inconclusive</font>>, fillcolor="#eb6834", fontcolor="#ffffff", color="#eb6834"];
  s5   [label=<<b>S5 normalise</b><br/><font point-size="9" color="#52514e">path gate · re-anchor · same-site collapse</font>>, fillcolor="#e9e8e4"];
  det  [label=<<b>S5 detectors</b> (optional)<br/><font point-size="9" color="#52514e">step5_detectors.enabled</font>>, fillcolor="#e9e8e4", style="rounded,filled,dashed"];
  ev   [label=<<b>Exploit verification</b> (optional)<br/><font point-size="9" color="#52514e">classify → map → payloads → attacker → oracle → judge</font>>, fillcolor="#fce3d6", color="#eb6834", style="rounded,filled,dashed"];
  s6   [label=<<b>S6 verify</b>  (× step6_verify.parallel)<br/><font point-size="9" color="#ffffff">batch_size · → TRUE_POSITIVE | FALSE_POSITIVE | INCONCLUSIVE<br/>confidence 0–10 · CVSS</font>>, fillcolor="#eb6834", fontcolor="#ffffff", color="#eb6834"];
  keep [label=<<b>Keep filter</b><br/><font point-size="9" color="#52514e">TP with confidence ≥ step6_verify.min_confidence<br/>INCONCLUSIVE kept as undetermined</font>>, fillcolor="#e9e8e4", shape=box];
  s7   [label=<<b>S7 dedup</b><br/><font point-size="9" color="#52514e">step7_dedup.line_tolerance</font>>, fillcolor="#e9e8e4"];
  s7s  [label=<<b>S7 semantic dedup</b> (optional)<br/><font point-size="9" color="#52514e">step7_dedup.semantic</font>>, fillcolor="#fce3d6", color="#eb6834", style="rounded,filled,dashed"];
  s8   [label=<<b>S8 report</b><br/><font point-size="9" color="#52514e">model writes, code validates;<br/>fallback: severity-sorted report</font>>, fillcolor="#fce3d6", color="#eb6834"];
  s9   [label=<<b>S9 outputs</b><br/><font point-size="9" color="#52514e">findings.json · Markdown · SARIF</font>>, fillcolor="#e9e8e4"];
  s10  [label=<<b>S10 remediate</b> (optional)<br/><font point-size="9" color="#ffffff">top step_remediate.top_n_findings by CVSS<br/>agent between policy gates · --remediate</font>>, fillcolor="#eb6834", fontcolor="#ffffff", color="#eb6834", style="rounded,filled,dashed"];
  s11  [label=<<b>S11 validate fixes</b> (optional)<br/><font point-size="9" color="#ffffff">orchestrator + 3 personas → consensus score<br/>step_validate.enabled</font>>, fillcolor="#eb6834", fontcolor="#ffffff", color="#eb6834", style="rounded,filled,dashed"];

  lg_opt -> pre [style=invis];
  pre -> ax [style=dashed];
  pre -> s0;
  ax -> s0 [style=dashed, label=" exclusion overlay"];
  s0 -> cg -> s1 -> s2;
  s2 -> s3 [label=" threats"];
  s3 -> bat -> s4;
  s4 -> s5 [label=" candidates"];
  det -> s5 [style=dashed];
  s5 -> ev [style=dashed];
  s5 -> s6;
  ev -> s6 [style=dashed];
  s6 -> keep -> s7;
  s7 -> s7s [style=dashed];
  s7 -> s8;
  s7s -> s8 [style=dashed];
  s8 -> s9;
  s9 -> s10 [style=dashed];
  s10 -> s11 [style=dashed, label=" fixes"];

  {rank=same; s5; det}
  {rank=same; s7; s7s}
}
