@src("vvaharness/backends/llm/cli/session.py:61")
record CliPin(List<String> cmd, String model, String cwd, Map env, Map jsonSchema, String tier, Event exited) { }

@executedBy(CODE) @role(backend)
class CliSession {

    // degradations already announced, so an old binary warns once, not once per call
    Set<String> WARNED_CAPS = new Set();                                                                    // src: vvaharness/backends/llm/cli/session.py:57
    // stage session id -> its live cli attempt; written once per agentic() loop iteration
    Map<String, CliPin> PINNED_CLI = new Map();                                                             // src: vvaharness/backends/llm/cli/session.py:74
    Lock PINNED_CLI_LOCK = new Lock();                                                                      // src: vvaharness/backends/llm/cli/session.py:75
