      "line_start": 15,
      "line_end": 15,
      "text": "One agentic session per threat: tool set, dispatch, and reply reduction.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 197,
      "line_end": 197,
      "text": "low",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 84,
      "line_end": 84,
      "text": "The native tool allowlist every S4 session passes to dispatch_agentic.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 92,
      "line_end": 92,
      "text": "A budget metering *names*, or None when the configured limit is <= 0 (unmetered).",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 100,
      "line_end": 100,
      "text": "*limit* grown by one call per extra batch member.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 104,
      "line_end": 104,
      "text": "",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 105,
      "line_end": 105,
      "text": "The session's model-call cap, or None when `step4.max_model_calls` is <= 0 (unmetered).",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 117,
      "line_end": 117,
      "text": "Whether this session actually has the six graph tools to call.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 123,
      "line_end": 123,
      "text": "The planning middleware, unless `step4.planning` turns it off; `graph` picks the wording.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 132,
      "line_end": 132,
      "text": "The plan-completion gate on the outcome tool, unless config turns it off.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 159,
      "line_end": 159,
      "text": "",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 161,
      "line_end": 161,
      "text": "Compose S4's tool builders, fact-tool names, and its per-session middleware.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 179,
      "line_end": 179,
      "text": "Whole-file source when `step4.inline_source` is on; `None` otherwise and always for LARGE.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 201,
      "line_end": 201,
      "text": "The step4.deadline knob in whole seconds; 0 = no clock.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 206,
      "line_end": 206,
      "text": "The route session clock, stopping the session before step4.deadline abandons it.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 213,
      "line_end": 213,
      "text": "*call*'s reply, or a resume of its own session once step4.deadline elapses; 0 = no clock.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 227,
      "line_end": 227,
      "text": "One tool-free, lowest-effort re-ask for the outcome the killed session never reported.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 245,
      "line_end": 245,
      "text": "Run one agentic session for *unit* and return the findings it confirmed.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 341,
      "line_end": 341,
      "text": "Keep the first `step4.max_findings_per_run` of *findings*; run on every session, batched or not.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 354,
      "line_end": 354,
      "text": "Collapse same-canonical-key findings; run on every session, batched or not.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4/session.py",
      "line_start": 368,
      "line_end": 368,
      "text": "Run one agentic session for *unit*, collapsing same-site findings by canonical key.",
