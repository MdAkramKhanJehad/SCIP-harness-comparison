// file: vulnhunter-fix/scripts/clone_repo.sh
// Shallow-clones a GitHub repo, or (with --fork) forks it, makes the fork private, enables issues,
// adds collaborators from collaborators.json and clones the fork.

@executedBy(CODE) @role(tool) @stage("fix")
class CloneRepo {

    int run(String repoUrl, String targetDir, List<String> flags, Theta θ) {
        boolean doFork = false;
        String forkOrg = "";
        String forkPrefix = "";
        String skillDir = Env.getOr("VULNFIX_SKILL_DIR", Path.dirname(thisScript()) + "/..");            // src: vulnhunter-fix/scripts/clone_repo.sh:15
        for (Flag f : flags) {
            if (f.name == "--fork") doFork = true;                                                        // src: vulnhunter-fix/scripts/clone_repo.sh:19
            else if (f.name == "--fork-org") forkOrg = f.value;                                           // src: vulnhunter-fix/scripts/clone_repo.sh:20
            else if (f.name == "--fork-prefix") forkPrefix = f.value;                                     // src: vulnhunter-fix/scripts/clone_repo.sh:21
            // unknown flags silently skipped
        }
        String ghHost = Env.getOr("VULNFIX_GH_HOST", θ["code.fix.scripts.check_repo_access.default_gh_host"]); // src: vulnhunter-fix/scripts/clone_repo.sh:26
        String ownerRepo = repoUrl.replaceRegex(".*github\\.com[:/]", "").removeSuffix(".git").replaceRegex("/tree/.*", ""); // src: vulnhunter-fix/scripts/clone_repo.sh:27
        String repoName = Path.basename(ownerRepo);                                                       // src: vulnhunter-fix/scripts/clone_repo.sh:28
        if (doFork) return forkAndClone(ownerRepo, repoName, targetDir, forkOrg, forkPrefix, skillDir, ghHost, θ); // src: vulnhunter-fix/scripts/clone_repo.sh:30
        Git.clone("https://github.com/" + ownerRepo + ".git", targetDir + "/" + repoName, θ["code.fix.scripts.clone_repo.clone_depth"], "no templates"); // src: vulnhunter-fix/scripts/clone_repo.sh:108
        if (Path.isDir(targetDir + "/" + repoName)) {
            print(json("status", "ok", "path", targetDir + "/" + repoName, "repo", ownerRepo));          // src: vulnhunter-fix/scripts/clone_repo.sh:111
            return 0;
        }
        print(json("status", "error", "message", "Clone failed"));                                        // src: vulnhunter-fix/scripts/clone_repo.sh:114
        return 1;
    }

    int forkAndClone(String ownerRepo, String repoName, String targetDir, String forkOrg, String forkPrefix, String skillDir, String ghHost, Theta θ) {
        String forkName = forkPrefix.isEmpty() ? repoName : forkPrefix + "-" + repoName;                  // src: vulnhunter-fix/scripts/clone_repo.sh:33
        Gh.repoFork(ghHost, ownerRepo, forkName, forkOrg.isEmpty() ? null : forkOrg, false);              // src: vulnhunter-fix/scripts/clone_repo.sh:44
        String forkFull = !forkOrg.isEmpty() ? forkOrg + "/" + forkName : Gh.api("user", ".login") + "/" + forkName; // src: vulnhunter-fix/scripts/clone_repo.sh:47
        // failures of visibility change and enable-issues are ignored (|| true)
        Gh.repoEdit(forkFull, "--visibility", θ["code.fix.scripts.clone_repo.fork_visibility"]);         // src: vulnhunter-fix/scripts/clone_repo.sh:55
        Gh.repoEdit(forkFull, "--enable-issues");                                                         // src: vulnhunter-fix/scripts/clone_repo.sh:58
        String collabFile = skillDir + "/collaborators.json";                                             // src: vulnhunter-fix/scripts/clone_repo.sh:61
        if (Path.isFile(collabFile)) addCollaborators(collabFile, forkFull, θ);                          // src: vulnhunter-fix/scripts/clone_repo.sh:62
        Git.clone("https://github.com/" + forkFull + ".git", targetDir + "/" + forkName, θ["code.fix.scripts.clone_repo.clone_depth"], "no templates"); // src: vulnhunter-fix/scripts/clone_repo.sh:96
        if (Path.isDir(targetDir + "/" + forkName)) {
            print(json("status", "ok", "path", targetDir + "/" + forkName, "repo", forkFull, "upstream", ownerRepo, "visibility", "private")); // src: vulnhunter-fix/scripts/clone_repo.sh:99
            return 0;
        }
        print(json("status", "error", "message", "Clone failed"));                                        // src: vulnhunter-fix/scripts/clone_repo.sh:102
        return 1;
    }

    void addCollaborators(String collabFile, String forkFull, Theta θ) {
        // values passed via argv to an embedded python heredoc (no shell expansion into source)
        Map data = Json.load(collabFile);                                                                 // src: vulnhunter-fix/scripts/clone_repo.sh:75
        for (Map c : data.getOr("collaborators", List.of())) {
            String role = c.getOr("role", θ["code.fix.scripts.clone_repo.default_collaborator_role"]);    // src: vulnhunter-fix/scripts/clone_repo.sh:78
            Proc r = Gh.apiPut("repos/" + forkFull + "/collaborators/" + c.username, "permission=" + role); // src: vulnhunter-fix/scripts/clone_repo.sh:80
            if (r.rc != 0) Stderr.print("Warning: Failed to add collaborator");                          // src: vulnhunter-fix/scripts/clone_repo.sh:89
        }
    }
}
