# vvaharness/remediation_agent/plugin_runner/trace.py

`--verbose` tracing helpers: labelled, redacted blocks on standard error, and the per-finding policy decision with the resolved playbook strategy. Presentation only; no model spend and no decisions.

Source: `vvaharness/remediation_agent/plugin_runner/trace.py` (lines 1-53)
Executor: code
Called from: `plugin_runner/__init__.sudo` (_dump), `plugin_runner/run.sudo` _trace_policy (_dump_policy)

// src: vvaharness/remediation_agent/plugin_runner/trace.py:23-29
fn dump(title, body):executor=code {
  console a box titled $title containing redact(body), line by line   // every traced prompt, tool call and reply is redacted before printing
}

// src: vvaharness/remediation_agent/plugin_runner/trace.py:32-53
fn dump_policy(target, pre):executor=code {
  console "POLICY → finding <index>": CWE (or "(unknown)"), decision action, may_patch, redacted reason, matched rule if any
  if (pre.strategy != null) {
    console "playbook strategy: <name> (confidence=<confidence>, fix_location=<fix_location>)"   // the only place Strategy.confidence is used
    dump("PLAYBOOK STRATEGY → finding <index>", pre.strategy.as_prompt_block())
  } else {
    console "playbook strategy: (none resolved — guidance-only)"
    // preserved: the label says "guidance-only", but an allowed finding with no strategy still goes to the model (pre.allowed comes from the gate alone; policy/decide.sudo)
  }
}
