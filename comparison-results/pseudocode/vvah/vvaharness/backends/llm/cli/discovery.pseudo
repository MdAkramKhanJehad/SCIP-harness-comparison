// file: vvaharness/backends/llm/cli/discovery.py
// Locating the `claude` binary (no cwd-planted hits), probing which flags the installed build accepts
// (memoised), mapping permission modes to a safe accepted one, and formatting CLI errors.

@executedBy(CODE) @role(backend)
class Discovery {

    List<String> CLAUDE_CMD = findClaudeCmd();                                                              // resolved once at import // src: vvaharness/backends/llm/cli/discovery.py:90
    // MOST RESTRICTIVE FIRST; bypassPermissions deliberately absent
    List<String> PERMISSION_FALLBACKS = θ["code.backends.llm.cli.discovery.permission_fallbacks"];          // src: vvaharness/backends/llm/cli/discovery.py:93
    Map capsCache = null;                                                                                   // src: vvaharness/backends/llm/cli/discovery.py:95
    List<String> PROBE_SENTINELS = List.of("--vvah-capability-probe-aaa", "--vvah-capability-probe-bbb");   // src: vvaharness/backends/llm/cli/discovery.py:97

    /** shutil.which, rejecting a relative hit from Windows's implicit cwd search (CWE-427). */
    @src("vvaharness/backends/llm/cli/discovery.py:36")
    String whichAbs(List<String> names) {
        for (String name : names) {                                                                         // src: vvaharness/backends/llm/cli/discovery.py:45
            String hit = Shutil.which(name);
            if (hit != null && Path.of(hit).isAbsolute()) return hit;                                       // src: vvaharness/backends/llm/cli/discovery.py:47
        }
        return null;
    }

    /** Resolve the claude CLI to an absolute-path command list. */
    @src("vvaharness/backends/llm/cli/discovery.py:52")
    List<String> findClaudeCmd() {
        String override = System.getenv("VVAHARNESS_CLAUDE_BINARY");                                        // src: vvaharness/backends/llm/cli/discovery.py:54
        if (override != null) {
            if (Files.isFile(override)) return List.of(override);                                           // src: vvaharness/backends/llm/cli/discovery.py:56
            Log.warning(Event.CLI_BINARY_OVERRIDE_MISSING, override);                                       // falls through to PATH // src: vvaharness/backends/llm/cli/discovery.py:59
        }
        if (OS.isWindows()) {                                                                               // src: vvaharness/backends/llm/cli/discovery.py:60
            System.setdefault("NoDefaultCurrentDirectoryInExePath", "1");                                   // src: vvaharness/backends/llm/cli/discovery.py:64
            String cmdPath = whichAbs(List.of("claude", "claude.cmd", "claude.CMD"));                       // src: vvaharness/backends/llm/cli/discovery.py:65
            if (cmdPath != null) {
                Path pkg = Path.of(cmdPath).parent().resolve("node_modules/@anthropic-ai/claude-code");
                if (pkg.resolve("bin/claude.exe").exists()) return List.of(pkg.resolve("bin/claude.exe"));  // >=2.1.x native // src: vvaharness/backends/llm/cli/discovery.py:70
                if (pkg.resolve("cli.js").exists()) {                                                       // <=2.0.x Node + cli.js // src: vvaharness/backends/llm/cli/discovery.py:74
                    String node = whichAbs(List.of("node"));
                    return List.of(node != null ? node : "node", pkg.resolve("cli.js"));                    // src: vvaharness/backends/llm/cli/discovery.py:76
                }
                return List.of(cmdPath);                                                                    // the .cmd shim by full path // src: vvaharness/backends/llm/cli/discovery.py:78
            }
            Log.warning("'claude' not found on PATH; using bare name");
            return List.of("claude");                                                                       // src: vvaharness/backends/llm/cli/discovery.py:80
        }
        String resolved = Shutil.which("claude");                                                           // src: vvaharness/backends/llm/cli/discovery.py:82
        if (resolved != null) return List.of(resolved);                                                     // src: vvaharness/backends/llm/cli/discovery.py:84
        Log.warning("'claude' not found on PATH; using bare name");
        return List.of("claude");                                                                           // src: vvaharness/backends/llm/cli/discovery.py:86
    }

    /** Both streams of one claude invocation, or "" when it could not run. */
    @src("vvaharness/backends/llm/cli/discovery.py:100")
    String cliOutput(List<String> args, int timeout) {
        // timeout default 20 s; the parse probe uses 30 s
        try {
            Result r = Subprocess.run(CLAUDE_CMD + args, timeout);                                          // src: vvaharness/backends/llm/cli/discovery.py:103
            return r.stdout + r.stderr;                                                                     // src: vvaharness/backends/llm/cli/discovery.py:107
        } catch (Exception e) {
            return "";                                                                                      // src: vvaharness/backends/llm/cli/discovery.py:106
        }
    }

    /** True once the installed claude build is at least the version floor that fixed --resume after a kill. */
    @src("vvaharness/backends/llm/cli/discovery.py:110")
    boolean resumeCapable() {
        Match m = Regex.search("(\\d+)\\.(\\d+)\\.(\\d+)", cliOutput(List.of("--version"), θ["code.backends.llm.cli.discovery.probe_timeout_s"])); // src: vvaharness/backends/llm/cli/discovery.py:114
        if (m == null) return false;                                                                        // unparsable keeps the replay path // src: vvaharness/backends/llm/cli/discovery.py:116
        return m.versionTuple() >= θ["code.backends.llm.cli.discovery.resume_min_version"];                  // src: vvaharness/backends/llm/cli/discovery.py:117
    }

    /** Run flag behind two sentinels so argument parsing always fails, and return what it said. */
    @src("vvaharness/backends/llm/cli/discovery.py:120")
    String parseProbe(String flag) {
        return cliOutput(List.of(flag, PROBE_SENTINELS, "-p", "x", "--output-format", "json"), 30);         // src: vvaharness/backends/llm/cli/discovery.py:122
    }

    /** --help is trusted only as positive evidence; otherwise a parse probe decides. */
    @src("vvaharness/backends/llm/cli/discovery.py:125")
    boolean flagAccepted(String flag, String helpText) {
        if (helpText.contains(flag)) return true;                                                           // src: vvaharness/backends/llm/cli/discovery.py:127
        if (helpText.isEmpty()) return false;                                                               // src: vvaharness/backends/llm/cli/discovery.py:129
        String out = parseProbe(flag);                                                                      // src: vvaharness/backends/llm/cli/discovery.py:131
        return !out.contains("unknown option '" + flag + "'") && PROBE_SENTINELS.anyMatch(s -> out.contains(s)); // src: vvaharness/backends/llm/cli/discovery.py:132
    }

    /** Probe the installed CLI once and memoise the flags/values it accepts. */
    @src("vvaharness/backends/llm/cli/discovery.py:136")
    Map cliCapabilities() {
        if (capsCache != null) return capsCache;                                                            // src: vvaharness/backends/llm/cli/discovery.py:139
        String helpText = cliOutput(List.of("--help"), θ["code.backends.llm.cli.discovery.probe_timeout_s"]); // src: vvaharness/backends/llm/cli/discovery.py:141
        Set<String> modes = new Set();
        Match m = Regex.search("--permission-mode\\b.*?\\(choices:\\s*([^)]*)\\)", helpText);              // choices list only // src: vvaharness/backends/llm/cli/discovery.py:144
        if (m != null) modes = Regex.findAll("\"([^\"]+)\"", m.group(1));                                   // src: vvaharness/backends/llm/cli/discovery.py:147
        boolean probed = !helpText.isEmpty();                                                               // src: vvaharness/backends/llm/cli/discovery.py:148
        capsCache = Map.of(
            "effort", flagAccepted("--effort", helpText),                                                   // src: vvaharness/backends/llm/cli/discovery.py:150
            "max_turns", flagAccepted("--max-turns", helpText),                                             // src: vvaharness/backends/llm/cli/discovery.py:151
            "max_budget", flagAccepted("--max-budget-usd", helpText),                                       // src: vvaharness/backends/llm/cli/discovery.py:152
            "tools", flagAccepted("--tools", helpText),                                                     // --allowedTools alone left Bash/Edit/Write // src: vvaharness/backends/llm/cli/discovery.py:154
            "disallowed_tools", flagAccepted("--disallowedTools", helpText),                                // src: vvaharness/backends/llm/cli/discovery.py:155
            "permission_prompts", flagAccepted("--permission-prompts", helpText),                           // src: vvaharness/backends/llm/cli/discovery.py:156
            "strict_mcp_config", flagAccepted("--strict-mcp-config", helpText),                             // src: vvaharness/backends/llm/cli/discovery.py:157
            "setting_sources", flagAccepted("--setting-sources", helpText),                                 // src: vvaharness/backends/llm/cli/discovery.py:158
            "disable_slash_commands", flagAccepted("--disable-slash-commands", helpText),                   // src: vvaharness/backends/llm/cli/discovery.py:159
            "restricted", flagAccepted("--restricted", helpText),                                           // the only read jail on this route // src: vvaharness/backends/llm/cli/discovery.py:161
            "json_schema", !probed || flagAccepted("--json-schema", helpText),                              // optimistic when unprobed // src: vvaharness/backends/llm/cli/discovery.py:163
            "permission_modes", modes,                                                                      // src: vvaharness/backends/llm/cli/discovery.py:164
            "probed", probed,                                                                               // src: vvaharness/backends/llm/cli/discovery.py:165
            "resume", resumeCapable());                                                                     // version floor, not a flag // src: vvaharness/backends/llm/cli/discovery.py:167
        return capsCache;
    }

    /** Map a requested --permission-mode to one this CLI accepts; never bypassPermissions. */
    @src("vvaharness/backends/llm/cli/discovery.py:173")
    String safePermissionMode(String requested) {
        Set<String> modes = cliCapabilities().get("permission_modes");                                      // src: vvaharness/backends/llm/cli/discovery.py:176
        if (modes.isEmpty()) return requested;                                                              // couldn't read help // src: vvaharness/backends/llm/cli/discovery.py:177
        if (modes.contains(requested)) return requested;                                                    // src: vvaharness/backends/llm/cli/discovery.py:179
        for (String m : PERMISSION_FALLBACKS) {                                                             // src: vvaharness/backends/llm/cli/discovery.py:181
            if (modes.contains(m)) {
                Log.warning(Event.CLI_PERMISSION_MODE_UNAVAILABLE, requested, m);
                return m;                                                                                   // src: vvaharness/backends/llm/cli/discovery.py:184
            }
        }
        String fallback = modes.sorted().firstWhere(m -> m != "bypassPermissions");                         // src: vvaharness/backends/llm/cli/discovery.py:186
        if (fallback == null) throw new RuntimeError("refusing to run a scan session under bypassPermissions"); // src: vvaharness/backends/llm/cli/discovery.py:189
        Log.warning(Event.CLI_NO_PERMISSION_MODE, PERMISSION_FALLBACKS, fallback);
        return fallback;                                                                                    // src: vvaharness/backends/llm/cli/discovery.py:195
    }

    @src("vvaharness/backends/llm/cli/discovery.py:198")
    String tail(String text, int n) {
        // n defaults to 1200 chars of error context
        if (text == null || text.isEmpty()) return "";                                                      // src: vvaharness/backends/llm/cli/discovery.py:199
        text = text.strip();
        if (text.length() <= n) return text;                                                                // src: vvaharness/backends/llm/cli/discovery.py:202
        return "...\n" + text.substring(text.length() - n);                                                 // src: vvaharness/backends/llm/cli/discovery.py:204
    }

    /** argv with long args (system prompts) elided so error lines stay readable. */
    @src("vvaharness/backends/llm/cli/discovery.py:207")
    String shortCmd(List<String> cmd) {
        List<String> out = new List();
        for (String a : cmd) {
            if (a.length() > 80) out.add(a.substring(0, 60) + "...<" + a.length() + " chars>");             // src: vvaharness/backends/llm/cli/discovery.py:211
            else out.add(a);
        }
        return String.join(" ", out);
    }

    /** If stdout is a json envelope carrying an error, a one-line summary of it. */
    @src("vvaharness/backends/llm/cli/discovery.py:219")
    String extractEnvelopeError(String stdout) {
        if (stdout == null || stdout.isEmpty()) return null;                                                // src: vvaharness/backends/llm/cli/discovery.py:221
        String s = stdout.strip();
        int start = firstOf(s.indexOf("<curly>"), s.indexOf("["));                                          // whichever bracket comes first // src: vvaharness/backends/llm/cli/discovery.py:225
        if (start < 0) return null;                                                                         // src: vvaharness/backends/llm/cli/discovery.py:227
        Object env;
        try { env = Json.loads(s.substring(start)); } catch (Exception e) { return null; }                  // src: vvaharness/backends/llm/cli/discovery.py:229
        if (env instanceof List) {                                                                          // src: vvaharness/backends/llm/cli/discovery.py:233
            env = env.reversed().firstWhere(e -> e.type == "result" || e.isError || List.of("error", "error_during_execution").contains(e.subtype)); // src: vvaharness/backends/llm/cli/discovery.py:235
        }
        if (!(env instanceof Map)) return null;                                                             // src: vvaharness/backends/llm/cli/discovery.py:242
        if (!(env.isError || List.of("error", "error_during_execution").contains(env.subtype))) return null; // src: vvaharness/backends/llm/cli/discovery.py:244
        Object status = env.apiErrorStatus;                                                                 // src: vvaharness/backends/llm/cli/discovery.py:246
        String msg = firstNonEmpty(env.result, env.error, env.message, "unknown error");                    // src: vvaharness/backends/llm/cli/discovery.py:247
        return status != null ? status + " " + msg : msg;                                                   // src: vvaharness/backends/llm/cli/discovery.py:248
    }

    @src("vvaharness/backends/llm/cli/discovery.py:251")
    String formatCliError(String prefix, List<String> cmd, Result result) {
        String envErr = extractEnvelopeError(result.stdout);                                                // src: vvaharness/backends/llm/cli/discovery.py:252
        if (envErr != null) return prefix + ": " + envErr + " (rc=" + result.returncode + ")";              // src: vvaharness/backends/llm/cli/discovery.py:254
        // redact BEFORE tail, never after: a credential straddling the cut loses its anchor
        String errTail = tail(Redact.redact(result.stderr), 1200);                                          // src: vvaharness/backends/llm/cli/discovery.py:257
        String outTail = tail(Redact.redact(result.stdout), 1200);                                          // src: vvaharness/backends/llm/cli/discovery.py:258
        List<String> parts = List.of(prefix + " (rc=" + result.returncode + ")", "cmd: " + shortCmd(cmd));
        if (!errTail.isEmpty()) parts.add("stderr tail:\n" + errTail);                                      // src: vvaharness/backends/llm/cli/discovery.py:263
        if (!outTail.isEmpty()) parts.add("stdout tail:\n" + outTail);                                      // src: vvaharness/backends/llm/cli/discovery.py:265
        if (errTail.isEmpty() && outTail.isEmpty()) parts.add("no stdout/stderr captured");                 // src: vvaharness/backends/llm/cli/discovery.py:267
        return String.join("\n", parts);
    }
}
