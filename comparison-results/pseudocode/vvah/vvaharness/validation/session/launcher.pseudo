    String failureReason(Object terminal, int exitCode) {
        if (terminal == null) return "no terminal result; exit=" + exitCode; // src: vvaharness/validation/session/launcher.py:417
        String reason = "session ended subtype=" + terminal.subtype; // src: vvaharness/validation/session/launcher.py:419
        if (terminal.subtype == "error_max_structured_output_retries") reason += "; validation-schema response retries exhausted or fallback retracted output"; // src: vvaharness/validation/session/launcher.py:420
        if (!terminal.errors.isEmpty()) reason += "; errors=" + join(" | ", terminal.errors.map(e -> str(e))); // src: vvaharness/validation/session/launcher.py:426
        return reason;
    }
    Pair boundedStream(Callable stream, Double timeout, String effort, Theta θ) {
        if (timeout == null || timeout <= 0) return await stream(); // src: vvaharness/validation/session/launcher.py:444
        AsyncTimeout deadline = asyncTimeout(timeout + θ["code.validation.session.launcher.backstop_grace_s"]); // src: vvaharness/validation/session/launcher.py:111
        try { with (deadline) { return await stream(); } } // src: vvaharness/validation/session/launcher.py:448
        catch (TimeoutError e) { if (!deadline.expired()) throw e; throw callTimeoutError("s11", "backstop", timeout, effort, e); } // src: vvaharness/validation/session/launcher.py:450
    }
