// file: vvaharness/remediation_agent/options.py
// Parse the remediate command's CLI flags (--resume, --interactive/-i, --verbose/-v, --mode, --top).

@executedBy(CODE) @role(types)
record RemediateOptions(boolean resume, boolean interactive, boolean verbose, String mode, Object top) { }

@executedBy(CODE) @role(config) @stage("S10")
class RemediationAgentOptions {

    RemediateOptions parseOptions(List<String> args, Theta θ) {
        String mode = modeFrom(args, θ);                                                            // src: vvaharness/remediation_agent/options.py:37
        if (!θ["code.remediation_agent.options.valid_modes"].contains(mode)) {                      // src: vvaharness/remediation_agent/options.py:38
            throw new ValueError("invalid --mode; choose fix or report-only");                      // src: vvaharness/remediation_agent/options.py:39
        }
        boolean resume = args.contains("--resume");                                                 // src: vvaharness/remediation_agent/options.py:41
        boolean interactive = args.contains("--interactive") || args.contains("-i");                // src: vvaharness/remediation_agent/options.py:42
        boolean verbose = args.contains("--verbose") || args.contains("-v");                        // src: vvaharness/remediation_agent/options.py:43
        Object top = Select.parseTopArg(args);                                                      // src: vvaharness/remediation_agent/options.py:45  (may raise ValueError)
        return new RemediateOptions(resume, interactive, verbose, mode, top);                       // src: vvaharness/remediation_agent/options.py:40
    }

    String modeFrom(List<String> args, Theta θ) {
        for (int i = 0; i < args.size(); i++) {                                                     // src: vvaharness/remediation_agent/options.py:51
            String a = args.get(i);
            if (a.equals("--mode") && i + 1 < args.size()) return args.get(i + 1);                  // src: vvaharness/remediation_agent/options.py:52
            if (a.startsWith("--mode=")) return a.split("=", 1)[1];                                 // src: vvaharness/remediation_agent/options.py:54
        }
        return θ["code.remediation_agent.options.default_mode"];                                    // src: vvaharness/remediation_agent/options.py:56
    }
}
