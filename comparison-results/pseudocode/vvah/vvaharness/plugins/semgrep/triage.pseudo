// file: vvaharness/plugins/semgrep/triage.py
// Builds a specialist definition in CODE; the triage procedure and evidence gates are MODEL instructions.

@executedBy(CODE) @role(agent)
class SemgrepTriage {
    @src("vvaharness/plugins/semgrep/triage.py:39")
    SubagentDefinition subagent(List<String> tools, Theta θ) {
        return new SubagentDefinition("semgrep-triage", "Triage Semgrep leads against the code graph", prompt(θ), tools);
    }
    @executedBy(MODEL) @role(prompt)
    @src("vvaharness/plugins/semgrep/triage.py:21")
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.persona("Triage findings against the code graph; return leads, not verdicts");
        p.step(1, "Call GraphSemgrepFindings for the supplied file");
        p.step(2, "For each distinct rule call GraphSemgrepTaintTrace; drop traces whose source is not attacker-controlled");
        p.step(3, "Call GraphSemgrepSinkCallers; an uncalled sink is not exploitable as written");
        p.step(4, "Call GraphSemgrepCoverage once; disclose an incomplete scan");
        p.threshold(θ["p.semgrep_triage.lead_limit"]); // src: vvaharness/plugins/semgrep/triage.py:33
        p.format("One line per lead: file:line, rule id, CWE and one reason; state dropped count");
        p.forbid("Reporting a lead whose trace could not be read; say trace absent instead");
        return p;
    }
    @executedBy(MODEL)
    @src("vvaharness/plugins/semgrep/triage.py:21")
    List<Lead> run(String file, Theta θ) {
        List<Map> findings = callTool("GraphSemgrepFindings", file);
        List<Lead> leads = new List();
        for (String rule : distinctRuleIds(findings)) {
            List<Map> trace = callTool("GraphSemgrepTaintTrace", rule);
            if (!traceWasReadable(trace) || !attackerControlledSource(trace)) continue;
            List<Map> callers = callTool("GraphSemgrepSinkCallers", file);
            if (!hasReachableSink(callers, rule)) continue;
            leads.add(modelLead(findings, rule, trace, callers));
        }
        discloseIncompleteCoverage(callTool("GraphSemgrepCoverage"));
        return modelRankStrongest(leads).head(θ["p.semgrep_triage.lead_limit"]); // src: vvaharness/plugins/semgrep/triage.py:33
    }
}
