// file: vulnhunter-agent/agent/_transient.py
// Shared transient-error classifier (HTTP 429 / 5xx / overload) used by _llm.py and runner.py
// to decide whether an SDK failure is worth retrying. Typed status wins over message text.

@executedBy(CODE) @role(rule_set) @stage("infra")
class Transient {

    // _TRANSIENT_INDICATOR_RE: word-bounded HTTP codes + phrase arms, case-insensitive
    boolean isTransientText(String text, Theta θ) {
        List<String> arms = θ["code.agent.transient.indicator_patterns"];                          // src: vulnhunter-agent/agent/_transient.py:51
        return regexSearchAny(arms, text, IGNORECASE);                                              // src: vulnhunter-agent/agent/_transient.py:68
    }

    boolean isTransientStatus(Object status, Theta θ) {
        if (!(status instanceof Integer)) return false;                                             // src: vulnhunter-agent/agent/_transient.py:77
        return status == 429 || status >= θ["code.agent.transient.server_error_floor"];            // src: vulnhunter-agent/agent/_transient.py:77
    }

    // classify: typed-first; a non-transient typed status (400/401/404) suppresses the text scan.
    boolean classify(Object status, String text, Theta θ) {
        if (θ["code.agent.transient.typed_status_authoritative"] && status instanceof Integer) return isTransientStatus(status, θ); // src: vulnhunter-agent/agent/_transient.py:99
        return isTransientText(text, θ);                                                            // src: vulnhunter-agent/agent/_transient.py:101
    }
}
