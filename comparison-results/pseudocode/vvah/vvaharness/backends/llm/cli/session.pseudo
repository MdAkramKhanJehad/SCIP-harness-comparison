        if (maxBudgetUsd != null && maxBudgetUsd != 0 && Discovery.cliCapabilities().get("max_budget")) cmd.addAll(List.of("--max-budget-usd", maxBudgetUsd.toString())); // src: vvaharness/backends/llm/cli/session.py:377
        boolean nativeTurnCap = maxTurns != null && maxTurns != 0 && Discovery.cliCapabilities().get("max_turns"); // src: vvaharness/backends/llm/cli/session.py:379
        if (nativeTurnCap) cmd.addAll(List.of("--max-turns", String.valueOf(maxTurns)));                    // src: vvaharness/backends/llm/cli/session.py:380
        cmd.addAll(List.of("--permission-mode", Discovery.safePermissionMode(permissionMode)));             // src: vvaharness/backends/llm/cli/session.py:383
        cmd.addAll(List.of("--output-format", "stream-json", "--verbose"));                                 // src: vvaharness/backends/llm/cli/session.py:384
        String tier = Env.effectiveEffort(effort);                                                          // src: vvaharness/backends/llm/cli/session.py:386
        int rawWallClock = (timeout != null && timeout != 0) ? timeout : AGENTIC_TIMEOUT;                   // src: vvaharness/backends/llm/cli/session.py:387
        int wallClock = LlmModels.effortScaledSeconds(rawWallClock, tier, ClockKind.SESSION);               // src: vvaharness/backends/llm/cli/session.py:388
        // armed only when a cap was asked for and the binary cannot enforce it
        Integer watchdogCap = (maxTurns != null && maxTurns != 0 && !nativeTurnCap) ? maxTurns : null;      // src: vvaharness/backends/llm/cli/session.py:390
