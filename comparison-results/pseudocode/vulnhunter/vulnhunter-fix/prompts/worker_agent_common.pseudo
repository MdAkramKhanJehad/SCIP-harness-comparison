        Prompt p = new Prompt();
        p.context("manifest at <MANIFEST_PATH>");                                                   // src: vulnhunter-fix/prompts/worker_agent_common.md:48
        p.choose(θ["p.worker_agent_common.manifest_test_framework_values"]);                        // src: vulnhunter-fix/prompts/worker_agent_common.md:57
        p.choose(θ["p.worker_agent_common.manifest_test_convention_values"]);                       // src: vulnhunter-fix/prompts/worker_agent_common.md:58
        p.choose(θ["p.worker_agent_common.manifest_model_values"]);                                 // src: vulnhunter-fix/prompts/worker_agent_common.md:61
        p.choose(θ["p.worker_agent_common.manifest_test_policy_values"]);                           // src: vulnhunter-fix/prompts/worker_agent_common.md:62
        p.threshold(θ["p.worker_agent_common.manifest_max_retries"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:63
        p.forbid(θ["p.worker_agent_common.branch_name_as_is_masked"]);                              // src: vulnhunter-fix/prompts/worker_agent_common.md:69
        p.rule(θ["p.worker_agent_common.mask_scope_branch_and_title_only"]);                        // src: vulnhunter-fix/prompts/worker_agent_common.md:69
        p.must(θ["p.worker_agent_common.security_test_always_runs"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:71
        return p;
    }

    Prompt executionSteps(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.worker_agent_common.retry_reads_error_context"]);                            // src: vulnhunter-fix/prompts/worker_agent_common.md:82
        p.step(2, θ["p.worker_agent_common.findings_sequential"]);                                  // src: vulnhunter-fix/prompts/worker_agent_common.md:84
        p.rule(θ["p.worker_agent_common.exploit_run_to_confirm"]);                                  // src: vulnhunter-fix/prompts/worker_agent_common.md:99
        p.rule(θ["p.worker_agent_common.not_patchable_result"]);                                    // src: vulnhunter-fix/prompts/worker_agent_common.md:116
        p.must(θ["p.worker_agent_common.infer_test_location"]);                                     // src: vulnhunter-fix/prompts/worker_agent_common.md:125
        p.threshold(θ["p.worker_agent_common.test_location_examples_count"]);                       // src: vulnhunter-fix/prompts/worker_agent_common.md:127
        p.rule(θ["p.worker_agent_common.create_resolved_dir"]);                                     // src: vulnhunter-fix/prompts/worker_agent_common.md:129
        p.format(θ["p.worker_agent_common.scaffold_name_pattern"]);                                 // src: vulnhunter-fix/prompts/worker_agent_common.md:133
        p.must(θ["p.worker_agent_common.cite_final_name_in_assertion_target"]);                     // src: vulnhunter-fix/prompts/worker_agent_common.md:134
        p.rule(θ["p.worker_agent_common.test_passes_already_fixed"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:142
        p.tiebreak(θ["p.worker_agent_common.ambiguous_conservative"]);                              // src: vulnhunter-fix/prompts/worker_agent_common.md:148
        p.rule(θ["p.worker_agent_common.placeholder_check_result"]);                                // src: vulnhunter-fix/prompts/worker_agent_common.md:151
        p.rule(θ["p.worker_agent_common.path_a_self_consistent_pr"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:176
        p.rule(θ["p.worker_agent_common.path_b_breaking_change_result"]);                           // src: vulnhunter-fix/prompts/worker_agent_common.md:182
        p.rule(θ["p.worker_agent_common.cross_repo_result"]);                                       // src: vulnhunter-fix/prompts/worker_agent_common.md:191
        p.rule(θ["p.worker_agent_common.test_fail_try_alternative"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:199
        p.rule(θ["p.worker_agent_common.exploit_expected_blocked"]);                                // src: vulnhunter-fix/prompts/worker_agent_common.md:208
        p.rule(θ["p.worker_agent_common.legacy_security_tests_cleanup"]);                           // src: vulnhunter-fix/prompts/worker_agent_common.md:214
        p.rule(θ["p.worker_agent_common.stash_and_run_preferred"]);                                 // src: vulnhunter-fix/prompts/worker_agent_common.md:219
        p.rule(θ["p.worker_agent_common.non_discriminating_rewrite"]);                              // src: vulnhunter-fix/prompts/worker_agent_common.md:234
        p.threshold(θ["p.worker_agent_common.regression_tail"]);                                    // src: vulnhunter-fix/prompts/worker_agent_common.md:265
        p.choose(θ["p.worker_agent_common.regression_status_values"]);                              // src: vulnhunter-fix/prompts/worker_agent_common.md:279
        p.rule(θ["p.worker_agent_common.env_error_signals"]);                                       // src: vulnhunter-fix/prompts/worker_agent_common.md:281
        p.rule(θ["p.worker_agent_common.regressions_adjust_else_cannot_fix"]);                      // src: vulnhunter-fix/prompts/worker_agent_common.md:289
        p.rule(θ["p.worker_agent_common.must_pass_env_error_failed"]);                              // src: vulnhunter-fix/prompts/worker_agent_common.md:293
        p.must(θ["p.worker_agent_common.promote_scaffold_mandatory"]);                              // src: vulnhunter-fix/prompts/worker_agent_common.md:298
        p.rule(θ["p.worker_agent_common.promote_into_canonical_file"]);                             // src: vulnhunter-fix/prompts/worker_agent_common.md:301
        p.forbid(θ["p.worker_agent_common.no_canonical_create_convention_file"]);                   // src: vulnhunter-fix/prompts/worker_agent_common.md:306
        p.checklist(θ["p.worker_agent_common.committed_test_shape"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:308
        p.must(θ["p.worker_agent_common.scope_check_revert_unrelated"]);                            // src: vulnhunter-fix/prompts/worker_agent_common.md:320
        p.rule(θ["p.worker_agent_common.commit_stage_set"]);                                        // src: vulnhunter-fix/prompts/worker_agent_common.md:324
        p.forbid(θ["p.worker_agent_common.commit_severity_mask_manual"]);                           // src: vulnhunter-fix/prompts/worker_agent_common.md:346
        return p;
    }

    Prompt resultSection(Theta θ) {
        Prompt p = new Prompt();
        p.choose(θ["p.worker_agent_common.result_status_values"]);                                  // src: vulnhunter-fix/prompts/worker_agent_common.md:356
        p.choose(θ["p.worker_agent_common.result_exploit_status_values"]);                          // src: vulnhunter-fix/prompts/worker_agent_common.md:359
        p.format(θ["p.worker_agent_common.result_use_vuln_id_key"]);                                // src: vulnhunter-fix/prompts/worker_agent_common.md:388
        p.forbid(θ["p.worker_agent_common.no_llm_review_terminal"]);                                // src: vulnhunter-fix/prompts/worker_agent_common.md:389
        p.rule(θ["p.worker_agent_common.tier_judgment_only_on_llm_review"]);                        // src: vulnhunter-fix/prompts/worker_agent_common.md:391
        p.format(θ["p.worker_agent_common.caller_pointer_format"]);                                 // src: vulnhunter-fix/prompts/worker_agent_common.md:392
        p.threshold(θ["p.worker_agent_common.design_options_min_and_recommended"]);                 // src: vulnhunter-fix/prompts/worker_agent_common.md:396
        p.forbid(θ["p.worker_agent_common.files_created_excludes_scaffolds"]);                      // src: vulnhunter-fix/prompts/worker_agent_common.md:399
        p.must(θ["p.worker_agent_common.test_file_points_to_canonical"]);                           // src: vulnhunter-fix/prompts/worker_agent_common.md:402
        p.must(θ["p.worker_agent_common.stable_hash_fields"]);                                      // src: vulnhunter-fix/prompts/worker_agent_common.md:403
        return p;
    }

    Prompt statusDefinitions(Theta θ) {
        Prompt p = new Prompt();
        p.context(θ["p.worker_agent_common.status_definitions"]);                                   // src: vulnhunter-fix/prompts/worker_agent_common.md:418
        p.rule(θ["p.worker_agent_common.requires_human_decision_signals"]);                         // src: vulnhunter-fix/prompts/worker_agent_common.md:428
        p.exemption(θ["p.worker_agent_common.requires_human_decision_exclusions"]);                 // src: vulnhunter-fix/prompts/worker_agent_common.md:434
        p.rule(θ["p.worker_agent_common.recommended_only_with_justification"]);                     // src: vulnhunter-fix/prompts/worker_agent_common.md:439
        return p;
    }

    Prompt constraints(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.worker_agent_common.worker_no_push_pr_issue"]);                               // src: vulnhunter-fix/prompts/worker_agent_common.md:443
        p.forbid(θ["p.worker_agent_common.no_other_branch_modification"]);                          // src: vulnhunter-fix/prompts/worker_agent_common.md:445
        p.forbid(θ["p.worker_agent_common.no_reads_outside_worktree"]);                             // src: vulnhunter-fix/prompts/worker_agent_common.md:446
        p.forbid("commit exploit files");                                                           // src: vulnhunter-fix/prompts/worker_agent_common.md:447
        p.forbid(θ["p.worker_agent_common.no_tests_outside_resolved_dir"]);                         // src: vulnhunter-fix/prompts/worker_agent_common.md:448
        p.must(θ["p.worker_agent_common.honest_result_on_failure"]);                                // src: vulnhunter-fix/prompts/worker_agent_common.md:449
        p.format(θ["p.worker_agent_common.concise_output"]);                                        // src: vulnhunter-fix/prompts/worker_agent_common.md:450
        return p;
    }

    // ---------------- procedure the model carries out ----------------

    WorkerResult execute(Manifest m, Theta θ) {
        // one root-cause group (same root cause AND same files), own worktree, no push/PR/issue
        assert m.groups == θ["p.worker_agent_common.scope_one_root_cause_group"];                   // src: vulnhunter-fix/prompts/worker_agent_common.md:41
        assert θ["p.worker_agent_common.own_worktree"];                                             // src: vulnhunter-fix/prompts/worker_agent_common.md:42
        int maxRetries = m.maxRetries;  // manifest default θ["p.worker_agent_common.manifest_max_retries"]
        if (m.maxRetries == null) maxRetries = θ["p.worker_agent_common.manifest_max_retries"];     // src: vulnhunter-fix/prompts/worker_agent_common.md:63
        setup(m, θ);
        List<FindingResult> results = new List();
        // findings processed sequentially
        if (θ["p.worker_agent_common.findings_sequential"] == "sequential") {                       // src: vulnhunter-fix/prompts/worker_agent_common.md:84
            for (Finding f : m.findings) results.add(processFinding(f, m, maxRetries, θ));
        }
        WorkerResult r = writeResult(results, m, θ);
        if (θ["p.worker_agent_common.result_json_required"]) write(m.resultPath, r);                // src: vulnhunter-fix/prompts/worker_agent_common.md:44
        return r;
    }

    void setup(Manifest m, Theta θ) {
        bash("cd <repo_path>; git checkout -b <branch_name>");                                      // src: vulnhunter-fix/prompts/worker_agent_common.md:78
        // branch name is masked fix/code-quality-<descriptor>-<hash>; use as-is, no VULN IDs
        if (θ["p.worker_agent_common.branch_name_as_is_masked"]) assert !m.branchName.containsVulnId(); // src: vulnhunter-fix/prompts/worker_agent_common.md:69
        // only branch name and PR title are masked; VULN ID may appear in commit body and PR/issue body
        List<String> masked = θ["p.worker_agent_common.mask_scope_branch_and_title_only"];          // src: vulnhunter-fix/prompts/worker_agent_common.md:69
        if (m.retryAttempt > 0 && θ["p.worker_agent_common.retry_reads_error_context"]) readErrorContextAndChangeApproach(m.errorContext); // src: vulnhunter-fix/prompts/worker_agent_common.md:82
    }

    FindingResult processFinding(Finding f, Manifest m, int maxRetries, Theta θ) {
        // Step A: exploit demonstration in $TMPDIR/vulnfix-exploits (never committed)
        Exploit ex = writeExploit(f, "$TMPDIR/vulnfix-exploits/exploit_" + f.id);                   // src: vulnhunter-fix/prompts/worker_agent_common.md:96
        if (θ["p.worker_agent_common.exploit_run_to_confirm"]) ex.run();                            // src: vulnhunter-fix/prompts/worker_agent_common.md:99
        // Step B: patchability check
        if (needsExternalValues(f) || needsCrossServiceCoordination(f) || needsPostMergeManualSteps(f)) { // src: vulnhunter-fix/prompts/worker_agent_common.md:109
            return FindingResult.of(θ["p.worker_agent_common.not_patchable_result"], "<exact reason>"); // src: vulnhunter-fix/prompts/worker_agent_common.md:116
        }
        // Step C: RED security test (always runs regardless of test_policy)
        assert θ["p.worker_agent_common.security_test_always_runs"];                                // src: vulnhunter-fix/prompts/worker_agent_common.md:71
        TestFile scaffold = writeSecurityTest(f, m, θ);
        if (scaffold.run().passed) return FindingResult.of(θ["p.worker_agent_common.test_passes_already_fixed"]); // src: vulnhunter-fix/prompts/worker_agent_common.md:142
        // Step D: fix (GREEN)
        FindingResult d = implementFix(f, m, scaffold, maxRetries, θ);
        if (d != null) return d;
        // Step E: exploit blocked, then delete exploit
        Outcome eo = ex.run();
        boolean blocked = θ["p.worker_agent_common.exploit_expected_blocked"] && (eo.failed || eo.raised || eo.safe); // src: vulnhunter-fix/prompts/worker_agent_common.md:208
        bash("rm $TMPDIR/vulnfix-exploits/exploit_<VULN_ID>.*; rmdir $TMPDIR/vulnfix-exploits");    // src: vulnhunter-fix/prompts/worker_agent_common.md:212
        if (θ["p.worker_agent_common.legacy_security_tests_cleanup"]) bash("rmdir security_tests || true"); // src: vulnhunter-fix/prompts/worker_agent_common.md:214
        // Step E.5: discrimination evidence
        Discrimination de = recordDiscrimination(f, scaffold, θ);
        if (de.preFix != "fail" || de.postFix != "pass") {
            // R4 violation: back to Step C and rewrite the test
            if (θ["p.worker_agent_common.non_discriminating_rewrite"]) return processFinding(f, m, maxRetries, θ); // src: vulnhunter-fix/prompts/worker_agent_common.md:234
        }
        // Step F: regression check
        FindingResult rf = regressionCheck(f, m, θ);
        if (rf != null && rf.terminal) return rf;
        // Step G: promote scaffold into canonical test
        String canonical = promoteScaffold(f, scaffold, θ);
        // Step H: scope check
        scopeCheck(f, θ);
        // Step I: commit
        commit(f, canonical, θ);
        FindingResult ok = FindingResult.of("VERIFIED");
        ok.exploitStatus = blocked ? "BLOCKED" : "ERROR";
        ok.discriminationEvidence = de;
        ok.regressionStatus = rf.regressionStatus;
        ok.testFile = canonical;
        return ok;
    }

    TestFile writeSecurityTest(Finding f, Manifest m, Theta θ) {
        String dir;
        if (θ["p.worker_agent_common.infer_test_location"]) {                                       // src: vulnhunter-fix/prompts/worker_agent_common.md:125
            // do NOT use test_dir_hint as a literal path; infer from 1-2 nearby existing tests
            List<TestFile> examples = findNearbyTests(f.location.file, m.testConvention, θ["p.worker_agent_common.test_location_examples_count"]); // src: vulnhunter-fix/prompts/worker_agent_common.md:127
            dir = derivePattern(examples);                                                          // src: vulnhunter-fix/prompts/worker_agent_common.md:128
        } else {
            dir = m.testDirHint;
        }
        if (θ["p.worker_agent_common.create_resolved_dir"] && !exists(dir)) mkdir(dir);             // src: vulnhunter-fix/prompts/worker_agent_common.md:129
        // same language; import and call the real production function; refactor for testability if needed
        if (!importable(f)) refactorForTestability(f);                                              // src: vulnhunter-fix/prompts/worker_agent_common.md:132
        TestFile t = new TestFile(dir + "/" + θ["p.worker_agent_common.scaffold_name_pattern"].with(f.id)); // src: vulnhunter-fix/prompts/worker_agent_common.md:133
        // decide the final committed (repo-convention) name now; cite it in E.5 assertion_target
        if (θ["p.worker_agent_common.cite_final_name_in_assertion_target"]) t.finalName = repoConventionName(f); // src: vulnhunter-fix/prompts/worker_agent_common.md:134
        return t;
    }

    FindingResult implementFix(Finding f, Manifest m, TestFile scaffold, int maxRetries, Theta θ) {
        read(f.location.file);                                                                      // src: vulnhunter-fix/prompts/worker_agent_common.md:146
        // ambiguous strategy -> most conservative secure approach
        Strategy s = f.proposedFix.strategy.ambiguous() ? θ["p.worker_agent_common.ambiguous_conservative"] : f.proposedFix.strategy; // src: vulnhunter-fix/prompts/worker_agent_common.md:148
        // interface breaking-change check BEFORE applying
        if (changesInterface(s)) {                                                                  // src: vulnhunter-fix/prompts/worker_agent_common.md:155
            Callers callers = bash("grep -rn <functionName> .; gh search code <functionName> --owner=<target_org> -L 20"); // src: vulnhunter-fix/prompts/worker_agent_common.md:166
            if (callers.allInRepoAndUpdatableAtomically()) {
                // Path A: apply fix and update every call site in the same commit
                if (θ["p.worker_agent_common.path_a_self_consistent_pr"]) updateAllCallSites(callers); // src: vulnhunter-fix/prompts/worker_agent_common.md:176
            } else {
                // Path B: no fix, no branch; issue-only delivery with breaking_change_details
                return FindingResult.breaking(θ["p.worker_agent_common.path_b_breaking_change_result"], breakingChangeDetails(s, callers)); // src: vulnhunter-fix/prompts/worker_agent_common.md:182
            }
        }
        // cross-repo coordination: no one-sided partial fix
        if (requiresOtherRepo(s) && θ["p.worker_agent_common.cross_repo_result"]) return FindingResult.of("CANNOT_AUTO_FIX", "requires coordination with <other_repo>: <description>"); // src: vulnhunter-fix/prompts/worker_agent_common.md:191
        applyFix(s);                                                                                // src: vulnhunter-fix/prompts/worker_agent_common.md:147
        // post-fix placeholder check
        if (containsPlaceholder() && θ["p.worker_agent_common.placeholder_check_result"]) {         // src: vulnhunter-fix/prompts/worker_agent_common.md:151
            revert();
            return FindingResult.of("CANNOT_AUTO_FIX", "fix contains placeholder: <detail>");
        }
        for (int attempt = 0; attempt <= maxRetries; attempt++) {
            if (scaffold.run().passed) return null;                                                 // src: vulnhunter-fix/prompts/worker_agent_common.md:198
            applyFix(alternativeApproach(f));                                                       // src: vulnhunter-fix/prompts/worker_agent_common.md:199
        }
        return FindingResult.of(θ["p.worker_agent_common.test_fail_try_alternative"]);              // src: vulnhunter-fix/prompts/worker_agent_common.md:199
    }

    Discrimination recordDiscrimination(Finding f, TestFile scaffold, Theta θ) {
        Discrimination d = new Discrimination();
        d.method = θ["p.worker_agent_common.stash_and_run_preferred"];                              // src: vulnhunter-fix/prompts/worker_agent_common.md:219
        bash("git stash");
        d.preFix = scaffold.run().passed ? "pass" : "fail";
        bash("git stash pop");
        d.postFix = scaffold.run().passed ? "pass" : "fail";
        // must name the FINAL committed test path, not the verify_ scaffold
        d.assertionTarget = scaffold.finalName;                                                     // src: vulnhunter-fix/prompts/worker_agent_common.md:232
        return d;
    }

    FindingResult regressionCheck(Finding f, Manifest m, Theta θ) {
        String policy = m.testPolicy;                                                               // src: vulnhunter-fix/prompts/worker_agent_common.md:238
        String status;
        if (policy == "skip") {
            status = "SKIPPED";                                                                     // src: vulnhunter-fix/prompts/worker_agent_common.md:249
        } else {
            Run r;
            if (exists("pytest.ini") || exists("setup.cfg") || isDir("tests")) r = bash("python3 -m pytest --tb=short -q"); // src: vulnhunter-fix/prompts/worker_agent_common.md:251
            else if (exists("package.json")) r = bash("npm test");                                 // src: vulnhunter-fix/prompts/worker_agent_common.md:254
            else if (exists("go.mod")) r = bash("go test ./...");                                  // src: vulnhunter-fix/prompts/worker_agent_common.md:257
            else r = Run.exit(127, "(no test framework detected)");                                // src: vulnhunter-fix/prompts/worker_agent_common.md:263
            print(r.output.tail(θ["p.worker_agent_common.regression_tail"]));                      // src: vulnhunter-fix/prompts/worker_agent_common.md:265
            if (r.exit == 0) status = "NO_REGRESSIONS";                                             // src: vulnhunter-fix/prompts/worker_agent_common.md:279
            else if (r.output.containsAny(θ["p.worker_agent_common.env_error_signals"]) || r.exit == 127) status = "ENV_ERROR"; // src: vulnhunter-fix/prompts/worker_agent_common.md:281
            else status = "REGRESSIONS_FOUND";                                                      // src: vulnhunter-fix/prompts/worker_agent_common.md:280
        }
        assert θ["p.worker_agent_common.regression_status_values"].contains(status);                // src: vulnhunter-fix/prompts/worker_agent_common.md:279
        FindingResult out = new FindingResult();
        out.regressionStatus = status;
        if (status == "REGRESSIONS_FOUND" && policy != "skip") {
            // attempt adjustment; if impossible revert + CANNOT_AUTO_FIX
            if (!tryAdjust() && θ["p.worker_agent_common.regressions_adjust_else_cannot_fix"]) {   // src: vulnhunter-fix/prompts/worker_agent_common.md:289
                revert();
                return FindingResult.terminal("CANNOT_AUTO_FIX", "fix breaks existing tests: <list>");
            }
        }
        if (status == "ENV_ERROR" && policy == "must-pass") {
            return FindingResult.terminal(θ["p.worker_agent_common.must_pass_env_error_failed"], "regression suite could not run; --test-policy=must-pass requires a working test environment"); // src: vulnhunter-fix/prompts/worker_agent_common.md:293
        }
        // best-effort ENV_ERROR / skip SKIPPED continue; delivery adds the corresponding banner
        return out;
    }

    String promoteScaffold(Finding f, TestFile scaffold, Theta θ) {
        // mandatory: check-committed-test-naming.py rejects committed verify_/exploit_ files
        assert θ["p.worker_agent_common.promote_scaffold_mandatory"];                               // src: vulnhunter-fix/prompts/worker_agent_common.md:298
        String canonical = findCanonicalTestFile(f.location.file);                                  // src: vulnhunter-fix/prompts/worker_agent_common.md:300
        if (canonical == null && θ["p.worker_agent_common.no_canonical_create_convention_file"]) canonical = createConventionNamedTest(f); // src: vulnhunter-fix/prompts/worker_agent_common.md:306
        if (θ["p.worker_agent_common.promote_into_canonical_file"]) appendDescribeBlock(canonical, scaffold); // src: vulnhunter-fix/prompts/worker_agent_common.md:301
        bash("rm <resolved_test_dir>/verify_<VULN_ID>_*");                                          // src: vulnhunter-fix/prompts/worker_agent_common.md:304
        for (String req : θ["p.worker_agent_common.committed_test_shape"]) assert holds(canonical, req); // src: vulnhunter-fix/prompts/worker_agent_common.md:308
        return canonical;
    }

    void scopeCheck(Finding f, Theta θ) {
        List<String> changed = bash("git diff --name-only main").lines();                           // src: vulnhunter-fix/prompts/worker_agent_common.md:317
        for (String file : changed) {
            if (!attributableTo(file, f.id) && θ["p.worker_agent_common.scope_check_revert_unrelated"]) revertFile(file); // src: vulnhunter-fix/prompts/worker_agent_common.md:320
        }
    }

    void commit(Finding f, String canonical, Theta θ) {
        // stage promoted test + fix (+ refactors) only; never scaffold or exploit
        if (θ["p.worker_agent_common.commit_stage_set"]) bash("git add <canonical_test_file> <fixed_source_files> <refactored_source_files>"); // src: vulnhunter-fix/prompts/worker_agent_common.md:324
        String msg = "fix(security): <VULN_ID> <short_title> ... VulnHunter-Finding: <VULN_ID>";   // src: vulnhunter-fix/prompts/worker_agent_common.md:331
        // never "Critical" in commit messages/branches/PR titles; use "High+"
        msg = msg.replace("Critical", θ["p.worker_agent_common.commit_severity_mask_manual"]);       // src: vulnhunter-fix/prompts/worker_agent_common.md:346
        bash("git commit -m " + msg);
    }

    WorkerResult writeResult(List<FindingResult> rs, Manifest m, Theta θ) {
        WorkerResult r = new WorkerResult();
        // key is vuln_id, never legacy finding_id
        if (θ["p.worker_agent_common.result_use_vuln_id_key"]) r.vulnId = m.findings.first().id;    // src: vulnhunter-fix/prompts/worker_agent_common.md:388
        r.status = aggregate(rs);
        assert θ["p.worker_agent_common.result_status_values"].contains(r.status);                  // src: vulnhunter-fix/prompts/worker_agent_common.md:356
        assert θ["p.worker_agent_common.result_exploit_status_values"].contains(r.exploitStatus);   // src: vulnhunter-fix/prompts/worker_agent_common.md:359
        r.completenessTier = ComputeCompletenessTier.run(r.diff, null, "implement");                // unclear: the preamble does not say how the worker obtains the tier
        if (r.completenessTier == "LLM_REVIEW") {
            // tier_judgment populated only when classifier returned LLM_REVIEW; never LLM_REVIEW at terminal
            if (θ["p.worker_agent_common.tier_judgment_only_on_llm_review"]) r.tierJudgment = TierJudgment.run(m.findings.first(), "verify", θ); // src: vulnhunter-fix/prompts/worker_agent_common.md:391
            r.completenessTier = r.tierJudgment.finalTier;
        }
        assert !(θ["p.worker_agent_common.no_llm_review_terminal"] && r.completenessTier == "LLM_REVIEW"); // src: vulnhunter-fix/prompts/worker_agent_common.md:389
        assert θ["p.worker_agent_common.tier_value_set"].contains(r.completenessTier);              // src: vulnhunter-fix/prompts/worker_agent_common.md:29
        // residual vectors non-empty iff tier != FULL; hand-wave phrases refuse delivery
        if (θ["p.worker_agent_common.residual_vectors_rule"]) r.residualVectors = r.completenessTier == "FULL" ? List.of() : concreteResidualVectors(); // src: vulnhunter-fix/prompts/worker_agent_common.md:32
        if (θ["p.worker_agent_common.hand_wave_refuses_delivery"]) assert !r.residualVectors.anyHandWave(); // src: vulnhunter-fix/prompts/worker_agent_common.md:33
        // callers routed through fix must be a superset of sidecar callers_of_sink; file:symbol pointers
        if (θ["p.worker_agent_common.callers_superset_of_sidecar"]) r.callersRoutedThroughFix = superset(m.sidecar.callersOfSink); // src: vulnhunter-fix/prompts/worker_agent_common.md:35
        r.callersRoutedThroughFix.format(θ["p.worker_agent_common.caller_pointer_format"]);         // src: vulnhunter-fix/prompts/worker_agent_common.md:392
        if (θ["p.worker_agent_common.record_discrimination_in_result"]) r.discriminationEvidence = rs.first().discriminationEvidence; // src: vulnhunter-fix/prompts/worker_agent_common.md:37
        if (r.status == "REQUIRES_HUMAN_DECISION") r.designOptions = designOptions(θ);
        // files_created excludes exploit files and verify_ scaffolds
        if (θ["p.worker_agent_common.files_created_excludes_scaffolds"]) r.filesCreated = r.filesCreated.filter(x -> !x.isExploitOrScaffold()); // src: vulnhunter-fix/prompts/worker_agent_common.md:399
        if (θ["p.worker_agent_common.test_file_points_to_canonical"]) r.testFile = rs.first().testFile; // src: vulnhunter-fix/prompts/worker_agent_common.md:402
        // file_path, cwe, root_cause kept stable for the idempotency hash
        for (String k : θ["p.worker_agent_common.stable_hash_fields"]) r.put(k, canonicalValue(m.findings.first(), k)); // src: vulnhunter-fix/prompts/worker_agent_common.md:403
        if (r.status == "CANNOT_AUTO_FIX" || r.status == "FAILED") {
            if (θ["p.worker_agent_common.honest_result_on_failure"]) r.cannotFixReason = honestReason(); // src: vulnhunter-fix/prompts/worker_agent_common.md:449
        }
        return r;   // output kept concise: only the result JSON matters
    }

    String chooseStatus(Finding f, Theta θ) {
        // status table (VERIFIED, FAILED, NEEDS_MANUAL_REVIEW, ALREADY_FIXED, CANNOT_AUTO_FIX, REQUIRES_HUMAN_DECISION, BREAKING_CHANGE)
        List<String> defs = θ["p.worker_agent_common.status_definitions"];                          // src: vulnhunter-fix/prompts/worker_agent_common.md:418
        if (f.hasSignalsAny(θ["p.worker_agent_common.requires_human_decision_signals"])) {          // src: vulnhunter-fix/prompts/worker_agent_common.md:428
            // not for single-approach fixes, missing-data blockers or cross-repo coordination
            if (!f.matchesAny(θ["p.worker_agent_common.requires_human_decision_exclusions"])) return "REQUIRES_HUMAN_DECISION"; // src: vulnhunter-fix/prompts/worker_agent_common.md:434
        }
        return null;
    }

    List<DesignOption> designOptions(Theta θ) {
        // at least two options; exactly one recommended with one-sentence justification
        List<DesignOption> opts = enumerateOptions();
        assert opts.size() >= θ["p.worker_agent_common.design_options_min_and_recommended"];        // src: vulnhunter-fix/prompts/worker_agent_common.md:396
        if (θ["p.worker_agent_common.recommended_only_with_justification"] && strongJustification()) opts.markRecommended(best(opts)); // src: vulnhunter-fix/prompts/worker_agent_common.md:439
        return opts;
    }
}
