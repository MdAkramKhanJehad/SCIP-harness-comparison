                        }
                        Console.write("structured tool rejected - re-asking");                              // src: vvaharness/backends/llm/sdk.py:1518
                        results.add(Map.of("type", "tool_result", "tool_use_id", b.id, "content", "Rejected: " + exc.toString().substring(0, θ["code.backends.llm.sdk.submit_reject_detail_chars"]) + ". Fix the named fields and call the tool again.")); // the validation error goes back to the model // src: vvaharness/backends/llm/sdk.py:1521
                        continue;                                                                           // src: vvaharness/backends/llm/sdk.py:1524
                    }
