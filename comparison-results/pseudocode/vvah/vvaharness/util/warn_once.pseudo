// file: vvaharness/util/warn_once.py
// One-shot stderr warnings: print a message at most once per key; each caller owns its seen set.
// _REGISTRY_SITES lists every module-level seen set so batch runs can clear them between repos.

@executedBy(CODE) @role(io)
class WarnOnce {

    static final Lock LOCK = new Lock();                                       // one lock for every seen set (S4/S6 pools) // src: vvaharness/util/warn_once.py:29

    static final List<Pair<String, String>> REGISTRY_SITES = List.of(        // src: vvaharness/util/warn_once.py:51
        Pair.of("backends.llm.deepagents", "_NO_USAGE_WARNED_TAGS"), Pair.of("backends.llm.deepagents", "_WARNED_LEGACY_KW"),
        Pair.of("backends.llm.sdk", "_CACHE_ROUTE_NOTED"), Pair.of("backends.harness.deepagents.tools", "_WARNED_UNKNOWN_TOOLS"),
        Pair.of("backends.harness.deepagents.usage", "_EXCLUSIVE_USAGE_WARNED"), Pair.of("backends.harness.deepagents.client", "_EFFORT_UNSUPPORTED_WARNED"),
        Pair.of("backends.harness.deepagents.client", "_TRANSPORT_FALLBACK_WARNED"), Pair.of("orchestrator.store", "_PERM_WARNED"),
        Pair.of("backends.llm.openai", "_WARNED_DROPS"), Pair.of("backends.llm.sdk", "_WARNED_DROPS"),
        Pair.of("backends.llm.tool_adapter", "_WARNED"), Pair.of("backends.llm.cli_mcp", "_WARNED"),
        Pair.of("backends.llm.deepagents", "_WARNED_DROPPED_KNOBS"), Pair.of("backends.llm.registry", "_WARNED_CLI_DROPPED"),
        Pair.of("backends.llm.cli", "_WARNED_CAPS"), Pair.of("pipeline.stages.s2.session", "_WARNED_NO_GRAPH_TOOLS"),
        Pair.of("pipeline.stages.s2.session", "_WARNED_DEGENERATE_GRAPH"), Pair.of("pipeline.stages.s4.session", "_WARNED_DEGENERATE_GRAPH"),
        Pair.of("pipeline.stages.s6.session", "_WARNED_NO_GRAPH"), Pair.of("pipeline.stages.s6.session", "_WARNED_DEGENERATE_GRAPH"),
        Pair.of("backends.harness.deepagents.options.model_building", "_INFERRED_VENDOR_WARNED"),
        Pair.of("remediation_agent.plugin_runner", "_WARNED_CLI_REDACTION"), Pair.of("pipeline.stages.s4_deepdive", "_WARNED_REDACTED_SOURCE"),
        Pair.of("pipeline.stages.s6_verify", "_WARNED_REPLAYED_DISCOVERIES"), Pair.of("validation.config.validate_role", "_WARNED_VIA_REWRITE"),
        Pair.of("backends.harness.deepagents.tool_budget", "_WARNED_EXHAUSTED"), Pair.of("backends.harness.deepagents.evidence_gate", "_WARNED_RELENTED"),
        Pair.of("backends.harness.deepagents.options.response_format", "_WARNED_DROPS"));

    void warnOnce(Set<String> seen, String key, String message) {
        synchronized (LOCK) {
            if (seen.contains(key)) return;                                    // src: vvaharness/util/warn_once.py:36
            seen.add(key);                                                     // src: vvaharness/util/warn_once.py:38
        }
        Console.write(message);                                                // never raises // src: vvaharness/util/warn_once.py:39
    }

    // caller alias (pass-1 files call WarnOnce.warn) for warn_once
    void warn(Set<String> seen, String key, String message) {
        warnOnce(seen, key, message);
    }

    String stageLabel(String counter) {
        String prefix = counter.split("_", 1)[0];                              // src: vvaharness/util/warn_once.py:46
        return (prefix.startsWith("s") && isDigits(prefix.substring(1))) ? "[" + prefix + "]" : "[stage]"; // src: vvaharness/util/warn_once.py:47
    }

    void resetWarnOnceRegistries() {
        for (Pair<String, String> site : REGISTRY_SITES) {                     // src: vvaharness/util/warn_once.py:88
            Module mod = sysModules.get(site.first);                           // lookup, not import (keeps langchain out)
            if (mod == null) continue;                                         // never imported -> nothing to clear // src: vvaharness/util/warn_once.py:90
            Object reg = getattr(mod, site.second, null);
            if (reg instanceof Set) reg.clear();                               // identity preserved // src: vvaharness/util/warn_once.py:94
        }
    }
}
