// file: vvaharness/backends/harness/deepagents/redaction.py
// Read-only session middleware: mask PII/credentials in content-returning native tool results (read_file, grep),
// elide non-text blocks, and withhold the write tools + delete. Deny rules FAIL OPEN, so writes are also withheld.

@executedBy(CODE) @role(backend)
class Redaction {

    // A str or text block is masked; any other dict block becomes the binary marker.
    Object redactBlock(Object block, String rel) {
        boolean isTextDict = block instanceof Map && "text".equals(block.get("type"));                   // src: vvaharness/backends/harness/deepagents/redaction.py:42
        if (block instanceof String || isTextDict) {                                                     // src: vvaharness/backends/harness/deepagents/redaction.py:43
            String text = block instanceof String ? block : block.getOrDefault("text", "");
            String masked = redactCounts(sanitizePackedText(text, rel)).first;   // report/redact + backends/llm/tools // src: vvaharness/backends/harness/deepagents/redaction.py:45
            return block instanceof String ? masked : block.with("text", masked);                        // src: vvaharness/backends/harness/deepagents/redaction.py:46
        }
        if (!(block instanceof Map)) return block;                                                       // src: vvaharness/backends/harness/deepagents/redaction.py:47
        return Map.of("type", "text", "text", "[binary content elided: <rel> is not text]");             // src: vvaharness/backends/harness/deepagents/redaction.py:49
    }

    Object redactMessage(Object message) {
        if (!(message instanceof ToolMessage)) return message;                                           // src: vvaharness/backends/harness/deepagents/redaction.py:54
        String rel = message.additionalKwargs.getOrDefault("read_file_path", "");                        // src: vvaharness/backends/harness/deepagents/redaction.py:56
        Object content = message.content;
        if (content instanceof String && !content.isEmpty()) {                                           // src: vvaharness/backends/harness/deepagents/redaction.py:58
            message.content = redactCounts(sanitizePackedText(content, rel)).first;                      // src: vvaharness/backends/harness/deepagents/redaction.py:59
        } else if (content instanceof List) {
            message.content = content.map(b -> redactBlock(b, rel));                                     // src: vvaharness/backends/harness/deepagents/redaction.py:61
        }
        return message;
    }

    Object redactIfContentTool(ToolCallRequest request, Object result, Theta θ) {
        if (HarnessModels.nativeContentTools(θ).contains(request.toolCall.get("name"))) return redactMessage(result); // src: vvaharness/backends/harness/deepagents/redaction.py:69
        return result;                                                                                   // src: vvaharness/backends/harness/deepagents/redaction.py:71
    }

    // Middleware every read-only agent needs (parent stack only; subagents get their own copy).
    List<Middleware> readOnlyMiddleware(Set<String> extraExcluded, Theta θ) {
        Set<String> excluded = HarnessModels.nativeWriteTools(θ).union(Set.of(DeepagentsModels.deleteToolName())).union(extraExcluded); // src: vvaharness/backends/harness/deepagents/redaction.py:99
        return List.of(new RedactToolResults(), new ExcludeTools(excluded));                             // src: vvaharness/backends/harness/deepagents/redaction.py:100
    }
}

@executedBy(CODE) @role(backend)
class RedactToolResults {
    ToolResult wrapToolCall(ToolCallRequest request, Handler handler, Theta θ) {
        return Redaction.redactIfContentTool(request, handler.call(request), θ);                         // src: vvaharness/backends/harness/deepagents/redaction.py:83
    }
}
