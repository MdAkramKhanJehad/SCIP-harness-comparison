// file: vulnhunter-fix/scripts/heading-sync-lint.py
// Dev-time lint (REQ-GAT-003): body templates must carry the headings Gate 2 requires (read from
// check-body-completeness.py by AST), no template comment may reference a block placeholder, and no
// Breaking Change heading may carry a suffix that Gate 2's regex rejects.

@executedBy(CODE) @role(evaluation) @stage("fix")
class HeadingSyncLint {

    int run(Theta θ) {
        return main(θ);
    }

    String extractStrConstant(Path path, String name) {
        // walk the module AST for NAME = "<str>"
        return Ast.parse(Files.read(path)).findAssign(name).stringValueOrNull();                          // src: vulnhunter-fix/scripts/heading-sync-lint.py:53
    }

    List<String> extractTupleConstant(Path path, String name) {
        return Ast.parse(Files.read(path)).findAssign(name).stringElementsOrNull();                       // src: vulnhunter-fix/scripts/heading-sync-lint.py:64
    }

    boolean headingPresent(String text, String heading) {
        // mirrors Gate 2 acceptance
        return Regex.searchMultiline("^" + Regex.escape(heading) + "\\s*(?:$|:)", text) != null;          // src: vulnhunter-fix/scripts/heading-sync-lint.py:81
    }

    int main(Theta θ) {
        Path gate2 = skillRoot().join("scripts", "check-body-completeness.py");                           // src: vulnhunter-fix/scripts/heading-sync-lint.py:37
        List<String> requiredAlways = extractTupleConstant(gate2, "REQUIRED_ALWAYS");                     // src: vulnhunter-fix/scripts/heading-sync-lint.py:86
        List<String> conditionals = List.of(extractStrConstant(gate2, "CONDITIONAL_TABLE"), extractStrConstant(gate2, "CONDITIONAL_RESIDUAL"), extractStrConstant(gate2, "CONDITIONAL_BREAKING"), extractStrConstant(gate2, "CONDITIONAL_SWEEP")); // src: vulnhunter-fix/scripts/heading-sync-lint.py:87
        if (requiredAlways == null || conditionals.contains(null)) return 2;                              // src: vulnhunter-fix/scripts/heading-sync-lint.py:92
        List<String> errors = List.of();
        // Check 1: presence in body templates
        for (String name : List.of("pr_body.md", "pr_body_cluster.md", "issue_body.md")) {                // src: vulnhunter-fix/scripts/heading-sync-lint.py:41
            Path path = skillRoot().join("templates", name);
            if (!path.isFile()) {
                errors.add(name + ": body template missing");                                             // src: vulnhunter-fix/scripts/heading-sync-lint.py:103
                continue;
            }
            String text = Files.read(path);
            for (String h : requiredAlways) if (!headingPresent(text, h)) errors.add(name + ": missing required H2 heading"); // src: vulnhunter-fix/scripts/heading-sync-lint.py:107
            // PR templates carry every conditional heading
            if (List.of("pr_body.md", "pr_body_cluster.md").contains(name)) {                            // src: vulnhunter-fix/scripts/heading-sync-lint.py:44
                for (String h : conditionals) if (!headingPresent(text, h)) errors.add(name + ": missing conditional heading"); // src: vulnhunter-fix/scripts/heading-sync-lint.py:111
            }
            // Check 1b: a block placeholder (one that also appears outside comments) must not appear inside an HTML comment
            String contentWithoutComments = Regex.replaceDotall("<!--.*?-->", "", text);                  // src: vulnhunter-fix/scripts/heading-sync-lint.py:126
            Set<String> blockPlaceholders = Regex.findAll("<UPPER_PLACEHOLDER>", contentWithoutComments).toSet(); // src: vulnhunter-fix/scripts/heading-sync-lint.py:127
            for (Match m : Regex.finditerDotall("<!--.*?-->", text)) {                                    // src: vulnhunter-fix/scripts/heading-sync-lint.py:128
                for (String tok : Regex.findAll("<UPPER_PLACEHOLDER>", m.group(0))) {
                    if (blockPlaceholders.contains(tok)) errors.add(name + ": HTML comment references block placeholder"); // src: vulnhunter-fix/scripts/heading-sync-lint.py:130
                }
            }
        }
        // Check 2: Breaking Change heading with a non-colon suffix anywhere in prompts/references/templates
        for (String d : List.of("prompts", "references", "templates")) {                                  // src: vulnhunter-fix/scripts/heading-sync-lint.py:47
            for (Path path : skillRoot().join(d).rglob("*.md").sorted()) {
                String text = Files.read(path);
                for (Match m : Regex.finditerMultiline("^#<2..4>\\s+Breaking Change(?P<suffix>.*)$", text)) { // src: vulnhunter-fix/scripts/heading-sync-lint.py:49
                    String suffix = m.group("suffix").strip();
                    if (!suffix.isEmpty() && !suffix.startsWith(":")) errors.add(path + ": Breaking-Change heading has a suffix"); // src: vulnhunter-fix/scripts/heading-sync-lint.py:145
                }
            }
        }
        if (!errors.isEmpty()) return 1;                                                                  // src: vulnhunter-fix/scripts/heading-sync-lint.py:158
        return 0;
    }
}
