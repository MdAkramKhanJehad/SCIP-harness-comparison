// file: vvaharness/backends/harness/deepagents/__init__.py
// DeepAgents backend package: resolves DeepAgentHarness lazily (PEP 562) so unrelated imports skip deepagents.

@executedBy(CODE) @role(backend)
class HarnessDeepagents {
    Object getattr(String name) {
        if (name.equals("DeepAgentHarness")) return Client.class;     // deepagents/client.py, imported on first access // src: vvaharness/backends/harness/deepagents/__init__.py:27
        throw new AttributeError("module has no attribute " + name);                                    // src: vvaharness/backends/harness/deepagents/__init__.py:33
    }
}
