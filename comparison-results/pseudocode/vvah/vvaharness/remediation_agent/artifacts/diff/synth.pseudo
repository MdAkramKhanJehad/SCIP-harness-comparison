// file: vvaharness/remediation_agent/artifacts/diff/synth.py
// Synthesized git-style unified diff (difflib) from a pre-edit snapshot, for non-git targets. Never raises.

@executedBy(CODE) @role(io) @stage("S10")
class Synth {

    String synthUnifiedDiff(String repo, Map<String, String> before, List<String> extraFiles) {
        before = before != null ? before : Map.of();                                                // src: vvaharness/remediation_agent/artifacts/diff/synth.py:39
        // extra_files have no baseline (render as newly added) and are model-controlled: confine them (CWE-22).
        List<String> paths = new List();
        Map<String, Path> safe = new Map();
        for (String ref : before.keys().plus(extraFiles != null ? extraFiles : List.of())) {        // src: vvaharness/remediation_agent/artifacts/diff/synth.py:43
            String rel = DiffPaths.normPath(ref);                                                   // src: vvaharness/remediation_agent/artifacts/diff/synth.py:44
            if (rel.isEmpty() || safe.containsKey(rel)) continue;                                   // src: vvaharness/remediation_agent/artifacts/diff/synth.py:45
            Path p = DiffPaths.safeRepoPath(repo, ref);                                             // src: vvaharness/remediation_agent/artifacts/diff/synth.py:47
            if (p == null) continue;                                                                // src: vvaharness/remediation_agent/artifacts/diff/synth.py:48
            safe.put(rel, p);
            paths.add(rel);
        }
        if (paths.isEmpty()) return null;                                                           // src: vvaharness/remediation_agent/artifacts/diff/synth.py:54
        List<String> chunks = new List();
        for (String rel : paths) {                                                                  // src: vvaharness/remediation_agent/artifacts/diff/synth.py:58
            String old = before.get(rel);
            String oldText = old == null ? "" : old;                                                // src: vvaharness/remediation_agent/artifacts/diff/synth.py:60
            String newText;
            try {
                newText = safe.get(rel).isFile() ? safe.get(rel).readText() : "";                   // src: vvaharness/remediation_agent/artifacts/diff/synth.py:63
            } catch (Exception e) {
                continue;                                                                           // src: vvaharness/remediation_agent/artifacts/diff/synth.py:65  (binary/unreadable: skip)
            }
            if (oldText.equals(newText)) continue;                                                  // src: vvaharness/remediation_agent/artifacts/diff/synth.py:67
            String fromLabel = old == null ? "/dev/null" : "a/" + rel;                              // src: vvaharness/remediation_agent/artifacts/diff/synth.py:69
            String toLabel = !newText.isEmpty() ? "b/" + rel : "/dev/null";                         // src: vvaharness/remediation_agent/artifacts/diff/synth.py:70
            String body = Difflib.unifiedDiff(oldText, newText, fromLabel, toLabel);                // src: vvaharness/remediation_agent/artifacts/diff/synth.py:71
            if (body.isEmpty()) continue;                                                           // src: vvaharness/remediation_agent/artifacts/diff/synth.py:76
            if (!body.endsWith("\n")) body = body + "\n";                                           // src: vvaharness/remediation_agent/artifacts/diff/synth.py:80
            chunks.add("diff --git a/" + rel + " b/" + rel + "\n" + body);                          // src: vvaharness/remediation_agent/artifacts/diff/synth.py:81
        }
        if (chunks.isEmpty()) return null;                                                          // src: vvaharness/remediation_agent/artifacts/diff/synth.py:83
        return "# (synthesized diff - target is not a git repository)\n" + chunks.join("");         // src: vvaharness/remediation_agent/artifacts/diff/synth.py:85
    }
}
