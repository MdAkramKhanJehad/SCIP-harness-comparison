// file: vvaharness/models/scan/report.py
// FinalReport: the findings.json shape S9 writes, its health predicates (hollow scan, undetermined drops,
// coverage loss, unranked split) and the Markdown renderer that assembles every report section in order.

@executedBy(CODE) @role(types)
record FinalReport(String schemaVersion, String repoRoot, String repoName, String gitSha, List<RankedFinding> findings,
                   List<Chain> chains, int chainsDropped, int chainsDeduped, int chainsInvalid, List<Pair> unpromotedLinks,
                   List<DroppedFinding> dropped, int rawFindingsCount, ScanMetrics metrics, ThreatModel threatModel,
                   AppProfile appProfile, List<String> unreachableFiles, List<String> threatsWithoutUnit, String summary,
                   boolean degraded, String degradedReason, boolean enrichmentUnavailable) {
    // schemaVersion "1.0" (findings.json consumers key on it); gitSha: step 10 refuses on mismatch // src: vvaharness/models/scan/report.py:60
    // unreachableFiles null = knob off, [] = s3 found zero                                         // src: vvaharness/models/scan/report.py:81
    // enrichmentUnavailable: chains=[] is NOT a trustworthy "zero chains found"                     // src: vvaharness/models/scan/report.py:88

    FinalReport modelValidateJson(String json) {
        return Report.validate(json);
    }

    boolean isHollow() {
        // the one hollowness predicate (s9/health.py uses it too, so report and SARIF agree)
        if (metrics == null || !findings.isEmpty()) return false;                                   // src: vvaharness/models/scan/report.py:95
        int raw = max(rawFindingsCount, metrics.rawFindingsCount);                                  // src: vvaharness/models/scan/report.py:98
        return raw == 0 && metrics.totalFilesInScope > 0 && metrics.s2Degraded;                     // src: vvaharness/models/scan/report.py:100
    }

    int undeterminedDropCount() {
        // dropped with no verifier verdict: never an FP or a duplicate
        return dropped.count(d -> θ["code.models.scan.report.undetermined_drop_reasons"].contains(d.reason)); // src: vvaharness/models/scan/report.py:106
    }

    Triple unrankedSplit() {
        Set feeders = chains.flatMap(c -> c.steps.dropLast());  // non-terminal chain steps         // src: vvaharness/models/scan/report.py:126
        List<Integer> unranked = findings.indicesWhere(rf -> rf.exploitabilityNotes.equals(NOT_RANKED_NOTE)); // src: vvaharness/models/scan/report.py:127
        int feederMissed = unranked.count(i -> feeders.contains(i));  // reply defect               // src: vvaharness/models/scan/report.py:129
        int byDesign = unranked.size() - feederMissed;                                              // src: vvaharness/models/scan/report.py:130
        int ranked = findings.size() - unranked.size();                                             // src: vvaharness/models/scan/report.py:131
        return Triple.of(ranked, byDesign, feederMissed);
    }

    Pair verifiedTpFp() {
        // as the verifier decided them, pre-s7-dedup; never raw_findings_count
        if (metrics != null) return Pair.of(metrics.truePositiveCount, metrics.falsePositiveCount); // src: vvaharness/models/scan/report.py:139
        return Pair.of(findings.size(), dropped.count(d -> d.reason.equals("FALSE_POSITIVE")));     // src: vvaharness/models/scan/report.py:141
    }

    List<String> coverageDegraded() {
        // s3_unreachable_files excluded by design: non-zero in most healthy scans
        if (metrics == null) return List.of();                                                      // src: vvaharness/models/scan/report.py:148
        List<String> reasons = new List();
        if (undeterminedDropCount() > 0) reasons.add("s6_undetermined");                           // src: vvaharness/models/scan/report.py:151
        if (metrics.totalFilesInScope > 0 && metrics.analyzedFilesUnique == 0) reasons.add("zero_analysis"); // src: vvaharness/models/scan/report.py:153
        if (metrics.llmTurnCapExhausted > 0) reasons.add("llm_turn_cap_exhausted");                // src: vvaharness/models/scan/report.py:155
        return reasons;
    }

    String toMarkdown(boolean postureChannel, boolean unreachableAppendix) {
        return Report.toMarkdown(this, postureChannel, unreachableAppendix);
    }
}

@executedBy(CODE) @role(io) @stage("S9")
class Report {

    FinalReport validate(String json) {
        return parseJson(json);  // pydantic model_validate_json
    }

    String toMarkdown(FinalReport r, boolean postureChannel, boolean unreachableAppendix) {
        // postureChannel defaults True to match build_sarif, so MD and SARIF cannot disagree
        String safeTitle = Regex.sub("[<>`|\\[\\]]", "", r.repoName != null ? r.repoName : r.repoRoot); // src: vvaharness/models/scan/report.py:162
        List<String> out = List.of("# Agentic SAST - " + safeTitle, "## Summary", ScanRender.demoteMdHeadings(r.summary, true)); // src: vvaharness/models/scan/report.py:164
        out.addAll(SectionsChain.summaryReconciliationNote(r));                                     // src: vvaharness/models/scan/report.py:169
        if (r.appProfile == null) {
            // no CMDB: OffensivePriority structurally capped at P3/P4 for every finding
            out.add("_No CMDB/application context was supplied - OffensivePriority is capped at its lowest reachable tier (P3/P4)._"); // src: vvaharness/models/scan/report.py:174
        }
        if (r.metrics != null) out.addAll(SectionsMetrics.renderMetrics(r, unreachableAppendix));   // src: vvaharness/models/scan/report.py:181
        out.addAll(SectionsMetrics.renderScanHealth(r));                                            // src: vvaharness/models/scan/report.py:183
        if (r.threatModel != null) out.addAll(SectionsChain.renderThreatModel(r));                  // src: vvaharness/models/scan/report.py:185
        else if (r.appProfile != null) out.addAll(List.of("## Threat Model").plus(SectionsChain.appProfileLines(r))); // src: vvaharness/models/scan/report.py:187
        out.addAll(SectionsMetrics.renderVerification(r, postureChannel));                          // src: vvaharness/models/scan/report.py:188
        // split into main vs posture, keeping 1-based positions (chain step indices reference them)
        List<Pair> main = new List(); List<Pair> posture = new List();
        for (int i = 1; i <= r.findings.size(); i++) {                                              // src: vvaharness/models/scan/report.py:192
            RankedFinding rf = r.findings.get(i - 1);
            if (postureChannel && rf.finding.channel.equals("posture")) posture.add(Pair.of(i, rf)); // src: vvaharness/models/scan/report.py:193
            else main.add(Pair.of(i, rf));
        }
        out.add("## Findings (" + main.size() + ")");                                               // src: vvaharness/models/scan/report.py:199
        if (!posture.isEmpty()) out.add("_Application-defect findings only - posture findings are listed separately below._"); // src: vvaharness/models/scan/report.py:203
        for (Pair p : main) out.addAll(FindingSection.findingSectionLines(p.i, p.rf));              // src: vvaharness/models/scan/report.py:211
        if (!posture.isEmpty()) {
            out.add("## Posture Findings (" + posture.size() + ") - remediation skips them by default"); // src: vvaharness/models/scan/report.py:215
            for (Pair p : posture) out.addAll(FindingSection.findingSectionLines(p.i, p.rf));       // src: vvaharness/models/scan/report.py:225
        }
        if (!r.chains.isEmpty()) {
            out.add("## Exploit Chains");                                                           // src: vvaharness/models/scan/report.py:227
            out.addAll(SectionsChain.chainRemovalLeadins(r)); out.addAll(SectionsChain.terminalDiversityLeadin(r)); // src: vvaharness/models/scan/report.py:228
            out.addAll(SectionsChain.unpromotedLinkLeadin(r));                                      // src: vvaharness/models/scan/report.py:229
            out.addAll(SectionsChain.chainPassCaveat(r));                                           // src: vvaharness/models/scan/report.py:230
            // chains failing >= N deterministic quality checks are shown under "Lower-confidence chains"
            int lowerAt = θ["code.models.scan.report.lower_confidence_chain_min_notes"];
            List<Pair> lower = r.chains.numbered(1).filter(nc -> nc.c.qualityNotes.size() >= lowerAt);   // src: vvaharness/models/scan/report.py:233
            List<Pair> confirmed = r.chains.numbered(1).filter(nc -> nc.c.qualityNotes.size() < lowerAt); // src: vvaharness/models/scan/report.py:235
            for (Pair nc : confirmed) out.addAll(SectionsChain.chainLines(r, nc.n, nc.c));          // src: vvaharness/models/scan/report.py:238
            if (!lower.isEmpty()) {
                out.add("### Lower-confidence chains");                                             // src: vvaharness/models/scan/report.py:241
                for (Pair nc : lower) out.addAll(SectionsChain.chainLines(r, nc.n, nc.c));          // src: vvaharness/models/scan/report.py:250
            }
        } else if (!r.enrichmentUnavailable) {
            out.add("## Exploit Chains");                                                           // src: vvaharness/models/scan/report.py:252
            out.addAll(SectionsChain.emptyChainSectionCopy(r));                                     // src: vvaharness/models/scan/report.py:253
            out.addAll(SectionsChain.chainPassCaveat(r));
        }
        out.add("## Dropped Findings");                                                             // src: vvaharness/models/scan/report.py:255
        if (!r.dropped.isEmpty()) {
            // tags: FALSE_POSITIVE->FP, UNCONFIRMED, VERIFY_ERROR->VERIFY-ERR, EXCLUDED, GUARDRAIL_BLOCKED->GUARDRAIL, INCONCLUSIVE
            for (DroppedFinding d : r.dropped) {
                String tag;
                if (d.reason.equals("DUPLICATE")) tag = d.canonicalIdx != null ? "DUP of #" + (d.canonicalIdx + 1) : "DUP (pre-verify)"; // src: vvaharness/models/scan/report.py:266
                else tag = DROP_TAG.getOrDefault(d.reason, d.reason);                               // src: vvaharness/models/scan/report.py:271
                out.add("- **[" + tag + "]** " + ScanRender.mdCell(d.file) + ":" + d.line + " " + d.vulnClass + " - " + ScanRender.mdCell(d.detail)); // src: vvaharness/models/scan/report.py:272
            }
        } else {
            out.add("_None._");                                                                     // src: vvaharness/models/scan/report.py:276
        }
        if (r.metrics != null) out.addAll(SectionsMetrics.renderScopeAppendix(r));                  // src: vvaharness/models/scan/report.py:279
        if (r.unreachableFiles != null && !r.unreachableFiles.isEmpty() && unreachableAppendix) out.addAll(SectionsChain.renderUnreachableAppendix(r)); // src: vvaharness/models/scan/report.py:280
        return String.join("\n", out);
    }
}
