// file: vvaharness/util/tokens.py
// Process-wide token accounting shared by every model backend (per-phase buckets), plus the one
// offline content-aware token estimator used to size prompts and windows.

@executedBy(CODE) @role(types)
record TokenUsage(int inputTokens, Integer outputTokens, int cacheCreationInputTokens, int cacheReadInputTokens, int reasoningTokens) { }

@executedBy(CODE) @role(types)
record Spend(double usd, int turns, int usdReports, int turnReports) { }

@executedBy(CODE) @role(backend)
class Tokens {

    static final String DEFAULT_PHASE = "unscoped";                            // src: vvaharness/util/tokens.py:40
    static final Regex UNPARSED_CACHE_KEY_RX = Regex.of(θ["code.util.tokens.unparsed_cache_key_rx"]);  // quantifier 1..64 written with angle brackets; key names only, never values // src: vvaharness/util/tokens.py:98
    static final int UNPARSED_CACHE_KEY_CAP = θ["code.util.tokens.unparsed_cache_key_cap"];                               // reporting cap // src: vvaharness/util/tokens.py:99

    Pair<Double, Integer> reportedBetween(Spend before, Spend after) {
        Double usd = after.usdReports > before.usdReports ? after.usd - before.usd : null;       // None where nothing was reported // src: vvaharness/util/tokens.py:54
        Integer turns = after.turnReports > before.turnReports ? after.turns - before.turns : null; // src: vvaharness/util/tokens.py:56
        return Pair.of(usd, turns);
    }

    int estimateTokens(String text, Theta θ) {
        int n = text.length();
        if (n <= 0) return 0;                                                  // src: vvaharness/util/tokens.py:72
        int dense = text.chars().count(ch -> !isSpace(ch) && !isAlpha(ch));    // digits + punctuation // src: vvaharness/util/tokens.py:75
        double frac = (double) dense / n;                                      // src: vvaharness/util/tokens.py:78
        double cpt;
        if (frac <= θ["code.util.tokens.dense_frac_lo"]) cpt = θ["code.util.tokens.chars_per_token_prose"];      // prose // src: vvaharness/util/tokens.py:79
        else if (frac >= θ["code.util.tokens.dense_frac_hi"]) cpt = θ["code.util.tokens.chars_per_token_dense"]; // dense numbered source // src: vvaharness/util/tokens.py:81
        else {
            double span = (frac - θ["code.util.tokens.dense_frac_lo"]) / (θ["code.util.tokens.dense_frac_hi"] - θ["code.util.tokens.dense_frac_lo"]); // src: vvaharness/util/tokens.py:84
            cpt = θ["code.util.tokens.chars_per_token_prose"] + span * (θ["code.util.tokens.chars_per_token_dense"] - θ["code.util.tokens.chars_per_token_prose"]); // linear blend // src: vvaharness/util/tokens.py:85
        }
        return (int) (n / cpt);                                                // src: vvaharness/util/tokens.py:86
    }

    // caller alias (pass-1 files call Tokens.estimate) for estimate_tokens
    int estimate(String text, Theta θ) {
        return estimateTokens(text, θ);
    }

    Map<String, Object> bucket() {
        // usd/turns seed null so unreported never reads as $0
        return Map.of("prompt", 0, "completion", 0, "cache_read", 0, "cache_write", 0, "calls", 0, "cache_unparsed", 0, "usd", null, "turns", null, "reasoning", 0); // src: vvaharness/util/tokens.py:91
    }

    List<String> unparsedCacheKeys(Object usage, Set<String> parsed) {
        if (!(usage instanceof Map)) return List.of();                         // src: vvaharness/util/tokens.py:105
        Set<String> hits = usage.keys().filter(k -> k instanceof String && !parsed.contains(k) && usage.get(k) != null
                                                   && k.lower().contains("cache") && UNPARSED_CACHE_KEY_RX.matches(k)); // src: vvaharness/util/tokens.py:107
        return sorted(hits).head(UNPARSED_CACHE_KEY_CAP);                      // src: vvaharness/util/tokens.py:112
    }
}

@executedBy(CODE) @role(backend)
class TokenCounter {

    Lock lock; String phase = Tokens.DEFAULT_PHASE;
    int prompt; int completion; int calls; int callsWithUsage; int completionAbsent;
    double usd; int turns; int usdReports; int turnReports;
    Map<String, Map<String, Object>> byPhase;
    Set<Pair> cacheUnparsedSeen; Set<String> completionAbsentNoted;

    void phase(String name, Runnable body) {
        String prev = phase; phase = name;                                     // phases never overlap // src: vvaharness/util/tokens.py:137
        try { body.run(); } finally { phase = prev; }
    }

    String currentPhase() {
        synchronized (lock) { return phase; }                                  // src: vvaharness/util/tokens.py:145
    }

    void add(Map<String, Object> usage, Double usdIn, Integer turnsIn) {
        synchronized (lock) {
            int nRequests = 1;                                                 // src: vvaharness/util/tokens.py:151
            if (usage instanceof Map && usage.get("calls") instanceof Integer && usage.get("calls") > 0) nRequests = usage.get("calls"); // src: vvaharness/util/tokens.py:154
            calls += nRequests;
            Map b = byPhase.computeIfAbsent(phase, Tokens.bucket());
            b.calls += nRequests;                                              // src: vvaharness/util/tokens.py:159
            if (usdIn != null) { usdReports += 1; usd += usdIn; b.usd = orZero(b.usd) + usdIn; }        // src: vvaharness/util/tokens.py:160
            if (turnsIn != null) { turnReports += 1; turns += turnsIn; b.turns = orZero(b.turns) + turnsIn; } // src: vvaharness/util/tokens.py:164
            if (!(usage instanceof Map)) return;                               // src: vvaharness/util/tokens.py:168
            callsWithUsage += nRequests;
            int fresh = intOr0(usage.get("input_tokens"));
            int cw = intOr0(usage.get("cache_creation_input_tokens"));
            int cr = intOr0(usage.get("cache_read_input_tokens"));             // src: vvaharness/util/tokens.py:173
            Object outRaw = usage.getOrDefault("output_tokens", 0);
            if (outRaw == null) {                                              // explicit null: coerce, but count it // src: vvaharness/util/tokens.py:175
                completionAbsent += 1;
                WarnOnce.warnOnce(completionAbsentNoted, "null-completion-count", "[tokens] WARN: a usage record carried a null completion count"); // src: vvaharness/util/tokens.py:178
            }
            int out = intOr0(outRaw);
            prompt += fresh + cw;                                              // billable input = fresh + cache-write // src: vvaharness/util/tokens.py:187
            completion += out;
            b.prompt += fresh + cw; b.completion += out; b.cache_read += cr; b.cache_write += cw; // src: vvaharness/util/tokens.py:189
            b.reasoning += intOr0(usage.get("reasoning_tokens"));              // detail only, already inside completion // src: vvaharness/util/tokens.py:194
        }
    }

    Spend spend() {
        synchronized (lock) { return new Spend(usd, turns, usdReports, turnReports); } // src: vvaharness/util/tokens.py:199
    }

    boolean noteCacheUnparsed(List<String> keys, String via) {
        if (keys.isEmpty()) return false;                                      // src: vvaharness/util/tokens.py:205
        synchronized (lock) {
            byPhase.get(phase).cache_unparsed += 1;                            // src: vvaharness/util/tokens.py:208
            if (cacheUnparsedSeen.contains(Pair.of(via, keys))) return false;  // log once per (via, key-set) // src: vvaharness/util/tokens.py:210
            cacheUnparsedSeen.add(Pair.of(via, keys));
            return true;
        }
    }

    void reset() {
        synchronized (lock) {
            prompt = completion = calls = callsWithUsage = completionAbsent = 0; // src: vvaharness/util/tokens.py:217
            usd = 0.0; turns = usdReports = turnReports = 0;
            byPhase.clear(); cacheUnparsedSeen.clear(); completionAbsentNoted.clear(); // src: vvaharness/util/tokens.py:221
        }
    }

    Map<String, Object> snapshot() {
        synchronized (lock) {
            return Map.of("prompt", prompt, "completion", completion, "total", prompt + completion, "calls", calls,
                          "calls_with_usage", callsWithUsage, "completion_absent", completionAbsent,
                          "usd", usdReports > 0 ? usd : null, "turns", turnReports > 0 ? turns : null, // src: vvaharness/util/tokens.py:234
                          "by_phase", copy(byPhase));
        }
    }
}
