// file: vulnhunter-fix/scripts/check_repo_access.sh
// Checks whether the authenticated gh user has push access to a GitHub repo (exit 0) or not (exit 1).

@executedBy(CODE) @role(tool) @stage("fix")
class CheckRepoAccess {

    int run(String repoUrl, Theta θ) {
        if (repoUrl == null) return usageError();                                                         // src: vulnhunter-fix/scripts/check_repo_access.sh:8
        String ownerRepo = repoUrl.replaceRegex(".*github\\.com[:/]", "").removeSuffix(".git");          // src: vulnhunter-fix/scripts/check_repo_access.sh:11
        String ghHost = Env.getOr("VULNFIX_GH_HOST", θ["code.fix.scripts.check_repo_access.default_gh_host"]); // src: vulnhunter-fix/scripts/check_repo_access.sh:13
        Map perms;
        try {
            perms = Gh.api(ghHost, "repos/" + ownerRepo, ".permissions");                                 // src: vulnhunter-fix/scripts/check_repo_access.sh:15
        } catch (Error e) {
            print(json("error", "Cannot access repo API. Check authentication with: gh auth status"));    // src: vulnhunter-fix/scripts/check_repo_access.sh:16
            return 1;                                                                                     // src: vulnhunter-fix/scripts/check_repo_access.sh:17
        }
        boolean hasPush = perms.getOr("push", false);                                                     // src: vulnhunter-fix/scripts/check_repo_access.sh:20
        if (hasPush) {
            print(json("repo", ownerRepo, "push", true));                                                 // src: vulnhunter-fix/scripts/check_repo_access.sh:23
            return 0;
        }
        print(json("repo", ownerRepo, "push", false));                                                    // src: vulnhunter-fix/scripts/check_repo_access.sh:26
        return 1;                                                                                         // src: vulnhunter-fix/scripts/check_repo_access.sh:27
    }
}
