// file: vulnhunter-agent/agent/_stream_events.py
// Shared SDK-event rendering for runner.py (scan) and verify_runner.py (verify): verbosity-tiered logging of
// assistant/user/system/task/result events (always credential-redacted) and per-session cost/turn totals.

@executedBy(CODE) @role(types) @stage("infra")
record SessionTotals(double costUsd, int numTurns, int durationApiMs, int resultMessages) { }   // all default 0

@executedBy(CODE) @role(io) @stage("infra")
class StreamEvents {

    // module state: _verbosity tier 0 (default) / 1 (-v) / 2 (-vv)
    int verbosity = 0;                                                                              // src: vulnhunter-agent/agent/_stream_events.py:61

    void setVerbosity(int level) {
        verbosity = max(0, level);                                                                  // src: vulnhunter-agent/agent/_stream_events.py:67
    }

    int getVerbosity() {
        return verbosity;                                                                           // src: vulnhunter-agent/agent/_stream_events.py:72
    }

    // _truncate: redact credentials first, escape newlines, cap length (_PREVIEW_MAX = 300 chars).
    String truncate(String text, int limit, Theta θ) {
        if (θ["code.agent.stream_events.redact_logs"]) text = Url.redact(text, θ);                 // src: vulnhunter-agent/agent/_stream_events.py:80
        text = text.replace("\n", "\\n");                                                         // src: vulnhunter-agent/agent/_stream_events.py:81
        if (text.length() <= limit) return text;                                                    // src: vulnhunter-agent/agent/_stream_events.py:82
        return text.take(limit) + "...<truncated>";                                                 // src: vulnhunter-agent/agent/_stream_events.py:84
    }

    // _tool_brief: short label per tool at default verbosity.
    String toolBrief(String name, Object toolInput, Theta θ) {
        if (!(toolInput instanceof Map)) return truncate(repr(toolInput), 80, θ);                   // src: vulnhunter-agent/agent/_stream_events.py:90
        if (toolInput.description != null) return truncate(toolInput.description, 100, θ);          // src: vulnhunter-agent/agent/_stream_events.py:93
        if (List.of("Read", "Edit", "Write").contains(name)) return toolInput.file_path;           // src: vulnhunter-agent/agent/_stream_events.py:95
        if (name == "Bash") return truncate(toolInput.command, 100, θ);                             // src: vulnhunter-agent/agent/_stream_events.py:97
        if (name == "Grep") return toolInput.pattern + (toolInput.path != null ? " in " + toolInput.path : ""); // src: vulnhunter-agent/agent/_stream_events.py:100
        if (name == "Glob") return toolInput.pattern;                                               // src: vulnhunter-agent/agent/_stream_events.py:104
        if (name == "Agent" || name == "Task") return toolInput.subagent_type + ": " + truncate(toolInput.description or toolInput.prompt, 80, θ); // src: vulnhunter-agent/agent/_stream_events.py:106
        if (name == "WebFetch") return toolInput.url;                                               // src: vulnhunter-agent/agent/_stream_events.py:110
        if (name == "TodoWrite") return toolInput.todos.size() + " item(s)";                       // src: vulnhunter-agent/agent/_stream_events.py:112
        return truncate(repr(toolInput), 100, θ);                                                   // src: vulnhunter-agent/agent/_stream_events.py:115
    }

    String resultBrief(Object content, Theta θ) {
        if (content instanceof String) {
            String text = content.strip();
            if (text.isEmpty()) return "<empty>";                                                   // src: vulnhunter-agent/agent/_stream_events.py:122
            int lineCount = text.count("\n") + 1;                                                   // src: vulnhunter-agent/agent/_stream_events.py:126
            return truncate(text.firstLine(), 120, θ) + (lineCount > 1 ? " (+" + (lineCount - 1) + " more line(s))" : ""); // src: vulnhunter-agent/agent/_stream_events.py:129
        }
        if (content instanceof List) return "<" + content.size() + " block(s)>";                    // src: vulnhunter-agent/agent/_stream_events.py:131
        return truncate(repr(content), 120, θ);                                                     // src: vulnhunter-agent/agent/_stream_events.py:132
    }

    String renderBlock(Object block, Theta θ) {
        if (block.text instanceof String) return block.type + ": " + truncate(block.text, 300, θ);  // src: vulnhunter-agent/agent/_stream_events.py:138
        if (block.name != null && block.input != null) return block.type + "(" + block.name + "): " + truncate(repr(block.input), 300, θ); // ToolUseBlock // src: vulnhunter-agent/agent/_stream_events.py:140
        if (block.content instanceof String) return block.type + ": " + truncate(block.content, 300, θ); // ToolResultBlock // src: vulnhunter-agent/agent/_stream_events.py:148
        if (block.content instanceof List) return block.type + ": " + truncate(join(" | ", block.content.map(b -> renderBlock(b, θ))), 300, θ); // src: vulnhunter-agent/agent/_stream_events.py:150
        return block.type + ": " + truncate(repr(block), 300, θ);                                   // src: vulnhunter-agent/agent/_stream_events.py:153
    }

    // _agent_name_from_started: first line of the orchestrator's description, else SDK task_type.
    String agentNameFromStarted(TaskStartedMessage m, Theta θ) {
        String desc = (m.description or "").strip();
        if (!desc.isEmpty() && !desc.firstLine().strip().isEmpty()) return truncate(desc.firstLine().strip(), 60, θ); // src: vulnhunter-agent/agent/_stream_events.py:169
        return (m.taskType or "").strip();                                                          // src: vulnhunter-agent/agent/_stream_events.py:173
    }

    // _log_per_turn_usage: gated on logging.per_turn_usage at the runner; Δ is wall-clock per agent.
    void logPerTurnUsage(AssistantMessage m, Map lastTurnTs, double runStart, Map agentNames, Theta θ) {
        double now = time();
        String agentId = m.parentToolUseId;                                                         // None = root orchestrator // src: vulnhunter-agent/agent/_stream_events.py:203
        double prev = lastTurnTs.getOrDefault(agentId, runStart);                                   // src: vulnhunter-agent/agent/_stream_events.py:204
        lastTurnTs.put(agentId, now);
        Map usage = m.usage or Map.of();                                                            // src: vulnhunter-agent/agent/_stream_events.py:207
        String label = (agentId == null) ? "root" : (agentNames.get(agentId) or "agent[" + agentId.take(8) + "]"); // src: vulnhunter-agent/agent/_stream_events.py:213
        log.info("turn-usage", label, m.model, now - prev, usage.input_tokens, usage.output_tokens, usage.cache_read_input_tokens, usage.cache_creation_input_tokens); // src: vulnhunter-agent/agent/_stream_events.py:217
    }

    // _log_assistant_message: prose always (redacted), tool use brief at v=0 / full at v>=1, thinking at v>=2.
    void logAssistantMessage(AssistantMessage m, Theta θ) {
        List content = m.content or List.of();
        if (content.isEmpty()) {
            if (verbosity >= 1) log.info("assistant: <empty>");                                     // src: vulnhunter-agent/agent/_stream_events.py:240
            return;
        }
        for (Object block : content) {
            if (block.type == "TextBlock") {                                                        // src: vulnhunter-agent/agent/_stream_events.py:246
                if (block.text.isEmpty()) continue;
                for (String line : block.text.rstrip().splitlines()) log.info("assistant: " + Url.redact(line, θ)); // src: vulnhunter-agent/agent/_stream_events.py:255
                continue;
            }
            if (block.type == "ToolUseBlock" || block.type == "ServerToolUseBlock") {               // src: vulnhunter-agent/agent/_stream_events.py:258
                if (verbosity == 0) log.info(block.name + "(" + toolBrief(block.name, block.input, θ) + ")"); // src: vulnhunter-agent/agent/_stream_events.py:261
                else log.info(block.name + "(" + toolBrief(block.name, block.input, θ) + "): " + truncate(repr(block.input), 300, θ)); // src: vulnhunter-agent/agent/_stream_events.py:264
                continue;
            }
            if (block.type == "ThinkingBlock") {                                                    // src: vulnhunter-agent/agent/_stream_events.py:272
                if (verbosity >= 2) log.info("assistant " + renderBlock(block, θ));                 // src: vulnhunter-agent/agent/_stream_events.py:273
                continue;
            }
            if (verbosity >= 1) log.info("assistant " + renderBlock(block, θ));                     // src: vulnhunter-agent/agent/_stream_events.py:278
        }
    }

    void logUserMessage(UserMessage m, Theta θ) {
        Object content = m.content;
        if (content == null) { if (verbosity >= 1) log.info("user: <empty>"); return; }             // src: vulnhunter-agent/agent/_stream_events.py:285
        if (content instanceof String) {
            if (verbosity == 0) log.info("-> " + resultBrief(content, θ));                          // src: vulnhunter-agent/agent/_stream_events.py:290
            else log.info("user: " + truncate(content, 300, θ));
            return;
        }
        if (content instanceof List) {
            if (content.isEmpty()) { if (verbosity >= 1) log.info("user: <empty list>"); return; }  // src: vulnhunter-agent/agent/_stream_events.py:296
            for (Object block : content) {
                if (block.type == "ToolResultBlock") {                                              // src: vulnhunter-agent/agent/_stream_events.py:302
                    if (verbosity == 0) log.info("-> " + resultBrief(block.content, θ));
                    else log.info("user " + renderBlock(block, θ));
                    continue;
                }
                if (verbosity >= 1) log.info("user " + renderBlock(block, θ));                      // src: vulnhunter-agent/agent/_stream_events.py:309
            }
            return;
        }
        if (verbosity >= 1) log.info("user: " + truncate(repr(content), 300, θ));                    // src: vulnhunter-agent/agent/_stream_events.py:312
    }

    void logTaskStarted(TaskStartedMessage m, Theta θ) {
        String shortDesc = truncate(m.description or "", verbosity == 0 ? 100 : 200, θ);           // src: vulnhunter-agent/agent/_stream_events.py:321
        log.info("task started: " + shortDesc + " (type=" + (m.taskType or "?") + ")");            // src: vulnhunter-agent/agent/_stream_events.py:322
        if (verbosity >= 1) log.info("task_id=" + m.taskId);                                        // src: vulnhunter-agent/agent/_stream_events.py:323
    }

    void logTaskStatus(Object m, String agentName, Theta θ) {
        String status = m.status or "?";                                                            // src: vulnhunter-agent/agent/_stream_events.py:335
        boolean failed = status == "failed" || status == "killed";                                  // warning level // src: vulnhunter-agent/agent/_stream_events.py:338
        if (verbosity == 0) {
            if (!TERMINAL_TASK_STATUSES.contains(status)) return;                                   // running/paused are silenced at v=0 // src: vulnhunter-agent/agent/_stream_events.py:344
            log.at(failed).info("task " + status + " " + agentName + ": " + truncate(m.summary or "", 100, θ)); // src: vulnhunter-agent/agent/_stream_events.py:347
            return;
        }
        log.at(failed).info("task " + status + " id=" + m.taskId + " summary=" + truncate(m.summary or "", 120, θ) + " output_file=" + m.outputFile); // src: vulnhunter-agent/agent/_stream_events.py:355
    }

    // _log_system_message: init confirms a vulnhunt* slash command is loaded; errors always surface.
    void logSystemMessage(SystemMessage m, Theta θ) {
        String subtype = m.subtype or "<none>";                                                     // src: vulnhunter-agent/agent/_stream_events.py:366
        Object data = m.data;
        boolean isError = subtype.lower() == "error" || (data instanceof Map && (data.is_error || data.error)); // src: vulnhunter-agent/agent/_stream_events.py:369
        if (subtype == "init") {                                                                    // src: vulnhunter-agent/agent/_stream_events.py:374
            if (data instanceof Map) {
                List<String> loaded = (data.slash_commands or List.of()).filter(c -> c.startsWith("vulnhunt")); // src: vulnhunter-agent/agent/_stream_events.py:382
                if (!loaded.isEmpty()) log.info("/" + loaded[0] + " is loaded");                   // src: vulnhunter-agent/agent/_stream_events.py:383
                else log.warning("No vulnhunt* slash command loaded");                              // src: vulnhunter-agent/agent/_stream_events.py:386
            }
            if (verbosity >= 2) log.info("system [init]: " + truncate(repr(data), 800, θ));        // src: vulnhunter-agent/agent/_stream_events.py:391
            return;
        }
        if (subtype == "task_progress" && verbosity < 1) return;                                    // src: vulnhunter-agent/agent/_stream_events.py:397
        if (data == null) {
            if (isError || verbosity >= 1) log.at(isError).info("system [" + subtype + "]: <no data>"); // src: vulnhunter-agent/agent/_stream_events.py:402
            return;
        }
        if (isError) log.error("system [" + subtype + "]: " + truncate(repr(data), 800, θ));        // src: vulnhunter-agent/agent/_stream_events.py:406
        else if (verbosity >= 2) log.info("system: " + truncate(repr(data), 800, θ));              // src: vulnhunter-agent/agent/_stream_events.py:408
        else if (verbosity >= 1) log.info("system: " + truncate(repr(data), 200, θ));              // src: vulnhunter-agent/agent/_stream_events.py:410
    }

    void logResult(ResultMessage m) {
        if (m.isError) log.warning("ResultMessage is_error=True: " + m.errors);                     // src: vulnhunter-agent/agent/_stream_events.py:416
        log.info("ResultMessage", m.durationMs, m.durationApiMs, m.numTurns, m.totalCostUsd or 0.0); // src: vulnhunter-agent/agent/_stream_events.py:423
    }

    // accumulate_result: cost is cumulative-within-session (running max); API time and turns are per cycle (sum).
    void accumulateResult(SessionTotals totals, ResultMessage m, Theta θ) {
        double costNow = m.totalCostUsd or 0.0;                                                     // src: vulnhunter-agent/agent/_stream_events.py:461
        if (θ["code.agent.stream_events.cost_aggregation"] == "max") {                             // src: vulnhunter-agent/agent/_stream_events.py:462
            if (costNow > totals.costUsd) totals.costUsd = costNow;                                 // src: vulnhunter-agent/agent/_stream_events.py:463
        }
        totals.durationApiMs += m.durationApiMs or 0;                                               // src: vulnhunter-agent/agent/_stream_events.py:464
        totals.numTurns += m.numTurns or 0;                                                         // src: vulnhunter-agent/agent/_stream_events.py:465
        totals.resultMessages += 1;                                                                 // src: vulnhunter-agent/agent/_stream_events.py:466
    }

    void logSessionTotals(SessionTotals totals, String label) {
        log.info(label + " totals", totals.numTurns, totals.resultMessages, totals.durationApiMs, totals.costUsd); // src: vulnhunter-agent/agent/_stream_events.py:475
    }
}
