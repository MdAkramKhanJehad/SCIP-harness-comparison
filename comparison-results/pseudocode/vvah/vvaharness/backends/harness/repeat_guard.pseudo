// file: vvaharness/backends/harness/repeat_guard.py
// Repeated-identical-tool-call guard (VVAH-E009) wrapped around the S10 validation and remediation stream
// consumers. S4 sessions are not wrapped by it (S4 relies on tool/model-call budgets and the recursion limit).

@executedBy(CODE) @role(rule_set)
class RepeatGuard {

    // (agent, tool name, canonical JSON input): two calls are identical when these match.
    Triple<String, String, String> signature(ToolUse msg) {
        return Triple.of(msg.agent != null ? msg.agent : "orchestrator", msg.name, canonicalJson(msg.input)); // src: vvaharness/backends/harness/repeat_guard.py:36
    }

    // Yield the stream, closing it and raising RepeatedToolCallError on a repeat loop.
    Stream<Message> guardRepeats(Stream<Message> source, String stage, String route, Theta θ) {
        Triple<String, String, String> last = null;
        int streak = 0;
        for (Message msg : source) {
            if (msg instanceof ToolUse) {
                Triple<String, String, String> sig = signature(msg);                                     // src: vvaharness/backends/harness/repeat_guard.py:57
                streak = sig.equals(last) ? streak + 1 : 1;                                              // src: vvaharness/backends/harness/repeat_guard.py:58
                last = sig;
                if (streak >= θ["code.repeat_call_limit"]) {                                             // src: vvaharness/backends/harness/repeat_guard.py:60
                    source.close();
                    throw new RepeatedToolCallError(msg.name + " called with identical input " + streak + " times in a row", stage, route); // src: vvaharness/backends/harness/repeat_guard.py:61
                }
            }
            yield(msg);                                                                                  // src: vvaharness/backends/harness/repeat_guard.py:66
        }
        source.close();                                                                                  // src: vvaharness/backends/harness/repeat_guard.py:68
        return source;
    }
}
