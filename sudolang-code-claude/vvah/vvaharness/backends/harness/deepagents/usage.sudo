# vvaharness/backends/harness/deepagents/usage.py

Recovers token usage for DeepAgents sessions from per-message usage metadata, normalized to "fresh input" (input tokens minus cache reads and cache writes), with a per-persona (subagent) breakdown when streamed with namespaces. Each message id is counted once.

Source: `vvaharness/backends/harness/deepagents/usage.py` (lines 1-233)
Executor: code (telemetry only; it changes no scan decision)
Called from: `vvaharness/backends/harness/deepagents/translate.sudo`, `vvaharness/backends/harness/deepagents/client.sudo` (streaming)

// Source comment (17): aggregate_usage_metadata under-counts subagent turns (it sees only final parent messages).

// src: vvaharness/backends/harness/deepagents/usage.py:31-36
SessionUsage { ...TokenUsage; calls?: Number; turns?: Number; subagents?: { persona -> TokenUsage } }

// src: vvaharness/backends/harness/deepagents/usage.py:45-72
_EPHEMERAL_CACHE_KEYS = ["ephemeral_5m_input_tokens", "ephemeral_1h_input_tokens"]
fn _cache_counts(meta):executor=code {
  // cache_read from input_token_details.cache_read; cache_creation = sum of the ephemeral keys if > 0, else input_token_details.cache_creation
}
fn _raw_cache_creation(raw):executor=code {
  // provider-raw usage: cache_creation_input_tokens, or when absent or zero the sum of the ephemeral keys nested under cache_creation
}

// src: vvaharness/backends/harness/deepagents/usage.py:75-121
_Counts {
  input_tokens = 0; output_tokens = 0; cache_read = 0; cache_creation = 0; calls = 0
  // src: usage.py:85-113
  fn add(meta, raw_usage?):executor=code {
    [cache_read, cache_creation] = _cache_counts(meta)
    if (cache_creation == 0) cache_creation = _raw_cache_creation(raw_usage)   // some gateways omit the detail key
    total_input = meta.input_tokens
    if (total_input < cache_read + cache_creation) {
      warn once: "  [deepagents] WARN: usage record reports more cached input (read $cache_read + write $cache_creation) than total input ($total_input); treating input_tokens as fresh-only — the gateway appears to report cache counts outside input_tokens"
      fresh = total_input
    } else {
      fresh = total_input - (cache_read + cache_creation)
    }
    input_tokens += fresh; output_tokens += meta.output_tokens; cache_read += cache_read; cache_creation += cache_creation; calls += 1
  }
}

// src: vvaharness/backends/harness/deepagents/usage.py:142-221
UsageAccumulator {
  State { _seen_ids = {}; _total = _Counts(); _subagents = {}; _ns_to_agent = {} }

  // src: usage.py:152-170 — one stream_mode="updates" event; malformed events are ignored
  fn add_event(event):executor=code { for each message in each node update's messages, add_message(message, namespace) }

  // src: usage.py:180-197
  fn add_message(message, namespace=()):executor=code {
    if (message is not an AI message) return
    if (namespace && message.name) _ns_to_agent[namespace] = message.name
    if (message.usage_metadata == null || message.id was already seen) return   // dedupe by message id
    _total.add(meta, raw usage from response_metadata)
    if (namespace) _subagents[_agent_label(namespace, message.name)].add(...)
  }

  // src: usage.py:199-206
  fn _agent_label(namespace, name):executor=code {
    return name or _ns_to_agent[namespace] or (first namespace element before ":")   // "node_name:task_id"
  }

  // src: usage.py:208-221
  fn snapshot():executor=code {
    if (_total.calls == 0) return null
    usage = _total as TokenUsage; usage.calls = _total.calls; usage.turns = _total.calls
    if (_subagents) usage.subagents = per-persona usage, sorted by persona
    return usage
    // Callers must pass TOKENS.add(usage, turns=usage.turns); TOKENS.add never reads turns itself
  }
}

// src: vvaharness/backends/harness/deepagents/usage.py:224-230
fn aggregate_usage_metadata(messages):executor=code {
  accumulator = UsageAccumulator(); for each message, accumulator.add_message(message)   // no namespace: no subagent breakdown
  return accumulator.snapshot()
}
