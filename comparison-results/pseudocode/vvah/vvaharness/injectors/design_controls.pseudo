// file: vvaharness/injectors/design_controls.py
// Loads design controls (auth boundaries, sandboxes, mitigations) from YAML (inject.controls_file).
// Missing file -> empty; any parse or validation error -> the whole list is empty (all-or-nothing).

@executedBy(CODE) @role(io) @stage("S1")
class DesignControls {

    List<Control> loadControls(Path path, Theta θ) {
        Path p = path;                                                                            // = inject.controls_file, resolved by the orchestrator. src: vvaharness/injectors/design_controls.py:32
        if (!p.exists()) return new List();                                                       // src: vvaharness/injectors/design_controls.py:33
        try {
            Object data = Yaml.safeLoad(p.readText("utf-8"));                                     // empty file -> empty mapping. src: vvaharness/injectors/design_controls.py:40
            List items;
            if (data instanceof Map) {                                                            // src: vvaharness/injectors/design_controls.py:41
                items = data.get("controls");                                                     // src: vvaharness/injectors/design_controls.py:42
                if (items == null) throw new ValueError("controls mapping without a controls key"); // src: vvaharness/injectors/design_controls.py:43
            } else {
                items = data;                                                                     // src: vvaharness/injectors/design_controls.py:48
            }
            // one invalid control fails the whole load (unlike the CVE feed's per-item isolation)
            if (θ["code.injectors.design_controls.all_or_nothing_validation"]) return items.map(it -> new Control(it)); // src: vvaharness/injectors/design_controls.py:49
            return items.mapNotNullCatching(it -> new Control(it));
        } catch (OSError | ValueError | TypeError | YAMLError | ValidationError e) {
            Log.warn("DESIGN_CONTROLS_UNREADABLE", p, e);                                         // src: vvaharness/injectors/design_controls.py:51
            ErrLog.log("inject.controls", p, e);                                                  // src: vvaharness/injectors/design_controls.py:52
            return new List();                                                                    // src: vvaharness/injectors/design_controls.py:53
        }
    }
}
