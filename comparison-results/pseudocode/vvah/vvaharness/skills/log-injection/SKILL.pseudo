// file: vvaharness/skills/log-injection/SKILL.md
// S4 skill playbook "log-injection": class A log injection (CWE-117), class B missing logging (CWE-778),
// class C plaintext credentials in logs (CWE-312/532), each with its own hard gate.

@executedBy(MODEL) @role(skill) @stage("S4")
class LogInjectionSkill {

    List<Finding> run(Repo repo, Lens lens, Theta θ) {
        if (!lens.task.matches(θ["p.skill_log-injection.trigger"])) return List.of();                      // src: vvaharness/skills/log-injection/SKILL.md:3
        LogInjectionPrompt.playbook(θ);
        List<Finding> out = new List();
        for (Candidate c : lookLogInjection(repo, θ)) {
            if (classAGate(c, θ)) out.add(c.toFinding(θ["p.skill_log-injection.class_a_cwe117"]));          // src: vvaharness/skills/log-injection/SKILL.md:27
            // class C stands alone, even when injection is impossible
            if (classCGate(c, θ) && θ["p.skill_log-injection.class_c_standalone_finding"]) out.add(c.toFinding(θ["p.skill_log-injection.class_c_cwe312_532"])); // src: vvaharness/skills/log-injection/SKILL.md:45
        }
        for (Candidate c : lookMissingLogging(repo, θ)) {
            if (θ["p.skill_log-injection.class_b_gate_silent_security_event"] && c.securityEvent != null && c.logOutputOnFailure == 0) out.add(c.toFinding(θ["p.skill_log-injection.class_b_cwe778"])); // src: vvaharness/skills/log-injection/SKILL.md:54
        }
        return out;
    }

    boolean classAGate(Candidate c, Theta θ) {
        if (θ["p.skill_log-injection.class_a_gate_log_call"] && c.logCall == null) return false;           // src: vvaharness/skills/log-injection/SKILL.md:36
        if (!c.valueExternal || c.strips(θ["p.skill_log-injection.class_a_gate_external_value_unstripped"])) return false; // newlines not stripped // src: vvaharness/skills/log-injection/SKILL.md:38
        if (θ["p.skill_log-injection.class_a_sanitised_or_fixed_not_finding"] && (c.sanitised || c.fixedString)) return false; // src: vvaharness/skills/log-injection/SKILL.md:41
        return true;
    }

    boolean classCGate(Candidate c, Theta θ) {
        // parameter name in the list (case-insensitive), or the keyword in the message followed by the value
        return c.logCall != null && (c.paramNameIn(θ["p.skill_log-injection.class_c_gate_param_names"]) || c.messageKeywordThenValue(θ["p.skill_log-injection.class_c_gate_param_names"])); // src: vvaharness/skills/log-injection/SKILL.md:49
    }

    List<Candidate> lookLogInjection(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (θ["p.skill_log-injection.look_fstring_raw_input"]) out.addAll(repo.grep("f-string log message with raw input")); // src: vvaharness/skills/log-injection/SKILL.md:64
        if (θ["p.skill_log-injection.look_format_args_from_request"]) out.addAll(repo.grep("log format/args from HTTP param, header, filename, profile field")); // src: vvaharness/skills/log-injection/SKILL.md:65
        if (θ["p.skill_log-injection.look_user_influenced_log_path"]) out.addAll(repo.grep("logger file path user-influenced")); // src: vvaharness/skills/log-injection/SKILL.md:67
        if (θ["p.skill_log-injection.look_structured_logger_merge"]) out.addAll(repo.grep("structlog/winston/bunyan merging attacker keys")); // src: vvaharness/skills/log-injection/SKILL.md:69
        return out;
    }

    List<Candidate> lookMissingLogging(Repo repo, Theta θ) {
        List<Candidate> out = new List();
        if (θ["p.skill_log-injection.look_auth_failures_unlogged"]) out.addAll(repo.grep("failed login, locked account, expired session without log")); // src: vvaharness/skills/log-injection/SKILL.md:74
        if (θ["p.skill_log-injection.look_admin_actions_unaudited"]) out.addAll(repo.grep("role change, deletion, config update without audit log")); // src: vvaharness/skills/log-injection/SKILL.md:76
        if (θ["p.skill_log-injection.look_swallowed_security_exceptions"]) out.addAll(repo.grep("PermissionDenied caught and swallowed")); // src: vvaharness/skills/log-injection/SKILL.md:78
        if (θ["p.skill_log-injection.look_reset_mfa_unlogged"]) out.addAll(repo.grep("password reset, MFA enrolment, 2FA bypass unlogged")); // src: vvaharness/skills/log-injection/SKILL.md:80
        if (θ["p.skill_log-injection.look_file_transfer_unlogged"]) out.addAll(repo.grep("sensitive file upload/download unlogged")); // src: vvaharness/skills/log-injection/SKILL.md:81
        return out;
    }
}

@executedBy(MODEL) @role(prompt) @stage("S4")
class LogInjectionPrompt {

    Prompt playbook(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.skill_log-injection.persona"]);                                                      // src: vvaharness/skills/log-injection/SKILL.md:24
        p.choose(θ["p.skill_log-injection.class_a_cwe117"]);                                                // src: vvaharness/skills/log-injection/SKILL.md:27
        p.choose(θ["p.skill_log-injection.class_b_cwe778"]);                                                // src: vvaharness/skills/log-injection/SKILL.md:31
        p.evidence(θ["p.skill_log-injection.class_a_gate_log_call"]);                                       // src: vvaharness/skills/log-injection/SKILL.md:36
        p.evidence(θ["p.skill_log-injection.class_a_gate_external_value_unstripped"]);                      // src: vvaharness/skills/log-injection/SKILL.md:38
        p.exemption(θ["p.skill_log-injection.class_a_sanitised_or_fixed_not_finding"]);                     // src: vvaharness/skills/log-injection/SKILL.md:41
        p.choose(θ["p.skill_log-injection.class_c_cwe312_532"]);                                            // src: vvaharness/skills/log-injection/SKILL.md:43
        p.rule(θ["p.skill_log-injection.class_c_standalone_finding"]);                                      // src: vvaharness/skills/log-injection/SKILL.md:45
        p.evidence(θ["p.skill_log-injection.class_c_gate_param_names"]);                                    // src: vvaharness/skills/log-injection/SKILL.md:49
        p.evidence(θ["p.skill_log-injection.class_b_gate_silent_security_event"]);                          // src: vvaharness/skills/log-injection/SKILL.md:54
        p.rule(θ["p.skill_log-injection.look_list_non_exhaustive"]);                                        // src: vvaharness/skills/log-injection/SKILL.md:59
        p.checklist(θ["p.skill_log-injection.look_fstring_raw_input"]);                                     // src: vvaharness/skills/log-injection/SKILL.md:64
        p.checklist(θ["p.skill_log-injection.look_format_args_from_request"]);                              // src: vvaharness/skills/log-injection/SKILL.md:65
        p.checklist(θ["p.skill_log-injection.look_user_influenced_log_path"]);                              // src: vvaharness/skills/log-injection/SKILL.md:67
        p.checklist(θ["p.skill_log-injection.look_structured_logger_merge"]);                               // src: vvaharness/skills/log-injection/SKILL.md:69
        p.checklist(θ["p.skill_log-injection.look_auth_failures_unlogged"]);                                // src: vvaharness/skills/log-injection/SKILL.md:74
        p.checklist(θ["p.skill_log-injection.look_admin_actions_unaudited"]);                               // src: vvaharness/skills/log-injection/SKILL.md:76
        p.checklist(θ["p.skill_log-injection.look_swallowed_security_exceptions"]);                         // src: vvaharness/skills/log-injection/SKILL.md:78
        p.checklist(θ["p.skill_log-injection.look_reset_mfa_unlogged"]);                                    // src: vvaharness/skills/log-injection/SKILL.md:80
        p.checklist(θ["p.skill_log-injection.look_file_transfer_unlogged"]);                                // src: vvaharness/skills/log-injection/SKILL.md:81
        return p;
    }
}
