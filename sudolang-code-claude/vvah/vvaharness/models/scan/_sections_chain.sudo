# vvaharness/models/scan/_sections_chain.py

Report sections for exploit chains, removed or unpromoted chains, the threat model, the application profile, and the appendix of files no investigation unit named. All text is code-generated; model prose is passed through the `_render` neutralisers.

Source: `vvaharness/models/scan/_sections_chain.py` (lines 1-278)
Executor: code
Called from: `vvaharness/models/scan/report.py` (FinalReport.to_markdown)

// src: vvaharness/models/scan/_sections_chain.py:33
_UNPROMOTED_SHOWN = 20

// src: vvaharness/models/scan/_sections_chain.py:36-94
fn _chain_lines(report, n, c):executor=code {
  path = join(for each idx in c.steps: "#${ idx+1 } <_md_cell(finding title)>", " → ")
  emit "### Chain $n — [<SEVERITY upper>] <_md_cell(c.title)>"
  emit "**Path:** $path" + ("  \n**Reached via:** ..." if entry_reachability) + ("  \n**Requires:** <preconditions>" if any) + ("  \n**Blocked by:** <blocked_by_controls>" if any)
  // "Requires" and "Blocked by" are opposites and never share a label (would read as mitigated)
  if (c.link_evidence) emit "**Step links:**" then "- from_id → to_id[ — mechanism][ (`file:line`) when file and line]" per link
  _decision_note = { lift_withheld: "severity not raised to the strongest constituent finding", self_raise_capped: "severity capped at the strongest constituent finding" }
  meta = ["Link coverage: $link_coverage" if set, _decision_note[severity_decision] if any, ...quality_notes, ...disclosures]
  if (meta) emit "_<join(meta, " · ")>_"
  emit _demote_md_headings(c.narrative, escape_angles=true)
}

// src: vvaharness/models/scan/_sections_chain.py:96-110
fn _unpromoted_pairs_text(report):executor=code {
  shown = first _UNPROMOTED_SHOWN pairs as "#o+1 → #t+1"; return shown + " (+N more)" when more exist
}
fn _unpromoted_link_leadin(report):executor=code {
  n = length(report.unpromoted_links); if (!n) return []
  return "_The chain pass marked $n link(s) between findings as chain potential that no chain below carries in order: <pairs>. Disclosed, not promoted: a chain needs link evidence, a marked link does not._"
}

// src: vvaharness/models/scan/_sections_chain.py:112-124 — one note per nonzero count
fn _chain_removal_leadins(report):executor=code {
  chains_dropped => "_N further proposed chain(s) were removed: their steps did not resolve to two or more distinct findings in this report._"
  chains_deduped => "_N further proposed chain(s) were identical to a chain already shown and were collapsed._"
  chains_invalid => "_N further proposed chain(s) were removed: the reply wrote them in a shape this report could not read (a required field missing or unreadable)._"
}

// src: vvaharness/models/scan/_sections_chain.py:126-135
fn _terminal_diversity_leadin(report):executor=code {
  n = length(chains); m = count of distinct (file, line_start) of each chain's last step   // location, not index
  if (n <= m) return []
  return "_$n chain(s) below end at $m distinct final step(s); a count of chains is not a count of distinct sinks._"
}

// src: vvaharness/models/scan/_sections_chain.py:137-145
fn _summary_reconciliation_note(report):executor=code {
  n = chains_dropped + chains_invalid; if (!n) return []
  return "_$n proposed chain(s) were removed before this report: their steps did not resolve to two or more distinct findings in this report, or the entry was written in a shape this report could not read; the summary above may still describe them._"
}

// src: vvaharness/models/scan/_sections_chain.py:147-164
fn _empty_chain_section_copy(report):executor=code {
  clauses = nonzero ones of: dropped ("... were removed because their steps did not resolve to two or more distinct findings in this report."),
            deduped ("... were identical to another and were collapsed."), invalid ("... were written in a shape this report could not read and were removed."),
            unpromoted links ("N link(s) between findings were marked as chain potential (<pairs>) but no surviving chain carries them.")
  if (clauses) return "No exploit chains are reported — <clauses>"
  return "No exploit chains were identified — no chain entry combining findings reached this report."
}

// src: vvaharness/models/scan/_sections_chain.py:166-173
fn _chain_pass_caveat(report):executor=code {
  if (report.findings is empty) return []   // no findings, no chain pass
  return "_Only chain entries the chain pass submitted are checked; a path the summary or a finding's Exploitability note above describes without one has not been checked._"
}

// src: vvaharness/models/scan/_sections_chain.py:175-197
fn _render_unreachable_appendix(report):executor=code {
  cap = 200
  emit "## Appendix — Files Named by No Investigation Unit (N)"
  emit "**N** file(s) in scope were named by no investigation unit when the threat model was decomposed, so no review pass read them. Treat this list as the scan's coverage gap — a finding in one of these files cannot appear above."
  for each f in first cap of files, emit "- `<_md_cell(f), backticks => U+02CB>`"
  if (length(files) > cap) emit "- _… and <rest> more (full list in the s3 checkpoint manifest)_"
}

// src: vvaharness/models/scan/_sections_chain.py:199-217
fn _app_profile_lines(report):executor=code {
  if (!app_profile) return []
  emit "### Application profile (CMDB)", ID (escaped), name or "-", "Externally facing: **YES|NO**",
       "Data sensitivity: <PCI-scoped, processes PAN, PII> or standard", "Source: ..."
}

// src: vvaharness/models/scan/_sections_chain.py:219-240
fn _ranked_threat_rows(tm, without_unit):executor=code {
  table columns: ID | Threat | Actor | Surface | Asset | Impact | Likelihood | Controls (empty => "-"), plus "Investigation unit" when without_unit != null
  for each (tid, t) in zip(tm.threat_ids(), tm.threats) {
    unit cell = if (tid in without_unit) "**none — never reviewed**" else "minted"   // cause-neutral
  }
}

// src: vvaharness/models/scan/_sections_chain.py:243-278
fn _render_threat_model(report):executor=code {
  emit "## Threat Model", ..._app_profile_lines(report)
  if (system_context) emit "### System context" + demoted text
  if (assets) emit "### Assets" table (Asset | Sensitivity | Description)
  if (trust_boundaries) emit "### Trust boundaries" list "- **entry_point** — crossing → reachable assets or -"
  if (threats) emit _ranked_threat_rows(tm, report.threats_without_unit)
  if (open_questions) emit "### Open questions", "_Model-authored during threat modeling — an estimate, not a computed count; see this report's own coverage figures (e.g. unreachable files, below) for the deterministic numbers._", each question
}
