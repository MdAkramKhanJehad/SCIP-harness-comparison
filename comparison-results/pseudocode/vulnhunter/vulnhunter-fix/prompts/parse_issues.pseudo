        Prompt p = new Prompt();
        p.must(θ["p.parse_issues.always_ask_selection"]);                                               // src: vulnhunter-fix/prompts/parse_issues.md:199
        p.rule(θ["p.parse_issues.severity_annotation_haiku_subagent"]);                                 // src: vulnhunter-fix/prompts/parse_issues.md:201
        p.must(θ["p.parse_issues.display_subagent_table_verbatim"]);                                    // src: vulnhunter-fix/prompts/parse_issues.md:216
        p.threshold(θ["p.parse_issues.cluster_threshold_n"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:237
        p.rule(θ["p.parse_issues.cluster_criterion_topic"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:237
        p.threshold(θ["p.parse_issues.cluster_count_target"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:237
        p.threshold(θ["p.parse_issues.cluster_name_max_words"]);                                        // src: vulnhunter-fix/prompts/parse_issues.md:237
        p.format(θ["p.parse_issues.cluster_fields"]);                                                   // src: vulnhunter-fix/prompts/parse_issues.md:242
        p.rule(θ["p.parse_issues.cluster_is_delivery_unit"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:244
        p.rule(θ["p.parse_issues.cluster_boundary_heuristic"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:246
        p.forbid(θ["p.parse_issues.severity_not_grouping_criterion"]);                                  // src: vulnhunter-fix/prompts/parse_issues.md:246
        p.rule(θ["p.parse_issues.cluster_rank_by_risk_score"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:248
        p.threshold(θ["p.parse_issues.weight_critical"]);                                               // src: vulnhunter-fix/prompts/parse_issues.md:252
        p.threshold(θ["p.parse_issues.weight_high"]);                                                   // src: vulnhunter-fix/prompts/parse_issues.md:253
        p.threshold(θ["p.parse_issues.weight_medium"]);                                                 // src: vulnhunter-fix/prompts/parse_issues.md:254
        p.threshold(1);                                                                                  // Low weight, no knob (src: vulnhunter-fix/prompts/parse_issues.md:255)
        p.threshold(θ["p.parse_issues.weight_unknown"]);                                                // src: vulnhunter-fix/prompts/parse_issues.md:256
        p.tiebreak(θ["p.parse_issues.cluster_tiebreak_member_count"]);                                  // src: vulnhunter-fix/prompts/parse_issues.md:260
        p.rule(θ["p.parse_issues.top_cluster_recommended"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:260
        p.format(θ["p.parse_issues.clusters_json_fields"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:264
        p.threshold(θ["p.parse_issues.cluster_min_fallback"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:283
        p.must(θ["p.parse_issues.canonical_scorer_run"]);                                               // src: vulnhunter-fix/prompts/parse_issues.md:285
        p.rule(θ["p.parse_issues.ask_via_checkboxes"]);                                                 // src: vulnhunter-fix/prompts/parse_issues.md:295
        p.rule(θ["p.parse_issues.single_issue_auto_proceed"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:299
        p.rule(θ["p.parse_issues.zero_issues_stop"]);                                                   // src: vulnhunter-fix/prompts/parse_issues.md:300
        p.rule(θ["p.parse_issues.small_n_per_issue_options"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:301
        p.threshold(θ["p.parse_issues.cluster_question_max_options"]);                                  // src: vulnhunter-fix/prompts/parse_issues.md:302
        p.choose(θ["p.parse_issues.severity_bucket_fallback_question"]);                                // src: vulnhunter-fix/prompts/parse_issues.md:303
        p.rule(θ["p.parse_issues.other_option_free_text"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:305
        p.checklist(θ["p.parse_issues.answer_parse_rules"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:307
        p.rule(θ["p.parse_issues.other_text_reject_non_numeric"]);                                      // src: vulnhunter-fix/prompts/parse_issues.md:312
        p.forbid(θ["p.parse_issues.filter_intake_no_jq"]);                                              // src: vulnhunter-fix/prompts/parse_issues.md:316
        p.step(1, θ["p.parse_issues.snapshot_full_intake"]);                                            // src: vulnhunter-fix/prompts/parse_issues.md:320
        p.step(3, θ["p.parse_issues.filtered_intake_sanity_check"]);                                    // src: vulnhunter-fix/prompts/parse_issues.md:323
        p.rule(θ["p.parse_issues.empty_selection_exit"]);                                               // src: vulnhunter-fix/prompts/parse_issues.md:326
