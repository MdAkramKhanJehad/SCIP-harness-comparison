# vvaharness/models/scan/metrics.py

`ScanMetrics`: coverage, verification and cost statistics rendered at the top of the report, plus a snapshot of every pipeline counter (`COUNTERS`). `ScopeEntry` is one analysis unit in the scope appendix.

Source: `vvaharness/models/scan/metrics.py` (lines 1-247)
Executor: code
Called from: `vvaharness/util/metrics.py` (builder), `vvaharness/models/scan/report.py` and the metrics report sections

// src: vvaharness/models/scan/metrics.py:25-29
ScopeEntry {
  name: String
  kind: "risk" | "catchall" | "specialist" | "taint" | "threat" | "other"
  files: String[]
}

// src: vvaharness/models/scan/metrics.py:32-240
ScanMetrics {
  // identity and timing
  scan_id: String = ""; module_name: String = ""; start_ts: String = ""; end_ts: String = ""   // ISO 8601
  duration_sec: Number = 0.0
  // coverage
  total_files_in_scope: Number = 0
  analyzed_files_unique: Number = 0
  chunks_total, chunks_risk, chunks_catchall, chunks_specialist: Number = 0
  chunks_attempted: Number = 0; chunks_failed: Number = 0   // failed, timed out or guardrail-blocked; default 0 keeps old payloads valid
  deepdive_skipped: Boolean = false
  errors_by_stage: { stage: Number } = {}; errors_log_path: String = ""
  loc_in_scope_by_language, loc_scanned_by_language: { language: Number } = {}
  // verification counts
  raw_findings_count, true_positive_count, false_positive_count, duplicate_count: Number = 0
  discovered_true_positive_count, repeat_clone_true_positive_count, ev_rescued_count: Number = 0   // the report's reconciling terms
  // tokens and cost: null renders as "unavailable", never 0
  prompt_tokens, completion_tokens, total_tokens: Number | null = null
  tokens_by_phase: { phase: {} } | null = null
  reported_cost_usd: Number | null = null   // backend billing (cli and cli_mcp only)
  priced_cost_usd: Number | null = null     // tokens × list price
  folders_scanned: String[] = []; scope: ScopeEntry[] = []; excluded: {} = {}
  chunks_by_kind: { kind: Number } = {}     // superset of chunks_risk / catchall / specialist

  // COUNTERS snapshot, read once by the metrics builder; every field defaults to 0 / false / [] so old payloads validate
  // abstracted: metrics.py:75-238 lists 109 counter fields; each is a plain number defaulting to 0 (except s2_degraded: Boolean = false,
  // s2_baseline_undisposed: String[] = [], s2_repo_kinds: String[] = []). They record, without changing any decision here:
  //   Stage 2: s2_degraded, s2_threats_raw / _truncated / _promoted, s2_frontier_*_excluded, s2_assets_truncated,
  //            s2_trust_boundaries_truncated, s2_prompt_*_truncated, s2_inventory_files_truncated, s2_baseline_undisposed(_recovered),
  //            s2_repo_kinds, s2_surface_files_dropped, s2_evidence_gate_rejected(_relented)
  //   Stage 3: s3_unknown_file_ids, s3_dropped_paths, s3_relocated_paths, s3_unreachable_files, s3_threats_without_unit
  //   Stage 4: s4_findings_truncated, s4_finding_extra_cwe_collapsed, s4_unit_key_deduped, s4_unit_no_outcome,
  //            s4_batch_member_uninvestigated / _failed / _resubmitted / _recovered, s4_evidence_gate_rejected(_relented)
  //   model routes: deepagents_oversize_prompts (VVAH-E004), deepagents_tool_state_not_roundtripped (VVAH-E006),
  //            deepagents_path_jail_refused, llm_truncated_replies (VVAH-E005), llm_truncated_below_budget,
  //            llm_adapter_evidence_gate_unenforced, cli_mcp_evidence_gate_unenforced, evidence_gate_stood_down_degenerate_graph,
  //            llm_turn_cap_exhausted, llm_model_refusals, llm_refusal_retry_*, llm_truncated_retry_*, llm_structured_submit_rejected,
  //            llm_structured_prose_reask, llm_structured_retry_truncated, sdk_tool_choice_dropped_for_thinking,
  //            deepagents_tool_choice_dropped, llm_call_timeouts (VVAH-E008), llm_call_budget_near (completed xhigh/max call at or above 0.75x budget)
  //   Stage 6: s6_evidence_gate_rejected(_relented), s6_confirmed_without_vector, s6_cvss_zero_impact_on_tp, s6_confidence_clamped,
  //            s6_confidence_uniform, s6_finding_line_correction_reverted_reanchor, s6_batch_structured / guardrail / generic_split,
  //            s6_structured_retry_*, s6_truncated_retry_*, s6_replayed_fp_held, s6_fp_premise_contradicted, s6_replayed_tp_shipped,
  //            s6_outcome_members_resubmitted / _recovered, s6_outcome_repaired_attempt / _ok
  //   per-stage retry pairs (attempted / recovered): s1_truncated_retry, s2_structured_retry, s2_truncated_retry, s4_structured_retry,
  //            s4_truncated_retry, s7_*, s8_*, ev_classify_truncated_retry, s2_empty_retry, s2_parse_repair, s4_outcome_repaired,
  //            s4_batch_repaired
  //   orphans: s2_orphan_settled, s4_orphan_settled, s6_orphan_settled, s8_orphan_settled
  //   Stage 1: s1_autoexclude_language_veto
}

// src: vvaharness/models/scan/metrics.py:242-247
fn ScanMetrics.coverage_pct():executor=code {
  if (!total_files_in_scope) return 0.0
  return analyzed_files_unique / total_files_in_scope * 100
}
