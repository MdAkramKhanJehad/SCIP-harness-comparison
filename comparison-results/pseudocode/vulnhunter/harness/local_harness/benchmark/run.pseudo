// file: harness/local_harness/benchmark/run.py
// Benchmark harness: load ground truth, dedupe (repo, commit) targets, clone at commit, scan in parallel,
// LLM-judge each ground-truth finding against the scan report, tally detection rate, update finding history.

@executedBy(CODE) @role(types)
record ScanTargetState(String repoUrl, String commitHash, String cloneDir, String status, String error, String resultsDir,
                       int scanExitCode, int scanElapsedS, int scanEventCount, Map scanCost) { }

@executedBy(CODE) @role(pipeline) @stage("benchmark")
class BenchmarkRun {

    List<Pair<String, List<Finding>>> loadAllBenchmarks() {
        List results = new List();
        for (String jsonFile : Fs.glob(LocalHarnessConfig.BENCHMARK_DIR() + "/*.json").sorted()) { // src: harness/local_harness/benchmark/run.py:57
            List<Finding> findings = Json.load(jsonFile);                            // src: harness/local_harness/benchmark/run.py:59
            for (Finding f : findings) {                                             // src: harness/local_harness/benchmark/run.py:60
                Triple t = LocalHarnessClone.parseSourceUrl(f.source_code);          // src: harness/local_harness/benchmark/run.py:61
                f.repoUrl = t.first; f.repoName = t.second; f.commitHash = t.third;
            }
            results.add(Fs.basename(jsonFile), findings);                            // src: harness/local_harness/benchmark/run.py:65
        }
        return results;
    }

    Map<String, Target> deduplicateTargets(List<Pair<String, List<Finding>>> benchmarks) {
        Map<String, Target> targets = new Map();
        for (Pair b : benchmarks) {                                                  // src: harness/local_harness/benchmark/run.py:75
            for (Finding f : b.findings) {
                String key = LocalHarnessClone.targetDirName(f.repoName, f.commitHash); // src: harness/local_harness/benchmark/run.py:77
                if (!targets.containsKey(key)) targets.put(key, new Target(key, f.repoUrl, f.commitHash, f.repoName, LocalHarnessConfig.CLONE_BASE_DIR() + "/" + key)); // src: harness/local_harness/benchmark/run.py:78
                targets[key].findings.add(f.finding_id, f.type, f.description, b.filename); // src: harness/local_harness/benchmark/run.py:87
            }
        }
        return targets;
    }

    State loadState(Theta θ) {
        if (Fs.isfile("benchmark_results/state.json")) {                             // src: harness/local_harness/benchmark/run.py:98
            try { return Json.load("benchmark_results/state.json"); } catch (JSONDecodeError | OSError e) { /* corrupt: start fresh */ } // src: harness/local_harness/benchmark/run.py:102
        }
        return new State(Map.of(), Map.of(), θ["harness.MODEL"]);                     // src: harness/local_harness/benchmark/run.py:104
    }

    void saveState(State state) {
        LocalHarnessConfig.atomicWriteJson("benchmark_results/state.json", state);   // src: harness/local_harness/benchmark/run.py:109
    }

    void phaseClone(Map<String, Target> targets, State state, Theta θ) {
        for (Target t : targets.values()) {                                          // src: harness/local_harness/benchmark/run.py:118
            String st = state.scanTargets.get(t.key)?.status;
            if (List.of("cloned", "scanned").contains(st) && Fs.isdir(t.cloneDir)) continue; // src: harness/local_harness/benchmark/run.py:119
            Pair<String, String> r = LocalHarnessClone.cloneAtCommit(t.repoUrl, t.commitHash, t.cloneDir, θ); // src: harness/local_harness/benchmark/run.py:124
            if (r.second != null) state.scanTargets.put(t.key, new ScanTargetState(t.repoUrl, t.commitHash, t.cloneDir, "clone_failed", r.second)); // src: harness/local_harness/benchmark/run.py:128
            else state.scanTargets.put(t.key, new ScanTargetState(t.repoUrl, t.commitHash, t.cloneDir, "cloned"));  // src: harness/local_harness/benchmark/run.py:138
            saveState(state);                                                        // src: harness/local_harness/benchmark/run.py:144
        }
    }

    void phaseScan(Map<String, Target> targets, State state, boolean forceRescan, int maxWorkers, boolean execute, Theta θ) {
        List<Target> toScan = new List();
        for (Target t : targets.values()) {                                          // src: harness/local_harness/benchmark/run.py:150
            ScanTargetState ts = state.scanTargets.getOrDefault(t.key, empty);
            if (ts.status == "clone_failed") continue;                               // src: harness/local_harness/benchmark/run.py:153
            if (!forceRescan && ts.status == "scanned" && ts.resultsDir != null && Fs.isdir(ts.resultsDir)) continue; // src: harness/local_harness/benchmark/run.py:156
            if (!forceRescan && LocalHarnessScan.hasValidResults(t.cloneDir)) {      // src: harness/local_harness/benchmark/run.py:162
                ts.status = "scanned"; ts.resultsDir = LocalHarnessScan.findResultsDir(t.cloneDir); // src: harness/local_harness/benchmark/run.py:163
                saveState(state);
                continue;                                                            // src: harness/local_harness/benchmark/run.py:169
            }
            toScan.add(t);                                                           // src: harness/local_harness/benchmark/run.py:171
        }
        if (toScan.isEmpty()) return;                                                // src: harness/local_harness/benchmark/run.py:173
        for (Target t : toScan) LocalHarnessScan.cleanPriorResults(t.cloneDir, null); // src: harness/local_harness/benchmark/run.py:179
        for (Target t : toScan) {                                                    // src: harness/local_harness/benchmark/run.py:184
            if (state.scanTargets.containsKey(t.key)) { state.scanTargets[t.key].resultsDir = null; state.scanTargets[t.key].status = "cloned"; } // src: harness/local_harness/benchmark/run.py:186
            for (Finding f : t.findings) state.judgments.remove(f.finding_id);       // src: harness/local_harness/benchmark/run.py:190 (rescan invalidates judgments)
        }
        saveState(state);
        List<Pair> results = LocalHarnessScan.scanTargets(toScan, maxWorkers, 300, null, !execute, θ); // src: harness/local_harness/benchmark/run.py:197
        for (Pair p : results) {                                                     // src: harness/local_harness/benchmark/run.py:199
            ScanResult r = p.result;
            if (r.returncode == 0 && r.resultsDir != null) state.scanTargets[p.key].merge("scanned", r.resultsDir, r.returncode, r.elapsed, r.eventCount, r.costData); // src: harness/local_harness/benchmark/run.py:200
            else state.scanTargets[p.key].merge("scan_failed", r.resultsDir, r.returncode, r.elapsed, r.eventCount, r.costData); // src: harness/local_harness/benchmark/run.py:211
            saveState(state);
        }
    }

    void phaseJudge(Map<String, Target> targets, State state, boolean forceRejudge, Theta θ) {
        for (Target t : targets.values()) {                                          // src: harness/local_harness/benchmark/run.py:232
            ScanTargetState ts = state.scanTargets.getOrDefault(t.key, empty);
            if (ts.status != "scanned" || ts.resultsDir == null) {                   // src: harness/local_harness/benchmark/run.py:236
                // judged as detected=null ("scan not available") — excluded from the detection rate by tally
                for (Finding f : t.findings) if (!state.judgments.containsKey(f.finding_id) || forceRejudge) state.judgments.put(f.finding_id, unavailableJudgment(t.key, ts.status)); // src: harness/local_harness/benchmark/run.py:239
                saveState(state);
                continue;
            }
            List<Finding> toJudge = t.findings.filter(f -> forceRejudge || !state.judgments.containsKey(f.finding_id)); // src: harness/local_harness/benchmark/run.py:258
            if (toJudge.isEmpty()) continue;                                         // src: harness/local_harness/benchmark/run.py:263
            String report = BenchmarkJudge.readResultsReport(ts.resultsDir);         // src: harness/local_harness/benchmark/run.py:266
            if (report == null) {                                                    // src: harness/local_harness/benchmark/run.py:267
                for (Finding f : toJudge) state.judgments.put(f.finding_id, unavailableJudgment(t.key, "no README.md in results directory")); // src: harness/local_harness/benchmark/run.py:269
                saveState(state);
                continue;
            }
            // one batched judge call per scan target, all its pending findings together
            List<Judgment> js = BenchmarkJudge.judgeFindingsBatch(report, toJudge, θ["harness.MODEL"], θ); // src: harness/local_harness/benchmark/run.py:284
            for (Judgment j : js) state.judgments.put(j.finding_id, j.withMeta(t));  // src: harness/local_harness/benchmark/run.py:289
            saveState(state);                                                        // src: harness/local_harness/benchmark/run.py:302
        }
    }

    void phaseTally(State state, Theta θ) {
        int backfilled = 0;
        for (ScanTargetState ts : state.scanTargets.values()) {                      // src: harness/local_harness/benchmark/run.py:315
            if (ts.scanCost.total_cost_usd != null) continue;                         // src: harness/local_harness/benchmark/run.py:316
            if (ts.cloneDir == null) continue;                                       // src: harness/local_harness/benchmark/run.py:319
            Map cost = LocalHarnessScan.extractCostFromLog(ts.cloneDir + "/benchmark_scan.log"); // src: harness/local_harness/benchmark/run.py:322
            if (!cost.isEmpty()) { ts.scanCost = cost; backfilled++; }               // src: harness/local_harness/benchmark/run.py:323
        }
        if (backfilled > 0) saveState(state);                                        // src: harness/local_harness/benchmark/run.py:329
        Tally tally = BenchmarkTally.generateTally(state, θ);                        // src: harness/local_harness/benchmark/run.py:331
        BenchmarkTally.writeTallyJson(tally);                                        // src: harness/local_harness/benchmark/run.py:332
        BenchmarkTally.writeTallyMarkdown(tally);                                    // src: harness/local_harness/benchmark/run.py:333
        // print_summary(tally)                                                      // src: harness/local_harness/benchmark/run.py:334
    }

    Map<String, Target> filterTargetsByFindings(Map<String, Target> targets, Set<String> findingIds) {
        Map<String, Target> filtered = new Map();
        for (Target t : targets.values()) {                                          // src: harness/local_harness/benchmark/run.py:340
            List<Finding> matching = t.findings.filter(f -> findingIds.contains(f.finding_id)); // src: harness/local_harness/benchmark/run.py:341
            if (!matching.isEmpty()) filtered.put(t.key, t.withFindings(matching));  // src: harness/local_harness/benchmark/run.py:342
        }
        return filtered;
    }

    void run(Args args, Theta θ) {
        // flags: --scan-only --judge-only --tally-only --force-rescan --force-rejudge --repos --findings --max-workers --skip-stable --execute
        int maxWorkers = args.maxWorkers != null ? args.maxWorkers : θ["harness.MAX_SCAN_WORKERS"]; // src: harness/local_harness/benchmark/run.py:363
        boolean execute = args.execute != null ? args.execute : θ["code.local_harness.batch.run.execute_default"]; // src: harness/local_harness/benchmark/run.py:367 (read-only scan unless --execute)
        List benchmarks = loadAllBenchmarks();                                       // src: harness/local_harness/benchmark/run.py:372
        if (benchmarks.isEmpty()) exit(1);                                           // src: harness/local_harness/benchmark/run.py:373
        Map<String, Target> targets = deduplicateTargets(benchmarks);                // src: harness/local_harness/benchmark/run.py:381
        if (args.repos != null) {                                                    // src: harness/local_harness/benchmark/run.py:384
            targets = targets.filterKeys(k -> k.lower().contains(args.repos.lower())); // src: harness/local_harness/benchmark/run.py:385
            if (targets.isEmpty()) exit(1);                                          // src: harness/local_harness/benchmark/run.py:386
        }
        if (args.findings != null) {                                                 // src: harness/local_harness/benchmark/run.py:391
            targets = filterTargetsByFindings(targets, Set.of(args.findings.split(",").map(String::strip))); // src: harness/local_harness/benchmark/run.py:393
            if (targets.isEmpty()) exit(1);                                          // src: harness/local_harness/benchmark/run.py:394
            args.forceRescan = true;                                                 // src: harness/local_harness/benchmark/run.py:402
            args.forceRejudge = true;                                                // src: harness/local_harness/benchmark/run.py:403
        }
        if (args.skipStable && args.findings == null) {                              // src: harness/local_harness/benchmark/run.py:408
            Set<String> stable = FindingHistory.getStableFindings(θ);                // src: harness/local_harness/benchmark/run.py:409 (threshold=θ["harness.stable_threshold"])
            for (Target t : targets.values()) {                                      // src: harness/local_harness/benchmark/run.py:411
                t.findings = t.findings.filter(f -> !stable.contains(f.finding_id)); // src: harness/local_harness/benchmark/run.py:412
                if (t.findings.isEmpty()) targets.remove(t.key);                     // src: harness/local_harness/benchmark/run.py:416
            }
            if (targets.isEmpty()) return;                                           // src: harness/local_harness/benchmark/run.py:419
        }
        State state = loadState(θ);                                                  // src: harness/local_harness/benchmark/run.py:429
        state.model = θ["harness.MODEL"];                                            // src: harness/local_harness/benchmark/run.py:430
        if (args.tallyOnly) { phaseTally(state, θ); return; }                        // src: harness/local_harness/benchmark/run.py:433
        if (!args.judgeOnly) {                                                       // src: harness/local_harness/benchmark/run.py:437
            phaseClone(targets, state, θ);                                           // src: harness/local_harness/benchmark/run.py:438
            phaseScan(targets, state, args.forceRescan, maxWorkers, execute, θ);     // src: harness/local_harness/benchmark/run.py:439
        }
        if (args.scanOnly) { saveState(state); return; }                             // src: harness/local_harness/benchmark/run.py:441
        phaseJudge(targets, state, args.forceRejudge, θ);                            // src: harness/local_harness/benchmark/run.py:446
        phaseTally(state, θ);                                                        // src: harness/local_harness/benchmark/run.py:447
        FindingHistory.updateHistory(state, targets);                                // src: harness/local_harness/benchmark/run.py:450
    }
}
