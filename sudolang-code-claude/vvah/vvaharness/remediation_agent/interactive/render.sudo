// src: vvaharness/remediation_agent/interactive/render.py:51-82
fn parse_selection(text, findings):executor=code {
  t = lower case of trimmed text
  if (t in ["q", "quit", "exit", ""]) return null   // quit
  if (t == "all") return every position
  if (t == "pending") return positions of findings with done == false
  // tokens split on commas and whitespace; numbers are the REPORT ordinals (finding.index), not list positions
  for each token {
    if (token contains "-") add the positions of every ordinal in the inclusive range lo..hi that exists
    else add the position of that ordinal if it exists
    // a token that is not a number is ignored; a position is added once, in first-chosen order
  }
  return chosen
}
