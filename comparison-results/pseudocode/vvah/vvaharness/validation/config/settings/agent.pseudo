// file: vvaharness/validation/config/settings/agent.py
// Agent runtime knobs for S11: model selection, backend, execution limits (pydantic model, extra=forbid).

@executedBy(CODE) @role(config) @stage("S11")
class Agent {

    AgentConfig defaults(Theta θ) {
        AgentConfig a = new AgentConfig();
        a.binary = "claude";                                                                         // DEFAULT_CLAUDE_BINARY; env VVAHARNESS_CLAUDE_BINARY  // src: vvaharness/validation/config/settings/agent.py:40
        a.model = θ["models.validate.orchestrator.id"];                                              // fallback DEFAULT_MODEL  // src: vvaharness/validation/config/settings/agent.py:41
        a.maxTurns = θ["step_validate.max_turns"];                                                   // src: vvaharness/validation/config/settings/agent.py:42
        a.maxBudgetUsd = θ["step_validate.max_budget_usd"];                                          // src: vvaharness/validation/config/settings/agent.py:43
        a.effort = θ["step_validate.effort"];                                                        // src: vvaharness/validation/config/settings/agent.py:44
        a.timeout = θ["step_validate.timeout"];                                                      // whole-session wall clock, seconds  // src: vvaharness/validation/config/settings/agent.py:46
        a.maxModelCalls = θ["step_validate.max_model_calls"];                                        // per persona, deepagents only  // src: vvaharness/validation/config/settings/agent.py:48
        a.orchestratorMaxModelCalls = θ["step_validate.orchestrator_max_model_calls"];               // deepagents only  // src: vvaharness/validation/config/settings/agent.py:50
        a.via = θ["models.validate.orchestrator.via"];                                               // src: vvaharness/validation/config/settings/agent.py:51
        a.provider = θ["models.validate.orchestrator.provider"];                                     // None -> infer  // src: vvaharness/validation/config/settings/agent.py:52
        a.useResponsesApi = null;                                                                    // None resolves learned, then Responses  // src: vvaharness/validation/config/settings/agent.py:54
        a.securityArchitectModel = θ["models.validate.security_architect.id"];                       // None -> inherit model  // src: vvaharness/validation/config/settings/agent.py:56
        a.penetrationTesterModel = θ["models.validate.penetration_tester.id"];                       // src: vvaharness/validation/config/settings/agent.py:57
        a.crossRepoAnalyzerModel = θ["models.validate.cross_repo_analyzer.id"];                      // src: vvaharness/validation/config/settings/agent.py:58
        a.validateTools = θ["step_validate.allowed_tools"];                                          // None -> persona .md default  // src: vvaharness/validation/config/settings/agent.py:60
        a.cacheMarkers = θ["sdk.cache_markers"];                                                     // src: vvaharness/validation/config/settings/agent.py:62
        return a;
    }
}

@executedBy(CODE) @role(types)
record AgentConfig(String binary, String model, int maxTurns, Double maxBudgetUsd, EffortLevel effort, int timeout,
                   int maxModelCalls, int orchestratorMaxModelCalls, String via, String provider, Boolean useResponsesApi,
                   String securityArchitectModel, String penetrationTesterModel, String crossRepoAnalyzerModel,
                   List<String> validateTools, boolean cacheMarkers) { }
