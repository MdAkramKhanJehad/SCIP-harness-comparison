// file: vvaharness/cli/_commands.py
// The non-scan subcommand handlers: doctor (readiness + live probe), estimate (offline scope preview),
// gc (state DB pruning), validate (S11), remediate (S10 from a prior scan), ev-replay.

@executedBy(CODE) @role(pipeline)
class Commands {

    Map<String, String> ICON = Map.of("ok", "v", "warn", "!", "fail", "x");                           // src: vvaharness/cli/_commands.py:33

    /** Read-only diagnostic: static checks, live backend probe, opt-in --cache-probe (spends tokens). */
    int doctor(List<String> rest, Theta θ) {
        if (rest.contains("--help") || rest.contains("-h")) { Console.write("usage: vvaharness doctor ..."); return 0; } // help must not run the probe // src: vvaharness/cli/_commands.py:38
        String cfgPath = Paths.configPathFrom(rest);                                                   // src: vvaharness/cli/_commands.py:55
        if (!Files.exists(cfgPath)) { Console.write("doctor: config not found"); return 2; }           // src: vvaharness/cli/_commands.py:56
        Config cfg = Paths.loadAndConfigure(cfgPath, "doctor", θ);                                     // src: vvaharness/cli/_commands.py:59
        if (cfg == null) return 2;                                                                     // src: vvaharness/cli/_commands.py:60
        List<Check> checks = Environment.runChecks(Path.of(cfgPath), θ);                               // src: vvaharness/cli/_commands.py:63
        Triple<Integer, Integer, Integer> s = Environment.summarize(checks);                           // src: vvaharness/cli/_commands.py:66
        if (s.third > 0) { Console.write("[probe] skipped - fix the blocking item(s) above first"); return 1; } // src: vvaharness/cli/_commands.py:70
        int rc = OrchestratorPreflight.probeBackends(cfg, Set.of(), θ) ? 0 : 1;                        // src: vvaharness/cli/_commands.py:73
        // a TLS/CA warning is reconciled when the live probe succeeded                                // src: vvaharness/cli/_commands.py:75
        if (rest.contains("--cache-probe")) {                                                          // src: vvaharness/cli/_commands.py:80
            if (rc != 0) { Console.write("[cache-probe] skipped"); return rc; }                        // src: vvaharness/cli/_commands.py:81
            rc = runCacheProbe(cfg) ? 0 : 1;                                                           // preflight.run_cache_probe // src: vvaharness/cli/_commands.py:86
        }
        return rc;
    }

    /** Offline S1 scope preview and a heuristic S1-S9 token range; no model calls. */
    int estimate(List<String> rest, Theta θ) {
        if (rest.contains("--help") || rest.contains("-h")) return 0;                                  // src: vvaharness/cli/_commands.py:96
        String repo = Paths.repoFrom(rest);                                                            // src: vvaharness/cli/_commands.py:100
        if (repo == null) { Console.write("usage: vvaharness estimate --repo <path>"); return 2; }     // src: vvaharness/cli/_commands.py:101
        boolean directory;
        try { directory = Path.of(repo).isDir(); }                                                     // src: vvaharness/cli/_commands.py:106
        catch (FileNotFoundError e) { return e.winerror == 206 ? 2 : 1; }                              // path too long -> 2 // src: vvaharness/cli/_commands.py:107
        catch (OSError e) { return 2; }                                                                // src: vvaharness/cli/_commands.py:113
        if (!directory) return 1;                                                                      // src: vvaharness/cli/_commands.py:116
        Pair<String, Boolean> cp = Paths.configPathFromExplicit(rest);                                 // src: vvaharness/cli/_commands.py:119
        List<String> inventory;
        try {
            String cfgPath = ConfigPaths.trustedConfig(cp.first, Path.of(repo), cp.second, false, θ); // src: vvaharness/cli/_commands.py:121
            Config cfg = Config.load(cfgPath, false);                                                  // src: vvaharness/cli/_commands.py:122
            inventory = Scope.walkRepo(repo, cfg, θ).first;                                            // src: vvaharness/cli/_commands.py:123
        } catch (Exception e) { Console.write("estimate: error"); return 2; }                          // src: vvaharness/cli/_commands.py:124
        long bytes = inventory.sum(r -> Path.of(repo, r).size());                                      // unreadable files skipped // src: vvaharness/cli/_commands.py:128
        long approxTokens = bytes / 4;                                                                 // display heuristic only // src: vvaharness/cli/_commands.py:134
        long lower = 250000 + 5 * approxTokens; long upper = 1000000 + 20 * approxTokens;              // printed range, not a cap // src: vvaharness/cli/_commands.py:139
        Console.write("S1-S9 input budget: " + lower + "-" + upper + " tokens (heuristic)");            // src: vvaharness/cli/_commands.py:141
        return 0;                                                                                      // src: vvaharness/cli/_commands.py:148
    }

    /** gc: prune old runs from the state DB (security-scan reports untouched), or evict one repo's run. */
    int gc(List<String> rest, Theta θ) {
        Args a = ArgParser.parse(rest, "--keep-runs", θ["code.orchestrator.checkpoints.prune_keep_runs"], "--max-age-days", θ["code.orchestrator.checkpoints.prune_max_age_days"], "--run", "--dry-run"); // defaults 100 / 5 // src: vvaharness/cli/_commands.py:156
        if (a.run != null) {                                                                           // src: vvaharness/cli/_commands.py:168
            String rid = Checkpoints.runIdFor(Path.of(a.run));                                         // src: vvaharness/cli/_commands.py:169
            try {
                if (a.dryRun) { Store.runExists(rid); return 0; }                                      // src: vvaharness/cli/_commands.py:170
                Store.deleteRun(rid);                                                                  // src: vvaharness/cli/_commands.py:182
            } catch (StoreError e) { Log.error("STORE_UNUSABLE"); return 2; }                         // src: vvaharness/cli/_commands.py:183
            return 0;                                                                                  // src: vvaharness/cli/_commands.py:188
        }
        Map r;
        try { r = Checkpoints.pruneCheckpoints(a.keepRuns, a.maxAgeDays, a.dryRun, θ); }              // src: vvaharness/cli/_commands.py:191
        catch (StoreError e) { Log.error("STORE_UNUSABLE"); return 2; }                               // src: vvaharness/cli/_commands.py:194
        Console.write("kept " + r.get("kept") + " run(s), deleted " + r.get("deleted").size());       // src: vvaharness/cli/_commands.py:202
        return 0;                                                                                      // src: vvaharness/cli/_commands.py:206
    }

    /** validate / s11: the S11 agentic validation CLI. */
    int validate(List<String> rest, Theta θ) {
        return ValidationCliEntry.main(rest, θ);                                                                      // validation.cli.main // src: vvaharness/cli/_commands.py:211
    }

    /** Standalone S10 remediation from a prior scan, using models.remediate. */
    int remediate(List<String> rest, Theta θ) {
        String repo = Paths.repoFrom(rest);                                                            // src: vvaharness/cli/_commands.py:218
        if (repo == null) { Console.write("usage: vvaharness remediate --repo <path>"); return 2; }    // src: vvaharness/cli/_commands.py:219
        Pair<String, Boolean> cp = Paths.configPathFromExplicit(rest);                                 // src: vvaharness/cli/_commands.py:222
        String cfgPath;
        try { cfgPath = ConfigPaths.trustedConfig(cp.first, Path.of(repo), cp.second, false, θ); }    // src: vvaharness/cli/_commands.py:224
        catch (ConfigPolicyError e) { return 2; }                                                      // src: vvaharness/cli/_commands.py:225
        if (!Files.exists(cfgPath)) return 2;                                                          // src: vvaharness/cli/_commands.py:228
        Config cfg = Paths.loadAndConfigure(cfgPath, "remediate", θ);                                  // src: vvaharness/cli/_commands.py:231
        if (cfg == null) return 2;                                                                     // src: vvaharness/cli/_commands.py:232
        return RemediationAgent.remediate(repo, rest, cfg, θ);                                         // src: vvaharness/cli/_commands.py:234
    }

    /** Re-check exploit-verified findings against a redeployed target (EV: out of scope). */
    int evReplay(List<String> rest, Theta θ) {
        String repo = Paths.repoFrom(rest);                                                            // src: vvaharness/cli/_commands.py:241
        if (repo == null) return 2;                                                                    // src: vvaharness/cli/_commands.py:242
        Pair<String, Boolean> cp = Paths.configPathFromExplicit(rest);                                 // src: vvaharness/cli/_commands.py:245
        String cfgPath;
        try { cfgPath = ConfigPaths.trustedConfig(cp.first, Path.of(repo), cp.second, false, θ); }    // src: vvaharness/cli/_commands.py:247
        catch (ConfigPolicyError e) { return 2; }                                                      // src: vvaharness/cli/_commands.py:248
        Config cfg = Paths.loadAndConfigure(cfgPath, "ev-replay", θ);                                  // src: vvaharness/cli/_commands.py:251
        if (cfg == null) return 2;                                                                     // src: vvaharness/cli/_commands.py:252
        return Run.replayRun(repo, rest, cfg);                                                         // exploit_verification.replay.run // src: vvaharness/cli/_commands.py:254
    }
}
