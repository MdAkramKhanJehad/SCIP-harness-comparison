// file: vulnhunter-agent/agent/templates/issue_body.md
// GitHub issue body for one finding, filled by IssuesRender.renderBody. Humans read it, and the
// footer HTML-comment markers are parsed later by /vulnhunter-fix and verify mode (issue intake).

@executedBy(CODE) @role(io) @stage("issues")
class IssueBody {

    String run(Map<String, String> fields) {
        StringBuilder b = new StringBuilder();
        b.append("Security Finding: " + fields.get("CWE") + " — " + fields.get("TITLE"));       // src: vulnhunter-agent/agent/templates/issue_body.md:1
        b.append(findingTable(fields));
        b.append(attacker(fields));
        b.append(status());
        b.append(proposedFix(fields));
        b.append(priority(fields));
        b.append(footer(fields));
        b.append(markers(fields));
        return b.toString();
    }

    // "### Finding": CWE (id: name), Severity, Location, Root Cause, Data Flow.
    String findingTable(Map<String, String> fields) {
        return table(List.of("CWE: CWE_NAME", "SEVERITY", "LOCATION", "ROOT_CAUSE", "DATA_FLOW"), fields); // src: vulnhunter-agent/agent/templates/issue_body.md:5
    }

    // "### What an Attacker Can Do": exploit description and Impact line.
    String attacker(Map<String, String> fields) {
        return fields.get("EXPLOIT_DESCRIPTION") + "Impact: " + fields.get("EXPLOIT_IMPACT");     // src: vulnhunter-agent/agent/templates/issue_body.md:15
    }

    // "### Status": detected only, no automated fix attempted; points the reader at /vulnhunter-fix.
    String status() {
        return "Detected by VulnHunter scan. No automated fix has been attempted by this stage. Review the proposed fix in the full report and remediate — you can use /vulnhunter-fix"; // src: vulnhunter-agent/agent/templates/issue_body.md:21
    }

    // "### Proposed Fix": strategy only; the diff and tests stay in the full report.
    String proposedFix(Map<String, String> fields) {
        return "Strategy: " + fields.get("FIX_STRATEGY") + " (See the full report for the proposed diff and any associated security tests.)"; // src: vulnhunter-agent/agent/templates/issue_body.md:25
    }

    String priority(Map<String, String> fields) {
        return fields.get("SEVERITY") + " — " + fields.get("SEVERITY_RATIONALE");                 // src: vulnhunter-agent/agent/templates/issue_body.md:31
    }

    String footer(Map<String, String> fields) {
        return "VulnHunter scan: " + fields.get("SCAN_DATE") + " Full report: " + fields.get("REPORT_URL") // src: vulnhunter-agent/agent/templates/issue_body.md:35
             + " > " + fields.get("REPORT_ACCESS_MESSAGE");                                       // src: vulnhunter-agent/agent/templates/issue_body.md:38
    }

    // Machine-readable markers: vulnfix-key (cross-scan idempotency), vulnhunt-finding-id, vulnhunt-results-dir.
    String markers(Map<String, String> fields) {
        List<String> names = θ["code.agent.templates.issue_body.footer_markers"];                 // src: vulnhunter-agent/agent/templates/issue_body.md:40
        return "vulnfix-key: " + fields.get("IDEMPOTENCY_KEY")                                     // src: vulnhunter-agent/agent/templates/issue_body.md:40
             + " vulnhunt-finding-id: " + fields.get("VULN_ID")                                    // src: vulnhunter-agent/agent/templates/issue_body.md:41
             + " vulnhunt-results-dir: " + fields.get("RESULTS_DIR_NAME");                         // src: vulnhunter-agent/agent/templates/issue_body.md:42
    }
}
