// file: vulnhunter-fix/scripts/check-scope.py
// Gate 3, scope (REQ-GAT-004): every file in the branch's merge-base diff must be in files_modified or be the
// declared test file. Zero exceptions.

@executedBy(CODE) @role(evaluation) @stage("fix")
class CheckScope {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/check-scope.py:83
        return check(args, θ);                                                                            // src: vulnhunter-fix/scripts/check-scope.py:91
    }

    boolean looksLikeRef(String value) {
        // rejects flag-like or range-like values before they reach git argv
        return !value.isEmpty() && !value.startsWith("-") && !value.split("..", 1).get(0).contains(".."); // src: vulnhunter-fix/scripts/check-scope.py:25
    }

    int check(Args args, Theta θ) {
        String baseRef = args.baseRef != null ? args.baseRef : θ["code.fix.scripts.check_scope.default_base_ref"]; // src: vulnhunter-fix/scripts/check-scope.py:29
        // empty files_modified is itself a failure: plan/verify bug or fabricated result
        if (args.filesModified.isEmpty()) return 1;                                                       // src: vulnhunter-fix/scripts/check-scope.py:30
        if (!looksLikeRef(args.branch)) return 2;                                                         // src: vulnhunter-fix/scripts/check-scope.py:39
        if (!looksLikeRef(baseRef)) return 2;                                                             // src: vulnhunter-fix/scripts/check-scope.py:42
        String git = Shutil.which("git");
        if (git == null) return 2;                                                                        // src: vulnhunter-fix/scripts/check-scope.py:46
        Proc result;
        try {
            // three-dot diff against the merge-base so base-branch drift is not counted
            result = Subprocess.runChecked(List.of(git, "-C", args.repoRoot, "diff", "--name-only", baseRef + "..." + args.branch, "--"), θ["code.fix.scripts.check_scope.git_timeout_s"]); // src: vulnhunter-fix/scripts/check-scope.py:55
        } catch (CalledProcessError | FileNotFoundError | TimeoutExpired e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/check-scope.py:62
        }
        Set<String> diffFiles = result.stdout.nonEmptyLines().toSet();                                    // src: vulnhunter-fix/scripts/check-scope.py:64
        Set<String> allowed = Set.copyOf(args.filesModified);                                             // src: vulnhunter-fix/scripts/check-scope.py:65
        if (args.testFile != null) allowed.add(args.testFile);                                            // src: vulnhunter-fix/scripts/check-scope.py:67
        Set<String> unexpected = diffFiles.minus(allowed);                                                // src: vulnhunter-fix/scripts/check-scope.py:69
        if (!unexpected.isEmpty()) {
            for (String f : unexpected.sorted()) Stderr.print("scope violation: " + f);                   // src: vulnhunter-fix/scripts/check-scope.py:72
            return 1;                                                                                     // src: vulnhunter-fix/scripts/check-scope.py:78
        }
        return 0;
    }
}
