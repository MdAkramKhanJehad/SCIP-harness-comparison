# vvaharness/orchestrator/entry.py

The `vvaharness scan` command. It parses the command line, applies the configuration trust gate, resolves the Stage 1 overlay source, runs the offline exploit verification collection gate and the backend preflight, and then hands either one repository to `scan_repo` or a manifest to `run_batch`. It maps the exceptions that escape a scan to exit codes.

Source: `vvaharness/orchestrator/entry.py` (lines 1-405)
Executor: code
Called from: `vvaharness/cli/_commands.py` (`scan` subcommand), `vvaharness/api.py` (`build_parser` for defaults)

// src: vvaharness/orchestrator/entry.py:140-223
ScanArgs {
  repo: Path | null              // --repo; exactly one of --repo / --repo-file is required (mutually exclusive group)
  repo_file: Path | null         // --repo-file: .txt "application_id,repository_name,path" per line, or .csv with AppID,RepoName[,Path]
  config: Path | null = null     // --config; else auto-detected ./config.yaml or the packaged default
  repo_name: String | null       // --repo-name (single-repository mode only)
  application_id: String | null  // --application-id: drives the configuration-management database lookup and SARIF applicationId
  workspace: Path = "./batch-workspace"
  keep_clones: Boolean = false
  group_by_app: Boolean = false  // one scan per AppID over {workspace}/{app_id}/
  resume: Boolean = false
  stop_after: "clone" | "ev" | "s0" | "s1" | "s2" | "s3" | "s4" | "s5" | "s6" | "s7" | "s8" | "s9" | "s10" | "s11" | null
  s6_progress_file: Boolean = false
  remediate: Boolean = false
  top: Number | "all" | null = null   // _top_arg: positive integer or "all" / "*", coerced by remediation_agent.select._coerce_top_value
  force: Boolean = false              // overrides the Stage 10 git SHA staleness refusal
  skip_preflight: Boolean = false     // skips the startup readiness probe; does not bypass authentication
  step1_config: Path | null           // explicit Stage 1 overlay; wins over auto-step1
  auto_step1: Boolean = false         // mutually exclusive with no_auto_step1
  no_auto_step1: Boolean = false
}

// src: vvaharness/orchestrator/entry.py:226-405
fn main(argv?):executor=code {
  args = build_parser().parse_args(argv)

  // src: entry.py:230-241 — single-repository target must be a directory
  if (!args.repo_file) {
    repo = Path(args.repo)
    require repo is a directory (stat succeeds and S_ISDIR) => { log REPO_NOT_A_DIRECTORY; return 2 }
    repo_name = _repo_name(repo, args.repo_name)
  }

  // src: entry.py:243-253 — configuration trust gate: a configuration inside the scan target is attacker-influenced
  config_explicit = args.config != null
  if (!config_explicit) args.config = config_paths._default_config()
  boundary = args.repo   // null for --repo-file, so no boundary check in batch mode
  try {
    args.config = config_paths.trusted_config(args.config, boundary, explicit=config_explicit)
    cfg = config.load(args.config)
  }
  catch ConfigPolicyError => { log CONFIG_POLICY_REFUSED; return 2 }
  if (args.s6_progress_file) cfg.step6_verify.progress_file = true
  cfg_dir = parent directory of resolved args.config
  cmdb._set_cmdb_path(cfg, cfg_dir)

  // src: entry.py:262-293 — Stage 1 overlay source precedence: --step1-config > --no-auto-step1 > --auto-step1 > step1.auto_exclude
  [args.auto_step1, auto_step1_src] = _resolve_auto_step1(args.auto_step1, cfg, disable=args.no_auto_step1)
  if (args.step1_config) {
    require !config.is_network_path(args.step1_config) => { log CONFIG_PATH_NOT_LOCAL; return 2 }
    try [cfg, s1_applied] = config.apply_step1_overlay(cfg, args.step1_config);
    catch (ConfigPolicyError | ValueError) => { log STEP1_OVERLAY_REFUSED; return 2 }
    require s1_applied => { log STEP1_OVERLAY_NOT_FOUND; return 2 }
    if (args.auto_step1) { console: "--step1-config given; ignoring $auto_step1_src"; args.auto_step1 = false }
  }

  // src: entry.py:295-299 — the configuration-management database is optional
  cmdb_file = cmdb._cmdb_path()
  if (!cmdb_file || cmdb_file is not a file) { warn CMDB_MISSING }   // no VulContextSeverity scoring; CVSS and OffensivePriority still run

  // src: entry.py:301-303
  note = _pricing_note(cfg); if (note) console: note

  preflight.configure_backends(cfg, cfg_dir)

  // src: entry.py:307-311 — exploit verification enabled: true / false is hard; a conflicting command line stops the run
  ev_err = exploit_verification.options.resolution_error(cfg, args)   // external: exploit verification package
  require !ev_err => { log EV_RESOLUTION_CONFLICT; return 2 }

  // src: entry.py:313-316 — offline collection gate before any model spend
  [rc, ev_collection_in] = _ev_gate(args, cfg)
  if (rc != null) return rc

  // src: entry.py:318-338 — backend readiness probe, skipped for --skip-preflight and for --stop-after clone / ev
  if (!args.skip_preflight && args.stop_after not in ["clone", "ev"]) {
    skip = if (!args.repo_file && exploit_verification.options.may_run(cfg, environment)) {} else config_paths.EV_MODEL_ROLES
    rem_on = args.remediate || knob("step_remediate.enabled", default=false)
    if (!(args.stop_after in [null, "s10", "s11"] && rem_on)) skip += "remediate"
    val_on = knob("step_validate.enabled", default=false)
    if (!(args.stop_after in [null, "s11"] && val_on)) skip += "validate"
    // a stage this run cannot reach must not demand a credential
    try { require preflight.check_backends(cfg, skip_roles=skip) => return 1 }
    catch KeyboardInterrupt => return 130
  }

  // src: entry.py:340-350 — batch mode
  if (args.repo_file) {
    require args.repo_file is a file => { log REPO_FILE_NOT_A_FILE; return 2 }
    try return batch.run_batch(args.repo_file, args, cfg);
    catch StoreError => return 2
    // preserved: ev_collection_in is not passed to run_batch; _ev_gate already returned no collection for --repo-file
  }

  // src: entry.py:352-405 — single repository; each exception maps to an exit code
  try outcome = scan.scan_repo(repo, repo_name, args.application_id, args, cfg, ev_collection_in=ev_collection_in);
  catch error => match (error) {
    case KeyboardInterrupt => return 130
    case AuthenticationError => { errlog.log("auth", repo_name, error, error_code="VVAH-E001"); console: "use `vvaharness doctor` ... add --resume to continue"; return 1 }   // not retryable in-process
    case ProxyError => { errlog.log("proxy", repo_name, error, error_code="VVAH-E002"); return 1 }   // configuration fault, no retry
    case EVUnreachableError => return 2
    case EVInputError => return 2
    case StoreError => return 2          // symlinked state directory or database: an operator fix
    case EmptyScopeError => { errlog.log("s1", repo_name, error, reason="empty_scope"); return 2 }   // refused before spend
    default => {
      console: "scan failed: <type>: <redacted message>"; errlog.log("scan", repo_name, error)
      if (environment VVAHARNESS_DEBUG is set) print traceback   // otherwise no traceback, so an agent is not tempted to "fix" the source
      return 1
    }
  }
  return outcome.exit_code   // remediation, validation or degraded code from scan_repo
}

// src: vvaharness/orchestrator/entry.py:72-100
fn _ev_gate(args, cfg):executor=code {
  // offline: no network, no model. Returns [exit_code_or_null, collection]
  path = exploit_verification.options.collection_path(environment)   // EV_API_COLLECTION; external
  if (!path) {
    require !(args.stop_after == "ev" && !args.resume) => { log "--stop-after ev requires EV_API_COLLECTION to be set (or --resume ...)"; return [2, null] }
    return [null, null]
  }
  require !config.is_network_path(path) => { log EV_COLLECTION_NOT_LOCAL; return [2, null] }
  if (args.repo_file) {
    warn "exploit verification is single-repo only; ignoring EV_API_COLLECTION for this batch (--repo-file) run."
    return [null, null]   // one EV_TARGET_URL cannot cover a batch
  }
  try result = exploit_verification.gate.run_gate(load_options(cfg, environment));   // external
  catch EVInputError => { console: "exploit verification: <redacted message>"; return [2, null] }
  return [null, result.collection]
}

// src: vvaharness/orchestrator/entry.py:103-113
fn _resolve_auto_step1(flag, cfg, disable=false):executor=code {
  if (disable) return [false, "--no-auto-step1"]
  if (flag) return [true, "--auto-step1"]
  if (knob("step1.auto_exclude", default=false)) return [true, "step1.auto_exclude"]
  return [false, null]
}

// src: vvaharness/orchestrator/entry.py:116-120
fn _repo_name(repo, explicit):executor=code {
  return if (explicit trimmed is non-empty) explicit trimmed else (resolved directory name || "repo")
}

// src: vvaharness/orchestrator/entry.py:123-137
fn _pricing_note(cfg):executor=code {
  file = knob("pricing.file", default=null)
  if (file == null) return null
  table = load_pricing_cached(file); if (table == null) return null   // the loader already warned
  missing = { resolve_model(m).model_id for each [_, m] in config_paths._iter_model_roles(cfg) } - table.models
  return if (missing) "[pricing] WARNING: no rates for <missing> in <path>; their cost reports as null" else null
}

