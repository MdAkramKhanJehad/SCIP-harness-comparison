// file: vvaharness/remediation_agent/artifacts/diff/paths.py
// Repo-relative path normalisation and repo confinement (CWE-22) shared by every diff artifact and by revert.

@executedBy(CODE) @role(rule_set) @stage("S10")
class DiffPaths {

    String normPath(String ref) {
        ref = (ref != null ? ref : "").strip();                                                     // src: vvaharness/remediation_agent/artifacts/diff/paths.py:31
        if (ref.isEmpty()) return "";                                                               // src: vvaharness/remediation_agent/artifacts/diff/paths.py:33
        // Strip only a trailing :<line> or :<start-end>; a drive-letter colon survives.
        return Regex.sub(":\\d+(-\\d+)?$", "", ref);                                                // src: vvaharness/remediation_agent/artifacts/diff/paths.py:35
    }

    Path safeRepoPath(String repo, String ref) {
        // Model-supplied refs: abs/../symlink escapes would read arbitrary files.
        String rel = normPath(ref);                                                                 // src: vvaharness/remediation_agent/artifacts/diff/paths.py:41
        if (rel.isEmpty() || Path.of(rel).isAbsolute()) return null;                                // src: vvaharness/remediation_agent/artifacts/diff/paths.py:42
        // UNC (//host, \\host) or drive (C:) prefix rejected on every OS: a POSIX runner would otherwise leak NetNTLMv2.
        if (θ["code.remediation_agent.artifacts.diff.paths.reject_unc_drive"] && Regex.match("^([\\\\/]2|[A-Za-z]:)", rel)) return null; // src: vvaharness/remediation_agent/artifacts/diff/paths.py:42
        try {
            Path target = Path.of(repo).join(rel).resolve();                                        // src: vvaharness/remediation_agent/artifacts/diff/paths.py:45
            target.relativeTo(Path.of(repo).resolve());                                             // src: vvaharness/remediation_agent/artifacts/diff/paths.py:46  (raises when it escapes)
            return target;                                                                          // src: vvaharness/remediation_agent/artifacts/diff/paths.py:49
        } catch (ValueError | OSError e) {
            return null;                                                                            // src: vvaharness/remediation_agent/artifacts/diff/paths.py:48
        }
    }
}
