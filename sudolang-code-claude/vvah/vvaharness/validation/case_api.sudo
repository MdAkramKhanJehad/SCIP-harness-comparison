# vvaharness/validation/case_api.py

Stage 11 (validation) for one in-memory finding and remediation, without a case file on disk. It refuses a case that cannot be staged, builds a one-attempt case, stages a temporary workspace with the remediation diff applied, runs the validation session, and returns the host-scored verdict.

Source: `vvaharness/validation/case_api.py` (lines 1-145)
Executor: code (the session it runs contains the model calls)
Called from: programmatic callers (the `vvaharness.sdk.validate` entry point named by ENGINE)

// src: vvaharness/validation/case_api.py:45-47
ENGINE = "vvaharness.sdk.validate"   // stamped on every verdict from this entry point

// src: vvaharness/validation/case_api.py:50-55
ValidationCaseError { }   // source: subclass of ValueError; "Raised when a finding and remediation cannot be validated as a case."
ValidationBusyError { }   // source: subclass of RuntimeError; "Raised when called from inside a running event loop, which ``asyncio.run`` forbids."

// src: vvaharness/validation/case_api.py:115-136
fn validate_case(finding, remediation, repo, config?, policy?):executor=code {
  refusal = _refusal(finding, remediation, repo)
  require refusal is empty => throw ValidationCaseError(refusal)
  require !_already_running() => throw ValidationBusyError("validate_case drives an asyncio pipeline and cannot be called from a running event loop; call it from a worker thread, or await the validation pipeline directly.")
  case = case_for(finding, remediation)
  resolved_policy = policy or, when absent, constants.scoring.FIX_POLICY
  resolved_config = config or, when absent, config.settings.load_config(project_root=repo)
  workspace_root = new temporary directory with prefix "vvah-validate-"
  constraint OnEveryExit { remove workspace_root recursively, ignoring errors }
  return _judge(case, repo, "$workspace_root/${ case.case_id }", resolved_config, resolved_policy)
  // "writes nothing to *repo*": the workspace is a copy outside the repository
}

// src: vvaharness/validation/case_api.py:64-72
fn _refusal(finding, remediation, repo):executor=code {
  // the first failed check, in this order, wins; empty string means the case can be validated
  if (repo is not a directory) return "repo is not a directory: $repo"
  if (!finding.file) return "the finding carries no file, so no workspace can be staged for it"
  if (!remediation.diff) return "the remediation carries no diff, so there is nothing to apply and judge"
  return ""
}

// src: vvaharness/validation/case_api.py:75-81
fn _already_running():executor=code = an asyncio event loop is running on this thread

// src: vvaharness/validation/case_api.py:58-61
fn case_for(finding, remediation):executor=code {
  target = RemediationTarget(finding, index=1)
  return remediation_agent.artifacts.report.build_report(target, remediation)   // external to this area: builds the FindingCase with one attempt
}

// src: vvaharness/validation/case_api.py:91-112
fn _judge(case, repo, workspace, config, policy):executor=code {
  started = now (UTC); spend_before = TOKENS.spend()
  session_id = new random hexadecimal id
  ingest.workspace.stage_workspace(repo, workspace, case.attempts[-1].remediation.diff)   // the latest attempt's diff
  plan = FixValidationPlan {
    case_id: case.case_id, session_id,
    manifest: ingest.manifest_builder.build_manifest(case, session_id),
    workspace_dir: workspace, output_dir: workspace,
    provenance: _provenance(started, spend_before), policy
  }
  outcome = execution.pipeline.execute_plan(plan, config, post_results=false, meta=RunMetadata(total_findings=1))   // run to completion with asyncio.run
  return io.case_writeback.build_verdict(case, workspace, provenance=_provenance(started, spend_before), policy, session_failed=outcome.session_failed)
  // preserved: the plan's provenance is computed before the session runs, so its ended time and spend cover only staging; the verdict's provenance is recomputed after the session
}

// src: vvaharness/validation/case_api.py:84-88
fn _provenance(started, spend_before):executor=code {
  [usd, turns] = reported_between(spend_before, TOKENS.spend())
  return Provenance { engine: ENGINE, started, ended: now (UTC), usd, turns }
}
