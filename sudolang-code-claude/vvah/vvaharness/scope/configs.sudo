# vvaharness/scope/configs.py

Stage 1 configuration-file deduplication. Configuration files with the same key shape (values ignored) are clustered; large clusters keep one representative per top-level directory plus every member whose secret or insecure-value hits are not already present in a representative. The rest are dropped from scope as near-duplicates.

Source: `vvaharness/scope/configs.py` (lines 1-271)
Executor: code
Called from: `vvaharness/pipeline/stages/s1_preprocess.py` run

// src: vvaharness/scope/configs.py:124-271
fn _dedup_configs(files, repo_root, cfg):executor=code {
  // src: configs.py:125-136
  dd = copy of scope.walk._DEDUP_DEFAULTS
  user = knob("step1.config_dedup", default=null)
  if (user != null) dd.update(entries of user whose value is not null)
  if (!dd.enabled) return [files, { enabled: false }]
  exts = lowercase(dd.exts); min_cluster = Integer(dd.min_cluster_size); max_bytes = Integer(dd.max_file_kb) * 1024

  // src: configs.py:138-148
  candidates = files whose lowercase suffix is in exts; passthrough = all others
  // preserved: the suffix of a dotfile named exactly ".env" is empty, so such a file is never a candidate despite ".env" being in the default list
  if (length(candidates) < min_cluster) return [files, { enabled: true, candidates: length(candidates), clusters: 0, dropped: 0, promoted: 0 }]
  want_sec = dd.promote_on_secret_hit; want_ins = dd.promote_on_insecure_value

  // src: configs.py:153-174 — pass 1: hash the key shape; bodies are discarded after hashing
  workers = Integer(dd.io_workers or 16)
  results = runConcurrently(candidates, workers=workers, rel => {
    if (stat fails) return [rel, 0, null]
    if (size > max_bytes) return [rel, size, null]
    return [rel, size, _shape_hash(file text, lowercase suffix)]
  }):order=input
  for each [rel, sz, h] in results { if (h == null) unclustered += rel else clusters[h] += (rel, sz) }
  keep = passthrough + unclustered   // unreadable, oversize and unparseable candidates stay in scope

  // src: configs.py:182-200 — re-read only members of large clusters for their suspicious-pattern set
  need_sus = members of clusters with size >= min_cluster
  sus_by_rel = runConcurrently(need_sus, workers=workers, rel => if (readable && size <= max_bytes) _suspicious_set(text, want_sec, want_ins) else null):order=input

  // src: configs.py:203-243 — pass 2
  for each (h, members) in clusters {
    if (length(members) < min_cluster) { keep += all members; continue }
    sort members by _rep_score
    reps = if (dd.keep_per_top_dir) first member per top-level directory else [members[0]]
    rep_sus = union of sus_by_rel[r] for r in reps
    keep += reps
    for each non-representative rel in members (in rep_score order) {
      if (rel not in sus_by_rel) { keep += rel; continue }   // body unreadable on re-read: cannot prove a pure duplicate
      extra = sus_by_rel[rel] - rep_sus
      if (extra) { keep += rel; promoted += (rel, _promotion_reason(first of sorted extra)); rep_sus = rep_sus union sus_by_rel[rel] }
      else { dropped += rel }
    }
  }
  // preserved: with both promote_on_secret_hit and promote_on_insecure_value false, every non-representative cluster member is dropped; s1_autoexclude refuses a model proposal to set either to false, but an operator setting is honored

  report = { enabled: true, candidates, unparseable_kept: length(unclustered), clusters, kept_reps, promoted, promoted_files: first 50, dropped, dropped_files, top_clusters: first 10 by size }
  return [sorted(keep), report]
  // abstracted: configs.py:259-270 console summary
}

// src: vvaharness/scope/configs.py:48-82
fn _shape_hash(text, ext):executor=code {
  keys = match (ext) {
    case ".yml" | ".yaml" => dotted key paths from indentation (comment lines skipped; list items "- key:" counted)
    case ".json" => _flatten_keys(json.loads(text))   // lists flatten as "key[]"
    case ".ini" | ".cfg" | ".conf" => "section.option" for each option (non-strict parser)
    default => key of each line matching "^\s*([A-Za-z0-9_.\-]+)\s*[:=]"
  }
  if (any parsing error || keys empty) return null   // null means unclustered, kept
  return sha1 of sorted unique keys joined by newlines
}

// src: vvaharness/scope/configs.py:85-94
fn _suspicious_set(text, want_secret, want_insecure):executor=code {
  out = {}
  if (want_secret) out += "secret:" + first 80 characters (whitespace collapsed) of each _SECRET_RX match
  if (want_insecure) out += "insecure:" + first 80 characters of each _INSECURE_RX match
  return out
}

// src: vvaharness/scope/configs.py:114-121
fn _rep_score(rel, size):executor=code {
  env = if ("/prod" in lowercase(rel)) 0 else if (any of "/cert", "/stag", "/stg") 1 else if (any of "/perf", "/qa") 2 else 3
  return [env, -size, rel]   // production-like paths first, then the largest, then by name
  // preserved: every marker needs a leading "/", so a top-level directory (for example "prod/app.yml") never matches and scores 3
}

