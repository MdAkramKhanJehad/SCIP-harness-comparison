  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Backend-neutral contexts supplied to trusted plugin capabilities.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom enum import StrEnum\nfrom pathlib import Path\nfrom typing import Protocol, runtime_checkable\n\nfrom context_graph_sdk.errors import ModelValidationError\nfrom context_graph_sdk.models import (\n    FrozenMap,\n    GraphSnapshot,\n    ProjectMetadata,\n    ProjectSnapshot,\n    SnapshotLocator,\n)\n\n\n@runtime_checkable\nclass SourceReader(Protocol):\n    def read_text(self, relative_path: str, max_bytes: int) -> str: ...\n\n\n@runtime_checkable\nclass CancellationState(Protocol):\n    @property\n    def is_cancelled(self) -> bool: ...\n\n\n@runtime_checkable\nclass AcceptedGraphReader(Protocol):\n    \"\"\"Bounded read access to accepted immutable project snapshots.\"\"\"\n\n    def query(\n        self,\n        locator: SnapshotLocator,\n        cypher: str,\n        parameters: FrozenMap,\n        row_limit: int,\n    ) -> tuple[FrozenMap, ...]: ...\n\n\nclass PluginLogLevel(StrEnum):\n    DEBUG = \"debug\"\n    INFO = \"info\"\n    WARNING = \"warning\"\n    ERROR = \"error\"\n\n\n@dataclass(frozen=True)\nclass PluginDiagnostic:\n    code: str\n    message: str\n    path: str | None = None\n    line: int | None = None\n\n    def __post_init__(self) -> None:\n        if not self.code or not self.message:\n            raise ModelValidationError(\"diagnostic code and message are required\")\n        if self.line is not None and self.line <= 0:\n            raise ModelValidationError(\"diagnostic line must be positive\")\n\n\n@runtime_checkable\nclass PluginReporter(Protocol):\n    def log(self, level: PluginLogLevel, message: str, details: FrozenMap) -> None: ...\n\n    def diagnostic(self, diagnostic: PluginDiagnostic) -> None: ...\n\n\n@dataclass(frozen=True)\nclass PluginContext:\n    project: ProjectMetadata\n    graph: GraphSnapshot\n    source_reader: SourceReader\n    reporter: PluginReporter\n    cancellation: CancellationState\n    configuration: FrozenMap\n    deadline_monotonic: float\n\n\n@dataclass(frozen=True)\nclass CorrelationContext:\n    candidate: GraphSnapshot\n    accepted: tuple[ProjectSnapshot, ...]\n    graph_reader: AcceptedGraphReader\n    reporter: PluginReporter\n    configuration: FrozenMap\n    cancellation: CancellationState\n    deadline_monotonic: float\n\n\n@dataclass(frozen=True)\nclass IndexContext:\n    snapshot: ProjectSnapshot\n    locator: SnapshotLocator\n    artifact_path: Path\n    graph_fingerprint: str\n    graph_reader: AcceptedGraphReader\n    source_reader: SourceReader\n    reporter: PluginReporter\n    configuration: FrozenMap\n    cancellation: CancellationState\n    deadline_monotonic: float\n",
