// file: vulnhunter-fix/prompts/worker_agent_config.md
// CWE-class worker prompt for IaC/IAM configuration findings; extends the common preamble but replaces the Python TDD
// cycle with static-analysis-tool discrimination, no verify_ scaffold, and a tool-run regression check.

@executedBy(MODEL) @role(prompt) @stage("fix.implement.worker")
class WorkerAgentConfig {

    WorkerResult run(Manifest manifest, Theta θ) {
        // extends worker_agent_common.md with two divergences (no Python TDD, no verify_ scaffold)
        return WorkerAgentCommon.run(manifest, prompt(θ), θ);                                       // src: vulnhunter-fix/prompts/worker_agent_config.md:3
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(divergences(θ));
        p.include(canonicalFix(θ));
        p.include(discrimination(θ));
        p.include(fullTierBar(θ));
        p.include(antiPatterns(θ));
        p.include(testPolicyOverride(θ));
        p.format(θ["p.worker_agent_config.residual_template"]);                                     // src: vulnhunter-fix/prompts/worker_agent_config.md:77
        return p;
    }

    Prompt divergences(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.worker_agent_config.no_python_tdd"]);                                           // src: vulnhunter-fix/prompts/worker_agent_config.md:5
        p.forbid(θ["p.worker_agent_config.no_verify_scaffold"]);                                    // src: vulnhunter-fix/prompts/worker_agent_config.md:9
        return p;
    }

    Prompt canonicalFix(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.worker_agent_config.fix_modify_declarative_artifact"]);                      // src: vulnhunter-fix/prompts/worker_agent_config.md:16
        p.step(2, θ["p.worker_agent_config.fix_least_privilege"]);                                  // src: vulnhunter-fix/prompts/worker_agent_config.md:17
        p.step(3, θ["p.worker_agent_config.fix_enable_standard_control"]);                          // src: vulnhunter-fix/prompts/worker_agent_config.md:19
        return p;
    }

    Prompt discrimination(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.worker_agent_config.discrimination_tool_pre_post"]);                            // src: vulnhunter-fix/prompts/worker_agent_config.md:24
        p.format(θ["p.worker_agent_config.discrimination_method"]);                                 // src: vulnhunter-fix/prompts/worker_agent_config.md:33
        p.choose(θ["p.worker_agent_config.discrimination_tool_values"]);                            // src: vulnhunter-fix/prompts/worker_agent_config.md:34
        return p;
    }

    Prompt fullTierBar(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.worker_agent_config.full_artifact_modified"]);                             // src: vulnhunter-fix/prompts/worker_agent_config.md:45
        p.checklist(θ["p.worker_agent_config.full_no_wildcard"]);                                   // src: vulnhunter-fix/prompts/worker_agent_config.md:47
        p.checklist(θ["p.worker_agent_config.full_no_drift_corrector"]);                            // src: vulnhunter-fix/prompts/worker_agent_config.md:48
        p.checklist(θ["p.worker_agent_config.full_tool_clean"]);                                    // src: vulnhunter-fix/prompts/worker_agent_config.md:49
        return p;
    }

    Prompt antiPatterns(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.worker_agent_config.anti_drift_corrector"]);                                    // src: vulnhunter-fix/prompts/worker_agent_config.md:53
        p.rule(θ["p.worker_agent_config.anti_earlier_permissive_statement"]);                       // src: vulnhunter-fix/prompts/worker_agent_config.md:55
        p.rule(θ["p.worker_agent_config.anti_narrowed_wildcard"]);                                  // src: vulnhunter-fix/prompts/worker_agent_config.md:57
        p.rule(θ["p.worker_agent_config.anti_non_atomic_apply"]);                                   // src: vulnhunter-fix/prompts/worker_agent_config.md:59
        return p;
    }

    Prompt testPolicyOverride(Theta θ) {
        Prompt p = new Prompt();
        p.exemption(θ["p.worker_agent_config.test_policy_ignored"]);                                // src: vulnhunter-fix/prompts/worker_agent_config.md:64
        p.rule(θ["p.worker_agent_config.regression_is_tool_run"]);                                  // src: vulnhunter-fix/prompts/worker_agent_config.md:68
        p.rule(θ["p.worker_agent_config.nonzero_exit_regressions"]);                                // src: vulnhunter-fix/prompts/worker_agent_config.md:71
        return p;
    }

    void applyCanonicalFix(Finding f, Theta θ) {
        // declarative artifact (Terraform, CloudFormation, k8s manifest, Helm values), never a runtime workaround
        if (θ["p.worker_agent_config.fix_modify_declarative_artifact"]) editDeclarativeArtifact(f); // src: vulnhunter-fix/prompts/worker_agent_config.md:16
        if (θ["p.worker_agent_config.fix_least_privilege"]) denyPublicWildcardAllowRequiredPrincipals(f); // src: vulnhunter-fix/prompts/worker_agent_config.md:17
        for (String control : θ["p.worker_agent_config.fix_enable_standard_control"]) if (relevant(f, control)) enable(control); // src: vulnhunter-fix/prompts/worker_agent_config.md:19
    }

    Discrimination discriminate(Finding f, Theta θ) {
        // replaces Steps C/D/E: no pytest file, no verify_ scaffold
        String tool = chooseOne(θ["p.worker_agent_config.no_python_tdd"], f);                       // src: vulnhunter-fix/prompts/worker_agent_config.md:5
        if (θ["p.worker_agent_config.no_verify_scaffold"]) assert !exists("verify_*");              // src: vulnhunter-fix/prompts/worker_agent_config.md:9
        Discrimination d = new Discrimination();
        if (θ["p.worker_agent_config.discrimination_tool_pre_post"]) {                              // src: vulnhunter-fix/prompts/worker_agent_config.md:24
            d.preFix = runTool(tool, "before").reports(f.ruleId, f.severity) ? "fail" : "pass";
            d.postFix = runTool(tool, "after").reports(f.ruleId) ? "fail" : "pass";                // src: vulnhunter-fix/prompts/worker_agent_config.md:26
        }
        d.method = θ["p.worker_agent_config.discrimination_method"];                                // src: vulnhunter-fix/prompts/worker_agent_config.md:33
        d.tool = tool;
        assert θ["p.worker_agent_config.discrimination_tool_values"].contains(d.tool);              // src: vulnhunter-fix/prompts/worker_agent_config.md:34
        d.assertionTarget = "<file>:<line> — <tool_rule_id> no longer triggers";                    // src: vulnhunter-fix/prompts/worker_agent_config.md:37
        write(".work/<repo>/discrimination/<vuln>.json", d);                                        // src: vulnhunter-fix/prompts/worker_agent_config.md:28
        return d;
    }

    String regressionCheck(List<String> changedFiles, Theta θ) {
        // manifest test_policy is ignored for config findings
        if (θ["p.worker_agent_config.test_policy_ignored"]) {                                       // src: vulnhunter-fix/prompts/worker_agent_config.md:64
            int exit = bash(θ["p.worker_agent_config.regression_is_tool_run"] + " <changed-tf-file>").exit; // src: vulnhunter-fix/prompts/worker_agent_config.md:68
            if (exit != 0) return θ["p.worker_agent_config.nonzero_exit_regressions"];              // src: vulnhunter-fix/prompts/worker_agent_config.md:71
            return "NO_REGRESSIONS";
        }
        return null;
    }

    String tier(Diff diff, Theta θ) {
        if (diff.nonAtomicApply()) return θ["p.worker_agent_config.anti_non_atomic_apply"];         // src: vulnhunter-fix/prompts/worker_agent_config.md:59
        boolean full = (θ["p.worker_agent_config.full_artifact_modified"] && diff.modifiesDeclarativeArtifact()) // src: vulnhunter-fix/prompts/worker_agent_config.md:45
            && (θ["p.worker_agent_config.full_no_wildcard"] && !diff.wildcardSurvives())            // src: vulnhunter-fix/prompts/worker_agent_config.md:47
            && (θ["p.worker_agent_config.full_no_drift_corrector"] && !diff.hasDriftCorrector())    // src: vulnhunter-fix/prompts/worker_agent_config.md:48
            && (θ["p.worker_agent_config.full_tool_clean"] && toolCleanOnChangedFiles());            // src: vulnhunter-fix/prompts/worker_agent_config.md:49
        String t = full ? "FULL" : "MITIGATION";   // unclear: prompt does not name the tier when a FULL condition fails
        if (diff.hasDriftCorrector()) t = θ["p.worker_agent_config.anti_drift_corrector"];          // src: vulnhunter-fix/prompts/worker_agent_config.md:53
        if (diff.earlierPermissiveStatementRemains()) t = θ["p.worker_agent_config.anti_earlier_permissive_statement"]; // src: vulnhunter-fix/prompts/worker_agent_config.md:55
        if (diff.wildcardOnlyNarrowed()) t = θ["p.worker_agent_config.anti_narrowed_wildcard"];     // src: vulnhunter-fix/prompts/worker_agent_config.md:57
        return t;
    }

    List<String> residuals(String tier, Theta θ) {
        if (tier == "FULL") return List.of();
        return List.of(θ["p.worker_agent_config.residual_template"].with("<artifact>", "<specific permissive path>")); // src: vulnhunter-fix/prompts/worker_agent_config.md:77
    }
}
