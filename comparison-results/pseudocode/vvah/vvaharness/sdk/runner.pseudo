// file: vvaharness/sdk/runner.py
// Running a scan from Python through the same entry point and trust gate as the CLI.

@executedBy(CODE) @role(types)
class ScanOptionsError {
    // ValueError subclass raised when options cannot become a valid command line.
}

@executedBy(CODE) @role(types)
record ScanOptions(Path repo, String profile, String stopAfter, boolean resume, String applicationId, String repoName, List<String> extraArgv) {
    // Everything but repo is optional; omitted fields keep the CLI default for that flag.

    // This scan as a vvaharness scan argument list.
    List<String> argv() {
        List<String> argv = new ArrayList(List.of("--repo", String.valueOf(repo)));                  // src: vvaharness/sdk/runner.py:52
        if (profile != null) argv.addAll(List.of("--config", String.valueOf(SdkRunner.profilePath(profile)))); // src: vvaharness/sdk/runner.py:54
        for (Tuple fv : List.of(Tuple.of("--stop-after", stopAfter), Tuple.of("--application-id", applicationId), Tuple.of("--repo-name", repoName))) { // src: vvaharness/sdk/runner.py:56
            if (fv.value != null && !fv.value.isEmpty()) argv.addAll(List.of(fv.flag, fv.value));    // falsy values (None or empty) omit the flag // src: vvaharness/sdk/runner.py:59
        }
        List<String> resumeFlag = resume ? List.of("--resume") : List.of();                          // src: vvaharness/sdk/runner.py:61
        return argv.concat(resumeFlag).concat(extraArgv);                                            // extra_argv last // src: vvaharness/sdk/runner.py:63
    }
}

@executedBy(CODE) @role(types)
record ScanResult(int exitCode, List<String> argv) {
    boolean ok() {
        return exitCode == 0;                                                                        // src: vvaharness/sdk/runner.py:74
    }
}

@executedBy(CODE) @role(pipeline)
class SdkRunner {

    // A shipped profile resolved by bare name, or an explicit path used as given.
    Path profilePath(String profile) {
        Path candidate = Path.of(profile);                                                           // src: vvaharness/sdk/runner.py:28
        if (!candidate.suffix().isEmpty() || !candidate.parent().equals(Path.of(""))) return candidate; // has an extension or a directory part: used as given // src: vvaharness/sdk/runner.py:31
        Path shipped = PROFILE_DIR.join(profile + ".yaml");                                          // PROFILE_DIR is config/profiles beside the package // src: vvaharness/sdk/runner.py:34
        if (!shipped.isFile()) throw new ScanOptionsError("no shipped profile; available: sorted stems of PROFILE_DIR yaml files"); // src: vvaharness/sdk/runner.py:37
        return shipped;
    }

    ScanResult scan(ScanOptions options, Theta θ) {
        List<String> argv = options.argv();                                                          // src: vvaharness/sdk/runner.py:79
        rejectUnknownFlags(argv, θ);                                                                 // fails before any work // src: vvaharness/sdk/runner.py:81
        return new ScanResult(OrchestratorEntry.main(argv, θ), argv);                                // same entry point and trust gate as the CLI // src: vvaharness/sdk/runner.py:84
    }

    void rejectUnknownFlags(List<String> argv, Theta θ) {
        try {
            OrchestratorEntry.buildParser(argv, θ);                                                  // parse_args only; argparse exits on an unknown flag // src: vvaharness/sdk/runner.py:87
        } catch (SystemExit exc) {
            throw new ScanOptionsError("invalid scan options");                                      // src: vvaharness/sdk/runner.py:93
        }
    }
}
