    Map extractVerdictFromHistory(HarnessResult terminal, StreamingOptions options, Theta θ) {
        // Ask the same model to emit its verdict as raw JSON from its own work log (one plain model call, no tools, over the terminal message history).
        List<Message> messages = terminal.state != null ? terminal.state.getOr("messages", List.of()) : List.of(); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:206
        if (messages.isEmpty()) return null;                                                        // src: vvaharness/remediation_agent/plugin_runner/__init__.py:207
        ChatModel model = ModelBuilding.buildModelCached(options.model, options.env, options.modelProvider, null, θ); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:209
        try {
            Response response = model.invoke(messages.plus(HumanMessage.of(verdictExtractionPrompt()))); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:216
            Object data = JsonExtract.extractJson(response.content != null ? response.content : "", θ); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:217
            if (data instanceof Map) return data;                                                   // src: vvaharness/remediation_agent/plugin_runner/__init__.py:218
            debugLog("EXTRACTION_NOT_A_DICT", String.valueOf(data));                                // src: vvaharness/remediation_agent/plugin_runner/__init__.py:220
            return null;                                                                            // src: vvaharness/remediation_agent/plugin_runner/__init__.py:221
        } catch (Exception exc) {
            debugLog("EXTRACTION_FAILED", String.valueOf(exc));                                     // src: vvaharness/remediation_agent/plugin_runner/__init__.py:223
            return null;                                                                            // src: vvaharness/remediation_agent/plugin_runner/__init__.py:224  (any failure means no extraction)
        }
    }

