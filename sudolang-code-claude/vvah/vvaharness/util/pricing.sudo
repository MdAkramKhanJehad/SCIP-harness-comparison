PRICING_FILE_ENV = "VVAHARNESS_PRICING_FILE"
_PER_MTOK = 1_000_000.0
FALLBACK_CACHE_READ_FRACTION = 0.10    // "Last resort only: Anthropic 5-min-TTL economics, WRONG for most OpenAI models"
FALLBACK_CACHE_WRITE_MULTIPLIER = 1.25

