// file: vvaharness/remediation_agent/artifacts/report.py
// Assembles the canonical finding_case.json by joining the scan finding with the attempt this pass produced.

@executedBy(CODE) @role(io) @stage("S10")
class ArtifactsReport {

    FindingCase buildReport(RemediationTarget target, Remediation remediation, List<String> revertedPaths) {
        String caseId = target.caseId();                                                            // src: vvaharness/remediation_agent/artifacts/report.py:27
        // Stamp the id onto the finding too, so a case file read on its own is self-describing.
        Finding finding = target.finding.caseId != null ? target.finding : target.finding.copyWith("case_id", caseId); // src: vvaharness/remediation_agent/artifacts/report.py:29
        FindingCase c = new FindingCase(caseId, finding);                                           // src: vvaharness/remediation_agent/artifacts/report.py:31
        return c.withAttempt(remediation, revertedPaths);                                           // src: vvaharness/remediation_agent/artifacts/report.py:32
    }
}
