# vvaharness/validation/io/result_collector.py

Turns the persisted `validation_report.json` into one verdict and one report row per finding, recomputing each verdict on the host, and fills blank row fields from `manifest.json`.

Source: `vvaharness/validation/io/result_collector.py` (lines 1-172)
Executor: code
Called from: `vvaharness/validation/execution/pipeline.sudo` execute_plan

_MIN_AFFECTED_FILE_LEN = 3   // src: result_collector.py:45-46

// src: vvaharness/validation/io/result_collector.py:118-138
fn collect_and_enrich(workspace_dir, finding_number_start=0, provenance?, policy?):executor=code {
  collected = _collect(workspace_dir, finding_number_start, provenance or, when absent, Provenance(), policy)
  manifest = _load_manifest(workspace_dir)   // null on any read or parse failure
  if (!collected || manifest == null || manifest.finding == null) return collected
  return for each item in collected: CollectedFinding(item.verdict, _enrich(item.row, manifest))
}

// src: vvaharness/validation/io/result_collector.py:56-75
fn _collect(workspace_dir, finding_number_start, provenance, policy):executor=code {
  try report = ValidationReport.from_file("$workspace_dir/validation_report.json")
  catch OSError, ValueError => { warn "Could not read validation report"; return [] }
  gates_by_id = io._host_score.load_synthesized_gates(workspace_dir)
  return for each [index, finding] in report.findings: _one(finding, gates_by_id[finding.tracking_id], finding_number_start + index, provenance, policy)
  // gates are looked up by the agent-supplied tracking_id
}

// src: vvaharness/validation/io/result_collector.py:78-98
fn _one(finding, gates, finding_number, provenance, policy):executor=code {
  verdict = io._host_score.verdict_for(finding, gates, provenance, policy)
  // preserved: conformant() is not applied here, unlike case_writeback.build_verdict; the row and the persisted verdict are computed separately
  rows = models.results.gate_score_rows(verdict, FIX_CONFIG)
  return CollectedFinding(verdict, models.results.render_row(verdict, finding, finding_number, gate_scores_json = if (rows) JSON(rows) else "", policy))
}

// src: vvaharness/validation/io/result_collector.py:141-172
fn _enrich(row, manifest):executor=code {
  finding = manifest.finding
  fills = [
    ["finding_title", finding.title, row.finding_title is empty],
    ["finding_description", finding.description with literal "\\n" replaced by " ", trimmed, row.finding_description is empty],
    ["affected_files", _filter_affected_files(manifest.affected_files), row.affected_files is empty],
    ["tracking_id", finding.case_id || manifest.case_id, row.tracking_id is empty || row.tracking_id == manifest.case_id],
    // "The agent left the schema default, so it offered no severity: defer to the finding's."
    ["severity", finding.severity.value, casefold(row.severity) == "medium"]
  ]
  apply every fill whose condition holds and whose value is non-empty, on a copy of row
}

// src: vvaharness/validation/io/result_collector.py:101-107
fn _filter_affected_files(affected):executor=code = join(names not starting with "//" and longer than 3 characters, ", ")
