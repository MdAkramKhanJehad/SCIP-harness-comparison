// src: vvaharness/lang/detect.py:23-105
// abstracted: EXT_TO_LANG maps about 170 lower-case extensions to language keys. Keys: c-cpp, rust, go, python, java, javascript,
//   typescript, php, ruby, objective-c, kotlin, csharp, perl, swift, scala, cobol, jcl, dart, elixir, erlang, groovy, lua, r,
//   powershell, shell, batch, sql, vbnet, abap, clojure, haskell, ocaml, fsharp, julia, solidity, assembly, zig, nim, crystal,
//   terraform (.tf .tfvars .hcl), bicep, and web-template (.html .htm .jsp .jspx .jspf .tag .tagx .aspx .ascx .master .cshtml
//   .vbhtml .phtml .erb .rhtml .ejs .hbs .handlebars .mustache .twig .pug .jade .ftl .ftlh .vm .vtl .mako .j2 .jinja .jinja2
//   .vue .svelte .liquid .njk .slim .haml .tpl .xhtml). No entry maps .yml / .yaml.
EXT_TO_LANG = { ".py": "python", ".java": "java", ..., ".xhtml": "web-template" }

// src: vvaharness/lang/detect.py:107-118
TEMPLATE_COMPOUND_SUFFIXES = (".blade.php",)
fn is_web_template(path):executor=code {
  low = lowercase(path)
  if (low ends with ".blade.php") return true
  return low has an extension && EXT_TO_LANG[".<ext>"] == "web-template"
}

// src: vvaharness/lang/detect.py:120-152
// abstracted: LANG_DISPLAY gives a display label per language key (for example "web-template" -> "Web Templates", "c-cpp" -> "C/C++"),
//   including the sniffed keys ansible, dockerfile, jenkins, github-actions, kubernetes.
LANG_DISPLAY = { "c-cpp": "C/C++", ..., "web-template": "Web Templates", ... }

// src: vvaharness/lang/detect.py:157-206
Options sniff_patterns {
  _ANSIBLE_PATH_RX: path segment ansible | playbook(s) | roles | inventories | group_vars | host_vars (case-insensitive)
  _ANSIBLE_BODY_RX: a line key hosts | tasks | handlers | become | gather_facts | ansible.<x>
  _COBOL_BODY_RX: IDENTIFICATION / PROCEDURE DIVISION, WORKING-STORAGE SECTION, level-number PIC clause, FILLER, COPY member
  _JCL_BODY_RX: /^\/\/\S*\s+(JOB|EXEC|DD|PROC)\b|^\/\/\s*SYSIN\b/m
  _MAINFRAME_PATH_RX: segment mvs_code | jcl | cntl | proclib | cobol | copybook(s) | jobs
  _DOCKERFILE_NAME_RX: Dockerfile or Containerfile, optional suffix
  _JENKINSFILE_NAME_RX: Jenkinsfile, optional suffix
  _GHACTIONS_PATH_RX: .github/workflows/<name>.yml|yaml
  _K8S_PATH_RX: under k8s | kubernetes | helm | chart(s) | manifest(s) | deploy(ment(s)), ending .yml|.yaml|.tpl
  _K8S_BODY_RX: a line starting "apiVersion: "
  _IAC_PATH_RX: Dockerfile / Containerfile / Jenkinsfile; docker-compose*, Chart, kustomization, .gitlab-ci, cloudbuild,
    azure-pipelines, buildspec, appspec, serverless .yml|.yaml; .tf .tfvars .hcl .bicep; GitHub workflows; .yml|.yaml|.tpl|.json
    under k8s / kubernetes / helm / chart(s) / manifest(s) / deploy(ment(s)) / cloudformation / cfn; .yml|.yaml under
    ansible / playbook(s) / roles / group_vars / host_vars
}

// src: vvaharness/lang/detect.py:209-211
fn is_iac_file(rel) = _IAC_PATH_RX matches rel   // path only, no file I/O

