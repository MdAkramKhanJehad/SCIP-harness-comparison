// file: vvaharness/skills/iac/probe.sh
// Read-only IaC sweep: manifest inventory of seven platforms, then labelled known-bad / control-presence
// directive sections per platform plus cross-cutting TLS and credential literals. CAP=20 per section; exits 0.

@executedBy(CODE) @role(tool) @stage("S4")
class IacProbe {

    String run(String root, Theta θ) {
        Out out = new Out();
        int cap = 20;                                                                                // src: vvaharness/skills/iac/probe.sh:19
        out.line("IAC MISCONFIGURATION SWEEP under: " + root);                                       // src: vvaharness/skills/iac/probe.sh:65
        out.line("--- MANIFEST INVENTORY (an absent platform is not a finding) ---");
        for (String platform : θ["p.skill_iac.probe_platform_inventory"]) {                         // src: vvaharness/skills/iac/probe.sh:68
            flist(root, platform, Patterns.platformMarker(platform), Patterns.platformGlobs(platform), cap, out);
        }
        for (String sec : θ["p.skill_iac.probe_directive_sections"]) {                              // src: vvaharness/skills/iac/probe.sh:78
            if (sec.equals("Ansible shell/become/vault")) {
                hits(root, "vault-encrypted material", "$ANSIBLE_VAULT;", cap, out);                // src: vvaharness/skills/iac/probe.sh:118
                // committed vault password / key file (find by name)
                nlist(root, "vault password / key file committed beside it", List.of("*vault*pass*", "*vault*key*", ".vault_pass*"), cap, out); // src: vvaharness/skills/iac/probe.sh:119
            }
            hits(root, sec, Patterns.directive(sec), cap, out);                                      // case-insensitive grep  // src: vvaharness/skills/iac/probe.sh:78
        }
        out.line("(end of sweep)");                                                                  // src: vvaharness/skills/iac/probe.sh:126
        return out.exit0();
    }

    void hits(String root, String label, String pat, int cap, Out out) {
        out.section(label);
        List<String> h = Grep.rEni(pat, root, Excludes.IAC);                                         // src: vvaharness/skills/iac/probe.sh:28
        if (h.isEmpty()) { out.line("(none)"); return; }                                             // src: vvaharness/skills/iac/probe.sh:30
        out.line(h.size() + " match(es); showing up to " + cap).lines(h.head(cap));                  // src: vvaharness/skills/iac/probe.sh:32
    }

    void flist(String root, String label, String pat, List<String> globs, int cap, Out out) {
        out.section(label);
        List<String> f = Grep.filesMatching(pat, globs, Excludes.IAC).sorted();                      // src: vvaharness/skills/iac/probe.sh:42
        if (f.isEmpty()) out.line("(none)"); else out.lines(f.head(cap));                            // src: vvaharness/skills/iac/probe.sh:44
    }

    void nlist(String root, String label, List<String> names, int cap, Out out) {
        out.section(label);
        List<String> f = Fs.find(root, names).pruning(List.of(".git", "node_modules", "vendor")).sorted(); // src: vvaharness/skills/iac/probe.sh:55
        if (f.isEmpty()) out.line("(none)"); else out.lines(f.head(cap));
    }
}
