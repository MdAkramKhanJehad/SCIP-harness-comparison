// file: vvaharness/sdk/loading.py
// Resolves a profile's sdk.plugins block into the one PluginSet a scan installs; only built-in names are loadable.

@executedBy(CODE) @role(config)
class Loading {

    // Allow-list of loadable plugin names -> lazy "module:Class" targets. A profile naming an arbitrary module is refused (config must not be a code-execution surface).
    Map<String, String> BUILTIN_PLUGINS = θ["code.sdk.loading.builtin_plugins"];                     // src: vvaharness/sdk/loading.py:30

    List<Map> pluginSpecs(Config cfg, Theta θ) {
        Object raw = UtilConfig.knob(cfg, "sdk.plugins", List.of(), θ);                              // falsy -> empty list // src: vvaharness/sdk/loading.py:35
        if (raw == null) raw = List.of();                                                            // src: vvaharness/sdk/loading.py:37
        if (!(raw instanceof List)) throw new TypeError("sdk.plugins must be a list of mappings");   // src: vvaharness/sdk/loading.py:39
        List<Map> specs = new ArrayList();
        for (Object entry : raw) {                                                                   // src: vvaharness/sdk/loading.py:41
            if (!(entry instanceof Map) || !entry.get("name")) throw new TypeError("each sdk.plugins entry needs a name"); // src: vvaharness/sdk/loading.py:43
            specs.add(Map.copyOf(entry));                                                            // src: vvaharness/sdk/loading.py:45
        }
        return specs;
    }

    VvahPlugin built(Map spec, Theta θ) {
        Map options = Map.copyOf(spec);                                                              // src: vvaharness/sdk/loading.py:48
        String name = options.remove("name");                                                        // name consumed as lookup key // src: vvaharness/sdk/loading.py:50
        String target = θ["code.sdk.loading.builtin_plugins"].get(name);                             // src: vvaharness/sdk/loading.py:51
        if (target == null) throw new ValueError("unknown sdk plugin; known: sorted BUILTIN_PLUGINS names"); // src: vvaharness/sdk/loading.py:53
        Callable factory = resolve(target);                                                          // src: vvaharness/sdk/loading.py:54
        for (String key : List.of("configs", "rulesets")) {                                          // src: vvaharness/sdk/loading.py:56
            if (options.containsKey(key)) options.put(key, Tuple.of(options.get(key) != null ? options.get(key) : List.of())); // src: vvaharness/sdk/loading.py:57
        }
        return factory.call(options);                                                                // remaining options passed as keyword arguments // src: vvaharness/sdk/loading.py:59
    }

    Callable resolve(String target) {
        String moduleName = target.partitionBefore(":");                                             // src: vvaharness/sdk/loading.py:62
        String attr = target.partitionAfter(":");
        return ImportLib.importModule(moduleName).getAttr(attr);                                       // imported only when that plugin is configured // src: vvaharness/sdk/loading.py:65
    }

    PluginSet loadPluginSet(Config cfg, Theta θ) {
        List<Map> specs = pluginSpecs(cfg, θ);                                                       // src: vvaharness/sdk/loading.py:68
        if (specs.isEmpty()) return new PluginSet();                                                 // src: vvaharness/sdk/loading.py:70
        PluginSet plugins = new PluginSet(specs.map(spec -> built(spec, θ)));                        // validation happens in the constructor // src: vvaharness/sdk/loading.py:73
        Logging.info("sdk plugins loaded: names");                                                   // src: vvaharness/sdk/loading.py:75
        return plugins;
    }
}
