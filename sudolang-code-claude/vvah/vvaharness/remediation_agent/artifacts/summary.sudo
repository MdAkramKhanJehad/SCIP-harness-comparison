// src: vvaharness/remediation_agent/artifacts/summary.py:21-44
fn render_summary(verdict, meta):executor=code {
  // abstracted: summary.py:23-44 — Markdown formatting only; no decisions
  return "# Remediation — finding <verdict.finding_index>" followed by Severity, Title, File (or "n/a"), Mode, Verdict, Gates (source, sink, missing_control) and Generated lines from meta and verdict, then the sections "Root cause", "Changes" ("- (none reported)" when empty), "Remaining risks", "Recommendations" ("- (none)" when empty) and "Summary"
}
