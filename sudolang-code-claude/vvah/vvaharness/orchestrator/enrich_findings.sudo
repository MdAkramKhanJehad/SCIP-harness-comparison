# vvaharness/orchestrator/enrich_findings.py

After Stage 7, each canonical finding gets its batch path prefix, a normalized CWE, a CVSS score derived from its vector, the contextual severity score (when a configuration-management database profile exists) and an offensive priority, so Stage 8 can render them.

Source: `vvaharness/orchestrator/enrich_findings.py` (lines 1-67)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (`_enrich_findings(canonical, app_info, path_prefix)`)

// src: vvaharness/orchestrator/enrich_findings.py:39-67
fn _enrich_findings(findings, app_info, path_prefix?):executor=code {
  for each f in findings {
    if (path_prefix) {
      // batch mode: paths become "<repo_name>/<path>" unless already prefixed; "file:line" refs prefix only the file part
      f.file = _prefix_path(f.file, path_prefix); f.source_ref, f.sink_ref = prefixed
      for each d in f.duplicates { prefix d.file (kept if prefixing yields nothing), d.source_ref, d.sink_ref }
    }
    f.cwe = norm_cwe(f.cwe)
    if (f.cvss_vector) {
      score = cvss.score_or_sentinel(f.cvss_vector)
      if (score >= 0) { f.cvss_score = score; f.cvss_rating = cvss.rating(score) }   // the vector wins over any model-stated score; a negative sentinel leaves the existing score
    }
    if (f.cvss_vector && app_info != null) {
      vr = appcontext.vsvs_score(f.cvss_vector, app_info)
      if (vr) { f.vsvs_vector, f.vsvs_score, f.vsvs_rating = vr }
    }
    [f.offensive_priority, f.offensive_reason] = appcontext.offensive_priority_for(f.title, f.vuln_class, f.description, f.cvss_vector, app_info)
  }
}

