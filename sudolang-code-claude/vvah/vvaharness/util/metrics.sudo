# vvaharness/util/metrics.py

Builds the `ScanMetrics` record from pipeline state: coverage (which files count as analyzed), failed-unit counts, token and cost totals, and the stage counters copied into named fields. Some of these fields feed the report's coverage-degraded verdict.

Source: `vvaharness/util/metrics.py` (lines 1-332)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (`build` before Stage 8, `refresh_tokens` afterwards)

// src: vvaharness/util/metrics.py:37-44
fn _priced_cost_usd(tok, role_models, pricing):executor=code {
  if (!pricing || !role_models) return null
  return stage_telemetry.compose_stage_section({}, tok, role_models, pricing).totals.cost_usd   // same costing as the manifest, so the two cannot drift
}

// src: vvaharness/util/metrics.py:48-54, 152-158
_KIND_PREFIXES = (("taint-", "taint"), ("catchall-", "catchall"), ("spec-", "specialist"), ("threat-", "threat"), ("chunk-", "risk"))   // first matching prefix wins; else "other"
// only "threat-" has a producer today; the others keep resumed runs classifying

// src: vvaharness/util/metrics.py:57-149
_INT_COUNTER_NAMES = (...)
// abstracted: 104 counter names copied verbatim from COUNTERS into same-named ScanMetrics fields (Stage 2 caps and evidence gate, Stage 3 path fixes, Stage 4 truncation, batch resubmission and evidence gate, Stage 6 clamps, splits and replays, structured and truncated retry pairs per stage, refusal retries, call timeouts, orphaned calls). Must stay a subset of ScanMetrics fields; an unmatched name drops silently.

// src: vvaharness/util/metrics.py:206-324
fn build(ctx, manifest, repo_name, start_ts, end_ts, raw_findings, true_pos, false_pos, duplicates, discovered_tp=0, clone_tp=0, ev_rescued=0, unit_outcomes?, external_input=false, role_models?, pricing?):executor=code {
  outcomes = unit_outcomes or {}
  external_only = external_input && every outcome in ("injected", "confirmed")
  for each u in manifest.units {
    // only COMPLETED units' files count as analyzed; a unit with no outcome counts as completed, unless external_input (then "uninvestigated")
    if (!external_only && outcomes[u.id] (default "uninvestigated" if external_input else "completed") == "completed") analyzed += u.files
    count u's kind; add ScopeEntry(u.id, kind, sorted files)
  }
  folders = sorted parent folders of analyzed files that contain a separator, plus "."
  for each f in ctx.all_files, add its non-blank line count to loc_in_scope[language], and to loc_scanned[language] if f in analyzed
  tok = TOKENS.snapshot(); tok_avail = tok.calls_with_usage > 0
  chunks_attempted = if (external_only) 0 else count of units
  non_failures = if (external_input) ("completed", "skipped", "injected", "confirmed") else ("completed", "skipped")   // "skipped" is a designed outcome, not a failure
  chunks_failed = count of outcomes not in non_failures
  counter_fields = each name in _INT_COUNTER_NAMES present in COUNTERS
  if ("s2_degraded" in COUNTERS) counter_fields.s2_degraded = COUNTERS.s2_degraded != 0   // a count turned into a boolean
  for each name in ("s2_baseline_undisposed", "s2_repo_kinds"), split the comma-joined note into a list ([] for empty);
  return ScanMetrics {
    scan_id: "${start_ts}__${repo_name}", analyzed_files_unique: |analyzed ∩ all_files|,
    s3_unreachable_files: count of manifest.unreachable_files,   // from the checkpointed manifest, not COUNTERS, so it survives --resume
    s3_threats_without_unit: count of manifest.threats_without_unit_for(ctx.threat_model),
    chunks_total, chunks_attempted, chunks_failed, deepdive_skipped: external_only,
    chunks_risk, chunks_catchall, chunks_specialist: per-kind unit counts (back-compatible tallies), chunks_by_kind: every kind count,
    folders_scanned: folders, scope, excluded: ctx.excluded or {}, loc_in_scope_by_language, loc_scanned_by_language,
    errors_by_stage: errlog.counts_by_stage(), errors_log_path: current path if it exists else "",
    finding counts as passed in,
    token fields: if (tok_avail) values else null   // null, never 0, when no call reported usage
    reported_cost_usd: tok.usd, priced_cost_usd: if (tok_avail) _priced_cost_usd(...) else null,
    ...counter_fields
  }
}

// src: vvaharness/util/metrics.py:174-203
fn refresh_tokens(metrics, end_ts?, role_models?, pricing?):executor=code {
  // build() runs BEFORE Stage 8, so it is blind to Stage 8 spend; this re-snapshots in place
  if (metrics == null) return
  if (end_ts) update end_ts and duration
  metrics.errors_by_stage = errlog.counts_by_stage(); update errors_log_path
  for each name in _INT_COUNTER_NAMES present in COUNTERS, except "llm_turn_cap_exhausted", copy it
  // preserved: llm_turn_cap_exhausted keeps its build() value because it is the only counter-backed coverage_degraded() reason, and a Stage 8 forced final bumps it on sdk/openai, which would flag a healthy scan as degraded
  if (TOKENS.snapshot().calls_with_usage <= 0) return
  update token fields, tokens_by_phase, reported_cost_usd, priced_cost_usd
}
