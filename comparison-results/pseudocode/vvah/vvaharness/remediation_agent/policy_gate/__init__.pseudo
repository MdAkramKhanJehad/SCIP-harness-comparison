// Deterministic eligibility gate facade: the only place deciding whether a finding reaches the patch agent.

@executedBy(CODE) @role(rule_set) @stage("S10")
class PolicyGate {

    Decision decide(RemediationGate gate, String cweId, String filePath) {
        return RemediationAgentPolicyGate.decide(gate, cweId, filePath);                            // src: vvaharness/remediation_agent/policy_gate/__init__.py:29
    }

    String capVerdict(Action action, boolean allGatesPassed) {
        return RemediationAgentPolicyGate.capVerdict(action, allGatesPassed);                       // src: vvaharness/remediation_agent/policy_gate/__init__.py:23
    }

    boolean globMatch(String path, String pat) {
        return RemediationAgentPolicyGate.globMatch(path, pat);                                     // src: vvaharness/remediation_agent/policy_gate/__init__.py:33
    }

    RemediationGate load(String policyPath, Theta θ) {
        // DEFAULT_POLICY_PATH = RULES_DIR/remediation_policy.yaml
        return RemediationAgentPolicyGate.load(policyPath, θ);                                      // src: vvaharness/remediation_agent/policy_gate/__init__.py:27
    }
}
