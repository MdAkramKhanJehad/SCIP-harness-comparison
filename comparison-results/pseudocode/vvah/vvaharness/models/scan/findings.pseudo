// file: vvaharness/models/scan/findings.py
// Findings and their post-processing forms: Finding, LinkEvidence (S8 per-hop schema the model
// fills; its field descriptions are prompt text), Chain, RankedFinding, DroppedFinding.

@executedBy(CODE) @role(types)
record Finding(String title, String file, int lineStart, VulnClass vulnClass, Severity severity, int lineEnd,
               String cwe, String vulnClassLabel, String chunkId, String impact, String description,
               String exploitScenario, List<String> preconditions, String recommendation, String codeSnippet,
               String sourceRef, String sinkRef, List<DupLocation> duplicates, List<String> backfilledRefs,
               int preAnchorLine, String caseId, String exploitabilityNotes, String severityProseMismatch,
               String channel, boolean controlAbsence, String origin, boolean isRepeatClone,
               String verdict, Integer verdictConfidence, String verdictReason, String cvssVector,
               Double cvssScore, String cvssRating, String evStatus, String evEvidence,
               String vsvsVector, Double vsvsScore, String vsvsRating, String offensivePriority) { }

@executedBy(CODE) @role(types)
class ScanFindings {

    String canonicalChannel(Object v) {
        // Canonicalize to "main"/"posture" so no consumer needs its own casefold.
        return (v is String && v.strip().casefold() == "posture") ? "posture" : "main";        // src: vvaharness/models/scan/findings.py:77
    }

    Tuple canonicalKey(Finding f, int lineBucket) {
        // Identity for intersection; cwe is in the key because VulnClass folds web defects.
        return Tuple.of(f.file, f.lineStart / lineBucket, f.vulnClass, f.cwe);                 // src: vvaharness/models/scan/findings.py:113
    }

    // NOT_RANKED_NOTE = "(no chain role found by the chaining pass; severity from the CVSS band)"
    // DroppedFinding.reason in FALSE_POSITIVE | VERIFY_ERROR | DUPLICATE | UNCONFIRMED | EXCLUDED | GUARDRAIL_BLOCKED | INCONCLUSIVE
}

@executedBy(MIXED) @role(prompt) @stage("S8")
class LinkEvidence {

    Prompt schema(Theta θ) {
        // Why hop N feeds hop N+1: the mechanism, plus the file/line that shows it holds.
        Prompt p = new Prompt();
        p.format("from_id: The FINDING id this link starts at (e.g. f3).");                     // src: vvaharness/models/scan/findings.py:126
        p.format("to_id: The FINDING id this link leads to (e.g. f7).");                        // src: vvaharness/models/scan/findings.py:127
        p.evidence(θ["p.findings.link_mechanism_concrete"]);                                    // src: vvaharness/models/scan/findings.py:129
        p.forbid(θ["p.findings.link_mechanism_not_title_restatement"]);                         // src: vvaharness/models/scan/findings.py:130
        p.evidence(θ["p.findings.link_file_repo_relative"]);                                    // src: vvaharness/models/scan/findings.py:132
        p.must(θ["p.findings.link_line_must_be_real"]);                                         // src: vvaharness/models/scan/findings.py:134
        return p;
    }

    @executedBy(CODE)
    Map unpackFileLine(Map data) {
        // A `file_line` string ("a.py:231 -> b.py:297") fills only what file/line left empty.
        if (!(data.get("file_line") is String)) return data;                                    // src: vvaharness/models/scan/findings.py:140
        Match m = FILE_LINE_RX.match(data.remove("file_line"));                                 // src: vvaharness/models/scan/findings.py:143
        if (m != null) {
            if (data.get("file").isEmpty()) data.put("file", m.group(1));                       // src: vvaharness/models/scan/findings.py:146
            if (coerceLine(data.get("line")) == 0) data.put("line", m.group(2));                // src: vvaharness/models/scan/findings.py:150
        }
        return data;
    }

    @executedBy(CODE)
    int coerceLine(Object v) {
        // Coerce, never reject: one "line 42" would fail S8's ENTIRE reply.
        double f;
        try { f = Float.parse(v); } catch (ValueError e) { return 0; }                          // src: vvaharness/models/scan/findings.py:161
        return isFinite(f) ? max((int) f, 0) : 0;                                               // src: vvaharness/models/scan/findings.py:163
    }
}

@executedBy(CODE) @role(types) @stage("S8")
record Chain(String title, List<Integer> steps, Severity severity, List<String> blockedByControls,
             List<String> preconditions, List<LinkEvidence> linkEvidence, String entryReachability,
             List<String> qualityNotes, List<String> disclosures, String severityDecision,
             String linkCoverage, String narrative) { }

@executedBy(CODE) @role(types)
record RankedFinding(Finding finding, Severity severity, String exploitabilityNotes) { }

@executedBy(CODE) @role(types)
record DroppedFinding(String file, int line, VulnClass vulnClass, String title, String chunkId,
                      String reason, String detail, Integer canonicalIdx) { }
