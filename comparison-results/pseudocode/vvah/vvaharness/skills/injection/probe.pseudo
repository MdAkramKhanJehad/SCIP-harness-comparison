// file: vvaharness/skills/injection/probe.sh
// Injection candidate sweep: one labelled grep section per injection class (CAP=20 hits shown), then a defence census.
// Run by the model through its shell tool; output is candidates only.

@executedBy(CODE) @role(tool) @stage("S4")
class InjectionProbe {

    int CAP = 20;                                                                                           // src: vvaharness/skills/injection/probe.sh:19
    List<String> EXCLUDE_DIRS = List.of(".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build", ".vvaharness", "vendor"); // src: vvaharness/skills/injection/probe.sh:20

    ProbeOutput run(Path root, Theta θ) {
        ProbeOutput out = new ProbeOutput("Every line below is a CANDIDATE. Apply the hard gate before reporting anything."); // src: vvaharness/skills/injection/probe.sh:43
        for (String label : θ["p.skill_injection.probe_sink_sections"]) {                                  // 17 per-class sink sections // src: vvaharness/skills/injection/probe.sh:45
            out.add(hits(label, root));
        }
        for (String marker : θ["p.skill_injection.probe_defence_census"]) {                                 // files containing each defence marker // src: vvaharness/skills/injection/probe.sh:83
            out.addCount(marker, Grep.filesMatching(root, marker, EXCLUDE_DIRS).size());                    // src: vvaharness/skills/injection/probe.sh:39
        }
        return out;
    }

    Section hits(String label, Path root) {
        List<String> lines = Grep.rEn(root, label, EXCLUDE_DIRS);                                          // src: vvaharness/skills/injection/probe.sh:27
        if (lines.isEmpty()) return Section.none(label);                                                    // "(none)" // src: vvaharness/skills/injection/probe.sh:29
        return new Section(label, lines.size(), lines.head(CAP));                                           // src: vvaharness/skills/injection/probe.sh:32
    }
}
