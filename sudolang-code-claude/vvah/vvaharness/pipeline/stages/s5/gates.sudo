# vvaharness/pipeline/stages/s5/gates.py

What Stage 5 still refuses: a test, mock or example path (unless the finding is a point-of-occurrence class such as a hardcoded secret), a file outside the repository inventory, an unreadable file, and a start line outside the file. A line_end past end of file is clamped, not refused.

Source: `vvaharness/pipeline/stages/s5/gates.py` (lines 1-47)
Executor: code
Called from: `vvaharness/pipeline/stages/s5/__init__.py` run

// src: vvaharness/pipeline/stages/s5/gates.py:23-29
fn reject_path(f, valid_files):executor=code {
  // judged with no disk I/O
  require !(EXCLUDE_PATH_RE matches f.file && !is_secret_class(f)) => return ["EXCLUDED", "test/mock/example path"]
  require valid_files == null || f.file in valid_files => return ["EXCLUDED", "file not in repo inventory"]
  return null
}

// src: vvaharness/pipeline/stages/s5/gates.py:32-47
fn reject(f, valid_files, lines):executor=code {
  verdict = reject_path(f, valid_files)
  if (verdict != null) return verdict
  require lines != null => return ["EXCLUDED", "file could not be read from the repo"]
  line = f.line_start or 0
  require 1 <= line <= length(lines) => return ["EXCLUDED", "line $line outside ${f.file} (1-${length(lines)})"]
  // the only point both Stage 4 rows and detector rows pass through, so line_end is clamped here
  if (f.line_end > length(lines)) { f.line_end = length(lines); COUNTERS.bump("s5_line_end_clamped_eof") }
  return null
}
