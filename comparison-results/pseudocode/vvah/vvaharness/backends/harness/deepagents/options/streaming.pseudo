// file: vvaharness/backends/harness/deepagents/options/streaming.py
// Streaming (multi-turn) graph compilation and its public entry point: builds the parent graph with the caller's
// subagents, tool policy, executor gate and middleware, wraps it with its LangGraph config (thread id, recursion limit)
// and holds it by session id so a deadline resume re-enters the same MemorySaver.

@executedBy(CODE) @role(backend)
class Streaming {

    // session_id -> the compiled graph built for it, so a resume reaches the SAME MemorySaver
    Map<String, CompiledGraph> SESSIONS = new Map();                                                     // src: vvaharness/backends/harness/deepagents/options/streaming.py:120
    Lock SESSIONS_LOCK = new Lock();                                                                     // src: vvaharness/backends/harness/deepagents/options/streaming.py:128

    // Native DeepAgents subagent specs for the streaming parent.
    List<SubagentSpec> buildSubagents(StreamingOptions options, Theta θ) {                               // src: vvaharness/backends/harness/deepagents/options/streaming.py:52
        return Subagents.getSubagentSpecs(options, options.agents, θ);                                   // src: vvaharness/backends/harness/deepagents/options/streaming.py:54
    }

    // Tool names contributed by the caller middleware (langchain AgentMiddleware.tools).
    Set<String> middlewareToolNames(StreamingOptions options) {                                          // src: vvaharness/backends/harness/deepagents/options/streaming.py:57
        Set names = new Set();
        for (mw : options.parentMiddleware) names.addAll(mw.tools.map(t -> t.name));                     // src: vvaharness/backends/harness/deepagents/options/streaming.py:61
        return names;
    }

    // Executor-permitted tool names: the caller set, its session tools, its middleware tools; plus the subagent dispatch tool
    // when subagents exist. null (no gate) when the caller set none.
    Set<String> permittedToolCalls(StreamingOptions options, List<Tool> sessionTools, Theta θ) {         // src: vvaharness/backends/harness/deepagents/options/streaming.py:65
        if (options.permittedToolCalls == null) return null;                                             // src: vvaharness/backends/harness/deepagents/options/streaming.py:68
        Set permitted = union(options.permittedToolCalls, DeepagentsTools.sessionToolNames(sessionTools, θ), middlewareToolNames(options)); // src: vvaharness/backends/harness/deepagents/options/streaming.py:70
        if (options.agents.nonEmpty()) permitted = union(permitted, Set.of(SUBAGENT_DISPATCH_TOOL));     // src: vvaharness/backends/harness/deepagents/options/streaming.py:73
        return permitted;
    }

    // Advertisement counterpart of the executor gate: un-offer what it refuses. Computed from the SAME permitted set as
    // PermitTools so the two cannot drift; advertising only.
    Set<String> extraExcludedTools(StreamingOptions options) {                                           // src: vvaharness/backends/harness/deepagents/options/streaming.py:78
        if (options.permittedToolCalls == null) return null;                                             // src: vvaharness/backends/harness/deepagents/options/streaming.py:81
        Set excluded = difference(ALL_NATIVE_TOOLS, options.permittedToolCalls);                         // src: vvaharness/backends/harness/deepagents/options/streaming.py:83
        if (options.agents.nonEmpty()) return excluded;                                                  // src: vvaharness/backends/harness/deepagents/options/streaming.py:84
        return union(excluded, Set.of(SUBAGENT_DISPATCH_TOOL));                                          // src: vvaharness/backends/harness/deepagents/options/streaming.py:86
    }

    // Compile the parent agent graph and its declarative subagents.
    CompiledStateGraph buildStreamingGraph(StreamingOptions options, Theta θ) {                          // src: vvaharness/backends/harness/deepagents/options/streaming.py:89
        List<SubagentSpec> subagentSpecs = buildSubagents(options, θ);                                   // src: vvaharness/backends/harness/deepagents/options/streaming.py:91
        // the orchestrator only gets read tools; it dispatches subagents via the auto-added task tool
        List<String> parentTools = Subagents.toolPolicy(options).allowedTools.filter(t -> READ_TOOLS.contains(t)); // src: vvaharness/backends/harness/deepagents/options/streaming.py:93
        List<Tool> tools = Subagents.buildSessionTools(options, parentTools, θ);                         // src: vvaharness/backends/harness/deepagents/options/streaming.py:94
        return GraphBuilder.createAgent(options.model, options.env, options.systemPrompt, tools, options.graphName,
            Filesystem.skillSources(options.skillRoot, options.cwd),
            Filesystem.filesystemPermissions(options, θ),
            options.modelProvider,
            subagentSpecs.nonEmpty() || !options.allowWrites,   // redact_reads                           // src: vvaharness/backends/harness/deepagents/options/streaming.py:106
            Filesystem.sessionBackend(options, θ),
            options.responseModel,
            ResponseFormat.responseFormat(options.responseModel, options.model, options.modelProvider),
            subagentSpecs,
            // null (S10/S11 and every non-opted-in caller) adds no exclusion and installs no gate
            extraExcludedTools(options),                                                                 // src: vvaharness/backends/harness/deepagents/options/streaming.py:115
            options.maxOutputTokens,   // null (frozen S10/S11 defaults) keeps the model own ceiling      // src: vvaharness/backends/harness/deepagents/options/streaming.py:119
            options.outputCap,
            permittedToolCalls(options, tools, θ),                                                       // src: vvaharness/backends/harness/deepagents/options/streaming.py:117
            false,   // strip_harness_suffix: default
            options.cacheMarkers,
            θ["code.backends.harness.deepagents.options.streaming.cache_tail"],   // true: agentic sessions re-read the marked tail every turn // src: vvaharness/backends/harness/deepagents/options/streaming.py:120
            concat(options.parentMiddleware, options.forceVerdictOnly ? [new ForceVerdictOnly()] : []),  // src: vvaharness/backends/harness/deepagents/options/streaming.py:129
            options.effort,
            options.useResponsesApi,
            options.thinkInPrompt,                                                                       // think_in_prompt is passed by keyword near the top of the call
            θ);                                                                                          // src: vvaharness/backends/harness/deepagents/options/streaming.py:92
    }

    // Compiled parent graph and its LangGraph invoke config; held by session id for resume.
    CompiledGraph buildStreamingAgent(StreamingOptions options, Theta θ) {                               // src: vvaharness/backends/harness/deepagents/options/streaming.py:134
        graph = buildStreamingGraph(options, θ);                                                         // src: vvaharness/backends/harness/deepagents/options/streaming.py:136
        // generous headroom: LangGraph ticks the recursion limit per node, not per parallel batch
        int maxTurns = options.maxTurns != null && options.maxTurns != 0 ? options.maxTurns : θ["code.backends.harness.deepagents.options.streaming.default_max_turns"]; // 50 // src: vvaharness/backends/harness/deepagents/options/streaming.py:141
        CompiledGraph compiled = new CompiledGraph(graph,
            Map.of("thread_id", options.sessionId != null && options.sessionId != "" ? options.sessionId : randomHex(8),  // src: vvaharness/backends/harness/deepagents/options/streaming.py:140
                   "recursion_limit", maxTurns + θ["code.deepagents.recursion_headroom"]));             // src: vvaharness/backends/harness/deepagents/options/streaming.py:141
        if (options.sessionId != null && options.sessionId != "") {                                      // src: vvaharness/backends/harness/deepagents/options/streaming.py:144
            // held so resumeStreaming can re-enter this graph: the conversation lives in its MemorySaver keyed by thread_id,
            // and dies with the graph object
            SESSIONS_LOCK.acquire();
            SESSIONS.put(options.sessionId, compiled);                                                   // src: vvaharness/backends/harness/deepagents/options/streaming.py:150
            SESSIONS_LOCK.release();
        }
        return compiled;
    }

    // The compiled graph still holding the session conversation, or null once released.
    CompiledGraph resumable(String sessionId) {                                                          // src: vvaharness/backends/harness/deepagents/options/streaming.py:154
        SESSIONS_LOCK.acquire();
        try { return SESSIONS.get(sessionId); } finally { SESSIONS_LOCK.release(); }                     // src: vvaharness/backends/harness/deepagents/options/streaming.py:157
    }

    // Drop the session graph so its checkpointed conversation can be collected.
    void releaseSession(String sessionId) {                                                              // src: vvaharness/backends/harness/deepagents/options/streaming.py:158
        SESSIONS_LOCK.acquire();
        SESSIONS.remove(sessionId);                                                                      // src: vvaharness/backends/harness/deepagents/options/streaming.py:161
        SESSIONS_LOCK.release();
    }
}
