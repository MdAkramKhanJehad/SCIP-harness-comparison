// file: vulnhunter-fix/references/repo-type-adapters.md
// Rule book (REQ-CWE-004, REQ-CWE-005): per-language adapter (Go / Java / TS-JS / Python): detection, test command, deps, framework idioms.
// Phase 2 (prompts/plan.md executor) detects the primary language and injects the matching section into the worker prompt;
// read by prompts/implement.md, prompts/verify.md and prompts/worker_agent_common.md (test command / promoted test name).

@executedBy(MODEL) @role(rule_set) @stage("fix.plan")
class RepoTypeAdapters {

    // Entry: detect language and return the adapter section spliced into the worker prompt.
    Prompt run(Repo repo, Theta θ) {
        String lang = detect(repo, θ);
        Prompt p = new Prompt();
        if (!θ["p.repo-type-adapters.adapter_injected_by_language"]) return p;                         // src: vulnhunter-fix/references/repo-type-adapters.md:5
        if (θ["p.repo-type-adapters.no_per_language_test_scaffold"]) {                                   // src: vulnhunter-fix/references/repo-type-adapters.md:7
            p.rule("discrimination-test shape follows TestQualityRubric R1-R5; no per-language scaffold");
        }
        if (lang == "go") p.include(go(θ));
        else if (lang == "java") p.include(java(θ));
        else if (lang == "ts") p.include(typescript(repo, θ));
        else if (lang == "python") p.include(python(repo, θ));
        return p;
    }

    @executedBy(CODE)
    String detect(Repo repo, Theta θ) {
        // routing implemented in scripts/language-detect.py
        if (repo.matches(θ["p.repo-type-adapters.go_detection"])) return "go";                          // src: vulnhunter-fix/references/repo-type-adapters.md:14
        if (repo.matches(θ["p.repo-type-adapters.java_detection"])) return "java";                      // src: vulnhunter-fix/references/repo-type-adapters.md:35
        if (repo.matches(θ["p.repo-type-adapters.ts_detection"])) return "ts";                          // src: vulnhunter-fix/references/repo-type-adapters.md:57
        if (repo.matches(θ["p.repo-type-adapters.py_detection"])) return "python";                      // src: vulnhunter-fix/references/repo-type-adapters.md:82
        return null;
    }

    // Promoted (repo-convention) test file name; used by CommittedTestNamingRule.promote.
    String testFileConvention(String lang, Theta θ) {
        if (lang == "go") return θ["p.repo-type-adapters.go_test_naming"];                              // src: vulnhunter-fix/references/repo-type-adapters.md:18
        if (lang == "java") return θ["p.repo-type-adapters.java_test_naming"];                          // src: vulnhunter-fix/references/repo-type-adapters.md:40
        return null;                                                                                     // unclear: no explicit naming rule given for TS/JS or Python
    }

    Prompt go(Theta θ) {
        Prompt p = new Prompt();
        String cmd = θ["p.repo-type-adapters.go_test_command"];                                          // src: vulnhunter-fix/references/repo-type-adapters.md:16
        if (θ["p.repo-type-adapters.go_race_mandatory"]) p.must("-race is mandatory");                  // src: vulnhunter-fix/references/repo-type-adapters.md:17
        p.rule(cmd);
        p.format(θ["p.repo-type-adapters.go_test_naming"]);                                             // same package as source  src: vulnhunter-fix/references/repo-type-adapters.md:18
        if (θ["p.repo-type-adapters.go_mod_tidy"]) p.must("go mod tidy after every dep change");        // src: vulnhunter-fix/references/repo-type-adapters.md:20
        if (θ["p.repo-type-adapters.go_pin_versions"]) p.forbid("wildcards in go.mod; pin versions");   // src: vulnhunter-fix/references/repo-type-adapters.md:21
        if (θ["p.repo-type-adapters.go_no_new_vendoring"]) p.forbid("introducing vendor/");             // src: vulnhunter-fix/references/repo-type-adapters.md:22
        if (θ["p.repo-type-adapters.go_http_idiom"]) p.rule("net/http + context is idiomatic");         // src: vulnhunter-fix/references/repo-type-adapters.md:25
        p.rule(θ["p.repo-type-adapters.go_auth_default"]);                                              // src: vulnhunter-fix/references/repo-type-adapters.md:26
        p.rule(θ["p.repo-type-adapters.go_api_codegen"]);                                               // manual routes discouraged  src: vulnhunter-fix/references/repo-type-adapters.md:27
        p.rule(θ["p.repo-type-adapters.go_logging"]);                                                   // fmt.Println is a violation  src: vulnhunter-fix/references/repo-type-adapters.md:28
        return p;
    }

    Prompt java(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.repo-type-adapters.java_test_command"]);                                            // src: vulnhunter-fix/references/repo-type-adapters.md:37
        p.rule(θ["p.repo-type-adapters.java_junit5_preferred"]);                                        // src: vulnhunter-fix/references/repo-type-adapters.md:38
        p.rule(θ["p.repo-type-adapters.java_mockito"]);                                                 // src: vulnhunter-fix/references/repo-type-adapters.md:39
        p.format(θ["p.repo-type-adapters.java_test_naming"]);                                           // under src/test/java/  src: vulnhunter-fix/references/repo-type-adapters.md:40
        if (θ["p.repo-type-adapters.java_maven_no_alias_versions"]) p.forbid("LATEST / RELEASE version alias"); // src: vulnhunter-fix/references/repo-type-adapters.md:43
        if (θ["p.repo-type-adapters.java_gradle_version_catalogs"]) p.rule("prefer libs.versions.toml"); // src: vulnhunter-fix/references/repo-type-adapters.md:44
        if (θ["p.repo-type-adapters.java_spring_idioms"]) p.rule("@RestController, @Service, constructor injection"); // src: vulnhunter-fix/references/repo-type-adapters.md:47
        p.rule(θ["p.repo-type-adapters.java_auth"]);                                                    // over custom filters  src: vulnhunter-fix/references/repo-type-adapters.md:48
        p.rule(θ["p.repo-type-adapters.java_logging"]);                                                 // never System.out.println  src: vulnhunter-fix/references/repo-type-adapters.md:49
        if (θ["p.repo-type-adapters.java_secrets"]) p.rule("@Value from config sourced from Chamber of Secrets"); // src: vulnhunter-fix/references/repo-type-adapters.md:50
        return p;
    }

    Prompt typescript(Repo repo, Theta θ) {
        Prompt p = new Prompt();
        for (String c : θ["p.repo-type-adapters.ts_test_command"]) {                                    // src: vulnhunter-fix/references/repo-type-adapters.md:60
            if (repo.packageJsonScripts().matches(c)) p.rule(c);
        }
        p.rule(θ["p.repo-type-adapters.ts_vitest_preferred"]);                                          // over Jest for new tests  src: vulnhunter-fix/references/repo-type-adapters.md:61
        p.rule(θ["p.repo-type-adapters.ts_e2e_playwright"]);                                            // src: vulnhunter-fix/references/repo-type-adapters.md:62
        if (θ["p.repo-type-adapters.ts_keep_package_manager"]) p.forbid("switching npm/pnpm/yarn");     // src: vulnhunter-fix/references/repo-type-adapters.md:65
        if (θ["p.repo-type-adapters.ts_pin_security_deps"]) p.rule("pin exact direct security deps; caret for indirect"); // src: vulnhunter-fix/references/repo-type-adapters.md:66
        if (θ["p.repo-type-adapters.ts_no_legacy_peer_deps"]) p.forbid("--legacy-peer-deps");           // src: vulnhunter-fix/references/repo-type-adapters.md:67
        p.rule(θ["p.repo-type-adapters.ts_react_style"]);                                               // no class components  src: vulnhunter-fix/references/repo-type-adapters.md:70
        p.rule(θ["p.repo-type-adapters.ts_routing"]);                                                   // src: vulnhunter-fix/references/repo-type-adapters.md:71
        p.rule(θ["p.repo-type-adapters.ts_css"]);                                                       // no Emotion in a Tailwind repo  src: vulnhunter-fix/references/repo-type-adapters.md:72
        p.rule(θ["p.repo-type-adapters.ts_logging"]);                                                   // console.log is a violation  src: vulnhunter-fix/references/repo-type-adapters.md:74
        return p;
    }

    Prompt python(Repo repo, Theta θ) {
        Prompt p = new Prompt();
        String cmd = θ["p.repo-type-adapters.py_test_command"];                                          // fail fast  src: vulnhunter-fix/references/repo-type-adapters.md:84
        if (repo.has("Pipfile") && θ["p.repo-type-adapters.py_pipenv_run"]) cmd = "pipenv run " + cmd; // src: vulnhunter-fix/references/repo-type-adapters.md:85
        p.rule(cmd + " " + θ["p.repo-type-adapters.py_short_tracebacks"]);                              // src: vulnhunter-fix/references/repo-type-adapters.md:86
        p.threshold(θ["p.repo-type-adapters.py_coverage_target"]);                                      // percent  src: vulnhunter-fix/references/repo-type-adapters.md:87
        if (θ["p.repo-type-adapters.py_prefer_pipfile"]) p.rule("prefer Pipfile + Pipfile.lock");       // src: vulnhunter-fix/references/repo-type-adapters.md:90
        if (θ["p.repo-type-adapters.py_no_mixed_dep_files"]) p.forbid("mixing requirements.txt and Pipfile"); // src: vulnhunter-fix/references/repo-type-adapters.md:91
        if (θ["p.repo-type-adapters.py_deps_on_configured_index"]) p.must("new deps resolve on configured package index"); // src: vulnhunter-fix/references/repo-type-adapters.md:92
        p.rule(θ["p.repo-type-adapters.py_web_framework"]);                                             // no bare http.server  src: vulnhunter-fix/references/repo-type-adapters.md:95
        p.rule(θ["p.repo-type-adapters.py_auth"]);                                                      // src: vulnhunter-fix/references/repo-type-adapters.md:96
        p.rule(θ["p.repo-type-adapters.py_logging"]);                                                   // structured formatter, never print()  src: vulnhunter-fix/references/repo-type-adapters.md:97
        p.rule(θ["p.repo-type-adapters.py_secrets"]);                                                   // never env vars for raw secrets  src: vulnhunter-fix/references/repo-type-adapters.md:99
        return p;
    }
}
