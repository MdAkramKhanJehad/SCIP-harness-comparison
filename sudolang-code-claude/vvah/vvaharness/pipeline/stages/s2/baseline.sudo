// src: vvaharness/pipeline/stages/s2/baseline.py:26
_BASELINE_EVIDENCE_RX = "baseline:\s*(BL-[A-Z]+-\w+)"   // matched at the START of a threat's evidence
// src: vvaharness/pipeline/stages/s2/baseline.py:47-58
_BASELINE_TEXT_BY_ID = every BASELINES (id, text) pair, flattened to id -> text   // the description doubles as the category label
_COVERED_BY_ALIAS = { "BL-IAC-TLS": ["BL-WEB-A02"] }
_CATEGORY_STOPWORDS = ["the", "and", "for", "via", "not", "any", "use", "non", "its", "that", "this", "from", "into", "with", "owasp", "cwe"]
_MIN_CATEGORY_TERM_MATCHES = 2   // src: baseline.py:80 — one shared word is noise

// src: vvaharness/pipeline/stages/s2/baseline.py:29-31
fn _required_baselines(kinds):executor=code = every baseline id in BASELINES[k] for k in kinds
// src: vvaharness/pipeline/stages/s2/baseline.py:34-41
fn _baseline_audit(tm, kinds):executor=code {
  as_threat = ids captured by _BASELINE_EVIDENCE_RX at the start of each threat's evidence
  as_question = for each open question starting with "BL-": text before the first ":", trimmed
  return _required_baselines(kinds) - as_threat - as_question
}

// src: vvaharness/pipeline/stages/s2/baseline.py:61-68
fn _stem(word):executor=code = if (length(word) < 6) word else word without the first matching trailing "ed", "es" or "s"
// src: vvaharness/pipeline/stages/s2/baseline.py:71-76
fn _category_terms(bid):executor=code = stems of lowercase alphabetic words of length >= 3 in the BASELINES text for bid, excluding stopwords

// src: vvaharness/pipeline/stages/s2/baseline.py:83-100
fn _category_covered_elsewhere(bid, threats, disposed=[]):executor=code {
  own_terms = _category_terms(bid)
  alias_terms = union of _category_terms(alias) for alias in _COVERED_BY_ALIAS[bid] where alias in disposed
  terms = own_terms union alias_terms
  if (length(terms) < _MIN_CATEGORY_TERM_MATCHES) return false
  for each t in threats {
    matched = terms that occur as substrings of lowercase(t.threat)
    if (length(matched) >= 2 && (matched intersection own_terms) is non-empty) return true   // an alias cannot cover alone
  }
  return false
}
