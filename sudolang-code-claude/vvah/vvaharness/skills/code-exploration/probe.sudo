# vvaharness/skills/code-exploration/probe.sh

Inventory probe: counts every file by directory, lists the file classes a source-only sweep skips (templates, container and IaC, CI, manifests, dotfiles, SQL, static assets, central controls), then runs escape, transport, CI, header, debug, credential, route-registration and SQL pattern batteries.

Source: `vvaharness/skills/code-exploration/probe.sh` (lines 1-223)
Executor: code (POSIX shell; read-only greps; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/code-exploration/probe.sh [root]`, because the lens SKILL.md or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 6-18 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints `path:line` hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/code-exploration/probe.sh:20-223
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/code-exploration/probe.sh:20-46 — setup
  shell globbing off (set -f)
  require cd ROOT succeeds => { print "== PROBE ABORTED: cannot enter '<ROOT>' =="; exit 0 }   // line 23
  PRUNE = ".git .vvaharness node_modules __pycache__ .venv venv .tox .nox .mypy_cache .pytest_cache .ruff_cache .idea .gradle target"
  EXCL = one --exclude-dir per PRUNE entry
  TPL = *.html *.htm *.jinja *.jinja2 *.j2 *.jsx *.tsx *.vue *.erb *.jsp *.twig *.hbs *.handlebars *.ejs *.php *.mustache *.pug *.haml *.svelte *.astro
  SRC = *.py *.rb *.js *.ts *.jsx *.tsx *.java *.go *.php *.cs *.kt *.scala
  CFG = *.conf *.ini *.cfg *.yml *.yaml *.toml *.json *.properties *.env *.xml
  sec(label) { print a blank line and "== <label> ==" }
  emit(text) { if (text empty) print "(none)" else print text }
  print current directory and the pruned directory names

  // src: vvaharness/skills/code-exploration/probe.sh:49-159 — file classes, embedded python3 (only if python3 is on PATH)
  if (python3 available) {
    walk "." pruning PRUNE directories (recorded as pruned); collect every file path
    print "== INVENTORY (<files> files, <groups> directory groups; authoritative, not truncated) ==" then up to 40 directory groups by descending count; then "... (<n> more directory groups)"; then up to 12 pruned subtrees
    for each class in [
      "TEMPLATES AND VIEWS", "CONTAINER / ORCHESTRATION / IaC", "CI / CD", "DEPENDENCY MANIFESTS",
      "ENV / CREDENTIAL-SHAPED DOTFILES", "SQL / MIGRATIONS / SEEDS", "STATIC / BUILT ASSETS",
      "CENTRAL CONTROLS (__init__, base, middleware, utils)"
    ] {
      a file belongs if its base name matches one of the class's globs OR any parent directory name is in the class's directory list   // abstracted: glob and directory lists at lines 77-116
      print "== <class> (<count>) ==" then the first 15 paths, then "... (<n> more)"
    }
    print "== ALL DOTFILES (<n>) -- the namespace the graph walk skips entirely ==" with the first 20 paths having any dot-prefixed component
    print "== ZERO-BYTE FILES (<n>) ==" with the first 10
  } else {
    // src: vvaharness/skills/code-exploration/probe.sh:160-163
    print "INVENTORY (python3 unavailable -- grep fallback, text files only)" with the first 60 text file paths, sorted
  }
  // preserved: the inventory heading says "authoritative, not truncated" while only 40 directory groups and 15 files per class are printed (the counts themselves are complete).

  // Each battery below prints at most the first 20 grep hits ("head -n 20").
  // src: vvaharness/skills/code-exploration/probe.sh:166-167
  sec("ESCAPE DEFEATS IN TEMPLATES (each hit is its own finding site)")
  // pattern and arguments, verbatim: emit "$(grep -rEn '\|[[:space:]]*safe|safe_columns|autoescape[[:space:]]*=?[[:space:]]*(false|False|off)|\{\{\{|html_safe|\|[[:space:]]*raw|raw\(|dangerouslySetInnerHTML|v-html|innerHTML[[:space:]]*=' . $EXCL $TPL 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:169-170
  sec("SERVER-SIDE ESCAPE BYPASS / DYNAMIC TEMPLATE COMPILATION")
  // pattern and arguments, verbatim: emit "$(grep -rEn 'mark_safe|Markup\(|render_template_string|Template\(|from_string|autoescape[[:space:]]*=[[:space:]]*False|\.html_safe|raw\(|new Function|eval\(' . $EXCL $SRC 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:172-173
  sec("HANDLER -> TEMPLATE EDGES (each named template is now in scope)")
  // pattern and arguments, verbatim: emit "$(grep -rEn 'render_template|render_to_response|\.render\(|render_to_string|ERB\.new|TemplateResponse|@Template|ModelAndView' . $EXCL $SRC 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:175-176
  sec("TEMPLATE INHERITANCE EDGES (extends/include puts the parent in scope)")
  // pattern and arguments, verbatim: emit "$(grep -rEn '\{%[[:space:]]*(extends|include)|@extends|@include|<%=[[:space:]]*render' . $EXCL $TPL 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:178-189 — transport config, one line per file
  sec("TRANSPORT CONFIG -- per file, is there any TLS at all?")
  for each of the first 12 *.conf / *.ini / *.cfg / *.template files matching '^[[:space:]]*listen|server_name|ssl_certificate|uwsgi_pass|proxy_pass|upstream|\[uwsgi\]|bind[[:space:]]*=' {
    print "<file>: lines=<total> listen/bind=<count of '^[[:space:]]*listen|bind'> ssl|tls|https|443 tokens=<case-insensitive count of 'ssl|https|443|tls'>"
  }
  if (no such file) print "(none)"

  // src: vvaharness/skills/code-exploration/probe.sh:191-192
  sec("PUBLISHED PORTS AND ENTRYPOINTS (compose / Dockerfile / uwsgi)")
  // pattern and arguments, verbatim: emit "$(grep -rEn '^[[:space:]]*-?[[:space:]]*\"?[0-9]{2,5}:[0-9]{2,5}|EXPOSE|CMD|ENTRYPOINT|^module[[:space:]]*=|^wsgi-file|^[[:space:]]*command:' . $EXCL --include=Dockerfile --include=Dockerfile.* --include=docker-compose*.yml --include=docker-compose*.yaml --include=compose.y*ml --include=*.ini --include=Procfile 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:194-195
  sec("CI/CD RISK (pull_request_target, event interpolation, unpinned actions, secrets in run)")
  // pattern and arguments, verbatim: emit "$(grep -rEn 'pull_request_target|workflow_run|\$\{\{[[:space:]]*github\.event|uses:[[:space:]]*[^@]+@(main|master|v?[0-9]+)([[:space:]]|$)|secrets\.|GITHUB_TOKEN|permissions:' . $EXCL --include=*.yml --include=*.yaml --include=Jenkinsfile --include=Jenkinsfile.* 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:197-201 — header and control presence
  sec("SECURITY HEADER / CONTROL PRESENCE (count per header; 0 supports an absence claim)")
  for each term in [Content-Security-Policy, Strict-Transport-Security, X-Frame-Options, X-Content-Type-Options, Referrer-Policy, SameSite, HttpOnly, "secure[ _]*=[ _]*True", COOKIE_SECURE, csrf_token, CSRFProtect, csrf_exempt, before_request, login_required] {
    print "<term>: <number of files matching, case-insensitive> file(s)"
  }

  // src: vvaharness/skills/code-exploration/probe.sh:203-204
  sec("DEBUG / VERBOSE-LOGGING FLAGS")
  // pattern and arguments, verbatim: emit "$(grep -rEn '(debug|DEBUG)[[:space:]]*=[[:space:]]*(True|true|1)|echo[[:space:]]*=[[:space:]]*True|app\.run\(.*debug|FLASK_ENV|DJANGO_DEBUG|log_level.*debug' . $EXCL $SRC $CFG 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:206-207
  sec("CREDENTIAL-SHAPED ASSIGNMENTS IN CONFIG, DOTFILES AND SEEDS")
  // pattern and arguments, verbatim: emit "$(grep -rEn '(secret_key|SECRET_KEY|api[_-]?key|API[_-]?KEY|password|PASSWORD|passwd|token|TOKEN|private_key|aws_secret|client_secret)[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/+_.-]{4,}' . $EXCL $CFG --include=*.sql --include=.env --include=.env.* --include=*.env 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:209-210
  sec("HARDCODED SECRET LITERALS IN SOURCE (assigned to a quoted string, not a var read)")
  // pattern and arguments, verbatim: emit "$(grep -rEn '(secret_key|SECRET_KEY|secret|api_key|apiKey|API_KEY|password|passwd|passphrase|token|private_key|client_secret|salt|encryption_key)[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']{3,}["'"'"']' . $EXCL $SRC 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:212-213
  sec("NON-TRIVIAL __init__.py AND ROUTE/BLUEPRINT REGISTRATION")
  // pattern and arguments, verbatim: emit "$(grep -rEn 'register_blueprint|add_url_rule|include_router|app\.route|@bp\.|url_patterns|urlpatterns|@app\.|MethodView|APIRouter|^[[:space:]]+import[[:space:]]|^[[:space:]]+from[[:space:]]' . $EXCL --include=__init__.py --include=urls.py --include=routes.py --include=app.py --include=main.py 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:215-216
  sec("SQL CONSTRUCTION AND SEED CREDENTIALS")
  // pattern and arguments, verbatim: emit "$(grep -rEn '(^|[^_[:alnum:]])(text|execute|executemany|executescript|raw|rawQuery)\(|cursor\.|createQuery|(SELECT|INSERT INTO|UPDATE|DELETE FROM)[^;]*(\{|%s|\+|\|\||f\"|\$)|CREATE USER|GRANT ALL|IDENTIFIED BY' . $EXCL $SRC --include=*.sql 2>/dev/null | head -n 20)"
  // src: vvaharness/skills/code-exploration/probe.sh:218-223
  print "Every section above is deterministic and exhaustive for its pattern set."
  print "An empty section is a finding: '(none)' under CI/CD means there is no pipeline to audit."
  print "This probe locates; it does not conclude. Read each named file to its last line."
  exit 0
  // preserved: the closing text claims every section is "exhaustive for its pattern set", but each pattern battery is cut at 20 lines with no truncation notice.
}
