  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Send back per-tool-call fields the endpoint put outside the OpenAI schema (Chat Completions).\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Iterable\nfrom typing import Any, Final\n\nfrom langchain_core.messages import AIMessage, BaseMessage\nfrom langchain_core.outputs import ChatResult\nfrom langchain_openai import ChatOpenAI\n\nfrom vvaharness.util.counters import COUNTERS\n\n__all__ = [\n    \"TOOL_CALL_STATE_KEY\",\n    \"TOOL_STATE_CAPTURED_COUNTER\",\n    \"ToolCallStateChatOpenAI\",\n]\n\n#: Namespaced so a future upstream capture key cannot collide; never sent on the wire.\nTOOL_CALL_STATE_KEY: Final = \"__vvaharness_tool_call_state__\"\nTOOL_STATE_CAPTURED_COUNTER: Final = \"deepagents_tool_state_captured\"\n\n#: Keys langchain-openai already round-trips, plus `index`, which is never echoed.\n_WIRE_TOOL_CALL_KEYS: Final = frozenset({\"id\", \"type\", \"function\", \"custom\", \"index\"})\n\n\ndef _state_by_id(tool_calls: Iterable[dict[str, Any]]) -> dict[str, dict[str, Any]]:\n    state: dict[str, dict[str, Any]] = {}\n    for call in tool_calls:\n        fields = {k: v for k, v in call.items() if k not in _WIRE_TOOL_CALL_KEYS and v is not None}\n        if call.get(\"id\") and fields:\n            state[call[\"id\"]] = fields\n    return state\n\n\ndef _choice_tool_calls(choice: Any) -> list[dict[str, Any]]:\n    if isinstance(choice, dict):\n        return (choice.get(\"message\") or {}).get(\"tool_calls\") or []\n    return [{\"id\": call.id, **(call.model_extra or {})} for call in choice.message.tool_calls or ()]\n\n\ndef _replay(state: dict[str, dict[str, Any]], sent: dict[str, Any]) -> None:\n    for call in sent.get(\"tool_calls\") or ():\n        for key, value in state.get(call.get(\"id\"), {}).items():\n            call.setdefault(key, value)\n\n\ndef _replay_all(messages: list[BaseMessage], wire: list[dict[str, Any]]) -> None:\n    if len(messages) != len(wire):\n        return\n    for message, sent in zip(messages, wire, strict=True):\n        state = message.additional_kwargs.get(TOOL_CALL_STATE_KEY)\n        if state:\n            _replay(state, sent)\n\n\nclass ToolCallStateChatOpenAI(ChatOpenAI):\n    \"\"\"ChatOpenAI that sends the extra fields the endpoint put on a tool call back on that call.\"\"\"\n\n    # Non-stream only: the route never streams, and merge_dicts would corrupt this dict.\n    def _create_chat_result(\n        self, response: Any, generation_info: dict | None = None,\n    ) -> ChatResult:\n        result = super()._create_chat_result(response, generation_info)\n        choices = (\n            response.get(\"choices\") if isinstance(response, dict) else response.choices\n        ) or ()\n        for generation, choice in zip(result.generations, choices, strict=False):\n            state = _state_by_id(_choice_tool_calls(choice))\n            if state and isinstance(generation.message, AIMessage):\n                generation.message.additional_kwargs[TOOL_CALL_STATE_KEY] = state\n                COUNTERS.bump(TOOL_STATE_CAPTURED_COUNTER)\n        return result\n\n    def _get_request_payload(\n        self, input_: Any, *, stop: list[str] | None = None, **kwargs: Any,\n    ) -> dict:\n        payload = super()._get_request_payload(input_, stop=stop, **kwargs)\n        wire = payload.get(\"messages\")\n        if isinstance(wire, list):\n            _replay_all(self._convert_input(input_).to_messages(), wire)\n        return payload\n",
