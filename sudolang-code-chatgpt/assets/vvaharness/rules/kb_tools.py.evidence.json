  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"The CWE knowledge base as a fact tool, composed via ``compose_tool_builders``.\"\"\"\nfrom __future__ import annotations\n\nimport threading\nfrom collections.abc import Sequence\n\nfrom langchain_core.tools import BaseTool, tool\n\nfrom vvaharness.backends.harness import StreamingOptions\nfrom vvaharness.rules import CweKB\nfrom vvaharness.util.counters import COUNTERS\n\nKB_TOOL_NAMES: tuple[str, ...] = (\"CweGuidance\",)\n\n_unknown_cwe_lock = threading.Lock()\n_unknown_cwe_ids: set[str] = set()\n\n\ndef _note_unknown_cwe(cwe_id: str) -> None:\n    \"\"\"Record *cwe_id* among this run's KB misses, as the comma-joined `note` fact.\"\"\"\n    # Sessions share this process's tool instance (possibly concurrently): the id set, not the\n    # last single id, is what distinguishes a KB gap from a model inventing ids.\n    with _unknown_cwe_lock:\n        if cwe_id in _unknown_cwe_ids:\n            return\n        _unknown_cwe_ids.add(cwe_id)\n        ids = \",\".join(sorted(_unknown_cwe_ids))\n    COUNTERS.note(\"s4_cwe_guidance_unknown_ids\", ids)\n\n\n@tool\ndef CweGuidance(cwe_id: str) -> dict:\n    \"\"\"Sanitizers, non-sanitizers and FP checks known for one CWE id, e.g. 'CWE-89'.\"\"\"\n    # Without this counter, a flat FP rate and \"never consulted\" look the same.\n    COUNTERS.bump(\"s4_cwe_guidance_called\")\n    entry = CweKB.load().for_cwes([cwe_id])\n    # A miss still returns every key, so the dict is truthy either way; only a hit fills `cwe`\n    if not entry.get(\"cwe\"):\n        COUNTERS.bump(\"s4_cwe_guidance_unknown_cwe\")\n        _note_unknown_cwe(cwe_id)\n    return entry\n\n\ndef build_kb_tool_builder():\n    \"\"\"Return a ``ToolBuilder`` contributing ``CweGuidance`` when fact-gated in.\"\"\"\n\n    def _build(options: StreamingOptions, *, allowed_tools: Sequence[str] | None = None) -> list[BaseTool]:\n        if \"CweGuidance\" not in set(getattr(options, \"fact_tools\", ()) or ()):\n            return []\n        return [CweGuidance]\n\n    return _build\n\n\n__all__ = [\"KB_TOOL_NAMES\", \"CweGuidance\", \"build_kb_tool_builder\"]\n",
