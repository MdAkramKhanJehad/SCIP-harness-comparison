// file: vvaharness/backends/harness/deepagents/options/tool_call_state.py
// ToolCallStateChatOpenAI (Chat Completions only): captures per-tool-call fields an endpoint put outside the OpenAI
// schema and sends them back on the same call when the conversation is replayed (avoids VVAH-E006 rejections).

@executedBy(CODE) @role(backend)
class ToolCallState {

    // Namespaced capture key, never sent on the wire.
    String toolCallStateKey() {
        return "__vvaharness_tool_call_state__";                                                         // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:34
    }

    // Per call id: every top-level field outside the wire keys langchain already round-trips (+ index, never echoed).
    Map<String, Map<String, Object>> stateById(List<Map<String, Object>> toolCalls, Theta θ) {
        Map<String, Map<String, Object>> state = new Map();
        for (Map<String, Object> call : toolCalls) {                                                     // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:43
            Map<String, Object> fields = call.filter((k, v) -> !θ["code.backends.harness.deepagents.options.tool_call_state.wire_tool_call_keys"].contains(k) && v != null); // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:44
            if (call.get("id") != null && !fields.isEmpty()) state.put(call.get("id"), fields);          // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:45
        }
        return state;
    }

    List<Map<String, Object>> choiceToolCalls(Object choice) {
        if (choice instanceof Map) return choice.get("message").getOrDefault("tool_calls", List.of());   // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:52
        return choice.message.toolCalls.map(c -> Map.of("id", c.id).plus(c.modelExtra));                // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:53
    }

    void replay(Map<String, Map<String, Object>> state, Map<String, Object> sent) {
        for (Map<String, Object> call : sent.getOrDefault("tool_calls", List.of())) {                    // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:57
            for (String key : state.getOrDefault(call.get("id"), Map.of()).keySet()) call.putIfAbsent(key, state.get(call.get("id")).get(key)); // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:59
        }
    }

    void replayAll(List<Message> messages, List<Map<String, Object>> wire) {
        if (messages.size() != wire.size()) return;                                                      // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:63
        for (int i = 0; i < messages.size(); i++) {                                                      // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:65
            Object state = messages.get(i).additionalKwargs.get(toolCallStateKey());                     // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:66
            if (state != null) replay(state, wire.get(i));                                               // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:68
        }
    }
}

@executedBy(CODE) @role(backend)
class ToolCallStateChatOpenAI {
    // Non-stream only: the route never streams.
    ChatResult createChatResult(Object response, Map<String, Object> generationInfo, Theta θ) {
        ChatResult result = superCreateChatResult(response, generationInfo);                             // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:78
        List<Object> choices = response instanceof Map ? response.get("choices") : response.choices;     // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:79
        for (int i = 0; i < min(result.generations.size(), choices.size()); i++) {                       // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:82
            Map state = ToolCallState.stateById(ToolCallState.choiceToolCalls(choices.get(i)), θ);       // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:83
            if (!state.isEmpty() && result.generations.get(i).message instanceof AIMessage) {            // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:84
                result.generations.get(i).message.additionalKwargs.put(ToolCallState.toolCallStateKey(), state); // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:85
                COUNTERS.bump("deepagents_tool_state_captured");                                         // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:86
            }
        }
        return result;
    }

    Map<String, Object> getRequestPayload(Object input, List<String> stop) {
        Map<String, Object> payload = superGetRequestPayload(input, stop);                               // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:92
        Object wire = payload.get("messages");
        if (wire instanceof List) ToolCallState.replayAll(convertInput(input).toMessages(), wire);       // src: vvaharness/backends/harness/deepagents/options/tool_call_state.py:95
        return payload;
    }
}
