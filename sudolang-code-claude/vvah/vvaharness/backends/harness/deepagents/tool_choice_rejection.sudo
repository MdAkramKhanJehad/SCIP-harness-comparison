# vvaharness/backends/harness/deepagents/tool_choice_rejection.py

Classifies and remembers the Anthropic models that reject a forced tool choice ("tool"/"any") with HTTP 400. The set is seeded with known rejecters and grows at runtime for the whole process; callers then stop forcing for those models.

Source: `vvaharness/backends/harness/deepagents/tool_choice_rejection.py` (lines 1-80)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/force_verdict_only.sudo` ForceVerdictOnly._force; `vvaharness/backends/harness/deepagents/client.sudo` (forced-tool-choice fallback)

// src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:29-40
_HTTP_BAD_REQUEST = 400
_MARKERS = ["tool_choice", "not supported for this model"]   // both must appear (lower-cased) in the error text
KNOWN_UNSUPPORTED = { "claude-opus-5-5" }   // seeded so neither S10 nor S11 pays for the first failed call
UNSUPPORTED_MODELS = copy of KNOWN_UNSUPPORTED   // process-wide, learned at runtime

// src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:43-51
fn is_tool_choice_unsupported_rejection(exc):executor=code {
  for each link in exception_chain(exc) {
    if (link.status_code == 400 && every marker in _MARKERS is in lower(link.message)) return true
  }
  stderr = lower(exc.stderr or "")   // the cli route's subprocess error
  return "400" in stderr && every marker in _MARKERS is in stderr
}

// src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:54-67
fn rejected_model(exc):executor=code {
  // The "model" field of the JSON request body kept on any link of the exception chain (anthropic APIStatusError keeps the httpx request), else null
}

// src: vvaharness/backends/harness/deepagents/tool_choice_rejection.py:70-80
fn learn_tool_choice_unsupported(...model_ids):executor=code {
  for each model_id in model_ids {
    UNSUPPORTED_MODELS.add(model_id)
    COUNTERS.bump("deepagents_tool_choice_unsupported_fallback")
    warn once per model_id: "WARN [deepagents]: model '$model_id' rejected a forced tool_choice (\"tool\"/\"any\") outright — retrying without forcing"
  }
}
