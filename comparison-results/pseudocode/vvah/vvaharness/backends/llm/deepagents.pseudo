    /** The chained dispatch adaptTools installs (nested function _dispatch): the adapter stack first, then the caller's own. */
    @src("vvaharness/backends/llm/deepagents.py:1147")
    Object dispatchChained(Object stack, Function callerDispatch, String name, Map args, String tag) {
