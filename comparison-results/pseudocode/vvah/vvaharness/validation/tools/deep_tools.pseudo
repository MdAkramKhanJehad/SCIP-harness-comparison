// file: vvaharness/validation/tools/deep_tools.py
// DeepAgents tool-builder for S11: the generic reader tools plus each deterministic fact tool whose
// name is in the allow-list.

@executedBy(CODE) @role(tool) @stage("S11")
class DeepTools {

    List<Tool> factTools(StreamingOptions options, Set<String> allowed) {
        Path workspace = options.cwd;                                                                // src: vvaharness/validation/tools/deep_tools.py:39
        List<Tool> tools = new List();
        if (allowed.contains("DiffTouched")) tools.add(new Tool("DiffTouched", fp -> DiffFacts.diffTouched(workspace, fp))); // src: vvaharness/validation/tools/deep_tools.py:42
        if (allowed.contains("ChangedLines")) tools.add(new Tool("ChangedLines", fp -> DiffFacts.changedLines(workspace, fp))); // src: vvaharness/validation/tools/deep_tools.py:50
        if (allowed.contains("DiffImpactMap")) tools.add(new Tool("DiffImpactMap", () -> FactSpecs.impact(workspace))); // files_changed + trust_boundary_touched  // src: vvaharness/validation/tools/deep_tools.py:58
        if (allowed.contains("PatternScan")) tools.add(new Tool("PatternScan", ps -> PatternScanner.patternScan(workspace, ps))); // src: vvaharness/validation/tools/deep_tools.py:70
        if (allowed.contains("TestInventory")) tools.add(new Tool("TestInventory", () -> ToolsTestInventory.testInventory(workspace))); // src: vvaharness/validation/tools/deep_tools.py:82
        return tools;
    }

    List<Tool> buildValidationTools(StreamingOptions options, List<String> allowedTools, Theta θ) {
        List<Tool> readerTools = DeepagentsTools.buildTools(options, allowedTools, θ);               // src: vvaharness/validation/tools/deep_tools.py:99
        Set<String> allowed = allowedTools != null ? Set.copyOf(allowedTools) : Set.of();            // None -> no fact tools  // src: vvaharness/validation/tools/deep_tools.py:100
        return readerTools.concat(factTools(options, allowed));                                      // src: vvaharness/validation/tools/deep_tools.py:101
    }
}
