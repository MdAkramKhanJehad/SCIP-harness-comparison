// file: vulnhunter-agent/agent/audit.py
// JSONL audit-event and findings-event streams (local append-only files, optional stdout mirror).
// Every string is credential-redacted, None fields dropped, free text capped; ids are monotonic ULIDs.

@executedBy(CODE) @role(types) @stage("agent")
record AuditPaths(Path events, Path findings) { }

@executedBy(CODE) @role(types) @stage("agent")
record AuditWriteError(String message) { }

@executedBy(CODE) @role(io) @stage("agent")
class Audit {

    // ---- ULID / ids / time
    // AuditPaths.from_config classmethod: expanduser then resolve both configured paths
    AuditPaths fromConfig(String eventsPath, String findingsPath) {
        return new AuditPaths(Path(eventsPath).expand().resolve(), Path(findingsPath).expand().resolve());  // src: vulnhunter-agent/agent/audit.py:176
    }

    String newUlid() {
        return UlidGenerator.next();                                                                // module-level shared generator // src: vulnhunter-agent/agent/audit.py:105
    }

    String eventTimeNow() {
        return utcNow().format("yyyy-MM-ddTHH:mm:ss.SSSZ");                                         // millisecond precision // src: vulnhunter-agent/agent/audit.py:126
    }

    String reportIdFrom(Path resultsDir) {
        return resultsDir.name;                                                                     // basename of *_VULNHUNT_RESULTS_* // src: vulnhunter-agent/agent/audit.py:135
    }

    // finding_id_for: <report_id>:VULN-NNN, zero-padded; malformed ids coerced to "unknown".
    String findingIdFor(String reportId, String vulnId) {
        if (!vulnIdRe().matches(vulnId or "")) return reportId + ":unknown";                        // src: vulnhunter-agent/agent/audit.py:149
        int n = int(vulnId.split("-")[1]);                                                          // src: vulnhunter-agent/agent/audit.py:154
        return reportId + ":" + format("VULN-%03d", n);                                             // src: vulnhunter-agent/agent/audit.py:155
    }

    String eventId(String descriptor) {
        return newUlid() + ":" + descriptor;                                                        // src: vulnhunter-agent/agent/audit.py:160
    }

    // _VULN_ID_RE
    Regex vulnIdRe() {
        return Regex("^VULN-[0-9]+$");                                                              // src: vulnhunter-agent/agent/audit.py:699
    }

    String shortVuln(String findingId) {
        if (findingId == null || findingId == "") return "unknown";                                 // src: vulnhunter-agent/agent/audit.py:689
        String tail = findingId.rsplit(":")[-1];                                                    // src: vulnhunter-agent/agent/audit.py:691
        return vulnIdRe().matches(tail) ? tail : "unknown";                                         // anti-injection into event_id // src: vulnhunter-agent/agent/audit.py:692
    }

    // _truncate_freetext: notes / evidence_text capped (_FREETEXT_MAX) with a visible marker.
    String truncateFreetext(String value, Theta θ) {
        if (value == null || value.length() <= θ["code.agent.audit.freetext_max_chars"]) return value; // src: vulnhunter-agent/agent/audit.py:712
        String marker = "...<truncated>";
        return value.take(θ["code.agent.audit.freetext_max_chars"] - marker.length()) + marker;      // src: vulnhunter-agent/agent/audit.py:715
    }

    // ---- serialization
    String serialize(Map record, Theta θ) {
        Object cleaned = clean(record, θ);                                                          // src: vulnhunter-agent/agent/audit.py:352
        return json.dumps(cleaned, true, ",", ":") + "\n";                                          // sorted keys, compact // src: vulnhunter-agent/agent/audit.py:353
    }

    Object clean(Object value, Theta θ) {
        if (value instanceof Map) {
            Map out = new Map();
            for (Entry e : value.entries()) {
                if (e.value == null) continue;                                                      // drop None // src: vulnhunter-agent/agent/audit.py:361
                out.put(e.key, clean(e.value, θ));
            }
            return out;
        }
        if (value instanceof List) return value.map(v -> clean(v, θ));                              // src: vulnhunter-agent/agent/audit.py:365
        if (value instanceof String) return Url.redact(value, θ);                                   // src: vulnhunter-agent/agent/audit.py:368
        return value;
    }

    Map commonScanFields(String appId, String actor, String repoSlug, String reportId) {
        return Map.of("event_time", eventTimeNow(), "repo_slug", repoSlug or null, "app_id", appId, "report_id", reportId or null, "actor", actor or null); // src: vulnhunter-agent/agent/audit.py:385
    }

    // ---- audit event builders
    Map buildScanStarted(String appId, String actor, String repoSlug, String reportId, String modelVersion, String targetSha, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:415
        r.putAll("event_id", eventId("scan_started"), "event_type", "scan_started", "model_version", modelVersion or null, "target_sha", targetSha or null, "notes", truncateFreetext(notes, θ) or null); // src: vulnhunter-agent/agent/audit.py:418
        return r;
    }

    // Issues-stage tier escalation only; the scanner itself never falls back.
    Map buildModelFallback(String appId, String actor, String fromModel, String toModel, String stage, String reason, String reportId, Theta θ) {
        Map r = commonScanFields(appId, actor, "", reportId);                                       // src: vulnhunter-agent/agent/audit.py:442
        r.putAll("event_id", eventId("model_fallback"), "event_type", "model_fallback", "from_model", fromModel, "to_model", toModel, "stage", stage or null, "notes", truncateFreetext(reason, θ) or null); // src: vulnhunter-agent/agent/audit.py:443
        return r;
    }

    // Final tier also failed; caller raises and the run exits 4.
    Map buildModelUnavailable(String appId, String actor, String fromModel, String stage, String reason, String reportId, Theta θ) {
        Map r = commonScanFields(appId, actor, "", reportId);                                       // src: vulnhunter-agent/agent/audit.py:465
        r.putAll("event_id", eventId("model_unavailable"), "event_type", "model_unavailable", "from_model", fromModel, "stage", stage or null, "notes", truncateFreetext(reason, θ) or null); // src: vulnhunter-agent/agent/audit.py:466
        return r;
    }

    Map buildScanCompleted(String appId, String actor, String repoSlug, String reportId, String modelVersion, String targetSha, Integer findingsCount, Double scanCostUsd, Integer scanDurationSeconds, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:495
        r.putAll("event_id", eventId("scan_completed"), "event_type", "scan_completed", "model_version", modelVersion or null, "target_sha", targetSha or null,
                 "findings_count", findingsCount, "scan_cost_usd", scanCostUsd, "scan_duration_seconds", scanDurationSeconds, "notes", truncateFreetext(notes, θ) or null); // failure: notes "failed: reason" // src: vulnhunter-agent/agent/audit.py:498
        return r;
    }

    Map buildVerifyStarted(String appId, String actor, String repoSlug, String reportId, String modelVersion, String targetSha, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:522
        r.putAll("event_id", eventId("verify_started"), "event_type", "verify_started", "model_version", modelVersion or null, "target_sha", targetSha or null, "notes", truncateFreetext(notes, θ) or null); // src: vulnhunter-agent/agent/audit.py:525
        return r;
    }

    // verdict PASS -> to_status RESOLVED; FAIL -> REOPENED
    Map buildVerifyDecision(String appId, String actor, String repoSlug, String reportId, String findingId, String verdict, String toStatus, String fromStatus, String evidenceText, String modelVersion, String targetSha, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:556
        r.putAll("event_id", eventId("verify_decision:" + shortVuln(findingId)), "event_type", "verify_decision", "finding_id", findingId or null, "verdict", verdict or null,
                 "from_status", fromStatus or null, "to_status", toStatus or null, "evidence_text", truncateFreetext(evidenceText, θ) or null,
                 "model_version", modelVersion or null, "target_sha", targetSha or null, "notes", truncateFreetext(notes, θ) or null); // src: vulnhunter-agent/agent/audit.py:559
        return r;
    }

    Map buildVerifyCompleted(String appId, String actor, String repoSlug, String reportId, String modelVersion, String targetSha, Integer findingsCount, Integer scanDurationSeconds, Double scanCostUsd, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:591
        r.putAll("event_id", eventId("verify_completed"), "event_type", "verify_completed", "model_version", modelVersion or null, "target_sha", targetSha or null,
                 "findings_count", findingsCount, "scan_cost_usd", scanCostUsd, "scan_duration_seconds", scanDurationSeconds, "notes", truncateFreetext(notes, θ) or null); // src: vulnhunter-agent/agent/audit.py:594
        return r;
    }

    Map buildFindingOpened(String appId, String actor, String repoSlug, String reportId, String findingId, String githubIssueUrl, String fromStatus, String toStatus, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:620
        r.putAll("event_id", eventId("finding_opened:" + shortVuln(findingId)), "event_type", "finding_opened", "finding_id", findingId or null,
                 "from_status", fromStatus or null, "to_status", toStatus or "OPEN", "github_issue_url", githubIssueUrl or null, "notes", truncateFreetext(notes, θ) or null); // src: vulnhunter-agent/agent/audit.py:623
        return r;
    }

    // to_status CLOSED (happy path / append) or OPEN (close-back PATCH failed); notes disambiguate.
    Map buildCleanScanNotified(String appId, String actor, String repoSlug, String reportId, String githubIssueUrl, String modelVersion, String targetSha, String toStatus, String notes, Theta θ) {
        Map r = commonScanFields(appId, actor, repoSlug, reportId);                                 // src: vulnhunter-agent/agent/audit.py:667
        r.putAll("event_id", eventId("clean_scan_notified"), "event_type", "clean_scan_notified", "to_status", toStatus or null, "github_issue_url", githubIssueUrl or null,
                 "model_version", modelVersion or null, "target_sha", targetSha or null, "notes", truncateFreetext(notes, θ) or null); // src: vulnhunter-agent/agent/audit.py:670
        return r;
    }

    // ---- findings-event builder
    Map buildFindingEvent(String appId, String repoSlug, String reportId, String findingId, String vulnId, String title, String cwe, String severity, String status, String location, String rootCause, String entryPoint, String dataFlow, String exploitTestCmd, String proposedFixStrategy, String proposedFixFiles, String proposedFixWhy, String pocFile, String exploitTestFile, String githubIssueUrl, boolean opened, Map repoProperties) {
        String now = eventTimeNow();                                                                // src: vulnhunter-agent/agent/audit.py:761
        String safeVuln = vulnIdRe().matches(vulnId or "") ? vulnId : shortVuln(findingId);         // src: vulnhunter-agent/agent/audit.py:762
        Map record = Map.of(
            "event_id", eventId("finding_state:" + safeVuln), "event_time", now, "repo_slug", repoSlug or null, "app_id", appId, "report_id", reportId,
            "opened_at", opened ? now : null,                                                       // only on the initial emission // src: vulnhunter-agent/agent/audit.py:769
            "transitioned_at", now, "github_issue_url", githubIssueUrl or null, "id", findingId, "title", title or "",
            "cwe", cwe or "CWE-UNKNOWN",                                                            // src: vulnhunter-agent/agent/audit.py:774
            "severity", (severity or "informational").lower(),                                      // default severity // src: vulnhunter-agent/agent/audit.py:775
            "status", status or null, "location", location or "", "root_cause", rootCause or "", "entry_point", entryPoint or null, "data_flow", dataFlow or null,
            "exploit_test", exploitTestCmd or null,
            "proposed_fix", Map.of("strategy", proposedFixStrategy or "", "files_to_change", proposedFixFiles or "", "why", proposedFixWhy or ""), // src: vulnhunter-agent/agent/audit.py:782
            "files", Map.of("poc", pocFile or null, "exploit_test", exploitTestFile or null));       // src: vulnhunter-agent/agent/audit.py:787
        for (Entry e : (repoProperties or Map.of()).entries()) {
            if (e.value != "") record.put(e.key, e.value);                                          // blank operator tags dropped // src: vulnhunter-agent/agent/audit.py:793
        }
        return record;
    }

    // writer_from_config: null writer == audit off.
    AuditWriter writerFromConfig(Theta θ, AuditConfig auditConfig) {
        if (!θ["audit.enabled"]) return null;                                                       // src: vulnhunter-agent/agent/audit.py:811
        AuditPaths paths = fromConfig(auditConfig.eventsPath, auditConfig.findingsPath); // events_path / findings_path: no knob // src: vulnhunter-agent/agent/audit.py:813
        return new AuditWriter(paths, auditConfig.stdout, auditConfig.strict);                      // stdout / strict: no knob // src: vulnhunter-agent/agent/audit.py:816
    }
}

@executedBy(CODE) @role(types) @stage("agent")
class UlidGenerator {
    // 48-bit ms timestamp + 80-bit random tail, Crockford base32; monotonic within a millisecond.
    long lastMs = 0;
    long lastRand = 0;

    String next() {
        long nowMs = time() * 1000;                                                                 // src: vulnhunter-agent/agent/audit.py:72
        long rand;
        if (nowMs <= lastMs) {                                                                      // same ms or clock went back // src: vulnhunter-agent/agent/audit.py:73
            nowMs = lastMs;
            rand = (lastRand + 1) & mask80;                                                         // bump tail // src: vulnhunter-agent/agent/audit.py:78
        } else {
            rand = secureRandom(10);                                                                // src: vulnhunter-agent/agent/audit.py:80
        }
        lastMs = nowMs; lastRand = rand;
        return encodeMs(nowMs) + encodeRand(rand);                                                  // src: vulnhunter-agent/agent/audit.py:83
    }

    String encodeMs(long ms) {
        return crockford32(ms, 10);                                                                 // src: vulnhunter-agent/agent/audit.py:88
    }

    String encodeRand(long rand) {
        return crockford32(rand, 16);                                                               // src: vulnhunter-agent/agent/audit.py:97
    }
}

@executedBy(CODE) @role(io) @stage("agent")
class AuditWriter {
    // Appends one compact JSON line per record; non-strict mode logs the first error per stream and silences the rest.
    boolean closed = false;
    boolean eventsFailed = false;
    boolean findingsFailed = false;

    void emitAudit(Map record, Theta θ) {
        emit("events", record, θ);                                                                  // src: vulnhunter-agent/agent/audit.py:220
    }

    void emitFinding(Map record, Theta θ) {
        emit("findings", record, θ);                                                                // src: vulnhunter-agent/agent/audit.py:223
    }

    void close() {
        if (closed) return;                                                                         // src: vulnhunter-agent/agent/audit.py:226
        for (Handle fh : List.of(eventsFh, findingsFh)) {
            if (fh == null) continue;
            try { fh.flush(); fh.close(); } catch (OSError e) { log.warning("audit close failed"); } // src: vulnhunter-agent/agent/audit.py:231
        }
        closed = true;                                                                              // never reopen // src: vulnhunter-agent/agent/audit.py:238
    }

    void emit(String stream, Map record, Theta θ) {
        if (closed) {                                                                               // src: vulnhunter-agent/agent/audit.py:243
            if (strict) throw new AuditWriteError("emit called after close()");                     // src: vulnhunter-agent/agent/audit.py:247
            return;
        }
        String line;
        try {
            line = Audit.serialize(record, θ);                                                      // src: vulnhunter-agent/agent/audit.py:252
        } catch (TypeError e) {
            handleError(stream, "serialize failed");                                                // src: vulnhunter-agent/agent/audit.py:254
            return;
        }
        if (stdout) {
            try { System.out.write(line); } catch (OSError e) { log.warning("stdout mirror failed"); } // best effort // src: vulnhunter-agent/agent/audit.py:257
        }
        Handle fh;
        try {
            fh = getHandle(stream);                                                                 // src: vulnhunter-agent/agent/audit.py:266
        } catch (OSError e) {
            handleError(stream, "open failed");                                                     // src: vulnhunter-agent/agent/audit.py:268
            return;
        }
        try {
            fh.write(line); fh.flush();                                                             // src: vulnhunter-agent/agent/audit.py:272
        } catch (OSError e) {
            handleError(stream, "write failed");                                                    // src: vulnhunter-agent/agent/audit.py:275
            return;
        }
        if (θ["code.agent.audit.fsync_each_record"]) {
            try {
                fsync(fh);                                                                          // src: vulnhunter-agent/agent/audit.py:286
            } catch (OSError e) {
                if (strict) throw new AuditWriteError("fsync failed");                              // src: vulnhunter-agent/agent/audit.py:288
                // warn once per stream; stream not marked failed
            }
        }
    }

    Handle getHandle(String stream) {
        if (stream == "events") { if (eventsFh == null) eventsFh = openAppend(paths.events); return eventsFh; }         // src: vulnhunter-agent/agent/audit.py:303
        if (stream == "findings") { if (findingsFh == null) findingsFh = openAppend(paths.findings); return findingsFh; } // src: vulnhunter-agent/agent/audit.py:307
        throw new ValueError("unknown audit stream");                                               // src: vulnhunter-agent/agent/audit.py:311
    }

    void handleError(String stream, String msg) {
        if (strict) throw new AuditWriteError(msg);                                                 // src: vulnhunter-agent/agent/audit.py:314
        boolean already = failed(stream);
        setFailed(stream, true);
        if (!already) log.error("audit " + stream + ": " + msg + " (further errors silenced)");    // src: vulnhunter-agent/agent/audit.py:319
    }

    // _open_append: owner-only perms (CWE-732), parent dir 0o700, line-buffered append.
    Handle openAppend(Path path, Theta θ) {
        path.parent.mkdirs();                                                                       // src: vulnhunter-agent/agent/audit.py:333
        try { chmod(path.parent, θ["code.agent.audit.dir_mode"]); } catch (OSError e) { }           // best effort // src: vulnhunter-agent/agent/audit.py:335
        int fd = osOpen(path, O_WRONLY | O_APPEND | O_CREAT, θ["code.agent.audit.file_mode"]);      // src: vulnhunter-agent/agent/audit.py:339
        try { chmod(path, θ["code.agent.audit.file_mode"]); } catch (OSError e) { }                 // src: vulnhunter-agent/agent/audit.py:341
        return fdopen(fd, "a", 1);                                                                  // line-buffered // src: vulnhunter-agent/agent/audit.py:347
    }
}
