Called from: `vvaharness/validation/io/case_writeback.sudo` build_verdict, `vvaharness/validation/io/result_collector.sudo` _one

// src: vvaharness/validation/io/_host_score.py:36-40
_NO_GATES = "no host-verified gates were available for this finding; the agent's self-reported verdict is not authoritative, so no score is recorded"

// src: vvaharness/validation/io/_host_score.py:123-153
fn verdict_for(output_finding?, gates?, provenance, policy?):executor=code {
  said = _narrative(output_finding)   // what the agent said: conditions_for_full_fix, recommendations, justification
  if (!gates) {
    return Verdict { decision: INCONCLUSIVE, rationale: _NO_GATES, score: null,
      conditions: said.conditions, recommendations: said.recommendations, engine_rationale: said.rationale, produced_by: provenance }
  }
  scored = scoring.score_fix(gates, policy)
  return Verdict {
    decision: scored.decision,
    rationale: scored.justification,   // host text, not the agent's
    score: if (scored.decision == INCONCLUSIVE) null else scored.raw_score,   // "A refusal inside the engine also means "no number", not zero confidence."
    gates: scored.gates,
    conditions: said.conditions, recommendations: said.recommendations, engine_rationale: said.rationale,
    produced_by: provenance
  }
  // "Return the authoritative verdict: host numbers, agent narrative, never fix_status."
}

// src: vvaharness/validation/io/_host_score.py:108-120
fn conformant(verdict, policy?):executor=code {
  if (policy == null) return verdict
  missing = policy.missing_from(names of verdict.gates)   // compared after normalise_gate_name on both sides
  if (!missing) return verdict
  return verdict with { decision: INCONCLUSIVE, score: null, rationale: "verdict does not answer required gate(s): <missing>; not scored" }
  // "Harness acceptance check: a verdict silent on a required gate downgrades to INCONCLUSIVE."
}

// src: vvaharness/validation/io/_host_score.py:43-86
fn load_synthesized_gates(workspace_dir):executor=code {
  text = read "$workspace_dir/synthesized_gates.json"; if (unreadable) return {}   // "the normal, silent fail-closed case"
  data = parse JSON
  require data parses => warn "present but unparseable; failing closed"; return {}
  require data is an array => warn "is not a JSON array; failing closed"; return {}
  return _gates_by_tracking_id(data)
}

// src: vvaharness/validation/io/_host_score.py:64-75
fn _gates_by_tracking_id(data):executor=code {
  for each entry in data {
    if (entry is a mapping && entry.gates is a list) gates_by_id[string(entry.tracking_id || "")] = entry.gates   // a later entry with the same id replaces an earlier one
    else dropped += 1
  }
  if (dropped) warn "dropped <n> malformed entries"
  return gates_by_id
}

// src: vvaharness/validation/io/_host_score.py:97-105
fn _narrative(output_finding?):executor=code {
  if (output_finding == null) return { conditions: [], recommendations: [], rationale: "" }
  return { conditions: output_finding.conditions_for_full_fix, recommendations: output_finding.recommendations, rationale: output_finding.justification || "" }
}
