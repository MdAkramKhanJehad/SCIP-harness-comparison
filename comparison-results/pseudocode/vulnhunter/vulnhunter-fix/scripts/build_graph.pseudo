// file: vulnhunter-fix/scripts/build_graph.py
// CLI wrapper around the code graph: builds (or loads cached) graph.json for a repo and, when --findings is
// given, writes one graph_context/<VULN>.json sidecar per finding (callers of sink, blast radius, confidence).

@executedBy(CODE) @role(tool) @stage("fix")
class BuildGraph {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    String sinkSymbolFromFinding(Map finding) {
        String loc = finding.getOr("location", finding.getOr("sink", ""));                               // src: vulnhunter-fix/scripts/build_graph.py:54
        if (loc.isEmpty()) {
            List<String> files = finding.getOr("files", List.of());                                       // src: vulnhunter-fix/scripts/build_graph.py:57
            if (files.isEmpty()) return null;                                                             // src: vulnhunter-fix/scripts/build_graph.py:59
            loc = files.get(0);                                                                           // src: vulnhunter-fix/scripts/build_graph.py:60
        }
        return loc.strip();
    }

    Map buildSidecar(GraphQuery query, Map finding, String docBackend, String docVersion, Theta θ) {
        String vulnId = finding.getOr("id", finding.getOr("vuln_id", ""));                               // src: vulnhunter-fix/scripts/build_graph.py:66
        Match m = Regex.search("VULN-\\d+ (case-insensitive)", vulnId);                                  // src: vulnhunter-fix/scripts/build_graph.py:39
        if (m == null) throw new ValueError("finding missing VULN-N id");                                // src: vulnhunter-fix/scripts/build_graph.py:69
        vulnId = m.group(0).upper();
        String sink = sinkSymbolFromFinding(finding);                                                     // src: vulnhunter-fix/scripts/build_graph.py:72
        List<String> callers = List.of();
        List<String> blast = List.of();
        if (sink != null) {
            try {
                callers = GraphQuery.callersOf(sink, θ).filter(c -> c != null);                            // src: vulnhunter-fix/scripts/build_graph.py:77
            } catch (Exception e) {
                callers = List.of();                                                                      // src: vulnhunter-fix/scripts/build_graph.py:79
            }
            try {
                blast = GraphQuery.blastRadius(sink, θ).getOr("reachable_files", List.of());              // src: vulnhunter-fix/scripts/build_graph.py:84
            } catch (Exception e) {
                blast = List.of();                                                                        // src: vulnhunter-fix/scripts/build_graph.py:87
            }
        }
        // only the AST backend yields high confidence; grep / none fall to low
        String confidence = docBackend == "ast" ? "high" : "low";                                        // src: vulnhunter-fix/scripts/build_graph.py:89
        String backend = List.of("ast", "grep", "none").contains(docBackend) ? docBackend : "grep";      // src: vulnhunter-fix/scripts/build_graph.py:90
        return Map.of("vuln_id", vulnId, "confidence", confidence, "sink_symbol", sink, "callers_of_sink", callers, "blast_radius", blast, "reachable_from_entry", null, "graph_backend", backend, "generated_at", now(), "graphifyy_version", confidence == "high" ? docVersion : null); // src: vulnhunter-fix/scripts/build_graph.py:92
    }

    int main(List<String> argv, Theta θ) {
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/build_graph.py:107
        Path repoRoot = Path.resolve(args.repoRoot);
        Path workDir = Path.resolve(args.workDir);
        if (!repoRoot.isDir()) return 2;                                                                  // src: vulnhunter-fix/scripts/build_graph.py:119
        Path graphPath = workDir.join("cache", "graph.json");                                            // src: vulnhunter-fix/scripts/build_graph.py:125
        GraphDocument doc = Build.buildOrLoad(repoRoot, graphPath);                                       // src: vulnhunter-fix/scripts/build_graph.py:127
        print(json("graph", graphPath, "backend", doc.backend, "confidence", doc.confidence, "nodes", doc.nodes.size(), "edges", doc.edges.size())); // src: vulnhunter-fix/scripts/build_graph.py:128
        if (args.findings == null) return 0;                                                              // src: vulnhunter-fix/scripts/build_graph.py:136
        if (!Path.isFile(args.findings)) return 2;                                                        // src: vulnhunter-fix/scripts/build_graph.py:140
        Object payload;
        try {
            payload = Json.parse(Files.read(args.findings));                                              // src: vulnhunter-fix/scripts/build_graph.py:145
        } catch (JSONDecodeError e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/build_graph.py:148
        }
        List<Map> findings;
        if (payload.isMap() && payload.get("findings").isList()) findings = payload.get("findings");    // src: vulnhunter-fix/scripts/build_graph.py:150
        else if (payload.isList()) findings = payload;                                                   // src: vulnhunter-fix/scripts/build_graph.py:152
        else if (payload.isMap() && payload.get("id") != null) findings = List.of(payload);              // src: vulnhunter-fix/scripts/build_graph.py:154
        else return 2;                                                                                    // src: vulnhunter-fix/scripts/build_graph.py:159
        Path sidecarDir = workDir.join("graph_context");                                                  // src: vulnhunter-fix/scripts/build_graph.py:161
        GraphQuery query = new GraphQuery(doc);                                                           // src: vulnhunter-fix/scripts/build_graph.py:164
        List<String> written = List.of();
        List<String> errors = List.of();
        for (Map finding : findings) {
            Map sidecar;
            try {
                sidecar = buildSidecar(query, finding, doc.backend, doc.graphifyVersion, θ);              // src: vulnhunter-fix/scripts/build_graph.py:169
            } catch (ValueError e) {
                errors.add(e);                                                                            // src: vulnhunter-fix/scripts/build_graph.py:171
                continue;
            }
            Files.write(sidecarDir.join(sidecar.vuln_id + ".json"), Json.dump(sidecar));                  // src: vulnhunter-fix/scripts/build_graph.py:174
            written.add(sidecar.vuln_id);
        }
        print(json("sidecars_written", written.size(), "errors", errors));                               // src: vulnhunter-fix/scripts/build_graph.py:177
        // non-AST backend with sidecars: soft signal, sidecars carry confidence low
        if (doc.backend != "ast" && !written.isEmpty()) return 3;                                         // src: vulnhunter-fix/scripts/build_graph.py:183
        return 0;
    }
}
