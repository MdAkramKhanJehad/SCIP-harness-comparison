// file: vulnhunter-agent/agent/issues_extract.py, vulnhunter-agent/agent/config.py
// Issues stage, step 1: a small model turns the results README.md into strict JSON findings
// (Confirmed rows only); code fills PoC/test paths from the filesystem and computes vulnfix_key.
// Also holds the [issues] config section (IssuesConfig) whose knobs drive the whole issues stage.

@executedBy(CODE) @role(step) @stage("issues")
class IssuesExtract {

    // _SCAN_DATE_RE = (\d{4}-\d{2}-\d{2})-\d{6} ; _VULN_FILE_RE = VULN[-_](\d+) case-insensitive   // src: vulnhunter-agent/agent/issues_extract.py:66

    String scanDateFromDir(String resultsDirName) {
        Match m = SCAN_DATE_RE.search(resultsDirName);                                     // src: vulnhunter-agent/agent/issues_extract.py:109
        if (m != null) return m.group(1);
        return utcNow().format("YYYY-MM-DD");                                              // src: vulnhunter-agent/agent/issues_extract.py:112
    }

    String computeVulnfixKey(String location, String cwe, String rootCause) {
        // key recipe = sha256(location|cwe|root_cause)[:16]; same convention as vulnhunter-fix
        KeySpec spec = θ["code.vulnfix_key"];                                              // src: vulnhunter-agent/agent/issues_extract.py:115
        return sha256(location + "|" + cwe + "|" + rootCause).hex().take(16);              // src: vulnhunter-agent/agent/issues_extract.py:120
    }

    String canonicalVulnId(String rawNumber) {
        return "VULN-" + zeroPad(int(rawNumber), 3);                                       // src: vulnhunter-agent/agent/issues_extract.py:131
    }

    Map<String, Map<String, String>> discoverFindingFiles(Path resultsDir) {
        Map<String, Map<String, String>> out = new Map();
        for (Pair<String, String> sk : List.of(Pair.of("poc", "poc"), Pair.of("exploit_tests", "exploit_test"))) { // src: vulnhunter-agent/agent/issues_extract.py:137
            Path d = resultsDir.resolve(sk.first);
            if (!d.exists()) continue;                                                     // src: vulnhunter-agent/agent/issues_extract.py:139
            for (Path f : d.iterdir()) {
                Match m = VULN_FILE_RE.search(f.name);
                if (m == null) continue;                                                   // src: vulnhunter-agent/agent/issues_extract.py:143
                out.setdefault(canonicalVulnId(m.group(1))).put(sk.second, f.toString());  // src: vulnhunter-agent/agent/issues_extract.py:145
            }
        }
        return out;
    }

    Finding coerceFinding(Map raw, Map<String, Map<String, String>> files) {
        String fid = str(raw.get("id")).strip();
        String canonical = "";
        Match m = VULN_FILE_RE.search(fid);                                                // src: vulnhunter-agent/agent/issues_extract.py:155
        if (m != null) canonical = canonicalVulnId(m.group(1));
        Map related = canonical.isEmpty() ? Map.of() : files.getOrDefault(canonical, Map.of()); // src: vulnhunter-agent/agent/issues_extract.py:158
        String location = str(raw.get("location")).strip();
        String cwe = str(raw.get("cwe")).strip();
        String rootCause = str(raw.get("root_cause")).strip();
        // every schema field copied as stripped string (title, cwe_name, severity, data_flow, entry_point, exploit_*, fix_strategy, severity_rationale)
        Finding f = Finding.fromRaw(raw, θ["p.issues_extract.finding_schema_fields"]);    // src: vulnhunter-agent/agent/issues_extract.py:162
        f.pocPath = related.get("poc");                                                    // src: vulnhunter-agent/agent/issues_extract.py:176
        f.exploitTestPath = related.get("exploit_test");                                   // src: vulnhunter-agent/agent/issues_extract.py:177
        f.vulnfixKey = computeVulnfixKey(location, cwe, rootCause);                        // src: vulnhunter-agent/agent/issues_extract.py:178
        return f;
    }

    ExtractedReport extractFindings(Path resultsDir, Theta θ, TokenManager tm, CostStats cost, AuditWriter audit) {
        Path readme = resultsDir.resolve("README.md");
        if (!readme.isFile()) throw new FileNotFoundError("README.md not found");          // src: vulnhunter-agent/agent/issues_extract.py:196
        String content = readme.readText("utf-8", "replace");                             // src: vulnhunter-agent/agent/issues_extract.py:198
        String system = IssuesExtractPrompt.system(θ).text();
        String user = IssuesExtractPrompt.user(content, θ).text();
        Object parsed;
        List<String> chain = θ["code.issues.fallback_chain"];                               // src: vulnhunter-agent/agent/issues_extract.py:209
        try {
            parsed = Llm.callJsonWithFallback(θ["issues.haiku_model"], θ["issues.sonnet_model"], system, user, θ, tm, cost, "extract", audit); // src: vulnhunter-agent/agent/issues_extract.py:209
        } catch (LLMError exc) {
            // both haiku + sonnet failed (not provisioned on this Bedrock deployment): use the scan model
            if (audit != null) audit.emitAudit(Audit.buildModelFallback(θ["issues.sonnet_model"], config.anthropic.model, "extract", exc, resultsDir.name)); // src: vulnhunter-agent/agent/issues_extract.py:235
            try {
                parsed = Llm.callJson(config.anthropic.model, system, user, θ, tm, cost, "extract-scan-fallback"); // src: vulnhunter-agent/agent/issues_extract.py:247
            } catch (LLMError finalExc) {
                if (audit != null) audit.emitAudit(Audit.buildModelUnavailable(config.anthropic.model, "extract", finalExc, resultsDir.name)); // src: vulnhunter-agent/agent/issues_extract.py:261
                throw finalExc;                                                            // src: vulnhunter-agent/agent/issues_extract.py:271
            }
        }
        Object rawFindings = (parsed instanceof Map) ? parsed.get("findings") : null;       // src: vulnhunter-agent/agent/issues_extract.py:273
        if (!(rawFindings instanceof List)) throw new LLMError("extractor returned no findings list"); // src: vulnhunter-agent/agent/issues_extract.py:274
        Map files = discoverFindingFiles(resultsDir);                                      // src: vulnhunter-agent/agent/issues_extract.py:279
        List<Finding> findings = new List();
        for (Object raw : rawFindings) {
            if (!(raw instanceof Map)) { log.warning("Skipping non-object finding"); continue; } // src: vulnhunter-agent/agent/issues_extract.py:282
            if (!raw.get("id")) { log.warning("Skipping finding with no id"); continue; }  // src: vulnhunter-agent/agent/issues_extract.py:285
            findings.add(coerceFinding(raw, files));                                       // src: vulnhunter-agent/agent/issues_extract.py:288
        }
        return new ExtractedReport(findings, scanDateFromDir(resultsDir.name), resultsDir.name); // src: vulnhunter-agent/agent/issues_extract.py:290
    }
}

@executedBy(MODEL) @role(prompt) @stage("issues")
class IssuesExtractPrompt {

    // _EXTRACTOR_SYSTEM
    Prompt system(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.issues_extract.extractor_role"]);                                   // src: vulnhunter-agent/agent/issues_extract.py:72
        if (θ["p.issues_extract.json_only_output"]) p.format("Return ONLY a JSON object - no prose, no code fences, no commentary"); // src: vulnhunter-agent/agent/issues_extract.py:73
        if (θ["p.issues_extract.status_from_summary_table"]) p.rule("Read status from the Status column of the summary table near the top"); // src: vulnhunter-agent/agent/issues_extract.py:75
        p.rule(θ["prompt.issue_extract_scope"]);                                           // src: vulnhunter-agent/agent/issues_extract.py:72
        p.choose(θ["p.issues_extract.confirmed_only_scope"]);                              // src: vulnhunter-agent/agent/issues_extract.py:76
        p.forbid(θ["p.issues_extract.ignored_status_set"]);                                // src: vulnhunter-agent/agent/issues_extract.py:77
        if (θ["p.issues_extract.locate_detail_section"]) p.rule("For each confirmed finding locate its detail section (## VULN-NNN: ...) and read the field table and prose"); // src: vulnhunter-agent/agent/issues_extract.py:80
        if (θ["p.issues_extract.always_emit_every_key"]) p.must("always emit every key; empty string if undeterminable"); // src: vulnhunter-agent/agent/issues_extract.py:83
        if (θ["p.issues_extract.never_invent_values"]) p.forbid("never invent values");    // src: vulnhunter-agent/agent/issues_extract.py:84
        p.format(θ["p.issues_extract.finding_schema_fields"]);                             // src: vulnhunter-agent/agent/issues_extract.py:92
        if (θ["p.issues_extract.title_format"]) p.format("title: short human-readable, no CWE prefix, no severity"); // src: vulnhunter-agent/agent/issues_extract.py:90
        p.choose(θ["p.issues_extract.severity_values"]);                                   // src: vulnhunter-agent/agent/issues_extract.py:93
        p.format(θ["p.issues_extract.root_cause_one_sentence"]);                           // src: vulnhunter-agent/agent/issues_extract.py:95
        p.format(θ["p.issues_extract.exploit_description_length_no_code"]);                // src: vulnhunter-agent/agent/issues_extract.py:98
        if (θ["p.issues_extract.exploit_impact_concrete"]) p.format("exploit_impact: concrete consequence"); // src: vulnhunter-agent/agent/issues_extract.py:99
        p.format(θ["p.issues_extract.fix_strategy_one_sentence"]);                         // src: vulnhunter-agent/agent/issues_extract.py:100
        p.format(θ["p.issues_extract.severity_rationale_basis"]);                          // src: vulnhunter-agent/agent/issues_extract.py:101
        return p;
    }

    Prompt user(String readmeContent, Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.issues_extract.user_extract_every_confirmed"]) p.rule("Extract every Confirmed finding from the report below. Return strict JSON matching the schema"); // src: vulnhunter-agent/agent/issues_extract.py:201
        String[] delim = θ["p.issues_extract.report_delimiters"].split(" / ");             // src: vulnhunter-agent/agent/issues_extract.py:203
        if (θ["p.issues_extract.full_readme_supplied"]) p.context(delim[0] + readmeContent + delim[1]); // src: vulnhunter-agent/agent/issues_extract.py:198
        return p;
    }
}

@executedBy(CODE) @role(config) @stage("issues")
class IssuesStageConfig {

    // IssuesConfig fields; each comment names the module where the value is consumed.
    boolean enabled(Theta θ) {
        return θ["issues.enabled"];                                                        // src: vulnhunter-agent/agent/config.py:222  (gates the issues stage in __main__.py:448)
    }

    List<String> labels(Theta θ) {
        return θ["issues.labels"];                                                         // src: vulnhunter-agent/agent/config.py:224  (applied to every posted issue, issues.py:303)
    }

    ModelChain models(Theta θ) {
        return new ModelChain(θ["issues.haiku_model"], θ["issues.sonnet_model"]);         // src: vulnhunter-agent/agent/config.py:226  (extract + dedup primary/fallback)
    }

    boolean semanticDedup(Theta θ) {
        return θ["issues.semantic_dedup"];                                                 // src: vulnhunter-agent/agent/config.py:228  (IssuesDedup.dedup)
    }

    int requestTimeoutSeconds(Theta θ) {
        return θ["issues.request_timeout_seconds"];                                        // src: vulnhunter-agent/agent/config.py:229  (GitHub requests, issues.py:296)
    }

    int maxOpenIssues(Theta θ) {
        return θ["issues.max_open_issues"];                                                // src: vulnhunter-agent/agent/config.py:230  (dedup pool cap, issues_fetch.py:112)
    }

    int dedupTokenBudget(Theta θ) {
        return int(θ["issues.model_context_tokens"] * θ["issues.token_budget_fraction"]); // src: vulnhunter-agent/agent/config.py:234  (IssuesDedup.budgetTokens)
    }

    boolean notifyCleanScan(Theta θ) {
        return θ["issues.notify_clean_scan"];                                              // src: vulnhunter-agent/agent/config.py:241  (closed receipt issue, issues.py:892)
    }
}
