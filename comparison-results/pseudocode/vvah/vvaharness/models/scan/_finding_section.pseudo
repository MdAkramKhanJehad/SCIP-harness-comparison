// file: vvaharness/models/scan/_finding_section.py
// Renders one ranked finding's Markdown report section as (line, in_sarif_description) pairs,
// including CVSS/VSVS/offensive-priority lines, dedup duplicates and the exploit-verification block.

@executedBy(CODE) @role(io) @stage("S9")
class FindingSection {

    // _EV_VERDICT_LABEL: CONFIRMED -> "CONFIRMED (beta)", NOT_CONFIRMED -> "NOT CONFIRMED (beta)",
    //   INCONCLUSIVE -> "REQUIRES REVIEW (beta)", NOT_TESTED -> "SAST-ONLY (beta; not live-testable)"   // src: vvaharness/models/scan/_finding_section.py:38
    // _EV_REASON_TAG: rule/triage/judge -> "[rule] " / "[triage] " / "[judge] "                         // src: vvaharness/models/scan/_finding_section.py:45
    // _EV_NOT_A_FP_NOTE: EV is additive and positive-only; static verification owns the verdict      // src: vvaharness/models/scan/_finding_section.py:51

    List<String> findingSectionLines(int i, RankedFinding rf) {
        return findingSection(i, rf).map(p -> p.line);                                              // src: vvaharness/models/scan/_finding_section.py:62
    }

    List<String> findingDescriptionLines(int i, RankedFinding rf) {
        return findingSection(i, rf).filter(p -> p.keep).map(p -> p.line);                          // src: vvaharness/models/scan/_finding_section.py:67
    }

    List<Pair> findingSection(int i, RankedFinding rf) {
        Finding f = rf.finding;
        String cvss;
        if (f.cvssScore != null) {
            // a FALSE_POSITIVE verdict means the score was computed against a rejected claim
            String score = f.verdict.equals("FALSE_POSITIVE") ? "(scored against the claim, verdict FALSE_POSITIVE)" : bold(f.cvssScore); // src: vvaharness/models/scan/_finding_section.py:75
            cvss = score + " (" + f.cvssRating + ") - " + ScanRender.vectorSpan(f.cvssVector);      // src: vvaharness/models/scan/_finding_section.py:78
        } else if (f.cvssVector != null) {
            cvss = ScanRender.vectorSpan(f.cvssVector);                                             // src: vvaharness/models/scan/_finding_section.py:80
        } else {
            cvss = "_not computed_";                                                                // src: vvaharness/models/scan/_finding_section.py:82
        }
        String cwe = Cwe.cweFor(f.cwe, f.vulnClass);                                          // src: vvaharness/models/scan/_finding_section.py:84
        List<Pair> out = new List();
        out.add(pair("### " + i + ". [" + rf.severity.upper() + "] " + ScanRender.mdCell(f.title), false)); // src: vvaharness/models/scan/_finding_section.py:88
        out.add(pair("**Class:** " + (cwe != null ? cweLabel(cwe) : f.vulnClass.value), false));   // src: vvaharness/models/scan/_finding_section.py:89
        if (cwe != null) out.add(pair("**CWE:** " + cweLabel(cwe) + " - https://cwe.mitre.org/data/definitions/<n>.html", false)); // src: vvaharness/models/scan/_finding_section.py:91
        // repo-controlled path: backticks folded to U+02CB so it cannot close the span
        String lines = f.lineEnd != 0 ? f.lineStart + "-" + f.lineEnd : "" + f.lineStart;           // src: vvaharness/models/scan/_finding_section.py:99
        out.add(pair("**File:** `" + foldTicks(ScanRender.mdCell(f.file)) + ":" + lines + "`", false)); // src: vvaharness/models/scan/_finding_section.py:102
        out.add(pair("**CVSS 3.1:** " + cvss, cvss.equals("_not computed_")));  // only a not-computed CVSS enters SARIF // src: vvaharness/models/scan/_finding_section.py:104
        if (f.vsvsScore != null) out.add(pair("**VulContextSeverity:** ...", false));               // src: vvaharness/models/scan/_finding_section.py:106
        if (f.offensivePriority != null) out.add(pair("**OffensivePriority:** " + f.offensivePriority + " - " + OFFENSIVE_LABELS.get(f.offensivePriority), false)); // src: vvaharness/models/scan/_finding_section.py:109
        if (!f.duplicates.isEmpty()) out.add(pair("**Also at:** <file:start[-end] per duplicate>", false)); // src: vvaharness/models/scan/_finding_section.py:113
        out.add(pair("", true));
        if (!f.duplicates.isEmpty()) {
            out.add(pair("*<n> additional call site(s) collapsed during dedup - same root cause; each location needs the same fix applied.*", true)); // src: vvaharness/models/scan/_finding_section.py:125
        }
        // model prose: angles escaped so GFM never acts on an injected tag; findings.json keeps raw bytes
        out.add(pair("#### Description", true)); out.add(pair(ScanRender.demoteMdHeadings(f.description, true), true)); // src: vvaharness/models/scan/_finding_section.py:131
        if (f.impact != null) { out.add(pair("#### Impact", true)); out.add(pair(ScanRender.demoteMdHeadings(f.impact, true), true)); } // src: vvaharness/models/scan/_finding_section.py:134
        if (f.exploitScenario != null) { out.add(pair("#### Exploit scenario", true)); out.add(pair(ScanRender.demoteMdHeadings(f.exploitScenario, true), true)); } // src: vvaharness/models/scan/_finding_section.py:138
        if (!f.preconditions.isEmpty()) {
            out.add(pair("#### Preconditions", true));                                              // src: vvaharness/models/scan/_finding_section.py:144
            for (String p : f.preconditions) out.add(pair("- " + ScanRender.mdCell(p), true));
        }
        String fence = ScanRender.snippetFence(f.codeSnippet);                                      // src: vvaharness/models/scan/_finding_section.py:148
        out.add(pair(fence, true)); out.add(pair(f.codeSnippet, true)); out.add(pair(fence, true));
        if (f.recommendation != null) { out.add(pair("#### How to fix", true)); out.add(pair(ScanRender.demoteMdHeadings(f.recommendation, true), true)); } // src: vvaharness/models/scan/_finding_section.py:155
        out.add(pair("**Exploitability:** " + ScanRender.oneLine(rf.exploitabilityNotes), true));  // src: vvaharness/models/scan/_finding_section.py:161
        if (f.verdict != null) {
            out.add(pair("#### Adversarial verification", true));                                   // src: vvaharness/models/scan/_finding_section.py:165
            out.add(pair("**Verdict:** " + f.verdict + " (confidence: " + ScanRender.confidenceLabel(f.verdictConfidence) + ") - " + ScanRender.oneLine(f.verdictReason), true)); // src: vvaharness/models/scan/_finding_section.py:166
        }
        if (EV_VERDICT_LABEL.containsKey(f.evStatus)) evBlock(f, out);                              // src: vvaharness/models/scan/_finding_section.py:172
        return out;
    }

    void evBlock(Finding f, List<Pair> out) {
        String verdict = EV_VERDICT_LABEL.get(f.evStatus);                                          // src: vvaharness/models/scan/_finding_section.py:173
        String reason = f.evEvidence != null ? ScanRender.oneLine(f.evEvidence) : "";               // src: vvaharness/models/scan/_finding_section.py:175
        out.add(pair("#### Exploit Verification", true));                                           // src: vvaharness/models/scan/_finding_section.py:177
        String confLine = f.evConfidenceScore != null ? "**EV Confidence:** " + f.evConfidenceScore + "/10" : null; // src: vvaharness/models/scan/_finding_section.py:179
        if (f.evStatus.equals("CONFIRMED")) {
            out.add(pair("**Exploit Verification:** " + verdict + (reason.isEmpty() ? "" : " - " + reason), false)); // src: vvaharness/models/scan/_finding_section.py:184
            if (confLine != null) out.add(pair(confLine, false));
        } else {
            out.add(pair("**Exploit Verification:** " + verdict, false));                           // src: vvaharness/models/scan/_finding_section.py:192
            if (confLine != null) out.add(pair(confLine, false));
            if (!reason.isEmpty()) out.add(pair("**Why:** " + EV_REASON_TAG.getOrDefault(f.evReasonSource, "") + reason, false)); // src: vvaharness/models/scan/_finding_section.py:198
            out.add(pair(EV_NOT_A_FP_NOTE, false));                                                 // src: vvaharness/models/scan/_finding_section.py:203
        }
        if (f.evStatus.equals("CONFIRMED")) {
            // method/CVSS/repro describe HOW it confirmed, so only CONFIRMED carries them
            if (f.evMethod != null || f.evConfidence != null) {
                out.add(pair("**EV Method:** " + (f.evMethod != null ? f.evMethod : "deterministic-backed") + " (" + (f.evConfidence != null ? f.evConfidence : "medium") + ")", false)); // src: vvaharness/models/scan/_finding_section.py:208
            }
            if (f.evCvssScore != null) out.add(pair("**EV CVSS:** " + f.evCvssScore, false));  // advisory; static cvss owns ranking // src: vvaharness/models/scan/_finding_section.py:215
            if (f.evRepro != null) out.add(pair("**Repro:** " + ScanRender.codeSpan(f.evRepro), false)); // src: vvaharness/models/scan/_finding_section.py:224
            if (f.evReproDetail != null) {
                boolean inDetails = false;
                for (String ln : ScanRender.renderReproBlock(f.evReproDetail)) {                    // src: vvaharness/models/scan/_finding_section.py:229
                    if (ln.startsWith("<details>")) inDetails = true;
                    out.add(pair(ln, ln.isEmpty() && !inDetails));  // only blank lines outside details enter SARIF // src: vvaharness/models/scan/_finding_section.py:232
                    if (ln.equals("</details>")) inDetails = false;
                }
            }
        }
    }
}
