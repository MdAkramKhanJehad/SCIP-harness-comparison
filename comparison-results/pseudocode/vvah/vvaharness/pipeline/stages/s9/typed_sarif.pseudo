            if (!f.origin.isEmpty()) props.put("origin", f.origin);                             // detector or s6_discovered; chunk_id is never emitted // src: vvaharness/pipeline/stages/s9/typed_sarif.py:325
            List<String> aliases = aliasIds.get(i - 1);                                         // src: vvaharness/pipeline/stages/s9/typed_sarif.py:327
            if (truthy(aliases)) props.put(ALIAS_KEY, aliases);                                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:328
            if (cvssScore >= 0) result.put("rank", round(cvssScore * 10.0, 1));                 // SARIF rank is 0-100, CVSS is 0-10 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:330
            if (!f.caseId.isEmpty()) result.put("partialFingerprints", Map.of(FINGERPRINT_KEY, f.caseId)); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:332
            results.add(result);                                                                // src: vvaharness/pipeline/stages/s9/typed_sarif.py:333
        }
        List<Map> rules = new List();
        for (String rid : ruleIds) {                                                            // src: vvaharness/pipeline/stages/s9/typed_sarif.py:336
            Map rule = Map.of("id", rid, "name", rid);                                          // src: vvaharness/pipeline/stages/s9/typed_sarif.py:337
            if (repName.containsKey(rid)) rule.put("shortDescription", Map.of("text", repName.get(rid))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:339
            List<String> tags = List.of("security");                                            // src: vvaharness/pipeline/stages/s9/typed_sarif.py:341
            if (truthy(ruleCwe.get(rid))) tags.add("external/cwe/" + ruleCwe.get(rid).lower()); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:343
            rule.put("properties", Map.of("tags", tags, "security-severity", ruleSev.get(rid))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:344
            rules.add(rule);
        }
        List<Map> taxa = new List();
        for (String cid : Set.copyOf(effCwes).sortedBy(c -> int(c.split("-").last()))) {        // numeric CWE order // src: vvaharness/pipeline/stages/s9/typed_sarif.py:348
            String nm = Cwe.cweName(cid); String n = cid.split("-").last();                     // src: vvaharness/pipeline/stages/s9/typed_sarif.py:349
            Map taxon = Map.of("id", cid, "helpUri", "https://cwe.mitre.org/data/definitions/" + n + ".html"); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:351
            if (!nm.isEmpty()) { taxon.put("name", nm); taxon.put("shortDescription", Map.of("text", nm)); } // src: vvaharness/pipeline/stages/s9/typed_sarif.py:355
            taxa.add(taxon);
        }
        Map taxonomy = Map.of("guid", CWE_TAXONOMY_GUID, "name", "CWE", "organization", "MITRE", "shortDescription", Map.of("text", "The MITRE Common Weakness Enumeration"), "informationUri", "https://cwe.mitre.org/", "taxa", taxa); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:359
        // one block: the checkpointed profile and CLI app_info can disagree and mislabel the report
        AppProfile prof = report.appProfile;                                                    // src: vvaharness/pipeline/stages/s9/typed_sarif.py:368
        Map runProps = Map.of("applicationId", firstTruthy(prof != null ? prof.applicationId : "", applicationId, ""));   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:369
        if (prof != null) { runProps.put("cmdbSource", prof.source); runProps.put("applicationName", prof.name); }        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:371
        else if (appInfo != null) { runProps.put("cmdbSource", appInfo.source); runProps.put("applicationName", appInfo.name); } // src: vvaharness/pipeline/stages/s9/typed_sarif.py:374
        Map run = Map.of("tool", Map.of("driver", Map.of("name", "Agentic SAST", "version", PKG_VERSION, "rules", rules, "supportedTaxonomies", List.of(Map.of("guid", CWE_TAXONOMY_GUID)))),
            "taxonomies", List.of(taxonomy), "properties", runProps, "results", results);        // src: vvaharness/pipeline/stages/s9/typed_sarif.py:378
        // health comes from the report, no sidecar, and is emitted on EVERY run for observability
        Map health = S9Health.scanHealth(report);                                               // src: vvaharness/pipeline/stages/s9/typed_sarif.py:393
        List<Map> notifications = healthNotifications(health);                                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:394
        Map invocation = Map.of("executionSuccessful", bool(health.getOrDefault("executionSuccessful", true))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:431
        if (!notifications.isEmpty()) invocation.put("toolExecutionNotifications", notifications); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:434
        run.put("invocations", List.of(invocation));                                            // src: vvaharness/pipeline/stages/s9/typed_sarif.py:436
        runProps.put("enrichmentUnavailable", bool(health.get("enrichment_unavailable")));      // src: vvaharness/pipeline/stages/s9/typed_sarif.py:437
        runProps.put("deepdiveSkipped", bool(health.get("deepdive_skipped")));                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:438
        runProps.put("hollow", bool(health.get("hollow")));                                     // exit-0-but-empty though executionSuccessful is true; always emitted (absence means an older doc) // src: vvaharness/pipeline/stages/s9/typed_sarif.py:440
        runProps.put("coverageDegraded", bool(health.get("coverage_degraded")));                // a THIRD question: coverage lost, not degraded or hollow // src: vvaharness/pipeline/stages/s9/typed_sarif.py:442
        runProps.put("coverageDegradedReasons", List.copyOf(firstTruthy(health.get("coverage_degraded_reasons"), List.of()))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:443
        // ranked threats S3 minted no unit for were never reviewed, so no finding is not an all-clear; always emitted: null means the payload predates the field, empty means full coverage
        runProps.put("threatsTotal", health.get("threats_total"));                              // src: vvaharness/pipeline/stages/s9/typed_sarif.py:449
        runProps.put("threatsWithoutUnit", health.get("threats_without_unit"));                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:450
        runProps.put("threatsBeforeCap", int(firstTruthy(health.get("threats_before_cap"), 0))); // threatsTotal is post-cap // src: vvaharness/pipeline/stages/s9/typed_sarif.py:452
        runProps.put("threatsTruncated", int(firstTruthy(health.get("threats_truncated"), 0))); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:453
        runProps.put("threatsPromoted", int(firstTruthy(health.get("threats_promoted"), 0)));   // src: vvaharness/pipeline/stages/s9/typed_sarif.py:454
        return Map.of("$schema", "https://json.schemastore.org/sarif-2.1.0.json", "version", "2.1.0", "runs", List.of(run)); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:456
    }

    /** Warning notifications: per-stage non-fatal error counts (sorted by stage; wording is a contract with the MD Scan Health section), failed deep-dive units, degradation (never missing ranking), and threats beyond the step2 cap. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:396")
    List<Map> healthNotifications(Map health) {
        List<Map> n = new List();
        for (Entry e : firstTruthy(health.get("errors_by_stage"), Map.of()).sortedByKey()) n.add(warning(e.key + ": " + e.value + " non-fatal error(s) logged")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:398
        int cf = int(firstTruthy(health.getOrDefault("chunks_failed", 0), 0));                  // src: vvaharness/pipeline/stages/s9/typed_sarif.py:403
        if (cf > 0) n.add(warning(cf + " deep-dive unit(s) failed or timed out; their findings are absent")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:404
        if (health.get("degraded")) n.add(warning(firstTruthy(health.get("degraded_reason"), "report degraded (no reason recorded)"))); // degradation means chain/narrative enrichment was unavailable // src: vvaharness/pipeline/stages/s9/typed_sarif.py:411
        int truncated = int(firstTruthy(health.getOrDefault("threats_truncated", 0), 0));       // src: vvaharness/pipeline/stages/s9/typed_sarif.py:415
        if (truncated > 0) n.add(warning(truncated + " threat(s) exceeded the step2.max_threats cap and were never investigated; threatsTotal counts only the " + health.get("threats_total") + " that remained")); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:418
        return n;
    }

    /** Build, redact and write the SARIF (indent 2, trailing newline); prints the emitted count, not len(findings), since the dup guard suppresses twins. */
    @src("vvaharness/pipeline/stages/s9/typed_sarif.py:438")
    Path writeSarif(FinalReport report, Path sarifPath, String applicationId, AppInfo appInfo, Theta θ) {
        Map doc = buildSarif(report, applicationId, appInfo, θ);                                // src: vvaharness/pipeline/stages/s9/typed_sarif.py:449
        Files.write(sarifPath, Json.dump(Redact.redactTree(doc, true, θ), 2) + "\n");           // redact_tree, carry True: filename-like keys are not carried // src: vvaharness/pipeline/stages/s9/typed_sarif.py:451
        Console.write("SARIF written: " + sarifPath + " (" + doc.get("runs").get(0).get("results").size() + " results)"); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:455
        return sarifPath;
    }
}
