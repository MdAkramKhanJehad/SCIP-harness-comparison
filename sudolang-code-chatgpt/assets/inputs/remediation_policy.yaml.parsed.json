{
  "schema_version": "1.0",
  "default_action": "allow",
  "kill_switch": {
    "env_var": "VVAHARNESS_REMEDIATE_DISABLE",
    "file": "./.vvaharness-remediate-off"
  },
  "deny": [],
  "deny_paths": [],
  "forbid_patch_paths": [
    "**/.git",
    "**/.git/**",
    "**/.github/**",
    "**/.gitlab/**",
    "**/.gitlab-ci.*",
    "**/.circleci/**",
    "**/.buildkite/**",
    "**/Jenkinsfile*",
    "**/azure-pipelines*.yml",
    "**/azure-pipelines*.yaml",
    "**/bitbucket-pipelines.yml",
    "**/bitbucket-pipelines.yaml",
    "**/cloudbuild.yml",
    "**/cloudbuild.yaml",
    "**/buildspec.yml",
    "**/buildspec.yaml",
    "**/.githooks/**",
    "**/.husky/**"
  ]
}
