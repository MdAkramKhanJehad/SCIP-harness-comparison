// file: vvaharness/validation/config/settings/config.py
// The composed S11 configuration tree and load_config(), which fills it from profile overrides or
// hard-coded defaults (never from the environment, except credentials/binary).

@executedBy(CODE) @role(types) @stage("S11")
record ValidationSettingsConfig(PathsConfig paths, AgentConfig agent, GheConfig ghe, Integer maxFindings, boolean live, boolean verbose, boolean dryRun) { }

@executedBy(CODE) @role(config) @stage("S11")
class SettingsConfig {

    List<String> parseTools(String raw) {
        List<String> tools = raw.split(",").map(t -> t.strip()).filter(t -> !t.isEmpty());          // src: vvaharness/validation/config/settings/config.py:57
        return tools.isEmpty() ? null : tools;                                                       // empty -> inherit .md default  // src: vvaharness/validation/config/settings/config.py:58
    }

    ValidationSettingsConfig loadConfig(Path projectRoot, boolean live, ValidateOverrides ov, Theta θ) {
        if (ov == null) ov = new ValidateOverrides();                                                // src: vvaharness/validation/config/settings/config.py:68
        EnvScalars env = new EnvScalars();                                                           // src: vvaharness/validation/config/settings/config.py:69
        Path root = projectRoot != null ? projectRoot : Path.cwd();                                  // src: vvaharness/validation/config/settings/config.py:70
        AgentConfig agent = new AgentConfig(
            env.binary,                                                                              // src: vvaharness/validation/config/settings/config.py:74
            ov.getOrDefault("model", θ["models.validate.orchestrator.id"]),                         // src: vvaharness/validation/config/settings/config.py:75
            ov.getOrDefault("max_turns", θ["step_validate.max_turns"]),                             // src: vvaharness/validation/config/settings/config.py:76
            ov.getOrDefault("max_budget_usd", θ["step_validate.max_budget_usd"]),                   // src: vvaharness/validation/config/settings/config.py:77
            ov.getOrDefault("effort", θ["step_validate.effort"]),                                   // src: vvaharness/validation/config/settings/config.py:78
            orDefault(ov.getOrDefault("timeout", θ["step_validate.timeout"]), θ["step_validate.timeout"]), // falsy timeout -> default  // src: vvaharness/validation/config/settings/config.py:79
            ov.getOrDefault("max_model_calls", θ["step_validate.max_model_calls"]),                 // src: vvaharness/validation/config/settings/config.py:80
            ov.getOrDefault("orchestrator_max_model_calls", θ["step_validate.orchestrator_max_model_calls"]), // src: vvaharness/validation/config/settings/config.py:81
            ov.getOrDefault("via", θ["models.validate.orchestrator.via"]),                          // src: vvaharness/validation/config/settings/config.py:83
            ov.getOrDefault("provider", null),                                                       // src: vvaharness/validation/config/settings/config.py:84
            ov.getOrDefault("use_responses_api", null),                                              // src: vvaharness/validation/config/settings/config.py:85
            ov.getOrDefault("security_architect_model", null),                                       // src: vvaharness/validation/config/settings/config.py:86
            ov.getOrDefault("penetration_tester_model", null),                                       // src: vvaharness/validation/config/settings/config.py:87
            ov.getOrDefault("cross_repo_analyzer_model", null),                                      // src: vvaharness/validation/config/settings/config.py:88
            parseTools(ov.getOrDefault("validate_tools", "")),                                       // src: vvaharness/validation/config/settings/config.py:89
            ov.getOrDefault("cache_markers", θ["sdk.cache_markers"]));                              // src: vvaharness/validation/config/settings/config.py:90
        ValidationSettingsConfig cfg = new ValidationSettingsConfig(SettingsPaths.buildPaths(root), agent,
            new GheConfig(env.gheToken, env.gheArchivedToken),                                       // src: vvaharness/validation/config/settings/config.py:92
            ov.getOrDefault("max_findings", θ["step_validate.max_findings"]),                       // src: vvaharness/validation/config/settings/config.py:93
            live, false, false);                                                                     // src: vvaharness/validation/config/settings/config.py:94
        return cfg;                                                                                  // no mkdir  // src: vvaharness/validation/config/settings/config.py:97
    }

    Object orDefault(Object v, Object d) {
        return (v == null || v.equals(0)) ? d : v;
    }
}
