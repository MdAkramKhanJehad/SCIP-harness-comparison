// src: vvaharness/pipeline/stages/s8/validate.py:125-134
fn link_ok(link_evidence, steps, repo_root):executor=code {
  hops = max(length(steps) - 1, 0)   // steps must be the hydrated path
  resolved = count of links where resolved_citation(repo_root, ln.file, ln.line) is ok   // uncapped, so "3/2" can show
  return [length(links) >= hops && resolved == length(links), resolved, hops]
}

