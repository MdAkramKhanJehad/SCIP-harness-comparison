// file: vvaharness/evidence/manifests.py
// S2 evidence: build/dependency manifests found by a depth-bounded walk, structurally truncated
// to their dependency sections, round-robin across kinds, then under an aggregate char cap.

@executedBy(CODE) @role(step) @stage("S2")
class Manifests {

    /** package.json / composer.json: keep only name/version/dependency/script keys. */
    String truncatePackageJson(String raw, int cap, Theta θ) {
        Object data;
        try { data = Json.parse(raw); } catch (Exception e) { return null; }                     // src: vvaharness/evidence/manifests.py:48
        if (!(data instanceof Map)) return null;                                                  // src: vvaharness/evidence/manifests.py:52
        Map keep = data.filterKeys(k -> θ["code.evidence.manifests.package_json_keys"].contains(k)); // src: vvaharness/evidence/manifests.py:54
        return keep.isEmpty() ? null : Read.capText(Json.dumpSorted(keep), cap);                  // src: vvaharness/evidence/manifests.py:55
    }

    /** The [project] subset and Poetry dependency table, the Python framework-detection signals. */
    Map pyprojectKeep(Map data, Theta θ) {
        Map keep = new Map();
        Object project = data.get("project");                                                     // src: vvaharness/evidence/manifests.py:61
        if (project instanceof Map) {                                                             // src: vvaharness/evidence/manifests.py:62
            Map sub = project.filterKeys(k -> θ["code.evidence.manifests.pyproject_project_keys"].contains(k)); // src: vvaharness/evidence/manifests.py:63
            if (!sub.isEmpty()) keep.put("project", sub);                                         // src: vvaharness/evidence/manifests.py:64
        }
        Object poetry = data.path("tool", "poetry");                                              // src: vvaharness/evidence/manifests.py:66
        if (poetry instanceof Map && poetry.containsKey("dependencies")) keep.put("tool", Map.of("poetry", Map.of("dependencies", poetry.get("dependencies")))); // src: vvaharness/evidence/manifests.py:68
        return keep;
    }

    String truncatePyprojectToml(String raw, int cap, Theta θ) {
        Map data;
        try { data = Toml.parse(raw); } catch (Exception e) { return null; }                     // src: vvaharness/evidence/manifests.py:76
        Map keep = pyprojectKeep(data, θ);                                                        // src: vvaharness/evidence/manifests.py:80
        return keep.isEmpty() ? null : Read.capText(Json.dumpSorted(keep), cap);                  // src: vvaharness/evidence/manifests.py:81
    }

    /** Keep a manifest's dependency section, not a blind prefix; plain cap when no truncator or it fails. */
    String structuralTruncate(String kind, String raw, int cap, Theta θ) {
        // _TRUNCATORS: package.json, composer.json -> package-json truncator; pyproject.toml -> TOML truncator
        String kept = null;
        if (θ["code.evidence.manifests.structural_truncators"].containsKey(kind)) {               // src: vvaharness/evidence/manifests.py:93
            kept = (kind == "pyproject.toml") ? truncatePyprojectToml(raw, cap, θ) : truncatePackageJson(raw, cap, θ); // src: vvaharness/evidence/manifests.py:94
        }
        return (kept != null) ? kept : Read.capText(raw, cap);                                    // src: vvaharness/evidence/manifests.py:95
    }

    /** Aggregate cap across manifests, applied in order after each file's own cap; later ones are cut or dropped. */
    List<Pair<String, String>> applyManifestTotalCap(List<Pair<String, String>> manifests, int totalCap) {
        List<Pair<String, String>> out = new List();
        int remaining = totalCap;                                                                 // src: vvaharness/evidence/manifests.py:102
        for (Pair<String, String> m : manifests) {                                                // src: vvaharness/evidence/manifests.py:103
            if (remaining <= 0) break;                                                            // src: vvaharness/evidence/manifests.py:104
            String text = m.second;
            if (text.length() > remaining) text = Read.capText(text, remaining);                  // src: vvaharness/evidence/manifests.py:106
            out.add(new Pair(m.first, text));                                                     // src: vvaharness/evidence/manifests.py:108
            remaining -= text.length();                                                           // src: vvaharness/evidence/manifests.py:109
        }
        return out;
    }

    /** Manifest candidates directly inside d, containment-checked, grouped by candidate name. */
    Map<String, List<Path>> dirManifestHits(Path root, Path d, Theta θ) {
        Map<String, List<Path>> hits = new Map();
        for (String name : θ["code.evidence.manifests.manifest_candidates"]) {                   // src: vvaharness/evidence/manifests.py:116
            // a leading-dot candidate (.csproj) is a suffix glob; others are exact names
            List<Path> candidates = name.startsWith(".") ? sorted(d.glob("*" + name)) : List.of(d.resolve(name)); // src: vvaharness/evidence/manifests.py:117
            for (Path p : candidates) {                                                           // src: vvaharness/evidence/manifests.py:118
                // A manifest-named symlink can target any in-root file (.git/config, a key); S2 is unredacted
                if (θ["code.evidence.manifests.skip_symlinked_manifests"] && p.isSymlink()) continue; // src: vvaharness/evidence/manifests.py:120
                if (p.isFile() && Read.contained(root, p) != null) hits.computeIfAbsent(name, new List()).add(p);         // src: vvaharness/evidence/manifests.py:122
            }
        }
        return hits;
    }

    /** Subdirs eligible for the walk: not a symlink, and not in the built-in exclude dirs (target/ only with a build marker). */
    List<Path> walkableChildren(Path d, Theta θ) {
        List<Path> children;
        try { children = sorted(d.iterdir().filter(c -> c.isDir())); } catch (OSError e) { return new List(); } // src: vvaharness/evidence/manifests.py:137
        // NOTE: only the built-in dir list (case-sensitive), not step1.exclude_dirs appends
        return children.filter(c -> !c.isSymlink()                                                // src: vvaharness/evidence/manifests.py:142
            && (!θ["code.scope.walk.default_exclude_dirs"].contains(c.name)                       // src: vvaharness/evidence/manifests.py:144
                || (c.name == "target" && !Walk.hasTargetBuildMarker(d, List.of(), θ))));         // src: vvaharness/evidence/manifests.py:145
    }

    /** Depth-bounded recursive walk; never descends into a symlinked dir. */
    void walkForManifests(Path root, Path d, int depth, int maxDepth, Map<String, List<Path>> hitsByKind, Theta θ) {
        for (Map.Entry<String, List<Path>> e : dirManifestHits(root, d, θ).entries()) hitsByKind.computeIfAbsent(e.key, new List()).addAll(e.value); // src: vvaharness/evidence/manifests.py:153
        if (depth >= maxDepth) return;                                                            // src: vvaharness/evidence/manifests.py:155
        for (Path child : walkableChildren(d, θ)) walkForManifests(root, child, depth + 1, maxDepth, hitsByKind, θ); // src: vvaharness/evidence/manifests.py:157
    }

    /** Bounded search, capped per kind, then breadth-first across kinds (candidate-list order) up to maxTotal. */
    List<Pair<String, Path>> findManifests(Path root, int maxDepth, int maxTotal, int maxPerKind, Theta θ) {
        Map<String, List<Path>> hitsByKind = new Map();
        walkForManifests(root, root, 0, maxDepth, hitsByKind, θ);            // = maxDepth. src: vvaharness/evidence/manifests.py:165
        for (String kind : hitsByKind.keys()) hitsByKind.put(kind, hitsByKind.get(kind).head(maxPerKind)); // = maxPerKind. src: vvaharness/evidence/manifests.py:167
        List<String> orderedKinds = θ["code.evidence.manifests.manifest_candidates"].filter(k -> hitsByKind.containsKey(k)); // src: vvaharness/evidence/manifests.py:168
        return Grouping.roundRobinSelect(hitsByKind, maxTotal, orderedKinds);     // = maxTotal. src: vvaharness/evidence/manifests.py:169
    }

    String manifestRelpath(Path root, Path p) {
        try { return posix(p.relativeTo(root)); } catch (ValueError e) { return p.toString(); }   // src: vvaharness/evidence/manifests.py:174
    }

    /** Find, read (raw ceiling), structurally truncate (step2.max_manifest_chars), aggregate-cap. */
    List<Pair<String, String>> gatherManifests(Path root, Triple<Integer, Integer, Integer> walkBounds, int manifestCap, int manifestTotalCap, Theta θ) {
        List<Pair<String, String>> manifestsStruct = new List();
        for (Pair<String, Path> kp : findManifests(root, walkBounds.first, walkBounds.second, walkBounds.third, θ)) { // src: vvaharness/evidence/manifests.py:184
            String raw = Read.readCapped(root, kp.second, θ["code.evidence.manifests.raw_ceiling"], false, θ); // src: vvaharness/evidence/manifests.py:185
            if (raw.isEmpty()) continue;                                                          // src: vvaharness/evidence/manifests.py:186
            manifestsStruct.add(new Pair(manifestRelpath(root, kp.second), structuralTruncate(kp.first, raw, manifestCap, θ))); // = manifestCap. src: vvaharness/evidence/manifests.py:189
        }
        return applyManifestTotalCap(manifestsStruct, manifestTotalCap);       // = manifestTotalCap. src: vvaharness/evidence/manifests.py:190
    }
}
