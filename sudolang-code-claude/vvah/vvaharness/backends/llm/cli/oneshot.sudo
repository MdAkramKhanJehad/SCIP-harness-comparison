# vvaharness/backends/llm/cli/oneshot.py

`prompt()` for the `claude` command-line route: one request and one reply with every tool disabled, the scanned repository's settings shut out, a JSON envelope always requested, the one doubled-budget truncation retry, refusal detection and the response-quality gate.

Source: `vvaharness/backends/llm/cli/oneshot.py` (lines 1-180)
Executor: mixed
Called from: `registry.sudo` `prompt` (when the role resolves to `via: cli`)

// src: vvaharness/backends/llm/cli/oneshot.py:46-180
fn prompt(user_prompt, model, system_prompt?, json_schema?, output_format="text", cwd?, max_budget_usd?, max_tokens?, timeout=1800, tag?, effort?):executor=mixed {
  // Flat text only: a content-block list is joined, dropping cache_control markers (no Messages API here)
  if (user_prompt is a list) user_prompt = text of its "text" blocks joined by blank lines
  require cancel._ABORT is not set => throw RuntimeError("aborted by user (Ctrl-C)")

  tier = env._effective_effort(effort)
  wall = effort_scaled_seconds(timeout, tier, kind=ClockKind.REQUEST)   // REQUEST factors: low/medium/high 1.0, xhigh 1.1, max 1.2 (vvaharness/backends/llm/models.py:263-272)
  cmd = [...discovery._CLAUDE_CMD, "-p", "--model", model, ...env._effort_argv(effort)]
  if (system_prompt) cmd += ["--system-prompt", system_prompt]
  cmd += ["--output-format", "json"]   // always the JSON envelope (for usage); output_format is accepted but not used
  if (json_schema) {
    if (discovery._cli_capabilities().json_schema) {
      cmd += ["--json-schema", JSON(json_schema)]
    } else {
      warn "this `claude` build does not advertise --json-schema; embedding the schema in the prompt instead. Structured output is no longer validator-enforced ..."
      user_prompt = "$user_prompt" + JSON_SCHEMA_FALLBACK_SUFFIX   // see interface below
    }
  }
  if (max_budget_usd && discovery._cli_capabilities().max_budget) cmd += ["--max-budget-usd", string(max_budget_usd)]   // probe-gated spend cap
  cmd += ["--tools", ""]   // every tool disabled: pure reasoning
  cmd += session._confinement_argv(allowed_tools=null, disallowed_tools=null, permission_prompts=null)   // cwd is still inside the scanned repository: its settings, hooks and MCP servers are shut out
  call_env = env._call_env(max_tokens, effort)   // effort pin, refusal no-resend, CLAUDE_CODE_MAX_OUTPUT_TOKENS when max_tokens

  // VVAH-E005: one doubled-budget retry, then fail loud
  trunc_retried = 0
  loop {
    call_start = now   // reset per attempt: the budget check compares per-attempt time
    // model invocation:
    // callModel({ role: caller, route: "cli", system: system_prompt, prompt: user_prompt, tools: [], limits: { wall_clock_seconds: wall, max_tokens, max_budget_usd }, output: json_schema || "free text in the JSON envelope" })
    try result = retry._run_with_retry(cmd, label="prompt($model) [tag]", input=user_prompt, cwd, timeout=wall, timeout_retries=0, env=call_env, heartbeat_label=...)
    catch subprocess.TimeoutExpired => throw call_timeout_error(stage=tag || "", route="cli", budget_s=wall, effort=tier, cause_text="claude subprocess exceeded ${wall}s")   // no time-out retry on this route

    if (result.returncode != 0) {
      cap = retry._truncation_cap(result)
      require cap != null => throw RuntimeError(discovery._format_cli_error("claude CLI failed", cmd, result))   // includes transient failures whose retries ran out
      requested = max_tokens || cap   // the caller's own value wins when set
      retry_at = if (trunc_retried) null else truncation_retry_max(requested, cap=MODEL_MAX_OUTPUT_TOKENS)   // doubled, capped at 64000; null when already at 64000
      if (retry_at != null) {
        retry._log_truncation_retry(tag, requested, retry_at, label="cli")
        call_env = copy of call_env with CLAUDE_CODE_MAX_OUTPUT_TOKENS = string(retry_at)   // keeps the effort pin
        trunc_retried = retry_at
        continue
      }
      throw retry._truncation_error(requested, retried=trunc_retried, tag, retry_at)
    }

    // With --tools "" a multi-turn envelope can only be a split reply, so it is stitched
    { text, usage, turns, usd, stop_reason, model_usage } = envelope._parse_envelope(result.stdout, stitch_continuations=true, tag)
    if (stop_reason == ANTHROPIC_STOP_MAX_TOKENS) {   // "max_tokens"; insurance, the source notes it is not reachable on 2.1.270
      requested = max_tokens || MODEL_MAX_OUTPUT_TOKENS
      retry_at = if (trunc_retried) null else truncation_retry_max(requested, cap=MODEL_MAX_OUTPUT_TOKENS)
      if (retry_at != null) { retry._log_truncation_retry(...); call_env.CLAUDE_CODE_MAX_OUTPUT_TOKENS = string(retry_at) on a copy; trunc_retried = retry_at; continue }
      throw retry._truncation_error(requested, retried=trunc_retried, tag, retry_at)
    }
    if (trunc_retried) COUNTERS.bump(TRUNCATED_RETRY_RECOVERED_COUNTER)
    break
  }

  note_budget_use(now - call_start, wall, tier)
  envelope._note_unparsed_cache_keys(usage)
  TOKENS.add(usage, usd, turns)   // usage is banked before the refusal check
  retry._log_usage(usage, stop_reason, model_usage)
  envelope._raise_if_refused(stop_reason, tag, stdout=result.stdout)
  check_response_quality(text, stage=tag || "", output_tokens=output_tokens_for_gate(usage))   // external to this batch: util/response_quality; may raise
  return text
}

// Appended to the user prompt only when the installed CLI lacks --json-schema
// prompt-src: vvaharness/backends/llm/cli/oneshot.py:86-89
JSON_SCHEMA_FALLBACK_SUFFIX {
  Constraints {
    "\n\nRespond with ONLY a JSON object conforming to this JSON Schema:\n$json_schema"
  }
}
