// file: vulnhunter-agent/agent/_url.py
// URL helpers for clone and publish: inject a GitHub token only into matching-host (and optionally
// authorized-path) HTTPS URLs, and redact credentials from any text before logging/auditing (CWE-532).

@executedBy(CODE) @role(rule_set) @stage("infra")
class Url {

    // redact: five pattern passes; residual risk = unknown secret formats pass through.
    String redact(String text, Theta θ) {
        List<String> passes = θ["code.agent.url.redaction_passes"];                                // src: vulnhunter-agent/agent/_url.py:16
        String s = text;
        if (passes.contains("basic_auth")) s = s.replaceAll("://[^@/]+@", "://***@");               // src: vulnhunter-agent/agent/_url.py:47
        if (passes.contains("bearer_header")) s = s.replaceAll("authorization: bearer|token SECRET", "authorization: bearer ***"); // src: vulnhunter-agent/agent/_url.py:48
        if (passes.contains("query_token")) s = s.replaceAll("[?&](access_token|token)=SECRET", "$1***"); // src: vulnhunter-agent/agent/_url.py:49
        if (passes.contains("raw_token_prefix")) {
            List<String> prefixes = θ["code.agent.url.raw_token_prefixes"];                        // src: vulnhunter-agent/agent/_url.py:23
            s = s.replaceAll(prefixes + "[A-Za-z0-9_-]+", "<prefix>***");                           // prefix kept, body masked // src: vulnhunter-agent/agent/_url.py:50
        }
        if (passes.contains("client_secret")) s = s.replaceAll("client[_-]?secret = SECRET", "client_secret=***"); // form/JSON/config // src: vulnhunter-agent/agent/_url.py:51
        return s;                                                                                   // src: vulnhunter-agent/agent/_url.py:55
    }

    String normalizeRepoPath(String path) {
        String p = path.strip("/");                                                                 // src: vulnhunter-agent/agent/_url.py:64
        if (p.endsWith(".git")) p = p.dropSuffix(".git");                                           // src: vulnhunter-agent/agent/_url.py:65
        return p;
    }

    boolean pathIsAuthorized(String path, List<String> allowedPathPrefixes) {
        String candidate = normalizeRepoPath(path);                                                 // src: vulnhunter-agent/agent/_url.py:77
        for (String raw : allowedPathPrefixes) {
            String prefix = normalizeRepoPath(raw);
            if (prefix.isEmpty()) continue;                                                         // src: vulnhunter-agent/agent/_url.py:80
            if (candidate == prefix || candidate.startsWith(prefix + "/")) return true;             // src: vulnhunter-agent/agent/_url.py:82
        }
        return false;
    }

    // inject_token: allowedPathPrefixes == null -> host match only (trusted target clone);
    // a list (possibly empty) -> also require an authorized path (confused-deputy guard, CWE-441).
    String injectToken(String repoUrl, String token, String expectedHost, List<String> allowedPathPrefixes) {
        if (token == null || token.isEmpty()) return repoUrl;                                       // src: vulnhunter-agent/agent/_url.py:111
        Url parsed = urlparse(repoUrl);
        if (parsed.scheme != "http" && parsed.scheme != "https") return repoUrl;                    // src: vulnhunter-agent/agent/_url.py:115
        if (parsed.username != null || parsed.password != null) return repoUrl;                    // already has creds // src: vulnhunter-agent/agent/_url.py:117
        if (parsed.hostname == null) return repoUrl;                                                // src: vulnhunter-agent/agent/_url.py:119
        if (parsed.hostname.lower() != expectedHost.lower()) return repoUrl;                        // token never leaks to another host // src: vulnhunter-agent/agent/_url.py:121
        if (allowedPathPrefixes != null && !pathIsAuthorized(parsed.path, allowedPathPrefixes)) return repoUrl; // src: vulnhunter-agent/agent/_url.py:123
        String netloc = "x-access-token:" + token + "@" + parsed.hostname;                          // src: vulnhunter-agent/agent/_url.py:130
        if (parsed.port != null) netloc = netloc + ":" + parsed.port;                               // src: vulnhunter-agent/agent/_url.py:131
        return parsed.withNetloc(netloc).toString();                                                // src: vulnhunter-agent/agent/_url.py:133
    }

    String injectToken(String repoUrl, String token, String expectedHost) {
        return injectToken(repoUrl, token, expectedHost, null);                                     // src: vulnhunter-agent/agent/_url.py:87
    }
}
