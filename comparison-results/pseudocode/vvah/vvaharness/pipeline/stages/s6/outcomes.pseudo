// file: vvaharness/pipeline/stages/s6/outcomes.py
// S6's output contract: one verdict per finding that can also CORRECT it (CWE, line, repeats,
// CVSS, trait stamps, discoveries). Field descriptions are prompt text; the reducer/router is code.

@executedBy(MODEL) @role(prompt) @stage("S6")
class S6Outcomes {

    Schema schema(Theta θ) {
        // VerificationOutcomes: outcomes: list<VerificationOutcome>
        Prompt p = new Prompt();
        p.must(θ["p.s6_outcomes.outcomes_one_entry_per_finding"]);                              // src: vvaharness/pipeline/stages/s6/outcomes.py:133
        p.rule(θ["p.s6_outcomes.outcomes_omitted_finding_dropped"]);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:134
        p.include(verdictFields(θ));
        p.include(correctionFields(θ));
        p.include(traitFields(θ));
        p.include(additionalFindings(θ));
        return Schema.of("VerificationOutcomes", p);
    }

    Prompt verdictFields(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["p.s6_outcomes.finding_id_echo_verbatim"]);                                  // src: vvaharness/pipeline/stages/s6/outcomes.py:40
        p.choose(θ["p.s6_outcomes.verdict_set"]);                                               // src: vvaharness/pipeline/stages/s6/outcomes.py:41
        p.rule(θ["p.s6_outcomes.true_positive_real_and_reachable"]);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:42
        p.evidence(θ["p.s6_outcomes.false_positive_must_name_refuting_control"]);               // src: vvaharness/pipeline/stages/s6/outcomes.py:43
        p.rule(θ["p.s6_outcomes.inconclusive_encouraged"]);                                     // src: vvaharness/pipeline/stages/s6/outcomes.py:44
        p.forbid(θ["p.s6_outcomes.no_guessed_false_positive"]);                                 // src: vvaharness/pipeline/stages/s6/outcomes.py:45
        p.format(θ["p.s6_outcomes.confidence_scale_0_10"]);                                     // src: vvaharness/pipeline/stages/s6/outcomes.py:48
        p.threshold(θ["p.s6_outcomes.confidence_hard_gate_disclosed"]);                         // src: vvaharness/pipeline/stages/s6/outcomes.py:49
        p.format(θ["p.s6_outcomes.reason_one_or_two_sentences"]);                               // src: vvaharness/pipeline/stages/s6/outcomes.py:73
        return p;
    }

    Prompt correctionFields(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s6_outcomes.corrected_cwe_when_label_wrong"]);                              // src: vvaharness/pipeline/stages/s6/outcomes.py:75
        p.rule(θ["p.s6_outcomes.corrected_cwe_with_true_positive"]);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:77
        p.forbid(θ["p.s6_outcomes.no_refute_for_imprecise_cwe"]);                               // src: vvaharness/pipeline/stages/s6/outcomes.py:78
        p.format(θ["p.s6_outcomes.corrected_cwe_empty_when_right"]);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:79
        p.rule(θ["p.s6_outcomes.corrected_line_when_wrong_line"]);                              // src: vvaharness/pipeline/stages/s6/outcomes.py:81
        p.must(θ["p.s6_outcomes.corrected_line_is_sink_not_header"]);                           // src: vvaharness/pipeline/stages/s6/outcomes.py:82
        p.format(θ["p.s6_outcomes.corrected_line_zero_when_already_sink"]);                     // src: vvaharness/pipeline/stages/s6/outcomes.py:83
        p.rule(θ["p.s6_outcomes.confirmed_repeat_lines_same_file"]);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:85
        p.rule(θ["p.s6_outcomes.confirmed_repeat_each_becomes_finding"]);                       // src: vvaharness/pipeline/stages/s6/outcomes.py:88
        p.rule(θ["p.s6_outcomes.confirmed_repeat_only_unfiled"]);                               // src: vvaharness/pipeline/stages/s6/outcomes.py:89
        p.format(θ["p.s6_outcomes.cvss_vector_3_1_base"]);                                      // src: vvaharness/pipeline/stages/s6/outcomes.py:91
        p.forbid(θ["p.s6_outcomes.cvss_vector_empty_if_unjustified"]);                          // src: vvaharness/pipeline/stages/s6/outcomes.py:92
        return p;
    }

    Prompt traitFields(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s6_outcomes.control_absence_definition"]);                                  // src: vvaharness/pipeline/stages/s6/outcomes.py:94
        p.tiebreak(θ["p.s6_outcomes.control_absence_unsure_false"]);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:98
        p.rule(θ["p.s6_outcomes.channel_posture_definition"]);                                  // src: vvaharness/pipeline/stages/s6/outcomes.py:100
        p.tiebreak(θ["p.s6_outcomes.channel_unsure_main"]);                                     // src: vvaharness/pipeline/stages/s6/outcomes.py:103
        p.forbid(θ["p.s6_outcomes.reframed_only_under_reframe_duty"]);                          // src: vvaharness/pipeline/stages/s6/outcomes.py:105
        return p;
    }

    Prompt additionalFindings(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.s6_outcomes.additional_findings_distinct_same_file"]);                      // src: vvaharness/pipeline/stages/s6/outcomes.py:122
        p.evidence(θ["p.s6_outcomes.additional_findings_same_evidence_bar"]);                   // src: vvaharness/pipeline/stages/s6/outcomes.py:124
        p.evidence(θ["p.s6_outcomes.additional_findings_pointable_only"]);                      // src: vvaharness/pipeline/stages/s6/outcomes.py:125
        return p;
    }

    @executedBy(CODE)
    Object clampConfidence(Object v) {
        // Clamp into 0-10 (a "N/10" string reads as N) instead of failing the whole batch.
        double f = parseOutOfTen(v);                                                            // src: vvaharness/pipeline/stages/s6/outcomes.py:56
        int score = isFinite(f) ? min(10, max(0, (int) f)) : (f > 0 ? 10 : 0);                 // src: vvaharness/pipeline/stages/s6/outcomes.py:68
        if (score != f) Counters.bump("s6_confidence_clamped");                                 // src: vvaharness/pipeline/stages/s6/outcomes.py:71
        return score;
    }

    @executedBy(CODE)
    VerificationOutcomes parseOutcomes(String raw) {
        // Tolerate JSON-in-prose and a bare single outcome.
        for (Function attempt : List.of(validateDirect, validateSalvaged, validateLone)) {      // src: vvaharness/pipeline/stages/s6/outcomes.py:161
            VerificationOutcomes parsed = attempt(raw);
            if (parsed != null) return parsed;
        }
        Counters.bump(raw.strip().endsWith("}") ? "s6_outcome_malformed" : "s6_outcome_truncated"); // src: vvaharness/pipeline/stages/s6/outcomes.py:166
        return null;
    }

    @executedBy(CODE)
    Map<String, VerificationOutcome> splitBatchReply(String raw, List<String> findingIds) {
        VerificationOutcomes parsed = parseOutcomes(raw);                                       // src: vvaharness/pipeline/stages/s6/outcomes.py:173
        if (parsed == null) return Map.of();
        Map byId = new Map();
        for (VerificationOutcome o : parsed.outcomes) {                                         // src: vvaharness/pipeline/stages/s6/outcomes.py:178
            if (!findingIds.contains(o.findingId)) { Counters.bump("s6_batch_finding_id_invented"); continue; } // src: vvaharness/pipeline/stages/s6/outcomes.py:179
            byId.put(o.findingId, o);
        }
        if (findingIds.size() > byId.size()) Counters.bump("s6_batch_finding_omitted", findingIds.size() - byId.size()); // src: vvaharness/pipeline/stages/s6/outcomes.py:185
        return byId;
    }

    @executedBy(CODE)
    String remapReasonIds(String reason, Map<String, String> display) {
        // Batch-local fN ids in reason become file:line (reason ships to the report).
        return Regex.sub(REASON_PROSE_ID_RX, reason, m -> display.getOrDefault(m, m));          // src: vvaharness/pipeline/stages/s6/outcomes.py:197
    }

    @executedBy(CODE)
    Map corrections(Finding f, VerificationOutcome o, Integer maxLine) {
        Map fixed = new Map();
        String cwe = Cwe.norm(o.correctedCwe);
        if (cwe != null && cwe != f.cwe) { fixed.put("cwe", cwe); Counters.bump("s6_finding_cwe_corrected"); } // src: vvaharness/pipeline/stages/s6/outcomes.py:206
        int line = o.correctedLineStart;
        if (line > 0 && line != f.lineStart) {                                                  // src: vvaharness/pipeline/stages/s6/outcomes.py:210
            // A correction back onto the header S5 moved off is refused.
            if (f.preAnchorLine > 0 && line == f.preAnchorLine) Counters.bump("s6_finding_line_correction_reverted_reanchor"); // src: vvaharness/pipeline/stages/s6/outcomes.py:212
            else if (maxLine != null && line > maxLine) Counters.bump("s6_finding_line_correction_ignored"); // src: vvaharness/pipeline/stages/s6/outcomes.py:214
            else { fixed.put("line_start", line); fixed.put("line_end", max(f.lineEnd, line)); fixed.put("pre_anchor_line", 0); } // src: vvaharness/pipeline/stages/s6/outcomes.py:217
        }
        if (maxLine != null && fixed.getOrDefault("line_end", f.lineEnd) > maxLine) fixed.put("line_end", maxLine); // src: vvaharness/pipeline/stages/s6/outcomes.py:225
        return fixed;
    }

    @executedBy(CODE)
    Map traitStamps(VerificationOutcome o) {
        Map stamped = new Map();
        if (o.controlAbsence) stamped.put("control_absence", true);                             // src: vvaharness/pipeline/stages/s6/outcomes.py:234
        if (o.channel == "posture") stamped.put("channel", "posture");                          // src: vvaharness/pipeline/stages/s6/outcomes.py:237
        return stamped;
    }

    @executedBy(CODE)
    Map verdictFieldsOf(VerificationOutcome o) {
        String vector = o.cvssVector.strip();
        Double score = vector.isEmpty() ? null : Cvss.score(vector);                            // src: vvaharness/pipeline/stages/s6/outcomes.py:247
        // A real weakness scored zero-impact ships unscored rather than ranking last.
        if (o.verdict == "TRUE_POSITIVE" && !vector.isEmpty() && score == 0.0) { vector = null; score = null; } // src: vvaharness/pipeline/stages/s6/outcomes.py:248
        // INCONCLUSIVE maps to verdict None (Finding.verdict has no INCONCLUSIVE slot).
        return Map.of("verdict", o.verdict == "INCONCLUSIVE" ? null : o.verdict, "verdict_confidence", o.confidence,
                      "verdict_reason", o.reason, "cvss_vector", vector, "cvss_score", score); // src: vvaharness/pipeline/stages/s6/outcomes.py:253
    }

    @executedBy(CODE)
    String classify(VerificationOutcome o, int minConfidence, Theta θ) {
        // Verdict routing: FP dropped; INCONCLUSIVE kept as undetermined; TP below the floor dropped as UNCONFIRMED.
        Object routing = θ["code.s6.verdict_routing"];                                          // src: vvaharness/pipeline/stages/s6/outcomes.py:262
        // A tool-free replay's low-confidence refutation must not delete the finding unseen.
        if (o.replayed && o.verdict == "FALSE_POSITIVE" && o.confidence < minConfidence) { Counters.bump("s6_replayed_fp_held"); return "INCONCLUSIVE"; } // src: vvaharness/pipeline/stages/s6/outcomes.py:265
        if (o.verdict == "INCONCLUSIVE") return "INCONCLUSIVE";                                 // src: vvaharness/pipeline/stages/s6/outcomes.py:269
        if (o.verdict == "FALSE_POSITIVE") return "FALSE_POSITIVE";                             // src: vvaharness/pipeline/stages/s6/outcomes.py:272
        if (o.confidence < minConfidence) return "UNCONFIRMED";                                 // src: vvaharness/pipeline/stages/s6/outcomes.py:274
        return "TRUE_POSITIVE";
    }

    @executedBy(CODE)
    List<Integer> newRepeatLines(Finding primary, VerificationOutcome o, Function reserve, Integer maxLine) {
        List<Integer> fresh = new List();
        for (int n : sorted(Set.of(o.confirmedRepeatLines))) {                                  // src: vvaharness/pipeline/stages/s6/outcomes.py:284
            if (n <= 0 || n == primary.lineStart) continue;
            if (maxLine != null && n > maxLine) { oob += 1; continue; }                         // src: vvaharness/pipeline/stages/s6/outcomes.py:287
            // reserve() checks and claims atomically: two sessions cannot file the same new line.
            if (!reserve(n)) { stale += 1; continue; }                                          // src: vvaharness/pipeline/stages/s6/outcomes.py:291
            fresh.add(n);
        }
        return fresh;
    }

    @executedBy(CODE)
    List<Finding> applyOutcome(Finding f, VerificationOutcome o, Function reserve, boolean stamps, boolean reframe, Integer maxLine, boolean cloneRepeats) {
        Map update = verdictFieldsOf(o) + corrections(f, o, maxLine);                           // src: vvaharness/pipeline/stages/s6/outcomes.py:310
        if (stamps) update.putAll(traitStamps(o));                                              // src: vvaharness/pipeline/stages/s6/outcomes.py:311
        Finding primary = f.copy(update);
        if (o.verdict != "TRUE_POSITIVE") return List.of(primary);                              // src: vvaharness/pipeline/stages/s6/outcomes.py:314
        if (reserve == null) reserve = line -> true;
        else if (primary.lineStart != f.lineStart) reserve(primary.lineStart);                  // src: vvaharness/pipeline/stages/s6/outcomes.py:320
        if (reframe && o.reframed) { Counters.bump("s6_verdict_reframed"); return List.of(primary); } // src: vvaharness/pipeline/stages/s6/outcomes.py:321
        if (!cloneRepeats) return List.of(primary);                                             // src: vvaharness/pipeline/stages/s6/outcomes.py:325
        // One point clone per new confirmed repeat site; refs/snippet cleared (they name the primary's line).
        return List.of(primary) + newRepeatLines(primary, o, reserve, maxLine).map(n -> primary.copy(lineStart = n, lineEnd = n, isRepeatClone = true)); // src: vvaharness/pipeline/stages/s6/outcomes.py:334
    }

    @executedBy(CODE)
    List<Finding> discovered(VerificationOutcome o, Finding parent, String repoRoot, Collection<String> inventory, Theta θ) {
        if (o.additionalFindings.isEmpty()) return List.of();                                   // src: vvaharness/pipeline/stages/s6/outcomes.py:344
        String chunk = (parent.chunkId.isEmpty() ? "s6" : parent.chunkId) + "+s6";              // src: vvaharness/pipeline/stages/s6/outcomes.py:347
        List<Finding> out = new List();
        for (InvestigatedFinding extra : o.additionalFindings) out.addAll(S4OutcomeReducer.fanOut(extra, chunk, parent.cwe, repoRoot, inventory, θ)); // src: vvaharness/pipeline/stages/s6/outcomes.py:356
        return out.map(f -> f.copy(verdict = "TRUE_POSITIVE", verdictConfidence = o.confidence, origin = "s6_discovered")); // src: vvaharness/pipeline/stages/s6/outcomes.py:359
    }

    @executedBy(CODE)
    Finding unverified(Finding f, String detail) {
        return f.copy(verdict = null, verdictConfidence = 0, verdictReason = detail);           // src: vvaharness/pipeline/stages/s6/outcomes.py:364
    }
}
