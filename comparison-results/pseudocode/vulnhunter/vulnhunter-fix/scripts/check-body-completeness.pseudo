// file: vulnhunter-fix/scripts/check-body-completeness.py
// Gate 2, body completeness (REQ-GAT-003): the PR / issue body must carry every required section heading with
// non-empty content (headings inside code fences do not count), contain no placeholder tokens, and carry any enforced strings.

@executedBy(CODE) @role(evaluation) @stage("fix")
class CheckBodyCompleteness {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    int main(List<String> argv, Theta θ) {
        // --kind pr|issue, --tier FULL|MITIGATION|WORKAROUND, --status, --sweep-ran true|false, --enforce-strings, --forbid-strings
        Args args = parseArgs(argv);                                                                      // src: vulnhunter-fix/scripts/check-body-completeness.py:146
        return check(args, θ);                                                                            // src: vulnhunter-fix/scripts/check-body-completeness.py:155
    }

    List<Range> fenceRanges(String text) {
        List<Range> ranges = List.of();
        boolean inFence = false;
        int start = 0;
        int offset = 0;
        for (String line : text.linesKeepEnds()) {
            if (line.lstrip().startsWith("```")) {                                                        // src: vulnhunter-fix/scripts/check-body-completeness.py:49
                if (!inFence) {
                    inFence = true;
                    start = offset;
                } else {
                    inFence = false;
                    ranges.add(new Range(start, offset + line.length()));                                 // src: vulnhunter-fix/scripts/check-body-completeness.py:55
                }
            }
            offset += line.length();
        }
        if (inFence) ranges.add(new Range(start, offset));                                                // src: vulnhunter-fix/scripts/check-body-completeness.py:57
        return ranges;
    }

    String maskFences(String text, List<Range> fences) {
        // same-length blanking keeps offsets 1:1 with the original text
        return text.replaceRangesKeepingNewlines(fences, " ");                                            // src: vulnhunter-fix/scripts/check-body-completeness.py:67
    }

    Pair<Boolean, Boolean> findSectionContent(String text, String heading) {
        String masked = maskFences(text, fenceRanges(text));                                              // src: vulnhunter-fix/scripts/check-body-completeness.py:83
        // heading anchored at end: followed by EOL / whitespace-EOL / colon, not further words
        Match match = Regex.searchMultiline("^" + Regex.escape(heading) + "\\s*(?:$|:)", masked);         // src: vulnhunter-fix/scripts/check-body-completeness.py:88
        if (match == null) return Pair.of(false, false);                                                  // src: vulnhunter-fix/scripts/check-body-completeness.py:91
        int after = match.start() + heading.length();
        Match next = Regex.searchMultiline("^(?:##|###)\\s", masked.substring(after));                     // src: vulnhunter-fix/scripts/check-body-completeness.py:94
        int end = next != null ? after + next.start() : masked.length();
        String body = text.substring(after, end).strip();                                                 // src: vulnhunter-fix/scripts/check-body-completeness.py:96
        return Pair.of(true, !body.isEmpty());
    }

    int check(Args args, Theta θ) {
        String text;
        try {
            text = Files.read(args.body);                                                                 // src: vulnhunter-fix/scripts/check-body-completeness.py:102
        } catch (OSError e) {
            return 2;                                                                                     // src: vulnhunter-fix/scripts/check-body-completeness.py:105
        }
        List<String> errors = List.of();
        List<String> required = List.copyOf(θ["code.fix.scripts.check_body_completeness.required_always"]); // src: vulnhunter-fix/scripts/check-body-completeness.py:26
        if (args.kind == "pr") required.add("## Verification Table");                                     // src: vulnhunter-fix/scripts/check-body-completeness.py:109
        if (args.tier != "FULL") required.add("## Residual Risk");                                        // src: vulnhunter-fix/scripts/check-body-completeness.py:111
        if (args.status == "BREAKING_CHANGE") required.add("## Breaking Change");                         // src: vulnhunter-fix/scripts/check-body-completeness.py:113
        if (args.sweepRan == "true") required.add("## Sweep Summary");                                    // src: vulnhunter-fix/scripts/check-body-completeness.py:115
        for (String heading : required) {
            Pair<Boolean, Boolean> r = findSectionContent(text, heading);                                 // src: vulnhunter-fix/scripts/check-body-completeness.py:119
            if (!r.first) errors.add("missing required section: " + heading);                             // src: vulnhunter-fix/scripts/check-body-completeness.py:121
            else if (!r.second) errors.add("section is empty: " + heading);                               // src: vulnhunter-fix/scripts/check-body-completeness.py:123
        }
        Set<String> forbidden = Set.copyOf(θ["code.fix.scripts.check_body_completeness.forbidden_tokens"]); // src: vulnhunter-fix/scripts/check-body-completeness.py:39
        if (args.forbidStrings != null) forbidden.addAll(args.forbidStrings);                             // src: vulnhunter-fix/scripts/check-body-completeness.py:127
        for (String term : forbidden) {
            // plain substring match anywhere in the body, including code blocks
            if (text.contains(term)) errors.add("forbidden token: " + term);                              // src: vulnhunter-fix/scripts/check-body-completeness.py:129
        }
        if (args.enforceStrings != null) {
            for (String term : args.enforceStrings) {
                if (!text.contains(term)) errors.add("required token missing: " + term);                  // src: vulnhunter-fix/scripts/check-body-completeness.py:135
            }
        }
        if (!errors.isEmpty()) return 1;                                                                  // src: vulnhunter-fix/scripts/check-body-completeness.py:141
        return 0;
    }
}
