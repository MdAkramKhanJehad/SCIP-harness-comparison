// file: vvaharness/injectors/cve_feed.py
// Loads the known-CVE feed (inject.cve_file) as prioritisation context. Missing file -> empty;
// malformed structure -> empty with a warning; a malformed record drops only itself.

@executedBy(CODE) @role(io) @stage("S1")
class CveFeed {

    List<CVE> loadCves(Path path, Theta θ) {
        Path p = path;                                                                            // = inject.cve_file, resolved by the orchestrator. src: vvaharness/injectors/cve_feed.py:33
        if (!p.exists()) return new List();                                                       // src: vvaharness/injectors/cve_feed.py:34
        List items;
        try {
            Object data = Json.parse(p.readText("utf-8"));                                        // src: vvaharness/injectors/cve_feed.py:41
            if (data instanceof Map) {                                                            // accept a bare list or an object with a cves key. src: vvaharness/injectors/cve_feed.py:46
                items = data.get("cves");                                                         // src: vvaharness/injectors/cve_feed.py:47
                if (items == null) throw new ValueError("CVE feed object without a cves key");   // src: vvaharness/injectors/cve_feed.py:48
            } else {
                items = data;                                                                     // src: vvaharness/injectors/cve_feed.py:53
            }
            if (!(items instanceof List)) throw new TypeError("CVE feed payload must be a list"); // src: vvaharness/injectors/cve_feed.py:57
        } catch (OSError | ValueError | TypeError e) {
            Log.warn("CVE_FEED_UNREADABLE", p, e);                                                // src: vvaharness/injectors/cve_feed.py:61
            ErrLog.log("inject.cves", p, e);                                                      // src: vvaharness/injectors/cve_feed.py:62
            return new List();                                                                    // src: vvaharness/injectors/cve_feed.py:63
        }
        List<CVE> out = new List();
        int skipped = 0;
        for (int idx = 0; idx < items.size(); idx++) {                                           // src: vvaharness/injectors/cve_feed.py:70
            try {
                out.add(new CVE(items.get(idx)));                                       // src: vvaharness/injectors/cve_feed.py:72
            } catch (ValidationError | TypeError | ValueError e) {
                if (!θ["code.injectors.cve_feed.per_item_validation"]) return new List();
                skipped++;                                                                        // one bad record drops only itself. src: vvaharness/injectors/cve_feed.py:74
                ErrLog.log("inject.cves.item", p + "#" + idx, e);                                 // src: vvaharness/injectors/cve_feed.py:77
            }
        }
        if (skipped > 0) Log.warn("CVE_FEED_RECORDS_SKIPPED", p, skipped, out.size());           // src: vvaharness/injectors/cve_feed.py:78
        return out;                                                                               // src: vvaharness/injectors/cve_feed.py:80
    }
}
