ModelPricing { input_per_mtok; output_per_mtok; cache_read_per_mtok = null; cache_creation_per_mtok = null }   // dollars per million tokens, one exact model id
PricingTable { models: Map(model id -> ModelPricing); path; sha256; source: "env" | "config"; cache_defaults }

