# vvaharness/backends/harness/deepagents/options/subagents.py

Builds the native DeepAgents subagent specs, one per configured persona, always including a gated `general-purpose` spec that displaces the library's ungated builtin of that name. For each spec it resolves the tool allow list, builds the model, and assembles the per-spec middleware: redaction or delete-exclusion, the executor tool gate, the per-subagent model-call budget, `ForceVerdictOnly`, prompt-cache markers and the connection retry.

Source: `vvaharness/backends/harness/deepagents/options/subagents.py` (lines 1-196)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/streaming.sudo` build_subagents; `vvaharness/backends/harness/deepagents/options/oneshot.sudo` _build_oneshot_graph (agents={})

// src: vvaharness/backends/harness/deepagents/options/subagents.py:58
GENERAL_PURPOSE_NAME = "general-purpose"

// src: vvaharness/backends/harness/deepagents/options/subagents.py:154-196
fn get_subagent_specs(options, agents?):executor=code {
  configured = copy of (if (agents == null) options.agents else agents)
  if (GENERAL_PURPOSE_NAME not in configured) configured[GENERAL_PURPOSE_NAME] = _general_purpose_agent(options)
  specs = []
  for each (name, subagent) in configured {
    tool_names = _subagent_tool_names(subagent, options)
    tools = _build_session_tools(options, tool_names)
    subagent_model_id = subagent.model or options.model
    subagent_model = model_building.build_model_cached(subagent_model_id, options.env, options.model_provider,
                       use_responses_api=options.use_responses_api, think_in_prompt=options.think_in_prompt)
    // preserved: no effort is passed for subagent models (effort defaults to null), unlike the parent graph
    spec = { name, description: subagent.description, system_prompt: subagent.prompt, model: subagent_model, tools }
    spec.middleware = _spec_middleware(tool_names, tools, options, budget=_subagent_budget(subagent))
    sources = filesystem._skill_sources(options.skill_root, options.cwd)
    if (sources) spec.skills = sources
    if (subagent.response_model != null) spec.response_format = response_format._strategy_for(subagent.response_model, subagent_model_id, options.model_provider)
    specs.append(spec)
  }
  return specs
}

// src: vvaharness/backends/harness/deepagents/options/subagents.py:95-103
fn _general_purpose_agent(options):executor=code {
  return SubagentDefinition(
    name=GENERAL_PURPOSE_NAME,
    description=DEFAULT_GENERAL_PURPOSE_DESCRIPTION,   // external: deepagents.middleware.subagents; wording not in this repository
    prompt=DEFAULT_SUBAGENT_PROMPT,                    // external: deepagents.middleware.subagents; wording not in this repository
    tools=[t for each t in _tool_policy(options).allowed_tools if t in READ_TOOLS])
}

// src: vvaharness/backends/harness/deepagents/options/subagents.py:74-92
fn _subagent_tool_names(subagent, options):executor=code {
  policy = _tool_policy(options)
  allowed = if (subagent.tools != null) subagent.tools else policy.allowed_tools
  denied = subagent.disallowed_tools or policy.disallowed_tools
  if (!options.allow_writes) denied = denied union MUTATING_TOOLS
  granted = (allowed minus denied), then options.fact_tools appended, duplicates removed, order kept
  excluded = [LEGACY_AGENT_TOOL] union (if (!options.allow_writes) MUTATING_TOOLS else [])
  return granted minus excluded
}

// src: vvaharness/backends/harness/deepagents/options/subagents.py:116-126
fn _subagent_budget(subagent):executor=code {
  limit = subagent.max_model_calls or 0
  if (limit <= 0) return null   // no budget installed
  outcome = if (subagent.response_model != null) [response_format._tool_name_for(subagent.response_model)] else []
  return model_call_budget.ModelCallBudget(limit, outcome_tools=outcome, counter="subagent_model_call_budget_final_turn[${subagent.name}]")
  // a fresh budget per spec build; specs are rebuilt per session
}

// src: vvaharness/backends/harness/deepagents/options/subagents.py:129-151
fn _spec_middleware(tool_names, tools, options, budget?):executor=code {
  // Redaction is keyed per subagent on its own tools, never on the session allow_writes.
  if (tool_names intersection MUTATING_TOOLS is not empty) middleware = [ExcludeTools(["delete"])]
  else middleware = redaction.read_only_middleware()   // [RedactToolResults(), ExcludeTools(NATIVE_WRITE_TOOLS union ["delete"])]
  if (options.permitted_tool_calls != null) middleware.append(permit_tools.PermitTools(_permitted_for_spec(tool_names, tools)))
  verdict_only = if (options.force_verdict_only) force_verdict_only.ForceVerdictOnly() else null
  // budget sits outside ForceVerdictOnly so the budget's final turn reaches it with tools withdrawn; both sit outside the connection retry, so a retried call is not counted twice
  middleware.extend([budget, verdict_only] without nulls)
  middleware.append(prompt_caching.BlockMarkerPromptCaching(enabled=bool(options.cache_markers, default true)))   // mark_tail left at its default
  middleware.append(graph_builder._CONNECTION_RETRY_MIDDLEWARE)
  // preserved: unlike the parent stack, subagent specs get no RepairInvalidToolArgs, LogInvalidRequestShape, CapOutputTokens or LogToolCalls from this function, and the connection retry is not skipped for "preflight" names
  return middleware
}

// src: vvaharness/backends/harness/deepagents/options/subagents.py:106-113
fn _permitted_for_spec(tool_names, tools):executor=code {
  native = [LOGICAL_TO_NATIVE[t] or t for each t in tool_names]
  if (native contains the native name of any READ_TOOLS entry) native = native union NATIVE_IMPLIED_READS
  return native union names of tools
}

// src: vvaharness/backends/harness/deepagents/options/subagents.py:61-71
fn _tool_policy(options):executor=code { return options.tool_policy or ToolPolicy() }
fn _build_session_tools(options, allowed_tools):executor=code {
  builder = options.tool_builder or deepagents.tools.build_tools
  return builder(options, allowed_tools)
}
