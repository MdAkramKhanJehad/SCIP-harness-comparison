// file: vvaharness/backends/harness/__init__.py
// Public surface of the harness family: re-exports the contract (vocabularies, options, messages, errors),
// the permission gate, provider routing and the backend registry. Consumers import from here.

@executedBy(CODE) @role(backend)
class Harness {

    // Re-exported names (no logic of their own).
    List<String> exports() {
        return List.of("DEFAULT_GRAPH_NAME", "LEGACY_AGENT_TOOL", "LOGICAL_TO_NATIVE", "MCP_TOOL_PREFIX", "MUTATING_TOOLS", "NATIVE_CONTENT_TOOLS", "NATIVE_WRITE_TOOLS", "ORCHESTRATION_TOOLS", "READ_ONLY_TOOLS", "READ_TOOLS", "UNCONDITIONALLY_DENIED_TOOLS", "EffortLevel", "FactToolSpec", "Harness", "HarnessAssistantText", "HarnessCLINotFoundError", "HarnessConnectionError", "HarnessError", "HarnessJSONDecodeError", "HarnessMessage", "HarnessMessageParseError", "HarnessProcessError", "HarnessResult", "HarnessSessionInit", "HarnessToolResult", "HarnessToolUse", "OneShotOptions", "OneShotResult", "PermissionDecision", "PermissionsPolicy", "Provider", "SessionOptions", "SettingSource", "StreamingOptions", "SubagentDefinition", "ToolBuilder", "ToolPolicy", "compose_tool_builders", "evaluate_write", "get_harness", "routes_to_anthropic"); // src: vvaharness/backends/harness/__init__.py:63
    }

    HarnessHarness getHarness(String via, Theta θ) {
        return HarnessRegistry.getHarness(via, θ);                                                          // src: vvaharness/backends/harness/__init__.py:61
    }

    PermissionDecision evaluateWrite(Map<String, Object> inputData, Path resolvedTarget, Set<String> allowedOutputFiles) {
        return PermissionRules.evaluateWrite(inputData, resolvedTarget, allowedOutputFiles);             // src: vvaharness/backends/harness/__init__.py:58
    }

    boolean routesToAnthropic(String modelId, String provider, Theta θ) {
        return ProviderRouting.routesToAnthropic(modelId, provider, θ);                                     // src: vvaharness/backends/harness/__init__.py:60
    }

    // unclear: is_halt_error is NOT re-exported by this __init__; callers import it from harness.models.
    // This forwarder exists only so pass-1 calls written as Harness.isHaltError resolve to the real predicate.
    boolean isHaltError(Exception exc) {
        return HarnessModels.isHaltError(exc);                                                           // src: vvaharness/backends/harness/models.py:722
    }
}
