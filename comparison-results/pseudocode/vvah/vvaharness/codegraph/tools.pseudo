// file: vvaharness/codegraph/tools.py
// Read-only graph-query tools over ctx.graph_handle; S2, S4 and S6 each build these.
// Tool docstrings are the descriptions the model sees; error results carry hints instead of raising.

@executedBy(CODE) @role(tool)
class CodegraphTools {

    Map PLUGIN_TOOLS = new OrderedMap(); // src: vvaharness/codegraph/tools.py:289

    String qname(Map row) {
        Object file = row.get("file"); Object name = row.get("name"); // src: vvaharness/codegraph/tools.py:60
        return file instanceof String && name instanceof String ? file + "::" + name : ""; // src: vvaharness/codegraph/tools.py:61
    }
    String ref(Object entity) {
        Object name = firstTruthy(getattr(entity, "name", null), getattr(entity, "qualified_name", null), ""); // src: vvaharness/codegraph/tools.py:66
        Object path = firstTruthy(getattr(entity, "file_path", null), getattr(entity, "path", null), ""); // src: vvaharness/codegraph/tools.py:67
        return truthy(path) && truthy(name) ? path + "::" + name : str(truthyOr(name, path)); // src: vvaharness/codegraph/tools.py:68
    }
    List<String> refs(Iterable entities) {
        return iterable(truthyOr(entities, List.of())).map(e -> ref(e)).filter(r -> !r.isEmpty()).head(REF_CAP); // src: vvaharness/codegraph/tools.py:73
    }
    List<String> paths(Iterable paths) {
        return iterable(truthyOr(paths, List.of())).map(p -> join(" -> ", refs(firstTruthy(getattr(p, "nodes", List.of()), getattr(p, "entities", List.of()))))).head(PATH_CAP); // src: vvaharness/codegraph/tools.py:78
    }
    SymbolSelector selector(String file, String symbol, Integer line) {
        return new SymbolSelector(truthyOr(symbol, file), file, line); // src: vvaharness/codegraph/tools.py:84
    }
    Map cypherError(Exception e) {
        return Map.of("error", typeName(e) + ": " + e.message); // src: vvaharness/codegraph/tools.py:101
    }
    boolean isEmptyResult(Object result) {
        if (result instanceof Map) return result.values().filter(v -> v instanceof List).allMatch(v -> v.isEmpty()); // empty set of list fields also returns true. src: vvaharness/codegraph/tools.py:106
        return result == null || (result instanceof List && result.isEmpty()); // src: vvaharness/codegraph/tools.py:108
    }
    Map communityFiles(ContextPackage ctx) {
        return iterable(truthyOr(getattr(ctx, "modules", null), List.of())).indexLastBy(m -> m.name).mapValues(m -> m.files); // src: vvaharness/codegraph/tools.py:136
    }

    List<String> GRAPH_TOOL_NAMES = List.of("GraphContext", "GraphImpact", "GraphNeighbors", "GraphCommunityOf", "GraphImporters", "GraphSinksInCommunity"); // src: vvaharness/codegraph/tools.py:287
    int REF_CAP = θ["code.codegraph.tools.ref_cap"];    // literal // src: vvaharness/codegraph/tools.py:37
    int PATH_CAP = θ["code.codegraph.tools.path_cap"];    // literal // src: vvaharness/codegraph/tools.py:38

    /** Shared argument rules repeated in every file/symbol tool description. */
    @executedBy(MODEL) @role(prompt)
    Prompt argRules(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.graph_tools.file_exact_repo_relative"]);                                 // src: vvaharness/codegraph/tools.py:149
        p.must(θ["p.graph_tools.symbol_bare_defined_name"]);                                 // not Class.method, a route, or a template  // src: vvaharness/codegraph/tools.py:149
        p.rule(θ["p.graph_tools.line_disambiguates_duplicate_names"]);                       // src: vvaharness/codegraph/tools.py:149
        return p;
    }

    /** _resolve_error: a usable answer when the graph cannot resolve symbol. */
    Map resolveError(String file, String symbol, Exception exc, Theta θ) {
        Prompt hint = new Prompt();
        if (exc is SymbolAmbiguousError) {                                                   // src: vvaharness/codegraph/tools.py:88
            hint.rule(θ["p.graph_tools.ambiguous_symbol_hint"]);                             // pass line or name the enclosing class/function  // src: vvaharness/codegraph/tools.py:89
        } else {
            hint.context(θ["p.graph_tools.unknown_symbol_scope_hint"]);                      // indexes functions, methods, classes only  // src: vvaharness/codegraph/tools.py:92
            hint.rule(θ["p.graph_tools.unknown_symbol_fallback_grep"]);                      // enclosing function's name, or fall back to Grep  // src: vvaharness/codegraph/tools.py:94
        }
        return Map.of("error", exc.toString(), "hint", hint);                               // src: vvaharness/codegraph/tools.py:95
    }

    /** GraphContext(file, symbol, line): callers, callees, imports, implementors and call paths in one call. */
    Map graphContext(GraphToolContext gtx, String file, String symbol, Integer line, Theta θ) {
        Prompt d = new Prompt();
        d.context(θ["p.graph_tools.graphcontext_description"]);                              // src: vvaharness/codegraph/tools.py:149
        d.rule(θ["p.graph_tools.prefer_context_over_neighbors"]);                            // src: vvaharness/codegraph/tools.py:149
        d.include(argRules(θ));
        Map limits = θ["p.graph_tools.context_limits"];                                      // candidates 5, group 8, depth 2, nodes 60, edges 120, paths 8  // src: vvaharness/codegraph/tools.py:33
        try {
            Result res = gtx.handle.graph.context(selector(file, symbol, line), limits);     // src: vvaharness/codegraph/tools.py:152
            return count(Map.of("symbol", ref(res.symbol), "callers", refs(res.callers), "callees", refs(res.callees), "imports", refs(res.imports), "implementors", refs(res.implementors), "call_paths", paths(res.callPaths))); // src: vvaharness/codegraph/tools.py:156
        } catch (Exception exc) {
            return count(resolveError(file, symbol, exc, θ));                                // src: vvaharness/codegraph/tools.py:155
        }
    }

    /** GraphImpact(file, symbol, direction, line): transitive reachability. */
    Map graphImpact(GraphToolContext gtx, String file, String symbol, String direction, Integer line, Theta θ) {
        Prompt d = new Prompt();
        d.context(θ["p.graph_tools.graphimpact_description"]);                               // src: vvaharness/codegraph/tools.py:175
        d.rule(θ["p.graph_tools.graphimpact_empty_upstream_meaning"]);                       // empty upstream = entry point or dead code  // src: vvaharness/codegraph/tools.py:175
        d.include(argRules(θ));
        if (direction == null) direction = θ["p.graph_tools.graphimpact_default_direction"]; // upstream  // src: vvaharness/codegraph/tools.py:173
        String want = direction.lower().startsWith("down") ? "downstream" : "upstream";     // src: vvaharness/codegraph/tools.py:177
        Map limits = θ["p.graph_tools.impact_limits"];                                       // candidates 5, depth 4, nodes 80, edges 160, paths 10  // src: vvaharness/codegraph/tools.py:35
        Result res;
        try {
            res = gtx.handle.graph.impact(selector(file, symbol, line), want, limits);       // src: vvaharness/codegraph/tools.py:180
        } catch (Exception exc) {
            return count(resolveError(file, symbol, exc, θ));                                // src: vvaharness/codegraph/tools.py:183
        }
        List<String> affected = refs(res.affected);                                          // src: vvaharness/codegraph/tools.py:184
        String note = "";
        if (affected.isEmpty() && want == "upstream") note = θ["p.graph_tools.graphimpact_unreachable_note"]; // entry point, framework-dispatched, or unreachable  // src: vvaharness/codegraph/tools.py:190
        return count(Map.of("symbol", ref(res.symbol), "direction", want, "affected", affected, "reachable", !affected.isEmpty(), "note", note, "paths", paths(res.paths))); // src: vvaharness/codegraph/tools.py:185
    }

    /** GraphNeighbors(file, function): direct callers/callees, as two single-MATCH cypher queries (LIMIT 25 each). */
    Map graphNeighbors(GraphToolContext gtx, String file, String function, Theta θ) {
        Prompt d = new Prompt().context(θ["p.graph_tools.graphneighbors_description"]);      // function is the bare name, not Class.method  // src: vvaharness/codegraph/tools.py:205
        List<String> callees;
        try { callees = gtx.handle.graph.cypher(θ["code.codegraph.tools.neighbors_query"], Map.of("file", file, "function", function)).rows.map(r -> qname(r.toDict())).filter(q -> !q.isEmpty()); } // src: vvaharness/codegraph/tools.py:40
        catch (Exception exc) { return count(Map.of("error", exc.toString())); }            // src: vvaharness/codegraph/tools.py:211
        try {
            List<String> callers = gtx.handle.graph.cypher(θ["code.codegraph.tools.callers_query"], Map.of("file", file, "function", function)).rows.map(r -> qname(r.toDict())).filter(q -> !q.isEmpty()); // src: vvaharness/codegraph/tools.py:45
            return count(Map.of("callees", callees, "callers", callers));                    // src: vvaharness/codegraph/tools.py:218
        } catch (Exception exc) {
            return count(Map.of("callees", callees, "error", exc.toString()));              // keep callees alongside the error  // src: vvaharness/codegraph/tools.py:217
        }
    }

    /** GraphCommunityOf(file): pure scan of ctx.modules, no graph. */
    String graphCommunityOf(GraphToolContext gtx, String file, Theta θ) {
        Prompt d = new Prompt().context(θ["p.graph_tools.graphcommunityof_description"]);    // src: vvaharness/codegraph/tools.py:232
        for (Map.Entry entry : communityFiles(gtx.ctx).entries()) if (entry.value.contains(file)) return count(entry.key); // src: vvaharness/codegraph/tools.py:233
        return count(null); // src: vvaharness/codegraph/tools.py:236
    }

    /** GraphImporters(file): files that import file (LIMIT 25). */
    Object graphImporters(GraphToolContext gtx, String file, Theta θ) {
        Prompt d = new Prompt().context(θ["p.graph_tools.graphimporters_trust_boundary_signal"]); // trust-boundary signal, not reachability  // src: vvaharness/codegraph/tools.py:247
        try { return count(gtx.handle.graph.cypher(θ["code.codegraph.tools.importers_query"], Map.of("file", file)).rows.map(r -> r.toDict().get("path")).filter(p -> p instanceof String)); } // src: vvaharness/codegraph/tools.py:50
        catch (Exception exc) { return count(cypherError(exc)); } // src: vvaharness/codegraph/tools.py:251
    }

    /** GraphSinksInCommunity(community): ctx.unsafe_sinks joined onto a module's file set. */
    List<Map> graphSinksInCommunity(GraphToolContext gtx, String community, Theta θ) {
        Prompt d = new Prompt().context(θ["p.graph_tools.graphsinksincommunity_description"]); // src: vvaharness/codegraph/tools.py:263
        Set<String> files = Set.copyOf(communityFiles(gtx.ctx).getOrDefault(community, List.of())); // src: vvaharness/codegraph/tools.py:264
        return count(iterable(truthyOr(getattr(gtx.ctx, "unsafe_sinks", null), List.of())).filter(s -> files.contains(s.file)).map(s -> Map.of("file", s.file, "line", s.line, "function", s.function))); // src: vvaharness/codegraph/tools.py:265
    }

    /** _counted: bumps exactly one of graph_tool_result_error / empty / hit. */
    Object count(Object result) {
        if (result is Map && result.containsKey("error")) Counters.bump("graph_tool_result_error"); // src: vvaharness/codegraph/tools.py:112
        else if (isEmptyResult(result)) Counters.bump("graph_tool_result_empty");            // src: vvaharness/codegraph/tools.py:114
        else Counters.bump("graph_tool_result_hit");                                         // src: vvaharness/codegraph/tools.py:117
        return result;
    }

    /** Built-in names then plugin names (registered before any session opens). */
    List<String> graphToolNames() {
        return GRAPH_TOOL_NAMES.concat(PLUGIN_TOOLS.keys());                                 // src: vvaharness/codegraph/tools.py:307
    }

    Map builtins(Theta θ) {
        return Map.of("GraphContext", gtx -> toolClosure(this::graphContext, gtx, θ), "GraphImpact", gtx -> toolClosure(this::graphImpact, gtx, θ), "GraphNeighbors", gtx -> toolClosure(this::graphNeighbors, gtx, θ), "GraphCommunityOf", gtx -> toolClosure(this::graphCommunityOf, gtx, θ), "GraphImporters", gtx -> toolClosure(this::graphImporters, gtx, θ), "GraphSinksInCommunity", gtx -> toolClosure(this::graphSinksInCommunity, gtx, θ)); // src: vvaharness/codegraph/tools.py:277
    }
    void registerPluginGraphTools(Map tools, Theta θ) {
        for (Map.Entry entry : tools.entries()) {
            if (builtins(θ).containsKey(entry.key) || PLUGIN_TOOLS.containsKey(entry.key)) throw new ValueError("graph tool already registered"); // src: vvaharness/codegraph/tools.py:295
            PLUGIN_TOOLS.put(entry.key, entry.value); // earlier registrations remain if a later name conflicts. src: vvaharness/codegraph/tools.py:297
        }
    }
    void clearPluginGraphTools() {
        PLUGIN_TOOLS.clear(); // src: vvaharness/codegraph/tools.py:302
    }
    List<Tool> graphTools(ContextPackage ctx, Set allowed, Theta θ) {
        Object handle = getattr(ctx, "graph_handle", null); if (handle == null) return List.of(); // src: vvaharness/codegraph/tools.py:312
        GraphToolContext gtx = new GraphToolContext(handle, ctx); Map registered = merge(builtins(θ), PLUGIN_TOOLS); // src: vvaharness/codegraph/tools.py:315
        return registered.entries().filter(entry -> allowed.contains(entry.key)).map(entry -> entry.value(gtx)); // src: vvaharness/codegraph/tools.py:317
    }

    /** build_graph_tool_builder: reader tools, then the graph tools gated on options.fact_tools. */
    ToolBuilder buildGraphToolBuilder(ContextPackage ctx, Theta θ) {
        return (options, allowedTools) -> buildTools(ctx, options, allowedTools, θ); // src: vvaharness/codegraph/tools.py:323
    }

    List<Tool> buildTools(ContextPackage ctx, StreamingOptions options, List<String> allowedTools, Theta θ) {
        List<Tool> reader = DeepagentsTools.buildTools(options, allowedTools);              // src: vvaharness/codegraph/tools.py:326
        if (ctx.graphHandle == null) return reader;                                          // src: vvaharness/codegraph/tools.py:313
        // gated on fact_tools: parent_tools strips fact names out of allowed_tools
        return reader.concat(graphTools(ctx, Set.copyOf(options.factTools), θ)); // src: vvaharness/codegraph/tools.py:327
    }
}

@executedBy(CODE) @role(types)
record GraphToolContext(GraphHandle handle, ContextPackage ctx) { } // src: vvaharness/codegraph/tools.py:140
