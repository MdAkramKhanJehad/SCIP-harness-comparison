# vvaharness/remediation_agent/artifacts/diff/gitcapture.py

Real `git diff` capture for a set of files (scoped to the pre-edit baseline when one is given), and the unscoped list of every changed path in the working tree, which the post-gate treats as ground truth.

Source: `vvaharness/remediation_agent/artifacts/diff/gitcapture.py` (lines 1-157)
Executor: code
Called from: `policy/postgate.sudo` enforce_post; `artifacts/diff/derive.sudo` derive_diff

// src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:30-89
fn changed_files_whole_tree(repo):executor=code {
  // Post-gate ground truth for edits the verdict omitted; NEVER "git add -N" here (it would write the index)
  try {
    require "git rev-parse --is-inside-work-tree" prints "true" (15-second timeout) => return []
    toplevel = "git rev-parse --show-toplevel" (15-second timeout); require non-empty => return []
    out = "git status --porcelain -z --untracked-files=all -- ." (60-second timeout)   // the "." pathspec keeps a nested repository without its own .git from reporting the whole enclosing tree
    require exit status 0 => return []
  } catch => return []   // never breaks a run
  // src: gitcapture.py:59-89
  for each NUL-separated record {
    add path = record without its 3-character "XY " status prefix, re-relativized from toplevel to repo; dropped when outside repo
    if (status has "R" or "C") add the next record too   // a rename or copy source is a bare token with no prefix
  }
  return the added paths in first-seen order, without duplicates
}

// src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:92-157
fn capture_git_diff(repo, files, baseline?):executor=code {
  // src: gitcapture.py:97-105 — confine model-controlled references before git sees them (a UNC reference could leak the runner's NetNTLMv2 hash)
  paths = files |> map(f => paths._safe_repo_path(repo, f)) |> filter(non-null) |> relative to resolved repo
  if (!paths) return null
  // every git command runs with LC_ALL=C and color.ui=false
  try {
    require "git rev-parse --is-inside-work-tree" prints "true" => return null
    // src: gitcapture.py:115-126 — a throwaway copy of the index (GIT_INDEX_FILE) so the real index is never touched
    copy <git dir>/index to a temporary index if it exists
    // src: gitcapture.py:128-147 — make the temporary index hold the pre-edit content, so the diff shows only this attempt's edits
    if (baseline) {
      for each rel in paths that are baseline keys {
        if (baseline[rel] == null) "git update-index --force-remove -- rel"   // did not exist before: diffs as a new file
        else { sha = "git hash-object -w --stdin" of baseline[rel]; if (ok) "git update-index --add --cacheinfo 100644,<sha>,<rel>" }
      }
    }
    // src: gitcapture.py:149-155
    "git add -N -- <paths>" (temporary index only)
    diff = stdout of "git diff --no-ext-diff -- <paths>" (60-second timeout)
    return if (diff is non-blank) diff else null
  } catch => return null   // diff capture never breaks a run
  // preserved: "hash-object -w" writes the baseline blobs into the repository's object store; only the index is kept untouched
}
