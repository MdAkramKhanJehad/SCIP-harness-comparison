# vvaharness/rules/kb_tools.py

The CWE knowledge base exposed to the Stage 4 deep-dive model as one fact tool, `CweGuidance`. The tool builder contributes it only when the session options list it among the fact tools. Calls and unknown-id misses are counted for the run's diagnostics.

Source: `vvaharness/rules/kb_tools.py` (lines 1-69)
Executor: code (the tool body is code; whether the model calls the tool is the model's decision)
Called from: `vvaharness/pipeline/stages/s4/session.py` (adds `build_kb_tool_builder()` and `KB_TOOL_NAMES` when `step4.cwe_tools` is on, with the `cwe_tool_budget` budget middleware)

// src: vvaharness/rules/kb_tools.py:27-30
KB_TOOL_NAMES = ("CweGuidance",)
State {
  _unknown_cwe_ids: Set<String> = {}   // process-wide, guarded by _unknown_cwe_lock (sessions may call concurrently)
}

// src: vvaharness/rules/kb_tools.py:45-55
// Tool offered to the model. Description given to the model (the docstring):
//   "Sanitizers, non-sanitizers and FP checks known for one CWE id, e.g. 'CWE-89'."
fn CweGuidance(cwe_id):executor=code {
  COUNTERS.bump("s4_cwe_guidance_called")
  entry = rules.CweKB.load().for_cwes([cwe_id])   // cached default KB; lang = null, so every language-tagged item is returned
  if (entry.cwe is empty) {
    COUNTERS.bump("s4_cwe_guidance_unknown_cwe")
    _note_unknown_cwe(cwe_id)
  }
  return entry   // { cwe, title, origin, sources, sinks, sanitizers, non_sanitizers, fp_checks }
}

// src: vvaharness/rules/kb_tools.py:33-42
fn _note_unknown_cwe(cwe_id):executor=code {
  with _unknown_cwe_lock {
    if (cwe_id in _unknown_cwe_ids) return
    _unknown_cwe_ids.add(cwe_id)
    ids = sorted(_unknown_cwe_ids) joined by ","
  }
  COUNTERS.note("s4_cwe_guidance_unknown_ids", ids)   // the id set distinguishes a KB gap from a model inventing ids
}

// src: vvaharness/rules/kb_tools.py:58-66
fn build_kb_tool_builder():executor=code {
  return (options, allowed_tools = null) => {
    require "CweGuidance" in options.fact_tools => return []   // fact-gated: not offered otherwise
    return [CweGuidance]
  }
}
