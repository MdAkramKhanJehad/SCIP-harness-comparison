// file: vulnhunter-fix/scripts/run-gates.py
// Gate orchestrator (REQ-GAT-011): loads PR/issue body, result.json and triage sidecar, builds per-gate argv
// via GATE_ROUTING, runs each mechanical delivery gate as a subprocess, fails closed on missing required gates.

@executedBy(CODE) @role(evaluation)
class RunGates {

    // GATE_ROUTING order determines run order; θ["code.fix.delivery_gates"] = number of routed gates (7)
    List<String> gateRouting(Theta θ) {
        List<String> gates = List.of("gate1_severity_mask", "gate2_body_completeness", "gate3_scope", "gate4_idempotency", "gate5_anti_merge", "gate6_verification_table", "gate7_committed_test_naming"); // src: vulnhunter-fix/scripts/run-gates.py:162
        assert gates.size() == θ["code.fix.delivery_gates"];                                   // src: vulnhunter-fix/scripts/run-gates.py:162
        return gates;
    }

    // gate5 (anti-merge) intentionally not required: no-op for single-finding PRs
    List<String> requiredGates() {
        return List.of("gate1_severity_mask", "gate2_body_completeness", "gate3_scope", "gate4_idempotency", "gate6_verification_table", "gate7_committed_test_naming"); // src: vulnhunter-fix/scripts/run-gates.py:208
    }

    int run(Args args, Theta θ) {
        Map result;
        try {
            result = loadJson(args.result, true);                                              // src: vulnhunter-fix/scripts/run-gates.py:267
        } catch (GateInputError e) {
            // --result is the fail-closed anchor: missing/corrupt result halts (no default to FULL/VERIFIED)
            print(json("pass", false, "error", e));                                            // src: vulnhunter-fix/scripts/run-gates.py:269
            return 2;                                                                          // src: vulnhunter-fix/scripts/run-gates.py:271
        }
        GateContext ctx = new GateContext(args.prBody, args.issueBody, result, args.sidecar != null ? loadJson(args.sidecar, false) : Map.of(), args.branch, args.repoRoot, args.result, args.sidecarsDir, args.defaultBranch); // src: vulnhunter-fix/scripts/run-gates.py:273
        Map outcomes = new Map();
        for (String gate : gateRouting(θ)) {                                                   // src: vulnhunter-fix/scripts/run-gates.py:286
            List<List<String>> invocations = buildInvocations(gate, ctx);                      // src: vulnhunter-fix/scripts/run-gates.py:288
            for (int idx = 0; idx < invocations.size(); idx++) {
                Outcome o = runGateScript(gate, invocations.get(idx), 60.0);                   // src: vulnhunter-fix/scripts/run-gates.py:293
                String key = invocations.size() == 1 ? gate : gate + "_" + idx;               // src: vulnhunter-fix/scripts/run-gates.py:294
                outcomes.put(key, o);
            }
        }
        List<String> missing = requiredGates().filter(g -> !outcomes.anyKeyEqualsOrStartsWith(g)); // src: vulnhunter-fix/scripts/run-gates.py:300
        if (!missing.isEmpty()) {
            print(json("pass", false, "error", "required gates contributed no invocations (routing drift)")); // src: vulnhunter-fix/scripts/run-gates.py:305
            return 1;                                                                          // src: vulnhunter-fix/scripts/run-gates.py:311
        }
        boolean allPass = outcomes.values().all(o -> o.rc == 0);                               // src: vulnhunter-fix/scripts/run-gates.py:313
        print(json("pass", allPass, "gates", outcomes));
        return allPass ? 0 : 1;                                                                // src: vulnhunter-fix/scripts/run-gates.py:315
    }

    List<List<String>> buildInvocations(String gate, GateContext ctx) {
        switch (gate) {
            case "gate1_severity_mask": return buildGate1Invocations(ctx);
            case "gate2_body_completeness": return buildGate2Invocations(ctx);
            case "gate3_scope": return buildGate3Invocations(ctx);
            case "gate4_idempotency": return buildGate4Invocations(ctx);
            case "gate5_anti_merge": return buildGate5Invocations(ctx);
            case "gate6_verification_table": return buildGate6Invocations(ctx);
            default: return buildGate7Invocations(ctx);
        }
    }

    Outcome runGateScript(String gate, List<String> argv, double timeoutSeconds) {
        // each gate is a stateless script run under the bundled-venv python
        switch (gate) {
            case "gate1_severity_mask": return CheckSeverityMask.run(argv);                    // src: vulnhunter-fix/scripts/run-gates.py:164
            case "gate2_body_completeness": return CheckBodyCompleteness.run(argv);            // src: vulnhunter-fix/scripts/run-gates.py:169
            case "gate3_scope": return CheckScope.run(argv);                                   // src: vulnhunter-fix/scripts/run-gates.py:173
            case "gate4_idempotency": return CheckIdempotency.run(argv);                       // src: vulnhunter-fix/scripts/run-gates.py:177
            case "gate5_anti_merge": return AntiMergeCheck.run(argv);                          // src: vulnhunter-fix/scripts/run-gates.py:181
            case "gate6_verification_table": return ValidateVerification.main(argv, θ);            // src: vulnhunter-fix/scripts/run-gates.py:185
            default: return CheckCommittedTestNaming.run(argv);                                // src: vulnhunter-fix/scripts/run-gates.py:189
        }
        // on timeout: rc = -1 with "timeout after <t>s" appended to stderr                    // src: vulnhunter-fix/scripts/run-gates.py:241
    }

    List<List<String>> buildGate1Invocations(GateContext ctx) {
        List<String> bodies = List.of(ctx.prBody);                                             // src: vulnhunter-fix/scripts/run-gates.py:53
        if (ctx.issueBody != null) bodies.add(ctx.issueBody);                                  // src: vulnhunter-fix/scripts/run-gates.py:54
        return List.of(bodies);
    }

    List<List<String>> buildGate2Invocations(GateContext ctx) {
        String tier = ctx.result.getOr("completeness_tier", "FULL"); // falsy values (empty string, null) also fall back (python or)                         // src: vulnhunter-fix/scripts/run-gates.py:60
        String status = ctx.result.getOr("status", "VERIFIED");                                // src: vulnhunter-fix/scripts/run-gates.py:61
        String sweepRan = ctx.result.get("sweep_ran") ? "true" : "false";                      // src: vulnhunter-fix/scripts/run-gates.py:62
        List<String> enforce = List.of();
        if (status == "BREAKING_CHANGE") enforce.add("## Breaking Change");                    // src: vulnhunter-fix/scripts/run-gates.py:68
        List<List<String>> inv = List.of(argsFor(ctx.prBody, "pr", tier, status, sweepRan, enforce)); // src: vulnhunter-fix/scripts/run-gates.py:78
        if (ctx.issueBody != null) inv.add(argsFor(ctx.issueBody, "issue", tier, status, sweepRan, enforce)); // src: vulnhunter-fix/scripts/run-gates.py:79
        return inv;
    }

    List<String> argsFor(String body, String kind, String tier, String status, String sweepRan, List<String> enforce) {
        List<String> a = List.of("--body", body, "--kind", kind, "--tier", tier, "--status", status, "--sweep-ran", sweepRan); // src: vulnhunter-fix/scripts/run-gates.py:72
        if (!enforce.isEmpty()) a.addAll("--enforce-strings", enforce);                        // src: vulnhunter-fix/scripts/run-gates.py:74
        return a;
    }

    List<List<String>> buildGate3Invocations(GateContext ctx) {
        List<String> a = List.of("--repo-root", ctx.repoRoot, "--branch", ctx.branch, "--files-modified", ctx.result.getOr("files_modified", List.of())); // src: vulnhunter-fix/scripts/run-gates.py:87
        if (ctx.result.get("test_file") != null) a.addAll("--test-file", ctx.result.get("test_file")); // src: vulnhunter-fix/scripts/run-gates.py:89
        return List.of(a);
    }

    List<List<String>> buildGate4Invocations(GateContext ctx) {
        List<List<String>> inv = List.of(List.of("--body", ctx.prBody, "--kind", "pr"));       // src: vulnhunter-fix/scripts/run-gates.py:95
        if (ctx.issueBody != null) inv.add(List.of("--body", ctx.issueBody, "--kind", "issue")); // src: vulnhunter-fix/scripts/run-gates.py:96
        return inv;
    }

    List<List<String>> buildGate5Invocations(GateContext ctx) {
        Map am = ctx.sidecar.getOr("anti_merge", Map.of());                                    // src: vulnhunter-fix/scripts/run-gates.py:108
        if (am.isEmpty() || !am.has("files_grouped")) return List.of();                        // src: vulnhunter-fix/scripts/run-gates.py:109
        List<String> a = List.of("--files-grouped", am.files_grouped, "--files-split", am.getOr("files_split", 1), "--strict"); // src: vulnhunter-fix/scripts/run-gates.py:111
        if (am.has("test_files_grouped")) a.addAll("--test-files-grouped", am.test_files_grouped); // src: vulnhunter-fix/scripts/run-gates.py:116
        if (am.has("test_files_split")) a.addAll("--test-files-split", am.test_files_split);   // src: vulnhunter-fix/scripts/run-gates.py:118
        return List.of(a);
    }

    List<List<String>> buildGate6Invocations(GateContext ctx) {
        // validator fails closed on any unverifiable "yes" column-7 cell
        List<String> a = List.of(ctx.prBody, "--worktree", ctx.repoRoot);                      // src: vulnhunter-fix/scripts/run-gates.py:132
        if (ctx.sidecarsDir != null) a.addAll("--sidecars-dir", ctx.sidecarsDir);              // src: vulnhunter-fix/scripts/run-gates.py:133
        if (ctx.resultPath != null) a.addAll("--result", ctx.resultPath);                      // src: vulnhunter-fix/scripts/run-gates.py:135
        return List.of(a);
    }

    List<List<String>> buildGate7Invocations(GateContext ctx) {
        List<String> a = List.of("--repo-root", ctx.repoRoot);                                 // src: vulnhunter-fix/scripts/run-gates.py:154
        if (ctx.defaultBranch != null) a.addAll("--base", ctx.defaultBranch);                  // src: vulnhunter-fix/scripts/run-gates.py:155
        return List.of(a);
    }

    Map loadJson(String path, boolean strict) {
        if (path == null || !isFile(path)) {
            if (strict) throw new GateInputError("required input not found");                  // src: vulnhunter-fix/scripts/run-gates.py:221
            return Map.of();
        }
        try {
            return parseJson(read(path));                                                      // src: vulnhunter-fix/scripts/run-gates.py:224
        } catch (JsonError e) {
            if (strict) throw new GateInputError("required input failed to load");             // src: vulnhunter-fix/scripts/run-gates.py:227
            return Map.of();
        }
    }
}

@executedBy(CODE) @role(types)
record GateContext(String prBody, String issueBody, Map result, Map sidecar, String branch, String repoRoot, String resultPath, String sidecarsDir, String defaultBranch) { }
