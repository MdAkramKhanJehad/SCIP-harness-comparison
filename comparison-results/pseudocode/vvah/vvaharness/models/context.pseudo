// file: vvaharness/models/context.py
// ScoringPolicy: the gate set a validator owes and how the host bands its score into merge readiness.

@executedBy(CODE) @role(types)
record ScoringPolicy(List<String> requiredGates, Map<String, Double> weights, Set<String> critical, double readyAt, double conditionalAt) {
    // frozen, extra keys forbidden                                                                 // src: vvaharness/models/context.py:29

    double readyAtDefault() {
        return θ["code.models.context.ready_at"];  // score >= this -> READY                        // src: vvaharness/models/context.py:36
    }

    double conditionalAtDefault() {
        return θ["code.models.context.conditional_at"];  // score >= this -> READY_WITH_CONDITIONS  // src: vvaharness/models/context.py:38
    }

    ScoringPolicy gatesAndWeightsAgree() {
        // after-validator: the scorer prefers weights, so both gate sets must match exactly
        if (!Set.of(requiredGates).equals(weights.keySet())) {                                      // src: vvaharness/models/context.py:44
            throw new ValueError("ScoringPolicy gate sets disagree: required-only / weighted-only"); // src: vvaharness/models/context.py:50
        }
        return this;
    }

    List<String> missingFrom(List<String> gateNames) {
        Set answered = gateNames.map(n -> Vocab.normaliseGateName(n));                              // src: vvaharness/models/context.py:57
        return requiredGates.filter(g -> !answered.contains(Vocab.normaliseGateName(g)));          // src: vvaharness/models/context.py:58
    }
}

@executedBy(CODE) @role(types)
class ModelsContext {

    ScoringPolicy defaults(Theta θ) {
        return new ScoringPolicy(List.of(), Map.of(), Set.of(), θ["code.models.context.ready_at"], θ["code.models.context.conditional_at"]); // src: vvaharness/models/context.py:31
    }
}
