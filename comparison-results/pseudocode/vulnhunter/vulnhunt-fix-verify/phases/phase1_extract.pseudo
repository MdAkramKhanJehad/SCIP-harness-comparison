// file: vulnhunt-fix-verify/phases/phase1_extract.md
// Fix-verify phase 1: convert the prior /vulnhunt report into ${OUT}/extracted_findings.md, one
// "## VULN-NNN" section per ID in fixed_ids_in_report, plus relevant accepted comment claims.

@executedBy(MODEL) @role(stage) @stage("FV1")
class Phase1Extract {

    void run(Bound b, Phase0State s0, Theta θ) {
        String mode = θ["p.phase1_extract.inline_or_delegate"];                                  // src: vulnhunt-fix-verify/phases/phase1_extract.md:6
        if (mode == "delegate") { delegated(b, θ); return; }
        if (θ["p.phase1_extract.read_only_report"]) b.readOnly(b.REPORT).writeOnly(b.OUT);       // src: vulnhunt-fix-verify/phases/phase1_extract.md:16
        Phase0State state = θ["p.phase1_extract.read_state_once"] ? Json.parse(Tools.read(b.OUT + "/phase0_state.json")) : s0; // src: vulnhunt-fix-verify/phases/phase1_extract.md:104
        StringBuilder doc = new StringBuilder("# Extracted findings");
        List<String> ids = state.fixedIdsInReport;
        if (θ["p.phase1_extract.one_section_per_id_in_order"]) ids = ids.inOriginalOrder();        // src: vulnhunt-fix-verify/phases/phase1_extract.md:21
        for (String id : ids) {                                                                    // src: vulnhunt-fix-verify/phases/phase1_extract.md:63
            Section sec = new Section(θ["p.phase1_extract.heading_anchor_fixed"].replace("NNN", id.num())); // src: vulnhunt-fix-verify/phases/phase1_extract.md:58
            sec.fields = step1CoreFields(id, b, θ);                                                // src: vulnhunt-fix-verify/phases/phase1_extract.md:65
            step2SweepFields(id, b, sec, θ);                                                       // src: vulnhunt-fix-verify/phases/phase1_extract.md:80
            step3PocPaths(id, b, sec, θ);                                                          // src: vulnhunt-fix-verify/phases/phase1_extract.md:92
            sec.claims = step4RelevantClaims(id, sec, state, θ);                                   // src: vulnhunt-fix-verify/phases/phase1_extract.md:102
            doc.append(sec.render(θ["p.phase1_extract.extracted_field_set"]));                     // src: vulnhunt-fix-verify/phases/phase1_extract.md:33
        }
        validate(doc, ids, θ);                                                                     // src: vulnhunt-fix-verify/phases/phase1_extract.md:119
        Tools.write(b.OUT + "/extracted_findings.md", doc);                                        // src: vulnhunt-fix-verify/phases/phase1_extract.md:127
        if (θ["p.phase1_extract.append_log"]) Tools.append(b.OUT + "/verify_run.log.md", "processed: " + ids); // src: vulnhunt-fix-verify/phases/phase1_extract.md:128
    }

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.phase1_extract.inline_or_delegate"]);                                         // src: vulnhunt-fix-verify/phases/phase1_extract.md:6
        if (θ["p.phase1_extract.read_only_report"]) p.must("read-only over REPORT; write-only to OUT"); // src: vulnhunt-fix-verify/phases/phase1_extract.md:16
        p.format(θ["p.phase1_extract.extracted_field_set"]);                                      // src: vulnhunt-fix-verify/phases/phase1_extract.md:33
        p.choose(θ["p.phase1_extract.severity_values"]);                                          // src: vulnhunt-fix-verify/phases/phase1_extract.md:35
        if (θ["p.phase1_extract.accepted_claims_copied_verbatim"]) p.format("copy relevant claims verbatim, else (none)"); // src: vulnhunt-fix-verify/phases/phase1_extract.md:48
        p.format(θ["p.phase1_extract.heading_anchor_fixed"]);                                     // src: vulnhunt-fix-verify/phases/phase1_extract.md:58
        p.include(whatNotToDo(θ));
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt whatNotToDo(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase1_extract.no_poc_contents"]) p.forbid("do not read full PoC or exploit-test contents into extracted_findings.md"); // src: vulnhunt-fix-verify/phases/phase1_extract.md:132
        if (θ["p.phase1_extract.no_source_reads"]) p.forbid("do not read source files in REPO");  // src: vulnhunt-fix-verify/phases/phase1_extract.md:135
        if (θ["p.phase1_extract.no_report_modification"]) p.forbid("do not modify REPORT");       // src: vulnhunt-fix-verify/phases/phase1_extract.md:137
        return p;
    }

    @executedBy(MODEL)
    Map step1CoreFields(String id, Bound b, Theta θ) {
        if (θ["p.phase1_extract.core_fields_from_manifest"] && Tools.glob(b.REPORT + "/scan_manifest.json").exists()) { // src: vulnhunt-fix-verify/phases/phase1_extract.md:67
            Finding f = Json.parse(Tools.read(b.REPORT + "/scan_manifest.json")).findings.find(x -> x.id == id);
            return f.pick("title", "cwe", "severity", "location", "entry_point", "root_cause", "data_flow", "fix_strategy"); // src: vulnhunt-fix-verify/phases/phase1_extract.md:69
        }
        if (θ["p.phase1_extract.core_fields_fallback_readme"]) {                                   // src: vulnhunt-fix-verify/phases/phase1_extract.md:72
            int line = Tools.grep("## [" + id + "]", b.REPORT + "/README.md").firstLine();        // src: vulnhunt-fix-verify/phases/phase1_extract.md:73
            String sect = θ["p.phase1_extract.focused_range_read"] ? Tools.read(b.REPORT + "/README.md", line, "<limit>") : Tools.read(b.REPORT + "/README.md"); // src: vulnhunt-fix-verify/phases/phase1_extract.md:74
            Map m = sect.fieldTable();
            if (!m.has("fix_strategy")) m.put("fix_strategy", Tools.read(b.REPORT + "/phase3_output.md").fixStrategyFor(id)); // src: vulnhunt-fix-verify/phases/phase1_extract.md:77
            return m;
        }
        return Map.of();
    }

    @executedBy(MODEL)
    void step2SweepFields(String id, Bound b, Section sec, Theta θ) {
        String none = θ["p.phase1_extract.sweep_fields_none_default"];                            // src: vulnhunt-fix-verify/phases/phase1_extract.md:89
        sec.sweepRootCause = none; sec.sweepPattern = none;
        if (!θ["p.phase1_extract.sweep_fields_from_phase3d"]) return;                              // src: vulnhunt-fix-verify/phases/phase1_extract.md:82
        Row row = Tools.grep(id, b.REPORT + "/phase3d_output.md").sweepRow();
        if (row != null) { sec.sweepRootCause = row.rootCause; sec.sweepPattern = row.grepPattern; } // src: vulnhunt-fix-verify/phases/phase1_extract.md:85
    }

    @executedBy(MODEL)
    void step3PocPaths(String id, Bound b, Section sec, Theta θ) {
        String rule = θ["p.phase1_extract.poc_path_first_match_or_missing"];                      // src: vulnhunt-fix-verify/phases/phase1_extract.md:94
        List<String> poc = Tools.glob(b.REPORT + "/poc/" + id + "_*.md");
        sec.pocPath = poc.isEmpty() ? "missing" : poc.get(0).absolute();
        List<String> et = Tools.glob(b.REPORT + "/exploit_tests/test_vuln_" + id.num() + "_*");    // src: vulnhunt-fix-verify/phases/phase1_extract.md:97
        sec.exploitTestPath = et.isEmpty() ? "missing" : et.get(0).absolute();
        if (θ["p.phase1_extract.exploit_paths_reference_only"]) sec.executeExploit = false;        // src: vulnhunt-fix-verify/phases/phase1_extract.md:100
    }

    @executedBy(MODEL)
    List<Claim> step4RelevantClaims(String id, Section sec, Phase0State state, Theta θ) {
        List<Claim> out = new List();
        for (Claim c : state.claims) {
            if (θ["p.phase1_extract.only_accepted_claims_eligible"] && c.status != "accepted") continue; // src: vulnhunt-fix-verify/phases/phase1_extract.md:115
            boolean rel = false;
            if (θ["p.phase1_extract.claim_relevance_same_file"] && c.refersToFile(sec.fields.location.file())) rel = true; // src: vulnhunt-fix-verify/phases/phase1_extract.md:108
            if (θ["p.phase1_extract.claim_relevance_entry_point"] && c.mentions(sec.fields.entry_point)) rel = true;   // src: vulnhunt-fix-verify/phases/phase1_extract.md:110
            if (c.looselyMatches(sec.fields.cwe, sec.fields.root_cause, θ["p.phase1_extract.claim_relevance_keywords_when_in_doubt_include"])) rel = true; // src: vulnhunt-fix-verify/phases/phase1_extract.md:112
            if (rel) out.add(θ["p.phase1_extract.accepted_claims_copied_verbatim"] ? c : c.summary()); // src: vulnhunt-fix-verify/phases/phase1_extract.md:48
        }
        return out;  // empty renders as "(none)"
    }

    @executedBy(MODEL)
    void validate(StringBuilder doc, List<String> ids, Theta θ) {
        if (θ["p.phase1_extract.sanity_one_section_per_id"]) assert ids.all(id -> doc.countHeading(id) == 1);       // src: vulnhunt-fix-verify/phases/phase1_extract.md:123
        if (θ["p.phase1_extract.sanity_no_extra_ids"]) assert doc.headingIds().all(h -> ids.contains(h));         // src: vulnhunt-fix-verify/phases/phase1_extract.md:125
    }

    @executedBy(MODEL)
    void delegated(Bound b, Theta θ) {
        int tries = 0;
        do {
            Runtime.subagent(prompt(θ).format("return message under " + θ["p.phase1_extract.subagent_return_word_cap"] + " words, confirming IDs written"), b); // src: vulnhunt-fix-verify/phases/phase1_extract.md:142
            tries++;
        } while (!Tools.glob(b.OUT + "/extracted_findings.md").exists() && tries <= θ["p.phase1_extract.redispatch_once_if_missing"]); // src: vulnhunt-fix-verify/phases/phase1_extract.md:141
    }
}
