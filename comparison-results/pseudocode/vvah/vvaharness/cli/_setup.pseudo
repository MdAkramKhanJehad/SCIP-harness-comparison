// file: vvaharness/cli/_setup.py
// Readiness wizard plus opt-in env-file/instruction installation. Preserve filesystem guards and all write conditions.

@executedBy(CODE) @role(io)
class CliSetup {
    @src("vvaharness/cli/_setup.py:32")
    Path symlinkedAncestor(Path path, Path anchor) {
        Path node = path;
        while (node != anchor && node != node.parent) {
            Object status;
            try { status = node.lstat(); } catch (OSError e) { status = null; }
            if (status != null && isSymlinkMode(status.mode)) return node;
            node = node.parent;
        }
        return null;
    }
    @src("vvaharness/cli/_setup.py:46")
    void cacheAdvisory(String configPath) {
        Object cfg;
        try { cfg = loadHarnessConfig(configPath); } catch (ConfigPolicyError | OSError | ValueError e) { return; }
        if (!iterModelRoles(cfg).anyMatch(pair -> getattr(pair.second, "via", null) == "sdk")) return;
        Map settings = cfg.data; if (!cacheMarkersEnabled(settings)) return;
        Object declared = settings.getOrDefault("cache_route", "auto"); if (declared == false || str(declared).strip().lower() == "none") return;
        Object transport = getattr(cfg, "sdk", null); String endpoint = firstTruthy(getattr(transport, "base_url", null), env("ANTHROPIC_BASE_URL"), "https://api.anthropic.com");
        Object route; String host;
        try { route = cacheRoute(endpoint, settings, emitNote=false); host = urlHostname(endpoint); } catch (ValueError e) { return; }
        if (route != ROUTE_UNKNOWN) return;
        printCacheGatewayAdvice(host, shellQuote(configPath)); // informational only: does not probe or change settings.
    }
    @src("vvaharness/cli/_setup.py:96")
    void put(Path path, String content, Path anchor) {
        if (path.exists()) { print("exists, left as-is", path); return; }
        if (osName() == "posix") { Path symlink = symlinkedAncestor(path, anchor); if (symlink != null) { logWarning("symlink refused", path); return; } }
        path.parent.mkdir(parents=true, existOk=true); path.writeText(content, "utf-8");
    }
    @src("vvaharness/cli/_setup.py:89")
    int installAgents() {
        Path cwd = currentDirectory(); Path home = homeDirectory();
        put(cwd.resolve("AGENTS.md"), AGENT_DOC, cwd); put(cwd.resolve(".github/copilot-instructions.md"), AGENT_DOC, cwd);
        if (which("claude") != null) { put(cwd.resolve("CLAUDE.md"), AGENT_DOC, cwd); put(home.resolve(".claude/skills/vvaharness/SKILL.md"), CLAUDE_SKILL, home); }
        if (which("gemini") != null) put(cwd.resolve("GEMINI.md"), geminiDoc(), cwd);
        return 0;
    }
    @src("vvaharness/cli/_setup.py:217")
    void promptForRemediationInputs() {
        List missing = missingRules(rulePathsModuleFile()); if (missing.isEmpty() || !stdinIsTty()) return;
        print("missing remediation defaults", missing);
        while (true) {
            String answer;
            try { answer = input("inputs directory, blank to skip").strip(); } catch (EOFError | KeyboardInterrupt e) { print(); return; }
            if (answer.isEmpty()) return;
            Pair checked = validateInputsDir(answer);
            if (!checked.second.isEmpty()) { print("missing files", checked.second); continue; }
            print("saved inputs directory", saveInputsDir(checked.first)); return;
        }
    }
    @src("vvaharness/cli/_setup.py:121")
    int setup(List<String> rest) {
        String configPath = configPathFrom(rest); boolean writeEnv = rest.contains("--write-env");
        promptForRemediationInputs(); List checks = runEnvironmentChecks(configPath);
        for (Object check : checks) printCheck(check);
        Triple totals = summarizeChecks(checks); Pair profile = recommendProfile();
        if (truthy(profile.first)) { print("recommended profile", profile); if (profile.first != "default") printProfileScanCommand(profile.first); }
        Object gatewayFailure = checks.firstOrNull(c -> c.name == "via:sdk endpoint" && c.status == "fail");
        Pair gateway = detectGateway(); Object ca = detectCaCert();
        if (gatewayFailure != null) printEndpointAdvice(gateway, ca);
        cacheAdvisory(configPath);
        Path envFile = Path.of(".env");
        if (!envFile.exists() && writeEnv) {
            Path example = Path.of(".env.example"); String base = example.exists() ? example.readText("utf-8") : ""; String extra = "";
            if (truthy(gateway.first)) extra += "\nANTHROPIC_BASE_URL=" + gateway.first + "\n";
            if (truthy(ca)) extra += "SSL_CERT_FILE=" + ca + "\nNODE_EXTRA_CA_CERTS=" + ca + "\n";
            if (truthy(gateway.first) || truthy(ca)) extra += "# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1\n";
            envFile.writeText(base + extra, "utf-8"); print("wrote .env; fill remaining keys");
        }
        if (rest.contains("--install-agents")) installAgents(); else printAgentInstallAdvice();
        if (totals.third > 0) { print("fix blocking checks", totals.third); return 1; }
        print("ready; default skips remediation/validation; stop-after s9 skips both with all profiles"); return 0;
    }
}
