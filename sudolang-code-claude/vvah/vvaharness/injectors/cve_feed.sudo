# vvaharness/injectors/cve_feed.py

Loads the operator's known-CVE feed (JSON) that is injected as prioritization context into the scan. A missing file gives no CVEs; a structurally malformed file degrades to no CVEs with a warning; a single malformed record drops only itself.

Source: `vvaharness/injectors/cve_feed.py` (lines 1-80)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (`load_cves(knob("inject.cve_file"))`)

// src: vvaharness/injectors/cve_feed.py:32-80
fn load_cves(path):executor=code {
  p = Path(path)
  if (!p exists) return []
  try {
    data = json.loads(read p as UTF-8)
    if (data is a dict) {
      items = data.cves
      require items != null => throw ValueError("CVE feed is a JSON object without a 'cves' key — expected a list or {\"cves\": [...]}")
    } else { items = data }   // a bare list
    require items is a list => throw TypeError("CVE feed payload must be a list, got <type>")
  }
  catch (OSError | ValueError | TypeError) => {
    warn CVE_FEED_UNREADABLE; errlog.log("inject.cves", p, error)
    return []   // the whole feed degrades to empty; the scan continues
  }
  out = []; skipped = 0
  for each [idx, item] in items {
    try out.append(CVE.model_validate(item));
    catch (ValidationError | TypeError | ValueError) => { skipped += 1; errlog.log("inject.cves.item", "$p#$idx (<id>)", error) }
  }
  if (skipped) warn CVE_FEED_RECORDS_SKIPPED
  return out
}
