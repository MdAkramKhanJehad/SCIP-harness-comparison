// file: vvaharness/validation/models/results.py
// Per-run counters and the flat render row the S11 report builds from (a render row, not a contract).

@executedBy(CODE) @role(types) @stage("S11")
record RunMetadata(int totalFindings, int findingsProcessed, int findingsFailed, List<String> errors) { }

@executedBy(CODE) @role(types) @stage("S11")
record ValidationResult(int findingNumber, String trackingId, String findingTitle, String findingDescription, String affectedFiles,
                        String fixed, String partiallyFixed, String notFixed, String filesNeedingFixes, String reasonForDecision,
                        String severity, String prMergeReadiness, String recommendations, double fixConfidence,
                        String gateResultsJson, String justification) { }

@executedBy(CODE) @role(types) @stage("S11")
record SarifLocation(String uri, int startLine) { }

@executedBy(CODE) @role(evaluation) @stage("S11")
class Results {

    Map<String, Map> gateScoreRows(Verdict verdict, ScoringConfig config) {
        Map<String, Map> rows = new Map();
        for (GateAssessment g : verdict.gates) {                                                     // src: vvaharness/validation/models/results.py:92
            double weight = config.weights.getOrDefault(g.name, 0.0);                                // unknown gate weighs 0  // src: vvaharness/validation/models/results.py:93
            double mult = config.statusMultiplier.getOrDefault(g.status, 0.0);                       // src: vvaharness/validation/models/results.py:94
            rows.put(g.name, Map.of("status", g.status, "weight", weight, "weighted_score", round(weight * mult, ConstantsScoring.SCORE_PRECISION))); // src: vvaharness/validation/models/results.py:95
        }
        return rows;
    }

    List<String> answerColumns(Decision d) {
        if (d == Decision.FIXED) return List.of("Yes", "No", "No");                                  // src: vvaharness/validation/models/results.py:105
        if (d == Decision.PARTIALLY_FIXED) return List.of("No", "Yes", "No");                        // src: vvaharness/validation/models/results.py:106
        if (d == Decision.NOT_FIXED) return List.of("No", "No", "Yes");                              // src: vvaharness/validation/models/results.py:107
        return List.of("?", "?", "?");                                                               // INCONCLUSIVE  // src: vvaharness/validation/models/results.py:108
    }

    ValidationResult renderRow(Verdict verdict, OutputFinding f, int findingNumber, String gateScoresJson, ScoringPolicy policy) {
        List<String> cols = answerColumns(verdict.decision);                                         // src: vvaharness/validation/models/results.py:121
        double score = verdict.score != null ? verdict.score : 0.0;                                  // src: vvaharness/validation/models/results.py:122
        return new ValidationResult(findingNumber, f.trackingId, f.findingTitle, f.findingDescription, f.affectedFiles,
            cols.get(0), cols.get(1), cols.get(2), filesNeedingFixes(f),                             // src: vvaharness/validation/models/results.py:129
            verdict.decision + " (score: " + score + "). " + verdict.rationale,                      // src: vvaharness/validation/models/results.py:133
            f.severity, Derive.mergeReadinessFor(verdict, policy),                                   // readiness is a host policy call  // src: vvaharness/validation/models/results.py:135
            String.join("; ", verdict.recommendations), score, gateScoresJson, verdict.rationale);  // src: vvaharness/validation/models/results.py:136
    }

    String filesNeedingFixes(OutputFinding f) {
        if (!f.conditionsForFullFix.isEmpty()) return String.join("; ", f.conditionsForFullFix);     // src: vvaharness/validation/models/results.py:145
        return f.filesNeedingFixes;                                                                  // src: vvaharness/validation/models/results.py:147
    }

    ValidationResult unverifiableRow(String trackingId, String title, String reason, int findingNumber) {
        return new ValidationResult(findingNumber, trackingId, title, "", "", "?", "?", "?", "",     // src: vvaharness/validation/models/results.py:154
            "INCONCLUSIVE: " + reason, "medium", "not_ready",                                        // explicit NOT_READY  // src: vvaharness/validation/models/results.py:167
            "Manual review required: " + reason, 0.0, "", "");                                       // src: vvaharness/validation/models/results.py:168
    }
}
