// file: vvaharness/pipeline/stages/s5/rules.py
// Path and weakness-class tables S5 matches against.

@executedBy(CODE) @role(rule_set) @stage("S5")
class S5Rules {

    // EXCLUDE_PATH_RE: (^|/)(tests?|__tests__|mocks?|examples?|fixtures?|samples?|testdata)(/|$) | _test. | .test. | .spec. | Test.java$ | Tests.cs$
    boolean excludePath(String path, Theta θ) {
        return Regex.matches(θ["code.s5.test_path_gate"], path, IGNORECASE);                     // src: vvaharness/pipeline/stages/s5/rules.py:22
    }

    // Point-of-occurrence classes override the test-path exclusion.
    List<String> hardcodedCwes() {
        return List.of("CWE-798", "CWE-259", "CWE-321", "CWE-256");                              // src: vvaharness/pipeline/stages/s5/rules.py:29
    }

    List<String> controlAbsenceCwes() {
        return List.of("CWE-352", "CWE-1004", "CWE-614", "CWE-307", "CWE-778", "CWE-311", "CWE-312", "CWE-532", "CWE-209"); // src: vvaharness/pipeline/stages/s5/rules.py:33
    }

    // SECRET_TEXT_RX: hard-coded | password | api_key | access_key | secret_key | auth_token | bearer token | jwt |
    // private_key | client_secret | credential | PEM private key header | AKIA... | gh?_... | xox?-...
    boolean isSecretClass(Finding f) {
        if (f.vulnClass == VulnClass.INFO_LEAK) return true;                                    // src: vvaharness/pipeline/stages/s5/rules.py:55
        if (f.cwe != null && (hardcodedCwes().contains(f.cwe) || controlAbsenceCwes().contains(f.cwe))) return true; // src: vvaharness/pipeline/stages/s5/rules.py:57
        String haystack = String.join(" ", f.title, f.description, f.codeSnippet);              // src: vvaharness/pipeline/stages/s5/rules.py:59
        return Regex.search(SECRET_TEXT_RX, haystack);                                           // src: vvaharness/pipeline/stages/s5/rules.py:60
    }
}
