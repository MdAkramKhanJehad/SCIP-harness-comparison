// file: vvaharness/plugins/semgrep/enricher.py
// One bounded Semgrep process enriches the structural graph with coverage, rule, finding and trace nodes.
// Subprocess/report failures degrade to a coverage node. Graph-construction exceptions are not caught by enrich().

@executedBy(CODE) @role(types)
record SemgrepLocated(String path, int line) { }

@executedBy(CODE) @role(types)
record SemgrepCoverage(String note, boolean complete = false, int findings = 0, int errors = 0, int skipped = 0, int rules = 0) { }

@executedBy(CODE) @role(step) @stage("S0")
class SemgrepEnricher {
    List<Path> configs = List.of(); List<String> rulesets = List.of();
    String executable = θ["code.plugins.semgrep.enricher.executable"]; // src: vvaharness/plugins/semgrep/enricher.py:311
    double timeoutSeconds = θ["code.plugins.semgrep.enricher.timeout_seconds"]; // src: vvaharness/plugins/semgrep/enricher.py:312
    int priority = θ["code.plugins.semgrep.enricher.priority"]; // src: vvaharness/plugins/semgrep/enricher.py:313
    @src("vvaharness/plugins/semgrep/enricher.py:306")
    SemgrepEnricher create(List<Path> configs, List<String> rulesets, String executable, double timeoutSeconds, int priority) {
        return new SemgrepEnricher(configs, rulesets, executable, timeoutSeconds, priority);
    }
    @src("vvaharness/plugins/semgrep/enricher.py:261")
    PluginMetadata metadata() {
        return new PluginMetadata(POST_DERIVATION, priority, "semgrep", "1");
    }
    @src("vvaharness/plugins/semgrep/enricher.py:87")
    SemgrepSymbols index(GraphSnapshot graph) {
        Map spans = new Map(); Map files = new Map();
        for (GraphNode node : graph.nodes) {
            Map props = node.properties.toDict(); Object path = props.get("filePath");
            if (!(path instanceof String)) continue;
            if (node.labels.contains("File")) files.putIfAbsent(path, node.id);
            Object start = props.get("startLine"); Object end = props.get("endLine");
            if (pythonIsInt(start) && pythonIsInt(end) && end >= start) spans.computeIfAbsent(path, new List()).add(new Triple(start, end, node.id));
        }
        return new SemgrepSymbols(spans.mapValues(rows -> sorted(rows)), files);
    }
    @src("vvaharness/plugins/semgrep/enricher.py:104")
    List<String> argv(String root, Path output, Theta θ) {
        List<String> argv = concat(List.of(executable), θ["code.plugins.semgrep.enricher.command_flags"], List.of("--output", str(output))); // src: vvaharness/plugins/semgrep/enricher.py:109
        for (Path c : configs) argv.addAll(List.of("--config", str(c)));
        for (String r : rulesets) argv.addAll(List.of("--config", r));
        return concat(argv, List.of(root));
    }
    @src("vvaharness/plugins/semgrep/enricher.py:116")
    List<String> cweIds(Map metadata) {
        Object raw = truthyOr(metadata.get("cwe"), List.of());
        List values = raw instanceof String ? List.of(raw) : iterable(raw).filter(v -> v instanceof String);
        return distinctInOrder(values.filter(v -> !v.strip().isEmpty()).map(v -> v.split(":").get(0).strip()));
    }
    @src("vvaharness/plugins/semgrep/enricher.py:123")
    List<String> classes(Map metadata, Theta θ) {
        List<String> out = new List();
        for (String key : θ["code.plugins.semgrep.enricher.class_metadata_keys"]) { // src: vvaharness/plugins/semgrep/enricher.py:126
            Object raw = truthyOr(metadata.get(key), List.of());
            List values = raw instanceof String ? List.of(raw) : iterable(raw).filter(v -> v instanceof String);
            out.addAll(values.map(v -> v.strip()).filter(v -> !v.isEmpty()));
        }
        return distinctInOrder(out);
    }
    @src("vvaharness/plugins/semgrep/enricher.py:133")
    List<Pair<String, SemgrepLocated>> traceSteps(Map extra, String root, Theta θ) {
        Object trace = truthyOr(extra.get("dataflow_trace"), Map.of());
        if (!(trace instanceof Map)) return List.of();
        List out = new List();
        for (Pair role : θ["code.plugins.semgrep.enricher.trace_roles"]) { // src: vvaharness/plugins/semgrep/enricher.py:57
            for (Map entry : flatten(trace.get(role.first), 0, θ)) {
                SemgrepLocated at = location(entry, root);
                if (at != null) out.add(new Pair(role.second, at));
            }
        }
        return out.head(θ["code.plugins.semgrep.enricher.max_trace_steps"]); // src: vvaharness/plugins/semgrep/enricher.py:52
    }
    @src("vvaharness/plugins/semgrep/enricher.py:147")
    List<Map> flatten(Object value, int depth, Theta θ) {
        if (value instanceof Map) return List.of(value);
        if (isListOrTuple(value) && depth < θ["code.plugins.semgrep.enricher.max_trace_nesting"]) return value.flatMap(item -> flatten(item, depth + 1, θ)); // src: vvaharness/plugins/semgrep/enricher.py:55
        return List.of();
    }
    @src("vvaharness/plugins/semgrep/enricher.py:156")
    SemgrepLocated location(Map entry, String root) {
        Object path = entry.get("path"); Object start = entry.get("start");
        Object line = start instanceof Map ? start.get("line") : null;
        if (path instanceof String && pythonIsInt(line)) return new SemgrepLocated(SemgrepFindings.relativePath(path, root), line);
        return null;
    }
    @src("vvaharness/plugins/semgrep/enricher.py:167")
    Tuple rankKey(Map result, Theta θ) {
        Map extra = truthyOr(result.get("extra"), Map.of());
        String severity = str(extra.getOrDefault("severity", "")).upper();
        return tuple(θ["code.plugins.semgrep.enricher.severity_order"].getOrDefault(severity, 3), str(truthyOr(result.get("path"), "")), toInt(truthyOr(truthyOr(result.get("start"), Map.of()).get("line"), 0)), str(truthyOr(result.get("check_id"), ""))); // src: vvaharness/plugins/semgrep/enricher.py:60
    }
    @src("vvaharness/plugins/semgrep/enricher.py:165")
    List<Map> ranked(List results, Theta θ) {
        return sortedBy(results.filter(r -> r instanceof Map), r -> rankKey(r, θ)).head(θ["code.plugins.semgrep.enricher.max_finding_nodes"]); // src: vvaharness/plugins/semgrep/enricher.py:51
    }
    @src("vvaharness/plugins/semgrep/enricher.py:188")
    GraphNode scanNode(ProjectId project, SemgrepCoverage c, Theta θ) {
        return GraphNode.create(project, localId("semgrep-scan", project.value), List.of("SemgrepScan"), Map.of("complete", c.complete, "findingCount", c.findings, "errorCount", c.errors, "skippedCount", c.skipped, "ruleCount", c.rules, "note", c.note.head(θ["code.plugins.semgrep.enricher.max_message_chars"]), "tool", "semgrep")); // src: vvaharness/plugins/semgrep/enricher.py:59
    }
    @src("vvaharness/plugins/semgrep/enricher.py:244")
    String ruleId(SemgrepGraphBuilder b, String checkId, Map metadata, Theta θ) {
        return b.node(localId("semgrep-rule", checkId), List.of("SemgrepRule"), Map.of("name", checkId, "ruleId", checkId, "cweIds", cweIds(metadata), "vulnerabilityClasses", classes(metadata, θ)));
    }
    @src("vvaharness/plugins/semgrep/enricher.py:252")
    boolean addFinding(SemgrepGraphBuilder b, SemgrepSymbols symbols, Map result, int ordinal, String root, Theta θ) {
        Object rawPath = result.get("path"); Object line = truthyOr(result.get("start"), Map.of()).get("line");
        if (!(rawPath instanceof String) || !pythonIsInt(line)) return false;
        String path = SemgrepFindings.relativePath(rawPath, root); Map extra = truthyOr(result.get("extra"), Map.of()); Map metadata = truthyOr(extra.get("metadata"), Map.of());
        String checkId = str(truthyOr(result.get("check_id"), "semgrep")); Object end = truthyOr(result.get("end"), Map.of()).get("line");
        String finding = b.node(localId("semgrep-finding", checkId, path, str(line), str(ordinal)), List.of("SemgrepFinding"), Map.of("name", checkId, "ruleId", checkId, "filePath", path, "semgrepStartLine", line, "semgrepEndLine", pythonIsInt(end) ? end : line, "severity", truthyOr(str(truthyOr(extra.get("severity"), "")).upper(), "UNKNOWN"), "message", str(truthyOr(extra.get("message"), checkId)).head(θ["code.plugins.semgrep.enricher.max_message_chars"]), "fingerprint", str(truthyOr(extra.get("fingerprint"), "")))); // src: vvaharness/plugins/semgrep/enricher.py:59
        b.edge(b.anchor(symbols, new SemgrepLocated(path, line)), "FLAGGED_BY", finding, "", Map.of(), θ);
        b.edge(finding, "DETECTED_BY", ruleId(b, checkId, metadata, θ), "", Map.of(), θ);
        for (Indexed step : enumerate(traceSteps(extra, root, θ))) {
            String target = symbols.resolve(step.value.second);
            if (target != null && target != finding) b.edge(finding, "TRACE_TOUCHES", target, str(step.index), Map.of("step", step.index, "role", step.value.first, "filePath", step.value.second.path, "startLine", step.value.second.line), θ);
        }
        return true;
    }
    @src("vvaharness/plugins/semgrep/enricher.py:283")
    GraphMutation mutation(ProjectId project, GraphSnapshot graph, Map document, String root, Theta θ) {
        Object raw = document.get("results"); List results = ranked(raw instanceof List ? raw : List.of(), θ);
        SemgrepGraphBuilder b = new SemgrepGraphBuilder(project); SemgrepSymbols symbols = index(graph); int written = 0;
        for (Indexed r : enumerate(results)) if (addFinding(b, symbols, r.value, r.index, root, θ)) written++;
        Object errors = document.get("errors"); Object skipped = truthyOr(document.get("paths"), Map.of()).get("skipped");
        int errorCount = errors instanceof List ? errors.size() : 0; int dropped = raw instanceof List ? raw.size() - results.size() : 0;
        SemgrepCoverage c = new SemgrepCoverage(dropped > 0 ? "results dropped at finding cap" : "ok", dropped == 0 && errorCount == 0, written, errorCount, skipped instanceof List ? skipped.size() : 0, b.nodes.values().count(n -> n.labels.contains("SemgrepRule")));
        // Source does not use skipped count, malformed result count, failed anchors or exhausted edge budget to clear complete.
        GraphNode scan = scanNode(project, c, θ); b.nodes.putIfAbsent(scan.id, scan); return b.mutation();
    }
    @src("vvaharness/plugins/semgrep/enricher.py:321")
    GraphMutation enrich(PluginContext context, Theta θ) {
        ProjectId project = context.project.projectId; double budget = min(timeoutSeconds, context.deadlineMonotonic - monotonic());
        String reason = refusal(context, budget, θ); if (!reason.isEmpty()) return degrade(project, reason, θ);
        String root = str(context.project.sourcePath); Pair report = report(root, budget, θ);
        if (report.first == null) return degrade(project, report.second, θ);
        return mutation(project, context.graph, report.first, root, θ);
    }
    @src("vvaharness/plugins/semgrep/enricher.py:334")
    GraphMutation degrade(ProjectId project, String note, Theta θ) {
        Counters.bump("semgrep_scan_degraded"); logWarning("Semgrep evidence absent", note);
        return degraded(project, note, θ);
    }
    @src("vvaharness/plugins/semgrep/enricher.py:342")
    String refusal(PluginContext context, double budget, Theta θ) {
        if (context.cancellation.isCancelled) return "cancelled";
        if (!truthy(context.project.sourcePath)) return "missing source path";
        if (configs.isEmpty() && rulesets.isEmpty()) return "no rules";
        if (budget < θ["code.plugins.semgrep.enricher.min_budget_seconds"]) return "insufficient budget"; // src: vvaharness/plugins/semgrep/enricher.py:54
        return "";
    }
    @src("vvaharness/plugins/semgrep/enricher.py:354")
    Pair<Map, String> report(String root, double budget, Theta θ) {
        try {
            with (TemporaryDirectory work = temporaryDirectory("vvah-semgrep-")) {
                Path output = work.path.resolve("semgrep.json");
                ProcessResult done = subprocess(argv(root, output, θ), captureOutput=true, text=true, check=false, timeout=budget, cwd=root);
                if (!output.isFile()) return new Pair(null, "no report: " + firstTruthy(done.stderr, done.stdout, "").strip().head(θ["code.plugins.semgrep.enricher.max_message_chars"])); // src: vvaharness/plugins/semgrep/enricher.py:59
                return new Pair(SemgrepFindings.readSemgrepJson(output, θ), "");
            }
        } catch (Exception e) { return new Pair(null, (typeName(e) + ": " + e.message).head(θ["code.plugins.semgrep.enricher.max_message_chars"])); } // src: vvaharness/plugins/semgrep/enricher.py:59
    }
    @src("vvaharness/plugins/semgrep/enricher.py:370")
    GraphMutation degraded(ProjectId project, String note, Theta θ) {
        return new GraphMutation(project, List.of(scanNode(project, new SemgrepCoverage(note), θ)), List.of());
    }
}

@executedBy(CODE) @role(types)
class SemgrepSymbols {
    Map spans; Map files;
    @src("vvaharness/plugins/semgrep/enricher.py:78")
    String resolve(SemgrepLocated at) {
        Pair best = null;
        for (Triple span : spans.getOrDefault(at.path, List.of())) {
            if (span.first <= at.line && at.line <= span.second && (best == null || span.second - span.first < best.first)) best = new Pair(span.second - span.first, span.third);
        }
        return best == null ? files.get(at.path) : best.second;
    }
}

@executedBy(CODE) @role(io)
class SemgrepGraphBuilder {
    ProjectId project; Map nodes = new OrderedMap(); Map edges = new OrderedMap();
    @src("vvaharness/plugins/semgrep/enricher.py:206")
    SemgrepGraphBuilder(ProjectId project) {
        this.project = project; // src: vvaharness/plugins/semgrep/enricher.py:214
    }
    @src("vvaharness/plugins/semgrep/enricher.py:211")
    String node(String localId, List labels, Map properties) {
        GraphNode node = GraphNode.create(project, localId, labels, freeze(properties));
        nodes.putIfAbsent(node.id, node); return node.id;
    }
    @src("vvaharness/plugins/semgrep/enricher.py:218")
    boolean edge(String source, String relationship, String target, String discriminator, Map properties, Theta θ) {
        if (edges.size() >= θ["code.plugins.semgrep.enricher.max_edges"]) return false; // src: vvaharness/plugins/semgrep/enricher.py:53
        GraphEdge edge = GraphEdge.create(project, source, relationship, target, discriminator, freeze(truthyOr(properties, Map.of())));
        edges.putIfAbsent(edge.id, edge); return true;
    }
    @src("vvaharness/plugins/semgrep/enricher.py:230")
    String anchor(SemgrepSymbols symbols, SemgrepLocated at) {
        String resolved = symbols.resolve(at); if (resolved != null) return resolved;
        return node(localId("semgrep-location", at.path), List.of("SemgrepLocation"), Map.of("name", at.path, "filePath", at.path));
    }
    @src("vvaharness/plugins/semgrep/enricher.py:283")
    GraphMutation mutation() {
        return new GraphMutation(project, nodes.values().toList(), edges.values().toList());
    }
}
