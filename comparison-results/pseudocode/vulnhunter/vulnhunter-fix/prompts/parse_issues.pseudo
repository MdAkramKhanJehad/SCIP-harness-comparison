// file: vulnhunter-fix/prompts/parse_issues.md
// Phase 1 of vulnhunter-fix in in-place mode: harvest vulnhunter-labeled GitHub issues (or a local RESULTS_PATH),
// let the developer pick issues/clusters, stage the full report from the publish repo, extract findings with a
// Sonnet subagent, hash vulnfix_keys in Python, and join issues to findings into .vulnhunter-fix/work.json.

@executedBy(MODEL) @role(prompt) @stage("parse")
class ParseIssues {

    // ---------------------------------------------------------------------------------------------
    // Entry point: the Phase 1 procedure. Every error stops the phase.
    // ---------------------------------------------------------------------------------------------
    PhaseOutput run(Dispatch d, Config cfg, Theta θ) {
        Prompt p = prompt(θ);
        // this prompt replaces parse.md in in-place mode
        assert θ["p.parse_issues.in_place_prompt_selection"];                                            // src: vulnhunter-fix/prompts/parse_issues.md:5
        try {
            if (d.results != null && θ["p.parse_issues.results_path_short_circuit"]) {                   // src: vulnhunter-fix/prompts/parse_issues.md:13
                String reportPath = step0ResultsPath(d, θ);
                Findings fs = step5Extract(reportPath, θ);
                // unclear: with no issues, Steps 3/5c/6 have nothing to join; findings flow downstream with no_source_issues=true
                return PhaseOutput.of(fs);
            }
            // default: findings come from vulnhunter-labeled issues on origin
            String source = θ["p.parse_issues.findings_source_default_issues"];                         // src: vulnhunter-fix/prompts/parse_issues.md:8
            List<Issue> raw = step1FetchIssues(d, θ);
            Intake intake = step2Markers(raw, θ);
            intake = step3Select(raw, intake, θ);
            if (intake.issues.isEmpty()) return PhaseOutput.nothingDone();                               // src: vulnhunter-fix/prompts/parse_issues.md:324
            String reportPath = step4StageReport(raw, intake, θ);
            Findings fs = step5Extract(reportPath, θ);
            step5cCoverage(intake, fs, θ);
            Work w = step6Join(intake, fs, θ);
            step7Present(w, θ);
            return PhaseOutput.of(w, θ["p.parse_issues.output_contract_files"]);                         // src: vulnhunter-fix/prompts/parse_issues.md:684
        } catch (PhaseError e) {
            return errorHandling(e, θ);
        }
    }

    // ---------------------------------------------------------------------------------------------
    // Prompt sections in document order.
    // ---------------------------------------------------------------------------------------------
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(whenThisRuns(θ));
        p.include(step0Text(θ));
        p.include(inputsText(θ));
        p.include(implementationPrinciple(θ));
        p.include(step1Text(θ));
        p.include(step2Text(θ));
        p.include(step3Text(θ));
        p.include(step4Text(θ));
        p.include(step5Text(θ));
        p.include(step6And7Text(θ));
        p.include(outputContractAndErrors(θ));
        return p;
    }

    Prompt whenThisRuns(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.parse_issues.in_place_prompt_selection"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:5
        p.rule(θ["p.parse_issues.findings_source_default_issues"]);                                     // src: vulnhunter-fix/prompts/parse_issues.md:8
        return p;
    }

    Prompt step0Text(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.parse_issues.results_path_short_circuit"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:13
        p.format(θ["p.parse_issues.work_json_no_source_issues_fields"]);                                // src: vulnhunter-fix/prompts/parse_issues.md:15
        p.rule(θ["p.parse_issues.results_path_local_dir_as_is"]);                                       // src: vulnhunter-fix/prompts/parse_issues.md:28
        p.rule(θ["p.parse_issues.results_path_url_shallow_clone"]);                                     // src: vulnhunter-fix/prompts/parse_issues.md:29
        p.must(θ["p.parse_issues.results_path_readme_required"]);                                       // src: vulnhunter-fix/prompts/parse_issues.md:34
        return p;
    }

    Prompt inputsText(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.parse_issues.explicit_issue_urls_optional"]);                                       // src: vulnhunter-fix/prompts/parse_issues.md:43
        return p;
    }

    Prompt implementationPrinciple(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.parse_issues.cheapest_model_principle"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:48
        p.choose(θ["p.parse_issues.transform_tiers"]);                                                  // src: vulnhunter-fix/prompts/parse_issues.md:50
        p.rule(θ["p.parse_issues.tier1_trivial_jq"]);                                                   // src: vulnhunter-fix/prompts/parse_issues.md:52
        p.rule(θ["p.parse_issues.tier2_main_agent_write"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:53
        p.rule(θ["p.parse_issues.tier3_subagent_type"]);                                                // src: vulnhunter-fix/prompts/parse_issues.md:54
        p.rule(θ["p.parse_issues.haiku_for_shape_stable"]);                                             // src: vulnhunter-fix/prompts/parse_issues.md:55
        p.rule(θ["p.parse_issues.sonnet_for_shape_variable"]);                                          // src: vulnhunter-fix/prompts/parse_issues.md:56
        p.tiebreak(θ["p.parse_issues.prefer_sonnet_when_unsure"]);                                      // src: vulnhunter-fix/prompts/parse_issues.md:58
        p.forbid(θ["p.parse_issues.no_multiline_jq_heredocs"]);                                         // src: vulnhunter-fix/prompts/parse_issues.md:60
        p.context(θ["fix.subagent_models"]);                                                             // src: vulnhunter-fix/prompts/parse_issues.md:55
        return p;
    }

    Prompt step1Text(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.parse_issues.network_calls_in_bash"]);                                              // src: vulnhunter-fix/prompts/parse_issues.md:64
        p.must(θ["p.parse_issues.gh_failure_stop_in_parse"]);                                           // src: vulnhunter-fix/prompts/parse_issues.md:66
        p.must(θ["p.parse_issues.issue_list_fail_stop"]);                                               // src: vulnhunter-fix/prompts/parse_issues.md:100
        p.rule(θ["p.parse_issues.no_issues_stop"]);                                                     // src: vulnhunter-fix/prompts/parse_issues.md:104
        p.rule(θ["p.parse_issues.missing_label_stop"]);                                                 // src: vulnhunter-fix/prompts/parse_issues.md:105
        return p;
