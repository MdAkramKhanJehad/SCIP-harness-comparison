// file: vvaharness/backends/llm/tool_adapter.py
// In-process langchain-tool adapter: carries a stage's caller fact tools (graph, CweGuidance) onto the
// via: sdk / via: openai raw loops, honouring the caller's budget and EvidenceGate middleware.

@executedBy(CODE) @role(tool)
class ToolAdapter {

    String EVIDENCE_UNENFORCED_COUNTER = "llm_adapter_evidence_gate_unenforced";                            // src: vvaharness/backends/llm/tool_adapter.py:38
    Set<String> WARNED = new Set();                                                                         // src: vvaharness/backends/llm/tool_adapter.py:41

    /** Run the caller's ToolBuilder and keep only its fact tools. */
    @src("vvaharness/backends/llm/tool_adapter.py:44")
    List<LcTool> materialize(ToolBuilder toolBuilder, String model, Path cwd, List<String> factTools) {
        Set<String> wanted = Set.copyOf(factTools);                                                         // src: vvaharness/backends/llm/tool_adapter.py:49
        if (wanted.isEmpty()) return List.of();                                                             // src: vvaharness/backends/llm/tool_adapter.py:51
        StreamingOptions options = new StreamingOptions(model, cwd, factTools);                             // src: vvaharness/backends/llm/tool_adapter.py:52
        List<LcTool> built = toolBuilder.build(options, List.of());                                         // src: vvaharness/backends/llm/tool_adapter.py:54
        return built.filter(t -> wanted.contains(t.name));                                                  // src: vvaharness/backends/llm/tool_adapter.py:55
    }

    @src("vvaharness/backends/llm/tool_adapter.py:58")
    Schema toolSchema(LcTool tool) {
        Map args = tool.args;                                                                               // src: vvaharness/backends/llm/tool_adapter.py:60
        List<String> required = args.keys().filter(n -> !args.get(n).containsKey("default"));               // src: vvaharness/backends/llm/tool_adapter.py:61
        return new Schema("object", args, required);                                                        // src: vvaharness/backends/llm/tool_adapter.py:65
    }

    @src("vvaharness/backends/llm/tool_adapter.py:68")
    Map anthropicSchema(LcTool tool) {
        String desc = tool.description.strip();                                                             // src: vvaharness/backends/llm/tool_adapter.py:71
        return Map.of("name", tool.name, "description", desc.isEmpty() ? tool.name : desc, "input_schema", toolSchema(tool)); // src: vvaharness/backends/llm/tool_adapter.py:72
    }

    /** Refusal text when one of the caller's own budgets has no allowance left. */
    @src("vvaharness/backends/llm/tool_adapter.py:76")
    String budgetRefusal(List<Middleware> parentMiddleware, String name) {
        for (Middleware mw : parentMiddleware) {                                                            // src: vvaharness/backends/llm/tool_adapter.py:78
            if (mw.refusalFor == null) continue;
            String text = mw.refusalFor(name);                                                              // src: vvaharness/backends/llm/tool_adapter.py:82
            if (text != null && !text.isEmpty()) return text;
        }
        return null;
    }

    /** Tool names the caller's EvidenceGate would have demanded before a verdict. */
    @src("vvaharness/backends/llm/tool_adapter.py:88")
    Set<String> requiredFactTools(List<Middleware> parentMiddleware) {
        Set<String> required = new Set();
        for (Middleware mw : parentMiddleware) if (mw.requiredTools != null) required.addAll(mw.requiredTools); // src: vvaharness/backends/llm/tool_adapter.py:91
        return required;
    }

    @src("vvaharness/backends/llm/tool_adapter.py:98")
    String serialize(Object result) {
        if (result instanceof String) return result;                                                        // src: vvaharness/backends/llm/tool_adapter.py:100
        try { return Json.dumps(result); } catch (Exception e) { return result.toString(); }                // src: vvaharness/backends/llm/tool_adapter.py:103
    }

    /** Adapt the caller's tool_builder for one sdk/openai agentic session; null = nothing to carry (tool paragraph withheld). */
    @src("vvaharness/backends/llm/tool_adapter.py:221")
    ToolStack build(ToolBuilder toolBuilder, String model, Path cwd, List<String> factTools, List<Middleware> parentMiddleware) {
        if (toolBuilder == null || factTools.isEmpty()) return null;                                        // src: vvaharness/backends/llm/tool_adapter.py:226
        List<LcTool> lcTools = materialize(toolBuilder, model, cwd, factTools);                             // src: vvaharness/backends/llm/tool_adapter.py:228
        if (lcTools.isEmpty()) return null;                                                                 // src: vvaharness/backends/llm/tool_adapter.py:230
        return new ToolStack(lcTools.map(t -> anthropicSchema(t)), lcTools.map(t -> t.name), requiredFactTools(parentMiddleware), lcTools, parentMiddleware); // src: vvaharness/backends/llm/tool_adapter.py:232
    }
}

@executedBy(CODE) @role(tool)
class ToolStack {

    List<Map> schemas;                                                                                      // Anthropic-shape extra_tools // src: vvaharness/backends/llm/tool_adapter.py:113
    List<String> names;
    Set<String> required;                                                                                   // per the caller's EvidenceGate // src: vvaharness/backends/llm/tool_adapter.py:117
    Map<String, LcTool> tools;
    List<Middleware> middleware;
    Set<String> called;                                                                                     // src: vvaharness/backends/llm/tool_adapter.py:120

    @src("vvaharness/backends/llm/tool_adapter.py:123")
    ValidationError validationError(LcTool lcTool, Map args) {
        if (lcTool.argsSchema == null || !lcTool.argsSchema.hasModelValidate()) return null;                // src: vvaharness/backends/llm/tool_adapter.py:126
        try { lcTool.argsSchema.modelValidate(args); } catch (ValidationError exc) { return exc; }          // src: vvaharness/backends/llm/tool_adapter.py:129
        return null;
    }

    @src("vvaharness/backends/llm/tool_adapter.py:134")
    String toolFault(String name, Map args, Exception exc, String tag) {
        Counters.bump("llm_adapter_tool_error_" + name);                                                    // src: vvaharness/backends/llm/tool_adapter.py:137
        String err = "ERROR: " + exc.type + ": " + Redact.redact(exc.message);                              // src: vvaharness/backends/llm/tool_adapter.py:138
        logDispatch(name, args, err, tag);
        return err;
    }

    /** Validation or budget rejection text, or null to proceed. */
    @src("vvaharness/backends/llm/tool_adapter.py:142")
    String rejected(LcTool lcTool, String name, Map args, String tag) {
        ValidationError invalid = validationError(lcTool, args);                                            // src: vvaharness/backends/llm/tool_adapter.py:145
        if (invalid != null) return toolFault(name, args, invalid, tag);                                    // src: vvaharness/backends/llm/tool_adapter.py:147
        String refusal = ToolAdapter.budgetRefusal(middleware, name);                                       // src: vvaharness/backends/llm/tool_adapter.py:148
        if (refusal != null) {
            logDispatch(name, args, "refused: " + refusal, tag);
            return refusal;                                                                                 // src: vvaharness/backends/llm/tool_adapter.py:151
        }
        return null;
    }

    /** Run one adapted tool, or null so the loop's localtools get the name. */
    @src("vvaharness/backends/llm/tool_adapter.py:154")
    String dispatch(String name, Map args, String tag) {
        LcTool lcTool = tools.get(name);                                                                    // src: vvaharness/backends/llm/tool_adapter.py:157
        if (lcTool == null) return null;                                                                    // src: vvaharness/backends/llm/tool_adapter.py:159
        String rejection = rejected(lcTool, name, args, tag);                                               // src: vvaharness/backends/llm/tool_adapter.py:160
        if (rejection != null) return rejection;
        called.add(name);                                                                                   // src: vvaharness/backends/llm/tool_adapter.py:163
        for (Middleware mw : middleware) if (mw.noteCall != null) mw.noteCall(name);                        // budgets metered // src: vvaharness/backends/llm/tool_adapter.py:164
        Object result;
        try { result = lcTool.invoke(args); } catch (Exception exc) { return toolFault(name, args, exc, tag); } // src: vvaharness/backends/llm/tool_adapter.py:169
        String masked = Redact.redactCounts(ToolAdapter.serialize(result)).masked;                          // src: vvaharness/backends/llm/tool_adapter.py:172
        String out = LlmTools.capToolResult(masked);                                                        // src: vvaharness/backends/llm/tool_adapter.py:173
        logDispatch(name, args, out.length() + " chars", tag);
        return out;
    }

    @src("vvaharness/backends/llm/tool_adapter.py:177")
    void logDispatch(String name, Map args, String outcome, String tag) {
        if (ScanProgress.isStageOnly()) return;                                                             // src: vvaharness/backends/llm/tool_adapter.py:179
        Console.write("[tool-adapter] tool " + name + "(" + LlmTools.summarizeArgs(args) + ") -> " + outcome); // src: vvaharness/backends/llm/tool_adapter.py:181
    }

    /** Union of every metered tool name whose caller-owned budget is spent. */
    @src("vvaharness/backends/llm/tool_adapter.py:184")
    Set<String> exhaustedTools() {
        Set<String> out = new Set();
        for (Middleware mw : middleware) if (mw.exhaustedTools != null) out.addAll(mw.exhaustedTools());    // src: vvaharness/backends/llm/tool_adapter.py:187
        return out;
    }

    /** Text to return as a tool result instead of the verdict (EvidenceGate hold), or null to allow it. */
    @src("vvaharness/backends/llm/tool_adapter.py:194")
    String submitGuard() {
        for (Middleware mw : middleware) {                                                                  // src: vvaharness/backends/llm/tool_adapter.py:196
            if (mw.holdForVerdict == null) continue;
            String text = mw.holdForVerdict();                                                              // src: vvaharness/backends/llm/tool_adapter.py:200
            if (text != null && !text.isEmpty()) return text;
        }
        return null;
    }

    /** Count and announce a verdict that shipped without consulting any required tool (gate already relented). */
    @src("vvaharness/backends/llm/tool_adapter.py:205")
    void reportEvidenceDegradation(String tag, String label) {
        if (required.isEmpty() || !required.intersect(called).isEmpty()) return;                            // src: vvaharness/backends/llm/tool_adapter.py:208
        Counters.bump(ToolAdapter.EVIDENCE_UNENFORCED_COUNTER);                                             // src: vvaharness/backends/llm/tool_adapter.py:210
        WarnOnce.warn(ToolAdapter.WARNED, "evidence-gate:" + label + ":" + tag, "verdict accepted without required graph evidence"); // src: vvaharness/backends/llm/tool_adapter.py:211
    }
}
