// src: vvaharness/util/net.py:22
_LOCAL_NAMES = {"localhost", "localhost."}   // compared lower-cased

// src: vvaharness/util/net.py:25-30
fn ip_literal(host):executor=code {
  return host (trimmed, surrounding "[" "]" removed) parsed as an IP address, or null when it is a name
}

// src: vvaharness/util/net.py:33-41
fn is_loopback_host(host):executor=code {
  if (!host) return false
  h = host trimmed, surrounding "[" "]" removed
  if (lower-case h in _LOCAL_NAMES) return true
  return ip_literal(h) is a loopback address   // for example 127.0.0.2 counts; a name that merely resolves to loopback does not
}
