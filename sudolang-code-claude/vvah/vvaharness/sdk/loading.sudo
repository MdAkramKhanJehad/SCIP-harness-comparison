# vvaharness/sdk/loading.py

Resolves a profile's `sdk.plugins` block into the one `PluginSet` a scan installs. Only plugin names in a fixed table can be loaded.

Source: `vvaharness/sdk/loading.py` (lines 1-78)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (`load_plugin_set(cfg)` then `install_graph_tools()`, before the code graph is built)

// src: vvaharness/sdk/loading.py:27-32
BUILTIN_PLUGINS = { semgrep: "vvaharness.plugins.semgrep:SemgrepPlugin" }
// only these names load: a profile naming an arbitrary module is deliberately refused, since configuration would otherwise be a code-execution surface; targets are imported lazily

// src: vvaharness/sdk/loading.py:68-75
fn load_plugin_set(cfg):executor=code {
  specs = _plugin_specs(cfg)
  if (specs is empty) return PluginSet()   // no plugins configured
  plugins = PluginSet(_built(spec) for each spec in specs)   // validation, ordering and merging: see sdk/plugins.sudo
  log "sdk plugins loaded: <names>"
  return plugins
}

// src: vvaharness/sdk/loading.py:35-45
fn _plugin_specs(cfg):executor=code {
  raw = knob("sdk.plugins", default=[]) || []
  require raw is a list => throw TypeError("sdk.plugins must be a list of mappings")
  for each entry in raw {
    require entry is a mapping with a non-empty name => throw TypeError("each sdk.plugins entry needs a name: <entry>")
  }
  return copies of the entries
}

// src: vvaharness/sdk/loading.py:48-65
fn _built(spec):executor=code {
  options = spec without "name"
  target = BUILTIN_PLUGINS[spec.name]
  require target != null => throw ValueError("unknown sdk plugin <name>; known: <sorted names>")
  factory = import the class named by target   // _resolve: "module:attribute"
  for each key in ["configs", "rulesets"] { if (key in options) options[key] = tuple(options[key] || []) }
  return factory(...options)   // every key except name becomes a constructor keyword argument
}
