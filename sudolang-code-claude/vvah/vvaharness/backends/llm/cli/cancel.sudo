# vvaharness/backends/llm/cli/cancel.py

Ctrl-C propagation for the `claude` command-line route: one process-wide abort flag, the registry of live `claude` subprocesses, and the process-tree kill and graceful stop used on abort and on time-out.

Source: `vvaharness/backends/llm/cli/cancel.py` (lines 1-121)
Executor: code
Called from: `vvaharness/backends/llm/cli/process.sudo` (`_run`, `_run_streaming`), `cli/retry.sudo`, `cli/oneshot.sudo`, `cli/session.sudo`, `cli_mcp.sudo`; `abort()` is called by stage worker pools on Ctrl-C

// src: vvaharness/backends/llm/cli/cancel.py:31-43
State {
  _ABORT: threading Event          // process-wide stop flag; only the main thread sees KeyboardInterrupt, so Stage 4 and Stage 6 pool workers call abort()
  _LIVE: set of running claude Popen objects, guarded by _LIVE_LOCK
  _NEW_GROUP_KW = if (os is Windows) {} else { start_new_session: true }   // each claude gets its own process group so the whole tree can be signalled
  // src: vvaharness/backends/llm/cli/cancel.py:93-94
  _ABORT_HOOKS: list of callables = []   // for processes not in _LIVE (the cli_mcp bridge's SDK-launched binary); hooks must never raise
}

// src: vvaharness/backends/llm/cli/cancel.py:38-39
fn aborted():executor=code { return _ABORT is set }

// src: vvaharness/backends/llm/cli/cancel.py:46-70
fn _kill_tree(proc):executor=code {
  if (proc has already exited) return
  try {
    if (os is Windows) {
      run "taskkill /F /T /PID <proc.pid>" with timeout 10 seconds
      return
    }
    pgid = process group of proc   // null on OSError or AttributeError
    // Guard against ever signalling our own group
    if (pgid != null && pgid != our own process group) { send SIGKILL to group pgid }
    else { proc.kill() }
  }
  catch error => try proc.kill(); catch => ignore   // last resort: the direct child
}

// src: vvaharness/backends/llm/cli/cancel.py:73-90
fn _stop_tree(proc, grace):executor=code {
  // A session that flushes its session file on SIGINT stays resumable; SIGKILL never does
  if (proc has already exited) return
  if (os is Windows) { _kill_tree(proc); return }
  try { if (process group of proc != our own process group) send SIGINT to that group }
  catch OSError or AttributeError => ignore
  try proc.wait(timeout=grace)
  catch TimeoutExpired => _kill_tree(proc)
}

// src: vvaharness/backends/llm/cli/cancel.py:97-100
fn register_abort_hook(fn):executor=code {
  if (fn not in _ABORT_HOOKS) append fn to _ABORT_HOOKS
}

// src: vvaharness/backends/llm/cli/cancel.py:103-116
fn abort():executor=code {
  set _ABORT
  procs = copy of _LIVE taken under _LIVE_LOCK
  for each p in procs, _kill_tree(p)
  for each hook in a copy of _ABORT_HOOKS {   // a copy: a hook may register another mid-teardown
    try hook(); catch => ignore
  }
  return length(procs)   // count signalled
}

// src: vvaharness/backends/llm/cli/cancel.py:119-121
fn reset_abort():executor=code {
  clear _ABORT   // so a programmatic abort() does not poison later repositories in a batch run
}
