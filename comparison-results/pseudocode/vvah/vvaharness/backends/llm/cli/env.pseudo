// file: vvaharness/backends/llm/cli/env.py
// Process-global cli config (TLS, proxy, effort, restricted) and the per-call `claude` subprocess env:
// Node TLS env vars, the effort pin, refusal-resend disable, and the output-token cap.

@executedBy(CODE) @role(config)
record CliConfig(Object verifySsl, String caCert, Object clientCert, String noProxy, String effort, boolean restricted) { }

@executedBy(CODE) @role(backend)
class Env {

    // process-global defaults, overwritten by configure() from the profile's cli: block
    CliConfig cfg = new CliConfig(true, null, null, null, "high", true);                                    // src: vvaharness/backends/llm/cli/env.py:35
    Map tlsExtra = new Map();                                                                               // src: vvaharness/backends/llm/cli/env.py:38

    // Default CLI resends a refused turn once and may switch to a fallback model: both disabled
    Map NO_REFUSAL_RESEND_ENV = θ["code.backends.llm.cli.env.no_refusal_resend_env"];                       // src: vvaharness/backends/llm/cli/env.py:109

    /** Stored TLS/proxy config -> subprocess env vars (mTLS has no env path for Node). */
    @src("vvaharness/backends/llm/cli/env.py:41")
    Map buildTlsEnv() {
        Map out = new Map();
        String ca = cfg.caCert;                                                                             // cli.ca_cert // src: vvaharness/backends/llm/cli/env.py:44
        Object verify = cfg.verifySsl;                                                                      // cli.verify_ssl // src: vvaharness/backends/llm/cli/env.py:45
        String bundle = ca != null ? ca : (verify instanceof String ? verify : null);                       // CA may arrive as string verify_ssl // src: vvaharness/backends/llm/cli/env.py:47
        if (bundle != null) {
            if (Files.exists(bundle)) out.put("NODE_EXTRA_CA_CERTS", bundle);                               // src: vvaharness/backends/llm/cli/env.py:50
            else Log.warning(Event.TLS_CA_NOT_FOUND, bundle);                                               // src: vvaharness/backends/llm/cli/env.py:52
        }
        if (verify == false) {
            out.put("NODE_TLS_REJECT_UNAUTHORIZED", "0");                                                   // src: vvaharness/backends/llm/cli/env.py:54
            Log.warning("TLS verification disabled for the claude subprocess");
        }
        if (cfg.noProxy != null) { out.put("NO_PROXY", cfg.noProxy); out.put("no_proxy", cfg.noProxy); }    // src: vvaharness/backends/llm/cli/env.py:59
        if (cfg.clientCert != null) Log.warning("client_cert/mTLS configured but the claude CLI cannot present it; use via: sdk or deepagents"); // src: vvaharness/backends/llm/cli/env.py:62
        return out;
    }

    /** Push gateway TLS/proxy/effort/restricted settings (from the profile's cli: block). */
    @src("vvaharness/backends/llm/cli/env.py:69")
    void configure(Object verifySsl, String caCert, Object clientCert, String noProxy, String effort, Boolean restricted, Theta θ) {
        if (verifySsl != null) cfg.verifySsl = Tls.coerceVerify(θ["cli.verify_ssl"]);                       // src: vvaharness/backends/llm/cli/env.py:77
        if (caCert != null) cfg.caCert = θ["cli.ca_cert"];                                                  // src: vvaharness/backends/llm/cli/env.py:79
        if (clientCert != null) cfg.clientCert = clientCert;                                                // src: vvaharness/backends/llm/cli/env.py:81
        if (noProxy != null) cfg.noProxy = noProxy;                                                         // src: vvaharness/backends/llm/cli/env.py:83
        if (effort != null) cfg.effort = θ["cli.effort"];                                                   // src: vvaharness/backends/llm/cli/env.py:85
        if (restricted != null) cfg.restricted = θ["cli.restricted"];                                       // False is meaningful: `is not None` // src: vvaharness/backends/llm/cli/env.py:87
        tlsExtra.clear();
        tlsExtra.putAll(buildTlsEnv());                                                                     // src: vvaharness/backends/llm/cli/env.py:90
    }

    /** Per-call effort if it parses to a known tier, else the process-global cli.effort. */
    @src("vvaharness/backends/llm/cli/env.py:93")
    String effectiveEffort(String effort) {
        Effort parsed = effort != null ? EffortLevel.parse(effort) : null;                                  // src: vvaharness/backends/llm/cli/env.py:95
        return parsed != null ? parsed.value : cfg.effort;                                                  // src: vvaharness/backends/llm/cli/env.py:96
    }

    /** `--effort <tier>` argv, only when the probe saw the flag. */
    @src("vvaharness/backends/llm/cli/env.py:99")
    List<String> effortArgv(String effort) {
        String tier = effectiveEffort(effort);                                                              // src: vvaharness/backends/llm/cli/env.py:101
        if (tier != null && Discovery.cliCapabilities().get("effort")) return List.of("--effort", tier);    // src: vvaharness/backends/llm/cli/env.py:102
        return List.of();                                                                                   // src: vvaharness/backends/llm/cli/env.py:104
    }

    /** Env pinned on every claude session: the effort tier (or blank) and no refusal resend. */
    @src("vvaharness/backends/llm/cli/env.py:115")
    Map sessionPins(String effort) {
        // an exported CLAUDE_CODE_EFFORT_LEVEL overrides --effort, so it is always pinned (blank = unset)
        List<String> argv = effortArgv(effort);                                                             // src: vvaharness/backends/llm/cli/env.py:119
        Map env = Map.of("CLAUDE_CODE_EFFORT_LEVEL", argv.isEmpty() ? "" : argv.get(1));                     // src: vvaharness/backends/llm/cli/env.py:120
        env.putAll(NO_REFUSAL_RESEND_ENV);                                                                  // src: vvaharness/backends/llm/cli/env.py:121
        return env;
    }

    /** Per-call env overrides: session pins plus any output-token cap. */
    @src("vvaharness/backends/llm/cli/env.py:124")
    Map callEnv(Integer maxTokens, String effort) {
        Map env = sessionPins(effort);                                                                      // src: vvaharness/backends/llm/cli/env.py:126
        if (maxTokens != null && maxTokens > 0) env.put("CLAUDE_CODE_MAX_OUTPUT_TOKENS", maxTokens.toString()); // src: vvaharness/backends/llm/cli/env.py:128
        return env;
    }
}
