# vvaharness/util/exceptions.py

The exception that halts a scan when the threat model is empty after its retry, and the shared walk over an exception's cause chain (used by the error log and by the failure classifiers in `response_quality`).

Source: `vvaharness/util/exceptions.py` (lines 1-41)
Executor: code
Called from: `vvaharness/pipeline/stages/s2/` (raises `S2HollowAfterRetry`), `vvaharness/orchestrator/scan.py` (catches it and stops the scan with exit code 1), `vvaharness/util/errlog.py`, `vvaharness/util/response_quality.py`

// src: vvaharness/util/exceptions.py:19-28
S2HollowAfterRetry {
  // raised when "Both the primary threat-model call and its tool-free retry produced nothing s3 can mint."
  reason: String
  message: "s2 produced no usable threat model ($reason) and the tool-free retry did not either; s3-s8 would run with zero threat units, so the scan stops here"
}

// src: vvaharness/util/exceptions.py:31-41
fn exception_chain(exc):executor=code {
  // Follows only explicit causes (`__cause__`), never implicit context; outermost first
  links = [exc]; seen = { identity of exc }
  loop {
    cause = explicit cause of last link
    if (cause == null || identity of cause in seen) break   // cycle guard by object identity
    add identity of cause to seen; append cause to links
  }
  return links
}
