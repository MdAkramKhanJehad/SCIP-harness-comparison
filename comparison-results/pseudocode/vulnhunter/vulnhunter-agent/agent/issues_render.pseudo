// file: vulnhunter-agent/agent/issues_render.py
// Render a Finding into a GitHub issue title + body (templates/issue_body.md) with sanitized
// attacker-influenced fields and machine-readable footer markers; also the clean-scan issue/comment.

@executedBy(CODE) @role(io) @stage("issues")
class IssuesRender {

    String reportAccessMessage() {
        return "The full report lives in a private repository. If the link 404s for you, request access from your security team."; // src: vulnhunter-agent/agent/issues_render.py:43
    }

    // _github_anchor: lowercase, strip non [\w\s-], spaces -> hyphens (GitHub heading anchors).
    String githubAnchor(String headingText) {
        String s = headingText.lower();                                                           // src: vulnhunter-agent/agent/issues_render.py:62
        s = s.replaceRegex("[^\\w\\s-]", "");                                                     // src: vulnhunter-agent/agent/issues_render.py:63
        return s.replace(" ", "-");                                                               // src: vulnhunter-agent/agent/issues_render.py:64
    }

    // _build_report_url: <dest>/blob/<branch>/<owner>/<name>/<timestamp>/<sha>/<results_dir>/README.md
    String buildReportUrl(String publishDestinationRepo, String publishBranch, String sourceRepoUrl, String sourceCommitHash, String timestamp, String resultsDirName) {
        String dest = publishDestinationRepo.rstrip("/");                                         // src: vulnhunter-agent/agent/issues_render.py:82
        if (dest.endsWith(".git")) dest = dest.dropSuffix(".git");                                // src: vulnhunter-agent/agent/issues_render.py:83
        (String srcOwner, String srcName) = Github.parseOwnerRepo(sourceRepoUrl);                 // src: vulnhunter-agent/agent/issues_render.py:85
        return dest + "/blob/" + publishBranch + "/" + srcOwner + "/" + srcName + "/" + timestamp + "/" + sourceCommitHash + "/" + resultsDirName + "/README.md"; // src: vulnhunter-agent/agent/issues_render.py:86
    }

    // render_title: "Security Finding: <cwe>: <title>" (no VULN-ID; scan-local ids are unstable).
    String renderTitle(Finding f) {
        String cwe = (f.cwe != "") ? f.cwe : "Unknown CWE";                                       // src: vulnhunter-agent/agent/issues_render.py:93
        String title = (f.title != "") ? f.title : "(untitled)";                                  // src: vulnhunter-agent/agent/issues_render.py:94
        return "Security Finding: " + cwe + ": " + title;                                         // src: vulnhunter-agent/agent/issues_render.py:95
    }

    // _sanitize_for_issue_body: HTML-escape, then backslash-escape markdown link/code metacharacters (CWE-79).
    String sanitizeForIssueBody(String value) {
        String s = html.escape(value, false);                                                     // src: vulnhunter-agent/agent/issues_render.py:115
        for (String ch : θ["code.agent.issues_render.md_escape_chars"]) s = s.replace(ch, "\\" + ch); // src: vulnhunter-agent/agent/issues_render.py:116
        return s;
    }

    // render_body: fill issue_body.md; finding fields sanitized, footer markers left exact.
    String renderBody(Finding f, ExtractedReport report, String reportUrl) {
        String anchor = (f.id != "") ? githubAnchor(f.id + ": " + f.title) : "";                 // src: vulnhunter-agent/agent/issues_render.py:132
        String deepLink = (anchor != "") ? reportUrl + "#" + anchor : reportUrl;                  // src: vulnhunter-agent/agent/issues_render.py:133
        Map<String, String> fields = new Map();
        fields.put("TITLE", sanitizeForIssueBody(orElse(f.title, "(untitled)")));                 // src: vulnhunter-agent/agent/issues_render.py:136
        fields.put("CWE", sanitizeForIssueBody(orElse(f.cwe, "Unknown CWE")));
        fields.put("CWE_NAME", sanitizeForIssueBody(orElse(f.cweName, "(unspecified)")));
        fields.put("SEVERITY", sanitizeForIssueBody(orElse(f.severity, "Unspecified")));
        fields.put("LOCATION", sanitizeForIssueBody(orElse(f.location, "(not specified)")));
        fields.put("ROOT_CAUSE", sanitizeForIssueBody(orElse(f.rootCause, "(not specified)")));
        fields.put("DATA_FLOW", sanitizeForIssueBody(orElse(f.dataFlow, "(not specified)")));
        fields.put("EXPLOIT_DESCRIPTION", sanitizeForIssueBody(orElse(f.exploitDescription, "(not specified in report)")));
        fields.put("EXPLOIT_IMPACT", sanitizeForIssueBody(orElse(f.exploitImpact, "(not specified in report)")));
        fields.put("FIX_STRATEGY", sanitizeForIssueBody(orElse(f.fixStrategy, "(see full report)")));
        fields.put("SEVERITY_RATIONALE", sanitizeForIssueBody(orElse(f.severityRationale, "(see full report)"))); // src: vulnhunter-agent/agent/issues_render.py:150
        // agent-derived fields: not sanitized so the markers stay exact
        fields.put("SCAN_DATE", report.scanDate);                                                 // src: vulnhunter-agent/agent/issues_render.py:155
        fields.put("REPORT_URL", deepLink);
        fields.put("REPORT_ACCESS_MESSAGE", reportAccessMessage());
        fields.put("IDEMPOTENCY_KEY", f.vulnfixKey);                                              // src: vulnhunter-agent/agent/issues_render.py:158
        fields.put("VULN_ID", f.id);
        fields.put("RESULTS_DIR_NAME", report.resultsDirName);                                    // src: vulnhunter-agent/agent/issues_render.py:160
        String body = IssueBody.run(fields);                                                      // src: vulnhunter-agent/agent/issues_render.py:162
        Set<String> leftovers = findPlaceholders(body);                                           // src: vulnhunter-agent/agent/issues_render.py:165
        if (!leftovers.isEmpty()) log.warning("Template placeholders unfilled");                  // src: vulnhunter-agent/agent/issues_render.py:166
        return body;
    }

    Set<String> findPlaceholders(String body) {
        return regexFindAll("<([A-Z_]+)>", body).toSet();                                         // src: vulnhunter-agent/agent/issues_render.py:174
    }

    String renderCleanScanTitle() {
        return "[VulnHunter] Clean scan — no findings detected";                                 // src: vulnhunter-agent/agent/issues_render.py:38
    }

    String renderCleanScanBody(CleanScanContext ctx) {
        return renderCleanScan(ctx, "clean_scan_body");                                           // src: vulnhunter-agent/agent/issues_render.py:214
    }

    String renderCleanScanComment(CleanScanContext ctx) {
        return renderCleanScan(ctx, "clean_scan_comment");                                        // src: vulnhunter-agent/agent/issues_render.py:223
    }

    // _render_clean_scan: blanks -> em dash; report line suppressed when no report_url.
    String renderCleanScan(CleanScanContext ctx, String template) {
        String duration = (ctx.durationSeconds != null && ctx.durationSeconds >= 0) ? ctx.durationSeconds + " seconds" : "—"; // src: vulnhunter-agent/agent/issues_render.py:228
        String reportLine;
        if (ctx.reportUrl != "") {                                                                // src: vulnhunter-agent/agent/issues_render.py:233
            String safeUrl = ctx.reportUrl.replace(")", "%29").replace("(", "%28");               // src: vulnhunter-agent/agent/issues_render.py:238
            reportLine = "Full scan report: [" + orElse(ctx.repoSlug, "report") + "](" + safeUrl + ")"; // src: vulnhunter-agent/agent/issues_render.py:239
        } else {
            reportLine = "";                                                                      // src: vulnhunter-agent/agent/issues_render.py:241
        }
        Map<String, String> fields = new Map();
        fields.put("SCAN_ID", orElse(ctx.scanId, "—"));                                           // src: vulnhunter-agent/agent/issues_render.py:243
        fields.put("REPO_SLUG", orElse(ctx.repoSlug, "—"));
        fields.put("COMMIT_SHA", orElse(ctx.commitShaShort, "—"));
        fields.put("APP_ID", orElse(ctx.appId, "—"));
        fields.put("SCAN_STARTED_AT", orElse(ctx.scanStartedAt, "—"));
        fields.put("SCAN_COMPLETED_AT", orElse(ctx.scanCompletedAt, "—"));
        fields.put("DURATION", duration);
        fields.put("MODEL_VERSION", orElse(ctx.modelVersion, "—"));
        fields.put("SKILL_VERSION", orElse(ctx.skillVersion, "unknown"));                         // src: vulnhunter-agent/agent/issues_render.py:251
        fields.put("REPORT_URL_LINE", reportLine);
        String body = (template == "clean_scan_body") ? CleanScanBody.run(fields) : CleanScanComment.run(fields); // src: vulnhunter-agent/agent/issues_render.py:254
        if (!findPlaceholders(body).isEmpty()) log.warning("Clean-scan template placeholders unfilled"); // src: vulnhunter-agent/agent/issues_render.py:258
        return body;
    }
}

@executedBy(CODE) @role(types)
record CleanScanContext(String scanId, String repoSlug, String commitShaShort, String appId, String scanStartedAt,
                        String scanCompletedAt, Integer durationSeconds, String modelVersion, String skillVersion, String reportUrl) { }
