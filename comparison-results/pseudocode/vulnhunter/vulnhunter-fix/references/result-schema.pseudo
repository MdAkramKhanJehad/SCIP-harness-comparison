// file: vulnhunter-fix/references/result-schema.json
// Per-finding worker result (group-NNN_result.json) and the aggregate .vulnfix_result.json (branches[] of results):
// terminal tier, worker status, bounded tier_judgment, caller routing, discrimination evidence, sweep fields.

@executedBy(CODE) @role(types)
enum ResultCompletenessTier { FULL, MITIGATION, WORKAROUND }

@executedBy(CODE) @role(types)
enum WorkerStatus { VERIFIED, VERIFIED_FULL, VERIFIED_MITIGATION, VERIFIED_WORKAROUND, ALREADY_FIXED, CANNOT_AUTO_FIX, NEEDS_MANUAL_REVIEW, REQUIRES_HUMAN_DECISION, BREAKING_CHANGE, FAILED }

@executedBy(CODE) @role(types)
record ResultTierJudgment(boolean invoked, String phase, ResultCompletenessTier final_tier, String rationale, String failure_reason) { }

@executedBy(CODE) @role(types)
record BreakingChangeDetails(String interface_change, String caller_action_required, List<String> known_callers, String final_secure_interface, String registration_actions) { }

@executedBy(CODE) @role(types)
record CallerNotRouted(String pointer, String reason) { }

@executedBy(CODE) @role(types)
record DiscriminationEvidence(String method, String pre_fix_result, String post_fix_result, String assertion_target) { }

@executedBy(CODE) @role(types)
record SweepSummary(int found, int captured, int mitigated, int remaining, String pattern, String captured_annotation) { }

@executedBy(CODE) @role(types)
record FindingResult(String vuln_id, WorkerStatus status, String severity, String branch, String file_path, String cwe, String root_cause,
                     boolean breaking_change, BreakingChangeDetails breaking_change_details, ResultCompletenessTier completeness_tier,
                     List<String> residual_vectors, ResultTierJudgment tier_judgment, List<String> callers_routed_through_fix,
                     List<CallerNotRouted> callers_not_routed, List<String> files_modified, DiscriminationEvidence discrimination_evidence,
                     boolean sweep_ran, SweepSummary sweep_summary, boolean sweep_revised) { }

@executedBy(CODE) @role(rule_set) @stage("fix")
class ResultSchema {

    boolean validate(Object doc, Theta θ) {
        // oneOf: aggregate with branches[] (min 1) or a single findingResult
        if (doc.has("branches")) {                                                   // src: vulnhunter-fix/references/result-schema.json:234
            if (doc.branches.size() < 1) return false;                               // src: vulnhunter-fix/references/result-schema.json:238
            for (FindingResult r : doc.branches) if (!validFindingResult(r, θ)) return false; // src: vulnhunter-fix/references/result-schema.json:239
            return true;
        }
        return validFindingResult(doc, θ);                                           // src: vulnhunter-fix/references/result-schema.json:244
    }

    boolean validFindingResult(FindingResult r, Theta θ) {
        // required: vuln_id, status, cwe, file_path, completeness_tier, residual_vectors, tier_judgment, callers_routed_through_fix, callers_not_routed
        if (!θ["p.worker_agent_common.result_status_values"].contains(r.status)) return false; // src: vulnhunter-fix/references/result-schema.json:16
        // LLM_REVIEW is never a terminal tier
        if (θ["p.verify.llm_review_never_terminal"] && !List.of("FULL", "MITIGATION", "WORKAROUND").contains(r.completeness_tier)) return false; // src: vulnhunter-fix/references/result-schema.json:11
        if (!Regex.match("^CWE-\\d+$", r.cwe) || r.file_path.isEmpty()) return false; // src: vulnhunter-fix/references/result-schema.json:107
        for (String c : r.callers_routed_through_fix) if (!Regex.match("^[^:]+:.+$", c)) return false; // src: vulnhunter-fix/references/result-schema.json:121 (file:symbol)
        for (CallerNotRouted c : r.callers_not_routed) if (!Regex.match("^[^:]+:.+$", c.pointer) || c.reason.isEmpty()) return false; // src: vulnhunter-fix/references/result-schema.json:131
        if (!validTierJudgment(r.tier_judgment, θ)) return false;                     // src: vulnhunter-fix/references/result-schema.json:118
        // R-1 / R-2: residuals iff not FULL
        if (r.completeness_tier == "FULL" && θ["p.residual-risk-rules.r2_empty_when_full"] && !r.residual_vectors.isEmpty()) return false; // src: vulnhunter-fix/references/result-schema.json:183
        if (r.completeness_tier != "FULL" && θ["p.residual-risk-rules.r1_non_empty_when_not_full"] && r.residual_vectors.isEmpty()) return false; // src: vulnhunter-fix/references/result-schema.json:188
        // FULL + VERIFIED/VERIFIED_FULL must carry discriminating evidence: pre=fail, post=pass (ALREADY_FIXED exempt)
        if (θ["p.remediation-rigor.discrimination_evidence_required_for_full"] && r.completeness_tier == "FULL" && List.of("VERIFIED", "VERIFIED_FULL").contains(r.status)) { // src: vulnhunter-fix/references/result-schema.json:195
            DiscriminationEvidence d = r.discrimination_evidence;
            if (d == null || d.method == null) return false;                         // src: vulnhunter-fix/references/result-schema.json:206
            if (d.pre_fix_result != "fail" || d.post_fix_result != "pass") return false; // src: vulnhunter-fix/references/result-schema.json:208
        }
        if (r.discrimination_evidence != null && r.discrimination_evidence.method != null
            && !θ["p.reviewer_test.discrimination_method_values"].contains(r.discrimination_evidence.method)) return false; // src: vulnhunter-fix/references/result-schema.json:145
        // a sweep that found an unmitigated sibling forbids FULL
        if (θ["p.verify.sweep_downgrades_full"] && r.sweep_revised && r.completeness_tier == "FULL") return false; // src: vulnhunter-fix/references/result-schema.json:223
        if (r.sweep_summary != null && (r.sweep_summary.found < 0 || r.sweep_summary.remaining < 0)) return false; // src: vulnhunter-fix/references/result-schema.json:161
        return true;
    }

    boolean validTierJudgment(ResultTierJudgment t, Theta θ) {
        // closed object; all five keys required
        if (!t.invoked) return t.phase == null && t.final_tier == null && t.rationale == null && t.failure_reason == null; // src: vulnhunter-fix/references/result-schema.json:49
        if (t.phase != null && !θ["p.tier_judgment.phase_values"].contains(t.phase)) return false; // src: vulnhunter-fix/references/result-schema.json:37
        if (t.final_tier != null) {
            if (!θ["p.tier_judgment.final_tier_values"].contains(t.final_tier)) return false; // src: vulnhunter-fix/references/result-schema.json:40
            return t.rationale != null && !t.rationale.isEmpty() && t.failure_reason == null; // src: vulnhunter-fix/references/result-schema.json:60
        }
        // invoked but no tier: failure_reason must be a non-empty string
        return !θ["p.tier_judgment.failure_reason_iff_null_tier"] || (t.failure_reason != null && !t.failure_reason.isEmpty()); // src: vulnhunter-fix/references/result-schema.json:69
    }

    boolean isSuccessStatus(WorkerStatus s) {
        // bare VERIFIED and all VERIFIED_* forms are success; tier disclosed via completeness_tier
        return s.name().startsWith("VERIFIED");                                      // src: vulnhunter-fix/references/result-schema.json:28
    }
}
