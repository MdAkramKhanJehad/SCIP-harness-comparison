# vvaharness/report/cwe.py

CWE identifier to canonical MITRE name for report labels, and a deterministic vulnerability-class to CWE fallback so a report CWE never comes from model text when the class is known and the CWE is missing.

Source: `vvaharness/report/cwe.py` (lines 1-179)
Executor: code
Called from: `vvaharness/pipeline/stages/s8/validate.py`, `vvaharness/pipeline/stages/s9/typed_sarif.py`, `vvaharness/remediation_agent/render.py`, `vvaharness/models/scan/_finding_section.py`, `vvaharness/plugins/semgrep/findings.py`

// src: vvaharness/report/cwe.py:18-138
// "Names verbatim from MITRE; NEVER add a View or Category id"
// abstracted: CWE_NAMES maps 118 CWE ids (CWE-20 ... CWE-1391) to their MITRE names; pure display labels, no gate reads them.
CWE_NAMES = { "CWE-20": "Improper Input Validation", ..., "CWE-1391": "Use of Weak Credentials" }

// src: vvaharness/report/cwe.py:141-145
fn cwe_name(cwe_id):executor=code {
  if (!cwe_id) return ""
  return CWE_NAMES[uppercase(trim(cwe_id))] or, when absent, ""   // unknown -> "" so callers fall back to the bare id
}

// src: vvaharness/report/cwe.py:148-162
VULNCLASS_CWE = {
  "use-after-free": "CWE-416", "heap-overflow": "CWE-122", "stack-overflow": "CWE-121",
  "format-string": "CWE-134", "integer-overflow": "CWE-190", "type-confusion": "CWE-843",
  "race-condition": "CWE-362", "injection": "CWE-74", "unsafe-deserialization": "CWE-502",
  "logic-flaw": "CWE-841", "info-leak": "CWE-200", "other": ""   // other: no CWE
}

// src: vvaharness/report/cwe.py:165-171
fn cwe_for(cwe_id, vuln_class):executor=code {
  if (cwe_id) return uppercase(trim(cwe_id))   // an explicit CWE always wins
  fb = VULNCLASS_CWE[vuln_class.value or string(vuln_class)] or, when absent, ""
  return fb or null
}

// src: vvaharness/report/cwe.py:174-179
fn cwe_label(cwe_id):executor=code {
  if (!cwe_id) return ""
  name = cwe_name(cwe_id)
  return if (name) "$cwe_id - $name" else cwe_id
}
