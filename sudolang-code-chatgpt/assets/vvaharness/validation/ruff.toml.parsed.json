{
  "line-length": 100,
  "target-version": "py311",
  "lint": {
    "select": [
      "E",
      "W",
      "F",
      "I",
      "N",
      "UP",
      "B",
      "SIM",
      "RET",
      "TRY",
      "C90",
      "PLR",
      "ANN",
      "D",
      "PTH",
      "RUF",
      "ARG",
      "C4",
      "PERF",
      "PIE",
      "DTZ",
      "ISC",
      "A",
      "S"
    ],
    "ignore": [
      "TRY003",
      "D203",
      "D213",
      "ANN401"
    ],
    "extend-select": [
      "TRY201",
      "TRY300",
      "TRY301",
      "TRY400",
      "SIM910"
    ],
    "per-file-ignores": {
      "scoring/*": [
        "S",
        "S603",
        "S607"
      ],
      "__init__.py": [
        "D104",
        "F401"
      ],
      "**/tools/deep_tools.py": [
        "N802"
      ],
      "io/__init__.py": [
        "A005",
        "D104",
        "F401"
      ],
      "**/test_*.py": [
        "S101",
        "ANN",
        "D",
        "PLR2004"
      ],
      "tests/*.py": [
        "S101",
        "ANN",
        "D",
        "PLR2004"
      ]
    },
    "mccabe": {
      "max-complexity": 6
    },
    "pylint": {
      "max-args": 5,
      "max-branches": 4,
      "max-returns": 3,
      "max-statements": 30
    },
    "pydocstyle": {
      "convention": "google"
    },
    "isort": {
      "known-first-party": [
        "vvaharness"
      ]
    }
  },
  "format": {
    "quote-style": "double"
  }
}
