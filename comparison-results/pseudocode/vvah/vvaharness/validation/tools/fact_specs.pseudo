// file: vvaharness/validation/tools/fact_specs.py
// S11's five fact tools as backend-neutral FactToolSpecs (served to the Claude harness as mcp__facts__*);
// descriptions duplicate deep_tools.

@executedBy(CODE) @role(tool) @stage("S11")
class FactSpecs {

    List<FactToolSpec> buildValidationFactSpecs(Path workspace) {
        return List.of(
            new FactToolSpec("DiffTouched", "Return whether file_path is in diff.patch and its changed line ranges.", "file_path", fp -> DiffFacts.diffTouched(workspace, fp)), // src: vvaharness/validation/tools/fact_specs.py:55
            new FactToolSpec("ChangedLines", "Return added line ranges for file_path from diff.patch.", "file_path", fp -> DiffFacts.changedLines(workspace, fp)), // src: vvaharness/validation/tools/fact_specs.py:62
            new FactToolSpec("DiffImpactMap", "Return files changed by diff.patch and whether a trust boundary was touched.", "no args", () -> impact(workspace)), // src: vvaharness/validation/tools/fact_specs.py:68
            new FactToolSpec("PatternScan", "Return bounded, secret-free match metadata and a scan summary. Builtin sets: secret_exposure, insecure_value.", "pattern_set", ps -> PatternScanner.patternScan(workspace, ps)), // src: vvaharness/validation/tools/fact_specs.py:75
            new FactToolSpec("TestInventory", "Inventory test files and detect negative/adversarial test markers.", "no args", () -> ToolsTestInventory.testInventory(workspace))); // src: vvaharness/validation/tools/fact_specs.py:84
    }

    Map impact(Path workspace) {
        DiffImpactMap m = DiffFacts.buildDiffImpactMap(workspace);                                   // src: vvaharness/validation/tools/fact_specs.py:96
        return Map.of("files_changed", m.filesChanged, "trust_boundary_touched", m.trustBoundaryTouched); // src: vvaharness/validation/tools/fact_specs.py:97
    }
}
