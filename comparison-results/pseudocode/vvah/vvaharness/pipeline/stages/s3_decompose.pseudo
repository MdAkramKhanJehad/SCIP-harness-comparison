// file: vvaharness/pipeline/stages/s3_decompose.py
// S3: builds the risk-ranked TaskManifest deterministically from S2's ThreatModel, one InvestigationUnit per threat.
// No model call; no catch-all unit for files no threat named (they are reported as unreachable).

@executedBy(CODE) @role(stage) @stage("S3")
class S3Decompose {

    Map<String, Integer> IMPACT_ORDINAL = Map.of("low", 1, "medium", 2, "high", 3, "critical", 4, "existential", 5);          // src: vvaharness/pipeline/stages/s3_decompose.py:35
    Map<String, Integer> LIKELIHOOD_ORDINAL = Map.of("very_rare", 1, "rare", 2, "possible", 3, "likely", 4, "almost_certain", 5); // src: vvaharness/pipeline/stages/s3_decompose.py:36
    int MAX_RISK_SCORE = 25;                                                                   // src: vvaharness/pipeline/stages/s3_decompose.py:41

    TaskManifest run(ContextPackage ctx, Config cfg, Theta θ) {
        TaskManifest manifest = new TaskManifest();                                            // src: vvaharness/pipeline/stages/s3_decompose.py:47
        int nThreat = investigationUnits(manifest, ctx, θ);                                    // src: vvaharness/pipeline/stages/s3_decompose.py:49
        for (InvestigationUnit u : manifest.units) u.languages = LangDetect.detectLanguages(u.files); // src: vvaharness/pipeline/stages/s3_decompose.py:53
        manifest.unreachableFiles = coverageReport(manifest, ctx);                             // src: vvaharness/pipeline/stages/s3_decompose.py:55
        return manifest;                                                                       // src: vvaharness/pipeline/stages/s3_decompose.py:71
    }

    /** 1 (most urgent) .. 25 from impact x likelihood; unknown values default to medium / possible. */
    int threatRiskRank(Threat t) {
        int score = IMPACT_ORDINAL.getOrDefault(t.impact, 2) * LIKELIHOOD_ORDINAL.getOrDefault(t.likelihood, 3); // src: vvaharness/pipeline/stages/s3_decompose.py:76
        return MAX_RISK_SCORE + 1 - score;                                                     // src: vvaharness/pipeline/stages/s3_decompose.py:78
    }

    /** One unit per threat, carrying that threat's whole validated surface uncut. */
    int investigationUnits(TaskManifest manifest, ContextPackage ctx, Theta θ) {
        Object rule = θ["code.s3.unit_rule"];                                                  // one unit per threat, ranked impact x likelihood  // src: vvaharness/pipeline/stages/s3_decompose.py:90
        ThreatModel tm = ctx.threatModel;
        if (tm == null || tm.threats.isEmpty()) return 0;                                      // src: vvaharness/pipeline/stages/s3_decompose.py:93
        Set<String> allFiles = Set.copyOf(ctx.allFiles);                                       // src: vvaharness/pipeline/stages/s3_decompose.py:96
        int added = 0;
        for (Threat t : tm.threats) {                                                          // src: vvaharness/pipeline/stages/s3_decompose.py:104
            List<String> files = distinct(t.surfaceFiles).filter(f -> allFiles.contains(f));  // src: vvaharness/pipeline/stages/s3_decompose.py:105
            if (files.isEmpty()) {                                                             // src: vvaharness/pipeline/stages/s3_decompose.py:106
                manifest.threatsWithoutUnit.add(t.id);                                         // never reviewed  // src: vvaharness/pipeline/stages/s3_decompose.py:107
                continue;
            }
            String cid = uniqueId(Work.threatUnitId(t.id), manifest);                          // src: vvaharness/pipeline/stages/s3_decompose.py:113
            List<Sink> sinks = ctx.unsafeSinks.filter(s -> files.contains(s.file));            // src: vvaharness/pipeline/stages/s3_decompose.py:122
            int loc = files.sum(f -> countLoc(f));                                             // src: vvaharness/pipeline/stages/s3_decompose.py:123
            manifest.units.add(new InvestigationUnit(cid, t, files, sinks,
                ctx.entryPoints.filter(e -> files.contains(e.file)),
                ctx.knownCves.filter(c -> c.affectedFiles.intersects(files)),
                sinks.flatMap(s -> s.cwe),
                threatRiskRank(t), sizeFor(loc, θ)));                                          // src: vvaharness/pipeline/stages/s3_decompose.py:125
            added++;
        }
        return added;                                                                          // src: vvaharness/pipeline/stages/s3_decompose.py:150
    }

    /** SMALL / MEDIUM / LARGE by LOC; LARGE units run alone in S4. */
    UnitSize sizeFor(int loc, Theta θ) {
        if (loc < θ["code.s3.small_unit_loc_max"]) return UnitSize.SMALL;                     // src: vvaharness/pipeline/stages/s3_decompose.py:154
        if (loc < θ["code.s3.medium_unit_loc_max"]) return UnitSize.MEDIUM;                   // src: vvaharness/pipeline/stages/s3_decompose.py:156
        return UnitSize.LARGE;                                                                 // src: vvaharness/pipeline/stages/s3_decompose.py:158
    }

    /** Files named by no unit; reported, never scanned. */
    List<String> coverageReport(TaskManifest manifest, ContextPackage ctx) {
        Set<String> covered = manifest.units.flatMap(u -> u.files);                            // src: vvaharness/pipeline/stages/s3_decompose.py:164
        return sorted(Set.copyOf(ctx.allFiles).minus(covered));                                // src: vvaharness/pipeline/stages/s3_decompose.py:166
    }
}
