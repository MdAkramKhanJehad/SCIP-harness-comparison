// file: vulnhunter-agent/agent/_github_verify.py
// GitHub REST + GraphQL surface for --mode=verify: read one issue, its edit history, comments and events,
// post a comment, reopen. Every fetch is bounded (CWE-400); one retry on 429/5xx with a fixed backoff.

@executedBy(CODE) @role(types) @stage("verify")
record GitHubVerifyError(String message) { }

@executedBy(CODE) @role(types) @stage("verify")
record IssueRef(String owner, String repo, int number, String kind) { }   // kind: "issue" | "pull", default "issue"

@executedBy(CODE) @role(types) @stage("verify")
record FetchedIssue(int number, String state, String stateReason, String title, String body, String closedAt, String htmlUrl) { }

@executedBy(CODE) @role(types) @stage("verify")
record IssueComment(int id, String author, String createdAt, String body) { }

@executedBy(CODE) @role(types) @stage("verify")
record IssueEvent(String event, String actor, String createdAt, String commitId) { }

@executedBy(CODE) @role(types) @stage("verify")
record UserContentEdit(String editedAt, String editor, String diff) { }

@executedBy(CODE) @role(io) @stage("verify")
class GithubVerify {

    Map headers(String token) {
        return Map.of("Authorization", "Bearer " + token, "Accept", "application/vnd.github+json", "X-GitHub-Api-Version", "2022-11-28"); // src: vulnhunter-agent/agent/_github_verify.py:116
    }

    // parse_issue_url: web UI, api.github.com/repos/..., GHE /api/vN/repos/...; /pull and /pulls are issue aliases.
    IssueRef parseIssueUrl(String url) {
        Url parsed = urlparse(url);
        if (parsed.scheme != "http" && parsed.scheme != "https") throw new GitHubVerifyError("Issue URL must be http(s)"); // src: vulnhunter-agent/agent/_github_verify.py:148
        List<String> parts = parsed.path.split("/").filter(p -> p != "");                        // src: vulnhunter-agent/agent/_github_verify.py:150
        if (parts.size() >= 2 && parts[0] == "api" && parts[1].matches("v[0-9]+")) parts = parts.drop(2); // strip /api/vN // src: vulnhunter-agent/agent/_github_verify.py:156
        if (!parts.isEmpty() && parts[0] == "repos") parts = parts.drop(1);                       // src: vulnhunter-agent/agent/_github_verify.py:164
        if (parts.size() < 4 || !List.of("issues", "pull", "pulls").contains(parts[2])) throw new GitHubVerifyError("Issue URL must be .../owner/repo/issues/n"); // src: vulnhunter-agent/agent/_github_verify.py:169
        int n;
        try {
            n = Integer.parseInt(parts[3]);                                                       // src: vulnhunter-agent/agent/_github_verify.py:176
        } catch (ValueError e) {
            throw new GitHubVerifyError("Issue number must be an integer");                       // src: vulnhunter-agent/agent/_github_verify.py:178
        }
        if (n <= 0) throw new GitHubVerifyError("Issue number must be positive");                 // src: vulnhunter-agent/agent/_github_verify.py:179
        String kind = (parts[2] == "pull" || parts[2] == "pulls") ? "pull" : "issue";             // src: vulnhunter-agent/agent/_github_verify.py:181
        return new IssueRef(parts[0], parts[1], n, kind);                                         // src: vulnhunter-agent/agent/_github_verify.py:182
    }

    String issueHost(String url) {
        String host = urlparse(url).hostname;                                                     // src: vulnhunter-agent/agent/_github_verify.py:188
        if (host == null || host.isEmpty()) throw new GitHubVerifyError("Cannot resolve host from URL"); // src: vulnhunter-agent/agent/_github_verify.py:189
        return host;
    }

    // _request_with_retry: one retry on transport error or 429/5xx; anything else fails fast.
    Response requestWithRetry(HttpClient client, String method, String url, Map json, Map params, List<Integer> expectedCodes, String context, Theta θ) {
        int attempts = 0;
        while (true) {
            attempts += 1;                                                                        // src: vulnhunter-agent/agent/_github_verify.py:207
            Response resp;
            try {
                resp = client.request(method, url, json, params);                                 // src: vulnhunter-agent/agent/_github_verify.py:209
            } catch (HTTPError exc) {
                if (attempts > θ["code.agent.github_verify.max_retries"]) throw new GitHubVerifyError(context + " failed after retry"); // src: vulnhunter-agent/agent/_github_verify.py:211
                sleep(θ["code.agent.github_verify.retry_backoff_seconds"]);                     // src: vulnhunter-agent/agent/_github_verify.py:218
                continue;
            }
            if (expectedCodes.contains(resp.statusCode)) return resp;                             // src: vulnhunter-agent/agent/_github_verify.py:220
            boolean retryable = resp.statusCode == 429 || resp.statusCode >= 500;                 // src: vulnhunter-agent/agent/_github_verify.py:222
            if (retryable && attempts <= θ["code.agent.github_verify.max_retries"]) {            // src: vulnhunter-agent/agent/_github_verify.py:223
                sleep(θ["code.agent.github_verify.retry_backoff_seconds"]);                     // src: vulnhunter-agent/agent/_github_verify.py:230
                continue;
            }
            throw new GitHubVerifyError(context + " failed: HTTP " + resp.statusCode);            // body truncated to 500 chars in the message // src: vulnhunter-agent/agent/_github_verify.py:232
        }
    }

    FetchedIssue getIssue(HttpClient client, String host, IssueRef ref, Theta θ) {
        String url = Github.apiBase(host) + "/repos/" + ref.owner + "/" + ref.repo + "/issues/" + ref.number; // src: vulnhunter-agent/agent/_github_verify.py:246
        Response resp = requestWithRetry(client, "GET", url, null, null, List.of(200), "GET issue", θ); // src: vulnhunter-agent/agent/_github_verify.py:247
        Map d = resp.json();
        return new FetchedIssue(d.number, d.state, d.state_reason or "", d.title, d.body or "", d.closed_at or "", d.html_url); // src: vulnhunter-agent/agent/_github_verify.py:254
    }

    // list_comments: stop following Link rel=next at the page cap or the cumulative body-byte budget.
    List<IssueComment> listComments(HttpClient client, String host, IssueRef ref, Theta θ) {
        int maxPages = θ["verify.*"].maxCommentPages;                                             // default _MAX_COMMENT_PAGES = 20 // src: vulnhunter-agent/agent/_github_verify.py:38
        int maxTotalBytes = θ["verify.*"].maxTimelineBytes;                                       // default _MAX_TIMELINE_BYTES = 5 MB // src: vulnhunter-agent/agent/_github_verify.py:39
        List<IssueComment> out = new List();
        String url = Github.apiBase(host) + "/repos/" + ref.owner + "/" + ref.repo + "/issues/" + ref.number + "/comments"; // src: vulnhunter-agent/agent/_github_verify.py:285
        Map params = Map.of("per_page", θ["code.agent.github_verify.per_page"]);                 // src: vulnhunter-agent/agent/_github_verify.py:287
        int pages = 0; int totalBytes = 0;
        while (url != null) {                                                                     // src: vulnhunter-agent/agent/_github_verify.py:290
            Response resp = requestWithRetry(client, "GET", url, null, params, List.of(200), "GET comments", θ); // src: vulnhunter-agent/agent/_github_verify.py:291
            for (Map item : resp.json()) {
                String body = item.body or "";
                totalBytes += body.utf8Length();                                                  // src: vulnhunter-agent/agent/_github_verify.py:300
                out.add(new IssueComment(item.id, item.user.login, item.created_at, body));        // src: vulnhunter-agent/agent/_github_verify.py:301
            }
            pages += 1;
            String nextUrl = nextLink(resp.headers.get("link"));                                  // src: vulnhunter-agent/agent/_github_verify.py:312
            if (nextUrl != null && pages >= maxPages) break;                                      // page cap; warn // src: vulnhunter-agent/agent/_github_verify.py:313
            if (nextUrl != null && totalBytes >= maxTotalBytes) break;                            // byte budget; warn // src: vulnhunter-agent/agent/_github_verify.py:321
            url = nextUrl; params = null;                                                         // src: vulnhunter-agent/agent/_github_verify.py:329
        }
        return out;
    }

    List<IssueEvent> listEvents(HttpClient client, String host, IssueRef ref, Theta θ) {
        int maxPages = θ["verify.*"].maxEventPages;                                               // default _MAX_EVENT_PAGES = 20 // src: vulnhunter-agent/agent/_github_verify.py:40
        List<IssueEvent> out = new List();
        String url = Github.apiBase(host) + "/repos/" + ref.owner + "/" + ref.repo + "/issues/" + ref.number + "/events"; // src: vulnhunter-agent/agent/_github_verify.py:348
        Map params = Map.of("per_page", θ["code.agent.github_verify.per_page"]);                 // src: vulnhunter-agent/agent/_github_verify.py:350
        int pages = 0;
        while (url != null) {
            Response resp = requestWithRetry(client, "GET", url, null, params, List.of(200), "GET events", θ); // src: vulnhunter-agent/agent/_github_verify.py:353
            for (Map item : resp.json()) out.add(new IssueEvent(item.event, item.actor.login, item.created_at, item.commit_id or "")); // src: vulnhunter-agent/agent/_github_verify.py:361
            pages += 1;
            String nextUrl = nextLink(resp.headers.get("link"));                                  // src: vulnhunter-agent/agent/_github_verify.py:371
            if (nextUrl != null && pages >= maxPages) break;                                      // src: vulnhunter-agent/agent/_github_verify.py:372
            url = nextUrl; params = null;                                                         // src: vulnhunter-agent/agent/_github_verify.py:380
        }
        return out;
    }

    String nextLink(String linkHeader) {
        if (linkHeader == null || linkHeader.isEmpty()) return null;                              // src: vulnhunter-agent/agent/_github_verify.py:386
        for (String piece : linkHeader.split(",")) {
            piece = piece.strip();
            if (!piece.contains("rel=\"next\"")) continue;                                        // src: vulnhunter-agent/agent/_github_verify.py:390
            if (piece.contains("<") && piece.contains(">")) return piece.between("<", ">");       // src: vulnhunter-agent/agent/_github_verify.py:393
        }
        return null;
    }

    // list_user_content_edits: GraphQL userContentEdits(first: N); resolver issue vs pullRequest by ref.kind.
    List<UserContentEdit> listUserContentEdits(HttpClient client, String host, IssueRef ref, Theta θ) {
        int maxDiffBytes = θ["verify.*"].maxEditDiffBytes;                                        // default _MAX_EDIT_DIFF_BYTES = 200 KB // src: vulnhunter-agent/agent/_github_verify.py:41
        int maxTotalBytes = θ["verify.*"].maxEditTotalBytes;                                      // default _MAX_EDIT_TOTAL_BYTES = 5 MB // src: vulnhunter-agent/agent/_github_verify.py:42
        String graphqlUrl = Github.apiBase(host) + "/graphql";                                    // src: vulnhunter-agent/agent/_github_verify.py:460
        String resolverField = (ref.kind == "pull") ? "pullRequest" : "issue";                    // src: vulnhunter-agent/agent/_github_verify.py:461
        int firstN = θ["code.agent.github_verify.edit_history_first_n"];                         // userContentEdits(first: 100) // src: vulnhunter-agent/agent/_github_verify.py:410
        String query = "repository(owner, name)." + resolverField + "(number).userContentEdits(first: " + firstN + ").nodes(editedAt, editor.login, diff)"; // src: vulnhunter-agent/agent/_github_verify.py:406
        Response resp = requestWithRetry(client, "POST", graphqlUrl, Map.of("query", query, "variables", Map.of("owner", ref.owner, "name", ref.repo, "number", ref.number)), null, List.of(200), "GraphQL userContentEdits", θ); // src: vulnhunter-agent/agent/_github_verify.py:475
        Map data = resp.json();
        if (data.containsKey("errors") && data.errors) throw new GitHubVerifyError("GraphQL userContentEdits returned errors"); // src: vulnhunter-agent/agent/_github_verify.py:483
        List<Map> nodes;
        try {
            nodes = data.data.repository.get(resolverField).userContentEdits.nodes;               // src: vulnhunter-agent/agent/_github_verify.py:488
        } catch (KeyError e) {
            throw new GitHubVerifyError("GraphQL userContentEdits response missing expected fields"); // src: vulnhunter-agent/agent/_github_verify.py:492
        }
        List<UserContentEdit> out = new List();
        int totalBytes = 0;
        for (Map node : nodes) {
            Object diff = node.get("diff");
            if (diff == null) continue;                                                           // attribute-only edit // src: vulnhunter-agent/agent/_github_verify.py:503
            byte[] encoded = str(diff).utf8();
            if (encoded.length > maxDiffBytes) {                                                  // src: vulnhunter-agent/agent/_github_verify.py:510
                String marker = "\n[...diff truncated by verify: exceeded per-edit size cap...]";  // src: vulnhunter-agent/agent/_github_verify.py:511
                int keep = max(0, maxDiffBytes - marker.utf8Length());                            // src: vulnhunter-agent/agent/_github_verify.py:512
                diff = encoded.take(keep).decodeIgnore() + marker;                                // src: vulnhunter-agent/agent/_github_verify.py:513
            }
            totalBytes += str(diff).utf8Length();                                                 // src: vulnhunter-agent/agent/_github_verify.py:522
            if (totalBytes > maxTotalBytes) break;                                                // remaining edits ignored // src: vulnhunter-agent/agent/_github_verify.py:523
            out.add(new UserContentEdit(node.editedAt, node.editor.login or "", diff));           // src: vulnhunter-agent/agent/_github_verify.py:533
        }
        return out;
    }

    String postComment(HttpClient client, String host, IssueRef ref, String body, Theta θ) {
        String url = Github.apiBase(host) + "/repos/" + ref.owner + "/" + ref.repo + "/issues/" + ref.number + "/comments"; // src: vulnhunter-agent/agent/_github_verify.py:554
        Response resp = requestWithRetry(client, "POST", url, Map.of("body", body), null, List.of(201), "POST comment", θ); // src: vulnhunter-agent/agent/_github_verify.py:556
        return resp.json().html_url;                                                              // src: vulnhunter-agent/agent/_github_verify.py:565
    }

    void reopenIssue(HttpClient client, String host, IssueRef ref, Theta θ) {
        String url = Github.apiBase(host) + "/repos/" + ref.owner + "/" + ref.repo + "/issues/" + ref.number; // src: vulnhunter-agent/agent/_github_verify.py:578
        requestWithRetry(client, "PATCH", url, Map.of("state", "open", "state_reason", "reopened"), null, List.of(200), "PATCH (reopen)", θ); // idempotent // src: vulnhunter-agent/agent/_github_verify.py:579
    }

    HttpClient makeClient(String token, boolean verifySsl, Theta θ) {
        return new HttpClient(verifySsl, θ["code.agent.github_verify.http_timeout_seconds"], headers(token)); // src: vulnhunter-agent/agent/_github_verify.py:591
    }
}
