    String agentic(Prompt userPrompt, String model, Prompt systemPrompt, List<String> allowedTools, Path cwd, Double maxBudgetUsd, String permissionMode, Integer maxTurns, Integer timeout, String tag, List<Map> extraTools, Function extraDispatch, Schema responseModel, Integer maxOutputTokens, Supplier<String> submitGuard, Supplier<Set<String>> exhaustedTools, String effort, Theta θ) {
