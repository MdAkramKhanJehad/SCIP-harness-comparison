# vvaharness/backends/harness/deepagents/force_verdict_only.py

`ForceVerdictOnly`, a deepagents middleware that keeps tool choice on "auto" while the session works, and forces the structured-output (outcome) tool only on the call that ends the session. When the model stops without calling a tool, the middleware re-issues the call with all regular tools withdrawn and a "report now" message. A model that rejects forced tool choice with a 400 is learned as unsupported and its outcome call is re-issued on auto in the same session.

Source: `vvaharness/backends/harness/deepagents/force_verdict_only.py` (lines 1-180)
Executor: code (it shapes the model calls)
Called from: `vvaharness/backends/harness/deepagents/options/streaming.sudo` (appended when options.force_verdict_only); `vvaharness/backends/harness/deepagents/options/subagents.sudo` (per subagent when options.force_verdict_only)

// src: vvaharness/backends/harness/deepagents/force_verdict_only.py:44-45
FORCED_VERDICT_COUNTER = "deepagents_verdict_forced_after_auto"   // bumped once per session end turned into a forced outcome call

// src: vvaharness/backends/harness/deepagents/force_verdict_only.py:48-54
// prompt-src: vvaharness/backends/harness/deepagents/force_verdict_only.py:50-54
ReportNowMessage {
  // HumanMessage appended after the model's tool-less reply; $names = outcome tool names in backticks joined by " or ", or "the outcome tool"
  Constraints {
    "You have finished working. Report your outcome NOW by calling $names with the conclusion you just reached. Every other tool has been withdrawn."
  }
}

// src: vvaharness/backends/harness/deepagents/force_verdict_only.py:62-68
fn _reply(result):executor=code {
  // The last message of the handler result if it is an AI message, else null
}

// src: vvaharness/backends/harness/deepagents/force_verdict_only.py:71-180
ForceVerdictOnly {
  // Note in source (78): the forced outcome call is one extra model call an outer ModelCallBudget does not count
  State {
    _auto = {}   // one copy per model object, with force_tool_choice=false; guarded by a lock
  }

  // src: force_verdict_only.py:94-99
  fn _applies(request):executor=code {
    return request.response_format is a ToolStrategy && request.model.force_tool_choice == true
  }

  // src: force_verdict_only.py:105-110
  fn _learn_rejection(request, exc):executor=code {
    if (!tool_choice_rejection.is_tool_choice_unsupported_rejection(exc)) return false
    tool_choice_rejection.learn_tool_choice_unsupported(request.model.model)
    return true
  }

  // src: force_verdict_only.py:112-120
  fn _forced(request, reply):executor=code {
    names = schema spec names of request.response_format
    COUNTERS.bump(FORCED_VERDICT_COUNTER)
    return request with tools = [], messages = [...request.messages, reply, ReportNowMessage(names)]
    // tools=[] leaves only the outcome tool, which langchain forces
  }

  // src: force_verdict_only.py:122-133 (async twin 135-147 identical)
  fn _force(request, handler):executor=code {
    if (request.model.model in tool_choice_rejection.UNSUPPORTED_MODELS) return handler(request on the auto copy)
    try return handler(request);   // forced tool choice
    catch exc => {
      if (!_learn_rejection(request, exc)) throw exc
    }
    return handler(request on the auto copy)   // one re-issue on auto, same session
  }

  // src: force_verdict_only.py:149-164 (async twin 166-180 identical)
  fn wrap_model_call(request, handler):executor=mixed {
    if (!_applies(request)) return handler(request)
    if (request.tools is non-empty) {
      result = handler(request on the auto copy)   // the working turn, tool choice auto
      reply = _reply(result)
      if (reply == null || reply.tool_calls) return result   // still working, or already called a tool
      request = _forced(request, reply)
    }
    // No regular tools: already outcome-only (ModelCallBudget's final turn), forced as it is
    return _force(request, handler)
  }
}
