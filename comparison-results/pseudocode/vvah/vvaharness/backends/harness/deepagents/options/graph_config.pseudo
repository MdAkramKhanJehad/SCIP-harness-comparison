// file: vvaharness/backends/harness/deepagents/options/graph_config.py
// LangGraph invoke-config construction: a fresh random thread id and, when max_turns is set, a recursion limit
// of max_turns + buffer (LangGraph counts supersteps, not turns).

@executedBy(CODE) @role(config)
class GraphConfig {
    GraphInvokeConfig makeConfig(Object options, int buffer) {
        GraphInvokeConfig config = new GraphInvokeConfig(new GraphConfigurable(randomHex(8)), null);     // src: vvaharness/backends/harness/deepagents/options/graph_config.py:27
        if (options.maxTurns != null) config.recursionLimit = options.maxTurns + buffer;                 // src: vvaharness/backends/harness/deepagents/options/graph_config.py:29
        return config;
    }
}
