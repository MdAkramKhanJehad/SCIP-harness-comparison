// file: vvaharness/remediation_agent/interactive/render.py
// Menu rendering plus numbered-prompt selection parsing (1,3-5 | all | pending | q) for the interactive picker.

@executedBy(CODE) @role(io) @stage("S10")
class InteractiveRender {

    List<String> renderRows(List<RemediationTarget> findings, Integer cursor) {
        List<String> rows = new List();
        for (int i = 0; i < findings.size(); i++) {                                                 // src: vvaharness/remediation_agent/interactive/render.py:27
            RemediationTarget f = findings.get(i);
            String mark = f.done ? "done-mark" : "  ";                                              // src: vvaharness/remediation_agent/interactive/render.py:28
            String line = f.index + "  " + mark + "  [" + f.severity() + "] " + f.title();          // src: vvaharness/remediation_agent/interactive/render.py:29
            if (f.file() != null) line = line + "  (" + f.file() + ")";                             // src: vvaharness/remediation_agent/interactive/render.py:30
            if (cursor != null && i == cursor) {                                                    // src: vvaharness/remediation_agent/interactive/render.py:32
                line = "> " + line;                                                                 // src: vvaharness/remediation_agent/interactive/render.py:33  (inverse video)
            } else {
                line = "  " + line;                                                                 // src: vvaharness/remediation_agent/interactive/render.py:35
            }
            rows.add(line);
        }
        return rows;
    }

    void clearAndDraw(List<RemediationTarget> findings, int cursor) {
        int nDone = findings.count(f -> f.done);                                                    // src: vvaharness/remediation_agent/interactive/render.py:41
        Stderr.write("CLEAR+HOME");                                                                 // src: vvaharness/remediation_agent/interactive/render.py:42
        Stderr.write("Remediation Agent remediation - " + findings.size() + " issue(s), " + nDone + " done"); // src: vvaharness/remediation_agent/interactive/render.py:43
        for (String row : renderRows(findings, cursor)) Stderr.write(row);                          // src: vvaharness/remediation_agent/interactive/render.py:46
    }

    List<Integer> parseSelection(String text, List<RemediationTarget> findings) {
        String t = (text != null ? text : "").strip().lower();                                      // src: vvaharness/remediation_agent/interactive/render.py:53
        if (List.of("q", "quit", "exit", "").contains(t)) return null;                              // src: vvaharness/remediation_agent/interactive/render.py:54
        if (t.equals("all")) return Range.of(0, findings.size());                                   // src: vvaharness/remediation_agent/interactive/render.py:56
        if (t.equals("pending")) return Range.of(0, findings.size()).filter(i -> !findings.get(i).done); // src: vvaharness/remediation_agent/interactive/render.py:58
        Map<Integer, Integer> byIndex = findings.toMap(f -> f.index, position);                     // src: vvaharness/remediation_agent/interactive/render.py:61
        List<Integer> chosen = new List();
        for (String tok : Regex.split("[,\\s]+", t)) {                                              // src: vvaharness/remediation_agent/interactive/render.py:63
            if (tok.isEmpty()) continue;
            if (tok.contains("-")) {                                                                // src: vvaharness/remediation_agent/interactive/render.py:66
                int lo;
                int hi;
                try {
                    lo = Integer.parse(tok.before("-"));                                            // src: vvaharness/remediation_agent/interactive/render.py:69
                    hi = Integer.parse(tok.after("-"));
                } catch (ValueError e) {
                    continue;                                                                       // src: vvaharness/remediation_agent/interactive/render.py:71
                }
                for (int idx = lo; idx <= hi; idx++) {                                              // src: vvaharness/remediation_agent/interactive/render.py:72
                    if (byIndex.containsKey(idx) && !chosen.contains(byIndex.get(idx))) chosen.add(byIndex.get(idx)); // src: vvaharness/remediation_agent/interactive/render.py:73
                }
            } else {
                int idx;
                try {
                    idx = Integer.parse(tok);                                                       // src: vvaharness/remediation_agent/interactive/render.py:77
                } catch (ValueError e) {
                    continue;                                                                       // src: vvaharness/remediation_agent/interactive/render.py:79
                }
                if (byIndex.containsKey(idx) && !chosen.contains(byIndex.get(idx))) chosen.add(byIndex.get(idx)); // src: vvaharness/remediation_agent/interactive/render.py:80
            }
        }
        return chosen;                                                                              // src: vvaharness/remediation_agent/interactive/render.py:82
    }
}
