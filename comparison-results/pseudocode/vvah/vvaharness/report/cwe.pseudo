// file: vvaharness/report/cwe.py
// Report-side CWE helpers: CWE id -> canonical MITRE name (unknown -> ""), the VulnClass -> CWE fallback
// used when a finding has no CWE, and the "CWE-NNN - Name" label renderers print.

@executedBy(CODE) @role(rule_set) @stage("S8")
class Cwe {

    // CWE_NAMES: about 120 MITRE weakness names verbatim (no View or Category ids)                   // src: vvaharness/report/cwe.py:19
    Map<String, String> CWE_NAMES = Map.of("CWE-20", "Improper Input Validation", "CWE-22", "Path Traversal", "...", "..."); // src: vvaharness/report/cwe.py:19

    /** MITRE name for CWE-NNN, or "" if unknown or null. */
    String cweName(String cweId) {
        if (cweId == null || cweId.isEmpty()) return "";                                               // src: vvaharness/report/cwe.py:143
        return CWE_NAMES.getOrDefault(cweId.upper().strip(), "");                                      // src: vvaharness/report/cwe.py:145
    }

    /** cwe_id if set, else the deterministic VulnClass fallback, else null. */
    String cweFor(String cweId, VulnClass vulnClass, Theta θ) {
        if (cweId != null && !cweId.isEmpty()) return cweId.upper().strip();                          // src: vvaharness/report/cwe.py:167
        String key = vulnClass != null ? vulnClass.value : "";                                         // src: vvaharness/report/cwe.py:169
        String fb = θ["code.report.cwe.vulnclass_cwe_fallback"].getOrDefault(key, "");                // "other" -> no CWE // src: vvaharness/report/cwe.py:170
        return fb.isEmpty() ? null : fb;                                                               // src: vvaharness/report/cwe.py:171
    }

    /** "CWE-862 - Missing Authorization", or just the id when the name is unknown. */
    String cweLabel(String cweId) {
        if (cweId == null || cweId.isEmpty()) return "";                                               // src: vvaharness/report/cwe.py:177
        String name = cweName(cweId);                                                                  // src: vvaharness/report/cwe.py:178
        return name.isEmpty() ? cweId : cweId + " - " + name;                                          // src: vvaharness/report/cwe.py:179
    }
}
