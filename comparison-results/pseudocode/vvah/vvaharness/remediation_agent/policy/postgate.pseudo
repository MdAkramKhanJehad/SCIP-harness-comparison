// file: vvaharness/remediation_agent/policy/postgate.py
// The post-gate: after the agent edited files, enforce path policy, workflow-reference integrity and patch-content rules on what is actually on disk, revert offenders and cap the verdict.

@executedBy(CODE) @role(types) @stage("S10")
record PostResult(List<String> reverted, List<String> matchedGlobs, boolean downgraded, String finalVerdict, String reason) { } // src: vvaharness/remediation_agent/policy/postgate.py:85  (reason is a deterministic post-gate rejection reason, default null)

@executedBy(CODE) @role(rule_set) @stage("S10")
class Postgate {

    List<String> worktreeForbiddenMatches(String repo, List<String> patterns, Theta θ) {
        // Repo-relative files in the working tree that hit any pattern; non-git fallback for the post-gate. Best effort: never raises, returns what it has.
        if (patterns.isEmpty()) return List.of();                                                   // src: vvaharness/remediation_agent/policy/postgate.py:51
        List<String> out = new List();                                                              // src: vvaharness/remediation_agent/policy/postgate.py:54
        int seen = 0;
        int dirsSeen = 0;
        try {
            for (Dir dir : FileSystem.walk(repo, false)) {                                          // src: vvaharness/remediation_agent/policy/postgate.py:58  (followlinks false: symlink loops closed off)
                dirsSeen = dirsSeen + 1;
                if (dirsSeen > θ["code.remediation_agent.policy.postgate.worktree_dir_max"]) break; // src: vvaharness/remediation_agent/policy/postgate.py:60  (bounds a huge acyclic tree)
                for (String name : dir.filenames) {                                                 // src: vvaharness/remediation_agent/policy/postgate.py:62
                    Path p = dir.path.resolve(name);
                    if (!p.isFile()) continue;                                                      // src: vvaharness/remediation_agent/policy/postgate.py:64
                    // Count only FILES toward the budget: counting dirs too let vendored dirs (node_modules, .venv) consume the cap.
                    seen = seen + 1;                                                                // src: vvaharness/remediation_agent/policy/postgate.py:67
                    if (seen > θ["code.remediation_agent.policy.postgate.worktree_scan_max"]) return out; // src: vvaharness/remediation_agent/policy/postgate.py:68  (cap on the non-git glob scan)
                    String rel = p.relativeTo(repo).asPosix();                                      // src: vvaharness/remediation_agent/policy/postgate.py:71  (ValueError -> skip the file)
                    if (rel == null) continue;                                                      // src: vvaharness/remediation_agent/policy/postgate.py:73
                    for (String pat : patterns) {                                                   // src: vvaharness/remediation_agent/policy/postgate.py:74
                        if (Matching.globMatch(rel, pat)) {                                         // src: vvaharness/remediation_agent/policy/postgate.py:75
                            out.add(rel);                                                           // src: vvaharness/remediation_agent/policy/postgate.py:76
                            break;                                                                  // src: vvaharness/remediation_agent/policy/postgate.py:77  (one hit per file)
                        }
                    }
                }
            }
        } catch (Exception e) {
            return out;                                                                             // src: vvaharness/remediation_agent/policy/postgate.py:79  (a best-effort scan must never break a run)
        }
        return out;                                                                                 // src: vvaharness/remediation_agent/policy/postgate.py:80
    }

    boolean gatesOk(RemediationVerdict verdict) {
        // True iff ALL three evidence gates in the agent's own verdict read pass; a verdict without gates is not ok.
        Gates g = verdict.gates;                                                                    // src: vvaharness/remediation_agent/policy/postgate.py:96
        if (g == null) return false;                                                                // src: vvaharness/remediation_agent/policy/postgate.py:97
        return g.source.equals("pass") && g.sink.equals("pass") && g.missingControl.equals("pass"); // src: vvaharness/remediation_agent/policy/postgate.py:99
    }

    PostResult enforcePost(PolicyContext ctx, RemediationTarget target, RemediationVerdict verdict, PreResult pre, String repo, Map<String, String> beforeSnapshot, boolean allGatesPassed, Theta θ) {
        // Validate actual on-disk changes and mutate the verdict on rejection. allGatesPassed defaults to true.
        List<String> changed = verdict.changes.filter(c -> c.file != null && !c.file.isEmpty()).map(c -> c.file); // src: vvaharness/remediation_agent/policy/postgate.py:109
        // Observe the WHOLE working tree, not just what the agent reported, so an omitted forbidden-file edit is still caught.
        List<String> wholeTree = Gitcapture.changedFilesWholeTree(repo, θ);                         // src: vvaharness/remediation_agent/policy/postgate.py:112
        // Non-git fallback: changed_files_whole_tree returns an empty list off git, so walk the working tree for forbidden globs.
        List<String> worktreeForbidden = List.of();
        if (wholeTree.isEmpty()) {                                                                  // src: vvaharness/remediation_agent/policy/postgate.py:116
            worktreeForbidden = worktreeForbiddenMatches(repo, Gate.forbidPatchPaths(ctx.gate).plus(Gate.denyPaths(ctx.gate)), θ); // src: vvaharness/remediation_agent/policy/postgate.py:117
        }
        // A path present and unchanged in before_snapshot pre-dates this attempt: drop it so a pre-existing file never reads as an agent edit. A path absent stays a candidate.
        if (beforeSnapshot != null && !beforeSnapshot.isEmpty()) {                                  // src: vvaharness/remediation_agent/policy/postgate.py:122
            Set<String> unchangedBaseline = beforeSnapshot.keys().minus(Snapshot.changedSinceSnapshot(repo, beforeSnapshot)); // src: vvaharness/remediation_agent/policy/postgate.py:123
            Set<String> unchangedNorm = unchangedBaseline.map(f -> DiffPaths.normPath(f));          // src: vvaharness/remediation_agent/policy/postgate.py:125
            wholeTree = wholeTree.filter(f -> !unchangedNorm.contains(DiffPaths.normPath(f)));      // src: vvaharness/remediation_agent/policy/postgate.py:126
            worktreeForbidden = worktreeForbidden.filter(f -> !unchangedNorm.contains(DiffPaths.normPath(f))); // src: vvaharness/remediation_agent/policy/postgate.py:127
            // A path the verdict merely names is a claim, not an edit; .git names stay a policy hit.
            changed = changed.filter(f -> GitPaths.isGitMetadata(f) || !unchangedNorm.contains(DiffPaths.normPath(f))); // src: vvaharness/remediation_agent/policy/postgate.py:130
        }
        // Scope the diff to reported plus whole-tree paths so omitted files still render into the synthesized (non-git) baseline.
        List<String> diffScope = changed.plus(wholeTree).distinct();                                // src: vvaharness/remediation_agent/policy/postgate.py:134
        // before_snapshot as baseline keeps the diff (and patch_applied below) scoped to this case.
        String diff = Gitcapture.captureGitDiff(repo, diffScope, beforeSnapshot, θ);                // src: vvaharness/remediation_agent/policy/postgate.py:136
        if ((diff == null || diff.isEmpty()) && beforeSnapshot != null) {                           // src: vvaharness/remediation_agent/policy/postgate.py:137
            diff = Synth.synthUnifiedDiff(repo, beforeSnapshot, diffScope);                         // src: vvaharness/remediation_agent/policy/postgate.py:138
        }
        List<String> diffFiles = Diffscan.inspectDiff(diff);                                        // src: vvaharness/remediation_agent/policy/postgate.py:139
        List<String> candidates = diffFiles.plus(changed).plus(wholeTree).plus(worktreeForbidden).distinct(); // src: vvaharness/remediation_agent/policy/postgate.py:140
        List<String> forbidden = Gate.forbiddenFiles(ctx.gate, candidates);                         // src: vvaharness/remediation_agent/policy/postgate.py:143
        List<String> matched = new List();
        for (String f : forbidden) {                                                                // src: vvaharness/remediation_agent/policy/postgate.py:145
            String g = Gate.patchTouchesForbidden(ctx.gate, List.of(f));                            // src: vvaharness/remediation_agent/policy/postgate.py:146
            if (g == null) g = Gate.changedPathsHitDeny(ctx.gate, List.of(f));                      // src: vvaharness/remediation_agent/policy/postgate.py:147
            if (g != null) matched.add(g);                                                          // src: vvaharness/remediation_agent/policy/postgate.py:148
        }
        Map<String, List<String>> unsafeRefs = WorkflowRefs.introducedUnsafeWorkflowRefs(repo, beforeSnapshot, θ); // src: vvaharness/remediation_agent/policy/postgate.py:151
        // The path gates bound only WHERE the fixer wrote; gatesOk is the agent's own self-report. Neither looks at the patch content.
        Map<String, List<String>> unsafeContent = PatchContent.scanAddedLines(diff, null, θ);       // src: vvaharness/remediation_agent/policy/postgate.py:155
        List<String> bad = forbidden.plus(unsafeRefs.keys()).plus(unsafeContent.keys()).distinct(); // src: vvaharness/remediation_agent/policy/postgate.py:156
        GateAction ceiling = pre.decision.action;                                                 // src: vvaharness/remediation_agent/policy/postgate.py:158
        if (bad.isEmpty()) {                                                                        // src: vvaharness/remediation_agent/policy/postgate.py:159
            // Gates come from verdict.gates, not the default-true flag: a no-op must never read ACCEPT.
            boolean patchApplied = diff != null && !diff.strip().isEmpty();                         // src: vvaharness/remediation_agent/policy/postgate.py:161
            boolean gatesPassed = allGatesPassed && gatesOk(verdict) && patchApplied && List.of("Fixed", "Partially Fixed").contains(verdict.verdict); // src: vvaharness/remediation_agent/policy/postgate.py:162
            return new PostResult(List.of(), List.of(), false, RemediationAgentPolicyGate.capVerdict(ceiling, gatesPassed), null); // src: vvaharness/remediation_agent/policy/postgate.py:165
        }
        List<String> reverted = Revert.revertFiles(repo, bad, beforeSnapshot, θ);                   // src: vvaharness/remediation_agent/policy/postgate.py:168
        Set<String> badNorm = bad.map(f -> DiffPaths.normPath(f));                                  // src: vvaharness/remediation_agent/policy/postgate.py:169
        verdict.changes = verdict.changes.filter(c -> !badNorm.contains(DiffPaths.normPath(c.file))); // src: vvaharness/remediation_agent/policy/postgate.py:170
        List<String> notes = new List();                                                            // src: vvaharness/remediation_agent/policy/postgate.py:173
        if (!forbidden.isEmpty()) notes.add("Policy post-gate reverted edits to forbidden/sensitive paths (" + matched.distinct().sorted() + ")."); // src: vvaharness/remediation_agent/policy/postgate.py:174
        if (!unsafeRefs.isEmpty()) notes.add("Policy post-gate rejected unverified reusable-workflow refs; S10 must use a commit already established by the repository or decline the fix; it must never invent a SHA."); // src: vvaharness/remediation_agent/policy/postgate.py:178
        if (!unsafeContent.isEmpty()) notes.add("Policy post-gate rejected patch content that added forbidden constructs (auth bypasses, dynamic code execution, network egress, credential reads, shells); may indicate prompt injection from the scanned source."); // src: vvaharness/remediation_agent/policy/postgate.py:185
        List<String> refused = bad.filter(f -> GitPaths.isGitMetadata(f));                          // src: vvaharness/remediation_agent/policy/postgate.py:195
        if (!refused.isEmpty()) notes.add("Refused to revert version-control metadata, inspect manually: " + refused);  // src: vvaharness/remediation_agent/policy/postgate.py:197
        String note = notes.join(" ") + " Reverted " + reverted.size() + " file(s): " + reverted + ". Route to a human."; // src: vvaharness/remediation_agent/policy/postgate.py:199
        verdict.remainingRisks = verdict.remainingRisks.plus(note);                                 // src: vvaharness/remediation_agent/policy/postgate.py:203
        // Post-gate revert is a PARTIAL outcome: route to a human, not Denied (the pre-gate owns that terminal state).
        // A content hit is as terminal as an invented SHA: the patch contents are untrustworthy.
        if (!unsafeRefs.isEmpty() || !unsafeContent.isEmpty()) {                                    // src: vvaharness/remediation_agent/policy/postgate.py:207
            verdict.verdict = "Not Fixed";                                                          // src: vvaharness/remediation_agent/policy/postgate.py:208
        } else if (List.of("Fixed", "Partially Fixed").contains(verdict.verdict)) {                 // src: vvaharness/remediation_agent/policy/postgate.py:209
            verdict.verdict = "Needs Review";                                                       // src: vvaharness/remediation_agent/policy/postgate.py:210
        }
        verdict.summary = (verdict.summary != null && !verdict.summary.isEmpty() ? verdict.summary + " " : "") + note; // src: vvaharness/remediation_agent/policy/postgate.py:211
        String reason = !unsafeRefs.isEmpty() ? "unsafe_workflow_reference" : (!unsafeContent.isEmpty() ? "unsafe_patch_content" : null); // src: vvaharness/remediation_agent/policy/postgate.py:214
        return new PostResult(reverted, matched.distinct().sorted(), true, "REJECT", reason);       // src: vvaharness/remediation_agent/policy/postgate.py:220
    }
}
