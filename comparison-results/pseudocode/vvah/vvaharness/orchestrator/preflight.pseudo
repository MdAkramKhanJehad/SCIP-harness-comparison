    /** Round-trip ONE synthetic tool call through the in-process CLI MCP bridge, bounded on a daemon thread. */
    @src("vvaharness/orchestrator/preflight.py:620")
    String probeAgenticViaCliBridge(Prompt prompt, String nonce, String model, List<String> allowedTools, Path cwd, Theta θ) {
        // public agentic_with_tools only; it takes no timeout, so it is bounded on a thread we cannot kill
        Future<String> future = ReplayStage.startDaemon(() -> CliMcp.agenticWithTools("Call the PreflightProbeEcho tool with the nonce, then reply with exactly what it returns and nothing else.", model, null, allowedTools, cwd, (o, t) -> toolBuilder(o, t), List.of("PreflightProbeEcho"), θ["code.orchestrator.preflight.probe_roundtrip_turns"], "preflight-agentic"), "preflight-bridge-probe"); // src: vvaharness/orchestrator/preflight.py:649
        try {
            return future.result(θ["code.orchestrator.preflight.probe_agentic_timeout_s"]);                 // src: vvaharness/orchestrator/preflight.py:651
        } catch (TimeoutError exc) {
            // a done future raised its own TimeoutError (not the futures one) or just finished: hand it back unchanged; only a pending one timed out
            if (future.done()) return future.result();                                                      // src: vvaharness/orchestrator/preflight.py:655
            future.cancel();                                                                                // src: vvaharness/orchestrator/preflight.py:657
            throw new TimeoutError("cli MCP bridge probe did not respond within the agentic probe timeout"); // src: vvaharness/orchestrator/preflight.py:658
        }
    }

    /** The synthetic tool the bridge probe offers: the one-element tool list (the echo tool returns its marker argument verbatim). */
