# vvaharness/pipeline/stages/s5/detectors.py

Stage 5's zero-model detector pass: runs the shared rule corpus over every in-scope inventory file and mints a finding per hit, minus hits that duplicate each other or sit at a finding Stage 4 already filed, capped by rule priority.

Source: `vvaharness/pipeline/stages/s5/detectors.py` (lines 1-145)
Executor: code
Called from: `vvaharness/pipeline/stages/s5/__init__.py` run (when step5_detectors.enabled)

// src: vvaharness/pipeline/stages/s5/detectors.py:30-32
_DETECTOR_LANGS = ["python", "javascript", "typescript", "web-template"]   // the only languages the shipped corpus is written for

// src: vvaharness/pipeline/stages/s5/detectors.py:119-145
fn run(kept, ctx, cache, line_tol, max_rows=200):executor=code {
  compiled = compile_detectors(detector_corpus())   // external to this batch: vvaharness/detect
  if (compiled is empty) return []
  by_lang = for each lang in _DETECTOR_LANGS: detectors whose spec.languages include lang
  rows = []
  for each rel in sorted distinct ctx.all_files {
    lang = EXT_TO_LANG[lowercased extension of rel]
    if (!_in_scope(rel, lang)) continue
    live = by_lang[lang]
    if (live is empty) continue
    lines = cache.lines(rel)
    if (lines == null) continue
    for each hit in detector_hits(rel, lines, live), rows += _mint(hit);
  }
  survivors = _cap(_dedup(rows, kept, line_tol), compiled, max_rows)
  // abstracted: :141-144 per-rule emission counters
  return survivors
}

// src: vvaharness/pipeline/stages/s5/detectors.py:39-44
fn _in_scope(rel, lang):executor=code {
  if (lang not in _DETECTOR_LANGS) return false
  return !(EXCLUDE_PATH_RE matches rel || lowercased file name contains ".min.")   // no test or mock paths, no minified files
}

// src: vvaharness/pipeline/stages/s5/detectors.py:47-64
fn _mint(hit):executor=code {
  xss = hit.spec.cwe == "CWE-79"
  return Finding(
    title = spec.title or spec.rule_id, file = hit.file, line_start = hit.line, line_end = hit.line_end,
    vuln_class = if (xss) VulnClass.INJECTION else VulnClass.OTHER,
    vuln_class_label = if (xss) "" else spec.kind,
    cwe = spec.cwe, origin = "detector", chunk_id = spec.rule_id,
    description = "Deterministic detector match (${spec.rule_id}). ${spec.citation} Matched: ${hit.snippet}"
  )   // code_snippet left empty so enrich backfills it
}

// src: vvaharness/pipeline/stages/s5/detectors.py:68-71 — rules describing the same defect; only within a family does span overlap mean one call site
_SPAN_FAMILY = { "detector-httpresponse-concat": "html-concat", "detector-html-string-concat": "html-concat" }

// src: vvaharness/pipeline/stages/s5/detectors.py:74-103
fn _dedup(rows, kept, tol):executor=code {
  kept_lines = for each kept finding with a weakness_key: (file, weakness_key(cwe)) -> its line_start values
  out = []; by_rule = {}; by_span = {}
  for each row in rows {
    line = row.line_start; end = max(line, row.line_end or line)
    rule_key = (file, cwe, rule id)                              // proximity dedup stays per rule
    span_key = (file, cwe, _SPAN_FAMILY[rule id] or rule id)     // overlap dedup crosses rules only within a family; first in corpus order wins
    site_key = (file, weakness_key(cwe))                         // one defect Stage 4 filed, whichever rule re-found it
    suppressed = (some n in by_rule[rule_key] with |line - n| <= tol)
              || (some [s, e] in by_span[span_key] with s <= end && line <= e)
              || (some n in kept_lines[site_key] with |line - n| <= tol || line <= n <= end)
    if (suppressed) { COUNTERS.bump("s5_det_dup_suppressed"); continue }
    record line under rule_key and [line, end] under span_key
    out += row
  }
  return out
}

// src: vvaharness/pipeline/stages/s5/detectors.py:106-116
fn _cap(survivors, compiled, max_rows):executor=code {
  if (max_rows <= 0 || length(survivors) <= max_rows) return survivors   // max_rows <= 0 means uncapped
  priority = rule id -> its index in compiled (corpus order)
  keep the max_rows survivors with the lowest (priority, original index), returned in original order
  COUNTERS.bump("s5_det_overflow_suppressed", length(survivors) - max_rows)
}
