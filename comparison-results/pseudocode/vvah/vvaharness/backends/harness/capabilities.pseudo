// file: vvaharness/backends/harness/capabilities.py
// Backend traits a host (S10/S11 only) must know before building a prompt, keyed by the `via` selector.
// Never consulted for a detection prompt.

@executedBy(CODE) @role(types)
record HarnessCapabilities(boolean readsInjectedClaudeConfig, boolean returnsSchemaValidatedReports) { }

@executedBy(CODE) @role(config)
class Capabilities {

    // Unknown selectors get every trait off, so a new backend opts in rather than inheriting.
    HarnessCapabilities none() {
        return new HarnessCapabilities(false, false);                                                    // src: vvaharness/backends/harness/capabilities.py:35
    }

    Map<String, HarnessCapabilities> byVia(Theta θ) {
        Map<String, HarnessCapabilities> m = new Map();
        // "cli"/"sdk" are one harness (ClaudeHarness): traits must stay identical; auto-loads .claude/
        m.put("cli", θ["code.backends.harness.capabilities.by_via"].get("cli"));                         // src: vvaharness/backends/harness/capabilities.py:42
        m.put("sdk", θ["code.backends.harness.capabilities.by_via"].get("sdk"));                         // src: vvaharness/backends/harness/capabilities.py:46
        // native subagents carry an output schema, so the host synthesizes gates deterministically
        m.put("deepagents", θ["code.backends.harness.capabilities.by_via"].get("deepagents"));           // src: vvaharness/backends/harness/capabilities.py:51
        return m;
    }

    HarnessCapabilities capabilitiesFor(String via, Theta θ) {
        return byVia(θ).getOrDefault(via == null ? "" : via, none());                                    // src: vvaharness/backends/harness/capabilities.py:60
    }

    // Name used by pass-1 callers (s11_validate) for capabilities_for.
    HarnessCapabilities of(String via, Theta θ) {
        return capabilitiesFor(via, θ);                                                                  // src: vvaharness/backends/harness/capabilities.py:58
    }
}
