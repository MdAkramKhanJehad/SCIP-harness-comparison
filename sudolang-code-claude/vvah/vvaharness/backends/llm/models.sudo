## Retry vocabulary

// src: vvaharness/backends/llm/models.py:44-56
RETRYABLE_STATUS = {429, 500, 502, 503, 504, 529}   // every route that owns its HTTP transport (all but `cli`)
CLI_RETRYABLE_STATUS = RETRYABLE_STATUS - {500, 504}   // the `claude` binary already retried 500 and 504
SERVER_ERROR_STATUS = RETRYABLE_STATUS - {429}   // gate of the server-error probe: a rate limit is not a server fault, and a lower tier cannot clear it
PARAM_REJECTION_STATUS = {400, 422}   // a gateway rejecting a request parameter; disjoint from retryable

// src: vvaharness/backends/llm/models.py:86-125
PARAM_REJECTION_ERROR_TYPES = {"invalid_request_error", "bad_request_error"}
RATE_LIMIT_TRANSIENT_RX = /rate.?limit|too many requests|overloaded|temporarily unavailable/i   // transient prose inside an HTTP 200; deliberately no bare 429 (a "req-429-" id would promote)
CLI_STATUS_429_RX = /\b429\b/   // `cli` only: no envelope status was parsed
SERVER_ERROR_TRANSIENT_RX = /server_error|overloaded|service unavailable|internal server error|bad gateway|validation errors? for ChatCompletion(?:Chunk)?\b/i
  // every route but `cli`; the last alternative is a gateway rejecting its upstream reply, sent as HTTP 400. No \b50\d\b because that matches "504 tokens"
CLI_CONN_TRANSIENT_RX = /socket connection was closed|connection (?:reset|closed|aborted)|ECONNRESET|EPIPE|broken pipe|incomplete(?:ly)? read|premature(?:ly)? closed|EOF occurred/i   // `cli` only

// src: vvaharness/backends/llm/models.py:59-73
fn rejection_text(exc):executor=code {
  // The rejection body to match parameter names against, minus any echoed request
  if (exc.body.detail is not a list) return exc.message || str(exc)
  return each detail entry with its "input" key removed and "loc" joined with ".", joined by "; "
}

// src: vvaharness/backends/llm/models.py:76-83
fn is_param_rejection(exc, ...names):executor=code {
  return any link in exception_chain(exc) with status_code in PARAM_REJECTION_STATUS whose lowercased rejection_text contains one of names
}

// src: vvaharness/backends/llm/models.py:92-100
fn is_gateway_wrapped_param_rejection(exc):executor=code {
  // a 200-status stream whose body (an SSE `error` event) is itself a parameter rejection
  return exc.status_code == 200 && exc.type in PARAM_REJECTION_ERROR_TYPES
}

## Agentic and structured-output constants

// src: vvaharness/backends/llm/models.py:127-144
DEFAULT_READ_TOOLS = ("Read", "Glob", "Grep")   // tools an agentic call gets when the caller names none; read-only, no shell
AGENTIC_MAX_TOKENS = 16000   // output cap for one agentic turn
RESPONSE_MODEL_VIAS = {"deepagents", "sdk", "openai", "cli"}   // routes that accept a response model; `cli` cannot re-ask
RESPONSE_MODEL_TOOL_NAME = "emit_structured_response"   // one name so the `sdk` and `openai` extractors match
STRUCTURED_REASK_MAX = 2   // repair re-asks per turn, shared by `sdk` and `openai`, so one bad submit cannot eat the turn budget
CLI_STRUCTURED_OUTPUT_TOOL = "StructuredOutput"   // the `cli` gate must allow it; never placed in allowed_tools

// src: vvaharness/backends/llm/models.py:147-155
fn response_model_tool(response_model):executor=code {
  schema = response_model.model_json_schema() without "title"
  return { name: RESPONSE_MODEL_TOOL_NAME, description: "Submit the final ${response_model.__name__}.", input_schema: schema }
}

// prompt-src: vvaharness/backends/llm/models.py:160-162
STRUCTURED_PROSE_REASK {
  // the once-only in-loop re-ask both raw loops (`sdk`, `openai`) send when a structured reply came back as prose
  Constraints {
    "Call the `emit_structured_response` tool now with your findings as its arguments. Do not reply with prose; the result is only accepted through that tool."
  }
}

// prompt-src: vvaharness/backends/llm/models.py:165-174
with_submit_instruction(system_prompt, response_model, tool_name = RESPONSE_MODEL_TOOL_NAME) {
  // used where a request cannot FORCE the tool: a model remembered as rejecting tool forcing, manual thinking on `sdk`, or a `deepagents` graph whose client drops the forcing under thinking (that caller passes the response model class name as tool_name)
  Constraints {
    "When you have your final ${response_model.__name__}, call the `$tool_name` tool with it; a plain-text reply is not accepted."
  }
  return if (system_prompt) "$system_prompt\n\n<line>" else "<line>"
}

