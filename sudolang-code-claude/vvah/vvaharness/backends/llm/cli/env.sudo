# vvaharness/backends/llm/cli/env.py

Process-global settings for the `claude` command-line route (TLS, proxy, effort, read jail) and the environment variables passed to each `claude` subprocess.

Source: `vvaharness/backends/llm/cli/env.py` (lines 1-129)
Executor: code
Called from: `vvaharness/orchestrator/preflight.py` (`configure` with the `cli.*` settings); `cli/oneshot.sudo`, `cli/session.sudo`, `cli/process.sudo`, `cli_mcp.sudo`

// src: vvaharness/backends/llm/cli/env.py:33-38
State {
  // Defaults until configure() runs. The CLI reaches Node only through environment variables; mutual TLS has no such path.
  _cfg = { verify_ssl: true, ca_cert: null, client_cert: null, no_proxy: null, effort: "high", restricted: true }
  _tls_extra = {}   // environment overrides derived from _cfg by _build_tls_env
}

// src: vvaharness/backends/llm/cli/env.py:41-66
fn _build_tls_env():executor=code {
  out = {}
  bundle = _cfg.ca_cert || (_cfg.verify_ssl if it is a string, else null)   // same precedence as sdk.py
  if (bundle) {
    if (bundle path exists) out.NODE_EXTRA_CA_CERTS = bundle
    else warn TLS_CA_NOT_FOUND   // the bundle is then not passed
  }
  if (_cfg.verify_ssl == false) {
    out.NODE_TLS_REJECT_UNAUTHORIZED = "0"
    warn "TLS verification disabled (verify_ssl=false) for the claude subprocess"
  }
  if (_cfg.no_proxy) { out.NO_PROXY = _cfg.no_proxy; out.no_proxy = _cfg.no_proxy }
  if (_cfg.client_cert) warn "client_cert/mTLS is configured but the `claude` CLI backend cannot present a client certificate ... Use a `via: sdk` or `via: deepagents` role for mTLS gateways."
  return out
}

// src: vvaharness/backends/llm/cli/env.py:69-90
fn configure(verify_ssl?, ca_cert?, client_cert?, no_proxy?, effort?, restricted?):executor=code {
  if (verify_ssl != null) _cfg.verify_ssl = tls.coerce_verify(verify_ssl)   // quoted "false" becomes false
  if (ca_cert) _cfg.ca_cert = ca_cert
  if (client_cert) _cfg.client_cert = client_cert
  if (no_proxy) _cfg.no_proxy = no_proxy
  if (effort) _cfg.effort = effort
  if (restricted != null) _cfg.restricted = bool(restricted)   // "is not None": false is meaningful
  _tls_extra = _build_tls_env()
}

// src: vvaharness/backends/llm/cli/env.py:93-104
fn _effective_effort(effort):executor=code {
  parsed = if (effort != null) EffortLevel.parse(effort) else null
  return if (parsed != null) parsed.value else _cfg.effort   // an unparsable per-call tier falls back to the global cli.effort
}
fn _effort_argv(effort):executor=code {
  tier = _effective_effort(effort)
  return if (tier && discovery._cli_capabilities().effort) ["--effort", tier] else []   // probe-gated
}

// src: vvaharness/backends/llm/cli/env.py:107-121
_NO_REFUSAL_RESEND_ENV = { CLAUDE_CODE_DISABLE_REFUSAL_RETRY: "1", CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK: "1" }
// By default the CLI re-sends a refused turn once and may switch to a fallback model, so flagged content would be sent again; with these set the refusal ends the turn
fn _session_pins(effort):executor=code {
  effort_argv = _effort_argv(effort)
  // An exported CLAUDE_CODE_EFFORT_LEVEL would override --effort, so it is always pinned; blank reads as unset
  return { CLAUDE_CODE_EFFORT_LEVEL: if (effort_argv) effort_argv[1] else "", ..._NO_REFUSAL_RESEND_ENV }
}

// src: vvaharness/backends/llm/cli/env.py:124-129
fn _call_env(max_tokens, effort):executor=code {
  env = _session_pins(effort)
  if (max_tokens) env.CLAUDE_CODE_MAX_OUTPUT_TOKENS = string(max_tokens)
  return env
}
// The full subprocess environment is built in process._run as: all of os.environ, then _tls_extra, then these per-call overrides (later wins).
