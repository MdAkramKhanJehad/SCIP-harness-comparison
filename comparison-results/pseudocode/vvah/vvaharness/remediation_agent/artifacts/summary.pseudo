// file: vvaharness/remediation_agent/artifacts/summary.py
// Human-readable per-finding summary.md renderer.

@executedBy(CODE) @role(io) @stage("S10")
class Summary {

    String renderSummary(RemediationVerdict verdict, Map meta) {
        String changes = verdict.changes.map(c -> "- " + c.file + " - " + c.summary).join("\n");    // src: vvaharness/remediation_agent/artifacts/summary.py:23
        if (changes.isEmpty()) changes = "- (none reported)";                                       // src: vvaharness/remediation_agent/artifacts/summary.py:25
        String recs = verdict.recommendations.map(r -> "- " + r).join("\n");                        // src: vvaharness/remediation_agent/artifacts/summary.py:26
        if (recs.isEmpty()) recs = "- (none)";
        String risks = verdict.remainingRisks.map(r -> "- " + r).join("\n");                        // src: vvaharness/remediation_agent/artifacts/summary.py:27
        if (risks.isEmpty()) risks = "- (none)";
        // Header: finding index, severity, title, file, mode, verdict, gates (source/sink/missing_control), generated;
        // then sections Root cause, Changes, Remaining risks, Recommendations, Summary.
        return "# Remediation - finding " + verdict.findingIndex + meta + verdict.verdict + verdict.gates + verdict.rootCause + changes + risks + recs + verdict.summary; // src: vvaharness/remediation_agent/artifacts/summary.py:29
    }
}
