# vvaharness/util/errlog.py

The structured error log shared across stages: one redacted JSON line per record in `<module>_<timestamp>_errors.jsonl`. Records marked `recovered` do not count as stage errors. Counts read back from this file decide whether a stage is shown as completed with errors and supply the failure message used in the report.

Source: `vvaharness/util/errlog.py` (lines 1-198)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (`configure`, `already_logged`, `last_message_for_stage`), `vvaharness/util/status.py` (`count_for_stage`), `vvaharness/util/metrics.py` and `vvaharness/manifest.py` (`counts_by_stage`, `current_path`), `vvaharness/util/response_quality.py` and every stage (`log`)

// src: vvaharness/util/errlog.py:33-48
State { _path = "pipeline-errors.jsonl"   // in the current directory until configure() is called once per scan
        _lock }
_LOGGED_ATTR = "_vvah_errlog_recorded"   // stamped on an exception once an unrecovered record exists
fn configure(path) { _path = path; create its parent directory }
fn current_path() { return _path }

// src: vvaharness/util/errlog.py:139-198
fn log(stage, unit, error, recovered=false, ...extra):executor=code {
  // never raises
  if (error is an exception) {
    msg = "Type: message"
    extra.error_code = first string error_code found along exception_chain(error), unless given
    extra.category = first string category along the chain (ModelRefusal.category), unless given
    extra.stderr = last 2000 characters of redact(first non-empty .stderr along the chain), unless given
    tb = last 4000 characters of redact(formatted traceback)   // redact BEFORE the cut, never reorder
  } else { msg = string(error); tb = null }
  rec = { ts, stage, unit: redact(unit), error: redact(msg), ...each string extra redacted }
  if (recovered) rec.recovered = true
  if (tb) rec.traceback = tb
  try append JSON line to _path under _lock, file mode 0600;
  catch => { warn ERRLOG_WRITE_FAILED; return }
  if (error is an exception && !recovered) set error._vvah_errlog_recorded = true   // after a successful write only
}

// src: vvaharness/util/errlog.py:120-126
fn already_logged(error):executor=code {
  return any link of exception_chain(error) carries _vvah_errlog_recorded   // only unrecovered records suppress a duplicate
}

// src: vvaharness/util/errlog.py:51-87
fn counts_by_stage(path?, include_recovered=true):executor=code {
  // best effort, never raises, no lock; unparseable lines skipped; records with recovered == true skipped when include_recovered is false
  return Map(stage label -> record count)
}
fn count_for_stage(stage_id, path?, include_recovered=true):executor=code {
  // boundary-aware: "s1" counts "s1" and "s1.autoexclude" but never "s10"
  return sum of counts for labels == stage_id or starting with stage_id followed by a non-alphanumeric character
}

// src: vvaharness/util/errlog.py:90-117
fn last_message_for_stage(stage_id, path?):executor=code {
  return the error text of the last unrecovered record whose label matches stage_id (same boundary rule), or null
}
