// file: vvaharness/evidence/gather.py
// S2 deterministic (no-LLM) threat-model evidence snapshot: resolves the step2.* caps, samples the AST frontier,
// gathers docs/manifests/config reps/API artefacts, and truncates prompt lists, counting every cut.

@executedBy(CODE) @role(types)
record Caps(int docCap, int manifestCap, int manifestTotalCap, int maxManifestDepth, int maxManifests,
            int maxManifestsPerKind, int maxGraphFiles, int maxEntryPoints, int maxGraphSinks, int maxModules,
            int maxGraphEdges, int maxConfigReps, int maxConfigRepChars, int maxConfigRepBodies, int maxApiArtefacts,
            int maxModulesPrompt, int maxEntryPointsPrompt, int maxInventoryFiles) { }   // src: vvaharness/evidence/gather.py:52

@executedBy(CODE) @role(types)
record ThreatEvidence(int fileCount, int originalFileCount, String primaryLanguage,
                      List<Pair<String, Integer>> languages, List<String> topDirs,
                      List<Triple<String, String, Integer>> modules, boolean modulesTruncated,
                      List<Quad<String, Boolean, String, String>> entryPoints, boolean entryPointsTruncated,
                      List<Pair<String, String>> configReps, List<String> apiArtefacts,
                      List<Pair<String, String>> docs, List<Pair<String, String>> manifests,
                      List<String> inventory, boolean inventoryTruncated, String s1Notes) { }   // frozen, extra=forbid. src: vvaharness/evidence/gather.py:99

@executedBy(CODE) @role(step) @stage("S2")
class Gather {

    /** Operator-configured integer cap: 0 survives; null, non-integer or negative falls back to the default. */
    int capInt(Object value, int dflt) {
        Object v = value;                                                                   // src: vvaharness/evidence/gather.py:41
        if (v == null) return dflt;                                                               // src: vvaharness/evidence/gather.py:42
        int n;
        try { n = toInt(v); } catch (TypeError | ValueError | OverflowError e) { return dflt; }                               // src: vvaharness/evidence/gather.py:45
        return n >= 0 ? n : dflt;                                                                 // src: vvaharness/evidence/gather.py:48
    }

    /** Every step2.* cap gather() reads; the literal fallbacks are the builtin defaults of these knobs. */
    Caps resolveCaps(Object s2, Theta θ) {
        return new Caps(
            capInt(θ["step2.max_doc_chars"], 20000),                                                             // src: vvaharness/evidence/gather.py:77
            capInt(θ["step2.max_manifest_chars"], 4000),                                                        // src: vvaharness/evidence/gather.py:78
            capInt(θ["step2.max_manifest_total_chars"], 24000),                                                  // src: vvaharness/evidence/gather.py:79
            capInt(θ["step2.max_manifest_depth"], 3),                                                        // src: vvaharness/evidence/gather.py:80
            capInt(θ["step2.max_manifests"], 12),                                                             // src: vvaharness/evidence/gather.py:81
            Math.max(1, capInt(θ["step2.max_manifests_per_kind"], 2)),                                       // floored at 1. src: vvaharness/evidence/gather.py:82
            capInt(θ["step2.max_graph_files"], 220),                                                           // src: vvaharness/evidence/gather.py:83
            capInt(θ["step2.max_entry_points"], 400),                                                          // src: vvaharness/evidence/gather.py:84
            capInt(θ["step2.max_graph_sinks"], 80),                                                           // src: vvaharness/evidence/gather.py:85
            capInt(θ["step2.max_modules"], 100),                                                               // src: vvaharness/evidence/gather.py:86
            capInt(θ["step2.max_graph_edges"], 100),                                                           // src: vvaharness/evidence/gather.py:87
            capInt(θ["step2.max_config_reps"], 80),                                                           // src: vvaharness/evidence/gather.py:88
            capInt(θ["step2.max_config_rep_chars"], 2000),                                                      // src: vvaharness/evidence/gather.py:89
            capInt(θ["step2.max_config_rep_bodies"], 12),                                                     // src: vvaharness/evidence/gather.py:90
            capInt(θ["step2.max_api_artefacts"], 100),                                                         // src: vvaharness/evidence/gather.py:91
            capInt(θ["step2.max_prompt_modules"], 100),                                                        // src: vvaharness/evidence/gather.py:93
            capInt(θ["step2.max_prompt_entry_points"], 400),                                                   // src: vvaharness/evidence/gather.py:94
            capInt(θ["step2.max_inventory_files"], 1200));                                                      // src: vvaharness/evidence/gather.py:95
    }

    /** The AST-relevant sample of ctx; graph-derived blocks read this, not ctx. */
    ContextPackage buildFrontier(ContextPackage ctx, Caps caps) {
        if (ctx == null) return null;                                                             // src: vvaharness/evidence/gather.py:124
        ContextPackage frontier = ctx.astContextView(caps.maxGraphFiles, caps.maxEntryPoints, caps.maxGraphSinks, caps.maxModules, caps.maxGraphEdges); // src: vvaharness/evidence/gather.py:126
        noteFrontierCuts(ctx, frontier, caps);                                                    // src: vvaharness/evidence/gather.py:133
        return frontier;
    }

    /** Count and warn when an evidence kind lost items, naming the binding step2 cap(s). */
    void noteCut(String counter, String kind, int total, int kept, List<String> capKeys) {
        if (kept >= total) return;                                                                // src: vvaharness/evidence/gather.py:139
        Counters.bump(counter, total - kept);                                                     // src: vvaharness/evidence/gather.py:141
        Log.warn("S2_CAP_TRUNCATED", kind, kept, total, capKeys);                                 // src: vvaharness/evidence/gather.py:142
    }

    /** Surface every item ast_context_view kept out, per kind, blaming max_graph_files or the kind's own cap. */
    void noteFrontierCuts(ContextPackage ctx, ContextPackage frontier, Caps caps) {
        Set<String> allowed = frontier.allFiles.toSet();                                          // src: vvaharness/evidence/gather.py:150
        noteCut("s2_frontier_files_excluded", "files", ctx.allFiles.size(), frontier.allFiles.size(), List.of("max_graph_files")); // src: vvaharness/evidence/gather.py:151
        for (Kind k : List.of(new Kind("entry_points", ctx.entryPoints.files(), frontier.entryPoints.size(), "max_entry_points", caps.maxEntryPoints), // src: vvaharness/evidence/gather.py:153
                              new Kind("sinks", ctx.unsafeSinks.files(), frontier.unsafeSinks.size(), "max_graph_sinks", caps.maxGraphSinks))) {
            int inside = k.files.count(f -> allowed.contains(f));                                 // src: vvaharness/evidence/gather.py:159
            List<String> keys = new List();
            if (inside < k.files.size()) keys.add("max_graph_files");                             // src: vvaharness/evidence/gather.py:161
            if (inside > k.limit) keys.add(k.key);                                                // src: vvaharness/evidence/gather.py:162
            noteCut("s2_frontier_" + k.kind + "_excluded", k.kind, k.files.size(), k.kept, keys); // src: vvaharness/evidence/gather.py:160
        }
        int inside = ctx.modules.count(m -> m.files.anyMatch(p -> allowed.contains(p)));          // src: vvaharness/evidence/gather.py:163
        List<String> keys = new List();
        if (inside < ctx.modules.size()) keys.add("max_graph_files");                             // src: vvaharness/evidence/gather.py:165
        if (inside > caps.maxModules) keys.add("max_modules");                                    // src: vvaharness/evidence/gather.py:166
        noteCut("s2_frontier_modules_excluded", "modules", ctx.modules.size(), frontier.modules.size(), keys); // src: vvaharness/evidence/gather.py:164
    }

    /** Language -> file count by extension (Detect's EXT_TO_LANG mapped to display names). */
    Counter<String> languageCounts(List<String> fullFiles, Theta θ) {
        Counter<String> counts = new Counter();
        for (String rel : fullFiles) {                                                            // src: vvaharness/evidence/gather.py:171
            String key = Detect.extToLang(θ).get(suffix(rel).lower());                              // _LANG_BY_EXT. src: vvaharness/evidence/gather.py:36
            String lang = (key == null) ? null : Detect.langDisplay().getOrDefault(key, key);     // src: vvaharness/evidence/gather.py:172
            if (lang != null) counts.inc(lang);                                                   // src: vvaharness/evidence/gather.py:173
        }
        return counts;
    }

    /** Entry points ordered so the prompt cap keeps the most exposed first: network kind, then unauth-reachable, then kind, file. */
    List<Quad<String, Boolean, String, String>> sortedEntryPoints(ContextPackage activeCtx, Theta θ) {
        List<Quad<String, Boolean, String, String>> eps = (activeCtx == null) ? new List() : activeCtx.entryPoints.map(e -> new Quad(e.kind, e.reachableFromUnauth, e.file, e.function)); // src: vvaharness/evidence/gather.py:179
        // key: (kind != network, !unauth, kind, file)
        eps.sortBy(θ["code.evidence.gather.entry_point_priority_order"]);                        // src: vvaharness/evidence/gather.py:181
        return eps;
    }

    /** Assemble ThreatEvidence: graph blocks read the AST frontier, shape blocks read all files. */
    ThreatEvidence gather(String repoRoot, Config cfg, ContextPackage ctx, Theta θ) {
        Path root = Path.of(repoRoot);                                                            // src: vvaharness/evidence/gather.py:187
        Caps caps = resolveCaps(cfg.step2, θ);                                                    // src: vvaharness/evidence/gather.py:188
        ContextPackage frontier = buildFrontier(ctx, caps);                                       // src: vvaharness/evidence/gather.py:190
        ContextPackage activeCtx = (frontier != null) ? frontier : ctx;                           // src: vvaharness/evidence/gather.py:191
        List<String> frontierFiles = (activeCtx != null) ? activeCtx.allFiles : new List();       // src: vvaharness/evidence/gather.py:192
        List<String> fullFiles = (ctx != null) ? ctx.allFiles : frontierFiles;                    // src: vvaharness/evidence/gather.py:193

        List modules = (activeCtx == null) ? new List() : activeCtx.modules.map(m -> new Triple(m.name, m.purpose, m.loc)); // src: vvaharness/evidence/gather.py:195
        List eps = sortedEntryPoints(activeCtx, θ);                                               // src: vvaharness/evidence/gather.py:196

        List docs = Docs.gatherDocs(root, fullFiles, caps.docCap, θ);                             // src: vvaharness/evidence/gather.py:198
        List manifests = Manifests.gatherManifests(root, new Triple(caps.maxManifestDepth, caps.maxManifests, caps.maxManifestsPerKind), caps.manifestCap, caps.manifestTotalCap, θ); // src: vvaharness/evidence/gather.py:199
        List cfgReps = Configs.gatherConfigReps(root, fullFiles, caps.maxConfigReps, caps.maxConfigRepChars, caps.maxConfigRepBodies, θ); // src: vvaharness/evidence/gather.py:202
        List apiArtefacts = ApiArtefacts.gatherApiArtefacts(fullFiles, caps.maxApiArtefacts, θ); // src: vvaharness/evidence/gather.py:204
        List<String> topDirs = sorted(fullFiles.filter(r -> r.contains("/")).map(r -> r.splitFirst("/")).toSet()); // src: vvaharness/evidence/gather.py:205

        // Prompt-list cuts are marked "...(truncated)" for the model and counted for the operator
        noteCut("s2_prompt_modules_truncated", "prompt_modules", modules.size(), Math.min(modules.size(), caps.maxModulesPrompt), List.of("max_prompt_modules")); // src: vvaharness/evidence/gather.py:209
        noteCut("s2_prompt_entry_points_truncated", "prompt_entry_points", eps.size(), Math.min(eps.size(), caps.maxEntryPointsPrompt), List.of("max_prompt_entry_points")); // src: vvaharness/evidence/gather.py:211
        noteCut("s2_inventory_files_truncated", "inventory_files", fullFiles.size(), Math.min(fullFiles.size(), caps.maxInventoryFiles), List.of("max_inventory_files")); // src: vvaharness/evidence/gather.py:213

        return new ThreatEvidence(                                                                // src: vvaharness/evidence/gather.py:218
            frontierFiles.size(),
            (ctx != null) ? ctx.allFiles.size() : frontierFiles.size(),                           // src: vvaharness/evidence/gather.py:220
            (ctx != null) ? ctx.language : "",                                                    // src: vvaharness/evidence/gather.py:221
            languageCounts(fullFiles, θ).mostCommon(),                                            // src: vvaharness/evidence/gather.py:222
            topDirs,
            modules.head(caps.maxModulesPrompt), modules.size() > caps.maxModulesPrompt,          // src: vvaharness/evidence/gather.py:224
            eps.head(caps.maxEntryPointsPrompt), eps.size() > caps.maxEntryPointsPrompt,          // src: vvaharness/evidence/gather.py:226
            cfgReps, apiArtefacts, docs, manifests,
            θ["code.evidence.gather.inventory_order"] == "alphabetical" ? sorted(fullFiles).head(caps.maxInventoryFiles) : fullFiles.head(caps.maxInventoryFiles), fullFiles.size() > caps.maxInventoryFiles, // src: vvaharness/evidence/gather.py:232
            (ctx != null) ? ctx.notes : "");                                                      // src: vvaharness/evidence/gather.py:234
    }
}

@executedBy(CODE) @role(types)
record Kind(String kind, List<String> files, int kept, String key, int limit) { }
