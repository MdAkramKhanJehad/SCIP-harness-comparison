  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Ctrl-C propagation: the abort flag, live-process registry and process-tree kill.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport signal\nimport subprocess\nimport threading\n\nfrom vvaharness.util import logs\n\n# Token accounting is shared with the SDK backend (util/tokens.py); re-exported for legacy imports\n\nlog = logs.get_logger(__name__)\n\n\n\n# Only the main thread sees KeyboardInterrupt, so s4/s6 pool workers call abort() on Ctrl-C.\n\n_ABORT = threading.Event()\n_LIVE_LOCK = threading.Lock()\n_LIVE: set[subprocess.Popen] = set()\n\n\ndef aborted() -> bool:\n    return _ABORT.is_set()\n\n\n#: Own process group per `claude` so the whole tree can be signalled; Windows uses ``taskkill /T``\n_NEW_GROUP_KW: dict = {} if os.name == \"nt\" else {\"start_new_session\": True}\n\n\ndef _kill_tree(proc: subprocess.Popen) -> None:\n    \"\"\"Kill *proc* AND the tool processes it spawned.\"\"\"\n    # kill() alone orphans the binary's tool subprocesses; ALWAYS the child's pgid, never 0 or ours\n    if proc.poll() is not None:\n        return\n    try:\n        if os.name == \"nt\":\n            subprocess.run([\"taskkill\", \"/F\", \"/T\", \"/PID\", str(proc.pid)],\n                           capture_output=True, timeout=10)\n            return\n        try:\n            pgid = os.getpgid(proc.pid)\n        except (OSError, AttributeError):\n            pgid = None\n        # Guard against ever signalling our own group, however that came about.\n        if pgid is not None and pgid != os.getpgrp():\n            os.killpg(pgid, signal.SIGKILL)\n        else:\n            proc.kill()\n    except Exception:\n        # Last resort: the direct child, which is what this did before.\n        try:\n            proc.kill()\n        except Exception:\n            pass\n\n\ndef _stop_tree(proc: subprocess.Popen, grace: float) -> None:\n    \"\"\"SIGINT proc's own process group, wait up to grace, then _kill_tree() if it ignored that.\"\"\"\n    # A session that flushes its session file on SIGINT stays resumable; SIGKILL never does.\n    if proc.poll() is not None:\n        return\n    if os.name == \"nt\":\n        _kill_tree(proc)\n        return\n    try:\n        pgid = os.getpgid(proc.pid)\n        if pgid != os.getpgrp():\n            os.killpg(pgid, signal.SIGINT)\n    except (OSError, AttributeError):\n        pass\n    try:\n        proc.wait(timeout=grace)\n    except subprocess.TimeoutExpired:\n        _kill_tree(proc)\n\n\n#: For processes not in _LIVE (the cli_mcp bridge's SDK-launched binary); hooks must never raise\n_ABORT_HOOKS: list = []\n\n\ndef register_abort_hook(fn) -> None:\n    \"\"\"Register *fn* to be called by :func:`abort`, for out-of-band `claude` processes.\"\"\"\n    if fn not in _ABORT_HOOKS:\n        _ABORT_HOOKS.append(fn)\n\n\ndef abort() -> int:\n    \"\"\"Set the stop flag and kill every in-flight `claude` subprocess, returning the count signalled.\"\"\"\n    _ABORT.set()\n    with _LIVE_LOCK:\n        procs = list(_LIVE)\n    for p in procs:\n        _kill_tree(p)\n    # Iterate a copy: a hook may register another mid-teardown\n    for hook in list(_ABORT_HOOKS):\n        try:\n            hook()\n        except Exception:\n            pass\n    return len(procs)\n\n\ndef reset_abort() -> None:\n    \"\"\"Clear the global stop flag, so a programmatic abort() doesn't poison later repos in a batch run.\"\"\"\n    _ABORT.clear()\n",
