// file: vvaharness/util/exceptions.py
// Shared exception-chain walk plus the S2 hollow-threat-model stop exception.

@executedBy(CODE) @role(types)
class Exceptions {

    List<Throwable> exceptionChain(Throwable exc) {
        List<Throwable> links = List.of(exc);                                  // src: vvaharness/util/exceptions.py:33
        Set<Integer> seen = Set.of(id(exc));
        while (true) {                                                         // src: vvaharness/util/exceptions.py:35
            Throwable cause = links.last().cause;                              // cause-only, never __context__ // src: vvaharness/util/exceptions.py:36
            if (cause == null || seen.contains(id(cause))) break;              // cycle guard // src: vvaharness/util/exceptions.py:37
            seen.add(id(cause));
            links.add(cause);
        }
        return links;
    }
}

@executedBy(CODE) @role(types)
class S2HollowAfterRetry extends Exception {
    String reason;
    // Raised when both the S2 threat-model call and its tool-free retry produced nothing S3 can mint;
    // the scan stops rather than running S3-S8 on zero threat units.
    S2HollowAfterRetry init(String reason) {
        this.reason = reason;                                                  // src: vvaharness/util/exceptions.py:28
        return this;
    }
}
