  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Solidity call filtering and modifier annotations.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\nfrom tree_sitter import Node\n\nfrom context_graph_sdk.extractors.analysis import (\n    extract_signature,\n    first_identifier_text,\n    node_text,\n    walk,\n)\nfrom context_graph_sdk.extractors.records import is_valid_symbol_name\n\n_RETURNS = re.compile(r\"returns\\s*\\([^)]*\\)\")\n_MODIFIER_NAME = re.compile(r\"\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\(|$|\\s)\")\n_NON_MODIFIER_TOKENS = frozenset(\n    {\n        \"public\",\n        \"external\",\n        \"internal\",\n        \"private\",\n        \"view\",\n        \"pure\",\n        \"payable\",\n        \"virtual\",\n        \"override\",\n        \"returns\",\n    }\n)\n\n\ndef _ancestor_exact(node: Node, node_type: str, max_depth: int) -> Node | None:\n    current = node.parent\n    for _ in range(max_depth):\n        if current is None:\n            return None\n        if current.type == node_type:\n            return current\n        current = current.parent\n    return None\n\n\ndef include_solidity_call(callee: str, name_node: Node, source: bytes) -> bool:\n    \"\"\"Constructor modifier invocations count as calls only when they are\n    parent-constructor calls (the contract inherits the callee).\"\"\"\n    modifier_invocation = _ancestor_exact(name_node, \"modifier_invocation\", 6)\n    if modifier_invocation is None:\n        return True\n    constructor = _ancestor_exact(modifier_invocation, \"constructor_definition\", 8)\n    if constructor is None:\n        return False\n    contract = _ancestor_exact(constructor, \"contract_declaration\", 12)\n    if contract is None:\n        return False\n    for child in contract.children:\n        if child.type != \"inheritance_specifier\":\n            continue\n        ancestor = child.child_by_field_name(\"ancestor\") or child\n        if _last_identifier(ancestor, source) == callee:\n            return True\n    return False\n\n\ndef _last_identifier(node: Node, source: bytes) -> str:\n    result = \"\"\n\n    def visit(current: Node, _depth: int) -> str | None:\n        nonlocal result\n        if \"identifier\" in current.type.lower() and current.child_count == 0:\n            result = node_text(current, source)\n        return None\n\n    walk(node, visit)\n    return result\n\n\ndef solidity_annotation_supplement(def_node: Node, source: bytes) -> tuple[str, ...]:\n    \"\"\"Report function modifier invocations as annotations.\"\"\"\n    names: list[str] = []\n\n    def visit(node: Node, depth: int) -> str | None:\n        node_type = node.type.lower()\n        if depth > 0 and node_type in (\"function_body\", \"block\"):\n            return \"skip\"\n        if node_type != \"modifier_invocation\":\n            return None\n        name = first_identifier_text(node, source)\n        if name and is_valid_symbol_name(name):\n            names.append(name)\n        return \"skip\"\n\n    walk(def_node, visit)\n    if not names:\n        names = _modifier_names_from_signature(extract_signature(def_node, source))\n    return tuple(dict.fromkeys(names))\n\n\ndef _modifier_names_from_signature(signature: str) -> list[str]:\n    if not signature:\n        return []\n    closing = signature.find(\")\")\n    if closing < 0 or closing + 1 >= len(signature):\n        return []\n    tail = _RETURNS.sub(\" \", signature[closing + 1 :])\n    names: list[str] = []\n    seen: set[str] = set()\n    for match in _MODIFIER_NAME.finditer(tail):\n        name = match.group(1)\n        if name in seen or name in _NON_MODIFIER_TOKENS:\n            continue\n        seen.add(name)\n        names.append(name)\n    return names\n",
