# vvaharness/plugins/semgrep/findings.py

Turns `semgrep --json` output into harness `Finding` records so Stage 5 onward can run on them (the external-findings input path). Bounded: at most 2,000 results and a 64 MiB file; unmapped CWEs fold to `other` rather than dropping the finding.

Source: `vvaharness/plugins/semgrep/findings.py` (lines 1-196)
Executor: code
Called from: the external-findings ingest path (findings_from_semgrep, read_semgrep_json); outside this batch

// src: vvaharness/plugins/semgrep/findings.py:30-36
MAX_FINDINGS = 2000
MAX_JSON_BYTES = 64 * 1024 * 1024
_MAX_SNIPPET_CHARS = 2000; _MAX_TITLE_CHARS = 200; _MAX_LABEL_CHARS = 120
_CWE_RE = /CWE-(\d{1,5})/

// src: vvaharness/plugins/semgrep/findings.py:38-66 — CWE number to VulnClass; anything unmapped becomes "other"
_CWE_TO_CLASS = {
  77, 78, 79, 89, 90, 91, 94, 95, 611, 643, 917, 88, 117, 470, 943, 1336 => injection;
  502 => unsafe-deserialization;
  190, 191 => integer-overflow;
  362, 367 => race-condition;
  134 => format-string;
  416 => use-after-free;
  121 => stack-overflow;
  122, 787 => heap-overflow;
  843, 704 => type-confusion;
  200, 209, 532, 215, 311, 312, 313, 315, 319, 359, 497, 522, 614, 798 => info-leak;
  22, 287, 306, 352, 862, 863 => logic-flaw
}
_SEVERITY = { ERROR: "high", WARNING: "medium", INFO: "low" }

// src: vvaharness/plugins/semgrep/findings.py:75-98
fn relative_path(path, root):executor=code {
  candidate = path with "\" => "/" as a POSIX path
  if (!root || candidate is not absolute) return if (candidate not in [".", ""]) candidate else path
  base = resolved root
  under = candidate relative to base, else resolved(path) relative to base
  if (under) return under
  COUNTERS.bump("semgrep_path_outside_repo")
  warn SEMGREP_PATH_NOT_RELATIVE "this finding keeps an absolute path, so S5 drops it as a file that is not in the repo inventory"
  return candidate
}

// src: vvaharness/plugins/semgrep/findings.py:101-126
fn _cwe_ids(metadata):executor=code { return every "CWE-<n>" (n as an integer, so leading zeros drop) in metadata.cwe (string or list), first-seen order, deduplicated }
fn _vuln_class(cwes):executor=code { return _CWE_TO_CLASS of the first mapped CWE, else "other" }
fn _label(metadata, cwes):executor=code { return first non-blank metadata.vulnerability_class, else the first CWE that has a name in report.cwe.cwe_name, else "" }

// src: vvaharness/plugins/semgrep/findings.py:129-158
fn _finding(result, root):executor=code {
  require result.path is a string && result.start.line is an integer => return null   // no usable location: skipped
  cwes = _cwe_ids(extra.metadata); vuln_class = _vuln_class(cwes)
  rule_id = result.check_id || "semgrep"; message = extra.message || rule_id
  return Finding({
    title: first line of strip(message), cut to 200 characters, || rule_id,
    file: relative_path(result.path, root), line_start: result.start.line, vuln_class, description: message,
    origin: "semgrep:$rule_id",
    // set only when not null:
    line_end: result.end.line, cwe: cwes[0], severity: _SEVERITY[upper(extra.severity)],   // other severities leave the Finding default "medium"
    code_snippet: extra.lines cut to 2000 characters (empty => unset),
    vuln_class_label: if (vuln_class == "other") _label(...) cut to 120 characters
  })
}

// src: vvaharness/plugins/semgrep/findings.py:161-173
fn findings_from_semgrep(payload, repo?):executor=code {
  // pass repo whenever semgrep was given an absolute target, or every unresolvable file is dropped by Stage 5
  document = if (payload is a dict) payload else read_semgrep_json(payload)
  require document.results is a list => throw SemgrepFindingsError("semgrep JSON has no 'results' list")
  require length(results) <= MAX_FINDINGS => throw SemgrepFindingsError("<n> results exceeds MAX_FINDINGS=2000")   // the whole set is refused, not truncated
  return non-null _finding(r, root) for each dict r in results
}

// src: vvaharness/plugins/semgrep/findings.py:176-186
fn read_semgrep_json(path):executor=code {
  require size(path) <= MAX_JSON_BYTES => throw SemgrepFindingsError("$path exceeds MAX_JSON_BYTES=...")
  try document = parse JSON of path; catch OS error or JSON error => throw SemgrepFindingsError("cannot read semgrep JSON at $path: ...")
  require document is an object => throw SemgrepFindingsError("semgrep JSON at $path is not an object")
}
