// file: vvaharness/report/cvss.py
// CVSS 3.1 calculator (FIRST.org spec section 7): base score from a vector, sentinel variant, severity rating.
// The single home for the metric weights and formula coefficients (appcontext reuses them for environmental scoring).

@executedBy(CODE) @role(rule_set) @stage("S6")
class Cvss {

    // Vector grammar: CVSS:3.0 or 3.1 with all eight base metrics; anything else is unscored         // src: vvaharness/report/cvss.py:20
    // Base weights AV, AC, PR (scope unchanged/changed), UI, CIA                                      // src: vvaharness/report/cvss.py:25
    // Environmental weights REQ, EXPLOIT_MATURITY, REMEDIATION_LEVEL, REPORT_CONFIDENCE               // src: vvaharness/report/cvss.py:31
    double NEUTRAL_WEIGHT = 1.0;                              // src: vvaharness/report/cvss.py:36
    double NO_SCORE = -1.0;                                   // sentinel renderers expect // src: vvaharness/report/cvss.py:37
    double MAX_SCORE = 10.0;                                  // src: vvaharness/report/cvss.py:38
    double MISS_CAP = 0.915;                                  // src: vvaharness/report/cvss.py:39

    Map weights(Theta θ) {
        return θ["code.report.cvss.base_metric_weights"];                                              // AV N.85 A.62 L.55 P.2; AC L.77 H.44; PR; UI; CIA H.56 L.22 N0 // src: vvaharness/report/cvss.py:25
    }

    Map environmentalWeights(Theta θ) {
        return θ["code.report.cvss.environmental_weights"];                                            // REQ H1.5 L0.5; E; RL; RC // src: vvaharness/report/cvss.py:31
    }

    /** Spec Appendix A Roundup: round the scaled value, never truncate. */
    double roundup1(double x, Theta θ) {
        long n = Math.round(x * θ["code.report.cvss.formula_coefficients"].get("ROUNDUP_SCALE"));       // 100000 // src: vvaharness/report/cvss.py:59
        if (n % 10000 == 0) return n / 100000.0;                                                       // src: vvaharness/report/cvss.py:60
        return (n / 10000 + 1) / 10.0;                                                                 // src: vvaharness/report/cvss.py:62
    }

    /** Section 7.2 impact sub-score. */
    double baseImpact(double iss, boolean scopeChanged, Theta θ) {
        Map k = θ["code.report.cvss.formula_coefficients"];
        if (!scopeChanged) return k.get("IMPACT_SCOPE_UNCHANGED_COEFF") * iss;                         // 6.42 // src: vvaharness/report/cvss.py:68
        return k.get("IMPACT_SCOPE_CHANGED_COEFF") * (iss - k.get("IMPACT_OFFSET"))
            - k.get("IMPACT_PENALTY_COEFF") * Math.pow(iss - k.get("IMPACT_PENALTY_OFFSET"), k.get("BASE_IMPACT_EXPONENT")); // 7.52, 0.029, 3.25, 0.02, 15 // src: vvaharness/report/cvss.py:69
    }

    /** Section 7.3 modified impact, with the MISS correction and exponent the base form lacks. */
    double modifiedImpact(double miss, boolean scopeChanged, Theta θ) {
        Map k = θ["code.report.cvss.formula_coefficients"];
        if (!scopeChanged) return k.get("IMPACT_SCOPE_UNCHANGED_COEFF") * miss;                        // src: vvaharness/report/cvss.py:76
        return k.get("IMPACT_SCOPE_CHANGED_COEFF") * (miss - k.get("IMPACT_OFFSET"))
            - k.get("IMPACT_PENALTY_COEFF") * Math.pow(miss * k.get("MODIFIED_IMPACT_MISS_CORRECTION") - k.get("IMPACT_PENALTY_OFFSET"), k.get("MODIFIED_IMPACT_EXPONENT")); // 0.9731, 13 // src: vvaharness/report/cvss.py:77
    }

    /** Final combination, x1.08 when scope changed, capped at 10 and rounded up. */
    double combine(double impact, double exploitability, boolean scopeChanged, Theta θ) {
        double raw = impact + exploitability;                                                          // src: vvaharness/report/cvss.py:85
        if (scopeChanged) raw *= θ["code.report.cvss.formula_coefficients"].get("SCOPE_CHANGED_COEFF"); // src: vvaharness/report/cvss.py:87
        return roundup1(Math.min(raw, MAX_SCORE), θ);                                                  // src: vvaharness/report/cvss.py:88
    }

    /** CVSS 3.1 base score from a vector string; null when absent or unparseable. */
    Double score(String vector, Theta θ) {
        if (vector == null || vector.isEmpty()) return null;                                           // src: vvaharness/report/cvss.py:93
        Match m = Regex.search(θ["code.report.cvss.vector_pattern"], vector);                          // src: vvaharness/report/cvss.py:95
        if (m == null) return null;                                                                    // src: vvaharness/report/cvss.py:96
        boolean scopeChanged = m.group("S") == "C";                                                    // src: vvaharness/report/cvss.py:99
        Map w = weights(θ);
        double iss = 1 - (1 - w.CIA.get(m.group("C"))) * (1 - w.CIA.get(m.group("I"))) * (1 - w.CIA.get(m.group("A"))); // src: vvaharness/report/cvss.py:101
        double impact = baseImpact(iss, scopeChanged, θ);                                              // src: vvaharness/report/cvss.py:102
        if (impact <= 0) return 0.0;                                                                   // src: vvaharness/report/cvss.py:103
        double pr = (scopeChanged ? w.PR_SCOPE_CHANGED : w.PR_SCOPE_UNCHANGED).get(m.group("PR"));     // src: vvaharness/report/cvss.py:106
        double exploitability = θ["code.report.cvss.formula_coefficients"].get("EXPLOITABILITY_COEFF") * w.AV.get(m.group("AV")) * w.AC.get(m.group("AC")) * pr * w.UI.get(m.group("UI")); // 8.22 // src: vvaharness/report/cvss.py:107
        return combine(impact, exploitability, scopeChanged, θ);                                       // src: vvaharness/report/cvss.py:108
    }

    double scoreOrSentinel(String vector, Theta θ) {
        Double s = score(vector, θ);                                                                   // src: vvaharness/report/cvss.py:113
        return s != null ? s : NO_SCORE;                                                               // src: vvaharness/report/cvss.py:114
    }

    /** Severity label per spec section 5; not sentinel-safe (callers guard with >= 0). */
    String rating(Double s, Theta θ) {
        if (s == null) return "Unknown";                                                               // src: vvaharness/report/cvss.py:120
        if (s == 0.0) return "None";                                                                   // src: vvaharness/report/cvss.py:122
        for (Pair<Double, String> band : θ["code.report.cvss.severity_bands"]) {                       // <4 Low, <7 Medium, <9 High // src: vvaharness/report/cvss.py:123
            if (s < band.first) return band.second;                                                    // src: vvaharness/report/cvss.py:125
        }
        return "Critical";                                                                             // src: vvaharness/report/cvss.py:126
    }
}
