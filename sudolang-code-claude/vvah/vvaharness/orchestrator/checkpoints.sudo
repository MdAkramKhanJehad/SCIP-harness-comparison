# vvaharness/orchestrator/checkpoints.py

Checkpoint storage for resume. Each stage's output is stored as one JSON row keyed by `(run_id, step)` in the SQLite state store and validated against a fixed schema on load. A row that is missing, oversized or fails its schema is treated as absent, so the stage reruns. The file also defines when a Stage 4 checkpoint counts as complete, the run id, provenance rows, dynamic per-finding keys for Stages 10 and 11, and pruning.

Source: `vvaharness/orchestrator/checkpoints.py` (lines 1-357)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (every stage), Stage 10 and 11 runners, `vvaharness/cli/_commands.py` (`prune`)

// src: vvaharness/orchestrator/checkpoints.py:46-49
_S4Ckpt {
  findings: Finding[]
  outcomes: { unit_id: String }   // per-unit outcome strings
  input_kind?: "deepdive" | "external"
}

// src: vvaharness/orchestrator/checkpoints.py:64
_S4_UNTRUSTED_OUTCOMES = ["error", "halted", "uninvestigated", "failed"]
// "guardrail" and "skipped" are excluded on purpose: they are deterministic for a given configuration, so retrying on --resume would not heal them

// src: vvaharness/orchestrator/checkpoints.py:67-70
fn s4_stage_complete(checkpoint):executor=code {
  // false means --resume must not reuse the Stage 4 checkpoint (scan.py then reruns Stage 4)
  return no value in checkpoint.outcomes is in _S4_UNTRUSTED_OUTCOMES
  // an empty outcomes map counts as complete
}

// src: vvaharness/orchestrator/checkpoints.py:52-60
fn s4_input_kind(checkpoint):executor=code {
  if ("input_kind" in checkpoint) return checkpoint.input_kind
  origins = { finding.origin || "external" for each finding in checkpoint.findings }
  if (findings non-empty && outcomes == every origin mapped to "confirmed") return "external"   // legacy inference for findings imported from outside Stage 4
  return "deepdive"
}

// src: vvaharness/orchestrator/checkpoints.py:133-149 (s7 tuple shapes: 83-93)
_STEP_SCHEMA {
  s0: SeedPackage
  s1: ContextPackage
  s2: ThreatModel
  s3: TaskManifest
  s4: _S4Ckpt
  s5: { findings: Finding[], pre_dropped: DroppedFinding[] }
  s6: { verified: Finding[], dropped: DroppedFinding[] }
  s7: [pre_dropped, verified, dropped, canonical, dup_dropped, s5_out_count] | [pre_dropped, verified, dropped, canonical, dup_dropped]   // 6-tuple current; 5-tuple accepted for legacy rows
  s8: FinalReport
  s9: String           // SARIF path
  ingest: Boolean      // not a stage: records the upload so --resume never re-uploads
  repo_identity: String   // REPO_IDENTITY_STEP: git HEAD at scan start; run_id keys on the path alone
}
// src: vvaharness/orchestrator/checkpoints.py:97-177 (constants at 97, 124, 155-161, 177; dynamic schemas 152, 164-173, 179-190)
REPO_IDENTITY_STEP = "repo_identity"
_PROVENANCE_SUFFIX = "_prov"          // "<step>_prov" holds StageProvenance { model, via, config_sha256, tokens }
REMEDIATE_PREFIX = "remediate_"       // dynamic rows: a plain dict per finding
VALIDATE_PREFIX = "validate_"         // dynamic rows: ValidationResult
_STEP_DIGEST_CHARS = 24
EV_COLLECTION_STEP = "ev_collection"  // NormalizedCollection; on --resume EV_API_COLLECTION is not needed (if set, it wins)

// src: vvaharness/orchestrator/checkpoints.py:193-206
fn _schema_for(step):executor=code {
  if (step in _STEP_SCHEMA) return _STEP_SCHEMA[step]
  if (step ends with "_prov" && the prefix is in _STEP_SCHEMA) return StageProvenance
  if (step == EV_COLLECTION_STEP) return NormalizedCollection
  if (step starts with REMEDIATE_PREFIX) return dict
  if (step starts with VALIDATE_PREFIX) return ValidationResult
  throw KeyError   // unknown step is a caller bug, fail loud
}

// src: vvaharness/orchestrator/checkpoints.py:238
_CKPT_MAX_BYTES = 100 * 1024 * 1024   // also enforced by a CHECK constraint on checkpoints.size

// src: vvaharness/orchestrator/checkpoints.py:241-263
fn save_ckpt(ckpt_dir, run_id, step, obj):executor=code {
  // ckpt_dir is ignored (kept for call-site compatibility)
  blob = _schema_for(step) serialized to JSON   // never pickle (CWE-502)
  require length(blob) <= _CKPT_MAX_BYTES => { warn CKPT_TOO_LARGE; return }   // the row is NOT saved, so a resume reruns the stage
  in one transaction {
    insert runs(run_id, repo_root="") if absent; set runs.updated_at = now
    insert or replace checkpoints(run_id, step, payload=blob, size)
  }
}

// src: vvaharness/orchestrator/checkpoints.py:266-301
fn load_ckpt(ckpt_dir, run_id, step):executor=code {
  row = select payload, size from checkpoints where run_id and step
  if (row == null) return null   // for step "s1" a console hint names the database path and $VVAHARNESS_STATE_DIR
  require row.size <= _CKPT_MAX_BYTES => { warn CKPT_STORED_TOO_LARGE; return null }
  try return _schema_for(step) validated from row.payload;
  catch (ValidationError | ValueError) => {
    if (payload is not well-formed JSON) warn CKPT_UNREADABLE else warn CKPT_SCHEMA_MISMATCH   // usually a different tool version
    return null   // the caller reruns the step
  }
}

// src: vvaharness/orchestrator/checkpoints.py:304-316
fn save_stage_provenance(ckpt_dir, run_id, step, model, via, config_sha256, tokens):executor=code {
  save_ckpt(ckpt_dir, run_id, "${step}_prov", { model, via, config_sha256, tokens })   // a second row per stage
}
fn load_stage_provenance(ckpt_dir, run_id, step):executor=code { return load_ckpt(ckpt_dir, run_id, "${step}_prov") }   // null for legacy checkpoints

// src: vvaharness/orchestrator/checkpoints.py:319-321
fn run_id_for(repo):executor=code {
  return sha256(resolved path of repo)[:32]
  // keyed on the PATH only: the same path re-cloned at another commit gets the same run_id, hence REPO_IDENTITY_STEP
}

// src: vvaharness/orchestrator/checkpoints.py:209-217
fn step_key_for(prefix, engine_id, engine_version, case_id, model="", backend=""):executor=code {
  require prefix in [REMEDIATE_PREFIX, VALIDATE_PREFIX] => throw ValueError("unknown dynamic checkpoint prefix ...")
  return prefix + sha256(join with newline [engine_id, engine_version, case_id, model, backend])[:24]
  // so --resume cannot republish another engine's or model's result for this case
}

// src: vvaharness/orchestrator/checkpoints.py:221-234
fn prune_stale_steps(run_id, prefix, live_keys):executor=code {
  if ([run_id, prefix] already pruned in this process) return []   // at most once per (run_id, prefix) per process
  mark pruned
  return store.delete_steps(run_id, prefix, set(live_keys))   // deletes this run's prefix rows no live case claims; console line when any were removed
}

// src: vvaharness/orchestrator/checkpoints.py:324-357
fn prune_checkpoints(keep_runs=100, max_age_days=5, dry_run=false):executor=code {
  db = store.db_location()
  if (db does not exist) return { root: db, kept: 0, deleted: [] }   // never creates the database
  victims = runs where updated_at older than max_age_days OR not among the keep_runs most recently updated, oldest first
  if (!dry_run && victims) {
    delete those runs rows (checkpoints, call graphs and replays cascade)
    PRAGMA incremental_vacuum; PRAGMA wal_checkpoint(TRUNCATE)
    for each v in victims, store.delete_run_graphs(v)
  }
  return { root: db, kept: total - length(victims), deleted: victims }
}

// abstracted: checkpoints.py:100-130 (StageProvenance docstring and suffix helper), 163-190 (lazy construction of the validate and exploit verification schemas to avoid an import cycle), console lines on save and load. No decision changes.
