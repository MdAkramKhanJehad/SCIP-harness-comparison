// file: vvaharness/pipeline/stages/s6/prompts.py
// Agentic S6 prompts: one scan-constant SYSTEM prompt (role, verdicts, confidence, method, duties,
// exclusion rules A-F, CVSS, output example) and one per-batch VERIFY prompt; plus the JSON repair re-ask.

@executedBy(MODEL) @role(prompt) @stage("S6")
class S6Prompts {

    Prompt buildSystemPrompt(boolean graph, boolean traitStamps, boolean reframe, Theta θ) {
        // Identical for every S6 session so it caches; empty clauses are skipped.
        Object order = θ["p.s6_prompts.system_prompt_clause_order"];                            // src: vvaharness/pipeline/stages/s6/prompts.py:236
        Prompt p = new Prompt();
        p.include(role(θ));                                                                     // src: vvaharness/pipeline/stages/s6/prompts.py:237
        p.include(verdictClause(θ));                                                            // src: vvaharness/pipeline/stages/s6/prompts.py:238
        p.include(confidenceClause(θ));                                                         // src: vvaharness/pipeline/stages/s6/prompts.py:239
        p.include(method(θ));                                                                   // src: vvaharness/pipeline/stages/s6/prompts.py:240
        if (graph) p.include(graphDuty(θ));                                                     // src: vvaharness/pipeline/stages/s6/prompts.py:241
        p.include(correctionDuty(θ));                                                           // src: vvaharness/pipeline/stages/s6/prompts.py:242
        if (reframe) p.include(reframeDuty(θ));                                                 // src: vvaharness/pipeline/stages/s6/prompts.py:243  (step6_verify.reframe_enabled)
        p.include(repeatDuty(θ));                                                               // src: vvaharness/pipeline/stages/s6/prompts.py:244
        p.include(extraDuty(θ));                                                                // src: vvaharness/pipeline/stages/s6/prompts.py:245
        if (traitStamps) p.include(traitStampDuty(θ));                                          // src: vvaharness/pipeline/stages/s6/prompts.py:246  (step6_verify.trait_stamps)
        p.include(exclusionRules(θ));                                                           // src: vvaharness/pipeline/stages/s6/prompts.py:247
        p.include(cvssDuty(θ));                                                                 // src: vvaharness/pipeline/stages/s6/prompts.py:248
        p.include(outputExample(θ));                                                            // src: vvaharness/pipeline/stages/s6/prompts.py:249
        return p;
    }

    Prompt role(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.s6.stance"]);                                                          // src: vvaharness/pipeline/stages/s6/prompts.py:23
        p.persona(θ["p.s6_prompts.role_second_opinion"]);                                       // src: vvaharness/pipeline/stages/s6/prompts.py:24
        p.must(θ["p.s6_prompts.assume_wrong_stance"]);                                          // src: vvaharness/pipeline/stages/s6/prompts.py:25
        return p;
    }

    Prompt exclusionRules(Theta θ) {
        // EXCLUSION_RULES: OUT OF SCOPE - do not report:
        Prompt p = new Prompt();
        p.rule(θ["prompt.s6.exclusion_rules"]);                                                 // src: vvaharness/pipeline/stages/s6/prompts.py:29
        p.checklist(θ["p.s6_prompts.exclusion_rules_header"]);                                  // src: vvaharness/pipeline/stages/s6/prompts.py:30
        // A. NO REAL ATTACKER
        p.forbid(θ["p.s6_prompts.exclusion_rule_a_no_real_attacker"]);                          // src: vvaharness/pipeline/stages/s6/prompts.py:32
        p.forbid(θ["p.s6_prompts.exclusion_a_unreachable_code"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:33
        p.forbid(θ["p.s6_prompts.exclusion_a_local_inputs"]);                                   // src: vvaharness/pipeline/stages/s6/prompts.py:35
        p.exemption(θ["p.s6_prompts.exclusion_a_boundary_exception"]);                          // src: vvaharness/pipeline/stages/s6/prompts.py:36
        // B. NO SECURITY IMPACT
        p.forbid(θ["p.s6_prompts.exclusion_rule_b_no_security_impact"]);                        // src: vvaharness/pipeline/stages/s6/prompts.py:41
        p.forbid(θ["p.s6_prompts.exclusion_b_crashes"]);                                        // src: vvaharness/pipeline/stages/s6/prompts.py:42
        p.forbid(θ["p.s6_prompts.exclusion_b_working_as_designed"]);                            // src: vvaharness/pipeline/stages/s6/prompts.py:44
        p.forbid(θ["p.s6_prompts.exclusion_b_nonsecurity_random_placeholder"]);                 // src: vvaharness/pipeline/stages/s6/prompts.py:46
        // C. WRONG LAYER
        p.forbid(θ["p.s6_prompts.exclusion_rule_c_wrong_layer"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:49
        p.forbid(θ["p.s6_prompts.exclusion_c_server_classes_on_client"]);                       // src: vvaharness/pipeline/stages/s6/prompts.py:50
        p.forbid(θ["p.s6_prompts.exclusion_c_memory_managed_langs"]);                           // src: vvaharness/pipeline/stages/s6/prompts.py:52
        p.forbid(θ["p.s6_prompts.exclusion_c_flat_object_keys"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:54
        p.forbid(θ["p.s6_prompts.exclusion_c_ssrf_path_only"]);                                 // src: vvaharness/pipeline/stages/s6/prompts.py:56
        // D. HANDLED ELSEWHERE
        p.forbid(θ["p.s6_prompts.exclusion_rule_d_handled_elsewhere"]);                         // src: vvaharness/pipeline/stages/s6/prompts.py:58
        p.forbid(θ["p.s6_prompts.exclusion_d_third_party_versions"]);                           // src: vvaharness/pipeline/stages/s6/prompts.py:59
        p.forbid(θ["p.s6_prompts.exclusion_d_volumetric_dos"]);                                 // src: vvaharness/pipeline/stages/s6/prompts.py:61
        p.exemption(θ["p.s6_prompts.exclusion_d_complexity_dos_exception"]);                    // src: vvaharness/pipeline/stages/s6/prompts.py:62
        // E. NOISE FLOOR
        p.forbid(θ["p.s6_prompts.exclusion_rule_e_noise_floor"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:65
        p.forbid(θ["p.s6_prompts.exclusion_e_log_injection"]);                                  // src: vvaharness/pipeline/stages/s6/prompts.py:66
        p.forbid(θ["p.s6_prompts.exclusion_e_llm_prompt_text"]);                                // src: vvaharness/pipeline/stages/s6/prompts.py:67
        p.forbid(θ["p.s6_prompts.exclusion_e_theoretical_gaps"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:69
        // F. INTENTIONALLY VULNERABLE TARGET
        p.exemption(θ["p.s6_prompts.exclusion_rule_f_intentionally_vulnerable"]);               // src: vvaharness/pipeline/stages/s6/prompts.py:72
        p.must(θ["p.s6_prompts.exclusion_f_report_as_production"]);                             // src: vvaharness/pipeline/stages/s6/prompts.py:78
        p.rule(θ["p.s6_prompts.exclusion_f_independent_reason_only"]);                          // src: vvaharness/pipeline/stages/s6/prompts.py:80
        return p;
    }

    Prompt verdictClause(Theta θ) {
        // ## The three verdicts
        Prompt p = new Prompt();
        p.rule(θ["prompt.s6.verdicts"]);                                                        // src: vvaharness/pipeline/stages/s6/prompts.py:84
        p.choose(θ["p.s6_prompts.verdict_set"]);                                                // src: vvaharness/pipeline/stages/s6/prompts.py:85
        p.rule(θ["p.s6_prompts.verdict_true_positive"]);                                        // src: vvaharness/pipeline/stages/s6/prompts.py:86
        p.evidence(θ["p.s6_prompts.verdict_false_positive"]);                                   // src: vvaharness/pipeline/stages/s6/prompts.py:88
        p.rule(θ["p.s6_prompts.verdict_inconclusive"]);                                         // src: vvaharness/pipeline/stages/s6/prompts.py:91
        p.rule(θ["p.s6_prompts.verdict_asymmetric_cost"]);                                      // src: vvaharness/pipeline/stages/s6/prompts.py:93
        p.tiebreak(θ["p.s6_prompts.unestablished_refutation_inconclusive"]);                    // src: vvaharness/pipeline/stages/s6/prompts.py:95
        p.forbid(θ["p.s6_prompts.inconclusive_not_avoidance"]);                                 // src: vvaharness/pipeline/stages/s6/prompts.py:97
        return p;
    }

    Prompt confidenceClause(Theta θ) {
        Prompt p = new Prompt();
        p.threshold(θ["p.s6_prompts.confidence_hard_gate"]);                                    // src: vvaharness/pipeline/stages/s6/prompts.py:101
        p.rule(θ["p.s6_prompts.confidence_high_band"]);                                         // src: vvaharness/pipeline/stages/s6/prompts.py:102
        p.rule(θ["p.s6_prompts.confidence_low_band"]);                                          // src: vvaharness/pipeline/stages/s6/prompts.py:103
        return p;
    }

    Prompt method(Theta θ) {
        // ## Method, per finding
        Prompt p = new Prompt();
        p.step(1, θ["p.s6_prompts.method_step1_open_cited_line"]);                              // src: vvaharness/pipeline/stages/s6/prompts.py:110
        p.step(2, θ["p.s6_prompts.method_step2_walk_callers"]);                                 // src: vvaharness/pipeline/stages/s6/prompts.py:111
        p.rule(θ["p.s6_prompts.no_entry_point_not_exploitable"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:112
        p.step(3, θ["p.s6_prompts.method_step3_try_to_kill"]);                                  // src: vvaharness/pipeline/stages/s6/prompts.py:113
        p.step(4, θ["p.s6_prompts.method_step4_probe_defence"]);                                // src: vvaharness/pipeline/stages/s6/prompts.py:117
        p.rule(θ["p.s6_prompts.partial_defence_not_refutation"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:118
        p.must(θ["p.s6_prompts.scope_glob_grep_calls"]);                                        // src: vvaharness/pipeline/stages/s6/prompts.py:120
        return p;
    }

    Prompt graphDuty(Theta θ) {
        // Included only when the graph tools are composed onto the session.
        Prompt p = new Prompt();
        p.rule(θ["p.s6_prompts.graph_duty_reachability"]);                                      // src: vvaharness/pipeline/stages/s6/prompts.py:126
        p.forbid(θ["p.s6_prompts.missing_graph_edge_not_refutation"]);                          // src: vvaharness/pipeline/stages/s6/prompts.py:130
        return p;
    }

    Prompt correctionDuty(Theta θ) {
        // ## A wrong label is not a wrong finding
        Prompt p = new Prompt();
        p.rule(θ["prompt.s6.correction_duty"]);                                                 // src: vvaharness/pipeline/stages/s6/prompts.py:135
        p.format(θ["p.s6_prompts.duty_correction"]);                                            // src: vvaharness/pipeline/stages/s6/prompts.py:136
        p.must(θ["p.s6_prompts.corrected_cwe_keep_tp"]);                                        // src: vvaharness/pipeline/stages/s6/prompts.py:138
        p.rule(θ["p.s6_prompts.corrected_line_start_rule"]);                                    // src: vvaharness/pipeline/stages/s6/prompts.py:141
        p.forbid(θ["p.s6_prompts.no_refute_for_imprecise_label"]);                              // src: vvaharness/pipeline/stages/s6/prompts.py:144
        p.forbid(θ["p.s6_prompts.correction_not_rewrite"]);                                     // src: vvaharness/pipeline/stages/s6/prompts.py:146
        return p;
    }

    Prompt reframeDuty(Theta θ) {
        // ## Refuting the framing is not refuting the exposure (gated on step6_verify.reframe_enabled, ships OFF)
        Prompt p = new Prompt();
        p.rule(θ["p.s6_prompts.duty_reframe"]);                                                 // src: vvaharness/pipeline/stages/s6/prompts.py:153
        p.must(θ["p.s6_prompts.reframe_demote_confidence"]);                                    // src: vvaharness/pipeline/stages/s6/prompts.py:156
        p.forbid(θ["p.s6_prompts.reframe_no_repeat_lines"]);                                    // src: vvaharness/pipeline/stages/s6/prompts.py:161
        p.forbid(θ["p.s6_prompts.reframe_no_rescue"]);                                          // src: vvaharness/pipeline/stages/s6/prompts.py:162
        return p;
    }

    Prompt traitStampDuty(Theta θ) {
        // ## Two trait stamps, per finding (criteria live in s6/outcomes.py)
        Prompt p = new Prompt();
        p.must(θ["p.s6_prompts.duty_trait_stamps"]);                                            // src: vvaharness/pipeline/stages/s6/prompts.py:169
        p.rule(θ["p.s6_prompts.trait_stamps_no_verdict_effect"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:170
        return p;
    }

    Prompt repeatDuty(Theta θ) {
        // ## You have the file open: say where else it holds
        Prompt p = new Prompt();
        p.rule(θ["p.s6_prompts.duty_repeat_lines"]);                                            // src: vvaharness/pipeline/stages/s6/prompts.py:176
        p.must(θ["p.s6_prompts.repeat_lines_only_checked"]);                                    // src: vvaharness/pipeline/stages/s6/prompts.py:180
        return p;
    }

    Prompt extraDuty(Theta θ) {
        // ## Other defects in the same file
        Prompt p = new Prompt();
        p.rule(θ["p.s6_prompts.duty_additional_findings"]);                                     // src: vvaharness/pipeline/stages/s6/prompts.py:185
        p.evidence(θ["p.s6_prompts.additional_findings_evidence_bar"]);                         // src: vvaharness/pipeline/stages/s6/prompts.py:188
        return p;
    }

    Prompt cvssDuty(Theta θ) {
        // ## CVSS 3.1 base vector
        Prompt p = new Prompt();
        p.rule(θ["prompt.s6.cvss_duty"]);                                                       // src: vvaharness/pipeline/stages/s6/prompts.py:192
        p.format(θ["p.s6_prompts.duty_cvss_vector"]);                                           // src: vvaharness/pipeline/stages/s6/prompts.py:193
        p.choose(θ["p.s6_prompts.cvss_av_values"]);                                             // src: vvaharness/pipeline/stages/s6/prompts.py:194
        p.choose(θ["p.s6_prompts.cvss_ac_values"]);                                             // src: vvaharness/pipeline/stages/s6/prompts.py:195
        p.choose(θ["p.s6_prompts.cvss_pr_values"]);                                             // src: vvaharness/pipeline/stages/s6/prompts.py:196
        p.choose(θ["p.s6_prompts.cvss_ui_values"]);                                             // src: vvaharness/pipeline/stages/s6/prompts.py:197
        p.choose(θ["p.s6_prompts.cvss_scope_values"]);                                          // src: vvaharness/pipeline/stages/s6/prompts.py:198
        p.choose(θ["p.s6_prompts.cvss_cia_values"]);                                            // src: vvaharness/pipeline/stages/s6/prompts.py:199
        p.must(θ["p.s6_prompts.cvss_score_even_on_fp"]);                                        // src: vvaharness/pipeline/stages/s6/prompts.py:200
        p.forbid(θ["p.s6_prompts.cvss_empty_rather_than_invent"]);                              // src: vvaharness/pipeline/stages/s6/prompts.py:201
        return p;
    }

    Prompt outputExample(Theta θ) {
        // One confirmation with extra sites, one correction (CWE-862 -> CWE-352), one refutation.
        Prompt p = new Prompt();
        if (θ["p.s6_prompts.output_example_included"]) {                                        // src: vvaharness/pipeline/stages/s6/prompts.py:206
            p.format(θ["p.s6_prompts.outcome_fields"]);                                         // src: vvaharness/pipeline/stages/s6/prompts.py:209
        }
        return p;
    }

    @executedBy(CODE)
    String entryPointLines(ContextPackage ctx, Theta θ) {
        int limit = θ["p.s6_prompts.entry_points_limit"];                                       // src: vvaharness/pipeline/stages/s6/prompts.py:253
        List<String> eps = ctx.entryPoints.map(e -> e.kind + ": " + e.function + " @ " + e.file + (e.reachableFromUnauth ? " [UNAUTH-REACHABLE]" : "")); // src: vvaharness/pipeline/stages/s6/prompts.py:255
        if (eps.isEmpty()) return "";
        String more = eps.size() > limit ? "...(+" + (eps.size() - limit) + " more)" : "";      // src: vvaharness/pipeline/stages/s6/prompts.py:260
        return θ["p.s6_prompts.entry_points_verify_before_relying"] + eps.first(limit).join("\n") + more; // src: vvaharness/pipeline/stages/s6/prompts.py:261
    }

    @executedBy(CODE)
    Prompt buildSharedContext(ContextPackage ctx, Theta θ) {
        // Scan-constant half of the user turn; stays AHEAD of the per-finding body so it is cached.
        Prompt p = new Prompt();
        p.context(entryPointLines(ctx, θ));                                                     // src: vvaharness/pipeline/stages/s6/prompts.py:268
        if (θ["p.s6_prompts.architecture_notes_block"] && ctx.notes != null) p.context("ARCHITECTURE NOTES:\n" + ctx.notes); // src: vvaharness/pipeline/stages/s6/prompts.py:270
        return p;
    }

    @executedBy(CODE)
    Prompt controlsBlock(List<String> files, ContextPackage ctx, Theta θ) {
        // Design controls whose protects-globs match any file in this session.
        List<String> lines = files.flatMap(f -> ctx.designControls.filter(c -> c.protects.isEmpty() || c.protects.any(g -> fnmatch(f, g)))).distinct(); // src: vvaharness/pipeline/stages/s6/prompts.py:278
        Prompt p = new Prompt();
        if (lines.isEmpty()) return p;
        if (θ["p.s6_prompts.design_controls_block"]) p.context("DESIGN CONTROLS IN EFFECT ON THESE PATHS:\n" + lines.join("\n")); // src: vvaharness/pipeline/stages/s6/prompts.py:294
        p.must(θ["p.s6_prompts.control_bypass_required_for_tp"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:295
        return p;
    }

    @executedBy(CODE)
    Prompt findingBlock(String fid, Finding f, Theta θ) {
        // One finding's claim as filed; prose folded to one line so it cannot forge a header.
        Prompt p = new Prompt();
        p.format(θ["p.s6_prompts.finding_block_fields"]);                                       // src: vvaharness/pipeline/stages/s6/prompts.py:311
        p.context("FINDING " + fid + ": " + f.file + " " + f.lineStart + "-" + f.lineEnd + " " + f.cwe + " " + f.vulnClass + " " + f.title + " " + f.severity); // src: vvaharness/pipeline/stages/s6/prompts.py:312
        p.context("Claim / Exploit scenario as filed / Preconditions");                         // src: vvaharness/pipeline/stages/s6/prompts.py:318
        String snippet = f.codeSnippet.strip();
        if (!snippet.isEmpty()) {
            // S5 backfills snippets from raw file text; redacted so live secrets do not ship.
            snippet = S4Deepdive.redactSource(snippet, f.file, "s6");                           // src: vvaharness/pipeline/stages/s6/prompts.py:308
            p.rule(θ["p.s6_prompts.snippet_verify_against_file"]);                              // src: vvaharness/pipeline/stages/s6/prompts.py:309
            p.context(snippet);
        }
        return p;
    }

    @executedBy(CODE)
    Prompt batchDuty(List<String> ids, List<String> files, Theta θ) {
        // THIS SESSION CARRIES <n> FINDINGS, all in <where>: <ids>
        Prompt p = new Prompt();
        p.context("THIS SESSION CARRIES " + ids.size() + " FINDINGS: " + ids.join(", "));       // src: vvaharness/pipeline/stages/s6/prompts.py:329
        p.must(θ["p.s6_prompts.batch_own_outcome_per_finding"]);                                // src: vvaharness/pipeline/stages/s6/prompts.py:333
        p.rule(θ["p.s6_prompts.batch_omitted_finding_dropped"]);                                // src: vvaharness/pipeline/stages/s6/prompts.py:335
        p.rule(θ["p.s6_prompts.batch_shared_file_not_shared_evidence"]);                        // src: vvaharness/pipeline/stages/s6/prompts.py:337
        p.checklist(θ["p.s6_prompts.batch_same_verdict_recheck"]);                              // src: vvaharness/pipeline/stages/s6/prompts.py:340
        p.rule(θ["p.s6_prompts.batch_effort_by_need"]);                                         // src: vvaharness/pipeline/stages/s6/prompts.py:343
        return p;
    }

    @executedBy(CODE)
    Prompt sourceSection(String code, int nFiles, Theta θ) {
        Prompt p = new Prompt();
        if (code == null) {                                                                     // src: vvaharness/pipeline/stages/s6/prompts.py:351
            p.must(θ["p.s6_prompts.no_source_read_cited_files"]);                               // src: vvaharness/pipeline/stages/s6/prompts.py:352
            return p;
        }
        p.context("SOURCE CODE - all " + nFiles + " file(s), each inlined ONCE:\n" + code);     // src: vvaharness/pipeline/stages/s6/prompts.py:354
        p.tiebreak(θ["p.s6_prompts.inlined_source_authoritative"]);                             // src: vvaharness/pipeline/stages/s6/prompts.py:356
        return p;
    }

    @executedBy(CODE)
    Prompt buildVerifyPrompt(List<Item> items, ContextPackage ctx, String code, Theta θ) {
        List<String> ids = items.ids();
        List<String> files = items.files().distinct();                                          // src: vvaharness/pipeline/stages/s6/prompts.py:366
        Prompt p = new Prompt();
        if (items.size() > 1) p.include(batchDuty(ids, files, θ));                              // src: vvaharness/pipeline/stages/s6/prompts.py:369
        for (Item it : items) p.include(findingBlock(it.fid, it.f, θ));                         // src: vvaharness/pipeline/stages/s6/prompts.py:367
        p.include(controlsBlock(files, ctx, θ));                                                // src: vvaharness/pipeline/stages/s6/prompts.py:368
        p.include(sourceSection(code, files.size(), θ));                                        // src: vvaharness/pipeline/stages/s6/prompts.py:370
        p.must(θ["p.s6_prompts.one_outcome_per_finding_id"]);                                   // src: vvaharness/pipeline/stages/s6/prompts.py:371
        return p;
    }

    @executedBy(CODE)
    Prompt repairPrompt(String raw, List<String> ids, Theta θ) {
        // REPAIR TASK: the previous reply failed to parse as an outcomes object.
        Prompt p = new Prompt();
        p.must(θ["p.s6_prompts.repair_only_json"]);                                             // src: vvaharness/pipeline/stages/s6/prompts.py:380
        p.format("finding_id values MUST be exactly these, one entry each: " + ids);            // src: vvaharness/pipeline/stages/s6/prompts.py:381
        p.forbid(θ["p.s6_prompts.repair_no_reconsider"]);                                       // src: vvaharness/pipeline/stages/s6/prompts.py:381
        p.context("--- ORIGINAL REPLY ---\n" + raw);                                            // src: vvaharness/pipeline/stages/s6/prompts.py:383
        return p;
    }

    @executedBy(MODEL)
    List<VerificationOutcome> verifySession(List<Item> items, Theta θ) {
        // The procedure the SYSTEM + VERIFY prompts ask the model to carry out, per finding.
        List<VerificationOutcome> out = new List();
        for (Item it : items) {                                                                 // src: vvaharness/pipeline/stages/s6/prompts.py:333
            Code code = open(it.f.file, it.f.lineStart);                                        // src: vvaharness/pipeline/stages/s6/prompts.py:110
            Path path = walkCallersToEntryPoint(code);                                          // src: vvaharness/pipeline/stages/s6/prompts.py:111
            String verdict;
            if (!evidenceReachable(it)) verdict = "INCONCLUSIVE";                               // src: vvaharness/pipeline/stages/s6/prompts.py:91
            else if (path == null) verdict = "FALSE_POSITIVE";                                  // src: vvaharness/pipeline/stages/s6/prompts.py:112
            else if (matchesExclusionRule(it, θ["p.s6_prompts.exclusion_rules_header"])) verdict = "FALSE_POSITIVE"; // src: vvaharness/pipeline/stages/s6/prompts.py:30
            else {
                Defence d = tryToKill(path, θ["p.s6_prompts.method_step3_try_to_kill"]);        // src: vvaharness/pipeline/stages/s6/prompts.py:113
                if (d != null && d.coversEveryRoute()) verdict = "FALSE_POSITIVE";              // src: vvaharness/pipeline/stages/s6/prompts.py:117
                else verdict = "TRUE_POSITIVE";
            }
            // An unestablished refutation becomes INCONCLUSIVE.
            if (verdict == "FALSE_POSITIVE" && !refutationEstablished(it)) verdict = "INCONCLUSIVE"; // src: vvaharness/pipeline/stages/s6/prompts.py:95
            VerificationOutcome o = new VerificationOutcome(it.fid, verdict, scoreEvidence());
            if (verdict == "TRUE_POSITIVE" && labelImprecise(it)) o.correctedCwe = supportedCwe(it); // src: vvaharness/pipeline/stages/s6/prompts.py:138
            if (verdict == "TRUE_POSITIVE" && anchoredOnHeader(it)) o.correctedLineStart = sinkLine(it); // src: vvaharness/pipeline/stages/s6/prompts.py:141
            o.confirmedRepeatLines = checkedUnfiledRepeats(it);                                 // src: vvaharness/pipeline/stages/s6/prompts.py:176
            o.additionalFindings = distinctPointableDefects(it);                                // src: vvaharness/pipeline/stages/s6/prompts.py:185
            o.cvssVector = justifiedVectorOrEmpty(it);                                          // src: vvaharness/pipeline/stages/s6/prompts.py:200
            out.add(o);
        }
        return out;
    }
}
