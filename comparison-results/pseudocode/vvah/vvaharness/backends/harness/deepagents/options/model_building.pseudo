// file: vvaharness/backends/harness/deepagents/options/model_building.py
// Resolves a model id to a chat model (Anthropic or OpenAI-compatible) with timeout, retries, output ceiling and
// reasoning/thinking settings; also owns the REASON_IN_PROMPT suffix used when think_in_prompt replaces native reasoning.
// (TLS/proxy/client-injection plumbing omitted.)

@executedBy(CODE) @role(backend)
class ModelBuilding {

    // True when think_in_prompt applies: every route except Anthropic models that refuse it.
    boolean reasonsInPrompt(String modelId, String provider, Theta θ) {
        if (!routesToAnthropic(modelId, provider)) return true;                                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:380
        // thinking cannot be disabled there and REASON_IN_PROMPT is refused as reasoning extraction
        return !regex(θ["p.model_building.no_reason_in_prompt_models"]).search(modelId);                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:374
    }

    Map<String, Object> anthropicThinkingKwargs(Effort effort, boolean inPrompt) {
        String mapped = ANTHROPIC_EFFORT_MAP.get(effort);                                                // src: vvaharness/backends/harness/deepagents/options/model_building.py:388
        if (mapped == null) return inPrompt ? Map.of("thinking", "disabled") : Map.of();                 // src: vvaharness/backends/harness/deepagents/options/model_building.py:390
        if (inPrompt) return Map.of("thinking", "disabled", "effort", mapped);                           // src: vvaharness/backends/harness/deepagents/options/model_building.py:394
        return Map.of("thinking", "adaptive", "effort", mapped);                                         // src: vvaharness/backends/harness/deepagents/options/model_building.py:395
    }

    ChatModel buildModel(String modelId, Env env, String provider, Effort effort, Boolean useResponsesApi, boolean thinkInPrompt, Theta θ) {
        thinkInPrompt = thinkInPrompt && reasonsInPrompt(modelId, provider, θ);                          // src: vvaharness/backends/harness/deepagents/options/model_building.py:470
        Duration requestTimeout = effortScaledSeconds(DeepagentsLimits.modelTimeoutSeconds(θ), effort);  // src: vvaharness/backends/harness/deepagents/options/model_building.py:475
        if (routesToAnthropic(modelId, provider)) {                                                      // src: vvaharness/backends/harness/deepagents/options/model_building.py:478
            return new ForcingChatAnthropic(modelId, requestTimeout, DeepagentsLimits.modelMaxRetries(θ),
                DeepagentsLimits.modelMaxOutputTokens(θ), anthropicThinkingKwargs(effort, thinkInPrompt)); // src: vvaharness/backends/harness/deepagents/options/model_building.py:480
        }
        boolean responses = resolveUseResponsesApi(modelId, provider, useResponsesApi);                  // src: vvaharness/backends/harness/deepagents/options/model_building.py:503
        // reasoning_effort mapped per tier, stepped down after rejections; "none" for reasoning-off models under think_in_prompt
        Map<String, Object> effortKwargs = thinkInPrompt ? reasoningOffKwargs(modelId) : effortKwargs(modelId, effort, responses); // src: vvaharness/backends/harness/deepagents/options/model_building.py:455
        return new ToolCallStateChatOpenAI(modelId, requestTimeout, DeepagentsLimits.modelMaxRetries(θ), effortKwargs, responses); // src: vvaharness/backends/harness/deepagents/options/model_building.py:506
    }
}

@executedBy(MODEL) @role(prompt)
class ReasonInPromptPrompt {

    // Appended to the system prompt (graph_builder.py:408) when think_in_prompt && reasonsInPrompt.
    Prompt reasonInPrompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.reason_in_prompt"]);                                                            // src: vvaharness/backends/harness/deepagents/options/model_building.py:364
        p.must(θ["p.model_building.reason_in_writing_before_answer"]);   // "REASONING: think it through in writing before you answer" // src: vvaharness/backends/harness/deepagents/options/model_building.py:365
        p.rule(θ["p.model_building.name_candidate_and_refuting_control"]); // name each candidate and the refuting control; discard what does not hold // src: vvaharness/backends/harness/deepagents/options/model_building.py:366
        p.format(θ["p.model_building.reasoning_compact"]);               // no restating input, no recap       // src: vvaharness/backends/harness/deepagents/options/model_building.py:367
        return p;
    }
}
