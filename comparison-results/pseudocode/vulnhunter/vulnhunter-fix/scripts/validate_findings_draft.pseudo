// file: vulnhunter-fix/scripts/validate_findings_draft.py
// Deterministic Step-5a draft-shape validation: fail at the first violation; extra keys and empty strings are allowed.

// source class name: ValidationError (a ValueError subclass); raised on the first rule violation
@executedBy(CODE) @role(types)
record FindingsDraftValidationError(String message) { }

@executedBy(CODE) @role(tool) @stage("fix")
class ValidateFindingsDraft {
    @src("vulnhunter-fix/scripts/validate_findings_draft.py:59")
    int validatePayload(Object payload, Theta θ) {
        if (!(payload instanceof Map)) throw new FindingsDraftValidationError("top-level must be object");
        if (!Set.copyOf(payload.keys()).containsAll(θ["code.fix.scripts.validate_findings_draft.required_top_keys"])) throw new FindingsDraftValidationError("missing top-level keys"); // src: vulnhunter-fix/scripts/validate_findings_draft.py:43
        Object findings = payload.get("findings"); if (!(findings instanceof List)) throw new FindingsDraftValidationError("findings must be list");
        for (Indexed f : enumerate(findings)) { try { validateFinding(f.value, θ); } catch (FindingsDraftValidationError e) { throw new FindingsDraftValidationError("findings[" + f.index + "]: " + e.message); } }
        return findings.size();
    }
    @src("vulnhunter-fix/scripts/validate_findings_draft.py:87")
    void validateFinding(Object f, Theta θ) {
        if (!(f instanceof Map)) throw new FindingsDraftValidationError("finding must be object");
        Set required = θ["code.fix.scripts.validate_findings_draft.required_finding_keys"]; // src: vulnhunter-fix/scripts/validate_findings_draft.py:44
        if (!Set.copyOf(f.keys()).containsAll(required)) throw new FindingsDraftValidationError("missing finding keys");
        for (String key : required.minus(Set.of("proposed_fix"))) if (!(f.get(key) instanceof String)) throw new FindingsDraftValidationError("field must be string: " + key);
        if (!Regex.compile(θ["code.fix.scripts.validate_findings_draft.vuln_id_re"]).match(f.get("id"))) throw new FindingsDraftValidationError("invalid finding id"); // src: vulnhunter-fix/scripts/validate_findings_draft.py:50
        if (truthy(f.get("primary_cwe")) && !Regex.compile(θ["code.fix.scripts.validate_findings_draft.primary_cwe_re"]).match(f.get("primary_cwe"))) throw new FindingsDraftValidationError("invalid primary CWE"); // src: vulnhunter-fix/scripts/validate_findings_draft.py:51
        if (!θ["code.fix.scripts.validate_findings_draft.accepted_severities"].contains(f.get("severity"))) throw new FindingsDraftValidationError("invalid severity"); // src: vulnhunter-fix/scripts/validate_findings_draft.py:52
        if (f.get("status") != θ["code.fix.scripts.validate_findings_draft.required_status"]) throw new FindingsDraftValidationError("finding must be confirmed"); // src: vulnhunter-fix/scripts/validate_findings_draft.py:111
        Object fix = f.get("proposed_fix"); if (!(fix instanceof Map)) throw new FindingsDraftValidationError("proposed_fix must be object");
        Set fixKeys = θ["code.fix.scripts.validate_findings_draft.required_fix_keys"]; // src: vulnhunter-fix/scripts/validate_findings_draft.py:48
        if (!Set.copyOf(fix.keys()).containsAll(fixKeys)) throw new FindingsDraftValidationError("missing proposed_fix keys");
        for (String key : fixKeys) if (!(fix.get(key) instanceof String)) throw new FindingsDraftValidationError("proposed_fix field must be string");
    }
    @src("vulnhunter-fix/scripts/validate_findings_draft.py:134")
    int mainWithArgv(List<String> argv, Theta θ) {
        Path path = parseRequiredPathArgument(argv); Object payload;
        try { payload = Json.parse(path.readText()); } catch (FileNotFoundError | JsonDecodeError e) { printError(e); return 1; }
        int count;
        try { count = validatePayload(payload, θ); } catch (FindingsDraftValidationError e) { printError(e); printError("rerun Step 5a subagent"); return 1; }
        print("ok", count); return 0;
    }
    @src("vulnhunter-fix/scripts/validate_findings_draft.py:160")
    int main(Theta θ) {
        return mainWithArgv(processArgsWithoutProgram(), θ);
    }
}
