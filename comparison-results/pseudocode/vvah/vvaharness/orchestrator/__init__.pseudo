// file: vvaharness/orchestrator/__init__.py
// Orchestrator package facade: re-exports the scan entry, batch runner, checkpoint helpers, config path
// helpers and preflight probes so callers (and tests) reach them as vvaharness.orchestrator.<name>.

@executedBy(CODE) @role(pipeline)
class Orchestrator {

    /** Re-exported scan entry points. */
    void exports() {
        // run_batch, main, scan_repo                                                                  // src: vvaharness/orchestrator/__init__.py:21
        // load_ckpt, run_id_for, save_ckpt                                                            // src: vvaharness/orchestrator/__init__.py:22
        // _default_config, trusted_config                                                             // src: vvaharness/orchestrator/__init__.py:31
        // check_backends, configure_backends, probe_backends and two probe helpers                    // src: vvaharness/orchestrator/__init__.py:38
    }

    ScanOutcome scanRepo(Path repo, String repoName, String applicationId, Args args, Config cfg, Theta θ) {
        return OrchestratorScan.run(repo, repoName, applicationId, args, cfg, null, null, θ);          // src: vvaharness/orchestrator/__init__.py:56
    }

    int main(List<String> argv, Theta θ) {
        return OrchestratorEntry.main(argv, θ);                                                        // src: vvaharness/orchestrator/__init__.py:37
    }

    Object loadCkpt(Path ckptDir, String runId, String step) {
        return Checkpoints.loadCkpt(ckptDir, runId, step);                                             // src: vvaharness/orchestrator/__init__.py:23
    }

    void saveCkpt(Path ckptDir, String runId, String step, Object obj) {
        Checkpoints.saveCkpt(ckptDir, runId, step, obj);                                               // src: vvaharness/orchestrator/__init__.py:29
    }

    String runIdFor(Path repo) {
        return Checkpoints.runIdFor(repo);                                                             // src: vvaharness/orchestrator/__init__.py:26
    }
}
