// file: vvaharness/backends/harness/claude/models.py
// The Claude backend's SDK-to-harness exception mapping. ProcessError is absent by design
// (wrap_sdk_error copies its exit code and stderr tail itself).

@executedBy(CODE) @role(types)
class ClaudeModels {
    List<Pair> sdkErrorMap() {
        return List.of(
            Pair.of(CLINotFoundError, HarnessCLINotFoundError),                                          // src: vvaharness/backends/harness/claude/models.py:37
            Pair.of(CLIConnectionError, HarnessConnectionError),                                         // src: vvaharness/backends/harness/claude/models.py:38
            Pair.of(CLIJSONDecodeError, HarnessJSONDecodeError),                                         // src: vvaharness/backends/harness/claude/models.py:39
            Pair.of(MessageParseError, HarnessMessageParseError));                                       // src: vvaharness/backends/harness/claude/models.py:40
    }
}
