# vvaharness/remediation_agent/report_parser/field_sections.py

Regular expressions for the metadata lines under a finding header in the Markdown report, and helpers that split a finding block into `#### Heading` sections.

Source: `vvaharness/remediation_agent/report_parser/field_sections.py` (lines 1-66)
Executor: code
Called from: `report_parser/fields.sudo` parse_finding_fields

// src: vvaharness/remediation_agent/report_parser/field_sections.py:20-33
_CLASS_RE = /^\*\*Class:\*\*\s*(.+?)\s*$/
_CWE_RE = /^\*\*CWE:\*\*\s*(CWE-\d+)/
_CVSS_SCORE_RE = /^\*\*CVSS 3\.1:\*\*\s*\*\*([0-9.]+)\*\*\s*\(([^)]+)\)\s*—\s*`([^`]+)`/   // score, rating, vector
_CVSS_VECONLY_RE = /^\*\*CVSS 3\.1:\*\*\s*`([^`]+)`/   // vector without a score
_SOURCE_RE = /^\*\*Source:\*\*\s*`?([^`]+?)`?\s*$/   // taint evidence; the bundled renderer does not emit it, but a report that does must not lose it
_SINK_RE = /^\*\*Sink:\*\*\s*`?([^`]+?)`?\s*$/
_VERDICT_RE = /^\*\*Verdict:\*\*\s*(\w+)\s*\(confidence:\s*(?:(\d+)\/10|not scored)\)\s*—?\s*(.*)$/   // group 2 is null when not scored
_FILELOC_RE = /^(.*?):(\d+)(?:-(\d+))?$/

// src: vvaharness/remediation_agent/report_parser/field_sections.py:36-43
fn _file_loc(ref):executor=code {
  match (trimmed ref against _FILELOC_RE) {
    case no match => return [trimmed ref, 0, 0]
    default => return [group 1 trimmed, start = group 2, end = group 3 or start]
  }
}

// src: vvaharness/remediation_agent/report_parser/field_sections.py:46-60
fn _sections(body):executor=code {
  // keys are lower-cased "#### Heading" texts; text before the first heading is stored under ""
  split body at lines matching /^####\s+(.+?)\s*$/ and return { lower-cased heading: trimmed text below it }
  // a repeated heading overwrites the earlier section
}

// src: vvaharness/remediation_agent/report_parser/field_sections.py:63-66
fn _first_code_block(text):executor=code { return contents of the first ``` fenced block in text, or "" }
