# vvaharness/pipeline/stages/s5/reanchor.py

Deterministic sink-line re-anchor for Python findings that Stage 4 anchored on a function or class header: the finding moves to the nearest sink call in that scope's own body (or to its own same-file sink_ref), within a move cap. Anything else is left unchanged.

Source: `vvaharness/pipeline/stages/s5/reanchor.py` (lines 1-227)
Executor: code
Called from: `vvaharness/pipeline/stages/s5/enrich.py` enrich (constructed in `s5/__init__.py` run when step5_prefilter.sink_reanchor)

// src: vvaharness/pipeline/stages/s5/reanchor.py:29-38
fn sink_patterns_by_cwe():executor=code {
  return for each spec in default_corpus() with role == "sink" and a weakness_key(spec.cwe): weakness key -> compiled spec.pattern list   // external to this batch: vvaharness/detect/patterns
}

// src: vvaharness/pipeline/stages/s5/reanchor.py:120-227
Reanchorer {
  cache; by_cwe; max_move   // max_move = knob("step5_prefilter.sink_reanchor_max_move_lines", default=40), read in s5/__init__.sudo
  parsed = {}               // least-recently-used, at most _MAX_PARSED_FILES = 16 files (src: :107, :150-151); a parse failure is cached as null

  // src: vvaharness/pipeline/stages/s5/reanchor.py:172-227
  fn apply(f):executor=code {
    // a same-file sink_ref is a CANDIDATE, never a veto: the header gate and move cap still bound it
    own_sink = _own_sink_line(f)
    if (own_sink == null) {
      patterns = by_cwe[weakness_key(f.cwe)]
      if (patterns is empty) return f                                  // s5_reanchor_no_pattern
    }
    parsed = if (f.file ends with ".py") _file(f.file) else null       // Python only
    if (parsed == null) return f                                       // s5_reanchor_unparsed
    line = max(1, f.line_start)
    [scope, header] = _innermost_scope(parsed.scopes, line)
    if (scope == null) return f                                        // s5_reanchor_no_scope
    // header gate: only a line in [header, first body line) moves; upper bound exclusive, max(..., header + 1) keeps one-line suites
    if (!(header <= line < max(_first_body_line(scope), header + 1))) return f   // s5_reanchor_body_anchored
    // an own sink_ref that IS the header is the mis-anchor to fix: fall back to the patterns
    if (own_sink != null && own_sink == line && line < _first_body_line(scope)) {
      own_sink = null
      patterns = by_cwe[weakness_key(f.cwe)]
      if (patterns is empty) return f
    }
    candidates = if (own_sink != null) [own_sink] else _sink_lines(calls in scope's own body, patterns)
    if (candidates is empty) return f                                  // s5_reanchor_no_sink
    sink = candidate minimizing (|candidate - line|, candidate)
    if (sink == line) return f                                         // already at sink
    if (|sink - line| > max_move) return f                             // s5_reanchor_capped
    moved = copy of f with line_start = sink, line_end = max(f.line_end, sink)
    if (f.sink_ref is blank) { moved.sink_ref = "${f.file}:$sink"; moved.backfilled_refs += "sink_ref" }   // same provenance as enrich's own ref fill
    moved.code_snippet = s5.enrich.snippet(moved, cache.lines(f.file) or [])   // recentred so Stage 6 reads the sink statement, not the header
    COUNTERS.bump("s5_sink_reanchored")
    return moved
  }

  // src: vvaharness/pipeline/stages/s5/reanchor.py:161-170
  fn _own_sink_line(f):executor=code {
    [path, ln] = f.sink_ref split at its last ":"
    if (path != f.file || ln is not all digits) return null
    if (file unreadable || !(1 <= ln <= line count)) return null
    return ln
  }

  // src: vvaharness/pipeline/stages/s5/reanchor.py:131-152
  fn _file(rel):executor=code {
    // scope index: (header start, end line, node) for every function, async function and class in ast.parse of the file
    // SyntaxError (for example Python 2 only files), ValueError, MemoryError, RecursionError => null
  }
}

// src: vvaharness/pipeline/stages/s5/reanchor.py:41-45
fn _header_start(node):executor=code { return min(line of each decorator, node's own line) }
// src: vvaharness/pipeline/stages/s5/reanchor.py:48-50
fn _first_body_line(scope):executor=code { return _header_start(scope.body[0]) }

// src: vvaharness/pipeline/stages/s5/reanchor.py:58-66
fn _innermost_scope(scopes, line):executor=code {
  return the scope with the greatest header among those whose header..end contains line, with that header (or [null, 0])
}

// src: vvaharness/pipeline/stages/s5/reanchor.py:69-103 — _own_nodes, _callee_text, _scope_calls and _sink_lines together
fn _sink_lines(calls, patterns):executor=code {
  // calls = (line, rendered callee + "(") for every Call node in the scope's OWN body; the walk stops at nested functions, classes and lambdas,
  //   except that a class scope also includes its methods' direct bodies (src: :72-75)
  // the callee text is ast.unparse(node.func) + "(", never the raw line; an unrenderable callee matches nothing
  return sorted distinct lines whose callee matches any pattern
}
