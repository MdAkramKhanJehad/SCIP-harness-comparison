// file: vulnhunter-fix/references/cwe-fix-patterns.md
// Rule book (REQ-CWE-002, REQ-CWE-003): five CWE classes, each with CWE IDs, canonical fix shape, discrimination criteria, FULL-tier bar.
// Read by prompts/plan.md (Phase 2 CWE routing), prompts/implement.md (Phase 3) and the five prompts/worker_agent_*.md workers;
// also used by sweep-algorithm.md Pass 2 to pick the CWE class.

@executedBy(MODEL) @role(rule_set) @stage("fix.implement")
class CweFixPatterns {

    // Entry: route a finding to its class worker and apply that class's fix shape, discrimination test and FULL bar.
    String run(Finding f, PlanArtifact plan, Theta θ) {
        List<String> sections = θ["p.cwe-fix-patterns.class_contents"];                                     // src: vulnhunter-fix/references/cwe-fix-patterns.md:8
        String cls = classify(f.primaryCwe, θ);
        if (cls == null) return unmapped(f, θ);
        if (θ["p.cwe-fix-patterns.patterns_mandatory_deviation_needs_rationale"]) {                         // src: vulnhunter-fix/references/cwe-fix-patterns.md:10
            if (plan.deviatesFromPattern(cls)) plan.require("explicit deviation rationale");
        }
        if (cls == "authz") return authz(f, plan, θ);
        if (cls == "injection") return injection(f, plan, θ);
        if (cls == "crypto") return crypto(f, plan, θ);
        if (cls == "resource") return resource(f, plan, θ);
        return config(f, plan, θ);
    }

    String classify(String cwe, Theta θ) {
        if (θ["p.cwe-fix-patterns.authz_cwe_set"].contains(cwe)) return "authz";                            // src: vulnhunter-fix/references/cwe-fix-patterns.md:17
        if (θ["p.cwe-fix-patterns.injection_cwe_set"].contains(cwe)) return "injection";                    // src: vulnhunter-fix/references/cwe-fix-patterns.md:43
        if (θ["p.cwe-fix-patterns.crypto_cwe_set"].contains(cwe)) return "crypto";                          // src: vulnhunter-fix/references/cwe-fix-patterns.md:78
        if (θ["p.cwe-fix-patterns.resource_cwe_set"].contains(cwe)) return "resource";                      // src: vulnhunter-fix/references/cwe-fix-patterns.md:111
        if (θ["p.cwe-fix-patterns.config_class_scope"] && isIacOrIamWithoutNumericCwe(cwe)) return "config"; // src: vulnhunter-fix/references/cwe-fix-patterns.md:140
        return null;
    }

    String unmapped(Finding f, Theta θ) {
        Log.diagnostic("unmapped CWE " + f.primaryCwe);                                                      // REQ-CWE-003
        return Worker.route(f, θ["p.cwe-fix-patterns.unmapped_cwe_routing"]);                                // src: vulnhunter-fix/references/cwe-fix-patterns.md:164
    }

    // Class 1: worker_agent_authz.md
    String authz(Finding f, PlanArtifact plan, Theta θ) {
        Fix fix = new Fix();
        if (θ["p.cwe-fix-patterns.authz_identify_resource"]) fix.target = f.subjectAndObject();                         // src: vulnhunter-fix/references/cwe-fix-patterns.md:20
        if (θ["p.cwe-fix-patterns.authz_check_earliest_path"]) fix.place("middleware | route decorator | method entry"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:21
        if (θ["p.cwe-fix-patterns.authz_fail_closed"]) fix.defaultDeny().allowAfterIdentityRoleCheck("owner or ACL");    // src: vulnhunter-fix/references/cwe-fix-patterns.md:23
        if (θ["p.cwe-fix-patterns.authz_server_side_check"]) fix.forbid("X-User-Id header / query param as sole identity"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:25
        // discrimination: pre-fix user A reads/mutates user B's resource
        String expected = θ["p.cwe-fix-patterns.authz_discrimination"];                                     // src: vulnhunter-fix/references/cwe-fix-patterns.md:31
        Test t = Test.of(f, "pre: A touches B's resource", "post: " + expected);
        boolean full = true;
        if (θ["p.cwe-fix-patterns.authz_full_all_callers_rerouted"]) full &= fix.allCallersRerouted();      // src: vulnhunter-fix/references/cwe-fix-patterns.md:34
        if (θ["p.cwe-fix-patterns.authz_full_no_bypass_fallback"]) full &= !fix.hasFallbackBypass();        // e.g. if is_admin or legacy_flag  src: vulnhunter-fix/references/cwe-fix-patterns.md:35
        full &= t.distinctUserContexts() >= θ["p.cwe-fix-patterns.authz_full_two_user_contexts"];          // src: vulnhunter-fix/references/cwe-fix-patterns.md:37
        return full ? "FULL" : "NOT_FULL";
    }

    // Class 2: worker_agent_injection.md
    String injection(Finding f, PlanArtifact plan, Theta θ) {
        Fix fix = new Fix();
        Sink sink = f.identifySink(θ["p.cwe-fix-patterns.injection_identify_sink"]);                        // src: vulnhunter-fix/references/cwe-fix-patterns.md:46
        if (θ["p.cwe-fix-patterns.injection_structural_separator"]) {                                        // src: vulnhunter-fix/references/cwe-fix-patterns.md:48
            if (sink.kind == SQL && θ["p.cwe-fix-patterns.injection_sql_parameterized"]) fix.use("parameterized query / prepared statement");  // src: vulnhunter-fix/references/cwe-fix-patterns.md:50
            else if (sink.kind == SHELL && θ["p.cwe-fix-patterns.injection_shell_argv"]) fix.use("argv list shell=False or whitelist-validated arg"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:51
            else if (sink.kind == HTML && θ["p.cwe-fix-patterns.injection_html_autoescape"]) fix.use("context-aware auto-escape at render");  // src: vulnhunter-fix/references/cwe-fix-patterns.md:53
            else if (sink.kind == PATH && θ["p.cwe-fix-patterns.injection_path_canonicalize"]) fix.use("canonicalize + prefix-match allowlist root"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:54
            else if (sink.kind == DESERIALIZE && θ["p.cwe-fix-patterns.injection_deserialization_schema"]) fix.use("schema-validated JSON; never pickle untrusted"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:55
            else if (sink.kind == XML && θ["p.cwe-fix-patterns.injection_xml_no_entities"]) fix.use("parser resolve_entities=False");  // src: vulnhunter-fix/references/cwe-fix-patterns.md:57
            else if (sink.kind == URL && θ["p.cwe-fix-patterns.injection_url_allowlist"]) fix.use("scheme+host allowlist or DNS+IP re-resolution blocklist"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:58
        }
        if (θ["p.cwe-fix-patterns.injection_reject_not_sanitize"] && fix.sanitizesInsteadOfRejects()) {      // src: vulnhunter-fix/references/cwe-fix-patterns.md:60
            return "MITIGATION";                                                                              // sanitization is a MITIGATION signal
        }
        if (θ["p.cwe-fix-patterns.injection_discrimination"]) {                                             // src: vulnhunter-fix/references/cwe-fix-patterns.md:65
            Test.of(f, "pre: PoC executes/exfiltrates/redirects", "post: rejected at boundary with structured error");
        }
        boolean full = true;
        if (θ["p.cwe-fix-patterns.injection_full_safe_api_only"]) full &= sink.onlySafeApi();               // src: vulnhunter-fix/references/cwe-fix-patterns.md:68
        if (θ["p.cwe-fix-patterns.injection_full_no_ambient_input"]) full &= sink.noAmbientInput();         // src: vulnhunter-fix/references/cwe-fix-patterns.md:70
        if (θ["p.cwe-fix-patterns.injection_full_exact_poc_payload"]) full &= f.test.payload == f.pocPayload; // src: vulnhunter-fix/references/cwe-fix-patterns.md:72
        return full ? "FULL" : "NOT_FULL";
    }

    // Class 3: worker_agent_crypto.md
    String crypto(Finding f, PlanArtifact plan, Theta θ) {
        Fix fix = new Fix();
        if (θ["p.cwe-fix-patterns.crypto_approved_algorithm"]) fix.use(Yaml.load("references/approved-crypto-algorithms.yaml")); // src: vulnhunter-fix/references/cwe-fix-patterns.md:81
        fix.keySource(θ["p.cwe-fix-patterns.crypto_approved_key_source"]);                                // never env vars, literals, filesystem  src: vulnhunter-fix/references/cwe-fix-patterns.md:83
        if (θ["p.cwe-fix-patterns.crypto_rotation_same_commit"]) fix.addRotationInSameCommit();             // src: vulnhunter-fix/references/cwe-fix-patterns.md:86
        if (θ["p.cwe-fix-patterns.crypto_transport_tls"]) fix.enforceTlsAtBoundary();                       // src: vulnhunter-fix/references/cwe-fix-patterns.md:88
        if (θ["p.cwe-fix-patterns.crypto_discrimination"]) {                                                // src: vulnhunter-fix/references/cwe-fix-patterns.md:93
            Test.of(f, "pre: forge/replay/brute-force works", "post: same attempt fails; signature/HMAC enforced");
        }
        for (String b : θ["p.cwe-fix-patterns.crypto_full_four_booleans"]) {                               // src: vulnhunter-fix/references/cwe-fix-patterns.md:97
            if (!plan.cryptoTrustChain.get(b)) {
                ResidualRiskRules.r5CryptoResiduals(f.result, f, θ);                                         // src: vulnhunter-fix/references/cwe-fix-patterns.md:104
                return θ["p.cwe-fix-patterns.crypto_any_false_is_mitigation"];                              // src: vulnhunter-fix/references/cwe-fix-patterns.md:103
            }
        }
        return "FULL";
    }

    // Class 4: worker_agent_resource.md
    String resource(Finding f, PlanArtifact plan, Theta θ) {
        Fix fix = new Fix();
        if (θ["p.cwe-fix-patterns.resource_identify"]) fix.target = f.resource();                          // CPU/memory/handles/log volume/sensitive fields  src: vulnhunter-fix/references/cwe-fix-patterns.md:114
        if (f.primaryCwe == "CWE-400") fix.boundedLimit(θ["p.cwe-fix-patterns.resource_cwe400_bounded_limit"]).structuredErrorOnBreach(); // src: vulnhunter-fix/references/cwe-fix-patterns.md:116
        if (f.primaryCwe == "CWE-362") fix.atomicOp(θ["p.cwe-fix-patterns.resource_cwe362_atomic"]);      // src: vulnhunter-fix/references/cwe-fix-patterns.md:118
        if ((f.primaryCwe == "CWE-117" || f.primaryCwe == "CWE-532") && θ["p.cwe-fix-patterns.resource_log_masking_at_call_site"]) {    // src: vulnhunter-fix/references/cwe-fix-patterns.md:120
            fix.maskPiiAtLogCallSite().structuredFields();                                                   // never at transport layer
        }
        if (f.primaryCwe == "CWE-200" && θ["p.cwe-fix-patterns.resource_cwe200_remove_field"]) fix.removeFieldFromResponse(); // src: vulnhunter-fix/references/cwe-fix-patterns.md:123
        if (θ["p.cwe-fix-patterns.resource_discrimination"]) {                                              // src: vulnhunter-fix/references/cwe-fix-patterns.md:129
            Test.of(f, "pre: exhaustion succeeds / field leaks", "post: bounded error / field absent");
        }
        boolean full = true;
        if (θ["p.cwe-fix-patterns.resource_full_correct_layer"]) full &= fix.atSink();                      // src: vulnhunter-fix/references/cwe-fix-patterns.md:132
        if (θ["p.cwe-fix-patterns.resource_full_no_unbounded_fallback"]) full &= !fix.hasUnboundedFallback(); // src: vulnhunter-fix/references/cwe-fix-patterns.md:133
        if (θ["p.cwe-fix-patterns.resource_full_test_observes_effect"]) full &= f.test.observesExhaustionOrLeak(); // src: vulnhunter-fix/references/cwe-fix-patterns.md:134
        return full ? "FULL" : "NOT_FULL";
    }

    // Class 5: worker_agent_config.md
    String config(Finding f, PlanArtifact plan, Theta θ) {
        Fix fix = new Fix();
        if (θ["p.cwe-fix-patterns.config_modify_declarative_artifact"]) fix.editDeclarative("Terraform | CloudFormation | k8s manifest | Helm"); // src: vulnhunter-fix/references/cwe-fix-patterns.md:143
        if (θ["p.cwe-fix-patterns.config_least_privilege"]) fix.denyPublicWildcard().allowRequiredPrincipalsOnly(); // src: vulnhunter-fix/references/cwe-fix-patterns.md:145
        if (θ["p.cwe-fix-patterns.config_enable_control_at_source"]) fix.enableControlAtSource();          // src: vulnhunter-fix/references/cwe-fix-patterns.md:147
        String tool = θ["p.cwe-fix-patterns.config_discrimination_static_tool"];                           // src: vulnhunter-fix/references/cwe-fix-patterns.md:151
        Test.of(f, "pre: " + tool + " reports finding", "post: same tool reports it gone");
        if (θ["p.cwe-fix-patterns.config_no_tdd_required"]) plan.skipPythonTdd();                           // src: vulnhunter-fix/references/cwe-fix-patterns.md:157
        boolean full = true;
        if (θ["p.cwe-fix-patterns.config_full_no_drift_corrector"]) full &= !fix.reliesOnDriftCorrector();  // src: vulnhunter-fix/references/cwe-fix-patterns.md:155
        return full ? "FULL" : "NOT_FULL";
    }
}
