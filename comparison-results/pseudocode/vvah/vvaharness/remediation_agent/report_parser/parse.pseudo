// file: vvaharness/remediation_agent/report_parser/parse.py
// Finding-header parsing and the done-marker that lets "done" survive across runs in the report itself.

@executedBy(CODE) @role(step) @stage("S10")
class ReportParserParse {

    // Invisible marker appended to a finding header once remediated.
    String DONE_MARKER = θ["code.remediation_agent.report_parser.parse.done_marker"];                // src: vvaharness/remediation_agent/report_parser/parse.py:25

    // Finding header "### 1. [CRITICAL] title"; the trailing optional group captures the done marker. Case-insensitive; severities limited to the five listed.
    Regex HEADER_RE = Regex.ignoreCase("^###\\s+(\\d+)\\.\\s*\\[(CRITICAL|HIGH|MEDIUM|LOW|INFO)\\]\\s*(.+?)\\s*(<!--\\s*remediation-agent:done\\s*-->)?\\s*$"); // src: vvaharness/remediation_agent/report_parser/parse.py:28
    // The "**File:** `routers/search.py:174-174`" line emitted under each header.
    Regex FILE_RE = Regex.of("^\\*\\*File:\\*\\*\\s*`([^`]+)`");                                      // src: vvaharness/remediation_agent/report_parser/parse.py:34

    // Extract findings from a scan report's Markdown as typed remediation targets.
    List<Target> parseFindings(String mdText, Theta θ) {
        return parseBlocks(mdText).map(parsed -> new Target(Fields.toScanFinding(parsed, θ), parsed.index, parsed.done)); // an unparseable vuln class raises out of the whole parse // src: vvaharness/remediation_agent/report_parser/parse.py:37
    }

    // Split the text into per-finding markdown blocks, as parse intermediates.
    List<ReportParserFinding> parseBlocks(String mdText) {
        List<ReportParserFinding> findings = new ArrayList();
        ReportParserFinding current = null;                                                                // src: vvaharness/remediation_agent/report_parser/parse.py:46
        List<String> buf = new ArrayList();
        for (String line : mdText.splitlines()) {                                                    // src: vvaharness/remediation_agent/report_parser/parse.py:49
            Match m = HEADER_RE.match(line);                                                         // src: vvaharness/remediation_agent/report_parser/parse.py:53
            if (m != null) {
                flush(current, buf);                                                                 // body of the previous finding is finalised // src: vvaharness/remediation_agent/report_parser/parse.py:56
                current = new ReportParserFinding(Integer.parseInt(m.group(1)), m.group(2).upper(), m.group(3).strip(), null, "", m.group(4) != null); // done when the marker group matched // src: vvaharness/remediation_agent/report_parser/parse.py:59
                findings.add(current);
                buf = new ArrayList(List.of(line));                                                  // block starts with the header line // src: vvaharness/remediation_agent/report_parser/parse.py:63
                continue;
            }
            if (current != null) {                                                                   // text before the first header is ignored // src: vvaharness/remediation_agent/report_parser/parse.py:66
                buf.add(line);
                if (current.file == null) {                                                          // first File line only // src: vvaharness/remediation_agent/report_parser/parse.py:69
                    Match fm = FILE_RE.match(line.strip());
                    if (fm != null) current.file = fm.group(1).strip();                              // src: vvaharness/remediation_agent/report_parser/parse.py:73
                }
            }
        }
        flush(current, buf);                                                                         // src: vvaharness/remediation_agent/report_parser/parse.py:76
        return findings;
    }

    // Nested function in the source: sets the current finding's body from the buffer, joined and stripped. Captured current and buf passed explicitly. Note the source closure reads the enclosing variables when called.
    void flush(ReportParserFinding current, List<String> buf) {
        if (current != null) current.body = String.join("\n", buf).strip();                          // src: vvaharness/remediation_agent/report_parser/parse.py:52
    }
}
