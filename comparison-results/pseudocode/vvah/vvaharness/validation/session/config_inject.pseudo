// file: vvaharness/validation/session/config_inject.py
// Injects the .claude/ runtime config (rules, optional skills, transcript hook, settings.json) into a
// validation workspace for Claude-Code-backed sessions. The scoring package is deliberately not copied.

@executedBy(CODE) @role(io) @stage("S11")
class ConfigInject {

    Path CLAUDE_CONFIG_SOURCE = Path.of(__file__).parent(2).resolve("claude_config");               // src: vvaharness/validation/session/config_inject.py:33

    void injectHooks(Path destClaude) {
        Path hooksLogging = destClaude.resolve("hooks/logging");                                     // src: vvaharness/validation/session/config_inject.py:38
        hooksLogging.mkdirs();                                                                       // src: vvaharness/validation/session/config_inject.py:39
        Path src = CLAUDE_CONFIG_SOURCE.resolve("hooks/logging/capture_transcript.sh");              // src: vvaharness/validation/session/config_inject.py:40
        if (src.exists()) {                                                                          // src: vvaharness/validation/session/config_inject.py:41
            Fs.copy2(src, hooksLogging.resolve("capture_transcript.sh"));                            // CaptureTranscript  // src: vvaharness/validation/session/config_inject.py:43
            hooksLogging.resolve("capture_transcript.sh").chmod(0755);                               // src: vvaharness/validation/session/config_inject.py:44
        }
    }

    void injectClaudeConfig(Path workspaceDir) {
        try {
            Path destClaude = workspaceDir.resolve(".claude");                                       // src: vvaharness/validation/session/config_inject.py:51
            if (destClaude.exists()) Fs.rmtree(destClaude);                                          // replaces any staged .claude  // src: vvaharness/validation/session/config_inject.py:52
            destClaude.mkdirs();                                                                     // src: vvaharness/validation/session/config_inject.py:54
            Path rulesSrc = CLAUDE_CONFIG_SOURCE.resolve("rules");                                   // scoring rubric: mandatory  // src: vvaharness/validation/session/config_inject.py:56
            if (!rulesSrc.exists()) throw new FileNotFoundError("required claude_config rules/ missing"); // src: vvaharness/validation/session/config_inject.py:57
            Fs.copytree(rulesSrc, destClaude.resolve("rules"));                                      // src: vvaharness/validation/session/config_inject.py:59
            Path skillsSrc = CLAUDE_CONFIG_SOURCE.resolve("skills");                                 // optional  // src: vvaharness/validation/session/config_inject.py:60
            if (skillsSrc.exists()) Fs.copytree(skillsSrc, destClaude.resolve("skills"));            // src: vvaharness/validation/session/config_inject.py:62
            injectHooks(destClaude);                                                                 // src: vvaharness/validation/session/config_inject.py:63
            Fs.copy2(CLAUDE_CONFIG_SOURCE.resolve("settings.json"), destClaude.resolve("settings.json")); // ClaudeConfigSettings  // src: vvaharness/validation/session/config_inject.py:64
            Path logDir = workspaceDir.resolve("logging");                                           // src: vvaharness/validation/session/config_inject.py:68
            logDir.resolve("orchestrator").mkdirs();                                                 // src: vvaharness/validation/session/config_inject.py:69
            logDir.resolve("subagents").mkdirs();                                                    // src: vvaharness/validation/session/config_inject.py:70
        } catch (OSError e) {
            Log.exception("Failed to inject claude config");                                         // src: vvaharness/validation/session/config_inject.py:72
            throw e;                                                                                 // src: vvaharness/validation/session/config_inject.py:73
        }
    }
}
