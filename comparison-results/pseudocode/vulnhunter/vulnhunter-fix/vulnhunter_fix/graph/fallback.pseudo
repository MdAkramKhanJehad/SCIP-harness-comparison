// file: vulnhunter-fix/vulnhunter_fix/graph/fallback.py
// Grep-based fallback graph (backend=grep, confidence=low): regex-found function definitions only, no edges,
// plus grep-based callers_of used by GraphQuery under the grep backend.

@executedBy(CODE) @role(backend) @stage("fix")
class Fallback {

    GraphDocument buildFallbackGraph(Path root, String contentHash, Theta θ) {
        Map<String, Node> nodes = new Map();
        Map<String, Regex> patterns = θ["code.vulnhunter_fix.graph.fallback.def_patterns_by_language"]; // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:25
        for (Path path : GraphConfig.iterSourceFiles(root, θ)) {                     // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:45
            String rel;
            try { rel = path.relativeTo(root); } catch (OSError | ValueError e) { continue; } // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:47
            String language = GraphConfig.languageForPath(path, θ) ?: "unknown";      // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:50
            Regex pat = patterns.get(language);                                      // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:51
            if (pat == null) continue;                                               // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:52 (rust / ruby files get no nodes)
            String text;
            try { text = path.readText(); } catch (OSError e) { continue; }          // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:55
            int lineno = 0;
            for (String line : text.splitlines()) {                                  // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:58
                lineno++;
                Match m = pat.match(line);                                           // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:59
                if (m == null) continue;                                             // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:60
                String id = rel + ":" + m.group(1);                                  // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:63
                nodes.put(id, new Node(id, "function", m.group(1), rel, lineno, id, language)); // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:64
            }
        }
        return new GraphDocument(Schema.schemaVersion(), null, now(), "grep", "low", contentHash, root.toString(), nodes, List.of()); // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:74
    }

    String enclosingSymbol(Path filePath, int lineNo, Theta θ) {
        String text;
        try { text = filePath.readText(); } catch (OSError e) { return null; }       // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:99
        List<String> lines = text.splitlines();                                      // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:103
        Regex enclosing = θ["code.vulnhunter_fix.graph.fallback.enclosing_fn_regex"]; // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:87
        for (int i = min(lineNo - 1, lines.size() - 1); i >= 0; i--) {               // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:104
            Match m = enclosing.match(lines.get(i));                                 // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:105
            if (m != null) return m.group(1);                                        // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:107
        }
        return null;                                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:108
    }

    List<String> grepCallersOf(Path root, String symbolName, Theta θ) {
        Path rootAbs = root.resolve();                                               // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:118
        String pattern = "\\b" + Regex.escape(symbolName) + "\\s*\\(";               // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:119
        String grep = Shell.which("grep");                                           // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:120
        if (grep == null) return List.of();                                          // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:121
        Process proc;
        try {
            // -rIin: recursive, skip binaries, case-insensitive, line numbers
            proc = Shell.run(grep, "-rIin", θ["code.vulnhunter_fix.graph.fallback.grep_include_globs"], "-E", pattern, rootAbs,
                             θ["code.vulnhunter_fix.graph.fallback.grep_timeout_seconds"]); // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:127
        } catch (OSError | TimeoutExpired e) {
            return List.of();                                                        // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:133
        }
        List<String> hits = new List();
        for (String line : proc.stdout.splitlines()) {                               // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:135
            List<String> parts = line.split(":", 2);
            if (parts.size() < 3) continue;                                          // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:137
            String fileRel;
            try { fileRel = Path(parts[0]).relativeTo(rootAbs); } catch (ValueError e) { fileRel = parts[0]; } // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:141
            int lineNo;
            try { lineNo = int(parts[1]); } catch (ValueError e) { continue; }       // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:145
            String symbol = enclosingSymbol(Path(parts[0]), lineNo, θ);              // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:148
            if (symbol != null) hits.add(fileRel + ":" + symbol);                    // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:149
        }
        return hits.distinct().sorted();                                             // src: vulnhunter-fix/vulnhunter_fix/graph/fallback.py:151
    }
}
