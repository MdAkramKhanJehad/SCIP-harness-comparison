# vvaharness/backends/harness/claude/options.py

Translates the harness option records (`OneShotOptions`, `StreamingOptions`) into the Claude Agent SDK's `ClaudeAgentOptions`. This is where, on the Claude route (`cli` / `sdk`), the tool allow and deny lists, the permission callback, the turn and dollar budgets, the structured-output schema, the in-process fact server, subagent definitions and the foreground-dispatch hook are installed.

Source: `vvaharness/backends/harness/claude/options.py` (lines 1-256)
Executor: code
Called from: `vvaharness/backends/harness/claude/client.py` ClaudeHarness.run_oneshot, ClaudeHarness.run_streaming

// src: vvaharness/backends/harness/claude/options.py:43-46
// preserved: duplicated from facts.py (not imported) to break an import cycle; a test pins them equal
FACT_SERVER_NAME = "facts"
FACT_TOOL_PREFIX = "mcp__facts__"
SUBAGENT_DISPATCH_TOOLS = ("Agent", "Task")

// src: vvaharness/backends/harness/claude/options.py:220-229
fn build_oneshot_sdk_options(options: OneShotOptions):executor=code {
  opts = _base_opts(options)
  opts.max_turns = options.max_turns   // OneShotOptions.max_turns default 15 (src: vvaharness/backends/harness/models.py:228)
  opts.permission_mode = "default"
  opts.setting_sources = null   // no settings files loaded for a one-shot call
  schema = _resolve_output_schema(options)
  if (schema != null) opts.output_format = _build_output_format(schema)
  return opts
  // note: no can_use_tool callback, no agents, no fact server on the one-shot path
}

// src: vvaharness/backends/harness/claude/options.py:232-256
fn build_streaming_sdk_options(options: StreamingOptions, fact_server = null, fact_tool_names = []):executor=code {
  opts = _base_opts(options)
  // StreamingOptions.max_turns and max_budget_usd default to null (src: vvaharness/backends/harness/models.py:238-239); each is installed only when set
  if (options.max_turns != null) opts.max_turns = options.max_turns
  if (options.max_budget_usd != null) opts.max_budget_usd = options.max_budget_usd
  if (options.setting_sources != null) opts.setting_sources = _to_setting_sources(options.setting_sources)
  if (options.permissions != null) opts.can_use_tool = _permissions_callback(options.permissions)
  // src: options.py:247 — the structured-output schema is served via a synthetic StructuredOutput tool that bypasses can_use_tool (CLI 2.1.220)
  schema = _resolve_output_schema(options)
  if (schema != null) opts.output_format = _build_output_format(schema)
  _apply_fact_server(opts, fact_server, fact_tool_names)
  _apply_agents(opts, options, bridged_tools = fact_tool_names with prefix "mcp__facts__" removed)
  _apply_foreground_subagents(opts, options, fact_tool_names)
  return opts
}

// src: vvaharness/backends/harness/claude/options.py:177-197
fn _base_opts(options):executor=code {
  opts = ClaudeAgentOptions({
    model: options.model,
    cwd: options.cwd,
    // the SDK spreads os.environ beneath this env, so these pins override an ambient "0"
    env: options.env + _NO_REFUSAL_RESEND_ENV,   // { CLAUDE_CODE_DISABLE_REFUSAL_RETRY: "1", CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK: "1" } (src: vvaharness/backends/llm/cli/env.py:109-112)
    effort: _to_effort(options.effort),
    verbatim_prompts: true   // scanned-repository text in the prompt is not parsed as an @path expansion or a slash command
  })
  if (options.cli_path) opts.cli_path = options.cli_path   // absolute path pin for the claude executable (CWE-426/427)
  if (options.system_prompt != null) opts.system_prompt = options.system_prompt
  if (options.tool_policy != null) {
    opts.allowed_tools = list(options.tool_policy.allowed_tools)
    opts.disallowed_tools = list(options.tool_policy.disallowed_tools)
  }
  return opts
}

// src: vvaharness/backends/harness/claude/options.py:51-54
fn _to_effort(effort):executor=code {
  parsed = EffortLevel.parse(effort)   // one of "low" | "medium" | "high" | "xhigh" | "max"
  return if (parsed != null) parsed.value else null
}

// src: vvaharness/backends/harness/claude/options.py:57-66
fn _to_setting_sources(sources):executor=code {
  for each s in sources {
    require s is a valid SettingSource member => throw ValueError("invalid setting_source: $s")
  }
  return list of member values
}

// src: vvaharness/backends/harness/claude/options.py:69-83
fn _permissions_callback(policy: PermissionsPolicy):executor=code {
  // returned as the SDK CanUseTool callback: consulted for each tool use the session requests
  return gate(tool_name, input_data, _context) {
    decision = policy.evaluate(tool_name, input_data)   // deny-by-default policy; see backends/harness/permissions.sudo
    require decision.allow => return PermissionResultDeny({ message: decision.reason, interrupt: decision.interrupt })
    return PermissionResultAllow({ updated_input: input_data })
  }
}

// src: vvaharness/backends/harness/claude/options.py:200-207
fn _apply_agents(opts, options, bridged_tools = []):executor=code {
  if (options.agents) {
    opts.agents = for each [name, a] in options.agents => name: _to_agent_definition(a, bridged_tools)
  }
}

// src: vvaharness/backends/harness/claude/options.py:86-111
fn _to_agent_definition(subagent: SubagentDefinition, bridged_tools = []):executor=code {
  tools = facts.rewrite_tool_names(subagent.tools, bridged_tools)   // null stays null (no tool override)
  if (tools != null && SUBMIT_TOOL in bridged_tools) {
    submit_name = facts.mcp_name(SUBMIT_TOOL)   // "mcp__facts__SubmitPersonaReport"
    if (submit_name not in tools) tools = tools + [submit_name]   // a persona with an explicit tool list always gets the submit tool
  }
  return AgentDefinition({
    description: subagent.description, prompt: subagent.prompt, tools,
    disallowedTools: subagent.disallowed_tools (null kept),
    model: subagent.model, skills: subagent.skills (null kept)
  })
}

// src: vvaharness/backends/harness/claude/options.py:210-217
fn _apply_fact_server(opts, fact_server, fact_tool_names):executor=code {
  if (fact_server == null) return
  opts.mcp_servers = { "facts": fact_server }   // this session's ONLY MCP server
  opts.strict_mcp_config = true
  opts.allowed_tools = (opts.allowed_tools or []) + fact_tool_names
}

// src: vvaharness/backends/harness/claude/options.py:134-150
fn _apply_foreground_subagents(opts, options, fact_tool_names):executor=code {
  // installed only when subagents exist AND personas report through the submit tool
  if (!options.agents || facts.mcp_name(SUBMIT_TOOL) not in fact_tool_names) return
  opts.hooks.PreToolUse += HookMatcher({ matcher: "Agent|Task", hooks: [_foreground_subagent_hook(keys of options.agents)] })
}

// src: vvaharness/backends/harness/claude/options.py:114-131
fn _foreground_subagent_hook(agent_names):executor=code {
  return hook(input_data, _tool_use_id, _context) {
    tool_input = input_data.tool_input or {}
    if (input_data.tool_name not in SUBAGENT_DISPATCH_TOOLS
        || tool_input.subagent_type not in agent_names
        || tool_input.run_in_background is false) return {}   // no change
    // forces a named persona dispatch to block, so its submitted report is collected before the result
    return { hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "allow", updatedInput: tool_input + { run_in_background: false } } }
  }
}

// src: vvaharness/backends/harness/claude/options.py:163-174
fn _resolve_output_schema(options):executor=code {
  if (options.output_schema != null) return _sanitize_schema(options.output_schema)
  dump = options.response_model.model_json_schema if callable, else return null
  schema = dump()
  return if (schema is a Mapping) _sanitize_schema(schema) else null
}
fn _sanitize_schema(schema):executor=code { return schema without the "$schema" key }   // src: options.py:153-160
fn _build_output_format(schema):executor=code { return { type: "json_schema", schema } }   // src: options.py:153-155
