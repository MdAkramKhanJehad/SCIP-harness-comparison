// file: vvaharness/remediation_agent/select/topspec.py, vvaharness/remediation_agent/select/pq.py
// Resolve the --top N cap (CLI flag wins over step_remediate.top_n_findings) and select the top N findings by CVSS.

@executedBy(CODE) @role(step) @stage("S10")
class Topspec {

    Object coerceTopValue(String raw, Theta θ) {
        // Coerce a raw --top or top_n_findings value to a positive int or the ALL_FINDINGS wildcard (the string all, distinct from null so CLI --top all overrides a profile cap).
        if (θ["code.remediation_agent.select.topspec.all_tokens"].contains(raw.strip().lower())) return "all"; // src: vvaharness/remediation_agent/select/topspec.py:28
        int n = Integer.parse(raw);                                                                 // src: vvaharness/remediation_agent/select/topspec.py:31  (TypeError or ValueError becomes a ValueError naming the source)
        if (n <= 0) throw new ValueError("must be a positive integer or all");                      // src: vvaharness/remediation_agent/select/topspec.py:35
        return n;                                                                                   // src: vvaharness/remediation_agent/select/topspec.py:38
    }

    Object parseTopArg(List<String> args, Theta θ) {
        // Parse --top N or --top=N (or the all wildcard) from a raw argv slice; the first occurrence wins; absent flag is null.
        String raw = null;
        for (int i = 0; i < args.size(); i = i + 1) {                                               // src: vvaharness/remediation_agent/select/topspec.py:44
            String a = args.get(i);
            if (a.equals("--top")) {                                                                // src: vvaharness/remediation_agent/select/topspec.py:45
                if (i + 1 >= args.size()) throw new ValueError("--top requires a value, e.g. --top 5 or --top all"); // src: vvaharness/remediation_agent/select/topspec.py:46
                raw = args.get(i + 1);                                                              // src: vvaharness/remediation_agent/select/topspec.py:49
                break;                                                                              // src: vvaharness/remediation_agent/select/topspec.py:50
            }
            if (a.startsWith("--top=")) {                                                           // src: vvaharness/remediation_agent/select/topspec.py:51
                raw = a.split("=", 2).get(1);                                                       // src: vvaharness/remediation_agent/select/topspec.py:52
                break;                                                                              // src: vvaharness/remediation_agent/select/topspec.py:53
            }
        }
        if (raw == null) return null;                                                               // src: vvaharness/remediation_agent/select/topspec.py:54
        return coerceTopValue(raw, θ);                                                              // src: vvaharness/remediation_agent/select/topspec.py:56
    }

    Object cfgTopNFindings(Config cfg, Theta θ) {
        // The profile driven top-N cap from step_remediate.top_n_findings. Null ONLY when the step_remediate block is absent; garbage degrades to the wildcard and never raises.
        Object sr = cfg.step_remediate;                                                             // src: vvaharness/remediation_agent/select/topspec.py:62
        if (sr == null) return null;                                                                // src: vvaharness/remediation_agent/select/topspec.py:63
        Object raw = θ["step_remediate.top_n_findings"];                                            // src: vvaharness/remediation_agent/select/topspec.py:65
        if (raw == null) return "all";                                                              // src: vvaharness/remediation_agent/select/topspec.py:66  (key absent but block present: no cap)
        try {
            return coerceTopValue(String.valueOf(raw), θ);                                          // src: vvaharness/remediation_agent/select/topspec.py:70
        } catch (ValueError e) {
            return "all";                                                                           // src: vvaharness/remediation_agent/select/topspec.py:73  (null, zero, negative or unparseable in a profile: wildcard rather than crashing the run)
        }
    }

    Integer resolveTop(Object cliTop, Object cfgTopN) {
        // cfgTopN: absent block -> null; garbage/0/negative in a profile -> wildcard (no cap).
        Object chosen = cliTop != null ? cliTop : cfgTopN;                                          // src: vvaharness/remediation_agent/select/topspec.py:79
        if (chosen instanceof Integer) return chosen;                                               // src: vvaharness/remediation_agent/select/topspec.py:80
        return null;                                                                                // src: vvaharness/remediation_agent/select/topspec.py:83  (no cap)
    }

    List<Finding> selectTopByCvss(List<Finding> items, Integer n) {
        if (n == null || n <= 0) return items;                                                      // src: vvaharness/remediation_agent/select/pq.py:50
        // Score = numeric CVSS, else band anchor (CRITICAL 9, HIGH 7, MEDIUM 4, LOW 1, INFO 0); index breaks ties.
        return items.sortedBy(it -> -(it.cvssScore != null ? it.cvssScore : bandScore(it.severity))).take(n); // src: vvaharness/remediation_agent/select/pq.py:62
    }

    double bandScore(String severity) {
        return Map.of("CRITICAL", 9.0, "HIGH", 7.0, "MEDIUM", 4.0, "LOW", 1.0, "INFO", 0.0).getOr(severity.upper(), 0.0); // src: vvaharness/remediation_agent/select/pq.py:39
    }

    List<Finding> dropNonMainChannel(List<Finding> items) {
        // Only channel == "posture" is dropped, before the top-N cap.
        return items.filter(it -> !it.channel.casefold().equals("posture"));                        // src: vvaharness/remediation_agent/select/pq.py:88
    }
}
