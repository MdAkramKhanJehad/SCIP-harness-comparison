  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"One compiled pattern a detector treats as a source, sink, or detector rule.\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\n\n\n@dataclass(frozen=True)\nclass MatchSpec:\n    \"\"\"One compiled pattern plus the role/CWE it implies when matched.\"\"\"\n\n    rule_id: str\n    role: str  # \"source\" | \"sink\" | \"detector\"\n    pattern: str  # regex, matched against one line of source text\n    cwe: str\n    kind: str\n    semantic_family: str = \"\"\n    owasp_top10_2025: frozenset[str] = field(default_factory=frozenset)\n\n    # ── detector-rule fields (role == \"detector\"); line specs ignore these ──\n    enabled: bool = True          # per-rule kill switch, part of the rule DATA\n    languages: frozenset[str] = field(default_factory=frozenset)  # EXT_TO_LANG keys\n    title: str = \"\"               # finding title minted for a hit\n    citation: str = \"\"            # one-line public CWE/OWASP citation for the rule\n    # Gate scope: \"line\" | \"call\" (balanced paren, <= span_max_lines) | \"block\" (to span_end)\n    span: str = \"line\"\n    span_end: str = \"\"            # regex closing a \"block\" span (e.g. \"</form\")\n    span_max_lines: int = 1\n    present_re: str = \"\"          # fire only when the span DOES match this\n    absent_re: str = \"\"           # fire only when the span does NOT match this\n    # Extra lines the absent_re guard ALSO sees (a wrapping `escape(`); negative gate only\n    absent_window: int = 0\n    file_re: str = \"\"             # file-scope gate: the whole file must match somewhere\n    near_re: str = \"\"             # proximity gate: must match within near_window lines\n    near_window: int = 0\n",
  "literals": {
