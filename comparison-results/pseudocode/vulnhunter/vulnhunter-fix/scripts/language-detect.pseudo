// file: vulnhunter-fix/scripts/language-detect.py
// Detects a target repo's primary language for Plan's worker-prompt adapter routing (REQ-CWE-005):
// manifest files first, then a file-suffix majority vote.

@executedBy(CODE) @role(tool) @stage("fix")
class LanguageDetect {

    Map run(Path root, Theta θ) {
        return detect(root, θ);
    }

    boolean manifestPresent(Path root, String name) {
        try {
            return root.join(name).isFile();                                                               // src: vulnhunter-fix/scripts/language-detect.py:71
        } catch (OSError e) {
            return false;                                                                                  // src: vulnhunter-fix/scripts/language-detect.py:73
        }
    }

    Map detect(Path root, Theta θ) {
        List<String> signals = List.of();
        Map<String, String> manifestHits = Map.of();
        for (Entry e : θ["code.fix.scripts.language_detect.manifest_map"].entries()) {                    // src: vulnhunter-fix/scripts/language-detect.py:33
            if (manifestPresent(root, e.key)) {
                manifestHits.put(e.value.lang, e.value.conf);                                              // src: vulnhunter-fix/scripts/language-detect.py:81
                signals.add("manifest:" + e.key);
            }
        }
        if (!manifestHits.isEmpty()) {
            List<String> high = manifestHits.keysWhere(c -> c == "high");                                  // src: vulnhunter-fix/scripts/language-detect.py:85
            if (!high.isEmpty()) {
                // tsconfig + package.json -> typescript wins
                if (manifestHits.containsKey("typescript")) return Map.of("language", "typescript", "confidence", "high", "signals", signals); // src: vulnhunter-fix/scripts/language-detect.py:88
                if (high.size() == 1) return Map.of("language", high.get(0), "confidence", "high", "signals", signals); // src: vulnhunter-fix/scripts/language-detect.py:90
                // several high-confidence languages: polyglot, fall through to suffix vote
            } else {
                return Map.of("language", manifestHits.firstKey(), "confidence", "medium", "signals", signals); // src: vulnhunter-fix/scripts/language-detect.py:94
            }
        }
        Counter<String> counter = new Counter();
        for (Path path : GraphConfig.safeWalkFiles(root, θ["code.fix.scripts.language_detect.skip_dirs"], θ)) { // src: vulnhunter-fix/scripts/language-detect.py:101
            String lang = θ["code.fix.scripts.language_detect.suffix_map"].get(path.suffix().lower());    // src: vulnhunter-fix/scripts/language-detect.py:106
            if (lang != null) counter.inc(lang);
        }
        if (counter.isEmpty()) return Map.of("language", null, "confidence", "low", "signals", signals.plus("no source files found")); // src: vulnhunter-fix/scripts/language-detect.py:111
        Pair winner = counter.mostCommon(1).get(0);                                                        // src: vulnhunter-fix/scripts/language-detect.py:113
        int total = counter.total();
        String confidence = winner.count / total >= θ["code.fix.scripts.language_detect.suffix_vote_high_share"] ? "high" : "medium"; // src: vulnhunter-fix/scripts/language-detect.py:115
        return Map.of("language", winner.key, "confidence", confidence, "signals", signals);              // src: vulnhunter-fix/scripts/language-detect.py:117
    }

    int main(List<String> argv, Theta θ) {
        if (argv.size() != 2) return 64;                                                                   // src: vulnhunter-fix/scripts/language-detect.py:121
        Path root = new Path(argv.get(1));
        if (!root.isDir()) return 2;                                                                       // src: vulnhunter-fix/scripts/language-detect.py:125
        print(Json.dump(detect(root, θ)));                                                                 // src: vulnhunter-fix/scripts/language-detect.py:129
        return 0;
    }
}
