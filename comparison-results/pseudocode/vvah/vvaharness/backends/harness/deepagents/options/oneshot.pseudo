// file: vvaharness/backends/harness/deepagents/options/oneshot.py
// One-shot (single-turn parser) graph compilation: which native tools are advertised vs. permitted to execute
// (fail closed via PermitTools; the subagent dispatch "task" never permitted), redaction on read-only, cache/suffix tweaks.

@executedBy(CODE) @role(backend)
class Oneshot {

    Set<String> grantedNatives(OneShotOptions options, Theta θ) {
        if (options.base.toolPolicy == null) return Set.of();                                            // src: vvaharness/backends/harness/deepagents/options/oneshot.py:56
        Set<String> out = new Set();
        for (String logical : options.base.toolPolicy.allowedTools) {                                    // src: vvaharness/backends/harness/deepagents/options/oneshot.py:60
            if (HarnessModels.logicalToNative(θ).containsKey(logical)) out.add(HarnessModels.logicalToNative(θ).get(logical)); // src: vvaharness/backends/harness/deepagents/options/oneshot.py:61
        }
        return out;
    }

    // Withheld from the model REQUEST (advertisement only). TRAP: an empty ToolPolicy still offers natives.
    Set<String> oneshotExcludedTools(OneShotOptions options, Theta θ) {
        Set<String> task = Set.of(DeepagentsModels.subagentDispatchTool());                              // src: vvaharness/backends/harness/deepagents/options/oneshot.py:68
        if (options.base.toolPolicy == null) return task;                                                // src: vvaharness/backends/harness/deepagents/options/oneshot.py:69
        return DeepagentsModels.allNativeTools(θ).minus(grantedNatives(options, θ)).union(task);         // src: vvaharness/backends/harness/deepagents/options/oneshot.py:71
    }

    // What the EXECUTOR may run (fed to PermitTools); a null policy permits every native + custom tools.
    Set<String> oneshotPermittedTools(OneShotOptions options, List<Tool> sessionTools, Theta θ) {
        Set<String> custom = DeepagentsTools.sessionToolNames(sessionTools, θ);                          // src: vvaharness/backends/harness/deepagents/options/oneshot.py:79
        if (options.base.toolPolicy == null) return DeepagentsModels.allNativeTools(θ).union(custom);    // src: vvaharness/backends/harness/deepagents/options/oneshot.py:81
        return grantedNatives(options, θ).union(custom);                                                 // src: vvaharness/backends/harness/deepagents/options/oneshot.py:82
    }

    CompiledStateGraph buildOneshotGraph(OneShotOptions options, Theta θ) {
        ToolPolicy policy = Subagents.toolPolicy(options);                                               // src: vvaharness/backends/harness/deepagents/options/oneshot.py:88
        List<Tool> tools = Subagents.buildSessionTools(options, policy.allowedTools, θ);                 // src: vvaharness/backends/harness/deepagents/options/oneshot.py:89
        // our gated general-purpose spec displaces deepagents' ungated, UNREDACTED builtin
        List<SubagentSpec> subagents = Subagents.getSubagentSpecs(options, Map.of(), θ);                 // src: vvaharness/backends/harness/deepagents/options/oneshot.py:91
        // graph_builder._create_agent with:
        //   name = graph_name + "-oneshot"; skills = skill sources or OMITTED (an empty list adds ~1.9k chars per call);
        //   permissions = filesystemPermissions; redact_reads = !allow_writes; backend = sessionBackend;
        //   response_format = oneshot response format; extra_excluded_tools; max_output_tokens / output_cap (null = 64k Anthropic / uncapped OpenAI);
        //   permitted_tool_calls (executor gate); cache_markers; cache_tail; strip_harness_suffix; effort; use_responses_api; parent_middleware
        List<String> skills = Filesystem.skillSources(options.base.skillRoot, options.base.cwd);         // src: vvaharness/backends/harness/deepagents/options/oneshot.py:100
        return createAgent(options.base.model, options.base.env, options.base.thinkInPrompt, options.base.systemPrompt, tools,
            options.base.graphName + "-oneshot",                                                         // src: vvaharness/backends/harness/deepagents/options/oneshot.py:98
            skills.isEmpty() ? null : skills,                                                            // src: vvaharness/backends/harness/deepagents/options/oneshot.py:100
            Filesystem.filesystemPermissions(options, θ),                                                // src: vvaharness/backends/harness/deepagents/options/oneshot.py:101
            !options.base.allowWrites,                                       // redact_reads             // src: vvaharness/backends/harness/deepagents/options/oneshot.py:103
            Filesystem.sessionBackend(options),                                                          // src: vvaharness/backends/harness/deepagents/options/oneshot.py:104
            oneshotResponseFormat(options),                                  // options/response_format  // src: vvaharness/backends/harness/deepagents/options/oneshot.py:106
            subagents,
            oneshotExcludedTools(options, θ),                                                            // src: vvaharness/backends/harness/deepagents/options/oneshot.py:108
            options.base.maxOutputTokens, options.base.outputCap,                                        // src: vvaharness/backends/harness/deepagents/options/oneshot.py:110
            oneshotPermittedTools(options, tools, θ),                        // fail-closed executor gate // src: vvaharness/backends/harness/deepagents/options/oneshot.py:113
            options.base.cacheMarkers,                                                                   // src: vvaharness/backends/harness/deepagents/options/oneshot.py:114
            θ["code.backends.harness.deepagents.options.oneshot.cache_tail"],   // a single call never reads a tail write back // src: vvaharness/backends/harness/deepagents/options/oneshot.py:116
            θ["code.backends.harness.deepagents.options.oneshot.strip_harness_suffix"], // suffix is dead weight on one turn // src: vvaharness/backends/harness/deepagents/options/oneshot.py:118
            options.base.effort, options.base.useResponsesApi, options.base.parentMiddleware);           // src: vvaharness/backends/harness/deepagents/options/oneshot.py:119
    }

    CompiledGraphPair buildOneshotOptions(OneShotOptions options, Theta θ) {
        CompiledStateGraph graph = buildOneshotGraph(options, θ);                                        // src: vvaharness/backends/harness/deepagents/options/oneshot.py:127
        return new CompiledGraphPair(graph, GraphConfig.makeConfig(options, θ["code.backends.harness.deepagents.options.oneshot.recursion_buffer"])); // src: vvaharness/backends/harness/deepagents/options/oneshot.py:128
    }
}
