// file: vvaharness/models/scan/_coerce.py
// Lenient coercion helpers used by model validators to absorb off-schema LLM output instead of rejecting it.

@executedBy(CODE) @role(types)
class Coerce {

    String norm(Object v) {
        return str(v or "").strip().lower().replace("-", "_").replace(" ", "_");                   // src: vvaharness/models/scan/_coerce.py:23
    }

    String coerceEnum(Object v, Set<String> valid, Map<String, String> alias, String deflt) {
        String raw = str(v or "").strip();
        if (valid.contains(raw)) return raw;  // exact, case-preserving hit                         // src: vvaharness/models/scan/_coerce.py:28
        String k = norm(v);
        if (valid.contains(k)) return k;                                                            // src: vvaharness/models/scan/_coerce.py:31
        return alias.getOrDefault(k, deflt);  // unknown value falls back to the caller's default   // src: vvaharness/models/scan/_coerce.py:33
    }

    int coerceInt(Object v, int deflt) {
        if (v is Boolean) return deflt;  // bool is an int in Python; rejected                     // src: vvaharness/models/scan/_coerce.py:37
        if (v is Integer) return v;
        if (v is Float) {
            if (isNaN(v) || isInf(v)) return deflt;                                                 // src: vvaharness/models/scan/_coerce.py:43
            return (int) v;
        }
        try {
            return parseInt(str(v).strip());                                                        // src: vvaharness/models/scan/_coerce.py:47
        } catch (ValueError e) {
            return deflt;                                                                           // src: vvaharness/models/scan/_coerce.py:49
        }
    }

    boolean flag(Object v) {
        // model-emitted flag -> bool, falling back to False rather than raising
        if (v is Boolean) return v;                                                                 // src: vvaharness/models/scan/_coerce.py:54
        if (v is String) return θ["code.models.scan._coerce.flag_true_strings"].contains(v.strip().lower()); // src: vvaharness/models/scan/_coerce.py:57
        if (v is Number) return v != 0;                                                             // src: vvaharness/models/scan/_coerce.py:59
        return false;                                                                               // src: vvaharness/models/scan/_coerce.py:60
    }

    String text(Object v) {
        return v is String ? v : (v == null ? "" : str(v));                                         // src: vvaharness/models/scan/_coerce.py:65
    }

    Object coerceScalarStr(Object v, Object deflt, String label) {
        if (v is String) return v;                                                                  // src: vvaharness/models/scan/_coerce.py:71
        if (v is List) {
            if (θ["code.models.scan._coerce.list_scalar_keep_first"]) {
                // tail elements are lost, including their file<->threat association
                Object first = v.firstWhere(x -> x != null && x != "");                            // src: vvaharness/models/scan/_coerce.py:74
                log.warning("list coerced to first element");
                return coerceScalarStr(first, deflt, label);                                        // src: vvaharness/models/scan/_coerce.py:77
            }
        }
        if (v == null) {
            if (deflt == null) return null;  // valid for Optional fields                           // src: vvaharness/models/scan/_coerce.py:80
            return deflt;                                                                           // src: vvaharness/models/scan/_coerce.py:83
        }
        if (v is Number && !(v is Boolean)) return str(v);                                          // src: vvaharness/models/scan/_coerce.py:87
        return v;  // unrecognisable: let Pydantic reject                                           // src: vvaharness/models/scan/_coerce.py:88
    }

    Object coerceStrList(Object v, String label) {
        if (v is List) return v;                                                                    // src: vvaharness/models/scan/_coerce.py:94
        if (v == null) return List.of();                                                            // src: vvaharness/models/scan/_coerce.py:98
        if (v is Tuple) return List.copyOf(v);                                                      // src: vvaharness/models/scan/_coerce.py:100
        if ((v is String || v is Number) && !(v is Boolean)) {
            String s = str(v).strip();
            return s.isEmpty() ? List.of() : List.of(s);  // bare scalar wrapped in a list          // src: vvaharness/models/scan/_coerce.py:105
        }
        return v;                                                                                   // src: vvaharness/models/scan/_coerce.py:106
    }
}
