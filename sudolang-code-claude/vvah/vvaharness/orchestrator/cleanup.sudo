# vvaharness/orchestrator/cleanup.py

Deletion of batch clones after their scan, keeping the artifact folders.

Source: `vvaharness/orchestrator/cleanup.py` (lines 1-70)
Executor: code
Called from: `vvaharness/orchestrator/batch.py` (`_purge_clone`, `_preserve_set`, `_rmtree_rw`)

// src: vvaharness/orchestrator/cleanup.py:43-48
_CLONE_KEEP_DEFAULT = [SCAN_DIR_NAME, CASE_DIR_NAME]   // "security-scan", "security-remediation"
fn _preserve_set(cfg):executor=code {
  vals = knob("output.preserve_on_cleanup", default=null)
  return if (vals) set(vals) else set(_CLONE_KEEP_DEFAULT)
  // anything not in the set is deleted outright: a profile that lists other names but omits these two loses the case files
}

// src: vvaharness/orchestrator/cleanup.py:51-70
fn _purge_clone(root, keep):executor=code {
  if (root does not exist) return
  for each child in root {
    if (child.name in keep) continue
    if (child is a directory) _rmtree_rw(child) else { clear read-only bit (ignore errors); delete child if present }
  }
  leftover = children of root not in keep
  if (leftover) warn PURGE_LEFTOVER   // a surviving clone may hold secrets, so the operator is told
}

// src: vvaharness/orchestrator/cleanup.py:31-39
fn _rmtree_rw(path):executor=code {
  delete the tree; on a per-entry error clear the read-only bit and retry once, ignoring any further error   // Windows read-only .git objects
}
