SECURITY_CONFIG_NAMES = {"web.xml", "struts.xml", "struts-config.xml", "applicationcontext.xml", "spring-security.xml", "beans.xml",
  "faces-config.xml", "shiro.ini", "security.xml", "ejb-jar.xml", "jboss-web.xml", "weblogic.xml", "androidmanifest.xml",
  "info.plist", "application.properties", "application.yml", "application.yaml", "appsettings.json", "web.config", "app.config"}
SECURITY_CONFIG_EXTS = {".xml", ".properties"}

// src: vvaharness/lang/detect.py:279-291
fn detect_languages(files, repo_root = null):executor=code {
  counts = {}
  for each f in files {
    suffix = lowercase extension of f
    lang = EXT_TO_LANG[suffix]
    if (lang == null || suffix in [".yml", ".yaml"]) lang = _sniff_lang(f, repo_root) || lang
    if (lang) counts[lang] += 1
  }
  return language keys sorted by count, most common first
}

// src: vvaharness/lang/detect.py:235-276
fn _sniff_lang(rel, repo_root):executor=code {
  if (_DOCKERFILE_NAME_RX matches rel) return "dockerfile"
  if (_JENKINSFILE_NAME_RX matches rel) return "jenkins"
  if (_GHACTIONS_PATH_RX matches rel) return "github-actions"
  suffix = lowercase extension of rel
  if (suffix in [".yml", ".yaml"]) {
    if (_ANSIBLE_PATH_RX matches rel) return "ansible"
    if (_K8S_PATH_RX matches rel) return "kubernetes"
    if (repo_root) {
      head = _read_head(repo_root, rel)   // first 4096 characters; "" on OSError
      if (_ANSIBLE_BODY_RX matches head) return "ansible"
      if (_K8S_BODY_RX matches head) return "kubernetes"
    }
    return null
  }
  if (suffix) return null
  // extension-less files: mainframe sources often ship as PDS-member dumps
  if (_MAINFRAME_PATH_RX matches rel && repo_root) head = _read_head(repo_root, rel)          // 4096 characters
  else if (repo_root) head = _read_head(repo_root, rel, 1024)                               // 1024 characters elsewhere
  else return null
  if (_JCL_BODY_RX matches head) return "jcl"
  if (_COBOL_BODY_RX matches head) return "cobol"
  return null
}

// src: vvaharness/lang/detect.py:294-301
VVAH_LANGUAGES = {"python", "java", "javascript", "typescript", "go", "csharp"}

// src: vvaharness/lang/detect.py:303-321
_LANG_ALIASES = { python, py, python3 -> "python"; java; javascript, js, node -> "javascript"; typescript, ts -> "typescript";
  go, golang -> "go"; csharp, c#, cs, dotnet -> "csharp"; kotlin, kt -> "kotlin"; scala; ruby, rb -> "ruby"; php;
  c, cpp, c++, cxx -> "c-cpp" }
fn canonical_lang(value) = _LANG_ALIASES[lowercase(trim(value))] or, when absent, lowercase(trim(value))   // unknown spellings kept, never defaulted
