# vvaharness/report/redact.py

Sensitive-data masking applied at the write boundary of every emitted report (Markdown, SARIF, findings JSON) and to text sent onward. A fixed, ordered list of regular-expression rules (card numbers with issuer and Luhn checks, CVV, track data, SSN, vendor tokens, JWT, bearer values, URL passwords, PEM private keys, keyword-anchored secrets) replaces matches with `[REDACTED-<LABEL>]`. Distinctive masked values are remembered in a bounded run-scoped registry so later prose restatements of the same value are masked too ("value carry").

Source: `vvaharness/report/redact.py` (lines 1-446)
Executor: code
Called from: `vvaharness/orchestrator/scan.py`, `vvaharness/orchestrator/findings_json.py`, `vvaharness/orchestrator/batch.py` (reset_known_values once per repository), `vvaharness/orchestrator/entry.py`, `vvaharness/orchestrator/preflight.py`, `vvaharness/manifest.py`, `vvaharness/pipeline/stages/s4_deepdive.py`, `vvaharness/pipeline/stages/s8_chain.py`, and others

// src: vvaharness/report/redact.py:28-82
Options validators {
  _luhn(digits): standard Luhn checksum
  _PAN_MIN_DIGITS: 12, _PAN_MAX_DIGITS: 19
  _CARD_NETWORKS (name, min length, max length, prefix width, prefixes): amex 15-15 w2 {34,37}; visa 13-19 w1 {4};
    mastercard 16 w2 51-55; mastercard-2-series 16 w4 2221-2720; discover-6011 16-19 w4 {6011}; discover-65 16-19 w2 {65};
    discover-64x 16-19 w3 644-649; jcb 16-19 w4 3528-3589; unionpay 16-19 w2 {62}; diners 14-19 w2 {36};
    maestro 12-19 w4 {5018,5020,5038,5893,6304,6759,6761,6762,6763}; rupay-508 16 w3 {508}; rupay-8x 16 w2 81-82
  _cc_network(digits): length in 12..19 and some network matches length and prefix   // so random Luhn-passing ids are not masked
  _ssn_valid(d): not (area == 0 || area == 666 || group == 0 || serial == 0)   // ITIN areas 900-999 allowed
  _bearer_credential(m): the value has a non-alphabetic character   // so "HTTP Basic Auth" prose is skipped
}

// src: vvaharness/report/redact.py:89-112
Options shapes {
  _SECRET_CODE_SHAPE: /^\(|^[A-Za-z_]\w*\(|^[A-Za-z_]\w*\.\w/          // cast, function call, member access
  _SECRET_CODE_SHAPE_DOTTED_CALL: /^[A-Za-z_]\w*\.\w+\(/
  _IDENTIFIER_SHAPE: /[A-Za-z]+(?:_[A-Za-z]+)+/                        // digit-free snake identifier
  _NEXT_LINE_ENV_KEY: /[A-Z][A-Z0-9_]*=(?!=)/
  _REDACTED_TAG_RX: /(?i)\[redacted-[a-z0-9-]+]/
  _PLACEHOLDER_RX: ${...}, %X%, <...>, ***, xxx, [redacted], redacted tags, null, none, true, false, changeme, your_*, placeholder, example
}

// src: vvaharness/report/redact.py:119-243
// Rules run in this order; each rule's validator must accept the match or the text is left unchanged.
_PATTERNS = [
  ["PAN", 13-19 digits with optional single space/dash separators, not adjacent to alphanumerics, validator: _cc_network && _luhn],
  ["CVV", /(?i)\b(cvv2?|cvc2?|cid|csc)\b\s*[:=]?\s*"?(\d{3,4})"?/, masks the digits only],
  ["TRACK", /%B\d{12,19}\^[^?]{2,90}\?/],
  ["SSN", ddd-dd-dddd with -, ., tab, space or Unicode spaces as separator (no newline), validator: _ssn_valid],
  ["SSN-CTX", bare 9 digits after ssn / social security / itin / tin / taxpayer id keyword, validator: _ssn_valid, counted as "SSN"],
  ["AWS-KEY", /\b(?:AKIA|ASIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA)[0-9A-Z]{16}\b/],
  ["GITHUB-TOKEN", gh[pousr]_ + 36-255 chars, or github_pat_ 22 + _ + 59],
  ["SLACK-TOKEN", /\bxox[baprs]-[A-Za-z0-9-]{10,72}\b/],
  ["ANTHROPIC-KEY", /\bsk-ant-[A-Za-z0-9_-]{16,}\b/],
  ["STRIPE-KEY", /\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{24,99}\b/],
  ["GOOGLE-API-KEY", /\bAIza[0-9A-Za-z_-]{35}\b/],
  ["AZURE-SAS", /(?i)\bsig=[0-9A-Za-z%+\/=]{20,}\b/],
  ["TWILIO-KEY", /\bSK[0-9a-fA-F]{32}\b/],
  ["JWT", eyJ + three base64url segments of 10+ chars],
  ["BEARER", /(?i)\b(?:Bearer|Basic)\s+(?P<bv>[A-Za-z0-9+\/=._-]{8,})\b/, validator: _bearer_credential],
  ["URL-CRED", scheme://user:<password>@, masks the password component only],
  ["PRIVATE-KEY", -----BEGIN ... PRIVATE KEY----- through -----END ... PRIVATE KEY----- (unbounded lazy body)],
  ["SECRET", keyword (password, passwd, pwd, passphrase, secret/signing/encryption/aes/jwt/hmac/master key, secret, api key,
     access key, private key, client secret, auth token, token, credential) + optional quote/closer + operator (:, =, ==, !=, :=)
     + value of 6-256 non-separator characters, optionally on the next indented line,
     validator: value is not a placeholder && (operator is ":" or "=" || value is quoted) && value does not start with "<"],
  ["SECRET-XML", <keyword>value</keyword> with 4-256 char value, validator: not a placeholder, counted as "SECRET"],
  ["SECRET-ARG", second quoted argument of jwt.encode( / jwt.decode(, 6-256 chars, validator: not a placeholder, counted as "SECRET"]
]
// abstracted: full regular-expression texts at lines 119-243 condensed to their matching shape; labels, order, validators and
//   length bounds are kept.

// src: vvaharness/report/redact.py:246-257
State {
  _KNOWN_VALUES: ordered set (least recently used first), guarded by _KNOWN_LOCK   // shared across threads (Stage 4 pool)
  _KNOWN_VALUES_MAX = 2048        // least recently used evicted
  _MIN_KNOWN_LEN = 10
  _KNOWN_LONG_ENOUGH_ALONE = 12
}

// src: vvaharness/report/redact.py:260-288
fn _rememberable(value) = length >= 12 || (length >= 10 && at least 2 of {lower, upper, digit, symbol} present)
fn _remember_known_value(value):executor=code {
  // caller holds _KNOWN_LOCK
  if (value in _KNOWN_VALUES) { move to most recent; return }
  if (size >= 2048) evict the least recent
  add value
}

// src: vvaharness/report/redact.py:291-295
fn reset_known_values():executor=code { with _KNOWN_LOCK, clear _KNOWN_VALUES }   // once per repository, never mid-repository

// src: vvaharness/report/redact.py:300-408
fn _redact_impl(text, carry = true):executor=code {
  remove every NUL byte from text   // NUL is reserved for the in-band placeholder sentinel
  counts = {}; placeholders = []
  mask(label, value, remember = true) {
    counts[label] += 1
    if (value has no newline && remember && _rememberable(value)) with _KNOWN_LOCK, _remember_known_value(value)
    placeholders.append("[REDACTED-$label]" + one newline per newline in value)   // keeps line numbers stable
    return sentinel "\x00<index>\x00"
  }
  for each [label, rx, validator] in _PATTERNS {
    replace each match m of rx in out {
      if (validator && !validator(m)) keep m
      match (label) {
        case "SECRET" => {
          v_core = if (quoted) v else v without trailing ").}]!?>*|" (kept whole if that leaves < 6 chars)
          if (v starts with a redacted tag) keep m                                   // idempotence
          if (!quoted && value is on the next line && (v ends with ":" || v looks like KEY=)) keep m   // sibling key, not a value
          strong = {password, passwd, pwd, apikey, accesskey, clientsecret, authtoken, passphrase, privatekey, secretkey,
                    signingkey, encryptionkey, aeskey, jwtkey, hmackey, masterkey}    // secret, token, credential are NOT strong
          generic_unquoted = keyword not in strong && !quoted
          tight_equals_assignment = operator is "=" with no spaces on either side    // .env shape is always masked
          short = length(v_core) < 20
          identifier = short && v_core is _IDENTIFIER_SHAPE
          plain_word = generic_unquoted && !tight_equals_assignment && v_core is lower case && ((alphabetic && short) || identifier)
          code_shape = !quoted && (if (generic_unquoted) _SECRET_CODE_SHAPE else _SECRET_CODE_SHAPE_DOTTED_CALL) matches v_core
          if (plain_word || code_shape) keep m                                       // prose or code, not a credential
          remember = !( !quoted && (v_core is code-shaped || identifier) )            // masked locally, never carried
          replace v_core only with mask("SECRET", v_core, remember)
        }
        case "SECRET-XML" | "SECRET-ARG" => replace the value with mask("SECRET", value)
        case "CVV" => replace the digits with mask("CVV", digits)
        case "SSN-CTX" => replace the digits with mask("SSN", digits)
        case "URL-CRED" => replace the password with mask("URL-CRED", password)
        default => replace the whole match with mask(label, m)
      }
    }
  }
  if (carry && _KNOWN_VALUES is non-empty) {
    known = _KNOWN_VALUES sorted longest first, then lexically   // a short value never masks inside a long one
    for each value in known where value occurs in out {
      refresh value to most recent
      replace every occurrence with mask("SECRET-RESTATED", value)
    }
  }
  replace each sentinel with its placeholder (an out-of-range index is left untouched)
  return [out, counts]
}

// src: vvaharness/report/redact.py:411-424
fn redact(text, carry = true):executor=code {
  if (!text) return text
  [out, counts] = _redact_impl(text, carry); redact.last_counts = counts   // not thread-safe; use redact_counts under concurrency
  return out
}
fn redact_counts(text, carry = true):executor=code { return if (!text) [text, {}] else _redact_impl(text, carry) }

// src: vvaharness/report/redact.py:427-446
_NO_CARRY_KEYS = {"file", "uri", "source_ref", "sink_ref", "chunk_id", "case_id", "ruleId", "partialFingerprints",
                  "aliasFindingIds", "filePath", "file_path", "filenames", "path"}   // a remembered literal in a path must not be replaced
fn redact_tree(obj, carry = true):executor=code {
  match (obj) {
    case dict => each value redacted with carry = carry && key not in _NO_CARRY_KEYS   // dict keys themselves are not redacted
    case list | tuple => each item redacted with the same carry
    case String => redact(obj, carry)
    default => obj
  }
}
