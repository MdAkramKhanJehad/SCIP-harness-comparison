// file: vvaharness/detect/patterns.py, vvaharness/detect/__init__.py
// The default source/sink corpus S0 matches against source text, plus the declarative S5 detector rules.
// Every callee is a public, documented API defensible from CWE semantics; never benchmark-led.

@executedBy(CODE) @role(rule_set) @stage("S0")
class DetectPatterns {

    /** detect.scan: match the source/sink corpus against every listed file (S0 seed). */
    @src("vvaharness/detect/__init__.py:45")
    DetectResult scan(String repoRoot, List<String> relPaths, Theta θ) {
        List<Hit> hits = Matcher.scanFiles(repoRoot, relPaths, defaultCorpus());             // src: vvaharness/detect/__init__.py:47
        return new DetectResult(Roles.hitsToEntryPoints(hits), Roles.hitsToSinks(hits), hits); // src: vvaharness/detect/__init__.py:48
    }

    /** default_corpus: role=sink / role=source specs only. */
    List<MatchSpec> defaultCorpus() {
        List<MatchSpec> specs = new List();
        specs.addAll(commandSpecs());      // CWE-78: system/popen/spawn/exec/eval and qualified os/subprocess calls  // src: vvaharness/detect/patterns.py:97
        specs.addAll(sqlSpecs());          // CWE-89: execute/executemany/raw/query  // src: vvaharness/detect/patterns.py:154
        specs.addAll(deserializeSpecs());  // CWE-502: loads/load/deserialize/unmarshal + module-qualified  // src: vvaharness/detect/patterns.py:169
        specs.addAll(templateSpecs());     // CWE-79: render_template_string  // src: vvaharness/detect/patterns.py:126
        specs.addAll(cookieSpecs());       // set_cookie without httponly/secure  // src: vvaharness/detect/patterns.py:140
        specs.addAll(sourceSpecs());       // CWE-20: request accessors -> entry points  // src: vvaharness/detect/patterns.py:198
        return specs;                                                                        // src: vvaharness/detect/patterns.py:213
    }

    /** detector_corpus: S5 rules (role=detector keeps them out of S0's view); every hit goes through S6. */
    List<MatchSpec> detectorCorpus(Theta θ) {
        // 11 rules; per-rule enabled flags are packaged data: form-no-csrf-post and form-get-password ship disabled
        List<MatchSpec> rules = θ["code.s5.detector_rules"];                                 // src: vvaharness/detect/patterns.py:326
        // detector-cookie-httponly (CWE-1004), detector-cookie-secure (CWE-614),
        // detector-autoescape-off-code / -template, detector-jinja-env-noescape, detector-template-safe (CWE-79),
        // detector-docwrite-location (CWE-79, proximity gate: location./document.URL/decodeURIComponent within 3 lines),
        // detector-form-no-csrf-post (CWE-352, OFF), detector-form-get-password (CWE-598, OFF),
        // detector-httpresponse-concat, detector-html-string-concat (CWE-79)
        return rules.filter(r -> r.enabled);                                                 // src: vvaharness/detect/patterns.py:221
    }

    MatchSpec detector(String ruleId, Theta θ) {
        return θ["code.s5.detector_rules"].first(r -> r.ruleId == ruleId);                   // src: vvaharness/pipeline/stages/s1_autoexclude.py:370
    }
}
