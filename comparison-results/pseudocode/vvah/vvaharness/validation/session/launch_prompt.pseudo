// file: vvaharness/validation/session/launch_prompt.py
// S11 launch (user) prompt for one fix-validation session: case/session header, patch-under-validation guidance,
// finding details with bypass hints, and the session config / post markers.

@executedBy(MODEL) @role(prompt) @stage("S11")
class SessionLaunchPrompt {

    Prompt run(Manifest m, Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.launch_prompt.header_finding_and_session"]) p.context("Finding: " + m.caseId + " / Session: " + m.sessionId); // src: vvaharness/validation/session/launch_prompt.py:102
        p.include(patchUnderValidation(θ));
        if (θ["p.launch_prompt.finding_details_block"] && m.finding != null) p.include(findingDetails(m.finding, m.affectedFiles)); // src: vvaharness/validation/session/launch_prompt.py:116
        p.include(sessionConfig(m, θ));
        return p;
    }

    Prompt patchUnderValidation(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.launch_prompt.patch_already_applied"]) p.context("The remediation patch is already applied to this workspace tree; the applied unified diff is in the workspace root"); // src: vvaharness/validation/session/launch_prompt.py:107
        if (θ["p.launch_prompt.read_diff_first_primary_focus"]) p.step(1, "Read the diff first, it is your primary focus, then read the rest of the tree freely for cross-file context"); // src: vvaharness/validation/session/launch_prompt.py:109
        if (θ["p.launch_prompt.follow_grounding_rules"]) p.must("Follow the grounding and independence rules in the system prompt"); // src: vvaharness/validation/session/launch_prompt.py:110
        if (θ["p.launch_prompt.navigate_by_hunk_not_line"]) p.rule("navigate by hunk content and symbol names, never by line number"); // src: vvaharness/validation/session/launch_prompt.py:111
        if (θ["p.launch_prompt.triage_verdict_unverified"]) p.rule("treat the remediator's triage.json verdict as an unverified claim to confirm or refute, not as evidence"); // src: vvaharness/validation/session/launch_prompt.py:112
        return p;
    }

    @executedBy(CODE)
    Prompt findingDetails(Finding f, List<String> affected) {
        Prompt p = new Prompt();
        p.context("Title: " + f.title);                                                             // src: vvaharness/validation/session/launch_prompt.py:84
        p.context("Category: " + (f.cwe != null ? f.cwe : f.vulnClass));                            // src: vvaharness/validation/session/launch_prompt.py:85
        p.context("Severity: " + (f.cvssRating != null ? f.cvssRating : f.severity));               // src: vvaharness/validation/session/launch_prompt.py:87
        if (f.cvssScore != null) p.context("CVSS: " + f.cvssScore + " " + f.cvssVector);            // src: vvaharness/validation/session/launch_prompt.py:90
        if (f.file != null) p.context("Source: " + f.file + ":" + f.lineStart);                     // src: vvaharness/validation/session/launch_prompt.py:92
        if (!affected.isEmpty()) p.context("Affected files: " + affected);                          // src: vvaharness/validation/session/launch_prompt.py:94
        for (String attr : List.of("description", "impact", "exploit_scenario", "preconditions", "recommendation")) { // src: vvaharness/validation/session/launch_prompt.py:31
            if (f.get(attr) != null) p.context(attr + ": " + f.get(attr));                         // src: vvaharness/validation/session/launch_prompt.py:58
        }
        List<String> hints = Hints.hintsFor(f.cwe != null ? f.cwe : f.vulnClass);                   // src: vvaharness/validation/session/launch_prompt.py:72
        if (!hints.isEmpty()) p.checklist(hints);                                                   // src: vvaharness/validation/session/launch_prompt.py:76  (Known bypass patterns)
        return p;
    }

    Prompt sessionConfig(Manifest m, Theta θ) {
        Prompt p = new Prompt();
        // S11 always sets post_results=false (execution/pipeline.py), so post markers are not emitted in-scan.
        p.context("post_results: " + θ["p.launch_prompt.session_config_post_results"]);              // src: vvaharness/validation/session/launch_prompt.py:119
        if (m.postResults && θ["p.launch_prompt.post_markers_block"]) p.format("### Post Markers: <!-- validation-session:<session_id> -->"); // src: vvaharness/validation/session/launch_prompt.py:122
        return p;
    }

    // ---- CODE-side builders: the real functions that assemble the launch prompt text (bullet labels are prompt text, apart from field names) ----

    @executedBy(CODE)
    String scoreLine(String label, Object score, Object vector) {
        // Render a "- **LABEL**: score (vector)" markdown bullet; the vector part is added only when truthy.
        String line = "- **" + label + "**: " + score;                                              // src: vvaharness/validation/session/launch_prompt.py:42
        if (vector != null && !String.valueOf(vector).isEmpty()) line = line + " (" + vector + ")";  // src: vvaharness/validation/session/launch_prompt.py:43
        return line;                                                                                // src: vvaharness/validation/session/launch_prompt.py:45
    }

    @executedBy(CODE)
    String render(Object value) {
        // Render a narrative value: a list or tuple becomes its items joined with a semicolon and a space, never a joined blob; anything else is its string form.
        if (value instanceof List) return value.map(item -> String.valueOf(item)).join("; ");       // src: vvaharness/validation/session/launch_prompt.py:50
        return String.valueOf(value);                                                               // src: vvaharness/validation/session/launch_prompt.py:52
    }

    @executedBy(CODE)
    List<String> narrativeLines(Finding finding, Theta θ) {
        // Markdown bullets for the optional narrative fields that are non-empty, in render order.
        List<String> out = new List();
        for (Pair<String, String> lf : θ["code.validation.session.launch_prompt.narrative_fields"]) { // src: vvaharness/validation/session/launch_prompt.py:31  (Description Detail, Impact, Exploit Scenario, Preconditions, Recommendation)
            Object value = finding.getOr(lf.second, "");                                            // src: vvaharness/validation/session/launch_prompt.py:60
            if (value != null && !value.isEmpty()) out.add("- **" + lf.first + "**: " + render(value)); // src: vvaharness/validation/session/launch_prompt.py:58  (empty values skipped)
        }
        return out;                                                                                 // src: vvaharness/validation/session/launch_prompt.py:57
    }

    @executedBy(CODE)
    String category(Finding finding) {
        // The weakness class as the prompt names it: the CWE when known, else the vuln class value.
        return finding.cwe != null && !finding.cwe.isEmpty() ? finding.cwe : finding.vulnClass.value; // src: vvaharness/validation/session/launch_prompt.py:66
    }

    @executedBy(CODE)
    List<String> bypassHintLines(Finding finding) {
        // Markdown bullets for known bypass patterns of the category (from the validator hints file); an empty list when none.
        String category = category(finding);                                                        // src: vvaharness/validation/session/launch_prompt.py:71
        List<String> hints = Hints.hintsFor(category);                                             // src: vvaharness/validation/session/launch_prompt.py:72
        if (hints.isEmpty()) return List.of();                                                      // src: vvaharness/validation/session/launch_prompt.py:73
        List<String> out = List.of("- **Known bypass patterns for " + category + "**:");           // src: vvaharness/validation/session/launch_prompt.py:76
        for (String hint : hints) out.add("  - " + hint);                                           // src: vvaharness/validation/session/launch_prompt.py:77
        return out;
    }

    @executedBy(CODE)
    void appendFindingDetails(List<String> lines, Finding finding, List<String> affected, Theta θ) {
        // Append a markdown Finding Details section to lines in place. Missing title or category prints the placeholder N/A.
        lines.addAll(List.of("", "## Finding Details", ""));                                        // src: vvaharness/validation/session/launch_prompt.py:83
        lines.add("- **Title**: " + (finding.title != null && !finding.title.isEmpty() ? finding.title : θ["code.validation.session.launch_prompt.missing_field_placeholder"])); // src: vvaharness/validation/session/launch_prompt.py:84
        String cat = category(finding);
        lines.add("- **Category**: " + (cat != null && !cat.isEmpty() ? cat : θ["code.validation.session.launch_prompt.missing_field_placeholder"])); // src: vvaharness/validation/session/launch_prompt.py:85
        lines.add("- **Severity**: " + (finding.cvssRating != null && !finding.cvssRating.isEmpty() ? finding.cvssRating : finding.severity.value)); // src: vvaharness/validation/session/launch_prompt.py:86
        if (finding.cvssScore != null) lines.add(scoreLine("CVSS", finding.cvssScore, finding.cvssVector)); // src: vvaharness/validation/session/launch_prompt.py:89
        if (finding.file != null && !finding.file.isEmpty()) lines.add("- **Source**: " + finding.file + ":" + finding.lineStart); // src: vvaharness/validation/session/launch_prompt.py:91
        if (!affected.isEmpty()) lines.add("- **Affected files**: " + affected.join(", "));         // src: vvaharness/validation/session/launch_prompt.py:93
        lines.addAll(narrativeLines(finding, θ));                                                   // src: vvaharness/validation/session/launch_prompt.py:95
        lines.addAll(bypassHintLines(finding));                                                     // src: vvaharness/validation/session/launch_prompt.py:96
    }

    @executedBy(CODE)
    String buildLaunchPrompt(Manifest manifest, Theta θ) {
        // Compose the fix-validation launch prompt for a pre-staged workspace: case and session header, patch-under-validation paragraph (diff.patch in the workspace root), optional finding details, session config and, when post_results, the post markers.
        List<String> lines = List.of("Finding: " + manifest.caseId, "Session: " + manifest.sessionId, "", "## Patch under validation", "", "The remediation patch is already applied to this workspace tree; the applied unified diff is at diff.patch in the workspace root. Read it first, it is your primary focus, then read the rest of the tree freely for cross-file context. Follow the grounding and independence rules in the system prompt: navigate by hunk content and symbol names, never by line number; treat the remediator's triage.json verdict as an unverified claim to confirm or refute, not as evidence."); // src: vvaharness/validation/session/launch_prompt.py:101
        if (manifest.finding != null) appendFindingDetails(lines, manifest.finding, manifest.affectedFiles, θ); // src: vvaharness/validation/session/launch_prompt.py:115
        lines.add("");                                                                              // src: vvaharness/validation/session/launch_prompt.py:117
        lines.add("## Session Config");                                                             // src: vvaharness/validation/session/launch_prompt.py:118
        lines.add("- post_results: " + (manifest.postResults ? "true" : "false"));                  // src: vvaharness/validation/session/launch_prompt.py:119
        if (manifest.postResults) {                                                                 // src: vvaharness/validation/session/launch_prompt.py:120
            lines.add("");
            lines.add("### Post Markers");                                                          // src: vvaharness/validation/session/launch_prompt.py:122
            lines.add("- Finding " + manifest.caseId + ": <!-- validation-session:" + manifest.sessionId + " -->"); // src: vvaharness/validation/session/launch_prompt.py:123
        }
        return lines.join("\n");                                                                    // src: vvaharness/validation/session/launch_prompt.py:127
    }
}
