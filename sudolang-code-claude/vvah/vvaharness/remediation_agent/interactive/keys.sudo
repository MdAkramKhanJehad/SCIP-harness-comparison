# vvaharness/remediation_agent/interactive/keys.py

Dependency-free terminal key input for the interactive picker: maps raw key sequences to menu tokens and reads one key from a raw terminal.

Source: `vvaharness/remediation_agent/interactive/keys.py` (lines 1-63)
Executor: code
Called from: `interactive/loop.sudo` _loop_tty

// src: vvaharness/remediation_agent/interactive/keys.py:20-21
UP, DOWN, ENTER, QUIT, OTHER = "up", "down", "enter", "quit", "other"

// src: vvaharness/remediation_agent/interactive/keys.py:24-34
fn decode_key(seq):executor=code {
  match (seq) {
    case "\x1b[A" | "\x1bOA" | "k" => UP
    case "\x1b[B" | "\x1bOB" | "j" => DOWN
    case "\r" | "\n" => ENTER
    case "q" | "Q" | "\x1b" | "\x03" | "\x04" => QUIT   // q, Esc, Ctrl-C, Ctrl-D
    default => OTHER
  }
}

// src: vvaharness/remediation_agent/interactive/keys.py:37-63
fn _read_key():executor=code {
  // RAISES on a non-terminal stream; that is how the loop falls back to the numbered prompt
  if (platform is Windows) {
    require msvcrt is importable => throw RuntimeError("no raw keyboard input")
    read one wide character; after the arrow prefix "\x00" or "\xe0" read one more: "H" => UP, "P" => DOWN, else OTHER
    otherwise return decode_key(character)
  }
  require standard input is a terminal => throw RuntimeError("stdin is not a TTY")
  set the terminal to raw mode; read 1 character, plus 2 more after "\x1b"; return decode_key(...)
  constraint OnEveryExit { restore the saved terminal attributes }
}
