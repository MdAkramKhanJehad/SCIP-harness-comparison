# vvaharness/validation/cli/_model.py

Resolves the validation model and backend from the harness profile (`models.validate`), the per-persona model overrides, the reviewer tool allow-list and the cache-marker switch, and refuses a persona model that would route to a different vendor than the orchestrator.

Source: `vvaharness/validation/cli/_model.py` (lines 1-174)
Executor: code
Called from: `vvaharness/validation/cli/__init__.sudo` _trusted_model_env and _preflight

// src: vvaharness/validation/cli/_model.py:35-39
_PERSONA_FIELDS = { security_architect: "security_architect_model", penetration_tester: "penetration_tester_model", cross_repo_analyzer: "cross_repo_analyzer_model" }

// src: vvaharness/validation/cli/_model.py:42-60
LoadedValidateSpec { config: HarnessConfig; spec }
PersonaModelResolution { model_id: String; via: String }
ModelEnvResult { exit_code: Number; overrides: ValidateOverrides }

// src: vvaharness/validation/cli/_model.py:137-174
fn _apply_model_env(config_path):executor=code {
  loaded = _load_validated_spec(config_path)
  require loaded != null => return ModelEnvResult(2, {})
  [cfg, spec] = loaded
  [model_id, via] = backends.llm.registry.resolve(spec)   // external to this area
  [via, provider] = config.validate_role.normalize_validate_backend(via || "", spec.provider)   // legacy via: openai becomes deepagents with provider openai
  overrides = _parser._tunable_overrides(cfg)
  overrides.model = model_id; overrides.via = via; overrides.provider = provider
  overrides.use_responses_api = llm.use_responses_api_of(spec)

  validate = cfg.models.validate
  if (validate != null) {
    for each [short_name, field] in _PERSONA_FIELDS {
      resolved = _persona_spec_resolved(validate[short_name])
      if (resolved != null) overrides[field] = resolved.model_id   // only the model id is used; the persona's via is dropped
    }
    declared = persona names in _PERSONA_FIELDS whose raw spec declares via or provider   // raw-spec check, so a malformed spec still warns
    _warn_ignored_persona_routes(declared, via, provider)
  }

  tools = knob("step_validate.allowed_tools", default=null)
  if (tools is a non-empty list) overrides.validate_tools = join(tools, ",")

  overrides.cache_markers = backends.llm.deepagents.markers_on(cfg.sdk)   // "the sdk block's kill switch gates the deepagents markers too"
  return ModelEnvResult(0, overrides)
}

// src: vvaharness/validation/cli/_model.py:92-106
fn _load_validated_spec(config_path):executor=code {
  require config_path exists => { console: "validate: config not found: $config_path"; return null }
  try cfg = vvaharness.config.load(config_path)
  catch ConfigPolicyError as e => { console: "validate: $e"; return null }
  spec = config.validate_role.validate_model_spec(cfg)   // cfg.models.validate.orchestrator
  require spec != null => { console: "validate: config defines no models.validate role"; return null }
  return LoadedValidateSpec(cfg, spec)
}

// src: vvaharness/validation/cli/_model.py:126-134
fn _persona_spec_resolved(spec?):executor=code {
  if (spec == null) return null
  try [model_id, via] = llm.resolve(spec)
  catch ValueError, AttributeError, KeyError, TypeError => return null   // "malformed spec — fall back to inheriting models.validate"
  return if (model_id) PersonaModelResolution(model_id, via || "") else null
}

// src: vvaharness/validation/cli/_model.py:109-123
fn _declares_route(spec):executor=code = spec.via or spec.provider is set
fn _warn_ignored_persona_routes(declared, via, provider?):executor=code {
  if (declared is empty) return
  console: "validate: models.validate.{<declared joined by \", \">} declare via/provider — ignored; the panel runs on the orchestrator's route (<via>/<provider> or <via>)"
}

// src: vvaharness/validation/cli/_model.py:63-89
fn _check_persona_vendors(overrides):executor=code {
  panel_anthropic = backends.harness.provider_routing.routes_to_anthropic(overrides.model || "", overrides.provider if a non-empty string else null)
  for each [short_name, field] in _PERSONA_FIELDS {
    model = overrides[field]
    if (model is not a non-empty string) continue
    if (routes_to_anthropic(model, null) == panel_anthropic) continue   // "A persona spec contributes only its model id, so the name alone decides."
    return "validate: models.validate.$short_name is '$model', which routes to <the other vendor>, but the panel runs on <panel vendor> (from models.validate.orchestrator). Every persona shares the orchestrator's provider — a persona's own via/provider is not honoured. Set $short_name to <an Anthropic | an OpenAI-compatible> model, or change models.validate.orchestrator."
  }
  return null   // no mismatch
}
