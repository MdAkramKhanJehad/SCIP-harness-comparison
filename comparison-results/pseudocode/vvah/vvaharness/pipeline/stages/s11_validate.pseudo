// file: vvaharness/pipeline/stages/s11_validate.py, vvaharness/orchestrator/scan.py, vvaharness/validation/cli/__init__.py, vvaharness/validation/cli/_run.py, vvaharness/validation/ingest/case_loader.py, vvaharness/validation/execution/pipeline.py, vvaharness/validation/session/launcher.py, vvaharness/validation/cli/_model.py
// S11: validate each S10 fix case with a 3-persona panel (one orchestrator session per case, personas as subagents),
// then synthesize persona gate reports on the host and score the fix. Cases run sequentially.

@executedBy(CODE) @role(stage) @stage("S11")
class S11Validate {

    int run(String repo, Config cfg, String configPath, List<String> findingIds, boolean resume, Path reportMd, Theta θ) {
        // Pipeline gate (scan.py): S11 runs only when step_validate.enabled and the report has findings.
        if (!(θ["step_validate.enabled"] && report.findings.size() > 0)) return 0;                  // src: vvaharness/orchestrator/scan.py:1032
        if (Preflight.validatePreflight(cfg) != null) return 0;                                     // src: vvaharness/orchestrator/scan.py:1035  (disabled with reason)
        List<String> argv = List.of("--repo", repo, "--config", configPath, "--scan-report", reportMd); // src: vvaharness/pipeline/stages/s11_validate.py:37
        for (String id : findingIds) argv.add("--finding", id);                                     // src: vvaharness/pipeline/stages/s11_validate.py:41
        if (resume) argv.add("--resume");                                                           // src: vvaharness/pipeline/stages/s11_validate.py:43
        int code = ValidationCli.main(argv, θ);                                                     // src: vvaharness/pipeline/stages/s11_validate.py:45
        CaseRollup.record(repo);                                                                    // src: vvaharness/pipeline/stages/s11_validate.py:50  (best-effort)
        return code;                                                                                // src: vvaharness/pipeline/stages/s11_validate.py:53
    }
}

// validation/cli: select cases, then validate each one in sequence.
@executedBy(CODE) @role(step) @stage("S11")
class ValidationCli {

    int main(List<String> argv, Theta θ) {
        Args args = Parser.parse(argv);
        Selection sel;
        if (args.findings != null) sel = new Selection(args.findings, null, args.resume);           // src: vvaharness/validation/cli/__init__.py:61
        else if (args.all) sel = new Selection(null, null, args.resume);                            // src: vvaharness/validation/cli/__init__.py:63
        else sel = new Selection(null, args.maxFindings != null ? args.maxFindings : θ["step_validate.max_findings"], args.resume); // src: vvaharness/validation/cli/__init__.py:64
        return runValidation(args.repo, sel, θ);
    }

    int runValidation(String repo, Selection sel, Theta θ) {
        String runId = Checkpoints.runIdFor(repo);                                                  // src: vvaharness/validation/cli/_run.py:395
        Set owned = RemediationAgentProvenance.ownedCases(runId);                                                   // src: vvaharness/validation/cli/_run.py:397  (only cases this run's S10 wrote)
        List<Case> cases = selectCases(repo, sel.caseIds, sel.maxFindings, owned);                  // src: vvaharness/validation/cli/_run.py:399
        if (cases.isEmpty()) return emptySelectionRc(repo);                                         // src: vvaharness/validation/cli/_run.py:404
        int failures = 0;
        List<ValidatedCase> validated = new List();
        for (Case c : cases) {                                                                      // src: vvaharness/validation/cli/_run.py:265  (sequential)
            ValidatedCase r = processCase(c, sel.resume, θ);                                        // src: vvaharness/validation/cli/_run.py:266
            if (r == null) {                                                                        // src: vvaharness/validation/cli/_run.py:267  (refused pre-flight)
                failures = failures + 1;
                continue;
            }
            if (r.sessionFailed) failures = failures + 1;                                           // src: vvaharness/validation/cli/_run.py:270
            validated.add(r);
        }
        ReportAugment.augmentReports(repo, validated);                                              // src: vvaharness/validation/cli/_run.py:419
        // A session failure outranks a verdict.
        return failures > 0 ? 1 : CaseRollup.rcForVerdicts(validated.map(v -> v.verdict));          // src: vvaharness/validation/cli/_run.py:432
    }

    List<Case> selectCases(String repo, List<String> caseIds, Integer maxFindings, Set owned) {
        List<Case> all = CaseLoader.allCases(repo).filter(c -> owned.contains(c.key));              // src: vvaharness/validation/ingest/case_loader.py:188  (owned filter before cap)
        if (caseIds != null) return CaseLoader.selectById(all, caseIds);                            // src: vvaharness/validation/ingest/case_loader.py:190
        List<Case> v = all.filter(c -> c.isValidatable());                                          // src: vvaharness/validation/ingest/case_loader.py:192
        if (maxFindings == null || maxFindings <= 0 || v.size() <= maxFindings) return v;           // src: vvaharness/validation/ingest/case_loader.py:139
        return CaseLoader.topByCvss(v, maxFindings);                                                // src: vvaharness/validation/ingest/case_loader.py:146
    }

    ValidatedCase processCase(Case c, boolean resume, Theta θ) {
        String step = Checkpoints.stepKeyFor(c.caseId);                                                // src: vvaharness/validation/cli/_run.py:224
        if (resume) {                                                                               // src: vvaharness/validation/cli/_run.py:225
            Row cached = Checkpoints.loadCkpt(step);
            if (cached != null && cached.trackingId.equals(c.caseId)) return resumed(c, cached);    // src: vvaharness/validation/cli/_run.py:228
        }
        if (c.attempts.isEmpty()) return null;                                                      // src: vvaharness/validation/cli/_run.py:200  (no remediation attempt)
        if (!Ingest.assertRemediationApplied(c)) return null;                                       // src: vvaharness/validation/cli/_run.py:205
        ValidatedCase r = runPlan(c, θ);                                                            // src: vvaharness/validation/cli/_run.py:210
        Checkpoints.saveCkpt(step, r.row);                                                          // src: vvaharness/validation/cli/_run.py:236
        return r;
    }

    ValidatedCase runPlan(Case c, Theta θ) {
        Workspace ws = Workspace.stageWorkspace(c.repo, c.attempts.last().remediation.diff);                 // src: vvaharness/validation/cli/_run.py:151  (patch applied in a staging tree)
        Manifest m = ManifestBuilder.buildManifest(c, uuid());                                                     // src: vvaharness/validation/cli/_run.py:155
        PlanOutcome out = executePlan(m, ws, θ);                                                    // src: vvaharness/validation/cli/_run.py:161
        Verdict v = CaseWriteback.buildVerdict(c, ws, out.sessionFailed);                                 // src: vvaharness/validation/cli/_run.py:168  (host scoring from synthesized gates)
        CaseWriteback.writeBackVerdict(c, v);                                                       // src: vvaharness/validation/cli/_run.py:193
        return new ValidatedCase(c, v, out.row, out.sessionFailed);
    }

    PlanOutcome executePlan(Manifest m, Workspace ws, Theta θ) {
        m.postResults = false;                                                                      // src: vvaharness/validation/execution/pipeline.py:78
        try {
            ValidationLauncher.launchSession(m, ws, θ);                                             // src: vvaharness/validation/execution/pipeline.py:82
        } catch (ValidationSessionError e) {
            return PlanOutcome.unverifiable(e.reason());                                            // src: vvaharness/validation/execution/pipeline.py:87  (INCONCLUSIVE, no score, session_failed)
        }
        List collected = ResultCollector.collectAndEnrich(ws);                                      // src: vvaharness/validation/execution/pipeline.py:88
        if (collected.isEmpty()) return PlanOutcome.unverifiable("Validation session produced no results"); // src: vvaharness/validation/execution/pipeline.py:90
        return new PlanOutcome(collected);                                                          // src: vvaharness/validation/execution/pipeline.py:91
    }
}

// session/launcher.py: one orchestrator session per case, the three personas as subagents.
@executedBy(CODE) @role(backend) @stage("S11")
class ValidationLauncher {

    ModelCallBudget orchestratorCallBudget(Theta θ) {
        int limit = θ["step_validate.orchestrator_max_model_calls"];                                // src: vvaharness/validation/session/launcher.py:288
        if (limit <= 0) return null;                                                                // src: vvaharness/validation/session/launcher.py:289
        // On the last call only the ValidationOutput tool remains.
        return new ModelCallBudget(limit, Set.of("ValidationOutput"), "s11");                       // src: vvaharness/validation/session/launcher.py:291
    }

    AgentSpec buildValidationOptions(Manifest m, Workspace ws, Prompt system, Config cfg, Theta θ) {
        boolean injectsClaude = Capabilities.of(cfg.agent.via).readsInjectedClaudeConfig;           // src: vvaharness/validation/session/launcher.py:308
        // max_turns on deepagents is a recursion floor (max_turns + 900); hard cap on sdk/cli. timeout dropped on sdk/openai.
        Bounds b = new Bounds(θ["step_validate.max_turns"], θ["step_validate.orchestrator_max_model_calls"], θ["step_validate.timeout"], θ["step_validate.max_budget_usd"]); // src: vvaharness/validation/session/launcher.py:316
        ModelSpec model = new ModelSpec(cfg.agent.model, cfg.agent.via, cfg.agent.provider, θ["step_validate.effort"], 0); // src: vvaharness/validation/session/launcher.py:315
        // Personas: tools narrowed to step_validate.allowed_tools (never dropping fact tools); per-persona model-call cap.
        List<Subagent> personas = SubagentsIndex.loadAgents(θ["step_validate.allowed_tools"], injectsClaude ? "SUBMIT_PROMPT_SUFFIX" : RuleSetText.personaRulesText(θ), θ["step_validate.max_model_calls"], θ); // src: vvaharness/validation/session/launcher.py:333
        Middleware mw = List.of(orchestratorCallBudget(θ));                                         // src: vvaharness/validation/session/launcher.py:342
        // Write gate: the session may only write its output files inside the workspace.
        return new AgentSpec(model, ValidationTools.policy(), List.of("validation-scoring"), system, SessionLaunchPrompt.run(m, θ), b, "ValidationOutput", false); // src: vvaharness/validation/session/launcher.py:309
    }

    Prompt loadSystemPrompt(Config cfg, Theta θ) {
        Prompt p = new Prompt();
        p.include(PromptsSystem.run(θ));                                                            // src: vvaharness/validation/session/launcher.py:406
        p.include(synthesisSection(cfg));                                                           // src: vvaharness/validation/session/launcher.py:407
        p.include(rulesSection(cfg, θ));                                                            // src: vvaharness/validation/session/launcher.py:408
        return p;
    }

    @executedBy(MODEL)
    Prompt synthesisSection(Config cfg) {
        Prompt p = new Prompt();
        if (Capabilities.of(cfg.agent.via).returnsSchemaValidatedReports) {                        // src: vvaharness/validation/session/launcher.py:376
            p.forbid("synthesize across personas, compute scores, or fill synthesized_gates; emit synthesized_gates as []"); // src: vvaharness/validation/session/launcher.py:379
        } else {
            p.must("fill synthesized_gates: 2+ agree -> that status; one evaluated -> that status; disagree -> LOWEST, show both"); // src: vvaharness/validation/session/launcher.py:386
            p.rule("Do NOT compute scores; raw_score, fix_status, merge_readiness are recomputed on the host"); // src: vvaharness/validation/session/launcher.py:392
        }
        return p;
    }

    @executedBy(MODEL)
    Prompt rulesSection(Config cfg, Theta θ) {
        Prompt p = new Prompt();
        if (Capabilities.of(cfg.agent.via).readsInjectedClaudeConfig) {                             // src: vvaharness/validation/session/launcher.py:355
            p.rule("Follow the rules auto-loaded from .claude/rules/");                             // src: vvaharness/validation/session/launcher.py:358
        } else {
            p.include(AdversarialReview.run(θ));                                                    // src: vvaharness/validation/session/launcher.py:366  (orchestrator_rules_text inlined)
            p.include(ScoringMatrix.run(θ));                                                        // src: vvaharness/validation/session/launcher.py:366
        }
        return p;
    }

    int launchSession(Manifest m, Workspace ws, Theta θ) {
        Config cfg = ws.config;
        if (Capabilities.of(cfg.agent.via).readsInjectedClaudeConfig) ConfigInject.injectClaudeConfig(ws); // src: vvaharness/validation/session/launcher.py:604  (.claude/rules + skills)
        AgentSpec spec = buildValidationOptions(m, ws, loadSystemPrompt(cfg, θ), cfg, θ);           // src: vvaharness/validation/session/launcher.py:608
        Transcript t = Runtime.agent(spec);                                                         // src: vvaharness/validation/session/launcher.py:621
        if (Capabilities.of(cfg.agent.via).returnsSchemaValidatedReports && t.state != null) {     // src: vvaharness/validation/session/launcher.py:561
            List<PersonaReport> reports = PersonaReportStash.extractSubagentReports(t.state);       // src: vvaharness/validation/session/launcher.py:272
            List gates = SynthesisConsensus.synthesizeGatesForFinding(reports, m.caseId, θ);        // src: vvaharness/validation/session/launcher.py:254
            ws.writeJson("synthesized_gates.json", gates);                                          // src: vvaharness/validation/session/launcher.py:283
        }
        return t.exitCode;
    }
}
