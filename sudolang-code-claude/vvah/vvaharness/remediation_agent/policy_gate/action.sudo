// src: vvaharness/remediation_agent/policy_gate/action.py:22-25
// Binary by design: there is no "auto" versus "suggest" autonomy mode
Action: "patch" | "guidance_only"   // PATCH: generate and apply a patch (no human gate); GUIDANCE_ONLY: NEVER call the patch model, emit prose advice

// src: vvaharness/remediation_agent/policy_gate/action.py:28-36
Decision {
  action: Action
  reason: String
  matched_rule: String | null = null
  may_generate_patch = (action == PATCH)
}

// src: vvaharness/remediation_agent/policy_gate/action.py:39
_FAIL_CLOSED = Decision(GUIDANCE_ONLY, "policy_unavailable_fail_closed")
