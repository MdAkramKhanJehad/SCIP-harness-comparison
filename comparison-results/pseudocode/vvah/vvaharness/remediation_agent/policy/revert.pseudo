// file: vvaharness/remediation_agent/policy/revert.py
// Roll back forbidden-path edits on disk, confined to the repo: restore from the pre-edit snapshot, else git checkout
// (tracked) or delete (untracked, agent-created). Best-effort, never raises.

@executedBy(CODE) @role(rule_set) @stage("S10")
class Revert {

    boolean isGitWorktree(String repo, Theta θ) {
        try {
            Proc r = Subprocess.run(List.of("git", "-C", repo, "rev-parse", "--is-inside-work-tree"), θ["code.remediation_agent.policy.revert.git_probe_timeout_s"]); // src: vvaharness/remediation_agent/policy/revert.py:30
            return r.returncode == 0 && r.stdout.strip().equals("true");                            // src: vvaharness/remediation_agent/policy/revert.py:33
        } catch (Exception e) {
            return false;                                                                           // src: vvaharness/remediation_agent/policy/revert.py:35
        }
    }

    boolean isTracked(String repo, String rel, Theta θ) {
        try {
            Proc r = Subprocess.run(List.of("git", "-C", repo, "ls-files", "--error-unmatch", "--", rel), θ["code.remediation_agent.policy.revert.git_probe_timeout_s"]); // src: vvaharness/remediation_agent/policy/revert.py:40
            return r.returncode == 0;                                                               // src: vvaharness/remediation_agent/policy/revert.py:43
        } catch (Exception e) {
            return false;                                                                           // src: vvaharness/remediation_agent/policy/revert.py:45
        }
    }

    List<String> revertFiles(String repo, List<String> files, Map<String, String> beforeSnapshot, Theta θ) {
        // Order: pre-edit snapshot, then git checkout (tracked) / delete (untracked), else leave alone.
        Map<String, String> snap = beforeSnapshot != null ? beforeSnapshot : Map.of();              // src: vvaharness/remediation_agent/policy/revert.py:53
        boolean isGit = isGitWorktree(repo, θ);                                                     // src: vvaharness/remediation_agent/policy/revert.py:54
        List<String> reverted = new List();
        for (String raw : files) {                                                                  // src: vvaharness/remediation_agent/policy/revert.py:56
            String rel = Diff.normPath(raw);                                                        // src: vvaharness/remediation_agent/policy/revert.py:57
            if (rel == null || rel.isEmpty()) continue;                                             // src: vvaharness/remediation_agent/policy/revert.py:58
            // Fail closed on abs/../symlink escapes (CWE-22): model refs would unlink host files.
            if (Diff.safeRepoPath(repo, raw) == null) continue;                                     // src: vvaharness/remediation_agent/policy/revert.py:61
            // Repository metadata is never deleted or rewritten.
            if (GitPaths.isGitMetadata(rel)) continue;                                              // src: vvaharness/remediation_agent/policy/revert.py:66
            Path p = Path.of(repo).join(rel);
            try {
                if (snap.containsKey(rel)) {                                                        // src: vvaharness/remediation_agent/policy/revert.py:71
                    String old = snap.get(rel);
                    if (old == null) {                                                              // src: vvaharness/remediation_agent/policy/revert.py:73  (file did not exist before)
                        if (p.exists()) p.unlink();                                                 // src: vvaharness/remediation_agent/policy/revert.py:75
                    } else {
                        p.writeText(old);                                                           // src: vvaharness/remediation_agent/policy/revert.py:77
                    }
                    reverted.add(rel);
                    continue;                                                                       // src: vvaharness/remediation_agent/policy/revert.py:79
                }
                if (isGit) {                                                                        // src: vvaharness/remediation_agent/policy/revert.py:80
                    if (isTracked(repo, rel, θ)) {                                                  // src: vvaharness/remediation_agent/policy/revert.py:81
                        Subprocess.run(List.of("git", "-C", repo, "checkout", "--", rel), θ["code.remediation_agent.policy.revert.git_checkout_timeout_s"]); // src: vvaharness/remediation_agent/policy/revert.py:82
                    } else if (p.exists() && θ["code.remediation_agent.policy.revert.delete_untracked"]) {
                        p.unlink();                                                                 // src: vvaharness/remediation_agent/policy/revert.py:87  (untracked, agent-created)
                    }
                    reverted.add(rel);                                                              // src: vvaharness/remediation_agent/policy/revert.py:88
                }
                // not a git worktree and no snapshot: left alone
            } catch (Exception e) {
                Log.warning("failed to revert", rel);                                               // src: vvaharness/remediation_agent/policy/revert.py:90
            }
        }
        return reverted;                                                                            // src: vvaharness/remediation_agent/policy/revert.py:91
    }
}
