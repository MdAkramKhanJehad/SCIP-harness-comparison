// file: vvaharness/models/vocab.py
// Shared vocabulary: closed enums (Severity, VulnClass, RemediationKind/Outcome, Disposition, Decision, GateStatus,
// CaseState, MergeReadiness) with their lenient parsers, offensive-priority labels and gate-name lists.

@executedBy(CODE) @role(types)
enum Severity {
    CRITICAL, HIGH, MEDIUM, LOW, INFO;

    /** Python's Severity(value) lookup: exact member value first, else _missing_ (Vocab.severityMissing); a miss raises ValueError. */
    @src("vvaharness/models/vocab.py:48")
    static Severity of(Object value) {
        for (Severity m : membersOf("Severity")) if (m.value.equals(value)) return m;
        Severity r = Vocab.severityMissing(value);                                                  // src: vvaharness/models/vocab.py:55
        if (r == null) throw new ValueError();                                                      // Enum raises when _missing_ returns None
        return r;
    }
}
// SEV_RANK: the one severity ranking, CRITICAL=0 .. INFO=4 (declaration order)

@executedBy(CODE) @role(types)
enum VulnClass { UAF, HEAP_OVERFLOW, STACK_OVERFLOW, FMT_STRING, INT_OVERFLOW, TYPE_CONFUSION, RACE, INJECTION, DESERIALIZATION, LOGIC, INFO_LEAK, OTHER }

@executedBy(CODE) @role(types)
enum RemediationKind { EDITS_APPLIED, DIFF_PROPOSED, PULL_REQUEST, NO_ACTION, ALREADY_RESOLVED }

@executedBy(CODE) @role(types)
enum RemediationOutcome { FIXED, PARTIALLY_FIXED, NOT_FIXED, FALSE_POSITIVE, NEEDS_REVIEW, DENIED }

@executedBy(CODE) @role(types)
enum Disposition { FALSE_POSITIVE, POLICY_DENIED, ACCEPTED_RISK, NOT_APPLICABLE }

@executedBy(CODE) @role(types)
enum Decision { FIXED, PARTIALLY_FIXED, NOT_FIXED, INCONCLUSIVE }

@executedBy(CODE) @role(types)
enum GateOutcomeStatus { PASS, PARTIAL, FAIL, SKIP, INVALID }
// real name GateStatus (renamed: name taken elsewhere). INVALID is harness-only and scores as failure, never dropped

@executedBy(CODE) @role(types)
enum CaseState { OPEN, REMEDIATED, VALIDATED, FAILED, DECLINED, PENDING }

@executedBy(CODE) @role(types)
enum MergeReadiness { READY, READY_WITH_CONDITIONS, NOT_READY }

@executedBy(CODE) @role(types)
class Vocab {

    // OFFENSIVE_LABELS: P1 Externally Exploitable, No Auth; P2 Externally Exploitable, Obtainable Auth;
    //                   P3 Internal Network / Privileged Position; P4 Code-Knowledge / Insider Dependent   // src: vvaharness/models/vocab.py:68
    // EVIDENCE_GATES = source, sink, missing_control (asserted by a remediator before patching)          // src: vvaharness/models/vocab.py:189
    // FIX_VALIDATION_GATES = root_cause, instance_coverage, no_new_vulnerabilities, security_best_practices // src: vvaharness/models/vocab.py:192
    // CANONICAL_GATE_NAMES = EVIDENCE_GATES + FIX_VALIDATION_GATES: documented, not enforced            // src: vvaharness/models/vocab.py:200

    String fold(Object value) {
        if (!(value is String)) return null;                                                        // src: vvaharness/models/vocab.py:42
        return value.strip().casefold().replace("-", "_").replace(" ", "_");                       // src: vvaharness/models/vocab.py:44
    }

    /** Severity._missing_: accept any casing, so validation's title-case "Medium" resolves here too. */
    @src("vvaharness/models/vocab.py:57")
    Severity severityMissing(Object value) {
        // any casing accepted; an unknown value stays unresolved (raises)
        String folded = fold(value);
        return membersOf("Severity").firstWhere(m -> m.value.equals(folded), null);                    // src: vvaharness/models/vocab.py:60
    }

    /** VulnClass._missing_: resolve a near-miss label, falling back to OTHER rather than raising. */
    @src("vvaharness/models/vocab.py:93")
    VulnClass vulnClassMissing(Object value) {
        // near-miss label resolves; unknown folds to the fallback class (original label kept in vuln_class_label)
        String folded = fold(value);
        if (folded == null) return θ["code.models.vocab.vuln_class_fallback"];                     // src: vvaharness/models/vocab.py:97
        for (VulnClass m : membersOf("VulnClass")) if (m.value.replace("-", "_").equals(folded)) return m; // src: vvaharness/models/vocab.py:98
        return θ["code.models.vocab.vuln_class_fallback"];                                          // src: vvaharness/models/vocab.py:101
    }

    /** Decision._missing_: fold casing and spacing only, failing closed. */
    @src("vvaharness/models/vocab.py:143")
    Decision decisionMissing(Object value) {
        // fold casing/spacing only, fail closed; no alias for retired values
        String folded = fold(value);
        if (folded == null) return θ["code.models.vocab.decision_fallback"];                       // src: vvaharness/models/vocab.py:147
        return membersOf("Decision").firstWhere(m -> m.value.equals(folded), θ["code.models.vocab.decision_fallback"]); // src: vvaharness/models/vocab.py:148
    }

    /** GateStatus._missing_: resolve a near-miss status, failing closed to INVALID. */
    @src("vvaharness/models/vocab.py:161")
    GateStatus gateStatusMissing(Object value) {
        // near-miss status resolves; anything else fails closed
        String folded = fold(value);
        if (folded == null) return θ["code.models.vocab.gate_status_fallback"];                    // src: vvaharness/models/vocab.py:165
        return membersOf("GateStatus").firstWhere(m -> m.value.equals(folded), θ["code.models.vocab.gate_status_fallback"]); // src: vvaharness/models/vocab.py:166
    }

    String normaliseGateName(String value) {
        // canonicalise spelling; an unknown name passes through, never rejected
        String f = fold(value);
        return f != null ? f : "";                                                                  // src: vvaharness/models/vocab.py:205
    }
}
