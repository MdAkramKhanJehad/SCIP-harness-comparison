// file: vvaharness/orchestrator/scan.py, vvaharness/orchestrator/cleanup.py
// L0 pipeline for one repository: pre-S1 exploit-verification prep, auto-exclude overlay, S0..S9, ingest upload,
// in-scan S10 remediation and S11 validation, each stage behind a checkpoint that --resume may replay.
// Resume rule: a stage reuses its checkpoint only when every upstream stage was itself restored (a re-run invalidates downstream).

@executedBy(CODE) @role(pipeline)
class OrchestratorScan {

    /** L0 overview: the order entry.main reaches scan_repo in (backend config, preflight probe, then this scan). */
    @src("vvaharness/orchestrator/entry.py:305")
    ScanOutcome pipeline(Args args, Config cfg, Theta θ) {
        OrchestratorPreflight.configureBackends(cfg, args.configDir, θ);                                   // src: vvaharness/orchestrator/entry.py:305
        if (!args.skipPreflight && !List.of("clone", "ev").contains(args.stopAfter)) {                       // src: vvaharness/orchestrator/entry.py:319
            if (!OrchestratorPreflight.checkBackends(cfg, OrchestratorEntry.unreachableRoles(args, cfg, θ), θ)) return new ScanOutcome(null, 0, 1); // src: vvaharness/orchestrator/entry.py:334
        }
        return run(args.repo, args.repoName, args.applicationId, args, cfg, null, args.evCollectionIn, θ); // src: vvaharness/orchestrator/entry.py:353
    }

    /** scan_repo: run the profile-selected S0-S11 workflow against one local checkout. Wrapped by SkillsIndex.withInjectedSkills. */
    @src("vvaharness/orchestrator/scan.py:379")
    ScanOutcome run(Path repo, String repoName, String applicationId, Args args, Config cfg, String pathPrefix, Collection evCollectionIn, Theta θ) {
        return SkillsIndex.withInjectedSkills(repo, () -> scanRepo(repo, repoName, applicationId, args, cfg, pathPrefix, evCollectionIn, θ)); // src: vvaharness/orchestrator/scan.py:379
    }

    ScanOutcome scanRepo(Path repo, String repoName, String applicationId, Args args, Config cfg, String pathPrefix, Collection evCollectionIn, Theta θ) {
        String runId = Checkpoints.runIdFor(repo);                                                          // src: vvaharness/orchestrator/scan.py:385
        // SECURITY: checkpoint state must live outside the scanned repo
        Path state = StateStore.stateRoot(θ);                                                               // src: vvaharness/orchestrator/scan.py:388
        Path ckptDir = state.resolve("checkpoints").resolve(runId);                                         // src: vvaharness/orchestrator/scan.py:389
        StateStore.registerRun(runId, repo, repoName, applicationId);                                       // src: vvaharness/orchestrator/scan.py:391
        // Fresh scan = start over (--stop-after ev exempt: it returns before S1)
        if (!args.resume && args.stopAfter != "ev") StateStore.resetRun(runId);                             // src: vvaharness/orchestrator/scan.py:395
        // run_id keys on PATH: a moved HEAD under --resume resets the run
        String repoHead = headSha(repo);                                                                    // src: vvaharness/orchestrator/scan.py:402
        if (args.resume && repoHead != null) {
            String priorHead = Checkpoints.loadCkpt(ckptDir, runId, "repo_identity");                           // src: vvaharness/orchestrator/scan.py:404
            if (priorHead != null && priorHead != repoHead) StateStore.resetRun(runId);                     // src: vvaharness/orchestrator/scan.py:405
        }
        if (repoHead != null) Checkpoints.saveCkpt(ckptDir, runId, "repo_identity", repoHead);                  // src: vvaharness/orchestrator/scan.py:410
        Path outDir = Artifacts.artifactDir(repo, "security-scan");                                         // src: vvaharness/orchestrator/scan.py:413
        int remRc = 0;                                                                                      // src: vvaharness/orchestrator/scan.py:416
        if (args.resume && ckptDir.isInside(repo)) return new ScanOutcome(null, 0, 0);                      // src: vvaharness/orchestrator/scan.py:419
        Path outPath = outDir.resolve(moduleName(repoName) + "_<ts>_report.md");                            // src: vvaharness/orchestrator/scan.py:434
        Path sarifPath = outDir.resolve(moduleName(repoName) + "_<ts>_report.sarif");                       // src: vvaharness/orchestrator/scan.py:435
        ErrLog.configure(outDir.resolve(moduleName(repoName) + "_<ts>_errors.jsonl"));                      // src: vvaharness/orchestrator/scan.py:437

        // ---- pre-S1: exploit verification prep (spend-free; --stop-after ev ends here)
        Map evCollection = evPrep(repo, args, cfg, ckptDir, runId, evCollectionIn, θ);                     // src: vvaharness/orchestrator/scan.py:440
        if (args.stopAfter == "ev") return new ScanOutcome(null, 0, 0);                                     // src: vvaharness/orchestrator/scan.py:442

        // ---- pre-S1: AI auto-exclude overlay (per target, layered on config step1)
        if (args.autoStep1) {                                                                               // src: vvaharness/orchestrator/scan.py:446
            Path autoPath = ckptDir.resolve("step1.yaml");                                                  // src: vvaharness/orchestrator/scan.py:449
            if (!(args.resume && autoPath.isFile())) {                                                      // src: vvaharness/orchestrator/scan.py:450
                try {
                    S1Autoexclude.run(repo, cfg, autoPath, θ);                                              // src: vvaharness/orchestrator/scan.py:453
                } catch (Exception e) {
                    if (isHaltError(e)) throw e;                                                            // src: vvaharness/orchestrator/scan.py:455
                    autoPath = null;                                                                        // src: vvaharness/orchestrator/scan.py:459
                }
            } else {
                // A cached overlay can predate this build's vetoes, so re-vet it
                Overlay stored = Yaml.load(autoPath);                                                       // src: vvaharness/orchestrator/scan.py:463
                Overlay vetted = S1Autoexclude.vetOverlay(repo, cfg, stored, θ);                            // src: vvaharness/orchestrator/scan.py:468
                vetted.configDedup = S1Autoexclude.vetConfigDedup(stored.configDedup, θ);                   // src: vvaharness/orchestrator/scan.py:471
                if (vetted != stored) Yaml.write(autoPath, vetted);                                         // src: vvaharness/orchestrator/scan.py:476
            }
            if (autoPath != null && autoPath.isFile()) {
                cfg = cfg.deepCopy();                                                                       // src: vvaharness/orchestrator/scan.py:496
                // expand=False: the overlay is LLM-authored; placeholders stay literal
                cfg = Config.applyStep1Overlay(cfg, autoPath, false);                                       // src: vvaharness/orchestrator/scan.py:498
            }
        }

        // ---- progress tracker
        ScanProgress tracker = ScanProgress.fromCfg(θ["scan_progress.enabled"], θ["scan_progress.style"], repoName); // src: vvaharness/util/scan_progress.py (from scan.py:506)
        // Banner: role -> model [via] table
        for (Role role : ConfigPaths.iterModelRoles(cfg)) LlmRegistry.resolve(role.model, θ);              // src: vvaharness/orchestrator/scan.py:534
        Path cfgDir = args.config.parent();                                                                 // src: vvaharness/orchestrator/scan.py:539
        List<CVE> cves = CveFeed.loadCves(cfgDir, cfg.inject.cveFile);                                      // src: vvaharness/orchestrator/scan.py:540
        List<Control> controls = DesignControls.loadControls(cfgDir, cfg.inject.controlsFile);              // src: vvaharness/orchestrator/scan.py:541
        Pair<AppProfile, AppInfo> app = Cmdb.loadAppProfile(applicationId);                                 // src: vvaharness/orchestrator/scan.py:542
        AppProfile appProfile = app.first;
        AppInfo appInfo = app.second;
        // Per-stage cost ingredients: role->model ids and the price table
        PriceTable pricing = LlmRegistryConfig.pricingTable(θ);                                             // src: vvaharness/orchestrator/scan.py:552

        // ---- S0: static seed (pure static, zero tokens)
        SeedPackage seed = args.resume ? Checkpoints.loadCkpt(ckptDir, runId, "s0") : null;                    // src: vvaharness/orchestrator/scan.py:570
        if (seed == null) {
            seed = S0Seed.run(repo, cfg, ckptDir, θ);                                                       // src: vvaharness/orchestrator/scan.py:576
            Checkpoints.saveCkpt(ckptDir, runId, "s0", seed);                                                   // src: vvaharness/orchestrator/scan.py:577
            saveStageProvenance("s0");
        } else markCached("s0", tracker);                                                                   // src: vvaharness/orchestrator/scan.py:582
        StateStore.saveCallgraph(runId, "s0", seed);                                                        // src: vvaharness/orchestrator/scan.py:583

        // ---- code graph (never checkpointed: a --resume rebuilds it)
        PluginSet plugins = LlmRegistryConfig.loadPluginSet(cfg, θ);                                        // src: vvaharness/orchestrator/scan.py:585
        plugins.installGraphTools();                                                                        // src: vvaharness/orchestrator/scan.py:586
        Path graphDir = StateStore.ensureStateDir("graphs", runId, uuid());                                 // src: vvaharness/orchestrator/scan.py:588
        // unclear: codegraph/build.py has no .pseudo of its own beyond S0GraphGate in s0_seed.pseudo
        GraphHandle graph = Build.buildGraph(repo, runId, graphDir, plugins.enrichers);                     // src: vvaharness/orchestrator/scan.py:589
        try {
            if (args.stopAfter == "s0") return new ScanOutcome(null, 0, 0);                                 // src: vvaharness/orchestrator/scan.py:593

            // ---- S1: pre-process
            ContextPackage ctx = args.resume ? Checkpoints.loadCkpt(ckptDir, runId, "s1") : null;              // src: vvaharness/orchestrator/scan.py:596
            if (ctx == null) {
                ctx = S1Preprocess.run(repo, cfg, cves, controls, seed, graph, θ);                          // src: vvaharness/orchestrator/scan.py:601
                Checkpoints.saveCkpt(ckptDir, runId, "s1", ctx);                                                // src: vvaharness/orchestrator/scan.py:603
            } else markCached("s1", tracker);
            ctx = hydrateCallgraph(runId, ctx, List.of("s1", "s0"));                                        // src: vvaharness/orchestrator/scan.py:609
            ctx.appProfile = appProfile;                                                                    // src: vvaharness/orchestrator/scan.py:610
            ctx.evCollection = evCollection;                                                                // src: vvaharness/orchestrator/scan.py:611
            ctx.graphHandle = graph;                                                                        // src: vvaharness/orchestrator/scan.py:612
            if (args.stopAfter == "s1") return new ScanOutcome(null, 0, 0);                                 // src: vvaharness/orchestrator/scan.py:613

            // ---- S2: threat model (always runs; S3/S4 mint nothing without it)
            ThreatModel tm = args.resume ? Checkpoints.loadCkpt(ckptDir, runId, "s2") : null;                  // src: vvaharness/orchestrator/scan.py:617
            boolean s2Reran = false;                                                                        // src: vvaharness/orchestrator/scan.py:623
            if (tm == null) {
                s2Reran = true;                                                                             // an attempted re-run already invalidates s3+
                try {
                    tm = S2.run(repo, repoName, cfg, cves, controls, ctx, appProfile, θ);                  // src: vvaharness/orchestrator/scan.py:631
                    // An empty model is never checkpointed (it would pin --resume forever)
                    if (!tm.threats.isEmpty() || !tm.assets.isEmpty() || !tm.trustBoundaries.isEmpty()) Checkpoints.saveCkpt(ckptDir, runId, "s2", tm); // src: vvaharness/orchestrator/scan.py:635
                    else Counters.bump("s2_degraded");                                                      // src: vvaharness/orchestrator/scan.py:639
                } catch (S2HollowAfterRetry e) {
                    Counters.bump("s2_degraded");                                                           // src: vvaharness/orchestrator/scan.py:643
                    return new ScanOutcome(null, 0, 1);                                                     // src: vvaharness/orchestrator/scan.py:648
                } catch (Exception e) {
                    if (isHaltError(e)) throw e;                                                            // src: vvaharness/orchestrator/scan.py:650
                    Counters.bump("s2_degraded");                                                           // src: vvaharness/orchestrator/scan.py:659
                    tm = null;                                                                              // stage recorded as error; downstream runs starved
                }
            } else markCached("s2", tracker);
            ctx.threatModel = tm;                                                                           // src: vvaharness/orchestrator/scan.py:664
            ctx = hydrateCallgraph(runId, ctx, List.of("s2", "s1", "s0"));                                  // src: vvaharness/orchestrator/scan.py:666
            if (args.stopAfter == "s2") return new ScanOutcome(null, 0, 0);                                 // src: vvaharness/orchestrator/scan.py:667

            // ---- S3: decompose (reuse only if s2 was restored too)
            TaskManifest manifest = (args.resume && !s2Reran) ? Checkpoints.loadCkpt(ckptDir, runId, "s3") : null; // src: vvaharness/orchestrator/scan.py:671
            boolean s3Resumed = manifest != null;                                                           // src: vvaharness/orchestrator/scan.py:673
            if (manifest == null) {
                manifest = S3Decompose.run(ctx, cfg, θ);                                                    // src: vvaharness/orchestrator/scan.py:678
                Checkpoints.saveCkpt(ckptDir, runId, "s3", manifest);                                           // src: vvaharness/orchestrator/scan.py:679
            } else markCached("s3", tracker);
            if (args.stopAfter == "s3") return new ScanOutcome(null, 0, 0);                                 // src: vvaharness/orchestrator/scan.py:685

            // ---- S4: deep-dive (reuse only if s3 was restored AND the checkpoint has no unresolved unit failure)
            Map s4Ckpt = (args.resume && s3Resumed) ? Checkpoints.loadCkpt(ckptDir, runId, "s4") : null;        // src: vvaharness/orchestrator/scan.py:689
            if (s4Ckpt != null && !Checkpoints.s4StageComplete(s4Ckpt)) s4Ckpt = null;                      // src: vvaharness/orchestrator/scan.py:691
            boolean s4Resumed = s4Ckpt != null;                                                             // src: vvaharness/orchestrator/scan.py:698
            List<Finding> findings;
            Map<String, String> unitOutcomes = new Map();
            boolean externalInput = false;
            if (s4Ckpt == null) {
                Pair<List<Finding>, Map<String, String>> s4 = S4Deepdive.run(manifest.sortedUnits(), ctx, cfg, θ); // src: vvaharness/orchestrator/scan.py:706
                findings = s4.first;
                unitOutcomes = s4.second;
                Checkpoints.saveCkpt(ckptDir, runId, "s4", Map.of("findings", findings, "outcomes", unitOutcomes)); // src: vvaharness/orchestrator/scan.py:708
            } else {
                findings = s4Ckpt.get("findings");                                                          // src: vvaharness/orchestrator/scan.py:715
                unitOutcomes = s4Ckpt.get("outcomes");                                                      // src: vvaharness/orchestrator/scan.py:716
                externalInput = Checkpoints.s4InputKind(s4Ckpt) == "external";                             // src: vvaharness/orchestrator/scan.py:717
                markCached("s4", tracker);
            }
            if (args.stopAfter == "s4") return new ScanOutcome(null, 0, 0);                                 // src: vvaharness/orchestrator/scan.py:720
            int s4Count = findings.size();                                                                  // src: vvaharness/orchestrator/scan.py:724

            // ---- S5 + S6 + S7 (combined S7 bundle; reuse only if s4 was restored)
            Object s7Ckpt = (args.resume && s4Resumed) ? Checkpoints.loadCkpt(ckptDir, runId, "s7") : null;     // src: vvaharness/orchestrator/scan.py:730
            List<Dropped> preDropped; List<Finding> verified; List<Dropped> dropped; List<Finding> canonical; List<Dropped> dupDropped;
            Integer s5OutCount;
            String legacyS7Note = "";
            if (s7Ckpt == null) {
                Map s5Ckpt = (args.resume && s4Resumed) ? Checkpoints.loadCkpt(ckptDir, runId, "s5") : null;    // src: vvaharness/orchestrator/scan.py:734
                boolean s5Resumed = s5Ckpt != null;
                if (s5Ckpt == null) {
                    Pair<List<Finding>, List<Dropped>> s5 = S5.run(findings, ctx, cfg, θ);                  // src: vvaharness/orchestrator/scan.py:742
                    findings = s5.first;
                    preDropped = s5.second;
                    Checkpoints.saveCkpt(ckptDir, runId, "s5", Map.of("findings", findings, "pre_dropped", preDropped)); // src: vvaharness/orchestrator/scan.py:743
                } else {
                    findings = s5Ckpt.get("findings");
                    preDropped = s5Ckpt.get("pre_dropped");
                    markCached("s5", tracker);
                }
                if (args.stopAfter == "s5") return new ScanOutcome(null, 0, 0);                             // src: vvaharness/orchestrator/scan.py:753

                Map s6Ckpt = (args.resume && s5Resumed) ? Checkpoints.loadCkpt(ckptDir, runId, "s6") : null;    // src: vvaharness/orchestrator/scan.py:757
                if (s6Ckpt == null) {
                    ctx = hydrateCallgraph(runId, ctx, List.of("s4", "s3", "s2", "s1", "s0"));              // src: vvaharness/orchestrator/scan.py:761
                    Pair<List<Finding>, List<Dropped>> s6;
                    if (ctx.evCollection != null) {
                        // EV armed: live-verifiable findings to the confirm agent, the rest stay on the static verifier
                        s6 = ExploitVerificationStub.run(findings, ctx, cfg, runId, θ);                     // src: vvaharness/orchestrator/scan.py:771
                    } else {
                        s6 = S6Verify.run(findings, ctx, cfg, runId, θ);                                    // src: vvaharness/orchestrator/scan.py:774
                    }
                    verified = verifiedOrder(s6.first);                                                     // src: vvaharness/orchestrator/scan.py:775
                    dropped = s6.second;
                    Checkpoints.saveCkpt(ckptDir, runId, "s6", Map.of("verified", verified, "dropped", dropped)); // src: vvaharness/orchestrator/scan.py:776
                } else {
                    verified = verifiedOrder(s6Ckpt.get("verified"));                                       // src: vvaharness/orchestrator/scan.py:784
                    dropped = s6Ckpt.get("dropped");
                    markCached("s6", tracker);
                }
                if (args.stopAfter == "s6") return new ScanOutcome(null, 0, 0);                             // src: vvaharness/orchestrator/scan.py:787
                ctx = hydrateCallgraph(runId, ctx, List.of("s4", "s3", "s2", "s1", "s0"));                  // src: vvaharness/orchestrator/scan.py:790
                Pair<List<Finding>, List<Dropped>> s7 = S7Dedup.run(verified, cfg, ctx, θ);                 // src: vvaharness/orchestrator/scan.py:795
                canonical = s7.first;
                dupDropped = s7.second;
                pruneEvReplays(runId, canonical, ctx);                                                      // src: vvaharness/orchestrator/scan.py:797
                s5OutCount = findings.size();                                                               // src: vvaharness/orchestrator/scan.py:799
                Checkpoints.saveCkpt(ckptDir, runId, "s7", List.of(preDropped, verified, dropped, canonical, dupDropped, s5OutCount)); // src: vvaharness/orchestrator/scan.py:800
            } else if (s7Ckpt.size() == 6) {
                // current 6-tuple: s5/s6/s7 all replayed from the bundle
                s5OutCount = s7Ckpt.get(5);                                                                 // src: vvaharness/orchestrator/scan.py:809
            } else if (s7Ckpt.size() == 5) {
                s5OutCount = null;                                                                          // src: vvaharness/orchestrator/scan.py:816
                legacyS7Note = "s5 post-enrich count unavailable for the finding ledger balance check (legacy checkpoint)"; // src: vvaharness/orchestrator/scan.py:817
            } else {
                preDropped = List.of();                                                                     // src: vvaharness/orchestrator/scan.py:824
                s5OutCount = null;
                legacyS7Note = "s5 drop audit unavailable (legacy checkpoint)";                             // src: vvaharness/orchestrator/scan.py:827
            }
            if (List.of("s5", "s6").contains(args.stopAfter)) return new ScanOutcome(null, 0, 0);          // src: vvaharness/orchestrator/scan.py:832
            EnrichFindings.enrich(canonical, appInfo, pathPrefix);                                          // src: vvaharness/orchestrator/scan.py:834
            List<Dropped> allDropped = preDropped + dropped + dupDropped;                                   // src: vvaharness/orchestrator/scan.py:835
            int rawCount = s5OutCount != null ? s5OutCount : s4Count;                                       // src: vvaharness/orchestrator/scan.py:837
            if (s5OutCount != null) {
                String ledgerMsg = ledgerImbalance(s5OutCount, verified, dropped);                          // src: vvaharness/orchestrator/scan.py:839
                if (ledgerMsg != null) ErrLog.log("s6-verify", repoName, ledgerMsg, true);                  // src: vvaharness/orchestrator/scan.py:843
            }
            if (args.stopAfter == "s7") return new ScanOutcome(null, 0, 0);                                 // src: vvaharness/orchestrator/scan.py:845

            // ---- S8: chain (reuse only if s7 was restored)
            ctx = hydrateCallgraph(runId, ctx, List.of("s4", "s3", "s2", "s1", "s0"));                      // src: vvaharness/orchestrator/scan.py:849
            boolean s7Resumed = s7Ckpt != null;                                                             // src: vvaharness/orchestrator/scan.py:853
            FinalReport report = (args.resume && s7Resumed) ? Checkpoints.loadCkpt(ckptDir, runId, "s8") : null; // src: vvaharness/orchestrator/scan.py:854
            if (report == null) {
                Metrics metrics = Metrics.build(ctx, manifest, rawCount, verifiedCounts(verified), dropped, dupDropped, unitOutcomes, externalInput, pricing); // src: vvaharness/orchestrator/scan.py:861
                report = S8Chain.run(canonical, ctx, cfg, allDropped, rawCount, metrics, θ);                // src: vvaharness/orchestrator/scan.py:874
                report.threatModel = tm;                                                                    // src: vvaharness/orchestrator/scan.py:882
                report.threatsWithoutUnit = manifest.threatsWithoutUnitFor(tm);                             // src: vvaharness/orchestrator/scan.py:884
                // gate 1 of 2: populate the unreachable appendix
                if (θ["output.emit_unreachable_appendix"]) report.unreachableFiles = manifest.unreachableFiles; // src: vvaharness/orchestrator/scan.py:885
                report.gitSha = headSha(repo);                                                              // src: vvaharness/orchestrator/scan.py:888
                Checkpoints.saveCkpt(ckptDir, runId, "s8", report);                                             // src: vvaharness/orchestrator/scan.py:889
            } else markCached("s8", tracker);
            // Degradation: legacy S7 note, upstream stage errors, s4 halted units (append-once)
            if (!legacyS7Note.isEmpty()) report.appendDegraded(legacyS7Note);                               // src: vvaharness/orchestrator/scan.py:895
            for (String stageId : List.of("s2", "s4", "s6")) {                                              // src: vvaharness/orchestrator/scan.py:903
                if (Stages.outcome(stageId) == "error") report.appendDegraded(stageId + " failed");         // src: vvaharness/orchestrator/scan.py:905
            }
            int nHalted = unitOutcomes.values().count(v -> v == "halted");                                 // src: vvaharness/orchestrator/scan.py:925
            if (nHalted > 0) report.appendDegraded("s4 halted early: units not analyzed");                  // src: vvaharness/orchestrator/scan.py:926
            int degradedRc = report.degraded ? 1 : 0;                                                       // src: vvaharness/orchestrator/scan.py:935

            // ---- output writing: case ids, findings.json, markdown report
            CaseIds.mint(report);                                                                           // src: vvaharness/orchestrator/scan.py:938
            FindingsJson.write(report, repo);                                                               // src: vvaharness/orchestrator/scan.py:946
            // gate 2 of 2: render the appendix; posture findings get their own subsection
            String mdText = Redact.redact(report.toMarkdown(θ["output.posture_channel"], θ["output.emit_unreachable_appendix"])); // src: vvaharness/orchestrator/scan.py:949
            outPath.write(mdText);                                                                          // src: vvaharness/orchestrator/scan.py:953
            if (args.stopAfter == "s8") return new ScanOutcome(outPath, report.findings.size(), remRc != 0 ? remRc : degradedRc); // src: vvaharness/orchestrator/scan.py:958

            // ---- S9: SARIF (re-run if checkpoint missing or the file is gone)
            Object s9Done = args.resume ? Checkpoints.loadCkpt(ckptDir, runId, "s9") : null;                    // src: vvaharness/orchestrator/scan.py:961
            if (s9Done == null || !sarifPath.exists()) {
                S9Sarif.run(report, sarifPath, applicationId, appInfo, cfg, θ);                             // src: vvaharness/orchestrator/scan.py:966
                Checkpoints.saveCkpt(ckptDir, runId, "s9", sarifPath);                                          // src: vvaharness/orchestrator/scan.py:970
            } else markCached("s9", tracker);

            // ---- ingest upload (once per run; checkpointed so --resume does not re-send)
            Object ingestDone = args.resume ? Checkpoints.loadCkpt(ckptDir, runId, "ingest") : null;            // src: vvaharness/orchestrator/scan.py:977
            if (ingestDone == null) {
                if (uploadToIngest(outPath, sarifPath, repoName, applicationId, cfgDir, θ)) Checkpoints.saveCkpt(ckptDir, runId, "ingest", true); // src: vvaharness/orchestrator/scan.py:981
            }
            if (args.stopAfter == "s9") return new ScanOutcome(outPath, report.findings.size(), remRc != 0 ? remRc : degradedRc); // src: vvaharness/orchestrator/scan.py:992

            // ---- S10: remediation (fix mode), inside the scan so the clone still exists
            boolean remOn = args.remediate || cfg.stepRemediate.enabled;                                    // src: vvaharness/orchestrator/scan.py:997
            if (remOn && !report.findings.isEmpty()) {                                                      // src: vvaharness/orchestrator/scan.py:1000
                String remErr = remediatePreflight(cfg, args, repo, report, θ);                             // src: vvaharness/orchestrator/scan.py:1003
                if (remErr == null) remRc = runRemediation(report, repo, cfg, ckptDir, runId, args, outPath, θ); // src: vvaharness/orchestrator/scan.py:1014
                // else: stage DISABLED, scan continues
            }
            if (args.stopAfter == "s10") return new ScanOutcome(outPath, report.findings.size(), remRc != 0 ? remRc : degradedRc); // src: vvaharness/orchestrator/scan.py:1024

            // ---- S11: validation
            int valRc = 0;                                                                                  // src: vvaharness/orchestrator/scan.py:1028
            boolean valOn = cfg.stepValidate.enabled;                                                       // src: vvaharness/orchestrator/scan.py:1030
            if (valOn && !report.findings.isEmpty()) {                                                      // src: vvaharness/orchestrator/scan.py:1032
                String valErr = validatePreflight(cfg, θ);                                                  // src: vvaharness/orchestrator/scan.py:1035
                if (valErr == null) {
                    valRc = S11Validate.run(repo, cfg, args.config, args.resume, outPath, θ);              // src: vvaharness/orchestrator/scan.py:1045
                }
            }
            // s10 first: a broken pipeline outranks a broken validation
            int rc = remRc != 0 ? remRc : (valRc != 0 ? valRc : degradedRc);                                // src: vvaharness/orchestrator/scan.py:1066
            return new ScanOutcome(outPath, report.findings.size(), rc);                                    // src: vvaharness/orchestrator/scan.py:1066
        } finally {
            tracker.stopLive();                                                                             // src: vvaharness/orchestrator/scan.py:1068
            if (graph != null) graph.close();                                                               // src: vvaharness/orchestrator/scan.py:1070
            Files.rmtree(graphDir);                                                                         // src: vvaharness/orchestrator/scan.py:1072
        }
    }

    /** Exploit-verification prep before S1: resolve the collection, probe reachability, OOB self-test. Returns null when EV is off. */
    @src("vvaharness/orchestrator/scan.py:214")
    Map evPrep(Path repo, Args args, Config cfg, Path ckptDir, String runId, Collection collectionIn, Theta θ) {
        if (EvGateStub.profileDisabled(cfg, θ)) return null;                                  // src: vvaharness/orchestrator/scan.py:223
        Pair<Collection, Boolean> c = evCollectionIn(args, ckptDir, runId, collectionIn, θ);               // src: vvaharness/orchestrator/scan.py:225
        if (c.first == null) {
            // enabled: true means REQUIRED
            if (EvGateStub.required(cfg, θ)) throw new EVInputError("enabled: true requires a collection"); // src: vvaharness/orchestrator/scan.py:228
            return null;
        }
        Options opts = EvGateStub.loadOptions(cfg, c.second, θ);                               // src: vvaharness/orchestrator/scan.py:235
        if (!opts.enabled) return null;                                                                     // src: vvaharness/orchestrator/scan.py:236
        if (!c.second) Checkpoints.saveCkpt(ckptDir, runId, "ev_collection", c.first);                          // src: vvaharness/orchestrator/scan.py:253
        Collection col = EvGateStub.runProbe(c.first, opts, θ);                                // src: vvaharness/orchestrator/scan.py:255
        if (col == null) return null;                                                                       // on_unreachable=abort disabled EV // src: vvaharness/orchestrator/scan.py:259
        return col.modelDump();                                                                             // src: vvaharness/orchestrator/scan.py:262
    }

    /** Collection precedence: EV_API_COLLECTION (via the entry gate), else the checkpoint under --resume only. */
    Pair<Collection, Boolean> evCollectionIn(Args args, Path ckptDir, String runId, Collection collectionIn, Theta θ) {
        if (θ["env.EV_API_COLLECTION"] != null) return new Pair(collectionIn, false);                       // src: vvaharness/orchestrator/scan.py:191
        if (!args.resume) return new Pair(null, false);                                                     // src: vvaharness/orchestrator/scan.py:199
        Collection col = Checkpoints.loadCkpt(ckptDir, runId, "ev_collection");                                 // src: vvaharness/orchestrator/scan.py:201
        return new Pair(col, col != null);                                                                  // src: vvaharness/orchestrator/scan.py:211
    }

    /** Upload markdown + SARIF to the ingest hub; non-fatal; a configured CA path that is missing fails closed. */
    @src("vvaharness/orchestrator/scan.py:302")
    boolean uploadToIngest(Path mdPath, Path sarifPath, String repoName, String applicationId, Path cfgDir, Theta θ) {
        String url = θ["output.ingest_url"];                                                                // src: vvaharness/orchestrator/scan.py:308
        String token = θ["output.ingest_token"];                                                            // src: vvaharness/orchestrator/scan.py:309
        if (url == null || url.isEmpty()) return false;                                                     // src: vvaharness/orchestrator/scan.py:310
        if (token == null || token.isEmpty()) return false;                                                 // src: vvaharness/orchestrator/scan.py:313
        if (!mdPath.exists() || !sarifPath.exists()) return false;                                          // src: vvaharness/orchestrator/scan.py:316
        Object verify = θ["output.ingest_verify"];                                                          // src: vvaharness/orchestrator/scan.py:320
        if (verify == null) verify = θ["sdk.verify_ssl"];                                                   // src: vvaharness/orchestrator/scan.py:322
        if (verify instanceof String) {
            verify = cfgDir.resolve(verify);                                                                // src: vvaharness/orchestrator/scan.py:325
            if (!Path.of(verify).exists()) return false;                                                    // SECURITY: fail CLOSED // src: vvaharness/orchestrator/scan.py:326
        }
        Response resp = Http.post(url, "Bearer " + token, Map.of("repositoryName", repoName, "applicationId", applicationId), List.of(mdPath, sarifPath), 60, verify); // src: vvaharness/orchestrator/scan.py:348
        return resp.status < 400;                                                                           // src: vvaharness/orchestrator/scan.py:349
    }

    /** S10 delegation: rank, drop posture findings, cap top-N, then run the Remediation Agent per finding. */
    @src("vvaharness/orchestrator/scan.py:1075")
    int runRemediation(FinalReport report, Path repo, Config cfg, Path ckptDir, String runId, Args args, Path reportMd, Theta θ) {
        // --top overrides step_remediate.top_n_findings; posture findings filtered BEFORE the cap
        int effTop = Topspec.resolveTop(args.top, θ["step_remediate.top_n_findings"]);                                        // src: vvaharness/orchestrator/scan.py:1096
        List<Finding> findings = Topspec.selectTopByCvss(Topspec.dropNonMainChannel(report.findings), effTop); // src: vvaharness/orchestrator/scan.py:1098
        String via = LlmRegistry.resolve(cfg.models.remediate, θ).via;                                      // src: vvaharness/orchestrator/scan.py:1106
        // via openai has no Edit/Write tool: fix mode errors per finding
        return RemediationAgentRemediate.run(repo, findings, ckptDir, runId, args.resume, "fix", reportMd, cfg, θ); // src: vvaharness/orchestrator/scan.py:1125
    }

    /** Hard checks before S10; an error string DISABLES remediation (scan continues). */
    String remediatePreflight(Config cfg, Args args, Path repo, FinalReport report, Theta θ) {
        if (cfg.models.remediate == null) return "models.remediate must be set";                            // src: vvaharness/orchestrator/scan.py:1150
        ResolvedModel m = LlmRegistry.resolve(cfg.models.remediate, θ);                                     // src: vvaharness/orchestrator/scan.py:1161
        if (!Environment.backendCredentialOk(m.via, m.modelId, θ["models.remediate.provider"])) return "credential missing"; // src: vvaharness/orchestrator/scan.py:1162
        String cur = headSha(repo);                                                                         // src: vvaharness/orchestrator/scan.py:1167
        if (report.gitSha != null && cur != null && report.gitSha != cur && !args.force) return "HEAD moved since scan"; // src: vvaharness/orchestrator/scan.py:1168
        return null;
    }

    /** Hard checks before S11; symmetrical with remediatePreflight. */
    String validatePreflight(Config cfg, Theta θ) {
        if (θ["models.validate.orchestrator.id"] == null) return "models.validate.orchestrator must be set"; // src: vvaharness/orchestrator/scan.py:1185
        ResolvedModel m = LlmRegistry.resolve(cfg.models.validate.orchestrator, θ);                         // src: vvaharness/orchestrator/scan.py:1188
        return Environment.backendCredentialOk(m.via, m.modelId, θ["models.validate.orchestrator.provider"]) ? null : "credential missing"; // src: vvaharness/orchestrator/scan.py:1192
    }

    /** Finding ledger balance: entered S6 == (verified - discovered - clones) + dropped-from-S5. */
    @src("vvaharness/orchestrator/scan.py:133")
    String ledgerImbalance(int s5OutCount, List<Finding> verified, List<Dropped> dropped) {
        int discovered = verified.count(f -> f.origin == "s6_discovered");                                  // src: vvaharness/orchestrator/scan.py:136
        int clones = verified.count(f -> f.isRepeatClone);                                                  // src: vvaharness/orchestrator/scan.py:137
        int droppedFromS5 = dropped.count(d -> !d.chunkId.endsWith("+s6"));                                 // src: vvaharness/orchestrator/scan.py:138
        int accounted = (verified.size() - discovered - clones) + droppedFromS5;                            // src: vvaharness/orchestrator/scan.py:139
        return accounted == s5OutCount ? null : "finding ledger does not balance";                          // src: vvaharness/orchestrator/scan.py:140
    }

    Counts verifiedCounts(List<Finding> verified) {
        List<Finding> tps = verified.filter(f -> f.verdict == "TRUE_POSITIVE");                             // src: vvaharness/orchestrator/scan.py:157
        return new Counts(tps.size(), tps.count(f -> f.origin == "s6_discovered"), tps.count(f -> f.isRepeatClone), verified.size() - tps.size()); // src: vvaharness/orchestrator/scan.py:158
    }

    List<Finding> verifiedOrder(List<Finding> verified) {
        return verified.sortedBy(f -> List.of(f.file, f.lineStart, f.lineEnd, f.cwe, f.vulnClass, f.title, f.chunkId)); // src: vvaharness/orchestrator/scan.py:166
    }

    void pruneEvReplays(String runId, List<Finding> canonical, ContextPackage ctx) {
        if (ctx.evCollection == null) return;                                                               // src: vvaharness/orchestrator/scan.py:174
        StateStore.pruneReplays(runId, canonical);                                                          // src: vvaharness/orchestrator/scan.py:178
    }

    ContextPackage hydrateCallgraph(String runId, ContextPackage ctx, List<String> steps) {
        for (String step : steps) {                                                                         // first hit wins // src: vvaharness/orchestrator/scan.py:290
            Graph g = StateStore.loadCallgraph(runId, step);
            if (g != null) return ctx.withCallGraph(g);                                                     // src: vvaharness/orchestrator/scan.py:298
        }
        return ctx;
    }

    void markCached(String stepId, ScanProgress tracker) {
        Stages.mark(stepId, "cached");                                                                      // src: vvaharness/orchestrator/scan.py:518
        tracker.stageDone(stepId, "cached");                                                                // src: vvaharness/orchestrator/scan.py:526
    }

    void saveStageProvenance(String stepId) {
        // model, via, config sha256 and token bucket per stage, for --resume under another config
        Checkpoints.saveStageProvenance(stepId);                                                            // src: vvaharness/orchestrator/scan.py:561
    }

    String headSha(Path repo) {
        return Git.revParseHead(repo);                                                                      // src: vvaharness/orchestrator/scan.py:117
    }

    String moduleName(String repoName) {
        return repoName.replaceNonSafe("_");                                                                // src: vvaharness/orchestrator/scan.py:375
    }
}

@executedBy(CODE) @role(io)
@src("vvaharness/orchestrator/cleanup.py:46")
class CloneCleanup {

    /** Directories kept when a batch clone is purged; profile value wins, else the built-in pair. */
    Set<String> preserveSet(Theta θ) {
        List<String> vals = θ["output.preserve_on_cleanup"];                                                // src: vvaharness/orchestrator/cleanup.py:47
        return (vals != null && !vals.isEmpty()) ? Set.copyOf(vals) : Set.of("security-scan", "security-remediation"); // src: vvaharness/orchestrator/cleanup.py:48
    }

    void purgeClone(Path root, Set<String> keep) {
        if (!root.exists()) return;                                                                         // src: vvaharness/orchestrator/cleanup.py:53
        for (Path child : root.children()) {                                                                // src: vvaharness/orchestrator/cleanup.py:55
            if (keep.contains(child.name)) continue;                                                        // src: vvaharness/orchestrator/cleanup.py:56
            Files.delete(child);                                                                            // src: vvaharness/orchestrator/cleanup.py:58
        }
    }
}
