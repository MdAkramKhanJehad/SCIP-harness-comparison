// file: vvaharness/pipeline/stages/s9/health.py
// Builds S9's scan-health block (degradation facts) stamped onto the SARIF run invocation.

@executedBy(CODE) @role(step) @stage("S9")
class S9Health {

    Map scanHealth(FinalReport report) {
        Metrics m = report.metrics;
        boolean emptyScope = m != null && m.totalFilesInScope == 0;                             // src: vvaharness/pipeline/stages/s9/health.py:25
        List<String> coverageReasons = report.coverageDegraded();                               // src: vvaharness/pipeline/stages/s9/health.py:26
        return Map.of(
            "executionSuccessful", !emptyScope,                                                 // src: vvaharness/pipeline/stages/s9/health.py:29
            "hollow", report.isHollow(),                                                        // src: vvaharness/pipeline/stages/s9/health.py:31
            "degraded", report.degraded, "degraded_reason", report.degradedReason,
            "enrichment_unavailable", report.enrichmentUnavailable,                             // src: vvaharness/pipeline/stages/s9/health.py:35
            "coverage_degraded", !coverageReasons.isEmpty(), "coverage_degraded_reasons", coverageReasons,
            "chunks_failed", m != null ? m.chunksFailed : 0,
            "deepdive_skipped", m != null ? m.deepdiveSkipped : false,
            "errors_by_stage", m != null ? m.errorsByStage : Map.of(),
            "threats_total", report.threatModel != null ? report.threatModel.threats.size() : 0, // src: vvaharness/pipeline/stages/s9/health.py:44
            "threats_without_unit", report.threatsWithoutUnit,                                  // src: vvaharness/pipeline/stages/s9/health.py:45
            "threats_before_cap", m != null ? m.s2ThreatsRaw : 0,
            "threats_truncated", m != null ? m.s2ThreatsTruncated : 0,
            "threats_promoted", m != null ? m.s2ThreatsPromoted : 0);                           // src: vvaharness/pipeline/stages/s9/health.py:50
    }
}
