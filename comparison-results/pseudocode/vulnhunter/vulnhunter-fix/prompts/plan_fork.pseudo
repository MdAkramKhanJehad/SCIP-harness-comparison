// file: vulnhunter-fix/prompts/plan_fork.md
// Phase 2 (fork mode): prioritize, live-code pre-check, strict grouping with masked branch names,
// conflict detection, per-finding assessment, plan table and user confirmation.

@executedBy(MODEL) @role(prompt) @stage("fix.plan.fork")
class PlanFork {

    Plan run(List<Finding> findings, String targetRepo, Theta θ) {
        Prompt p = prompt(θ);
        // no interactive collaboration loop, strict per-finding grouping, masked branch naming
        assert θ["p.plan_fork.fork_plan_properties"];                                               // src: vulnhunter-fix/prompts/plan_fork.md:3
        List<Finding> ordered = prioritize(findings, θ);
        List<Finding> live = precheck(ordered, targetRepo, θ);
        List<Group> groups = group(live, θ);
        detectConflicts(groups, θ);
        assess(live, θ);
        return present(groups, live, θ);
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.plan_fork.fork_plan_properties"]);                                              // src: vulnhunter-fix/prompts/plan_fork.md:3
        p.step(1, θ["p.plan_fork.priority_order"]);                                                 // src: vulnhunter-fix/prompts/plan_fork.md:7
        p.tiebreak(θ["p.plan_fork.priority_tiebreak_simpler_first"]);                               // src: vulnhunter-fix/prompts/plan_fork.md:13
        p.step(2, θ["p.plan_fork.live_code_precheck"]);                                             // src: vulnhunter-fix/prompts/plan_fork.md:17
        p.rule(θ["p.plan_fork.precheck_missing_already_fixed"]);                                    // src: vulnhunter-fix/prompts/plan_fork.md:27
        p.rule(θ["p.plan_fork.precheck_rewritten_already_fixed"]);                                  // src: vulnhunter-fix/prompts/plan_fork.md:28
        p.step(3, θ["p.plan_fork.grouping_conditions"]);                                            // src: vulnhunter-fix/prompts/plan_fork.md:34
        p.forbid(θ["p.plan_fork.never_group_different_root_causes"]);                               // src: vulnhunter-fix/prompts/plan_fork.md:39
        p.rule(θ["p.plan_fork.group_branch_pr_tests_1to1"]);                                        // src: vulnhunter-fix/prompts/plan_fork.md:41
        p.forbid(θ["p.plan_fork.masked_descriptor_never_specific"]);                                // src: vulnhunter-fix/prompts/plan_fork.md:43
        p.step(4, θ["p.plan_fork.conflict_detection"]);                                             // src: vulnhunter-fix/prompts/plan_fork.md:47
        p.rule(θ["p.plan_fork.conflict_earlier_in_file_first"]);                                    // src: vulnhunter-fix/prompts/plan_fork.md:49
        p.rule(θ["p.plan_fork.conflict_reread_file"]);                                              // src: vulnhunter-fix/prompts/plan_fork.md:50
        p.step(5, θ["p.plan_fork.assess_items"]);                                                   // src: vulnhunter-fix/prompts/plan_fork.md:54
        p.rule(θ["p.plan_fork.non_patchable_to_issue"]);                                            // src: vulnhunter-fix/prompts/plan_fork.md:61
        p.step(6, θ["p.plan_fork.plan_table_columns"]);                                             // src: vulnhunter-fix/prompts/plan_fork.md:67
        p.format(θ["p.plan_fork.plan_per_finding_notes"]);                                          // src: vulnhunter-fix/prompts/plan_fork.md:71
        p.must(θ["p.plan_fork.user_confirm_before_phase3"]);                                        // src: vulnhunter-fix/prompts/plan_fork.md:75
        return p;
    }

    List<Finding> prioritize(List<Finding> fs, Theta θ) {
        // severity order, then fewer files touched first
        fs.sortBy(f -> θ["p.plan_fork.priority_order"].indexOf(f.severity));                       // src: vulnhunter-fix/prompts/plan_fork.md:7
        fs.thenSortBy(f -> f.filesTouched);                                                         // src: vulnhunter-fix/prompts/plan_fork.md:13
        String tiebreak = θ["p.plan_fork.priority_tiebreak_simpler_first"];                         // src: vulnhunter-fix/prompts/plan_fork.md:13
        return fs;
    }

    List<Finding> precheck(List<Finding> fs, String repo, Theta θ) {
        if (!θ["p.plan_fork.live_code_precheck"]) return fs;                                        // src: vulnhunter-fix/prompts/plan_fork.md:17
        List<Finding> live = new List();
        for (Finding f : fs) {
            Grep g = bash("grep -n <vulnerable_pattern> <target_file>");                            // src: vulnhunter-fix/prompts/plan_fork.md:21
            if (!exists(f.location.file) || !g.found) {
                f.status = θ["p.plan_fork.precheck_missing_already_fixed"];                         // src: vulnhunter-fix/prompts/plan_fork.md:27
                documentInTrackingIssue(f);
            } else if (substantiallyRewritten(f)) {
                f.status = θ["p.plan_fork.precheck_rewritten_already_fixed"];                       // src: vulnhunter-fix/prompts/plan_fork.md:28
            } else {
                live.add(f);                                                                        // src: vulnhunter-fix/prompts/plan_fork.md:26
            }
        }
        return live;
    }

    List<Group> group(List<Finding> fs, Theta θ) {
        List<Group> groups = new List();
        for (Finding f : fs) {
            Group g = groups.find(x -> θ["p.plan_fork.grouping_conditions"].allHold(x, f));         // src: vulnhunter-fix/prompts/plan_fork.md:34
            if (g != null && θ["p.plan_fork.never_group_different_root_causes"] && g.rootCause != f.rootCause) g = null; // src: vulnhunter-fix/prompts/plan_fork.md:39
            if (g == null) {
                g = new Group(f);
                groups.add(g);
            } else {
                g.add(f);
            }
        }
        for (Group g : groups) {
            // one branch, one PR, one set of tests per group
            if (θ["p.plan_fork.group_branch_pr_tests_1to1"]) g.branch = branchFor(g);               // src: vulnhunter-fix/prompts/plan_fork.md:41
            // fix/code-quality-<descriptor>-<hash>; descriptor is generalized, never the vuln class
            if (θ["p.plan_fork.masked_descriptor_never_specific"]) g.branch = Delivery.computeMaskedBranchName(Delivery.cweToDescriptor(g.cwe), g.idempotencyHash); // src: vulnhunter-fix/prompts/plan_fork.md:43
        }
        return groups;
    }

    void detectConflicts(List<Group> groups, Theta θ) {
        if (!θ["p.plan_fork.conflict_detection"]) return;                                           // src: vulnhunter-fix/prompts/plan_fork.md:47
        for (Pair<Group> pr : groups.pairs()) {
            if (pr.sameFileOrOverlappingLines()) {
                noteDependency(pr);                                                                 // src: vulnhunter-fix/prompts/plan_fork.md:48
                if (θ["p.plan_fork.conflict_earlier_in_file_first"]) pr.orderByLine();              // src: vulnhunter-fix/prompts/plan_fork.md:49
                if (θ["p.plan_fork.conflict_reread_file"]) pr.second.rereadBeforeApply = true;      // src: vulnhunter-fix/prompts/plan_fork.md:50
            }
        }
    }

    void assess(List<Finding> fs, Theta θ) {
        for (Finding f : fs) {
            f.assessment = determine(f, θ["p.plan_fork.assess_items"]);                             // src: vulnhunter-fix/prompts/plan_fork.md:54
            // not auto-patchable -> routed to issues in Phase 5 without a fix attempt
            if (!f.assessment.autoPatchable && θ["p.plan_fork.non_patchable_to_issue"]) f.route = "issue"; // src: vulnhunter-fix/prompts/plan_fork.md:61
        }
    }

    Plan present(List<Group> groups, List<Finding> fs, Theta θ) {
        showTable(fs, θ["p.plan_fork.plan_table_columns"]);                                         // src: vulnhunter-fix/prompts/plan_fork.md:67
        for (Finding f : fs) describe(f, θ["p.plan_fork.plan_per_finding_notes"]);                  // src: vulnhunter-fix/prompts/plan_fork.md:71
        Plan plan = new Plan(groups);
        if (θ["p.plan_fork.user_confirm_before_phase3"]) plan.confirmed = askUserConfirm();         // src: vulnhunter-fix/prompts/plan_fork.md:75
        return plan;
    }
}
