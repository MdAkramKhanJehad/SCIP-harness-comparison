# vvaharness/backends/llm/openai_responses.py

Pure translation between the Chat-shaped transcript that the `openai` route keeps and the OpenAI Responses API. `openai.agentic()` sends a model's tool turns through the Responses API once it has learned (or been pinned) that tools and `reasoning_effort` conflict on Chat Completions; these functions build the Responses request from the Chat transcript and turn the Responses reply back into a Chat-like reply. No input or output, no client, no logging.

Source: `vvaharness/backends/llm/openai_responses.py` (lines 1-408)
Executor: code
Called from: `vvaharness/backends/llm/openai.py` `_send_turn` (`to_chat_messages`, `to_responses_request`, `from_response`) and `_check_terminal_finish` / `agentic` (`REASONING_ITEMS_KEY`)

// src: vvaharness/backends/llm/openai_responses.py:46-59
Constants {
  REASONING_ITEMS_KEY = "_reasoning_items"   // on an assistant transcript entry: the Responses reasoning items kept for next-turn replay; stripped before the Chat wire
  ITEM_ID_KEY = "_item_id"   // inside a tool call: the Responses function_call item id kept for replay; stripped before the Chat wire
  INCLUDE_ENCRYPTED_REASONING = ("reasoning.encrypted_content",)   // with store=False the endpoint keeps no per-turn state; encrypted reasoning replays it
  _REASONING_INPUT_FIELDS = ("type", "id", "encrypted_content", "summary")   // allowlist: a replayed OUTPUT-only field such as `status` is rejected as an unknown input parameter
}

## Request side (Chat transcript to Responses request)

// src: vvaharness/backends/llm/openai_responses.py:221-233
fn to_responses_request(messages, base_kw, include_encrypted):executor=code {
  request = { model: base_kw.model, input: to_responses_input(messages) }
  request += _tool_kwargs(base_kw)
  request += _responses_only_kwargs(base_kw, include_encrypted)
  return request
  // Chat-only keys (stream, stream_options, messages, response_format, temperature) are dropped by omission
  // preserved: response_format is never carried over, so a json_schema or json_object request has no Responses equivalent here
}

// src: vvaharness/backends/llm/openai_responses.py:173-188
fn to_responses_input(messages):executor=code {
  items = []
  for each entry in messages {
    match (entry.role) {
      case "assistant" => items += _assistant_items(entry)
      case "tool" => items.append({ type: "function_call_output", call_id: entry.tool_call_id, output: entry.content })
      default => items.append({ role: entry.role, content: _input_content(entry.content) })   // system and user; list blocks of type "text" become "input_text"
    }
  }
  return items
}

// src: vvaharness/backends/llm/openai_responses.py:124-170
fn _assistant_items(entry):executor=code {
  // order: reasoning items, then the text message, then the function calls
  items = copies of entry[REASONING_ITEMS_KEY] that carry encrypted_content   // already allowlisted when stored
  if (entry.content) items.append({ type: "message", role: "assistant", content: [{ type: "output_text", text: entry.content, annotations: [] }] })
  for each tool_call in entry.tool_calls {
    call_item = { type: "function_call", call_id: tool_call.id, name: tool_call.function.name, arguments: tool_call.function.arguments }
    if (tool_call[ITEM_ID_KEY] != null) call_item.id = tool_call[ITEM_ID_KEY]
    items.append(call_item)   // only these fields are read, so no OUTPUT-only field is replayed
  }
  return items
}

// src: vvaharness/backends/llm/openai_responses.py:80-110, 191-199
fn _tool_kwargs(base_kw):executor=code {
  kwargs = {}
  tools = for each Chat tool { type: "function", name, description, parameters, strict: false }   // explicit false: the Responses API attempts strict mode when this is omitted
  if (tools) kwargs.tools = tools
  if (base_kw.tool_choice != null) {
    kwargs.tool_choice = if (tool_choice is { type: "function", function: {...} }) { type: "function", name: tool_choice.function.name } else tool_choice   // strings pass through
  }
  return kwargs
}

// src: vvaharness/backends/llm/openai_responses.py:202-218
fn _responses_only_kwargs(base_kw, include_encrypted):executor=code {
  kwargs = { store: false }   // no per-turn server state
  max_tokens = base_kw.max_completion_tokens or, when absent, base_kw.max_tokens
  if (max_tokens != null) kwargs.max_output_tokens = max_tokens
  effort = base_kw.reasoning_effort
  if (effort != null && effort != REASONING_OFF) kwargs.reasoning = { effort }   // "none" is never sent on this wire: the field is omitted instead
  if (base_kw.prompt_cache_key != null) kwargs.prompt_cache_key = base_kw.prompt_cache_key
  if (include_encrypted) kwargs.include = INCLUDE_ENCRYPTED_REASONING   // openai.py passes false once the model's gateway rejected `include`
  return kwargs
}

