@executedBy(CODE) @role(types)
record EvidenceAnchor(String file, Integer line, String snippet) {
    // frozen, extra ignored; file/snippet default "", line null when unanchored                    // src: vvaharness/models/gates.py:32

    Object noneToEmpty(Object value) {
        return value == null ? "" : value;  // models emit null for evidence with no file anchor     // src: vvaharness/models/gates.py:40
    }
}

