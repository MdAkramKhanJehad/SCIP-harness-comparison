  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Cross-platform exclusive workspace file locking.\"\"\"\n\nfrom __future__ import annotations\n\nimport errno\nimport importlib\nimport os\nfrom pathlib import Path\nfrom typing import BinaryIO, Protocol, cast\n\n\nclass _PosixLocking(Protocol):\n    LOCK_EX: int\n    LOCK_NB: int\n    LOCK_UN: int\n\n    def flock(self, file_descriptor: BinaryIO, operation: int) -> None: ...\n\n\nclass _WindowsLocking(Protocol):\n    LK_NBLCK: int\n    LK_UNLCK: int\n\n    def locking(self, file_descriptor: int, mode: int, byte_count: int) -> None: ...\n\n\nclass WorkspaceFileLock:\n    \"\"\"Owns an exclusive process lock for one workspace lock file.\"\"\"\n\n    def __init__(self, path: Path) -> None:\n        self._file = path.open(\"a+b\")\n        self._locked = False\n        try:\n            _acquire_file_lock(self._file)\n            self._locked = True\n        except Exception:\n            self._file.close()\n            raise\n\n    def release(self) -> None:\n        if not self._locked:\n            return\n        try:\n            _release_file_lock(self._file)\n        finally:\n            self._locked = False\n            self._file.close()\n\n\ndef _acquire_file_lock(lock_file: BinaryIO) -> None:\n    if os.name == \"nt\":\n        _acquire_windows_lock(lock_file)\n        return\n    _acquire_posix_lock(lock_file)\n\n\ndef _release_file_lock(lock_file: BinaryIO) -> None:\n    if os.name == \"nt\":\n        _release_windows_lock(lock_file)\n        return\n    _release_posix_lock(lock_file)\n\n\ndef _load_posix_locking() -> _PosixLocking:\n    return cast(_PosixLocking, importlib.import_module(\"fcntl\"))\n\n\ndef _acquire_posix_lock(lock_file: BinaryIO) -> None:\n    posix_locking = _load_posix_locking()\n    try:\n        posix_locking.flock(lock_file, posix_locking.LOCK_EX | posix_locking.LOCK_NB)\n    except OSError as exc:\n        if exc.errno in {errno.EACCES, errno.EAGAIN}:\n            raise BlockingIOError(errno.EWOULDBLOCK, \"workspace lock is already held\") from exc\n        raise\n\n\ndef _release_posix_lock(lock_file: BinaryIO) -> None:\n    posix_locking = _load_posix_locking()\n    posix_locking.flock(lock_file, posix_locking.LOCK_UN)\n\n\ndef _load_windows_locking() -> _WindowsLocking:\n    return cast(_WindowsLocking, importlib.import_module(\"msvcrt\"))\n\n\ndef _acquire_windows_lock(lock_file: BinaryIO) -> None:\n    windows_locking = _load_windows_locking()\n    if os.fstat(lock_file.fileno()).st_size == 0:\n        lock_file.write(b\"\\0\")\n        lock_file.flush()\n    lock_file.seek(0)\n    try:\n        windows_locking.locking(lock_file.fileno(), windows_locking.LK_NBLCK, 1)\n    except OSError as exc:\n        if exc.errno in {errno.EACCES, errno.EAGAIN, errno.EDEADLK}:\n            raise BlockingIOError(errno.EWOULDBLOCK, \"workspace lock is already held\") from exc\n        raise\n\n\ndef _release_windows_lock(lock_file: BinaryIO) -> None:\n    windows_locking = _load_windows_locking()\n    lock_file.seek(0)\n    windows_locking.locking(lock_file.fileno(), windows_locking.LK_UNLCK, 1)\n",
