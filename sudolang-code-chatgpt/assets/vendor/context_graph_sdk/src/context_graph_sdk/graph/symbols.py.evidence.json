  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Symbol records to project-local graph nodes and immediately safe edges.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\nfrom context_graph_sdk.extractors.records import CALLABLE_LABELS, ExtractionResult, Symbol\nfrom context_graph_sdk.models import GraphNode, LocalRelationshipType\n\n_TEST_DIR = re.compile(\n    r\"(?i)(^|/)(_*test(s|ing|data|util|utils)?([_-]\\w+)?_*\"\n    r\"|[\\w.-]+[_-]test(s|ing|data|util|utils)?([_-]\\w+)?\"\n    r\"|_*specs?_*|[\\w.-]+[_-]specs?\"\n    r\"|__tests__|__mocks__|__snapshots__|e2e|cypress|fixtures?|mocks?|mirage|androidtest)(/|$)\"\n)\n\n_TEST_HELPER_NAMES = frozenset(\n    {\n        \"testing.go\",\n        \"test_helpers.go\",\n        \"test_helper.go\",\n        \"testutil.go\",\n        \"testutils.go\",\n        \"conftest.py\",\n        \"test_helpers.rb\",\n        \"test_helper.rb\",\n        \"spec_helper.rb\",\n        \"rails_helper.rb\",\n    }\n)\n\n\ndef is_test_file(file_path: str) -> bool:\n    lower = file_path.replace(\"\\\\\", \"/\").lower()\n    if _TEST_DIR.search(lower):\n        return True\n    if \".test.\" in lower or \".spec.\" in lower or \".cy.\" in lower:\n        return True\n    if lower.endswith(\"_test.go\"):\n        return True\n    base = lower.rsplit(\"/\", 1)[-1]\n    if base in _TEST_HELPER_NAMES:\n        return True\n    if base.endswith(\".go\") and base.startswith(\"test\") and base != \"testing.go\":\n        stem = base[:-3]\n        if len(stem) == 4 or (len(stem) > 4 and (stem[4].isupper() or stem[4] == \"_\")):\n            return True\n    if base.endswith(\".py\") and (base.startswith(\"test_\") or base.endswith(\"_test.py\")):\n        return True\n    return base.endswith(\"_spec.rb\")\n\n\ndef symbol_properties(symbol: Symbol) -> dict[str, object]:\n    is_test = is_test_file(symbol.file_path)\n    is_exported = symbol.is_exported\n    # Test functions are excluded from the public API surface even when\n    # language visibility rules mark them exported.\n    if is_exported and symbol.label in (\"Function\", \"Method\") and is_test:\n        is_exported = False\n    properties: dict[str, object] = {\n        \"name\": symbol.name,\n        \"filePath\": symbol.file_path,\n        \"startLine\": symbol.start_line,\n        \"endLine\": symbol.end_line,\n        \"isExported\": is_exported,\n        \"language\": symbol.language,\n        \"isTest\": is_test,\n    }\n    if symbol.kind:\n        properties[\"kind\"] = symbol.kind\n    if symbol.content:\n        properties[\"content\"] = symbol.content\n    if symbol.doc_comment:\n        properties[\"description\"] = symbol.doc_comment\n    if symbol.annotations:\n        properties[\"annotations\"] = symbol.annotations\n    if symbol.signature:\n        properties[\"signature\"] = symbol.signature\n    if symbol.parameter_count > 0:\n        properties[\"parameterCount\"] = symbol.parameter_count\n    if symbol.return_type:\n        properties[\"returnType\"] = symbol.return_type\n    return properties\n\n\ndef owner_relationship(symbol: Symbol) -> LocalRelationshipType:\n    if symbol.label in (\"Property\", \"Const\"):\n        return LocalRelationshipType.HAS_PROPERTY\n    if symbol.label in CALLABLE_LABELS:\n        return LocalRelationshipType.HAS_METHOD\n    return LocalRelationshipType.CONTAINS\n\n\ndef same_file_owner(symbol: Symbol, nodes_by_name: dict[str, list[GraphNode]]) -> GraphNode | None:\n    \"\"\"Deterministic same-file owner lookup; owners declared in other files are not linked.\"\"\"\n    for candidate in nodes_by_name.get(symbol.owner_name, []):\n        if candidate.properties.to_dict().get(\"filePath\") == symbol.file_path:\n            return candidate\n    return None\n\n\ndef sorted_symbols(extraction: ExtractionResult) -> list[Symbol]:\n    return sorted(\n        (symbol for _, file_result in extraction.files for symbol in file_result.symbols),\n        key=lambda symbol: (symbol.file_path, symbol.start_line, symbol.id),\n    )\n",
