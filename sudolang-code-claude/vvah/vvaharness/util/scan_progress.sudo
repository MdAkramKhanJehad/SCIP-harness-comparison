# vvaharness/util/scan_progress.py

Per-file scan observability on standard error, enabled by `scan_progress.enabled` or an environment variable. Display only: it changes no pipeline decision. In `llm_debug` style it echoes redacted prompts.

Source: `vvaharness/util/scan_progress.py` (lines 1-469)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (`ScanProgress.from_cfg`, stage hooks), Stage 1, 3 and 4 (`discovered`, `queued`, `scanning`, `scanned`, `print_summary`), backends (`llm_payload` through `get_active_tracker`)

// src: vvaharness/util/scan_progress.py:28-31
Style = "compact" | "verbose" | "summary_only" | "stage_only" | "llm_debug" | "live"

// src: vvaharness/util/scan_progress.py:131-144
fn ScanProgress.from_cfg(cfg, repo_name=""):executor=code {
  enabled = knob("scan_progress.enabled", default=false)
  if (lower-case env VVAHARNESS_SCAN_PROGRESS_ENABLED in ("1", "true", "yes")) enabled = true   // environment can only enable, not disable
  style = knob("scan_progress.style", default="compact"); unknown style -> "compact"
  if (style == "live" && standard error is not a terminal) style = "compact"
}

// src: vvaharness/util/scan_progress.py:105-129, 147-336
ScanProgress {
  // one lock; every emit happens under it so Stage 4 worker threads do not interleave mid-line
  State { _units: Map(unit id -> UnitProgress); _stages; _n_scanning; _n_scanned; _findings; _llm_max_chars = integer env VVAHARNESS_SCAN_PROGRESS_LLM_MAX_CHARS or 12000 }
  fn stage_started(stage_id, label); fn stage_done(stage_id, outcome, detail); fn stage_note(stage_id, detail);
  fn discovered(all_files); fn queued(unit); fn scanning(unit);
  // src: scan_progress.py:260-293
  fn scanned(unit, outcome, n_findings=0) { a unit is counted once even if reported twice }
  // src: scan_progress.py:295-336
  fn print_summary() { "N / total units done"; "WARNING: R unit(s) not scanned (see error log)" when units remain }
  // abstracted: per-style line formatting; summary_only and stage_only suppress most lines; verbose and llm_debug list files
}

// src: vvaharness/util/scan_progress.py:338-375
fn llm_payload(phase, backend, model_id, tag="", user_prompt="", system_prompt=""):executor=code {
  if (!enabled || style != "llm_debug") return
  // echoes system and user prompts, redacted, first _llm_max_chars characters each, with a truncation note; a redaction failure never fails the scan
  // preserved: when redact() raises, the exception is swallowed and the unredacted prompt is echoed (lines 356-362)
}

// src: vvaharness/util/scan_progress.py:393-469
// abstracted: "live" style takes over standard error with a refreshing stage table (rich Live, 8 refreshes per second), falls back to compact on any terminal error, and is stopped at exit; line emits are suppressed while it runs
