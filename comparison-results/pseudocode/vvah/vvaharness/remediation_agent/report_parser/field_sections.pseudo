// file: vvaharness/remediation_agent/report_parser/field_sections.py
// Regexes for the inline metadata lines of a finding block, and splitting the block into its #### sections.

@executedBy(CODE) @role(rule_set) @stage("S10")
class FieldSections {

    // Inline metadata lines emitted under each finding header by the report renderer.
    Regex CLASS_RE = Regex.of("^\\*\\*Class:\\*\\*\\s*(.+?)\\s*$");                                  // src: vvaharness/remediation_agent/report_parser/field_sections.py:21
    Regex CWE_RE = Regex.of("^\\*\\*CWE:\\*\\*\\s*(CWE-\\d+)");                                      // src: vvaharness/remediation_agent/report_parser/field_sections.py:22
    Regex CVSS_SCORE_RE = Regex.of("^\\*\\*CVSS 3\\.1:\\*\\*\\s*\\*\\*([0-9.]+)\\*\\*\\s*\\(([^)]+)\\)\\s*—\\s*`([^`]+)`"); // score, rating, vector; dash is an em dash // src: vvaharness/remediation_agent/report_parser/field_sections.py:23
    Regex CVSS_VECONLY_RE = Regex.of("^\\*\\*CVSS 3\\.1:\\*\\*\\s*`([^`]+)`");                        // src: vvaharness/remediation_agent/report_parser/field_sections.py:25
    // Taint evidence refs: the bundled renderer does not emit these, but a report that does carry them must not drop them (the s4 evidence gate).
    Regex SOURCE_RE = Regex.of("^\\*\\*Source:\\*\\*\\s*`?([^`]+?)`?\\s*$");                         // src: vvaharness/remediation_agent/report_parser/field_sections.py:27
    Regex SINK_RE = Regex.of("^\\*\\*Sink:\\*\\*\\s*`?([^`]+?)`?\\s*$");                             // src: vvaharness/remediation_agent/report_parser/field_sections.py:28
    // Verdict line: group 2 is null when scored as "not scored"; group 3 is the reason after an optional em dash.
    Regex VERDICT_RE = Regex.of("^\\*\\*Verdict:\\*\\*\\s*(\\w+)\\s*\\(confidence:\\s*(?:(\\d+)/10|not scored)\\)\\s*—?\\s*(.*)$"); // src: vvaharness/remediation_agent/report_parser/field_sections.py:30
    // path:174-147 -> file, line_start, line_end
    Regex FILELOC_RE = Regex.of("^(.*?):(\\d+)(?:-(\\d+))?$");                                       // src: vvaharness/remediation_agent/report_parser/field_sections.py:33

    // Split a path:start-end reference into (file, line_start, line_end); falls back to (ref, 0, 0) when malformed.
    Tuple fileLoc(String ref) {
        Match m = FILELOC_RE.match(ref.strip());                                                     // src: vvaharness/remediation_agent/report_parser/field_sections.py:36
        if (m == null) return Tuple.of(ref.strip(), 0, 0);                                           // src: vvaharness/remediation_agent/report_parser/field_sections.py:38
        int start = Integer.parseInt(m.group(2));                                                    // src: vvaharness/remediation_agent/report_parser/field_sections.py:40
        int end = m.group(3) != null ? Integer.parseInt(m.group(3)) : start;                         // no range: end equals start // src: vvaharness/remediation_agent/report_parser/field_sections.py:41
        return Tuple.of(m.group(1).strip(), start, end);                                             // src: vvaharness/remediation_agent/report_parser/field_sections.py:43
    }

    // Split a finding block into its #### sections keyed by lower-cased heading text; text before the first heading is under the empty key. A repeated heading overwrites the earlier one.
    Map<String, String> sections(String body) {
        Map<String, String> out = new HashMap();
        String key = "";                                                                             // src: vvaharness/remediation_agent/report_parser/field_sections.py:46
        List<String> buf = new ArrayList();
        for (String line : body.splitlines()) {                                                      // src: vvaharness/remediation_agent/report_parser/field_sections.py:48
            Match m = Regex.match("^####\\s+(.+?)\\s*$", line);                                      // src: vvaharness/remediation_agent/report_parser/field_sections.py:51
            if (m != null) {
                out.put(key, String.join("\n", buf).strip());                                        // close the previous section // src: vvaharness/remediation_agent/report_parser/field_sections.py:53
                key = m.group(1).strip().lower();                                                    // src: vvaharness/remediation_agent/report_parser/field_sections.py:55
                buf = new ArrayList();
                continue;
            }
            buf.add(line);                                                                           // src: vvaharness/remediation_agent/report_parser/field_sections.py:58
        }
        out.put(key, String.join("\n", buf).strip());                                                // src: vvaharness/remediation_agent/report_parser/field_sections.py:60
        return out;
    }

    // Contents of the first fenced code block (language tag ignored); empty when none.
    String firstCodeBlock(String text) {
        Match m = Regex.dotallSearch("```[^\\n]*\\n(.*?)\\n```", text);                              // src: vvaharness/remediation_agent/report_parser/field_sections.py:63
        return m != null ? m.group(1) : "";                                                          // src: vvaharness/remediation_agent/report_parser/field_sections.py:66
    }
}
