// src: vvaharness/remediation_agent/report_augment/dto.py:36-55
FINDING_CASE_FILENAME = "finding_case.json"
TRIAGE_RELPATH = "evidence/triage.json"
REMEDIATED = "remediated"; DENY = "deny"; SKIPPED = "skipped"   // narrower than CaseState on purpose
_NOT_PROCESSED_REASON = "finding not processed for remediation"
_STATE_BUCKET = { REMEDIATED: REMEDIATED, VALIDATED: REMEDIATED, FAILED: SKIPPED, DECLINED: SKIPPED, OPEN: SKIPPED, PENDING: SKIPPED }

// src: vvaharness/remediation_agent/report_augment/dto.py:58-65
CaseRecord { bucket; reason; case = null; false_positive = false }

// src: vvaharness/remediation_agent/report_augment/dto.py:68-100
fn _load_cases(rem_dir):executor=code {
  for each path in sorted glob "rem_dir/*/finding_case.json" {
    case = FindingCase.read(path), or skipped with a warning when unreadable or invalid
    [bucket, reason] = _bucket_and_reason(case, triage.json beside it, or {} when absent or invalid)
    append CaseRecord(bucket, reason, case, false_positive = (newest attempt's disposition == FALSE_POSITIVE))
  }
  return records
}

// src: vvaharness/remediation_agent/report_augment/dto.py:103-125
fn _bucket_and_reason(case, triage):executor=code {
  remediation = newest attempt's remediation, or null   // the last attempt is what the report reflects
  summary = trimmed remediation.summary or ""
  // a policy denial is called out separately because a human must act
  if (remediation.disposition == POLICY_DENIED) return [DENY, triage.policy_reason or summary or "policy gate denied automated remediation"]
  bucket = _STATE_BUCKET[case.state]
  if (bucket == REMEDIATED) return [REMEDIATED, summary or "remediation applied"]
  return [SKIPPED, summary or _skipped_reason(case)]
}

// src: vvaharness/remediation_agent/report_augment/dto.py:117-125
fn _skipped_reason(case):executor=code {
  if (newest disposition == FALSE_POSITIVE) return "finding rejected as a false positive"
  if (case.state == FAILED) return "fix applied but failed validation; needs rework"
  if (case.state == OPEN && case.attempts) return "fix applied; validation inconclusive, pending re-validation"
  return "remediation not applied; needs review"
}

// src: vvaharness/remediation_agent/report_augment/dto.py:141-176
fn _skipped_record():executor=code { return CaseRecord(bucket=SKIPPED, reason=_NOT_PROCESSED_REASON) }   // for a finding never processed
fn _files_touched(record):executor=code { return newest attempt's files_touched, non-empty, unique, first-seen order }   // the harness-measured list (plugin_runner/run.sudo), not the model's claim
fn _remediation_block(record):executor=code { return { remediationStatus: record.bucket, remediationReason: first 2000 characters of record.reason } }
