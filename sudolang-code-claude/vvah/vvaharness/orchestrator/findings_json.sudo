# vvaharness/orchestrator/findings_json.py

The typed scan result written beside the Markdown report, so later processes (remediation, validation, other tools) read findings without re-parsing Markdown.

Source: `vvaharness/orchestrator/findings_json.py` (lines 1-72)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` scan_repo (`write_findings_json`, after case ids are minted); readers in remediation and validation

// src: vvaharness/orchestrator/findings_json.py:41-55
fn findings_json_path(repo):executor=code { return "$repo/security-scan/findings.json" }
fn write_findings_json(report, repo):executor=code {
  out_dir = artifacts.artifact_dir(repo, SCAN_DIR_NAME)   // refuses a symlinked or escaping directory
  create out_dir
  payload = JSON of redact_tree(report as JSON data)   // secrets redacted
  write payload to "findings.json.tmp", then atomically replace findings.json
  return path
}

// src: vvaharness/orchestrator/findings_json.py:58-72
fn read_findings_json(repo):executor=code {
  path = findings_json_path(repo)
  if (path is not a file) return null   // absent: an older build
  try return FinalReport validated from path;
  catch (OSError | ValidationError | ValueError) => throw InvalidFindingsJSON("... is not a readable scan result ...")
  // present but invalid is never partially trusted and never falls back to the Markdown
}
