  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\".csproj PackageReference and .sln solution parsing.\"\"\"\n\nfrom __future__ import annotations\n\nimport posixpath\nimport re\nimport xml.etree.ElementTree as ElementTree\n\nfrom context_graph_sdk.project.config import (\n    DependencyRecord,\n    ManifestReader,\n    ManifestRecord,\n    ProjectConfig,\n)\n\n_SOLUTION_PROJECT = re.compile(r'Project\\(\"[^\"]+\"\\)\\s*=\\s*\"[^\"]+\"\\s*,\\s*\"([^\"]+\\.csproj)\"')\n\n\ndef _is_msbuild_variable(value: str) -> bool:\n    return value.startswith(\"$(\") and value.endswith(\")\")\n\n\ndef load_csproj_dependencies(reader: ManifestReader, config: ProjectConfig) -> None:\n    for relative in reader.by_extension(\".csproj\"):\n        text = reader.read_text(relative)\n        if text is None:\n            continue\n        try:\n            root = ElementTree.fromstring(text)\n        except ElementTree.ParseError:\n            continue\n        for reference in root.iter(\"PackageReference\"):\n            name = (reference.get(\"Include\") or reference.get(\"Update\") or \"\").strip()\n            version = (reference.get(\"Version\") or \"\").strip()\n            if not version:\n                version_element = reference.find(\"Version\")\n                if version_element is not None:\n                    version = (version_element.text or \"\").strip()\n            if not name or _is_msbuild_variable(name) or _is_msbuild_variable(version):\n                continue\n            config.add_dependency(DependencyRecord(name, version, relative))\n\n\ndef load_solution_manifests(reader: ManifestReader, config: ProjectConfig) -> None:\n    for relative in reader.by_extension(\".sln\"):\n        text = reader.read_text(relative)\n        if text is None:\n            continue\n        members = tuple(\n            match.group(1).replace(\"\\\\\", \"/\") for match in _SOLUTION_PROJECT.finditer(text)\n        )\n        config.add_manifest(\n            ManifestRecord(\n                posixpath.splitext(posixpath.basename(relative))[0],\n                relative,\n                \"csharp\",\n                \"\",\n                members,\n            )\n        )\n",
