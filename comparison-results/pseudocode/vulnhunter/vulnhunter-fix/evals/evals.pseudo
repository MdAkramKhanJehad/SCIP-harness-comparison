// file: vulnhunter-fix/evals/evals.json
// Four skill evaluation cases for the fix skill (named vulnfix in the file): prompt, expected output, and a list of assertion rows.
// Data only: every assertion starts unjudged (passed null, empty evidence); nothing in the code reads this file.

@executedBy(CODE) @role(types)
record EvalAssertion(String text, Boolean passed, String evidence) { }   // src: vulnhunter-fix/evals/evals.json:7 (passed null until judged)

@executedBy(CODE) @role(types)
record EvalCase(int id, String prompt, String expectedOutput, List<EvalAssertion> assertions, List<String> files) { }   // src: vulnhunter-fix/evals/evals.json:4

@executedBy(CODE) @role(types)
record EvalSuite(String skillName, List<EvalCase> evals) { }             // src: vulnhunter-fix/evals/evals.json:1

@executedBy(CODE) @role(evaluation) @stage("fix")
class Evals {

    EvalSuite suite() {
        return new EvalSuite("vulnfix", List.of(case1(), case2(), case3(), case4()));             // src: vulnhunter-fix/evals/evals.json:2
    }

    // id 1: skill invoked with a repo URL and a results path
    EvalCase case1() {
        return new EvalCase(1, "/vulnfix https://github.com/example/app ./results/app_VULNHUNT_RESULTS_sonnet46_2026-05-01/",
            "Parses findings, presents a remediation plan with priorities, asks for confirmation",
            List.of(unjudged("Validates both inputs (repo URL and results path)"),
                    unjudged("Runs parse_results.py and presents findings table"),
                    unjudged("Shows prioritized plan before proceeding"),
                    unjudged("Asks for user confirmation before implementation")), List.of());     // src: vulnhunter-fix/evals/evals.json:4
    }

    // id 2: free-form request to fix one finding
    EvalCase case2() {
        return new EvalCase(2, "Fix VULN-001 SQL injection in the user lookup function",
            "Creates exploit demo, failing security test, applies fix, test passes",
            List.of(unjudged("Writes exploit demo script showing SQL injection in action"),
                    unjudged("Writes security test that FAILS before fix"),
                    unjudged("Applies fix from VulnHunter proposed fix section"),
                    unjudged("Security test PASSES after fix"),
                    unjudged("Exploit demo is blocked after fix")), List.of());                   // src: vulnhunter-fix/evals/evals.json:31
    }

    // id 3: private repo without push access, expects the issue fallback
    EvalCase case3() {
        return new EvalCase(3, "/vulnfix https://github.com/org/private-repo ./results/",
            "Detects no write access and falls back to creating a GitHub issue",
            List.of(unjudged("Runs check_repo_access.sh and detects no push permission"),
                    unjudged("Falls back to issue creation with full fix details"),
                    unjudged("Issue body includes exploit demo, security test, and diff")), List.of());  // src: vulnhunter-fix/evals/evals.json:62
    }

    // id 4: fix fails; expects revert, alternative attempts up to max_retries, then NEEDS_MANUAL_REVIEW
    EvalCase case4() {
        return new EvalCase(4, "/vulnfix — fix fails, security test still fails after applying proposed fix",
            "Retries with alternative approach, then marks as needs-manual-review",
            List.of(unjudged("Detects that security test still FAILS after first fix attempt"),
                    unjudged("Reverts the failed fix"),
                    unjudged("Tries alternative fix approach (up to max_retries)"),
                    unjudged("After retries exhausted, marks finding as NEEDS_MANUAL_REVIEW")), List.of());  // src: vulnhunter-fix/evals/evals.json:84
    }

    EvalAssertion unjudged(String text) {
        return new EvalAssertion(text, null, "");                                                 // src: vulnhunter-fix/evals/evals.json:7
    }
}
