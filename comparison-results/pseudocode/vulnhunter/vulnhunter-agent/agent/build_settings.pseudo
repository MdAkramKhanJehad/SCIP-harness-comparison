// file: vulnhunter-agent/agent/build_settings.py
// Builds the Claude Code settings JSON (env + OS sandbox) passed to every SDK session (scan, verify, small LLM calls).
// Routes inference via api_key, bedrock_oauth or bedrock_sigv4; blanks proxies; optional OTLP telemetry.

@executedBy(CODE) @role(config) @stage("agent")
class BuildSettings {

    // Context-fill percentage that triggers compaction: explicit override, else 90 for 1M-context models, else 85.
    int resolveAutocompactPct(String model, Integer override) {
        if (override != null) return override;                                                   // src: vulnhunter-agent/agent/build_settings.py:42
        return LONG_CONTEXT_RE.search(model) ? 90 : 85;                                          // src: vulnhunter-agent/agent/build_settings.py:44
    }

    String anthropicHost(Theta θ) {
        if (θ["anthropic.auth_mode"] == "bedrock_oauth") return hostname(θ["anthropic.bedrock_base_url"]); // src: vulnhunter-agent/agent/build_settings.py:49
        if (θ["anthropic.auth_mode"] == "bedrock_sigv4") {                                      // src: vulnhunter-agent/agent/build_settings.py:51
            if (θ["anthropic.bedrock_base_url"] != "") return hostname(θ["anthropic.bedrock_base_url"]); // src: vulnhunter-agent/agent/build_settings.py:54
            return "bedrock-runtime." + θ["anthropic.aws_region"] + ".amazonaws.com";             // src: vulnhunter-agent/agent/build_settings.py:57
        }
        return "api.anthropic.com";                                                              // src: vulnhunter-agent/agent/build_settings.py:58
    }

    List<String> sandboxAllowReadPaths(Theta θ) {
        List<String> paths = List.of(".");                                                       // src: vulnhunter-agent/agent/build_settings.py:72
        if (θ["anthropic.auth_mode"] == "bedrock_sigv4") paths.add("~/.aws");                    // src: vulnhunter-agent/agent/build_settings.py:73
        return paths;
    }

    List<String> sandboxAllowedDomains(Theta θ) {
        String host = anthropicHost(θ);                                                          // src: vulnhunter-agent/agent/build_settings.py:88
        List<String> domains = (host != "") ? List.of(host) : List.of();
        if (θ["anthropic.auth_mode"] == "bedrock_sigv4" && θ["anthropic.aws_region"] != "") domains.addUnique("sts." + θ["anthropic.aws_region"] + ".amazonaws.com"); // src: vulnhunter-agent/agent/build_settings.py:90
        return domains;
    }

    // OS sandbox: reads limited to the clone (cwd), writes to cwd, network limited to the inference host.
    Sandbox buildSandbox(Theta θ) {
        Sandbox s = new Sandbox();
        s.enabled = θ["sandbox.enabled"];                                                        // src: vulnhunter-agent/agent/build_settings.py:102
        s.failIfUnavailable = θ["sandbox.fail_if_unavailable"];                                  // src: vulnhunter-agent/agent/build_settings.py:103
        s.allowUnsandboxedCommands = θ["sandbox.allow_unsandboxed_commands"];                    // src: vulnhunter-agent/agent/build_settings.py:104
        s.denyRead = List.of("/app", "/etc", "/proc", "/root", "/home", "/var", "/sys", "/run"); // src: vulnhunter-agent/agent/build_settings.py:27
        s.allowRead = sandboxAllowReadPaths(θ);                                                  // src: vulnhunter-agent/agent/build_settings.py:107
        s.denyWrite = List.of("/");                                                              // src: vulnhunter-agent/agent/build_settings.py:28
        s.allowWrite = List.of(".");                                                             // src: vulnhunter-agent/agent/build_settings.py:30
        s.allowedDomains = sandboxAllowedDomains(θ);                                             // src: vulnhunter-agent/agent/build_settings.py:111
        return s;
    }

    String buildClaudeSettings(Theta θ, String authToken, String model, String scanId) {
        Map<String, String> env = new Map();
        env.put("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", resolveAutocompactPct(model, θ["scan.autocompact_pct_override"])); // src: vulnhunter-agent/agent/build_settings.py:128
        env.put("http_proxy", ""); env.put("https_proxy", ""); env.put("HTTP_PROXY", ""); env.put("HTTPS_PROXY", ""); // src: vulnhunter-agent/agent/build_settings.py:129
        env.put("NO_PROXY", θ["scan.no_proxy"]);                                                 // src: vulnhunter-agent/agent/build_settings.py:134
        env.put("NODE_TLS_REJECT_UNAUTHORIZED", "");                                             // src: vulnhunter-agent/agent/build_settings.py:135

        if (θ["anthropic.auth_mode"] == "bedrock_oauth") {                                      // src: vulnhunter-agent/agent/build_settings.py:138
            env.put("CLAUDE_CODE_SKIP_BEDROCK_AUTH", "1"); env.put("CLAUDE_CODE_USE_BEDROCK", "1"); // src: vulnhunter-agent/agent/build_settings.py:141
            env.put("AWS_REGION", θ["anthropic.aws_region"]);                                    // src: vulnhunter-agent/agent/build_settings.py:143
            env.put("ANTHROPIC_BEDROCK_BASE_URL", θ["anthropic.bedrock_base_url"]);              // src: vulnhunter-agent/agent/build_settings.py:144
            env.put("ANTHROPIC_AUTH_TOKEN", authToken);                                          // src: vulnhunter-agent/agent/build_settings.py:145
            if (θ["code.bedrock_cache_ttl"] != null) env.put("ENABLE_PROMPT_CACHING_1H_BEDROCK", "1"); // src: vulnhunter-agent/agent/build_settings.py:151
        } else if (θ["anthropic.auth_mode"] == "bedrock_sigv4") {                               // src: vulnhunter-agent/agent/build_settings.py:154
            env.put("CLAUDE_CODE_USE_BEDROCK", "1");                                             // src: vulnhunter-agent/agent/build_settings.py:164
            env.put("AWS_REGION", θ["anthropic.aws_region"]);                                    // src: vulnhunter-agent/agent/build_settings.py:165
            if (θ["code.bedrock_cache_ttl"] != null) env.put("ENABLE_PROMPT_CACHING_1H_BEDROCK", "1"); // src: vulnhunter-agent/agent/build_settings.py:167
            if (θ["anthropic.bedrock_base_url"] != "") env.put("ANTHROPIC_BEDROCK_BASE_URL", θ["anthropic.bedrock_base_url"]); // src: vulnhunter-agent/agent/build_settings.py:172
            if (config.anthropic.awsProfile != "") env.put("AWS_PROFILE", config.anthropic.awsProfile); // src: vulnhunter-agent/agent/build_settings.py:176
        } else {
            env.put("ANTHROPIC_API_KEY", (authToken != "") ? authToken : θ["anthropic.api_key"]); // src: vulnhunter-agent/agent/build_settings.py:181
        }

        if (θ["scan.async_agent_stall_timeout_ms"] > 0) env.put("CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS", θ["scan.async_agent_stall_timeout_ms"]); // src: vulnhunter-agent/agent/build_settings.py:186

        if (θ["telemetry.enabled"] && config.telemetry.otelExporterOtlpEndpoint != "") {        // src: vulnhunter-agent/agent/build_settings.py:191
            String attrs = (config.telemetry.resourceAttributes != "") ? config.telemetry.resourceAttributes : "service.name=vulnhunter-agent,type=cli"; // src: vulnhunter-agent/agent/build_settings.py:192
            if (scanId != "") attrs = attrs + ",scan.id=" + scanId;                              // src: vulnhunter-agent/agent/build_settings.py:195
            env.put("CLAUDE_CODE_ENABLE_TELEMETRY", "1");                                        // src: vulnhunter-agent/agent/build_settings.py:199
            env.put("OTEL_LOG_USER_PROMPTS", "1"); env.put("OTEL_LOG_TOOL_CONTENT", "1");         // src: vulnhunter-agent/agent/build_settings.py:202
            env.put("OTEL_RESOURCE_ATTRIBUTES", attrs);                                          // src: vulnhunter-agent/agent/build_settings.py:212
        } else {
            env.put("CLAUDE_CODE_ENABLE_TELEMETRY", "0");                                        // src: vulnhunter-agent/agent/build_settings.py:216
        }
        return toJson(env, buildSandbox(θ));                                                     // src: vulnhunter-agent/agent/build_settings.py:218
    }
}
