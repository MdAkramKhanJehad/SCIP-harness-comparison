// file: vvaharness/remediation_agent/report_augment/summary.py
// The report-level "## Remediation Summary" section and its tallies.

@executedBy(CODE) @role(step) @stage("S10")
class ReportAugmentSummary {

    // Tally report-level metrics from the loaded cases.
    Map<String, Integer> summaryCounts(List<CaseRecord> records) {
        int total = records.size();                                                                  // src: vvaharness/remediation_agent/report_augment/summary.py:21
        int falsePositive = records.filter(r -> r.falsePositive).size();                             // src: vvaharness/remediation_agent/report_augment/summary.py:24
        int remediated = records.filter(r -> r.bucket.equals(Dto.REMEDIATED)).size();                // src: vvaharness/remediation_agent/report_augment/summary.py:27
        return Map.of("true_positive", total - falsePositive, "in_scope", total, "remediated", remediated); // in_scope counts false positives too // src: vvaharness/remediation_agent/report_augment/summary.py:30
    }

    String mdSummarySection(List<CaseRecord> records) {
        Map<String, Integer> c = summaryCounts(records);                                             // src: vvaharness/remediation_agent/report_augment/summary.py:33
        int truePositive = c.get("true_positive");
        int inScope = c.get("in_scope");
        int remediated = c.get("remediated");
        // The label says "/true positive": divide by that, not by in_scope (which includes false positives and would understate the rate).
        String rate = truePositive > 0 ? String.format("%.0f%%", remediated / truePositive * 100) : "n/a"; // src: vvaharness/remediation_agent/report_augment/summary.py:41
        return "## Remediation Summary\n- Total findings (true positive): " + truePositive + "\n- Findings in scope for remediation: " + inScope + "\n- Remediated: " + remediated + "\n- Success Rate(remediated/true positive): " + rate + "\n"; // src: vvaharness/remediation_agent/report_augment/summary.py:48
    }
}
