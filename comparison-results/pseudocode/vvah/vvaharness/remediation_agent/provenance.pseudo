// file: vvaharness/remediation_agent/provenance.py
// Trust boundary for S11: which on-disk finding cases this machine's S10 run actually produced.
// The repo-local security-remediation/ dir is untrusted; only checkpoint rows in the out-of-repo state store count.

@executedBy(CODE) @role(io) @stage("S10")
class RemediationAgentProvenance {

    Set<Pair<String, Path>> ownedCases(String runId, Theta θ) {
        Set<Pair<String, Path>> owned = new Set();
        for (String step : Store.stepsWithPrefix(runId, Checkpoints.REMEDIATE_PREFIX)) {            // src: vvaharness/remediation_agent/provenance.py:45
            Object record = Checkpoints.loadCkpt(Path.of(""), runId, step);                         // src: vvaharness/remediation_agent/provenance.py:46
            if (!(record instanceof Map)) continue;                                                 // src: vvaharness/remediation_agent/provenance.py:47
            String findingId = record.get("finding_id");                                            // src: vvaharness/remediation_agent/provenance.py:49
            String artifactDir = record.get("artifact_dir");                                        // src: vvaharness/remediation_agent/provenance.py:50
            if (findingId == null || artifactDir == null) continue;                                 // src: vvaharness/remediation_agent/provenance.py:51
            try {
                // A case is owned only when BOTH finding id AND resolved artifact dir match a checkpoint row.
                if (θ["code.remediation_agent.provenance.match_id_and_dir"]) owned.add(new Pair(findingId, Path.of(artifactDir).resolve())); // src: vvaharness/remediation_agent/provenance.py:54
            } catch (OSError e) {
                continue;                                                                           // src: vvaharness/remediation_agent/provenance.py:56
            }
        }
        return owned;                                                                               // src: vvaharness/remediation_agent/provenance.py:57
    }
}
