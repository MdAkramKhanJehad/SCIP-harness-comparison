// file: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh
// Claude Code Stop hook in the S11 session: copies the raw (unredacted) session transcript into the
// logging dir, only when an operator opts in. Fail-open: every failure exits 0.

@executedBy(CODE) @role(io) @stage("S11")
class CaptureTranscript {

    int run(String stdinJson, Env env, Theta θ) {
        if (!θ["code.validation.claude_config.hooks.logging.capture_transcript.debug_transcript_opt_in"] || env.get("VALIDATION_DEBUG_TRANSCRIPT").isEmpty()) return 0; // default: never persist raw transcript  // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:24
        String transcript = Jq.get(stdinJson, ".transcript_path", "").replaceHome();                 // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:27
        String logDir = env.getOrDefault("VALIDATION_LOG_DIR", "");                                  // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:28
        if (transcript.isEmpty() || !Fs.isFile(transcript) || logDir.isEmpty()) return 0;           // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:30
        String dest = logDir + "/subagents/transcript.jsonl";                                        // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:32
        Fs.mkdirs(Fs.dirname(dest));                                                                 // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:33
        Fs.copyIgnoringErrors(transcript, dest);                                                     // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:34
        return 0;                                                                                    // src: vvaharness/validation/claude_config/hooks/logging/capture_transcript.sh:35
    }
}
