// file: vvaharness/remediation_agent/artifacts/diff/gitcapture.py
// Real git diff capture: a scoped diff for a file set (against a throwaway index copy, pre-edit baseline when given),
// plus the unscoped whole-tree changed set used by the post-gate as ground truth.

@executedBy(CODE) @role(io) @stage("S10")
class Gitcapture {

    List<String> changedFilesWholeTree(String repo, Theta θ) {
        // Post-gate ground truth for edits omitted from verdict.changes; NEVER git add -N here (writes the index).
        Path root = Path.of(repo).resolve();                                                        // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:34
        Proc out;
        Path toplevel;
        try {
            Proc chk = Subprocess.run(List.of("git", "-C", repo, "rev-parse", "--is-inside-work-tree"), θ["code.remediation_agent.artifacts.diff.gitcapture.git_probe_timeout_s"]); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:36
            if (chk.returncode != 0 || !chk.stdout.strip().equals("true")) return List.of();        // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:39  (non-git: empty)
            Proc top = Subprocess.run(List.of("git", "-C", repo, "rev-parse", "--show-toplevel"), θ["code.remediation_agent.artifacts.diff.gitcapture.git_probe_timeout_s"]); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:41
            if (top.returncode != 0 || top.stdout.strip().isEmpty()) return List.of();              // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:44
            toplevel = Path.of(top.stdout.strip()).resolve();                                       // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:46
            // Pathspec "." confines to repo's own subtree even when nested in a larger work tree.
            String untracked = θ["code.remediation_agent.artifacts.diff.gitcapture.include_untracked"] ? "--untracked-files=all" : "--untracked-files=no";
            out = Subprocess.run(List.of("git", "-C", repo, "status", "--porcelain", "-z", untracked, "--", "."), θ["code.remediation_agent.artifacts.diff.gitcapture.git_diff_timeout_s"]); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:51
            if (out.returncode != 0) return List.of();                                              // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:54
        } catch (Exception e) {
            return List.of();                                                                       // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:57  (never break a run)
        }
        List<String> files = new List();
        Set<String> seen = new Set();
        // Rename/copy records carry a second bare NUL token (the source path) that must also be added.
        List<String> records = out.stdout.split("NUL");                                             // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:78
        int i = 0;
        while (i < records.size()) {                                                                // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:80
            String rec = records.get(i);
            i = i + 1;
            if (rec.isEmpty()) continue;                                                            // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:83
            add(rec.length() > 3 ? rec.substring(3) : "", toplevel, root, seen, files);             // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:85
            if ((rec.substring(0, 2).contains("R") || rec.substring(0, 2).contains("C")) && i < records.size()) { // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:86
                add(records.get(i), toplevel, root, seen, files);                                   // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:87
                i = i + 1;
            }
        }
        return files;                                                                               // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:89
    }

    void add(String path, Path toplevel, Path root, Set<String> seen, List<String> files) {
        if (path.isEmpty()) return;                                                                 // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:63
        String rel;
        try {
            // Re-relativize from git toplevel to repo; anything outside repo is dropped.
            rel = toplevel.join(path).resolve().relativeTo(root).asPosix();                         // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:70
        } catch (ValueError e) {
            return;                                                                                 // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:72
        }
        if (!seen.contains(rel)) {                                                                  // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:73
            seen.add(rel);
            files.add(rel);
        }
    }

    String captureGitDiff(String repo, List<String> files, Map<String, String> baseline, Theta θ) {
        // Runs against a throwaway copy of the index (GIT_INDEX_FILE): the repo's real index is never touched.
        Path root = Path.of(repo).resolve();
        List<String> paths = new List();
        for (String f : files) {                                                                    // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:100
            Path safe = DiffPaths.safeRepoPath(repo, f);                                            // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:101  (UNC ref would leak NetNTLMv2 via SMB)
            if (safe != null) paths.add(safe.relativeTo(root).asPosix());                           // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:103
        }
        if (paths.isEmpty()) return null;                                                           // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:105
        List<String> git = List.of("git", "-C", repo, "-c", "color.ui=false");                      // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:107  (env LC_ALL=C)
        try {
            Proc chk = Subprocess.run(git.plus("rev-parse", "--is-inside-work-tree"), θ["code.remediation_agent.artifacts.diff.gitcapture.git_probe_timeout_s"]); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:109
            if (chk.returncode != 0 || !chk.stdout.strip().equals("true")) return null;             // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:112
            Proc gd = Subprocess.run(git.plus("rev-parse", "--git-dir"), θ["code.remediation_agent.artifacts.diff.gitcapture.git_probe_timeout_s"]); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:115
            Path gitDir = (gd.returncode == 0 && !gd.stdout.strip().isEmpty()) ? Path.of(gd.stdout.strip()) : null; // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:117
            if (gitDir != null && !gitDir.isAbsolute()) gitDir = Path.of(repo).join(gitDir).resolve(); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:118
            Path realIndex = gitDir != null ? gitDir.join("index") : null;                          // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:120
            Path tmpIndex = TempDir.create().join("index");                                         // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:123
            if (realIndex != null && realIndex.exists()) Files.copy(realIndex, tmpIndex);           // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:125
            Env scoped = OsEnviron.with("GIT_INDEX_FILE", tmpIndex);                                      // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:126
            if (baseline != null && !baseline.isEmpty()) {                                          // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:128
                // Stage the pre-edit content into the temp index so the diff covers only this case's edits.
                Map<String, String> baselineNorm = baseline.mapKeys(k -> DiffPaths.normPath(k));    // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:129
                for (String rel : paths) {                                                          // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:130
                    if (!baselineNorm.containsKey(rel)) continue;                                   // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:131
                    String old = baselineNorm.get(rel);
                    if (old == null) {                                                              // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:134  (did not exist: diff as new file)
                        Subprocess.run(git.plus("update-index", "--force-remove", "--", rel), θ["code.remediation_agent.artifacts.diff.gitcapture.git_index_timeout_s"], scoped); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:136
                        continue;
                    }
                    Proc blob = Subprocess.run(git.plus("hash-object", "-w", "--stdin"), old, θ["code.remediation_agent.artifacts.diff.gitcapture.git_index_timeout_s"], scoped); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:139
                    String sha = blob.stdout.strip();
                    if (blob.returncode == 0 && !sha.isEmpty()) {                                   // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:143
                        Subprocess.run(git.plus("update-index", "--add", "--cacheinfo", "100644," + sha + "," + rel), θ["code.remediation_agent.artifacts.diff.gitcapture.git_index_timeout_s"], scoped); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:144
                    }
                }
            }
            Subprocess.run(git.plus("add", "-N", "--").plus(paths), θ["code.remediation_agent.artifacts.diff.gitcapture.git_index_timeout_s"], scoped); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:149  (temp index only)
            Proc out = Subprocess.run(git.plus("diff", "--no-ext-diff", "--").plus(paths), θ["code.remediation_agent.artifacts.diff.gitcapture.git_diff_timeout_s"], scoped); // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:151
            return out.stdout.strip().isEmpty() ? null : out.stdout;                                // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:155
        } catch (Exception e) {
            return null;                                                                            // src: vvaharness/remediation_agent/artifacts/diff/gitcapture.py:157  (never break a run)
        }
    }
}
