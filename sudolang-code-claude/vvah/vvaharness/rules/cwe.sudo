// src: vvaharness/rules/cwe.py:21-31
// Families absent here fall back to Injection, the modal category for a taint sink (fallback applied by the caller).
OWASP_2025_BY_SEMANTIC = {
  "html-response":   ["A03:2025-Injection"],
  "command-exec":    ["A03:2025-Injection"],
  "sql-exec":        ["A03:2025-Injection"],
  "url-fetch":       ["A10:2025-SSRF", "A03:2025-Injection"],
  "file-io":         ["A01:2025-Broken-Access-Control", "A03:2025-Injection"],
  "deserialization": ["A08:2025-Software-and-Data-Integrity-Failures"],
  "template-render": ["A03:2025-Injection"],
  "credentials":     ["A02:2025-Cryptographic-Failures"]
}

// src: vvaharness/rules/cwe.py:34-40
_CWE_RE = /CWE[-_ ]?0*(\d{1,4})/i
fn norm_cwe(value):executor=code {
  // "cwe_089", "CWE-0089" -> "CWE-89"
  m = first _CWE_RE match in string(value)
  return if (m) "CWE-${ int(m.group(1)) }" else null
}
// src: vvaharness/rules/cwe.py:37-40
// preserved: the docstring lists a bare "89" as normalizing to "CWE-89", but _CWE_RE requires the "CWE" prefix, so "89" returns null.

// src: vvaharness/rules/cwe.py:43-57
// One weakness per row; the first id of each cluster names the survivor. Clusters are disjoint.
_WEAKNESS_CLUSTERS = [
  ["CWE-89", "CWE-943", "CWE-564"],   // SQL injection
  ["CWE-78", "CWE-77"],               // OS command / command injection
  ["CWE-22", "CWE-23", "CWE-36"],     // path traversal
  ["CWE-79", "CWE-80"],               // cross-site scripting
  ["CWE-862", "CWE-285", "CWE-284"]   // missing authorization / improper access control
]
_WEAKNESS_KEY = every member of each cluster -> that cluster's first id

// src: vvaharness/rules/cwe.py:59-60
_GENERIC_PARENT_CWES = {"CWE-20", "CWE-74"}   // generic parents, redundant against anything specific; 20 and 74 are NOT folded together

// src: vvaharness/rules/cwe.py:63-66
fn weakness_key(value):executor=code {
  cwe = norm_cwe(value)
  return if (cwe) (_WEAKNESS_KEY[cwe] or, when absent, cwe) else null
}

// src: vvaharness/rules/cwe.py:69-84
fn same_weakness(cwe_a, cwe_b):executor=code {
  a = norm_cwe(cwe_a); b = norm_cwe(cwe_b)
  if (!a || !b) return false        // "cannot tell" is never evidence of a match
  if (a == b) return true
  a_generic = a in _GENERIC_PARENT_CWES; b_generic = b in _GENERIC_PARENT_CWES
  if (a_generic xor b_generic) return true   // a generic parent matches ANY specific CWE
  if (a_generic && b_generic) return false   // CWE-20 vs CWE-74
  return weakness_key(a) == weakness_key(b)
}
