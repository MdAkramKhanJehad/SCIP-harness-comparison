// file: vvaharness/validation/config/validate_role.py
// Resolves the models.validate role from a harness profile, and reroutes a legacy via: openai
// role onto DeepAgents with the OpenAI provider.

@executedBy(CODE) @role(config) @stage("S11")
class ValidateRole {

    Set<String> WARNED_VIA_REWRITE = new Set();                                                      // warn once per process  // src: vvaharness/validation/config/validate_role.py:32

    Object validateModelSpec(HarnessConfig cfg) {
        Object models = cfg.get("models");                                                           // src: vvaharness/validation/config/validate_role.py:44
        if (models == null) return null;                                                             // src: vvaharness/validation/config/validate_role.py:46
        Object validate = models.get("validate");                                                    // src: vvaharness/validation/config/validate_role.py:47
        if (validate == null) return null;                                                           // src: vvaharness/validation/config/validate_role.py:49
        return validate.get("orchestrator");                                                         // src: vvaharness/validation/config/validate_role.py:50
    }

    BackendRoute normalizeValidateBackend(String via, String provider, Theta θ) {
        if (!θ["code.validation.config.validate_role.reroute_legacy_openai_via"] || !via.equals("openai")) return new BackendRoute(via, provider); // src: vvaharness/validation/config/validate_role.py:55
        WarnOnce.warnOnce(WARNED_VIA_REWRITE, "validate-via-openai-rewritten", "routing via: openai to via: deepagents (provider: openai)");                          // src: vvaharness/validation/config/validate_role.py:57
        return new BackendRoute("deepagents", provider != null ? provider : "openai");              // src: vvaharness/validation/config/validate_role.py:63
    }
}

@executedBy(CODE) @role(types)
record BackendRoute(String via, String provider) { }
