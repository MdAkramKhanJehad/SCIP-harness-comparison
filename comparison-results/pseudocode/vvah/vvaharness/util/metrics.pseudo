// file: vvaharness/util/metrics.py
// Build ScanMetrics from pipeline state (units, outcomes, LOC, tokens, counters, errlog), kept out of the
// orchestrator; refresh_tokens re-snapshots token/cost/error fields after S8. Reporting only.

@executedBy(CODE) @role(evaluation)
class UtilMetrics {

    // most-specific prefix first; only "threat-" has a producer today
    static final List<Pair<String, String>> KIND_PREFIXES = List.of(Pair.of("taint-", "taint"), Pair.of("catchall-", "catchall"),
        Pair.of("spec-", "specialist"), Pair.of("threat-", "threat"), Pair.of("chunk-", "risk")); // src: vvaharness/util/metrics.py:48
    // counters copied into ScanMetrics (must be a subset of its fields; an unmatched name drops silently)
    static final List<String> INT_COUNTER_NAMES = List.of("s2_threats_raw", "s2_threats_truncated", "s2_threats_promoted", "s2_frontier_*_excluded",
        "s2_*_truncated", "s2_surface_files_dropped", "s2_evidence_gate_rejected*", "s3_unknown_file_ids", "s3_dropped_paths", "s3_relocated_paths",
        "s4_findings_truncated", "s4_batch_member_*", "s4_evidence_gate_rejected*", "deepagents_*", "llm_truncated_*", "llm_turn_cap_exhausted",
        "s6_*", "s<N>_structured_retry_*", "s<N>_truncated_retry_*", "llm_structured_retry_truncated", "s2_empty_retry_*", "s2_parse_repair_*",
        "s4_outcome_repaired_*", "s6_outcome_repaired_*", "llm_call_timeouts", "llm_call_budget_near", "llm_model_refusals",
        "llm_refusal_retry_*", "s<N>_orphan_settled");                        // abbreviated with wildcards // src: vvaharness/util/metrics.py:57

    Double pricedCostUsd(Map tok, Map<String, String> roleModels, PricingTable pricing, Theta θ) {
        if (pricing == null || roleModels == null || roleModels.isEmpty()) return null; // src: vvaharness/util/metrics.py:41
        return StageTelemetry.composeStageSection(Map.of(), tok, roleModels, pricing, null, θ).totals.costUsd; // same costing as the manifest // src: vvaharness/util/metrics.py:43
    }

    String classifyUnitKind(InvestigationUnit u) {
        for (Pair<String, String> p : KIND_PREFIXES) if (u.id.startsWith(p.first)) return p.second; // src: vvaharness/util/metrics.py:155
        return "other";                                                        // src: vvaharness/util/metrics.py:158
    }

    String nowIso() {
        return nowUtc().format("yyyy-MM-ddTHH:mm:ssZ");                        // src: vvaharness/util/metrics.py:162
    }

    double elapsedSec(String startTs, String endTs) {
        try { return parseIso(endTs) - parseIso(startTs); }                    // src: vvaharness/util/metrics.py:167
        catch (Exception e) { return 0.0; }                                    // src: vvaharness/util/metrics.py:171
    }

    void refreshTokens(ScanMetrics metrics, String endTs, Map<String, String> roleModels, PricingTable pricing, Theta θ) {
        if (metrics == null) return;                                           // src: vvaharness/util/metrics.py:180
        if (endTs != null) { metrics.endTs = endTs; metrics.durationSec = elapsedSec(metrics.startTs, endTs); } // src: vvaharness/util/metrics.py:182
        metrics.errorsByStage = Errlog.countsByStage(null, true);              // unconditional // src: vvaharness/util/metrics.py:186
        metrics.errorsLogPath = Errlog.currentPath().exists() ? str(Errlog.currentPath()) : ""; // src: vvaharness/util/metrics.py:187
        Map<String, Object> counters = Counters.snapshot();                    // src: vvaharness/util/metrics.py:189
        for (String name : INT_COUNTER_NAMES)                                  // src: vvaharness/util/metrics.py:190
            if (counters.containsKey(name) && name != "llm_turn_cap_exhausted") setattr(metrics, name, counters.get(name)); // keep build()'s value // src: vvaharness/util/metrics.py:193
        Map tok = TokenCounter.snapshot();                                     // src: vvaharness/util/metrics.py:195
        if (tok.callsWithUsage <= 0) return;                                   // None never becomes 0 // src: vvaharness/util/metrics.py:196
        metrics.promptTokens = tok.prompt; metrics.completionTokens = tok.completion; metrics.totalTokens = tok.total; // src: vvaharness/util/metrics.py:198
        metrics.tokensByPhase = tok.byPhase; metrics.reportedCostUsd = tok.usd;
        metrics.pricedCostUsd = pricedCostUsd(tok, roleModels, pricing, θ);   // src: vvaharness/util/metrics.py:203
    }

    ScanMetrics build(ContextPackage ctx, TaskManifest manifest, String repoName, String startTs, String endTs, int rawFindings, int truePos, int falsePos,
                      int duplicates, int discoveredTp, int cloneTp, int evRescued, Map<String, String> unitOutcomes, boolean externalInput,
                      Map<String, String> roleModels, PricingTable pricing, Theta θ) {
        Map<String, String> outcomes = unitOutcomes != null ? unitOutcomes : Map.of();
        boolean externalOnly = externalInput && outcomes.values().all(o -> List.of("injected", "confirmed").contains(o)); // src: vvaharness/util/metrics.py:219
        Set<String> analyzed = Set.of(); List<ScopeEntry> scope = List.of(); Map<String, Integer> kindCounts = Map.of();
        for (InvestigationUnit u : manifest.units) {                           // src: vvaharness/util/metrics.py:224
            // only COMPLETED units' files count as analyzed; no outcome = completed (uninvestigated for external input)
            if (!externalOnly && outcomes.getOrDefault(u.id, externalInput ? "uninvestigated" : "completed") == "completed") analyzed.addAll(u.files); // src: vvaharness/util/metrics.py:225
            String kind = classifyUnitKind(u);
            kindCounts.inc(kind);
            scope.add(new ScopeEntry(u.id, kind, sorted(u.files)));           // src: vvaharness/util/metrics.py:230
        }
        List<String> folders = sorted(analyzed.filter(f -> f.contains("/")).map(f -> parent(f)).union(Set.of("."))); // src: vvaharness/util/metrics.py:236
        Map<String, Integer> locScope = Map.of(); Map<String, Integer> locScan = Map.of();
        for (String f : ctx.allFiles) {                                        // src: vvaharness/util/metrics.py:241
            String lang = EXT_TO_LANG.getOrDefault(suffix(f).lower(), "other");
            int loc = countLoc(ctx.repoRoot.resolve(f));
            locScope.add(lang, loc);
            if (analyzed.contains(f)) locScan.add(lang, loc);                  // src: vvaharness/util/metrics.py:245
        }
        double dur = elapsedSec(startTs, endTs);
        Map tok = TokenCounter.snapshot();
        boolean tokAvail = tok.callsWithUsage > 0;                             // src: vvaharness/util/metrics.py:251
        int chunksAttempted = externalOnly ? 0 : manifest.units.size();        // src: vvaharness/util/metrics.py:254
        List<String> nonFailures = externalInput ? List.of("completed", "skipped", "injected", "confirmed") : List.of("completed", "skipped"); // skipped is designed, not a failure // src: vvaharness/util/metrics.py:256
        int chunksFailed = outcomes.values().count(o -> !nonFailures.contains(o)); // src: vvaharness/util/metrics.py:258
        Map<String, Object> counters = Counters.snapshot();
        Map<String, Object> counterFields = Map.of();
        for (String name : INT_COUNTER_NAMES) if (counters.containsKey(name)) counterFields.put(name, counters.get(name)); // present keys only // src: vvaharness/util/metrics.py:264
        if (counters.containsKey("s2_degraded")) counterFields.put("s2_degraded", counters.get("s2_degraded") != 0); // count -> bool // src: vvaharness/util/metrics.py:269
        for (String name : List.of("s2_baseline_undisposed", "s2_repo_kinds"))  // comma-joined notes -> list // src: vvaharness/util/metrics.py:273
            if (counters.containsKey(name)) counterFields.put(name, counters.get(name).isEmpty() ? List.of() : counters.get(name).split(","));
        return new ScanMetrics(startTs + "__" + repoName, repoName, startTs, endTs, dur, ctx.allFiles.size(), intersect(analyzed, ctx.allFiles).size(), // src: vvaharness/util/metrics.py:278
            manifest.unreachableFiles.size(), manifest.threatsWithoutUnitFor(ctx.threatModel).size(),      // checkpointed, resume-safe // src: vvaharness/util/metrics.py:287
            manifest.units.size(), kindCounts.get("risk"), kindCounts.get("catchall"), kindCounts.get("specialist"), chunksAttempted, chunksFailed, externalOnly,
            Errlog.countsByStage(null, true), Errlog.currentPath().exists() ? str(Errlog.currentPath()) : "", locScope, locScan,
            rawFindings, truePos, falsePos, duplicates, discoveredTp, cloneTp, evRescued,
            tokAvail ? tok.prompt : null, tokAvail ? tok.completion : null, tokAvail ? tok.total : null, tokAvail ? tok.byPhase : null, tok.usd, // src: vvaharness/util/metrics.py:311
            tokAvail ? pricedCostUsd(tok, roleModels, pricing, θ) : null, folders, scope, ctx.excluded, kindCounts, counterFields); // src: vvaharness/util/metrics.py:316
    }

    int countLoc(Path p) {
        try { return readLines(p, "replace").count(ln -> !ln.strip().isEmpty()); } // non-blank lines // src: vvaharness/util/metrics.py:329
        catch (OSError e) { return 0; }                                        // src: vvaharness/util/metrics.py:331
    }
}
