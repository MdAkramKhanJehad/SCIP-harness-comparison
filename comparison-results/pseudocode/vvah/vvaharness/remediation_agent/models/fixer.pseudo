// file: vvaharness/remediation_agent/models/fixer.py
// Structured result returned by the S10 file-editor (fixer) subagent, with validators that tie success/retry claims to evidence.

@executedBy(CODE) @role(types)
enum FixerStatus { APPLIED, ALREADY_APPLIED, NOT_APPLIED, TOOL_ERROR }

@executedBy(CODE) @role(types) @stage("S10")
class Fixer {
    FixerStatus status;                                                                             // src: vvaharness/remediation_agent/models/fixer.py:29
    List<String> filesChanged = List.of();                                                          // src: vvaharness/remediation_agent/models/fixer.py:30
    String summary;                                                                                 // src: vvaharness/remediation_agent/models/fixer.py:31
    String error = "";                                                                              // src: vvaharness/remediation_agent/models/fixer.py:32
    boolean retryable = false;                                                                      // src: vvaharness/remediation_agent/models/fixer.py:33

    Fixer statusHasEvidence(Theta θ) {
        if (!θ["code.remediation_agent.models.fixer.status_evidence_validation"]) return this;      // src: vvaharness/remediation_agent/models/fixer.py:35
        if (status == APPLIED && filesChanged.isEmpty()) throw new ValueError("status=applied requires at least one changed file"); // src: vvaharness/remediation_agent/models/fixer.py:38
        if (status != APPLIED && !filesChanged.isEmpty()) throw new ValueError("only status=applied may report changed files"); // src: vvaharness/remediation_agent/models/fixer.py:40
        if (retryable && status != TOOL_ERROR) throw new ValueError("retryable=true is valid only for status=tool_error"); // src: vvaharness/remediation_agent/models/fixer.py:42
        if (status == TOOL_ERROR && error.strip().isEmpty()) throw new ValueError("status=tool_error requires an error description"); // src: vvaharness/remediation_agent/models/fixer.py:44
        return this;
    }

    String schemaJsonCompact() {
        return Json.dumpCompact(Pydantic.jsonSchema(Fixer));                                                  // src: vvaharness/remediation_agent/models/fixer.py:51  (embedded in the fixer system prompt)
    }
}
