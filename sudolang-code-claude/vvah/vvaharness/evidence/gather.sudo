# vvaharness/evidence/gather.py

The deterministic (no model) evidence snapshot that the Stage 2 prompt is built from. Graph-derived blocks (modules, entry points, file count) read a capped "AST frontier" of the context; shape blocks (inventory, languages, docs, manifests, config representatives, API artefacts) read all in-scope files. Every block is capped by a `step2.*` setting.

Source: `vvaharness/evidence/gather.py` (lines 1-235)
Executor: code
Called from: `vvaharness/pipeline/stages/s2/__init__.py` run

// src: vvaharness/evidence/gather.py:39-48
fn _cap_int(s2, key, default):executor=code {
  v = s2.key
  if (v == null || int(v) raises || int(v) < 0) return default
  return Integer(v)   // 0 is honored
}

// src: vvaharness/evidence/gather.py:75-96 — every cap, each read through _cap_int
_resolve_caps {
  doc_cap = knob("step2.max_doc_chars", default=20000)
  manifest_cap = knob("step2.max_manifest_chars", default=4000)
  manifest_total_cap = knob("step2.max_manifest_total_chars", default=24000)
  max_manifest_depth = knob("step2.max_manifest_depth", default=3)
  max_manifests = knob("step2.max_manifests", default=12)
  max_manifests_per_kind = max(1, knob("step2.max_manifests_per_kind", default=2))
  max_graph_files = knob("step2.max_graph_files", default=220)
  max_entry_points = knob("step2.max_entry_points", default=400)
  max_graph_sinks = knob("step2.max_graph_sinks", default=80)
  max_modules = knob("step2.max_modules", default=100)
  max_graph_edges = knob("step2.max_graph_edges", default=100)
  max_config_reps = knob("step2.max_config_reps", default=80)
  max_config_rep_chars = knob("step2.max_config_rep_chars", default=2000)
  max_config_rep_bodies = knob("step2.max_config_rep_bodies", default=12)
  max_api_artefacts = knob("step2.max_api_artefacts", default=100)
  max_modules_prompt = knob("step2.max_prompt_modules", default=100)            // prompt caps are separate keys from the frontier caps
  max_entry_points_prompt = knob("step2.max_prompt_entry_points", default=400)
  max_inventory_files = knob("step2.max_inventory_files", default=1200)
}

// src: vvaharness/evidence/gather.py:99-119
ThreatEvidence {
  file_count; original_file_count; primary_language
  languages: [(language, count)]; top_dirs
  modules: [(name, purpose, loc)]; modules_truncated
  entry_points: [(kind, unauth, file, function)]; entry_points_truncated
  config_reps: [(rel_path, body or "")]; api_artefacts; docs: [(name, body)]; manifests: [(rel_path, body)]
  inventory; inventory_truncated; s1_notes
}

// src: vvaharness/evidence/gather.py:185-235
fn gather(repo_root, cfg, ctx?):executor=code {
  caps = _resolve_caps(cfg.step2)
  frontier = _build_frontier(ctx, caps)
  active_ctx = frontier || ctx
  frontier_files = active_ctx.all_files (or [])
  full_files = ctx.all_files (or frontier_files)

  modules = active_ctx.modules as (name, purpose, loc)
  eps = _sorted_entry_points(active_ctx)
  docs = evidence.docs.gather_docs(repo_root, full_files, caps.doc_cap)
  manifests = evidence.manifests.gather_manifests(repo_root, (caps.max_manifest_depth, caps.max_manifests, caps.max_manifests_per_kind), caps.manifest_cap, caps.manifest_total_cap)
  cfg_reps = evidence.configs.gather_config_reps(repo_root, full_files, caps.max_config_reps, caps.max_config_rep_chars, caps.max_config_rep_bodies)
  api_artefacts = evidence.api_artefacts.gather_api_artefacts(full_files, caps.max_api_artefacts)
  top_dirs = sorted unique first path components of files that have a "/"

  // src: gather.py:207-216 — prompt cuts are counted and warned (the prompt shows "…(truncated)")
  _note_cut("s2_prompt_modules_truncated", ..., length(modules), caps.max_modules_prompt)
  _note_cut("s2_prompt_entry_points_truncated", ..., length(eps), caps.max_entry_points_prompt)
  _note_cut("s2_inventory_files_truncated", ..., length(full_files), caps.max_inventory_files)

  return ThreatEvidence({
    file_count: length(frontier_files),   // the AST frontier, at most max_graph_files when a context exists
    original_file_count: length(ctx.all_files),
    primary_language: ctx.language,
    languages: _language_counts(full_files) most common first,   // src: vvaharness/evidence/gather.py:169-175 — extension mapped through lang.detect EXT_TO_LANG and LANG_DISPLAY; unmapped extensions are not counted
    top_dirs,
    modules: first max_modules_prompt modules, modules_truncated,
    entry_points: first max_entry_points_prompt of eps, entry_points_truncated,
    config_reps: cfg_reps, api_artefacts, docs, manifests,
    inventory: first max_inventory_files of sorted(full_files), inventory_truncated,
    s1_notes: ctx.notes
  })
  // preserved: the FILE INVENTORY shown to the model is cut at max_inventory_files (1200) sorted paths, yet s2/outcomes.py validates surface_files against the full ctx.all_files; a repository larger than the cap has files the prompt never lists but that remain valid surface files
}

// src: vvaharness/evidence/gather.py:122-134
fn _build_frontier(ctx?, caps):executor=code {
  if (!ctx) return null
  frontier = ctx.ast_context_view(max_files=caps.max_graph_files, max_entry_points=caps.max_entry_points, max_sinks=caps.max_graph_sinks, max_modules=caps.max_modules, max_edges=caps.max_graph_edges)
  // external: vvaharness/models ContextPackage.ast_context_view selects which files, entry points, sinks and modules make the frontier
  _note_frontier_cuts(ctx, frontier, caps)   // counts and warns, per kind, naming max_graph_files and/or the kind's own cap
  return frontier
}

// src: vvaharness/evidence/gather.py:178-182
fn _sorted_entry_points(active_ctx):executor=code {
  return entry points as (kind, reachable_from_unauth, file, function) sorted by (kind != "network", !unauth, kind, file)   // network first, then unauthenticated first
}

// src: vvaharness/evidence/gather.py:137-166
fn _note_cut(counter, kind, total, kept, cap_keys):executor=code {
  if (kept < total) { COUNTERS.bump(counter, total - kept); warn S2_CAP_TRUNCATED naming each "step2.$key" }
}
