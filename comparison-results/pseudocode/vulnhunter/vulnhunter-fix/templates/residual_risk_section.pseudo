// file: vulnhunter-fix/templates/residual_risk_section.md
// '## Residual Risk' section appended to PR / issue bodies when tier != FULL (REQ-HON-009);
// code renderer is Delivery.renderResidualRiskSection.

@executedBy(CODE) @role(types)
record ResidualRiskVars(String COMPLETENESS_TIER, String TIER_ONE_LINER, List<String> RESIDUAL_BULLETS, int ISSUE_NUMBER) { }

@executedBy(MIXED) @role(prompt) @stage("fix")
class ResidualRiskSection {

    Prompt run(ResidualRiskVars v, Theta θ) {
        Prompt p = new Prompt();
        if (v.COMPLETENESS_TIER == "FULL") return p;                                 // src: vulnhunter-fix/templates/residual_risk_section.md:16 (only MITIGATION | WORKAROUND)
        if (θ["p.residual-risk-rules.r6_residual_section_mandatory"]) p.must("## Residual Risk"); // src: vulnhunter-fix/templates/residual_risk_section.md:1
        p.format("This fix ships as **<COMPLETENESS_TIER>** — the stated attack vector is <TIER_ONE_LINER>."); // src: vulnhunter-fix/templates/residual_risk_section.md:3
        p.choose(List.of("partially blocked; residual exposure remains (MITIGATION)",
                         "not blocked; a compensating control was applied instead (WORKAROUND)")); // src: vulnhunter-fix/templates/residual_risk_section.md:19
        p.format(θ["p.residual-risk-rules.r6_bullet_order"]);                        // src: vulnhunter-fix/templates/residual_risk_section.md:23 (one bullet per residual_vectors entry, list order)
        p.rule("each vector has an auto-created follow-up issue labelled vulnhunter-followup; see primary issue #<ISSUE_NUMBER>"); // src: vulnhunter-fix/templates/residual_risk_section.md:9
        return p;
    }

    String render(ResidualRiskVars v, Theta θ) {
        return Delivery.renderResidualRiskSection(null, v.COMPLETENESS_TIER, v.RESIDUAL_BULLETS, v.ISSUE_NUMBER, θ);
    }
}
