  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"What s5 still refuses: a coordinate that does not exist, and test-path noise.\"\"\"\nfrom __future__ import annotations\n\nfrom vvaharness.models import Finding\nfrom vvaharness.pipeline.stages.s5.rules import EXCLUDE_PATH_RE, is_secret_class\nfrom vvaharness.util.counters import COUNTERS\n\n\ndef reject_path(f: Finding, valid_files: set[str] | None) -> tuple[str, str] | None:\n    \"\"\"The path-level (reason, detail) for dropping *f*, judged with no disk I/O.\"\"\"\n    if EXCLUDE_PATH_RE.search(f.file) and not is_secret_class(f):\n        return \"EXCLUDED\", \"test/mock/example path\"\n    if valid_files is not None and f.file not in valid_files:\n        return \"EXCLUDED\", \"file not in repo inventory\"\n    return None\n\n\ndef reject(f: Finding, valid_files: set[str] | None,\n           lines: list[str] | None) -> tuple[str, str] | None:\n    \"\"\"The (reason, detail) for dropping *f*, or None to keep it after clamping `line_end` to EOF.\"\"\"\n    verdict = reject_path(f, valid_files)\n    if verdict is not None:\n        return verdict\n    if lines is None:\n        return \"EXCLUDED\", \"file could not be read from the repo\"\n    line = int(f.line_start or 0)\n    if not 1 <= line <= len(lines):\n        return \"EXCLUDED\", f\"line {line} outside {f.file} (1-{len(lines)})\"\n    # Only point both s4-born and detector rows pass through, so clamp here.\n    if f.line_end > len(lines):\n        f.line_end = len(lines)\n        COUNTERS.bump(\"s5_line_end_clamped_eof\")\n    return None\n",
