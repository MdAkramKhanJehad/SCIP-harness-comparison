// file: vvaharness/validation/constants/diff.py
// Constants for the deterministic diff-based fact tools (hunk parsing, trust-boundary detection).

@executedBy(CODE) @role(config) @stage("S11")
class ConstantsDiff {

    Regex trustBoundaryRe(Theta θ) {
        return Regex.compileIgnoreCase(θ["code.validation.constants.diff.trust_boundary_keywords"]); // auth|session|...|settings, word-bounded  // src: vvaharness/validation/constants/diff.py:21
    }

    Regex HUNK_HEADER_RE = Regex.compile("^@@ -N(,N)? +(N)(,N)? @@");                                // group 1 = new-side start  // src: vvaharness/validation/constants/diff.py:26
    String GIT_HEADER_PREFIX = "diff --git ";                                                        // src: vvaharness/validation/constants/diff.py:32
    int GIT_HEADER_MIN_TOKENS = 4;                                                                   // fewer = truncated header  // src: vvaharness/validation/constants/diff.py:34
    String OLD_FILE_MARKER = "--- ";                                                                 // src: vvaharness/validation/constants/diff.py:35
    String NEW_FILE_MARKER = "+++ ";                                                                 // src: vvaharness/validation/constants/diff.py:36
    String DEV_NULL_PATH = "/dev/null";                                                              // src: vvaharness/validation/constants/diff.py:39
    List<String> GIT_PATH_PREFIXES = List.of("a/", "b/");                                            // src: vvaharness/validation/constants/diff.py:40
}
