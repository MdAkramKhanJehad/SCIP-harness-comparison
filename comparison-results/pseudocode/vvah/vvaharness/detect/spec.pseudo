// MatchSpec: one compiled pattern a static detector treats as a source, sink, or detector rule,
// plus the gate fields a detector rule uses to decide whether a line hit fires.

@executedBy(CODE) @role(types)
enum SpecRole { SOURCE, SINK, DETECTOR }

@executedBy(CODE) @role(types)
enum SpanKind { LINE, CALL, BLOCK }   // call = balanced parens up to spanMaxLines; block = up to spanEnd

@executedBy(CODE) @role(types)
record MatchSpec(
    String ruleId,
    String role,                     // source | sink | detector
    String pattern,                  // regex matched against one line of source text
    String cwe,
    String kind,
    String semanticFamily,           // default ""
    Set<String> owaspTop102025,      // default empty
    // detector-rule fields (role == detector); line specs ignore these
    boolean enabled,                 // default true; per-rule kill switch, part of the rule data
    Set<String> languages,           // EXT_TO_LANG keys; empty = all languages
    String title,                    // finding title minted for a hit
    String citation,                 // one-line CWE/OWASP citation
    String span,                     // default "line"
    String spanEnd,                  // regex closing a block span
    int spanMaxLines,                // default 1
    String presentRe,                // fire only when the span matches this
    String absentRe,                 // fire only when the span does NOT match this
    int absentWindow,                // extra lines the absent guard also sees; default 0
    String fileRe,                   // whole file must match somewhere
    String nearRe,                   // must match within nearWindow lines
    int nearWindow) { }              // default 0. src: vvaharness/detect/spec.py:22

@executedBy(CODE) @role(types)
class Spec {
    /** Frozen dataclass defaults, as constructed when a field is omitted. */
    MatchSpec defaults(String ruleId, String role, String pattern, String cwe, String kind) {
        return new MatchSpec(ruleId, role, pattern, cwe, kind, "", Set.of(), true, Set.of(), "", "", "line", "", 1, "", "", 0, "", "", 0); // src: vvaharness/detect/spec.py:30
    }
}
