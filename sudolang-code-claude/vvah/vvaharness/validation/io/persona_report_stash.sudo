# vvaharness/validation/io/persona_report_stash.py

Extracts the persona reports from the harness's terminal state: pre-parsed reports for the Claude cli/sdk route, or JSON tool messages from the deepagents graph state. Invalid, duplicate or oversized candidates are dropped.

Source: `vvaharness/validation/io/persona_report_stash.py` (lines 1-80)
Executor: code
Called from: `vvaharness/validation/session/launcher.sudo` _write_host_synthesized_gates

MAX_TOOL_MESSAGE_CHARS = 1048576   // src: persona_report_stash.py:27

// src: vvaharness/validation/io/persona_report_stash.py:52-80
fn extract_subagent_reports(final_state):executor=code {
  if ("sdk_persona_reports" in final_state) {
    return _validate_candidates(final_state.sdk_persona_reports)
    // external: ClaudeHarness pre-parsed these from transcript files (vvaharness/backends/harness/claude)
  }
  candidates = []
  for each msg in final_state.messages {
    if (msg is not a ToolMessage) skip   // external: langchain_core
    content = msg.content; if (content is a list) content = first item or ""
    if (content is not a string || length(content) > MAX_TOOL_MESSAGE_CHARS || content is blank) skip
    try append parse_json(trimmed content) to candidates; catch JSONDecodeError => skip
  }
  return _validate_candidates(candidates)
}

// src: vvaharness/validation/io/persona_report_stash.py:30-49
fn _validate_candidates(candidates):executor=code {
  seen = {}
  for each data in candidates {
    if (data is not a dict || "persona" not in data || "gates" not in data) skip
    key = [data.persona, data.tracking_id]
    if (key in seen) skip   // first candidate per persona and tracking id wins
    add key to seen
    // preserved: the key is recorded before validation, so a candidate that then fails validation still blocks a later valid one with the same key
    try append PersonaReport.validate(data) to reports; catch ValidationError => skip
  }
  return reports
}
