// ---------- planner ----------

// src: vvaharness/pipeline/stages/s4/prompts.py:399-401
// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:350-396
build_plan_system_prompt(graph=true) {
  // _PLAN_HEAD + (graph ? _PLAN_REACHABILITY_GRAPH : _PLAN_REACHABILITY_NO_GRAPH) + _PLAN_TAIL; used as TodoListMiddleware system prompt when step4.planning
  Constraints {
    "## Planning is mandatory here"
    "Your FIRST action in every session is `write_todos`. Do not answer, and do not call the outcome tool, before you have written a plan and worked it."
    "The claim you were handed is a LEAD, not the scope of the work. A plan that only says \"check the claim\" is a bad plan. Every plan covers at least:"
    "  1. Account for EVERY path in FILES — one todo per file, or one todo naming a group of them."
    "  2. Locate where this threat is actually implemented — the sink, the caller that supplies the tainted value, the config or base class holding the real default."
    if (graph) "  3. Establish REACHABILITY from the call graph, not from the file list: one `GraphContext` call returns callers, callees, imports and call paths together, and `GraphImpact` answers whether anything reaches the symbol at all."
    else "  3. Establish REACHABILITY from the callers, not from the file list: Grep for the implicated symbol's name to find what calls it, and follow those callers toward an entry point."
    "  4. Decide the claim on that evidence, and address the CweGuidance FP CHECKS for the CWE you are about to report."
    "  5. Look for OTHER weakness classes at the same location."
    "  6. Look for SIBLING INSTANCES of whatever you confirm."
    "  7. For a claim that a control is MISSING, enumerate every place that control belongs before concluding it is absent anywhere."
    "Mark each todo in_progress as you start it and completed only when you have actually done it. Keep at least one in_progress until the work is finished. Add todos when the evidence opens something new."
    "The outcome tool is GATED on this list: a call to it while any todo is still pending or in_progress is refused and handed back to you with the outstanding items named. Finishing the plan is the only way to report."
    "If a todo turns out not to apply, mark it completed and say why — do not leave it open, and do not retry the same verdict without doing the work."
  }
  // the gate described here is real code: EvidenceGate middleware when step4.planning and step4.evidence_gate are on (s4/session.sudo _gate), at most evidence_gate_refusals rejections
  // preserved: item 1 says "Their source is already inlined below" in every variant, although inlining is off by default (step4.inline_source=false)
}

// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:404-412
PLAN_TOOL_DESCRIPTION {
  Constraints {
    "Record and update your investigation plan for this threat. Call this FIRST, before any other tool and before any verdict"
    "a verdict reached without a worked plan is not acceptable output here."
    "Statuses are \"pending\", \"in_progress\" and \"completed\". Never call this tool twice in one turn."
  }
}

// ---------- per-unit first turn ----------

// src: vvaharness/pipeline/stages/s4/prompts.py:528-533
// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:528-533
S4_INITIAL_PROMPT(unit, code, call_budget = _cap_int(step4, "max_model_calls", 0), graph) {
  _unit_block(unit, code, graph)
  _sweep(call_budget, inlined = code != null, graph)
  _closing(call_budget)
  // never cached; a pure formatter over InvestigationUnit fields
}

// src: vvaharness/pipeline/stages/s4/prompts.py:503-525
// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:447-525
_unit_block(unit, code, files_only=false, graph=true) {
  "UNIT: $id  SIZE: $size  RISK: $impact/$likelihood"
  "ACTOR: $actor"
  "CLAIM: $threat"
  "SURFACE (prose, from the threat model): $surface"
  "ASSET: $asset"
  if (unit.controls) "ALREADY IN PLACE: $controls"
  if (unit.evidence) "WHERE S2 SAW IT: $evidence"
  if (unit.sinks) "KNOWN SINKS IN THESE FILES:" then "  $file:$line  $function  $snippet  $cwes" per sink
  if (unit.cwes) {
    "CWEs THE DETERMINISTIC SCANNER ALREADY MATCHED HERE: $cwes"
    "  These are confirmed pattern hits, not the classification of THIS threat. The claim above may be a different class entirely, and the scanner cannot see a weakness that consists of something MISSING. Treat them as a floor to check, never a ceiling."
  }
  if (unit.entry_points) "ENTRY POINTS:" then "  [unauth]|[auth] [$kind] $file::$function" per entry point
  if (unit.communities) {
    if (graph) "CALL-GRAPH NEIGHBOURHOODS (pass one of these strings verbatim as the `community` argument to GraphSinksInCommunity or GraphCommunityOf):"
    else "CALL-GRAPH NEIGHBOURHOODS:"
    then one community name per line
  }
  if (unit.related_cves) "KNOWN CVEs (hunt for variants/siblings):" then "  - $cve" per CVE
  if (files_only) "FILES ($n):" then one path per line
  else if (code != null) "SOURCE CODE:\n$code"
  else "FILES ($n):" + paths + "No source is inlined for this unit. Read every path above — the sink lines are a starting point, not the full picture."
}

// src: vvaharness/pipeline/stages/s4/prompts.py:304-308
// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:173-260
_sweep(budget, inlined, graph) {
  if (budget > 0) _budgeted_sweep(budget, inlined, graph) else _breadth_sweep(inlined, graph)
}

// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:187-225
_budgeted_sweep(budget, inlined, graph) {
  lookups = max(0, budget - 1)
  Constraints {
    "YOU HAVE $budget MODEL CALLS FOR THIS UNIT, and the last one is reserved: every tool except the outcome report is withdrawn on it. So you have $lookups call(s) that may use tools, then you report. Plan the spend before you spend it."
    if (inlined) "The source above already carries every file in FILES. You do not need a single Read."
    else "No source was inlined, so one of your lookups must be the Read — prefer one call that batches what you need."
    "Spend the lookups on what the prompt above cannot tell you, in this order of value:"
    if (graph) "  1. REACHABILITY — one `GraphContext` on the implicated symbol returns callers, callees, imports and call paths together. An unreachable sink is not a finding, and this is the one question no amount of reading the file answers."
    else "  1. REACHABILITY — one repo-wide Grep for the implicated symbol's name returns its callers with their paths and lines; follow those toward an entry point. An unreachable sink is not a finding, and this is the one question no amount of reading the file answers."
    "  2. BREADTH IN ONE CALL — a lens under `.vvaharness/skills/` that ships a `probe.sh` runs that whole weakness family across the tree in a single `execute`, and its empty sections are evidence of absence."
    "One `grep -rEn \"pat1|pat2|pat3\"` does the same for patterns you choose. Prefer either over several narrow lookups."
    "Then report EVERY distinct weakness you have evidence for — the claim you were handed plus anything else the code in front of you shows: injection, authorization, crypto, secrets, deserialization, sensitive data in logs or responses, request forgery, cookie and transport flags, resource exhaustion, logic flaws."
    "A narrow budget is a reason to look at the whole surface in one pass, not a reason to report one finding."
    "Do not spend a call re-fetching bytes you already hold, and do not end with an empty findings list because you ran out of lookups — report what you established."
  }
  // the reserved last call is real code: ModelCallBudget withdraws non-outcome tools (s4/session.sudo _call_budget); the budget there is grown by one per extra batch member, but this text states the unit budget
  // preserved: item 2 refers to `execute`, which exists only when step4.bash is on
}

// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:173-260
_breadth_sweep(inlined, graph) {
  Constraints {
    "FOUR PASSES, in this order, before you report. You have no sub-agents: every pass is yours, and the todo list is what proves you made them."
    if (inlined) "  1. SURFACE — the source above already carries this unit's files. Work from it. Call Read only for a path that is NOT shown there, or for one the block marks as clipped."
    else "  1. SURFACE — no source was inlined, so Read every path in FILES, each to its end. A paginated result is a prefix: call Read again at the stated offset until you reach the last line. A weakness in the part you did not read is one you will report as absent."
    if (inlined) "Re-reading a file you were already given spends a turn for bytes you hold, and the duplicate is re-sent on every later turn."
    if (graph) "  2. REACHABILITY — one `GraphContext` call on the implicated symbol returns its callers, callees, imports and call paths together. Prefer it over several Reads."
    else "  2. REACHABILITY — Grep the repo for the implicated symbol's name to find its callers, and follow them toward an entry point. Prefer one wide Grep over several Reads."
    "An unreachable sink is not a finding; a caller you never looked for is how a real one is missed."
    "  3. CO-LOCATED CLASSES — having settled the claim, walk the same location for everything ELSE wrong with it: injection, authorization, crypto and randomness, secrets, deserialization, sensitive data in responses and logs, request forgery, cookie and transport flags, resource exhaustion, logic flaws on amounts and identifiers. You are anchored on your claim and will not see these unless you look deliberately."
    "  4. SIBLINGS — for anything you confirm, Grep the repo for two or three phrasings of the same pattern and judge each hit on its own evidence."
    "Each site is its own finding with its own cwe, file and line_start."
    "A session that confirms one weakness and makes none of these passes has reported a fraction of what is there. Make them even when the claim looks narrow and obvious — that is exactly the case where the rest of the surface goes unexamined."
  }
}

// src: vvaharness/pipeline/stages/s4/prompts.py:311-315
_closing(budget) {
  if (budget > 0) "Spend your lookups, then report the outcome object."
  else "Work your plan, make all four passes, then report the outcome object."
}

// ---------- per-batch first turn ----------

// src: vvaharness/pipeline/stages/s4/prompts.py:571-578
// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:536-578
S4_BATCH_PROMPT(units, code, n_files, call_budget, graph) {
  _batch_duty(units)
  "---"
  each unit's _unit_block(unit, null, files_only=true, graph), separated by "---"
  "---"
  _shared_code_section(code, n_files)
  _sweep(call_budget, inlined = code != null, graph)
  _closing(call_budget)
}

// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:536-556
_batch_duty(units) {
  Constraints {
    "THIS SESSION CARRIES $n UNITS: $ids"
    "What it is NOT is permission to merge them."
    "Each unit gets its OWN entry in `outcomes`, with its own verdict, its own rationale and its own findings, echoing its own id. A unit you leave out is recorded as uninvestigated, which is worse than a refutation you had to reason your way to."
    "Two units sharing a file do NOT share an answer: the same handler can satisfy one claim and refute another. Decide each claim on its own evidence."
    "a weakness you find while working one unit belongs to whichever unit's surface actually holds it — file it there, not wherever you happened to be looking."
    "These units are NOT owed equal output"
    "do not ration findings across units, and do not summarise several call sites into one broad finding to keep the reply short."
  }
  // the omission consequence is real code: an omitted member is "uninvestigated" and may be retried alone (s4_deepdive.sudo run)
}

// prompt-src: vvaharness/pipeline/stages/s4/prompts.py:559-568
_shared_code_section(code, n_files) {
  if (code == null) "No source is inlined for this session. Read the paths listed under each unit — the sink lines are a starting point, not the full picture."
  else {
    "SOURCE CODE — all $n_files file(s) across every unit above, each inlined ONCE:\n$code"
    "A file listed under two units appears here a single time. When two units name the same path, they are asking different questions of the same code."
  }
}
