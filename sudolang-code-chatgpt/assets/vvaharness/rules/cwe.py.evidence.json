  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"CWE id normalisation, weakness-class equivalence, and the OWASP-2025 label map.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\n# Families absent here fall back to Injection, the modal category for a taint sink.\nOWASP_2025_BY_SEMANTIC: dict[str, tuple[str, ...]] = {\n    \"html-response\": (\"A03:2025-Injection\",),\n    \"command-exec\": (\"A03:2025-Injection\",),\n    \"sql-exec\": (\"A03:2025-Injection\",),\n    \"url-fetch\": (\"A10:2025-SSRF\", \"A03:2025-Injection\"),\n    \"file-io\": (\"A01:2025-Broken-Access-Control\", \"A03:2025-Injection\"),\n    \"deserialization\": (\"A08:2025-Software-and-Data-Integrity-Failures\",),\n    \"template-render\": (\"A03:2025-Injection\",),\n    \"credentials\": (\"A02:2025-Cryptographic-Failures\",),\n}\n\n\n_CWE_RE = re.compile(r\"CWE[-_ ]?0*(\\d{1,4})\", re.IGNORECASE)\n\n\ndef norm_cwe(value: object) -> str | None:\n    \"\"\"Canonicalize a CWE reference: 'cwe_089', 'CWE-0089', '89' -> 'CWE-89'.\"\"\"\n    match = _CWE_RE.search(str(value or \"\"))\n    return f\"CWE-{int(match.group(1))}\" if match else None\n\n\n# One weakness per row (s4 fan-out, s5/s7 collapse, s5 re-anchor); the first id names a survivor\n_WEAKNESS_CLUSTERS: tuple[tuple[str, ...], ...] = (\n    # SQL injection, Data Query Logic neutralization, and the dedicated SQL-injection variant.\n    (\"CWE-89\", \"CWE-943\", \"CWE-564\"),\n    # OS Command Injection / Command Injection.\n    (\"CWE-78\", \"CWE-77\"),\n    # Path Traversal family.\n    (\"CWE-22\", \"CWE-23\", \"CWE-36\"),\n    # XSS family.\n    (\"CWE-79\", \"CWE-80\"),\n    # Missing Authorization / Improper Access Control family.\n    (\"CWE-862\", \"CWE-285\", \"CWE-284\"),\n)\n# Disjoint clusters make key equality an equivalence, so a dedup pass may test the group root alone.\n_WEAKNESS_KEY: dict[str, str] = {c: cluster[0] for cluster in _WEAKNESS_CLUSTERS for c in cluster}\n\n# GENERIC PARENTS, redundant against anything specific; 20 vs 74 are deliberately NOT folded\n_GENERIC_PARENT_CWES: frozenset[str] = frozenset({\"CWE-20\", \"CWE-74\"})\n\n\ndef weakness_key(value: object) -> str | None:\n    \"\"\"norm_cwe(*value*) with cluster siblings folded onto one id; None when unparseable.\"\"\"\n    cwe = norm_cwe(value)\n    return _WEAKNESS_KEY.get(cwe, cwe) if cwe else None\n\n\ndef same_weakness(cwe_a: object, cwe_b: object) -> bool:\n    \"\"\"True when *cwe_a* and *cwe_b* name the same underlying weakness.\"\"\"\n    # An input that fails to normalise returns False: \"cannot tell\" is never evidence of a match.\n    a = norm_cwe(cwe_a)\n    b = norm_cwe(cwe_b)\n    if not a or not b:\n        return False\n    if a == b:\n        return True\n    a_generic = a in _GENERIC_PARENT_CWES\n    b_generic = b in _GENERIC_PARENT_CWES\n    if a_generic != b_generic:\n        return True\n    if a_generic and b_generic:\n        return False\n    return weakness_key(a) == weakness_key(b)\n\n\n__all__ = [\n    \"OWASP_2025_BY_SEMANTIC\",\n    \"norm_cwe\",\n    \"same_weakness\",\n    \"weakness_key\",\n]\n",
