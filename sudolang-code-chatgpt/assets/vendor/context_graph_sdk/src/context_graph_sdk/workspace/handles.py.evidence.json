  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Manager-owned snapshot lease registry.\n\nProject databases are not cached by the manager: query workers open the\nleased immutable snapshot per request and close it afterwards, so open\nhandles are bounded by the worker pool. The registry only tracks active\nreader leases so retired snapshots are garbage-collected safely.\n\"\"\"\n\n# pyright: reportPrivateUsage=false\n\nfrom __future__ import annotations\n\nimport threading\nimport time\nfrom contextlib import AbstractContextManager\nfrom types import TracebackType\n\nfrom context_graph_sdk.models import SnapshotLocator\n\n\nclass _SnapshotLease(AbstractContextManager[\"_SnapshotLease\"]):\n    def __init__(self, registry: SnapshotLeaseRegistry, locator: SnapshotLocator) -> None:\n        self._registry = registry\n        self.locator = locator\n        self.released = False\n\n    def __enter__(self) -> _SnapshotLease:\n        return self\n\n    def __exit__(\n        self,\n        exc_type: type[BaseException] | None,\n        exc_value: BaseException | None,\n        traceback: TracebackType | None,\n    ) -> None:\n        self.release()\n\n    def release(self) -> None:\n        if not self.released:\n            self._registry._release(self.locator)\n            self.released = True\n\n\nclass SnapshotLeaseRegistry:\n    def __init__(self) -> None:\n        self._counts: dict[str, int] = {}\n        self._condition = threading.Condition()\n        self._closed = False\n\n    def acquire(self, locator: SnapshotLocator) -> AbstractContextManager[_SnapshotLease]:\n        with self._condition:\n            if self._closed:\n                raise RuntimeError(\"snapshot lease registry is closed\")\n            key = locator.database_path\n            self._counts[key] = self._counts.get(key, 0) + 1\n        return _SnapshotLease(self, locator)\n\n    def active_count(self, locator: SnapshotLocator) -> int:\n        with self._condition:\n            return self._counts.get(locator.database_path, 0)\n\n    def wait_for_zero(self, timeout_seconds: float) -> bool:\n        deadline = time.monotonic() + timeout_seconds\n        with self._condition:\n            while self._counts:\n                remaining = deadline - time.monotonic()\n                if remaining <= 0:\n                    return False\n                self._condition.wait(remaining)\n            return True\n\n    def close(self) -> None:\n        with self._condition:\n            if self._counts:\n                raise RuntimeError(\"cannot close lease registry with active leases\")\n            self._closed = True\n\n    def _release(self, locator: SnapshotLocator) -> None:\n        with self._condition:\n            key = locator.database_path\n            count = self._counts.get(key, 0)\n            if count <= 1:\n                self._counts.pop(key, None)\n            else:\n                self._counts[key] = count - 1\n            self._condition.notify_all()\n",
