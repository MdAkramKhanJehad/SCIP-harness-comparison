// file: vulnhunter-fix/scripts/prompt-lint.py
// Dev-time lint (REQ-CWE-010): each CWE-class worker prompt must exist and reference worker_agent_common.md,
// the shared preamble must exist, and the legacy worker_agent.md must be gone.

@executedBy(CODE) @role(evaluation) @stage("fix")
class PromptLint {

    int run(List<String> argv) {
        return main(argv);
    }

    int lint(Path promptsDir) {
        List<String> violations = List.of();
        for (String name : List.of("worker_agent_authz.md", "worker_agent_injection.md", "worker_agent_crypto.md", "worker_agent_resource.md", "worker_agent_config.md")) { // src: vulnhunter-fix/scripts/prompt-lint.py:27
            Path path = promptsDir.join(name);
            if (!path.isFile()) {
                violations.add(name + ": missing CWE-class prompt file");                                  // src: vulnhunter-fix/scripts/prompt-lint.py:41
                continue;
            }
            if (!Files.read(path).contains("worker_agent_common.md")) violations.add(name + ": does not reference the shared preamble"); // src: vulnhunter-fix/scripts/prompt-lint.py:44
        }
        if (!promptsDir.join("worker_agent_common.md").isFile()) violations.add("missing shared preamble"); // src: vulnhunter-fix/scripts/prompt-lint.py:50
        if (promptsDir.join("worker_agent.md").isFile()) violations.add("legacy worker_agent.md must be deleted"); // src: vulnhunter-fix/scripts/prompt-lint.py:54
        if (!violations.isEmpty()) return 1;                                                               // src: vulnhunter-fix/scripts/prompt-lint.py:63
        return 0;
    }

    int main(List<String> argv) {
        Args args = parseArgs(argv);                                                                       // --prompts-dir defaults to <skill>/prompts
        return lint(args.promptsDir != null ? args.promptsDir : skillRoot().join("prompts"));              // src: vulnhunter-fix/scripts/prompt-lint.py:71
    }
}
