// file: vulnhunter-agent/agent/verify_resolve.py
// Verify-mode git/GitHub resolution: repo_hint -> clonable URL (allow-listed URL or exact alias, never inferred),
// additional-repo and target clones, and staging of the named scan report. Failures raise ResolveError.

@executedBy(CODE) @role(io) @stage("verify")
class VerifyResolve {

    // _hint_host: lowercased host of https?://, ssh:// or scp-like git@host:path.
    String hintHost(String url) {
        if (url.startsWith("git@")) {                                                             // src: vulnhunter-agent/agent/verify_resolve.py:56
            String host = url.substring(4).split(":", 1).get(0);                                  // src: vulnhunter-agent/agent/verify_resolve.py:57
            return (host != "") ? host.lower() : null;                                            // src: vulnhunter-agent/agent/verify_resolve.py:58
        }
        Url parsed = urlparse(url);                                                               // src: vulnhunter-agent/agent/verify_resolve.py:59
        return (parsed.hostname != null) ? parsed.hostname.lower() : null;                        // src: vulnhunter-agent/agent/verify_resolve.py:60
    }

    // resolve_repo_hint: (1) URL-shaped hint on an allow-listed host, else null (SSRF guard); (2) exact alias key.
    String resolveRepoHint(String hint, Map<String, String> aliases, List<String> allowedHosts) {
        String cleaned = orElse(hint, "").strip();                                                // src: vulnhunter-agent/agent/verify_resolve.py:86
        if (cleaned == "") return null;                                                           // src: vulnhunter-agent/agent/verify_resolve.py:87
        if (θ["code.agent.verify_resolve.url_like_pattern"].match(cleaned)) {                     // src: vulnhunter-agent/agent/verify_resolve.py:89
            Set<String> allowed = allowedHosts.filter(h -> h != "").map(h -> h.lower()).toSet();  // src: vulnhunter-agent/agent/verify_resolve.py:90
            String host = hintHost(cleaned);                                                      // src: vulnhunter-agent/agent/verify_resolve.py:91
            if (host != null && allowed.contains(host)) return cleaned;                           // src: vulnhunter-agent/agent/verify_resolve.py:92
            return null;                                                                          // src: vulnhunter-agent/agent/verify_resolve.py:99
        }
        return aliases.get(cleaned);                                                              // src: vulnhunter-agent/agent/verify_resolve.py:100
    }

    // authorized_token_path_prefixes: owner segment of each alias URL plus verify.token_path_prefixes (CWE-441 guard).
    List<String> authorizedTokenPathPrefixes(Map<String, String> aliases, List<String> extra) {
        Set<String> prefixes = extra.filter(p -> p != null && p.strip() != "").map(p -> p.strip()).toSet(); // src: vulnhunter-agent/agent/verify_resolve.py:113
        if (θ["code.agent.verify_resolve.alias_owners_get_token"]) {                              // src: vulnhunter-agent/agent/verify_resolve.py:114
            for (String url : aliases.values()) {                                                 // src: vulnhunter-agent/agent/verify_resolve.py:114
                String path;
                if (url.startsWith("git@")) path = url.contains(":") ? url.substring(4).split(":", 1).get(1) : ""; // src: vulnhunter-agent/agent/verify_resolve.py:116
                else path = urlparse(url).path;                                                   // src: vulnhunter-agent/agent/verify_resolve.py:118
                String owner = (path.strip("/") != "") ? path.strip("/").split("/").get(0) : "";  // src: vulnhunter-agent/agent/verify_resolve.py:119
                if (owner != "") prefixes.add(owner);                                             // src: vulnhunter-agent/agent/verify_resolve.py:120
            }
        }
        return prefixes.sorted();                                                                 // src: vulnhunter-agent/agent/verify_resolve.py:122
    }

    // clone_additional_repo: token attached only for authorized owner paths (empty -> no token).
    Path cloneAdditionalRepo(String url, Path baseDir, String githubToken, String githubHost, int timeoutSeconds, List<String> allowedTokenPathPrefixes) {
        baseDir.mkdirs();                                                                         // src: vulnhunter-agent/agent/verify_resolve.py:146
        try {
            return Clone.shallowClone(url, baseDir, timeoutSeconds, false, githubToken, githubHost, θ); // src: vulnhunter-agent/agent/verify_resolve.py:148
            // allowed_token_path_prefixes passed through to the clone's token-injection check
        } catch (RuntimeError exc) {
            throw new ResolveError("Could not clone additional repo");                            // src: vulnhunter-agent/agent/verify_resolve.py:157
        }
    }

    // clone_target_repo: commit-pinned when commit is given, else shallow clone of the default branch.
    Path cloneTargetRepo(String repoUrl, Path targetDir, String commit, String githubToken, String githubHost, int timeoutSeconds) {
        targetDir.mkdirs();                                                                       // src: vulnhunter-agent/agent/verify_resolve.py:177
        try {
            if (commit != null && commit != "") return Clone.cloneAtCommit(repoUrl, targetDir, commit, timeoutSeconds, false, githubToken, githubHost, θ); // src: vulnhunter-agent/agent/verify_resolve.py:179
            return Clone.shallowClone(repoUrl, targetDir, timeoutSeconds, false, githubToken, githubHost, θ); // src: vulnhunter-agent/agent/verify_resolve.py:188
        } catch (RuntimeError exc) {
            throw new ResolveError("Could not clone target repo");                                // src: vulnhunter-agent/agent/verify_resolve.py:196
        }
    }

    // stage_report: download the named report and copy it under destination_dir/<results_dir_name>.
    // Accepted risk (VULN-005/006): markers come from the issue body with no authenticity binding.
    Path stageReport(String sourceRepoUrl, String resultsDirName, Path destinationDir) {
        destinationDir.mkdirs();                                                                  // src: vulnhunter-agent/agent/verify_resolve.py:234
        DownloadedReport downloaded;
        try {
            downloaded = IssuesRemoteReport.downloadNamedReport(sourceRepoUrl, resultsDirName, θ["publish.*"], θ["github.*"],
                    θ["verify.*"].cloneTimeoutSeconds, null);                                     // src: vulnhunter-agent/agent/verify_resolve.py:240
        } catch (Exception exc) {
            throw new ResolveError("Could not download named report");                            // src: vulnhunter-agent/agent/verify_resolve.py:243
        }
        try {
            Path target = destinationDir.resolve(resultsDirName);                                 // src: vulnhunter-agent/agent/verify_resolve.py:249
            if (target.exists()) rmtree(target);                                                  // src: vulnhunter-agent/agent/verify_resolve.py:250
            copytree(downloaded.path, target);                                                    // src: vulnhunter-agent/agent/verify_resolve.py:252
            return target;
        } finally {
            downloaded.cleanup();                                                                 // src: vulnhunter-agent/agent/verify_resolve.py:255
        }
    }
}

@executedBy(CODE) @role(types)
class ResolveError extends RuntimeError { }
