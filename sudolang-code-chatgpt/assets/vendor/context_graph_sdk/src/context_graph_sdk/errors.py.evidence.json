  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Typed errors shared by backend-neutral SDK contracts.\"\"\"\n\nfrom __future__ import annotations\n\n\nclass ContextGraphError(Exception):\n    \"\"\"Base class for SDK failures.\"\"\"\n\n\nclass ModelValidationError(ContextGraphError, ValueError):\n    \"\"\"A graph or identity value violates a persisted-data invariant.\"\"\"\n\n\nclass ResolutionLimitError(ContextGraphError):\n    \"\"\"Resolution exceeded an explicit graph-growth bound.\"\"\"\n\n\nclass LifecycleError(ContextGraphError):\n    \"\"\"A workspace or snapshot resource is not in the required state.\"\"\"\n\n\nclass WorkspaceClosedError(LifecycleError):\n    \"\"\"An operation was attempted after workspace closure.\"\"\"\n\n\nclass WorkspaceLockedError(LifecycleError):\n    \"\"\"Another manager process owns the workspace directory.\"\"\"\n\n\nclass SnapshotLifecycleError(LifecycleError):\n    \"\"\"An accepted or leased snapshot cannot be resolved safely.\"\"\"\n\n\nclass DiscoveryError(ContextGraphError):\n    \"\"\"Repository discovery input is unsafe, unreadable, or over a bound.\"\"\"\n\n\nclass QueryError(ContextGraphError):\n    \"\"\"Base class for project-query failures.\"\"\"\n\n\nclass QueryValidationError(QueryError):\n    \"\"\"Cypher is outside the accepted read-only subset.\"\"\"\n\n\nclass QueryTimeoutError(QueryError):\n    \"\"\"The manager terminated a query worker at its deadline.\"\"\"\n\n\nclass QueryCancelledError(QueryError):\n    \"\"\"The caller cancelled an in-flight worker request.\"\"\"\n\n\nclass QueryResourceLimitError(QueryError):\n    \"\"\"A worker, row, or serialized-byte limit was exceeded.\"\"\"\n\n\nclass QueryWorkerError(QueryError):\n    \"\"\"The worker crashed or violated its lifecycle contract.\"\"\"\n\n\nclass QueryProtocolError(QueryError):\n    \"\"\"A bounded worker IPC frame was malformed.\"\"\"\n\n\nclass StructuredQueryError(QueryError):\n    \"\"\"A bounded model-facing graph operation failed.\"\"\"\n\n\nclass SymbolNotFoundError(StructuredQueryError):\n    def __init__(self, selector: str) -> None:\n        self.selector = selector\n        super().__init__(f\"symbol not found: {selector}\")\n\n\nclass SymbolAmbiguousError(StructuredQueryError):\n    def __init__(self, selector: str, candidate_ids: tuple[str, ...]) -> None:\n        self.selector = selector\n        self.candidate_ids = candidate_ids\n        super().__init__(f\"symbol is ambiguous: {selector} ({len(candidate_ids)} candidates)\")\n\n\nclass StructuredQueryLimitError(StructuredQueryError):\n    \"\"\"A structured traversal exceeded an explicit graph bound.\"\"\"\n\n\nclass PluginError(ContextGraphError):\n    \"\"\"A trusted plugin failed in a named execution phase.\"\"\"\n\n    def __init__(\n        self,\n        plugin_name: str,\n        phase: str,\n        message: str,\n        *,\n        context: str | None = None,\n    ) -> None:\n        self.plugin_name = plugin_name\n        self.phase = phase\n        self.context = context\n        suffix = f\" ({context})\" if context else \"\"\n        super().__init__(f\"{plugin_name} [{phase}]{suffix}: {message}\")\n",
