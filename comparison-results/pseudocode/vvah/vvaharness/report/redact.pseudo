// file: vvaharness/report/redact.py
// Sensitive-data redaction applied at every write boundary (Markdown, SARIF, findings.json, error logs):
// ordered regex rules for card data, PII and credentials, each with a validator, plus a run-scoped value-carry
// registry that masks later restatements of an already-masked secret.

@executedBy(CODE) @role(rule_set)
class Redact {

    OrderedMap<String, Object> KNOWN_VALUES = new OrderedMap();   // value-carry registry (LRU), guarded by KNOWN_LOCK // src: vvaharness/report/redact.py:247
    Lock KNOWN_LOCK = new Lock();                                 // src: vvaharness/report/redact.py:248
    String REDACTED_TAG = "[redacted-<label>]";                   // src: vvaharness/report/redact.py:104

    // ---- validators ----

    boolean luhn(String digits) {
        int total = 0; boolean odd = true;                                                             // src: vvaharness/report/redact.py:29
        for (char ch : digits.reversed()) {
            int n = ch.digit();
            if (!odd) { n *= 2; if (n > 9) n -= 9; }                                                   // src: vvaharness/report/redact.py:32
            total += n; odd = !odd;
        }
        return total % 10 == 0;                                                                        // src: vvaharness/report/redact.py:38
    }

    /** IIN/BIN gate so random Luhn-passing 16-digit ids are not masked. */
    boolean ccNetwork(String digits, Theta θ) {
        int n = digits.length();                                                                       // src: vvaharness/report/redact.py:69
        if (n < θ["code.report.redact.pan_digit_range"].min || n > θ["code.report.redact.pan_digit_range"].max) return false; // 12..19 // src: vvaharness/report/redact.py:70
        for (CardNetwork c : θ["code.report.redact.card_networks"]) {                                  // amex, visa, mastercard, discover, jcb, unionpay, diners, maestro, rupay // src: vvaharness/report/redact.py:49
            if (c.lo <= n && n <= c.hi && c.prefixes.contains(Integer.parse(digits.substring(0, c.width)))) return true; // src: vvaharness/report/redact.py:72
        }
        return false;
    }

    /** Rejects only impossible SSN groupings (area 000/666, group 00, serial 0000). */
    boolean ssnValid(String d) {
        int area = Integer.parse(d.substring(0, 3)); int group = Integer.parse(d.substring(3, 5)); int serial = Integer.parse(d.substring(5, 9)); // src: vvaharness/report/redact.py:81
        return !(area == 0 || area == 666 || group == 0 || serial == 0);                               // src: vvaharness/report/redact.py:82
    }

    /** Bearer/Basic value must contain a non-letter, so prose like "HTTP Basic Auth" is skipped. */
    boolean bearerCredential(Match m) {
        return m.group("bv").anyMatch(c -> !c.isAlpha());                                             // src: vvaharness/report/redact.py:87
    }

    // ---- value carry ----

    int classDiversity(String value) {
        return count(value.hasLower(), value.hasUpper(), value.hasDigit(), value.hasSymbol());         // src: vvaharness/report/redact.py:262
    }

    /** Distinctive enough to remember for restatement matching. */
    boolean rememberable(String value, Theta θ) {
        if (value.length() < θ["code.report.redact.min_known_len"]) return false;                      // 10 // src: vvaharness/report/redact.py:273
        if (value.length() >= θ["code.report.redact.known_long_enough_alone"]) return true;            // 12 // src: vvaharness/report/redact.py:275
        return classDiversity(value) >= 2;                                                             // src: vvaharness/report/redact.py:277
    }

    /** Register value in the bounded LRU registry (caller holds KNOWN_LOCK). */
    void rememberKnownValue(String value, Theta θ) {
        if (KNOWN_VALUES.containsKey(value)) { KNOWN_VALUES.moveToEnd(value); return; }               // src: vvaharness/report/redact.py:283
        if (KNOWN_VALUES.size() >= θ["code.report.redact.known_values_max"]) KNOWN_VALUES.popFirst();  // 2048, LRU eviction // src: vvaharness/report/redact.py:286
        KNOWN_VALUES.put(value, null);                                                                 // src: vvaharness/report/redact.py:288
    }

    /** Once per repo (batch.py); never mid-repo. */
    void resetKnownValues() {
        synchronized (KNOWN_LOCK) { KNOWN_VALUES.clear(); }                                            // src: vvaharness/report/redact.py:295
    }

    // ---- core ----

    /** Core masking pass: each rule in order, then value carry, then placeholder reinsertion. Returns (text, counts). */
    Pair<String, Map<String, Integer>> redactImpl(String text, boolean carry, Theta θ) {
        if (text.contains("\0")) text = text.replace("\0", "");                                       // NUL reserved as the placeholder sentinel // src: vvaharness/report/redact.py:303
        Map<String, Integer> counts = new Map(); List<String> placeholders = new List();
        String out = text;                                                                             // src: vvaharness/report/redact.py:322
        for (RedactRule r : θ["code.report.redact.patterns"]) {                                        // PAN CVV TRACK SSN SSN-CTX AWS GITHUB SLACK ANTHROPIC STRIPE GOOGLE AZURE-SAS TWILIO JWT BEARER URL-CRED PRIVATE-KEY SECRET SECRET-XML SECRET-ARG // src: vvaharness/report/redact.py:119
            out = r.regex.sub(out, m -> substitute(r, m, counts, placeholders, θ));                     // src: vvaharness/report/redact.py:385
        }
        if (carry && !KNOWN_VALUES.isEmpty()) {                                                        // src: vvaharness/report/redact.py:388
            List<String> known = KNOWN_VALUES.keys().sortedBy(s -> Tuple.of(-s.length(), s));         // longest first // src: vvaharness/report/redact.py:391
            for (String value : known) {
                if (out.contains(value)) {                                                             // src: vvaharness/report/redact.py:393
                    KNOWN_VALUES.moveToEnd(value);                                                     // a hit is a use: refresh LRU // src: vvaharness/report/redact.py:397
                    out = out.replaceAll(Regex.escape(value), m -> mask("SECRET-RESTATED", m, null, true, counts, placeholders, θ)); // src: vvaharness/report/redact.py:398
                }
            }
        }
        if (!placeholders.isEmpty()) out = Regex.sub("\\x00(\\d+)\\x00", out, m -> placeholders.getOrSelf(m.group(1))); // src: vvaharness/report/redact.py:407
        return Pair.of(out, counts);                                                                   // src: vvaharness/report/redact.py:408
    }

    /** _mask: count the label, maybe remember the value, return a sentinel; keeps the newline count (PEM line numbers). */
    String mask(String label, Match m, String span, boolean remember, Map counts, List placeholders, Theta θ) {
        counts.increment(label);                                                                       // src: vvaharness/report/redact.py:311
        String value = span != null ? span : m.group(0);                                               // src: vvaharness/report/redact.py:313
        int nl = value.count("\n");                                                                    // src: vvaharness/report/redact.py:314
        if (nl == 0 && remember && rememberable(value, θ)) rememberKnownValue(value, θ);              // src: vvaharness/report/redact.py:316
        placeholders.add("[REDACTED-" + label + "]" + "\n".repeat(nl));                                // src: vvaharness/report/redact.py:319
        return "\0" + (placeholders.size() - 1) + "\0";                                                // src: vvaharness/report/redact.py:320
    }

    /** _sub: run the rule's validator, then the per-label masking shape. */
    String substitute(RedactRule r, Match m, Map counts, List placeholders, Theta θ) {
        if (r.validator != null && !r.validator.test(m)) return m.group(0);                           // src: vvaharness/report/redact.py:325
        if (r.label == "SECRET") return secretValue(m, counts, placeholders, θ);                       // src: vvaharness/report/redact.py:327
        if (r.label == "SECRET-XML" || r.label == "SECRET-ARG") return m.head("v") + mask("SECRET", m, m.group("v"), true, counts, placeholders, θ) + m.tail("v"); // relabelled SECRET // src: vvaharness/report/redact.py:372
        if (r.label == "CVV") return m.head(2) + mask("CVV", m, m.group(2), true, counts, placeholders, θ); // src: vvaharness/report/redact.py:377
        if (r.label == "SSN-CTX") return m.head(2) + mask("SSN", m, m.group(2), true, counts, placeholders, θ); // src: vvaharness/report/redact.py:379
        if (r.label == "URL-CRED") return m.group(1) + mask("URL-CRED", m, m.group(2), true, counts, placeholders, θ) + "@"; // password component only // src: vvaharness/report/redact.py:382
        return mask(r.label, m, null, true, counts, placeholders, θ);                                  // src: vvaharness/report/redact.py:384
    }

    /** SECRET rule: keyword + operator + value, with skips for prose, code shapes and sibling keys. */
    String secretValue(Match m, Map counts, List placeholders, Theta θ) {
        String v = m.group("v"); boolean quoted = !m.group("q").isEmpty();                            // src: vvaharness/report/redact.py:328
        String vCore = quoted ? v : v.rstrip(").}]!?>*|");                                             // markdown bold / table cells stripped // src: vvaharness/report/redact.py:331
        if (vCore.length() < 6) vCore = v;                                                             // src: vvaharness/report/redact.py:332
        if (Regex.match("(?i)\\[redacted-[a-z0-9-]+]", v)) return m.group(0);                         // idempotence // src: vvaharness/report/redact.py:335
        if (!quoted && m.head("v").contains("\n") && (v.endsWith(":") || Regex.match("[A-Z][A-Z0-9_]*=(?!=)", v))) return m.group(0); // next-line sibling key // src: vvaharness/report/redact.py:338
        String keyword = m.group(1).lower().keepLetters();                                             // src: vvaharness/report/redact.py:341
        boolean genericUnquoted = !θ["code.report.redact.strong_secret_keywords"].contains(keyword) && !quoted; // src: vvaharness/report/redact.py:348
        boolean tightEquals = m.group("op") == "=" && m.group("presp").isEmpty() && m.group("postsp").isEmpty(); // .env KEY=value // src: vvaharness/report/redact.py:350
        boolean shortV = vCore.length() < θ["code.report.redact.generic_word_max_len"];               // 20 // src: vvaharness/report/redact.py:354
        boolean identifier = shortV && Regex.fullMatch("[A-Za-z]+(?:_[A-Za-z]+)+", vCore);            // src: vvaharness/report/redact.py:355
        boolean plainWord = genericUnquoted && !tightEquals && vCore.isLower() && ((vCore.isAlpha() && shortV) || identifier); // src: vvaharness/report/redact.py:356
        boolean codeShape = !quoted && (genericUnquoted ? Regex.match("^\\(|^[A-Za-z_]\\w*\\(|^[A-Za-z_]\\w*\\.\\w", vCore)
                                                        : Regex.match("^[A-Za-z_]\\w*\\.\\w+\\(", vCore)); // src: vvaharness/report/redact.py:360
        if (plainWord || codeShape) return m.group(0);                                                 // src: vvaharness/report/redact.py:363
        boolean remember = !(!quoted && (Regex.match("^\\(|^[A-Za-z_]\\w*\\(|^[A-Za-z_]\\w*\\.\\w", vCore) || identifier)); // never remember code-shaped residue // src: vvaharness/report/redact.py:368
        return m.head("v") + mask("SECRET", m, vCore, remember, counts, placeholders, θ) + v.substring(vCore.length()) + m.tail("v"); // src: vvaharness/report/redact.py:370
    }

    // ---- public API ----

    /** Mask card data, PII and credentials in text; records last_counts (not thread-safe). */
    String redact(String text, boolean carry, Theta θ) {
        if (text == null || text.isEmpty()) return text;                                               // src: vvaharness/report/redact.py:413
        Pair<String, Map> r = redactImpl(text, carry, θ);                                             // src: vvaharness/report/redact.py:415
        lastCounts = r.second;                                                                         // src: vvaharness/report/redact.py:416
        return r.first;                                                                                // src: vvaharness/report/redact.py:417
    }

    /** Thread-safe redact: returns (masked_text, counts). */
    Pair<String, Map> redactCounts(String text, boolean carry, Theta θ) {
        if (text == null || text.isEmpty()) return Pair.of(text, Map.of());                           // src: vvaharness/report/redact.py:422
        return redactImpl(text, carry, θ);                                                             // src: vvaharness/report/redact.py:424
    }

    /** Redact every string leaf of a JSON-shaped structure; value carry is off under path/id keys. */
    Object redactTree(Object obj, boolean carry, Theta θ) {
        if (obj instanceof Map) return obj.mapEntries((k, v) -> redactTree(v, carry && !θ["code.report.redact.no_carry_keys"].contains(k), θ)); // src: vvaharness/report/redact.py:438
        if (obj instanceof List) return obj.map(v -> redactTree(v, carry, θ));                         // src: vvaharness/report/redact.py:441
        if (obj instanceof String) return redact(obj, carry, θ);                                       // src: vvaharness/report/redact.py:445
        return obj;                                                                                    // src: vvaharness/report/redact.py:446
    }
}

/** One ordered redaction rule: label, regex, optional validator (PAN: IIN gate + Luhn; SSN: grouping; SECRET: placeholder/quote rules). */
@executedBy(CODE) @role(types)
record RedactRule(String label, Regex regex, Predicate<Match> validator) { }                         // src: vvaharness/report/redact.py:119
