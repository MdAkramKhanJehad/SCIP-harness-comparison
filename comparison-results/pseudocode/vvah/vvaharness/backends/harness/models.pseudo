    }
}

@executedBy(CODE) @role(types)
class AuthenticationError {
    // VVAH-E001, halt error; message gets the credential remediation block appended.
    void init(String message, Integer statusCode, String backend) {
        String full = "[VVAH-E001] Authentication failed" + (statusCode != null ? " (HTTP " + statusCode + ")" : "") + (backend.isEmpty() ? "" : " [" + backend + "]") + ": " + message + AUTH_REMEDIATION; // src: vvaharness/backends/harness/models.py:436
    }
}

@executedBy(CODE) @role(types)
class ProxyError {
    // VVAH-E002, halt error, raised without retry; proxy/TLS remediation block appended.
    void init(String message, Integer statusCode, String backend) {
        String full = "[VVAH-E002] Proxy/network error" + (statusCode != null ? " (HTTP " + statusCode + ")" : "") + ": " + message + PROXY_REMEDIATION; // src: vvaharness/backends/harness/models.py:461
    }
}

@executedBy(CODE) @role(types)
class DegenerateResponseError {
    // VVAH-E003: 200 OK but degenerate content; a single short response is only a warning, repeats raise.
    void init(String message, String stage, int responseLen, int threshold, int consecutive) {
        String full = "[VVAH-E003] Degenerate LLM response" + " | stage=" + stage + " | len=" + responseLen + " (threshold=" + threshold + ")" + " | consecutive=" + consecutive; // src: vvaharness/backends/harness/models.py:493
    }
}

@executedBy(CODE) @role(types)
class OversizePromptError {
    // VVAH-E004: raised BEFORE dispatch on the deepagents route; not a halt error, scan continues.
    void init(String message, String stage, int estimatedTokens, int limit) {
        String full = "[VVAH-E004] Prompt too large for the deepagents route | estimated_tokens=" + estimatedTokens + " (limit=" + limit + ")"; // src: vvaharness/backends/harness/models.py:520
    }
}

@executedBy(CODE) @role(types)
class TruncatedResponseError {
    // VVAH-E005: cut off by its output budget despite one retry; non-halt.
    void init(String message, String stage, int requested, int retried, Integer produced, Integer reasoningTokens, Theta θ) {
        String hint = "";
        if (HarnessModels.truncatedBelowBudget(produced, requested, θ)) {                                // src: vvaharness/backends/harness/models.py:563
            hint = " -- provider stopped at <produced> output tokens against a <requested> budget: a gateway-side cap or reasoning consumption; set models.<role>.max_tokens or lower step*.effort"; // src: vvaharness/backends/harness/models.py:564
        }
        String full = "[VVAH-E005] Truncated LLM response | requested=" + requested + " | retried_at=" + retried + ": " + message + hint; // src: vvaharness/backends/harness/models.py:570
    }
}

