# vvaharness/orchestrator/scan.py

The pipeline for one repository checkout. `scan_repo` runs Stage 0 (static seed) through Stage 11 (validation) in a fixed order. Each stage is checkpointed. On `--resume`, a stage is reused only when the stages it depends on were themselves reused. `--stop-after` can end the run after any stage. This is the top of the stage hierarchy. Each stage's own file is linked from `vvah/INDEX.sudo.md`.

Source: `vvaharness/orchestrator/scan.py` (lines 1-1193)
Executor: code (stages it calls contain the model calls)
Called from: `vvaharness/orchestrator/entry.py` and `vvaharness/orchestrator/batch.py` (one call per repository)

// src: vvaharness/orchestrator/scan.py:106-111
ScanOutcome {
  report_path: Path | null
  finding_count: Number
  exit_code: Number = 0   // nonzero for remediation failure, validation failure, or a degraded report
}

// src: vvaharness/orchestrator/scan.py:380-1072
fn scan_repo(repo, repo_name, application_id, args, cfg, path_prefix?, ev_collection_in?):executor=code {
  run_id = run_id_for(repo)   // keyed on the checkout PATH, not on its content
  ckpt_dir = state_root() + "/checkpoints/$run_id"   // outside the scanned repository
  register_run(run_id, repo, repo_name, application_id)

  // src: scan.py:394-399 — a fresh scan clears old checkpoint rows
  if (!args.resume && args.stop_after != "ev") { reset_run(run_id) }

  // src: scan.py:401-410 — resume is invalidated when git HEAD moved
  repo_head = _head_sha(repo)   // null for a non-git target or a git failure
  if (args.resume && repo_head) {
    prior_head = load_ckpt(run_id, REPO_IDENTITY_STEP)
    if (prior_head is a non-empty string && prior_head != repo_head) {
      warn checkpoint target changed
      reset_run(run_id)
      // preserved: args.resume stays true after this reset; each stage below then finds no checkpoint and reruns
    }
  }
  if (repo_head) { save_ckpt(run_id, REPO_IDENTITY_STEP, repo_head) }

  out_dir = artifact_dir(repo, SCAN_DIR_NAME)   // "security-scan" inside the repository; refuses a committed symlink
  rem_rc = 0

  // src: scan.py:418-427
  if (args.resume && ckpt_dir is inside repo) {
    require checkpoint directory is outside the scanned repository => return ScanOutcome(null, 0)
  }

  out_path, sarif_path = "$out_dir/${module}_${timestamp}_report.md", "...report.sarif"
  errlog.configure("$out_dir/${module}_${timestamp}_errors.jsonl")

  // src: scan.py:439-443 — exploit verification preparation; package rendered under vvah/vvaharness/exploit_verification/
  ev_collection = _ev_prep(repo, args, cfg, ckpt_dir, run_id, ev_collection_in)
  if (args.stop_after == "ev") return ScanOutcome(null, 0)

  // src: scan.py:445-503 — optional model-written exclusion overlay for Stage 1
  if (args.auto_step1) {
    auto_path = "$ckpt_dir/step1.yaml"
    if (!(args.resume && auto_path exists)) {
      try s1_autoexclude.run(repo, cfg, out_path=auto_path);   // contains a model call; see pipeline/stages/s1_autoexclude.sudo
      catch error => {
        if (is_halt_error(error)) throw error
        warn S1_AUTOEXCLUDE_FAILED; errlog.log("s1.autoexclude", error); auto_path = null
      }
    } else {
      // A stored overlay is re-checked against the current vetoes; changes are written back
      stored = yaml(auto_path)
      [dirs1, exts1, globs1] = s1_autoexclude.vet_overlay(repo, cfg, stored.exclude_dirs, stored.exclude_exts, stored.exclude_globs)
      dedup1 = s1_autoexclude.vet_config_dedup(stored.config_dedup)
      if (anything was vetoed || dedup1 != stored.config_dedup) { warn; rewrite auto_path with the vetted lists }
    }
    if (auto_path && auto_path is a file) {
      cfg = deep copy of cfg   // so one batch entry's overlay does not leak into the next
      cfg = config.apply_step1_overlay(cfg, auto_path, expand=false)   // expand=false: overlay text is model-written, so ${...} stays literal
    }
  }

  tracker = ScanProgress.from_cfg(cfg, repo_name)   // abstracted: progress display; no decisions
  cves = load_cves(knob("inject.cve_file")); controls = load_controls(knob("inject.controls_file"))
  [app_profile, app_info] = _load_app_profile(application_id)   // external configuration-management database lookup; see orchestrator/cmdb.sudo

  // ---------- Stage 0: static seed (no model) ----------
  // src: scan.py:569-583
  seed = if (args.resume) load_ckpt(run_id, "s0") else null
  if (seed == null) {
    seed = s0_seed.run(repo, cfg, ckpt_dir)
    save_ckpt(run_id, "s0", seed); _save_stage_provenance("s0")
  } else { mark s0 cached }
  save_callgraph(run_id, "s0", seed)

  // src: scan.py:584-590 — graph workspace, rebuilt every run (never checkpointed)
  plugins = load_plugin_set(cfg); plugins.install_graph_tools()
  graph_dir = ensure_state_dir("graphs", run_id, new random id)
  graph_handle = build_graph(repo, run_id, graph_dir, enrichers=plugins.contribution.enrichers)

  // src: scan.py:591-592, 1067-1072
  constraint OnEveryExit {
    On every exit from here (each --stop-after return, the final return, or an exception): stop the progress display, close graph_handle, delete graph_dir (best effort).
  }

  if (args.stop_after == "s0") return ScanOutcome(null, 0)

  // ---------- Stage 1: pre-process ----------
  // src: scan.py:596-614
  ctx = if (args.resume) load_ckpt(run_id, "s1") else null
  if (ctx == null) {
    ctx = s1_preprocess.run(repo, cfg, cves, controls, seed, graph_handle)   // console label uses role name "preprocess" (scan.py:598-599); see s1_preprocess.sudo for whether a model is called
    save_ckpt(run_id, "s1", ctx); _save_stage_provenance("s1")
  } else { mark s1 cached }
  save_callgraph(run_id, "s1", ctx)
  ctx = _hydrate_ctx_callgraph_from_store(run_id, ctx, "s1", "s0")
  ctx.app_profile = app_profile; ctx.ev_collection = ev_collection; ctx.graph_handle = graph_handle
  if (args.stop_after == "s1") return ScanOutcome(null, 0)

  // ---------- Stage 2: threat model (always attempted; Stages 3 and 4 create nothing without it) ----------
  // src: scan.py:616-668
  tm = if (args.resume) load_ckpt(run_id, "s2") else null
  s2_reran = false
  if (tm == null) {
    s2_reran = true   // set when a rerun is attempted, even if it then fails
    try {
      tm = s2.run(repo, repo_name, cfg, cves, controls, ctx, app_profile)   // model role: threatmodel
      if (tm.threats || tm.assets || tm.trust_boundaries) {
        save_ckpt(run_id, "s2", tm); _save_stage_provenance("s2")
      } else {
        COUNTERS.bump("s2_degraded")   // an empty threat model is not checkpointed, so a resume retries it
      }
    }
    catch error => match (error) {
      case S2HollowAfterRetry => {
        COUNTERS.bump("s2_degraded"); errlog.log("s2", error.reason); mark s2 error
        return ScanOutcome(null, 0, exit_code=1)   // the whole scan stops here
      }
      case is_halt_error(error) => throw error
      default => {
        warn S2_STEP_FAILED; mark s2 error; COUNTERS.bump("s2_degraded")
        tm = null   // the scan continues without a threat model
      }
    }
  } else { mark s2 cached }
  ctx.threat_model = tm
  save_callgraph(run_id, "s2", ctx)
  ctx = _hydrate_ctx_callgraph_from_store(run_id, ctx, "s2", "s1", "s0")
  if (args.stop_after == "s2") return ScanOutcome(null, 0)

  // ---------- Stage 3: decompose into investigation units ----------
  // src: scan.py:670-686
  manifest = if (args.resume && !s2_reran) load_ckpt(run_id, "s3") else null
  s3_resumed = manifest != null
  if (manifest == null) {
    manifest = s3_decompose.run(ctx, cfg)   // console label uses role name "decompose" (scan.py:675-676); see s3_decompose.sudo for whether a model is called
    save_ckpt(run_id, "s3", manifest); _save_stage_provenance("s3")
  } else { mark s3 cached }
  save_callgraph(run_id, "s3", ctx)
  if (args.stop_after == "s3") return ScanOutcome(null, 0)

  // ---------- Stage 4: deep-dive each unit ----------
  // src: scan.py:688-724
  s4_ckpt = if (args.resume && s3_resumed) load_ckpt(run_id, "s4") else null
  if (s4_ckpt != null && !(s4_ckpt is a dict && s4_stage_complete(s4_ckpt))) {
    warn CKPT_STAGE_DEGRADED   // unresolved unit failures from a prior run: rerun Stage 4
    s4_ckpt = null
  }
  s4_resumed = s4_ckpt != null
  unit_outcomes = {}; external_input = false
  if (s4_ckpt == null) {
    [findings, unit_outcomes] = s4_deepdive.run(manifest.sorted_units(), ctx, cfg)   // model role: deepdive; parallel = knob("step4.parallel", default=12)
    save_ckpt(run_id, "s4", { findings, outcomes: unit_outcomes }); _save_stage_provenance("s4")
  } else {
    findings = s4_ckpt.findings; unit_outcomes = s4_ckpt.outcomes
    external_input = s4_input_kind(s4_ckpt) == "external"
    mark s4 cached
  }
  save_callgraph(run_id, "s4", ctx)
  if (args.stop_after == "s4") return ScanOutcome(null, 0)
  s4_count = length(findings)

  // ---------- Stages 5, 6, 7 share one combined checkpoint ("s7") ----------
  // src: scan.py:726-846
  s7_ckpt = if (args.resume && s4_resumed) load_ckpt(run_id, "s7") else null
  legacy_s7_note = ""
  if (s7_ckpt == null) {

    // Stage 5: enrich and pre-filter (deterministic)
    // src: scan.py:732-754
    s5_ckpt = if (args.resume && s4_resumed) load_ckpt(run_id, "s5") else null
    s5_resumed = s5_ckpt != null
    if (s5_ckpt == null) {
      [findings, pre_dropped] = s5.run(findings, ctx, cfg)
      save_ckpt(run_id, "s5", { findings, pre_dropped }); _save_stage_provenance("s5")
    } else { { findings, pre_dropped } = s5_ckpt; mark s5 cached }
    if (args.stop_after == "s5") return ScanOutcome(null, 0)

    // Stage 6: verify
    // src: scan.py:756-788
    s6_ckpt = if (args.resume && s5_resumed) load_ckpt(run_id, "s6") else null
    if (s6_ckpt == null) {
      ctx = _hydrate_ctx_callgraph_from_store(run_id, ctx, "s4", "s3", "s2", "s1", "s0")
      if (ctx.ev_collection) {
        [verified, dropped] = exploit_verification.verify.router.run(findings, ctx, cfg, run_id)   // see exploit_verification/verify/router.sudo
      } else {
        [verified, dropped] = s6_verify.run(findings, ctx, cfg, run_id)   // model role: verify
      }
      verified = _verified_order(verified)
      save_ckpt(run_id, "s6", { verified, dropped }); _save_stage_provenance("s6")
    } else {
      verified = _verified_order(s6_ckpt.verified); dropped = s6_ckpt.dropped; mark s6 cached
    }
    if (args.stop_after == "s6") return ScanOutcome(null, 0)

    // Stage 7: deduplicate (never checkpointed on its own; always reruns when the combined row is missing)
    // src: scan.py:789-807
    ctx = _hydrate_ctx_callgraph_from_store(run_id, ctx, "s4", "s3", "s2", "s1", "s0")
    [canonical, dup_dropped] = s7_dedup.run(verified, cfg, ctx)   // model role: dedup
    _prune_ev_replays(run_id, canonical, ctx)
    s5_out_count = length(findings)
    save_ckpt(run_id, "s7", [pre_dropped, verified, dropped, canonical, dup_dropped, s5_out_count])
  } else {
    // src: scan.py:808-830 — three checkpoint layouts are accepted
    match (length(s7_ckpt)) {
      case 6 => [pre_dropped, verified, dropped, canonical, dup_dropped, s5_out_count] = s7_ckpt
      case 5 => { [pre_dropped, verified, dropped, canonical, dup_dropped] = s7_ckpt; s5_out_count = null; legacy_s7_note = "s5 post-enrich count unavailable for the finding ledger balance check (legacy checkpoint)" }
      default => { [verified, dropped, canonical, dup_dropped] = s7_ckpt; pre_dropped = []; s5_out_count = null; legacy_s7_note = "s5 drop audit unavailable (legacy checkpoint)" }
    }
    mark s5, s6, s7 cached
  }
  if (args.stop_after in ["s5", "s6"]) return ScanOutcome(null, 0)

  // src: scan.py:834-846
  _enrich_findings(canonical, app_info, path_prefix)
  all_dropped = pre_dropped + dropped + dup_dropped
  raw_count = if (s5_out_count != null) s5_out_count else s4_count
  if (s5_out_count != null) {
    ledger_msg = _ledger_imbalance(s5_out_count, verified, dropped)
    if (ledger_msg) { warn LEDGER_IMBALANCE; errlog.log("s6-verify", ledger_msg, recovered=true) }   // logged only; the report is not marked degraded
  }
  save_callgraph(run_id, "s7", ctx)
  if (args.stop_after == "s7") return ScanOutcome(null, 0)

  // ---------- Stage 8: chain analysis and final report ----------
  // src: scan.py:848-899
  ctx = _hydrate_ctx_callgraph_from_store(run_id, ctx, "s4", "s3", "s2", "s1", "s0")
  s7_resumed = s7_ckpt != null
  report = if (args.resume && s7_resumed) load_ckpt(run_id, "s8") else null
  if (report == null) {
    fp = count of dropped where reason == "FALSE_POSITIVE"
    [true_pos, discovered_tp, clone_tp, ev_rescued] = _verified_counts(verified)
    metrics = metrics.build(ctx, manifest, raw_findings=raw_count, true_pos, false_pos=fp, duplicates=length(dup_dropped), discovered_tp, clone_tp, ev_rescued, unit_outcomes, external_input)
    report = s8_chain.run(canonical, ctx, cfg, dropped=all_dropped, raw_findings_count=raw_count, metrics)   // model role: chain
    metrics.refresh_tokens(report.metrics)   // metrics were built before Stage 8 spent tokens
    report.threat_model = tm; report.app_profile = app_profile
    report.threats_without_unit = manifest.threats_without_unit_for(tm)
    if (knob("output.emit_unreachable_appendix", default=false)) { report.unreachable_files = manifest.unreachable_files }
    report.git_sha = _head_sha(repo)   // pinned so Stage 10 can refuse if HEAD moves
    save_ckpt(run_id, "s8", report)
  } else { mark s8 cached }
  if (legacy_s7_note && legacy_s7_note not in report.degraded_reason) {
    report.degraded_reason += legacy_s7_note; report.degraded = true   // appended, never replaced
  }

  // src: scan.py:901-932 — failures upstream mark the report degraded
  for each stage_id in ["s2", "s4", "s6"] {
    if (recorded outcome of stage_id == "error") {
      append "$stage_id failed: <redacted last error>" to report.degraded_reason once; report.degraded = true
    }
  }
  if (any stage in ["s2", "s4", "s6"] failed) { warn INVESTIGATION_STAGE_FAILED; console: findings below "are NOT a trustworthy result for this repo" }
  n_halted = count of unit_outcomes where value == "halted"
  if (n_halted > 0) {
    append "s4 halted early: $n_halted unit(s) not analyzed (expired/invalid credentials or a broken proxy/TLS path)" once; report.degraded = true
  }
  degraded_rc = if (report.degraded) 1 else 0

  // src: scan.py:937-959 — identities, then files
  mint_case_ids(report)   // asserts uniqueness; a clash stops the run before anything is written
  write_findings_json(report, repo)
  md_text = redact(report.to_markdown(
    posture_channel=knob("output.posture_channel", default=true),
    unreachable_appendix=knob("output.emit_unreachable_appendix", default=false)))
  write md_text to out_path
  if (args.stop_after == "s8") return ScanOutcome(out_path, length(report.findings), rem_rc || degraded_rc)

  // ---------- Stage 9: SARIF ----------
  // src: scan.py:961-974
  s9_done = if (args.resume) load_ckpt(run_id, "s9") else null
  if (s9_done == null || sarif_path does not exist) {
    s9_sarif.run(report, sarif_path, application_id, app_info, cfg)
    save_ckpt(run_id, "s9", sarif_path)
  } else { mark s9 cached }

  // src: scan.py:976-990 — upload, once per run
  ingest_done = if (args.resume) load_ckpt(run_id, "ingest") else null
  if (!ingest_done) {
    ok = _upload_to_ingest(out_path, sarif_path, repo_name, application_id, cfg)
    if (ok) save_ckpt(run_id, "ingest", true)
  }
  if (args.stop_after == "s9") return ScanOutcome(out_path, length(report.findings), rem_rc || degraded_rc)

  // ---------- Stage 10: remediation ----------
  // src: scan.py:995-1025
  rem_on = args.remediate || knob("step_remediate.enabled", default=false)
  if (!(rem_on && report.findings)) {
    mark s10 disabled
  } else {
    rem_err = _remediate_preflight(cfg, args, repo, report)
    if (rem_err) {
      mark s10 disabled; errlog.log("s10.preflight", rem_err)   // the scan continues
    } else {
      rem_rc = _run_remediation(report, repo, cfg, ckpt_dir, run_id, resume=args.resume, top=args.top, report_md=out_path)
      if (rem_rc) warn REMEDIATION_INCOMPLETE
    }
  }
  if (args.stop_after == "s10") return ScanOutcome(out_path, length(report.findings), rem_rc || degraded_rc)

  // ---------- Stage 11: validation ----------
  // src: scan.py:1027-1052
  val_rc = 0
  val_on = knob("step_validate.enabled", default=false)
  if (!(val_on && report.findings)) {
    mark s11 disabled
  } else {
    val_err = _validate_preflight(cfg)
    if (val_err) { mark s11 disabled; errlog.log("s11.preflight", val_err) }
    else { val_rc = _run_validation(repo, cfg, config_path=args.config, resume=args.resume, report_md=out_path) }
  }

  // src: scan.py:1050-1066 — exit code precedence: remediation, then validation, then degraded
  return ScanOutcome(out_path, length(report.findings), rem_rc || val_rc || degraded_rc)
}

// src: vvaharness/orchestrator/scan.py:133-149
fn _ledger_imbalance(s5_out_count, verified, dropped):executor=code {
  s6_discovered_verified = count of verified where origin == "s6_discovered"
  clones = count of verified where is_repeat_clone
  s6_dropped_from_s5 = count of dropped where chunk_id does not end with "+s6"
  accounted = (length(verified) - s6_discovered_verified - clones) + s6_dropped_from_s5
  if (accounted == s5_out_count) return null   // an equality check, not a floor
  return message naming how many are missing, or how many are double-counted
}

// src: vvaharness/orchestrator/scan.py:152-161
fn _verified_counts(verified):executor=code {
  tps = verified where verdict == "TRUE_POSITIVE"
  return [length(tps), count of tps where origin == "s6_discovered", count of tps where is_repeat_clone, length(verified) - length(tps)]
  // the last value counts exploit-verification rescues: verified rows without a TRUE_POSITIVE verdict
}

// src: vvaharness/orchestrator/scan.py:164-168
fn _verified_order(verified):executor=code {
  return verified sorted by (file, line_start, line_end, cwe, vuln_class, title, chunk_id)
}

// src: vvaharness/orchestrator/scan.py:287-299
fn _hydrate_ctx_callgraph_from_store(run_id, ctx, ...steps):executor=code {
  for each step in steps {
    graph = load_callgraph(run_id, step)
    if (graph) return copy of ctx with call_graph = graph.call_graph   // first hit wins
  }
  return ctx
}

// src: vvaharness/orchestrator/scan.py:214-262 — the package itself is rendered under vvah/vvaharness/exploit_verification/
fn _ev_prep(repo, args, cfg, ckpt_dir, run_id, collection_in?):executor=code {
  if (ev_options.profile_disabled(cfg)) return null
  [col_in, resumed] = _ev_collection_in(repo, args, ckpt_dir, run_id, collection_in)   // environment variable EV_API_COLLECTION first, then a checkpoint, the latter only on --resume
  if (col_in == null) {
    require !ev_options.required(cfg) => throw EVInputError("step6_exploit_verification.enabled: true requires a collection ...")
    return null
  }
  opts = ev_options.load_options(cfg, environment, resumed)
  if (!opts.enabled) return null
  require ev_options.model_preflight(cfg) reports no error => throw EVInputError
  if (resumed) { ev_gate.run_gate(opts, environment, col_in) } else { save_ckpt(run_id, EV_COLLECTION_STEP, col_in) }
  col = ev_probe.run_probe(col_in, opts, allow_state_changing=knob("step6_exploit_verification.allow_state_changing_methods"))   // external: live requests to the target
  if (col == null) return null   // on_unreachable=abort disabled exploit verification for this run
  _ev_oob_selftest(opts)
  return col
}

// src: vvaharness/orchestrator/scan.py:302-360
fn _upload_to_ingest(md_path, sarif_path, repository_name, application_id, cfg):executor=code {
  url = knob("output.ingest_url"); token = knob("output.ingest_token")
  if (!url || !token || either file missing) return false   // skipped with a console message
  verify = knob("output.ingest_verify", default=knob("sdk.verify_ssl", default=true))
  if (verify is a certificate path && path missing) return false   // fails closed
  POST md and sarif to url with bearer token, timeout 60 seconds   // destination is not restricted
  return status < 400   // any failure is non-fatal
}

// src: vvaharness/orchestrator/scan.py:1075-1126
fn _run_remediation(report, repo, cfg, ckpt_dir, run_id, resume, top?, report_md?):executor=code {
  rem_dir = artifact_dir(repo, REMEDIATION_DIR_NAME)
  eff_top = resolve_top(top, cfg)   // --top overrides knob("step_remediate.top_n_findings")
  selected = drop_non_main_channel(report.findings) |> select_top_logged(eff_top, score_of=finding.cvss_score)
  // posture findings are removed before the top-N cap, so they cannot take an application finding's place
  via = resolve_model(knob("models.remediate")).via
  if (via in ["cli", "sdk", "deepagents"]) { console: FIX MODE, about to edit source files }
  else { console: this backend cannot edit files; fix mode errors per finding }   // preserved: the run still proceeds
  targets = selected as RemediationTarget(finding, index 1..N)
  return runner.process_targets(targets, Layout(rem_dir, ckpt_dir, run_id), cfg, repo, RemediateOptions(resume, mode="fix"), report=report_md)
}

// src: vvaharness/orchestrator/scan.py:1147-1172
fn _remediate_preflight(cfg, args, repo, report):executor=code {
  require knob("models.remediate") is set => return "models.remediate must be set"
  require artifact_dir(repo, REMEDIATION_DIR_NAME) is safe => return error text
  require credentials ready for the remediate model's route => return error text
  require !(report.git_sha && current HEAD && report.git_sha != current HEAD && !args.force) => return "HEAD moved since scan ...; pass --force to override"
  return null
  // any returned text disables Stage 10 only; the scan continues
}

// src: vvaharness/orchestrator/scan.py:1175-1193
fn _validate_preflight(cfg):executor=code {
  require validate_model_spec(cfg) != null => return "models.validate.orchestrator must be set"
  [via, provider] = normalize_validate_backend(resolved via, provider)
  require credentials ready for that route => return error text
  return null
}

// src: vvaharness/orchestrator/scan.py:1129-1139
fn _run_validation(repo, cfg, config_path, resume, report_md?):executor=code {
  rc = s11_validate.run(repo, cfg, config_path, resume, report_md)
  if (rc != 0) warn VALIDATION_NONZERO_EXIT
  return rc
}

