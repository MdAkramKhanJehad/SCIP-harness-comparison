// file: vvaharness/validation/cli/__init__.py
// Trust and path preflight precede staging/spend; temporary workspaces are cleaned even on early failure.

@executedBy(CODE) @role(types)
record ValidationWorkspacePlan(Path workspaceRoot, boolean ownsWorkspace, String error) { }

@executedBy(CODE) @role(pipeline) @stage("S11")
class ValidationCliEntry {
    @src("vvaharness/validation/cli/__init__.py:58")
    ValidationSelection resolveSelection(ValidateArgs args, Config config) {
        if (truthy(args.findings)) return new ValidationSelection(args.findings, null, args.resume);
        if (args.everyValidatable) return new ValidationSelection(null, null, args.resume);
        return new ValidationSelection(null, args.maxFindings != null ? args.maxFindings : config.maxFindings, args.resume);
    }
    @src("vvaharness/validation/cli/__init__.py:68")
    String resolveConfigPath(ValidateArgs args) {
        if (truthy(args.config)) return str(args.config);
        logInfo("using packaged default profile"); return str(defaultConfig());
    }
    @src("vvaharness/validation/cli/__init__.py:77")
    boolean isNonemptyDir(Path path) {
        return path.isDirectory() && path.iterdir().hasNext();
    }
    @src("vvaharness/validation/cli/__init__.py:82")
    String networkPathError(ValidateArgs args) {
        for (Path path : List.ofNullable(args.workspace, args.repo)) if (path != null && isNetworkPath(path)) return "network/UNC path refused";
        return null;
    }
    @src("vvaharness/validation/cli/__init__.py:93")
    String workspaceInsideRepoError(ValidateArgs args) {
        if (args.workspace == null || !args.workspace.resolve().isRelativeTo(args.repo.resolve())) return null;
        return "workspace inside target would load target instructions";
    }
    @src("vvaharness/validation/cli/__init__.py:110")
    String nonemptyWorkspaceError(ValidateArgs args) {
        return args.workspace == null || !isNonemptyDir(args.workspace) ? null : "workspace must be new or empty";
    }
    @src("vvaharness/validation/cli/__init__.py:120")
    String checkPathGuards(ValidateArgs args) {
        String error = networkPathError(args); if (truthy(error)) return error;
        error = workspaceInsideRepoError(args); return truthy(error) ? error : nonemptyWorkspaceError(args);
    }
    @src("vvaharness/validation/cli/__init__.py:129")
    ModelEnvResult trustedModelEnv(ValidateArgs args, Theta θ) {
        String path;
        try { path = trustedConfig(resolveConfigPath(args), args.repo, explicit=args.config != null); }
        catch (ConfigPolicyError e) { logWarning(e); return new ModelEnvResult(2, Map.of()); }
        return ValidationCliModel.applyModelEnv(path, θ);
    }
    @src("vvaharness/validation/cli/__init__.py:148")
    ValidationWorkspacePlan resolveWorkspacePlan(ValidateArgs args, Path repo) {
        if (args.workspace != null) return new ValidationWorkspacePlan(args.workspace.resolve(), false, null);
        Path root = temporaryDirectoryPath("vvah-validate-").resolve();
        if (!root.isRelativeTo(repo)) return new ValidationWorkspacePlan(root, true, null);
        removeTree(root, ignoreErrors=true); return new ValidationWorkspacePlan(root, true, "TMPDIR produced workspace inside repo");
    }
    @src("vvaharness/validation/cli/__init__.py:172")
    ModelEnvResult preflight(ValidateArgs args, Theta θ) {
        ModelEnvResult result = trustedModelEnv(args, θ); if (result.exitCode != 0) return result;
        // Source constructs both checks eagerly, before iterating over them.
        String persona = ValidationCliModel.checkPersonaVendors(result.overrides, θ); String paths = checkPathGuards(args);
        if (truthy(persona)) { logWarning(persona); return new ModelEnvResult(2, result.overrides); }
        if (truthy(paths)) { logWarning(paths); return new ModelEnvResult(1, result.overrides); }
        return result;
    }
    @src("vvaharness/validation/cli/__init__.py:187")
    ValidationRunResult runValidationCleaningUp(Path repo, ValidateArgs args, Config config, ValidationWorkspacePlan plan, Theta θ) {
        try { return ValidationCliRun.runValidation(repo, resolveSelection(args, config), plan.workspaceRoot, config, args.scanReport, θ); }
        finally { if (plan.ownsWorkspace) removeTree(plan.workspaceRoot, ignoreErrors=true); }
    }
    @src("vvaharness/validation/cli/__init__.py:233")
    void recordProgress(ValidationRunResult result, Map progress) {
        int passed = result.verdicts.count(v -> verdictState(v) == VALIDATED);
        int validated = result.metadata.totalFindings; progress.putAll(Map.of("validated", validated, "passed", passed, "failed", validated - passed));
    }
    @src("vvaharness/validation/cli/__init__.py:209")
    int dispatch(List<String> argv, Map progress, Theta θ) {
        ValidateArgs args = ValidateArgs.of(Parser.buildParser().parseArgs(argv));
        ModelEnvResult ready = preflight(args, θ); if (ready.exitCode != 0) return ready.exitCode;
        Config config = loadValidationConfig(ready.overrides); Path repo = args.repo.resolve();
        ValidationWorkspacePlan plan = resolveWorkspacePlan(args, repo);
        if (truthy(plan.error)) { logWarning(plan.error); return 1; }
        ValidationRunResult result = runValidationCleaningUp(repo, args, config, plan, θ);
        if (progress != null) recordProgress(result, progress); return result.exitCode;
    }
    @src("vvaharness/validation/cli/__init__.py:254")
    int main(List<String> argv, Map progress, Theta θ) {
        try { return dispatch(argv, progress, θ); }
        catch (IngestError | ValidationSessionError | ValidationError | FileNotFoundError | OSError | YamlError e) { logWarning(e); return 1; }
        catch (Exception e) { logWarning("unexpected validation error", typeName(e), e); return 1; }
    }
}
