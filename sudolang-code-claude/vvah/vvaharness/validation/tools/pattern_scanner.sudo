Executor: code
Called from: `vvaharness/validation/tools/deep_tools.sudo`, `vvaharness/validation/tools/fact_specs.sudo`

// src: vvaharness/validation/tools/pattern_scanner.py:32-36
_MAX_FILE_BYTES = 512 * 1024
_MAX_TOTAL_BYTES = 32 * 1024 * 1024
_MAX_FILES = 10000
_MAX_MATCHES_PER_FILE = 50
_MAX_MATCHES = 200

// src: vvaharness/validation/tools/pattern_scanner.py:190-203
fn pattern_scan(workspace, pattern_set):executor=code {
  require pattern_set in DEFAULT_PATTERN_SETS => return [{ kind: "error", error: "unknown pattern_set ...; available: [\"insecure_value\", \"secret_exposure\"]" }]
  [description, regex] = DEFAULT_PATTERN_SETS[pattern_set]
  state = new scan state
  _scan_workspace(state, workspace, pattern)
  return _result(state, pattern_set)
}

// src: vvaharness/validation/tools/pattern_scanner.py:176-187
fn _scan_workspace(state, workspace, pattern):executor=code {
  for each file_path in tools._scope.iter_in_scope_files(workspace, include_tests=false) {
    if (file name is "diff.patch") continue   // SKIP_IN_SCAN
    if (state.files_considered >= _MAX_FILES) { state.file_count_truncated = true; break }
    _consume_file(state, file_path, workspace, pattern)
    if (state.byte_limit_truncated) break
  }
}

// src: vvaharness/validation/tools/pattern_scanner.py:152-173
fn _consume_file(state, file_path, workspace, pattern):executor=code {
  state.files_considered += 1
  remaining = _MAX_TOTAL_BYTES - state.bytes_scanned
  read_limit = min(_MAX_FILE_BYTES, remaining)
  result = read at most read_limit bytes   // flags: unreadable; too_large = size > _MAX_FILE_BYTES; binary = contains NUL; has_more = size > read_limit
  state.bytes_scanned += bytes read; count unreadable, too_large, binary
  budget_exhausted = read_limit == remaining && result.has_more
  state.byte_limit_truncated |= budget_exhausted
  if (!(unreadable || too_large || binary || budget_exhausted)) {
    state.files_scanned += 1
    _scan_text(state, decoded text, relative path, pattern)
  }
}

// src: vvaharness/validation/tools/pattern_scanner.py:86-110
fn _scan_text(state, text, relative_path, pattern):executor=code {
  file_matches = 0
  for each match of pattern.regex in text {
    state.matches_seen += 1; file_matches += 1
    if (file_matches > _MAX_MATCHES_PER_FILE) { state.per_file_truncated = true; continue }
    if (length(state.matches) >= _MAX_MATCHES) { state.overall_truncated = true; continue }
    append { kind: "match", file: relative_path, line: line number of match start, pattern_set, rule: "__builtin__", description }
  }
}

// src: vvaharness/validation/tools/pattern_scanner.py:113-149
fn _result(state, pattern_set):executor=code {
  sort matches by (file, line)
  reasons = names of the set flags among: file_size_limit, unreadable_files, binary_files, overall_file_limit, overall_byte_limit, per_file_match_limit, overall_match_limit
  append { kind: "summary", pattern_set, matches_seen, matches_returned, files_considered, files_scanned, files_too_large,
           files_unreadable, binary_files, bytes_scanned, truncated: reasons non-empty, truncation_reasons: reasons, limits: { the five limits above } }
  return matches
  // matches_returned is read before the summary record is appended, so it counts match records only
}
