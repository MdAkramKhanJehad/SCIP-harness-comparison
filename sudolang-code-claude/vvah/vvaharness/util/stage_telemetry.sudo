# vvaharness/util/stage_telemetry.py

Process-wide per-stage telemetry: outcome and duration of each stage, and the composition of the run manifest's `stages`, `totals` and `pricing` sections, with token buckets attributed to stages through a phase map and costed through the price table.

Source: `vvaharness/util/stage_telemetry.py` (lines 1-474)
Executor: code
Called from: `vvaharness/util/status.py` (`STAGES.start/done`), `vvaharness/orchestrator/scan.py` (`STAGES.mark`, `stage_token_bucket` for stage provenance at scan.py:560, `CACHED_PROVENANCE`), `vvaharness/util/metrics.py` and `vvaharness/manifest.py` (`compose_stage_section`), `vvaharness/orchestrator/batch.py` (per-repository `CACHED_PROVENANCE.reset`, `STAGES`)

// src: vvaharness/util/stage_telemetry.py:34-79
STAGE_IDS = ("s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11")
PHASE_MAP = {   // token phase name -> (stage, model role used to price it)
  "s0-seed": ("s0", null), "s1-autoexclude": ("s1", "autoexclude"), "s1-preprocess": ("s1", "preprocess"),
  "s2-threatmodel": ("s2", "threatmodel"), "s3-decompose": ("s3", "decompose"), "s4-deepdive": ("s4", "deepdive"),
  "s5-prefilter": ("s5", "dedup"), "s6-verify": ("s6", "verify"), "s6-ev": ("s6", "exploit_verification.attacker"),
  "s7-dedup": ("s7", "dedup"), "s8-chain": ("s8", "chain"), "s10-remediate": ("s10", "remediate"),
  "remediation-agent-remediate": ("s10", "remediate"), "s11-validate": ("s11", "validate")
}
STAGE_ROLES = { s0: null, s1: "preprocess", s2: "threatmodel", s3: "decompose", s4: "deepdive", s5: "dedup", s6: "verify", s7: "dedup", s8: "chain", s9: null, s10: "remediate", s11: "validate" }
ESTIMATED_COST_STAGES = {"s11"}
ESTIMATED_COST_ROLES = {"exploit_verification.attacker"}   // one phase for all four exploit verification roles, priced at the attacker's model
_ROLE_FALLBACKS = { "exploit_verification.attacker": ("exploit_verification.judge", "exploit_verification.mapper", "exploit_verification.classify") }

// src: vvaharness/util/stage_telemetry.py:185-253
STAGES {
  // locked recorder: stage_id -> { label, outcome, duration_sec }
  fn start(stage_id, label) { outcome = "running" }
  fn done(stage_id, outcome="completed", duration_sec?);
  fn mark(stage_id, outcome, label);   // a stage with no timed body: cached, skipped, disabled
  fn reset();
  fn snapshot() { ordered by STAGE_IDS, unknown ids appended }
}
CACHED_PROVENANCE { fn record(stage_id, provenance); fn reset(); fn snapshot() }   // a resumed stage's actual model, via, configuration hash and tokens

// src: vvaharness/util/stage_telemetry.py:271-295
fn _group_phases(token_snap):executor=code {
  for each phase bucket in token_snap.by_phase {
    if (phase not in PHASE_MAP) add every key (prompt, completion, cache_read, cache_write, calls) to unattributed   // so Σ stages + unattributed = totals for every key
    else append (role, bucket) to its stage
  }
}
fn stage_token_bucket(step_id, token_snap) { return sum of buckets mapped to step_id }

// src: vvaharness/util/stage_telemetry.py:298-342
fn _resolve_model(role, role_models) { return role_models of role, else of each fallback role in order, else null }
fn _stage_cost(phases, role_models, pricing):executor=code {
  if (pricing == null) return null
  total = 0
  for each (role, bucket) {
    rate = pricing.models[_resolve_model(role)]
    if (rate) total += bucket_cost_usd(bucket, rate, pricing.cache_defaults)
    else if (bucket has any prompt, completion or cache-read tokens) return null   // one unpriced phase with tokens makes the whole stage unpriced
  }
  return total
}
fn _provenance_cost(model_id, bucket, pricing) { cached stage priced at its own recorded model; null if unpriced with tokens; 0 if no tokens }

// src: vvaharness/util/stage_telemetry.py:345-380
fn _stage_entry(stage_id, record, phases, role_models, pricing, provenance?):executor=code {
  if (provenance) {
    // a cached stage reports what it was actually produced under; live tokens of the same stage (for example s1 autoexclude) are ADDED
    tokens = provenance.tokens + live tokens
    cost = if (either part unpriced) null else cached cost + live cost
    cached_from_config_sha = provenance.config_sha256
  } else { model = _resolve_model(STAGE_ROLES[stage_id]); tokens = live tokens; cost = _stage_cost(...) }
  cost_estimated = stage_id in ESTIMATED_COST_STAGES || any phase with an ESTIMATED_COST_ROLES role has tokens
  outcome = record.outcome or "not_run"
}

// src: vvaharness/util/stage_telemetry.py:383-443
fn _total_cost(stages) { return if (any stage cost is null) null else sum }
fn _totals(...):executor=code {
  // live token totals plus cached_carryover (sum of cached provenance tokens, read from the provenance envelope, not stage rows, to avoid double counting)
  // abstracted: field-by-field sums; cache_unparsed_calls counts calls and is never priced
}
fn _pricing_status(stages, pricing) {
  match {
    case pricing == null => { status: "unavailable", reason: "no pricing table configured" }
    case some stage has a model and null cost => { status: "incomplete", reason: "pricing missing for model(s): ..." }
    default => { status: "available", reason: "pricing table applied" }
  }
}

// src: vvaharness/util/stage_telemetry.py:454-474
fn compose_stage_section(stage_snap, token_snap, role_models, pricing, cached_provenance?):executor=code {
  // pure: every input is a snapshot
  [by_stage, unattributed] = _group_phases(token_snap)
  stages = for each stage id present in records or buckets (STAGE_IDS order, unknown appended), _stage_entry(...)
  return { stages, totals: _totals(...), pricing: provenance of the table or null, pricing_status: _pricing_status(...) }
}
