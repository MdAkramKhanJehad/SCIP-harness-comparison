// file: vvaharness/validation/io/result_collector.py
// Collects fix-validation verdicts from validation_report.json, re-scored host-side from synthesized gates,
// and renders report rows, filling blank row fields from manifest.json.

@executedBy(CODE) @role(io) @stage("S11")
class ResultCollector {

    List<CollectedFinding> collect(Path workspaceDir, int findingNumberStart, Provenance provenance, ScoringPolicy policy) {
        PersistedValidationReport report;
        try {
            report = Output.fromFile(workspaceDir.resolve("validation_report.json"));      // src: vvaharness/validation/io/result_collector.py:66
        } catch (OSError | ValueError e) {
            Log.warning("Could not read validation report");                                         // src: vvaharness/validation/io/result_collector.py:68
            return List.of();                                                                        // src: vvaharness/validation/io/result_collector.py:69
        }
        Map<String, List<Map>> gatesById = HostScore.loadSynthesizedGates(workspaceDir);             // src: vvaharness/validation/io/result_collector.py:70
        List<CollectedFinding> out = new List();
        for (int i = 0; i < report.findings.size(); i++) {                                           // src: vvaharness/validation/io/result_collector.py:74
            OutputFinding f = report.findings.get(i);
            out.add(one(f, gatesById.get(f.trackingId), findingNumberStart + i, provenance, policy)); // src: vvaharness/validation/io/result_collector.py:72
        }
        return out;
    }

    CollectedFinding one(OutputFinding finding, List<Map> gates, int findingNumber, Provenance provenance, ScoringPolicy policy) {
        Verdict verdict = HostScore.verdictFor(finding, gates, provenance, policy);                  // src: vvaharness/validation/io/result_collector.py:87
        List rows = ValidationModels.gateScoreRows(verdict, ValidationScoring.FIX_CONFIG);           // src: vvaharness/validation/io/result_collector.py:88
        return new CollectedFinding(verdict, ValidationModels.renderRow(verdict, finding, findingNumber, rows.isEmpty() ? "" : Json.dumps(rows), policy)); // src: vvaharness/validation/io/result_collector.py:89
    }

    String filterAffectedFiles(List<String> affected, Theta θ) {
        List<String> kept = affected.filter(n -> !n.startsWith("//") && n.length() > θ["code.validation.io.result_collector.min_affected_file_len"]); // src: vvaharness/validation/io/result_collector.py:103
        return String.join(", ", kept);                                                              // src: vvaharness/validation/io/result_collector.py:107
    }

    Manifest loadManifest(Path workspaceDir) {
        try {
            return ModelsManifest.fromFile(workspaceDir.resolve("manifest.json"));                   // src: vvaharness/validation/io/result_collector.py:113
        } catch (OSError | ValueError e) {
            return null;                                                                             // src: vvaharness/validation/io/result_collector.py:115
        }
    }

    List<CollectedFinding> collectAndEnrich(Path workspaceDir, int findingNumberStart, Provenance provenance, ScoringPolicy policy, Theta θ) {
        List<CollectedFinding> collected = collect(workspaceDir, findingNumberStart, provenance != null ? provenance : new Provenance(), policy); // src: vvaharness/validation/io/result_collector.py:126
        Manifest manifest = loadManifest(workspaceDir);                                              // src: vvaharness/validation/io/result_collector.py:132
        if (collected.isEmpty() || manifest == null || manifest.finding == null) return collected;  // src: vvaharness/validation/io/result_collector.py:133
        return collected.map(item -> new CollectedFinding(item.verdict, enrich(item.row, manifest, θ))); // src: vvaharness/validation/io/result_collector.py:135
    }

    ValidationResult enrich(ValidationResult row, Manifest manifest, Theta θ) {
        Finding f = manifest.finding;                                                                // src: vvaharness/validation/io/result_collector.py:143
        if (f == null) return row;                                                                   // src: vvaharness/validation/io/result_collector.py:144
        Map<String, Object> updates = new Map();
        if (row.findingTitle.isEmpty() && f.title != null) updates.put("finding_title", f.title);    // src: vvaharness/validation/io/result_collector.py:148
        if (row.findingDescription.isEmpty()) updates.put("finding_description", f.description.replace("\\n", " ").strip()); // src: vvaharness/validation/io/result_collector.py:150
        if (row.affectedFiles.isEmpty()) updates.put("affected_files", filterAffectedFiles(manifest.affectedFiles, θ)); // src: vvaharness/validation/io/result_collector.py:155
        if (row.trackingId.isEmpty() || row.trackingId.equals(manifest.caseId)) updates.put("tracking_id", f.caseId != null ? f.caseId : manifest.caseId); // src: vvaharness/validation/io/result_collector.py:160
        if (θ["code.validation.io.result_collector.default_severity_defers_to_finding"] && row.severity.casefold().equals("medium")) updates.put("severity", f.severity); // schema default = no opinion  // src: vvaharness/validation/io/result_collector.py:168
        updates.removeIf(v -> v == null || v.isEmpty());                                             // src: vvaharness/validation/io/result_collector.py:171
        return updates.isEmpty() ? row : row.copy(updates);                                          // src: vvaharness/validation/io/result_collector.py:172
    }
}

@executedBy(CODE) @role(types)
record CollectedFinding(Verdict verdict, ValidationResult row) { }
