// file: vvaharness/skills/__init__.py
// How skills reach a session: the packaged skill tree is copied into <repo>/.vvaharness/skills/ once per scan
// (S2/S4 hand it to the harness as skill_root), removed when the scan returns; the model picks a playbook by its description.

@executedBy(CODE) @role(skill)
class SkillsIndex {

    String INJECTED_SUBDIR = ".vvaharness/skills";                                                         // src: vvaharness/skills/__init__.py:27

    /** Every packaged skill name: a directory carrying SKILL.md. */
    @src("vvaharness/skills/__init__.py:34")
    List<String> skillNames(Theta θ) {
        // one playbook per weakness family, each with a HARD GATE and FP checks; some ship a probe.sh
        return θ["prompt.skills.set"];                                                                      // src: vvaharness/skills/__init__.py:36
    }

    /** Copy the packaged skills under repo_root; None when the copy fails (symlinked parent refused). */
    @src("vvaharness/skills/__init__.py:42")
    Path inject(Path repoRoot) {
        Path parent = repoRoot.resolve(".vvaharness");                                                      // src: vvaharness/skills/__init__.py:44
        if (parent.isSymlink()) return null;                                                                // src: vvaharness/skills/__init__.py:45
        Path dst = repoRoot.resolve(INJECTED_SUBDIR);                                                       // src: vvaharness/skills/__init__.py:50
        try {
            dst.mkdir();                                                                                    // src: vvaharness/skills/__init__.py:51
            Files.copytree(PACKAGED_SKILLS, dst);                                                           // src: vvaharness/skills/__init__.py:56
        } catch (OSError e) {
            return null;                                                                                    // src: vvaharness/skills/__init__.py:58
        }
        Files.delete(dst.resolve("__init__.py"));                                                           // src: vvaharness/skills/__init__.py:59
        return dst;
    }

    /** skill_root for a repo, copied on first call only (S2 and S4 sessions, when step2/step4 skills is on). */
    @src("vvaharness/skills/__init__.py:67")
    Path injectSkills(Path repoRoot) {
        if (!injected.containsKey(repoRoot)) injected.put(repoRoot, inject(repoRoot));                      // src: vvaharness/skills/__init__.py:71
        return injected.get(repoRoot);                                                                      // src: vvaharness/skills/__init__.py:73
    }

    /** Wraps scan_repo: remove this scan's temporary skills on return, failure or interruption. */
    @src("vvaharness/skills/__init__.py:76")
    ScanOutcome withInjectedSkills(Path repo, Callable scan) {
        return scoped(repo, scan);                                                                          // src: vvaharness/skills/__init__.py:78
    }

    /** The decorator's inner function (nested in with_injected_skills, flattened: function becomes the scan callable). */
    @src("vvaharness/skills/__init__.py:79")
    ScanOutcome scoped(Path repo, Callable scan) {
        try {
            return scan.run();                                                                              // src: vvaharness/skills/__init__.py:81
        } finally {
            String key = repo.resolve().toString();                                                         // src: vvaharness/skills/__init__.py:83
            synchronized (INJECT_LOCK) {                                                                    // src: vvaharness/skills/__init__.py:84
                injected.remove(key);                                                                       // src: vvaharness/skills/__init__.py:85
                Pair<Path, Boolean> copy = tempCopies.remove(key);                                          // src: vvaharness/skills/__init__.py:86
                if (copy != null) {                                                                         // src: vvaharness/skills/__init__.py:87
                    Files.rmtree(copy.first);                                                               // src: vvaharness/skills/__init__.py:89
                    if (!copy.second) {                                                                     // parent dir did not exist before injection
                        try { repo.resolve(INJECTED_SUBDIR.parent).rmdir(); } catch (OSError e) { }         // best effort, only if empty // src: vvaharness/skills/__init__.py:92
                    }
                }
            }
        }
    }

    /** Model side: the harness lists each skill's name + frontmatter description; the model reads a SKILL.md when its description fits. */
    @executedBy(MODEL)
    @src("vvaharness/pipeline/stages/s4/prompts.py:160")
    List<Finding> selectAndApply(Repo repo, Lens lens, Theta θ) {
        List<Finding> out = new List();
        for (String name : skillNames(θ)) {
            switch (name) {
                case "access-control":   out.addAll(AccessControlSkill.run(repo, lens, θ)); break;
                case "batch-etl":        out.addAll(BatchEtlSkill.run(repo, lens, θ)); break;
                case "crypto":           out.addAll(CryptoSkill.run(repo, lens, θ)); break;
                case "deserialization":  out.addAll(DeserializationSkill.run(repo, lens, θ)); break;
                case "injection":        out.addAll(InjectionSkill.run(repo, lens, θ)); break;
                case "log-injection":    out.addAll(LogInjectionSkill.run(repo, lens, θ)); break;
                case "logic-bug":        out.addAll(LogicBugSkill.run(repo, lens, θ)); break;
                case "sensitive-data":   out.addAll(SensitiveDataSkill.run(repo, lens, θ)); break;
                // applied after a confirmation, over the findings already made
                case "sibling-instances": out.addAll(SiblingInstancesSkill.run(repo, lens, out, θ)); break;
                // other packaged skills (code-exploration, client-side, csrf, hardcoded-creds, iac, missing-controls, ssrf, templates) live in their own files
                default: break;
            }
        }
        return out;
    }
}
