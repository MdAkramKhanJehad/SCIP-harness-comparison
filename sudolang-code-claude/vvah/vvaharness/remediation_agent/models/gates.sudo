// src: vvaharness/remediation_agent/models/gates.py:28-32 — default "fail" is conservative: an omitted gate still validates
Gates {
  source: EvidenceGateStatus = "fail"   // "Gate A — attacker-controlled source identified"
  sink: EvidenceGateStatus = "fail"   // "Gate B — security-relevant sink reachable from source"
  missing_control: EvidenceGateStatus = "fail"   // "Gate C — missing/insufficient validation"
}
// The gates are the model's self-report; the only code decision that reads them is the post-gate ACCEPT decision (all three must be "pass"); otherwise they are recorded in the case and summary
