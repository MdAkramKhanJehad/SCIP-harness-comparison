// file: vvaharness/backends/harness/deepagents/tool_budget.py
// ToolCallBudget middleware: caps how many times one session may call a named (metered) set of tools, refuses
// the over-budget call, then withdraws the tool family from the tool list with a one-time notice.

@executedBy(CODE) @role(rule_set)
class ToolBudget {

    Set<String> toolNames;
    int limit;
    String counter;
    int spent;
    boolean withdrawalAnnounced;

    // S4: graph tools limited by step4.graph_tool_budget, CweGuidance by step4.cwe_tool_budget (S4Session.budget)
    void init(Set<String> toolNames, int limit, String counter) {
        this.toolNames = toolNames;    // never meter every tool: the structured-output call is a tool call // src: vvaharness/backends/harness/deepagents/tool_budget.py:94
        this.limit = limit;                                                                              // src: vvaharness/backends/harness/deepagents/tool_budget.py:101
        this.counter = counter;
        this.spent = 0;
        this.withdrawalAnnounced = false;
    }

    boolean claim() {
        if (spent >= limit) return false;                                                                // src: vvaharness/backends/harness/deepagents/tool_budget.py:116
        spent += 1;
        return true;
    }

    // The refusal to return when the budget is gone, else null to proceed.
    ToolMessage gate(ToolCall toolCall, Theta θ) {
        if (!toolNames.contains(toolCall.name)) return null;                                             // src: vvaharness/backends/harness/deepagents/tool_budget.py:123
        if (claim()) {
            Counters.bump(callsCounterName(counter, toolCall.name));                                     // src: vvaharness/backends/harness/deepagents/tool_budget.py:126
            return null;
        }
        Counters.bump(counter);                                                                          // src: vvaharness/backends/harness/deepagents/tool_budget.py:128
        WarnOnce.warnOnce(WARNED_EXHAUSTED, counter, exhaustionWarning(counter, limit, toolNames));      // once per counter per run // src: vvaharness/backends/harness/deepagents/tool_budget.py:129
        return refuse(toolCall, ToolBudgetPrompts.budgetMessage(θ).text());                              // src: vvaharness/backends/harness/deepagents/tool_budget.py:131
    }

    // Once-per-(stage, family)-per-run WARN line for the first refusal on the counter. Names the scan-config knob the
    // operator would raise (display only): s2_graph_tool_budget_exhausted = step2.graph_tool_budget, s4 graph = step4.graph_tool_budget,
    // s4 cwe = step4.cwe_tool_budget, s6 graph = step6_verify.graph_tool_budget; an unlisted counter gets a generic phrase.
    String exhaustionWarning(String counter, int limit, Set<String> toolNames) {                         // src: vvaharness/backends/harness/deepagents/tool_budget.py:64
        String knob = KNOB_NAMES.get(counter, "its scan-config budget knob");                            // src: vvaharness/backends/harness/deepagents/tool_budget.py:66
        return "WARN: tool-call budget (" + knob + "=" + limit + " per session) exhausted for " + sorted(toolNames).join(", ") + "; further calls are refused and the tool family is withdrawn once the model calls again"; // src: vvaharness/backends/harness/deepagents/tool_budget.py:68
    }

    // A synthetic error ToolMessage explaining why a call was not executed.
    ToolMessage refuse(ToolCall toolCall, String content) {                                              // src: vvaharness/backends/harness/deepagents/tool_budget.py:77
        return new ToolMessage(content, toolCall.name, toolCall.id, "error");                            // src: vvaharness/backends/harness/deepagents/tool_budget.py:79
    }

    Set<String> exhaustedTools() {
        return spent >= limit ? toolNames : Set.of();                                                    // src: vvaharness/backends/harness/deepagents/tool_budget.py:136
    }

    // OUT-OF-LOOP form for non-langchain backends.
    String refusalFor(String toolName, Theta θ) {
        ToolMessage r = gate(new ToolCall(toolName, "out-of-loop"), θ);                                  // src: vvaharness/backends/harness/deepagents/tool_budget.py:141
        return r == null ? null : r.content;
    }

    ToolMessage wrapToolCall(ToolCallRequest request, Handler handler, Theta θ) {
        ToolMessage refusal = gate(request.toolCall, θ);                                                 // src: vvaharness/backends/harness/deepagents/tool_budget.py:150
        return refusal != null ? refusal : handler.call(request);
    }

    // Async counterpart of wrapToolCall.
    ToolMessage awrapToolCall(ToolCallRequest request, Handler handler, Theta θ) {
        ToolMessage refusal = gate(request.toolCall, θ);                                                 // src: vvaharness/backends/harness/deepagents/tool_budget.py:158
        return refusal != null ? refusal : await handler.call(request);                                  // src: vvaharness/backends/harness/deepagents/tool_budget.py:159
    }

    ModelRequest withdraw(ModelRequest request, Theta θ) {
        List<Tool> kept = request.tools.filter(t -> !toolNames.contains(t.name));                        // src: vvaharness/backends/harness/deepagents/tool_budget.py:163
        List<Message> messages = request.messages;
        if (!withdrawalAnnounced) {                                                                      // src: vvaharness/backends/harness/deepagents/tool_budget.py:166
            withdrawalAnnounced = true;
            messages = concat(messages, ToolBudgetPrompts.withdrawnNotice(toolNames, θ));                // src: vvaharness/backends/harness/deepagents/tool_budget.py:168
        }
        return request.override(kept, messages);                                                         // src: vvaharness/backends/harness/deepagents/tool_budget.py:169
    }

    ModelResponse wrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        if (!exhaustedTools().isEmpty()) request = withdraw(request, θ);                                 // src: vvaharness/backends/harness/deepagents/tool_budget.py:177
        return handler.call(request);
    }

    // Async counterpart of wrapModelCall: withdraw once the pool is spent, then the awaited handler.
    ModelResponse awrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        if (!exhaustedTools().isEmpty()) request = withdraw(request, θ);                                 // src: vvaharness/backends/harness/deepagents/tool_budget.py:188
        return await handler.call(request);                                                              // src: vvaharness/backends/harness/deepagents/tool_budget.py:190
    }
}

@executedBy(MODEL) @role(prompt)
class ToolBudgetPrompts {

    // Content of the error ToolMessage returned for a refused metered call.
    Prompt budgetMessage(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.tool_budget.budget_exhausted_message"]);           // "Your tool-call budget for this session is exhausted." // src: vvaharness/backends/harness/deepagents/tool_budget.py:38
        p.forbid(θ["p.tool_budget.finish_from_existing_evidence"]);    // no further metered call; finish from evidence // src: vvaharness/backends/harness/deepagents/tool_budget.py:39
        p.rule(θ["p.tool_budget.repeat_call_wastes_turn"]);            // it will not run and only spends a turn // src: vvaharness/backends/harness/deepagents/tool_budget.py:40
        return p;
    }

    // One-time turn appended when the family is removed from the tool list.
    Prompt withdrawnNotice(Set<String> toolNames, Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.tool_budget.withdrawn_notice"]);                   // "Your budget for <tools> is exhausted; ... withdrawn" // src: vvaharness/backends/harness/deepagents/tool_budget.py:86
        p.context(toolNames);
        p.forbid(θ["p.tool_budget.withdrawn_finish_without_asking"]);  // finish rather than asking for them again // src: vvaharness/backends/harness/deepagents/tool_budget.py:88
        return p;
    }
}
