  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Running a scan from Python, through the same entry point and trust gate as the CLI.\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\n\n_PROFILE_DIR = Path(__file__).resolve().parent.parent / \"config\" / \"profiles\"\n\n\nclass ScanOptionsError(ValueError):\n    \"\"\"Raised when scan options cannot be turned into a valid command line.\"\"\"\n\n\ndef profile_path(profile: str | Path) -> Path:\n    \"\"\"A shipped profile resolved by bare name, or an explicit path used as given.\"\"\"\n    candidate = Path(profile)\n    if candidate.suffix or candidate.parent != Path():\n        return candidate\n    shipped = _PROFILE_DIR / f\"{profile}.yaml\"\n    if not shipped.is_file():\n        available = sorted(p.stem for p in _PROFILE_DIR.glob(\"*.yaml\"))\n        raise ScanOptionsError(f\"no shipped profile {profile!r}; available: {available}\")\n    return shipped\n\n\n@dataclass(frozen=True)\nclass ScanOptions:\n    \"\"\"One scan's inputs; anything omitted keeps the CLI's own default for that flag.\"\"\"\n\n    repo: Path | str\n    profile: str | Path | None = None\n    stop_after: str | None = None\n    resume: bool = False\n    application_id: str | None = None\n    repo_name: str | None = None\n    extra_argv: tuple[str, ...] = field(default_factory=tuple)\n\n    def argv(self) -> list[str]:\n        \"\"\"This scan as a ``vvaharness scan`` argument list, for running and for reproducing.\"\"\"\n        argv = [\"--repo\", str(self.repo)]\n        if self.profile is not None:\n            argv += [\"--config\", str(profile_path(self.profile))]\n        for flag, value in ((\"--stop-after\", self.stop_after),\n                            (\"--application-id\", self.application_id),\n                            (\"--repo-name\", self.repo_name)):\n            if value:\n                argv += [flag, value]\n        resume = [\"--resume\"] if self.resume else []\n        return argv + resume + list(self.extra_argv)\n\n\n@dataclass(frozen=True)\nclass ScanResult:\n    \"\"\"A finished scan's outcome, plus the argv that produced it so a run is reproducible.\"\"\"\n\n    exit_code: int\n    argv: tuple[str, ...]\n\n    @property\n    def ok(self) -> bool:\n        \"\"\"True when the scan completed with no in-pipeline failure.\"\"\"\n        return self.exit_code == 0\n\n\ndef scan(options: ScanOptions) -> ScanResult:\n    \"\"\"Runs one scan through ``vvaharness scan``'s own entry point, returning its outcome.\"\"\"\n    from vvaharness.orchestrator import entry\n    argv = options.argv()\n    _reject_unknown_flags(argv)\n    return ScanResult(exit_code=entry.main(argv), argv=tuple(argv))\n\n\ndef _reject_unknown_flags(argv: list[str]) -> None:\n    \"\"\"Fails before any work when extra_argv carries a flag the CLI does not define.\"\"\"\n    from vvaharness.orchestrator import entry\n    try:\n        entry.build_parser().parse_args(argv)\n    except SystemExit as exc:\n        raise ScanOptionsError(f\"invalid scan options: {argv}\") from exc\n\n\n__all__ = [\"ScanOptions\", \"ScanOptionsError\", \"ScanResult\", \"profile_path\", \"scan\"]\n",
