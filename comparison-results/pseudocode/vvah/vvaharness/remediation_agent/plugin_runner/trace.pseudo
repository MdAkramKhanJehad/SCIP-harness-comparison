// file: vvaharness/remediation_agent/plugin_runner/trace.py
// --verbose stderr tracing helpers: redacted labelled blocks and the per-finding policy decision. Pure presentation.

@executedBy(CODE) @role(io) @stage("S10")
class Trace {

    void dump(String title, String body) {
        Console.write("+- " + title);                                                               // src: vvaharness/remediation_agent/plugin_runner/trace.py:26
        for (String line : Redact.redact(body != null ? body : "").splitlines()) Console.write("| " + line); // src: vvaharness/remediation_agent/plugin_runner/trace.py:27
        Console.write("+-");                                                                        // src: vvaharness/remediation_agent/plugin_runner/trace.py:29
    }

    void dumpPolicy(RemediationTarget target, PreResult pre) {
        Decision decision = pre.decision;                                                           // src: vvaharness/remediation_agent/plugin_runner/trace.py:34
        Console.write("POLICY finding " + target.index);                                            // src: vvaharness/remediation_agent/plugin_runner/trace.py:35
        Console.write("CWE: " + (pre.cwe != null ? pre.cwe : "(unknown)"));                         // src: vvaharness/remediation_agent/plugin_runner/trace.py:37
        Console.write("decision: " + decision.action + " (may_patch=" + decision.mayGeneratePatch + ")"); // src: vvaharness/remediation_agent/plugin_runner/trace.py:38
        Console.write("reason: " + Redact.redact(decision.reason));                                 // src: vvaharness/remediation_agent/plugin_runner/trace.py:40
        if (decision.matchedRule != null) Console.write("matched rule: " + Redact.redact(decision.matchedRule)); // src: vvaharness/remediation_agent/plugin_runner/trace.py:42
        if (pre.strategy != null) {                                                                 // src: vvaharness/remediation_agent/plugin_runner/trace.py:44
            Console.write("playbook strategy: " + pre.strategy.name + " confidence=" + pre.strategy.confidence + " fix_location=" + pre.strategy.fixLocation); // src: vvaharness/remediation_agent/plugin_runner/trace.py:45
        } else {
            Console.write("playbook strategy: (none resolved - guidance-only)");                    // src: vvaharness/remediation_agent/plugin_runner/trace.py:49
        }
        if (pre.strategy != null) dump("PLAYBOOK STRATEGY finding " + target.index, PlaybookStrategyBlock.asPromptBlock(pre.strategy)); // src: vvaharness/remediation_agent/plugin_runner/trace.py:52
    }
}
