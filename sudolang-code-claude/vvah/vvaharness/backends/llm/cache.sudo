# vvaharness/backends/llm/cache.py

Prompt-cache policy shared by the cli, sdk, openai and deepagents routes: which caching mechanism each route can use, the `cache_markers` kill switch, and reporting of cache accounting under key names the token counter does not parse.

Source: `vvaharness/backends/llm/cache.py` (lines 1-81)
Executor: code
Called from: `vvaharness/backends/llm/sdk.py`, `openai.py`, `deepagents.py`, `vvaharness/cli/_setup.py`; `cli/envelope.sudo` (`note_unparsed_cache_keys`)

// src: vvaharness/backends/llm/cache.py:25-34
Constants {
  CACHE_EST_MARGIN = 1.35   // margin on the token ESTIMATE (the estimator under-counts), not on the floor; consumed outside this batch
  _DISABLED_SPELLINGS = ("off", "false", "no", "0", "none")
  PREFIX_CACHE_BREAKPOINT = "breakpoint"; PREFIX_CACHE_IMPLICIT = "implicit"; PREFIX_CACHE_NONE = "none"
}

// src: vvaharness/backends/llm/cache.py:37-48
fn prefix_cache_class(via, model_id="", provider?):executor=code {
  return match (via) {
    case "sdk" => PREFIX_CACHE_BREAKPOINT
    case "openai" => PREFIX_CACHE_IMPLICIT
    case "deepagents" => if (routes_to_anthropic(model_id, provider)) PREFIX_CACHE_BREAKPOINT else PREFIX_CACHE_IMPLICIT
    default => PREFIX_CACHE_NONE   // includes "cli": no cache markers on that route
  }
}

// src: vvaharness/backends/llm/cache.py:51-56
fn markers_enabled(cfg):executor=code {
  v = cfg.get("cache_markers", "on")   // the caller passes its route section, so this reads knob("<route>.cache_markers", default="on")
  if (v is a boolean) return v   // unquoted YAML `off` parses as false
  return lowercased trimmed string(v) not in _DISABLED_SPELLINGS
}

// src: vvaharness/backends/llm/cache.py:59-81
ANTHROPIC_PARSED_CACHE_KEYS = { "cache_creation_input_tokens", "cache_read_input_tokens", "cache_creation" }   // cache_creation is the per-TTL breakdown of a total already carried
fn note_unparsed_cache_keys(usage, via):executor=code { report_unparsed_cache_keys(usage, ANTHROPIC_PARSED_CACHE_KEYS, via, label=via) }
fn report_unparsed_cache_keys(usage, parsed, via, label):executor=code {
  keys = unparsed_cache_keys(usage, parsed)   // external to this batch: util/tokens
  if (TOKENS.note_cache_unparsed exists && TOKENS.note_cache_unparsed(keys, via)) console "[<label>] note: usage reports cache accounting under unparsed key(s): <redacted names> — not included in cache_read/cache_write totals; counted in the cache_unparsed bucket"
  // without this, a working cache would read 0/0; key names only, never values
}
