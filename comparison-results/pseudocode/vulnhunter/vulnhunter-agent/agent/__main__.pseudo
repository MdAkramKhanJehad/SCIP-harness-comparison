// file: vulnhunter-agent/agent/__main__.py
// CLI entrypoint: --mode=scan clones a repo and runs /vulnhunt (ScanFlow in runner.pseudo);
// --mode=verify runs /vulnhunt-fix-verify against issue URLs (AgentVerify -> VerifyRunner).

@executedBy(CODE) @role(pipeline) @stage("agent")
class Main {

    int main(List<String> argv, Theta θ) {
        Args args = buildParser(θ).parse(argv);                                                  // src: vulnhunter-agent/agent/__main__.py:1221
        if (args.mode == null) return usageError("--mode is required; choose scan or verify");   // src: vulnhunter-agent/agent/__main__.py:1224
        if (args.mode == "scan") {                                                               // src: vulnhunter-agent/agent/__main__.py:1228
            if (args.targets.size() != 1) return usageError("--mode=scan takes exactly one repo URL"); // src: vulnhunter-agent/agent/__main__.py:1229
            if (args.commit != null || args.scratchDir != null || args.noPost || args.noReopen) return usageError("verify-mode only flag"); // src: vulnhunter-agent/agent/__main__.py:1237
            // --enable-bash and --no-read-only must be passed together, enforced only when the scan will run.
            if (args.scan != false) {                                                            // src: vulnhunter-agent/agent/__main__.py:1251
                boolean readOnly = (args.readOnly == null) ? θ["cli.read_only"] : args.readOnly; // src: vulnhunter-agent/agent/__main__.py:221
                if (args.enableBash && readOnly != false) return usageError("--enable-bash requires --no-read-only"); // src: vulnhunter-agent/agent/__main__.py:1252
                if (readOnly == false && !args.enableBash) return usageError("--no-read-only requires --enable-bash"); // src: vulnhunter-agent/agent/__main__.py:1259
            }
        } else {
            if (anyScanOnlyFlag(args)) return usageError("scan-mode only flags with --mode=verify"); // src: vulnhunter-agent/agent/__main__.py:1287
        }
        configureLogging(args.logLevel, args.verbose);                                           // src: vulnhunter-agent/agent/__main__.py:1293
        try {
            if (args.mode == "verify") return amainVerify(args, θ);                              // src: vulnhunter-agent/agent/__main__.py:1297
            return amain(args, θ);                                                               // src: vulnhunter-agent/agent/__main__.py:1298
        } catch (KeyboardInterrupt e) {
            return 130;                                                                          // src: vulnhunter-agent/agent/__main__.py:1301
        } catch (FileNotFoundError e) {
            return 64;                                                                           // src: vulnhunter-agent/agent/__main__.py:1307
        } catch (ValueError e) {
            return 64;                                                                           // src: vulnhunter-agent/agent/__main__.py:1312
        } catch (Exception e) {
            return 1;                                                                            // src: vulnhunter-agent/agent/__main__.py:1315
        }
    }

    // _build_parser: CLI surface. Stage toggles are tristate (None = take default/config).
    @src("vulnhunter-agent/agent/__main__.py:82")
    Parser buildParser(Theta θ) {
        Parser p = new Parser();
        p.add("--mode", List.of("scan", "verify"));                                              // src: vulnhunter-agent/agent/__main__.py:91
        p.add("targets", "+");                                                                   // src: vulnhunter-agent/agent/__main__.py:109
        p.add("--config"); p.add("--model");                                                     // src: vulnhunter-agent/agent/__main__.py:117
        p.add("--clone-dir"); p.add("--re-clone"); p.add("--scan-id");                           // src: vulnhunter-agent/agent/__main__.py:131
        p.addToggle("--scan", "--no-scan", θ["cli.stage_toggles"].scan);                         // src: vulnhunter-agent/agent/__main__.py:149
        p.addToggle("--publish", "--no-publish", θ["cli.stage_toggles"].publish);                // src: vulnhunter-agent/agent/__main__.py:165
        p.addToggle("--issues", "--no-issues", θ["cli.stage_toggles"].issues);                   // src: vulnhunter-agent/agent/__main__.py:181
        p.add("--issues-target-repo");                                                           // src: vulnhunter-agent/agent/__main__.py:196
        p.addToggle("--notify-clean-scan", "--no-notify-clean-scan", null);                      // src: vulnhunter-agent/agent/__main__.py:203
        p.addToggle("--read-only", "--no-read-only", θ["cli.read_only"]);                        // src: vulnhunter-agent/agent/__main__.py:221
        p.addFlag("--enable-bash", θ["cli.enable_bash"]);                                        // src: vulnhunter-agent/agent/__main__.py:238
        p.add("--commit"); p.add("--scratch-dir"); p.addFlag("--no-post"); p.addFlag("--no-reopen"); // src: vulnhunter-agent/agent/__main__.py:252
        p.addCount("-v"); p.add("--log-level");                                                  // src: vulnhunter-agent/agent/__main__.py:276
        p.addToggle("--audit", "--no-audit", null); p.add("--audit-events-path"); p.add("--audit-findings-path"); // src: vulnhunter-agent/agent/__main__.py:303
        p.addToggle("--audit-stdout", "--no-audit-stdout", null); p.add("--app-id"); p.add("--audit-actor"); // src: vulnhunter-agent/agent/__main__.py:328
        p.addRepeat("--repo-property");                                                          // src: vulnhunter-agent/agent/__main__.py:363
        return p;
    }

    // _resolve_modes: scan defaults on; publish and issues fall through to config when the flag is absent.
    boolean[] resolveModes(Args args, Theta θ) {
        boolean scan = (args.scan == null) ? θ["cli.stage_toggles"].scan : args.scan;            // src: vulnhunter-agent/agent/__main__.py:442
        boolean publish = (args.publish == null) ? θ["publish.enabled"] : args.publish;          // src: vulnhunter-agent/agent/__main__.py:443
        boolean issues = (args.issues == null) ? config.issues.enabled : args.issues;            // src: vulnhunter-agent/agent/__main__.py:447
        return new boolean[] (scan, publish, issues);
    }

    // _validate_modes: reject incoherent stage combinations and missing tokens before doing work.
    void validateModes(boolean scan, boolean publish, boolean issues, Theta θ) {
        if (!scan && !publish && !issues) throw new ValueError("Nothing to do");                 // src: vulnhunter-agent/agent/__main__.py:458
        if (scan && !publish && issues) throw new ValueError("--scan + --no-publish + --issues is incoherent"); // src: vulnhunter-agent/agent/__main__.py:463
        if (!scan && issues && θ["publish.*"].destinationRepo == "") throw new ValueError("needs publish.destination_repo"); // src: vulnhunter-agent/agent/__main__.py:469
        if (θ["github.*"].brokerTokenDir != "") return;                                          // src: vulnhunter-agent/agent/__main__.py:481
        if (issues && θ["github.*"].scanToken == "") throw new ValueError("--issues requires scan_token"); // src: vulnhunter-agent/agent/__main__.py:483
        if (publish && θ["github.*"].reportsToken == "") throw new ValueError("--publish requires reports_token"); // src: vulnhunter-agent/agent/__main__.py:488
        if (!scan && issues && θ["github.*"].reportsToken == "") throw new ValueError("--no-scan + --issues requires reports_token"); // src: vulnhunter-agent/agent/__main__.py:493
    }

    // _preflight_standalone_tokens: GET /installation/repositories once per role the enabled stages need.
    void preflightStandaloneTokens(Theta θ, boolean scan, boolean publish, boolean issues) {
        List<String> roles = new List();
        if (issues) roles.add("scan");                                                           // src: vulnhunter-agent/agent/__main__.py:515
        if (publish || (!scan && issues)) roles.add("reports");                                  // src: vulnhunter-agent/agent/__main__.py:517
        for (String role : roles) {                                                              // src: vulnhunter-agent/agent/__main__.py:560
            String token = TokenClient.getGithubToken(role, θ["github.*"]);
            if (token == "") throw new PreflightError(role);                                     // src: vulnhunter-agent/agent/__main__.py:562
            Response r = httpGet(θ["github.*"].host + "/installation/repositories", token, θ["tls.ssl_cert_path"], 30); // src: vulnhunter-agent/agent/__main__.py:577
            if ((r.status == 401 || r.status == 403) && !r.text.contains("authenticate with an installation access token")) throw new PreflightError(role); // src: vulnhunter-agent/agent/__main__.py:583
        }
    }

    // _amain: scan-mode entrypoint.
    int amain(Args args, Theta θ) {
        Config config = AgentConfig.loadConfig(args.config);                                     // src: vulnhunter-agent/agent/__main__.py:763
        config = applyAuditOverrides(config, args);                                              // src: vulnhunter-agent/agent/__main__.py:765
        config = applyIssuesOverrides(config, args);                                             // src: vulnhunter-agent/agent/__main__.py:766
        if (args.verbose >= 1) config.logging.perTurnUsage = true;                               // src: vulnhunter-agent/agent/__main__.py:771
        AuditWriter w = θ["audit.enabled"] ? Audit.writerFromConfig(config.audit) : null;        // src: vulnhunter-agent/agent/__main__.py:781
        try {
            return runScanFlow(args, θ, w);                                                      // src: vulnhunter-agent/agent/__main__.py:783
        } finally {
            if (w != null) w.close();
        }
    }

    // _run_scan_flow: rendered as ScanFlow.run in runner.pseudo (the agent L0).
    int runScanFlow(Args args, Theta θ, AuditWriter w) {
        return ScanFlow.run(args, θ, w);                                                         // src: vulnhunter-agent/agent/__main__.py:789
    }

    // _amain_verify: verify-mode entrypoint; AgentVerify.run drives VerifyRunner per issue.
    int amainVerify(Args args, Theta θ) {
        Config config = AgentConfig.loadConfig(args.config);                                     // src: vulnhunter-agent/agent/__main__.py:1095
        config = applyAuditOverrides(config, args);                                              // src: vulnhunter-agent/agent/__main__.py:1097
        AuditWriter w = θ["audit.enabled"] ? Audit.writerFromConfig(config.audit) : null;        // src: vulnhunter-agent/agent/__main__.py:1113
        RepoProperties props = (w != null) ? resolveRepoProperties(args, θ, issueUrlToRepoUrl(args.targets[0])) : new RepoProperties(); // src: vulnhunter-agent/agent/__main__.py:1121
        try {
            return AgentVerify.run(config, args.targets, args.commit, args.scratchDir, args.noPost, args.noReopen, args.model, w, props); // src: vulnhunter-agent/agent/__main__.py:1133
        } finally {
            if (w != null) w.close();
        }
    }

    Config applyAuditOverrides(Config config, Args args) {
        // CLI > env > TOML for [audit] fields (enabled, paths, stdout, app_id, actor)
        if (args.audit != null) config.audit.enabled = args.audit;                               // src: vulnhunter-agent/agent/__main__.py:670
        return config;
    }

    Config applyIssuesOverrides(Config config, Args args) {
        if (args.notifyCleanScan != null) config.issues.notifyCleanScan = args.notifyCleanScan;  // src: vulnhunter-agent/agent/__main__.py:695
        return config;
    }

    RepoProperties resolveRepoProperties(Args args, Theta θ, String repoUrl) {
        RepoProperties cli = cliRepoProperties(args);                                            // src: vulnhunter-agent/agent/__main__.py:741
        if (config.repoProperties.githubPropertyMap.isEmpty() || repoUrl == "") return RepoProperties.resolve(cli, null); // src: vulnhunter-agent/agent/__main__.py:744
        if (allMappedFieldsGiven(cli)) return cli;                                               // src: vulnhunter-agent/agent/__main__.py:749
        return RepoProperties.resolve(cli, RepoProperties.fetchFromGithub(repoUrl));             // src: vulnhunter-agent/agent/__main__.py:751
    }

    RepoProperties cliRepoProperties(Args args) {
        for (String raw : args.repoProperty) {                                                   // src: vulnhunter-agent/agent/__main__.py:712
            if (!raw.contains("=")) throw new ValueError("--repo-property must be NAME=VALUE");   // src: vulnhunter-agent/agent/__main__.py:713
        }
        return new RepoProperties(args.repoProperty);
    }

    String shortSha(Path cloneDir) {
        Proc out = subprocess("git", "rev-parse", "--short", "HEAD", cloneDir, 10);              // src: vulnhunter-agent/agent/__main__.py:412
        return (out.failed || out.stdout == "") ? "unknown" : out.stdout;                        // src: vulnhunter-agent/agent/__main__.py:430
    }

    AuditCtx auditContextForResults(Path resultsDir, Args args, boolean scan, AuditWriter w) {
        if (w == null || resultsDir == null) return null;                                        // src: vulnhunter-agent/agent/__main__.py:1181
        String reportId = Audit.reportIdFrom(resultsDir);                                        // src: vulnhunter-agent/agent/__main__.py:1183
        String slug = scan ? Runner.repoSlugFromUrl(Runner.gitContext(resultsDir.parent).repoUrl, resultsDir.parent.name)
                           : Runner.repoSlugFromUrl(Runner.normalizeRepoUrl(args.targets[0]), resultsDir.name); // src: vulnhunter-agent/agent/__main__.py:1199
        return new AuditCtx(reportId, slug);
    }

    String issueUrlToRepoUrl(String issueUrl) {
        for (String marker : List.of("/issues/", "/pull/", "/pulls/")) {                         // src: vulnhunter-agent/agent/__main__.py:1161
            if (issueUrl.indexOf(marker) > 0) return issueUrl.before(marker);
        }
        return issueUrl;
    }
}
