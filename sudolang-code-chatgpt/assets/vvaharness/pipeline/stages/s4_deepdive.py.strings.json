  "strings": [
    {
      "source": "vvaharness/pipeline/stages/s4_deepdive.py",
      "line_start": 15,
      "line_end": 15,
      "text": "Step 4 — deep-dive each unit in its own agentic session.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4_deepdive.py",
      "line_start": 45,
      "line_end": 45,
      "text": "Process every unit, returning ``(findings, outcomes)`` so a failed or blocked unit stays distinguishable from a clean one.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4_deepdive.py",
      "line_start": 366,
      "line_end": 366,
      "text": "Units per shared session.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4_deepdive.py",
      "line_start": 372,
      "line_end": 375,
      "text": "Submit one work item, returning a future that resolves to\n    ``(findings_by_unit, merged_by_unit, verdict_by_unit)`` — *verdict_by_unit* carries\n    \"uninvestigated\"/\"failed\" for a batch member the shared reply omitted or that didn't\n    parse, so the caller never mistakes that member for a clean \"completed\" unit.",
      "context": "literal string"
    },
    {
      "source": "vvaharness/pipeline/stages/s4_deepdive.py",
      "line_start": 402,
      "line_end": 402,
      "text": "Build the never-empty, cache-marked context prefix that is byte-identical for every unit of the scan.",
      "context": "literal string"
    },
