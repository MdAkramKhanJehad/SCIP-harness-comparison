# vvaharness/skills/missing-controls/probe.sh

Absent-control probe: enumerates every site a control belongs (routes, credential and cost endpoints, state-changing handlers, cookie writes, session config, sensitive storage) and every place each control is present, so absence can be argued site by site.

Source: `vvaharness/skills/missing-controls/probe.sh` (lines 1-163)
Executor: code (POSIX shell; read-only greps; nothing in the harness parses its output)
Called from: no harness code runs it. A model session may run it through a shell tool as `sh .vvaharness/skills/missing-controls/probe.sh [root]`, because the lens SKILL.md or the Stage 4 prompt suggests it. Whether it is run is the model's decision.

// abstracted: lines 5-17 are the Apache 2.0 license comment.
// Output is advisory text for the model; every section prints `path:line` hits, or "(none)". The script always ends with `exit 0`, so a failed grep never surfaces as an error.

// src: vvaharness/skills/missing-controls/probe.sh:19-163
probe(ROOT = $1 or "."):executor=code {
  // src: vvaharness/skills/missing-controls/probe.sh:19-92 — setup, the three helpers, ROUTE and SENSITIVE
  shell globbing off (set -f), so include globs reach grep literally
  CAP = MC_PROBE_CAP or 12   // line 21
  WIDTH = 140                // each printed hit is cut to 140 characters
  EX = exclude directories .git, node_modules, .venv, venv, .tox, dist, build, __pycache__, site-packages, .mypy_cache, target, .next, coverage, .vvaharness, security-scan; exclude files SKILL.md, probe.sh

  scan(label, includeGlobs, pattern) {
    // grep -rEn, case-sensitive
    if (no match) print "(none)"
    else { print first CAP hits cut to WIDTH; if (total > CAP) print "... <total> hits total, showing <CAP> - grep this pattern yourself for the rest" }
  }
  scan2(label, includeGlobs, sitePattern, keywordPattern) {
    // hits matching sitePattern (case-sensitive) AND keywordPattern (case-insensitive, grep -iE) on the same line; same capping as scan
    // the keyword filter runs over the whole "path:line:text" output line, so a keyword in the file path also matches
  }
  files(label, includeGlobs, pattern) {
    // file names only; at most 15 shown, then "... <n> files total, showing 15"
  }

  ROUTE = "@[a-zA-Z_.]*\.(route|get|post|put|patch|delete)\(|@(Get|Post|Put|Patch|Delete|Request)Mapping|(app|router|api|server)\.(get|post|put|patch|delete|all)\(|path\(|re_path\(|url\(|def (get|post|put|patch|delete)\(|\[Http(Get|Post|Put|Delete)\]"   // line 88
  SENSITIVE = "ssn|social_security|national_id|tax_id|passport|dob|date_of_birth|birth|card_number|cardnum|pan\b|cvv|cvc|iban|routing|account_number|salary|income|health|diagnosis|medical|insurance|address|phone|mobile|email|api_key|apikey|secret|token|password|passwd|pin\b|license"   // line 89

  // Cap changes by phase: CAP = 15 for SITES, 6 for CONTROLS, 12 for POSTURE HOLES (lines 94, 124, 149)
  // preserved: CAP is reassigned to 15 at line 94 before any section prints, so the MC_PROBE_CAP environment override read at line 21 never takes effect.

  // src: vvaharness/skills/missing-controls/probe.sh:95 — echo "--- SITES: enumerate these, then judge each ---"
  // src: vvaharness/skills/missing-controls/probe.sh:96 — echo ""
  // src: vvaharness/skills/missing-controls/probe.sh:98-98
  scan("ALL ROUTE/HANDLER SITES (total count is your enumeration denominator)")
  // pattern and arguments, verbatim: "" "$ROUTE"
  // src: vvaharness/skills/missing-controls/probe.sh:100-101
  scan2("CREDENTIAL AND COST ENDPOINTS (rate-limit sites)")
  // pattern and arguments, verbatim: "" "$ROUTE" 'login|signin|sign_in|logout|signout|register|signup|sign_up|password|reset|forgot|otp|mfa|2fa|verify|token|refresh|confirm|invite|upload|import|export|search|send|mail|sms|pay|charge|checkout|transfer|withdraw'
  // src: vvaharness/skills/missing-controls/probe.sh:103-104
  scan2("STATE-CHANGING HANDLERS (CSRF / authz enumeration sites)")
  // pattern and arguments, verbatim: "" "$ROUTE" 'post|put|patch|delete|create|update|edit|save|add|remove|transfer|change|reset'
  // src: vvaharness/skills/missing-controls/probe.sh:106-107
  scan("COOKIE WRITE SITES (one finding per write; config default does not cover these)")
  // pattern and arguments, verbatim: "" 'set_cookie|Set-Cookie|res\.cookie|response\.cookies|addCookie|new Cookie\(|HttpCookie|cookies\.set|\.cookie\s*='
  // src: vvaharness/skills/missing-controls/probe.sh:109-110
  scan("SESSION AND TOKEN CONFIG SITES")
  // pattern and arguments, verbatim: "" 'SESSION_COOKIE_[A-Z]+|CSRF_COOKIE_[A-Z]+|REMEMBER_COOKIE_[A-Z]+|PERMANENT_SESSION_LIFETIME|SESSION_COOKIE_AGE|SESSION_EXPIRE|session\.permanent|JWT_|jwt\.(encode|sign)|expires_delta|exp[\"'\'']?\s*[:=]|maxAge|max_age|SECRET_KEY|secret\s*[:=]'
  // src: vvaharness/skills/missing-controls/probe.sh:112-114
  scan2("STORAGE SITES HOLDING SENSITIVE FIELDS (cleartext-at-rest sites)")
  // pattern and arguments, verbatim: "" 'Column\(|db\.Column|models\.[A-Za-z]+Field\(|@Column|Schema\(|Field\(|CREATE TABLE|ALTER TABLE|ADD COLUMN|add_column|INSERT INTO' "$SENSITIVE"
  // src: vvaharness/skills/missing-controls/probe.sh:116-118
  files("SEED / FIXTURE / SAMPLE DATA FILES (synthetic only refutes if never seeded)")
  // pattern and arguments, verbatim:  "*seed* *fixture* *sample* *demo* *.sql *.csv" 'INSERT INTO|password|api_key|secret|ssn|card|token'
  // src: vvaharness/skills/missing-controls/probe.sh:120-122
  files("CONFIG AND DEPLOYMENT FILES PRESENT (open these for posture)")
  // pattern and arguments, verbatim:  "Dockerfile* docker-compose* *.yml *.yaml *.ini *.cfg *.toml *.env* Procfile *.tf settings*.py config*.py" 'DEBUG|debug|host|HOST|port|PORT|ENV|environment|image:|command:'
  // src: vvaharness/skills/missing-controls/probe.sh:124 — CAP=6
  // src: vvaharness/skills/missing-controls/probe.sh:125 — echo "--- CONTROLS: where each is actually present ---"
  // src: vvaharness/skills/missing-controls/probe.sh:126 — echo ""
  // src: vvaharness/skills/missing-controls/probe.sh:128-129
  scan("RATE LIMIT / ANTI-AUTOMATION PRESENT")
  // pattern and arguments, verbatim: "" 'limiter|Limiter|@ratelimit|ratelimit|RateLimit|rate_limit|throttle|Throttle|slowapi|express-rate-limit|Bucket4j|resilience4j|captcha|recaptcha|hcaptcha|turnstile|failed_(attempt|count|login)s?|login_attempt|LoginAttempt|lockout|locked_until|backoff'
  // src: vvaharness/skills/missing-controls/probe.sh:131-132
  scan("AUTH / AUTHZ GUARDS PRESENT")
  // pattern and arguments, verbatim: "" 'login_required|@login|jwt_required|token_required|auth_required|requires_auth|requireAuth|isAuthenticated|IsAuthenticated|permission_classes|has_permission|@PreAuthorize|@Secured|@RolesAllowed|before_request|Depends\(|middleware\.[Aa]uth|passport\.|ensureLoggedIn|current_user|\[Authorize\]'
  // src: vvaharness/skills/missing-controls/probe.sh:134-135
  scan("SESSION TERMINATION / REVOCATION PRESENT")
  // pattern and arguments, verbatim: "" 'session\.(clear|flush|pop|destroy|invalidate)|logout_user|destroy_session|invalidateSession|revoke|revocation|jti|token_version|password_changed_at|denylist|blocklist|blacklist|deleted_tokens|refresh_token_rotation'
  // src: vvaharness/skills/missing-controls/probe.sh:137-138
  scan("COOKIE FLAGS AND TRANSPORT SECURITY PRESENT")
  // pattern and arguments, verbatim: "" 'httponly|HttpOnly|[Ss]ecure\s*[:=]|samesite|SameSite|SECURE_SSL_REDIRECT|SECURE_HSTS|Strict-Transport-Security|HSTS|force_https|SESSION_COOKIE_SECURE|PREFERRED_URL_SCHEME'
  // src: vvaharness/skills/missing-controls/probe.sh:140-141
  scan("CSRF PROTECTION PRESENT")
  // pattern and arguments, verbatim: "" 'CSRFProtect|CsrfViewMiddleware|csrf_token|csrf_exempt|WTF_CSRF|csurf|csrf-token|X-CSRF|XSRF|AntiForgery|@csrf'
  // src: vvaharness/skills/missing-controls/probe.sh:143-144
  scan("SECURITY HEADERS PRESENT")
  // pattern and arguments, verbatim: "" 'Content-Security-Policy|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy|Talisman|helmet|frame_options|X-XSS-Protection'
  // src: vvaharness/skills/missing-controls/probe.sh:146-147
  scan("PASSWORD / FIELD ENCRYPTION PRIMITIVES PRESENT")
  // pattern and arguments, verbatim: "" 'bcrypt|argon2|pbkdf2|scrypt|generate_password_hash|check_password_hash|werkzeug\.security|passlib|PasswordEncoder|Fernet|AES|KMS|encrypt|EncryptedType|pgcrypto'
  // src: vvaharness/skills/missing-controls/probe.sh:149 — CAP=12
  // src: vvaharness/skills/missing-controls/probe.sh:150 — echo "--- POSTURE HOLES: these hits are usually findings on sight ---"
  // src: vvaharness/skills/missing-controls/probe.sh:151 — echo ""
  // src: vvaharness/skills/missing-controls/probe.sh:153-154
  scan("DEBUG / EXPOSURE POSTURE")
  // pattern and arguments, verbatim: "" 'debug\s*=\s*True|DEBUG\s*=\s*True|debug:\s*true|app\.run\(|ALLOWED_HOSTS\s*=|\*.{0,3}ALLOWED|host\s*=\s*.0\.0\.0\.0|--reload|FLASK_ENV|FLASK_DEBUG|NODE_ENV|display_errors|expose_php|printStackTrace|print_exc|traceback\.format_exc|autoreload|werkzeug'
  // src: vvaharness/skills/missing-controls/probe.sh:156-157
  scan("TLS VERIFICATION DISABLED")
  // pattern and arguments, verbatim: "" 'verify\s*=\s*False|verify_ssl\s*=\s*False|rejectUnauthorized\s*:\s*false|CURLOPT_SSL_VERIFY(PEER|HOST)\s*,\s*(0|false)|InsecureSkipVerify|_create_unverified|check_hostname\s*=\s*False|NODE_TLS_REJECT_UNAUTHORIZED|TrustAllCerts|ALLOW_ALL_HOSTNAME'
  // src: vvaharness/skills/missing-controls/probe.sh:159-160
  scan("WEAK HASH OR NO HASH ON CREDENTIALS")
  // pattern and arguments, verbatim: "" 'hashlib\.(md5|sha1)\(|MD5|SHA1|password\s*=\s*(request|req|\$_|body|data|params)|password\s*==\s*|plain_?password|raw_password'

  // src: vvaharness/skills/missing-controls/probe.sh:162-163
  print "### END MISSING-CONTROLS PROBE"; exit 0
}
