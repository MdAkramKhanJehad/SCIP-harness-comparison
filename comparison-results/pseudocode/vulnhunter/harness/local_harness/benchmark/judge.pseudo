// file: harness/local_harness/benchmark/judge.py
// LLM-as-judge for the local benchmark: one batched `claude -p` call per scan decides, for each
// ground-truth finding, whether the scanner's README.md report detected the same vulnerability.

@executedBy(CODE) @role(evaluation)
class BenchmarkJudge {

    String readResultsReport(String resultsDir) {
        String readme = resultsDir + "/README.md";
        if (!LocalHarnessScan.isRegularFile(readme)) return null;  // never follow a planted symlink  // src: harness/local_harness/benchmark/judge.py:53
        return Fs.open(readme, O_RDONLY | O_NOFOLLOW).read();                                  // src: harness/local_harness/benchmark/judge.py:55
    }

    @executedBy(MIXED)
    List<Judgment> judgeFindingsBatch(String resultsReport, List<Finding> findings, String model, Theta θ) {
        if (model == null) model = θ["harness.MODEL"];                                         // src: harness/local_harness/benchmark/judge.py:71
        Prompt system = JudgePrompts.system(θ);
        Prompt user = JudgePrompts.user(resultsReport, findings, θ);
        double backoff = 30;  // JUDGE_RETRY_INITIAL_BACKOFF literal                            // src: harness/local_harness/benchmark/judge.py:92
        for (int attempt = 0; attempt <= θ["harness.JUDGE_MAX_RETRIES"]; attempt++) {          // src: harness/local_harness/benchmark/judge.py:94
            Response r = Runtime.llm(new ModelSpec(model, "claude-cli", "anthropic", null, 0), system, user, null); // src: harness/local_harness/benchmark/judge.py:96
            if (r.timedOut(θ["harness.JUDGE_TIMEOUT"])) return errorAll(findings, "judge timed out"); // src: harness/local_harness/benchmark/judge.py:101
            if (r.returncode != 0 && isJudgeRateLimited(r)) {                                  // src: harness/local_harness/benchmark/judge.py:108
                if (attempt < θ["harness.JUDGE_MAX_RETRIES"]) {
                    Clock.sleep(backoff);
                    backoff = Math.min(backoff * 2.0, 180);  // multiplier / max literals      // src: harness/local_harness/benchmark/judge.py:113
                    continue;
                }
                return errorAll(findings, "judge failed: 429 rate limit (retries exhausted)"); // src: harness/local_harness/benchmark/judge.py:115
            }
            if (r.returncode != 0) return errorAll(findings, "judge failed: " + r.stderr.take(200)); // src: harness/local_harness/benchmark/judge.py:120
            return parseJudgeOutput(r.stdout, findings, θ);                                    // src: harness/local_harness/benchmark/judge.py:126
        }
        return null;
    }

    boolean isJudgeRateLimited(Response r) {
        String c = r.stderr + r.stdout;
        return c.contains("429") && (c.contains("rate_limit") || c.toLowerCase().contains("rate limit")); // src: harness/local_harness/benchmark/judge.py:132
    }

    List<Judgment> parseJudgeOutput(String raw, List<Finding> findings, Theta θ) {
        String text = raw.trim();
        int s = text.indexOf("["), e = text.lastIndexOf("]");                                  // src: harness/local_harness/benchmark/judge.py:140
        if (s != -1 && e != -1) text = text.substring(s, e + 1);
        Object j = Json.tryParse(text);
        if (j instanceof List) return j;  // fields per p.judge.output_fields; not validated     // src: harness/local_harness/benchmark/judge.py:147
        return errorAll(findings, "failed to parse judge output");                             // src: harness/local_harness/benchmark/judge.py:153
    }

    List<Judgment> errorAll(List<Finding> findings, String reason) {
        return findings.map(f -> new Judgment(f.findingId, null, null, reason, null));
    }
}

@executedBy(MODEL) @role(prompt)
class JudgePrompts {

    Prompt system(Theta θ) {
        Prompt p = new Prompt();
        p.persona(θ["p.judge.judge_persona"]);                                                 // src: harness/local_harness/benchmark/judge.py:18
        p.context(θ["p.judge.judge_inputs"]);                                                  // src: harness/local_harness/benchmark/judge.py:21
        if (θ["p.judge.per_finding_same_vulnerability"]) p.must("for EACH benchmark finding, determine if the scanner detected the SAME vulnerability"); // src: harness/local_harness/benchmark/judge.py:24
        if (θ["p.judge.terminology_tolerance"]) p.rule("different terminology/IDs/detail level are fine; what matters is the same security issue"); // src: harness/local_harness/benchmark/judge.py:25
        p.rule(θ["harness.judge_match_rule"]);                                                 // src: harness/local_harness/benchmark/judge.py:27
        p.must(θ["p.judge.all_criteria_required"] + " criteria must be true for detected");    // src: harness/local_harness/benchmark/judge.py:27
        if (θ["p.judge.criterion_same_class_or_upstream"]) p.checklist("same vulnerability CLASS, or an earlier finding in the same data flow whose fix also prevents it"); // src: harness/local_harness/benchmark/judge.py:28
        if (θ["p.judge.shallower_classification_counts"]) p.exemption("same root-cause fix -> a shallower classification still counts"); // src: harness/local_harness/benchmark/judge.py:32
        if (θ["p.judge.criterion_same_location"]) p.checklist("same LOCATION (same file or closely related files in same component)"); // src: harness/local_harness/benchmark/judge.py:33
        if (θ["p.judge.criterion_same_root_cause"]) p.checklist("same ROOT CAUSE");           // src: harness/local_harness/benchmark/judge.py:34
        if (θ["p.judge.not_required_same_id"]) p.exemption("same finding ID not required");    // src: harness/local_harness/benchmark/judge.py:37
        if (θ["p.judge.not_required_identical_description"]) p.exemption("word-for-word description not required"); // src: harness/local_harness/benchmark/judge.py:38
        if (θ["p.judge.not_required_exact_details"]) p.exemption("every detail need not match; line numbers may differ slightly"); // src: harness/local_harness/benchmark/judge.py:39
        if (θ["p.judge.not_required_same_severity"]) p.exemption("severity need not match");   // src: harness/local_harness/benchmark/judge.py:40
        if (θ["p.judge.duplicate_or_subset_counts"]) p.rule("a duplicate/subset of another detected finding counts as detected"); // src: harness/local_harness/benchmark/judge.py:42
        if (θ["p.judge.output_json_array_only"]) p.format("output ONLY a valid JSON array, one object per benchmark finding"); // src: harness/local_harness/benchmark/judge.py:44
        p.format(θ["p.judge.output_fields"]);                                                  // src: harness/local_harness/benchmark/judge.py:45
        p.choose(θ["p.judge.confidence_levels"]);                                              // src: harness/local_harness/benchmark/judge.py:45
        p.format(θ["p.judge.reasoning_length"]);                                               // src: harness/local_harness/benchmark/judge.py:45
        return p;
    }

    Prompt user(String report, List<Finding> findings, Theta θ) {
        Prompt p = new Prompt();
        List<String> sections = θ["p.judge.user_prompt_sections"];                            // src: harness/local_harness/benchmark/judge.py:84
        p.context("## " + sections.get(0) + " " + report);                                    // src: harness/local_harness/benchmark/judge.py:78
        for (Finding f : findings) {
            p.context("### Benchmark Finding: " + f.pick(θ["p.judge.benchmark_finding_format"])); // src: harness/local_harness/benchmark/judge.py:74
        }
        if (θ["p.judge.user_prompt_closing_instruction"]) p.must("For EACH benchmark finding above, determine if the scanner detected it. Respond with ONLY a JSON array."); // src: harness/local_harness/benchmark/judge.py:90
        return p;
    }
}

@executedBy(CODE) @role(types)
record Judgment(String findingId, Boolean detected, String confidence, String reasoning, String matchedFindingId) { }
