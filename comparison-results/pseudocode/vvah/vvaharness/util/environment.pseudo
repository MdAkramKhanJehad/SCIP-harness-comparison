// file: vvaharness/util/environment.py
// Environment readiness engine shared by `vvaharness setup` and `vvaharness doctor`: interpreter, tools,
// agents, deps, credentials (presence only), tracing egress, TLS trust, config/backends. Preflight and scan
// reuse backendCredentialOk / gatewayCheck. A required FAIL blocks setup/doctor, not `scan`.

@executedBy(CODE) @role(types)
enum CheckStatus { OK, WARN, FAIL }

@executedBy(CODE) @role(types)
record Check(String name, CheckStatus status, String detail, boolean required) { }

@executedBy(CODE) @role(config)
class Environment {

    // (display, command, env keys, backend it maps to)
    static final List<Agent> AGENTS = θ["code.util.environment.agents"]; // src: vvaharness/util/environment.py:106
    static final List<Pair<String, Boolean>> DEPS = θ["code.util.environment.deps"]; // (module, required) // src: vvaharness/util/environment.py:158
    static final List<String> SDK_VENDOR_PARTS = List.of("vendor", "context_graph_sdk", "src", "context_graph_sdk"); // src: vvaharness/util/environment.py:200
    static final List<String> CRED_ENVS = θ["code.util.environment.cred_envs"];                   // presence only // src: vvaharness/util/environment.py:289
    static final List<List<String>> TRACING_GATE_ENVS = θ["code.util.environment.tracing_gate_envs"]; // src: vvaharness/util/environment.py:305
    static final List<String> TRACING_KEY_ENVS = θ["code.util.environment.tracing_key_envs"]; // src: vvaharness/util/environment.py:310
    static final List<String> RC_FILES = θ["code.util.environment.rc_files"]; // src: vvaharness/util/environment.py:371
    static final int TLS_HANDSHAKE_TIMEOUT_S = 8;                              // doctor-only probe // src: vvaharness/util/environment.py:759

    boolean isSet(String env) {
        return env(env) != null && !env(env).isEmpty();                        // src: vvaharness/util/environment.py:61
    }

    boolean looksLikeJwt(String v, Theta θ) {
        if (v == null || v.isEmpty()) return false;                            // src: vvaharness/util/environment.py:66
        if (v.startsWith(θ["code.util.environment.jwt_key_prefix"])) return true; // gateway/Claude-Code token shape, not sk-ant- // src: vvaharness/util/environment.py:68
        List<String> parts = v.split(".");
        if (parts.size() == 3 && v.startsWith("ey")) return parts.all(p -> !p.isEmpty()); // opaque JWT-like session token // src: vvaharness/util/environment.py:72
        return false;
    }

    Check pythonCheck() {
        Pair<Integer, Integer> floor = Pair.of(3, 10);                         // source-tree fallback // src: vvaharness/util/environment.py:80
        try {
            Match m = Regex.search(">=\\s*(\\d+)\\.(\\d+)", packageMetadata("vvaharness").requiresPython); // src: vvaharness/util/environment.py:85
            if (m != null) floor = Pair.of(m.group(1), m.group(2));
        } catch (Exception e) { }
        if (pythonVersion() >= floor) return new Check("Python", OK, "ok", false); // src: vvaharness/util/environment.py:91
        return new Check("Python", FAIL, "requires newer Python", true);       // src: vvaharness/util/environment.py:93
    }

    Check toolCheck(String cmd, String why, boolean required) {
        String path = which(cmd);                                              // src: vvaharness/util/environment.py:98
        if (path != null) return new Check(cmd, OK, path, false);
        return new Check(cmd, required ? FAIL : WARN, "not on PATH (" + why + ")", required); // src: vvaharness/util/environment.py:101
    }

    boolean claudeCodeLoginPresent() {
        // false negative by design: Keychain-only OAuth is invisible; never a gate
        if (home().resolve(".claude/.credentials.json").exists()) return true; // src: vvaharness/util/environment.py:119
        Path state = home().resolve(".claude.json");
        if (!state.exists()) return false;                                     // src: vvaharness/util/environment.py:122
        try { return Json.parse(state.readText()).get("oauthAccount") != null; } // src: vvaharness/util/environment.py:129
        catch (Exception e) { return false; }
    }

    List<Check> agentChecks() {
        List<Check> out = List.of();
        boolean oauth = claudeCodeLoginPresent();                              // src: vvaharness/util/environment.py:135
        for (Agent a : AGENTS) {                                               // src: vvaharness/util/environment.py:136
            if (which(a.cmd) == null) { out.add(new Check("agent: " + a.display, WARN, "not installed", false)); continue; } // src: vvaharness/util/environment.py:138
            boolean hasAuth = a.keys.isEmpty() || a.keys.any(k -> isSet(k)) || (a.cmd == "claude" && oauth); // src: vvaharness/util/environment.py:141
            out.add(new Check("agent: " + a.display, hasAuth ? OK : WARN, hasAuth ? "installed and logged in" : "installed; login not detected", false)); // src: vvaharness/util/environment.py:151
        }
        return out;
    }

    List<Check> depChecks() {
        List<Check> out = List.of();
        for (Pair<String, Boolean> d : DEPS) {                                 // src: vvaharness/util/environment.py:170
            boolean present = findSpec(d.first) != null;
            if (present) out.add(new Check("dep: " + d.first, OK, "importable", false));         // src: vvaharness/util/environment.py:177
            else if (d.second) out.add(new Check("dep: " + d.first, FAIL, "missing", true));      // src: vvaharness/util/environment.py:179
            else if (d.first == "tree_sitter") out.add(new Check("dep: tree-sitter", WARN, "NOT INSTALLED — call graph falls back to regex (degraded taint coverage)", false)); // src: vvaharness/util/environment.py:181
            else if (d.first == "tree_sitter_language_pack") out.add(new Check("dep: tree-sitter-language-pack", WARN, "NOT INSTALLED — AST plugins unavailable; call graph degrades", false)); // src: vvaharness/util/environment.py:187
            else out.add(new Check("dep: " + d.first, WARN, "missing (optional — needed only for via:openai)", false)); // src: vvaharness/util/environment.py:193
        }
        out.add(graphSdkCheck());                                              // src: vvaharness/util/environment.py:196
        return out;
    }

    Path moduleDir(String name) {
        try { Spec spec = findSpec(name); return spec != null && spec.origin != null ? Path.of(spec.origin).resolve().parent : null; } // src: vvaharness/util/environment.py:206
        catch (ImportError | ValueError e) { return null; }
    }

    String separatelyInstalledSdk() {
        try { return packageVersion("context-graph-sdk"); }                    // src: vvaharness/util/environment.py:216
        catch (PackageNotFoundError e) { return ""; }                          // correctly bundled
    }

    Check graphSdkCheck() {
        Path sdk = moduleDir("context_graph_sdk");
        if (sdk == null) return new Check("dep: context-graph-sdk", FAIL, "not importable — S0/S1 cannot build the code graph", true); // src: vvaharness/util/environment.py:224
        String stray = separatelyInstalledSdk();
        if (!stray.isEmpty()) return new Check("dep: context-graph-sdk", FAIL, "a standalone context-graph-sdk shadows the bundled copy and fails S0/S1", true); // src: vvaharness/util/environment.py:228
        Path own = moduleDir("vvaharness");
        if (own == null || sdk.parent == own.parent || sdk == own.parent.resolve(SDK_VENDOR_PARTS)) return new Check("dep: context-graph-sdk", OK, "bundled", false); // src: vvaharness/util/environment.py:235
        return new Check("dep: context-graph-sdk", FAIL, "SHADOWED by an external install; fails S0/S1 with SnapshotLifecycleError", true); // src: vvaharness/util/environment.py:237
    }

    List<Integer> release(String version) {
        String core = version.split("!").last().split("+")[0];                 // not full PEP 440 // src: vvaharness/util/environment.py:249
        return Regex.findall("\\d+", core).map(Integer::parse);
    }

    Check anthropicVersionCheck() {
        String installed;
        try { installed = packageVersion("anthropic"); }                       // src: vvaharness/util/environment.py:260
        catch (PackageNotFoundError e) { return new Check("anthropic version", OK, "no version metadata found (see dep: anthropic)", false); } // src: vvaharness/util/environment.py:263
        List<String> reqs;
        try { reqs = packageRequires("vvaharness"); } catch (PackageNotFoundError e) { reqs = List.of(); } // src: vvaharness/util/environment.py:266
        String spec = reqs.firstOr(r -> Regex.match("anthropic\\s*[\\[<>=!~]", r), "");  // src: vvaharness/util/environment.py:270
        Match ceiling = Regex.search("<\\s*(\\d[^,\\s]*)", spec);              // upper bound, any clause order // src: vvaharness/util/environment.py:272
        if (ceiling == null) return new Check("anthropic version", OK, installed + " (no declared ceiling)", false); // src: vvaharness/util/environment.py:273
        if (release(installed) < release(ceiling.group(1))) return new Check("anthropic version", OK, installed + " (supported)", false); // src: vvaharness/util/environment.py:276
        return new Check("anthropic version", FAIL, installed + " is out of the supported range", true); // src: vvaharness/util/environment.py:279
    }

    List<Check> credentialChecks() {
        return CRED_ENVS.map(e -> new Check("cred: " + e, isSet(e) ? OK : WARN, isSet(e) ? "set" : "unset", false)); // never the value // src: vvaharness/util/environment.py:298
    }

    String langsmithTracingGate() {
        for (List<String> group : TRACING_GATE_ENVS)                           // earliest set var wins // src: vvaharness/util/environment.py:316
            for (String name : group) {
                String v = env(name);
                if (v != null && !v.strip().isEmpty()) return v == "true" ? name : null; // only exact "true" enables // src: vvaharness/util/environment.py:319
            }
        return null;
    }

    Check langsmithTracingCheck() {
        String gate = langsmithTracingGate();                                  // src: vvaharness/util/environment.py:328
        if (gate == null) return new Check("LangSmith tracing", OK, "disabled", false); // src: vvaharness/util/environment.py:329
        if (findSpec("langsmith") == null) return new Check("LangSmith tracing", OK, "gate set but langsmith not installed — no tracing", false); // src: vvaharness/util/environment.py:333
        String key = TRACING_KEY_ENVS.firstOr(k -> isSet(k), null);            // src: vvaharness/util/environment.py:337
        return new Check("LangSmith tracing", WARN, "every prompt (repo source included) and completion goes to LangSmith" + (key != null ? "; upload accepted" : "; upload rejected but still transmitted"), false); // WARN, never FAIL // src: vvaharness/util/environment.py:343
    }

    Check gatewayCheck(Theta θ) {
        String base = env("ANTHROPIC_BASE_URL"); String key = env("ANTHROPIC_API_KEY"); // src: vvaharness/util/environment.py:354
        if (base != null && !base.isEmpty()) return new Check("via:sdk endpoint", OK, "ANTHROPIC_BASE_URL=" + base.split("?", 1)[0], false); // query string stripped // src: vvaharness/util/environment.py:356
        if (looksLikeJwt(key, θ)) return new Check("via:sdk endpoint", FAIL, "ANTHROPIC_API_KEY looks like a gateway token but ANTHROPIC_BASE_URL is unset — it will 401", true); // src: vvaharness/util/environment.py:360
        return new Check("via:sdk endpoint", OK, "public api.anthropic.com (default)", false); // src: vvaharness/util/environment.py:368
    }

    Pair<String, String> detectGateway() {
        String live = env("ANTHROPIC_BASE_URL");
        if (live != null && !live.isEmpty()) return Pair.of(live, "environment"); // src: vvaharness/util/environment.py:379
        Regex rx = Regex.of("ANTHROPIC_BASE_URL\\s*=\\s*[\"']?(https?://[^\"'\\s]+)"); // src: vvaharness/util/environment.py:381
        for (String name : RC_FILES) {                                         // read only, never writes // src: vvaharness/util/environment.py:382
            Path p = home().resolve(name);
            if (!p.isFile()) continue;
            try { for (String line : p.readLines()) { Match m = rx.search(line); if (m != null) return Pair.of(m.group(1), "~/" + name); } } // commented lines match too // src: vvaharness/util/environment.py:387
            catch (OSError e) { continue; }
        }
        return Pair.of(null, null);
    }

    String detectCaCert() {
        String envCert = env("NODE_EXTRA_CA_CERTS");
        if (envCert != null && Path.of(envCert).isFile()) return envCert;      // src: vvaharness/util/environment.py:400
        Path dflt = home().resolve("cacerts.pem");
        return dflt.isFile() ? str(dflt) : null;                               // src: vvaharness/util/environment.py:403
    }

    Pair<String, String> recommendProfile(Theta θ) {
        boolean cliAuth = which("claude") != null && (looksLikeJwt(env("ANTHROPIC_API_KEY"), θ) || isSet("ANTHROPIC_AUTH_TOKEN") || isSet("CLAUDE_CODE_OAUTH_TOKEN") || claudeCodeLoginPresent()); // src: vvaharness/util/environment.py:409
        if (cliAuth && isSet("ANTHROPIC_SDK_API_KEY")) return Pair.of("default", "Claude Code auth and SDK key present"); // src: vvaharness/util/environment.py:414
        if (cliAuth) return Pair.of("default", "Claude Code auth detected");    // src: vvaharness/util/environment.py:419
        if (isSet("ANTHROPIC_SDK_API_KEY")) return Pair.of("sdk", "ANTHROPIC_SDK_API_KEY is set"); // src: vvaharness/util/environment.py:424
        if (isSet("OPENAI_API_KEY")) return Pair.of("full", "OPENAI_API_KEY is set"); // src: vvaharness/util/environment.py:427
        return Pair.of(null, "no usable credential detected yet");             // src: vvaharness/util/environment.py:430
    }

    Check dotenvCheck() {
        DotenvSelection sel = dotenvSelection();                               // vvaharness.cli._dotenv_selection // src: vvaharness/util/environment.py:437
        if (sel.path == null) {
            if (!sel.rejected.isEmpty()) return new Check(".env", WARN, "ignored untrusted file(s)", false); // src: vvaharness/util/environment.py:440
            return new Check(".env", OK, "not found (optional)", false);
        }
        if (!sel.rejected.isEmpty()) return new Check(".env", WARN, "found; ignored untrusted file(s)", false); // src: vvaharness/util/environment.py:444
        return new Check(".env", OK, ".env found", false);
    }

    Check appliedOverlayCheck(String name, Path local, Path cfgPath) {
        Object over; Config cfg;
        try { over = Yaml.safeLoad(local.readText()); cfg = Config.load(cfgPath); } // src: vvaharness/util/environment.py:452
        catch (OSError | ValueError | YAMLError e) { return new Check(name, FAIL, "failed to load", true); } // src: vvaharness/util/environment.py:455
        if (!(over instanceof Map)) return new Check(name, FAIL, "must be a YAML mapping", true); // src: vvaharness/util/environment.py:456
        return new Check(name, OK, "applied (overrides: " + overlayOverrideEntries(leafPaths(over), cfg) + ")", false); // src: vvaharness/util/environment.py:458
    }

    Check overlayCheck(Path cfgPath, Theta θ) {
        Path local = cfgPath.withName("config.local.yaml");                    // LOCAL_OVERLAY_NAME // src: vvaharness/util/environment.py:466
        if (!local.exists()) return new Check("config overlay", OK, "not found (optional)", false); // src: vvaharness/util/environment.py:467
        if (θ["env.VVAHARNESS_NO_LOCAL_CONFIG"] != null) return new Check("config overlay", OK, "present but skipped", false); // src: vvaharness/util/environment.py:469
        if (hasGeteuid() && !localOverlayTrusted(local)) return new Check("config overlay", FAIL, "untrusted — must be user-owned and not group/world-writable", true); // src: vvaharness/util/environment.py:472
        return appliedOverlayCheck("config overlay", local, cfgPath);          // src: vvaharness/util/environment.py:481
    }

    Check viaGapCheck(String name, String gap, Set<String> roles, String hint) {
        // mirrors preflight: a gap touching a detection role FAILs; post-scan S10/S11 only is advisory
        if (!POST_SCAN_ROLES.containsAll(roles)) return new Check(name, FAIL, gap + " (required by this profile)" + hint, true); // src: vvaharness/util/environment.py:489
        return new Check(name, WARN, gap + " (that stage will be skipped)", false); // src: vvaharness/util/environment.py:492
    }

    List<Check> configCheck(Path cfgPath, Theta θ) {
        if (!cfgPath.exists()) return List.of(new Check("config", FAIL, "not found", true)); // src: vvaharness/util/environment.py:500
        Config cfg;
        try { cfg = Config.load(cfgPath); }                                    // src: vvaharness/util/environment.py:504
        catch (Exception e) { return List.of(new Check("config", FAIL, "failed to load", true)); } // src: vvaharness/util/environment.py:506
        List<Check> out = List.of(new Check("config", OK, "loads", false));    // src: vvaharness/util/environment.py:515
        Map<String, Node> nodes = ConfigPaths.iterModelRoles(cfg, θ);          // never a hand-rolled walk // src: vvaharness/util/environment.py:517
        Map<String, Set<String>> rolesByVia = groupBy(nodes, n -> n.via != null ? n.via : "cli"); // src: vvaharness/util/environment.py:519
        Set<String> vias = rolesByVia.keys();
        out.add(new Check("active backends", OK, sorted(vias).join(", "), false)); // src: vvaharness/util/environment.py:522
        List<String> invalidDeepagents = nodes.filter((r, n) -> n.via == "deepagents" && !DEEPAGENTS_ROLES.contains(r)).keys(); // src: vvaharness/util/environment.py:523
        if (!invalidDeepagents.isEmpty()) out.add(new Check("via:deepagents roles", FAIL, "invalid role(s)", true)); // src: vvaharness/util/environment.py:528
        List<String> unknownKeys = nodes.flatMap((r, n) -> unrecognizedModelKeys(n));  // backends.llm.registry // src: vvaharness/util/environment.py:539
        if (!unknownKeys.isEmpty()) out.add(new Check("model config keys", WARN, "unrecognized model key(s) ignored", false)); // never fatal // src: vvaharness/util/environment.py:544
        if (vias.contains("sdk")) {                                            // src: vvaharness/util/environment.py:550
            out.add(gatewayCheck(θ));
            boolean hasSdkKey = isSet("ANTHROPIC_SDK_API_KEY") || cfg.sdk.apiKey != null; // src: vvaharness/util/environment.py:553
            boolean sdkSole = Set.of("sdk", "deepagents").containsAll(vias);  // same predicate as preflight // src: vvaharness/util/environment.py:556
            boolean fallback = sdkSole && (isSet("ANTHROPIC_API_KEY") || isSet("ANTHROPIC_AUTH_TOKEN")); // src: vvaharness/util/environment.py:557
            if (hasSdkKey) { }                                                 // nothing to flag // src: vvaharness/util/environment.py:559
            else if (fallback) out.add(new Check("via:sdk credential", OK, "using ANTHROPIC_API_KEY/AUTH_TOKEN fallback", false)); // src: vvaharness/util/environment.py:561
            else out.add(viaGapCheck("via:sdk credential", "ANTHROPIC_SDK_API_KEY not set", rolesByVia.get("sdk"), sdkSole ? " — or set ANTHROPIC_API_KEY" : "")); // src: vvaharness/util/environment.py:569
            for (String envName : List.of("ANTHROPIC_SDK_BASE_URL", "ANTHROPIC_SDK_CA_CERT", "ANTHROPIC_SDK_CLIENT_CERT")) // optional levers, never blocking // src: vvaharness/util/environment.py:573
                out.add(new Check("via:sdk " + envName, isSet(envName) ? OK : WARN, isSet(envName) ? "set" : "unset (optional)", false));
        }
        if (vias.contains("openai") && !isSet("OPENAI_API_KEY")) out.add(viaGapCheck("via:openai credential", "OPENAI_API_KEY not set", rolesByVia.get("openai"), "")); // src: vvaharness/util/environment.py:584
        if (vias.contains("cli") && which("claude") == null) out.add(viaGapCheck("via:cli backend", "`claude` CLI not on PATH", rolesByVia.get("cli"), "")); // src: vvaharness/util/environment.py:588
        out.addAll(deepagentsChecks(nodes, cfg, vias.contains("sdk"), θ));    // src: vvaharness/util/environment.py:592
        out.addAll(remediateChecks(cfg, θ));                                   // s10/s11 never block: WARN // src: vvaharness/util/environment.py:594
        out.addAll(validateChecks(cfg, θ));
        return out;
    }

    Check remediationInputsCheck() {
        List<String> missing = RulePaths.missingRules(rulePathsFile);          // src: vvaharness/util/environment.py:602
        String configured = RulePaths.configuredInputsDir();
        if (missing.isEmpty()) return new Check("remediation inputs", OK, configured != null ? "using " + configured : "bundled policy and playbook available", false); // src: vvaharness/util/environment.py:604
        return new Check("remediation inputs", FAIL, "missing " + missing.join(", "), true); // fail-closed // src: vvaharness/util/environment.py:608
    }

    Pair<Boolean, String> backendCredentialOk(String via, String modelId, String provider, Config cfg, Theta θ) {
        // presence only, never the value
        if (via == "cli") return which("claude") != null ? Pair.of(true, "`claude` CLI on PATH") : Pair.of(false, "`claude` CLI not on PATH"); // src: vvaharness/util/environment.py:620
        if (via == "sdk") {                                                    // src: vvaharness/util/environment.py:624
            if (isSet("ANTHROPIC_SDK_API_KEY") || isSet("ANTHROPIC_API_KEY") || isSet("ANTHROPIC_AUTH_TOKEN")) return Pair.of(true, "Anthropic SDK credential present"); // src: vvaharness/util/environment.py:625
            return Pair.of(false, "ANTHROPIC_SDK_API_KEY not set");
        }
        if (via == "openai") return isSet("OPENAI_API_KEY") ? Pair.of(true, "OPENAI_API_KEY set") : Pair.of(false, "OPENAI_API_KEY not set"); // src: vvaharness/util/environment.py:630
        if (via == "deepagents") return deepagentsCredentialOk(modelId, provider, cfg, θ); // src: vvaharness/util/environment.py:634
        return Pair.of(true, "via:" + via);                                    // unknown via passes // src: vvaharness/util/environment.py:636
    }

    boolean cfgApiKeyPresent(Config cfg, String block) {
        return cfg != null && getattr(getattr(cfg, block, null), "api_key", null) != null; // src: vvaharness/util/environment.py:641
    }

    Pair<Boolean, String> deepagentsCredentialOk(String modelId, String provider, Config cfg, Theta θ) {
        if (!ProviderRouting.routesToAnthropic(modelId, provider, θ)) {        // OpenAI-compatible route // src: vvaharness/util/environment.py:649
            if (cfgApiKeyPresent(cfg, "openai") || isSet("OPENAI_API_KEY")) return Pair.of(true, "OpenAI-compatible DeepAgents credential present"); // src: vvaharness/util/environment.py:650
            return Pair.of(false, "OPENAI_API_KEY not set");
        }
        if (cfgApiKeyPresent(cfg, "sdk") || isSet("ANTHROPIC_API_KEY") || isSet("ANTHROPIC_AUTH_TOKEN")) return Pair.of(true, "Anthropic-compatible DeepAgents credential present"); // src: vvaharness/util/environment.py:654
        return Pair.of(false, "ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN not set"); // src: vvaharness/util/environment.py:657
    }

    Map<Pair<String, String>, Set<String>> deepagentsTargets(Map<String, Node> nodes) {
        Map targets = Map.of();
        for (Entry<String, Node> e : nodes) {                                  // credentials are per target, not per via // src: vvaharness/util/environment.py:666
            if ((e.value.via != null ? e.value.via : "cli") != "deepagents") continue;
            targets.computeIfAbsent(Pair.of(e.value.id, e.value.provider)).add(e.key); // src: vvaharness/util/environment.py:670
        }
        return targets;
    }

    List<Check> deepagentsChecks(Map<String, Node> nodes, Config cfg, boolean gatewayDone, Theta θ) {
        List<Check> out = List.of(); boolean anthropicRoute = false;
        for (Entry<Pair<String, String>, Set<String>> t : sortedBy(deepagentsTargets(nodes), k -> Pair.of(k.first, orEmpty(k.second)))) { // src: vvaharness/util/environment.py:682
            anthropicRoute = anthropicRoute || ProviderRouting.routesToAnthropic(t.key.first, t.key.second, θ); // src: vvaharness/util/environment.py:684
            Pair<Boolean, String> r = backendCredentialOk("deepagents", t.key.first, t.key.second, cfg, θ);
            boolean blocking = !POST_SCAN_ROLES.containsAll(t.value);          // src: vvaharness/util/environment.py:687
            out.add(new Check("via:deepagents " + t.key.first, r.first ? OK : (blocking ? FAIL : WARN), r.second, blocking && !r.first)); // src: vvaharness/util/environment.py:688
        }
        if (anthropicRoute && !gatewayDone) {                                  // same JWT-without-base-url trap // src: vvaharness/util/environment.py:694
            Check gw = gatewayCheck(θ);
            out.add(new Check("via:deepagents endpoint", gw.status, gw.detail, gw.required));
        }
        return out;
    }

    List<Check> remediateChecks(Config cfg, Theta θ) {
        if (!θ["step_remediate.enabled"]) return List.of();                    // src: vvaharness/util/environment.py:705
        Node rem = cfg.models.remediate;
        if (rem == null) return List.of(new Check("step10: remediate", WARN, "models.remediate unset — remediation will be skipped", false)); // src: vvaharness/util/environment.py:708
        Pair<Boolean, String> r = backendCredentialOk(rem.via != null ? rem.via : "cli", rem.id, rem.provider, cfg, θ); // src: vvaharness/util/environment.py:713
        return List.of(new Check("step10: remediate", r.first ? OK : WARN, r.second, false)); // src: vvaharness/util/environment.py:715
    }

    List<Check> validateChecks(Config cfg, Theta θ) {
        if (!θ["step_validate.enabled"]) return List.of();                     // src: vvaharness/util/environment.py:723
        List<Check> out = List.of();
        Object val = ValidateRole.validateModelSpec(cfg);                      // src: vvaharness/util/environment.py:726
        if (val == null) out.add(new Check("step11: validate", WARN, "models.validate.orchestrator unset — validation will be skipped", false)); // src: vvaharness/util/environment.py:727
        else {
            BackendRoute route = ValidateRole.normalizeValidateBackend(val.via != null ? val.via : "cli", val.provider, θ); // legacy via:openai -> deepagents // src: vvaharness/util/environment.py:733
            Pair<Boolean, String> r = backendCredentialOk(route.via, val.id, route.provider, cfg, θ);
            out.add(new Check("step11: validate", r.first ? OK : WARN, r.second, false)); // src: vvaharness/util/environment.py:737
        }
        out.add(findSpec("claude_agent_sdk") != null ? new Check("step11: claude_agent_sdk", OK, "importable", false)
                                                     : new Check("step11: claude_agent_sdk", WARN, "claude_agent_sdk missing", false)); // src: vvaharness/util/environment.py:740
        return out;
    }

    Check tlsCheck() {
        String base = env("ANTHROPIC_BASE_URL", "https://api.anthropic.com");  // src: vvaharness/util/environment.py:752
        Url u = urlparse(base.contains("://") ? base : "https://" + base);
        String host = u.hostname != null ? u.hostname : "api.anthropic.com"; int port = u.port != null ? u.port : 443; // src: vvaharness/util/environment.py:754
        String cafile = env("NODE_EXTRA_CA_CERTS");
        boolean useBundle = cafile != null && Path.of(cafile).isFile();        // src: vvaharness/util/environment.py:756
        try {
            handshake(sslContext(useBundle ? cafile : null), host, port);      // no tokens, just a handshake // src: vvaharness/util/environment.py:758
            return new Check("TLS / CA cert", OK, host + ":" + port + " verified", false); // src: vvaharness/util/environment.py:767
        } catch (SSLCertVerificationError e) {
            String ca = detectCaCert();                                        // src: vvaharness/util/environment.py:772
            return new Check("TLS / CA cert", WARN, "private CA in the path; set SSL_CERT_FILE" + (ca != null ? " (bundle detected)" : ""), false); // src: vvaharness/util/environment.py:780
        } catch (Exception e) {
            return new Check("TLS / CA cert", WARN, "could not verify; the live probe will confirm", false); // DNS/timeout/proxy // src: vvaharness/util/environment.py:786
        }
    }

    void handshake(SSLContext ctx, String host, int port) {
        Socket sock = createConnection(host, port, TLS_HANDSHAKE_TIMEOUT_S);   // src: vvaharness/util/environment.py:792
        ctx.wrapSocket(sock, host).close();
    }

    Pair<SSLContext, String> clientTrust(SdkConfig sdkCfg, Path cfgPath) {
        String ca = sdkCfg != null ? sdkCfg.caCert : null;                     // sdk.ca_cert wins // src: vvaharness/util/environment.py:800
        if (ca != null) {
            Path path = ConfigPaths.resolveAgainst(cfgPath.resolve().parent, ca);  // src: vvaharness/util/environment.py:803
            if (path.isFile()) return Pair.of(sslContext(path), "sdk.ca_cert");
        }
        SSLContext ctx;
        try { ctx = Httpx2.createSslContext(true, true); }                     // reads SSL_CERT_FILE / DIR // src: vvaharness/util/environment.py:808
        catch (ImportError e) { ctx = sslContext(env("SSL_CERT_FILE")); }
        if (env("SSL_CERT_FILE") != null) return Pair.of(ctx, "SSL_CERT_FILE"); // src: vvaharness/util/environment.py:811
        if (env("SSL_CERT_DIR") != null) return Pair.of(ctx, "SSL_CERT_DIR");
        return Pair.of(ctx, "the OS trust store");
    }

    Check clientTlsCheck(Path cfgPath, Theta θ) {
        Config cfg; Map<String, Node> nodes;
        try { cfg = Config.load(cfgPath); nodes = ConfigPaths.iterModelRoles(cfg, θ); } // src: vvaharness/util/environment.py:822
        catch (Exception e) { return null; }                                   // config_check reports it
        Set<String> roles = nodes.filter((r, n) -> n.via == "sdk" || (n.via == "deepagents" && ProviderRouting.routesToAnthropic(n.id, n.provider, θ))).keys(); // src: vvaharness/util/environment.py:826
        if (roles.isEmpty()) return null;                                      // src: vvaharness/util/environment.py:831
        String base = firstNonNull(cfg.sdk.baseUrl, env("ANTHROPIC_BASE_URL"), "https://api.anthropic.com"); // src: vvaharness/util/environment.py:834
        Url u = urlparse(base.contains("://") ? base : "https://" + base);
        String host = u.hostname; int port = u.port != null ? u.port : 443;
        String source;
        try {
            Pair<SSLContext, String> t = clientTrust(cfg.sdk, cfgPath); source = t.second;
            handshake(t.first, host, port);                                    // src: vvaharness/util/environment.py:840
            return new Check("TLS / client trust", OK, host + ":" + port + " verified (" + source + ")", false);
        } catch (SSLCertVerificationError e) { }                               // fall through to the bundle test // src: vvaharness/util/environment.py:844
        catch (Exception e) { return null; }                                   // tls_check already reports it // src: vvaharness/util/environment.py:846
        boolean blocking = !POST_SCAN_ROLES.containsAll(roles);                // src: vvaharness/util/environment.py:849
        String nodeCa = env("NODE_EXTRA_CA_CERTS");
        try {
            if (!(nodeCa != null && Path.of(nodeCa).isFile())) throw new SSLError("no NODE_EXTRA_CA_CERTS bundle"); // src: vvaharness/util/environment.py:852
            handshake(sslContext(nodeCa), host, port);
        } catch (Exception e) {
            return new Check("TLS / client trust", WARN, "rejected by the sdk/deepagents trust; set SSL_CERT_FILE or sdk.ca_cert", false); // src: vvaharness/util/environment.py:856
        }
        return new Check("TLS / client trust", blocking ? FAIL : WARN, "accepted only with NODE_EXTRA_CA_CERTS (via:cli trust); export SSL_CERT_FILE", blocking); // src: vvaharness/util/environment.py:861
    }

    List<Check> runChecks(Path cfgPath, Theta θ) {
        List<Check> checks = List.of(pythonCheck(), toolCheck("git", "batch --repo-file cloning", false), toolCheck("pip3", "installing optional extras", false)); // src: vvaharness/util/environment.py:873
        checks.addAll(agentChecks());
        checks.addAll(credentialChecks());
        checks.add(langsmithTracingCheck());                                   // advisory egress guard // src: vvaharness/util/environment.py:879
        checks.addAll(depChecks());
        checks.add(anthropicVersionCheck());
        checks.add(tlsCheck());                                                // src: vvaharness/util/environment.py:882
        Check clientTls = clientTlsCheck(cfgPath, θ);
        if (clientTls != null) checks.add(clientTls);                          // src: vvaharness/util/environment.py:884
        checks.add(remediationInputsCheck());
        List<Check> cfgChecks = configCheck(cfgPath, θ);                       // src: vvaharness/util/environment.py:887
        if (!cfgChecks.isEmpty()) {
            checks.add(cfgChecks[0]); checks.add(dotenvCheck()); checks.add(overlayCheck(cfgPath, θ)); // src: vvaharness/util/environment.py:889
            checks.addAll(cfgChecks.tail(1));
        }
        return checks;
    }

    Triple<Integer, Integer, Integer> summarize(List<Check> checks) {
        return Triple.of(checks.count(c -> c.status == OK), checks.count(c -> c.status == WARN),
                         checks.count(c -> c.status == FAIL && c.required)); // required fails block // src: vvaharness/util/environment.py:898
    }
}
