        p.rule(θ["p.implement.companion_partner_check"]);                                               // src: vulnhunter-fix/prompts/implement.md:371
        p.context(θ["p.implement.companion_table"]);                                                    // src: vulnhunter-fix/prompts/implement.md:373
        p.rule(θ["p.implement.upgrade_guide_lookup"]);                                                  // src: vulnhunter-fix/prompts/implement.md:390
        p.choose(θ["p.implement.companion_options_in_place"]);                                         // src: vulnhunter-fix/prompts/implement.md:392
        p.rule(θ["p.implement.companion_fork_notes"]);                                                  // src: vulnhunter-fix/prompts/implement.md:397
        p.choose(θ["p.implement.companion_check_record_values"]);                                       // src: vulnhunter-fix/prompts/implement.md:399
