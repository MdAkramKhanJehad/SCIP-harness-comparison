// file: vvaharness/lang/detect.py
// Classifies a repo's files by language (extension map, then path/content sniffing for IaC, CI, Ansible,
// Kubernetes and mainframe sources) and tells source apart from config and templates.

@executedBy(CODE) @role(rule_set) @stage("S0")
class Detect {

    /** EXT_TO_LANG: ~150 extensions -> language key (incl. sql, terraform, bicep and a web-template bucket for XSS/SSTI surfaces). */
    Map<String, String> extToLang(Theta θ) {
        return θ["code.lang.detect.ext_to_lang"];                                                 // src: vvaharness/lang/detect.py:23
    }

    /** Whether path names a server-side template: compound suffix (.blade.php) or a web-template extension; case-insensitive. */
    boolean isWebTemplate(String path, Theta θ) {
        String low = path.lower();                                                                // src: vvaharness/lang/detect.py:114
        if (θ["code.lang.detect.template_compound_suffixes"].anyMatch(s -> low.endsWith(s))) return true; // src: vvaharness/lang/detect.py:115
        String ext = low.afterLast(".");                                                          // src: vvaharness/lang/detect.py:117
        return low.contains(".") && extToLang(θ).get("." + ext) == "web-template";                // src: vvaharness/lang/detect.py:118
    }

    /** LANG_DISPLAY: language key -> human label (used in S2 evidence and repo-kind rules). Display only. */
    Map<String, String> langDisplay() {
        return LANG_DISPLAY;                                                                      // src: vvaharness/lang/detect.py:120
    }

    /** Path/filename-only IaC, CI and container check (Dockerfile, compose, Chart, k8s/helm dirs, .tf/.bicep, workflows, ansible). */
    boolean isIacFile(String rel, Theta θ) {
        return Regex.searchIgnoreCase(θ["code.lang.detect.iac_path_rx"], rel);                   // src: vvaharness/lang/detect.py:211
    }

    /** SECURITY_CONFIG_NAMES: framework security config file names (web.xml, struts.xml, application.yml, web.config ...). */
    Set<String> securityConfigNames(Theta θ) {
        return θ["code.lang.detect.security_config_names"];                                       // src: vvaharness/lang/detect.py:214
    }

    // SECURITY_CONFIG_EXTS = .xml, .properties (exported; no caller in this package). src: vvaharness/lang/detect.py:222

    String readHead(Path repoRoot, String rel, int n) {
        try { return repoRoot.resolve(rel).readText("utf-8", "replace", n); } catch (OSError e) { return ""; } // src: vvaharness/lang/detect.py:229
    }

    /** Classify files the extension map missed or mis-bucketed as plain config. */
    String sniffLang(String rel, Path repoRoot, Theta θ) {
        Map<String, String> pathRx = θ["code.lang.detect.sniff_path_rx"];
        Map<String, String> bodyRx = θ["code.lang.detect.sniff_body_rx"];
        // IaC by filename: Dockerfile/Jenkinsfile have no extension, Actions live in .github/workflows
        if (Regex.search(pathRx.get("dockerfile"), rel)) return "dockerfile";                    // src: vvaharness/lang/detect.py:238
        if (Regex.search(pathRx.get("jenkins"), rel)) return "jenkins";                          // src: vvaharness/lang/detect.py:240
        if (Regex.search(pathRx.get("github-actions"), rel)) return "github-actions";            // src: vvaharness/lang/detect.py:242
        String suffix = suffix(rel).lower();                                                      // src: vvaharness/lang/detect.py:245
        if (suffix == ".yml" || suffix == ".yaml") {                                              // src: vvaharness/lang/detect.py:247
            if (Regex.search(pathRx.get("ansible"), rel)) return "ansible";                      // src: vvaharness/lang/detect.py:248
            if (Regex.search(pathRx.get("kubernetes"), rel)) return "kubernetes";                // src: vvaharness/lang/detect.py:250
            if (repoRoot != null) {                                                               // src: vvaharness/lang/detect.py:252
                String head = readHead(repoRoot, rel, θ["code.lang.detect.sniff_head_chars"]);   // src: vvaharness/lang/detect.py:253
                if (Regex.search(bodyRx.get("ansible"), head)) return "ansible";                 // src: vvaharness/lang/detect.py:254
                if (Regex.search(bodyRx.get("kubernetes"), head)) return "kubernetes";           // src: vvaharness/lang/detect.py:256
            }
            return null;                                                                          // src: vvaharness/lang/detect.py:258
        }
        if (!suffix.isEmpty()) return null;                                                       // src: vvaharness/lang/detect.py:260
        // extension-less: mainframe sources commonly ship as PDS-member dumps
        if (Regex.search(pathRx.get("mainframe"), rel) && repoRoot != null) {                    // src: vvaharness/lang/detect.py:264
            String head = readHead(repoRoot, rel, θ["code.lang.detect.sniff_head_chars"]);       // src: vvaharness/lang/detect.py:265
            if (Regex.search(bodyRx.get("jcl"), head)) return "jcl";                             // src: vvaharness/lang/detect.py:266
            if (Regex.search(bodyRx.get("cobol"), head)) return "cobol";                         // src: vvaharness/lang/detect.py:268
        } else if (repoRoot != null) {                                                            // src: vvaharness/lang/detect.py:270
            String head = readHead(repoRoot, rel, θ["code.lang.detect.sniff_head_chars_extensionless"]); // src: vvaharness/lang/detect.py:271
            if (Regex.search(bodyRx.get("jcl"), head)) return "jcl";                             // src: vvaharness/lang/detect.py:272
            if (Regex.search(bodyRx.get("cobol"), head)) return "cobol";                         // src: vvaharness/lang/detect.py:274
        }
        return null;                                                                              // src: vvaharness/lang/detect.py:276
    }

    /** Ordered list of language keys present in files, most common first. */
    List<String> detectLanguages(List<String> files, Path repoRoot, Theta θ) {
        Map<String, Integer> counts = new Map();
        for (String f : files) {                                                                  // src: vvaharness/lang/detect.py:284
            String suffix = suffix(f).lower();                                                    // src: vvaharness/lang/detect.py:285
            String lang = extToLang(θ).get(suffix);                                               // src: vvaharness/lang/detect.py:286
            if (lang == null || suffix == ".yml" || suffix == ".yaml") {                          // src: vvaharness/lang/detect.py:287
                String s = sniffLang(f, repoRoot, θ);                                             // src: vvaharness/lang/detect.py:288
                if (s != null) lang = s;
            }
            if (lang != null) counts.inc(lang);                                                   // src: vvaharness/lang/detect.py:289
        }
        return counts.keysSortedByValueDesc();                                                    // src: vvaharness/lang/detect.py:291
    }

    // VVAH_LANGUAGES = python, java, javascript, typescript, go, csharp: only used by S0 to warn about an unrecognised step0.languages entry. src: vvaharness/lang/detect.py:294

    /** Normalise a language spelling to its key; unknown spellings return lower-cased, never defaulted. */
    String canonicalLang(Object value, Theta θ) {
        String key = String.valueOf(value == null ? "" : value).strip().lower();                  // src: vvaharness/lang/detect.py:320
        return θ["code.lang.detect.lang_aliases"].getOrDefault(key, key);                         // src: vvaharness/lang/detect.py:321
    }
}
