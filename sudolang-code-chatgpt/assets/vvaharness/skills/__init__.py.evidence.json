  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Detection skill packages, and the injection that makes them reachable from a session.\"\"\"\n\nfrom __future__ import annotations\n\nimport shutil\nimport threading\nfrom functools import wraps\nfrom pathlib import Path\n\nPACKAGED_SKILLS = Path(__file__).parent\n\n#: Repo-relative location for temporary skill copies.\nINJECTED_SUBDIR = Path(\".vvaharness\") / \"skills\"\n\n_INJECTED: dict[str, Path | None] = {}\n_TEMP_COPIES: dict[str, tuple[Path, bool]] = {}\n_INJECT_LOCK = threading.Lock()\n\n\ndef skill_names() -> tuple[str, ...]:\n    \"\"\"Every packaged skill name, sorted.\"\"\"\n    return tuple(sorted(\n        d.name for d in PACKAGED_SKILLS.iterdir()\n        if d.is_dir() and (d / \"SKILL.md\").is_file()\n    ))\n\n\ndef _inject(repo_root: Path) -> Path | None:\n    \"\"\"Copy the packaged skills under *repo_root*, or None when the copy fails.\"\"\"\n    parent = Path(repo_root) / INJECTED_SUBDIR.parent\n    if parent.is_symlink():\n        return None\n    parent_existed = parent.exists()\n    try:\n        parent.mkdir(exist_ok=True)\n        dst = Path(repo_root) / INJECTED_SUBDIR\n        dst.mkdir()\n    except OSError:\n        return None\n    _TEMP_COPIES[str(repo_root.resolve())] = (dst, parent_existed)\n    try:\n        shutil.copytree(PACKAGED_SKILLS, dst, dirs_exist_ok=True)\n    except OSError:\n        return None\n    for leftover in (dst / \"__init__.py\", dst / \"__pycache__\"):\n        if leftover.is_dir():\n            shutil.rmtree(leftover, ignore_errors=True)\n        elif leftover.exists():\n            leftover.unlink(missing_ok=True)\n    return dst\n\n\ndef inject_skills(repo_root: Path) -> Path | None:\n    \"\"\"The skill_root for *repo_root*, copying the packaged tree there on first call only.\"\"\"\n    key = str(Path(repo_root).resolve())\n    with _INJECT_LOCK:\n        if key not in _INJECTED:\n            _INJECTED[key] = _inject(Path(repo_root))\n        return _INJECTED[key]\n\n\ndef with_injected_skills(function):\n    \"\"\"Remove this scan's temporary skills on return, failure or interruption.\"\"\"\n    @wraps(function)\n    def scoped(repo: Path, *args, **kwargs):\n        try:\n            return function(repo, *args, **kwargs)\n        finally:\n            key = str(Path(repo).resolve())\n            with _INJECT_LOCK:\n                _INJECTED.pop(key, None)\n                copy = _TEMP_COPIES.pop(key, None)\n                if copy is not None:\n                    destination, parent_existed = copy\n                    shutil.rmtree(destination)\n                    if not parent_existed:\n                        try:\n                            (Path(repo) / INJECTED_SUBDIR.parent).rmdir()\n                        except OSError:\n                            pass\n    return scoped\n\n\n__all__ = [\"INJECTED_SUBDIR\", \"PACKAGED_SKILLS\", \"inject_skills\", \"skill_names\",\n           \"with_injected_skills\"]\n",
