# vvaharness/backends/harness/deepagents/options/forcing.py

`ForcingChatAnthropic`: the Anthropic chat model used on every Anthropic route of the deepagents backend. langchain-anthropic drops a forced `tool_choice` whenever thinking is enabled or adaptive; this class puts the forcing back for adaptive thinking (which the API accepts), so a structured-output session cannot end on prose. `ForceVerdictOnly` can switch forcing off per call.

Source: `vvaharness/backends/harness/deepagents/options/forcing.py` (lines 1-80)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/model_building.sudo` build_model (Anthropic arm); `vvaharness/backends/harness/deepagents/force_verdict_only.py` (copies the model with `force_tool_choice=false`)

// src: vvaharness/backends/harness/deepagents/options/forcing.py:28-29
_DROP_MESSAGE = "tool_choice is forced but thinking is enabled"
_FORCED_TYPES = ["any", "tool"]

// src: vvaharness/backends/harness/deepagents/options/forcing.py:43-47
ForcingChatAnthropic {
  // external: subclass of langchain_anthropic.ChatAnthropic
  force_tool_choice: Boolean = true   // false binds every tool_choice as auto; set by deepagents.force_verdict_only.ForceVerdictOnly._auto_model (force_verdict_only.py:91) for its working calls
}

// src: vvaharness/backends/harness/deepagents/options/forcing.py:49-66
fn ForcingChatAnthropic.bind_tools(tools, tool_choice?, ...kwargs):executor=code {
  if (!force_tool_choice) return ChatAnthropic.bind_tools(tools, tool_choice=null, ...kwargs)
  forced = _forced_choice(tool_choice)
  adaptive = thinking.type == "adaptive"
  if (forced == null || !adaptive) return ChatAnthropic.bind_tools(tools, tool_choice, ...kwargs)
  // Manual "enabled" thinking is left as langchain leaves it (forcing dropped); only adaptive is re-forced.
  bound = ChatAnthropic.bind_tools(tools, tool_choice, ...kwargs) with the _DROP_MESSAGE warning suppressed
  return _reforce(bound, forced)
}

// src: vvaharness/backends/harness/deepagents/options/forcing.py:32-40
fn _forced_choice(tool_choice):executor=code {
  match (tool_choice) {
    case dict with type in _FORCED_TYPES => copy of tool_choice
    case dict => null
    case "any" | "tool" => { type: tool_choice }
    case String => { type: "tool", name: tool_choice }
    default => null
  }
}

// src: vvaharness/backends/harness/deepagents/options/forcing.py:69-80
fn _reforce(bound, forced):executor=code {
  held = bound.kwargs
  if (held is not a dict) return bound
  if (held.tool_choice.type in _FORCED_TYPES) return bound   // langchain kept it; nothing to do
  if (held.tool_choice has disable_parallel_tool_use) forced.disable_parallel_tool_use = held.tool_choice.disable_parallel_tool_use
  COUNTERS.bump("deepagents_tool_choice_reforced_under_adaptive_thinking")
  return bound.bind(tool_choice=forced)
}
