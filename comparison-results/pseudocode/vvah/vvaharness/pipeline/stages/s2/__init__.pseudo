// file: vvaharness/pipeline/stages/s2/__init__.py
// S2 entry: the application threat model, reasoned over S1's mapped attack surface.
// gather evidence -> baseline block -> user prompt -> agentic call (one unforced resend) -> parse (one repair) -> finalize -> hollow retry -> baseline audit -> caps.

@executedBy(MIXED) @role(stage) @stage("S2")
class S2 {

    ThreatModel run(String repoRoot, String repoName, Config cfg, List<CVE> knownCves, List<Control> controls, ContextPackage ctx, AppProfile appProfile, Theta θ) {
        ThreatEvidence ev = S2Evidence.gather(repoRoot, ctx, θ);                              // src: vvaharness/pipeline/stages/s2/__init__.py:137
        String baselineMode = S2Config.baselineMode(θ);                                       // src: vvaharness/pipeline/stages/s2/__init__.py:147
        Pair<Set<String>, Prompt> bl = S2Prompts.baselineBlock(ev, ctx, baselineMode, θ);     // src: vvaharness/pipeline/stages/s2/__init__.py:148
        Set<String> kinds = bl.first;
        Prompt user = S2Prompts.user(repoName, ev, knownCves, controls, appProfile, bl.second, θ); // src: vvaharness/pipeline/stages/s2/__init__.py:152
        Effort effort = S2Config.effort(θ);                                                   // src: vvaharness/pipeline/stages/s2/__init__.py:158
        String raw;
        try {
            // one resend without forced tool_choice / thinking when the reply is degenerate, clipped or refused
            raw = ResponseQuality.dispatchOrRetryUnforced(
                drop -> S2Session.threatmodelCall(user, cfg, repoRoot, ctx, drop, ev.fileCount > 0, θ),
                effort, () -> S2Config.emptyRetry(θ));                                        // src: vvaharness/pipeline/stages/s2/__init__.py:163
        } catch (Exception e) {
            ErrLog.log("s2", "threat_model_call_failed");                                     // record-then-raise, never swallow  // src: vvaharness/pipeline/stages/s2/__init__.py:175
            throw e;
        }
        ThreatModel tm;
        try {
            tm = S2Outcomes.parseThreatModel(raw);                                            // src: vvaharness/pipeline/stages/s2/__init__.py:181
        } catch (Exception parseErr) {
            // one repair re-ask, same SYSTEM, full step2 caps
            Pair<Integer, Integer> lim = S2Config.repairLimits(θ);                            // src: vvaharness/pipeline/stages/s2/__init__.py:197
            String repaired = Runtime.llm(new ModelSpec(cfg.models.threatmodel, null, lim.first), S2Prompts.run(θ), S2Prompts.repairJson(raw, parseErr, θ), null); // src: vvaharness/pipeline/stages/s2/__init__.py:191
            tm = S2Outcomes.parseThreatModel(repaired);                                       // on failure: errlog + raise (orchestrator bumps s2_degraded)  // src: vvaharness/pipeline/stages/s2/__init__.py:201
        }
        S2Outcomes.finalizeThreats(tm, ctx);                                                  // src: vvaharness/pipeline/stages/s2/__init__.py:217
        tm = S2Session.retryIfHollow(tm, ev, user, cfg, repoRoot, ctx, θ);                    // src: vvaharness/pipeline/stages/s2/__init__.py:219
        if (tm.threats.isEmpty()) {                                                           // src: vvaharness/pipeline/stages/s2/__init__.py:221
            ErrLog.log("s2", "zero threats");                                                 // src: vvaharness/pipeline/stages/s2/__init__.py:223
            if (ev.fileCount > 0) Counters.bump("s2_degraded");                               // src: vvaharness/pipeline/stages/s2/__init__.py:228
        }
        // audit BEFORE the cap: baseline threats rank last and would be truncated
        Set<String> undisposed = S2Baseline.baselineAudit(tm, kinds, θ);                      // src: vvaharness/pipeline/stages/s2/__init__.py:233
        Triple<Integer, Integer, Integer> caps = S2Config.outputCaps(θ);                      // src: vvaharness/pipeline/stages/s2/__init__.py:235
        Triple<Integer, Integer, Integer> rawCounts = new Triple(tm.threats.size(), tm.assets.size(), tm.trustBoundaries.size()); // src: vvaharness/pipeline/stages/s2/__init__.py:238
        tm = ScanThreat.capThreats(tm, caps.first);                                               // ranks impact x likelihood, keeps top N  // src: vvaharness/pipeline/stages/s2/__init__.py:239
        tm = ScanThreat.capAssets(tm, caps.second);                                               // src: vvaharness/pipeline/stages/s2/__init__.py:240
        tm = ScanThreat.capBoundaries(tm, caps.third);                                            // src: vvaharness/pipeline/stages/s2/__init__.py:241
        S2Outcomes.warnOutputCaps(rawCounts, tm, caps);                                       // src: vvaharness/pipeline/stages/s2/__init__.py:242
        if (!undisposed.isEmpty()) {                                                          // src: vvaharness/pipeline/stages/s2/__init__.py:246
            Set<String> disposed = S2Baseline.requiredBaselines(kinds, θ).minus(undisposed);  // src: vvaharness/pipeline/stages/s2/__init__.py:248
            boolean allCoveredElsewhere = undisposed.allMatch(bid -> S2Baseline.categoryCoveredElsewhere(bid, tm.threats, disposed, θ)); // src: vvaharness/pipeline/stages/s2/__init__.py:250
            if (allCoveredElsewhere) ErrLog.log("s2", "baseline_items_undisposed", true);     // recovered  // src: vvaharness/pipeline/stages/s2/__init__.py:253
            else ErrLog.log("s2", "baseline_items_undisposed");                               // a real gap  // src: vvaharness/pipeline/stages/s2/__init__.py:261
        }
        return tm;                                                                            // src: vvaharness/pipeline/stages/s2/__init__.py:272
    }
}
