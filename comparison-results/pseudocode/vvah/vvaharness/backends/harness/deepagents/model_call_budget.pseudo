// file: vvaharness/backends/harness/deepagents/model_call_budget.py
// ModelCallBudget middleware: caps model calls per session; on the last permitted call every tool but the
// outcome tool is withdrawn and a FINAL TURN notice is appended. S4 opts in to raising VVAH-E007 if even that
// forced turn does not end the session.

@executedBy(CODE) @role(rule_set)
class ModelCallBudget {

    int limit;
    Set<String> outcome;
    String counter;
    int calls;
    boolean raiseWhenExhausted;
    String stage;
    boolean finalTurnIssued;

    // S4: limit = step4.max_model_calls + (members - 1); outcome = InvestigationOutcome(s); raise = true
    void init(int limit, Set<String> outcomeTools, String counter, boolean raiseWhenExhausted, String stage) {
        this.limit = max(1, limit);                                                                      // src: vvaharness/backends/harness/deepagents/model_call_budget.py:51
        this.outcome = outcomeTools;
        this.counter = counter;
        this.calls = 0;
        this.raiseWhenExhausted = raiseWhenExhausted;
        this.stage = stage;
        this.finalTurnIssued = false;
    }

    // Count this call; true when it is the last permitted one.
    boolean claim() {
        calls += 1;                                                                                      // src: vvaharness/backends/harness/deepagents/model_call_budget.py:68
        return calls >= limit;                                                                           // src: vvaharness/backends/harness/deepagents/model_call_budget.py:69
    }

    // A deadline resume's next call becomes the forced final turn again instead of VVAH-E007.
    void grantResumeTurn() {
        if (!finalTurnIssued) return;                                                                    // src: vvaharness/backends/harness/deepagents/model_call_budget.py:74
        finalTurnIssued = false;
        calls = limit - 1;                                                                               // src: vvaharness/backends/harness/deepagents/model_call_budget.py:77
    }

    ModelRequest finalTurn(ModelRequest request, Theta θ) {
        List<Tool> kept = request.tools.filter(t -> outcome.contains(t.name));                           // src: vvaharness/backends/harness/deepagents/model_call_budget.py:81
        Counters.bump(counter);
        return request.override(kept, concat(request.messages, ModelCallBudgetPrompts.finalTurnNotice(limit, θ))); // src: vvaharness/backends/harness/deepagents/model_call_budget.py:83
    }

    void checkExhausted() {
        if (raiseWhenExhausted && finalTurnIssued) {                                                     // src: vvaharness/backends/harness/deepagents/model_call_budget.py:89
            throw new ModelCallBudgetExhaustedError("forced final turn did not end the session on the outcome tool", stage, limit); // src: vvaharness/backends/harness/deepagents/model_call_budget.py:90
        }
    }

    ModelResponse wrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        checkExhausted();                                                                                // src: vvaharness/backends/harness/deepagents/model_call_budget.py:101
        if (claim()) {
            finalTurnIssued = true;                                                                      // src: vvaharness/backends/harness/deepagents/model_call_budget.py:103
            request = finalTurn(request, θ);                                                             // src: vvaharness/backends/harness/deepagents/model_call_budget.py:104
        }
        return handler.call(request);
    }

    // Async counterpart of wrapModelCall: same exhaustion check and final-turn claim, awaited handler.
    ModelResponse awrapModelCall(ModelRequest request, Handler handler, Theta θ) {
        checkExhausted();                                                                                // src: vvaharness/backends/harness/deepagents/model_call_budget.py:113
        if (claim()) {                                                                                  // src: vvaharness/backends/harness/deepagents/model_call_budget.py:114
            finalTurnIssued = true;
            request = finalTurn(request, θ);                                                             // src: vvaharness/backends/harness/deepagents/model_call_budget.py:116
        }
        return await handler.call(request);                                                              // src: vvaharness/backends/harness/deepagents/model_call_budget.py:117
    }
}

@executedBy(MODEL) @role(prompt)
class ModelCallBudgetPrompts {

    Prompt finalTurnNotice(int limit, Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.model_call_budget.final_turn_notice"]);            // "FINAL TURN. You have used your <limit> model calls ... every tool except the outcome report has been withdrawn" // src: vvaharness/backends/harness/deepagents/model_call_budget.py:32
        p.threshold(limit);
        p.must(θ["p.model_call_budget.report_from_held_evidence"]);    // report the outcome object NOW          // src: vvaharness/backends/harness/deepagents/model_call_budget.py:35
        p.must(θ["p.model_call_budget.keep_confirmed_findings"]);      // do not discard confirmed findings      // src: vvaharness/backends/harness/deepagents/model_call_budget.py:36
        p.rule(θ["p.model_call_budget.open_question_in_rationale"]);   // open question -> say so, set verdict accordingly // src: vvaharness/backends/harness/deepagents/model_call_budget.py:37
        p.tiebreak(θ["p.model_call_budget.inconclusive_is_honest"]);   // "`inconclusive` is honest, silence is not" // src: vvaharness/backends/harness/deepagents/model_call_budget.py:38
        return p;
    }
}
