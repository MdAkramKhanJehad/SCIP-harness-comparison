            Map props = new Map();                                                              // insertion order is the serialisation order
            props.put("severity", sev.lower());                                                 // src: vvaharness/pipeline/stages/s9/typed_sarif.py:231
            props.put("security-severity", securitySeverity(sev, cvssScore, θ));                // src: vvaharness/pipeline/stages/s9/typed_sarif.py:232
            props.put("cvssRating", Cvss.rating(cvssScore >= 0 ? cvssScore : parseFloat(securitySeverity(sev, cvssScore, θ)), θ)); // src: vvaharness/pipeline/stages/s9/typed_sarif.py:233
