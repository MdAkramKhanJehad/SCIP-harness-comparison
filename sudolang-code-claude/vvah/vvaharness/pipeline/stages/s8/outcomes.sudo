# vvaharness/pipeline/stages/s8/outcomes.py

The Stage 8 output contract and its reducer onto `FinalReport`. The model's reply (`ChainReport`) is salvaged entry by entry, then hydrated: ids are resolved against the findings the model was shown, severities are taken from the CVSS / VulContextSeverity band ahead of the model's word, and each proposed chain passes deterministic gates (same-location collapse, link evidence, severity lift gate) or is dropped. `deterministic_report` is the always-computable floor used whenever enrichment fails.

Source: `vvaharness/pipeline/stages/s8/outcomes.py` (lines 1-787)
Executor: code (schema field descriptions are model-facing instructions)
Called from: `vvaharness/pipeline/stages/s8_chain.py` run; `vvaharness/pipeline/stages/s8/window.py`

// ---------- reply schema (sent to the model as the response schema) ----------

// src: vvaharness/pipeline/stages/s8/outcomes.py:72-99
// prompt-src: vvaharness/pipeline/stages/s8/outcomes.py:72-87
RankedEntry {
  finding_id: String
  severity: String = ""
  exploitability_notes: String = ""
  feeds: String[] = []
  Constraints {
    finding_id: "Echo the FINDING id you were given, verbatim."
    severity: "LEAVE EMPTY unless you are deliberately overriding the severity shown. final_severity takes the VulContextSeverity or CVSS band ahead of this value, so for any finding that has one your word here is discarded. One of critical, high, medium, low, info."
    exploitability_notes: "AT MOST TWO SENTENCES: why this severity differs, naming the control that applies or fails. Omit entirely when you are only recording `feeds`."
    feeds: "Ids of the findings this one SUPPLIES something to — a value, a privilege, a reachable state or an input the other finding needs — whether or not you can evidence the link. Record every such id; chain the ones you can evidence with link_evidence, the rest stay here. Never a finding at the same file:line, and never a precondition or amplifier (a root container, a missing header): those stay in exploitability_notes."
  }
  // src: outcomes.py:89-99 — code coerces each scalar to text and feeds to a list of strings, so one malformed value costs that entry alone
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:102-152
// prompt-src: vvaharness/pipeline/stages/s8/outcomes.py:102-127
ChainEntry {
  title: String
  steps: String[]
  severity: String = ""
  blocked_by_controls: String[] = []
  narrative: String = ""
  link_evidence: LinkEvidence[] = []   // defaulted, not required: one absent list must not fail the whole report
  entry_reachability: String = ""
  preconditions: String[] = []
  Constraints {
    title: "The chain in a few words, e.g. 'SSRF -> metadata creds -> S3'."
    steps: "The FINDING ids in exploitation order, at least two. Ids only, no prose. Two findings at the SAME file and line are one code fact, never two steps."
    severity: "LEAVE EMPTY. The host derives a chain's severity from its steps and the lift gate caps it at the strongest constituent finding, so a value here is discarded."
    blocked_by_controls: "Names of design controls that genuinely block this chain, if any."
    narrative: "ONE sentence naming what the chain achieves that no single step does. The per-hop mechanism belongs in link_evidence, not here -- do not retell the steps."
    link_evidence: "ONE entry per adjacent pair in `steps`, IN ORDER (so len(steps) - 1 entries). Leave from_id/to_id EMPTY -- position already says which pair you mean and the host fills them. Give only `mechanism` and the file/line that shows the link holds. A link you cannot evidence means the chain is not real: drop the chain, do not invent one."
    entry_reachability: "How the FIRST step is reached by the attacker you claim — cite the route/entry point and any binding or exposure fact you were given."
    preconditions: "Non-default config or state this chain REQUIRES (e.g. 'requires --risk>=3, default is 1'). These are surfaced to the report reader, so a chain that only works off-default must say so here."
  }
  // src: outcomes.py:129-152 — code coercions: scalars to text, lists to lists of strings;
  // a non-list link_evidence becomes []; non-object entries are dropped and counted ("s8_link_evidence_entry_invalid")
  // preserved: the severity description says "a value here is discarded", but _model_or_derived_chain_severity uses a parseable model severity as the starting chain severity
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:155-198
// prompt-src: vvaharness/pipeline/stages/s8/outcomes.py:157-169
ChainReport {
  ranked_findings: RankedEntry[] = []
  chains: ChainEntry[] = []      // declared before summary: chains before the summary that describes them
  summary: String
  chains_invalid: Number = 0     // harness-only, hidden from the model-facing schema
  Constraints {
    ranked_findings: "SPARSE: an entry ONLY for a finding that feeds another one, or whose severity you are changing from the CVSS-derived value shown. Omit every other finding -- omitted ones ship with their CVSS severity, which is already correct. An empty list is a valid answer. Do NOT echo back findings you have nothing to add to."
    chains: "Chains of two or more findings. Empty is correct when no finding feeds another — an invented chain is worse than none."
    summary: "Executive summary, 2-4 sentences, written LAST: it may describe only the chains listed in `chains` and the ranking above — a path that is not a chain entry must not be claimed here."
  }
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:174-198 — salvage before validation
fn ChainReport._salvage_entries(data):executor=code {
  if (data is not an object) return data   // a non-list or non-object stays broken wholesale
  if ("chains" not in data) COUNTERS.bump("s8_chains_key_absent")
  for each field, model in [["ranked_findings", RankedEntry], ["chains", ChainEntry]] {
    if (data[field] is a list) {
      [data[field], dropped[field]] = _salvage(data[field], model)   // each entry validated alone; unreadable ones dropped
      if (dropped[field]) COUNTERS.bump("s8_${field}_entry_invalid", dropped[field])
    }
  }
  // src: outcomes.py:192-197 — carried across re-validation; anything but an integer in [0, 1000] reads as 0
  carried = data.chains_invalid
  if (carried is not an integer || !(0 <= carried && carried <= _CHAINS_INVALID_MAX)) carried = 0   // _CHAINS_INVALID_MAX = 1000 (outcomes.py:58)
  data.chains_invalid = carried + (dropped.chains or 0)
  return data
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:201-206
fn parse_chain_reply(raw):executor=code {
  try return ChainReport from JSON raw;
  catch ValueError => return ChainReport from extract_json(raw)   // raises ValueError or TypeError when neither parses
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:209-211
fn finding_ids(findings):executor=code { return { "f$i": i for each i in 0..length(findings)-1 } }   // the one place the id mapping is defined

// ---------- hydration (the code checks on the model reply) ----------

// src: vvaharness/pipeline/stages/s8/outcomes.py:651-787
fn hydrate_report(data, ctx, findings, dropped, raw_findings_count, metrics, window?, cfg?):executor=code {
  // window = original indices the model was shown; null = all
  index_of = finding_ids(findings)
  ranked = []; ranked_orig_idx = []; covered = {}; claims = {}

  // src: outcomes.py:662-692 — ranking entries
  for each item in data.ranked_findings {
    idx = index_of[trimmed item.finding_id]
    if (window != null && idx != null && idx not in window) idx = null   // a real id the model was never shown
    require idx != null && idx not in covered => {
      COUNTERS.bump(if (idx == null) "s8_ranked_finding_id_unknown" else "s8_ranked_finding_id_repeated"); skip this entry
    }
    covered = covered union {idx}
    for each token in item.feeds {
      t = index_of[trimmed token]
      if (t == null || (window != null && t not in window)) COUNTERS.bump("s8_chain_feeds_id_unknown")   // counted, never echoed
      else if (t != idx) claims = claims union {[idx, t]}
    }
    parsed_sev = _coerce_sev_or_none(item.severity)
    // a blank severity is not an asserted INFO: fallback is the finding's own carried severity
    shipped_sev = final_severity(findings[idx], parsed_sev or findings[idx].severity)
    findings[idx].severity_prose_mismatch = if (parsed_sev != null) severity_prose_mismatch(parsed_sev, shipped_sev) else ""
    append ranked_finding(findings[idx], shipped_sev, item.exploitability_notes) to ranked; append idx to ranked_orig_idx
  }

  // src: outcomes.py:694-702 — every finding not ranked still ships, at its own severity
  for each i, f in findings where i not in covered {
    note = if (window == null || i in window) NOT_RANKED_NOTE else "(not sent to the enrichment pass — report windowed)"
    append ranked_finding(f, final_severity(f, f.severity), note) to ranked; append i to ranked_orig_idx
  }

  // src: outcomes.py:704-705
  [ranked, orig_to_sorted, dropped_out] = _sort_and_remap(ranked, ranked_orig_idx, dropped)

  // src: outcomes.py:707-710 — a missing cfg or key reads as ON
  gate_on = knob("step8.severity_lift_gate", default=true)
  checks_on = knob("step8.chain_quality_checks", default=true)
  dedup_on = knob("step8.chain_dedup", default=true)

  // src: outcomes.py:712-726 — ONE prose id mapping fN -> #N, built after the sort
  prose_ids = { token: "#${orig_to_sorted[i] + 1}" for each [token, i] in index_of where i in orig_to_sorted }
  for each rf in ranked {
    [remapped, missed] = _remap_prose_ids(rf.exploitability_notes, prose_ids)
    rf.exploitability_notes = remapped; rf.finding.exploitability_notes = remapped
    if (missed) COUNTERS.bump("s8_chain_prose_id_unresolved", length(missed))
  }
  [summary, summary_missed] = _remap_prose_ids(data.summary, prose_ids)
  if (summary_missed) COUNTERS.bump("s8_chain_prose_id_unresolved", length(summary_missed))
  summary = _reword_schema_terms(summary)

  // src: outcomes.py:728-742 — each proposed chain through the gates
  chains = []; chains_dropped = 0
  for each item in data.chains {
    chain = _build_chain(item, ranked, index_of, orig_to_sorted, prose_ids, ctx.repo_root, window, gate_on, checks_on)
    if (chain == null) chains_dropped += 1 else append chain to chains
  }
  if (chains_dropped) COUNTERS.bump("s8_chain_dropped", chains_dropped)

  // src: outcomes.py:744-751 — feeds claims no shipped chain carries: disclosed, never promoted
  unpromoted = []
  if (checks_on) {
    unpromoted = s8.validate.unpromoted_links(sorted([orig_to_sorted[o], orig_to_sorted[t]] for each [o, t] in claims), chains, ranked)
    if (unpromoted) COUNTERS.bump("s8_chain_link_unpromoted", length(unpromoted))
  }

  // src: outcomes.py:753-769
  chains_deduped = 0
  if (dedup_on) {
    [chains, chains_deduped, pairs] = s8.validate.dedup_chains(chains)
    if (chains_deduped) COUNTERS.bump("s8_chain_deduped", chains_deduped)
    if (pairs) COUNTERS.bump("s8_chain_near_duplicate", length(pairs))
    siblings = count of pairs each chain position appears in
    for each [i, n] in siblings {
      append s8.validate.NEAR_DUPLICATE_NOTE with n=chains[i].steps[-1] + 1, others=n to chains[i].disclosures   // a disclosure, not a quality note
    }
  }

  // src: outcomes.py:771-772 — band, then blocked after unblocked; stable sort
  chains = chains sorted by (SEV_RANK[c.severity], bool(c.blocked_by_controls))

  // src: outcomes.py:774-787
  return [FinalReport(repo_root=ctx.repo_root, findings=ranked, chains, chains_dropped, chains_deduped,
    chains_invalid=data.chains_invalid, unpromoted_links=unpromoted, dropped=dropped_out,
    raw_findings_count, metrics, summary), covered]
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:498-648
fn _build_chain(item, ranked, index_of, orig_to_sorted, prose_ids, repo_root, window, gate_on, checks_on):executor=code {
  // src: outcomes.py:504-505 — hedge note, unconditional
  [narrative, hedged] = s8.validate.annotate_hedges(item.narrative)

  // src: outcomes.py:506-512 — one-link-per-step reply with empty ids: entry 0 is dropped
  if (length(item.link_evidence) == length(item.steps) && length(item.steps) >= 2 && every link has empty from_id and to_id) {
    item.link_evidence = item.link_evidence without its first entry
    COUNTERS.bump("s8_chain_links_origin_dropped")
  }
  // src: outcomes.py:513-515
  prose = _remap_item_prose(item, narrative, prose_ids)
  narrative = prose.narrative

  // src: outcomes.py:517-525 — steps resolved against ids the model was shown
  steps = for each s in item.steps where trimmed s in index_of && (window == null || index_of[s] in window): index_of[s]
  unknown = item.steps that are not in index_of, or are outside the window
  if (unknown) COUNTERS.bump("s8_chain_step_id_unknown", length(unknown))
  named = for each s in steps where s in orig_to_sorted: orig_to_sorted[s]

  // src: outcomes.py:527-535 — one file:line is one code fact; collapse BEFORE the length test
  [remapped, dupes] = s8.validate.collapse_same_location(named, ranked)
  if (dupes) COUNTERS.bump("s8_chain_hop_same_location", dupes)
  require length(remapped) >= 2 => {
    COUNTERS.bump(if (unknown || !dupes) "s8_chain_dropped_unresolved_steps" else "s8_chain_dropped_same_location")
    return null   // the chain is dropped
  }
  // src: outcomes.py:536-546 — note naming up to 20 omitted ids
  if (unknown) {
    why = if (window != null) "outside this pass's view (not in the verified set, or not sent to the windowed enrichment call)" else "not in the verified set"
    narrative = trimmed "$narrative\n\n_Note: this chain referenced finding ids ${ first 20 of unknown }${ if (length(unknown) > 20) " (+${length(unknown) - 20} more)" } that were $why; they have been omitted from the path above._"
  }

  // src: outcomes.py:548-568 — only links evidencing a hop of the PRINTED path ship, ids rewritten to #N
  filled = _positionally_filled(item)
  path_hops = adjacent pairs of remapped
  survivor = { location_key(ranked, s): s for each s in remapped }
  alias = { s: survivor[location_key(ranked, s)] for each s in named }   // a collapsed step reads as the survivor at its location
  links = []
  for each [ln, mech] in zip(filled, prose.mechanisms) {
    src = alias[orig_to_sorted[index_of[trimmed ln.from_id]]]
    dst = alias[orig_to_sorted[index_of[trimmed ln.to_id]]]
    if ([src, dst] in path_hops) {
      [_, cfile, cline] = s8.validate.resolved_citation(repo_root, ln.file, ln.line)   // an unresolved citation ships with line 0
      append LinkEvidence(from_id="#${src + 1}", to_id="#${dst + 1}", mechanism=mech, file=cfile, line=cline) to links
    }
  }
  if (length(filled) > length(links)) COUNTERS.bump("s8_chain_links_unplaced", length(filled) - length(links))

  // src: outcomes.py:570-574 — one verdict, priced on the hydrated path and the links that ship
  [links_ok, resolved_links, hops] = s8.validate.link_ok(links, remapped, repo_root)
  hardening = s8.validate.hardening_steps(remapped, ranked)

  // src: outcomes.py:576-589
  quality_notes = []; disclosures = []
  if (checks_on) {
    quality_notes += s8.validate.quality_annotations(item with link_evidence=links, remapped, ranked, repo_root,
      links_ok=links_ok, resolved=resolved_links, hops=hops, hardening=hardening)
  }
  prose_missed = prose.missed minus the ids already named in the step note
  if (prose_missed) {
    COUNTERS.bump("s8_chain_prose_id_unresolved", length(prose_missed))
    append _PROSE_ID_NOTE with ids=first 20 of prose_missed to quality_notes   // annotated, never deleted
  }

  // ---------- severity rule ----------
  // src: outcomes.py:591-632 — FLOOR = strongest deterministic CVSS / VulContextSeverity band among hops; CAP = strongest hop severity
  explained = bool(prose.blocked || prose.preconditions)
  hop_sevs = for each st in remapped: ranked[st].severity
  [model_sev, derived] = _model_or_derived_chain_severity(item.severity, hop_sevs)
  severity = model_sev
  hop_bands = for each st in remapped: sev_from_band(ranked[st].finding.vsvs_rating) or sev_from_band(ranked[st].finding.cvss_rating), when not null
  floor = if (hop_bands) _strongest(hop_bands) else null
  effective = _strongest(hop_sevs)
  allowed = !gate_on || s8.validate.lift_allowed(links_ok, hardening, hedged)
  decision = ""
  if (floor != null && SEV_RANK[model_sev] > SEV_RANK[floor] && (derived || !explained)) {
    // model or derived severity is under the deterministic floor, unexplained
    if (allowed) {
      severity = floor; COUNTERS.bump("s8_chain_severity_lifted")
      narrative = trimmed "$narrative\n\n$_LIFT_NOTE"
    } else {
      COUNTERS.bump("s8_chain_lift_suppressed"); decision = "lift_withheld"   // keeps the reply's rating
    }
  } else if (SEV_RANK[severity] > SEV_RANK[effective] && !explained) {
    COUNTERS.bump("s8_chain_severity_under_hops")   // left alone: hop bands may be model labels
  } else if (SEV_RANK[model_sev] < SEV_RANK[effective]) {
    COUNTERS.bump("s8_chain_severity_raised")
    if (!allowed) { severity = effective; COUNTERS.bump("s8_chain_severity_capped"); decision = "self_raise_capped" }   // hard cap at the strongest hop
  }
  if (decision) append _CAP_ANNOTATION to disclosures   // not gated on chain_quality_checks

  // src: outcomes.py:634-648
  return Chain(title=prose.title or "Unnamed chain", steps=remapped, severity, blocked_by_controls=prose.blocked,
    preconditions=prose.preconditions, link_evidence=links, entry_reachability=prose.reachability,
    quality_notes, disclosures, severity_decision=decision,
    link_coverage = if (checks_on) "$resolved_links/$hops" else "", narrative)
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:243-264
_LIFT_NOTE = "_Severity aligned to the highest-severity finding in this path._"
_CAP_ANNOTATION = "Severity not raised for chain composition: this path's hops are not fully evidenced, or a step supplies no attacker capability."
_PROSE_ID_NOTE = "This chain's prose cites finding id(s) {ids} that name no finding in this report; they are printed as the reply wrote them."

// src: vvaharness/pipeline/stages/s8/outcomes.py:231-240
fn _model_or_derived_chain_severity(raw_severity, hop_sevs):executor=code {
  parsed = _coerce_sev_or_none(raw_severity)
  if (parsed != null) return [parsed, false]   // the reply's own word
  COUNTERS.bump("s8_chain_severity_derived")
  return [_weakest(hop_sevs), true]   // blank: the weakest shipped hop, not INFO
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:486-495
fn _positionally_filled(item):executor=code {
  // fills empty from_id/to_id from adjacent step pairs, only when there is exactly one link per pair and every id is empty
  links = item.link_evidence
  if (!links || length(links) != length(item.steps) - 1 || any link has a non-empty from_id or to_id) return links
  COUNTERS.bump("s8_chain_links_positionally_filled")
  return for each k, ln in links: ln with from_id=item.steps[k], to_id=item.steps[k + 1]
  // preserved: trusts the model's order; out-of-order empty-id links land on the wrong hop (source comment outcomes.py:488)
}

// ---------- the deterministic floor ----------

// src: vvaharness/pipeline/stages/s8/outcomes.py:456-483
fn deterministic_report(ctx, findings, dropped, raw_findings_count, metrics, enrichment_failure):executor=code {
  for each f in findings, f.severity_prose_mismatch = "";
  ranked = for each f in findings: ranked_finding(f, final_severity(f, f.severity), "(enrichment unavailable — severity from CVSS or the detection label)")
  [ranked, _, dropped_out] = _sort_and_remap(ranked, [0..length(findings)-1], dropped)
  return FinalReport(repo_root=ctx.repo_root, findings=ranked, chains=[], dropped=dropped_out, raw_findings_count, metrics,
    summary=templated_summary(ranked), degraded=true, enrichment_unavailable=true,
    degraded_reason="chain/narrative enrichment unavailable: $enrichment_failure")   // stable contract string; later writers append after a semicolon
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:444-453
fn templated_summary(ranked):executor=code {
  if (ranked is empty) return "No verified findings."
  bands = for each severity s in SEV_RANK order with a nonzero count: "${count} ${s.value}", joined by ", "
  return "${length(ranked)} verified finding(s): $bands."
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:428-441
fn _sort_and_remap(ranked, ranked_orig_idx, dropped):executor=code {
  order = severity_sort_order(ranked)
  ranked = ranked in order
  orig_to_sorted = { original index: new position }
  dropped_out = for each d in dropped: if (d.reason == "DUPLICATE" && d.canonical_idx in orig_to_sorted) copy of d with canonical_idx=orig_to_sorted[d.canonical_idx] else d
  return [ranked, orig_to_sorted, dropped_out]
}

// ---------- severity helpers ----------

// src: vvaharness/pipeline/stages/s8/outcomes.py:214-219
CVSS_BAND_TO_SEV = { "critical": Severity.CRITICAL, "high": Severity.HIGH, "medium": Severity.MEDIUM, "low": Severity.LOW }   // no "none" band

// src: vvaharness/pipeline/stages/s8/outcomes.py:356-365
fn sev_from_band(rating):executor=code { return CVSS_BAND_TO_SEV[lowercased trimmed rating] or null }
fn final_severity(finding, llm_label):executor=code {
  // VulContextSeverity (environmental) first, else base CVSS band, else the model's label; OffensivePriority never folded in
  return sev_from_band(finding.vsvs_rating) or sev_from_band(finding.cvss_rating) or llm_label
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:368-378
fn severity_prose_mismatch(model_label, shipped):executor=code {
  if (model_label is shipped) return ""
  return "Model-assessed severity (${model_label.value}) differs from the CVSS/VulContextSeverity band (${shipped.value}) that determines the shipped rating."
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:381-386
fn ranked_finding(finding, severity, notes):executor=code {
  finding.severity = severity; finding.exploitability_notes = notes   // stamped in place, too
  return RankedFinding(finding, severity, exploitability_notes=notes)
}

// src: vvaharness/pipeline/stages/s8/outcomes.py:389-399
fn offensive_rank(finding):executor=code {
  op = uppercased trimmed finding.offensive_priority
  return if (op matches "P<digit>") that digit else 9   // P1 first, unset last
}
fn severity_sort_order(ranked):executor=code { return indices sorted by (SEV_RANK[ranked[k].severity], offensive_rank(ranked[k].finding)) }

// src: vvaharness/pipeline/stages/s8/outcomes.py:221-228
fn _strongest(severities):executor=code { return severity with the lowest SEV_RANK }
fn _weakest(severities):executor=code { return severity with the highest SEV_RANK }

// src: vvaharness/pipeline/stages/s8/outcomes.py:402-425
fn _coerce_sev_or_none(s):executor=code {
  if (!s) return null
  key = lowercased trimmed string(s)
  if (key is a Severity value) return Severity(key)
  if (s is not a string) return null
  token = part of key before the first "/"   // "9.8/10" trims to 9.8
  score = try float(token); catch => return null
  if (score is not finite || !(0.0 <= score && score <= 10.0)) return null
  return sev_from_band(report.cvss.rating(score))   // reuses the CVSS bands; a score of 0.0 rates "None" and maps to null
}
fn coerce_sev(s):executor=code { return _coerce_sev_or_none(s) or Severity.INFO }

// ---------- prose id remapping ----------

// src: vvaharness/pipeline/stages/s8/outcomes.py:252-300
fn _remap_prose_ids(text, display):executor=code {
  // rewrites each prose id token fN (or a run joined by "/", a dash or "..") to its #N; returns [rewritten, unresolved ids]
  // _PROSE_ID_RX rejects ids glued to word characters, paths or file extensions (buf_f1, utils/f2, f1.py)
  // text inside backtick code spans is left untouched
  for each matched token {
    ids = the fN parts; joins = the separators
    if (any id has no display entry) { record those ids as unresolved; keep token unchanged }   // all or none
    else if (two ids, joined by a dash or "..", ascending) {
      // an inclusive range: every member must exist, or the range stays raw
      if (any member missing) { record the gaps; keep token } else replace with members' #N joined by "/"
    }
    else replace each id in place, keeping the joiners
  }
  return [rewritten, unresolved ids deduplicated in order]
}

