// file: vvaharness/remediation_agent/discovery.py
// Locate the newest scan report, load findings (typed findings.json first, legacy Markdown fallback),
// mark already-remediated cases done, select top-N by CVSS and resolve the per-repo output layout.

@executedBy(CODE) @role(types)
record Found(List<RemediationTarget> selected, List<RemediationTarget> discovered) { }

// Real name: Layout (discovery.py:144); renamed here because class Layout is artifacts/layout.pseudo.
@executedBy(CODE) @role(types)
record DiscoveryLayout(Path remDir, Path ckptDir, String runId) { }

@executedBy(CODE) @role(step) @stage("S10")
class RemediationAgentDiscovery {

    Double mtime(Path path) {
        try {
            return path.stat().mtime;                                                               // src: vvaharness/remediation_agent/discovery.py:54
        } catch (OSError e) {
            return null;                                                                            // src: vvaharness/remediation_agent/discovery.py:56  (no cutoff)
        }
    }

    Pair<Path, Integer> locateReport(String repoPath) {
        Path scanDir = ReportParser.findScanDir(repoPath);                                          // src: vvaharness/remediation_agent/discovery.py:61
        if (scanDir == null) return new Pair(null, 1);                                              // src: vvaharness/remediation_agent/discovery.py:65  (no security-scan folder)
        Path report = ReportParser.latestReport(scanDir);                                           // src: vvaharness/remediation_agent/discovery.py:67
        if (report == null) return new Pair(null, 1);                                               // src: vvaharness/remediation_agent/discovery.py:71  (no *_report.md)
        return new Pair(report, 0);                                                                 // src: vvaharness/remediation_agent/discovery.py:72
    }

    Double cvssScoreOf(RemediationTarget target) {
        return target.finding.cvssScore;                                                            // src: vvaharness/remediation_agent/discovery.py:77  (null when only vector/band)
    }

    Set<String> completedCaseIds(String repoPath, Double since, Theta θ) {
        Set<String> done = new Set();
        for (Path casePath : Path.of(repoPath).join(ReportParser.REMEDIATION_DIR_NAME).glob("*/finding_case.json").sorted()) { // src: vvaharness/remediation_agent/discovery.py:92
            FindingCase c;
            try {
                // Cases older than the findings source are stale and ignored.
                if (since != null && casePath.stat().mtime < since) continue;                       // src: vvaharness/remediation_agent/discovery.py:95
                c = Pydantic.validateJson(FindingCase, casePath.readText());                             // src: vvaharness/remediation_agent/discovery.py:97
            } catch (OSError | ValueError e) {
                continue;                                                                           // src: vvaharness/remediation_agent/discovery.py:100
            }
            if (θ["code.remediation_agent.discovery.done_states"].contains(c.state)) done.add(c.caseId); // src: vvaharness/remediation_agent/discovery.py:101
        }
        done.remove("");                                                                            // src: vvaharness/remediation_agent/discovery.py:103
        return done;
    }

    List<RemediationTarget> targetsFromTyped(FinalReport report, Set<String> done) {
        List<RemediationTarget> targets = new List();
        int i = 1;
        for (ReportFinding rf : report.findings) {                                                  // src: vvaharness/remediation_agent/discovery.py:112  (ordinals assigned before the posture drop)
            Finding f = rf.finding;
            f.severity = rf.severity;                                                               // src: vvaharness/remediation_agent/discovery.py:114
            RemediationTarget t = new RemediationTarget(f, i);
            t.done = done.contains(t.caseId());                                                     // src: vvaharness/remediation_agent/discovery.py:116
            targets.add(t);
            i = i + 1;
        }
        return Topspec.dropNonMainChannel(targets);                                                 // src: vvaharness/remediation_agent/discovery.py:118
    }

    Found loadFindings(String repoPath, Path report, Integer top, Theta θ) {
        // Invalid findings.json raises InvalidFindingsJSON: no silent Markdown fallback.
        FinalReport typed = FindingsJson.readFindingsJson(repoPath);                                // src: vvaharness/remediation_agent/discovery.py:124
        Set<String> done = completedCaseIds(repoPath, mtime(typed != null ? FindingsJson.findingsJsonPath(repoPath) : report), θ); // src: vvaharness/remediation_agent/discovery.py:125
        List<RemediationTarget> discovered;
        if (typed != null && θ["code.remediation_agent.discovery.prefer_typed_findings"]) {        // src: vvaharness/remediation_agent/discovery.py:129
            discovered = targetsFromTyped(typed, done);                                             // src: vvaharness/remediation_agent/discovery.py:131
        } else {
            discovered = ReportParser.parseFindings(report.readText());                             // src: vvaharness/remediation_agent/discovery.py:135  (legacy Markdown parse)
            for (RemediationTarget t : discovered) t.done = t.done || done.contains(t.caseId());     // src: vvaharness/remediation_agent/discovery.py:137
        }
        List<RemediationTarget> selected = Select.selectTopLogged(discovered, top);                 // src: vvaharness/remediation_agent/discovery.py:138  (score_of = cvss_score_of)
        return new Found(selected, discovered);                                                     // src: vvaharness/remediation_agent/discovery.py:140
    }

    DiscoveryLayout prepareLayout(String repoPath) {
        // Raises UnsafeArtifactDir rather than following a committed symlink out of the repo.
        Path remDir = OrchestratorArtifacts.artifactDir(repoPath, ReportParser.REMEDIATION_DIR_NAME); // src: vvaharness/remediation_agent/discovery.py:157
        remDir.mkdir();                                                                             // src: vvaharness/remediation_agent/discovery.py:158
        return new DiscoveryLayout(remDir, Path.of(repoPath).join("checkpoints"), Checkpoints.runIdFor(repoPath)); // src: vvaharness/remediation_agent/discovery.py:159
    }
}
