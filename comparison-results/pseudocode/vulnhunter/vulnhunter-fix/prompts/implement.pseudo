        p.step(3, θ["p.implement.collab_round_ends_red_green"]);                                        // src: vulnhunter-fix/prompts/implement.md:553
        p.step(4, θ["p.implement.collab_loop_until_green_no_cap"]);                                     // src: vulnhunter-fix/prompts/implement.md:555
