// file: vvaharness/skills/csrf/SKILL.md
// S4 skill playbook "csrf": state-changing endpoints a third-party origin can forge. Three-part hard gate,
// explicit-exemption exception, per-framework look list, one finding per handler. No probe.sh.

@executedBy(MODEL) @role(skill) @stage("S4")
class CsrfSkill {

    // ---------------------------------------------------------------- procedure (model-executed)

    List<Finding> run(Repo repo, Theta θ) {
        if (!repo.taskMatches(θ["p.skill_csrf.trigger"])) return List.of();                        // src: vvaharness/skills/csrf/SKILL.md:3
        List<Handler> cands = new List<Handler>();
        cands.addAll(lookDjango(repo, θ));
        cands.addAll(lookFlask(repo, θ));
        cands.addAll(lookExpress(repo, θ));
        cands.addAll(lookSpring(repo, θ));
        cands.addAll(lookRails(repo, θ));
        cands.addAll(lookCrossCutting(repo, θ));
        if (θ["p.skill_csrf.look_list_non_exhaustive"]) cands.addAll(repo.otherStateChangingHandlers()); // src: vvaharness/skills/csrf/SKILL.md:49
        List<Finding> out = new List<Finding>();
        for (Handler h : cands.distinct()) {
            if (!hardGate(h, θ)) continue;
            out.add(new Finding(h.functionName, h.file, h.line, "CWE-352"));
        }
        return enumerate(out, θ);
    }

    boolean hardGate(Handler h, Theta θ) {
        boolean a = !θ["p.skill_csrf.gate_state_change"] || h.performsStateChange();               // src: vvaharness/skills/csrf/SKILL.md:30
        boolean b = !θ["p.skill_csrf.gate_cookie_or_basic_auth"] || h.cookieOrBasicAuth();         // src: vvaharness/skills/csrf/SKILL.md:32
        // explicit exemption decorator satisfies (b) alone; report every such state-changing handler
        boolean exempt = h.hasAnyMarker(θ["p.skill_csrf.csrf_exempt_exception_markers"]);           // src: vvaharness/skills/csrf/SKILL.md:40
        if (exempt && θ["p.skill_csrf.csrf_exempt_satisfies_b"]) b = true;                          // src: vvaharness/skills/csrf/SKILL.md:46
        if (exempt && a && θ["p.skill_csrf.csrf_exempt_report_every_handler"]) return true;        // src: vvaharness/skills/csrf/SKILL.md:43
        // (c) no effective defence: token on this handler, SameSite Strict/Lax, Origin/Referer check, custom header
        boolean c = !h.hasAnyDefence(θ["p.skill_csrf.gate_no_effective_defence"]);                   // src: vvaharness/skills/csrf/SKILL.md:34
        if (θ["p.skill_csrf.drop_if_any_condition_absent"] && !(a && b && c)) return false;        // src: vvaharness/skills/csrf/SKILL.md:37
        return a && b && c;
    }

    List<Handler> lookDjango(Repo repo, Theta θ) {
        List<Handler> out = new List<Handler>();
        if (θ["p.skill_csrf.look_django_csrf_exempt"]) out.addAll(repo.handlersDecorated("@csrf_exempt").stateChanging()); // src: vvaharness/skills/csrf/SKILL.md:52
        if (θ["p.skill_csrf.look_django_middleware_absent"] && !repo.settingsMiddleware().contains("CsrfViewMiddleware")) out.addAll(repo.allStateChangingViews()); // src: vvaharness/skills/csrf/SKILL.md:54
        if (θ["p.skill_csrf.look_state_changing_get"]) out.addAll(repo.getHandlersThatMutate());   // src: vvaharness/skills/csrf/SKILL.md:56
        if (θ["p.skill_csrf.look_forms_without_token"]) out.addAll(repo.formsPostingWithoutCsrfToken().targets()); // src: vvaharness/skills/csrf/SKILL.md:59
        if (θ["p.skill_csrf.look_require_post_missing"]) out.addAll(repo.stateChangingHandlersAcceptingGet()); // src: vvaharness/skills/csrf/SKILL.md:60
        if (θ["p.skill_csrf.look_ajax_session_only"]) out.addAll(repo.ajaxEndpointsWithoutHeaderOrBodyToken()); // src: vvaharness/skills/csrf/SKILL.md:61
        return out;
    }

    List<Handler> lookFlask(Repo repo, Theta θ) {
        List<Handler> out = new List<Handler>();
        if (θ["p.skill_csrf.look_flask_wtf_not_initialized"] && !repo.csrfProtectApplied()) out.addAll(repo.postViewsWithSessionAuth()); // src: vvaharness/skills/csrf/SKILL.md:65
        if (θ["p.skill_csrf.look_flask_exempt"]) out.addAll(repo.handlersDecorated("@csrf.exempt").stateChanging()); // src: vvaharness/skills/csrf/SKILL.md:67
        if (θ["p.skill_csrf.look_conditional_before_request_bypass"]) out.addAll(repo.beforeRequestCsrfChecksSkippingUnsafeMethods()); // src: vvaharness/skills/csrf/SKILL.md:68
        return out;
    }

    List<Handler> lookExpress(Repo repo, Theta θ) {
        List<Handler> out = new List<Handler>();
        if (θ["p.skill_csrf.look_express_csurf_coverage"]) out.addAll(repo.stateChangingRoutesNotCoveredBy("csurf")); // src: vvaharness/skills/csrf/SKILL.md:73
        if (θ["p.skill_csrf.look_express_samesite"] && !repo.sessionCookieSameSiteStrictOrLax() && !repo.customHeaderCheck()) out.addAll(repo.stateChangingRoutes()); // src: vvaharness/skills/csrf/SKILL.md:75
        return out;
    }

    List<Handler> lookSpring(Repo repo, Theta θ) {
        List<Handler> out = new List<Handler>();
        if (θ["p.skill_csrf.look_spring_csrf_disable"] && repo.securityConfigHas(".csrf().disable()")) out.addAll(repo.stateChangingRoutes()); // src: vvaharness/skills/csrf/SKILL.md:78
        // enabled by default: only explicit disablement or excluding request matchers count
        if (θ["p.skill_csrf.spring_default_enabled"]) out.addAll(repo.csrfIgnoringMatchers().stateChangingPaths()); // src: vvaharness/skills/csrf/SKILL.md:79
        if (θ["p.skill_csrf.look_spring_samesite_and_token"] && !repo.sessionCookieSameSite() && !repo.csrfTokenChecked()) out.addAll(repo.stateChangingRoutes()); // src: vvaharness/skills/csrf/SKILL.md:81
        return out;
    }

    List<Handler> lookRails(Repo repo, Theta θ) {
        List<Handler> out = new List<Handler>();
        if (θ["p.skill_csrf.look_rails_forgery_bypass"]) out.addAll(repo.actionsWithNullSessionOrSkipVerifyAuthenticityToken()); // src: vvaharness/skills/csrf/SKILL.md:84
        return out;
    }

    List<Handler> lookCrossCutting(Repo repo, Theta θ) {
        List<Handler> out = new List<Handler>();
        if (θ["p.skill_csrf.look_json_content_type_only"]) out.addAll(repo.jsonApisRelyingOnlyOnContentType()); // src: vvaharness/skills/csrf/SKILL.md:88
        if (θ["p.skill_csrf.look_logout_csrf"]) out.addAll(repo.logoutEndpointsWithoutCsrf());     // src: vvaharness/skills/csrf/SKILL.md:91
        // password / email change: highest-severity target, always check specifically
        for (Handler h : repo.passwordOrEmailChangeEndpoints()) { h.priority = θ["p.skill_csrf.password_email_change_always_check"]; out.add(h); } // src: vvaharness/skills/csrf/SKILL.md:93
        return out;
    }

    List<Finding> enumerate(List<Finding> fs, Theta θ) {
        // each handler separate (own function name, file, line); never an omnibus
        if (θ["p.skill_csrf.enum_each_handler_separate"]) fs = fs.distinctBy(f -> f.functionName + f.file + f.line); // src: vvaharness/skills/csrf/SKILL.md:99
        if (θ["p.skill_csrf.never_collapse_omnibus"]) fs.removeIf(f -> f.isOmnibus());              // src: vvaharness/skills/csrf/SKILL.md:100
        return fs;
    }

    // ---------------------------------------------------------------- prompt sections (SKILL.md text, in order)

    Prompt intro(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_csrf.trigger"]);                                                          // src: vvaharness/skills/csrf/SKILL.md:3
        p.persona(θ["p.skill_csrf.persona"]);                                                       // src: vvaharness/skills/csrf/SKILL.md:24
        p.context(θ["p.skill_csrf.attacker_model"]);                                                // src: vvaharness/skills/csrf/SKILL.md:26
        return p;
    }

    Prompt hardGateSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_csrf.gate_state_change"]);                                                // src: vvaharness/skills/csrf/SKILL.md:30
        p.must(θ["p.skill_csrf.gate_cookie_or_basic_auth"]);                                        // src: vvaharness/skills/csrf/SKILL.md:32
        p.checklist(θ["p.skill_csrf.gate_no_effective_defence"]);                                   // src: vvaharness/skills/csrf/SKILL.md:34
        p.forbid(θ["p.skill_csrf.drop_if_any_condition_absent"]);                                   // src: vvaharness/skills/csrf/SKILL.md:37
        return p;
    }

    Prompt exemptionSection(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.skill_csrf.csrf_exempt_exception_markers"]);                               // src: vvaharness/skills/csrf/SKILL.md:40
        p.must(θ["p.skill_csrf.csrf_exempt_report_every_handler"]);                                 // src: vvaharness/skills/csrf/SKILL.md:43
        p.exemption(θ["p.skill_csrf.csrf_exempt_satisfies_b"]);                                     // src: vvaharness/skills/csrf/SKILL.md:46
        return p;
    }

    Prompt whereToLookSection(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.skill_csrf.look_list_non_exhaustive"]);                                         // src: vvaharness/skills/csrf/SKILL.md:49
        p.checklist(θ["p.skill_csrf.look_django_csrf_exempt"]);                                     // src: vvaharness/skills/csrf/SKILL.md:52
        p.checklist(θ["p.skill_csrf.look_django_middleware_absent"]);                               // src: vvaharness/skills/csrf/SKILL.md:54
        p.checklist(θ["p.skill_csrf.look_state_changing_get"]);                                     // src: vvaharness/skills/csrf/SKILL.md:56
        p.checklist(θ["p.skill_csrf.look_forms_without_token"]);                                    // src: vvaharness/skills/csrf/SKILL.md:59
        p.checklist(θ["p.skill_csrf.look_require_post_missing"]);                                   // src: vvaharness/skills/csrf/SKILL.md:60
        p.checklist(θ["p.skill_csrf.look_ajax_session_only"]);                                      // src: vvaharness/skills/csrf/SKILL.md:61
        p.checklist(θ["p.skill_csrf.look_flask_wtf_not_initialized"]);                              // src: vvaharness/skills/csrf/SKILL.md:65
        p.checklist(θ["p.skill_csrf.look_flask_exempt"]);                                           // src: vvaharness/skills/csrf/SKILL.md:67
        p.checklist(θ["p.skill_csrf.look_conditional_before_request_bypass"]);                      // src: vvaharness/skills/csrf/SKILL.md:68
        p.checklist(θ["p.skill_csrf.look_express_csurf_coverage"]);                                 // src: vvaharness/skills/csrf/SKILL.md:73
        p.checklist(θ["p.skill_csrf.look_express_samesite"]);                                       // src: vvaharness/skills/csrf/SKILL.md:75
        p.checklist(θ["p.skill_csrf.look_spring_csrf_disable"]);                                    // src: vvaharness/skills/csrf/SKILL.md:78
        p.rule(θ["p.skill_csrf.spring_default_enabled"]);                                           // src: vvaharness/skills/csrf/SKILL.md:79
        p.checklist(θ["p.skill_csrf.look_spring_samesite_and_token"]);                              // src: vvaharness/skills/csrf/SKILL.md:81
        p.checklist(θ["p.skill_csrf.look_rails_forgery_bypass"]);                                   // src: vvaharness/skills/csrf/SKILL.md:84
        p.checklist(θ["p.skill_csrf.look_json_content_type_only"]);                                 // src: vvaharness/skills/csrf/SKILL.md:88
        p.checklist(θ["p.skill_csrf.look_logout_csrf"]);                                            // src: vvaharness/skills/csrf/SKILL.md:91
        p.must(θ["p.skill_csrf.password_email_change_always_check"]);                               // src: vvaharness/skills/csrf/SKILL.md:93
        return p;
    }

    Prompt enumerationSection(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.skill_csrf.enum_each_handler_separate"]);                                       // src: vvaharness/skills/csrf/SKILL.md:99
        p.forbid(θ["p.skill_csrf.never_collapse_omnibus"]);                                         // src: vvaharness/skills/csrf/SKILL.md:100
        return p;
    }

    Prompt build(Theta θ) {
        Prompt p = new Prompt();
        p.include(intro(θ));
        p.include(hardGateSection(θ));
        p.include(exemptionSection(θ));
        p.include(whereToLookSection(θ));
        p.include(enumerationSection(θ));
        return p;
    }
}
