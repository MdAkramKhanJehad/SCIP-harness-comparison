# vvaharness/backends/harness/claude/facts.py

Stage 11 (validation) fact tools and the persona report channel for the Claude harness, exposed as tools of one in-process MCP server named "facts". Each fact tool runs a code function; the submit tool validates a persona report against `PersonaReport` and stores it in a per-session collector.

Source: `vvaharness/backends/harness/claude/facts.py` (lines 1-199)
Executor: code (tool handlers; the model decides whether to call them)
Called from: `vvaharness/backends/harness/claude/client.py` ClaudeHarness.run_streaming (build_fact_mcp); `vvaharness/backends/harness/claude/options.py` (mcp_name, rewrite_tool_names, SUBMIT_TOOL); `vvaharness/validation/session/launcher.py` (SUBMIT_PROMPT_SUFFIX)

// src: vvaharness/backends/harness/claude/facts.py:35-39
SERVER_NAME = "facts"
TOOL_PREFIX = "mcp__facts__"   // MCP_TOOL_PREFIX ("mcp__", src: vvaharness/backends/harness/models.py:77) + SERVER_NAME + "__"; admitted by permissions.py through MCP_TOOL_PREFIX
SUBMIT_TOOL = "SubmitPersonaReport"   // not a fact tool: the validated channel for a persona verdict
// src: facts.py:17 — no native schema per persona: AgentDefinition has no per-subagent schema field and --json-schema is session-scoped

// src: vvaharness/backends/harness/claude/facts.py:165-174
fn build_fact_mcp(specs: FactToolSpec[], report_model = null):executor=code {
  [tools, names, collector] = build_fact_tools(specs, report_model)
  return [create_sdk_mcp_server(SERVER_NAME, tools), names, collector]   // external: claude_agent_sdk
}

// src: vvaharness/backends/harness/claude/facts.py:146-162
fn build_fact_tools(specs, report_model = null):executor=code {
  collector = PersonaReportCollector()
  tools = for each spec in specs => _fact_tool(spec)
  names = for each spec in specs => mcp_name(spec.name)
  if (report_model != null) {   // client passes PersonaReport, or null when the validation package cannot be imported
    tools += _submit_tool(report_model, collector); names += mcp_name(SUBMIT_TOOL)
  }
  return [tools, names, collector]
}

// src: vvaharness/backends/harness/claude/facts.py:101-114
fn _fact_tool(spec):executor=code {
  // tool offered with spec.name, spec.description, spec.input_schema
  handler(args) {
    try result = spec.fn(**args) on a worker thread   // off the event loop so a large diff does not stall the CLI stream
    catch exc => return _content("${type name}: $exc", is_error=true)   // errors go back to the model, not raised
    return _content(_serialize(result))   // strings as is, else JSON (default=str), else str()
  }
}

// src: vvaharness/backends/harness/claude/facts.py:117-143
fn _submit_tool(report_model, collector):executor=code {
  // tool offered: name SUBMIT_TOOL, input schema = report_model JSON schema without "$schema"
  SubmitToolDescription {
    // prompt-src: vvaharness/backends/harness/claude/facts.py:125-129
    Constraints {
      "Submit your final $report_model_name. Call this exactly once, as your last action. The report is validated on submission; if it is rejected, fix the named fields and call this again."
    }
  }
  handler(args) {
    try report = report_model.model_validate(args)
    catch exc => return _content("Report rejected — not a valid $report_model_name: $exc. Fix the fields named above and call SubmitPersonaReport again.", is_error=true)
    // the model may resubmit; nothing in this code caps the number of submissions
    collector.add(report as JSON dict)
    return _content("Report accepted.")
  }
}

// src: vvaharness/backends/harness/claude/facts.py:57-80
PersonaReportCollector {
  State { reports: [] }   // one collector per session
  add(report) {
    key = (report.persona, report.tracking_id)
    remove earlier reports with the same key; append report   // newest wins per persona
  }
}

// src: vvaharness/backends/harness/claude/facts.py:42-54
fn mcp_name(bare):executor=code { return TOOL_PREFIX + bare }
fn rewrite_tool_names(names, bridged):executor=code {
  // a bare grant of a bridged tool would match nothing, so the persona would lose the tool
  if (names == null) return null   // no tool override
  return for each n in names => if (n in bridged) mcp_name(n) else n
}

// src: vvaharness/backends/harness/claude/facts.py:177-187
// Appended to each persona prompt on this backend only (persona .md files are not edited); installed by vvaharness/validation/session/launcher.py:338 when the Claude backend injects .claude/
SUBMIT_PROMPT_SUFFIX {
  // prompt-src: vvaharness/backends/harness/claude/facts.py:178-186
  Constraints {
    heading: "## Report submission (this run)"
    "Submit your final report by calling the `mcp__facts__SubmitPersonaReport` tool with the report object as its arguments. It is validated on submission and will tell you which fields to fix if it is rejected. Print the same report as a ```json block as well, so it is visible in the transcript."
    "Your fact tools are named with an `mcp__facts__` prefix on this run: `mcp__facts__DiffTouched`, `mcp__facts__ChangedLines`, `mcp__facts__DiffImpactMap`, `mcp__facts__PatternScan`, `mcp__facts__TestInventory`."
  }
}

// abstracted: facts.py:83-98 (_content builds the MCP text payload, adding is_error only when true; _serialize as noted in _fact_tool)
