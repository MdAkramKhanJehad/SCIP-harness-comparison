// file: vulnhunter-fix/scripts/validate-triage.py
// Validates a per-finding triage sidecar (graph_context/<VULN>.json) against references/triage-schema.json before Plan dispatches a worker.

@executedBy(CODE) @role(evaluation) @stage("fix")
class ValidateTriage {

    // callers use run(path); returns ok plus the exit code
    Map run(String path) {
        int rc = validateFile(path);
        return Map.of("ok", rc == 0, "rc", rc);
    }

    // one diagnostic line per schema error: path, json-path joined with slash (or the root marker when empty), message
    String formatError(String path, Error err) {
        String loc = err.absolutePath.map(p -> str(p)).join("/");                  // src: vulnhunter-fix/scripts/validate-triage.py:27
        if (loc.isEmpty()) loc = "<root>";
        return path + ": " + loc + ": " + err.message;
    }

    int validateFile(String path) {
        Map schema = Json.parse(Files.read(skillRoot().join("references", "triage-schema.json")));            // src: vulnhunter-fix/scripts/validate-triage.py:33
        Draft202012Validator.checkSchema(schema);
        Object payload;
        try {
            payload = Json.parse(Files.read(path));                                                           // src: vulnhunter-fix/scripts/validate-triage.py:37
        } catch (OSError e) {
            return 2;                                                                                         // src: vulnhunter-fix/scripts/validate-triage.py:40
        } catch (JSONDecodeError e) {
            return 3;                                                                                         // src: vulnhunter-fix/scripts/validate-triage.py:43
        }
        Validator v = Draft202012Validator.of(schema);                                                        // src: vulnhunter-fix/scripts/validate-triage.py:45
        List<Error> errors = v.iterErrors(payload).sortedBy(e -> e.absolutePath);                             // src: vulnhunter-fix/scripts/validate-triage.py:45
        if (errors.isEmpty()) return 0;                                                                       // src: vulnhunter-fix/scripts/validate-triage.py:47
        for (Error err : errors) Stderr.print(formatError(path, err));
        return 1;                                                                                             // src: vulnhunter-fix/scripts/validate-triage.py:50
    }

    int main(List<String> argv) {
        if (argv.size() != 2) return 64;                                                                      // src: vulnhunter-fix/scripts/validate-triage.py:55
        return validateFile(argv.get(1));
    }
}
