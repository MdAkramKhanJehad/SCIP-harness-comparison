// file: vvaharness/util/json_extract.py
// Pull a JSON object/array out of a model response that may have prose or code fences around it.
// Candidate order: whole-fence body, every fenced block, then the raw text; first parseable span wins.

@executedBy(CODE) @role(rule_set)
class JsonExtract {

    static final Regex FENCE = Regex.of("```(?:json)?\\s*(.*?)\\s*```", DOTALL);  // src: vvaharness/util/json_extract.py:25
    static final Regex FENCE_OPEN = Regex.of(θ["code.util.json_extract.fence_open"]); // src: vvaharness/util/json_extract.py:27
    static final Set<Character> VALID_ESCAPE = Set.characters(θ["code.util.json_extract.valid_escape"]); // src: vvaharness/util/json_extract.py:32

    String repairInvalidEscapes(String s) {
        StringBuilder out = new StringBuilder();
        int i = 0;
        while (i < s.length()) {                                               // src: vvaharness/util/json_extract.py:39
            char ch = s.charAt(i);
            if (ch == '\\') {
                String nxt = i + 1 < s.length() ? s.charAt(i + 1) : "";
                if (VALID_ESCAPE.contains(nxt)) { out.append(ch).append(nxt); i += 2; continue; } // src: vvaharness/util/json_extract.py:43
                out.append("\\\\"); i += 1; continue;                          // invalid/trailing escape -> literal backslash // src: vvaharness/util/json_extract.py:48
            }
            out.append(ch); i += 1;
        }
        return out.toString();
    }

    String balancedSpan(String s, int start) {
        char open = s.charAt(start);
        char close = open == '[' ? ']' : CLOSE_BRACE;                          // matching closer for the opener // src: vvaharness/util/json_extract.py:58
        int depth = 0; boolean inStr = false; boolean esc = false;
        for (int i = start; i < s.length(); i++) {                             // src: vvaharness/util/json_extract.py:62
            char ch = s.charAt(i);
            if (inStr) {
                if (esc) esc = false;
                else if (ch == '\\') esc = true;
                else if (ch == '"') inStr = false;                             // src: vvaharness/util/json_extract.py:69
            } else {
                if (ch == '"') inStr = true;
                else if (ch == open) depth += 1;
                else if (ch == close) { depth -= 1; if (depth == 0) return s.substring(start, i + 1); } // src: vvaharness/util/json_extract.py:78
            }
        }
        return null;                                                           // unbalanced // src: vvaharness/util/json_extract.py:80
    }

    Object extractJson(String text, Theta θ) {
        if (text.length() > θ["code.util.json_extract.max_json_input"]) {      // src: vvaharness/util/json_extract.py:84
            Logs.getLogger("json_extract").warning(Events.JSON_INPUT_TRUNCATED);
            text = text.substring(0, θ["code.util.json_extract.max_json_input"]); // scan the head only // src: vvaharness/util/json_extract.py:86
        }
        String stripped = text.strip();
        List<String> candidates = List.of();
        Match whole = θ["code.util.json_extract.fence_pattern"].fullmatch(stripped); // src: vvaharness/util/json_extract.py:91
        if (whole != null) candidates.add(whole.group(1));                     // src: vvaharness/util/json_extract.py:93
        candidates.addAll(θ["code.util.json_extract.fence_pattern"].findall(text)); // src: vvaharness/util/json_extract.py:94
        candidates.add(text);                                                  // whole response is always the last candidate // src: vvaharness/util/json_extract.py:95

        String peek = FENCE_OPEN.sub("", stripped, 1);                         // src: vvaharness/util/json_extract.py:98
        boolean wantDict = θ["code.util.json_extract.prefer_object_when_reply_starts_with_brace"] && peek.startsWith(OPEN_BRACE); // src: vvaharness/util/json_extract.py:99
        List heldList = null; Exception lastErr = null;

        for (String cand : candidates) {                                       // src: vvaharness/util/json_extract.py:103
            int i = 0;
            while (i < cand.length()) {
                if (!isOpener(cand.charAt(i))) { i += 1; continue; }           // object or array opener // src: vvaharness/util/json_extract.py:106
                String span = balancedSpan(cand, i);                           // src: vvaharness/util/json_extract.py:109
                if (span == null) { i += 1; continue; }                        // stray opener in prose: keep scanning // src: vvaharness/util/json_extract.py:110
                Object val = null;
                try { val = Json.parse(span); }                                // src: vvaharness/util/json_extract.py:116
                catch (JsonDecodeError e) {
                    lastErr = e;
                    if (θ["code.util.json_extract.repair_invalid_escapes"]) {  // LLMs emit invalid backslash escapes // src: vvaharness/util/json_extract.py:120
                        String repaired = repairInvalidEscapes(span);
                        if (repaired != span) {
                            try { val = Json.parse(repaired); } catch (JsonDecodeError e2) { } // src: vvaharness/util/json_extract.py:123
                        }
                    }
                }
                if (val == null) { i += span.length(); continue; }             // src: vvaharness/util/json_extract.py:126
                if (wantDict && val instanceof List) {                         // hold a sub-list, keep looking for an object // src: vvaharness/util/json_extract.py:129
                    if (heldList == null) heldList = val;
                    i += span.length(); continue;
                }
                return val;                                                    // first usable value wins // src: vvaharness/util/json_extract.py:134
            }
        }
        if (heldList != null) return heldList;                                 // src: vvaharness/util/json_extract.py:136
        if (lastErr != null) throw lastErr;                                    // src: vvaharness/util/json_extract.py:138
        throw new ValueError("no JSON object found in response");              // src: vvaharness/util/json_extract.py:140
    }

    // caller alias (pass-1 files call JsonExtract.extract) for extract_json
    Object extract(String text, Theta θ) {
        return extractJson(text, θ);
    }
}
