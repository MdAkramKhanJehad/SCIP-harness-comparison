// file: vvaharness/validation/io/persona_report_stash.py
// Pulls persona reports out of the session's terminal state: pre-parsed SDK/CLI reports, or JSON
// ToolMessages in the DeepAgents graph state. Validates and dedupes them.

@executedBy(CODE) @role(io) @stage("S11")
class PersonaReportStash {

    List<PersonaReport> validateCandidates(List<Object> candidates, Theta θ) {
        List<PersonaReport> reports = new List();
        Set<Object> seen = new Set();
        for (Object data : candidates) {                                                             // src: vvaharness/validation/io/persona_report_stash.py:36
            if (!(data instanceof Map)) continue;                                                    // src: vvaharness/validation/io/persona_report_stash.py:37
            if (!data.containsKey("persona") || !data.containsKey("gates")) continue;                // src: vvaharness/validation/io/persona_report_stash.py:39
            Object key = θ["code.validation.io.persona_report_stash.dedup_key"].of(data);            // (persona, tracking_id): first report wins  // src: vvaharness/validation/io/persona_report_stash.py:41
            if (seen.contains(key)) continue;                                                        // src: vvaharness/validation/io/persona_report_stash.py:42
            seen.add(key);
            try {
                reports.add(Pydantic.modelValidate(PersonaReport, data));                                      // src: vvaharness/validation/io/persona_report_stash.py:46
            } catch (ValidationError e) {
                continue;                                                                            // invalid report silently dropped  // src: vvaharness/validation/io/persona_report_stash.py:48
            }
        }
        return reports;
    }

    List<PersonaReport> extractSubagentReports(HarnessTerminalState finalState, Theta θ) {
        if (finalState.containsKey("sdk_persona_reports")) return validateCandidates(finalState.get("sdk_persona_reports"), θ); // SDK/CLI path  // src: vvaharness/validation/io/persona_report_stash.py:57
        List<Object> candidates = new List();
        for (Object msg : finalState.getOrDefault("messages", List.of())) {                          // DeepAgents path  // src: vvaharness/validation/io/persona_report_stash.py:62
            if (!(msg instanceof ToolMessage)) continue;                                             // src: vvaharness/validation/io/persona_report_stash.py:63
            Object content = msg.content;
            if (content instanceof List) content = content.isEmpty() ? "" : content.get(0);          // src: vvaharness/validation/io/persona_report_stash.py:66
            if (!(content instanceof String) || content.length() > θ["code.validation.io.persona_report_stash.max_tool_message_chars"] || content.strip().isEmpty()) continue; // src: vvaharness/validation/io/persona_report_stash.py:68
            try {
                candidates.add(Json.loads(content.strip()));                                         // src: vvaharness/validation/io/persona_report_stash.py:75
            } catch (JSONDecodeError e) {
                continue;                                                                            // src: vvaharness/validation/io/persona_report_stash.py:77
            }
        }
        return validateCandidates(candidates, θ);                                                    // src: vvaharness/validation/io/persona_report_stash.py:80
    }
}
