// file: vulnhunt/phases/phase1_recon.md
// Phase 1 recon subagent: maps the attack surface (files, sink inventory, input inventory, indirect dispatch,
// call graph + union-find partitions, authz gate audit, auth paths, threat model, trust boundaries, build swapping)
// and writes phase1_output.md, whose partition and inventory tables drive Phase 2 dispatch.

@executedBy(MODEL) @role(prompt) @stage("phase1")
class Phase1Recon {

    // Entry: the procedure the recon subagent carries out, steps in file order.
    @executedBy(MODEL)
    ReconReport run(String vulnhuntDir, Theta θ) {
        Prompt p = prompt(θ);
        Structure s = step1StructuralOverview(θ);                                                // src: vulnhunt/phases/phase1_recon.md:10
        SinkInventory sinks = step1aSinkPrepass(s, θ);                                           // src: vulnhunt/phases/phase1_recon.md:24
        Inventory inv = step1bInputInventory(s, θ);                                              // src: vulnhunt/phases/phase1_recon.md:51
        step1cIndirectDispatch(inv, θ);                                                          // src: vulnhunt/phases/phase1_recon.md:172
        Partitioning parts = step1dPartition(s, inv, sinks, θ);                                  // src: vulnhunt/phases/phase1_recon.md:218
        step1eAuthzGateAudit(inv, θ);                                                            // src: vulnhunt/phases/phase1_recon.md:344
        step1fAuthPathEnumeration(inv, θ);                                                       // src: vulnhunt/phases/phase1_recon.md:367
        List<ThreatRow> tm = step2ThreatModel(inv, θ);                                           // src: vulnhunt/phases/phase1_recon.md:380
        List<Boundary> tb = step3TrustBoundaries(s, inv, θ);                                     // src: vulnhunt/phases/phase1_recon.md:459
        Path prodDir = step4BuildSwapDetection(θ);                                               // src: vulnhunt/phases/phase1_recon.md:467
        return writeReconOutput(vulnhuntDir + "/phase1_output.md", s, inv, tm, tb, parts, θ);    // src: vulnhunt/phases/phase1_recon.md:487
    }

    // ---------------- prompt sections, in file order ----------------

    @executedBy(MODEL) @role(prompt)
    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.context("Mandatory First Actions done; Operating Principles and Investigation Discipline in effect"); // src: vulnhunt/phases/phase1_recon.md:3
        p.include(VulnhuntInvestigationDiscipline.prompt(θ));                                    // src: vulnhunt/phases/phase1_recon.md:5
        if (θ["p.phase1_recon.map_surface_before_hunting"]) p.rule("map the complete attack surface before looking for specific vulnerabilities"); // src: vulnhunt/phases/phase1_recon.md:7
        p.include(structuralOverviewText(θ));
        p.include(sinkPrepassText(θ));
        p.include(inputInventoryText(θ));
        p.include(indirectDispatchText(θ));
        p.include(partitioningText(θ));
        p.include(authzGateText(θ));
        p.include(authPathText(θ));
        p.include(threatModelText(θ));
        p.include(trustBoundaryText(θ));
        p.include(buildSwapText(θ));
        p.include(reconOutputText(θ));
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt structuralOverviewText(Theta θ) {
        Prompt p = new Prompt();
        p.rule("discover all production source files with " + θ["p.phase1_recon.glob_file_discovery"]); // src: vulnhunt/phases/phase1_recon.md:12
        if (θ["p.phase1_recon.parallel_glob_calls"]) p.rule("run one Glob per language extension, in parallel"); // src: vulnhunt/phases/phase1_recon.md:13
        p.checklist(θ["p.phase1_recon.language_extension_list"]);                                // src: vulnhunt/phases/phase1_recon.md:15
        if (θ["p.phase1_recon.exclude_non_production_dirs"]) p.forbid("exclude test, vendor, generated, third-party directories (Operating Principle 5)"); // src: vulnhunt/phases/phase1_recon.md:18
        p.checklist(θ["p.phase1_recon.structural_overview_outputs"]);                            // src: vulnhunt/phases/phase1_recon.md:20
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt sinkPrepassText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.scope.sink_prepass"]) p.step(1, "Sink Enumeration Pre-Pass");              // src: vulnhunt/phases/phase1_recon.md:24
        if (θ["p.phase1_recon.sink_prepass_before_inventory"]) p.rule("grep ALL dangerous sink patterns from the Phase 2 Sink Reference before building the input inventory"); // src: vulnhunt/phases/phase1_recon.md:26
        if (θ["p.phase1_recon.sink_patterns_framework_adapted"]) p.rule("adapt sink patterns to detected frameworks, including template-level sinks ([href], v-html)"); // src: vulnhunt/phases/phase1_recon.md:27
        if (θ["p.phase1_recon.sink_inventory_file_line"]) p.format("record each sink's file:line in a sink inventory"); // src: vulnhunt/phases/phase1_recon.md:28
        if (θ["p.phase1_recon.sink_grep_truncation_rescope"]) p.rule("exclude test/spec files; if results are truncated run scoped greps per app/lib directory"); // src: vulnhunt/phases/phase1_recon.md:30
        if (θ["p.phase1_recon.sink_completeness_crosscheck"]) p.must("MANDATORY: confirm every app/module from Step 1 has at least one sink entry"); // src: vulnhunt/phases/phase1_recon.md:33
        if (θ["p.phase1_recon.zero_sink_app_targeted_grep"]) p.must("for EACH app with zero sinks run a separate targeted grep in its source dir and libs/"); // src: vulnhunt/phases/phase1_recon.md:35
        if (θ["p.phase1_recon.shared_libs_in_app_coverage"]) p.rule("shared libraries serving an app count in that app's coverage check"); // src: vulnhunt/phases/phase1_recon.md:39
        if (θ["p.phase1_recon.url_concat_sink_sweep"]) p.must("MANDATORY: grep all production files for string concatenation/interpolation into HTTP client URL arguments"); // src: vulnhunt/phases/phase1_recon.md:42
        if (θ["p.phase1_recon.url_concat_sink_even_if_base_hardcoded"]) p.rule("these are SSRF/path-traversal sinks even when the base URL is hardcoded"); // src: vulnhunt/phases/phase1_recon.md:46
        if (θ["p.phase1_recon.shared_lib_sink_in_every_partition"]) p.rule("a shared-library sink file joins the file list of every partition whose inputs reach it"); // src: vulnhunt/phases/phase1_recon.md:48
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt inputInventoryText(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["prompt.scope.input_inventory"]);                                               // src: vulnhunt/phases/phase1_recon.md:51
        if (θ["p.phase1_recon.enumerate_every_input"]) p.must("enumerate every point where external data enters the codebase"); // src: vulnhunt/phases/phase1_recon.md:53
        if (θ["p.phase1_recon.audit_done_only_when_inventory_resolved"]) p.rule("the audit is not done until the inventory is fully resolved"); // src: vulnhunt/phases/phase1_recon.md:55
        p.rule("find inputs with " + θ["p.phase1_recon.grep_for_inputs"]);                       // src: vulnhunt/phases/phase1_recon.md:58
        if (θ["p.phase1_recon.no_verbatim_example_patterns"]) p.forbid("do NOT use the example patterns verbatim; build patterns from what Step 1 found"); // src: vulnhunt/phases/phase1_recon.md:59
        p.checklist(θ["p.phase1_recon.entry_point_types"]);                                      // src: vulnhunt/phases/phase1_recon.md:64
        if (θ["p.phase1_recon.cron_store_values_are_inputs"]) p.rule("scheduled jobs reading attacker-writable stores: the store values are inputs"); // src: vulnhunt/phases/phase1_recon.md:72
        if (θ["p.phase1_recon.interceptor_response_handlers"]) p.rule("interceptors reading response/error body fields and passing them on are entry points"); // src: vulnhunt/phases/phase1_recon.md:73
        if (θ["p.phase1_recon.filters_with_direct_response_sinks"]) p.rule("filters/middleware that respond directly without a controller are independent entry points"); // src: vulnhunt/phases/phase1_recon.md:78
        if (θ["p.phase1_recon.framework_infrastructure_endpoints"]) p.rule("search bootstrap/config for extra framework listeners: management, probes, remoting, debug"); // src: vulnhunt/phases/phase1_recon.md:84
        p.checklist(θ["p.phase1_recon.infra_endpoint_four_checks"]);                             // src: vulnhunt/phases/phase1_recon.md:89
        if (θ["p.phase1_recon.unauth_management_endpoint_is_finding"]) p.rule("unauthenticated management endpoint or unencrypted remoting port is a finding"); // src: vulnhunt/phases/phase1_recon.md:90
        if (θ["p.phase1_recon.extend_input_api_list"]) p.rule("add project-specific wrappers, custom parsers and plugins beyond the examples"); // src: vulnhunt/phases/phase1_recon.md:96
        p.checklist(θ["p.phase1_recon.input_vector_categories"]);                                // src: vulnhunt/phases/phase1_recon.md:101
        if (θ["p.phase1_recon.env_and_config_as_inputs"]) p.rule("env vars and config a deployment-adjacent attacker could influence are inputs"); // src: vulnhunt/phases/phase1_recon.md:109
        if (θ["p.phase1_recon.second_order_db_reads_as_inputs"]) p.rule("database reads of attacker-writable values are second-order inputs"); // src: vulnhunt/phases/phase1_recon.md:114
        if (θ["p.phase1_recon.third_party_responses_as_inputs"]) p.rule("attacker-influenceable third-party API responses are inputs"); // src: vulnhunt/phases/phase1_recon.md:116
        if (θ["p.phase1_recon.promoted_server_variables"]) p.rule("normally-trusted server variables promoted by repo config are inputs"); // src: vulnhunt/phases/phase1_recon.md:119
        p.checklist(θ["p.phase1_recon.promotion_directive_grep_list"]);                          // src: vulnhunt/phases/phase1_recon.md:121
        p.threshold(θ["p.phase1_recon.broad_cidr_promotion_rule"]);                              // src: vulnhunt/phases/phase1_recon.md:123
        if (θ["p.phase1_recon.extend_input_vectors"]) p.rule("add input vectors from custom abstractions even if not listed"); // src: vulnhunt/phases/phase1_recon.md:126
        p.format(θ["p.phase1_recon.input_record_fields"]);                                       // src: vulnhunt/phases/phase1_recon.md:130
        if (θ["p.phase1_recon.input_location_file_line"]) p.evidence("Location: file:line where the input enters"); // src: vulnhunt/phases/phase1_recon.md:131
        p.choose(θ["p.phase1_recon.trust_levels"]);                                              // src: vulnhunt/phases/phase1_recon.md:137
        p.format(θ["p.phase1_recon.inventory_table_format"]);                                    // src: vulnhunt/phases/phase1_recon.md:140
        p.rule(θ["p.phase1_recon.lowest_trust_first"]);                                          // src: vulnhunt/phases/phase1_recon.md:150
        if (θ["p.phase1_recon.entry_point_inventory_completeness"]) p.must("every entry point from Step 1 has at least one input"); // src: vulnhunt/phases/phase1_recon.md:155
        if (θ["p.phase1_recon.zero_input_entry_point_reread"]) p.rule("zero-input entry point: go back and read its code"); // src: vulnhunt/phases/phase1_recon.md:158
        p.format(θ["p.phase1_recon.synthetic_no_input_entry"]);                                  // src: vulnhunt/phases/phase1_recon.md:160
        p.rule("sensitive no-input endpoint without auth is an auth bypass candidate " + θ["p.phase1_recon.no_input_endpoint_cwe306"]); // src: vulnhunt/phases/phase1_recon.md:162
        if (θ["p.phase1_recon.sibling_input_rule"]) p.must("an extraction point yielding N inputs: enumerate ALL N"); // src: vulnhunt/phases/phase1_recon.md:166
        if (θ["p.phase1_recon.same_name_across_routes_separate"]) p.rule("grep each parameter name across ALL entry points; same name at a different route is a separate input"); // src: vulnhunt/phases/phase1_recon.md:168
        if (θ["p.phase1_recon.phase1_does_not_judge_safety"]) p.forbid("Phase 2 determines safety, not Phase 1"); // src: vulnhunt/phases/phase1_recon.md:170
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt indirectDispatchText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.scope.indirect_dispatch"]) p.step(3, "Indirect Dispatch Detection");       // src: vulnhunt/phases/phase1_recon.md:172
        p.checklist(θ["p.phase1_recon.indirect_dispatch_patterns"]);                             // src: vulnhunt/phases/phase1_recon.md:174
        if (θ["p.phase1_recon.enumerate_dispatch_table"]) p.step(1, "enumerate every function in the dispatch table / callback registry"); // src: vulnhunt/phases/phase1_recon.md:189
        if (θ["p.phase1_recon.dispatch_targets_as_entry_points"]) p.step(2, "add each as a separate entry point in the inventory"); // src: vulnhunt/phases/phase1_recon.md:190
        p.format(θ["p.phase1_recon.indirect_dispatch_flag"]);                                    // src: vulnhunt/phases/phase1_recon.md:192
        if (θ["p.phase1_recon.actor_framework_audit"]) p.rule("actor/message frameworks: audit message routing and entity identity"); // src: vulnhunt/phases/phase1_recon.md:199
        if (θ["p.phase1_recon.entity_id_construction_audit"]) p.rule("entity IDs concatenating user fields without unambiguous delimiters can collide"); // src: vulnhunt/phases/phase1_recon.md:202
        if (θ["p.phase1_recon.cached_state_reuse_audit"]) p.rule("cache keys for cached auth decisions/credentials must be collision-resistant"); // src: vulnhunt/phases/phase1_recon.md:209
        if (θ["p.phase1_recon.distinct_auth_context_distinct_id"]) p.must("different authorization contexts MUST map to different entity/cache IDs"); // src: vulnhunt/phases/phase1_recon.md:212
        if (θ["p.phase1_recon.always_read_companion_objects"]) p.must("always read companion objects / factories defining dispatch identity"); // src: vulnhunt/phases/phase1_recon.md:214
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt partitioningText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase1_recon.partition_goal_shared_flow"]) p.rule("group inputs whose flows share app-specific code; one coherent slice per agent"); // src: vulnhunt/phases/phase1_recon.md:222
        p.threshold(θ["prompt.recon.callgraph_depth"]);                                          // src: vulnhunt/phases/phase1_recon.md:229
        if (θ["p.phase1_recon.callgraph_level1_definition"]) p.rule("Level 1: codebase-defined functions the handler calls, with files"); // src: vulnhunt/phases/phase1_recon.md:232
        if (θ["p.phase1_recon.callgraph_level2_definition"]) p.rule("Level 2: same listing for each Level 1 function"); // src: vulnhunt/phases/phase1_recon.md:235
        if (θ["p.phase1_recon.callgraph_records_sinks"]) p.rule("record which dangerous sink APIs each chain reaches"); // src: vulnhunt/phases/phase1_recon.md:238
        if (θ["p.phase1_recon.callgraph_no_data_flow"]) p.forbid("do not trace data flow here; call-level connectivity only"); // src: vulnhunt/phases/phase1_recon.md:239
        p.format(θ["p.phase1_recon.callgraph_table_format"]);                                    // src: vulnhunt/phases/phase1_recon.md:242
        p.threshold(θ["prompt.recon.callgraph_call_budget"]);                                    // src: vulnhunt/phases/phase1_recon.md:249
        if (θ["p.phase1_recon.shared_infra_factored_out"]) p.rule("factor cross-cutting infrastructure out of the connectivity analysis"); // src: vulnhunt/phases/phase1_recon.md:254
        p.threshold(θ["prompt.recon.shared_infra_import_share"]);                                // src: vulnhunt/phases/phase1_recon.md:259
        p.checklist(θ["p.phase1_recon.shared_infra_explicit_list"]);                             // src: vulnhunt/phases/phase1_recon.md:262
        p.format(θ["p.phase1_recon.shared_infra_catalog_format"]);                               // src: vulnhunt/phases/phase1_recon.md:272
        if (θ["p.phase1_recon.catalog_is_reference_not_scope"]) p.rule("the catalog is reference context for trace agents, not their trace scope"); // src: vulnhunt/phases/phase1_recon.md:280
        if (θ["p.phase1_recon.config_module_sink_exception"]) p.exemption("config modules interpolating parameters into URLs/queries/commands are app-specific sinks"); // src: vulnhunt/phases/phase1_recon.md:284
        p.rule(θ["prompt.recon.partition_rule"]);                                                // src: vulnhunt/phases/phase1_recon.md:289
        p.rule(θ["p.phase1_recon.union_find_partitioning"]);                                     // src: vulnhunt/phases/phase1_recon.md:292
        p.format(θ["p.phase1_recon.partition_table_format"]);                                    // src: vulnhunt/phases/phase1_recon.md:300
        p.threshold(θ["prompt.recon.oversize_inputs"]);                                          // src: vulnhunt/phases/phase1_recon.md:312
        p.threshold(θ["prompt.recon.oversize_files"]);                                           // src: vulnhunt/phases/phase1_recon.md:312
        p.rule(θ["p.phase1_recon.oversize_split_method"]);                                       // src: vulnhunt/phases/phase1_recon.md:313
        if (θ["p.phase1_recon.single_connector_promotion"]) p.rule("a single function connecting everything is promoted to shared infra; recompute"); // src: vulnhunt/phases/phase1_recon.md:315
        p.threshold(θ["p.phase1_recon.monolithic_sequential_fallback"]);                         // src: vulnhunt/phases/phase1_recon.md:318
        p.threshold(θ["prompt.recon.undersize_rule"]);                                           // src: vulnhunt/phases/phase1_recon.md:321
        p.rule(θ["p.phase1_recon.undersize_merge_target"]);                                      // src: vulnhunt/phases/phase1_recon.md:322
        if (θ["prompt.scope.dev_only_skip"]) p.rule("DEV-ONLY partitions are not dispatched");    // src: vulnhunt/phases/phase1_recon.md:324
        if (θ["p.phase1_recon.reachability_per_partition"]) p.must("verify production reachability for EACH partition"); // src: vulnhunt/phases/phase1_recon.md:326
        if (θ["p.phase1_recon.read_route_mounting_for_env_gate"]) p.rule("read route-mounting code for an environment gate"); // src: vulnhunt/phases/phase1_recon.md:327
        p.choose(θ["p.phase1_recon.partition_reachability_labels"]);                             // src: vulnhunt/phases/phase1_recon.md:330
        if (θ["p.phase1_recon.reachability_code_evidence_only"]) p.evidence("file:line of actual code, not naming or comments"); // src: vulnhunt/phases/phase1_recon.md:331
        if (θ["p.phase1_recon.dev_only_not_dispatched"]) p.forbid("DEV-ONLY partitions are NOT dispatched to trace agents"); // src: vulnhunt/phases/phase1_recon.md:334
        if (θ["p.phase1_recon.dev_only_skip_record"]) p.format("SG-N: SKIPPED - entry point gated by [file:line], only reachable in [env]"); // src: vulnhunt/phases/phase1_recon.md:335
        p.format(θ["p.phase1_recon.dev_only_inputs_marked_safe"]);                               // src: vulnhunt/phases/phase1_recon.md:336
        if (θ["prompt.scope.partition_coverage_check"]) p.must("MANDATORY partition coverage check: every production app appears in a partition"); // src: vulnhunt/phases/phase1_recon.md:338
        if (θ["p.phase1_recon.zero_coverage_app_recovery"]) p.rule("uncovered app: redo Steps 1a/1b for it and create or merge a partition"); // src: vulnhunt/phases/phase1_recon.md:340
        if (θ["p.phase1_recon.per_app_pass_fail_list"]) p.format("explicit per-app pass/fail list"); // src: vulnhunt/phases/phase1_recon.md:342
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt authzGateText(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.phase1_recon.authz_gate_grep_patterns"]);                               // src: vulnhunt/phases/phase1_recon.md:346
        if (θ["p.phase1_recon.authz_check_receiver_type"]) p.rule("CANDIDATE: .contains() on a String, not a collection"); // src: vulnhunt/phases/phase1_recon.md:351
        if (θ["p.phase1_recon.authz_check_allowlist_loading"]) p.rule("CANDIDATE: allowlist loaded via getString/getProperty without split()"); // src: vulnhunt/phases/phase1_recon.md:352
        if (θ["p.phase1_recon.authz_check_comparison_direction"]) p.rule("CANDIDATE: input.contains(allowlistValue), reversed"); // src: vulnhunt/phases/phase1_recon.md:353
        if (θ["p.phase1_recon.authz_check_ambiguous_classification"]) p.rule("CANDIDATE: unanchored match on attacker input classifies into a security-relevant category"); // src: vulnhunt/phases/phase1_recon.md:354
        if (θ["p.phase1_recon.latent_gate_candidate"]) p.rule("any match is a CANDIDATE even if no inventoried input reaches it"); // src: vulnhunt/phases/phase1_recon.md:356
        p.format(θ["p.phase1_recon.gate_logic_inventory_entries"]);                              // src: vulnhunt/phases/phase1_recon.md:357
        if (θ["p.phase1_recon.classification_consistency_check"]) p.rule("grep all sites deriving the same security dimension from the same input"); // src: vulnhunt/phases/phase1_recon.md:360
        if (θ["p.phase1_recon.inconsistent_classifier_candidate"]) p.rule("two sites using different logic -> CANDIDATE"); // src: vulnhunt/phases/phase1_recon.md:363
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt authPathText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase1_recon.auth_path_enumeration"]) p.rule("for entry points returning credentials/authz decisions enumerate every auth branch"); // src: vulnhunt/phases/phase1_recon.md:369
        p.format(θ["p.phase1_recon.auth_branch_record_fields"]);                                 // src: vulnhunt/phases/phase1_recon.md:371
        if (θ["p.phase1_recon.unverified_identity_branch_flag"]) p.rule("flag any branch accepting identity without cryptographic verification"); // src: vulnhunt/phases/phase1_recon.md:374
        p.format(θ["p.phase1_recon.auth_bypass_path_entries"]);                                  // src: vulnhunt/phases/phase1_recon.md:375
        p.checklist(θ["p.phase1_recon.bypass_comment_grep"]);                                    // src: vulnhunt/phases/phase1_recon.md:377
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt threatModelText(Theta θ) {
        Prompt p = new Prompt();
        p.format(θ["prompt.threat_model_fields"]);                                               // src: vulnhunt/phases/phase1_recon.md:380
        if (θ["p.phase1_recon.threat_model_code_evidence"]) p.evidence("derive from audited-code evidence only"); // src: vulnhunt/phases/phase1_recon.md:382
        p.rule("prose about upstream protection only -> " + θ["p.phase1_recon.prose_not_admissible"]); // src: vulnhunt/phases/phase1_recon.md:383
        p.persona(θ["prompt.recon_stance"]);                                                     // src: vulnhunt/phases/phase1_recon.md:387
        if (θ["p.phase1_recon.phase1_pessimistic_stance"]) p.rule("record what the audited code does at face value"); // src: vulnhunt/phases/phase1_recon.md:387
        if (θ["p.phase1_recon.no_upstream_credit_in_recon"]) p.forbid("do not credit upstream signals or known-library shortcuts"); // src: vulnhunt/phases/phase1_recon.md:388
        if (θ["p.phase1_recon.downgrades_deferred_to_2b"]) p.rule("downgrades for verified upstream delegation are phase2b_verify.md section 8's job"); // src: vulnhunt/phases/phase1_recon.md:389
        p.format(θ["p.phase1_recon.threat_model_row_granularity"]);                              // src: vulnhunt/phases/phase1_recon.md:393
        if (θ["p.phase1_recon.threat_model_as_table"]) p.format("output Step 2 as the table, not prose bullets"); // src: vulnhunt/phases/phase1_recon.md:396
        if (θ["p.phase1_recon.field_app_layer_auth_enforcement"]) p.format("App-layer auth enforcement: file:line of code that rejects credential-less requests, or NONE"); // src: vulnhunt/phases/phase1_recon.md:401
        if (θ["p.phase1_recon.field_caller_identity_binding"]) p.format("Caller identity binding: file:line of code that cryptographically verifies a credential, or NONE"); // src: vulnhunt/phases/phase1_recon.md:403
        if (θ["p.phase1_recon.unverified_header_not_binding"]) p.forbid("a principal built from an unverified header does not qualify"); // src: vulnhunt/phases/phase1_recon.md:406
        if (θ["p.phase1_recon.field_per_resource_authorization"]) p.format("Per-resource authorization: file:line authorizing the bound caller for this resource, or NONE"); // src: vulnhunt/phases/phase1_recon.md:407
        if (θ["p.phase1_recon.authz_field_requires_other_two"]) p.rule("authorization only meaningful when the two fields above are non-NONE"); // src: vulnhunt/phases/phase1_recon.md:409
        p.rule(θ["p.phase1_recon.profile_all_none"]);                                            // src: vulnhunt/phases/phase1_recon.md:412
        p.rule(θ["p.phase1_recon.profile_authz_missing"]);                                       // src: vulnhunt/phases/phase1_recon.md:413
        p.rule(θ["p.phase1_recon.profile_all_present"]);                                         // src: vulnhunt/phases/phase1_recon.md:415
        if (θ["p.phase1_recon.field_attacker_controls"]) p.format("Attacker controls: input rows reachable from this group"); // src: vulnhunt/phases/phase1_recon.md:416
        if (θ["p.phase1_recon.field_attacker_does_not_control"]) p.format("Attacker does NOT control: server-side values"); // src: vulnhunt/phases/phase1_recon.md:417
        if (θ["p.phase1_recon.field_existing_capabilities_gate3_baseline"]) p.format("Existing attacker capabilities: the Gate 3 baseline"); // src: vulnhunt/phases/phase1_recon.md:419
        p.rule(θ["p.phase1_recon.all_none_baseline_constraint"]);                                // src: vulnhunt/phases/phase1_recon.md:422
        if (θ["p.phase1_recon.no_baseline_from_missing_auth"]) p.forbid("do NOT derive baseline capabilities from the absence of auth"); // src: vulnhunt/phases/phase1_recon.md:423
        p.rule(θ["p.phase1_recon.all_none_ops_still_cwe306_639"]);                               // src: vulnhunt/phases/phase1_recon.md:426
        if (θ["p.phase1_recon.non_network_entry_point_substitution"]) p.rule("non-network entry points: substitute the execution boundary"); // src: vulnhunt/phases/phase1_recon.md:429
        p.checklist(θ["prompt.inadmissible_evidence"]);                                          // src: vulnhunt/phases/phase1_recon.md:433
        p.rule("anti-pattern is the only basis -> " + θ["p.phase1_recon.inadmissible_only_basis_none"]); // src: vulnhunt/phases/phase1_recon.md:435
        if (θ["p.phase1_recon.antipattern_path_naming"]) p.forbid("path or route naming");        // src: vulnhunt/phases/phase1_recon.md:438
        if (θ["p.phase1_recon.antipattern_comments"]) p.forbid("comments/doc-strings/constants asserting upstream protection"); // src: vulnhunt/phases/phase1_recon.md:440
        if (θ["p.phase1_recon.antipattern_auth_optout_config"]) p.forbid("config opting the entry point out of auth"); // src: vulnhunt/phases/phase1_recon.md:443
        if (θ["p.phase1_recon.antipattern_optional_client_auth"]) p.forbid("transport settings that request but do not require a client credential"); // src: vulnhunt/phases/phase1_recon.md:446
        if (θ["p.phase1_recon.antipattern_deployment_inference"]) p.forbid("deployment-context inference (VPC, mesh, env name)"); // src: vulnhunt/phases/phase1_recon.md:449
        if (θ["p.phase1_recon.antipattern_upstream_claims"]) p.forbid("upstream proxy/gateway claims not cryptographically bound"); // src: vulnhunt/phases/phase1_recon.md:450
        if (θ["p.phase1_recon.antipattern_shape_validators"]) p.forbid("type/format/shape validators on identifiers"); // src: vulnhunt/phases/phase1_recon.md:452
        if (θ["p.phase1_recon.gateway_handles_it_rule"]) p.rule("the gateway handles it -> cite the verifying code or record NONE"); // src: vulnhunt/phases/phase1_recon.md:455
        if (θ["p.phase1_recon.no_pre_resolving_delegation"]) p.forbid("do not pre-resolve genuine delegation here"); // src: vulnhunt/phases/phase1_recon.md:456
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt trustBoundaryText(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.phase1_recon.trust_boundary_questions"]);                               // src: vulnhunt/phases/phase1_recon.md:461
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt buildSwapText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["prompt.scope.build_time_swapping"]) p.step(4, "Build-Time Code Swapping Detection"); // src: vulnhunt/phases/phase1_recon.md:467
        if (θ["p.phase1_recon.analysis_targets_production_variant"]) p.must("analysis MUST target the production variant"); // src: vulnhunt/phases/phase1_recon.md:471
        p.checklist(θ["p.phase1_recon.build_swap_detection_commands"]);                          // src: vulnhunt/phases/phase1_recon.md:475
        if (θ["p.phase1_recon.parallel_dir_structure_check"]) p.rule("look for parallel directory structures (prod-impl/ vs mock-impl/)"); // src: vulnhunt/phases/phase1_recon.md:478
        if (θ["p.phase1_recon.record_production_directory"]) p.rule("record which directory contains production code and always read from it"); // src: vulnhunt/phases/phase1_recon.md:480
        return p;
    }

    @executedBy(MODEL) @role(prompt)
    Prompt reconOutputText(Theta θ) {
        Prompt p = new Prompt();
        if (θ["p.phase1_recon.compact_report_not_raw"]) p.format("compact Attack Surface Report, not raw tool output"); // src: vulnhunt/phases/phase1_recon.md:489
        p.format(θ["p.phase1_recon.report_header_fields"]);                                      // src: vulnhunt/phases/phase1_recon.md:491
        if (θ["p.phase1_recon.full_inventory_in_report"]) p.format("include the full inventory table from Step 1b"); // src: vulnhunt/phases/phase1_recon.md:494
        if (θ["p.phase1_recon.all_row_only_after_confirming"]) p.rule("collapse to a single all row only after confirming every entry point shares the three fields"); // src: vulnhunt/phases/phase1_recon.md:498
        p.format(θ["p.phase1_recon.threat_model_table_columns"]);                                // src: vulnhunt/phases/phase1_recon.md:501
        p.format(θ["p.phase1_recon.trust_boundary_table_columns"]);                              // src: vulnhunt/phases/phase1_recon.md:511
        p.choose(θ["p.phase1_recon.partition_markers"]);                                         // src: vulnhunt/phases/phase1_recon.md:519
        return p;
    }

    // ---------------- procedures the recon subagent carries out ----------------

    @executedBy(MODEL)
    Structure step1StructuralOverview(Theta θ) {
        List<File> files = Runtime.parallel(θ["p.phase1_recon.parallel_glob_calls"] ? 13 : 1, θ["p.phase1_recon.language_extension_list"], ext -> glob("**/*." + ext)); // src: vulnhunt/phases/phase1_recon.md:13
        if (θ["p.phase1_recon.exclude_non_production_dirs"]) files = files.filter(f -> !excluded(f, θ["prompt.scope.exclusions"])); // src: vulnhunt/phases/phase1_recon.md:18
        return identify(files, θ["p.phase1_recon.structural_overview_outputs"]);                 // src: vulnhunt/phases/phase1_recon.md:20
    }

    @executedBy(MODEL)
    SinkInventory step1aSinkPrepass(Structure s, Theta θ) {
        SinkInventory sinks = new SinkInventory();
        for (Pattern pat : adaptToFrameworks(sinkReferenceFrom(PhasesIndex.classFiles(θ)), s.frameworks)) {      // src: vulnhunt/phases/phase1_recon.md:27
            List<Hit> hits = grep(pat).excludeTests();                                           // src: vulnhunt/phases/phase1_recon.md:30
            if (hits.truncated && θ["p.phase1_recon.sink_grep_truncation_rescope"]) for (Dir d : s.appDirs) hits.addAll(grep(pat, d)); // src: vulnhunt/phases/phase1_recon.md:31
            sinks.addAll(hits);                                                                  // src: vulnhunt/phases/phase1_recon.md:28
        }
        if (θ["p.phase1_recon.sink_completeness_crosscheck"]) {                                  // src: vulnhunt/phases/phase1_recon.md:33
            for (App app : s.apps) {
                if (sinks.countFor(app) == 0 && θ["p.phase1_recon.zero_sink_app_targeted_grep"]) sinks.addAll(grepAllSinkPatterns(app.srcDir, app.libs)); // src: vulnhunt/phases/phase1_recon.md:35
            }
        }
        if (θ["p.phase1_recon.url_concat_sink_sweep"]) sinks.addAll(grep("string concat/interpolation into HTTP client URL args")); // src: vulnhunt/phases/phase1_recon.md:42
        return sinks;
    }

    @executedBy(MODEL)
    Inventory step1bInputInventory(Structure s, Theta θ) {
        Inventory inv = new Inventory();
        for (EntryPoint ep : findEntryPoints(s, θ["p.phase1_recon.entry_point_types"])) {        // src: vulnhunt/phases/phase1_recon.md:64
            if (ep.isFrameworkInfra()) {
                for (String check : θ["p.phase1_recon.infra_endpoint_four_checks"]) ep.verify(check); // src: vulnhunt/phases/phase1_recon.md:89
            }
            for (Input in : readEntryPoint(ep).allExtractedInputs()) inv.add(in);                // src: vulnhunt/phases/phase1_recon.md:166
        }
        for (Directive d : grep(θ["p.phase1_recon.promotion_directive_grep_list"])) {            // src: vulnhunt/phases/phase1_recon.md:121
            if (d.trustsAny(θ["p.phase1_recon.broad_cidr_promotion_rule"])) inv.add(d.promotedVariable()); // src: vulnhunt/phases/phase1_recon.md:123
        }
        for (EntryPoint ep : s.entryPoints) {                                                    // src: vulnhunt/phases/phase1_recon.md:155
            if (inv.countFor(ep) == 0) {
                List<Input> found = readEntryPoint(ep).allExtractedInputs();                     // src: vulnhunt/phases/phase1_recon.md:158
                if (found.isEmpty()) inv.add(Input.synthetic(ep, θ["p.phase1_recon.synthetic_no_input_entry"], "N/A")); // src: vulnhunt/phases/phase1_recon.md:160
                else inv.addAll(found);
            }
        }
        inv.sortBy(θ["p.phase1_recon.lowest_trust_first"]);                                      // src: vulnhunt/phases/phase1_recon.md:150
        return inv;
    }

    @executedBy(MODEL)
    void step1cIndirectDispatch(Inventory inv, Theta θ) {
        for (Dispatch d : grep(θ["p.phase1_recon.indirect_dispatch_patterns"])) {                // src: vulnhunt/phases/phase1_recon.md:174
            for (Function f : d.targets()) inv.add(Input.entryPoint(f, θ["p.phase1_recon.indirect_dispatch_flag"])); // src: vulnhunt/phases/phase1_recon.md:190
        }
    }

    // Step 1d: call graph (2 levels), shared infra catalog, union-find partitions, pathological fixes, reachability, coverage.
    @executedBy(MODEL)
    Partitioning step1dPartition(Structure s, Inventory inv, SinkInventory sinks, Theta θ) {
        CallGraph cg = new CallGraph();
        for (EntryPoint ep : inv.entryPoints()) cg.add(ep, callsToDepth(ep, θ["prompt.recon.callgraph_depth"]), sinks); // src: vulnhunt/phases/phase1_recon.md:229
        Set<Module> shared = cg.modulesImportedByMoreThan(θ["prompt.recon.shared_infra_import_share"]); // src: vulnhunt/phases/phase1_recon.md:259
        shared.addAll(cg.modulesOfKind(θ["p.phase1_recon.shared_infra_explicit_list"]));         // src: vulnhunt/phases/phase1_recon.md:262
        if (θ["p.phase1_recon.config_module_sink_exception"]) shared.removeIf(m -> m.interpolatesParamsIntoUrlsQueriesCommands()); // src: vulnhunt/phases/phase1_recon.md:284
        UnionFind uf = new UnionFind(inv.entryPoints());                                         // src: vulnhunt/phases/phase1_recon.md:294
        for (Function f : cg.appFunctions().minus(shared)) uf.mergeAll(cg.entryPointsCalling(f)); // src: vulnhunt/phases/phase1_recon.md:295
        List<Partition> parts = uf.sets();                                                       // src: vulnhunt/phases/phase1_recon.md:298
        for (Partition sg : parts) {                                                             // src: vulnhunt/phases/phase1_recon.md:308
            if (sg.inputs > θ["prompt.recon.oversize_inputs"] || sg.files > θ["prompt.recon.oversize_files"]) { // src: vulnhunt/phases/phase1_recon.md:312
                List<Partition> split = sg.splitBy(θ["p.phase1_recon.oversize_split_method"]);   // src: vulnhunt/phases/phase1_recon.md:313
                if (split.minInputs() > θ["p.phase1_recon.monolithic_sequential_fallback"]) sg.mark("SEQUENTIAL-FALLBACK"); // src: vulnhunt/phases/phase1_recon.md:318
            }
            if (sg.inputs <= 2 && sg.files == 1) sg.mergeInto(mostRelated(sg, parts));          // src: vulnhunt/phases/phase1_recon.md:321
        }
        if (θ["p.phase1_recon.single_connector_promotion"] && parts.size() == 1 && cg.singleConnector() != null) { // src: vulnhunt/phases/phase1_recon.md:315
            shared.add(cg.singleConnector());
            return step1dPartition(s, inv, sinks, θ);                                            // unclear: recomputation is described as "recompute partitions"; the promoted function must persist across the recursion
        }
        for (Partition sg : parts) {                                                             // src: vulnhunt/phases/phase1_recon.md:326
            sg.reachability = envGateAt(readRouteMounting(sg)) == null ? "PRODUCTION" : "DEV-ONLY"; // src: vulnhunt/phases/phase1_recon.md:330
            if (sg.reachability == "DEV-ONLY") {                                                 // src: vulnhunt/phases/phase1_recon.md:334
                sg.record("SKIPPED - entry point gated by file:line");
                sg.markInputs(θ["p.phase1_recon.dev_only_inputs_marked_safe"]);                  // src: vulnhunt/phases/phase1_recon.md:336
            }
        }
        for (App app : s.productionApps()) {                                                     // src: vulnhunt/phases/phase1_recon.md:338
            if (!coveredBy(app, parts)) parts.add(recoverAppPartition(app));                     // src: vulnhunt/phases/phase1_recon.md:340
        }
        return new Partitioning(cg, shared, parts);
    }

    @executedBy(MODEL)
    void step1eAuthzGateAudit(Inventory inv, Theta θ) {
        for (Hit h : grep(θ["p.phase1_recon.authz_gate_grep_patterns"], inv.authzHelpers())) {   // src: vulnhunt/phases/phase1_recon.md:346
            if (h.receiverIsString() || h.allowlistUnsplit() || h.comparisonReversed() || h.ambiguousClassification()) { // src: vulnhunt/phases/phase1_recon.md:351
                inv.add(Input.gate(h, θ["p.phase1_recon.gate_logic_inventory_entries"]));        // src: vulnhunt/phases/phase1_recon.md:357
            }
        }
        for (Dimension dim : inv.securityDimensions()) {                                         // src: vulnhunt/phases/phase1_recon.md:360
            if (classifierSites(dim).distinctLogic() > 1) inv.flagCandidate(dim);                // src: vulnhunt/phases/phase1_recon.md:363
        }
    }

    @executedBy(MODEL)
    void step1fAuthPathEnumeration(Inventory inv, Theta θ) {
        for (EntryPoint ep : inv.entryPointsReturningCredentials()) {                            // src: vulnhunt/phases/phase1_recon.md:369
            for (AuthBranch b : ep.authBranches()) {
                if (!b.cryptographicallyVerified()) inv.add(Input.authBypass(b, θ["p.phase1_recon.auth_bypass_path_entries"])); // src: vulnhunt/phases/phase1_recon.md:374
            }
        }
        for (Hit c : grepComments(θ["p.phase1_recon.bypass_comment_grep"])) evaluateAsCandidate(c); // src: vulnhunt/phases/phase1_recon.md:377
    }

    // Step 2: one row per entry-point group; each field is audited-code file:line or NONE.
    @executedBy(MODEL)
    List<ThreatRow> step2ThreatModel(Inventory inv, Theta θ) {
        List<ThreatRow> rows = new List();
        for (Group g : inv.entryPointGroups()) {                                                 // src: vulnhunt/phases/phase1_recon.md:393
            ThreatRow r = new ThreatRow(g);
            r.enforcement = admissible(codeThatRejectsMissingCredential(g), θ);                  // src: vulnhunt/phases/phase1_recon.md:401
            r.binding = admissible(codeThatCryptoVerifiesCredential(g), θ);                      // src: vulnhunt/phases/phase1_recon.md:403
            r.authorization = (r.enforcement != "NONE" && r.binding != "NONE") ? admissible(codeThatAuthorizesResource(g), θ) : "NONE"; // src: vulnhunt/phases/phase1_recon.md:409
            if (r.allNone()) { r.profile = θ["p.phase1_recon.profile_all_none"]; r.baseline = θ["p.phase1_recon.all_none_baseline_constraint"]; } // src: vulnhunt/phases/phase1_recon.md:412
            else if (r.authorization == "NONE") r.profile = θ["p.phase1_recon.profile_authz_missing"]; // src: vulnhunt/phases/phase1_recon.md:413
            else r.profile = θ["p.phase1_recon.profile_all_present"];                            // src: vulnhunt/phases/phase1_recon.md:415
            rows.add(r);
        }
        if (rows.allShareThreeFields()) rows = List.of(rows.collapseToAll());                    // src: vulnhunt/phases/phase1_recon.md:394
        return rows;
    }

    // Anti-patterns: inadmissible evidence makes the field NONE.
    @executedBy(MODEL)
    String admissible(Evidence e, Theta θ) {
        if (e == null || e.isProseOnly()) return θ["p.phase1_recon.prose_not_admissible"];       // src: vulnhunt/phases/phase1_recon.md:383
        if (e.onlyBasisIn(θ["prompt.inadmissible_evidence"])) return θ["p.phase1_recon.inadmissible_only_basis_none"]; // src: vulnhunt/phases/phase1_recon.md:435
        return e.fileLine;
    }

    @executedBy(MODEL)
    List<Boundary> step3TrustBoundaries(Structure s, Inventory inv, Theta θ) {
        return answer(θ["p.phase1_recon.trust_boundary_questions"], s, inv);                      // src: vulnhunt/phases/phase1_recon.md:461
    }

    @executedBy(MODEL)
    Path step4BuildSwapDetection(Theta θ) {
        for (Script b : buildSystemFiles()) {                                                    // src: vulnhunt/phases/phase1_recon.md:475
            if (b.uses(θ["p.phase1_recon.build_swap_detection_commands"]) || parallelDirs()) return recordProductionDir(); // src: vulnhunt/phases/phase1_recon.md:480
        }
        return null;
    }

    // Used by the Investigation Discipline: read the production variant of a build-output file.
    @executedBy(MODEL)
    Path productionDirFor(Path file) {
        return (recordedProductionDir != null) ? recordedProductionDir.resolve(file.name) : file; // src: vulnhunt/phases/phase1_recon.md:484
    }

    @executedBy(MODEL)
    ReconReport writeReconOutput(String path, Structure s, Inventory inv, List<ThreatRow> tm, List<Boundary> tb, Partitioning parts, Theta θ) {
        ReconReport r = new ReconReport(s.languages, s.frameworks, inv, tm, tb, parts.shared, parts.partitions); // src: vulnhunt/phases/phase1_recon.md:489
        writeFile(path, r);
        return r;
    }
}
