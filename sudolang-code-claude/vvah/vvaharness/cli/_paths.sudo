Executor: code
Called from: `vvaharness/cli/__init__.py`, `vvaharness/cli/_commands.py`, `vvaharness/cli/_setup.py`

// src: vvaharness/cli/_paths.py:41-61 (_config_path_from_explicit 41-53, _config_path_from 55-57, _config_trust_boundary 59-61)
fn _config_path_from_explicit(rest):executor=code {
  found = value of the LAST "--config X" or "--config=X" in rest   // matches argparse on a repeated flag
  return if (found != null) [found, true] else [config_paths._default_config(), false]
}
fn _config_path_from(rest):executor=code { return _config_path_from_explicit(rest)[0] }
fn _config_trust_boundary(rest):executor=code { return _repo_from(rest) }   // the --repo target, else null

// src: vvaharness/cli/_paths.py:81-88
fn _repo_from(rest):executor=code {
  return value of the FIRST "--repo X" or "--repo=X" in rest, else null
  // preserved: the first --repo wins here while argparse in entry.py keeps the last, so with a repeated --repo the configuration and .env trust boundary is checked against a different directory than the one scanned (entry.py re-applies trusted_config against its own args.repo)
}

// src: vvaharness/cli/_paths.py:29-39
fn _load_and_configure(cfg_path, label):executor=code {
  try cfg = config.load(cfg_path); catch ConfigPolicyError => return null   // reported with label
  preflight.configure_backends(cfg, parent directory of cfg_path)
  return cfg
}

// src: vvaharness/cli/_paths.py:63-79
fn _check_python():executor=code {
  floor = ">= X.Y" from the installed package's Requires-Python; if (unreadable or absent) return null
  return if (interpreter version < floor) "vvaharness requires Python >= ${floor.major}.${floor.minor}; this interpreter is $current. Please use a newer Python." else null
}
