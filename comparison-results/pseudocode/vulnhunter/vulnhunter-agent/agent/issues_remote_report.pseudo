// file: vulnhunter-agent/agent/issues_remote_report.py
// Fetch a published VulnHunter report from publish.destination_repo by sparse checkout of <owner>/<name>/:
// the newest *VULNHUNT_RESULTS* dir (--no-scan --issues) or an exactly named one (verify mode).

@executedBy(CODE) @role(io) @stage("issues")
class IssuesRemoteReport {

    // _run: git with GIT_TERMINAL_PROMPT=0; non-zero exit -> RemoteReportError with redacted argv/stderr.
    Completed run(List<String> cmd, Path cwd, int timeout) {
        Map env = os.environ.copy();
        env.put("GIT_TERMINAL_PROMPT", "0");                                                      // src: vulnhunter-agent/agent/issues_remote_report.py:68
        Completed result = subprocess.run(cmd, cwd, timeout, env);                                // src: vulnhunter-agent/agent/issues_remote_report.py:69
        if (result.returncode != 0) throw new RemoteReportError("git command failed: " + Url.redact(cmd)); // src: vulnhunter-agent/agent/issues_remote_report.py:72
        return result;
    }

    // download_latest_report: newest report (max dir name, which encodes YYYY-MM-DD-HHMMSS).
    DownloadedReport downloadLatestReport(String sourceRepoUrl, PublishConfig publish, GithubConfig github) {
        if (publish.destinationRepo == "") throw new RemoteReportError("publish.destination_repo must be set when --no-scan + --issues"); // src: vulnhunter-agent/agent/issues_remote_report.py:95
        String token = TokenClient.getGithubToken("reports", github);                             // src: vulnhunter-agent/agent/issues_remote_report.py:100
        if (token == "") throw new RemoteReportError("reports_token is required");                // src: vulnhunter-agent/agent/issues_remote_report.py:101
        (String owner, String name) = Github.parseOwnerRepo(sourceRepoUrl);                       // src: vulnhunter-agent/agent/issues_remote_report.py:106
        String sparsePath = owner + "/" + name;                                                   // src: vulnhunter-agent/agent/issues_remote_report.py:107
        String authedUrl = Url.injectToken(publish.destinationRepo, token, github.host);          // src: vulnhunter-agent/agent/issues_remote_report.py:108
        Path workdir = mkdtemp("vulnhunt-fetch-");                                                // src: vulnhunter-agent/agent/issues_remote_report.py:110
        try {
            run(List.of("git", "clone", "--filter=blob:none", "--no-checkout", "--depth=1", "--branch", publish.branch, authedUrl, workdir), null,
                θ["issues.request_timeout_seconds"] * θ["code.agent.issues_remote_report.clone_timeout_multiplier"]); // src: vulnhunter-agent/agent/issues_remote_report.py:124
            sparseCheckout(workdir, sparsePath, publish.branch);                                  // src: vulnhunter-agent/agent/issues_remote_report.py:126
            Path ownerDir = workdir.resolve(sparsePath);                                          // src: vulnhunter-agent/agent/issues_remote_report.py:133
            if (!ownerDir.isDir()) throw new RemoteReportError("No published reports found");     // src: vulnhunter-agent/agent/issues_remote_report.py:134
            List<Path> candidates = ownerDir.rglob(θ["code.agent.issues_remote_report.results_dir_glob"])
                    .filter(p -> p.isDir() && p.resolve("README.md").isFile());                   // src: vulnhunter-agent/agent/issues_remote_report.py:142
            if (candidates.isEmpty()) throw new RemoteReportError("No *VULNHUNT_RESULTS* directory with a README.md"); // src: vulnhunter-agent/agent/issues_remote_report.py:145
            Path newest = candidates.maxBy(p -> p.name);                                          // src: vulnhunter-agent/agent/issues_remote_report.py:152
            return new DownloadedReport(newest, newest.relativeTo(workdir), workdir);             // src: vulnhunter-agent/agent/issues_remote_report.py:161
        } catch (Exception e) {
            rmtree(workdir);                                                                      // src: vulnhunter-agent/agent/issues_remote_report.py:165
            throw e;
        }
    }

    // git sparse-checkout init; set --no-cone /<owner>/<name>/*; checkout <branch> (each with the default git timeout).
    void sparseCheckout(Path workdir, String sparsePath, String branch) {
        int t = θ["code.agent.issues_remote_report.git_timeout_seconds"];                        // src: vulnhunter-agent/agent/issues_remote_report.py:60
        run(List.of("git", "sparse-checkout", "init"), workdir, t);                               // src: vulnhunter-agent/agent/issues_remote_report.py:126
        run(List.of("git", "sparse-checkout", "set", "--no-cone", "/" + sparsePath + "/*"), workdir, t); // src: vulnhunter-agent/agent/issues_remote_report.py:128
        run(List.of("git", "checkout", branch), workdir, t);                                      // src: vulnhunter-agent/agent/issues_remote_report.py:131
    }

    // download_named_report: verify mode; exact dir name from the issue's vulnhunt-results-dir marker. Never falls back to newest.
    DownloadedReport downloadNamedReport(String sourceRepoUrl, String resultsDirName, PublishConfig publish, GithubConfig github, int timeoutSeconds, Path cacheBaseDir) {
        if (publish.destinationRepo == "") throw new RemoteReportError("publish.destination_repo must be set"); // src: vulnhunter-agent/agent/issues_remote_report.py:191
        String reportsToken = TokenClient.getGithubToken("reports", github);                      // src: vulnhunter-agent/agent/issues_remote_report.py:198
        if (reportsToken == "") throw new RemoteReportError("reports_token is required");         // src: vulnhunter-agent/agent/issues_remote_report.py:199
        if (resultsDirName == "") throw new RemoteReportError("results_dir_name must be a non-empty basename"); // src: vulnhunter-agent/agent/issues_remote_report.py:203
        (String owner, String name) = Github.parseOwnerRepo(sourceRepoUrl);                       // src: vulnhunter-agent/agent/issues_remote_report.py:209
        String sparsePath = owner + "/" + name;
        String authedUrl = Url.injectToken(publish.destinationRepo, reportsToken, github.host);   // src: vulnhunter-agent/agent/issues_remote_report.py:211
        Path workdir = mkdtemp("vulnhunt-verify-fetch-", cacheBaseDir);                           // src: vulnhunter-agent/agent/issues_remote_report.py:215
        try {
            run(List.of("git", "clone", "--filter=blob:none", "--no-checkout", "--depth=1", "--branch", publish.branch, authedUrl, workdir), null, timeoutSeconds); // src: vulnhunter-agent/agent/issues_remote_report.py:229
            sparseCheckout(workdir, sparsePath, publish.branch);                                  // src: vulnhunter-agent/agent/issues_remote_report.py:231
            Path ownerDir = workdir.resolve(sparsePath);
            if (!ownerDir.isDir()) throw new RemoteReportError("No published reports found");     // src: vulnhunter-agent/agent/issues_remote_report.py:239
            List<Path> matches = ownerDir.rglob(resultsDirName).filter(p -> p.isDir() && p.name == resultsDirName); // src: vulnhunter-agent/agent/issues_remote_report.py:245
            if (matches.isEmpty()) throw new RemoteReportError("No directory named results_dir_name"); // src: vulnhunter-agent/agent/issues_remote_report.py:250
            if (matches.size() > 1) throw new RemoteReportError("Multiple directories named results_dir_name; cannot resolve"); // src: vulnhunter-agent/agent/issues_remote_report.py:256
            Path match = matches.get(0);
            if (!match.resolve("README.md").isFile()) throw new RemoteReportError("Report directory lacks a README.md"); // src: vulnhunter-agent/agent/issues_remote_report.py:266
            return new DownloadedReport(match, match.relativeTo(workdir), workdir);               // src: vulnhunter-agent/agent/issues_remote_report.py:279
        } catch (Exception e) {
            rmtree(workdir);                                                                      // src: vulnhunter-agent/agent/issues_remote_report.py:283
            throw e;
        }
    }

    // DownloadedReport.cleanup: remove the temp workdir tree; errors ignored
    void cleanup(DownloadedReport r) {
        Fs.rmtree(r.workdir, true);                                                               // src: vulnhunter-agent/agent/issues_remote_report.py:56
    }
}

// DownloadedReport.cleanup(): the caller must invoke it when done reading; otherwise the mkdtemp workdir accumulates under tmp
@executedBy(CODE) @role(types)
record DownloadedReport(Path path, String relPathInDest, Path workdir) { }

@executedBy(CODE) @role(types)
class RemoteReportError extends RuntimeError { }
