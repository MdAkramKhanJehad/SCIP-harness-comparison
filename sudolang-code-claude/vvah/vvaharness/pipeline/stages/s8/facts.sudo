# vvaharness/pipeline/stages/s8/facts.py

Deterministic code and repository facts shown to the Stage 8 model: each finding's redacted code snippet (optionally with decorator lines above it), groups of findings at one location, and deployment exposure facts (binds, published ports, bind rewrites, Dockerfile USER). The facts are shown, never interpreted by code.

Source: `vvaharness/pipeline/stages/s8/facts.py` (lines 1-241)
Executor: code
Called from: `vvaharness/pipeline/stages/s8/prompts.py` finding_block, repo_fact_blocks; `vvaharness/pipeline/stages/s8/validate.py` (_file_lines)

// src: vvaharness/pipeline/stages/s8/facts.py:29-49
MAX_SNIPPET_CHARS = 1200
MAX_DECORATOR_LINES = 4      // a registration sits 1-3 lines above the definition
MAX_PROLOGUE_CHARS = 200     // prepended before the snippet cap, so one long decorator cannot evict the code
_ANNOTATION_RX = whole-line decorator "@name(...)" or a whole-line attribute "[...]" / "#[...]", anchored at both ends
_FROM_RX = line-start "FROM " (case-insensitive); _USER_RX = line-start "USER <user>" (case-insensitive)
_USER_TOKEN_RX = /^[A-Za-z0-9_.:\-]{1,64}$/   // only name, uid or name:group is stated; anything else could carry prompt injection

// src: vvaharness/pipeline/stages/s8/facts.py:89-106
fn snippet_for(f, repo_root, include_decorators=false):executor=code {
  text = trimmed f.code_snippet
  if (text) text = s4_deepdive._redact_source(text, f.file, stage="s8")   // outside this batch; redacts on both paths
  else text = _read_range(repo_root, f.file, f.line_start, f.line_end)
  if (include_decorators) {
    prologue = _decorator_lines(repo_root, f.file, f.line_start)
    // a producer that cut above the decorator repeats its nearest line: test only that line
    if (prologue && last line of prologue (trimmed) not in text) text = if (text) "$prologue\n$text" else prologue
  }
  if (length(text) > MAX_SNIPPET_CHARS) text = first 1200 characters of text + "\n… (snippet truncated)"
  return text
}

// src: vvaharness/pipeline/stages/s8/facts.py:110-130
fn _file_lines(repo_root, file):executor=code {
  // file's lines, or [] when unreadable, not a regular file (a FIFO would block), or escaping the repository
  require resolved(repo_root / file) is inside resolved(repo_root) => return []
  require target is a regular file => return []
  return lines cached by (path, mtime_ns, size), up to 256 entries, split with detect.matcher.split_lines
}

// src: vvaharness/pipeline/stages/s8/facts.py:133-141
fn _read_range(repo_root, file, start, end):executor=code {
  lines = _file_lines(repo_root, file)
  if (!lines) return ""
  return s4_deepdive._redact_source(lines[max(start - 1, 0) .. max(end or start, start)] joined by "\n", file, stage="s8")
}

// src: vvaharness/pipeline/stages/s8/facts.py:144-166
fn _decorator_lines(repo_root, file, start):executor=code {
  if (start <= 1) return ""
  lines = _file_lines(repo_root, file); if (!lines) return ""
  picked = []; total = 0; i = line index directly above start
  while (i >= 0 && length(picked) < MAX_DECORATOR_LINES) {
    if (lines[i] does not match _ANNOTATION_RX) break
    total += length(lines[i]) + 1
    if (total > MAX_PROLOGUE_CHARS) break   // nearest-first, so an oversized outer line is dropped
    append lines[i] to picked; i -= 1
  }
  if (!picked) return ""
  return s4_deepdive._redact_source(picked in file order joined by "\n", file, stage="s8")
}

// src: vvaharness/pipeline/stages/s8/facts.py:169-176
fn same_location_groups(findings, labels):executor=code {
  group labels by (file, line_start)
  return for each group with more than one label: "${ids joined by ", "} are all at $file:$line — ONE code fact"
}

// src: vvaharness/pipeline/stages/s8/facts.py:199-238
fn exposure_facts(ctx, findings, user_facts=false):executor=code {
  names = ["Dockerfile", "docker-compose.yml", "docker-compose.yaml", "compose.yml", "Makefile"] + first 60 of sorted distinct finding files
  facts = []
  for each rel in names (deduplicated) {
    require resolved path is inside the repository && is a file && readable => skip
    if (user_facts && _is_dockerfile_name(base name of rel)) facts += _user_directive_facts(rel, text)
    for each m in _BIND_RX matches in text {
      // _BIND_RX alternatives: .run/.serve/.bind/.listen/.create_server(... host="ADDR"); socket bind on ("ADDR", port);
      // a LISTEN_ADDRESS/BIND_ADDRESS/BIND_HOST/SERVER_HOST/HOST = "ADDR" constant; a "- NNNN:NNNN" port line; sed -i s/FROM/TO/ (facts.py:63-81)
      host = m.host or m.tuple or m.const
      if (host) {
        if (!_real_host(host)) continue   // a complete IP literal or a loopback name only
        append "$rel binds $host" + (if (loopback host) " (LOOPBACK — not remotely reachable as written)" else " (all interfaces — remotely reachable)") to facts
      } else if (m.port) {
        if ("compose" in lowercased base name of rel) append "$rel publishes port ${m.port} to the host" to facts   // only compose files map ports
      } else if (m.to) {
        if (_real_host(m.from) && _real_host(m.to)) append "$rel rewrites the bind ${m.from} -> ${m.to}" to facts
      }
    }
  }
  return first 12 of facts (deduplicated)
  // preserved: "all interfaces — remotely reachable" is stated for any non-loopback IP literal, not only 0.0.0.0
}

// src: vvaharness/pipeline/stages/s8/facts.py:179-196
fn _user_directive_facts(rel, text):executor=code {
  matches = _USER_RX matches; users = matches whose token fits _USER_TOKEN_RX
  if (matches && !users) return []   // dropping an unstateable token rather than stating a false fact
  if (!users) return ["$rel declares no USER directive"]
  final = users after the last FROM
  if (final) return ["$rel final stage runs as USER ${last of final} (last USER directive after the last FROM)"]
  return ["$rel declares no USER directive after its last FROM (earlier build stage(s) declare: ${distinct users joined by ", "})"]
}

// src: vvaharness/pipeline/stages/s8/facts.py:52-61
fn _is_dockerfile_name(name):executor=code {
  // "Dockerfile" or "Dockerfile.<variant>", excluding source and document extensions (py, pyi, js, ts, rb, go, java, cs, php, sh, yml, yaml, json, md, txt, html)
}

// src: vvaharness/pipeline/stages/s8/facts.py:84-86
fn _real_host(host):executor=code { return util.net.is_loopback_host(host) || util.net.ip_literal(host) }   // external: vvaharness/util/net
