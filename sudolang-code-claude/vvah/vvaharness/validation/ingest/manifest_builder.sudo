# vvaharness/validation/ingest/manifest_builder.py

Builds the single-finding manifest for a case.

Source: `vvaharness/validation/ingest/manifest_builder.py` (lines 1-34)
Executor: code
Called from: `vvaharness/validation/cli/_run.sudo` _run_plan, `vvaharness/validation/case_api.sudo` _judge

// src: vvaharness/validation/ingest/manifest_builder.py:25-34
fn build_manifest(case, session_id):executor=code {
  latest = last of case.attempts, or null
  return Manifest { case_id: case.case_id, session_id, finding: case.finding,
    affected_files: if (latest) latest.remediation.files_touched else [], post_results: false }
}
