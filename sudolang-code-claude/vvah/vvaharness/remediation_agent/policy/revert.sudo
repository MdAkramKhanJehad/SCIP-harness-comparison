# vvaharness/remediation_agent/policy/revert.py

Rolls files back to their pre-edit state: from the snapshot when one exists, else `git checkout` for tracked files or deletion for untracked ones. Confined to the repository and never touches `.git` metadata.

Source: `vvaharness/remediation_agent/policy/revert.py` (lines 1-91)
Executor: code
Called from: `policy/postgate.sudo` enforce_post; `plugin_runner/run.sudo` _engine_failed

// src: vvaharness/remediation_agent/policy/revert.py:48-91
fn revert_files(repo, files, before_snapshot?):executor=code {
  snap = before_snapshot or {}
  is_git = _is_git_worktree(repo)   // git rev-parse --is-inside-work-tree, 15-second timeout
  reverted = []
  for each raw in files {
    rel = _norm_path(raw)   // strips a trailing ":<line>" or ":<start-end>"
    if (!rel) continue
    // src: revert.py:60-64 — fail closed on absolute, "..", UNC/drive or symlink escapes (CWE-22): model-supplied names would otherwise unlink host files
    require _safe_repo_path(repo, raw) != null => { warn "refusing to revert out-of-repo path"; continue }
    // src: revert.py:65-68 — repository metadata is never deleted or rewritten
    require !is_git_metadata(rel) => { warn "refusing to revert .git-owned path"; continue }
    try {
      if (rel in snap) {
        if (snap[rel] == null) delete repo/rel if it exists   // the file did not exist before
        else write snap[rel] to repo/rel (UTF-8)
        append rel to reverted; continue
      }
      if (is_git) {
        if (_is_tracked(repo, rel)) run "git checkout -- <rel>" (30-second timeout)   // git ls-files --error-unmatch, 15-second timeout
        else if (exists) delete repo/rel   // untracked, agent-created
        append rel to reverted
      }
      // not in the snapshot and not a git work tree: left alone and not reported as reverted
    } catch error => warn "failed to revert <rel>: <error>"
  }
  return reverted
  // preserved: the git checkout exit status is not checked; the path is reported as reverted even if checkout failed
  // preserved: the snapshot is decoded UTF-8 text; a file that was binary or unreadable was snapshotted as null and is therefore DELETED on revert
}
