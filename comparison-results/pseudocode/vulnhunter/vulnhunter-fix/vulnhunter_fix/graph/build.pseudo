// file: vulnhunter-fix/vulnhunter_fix/graph/build.py
// Graph builder: wraps graphify AST extraction into the VF schema, content-hash cached;
// any failure (cloud-LLM env set, import error, no code files, extract error) degrades to the grep fallback.

@executedBy(CODE) @role(backend) @stage("fix")
class Build {

    boolean graphifyParallel(Theta θ) {
        String override = env("GRAPHIFY_PARALLEL").strip().lower();                  // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:51
        if (List.of("1", "true", "yes").contains(override)) return true;             // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:52
        if (List.of("0", "false", "no").contains(override)) return false;            // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:54
        // unset: sequential on macOS (sandbox blocks ProcessPoolExecutor init), parallel elsewhere
        return θ["code.vulnhunter_fix.graph.build.graphify_parallel_default"] && platform != "darwin"; // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:56
    }

    String contentHash(Path root, Theta θ) {
        Hash h = sha256();                                                           // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:73
        for (Path p : GraphConfig.iterSourceFiles(root, θ).sorted()) {               // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:74
            try {
                h.update(p.relativeTo(root) + "\0" + p.readBytes() + "\0");          // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:76
            } catch (OSError e) {
                continue;                                                            // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:81
            }
        }
        return "sha256:" + h.hex();                                                  // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:82
    }

    GraphDocument loadCacheIfValid(Path cachePath, String expectedHash, Theta θ) {
        if (!cachePath.exists()) return null;                                        // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:86
        Map data;
        try { data = Json.parse(cachePath.readText()); } catch (OSError | JSONDecodeError e) { return null; } // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:90
        if (data.get("content_hash") != expectedHash) return null;                   // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:92
        if (data.get("schema_version") != Schema.schemaVersion()) return null;       // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:94
        return Schema.fromDict(data, θ);                                             // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:96
    }

    void saveCache(Path cachePath, GraphDocument doc) {
        cachePath.parent().mkdirs();                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:100
        cachePath.writeText(Json.dump(Schema.toDict(doc)));                          // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:101
    }

    GraphDocument tryGraphifyBuild(Path root, String contentHash, Theta θ) {
        List<String> violations = GraphConfig.checkBackendIsolation(env(), θ);       // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:106
        if (!violations.isEmpty()) return null;                                      // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:107 (warn, fall back to grep)
        if (!importable("graphify")) return null;                                    // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:118
        Map detected;
        try { detected = Graphify.detect(root); } catch (Exception e) { return null; } // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:127 (honours .gitignore / .graphifyignore)
        List<Path> codeFiles = detected.files.code;                                  // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:132
        if (codeFiles.isEmpty()) return null;                                        // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:133
        Object raw;
        try {
            raw = Graphify.extract(codeFiles, graphifyParallel(θ));                  // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:142
        } catch (TypeError e1) {
            try {
                raw = Graphify.extract(codeFiles);                                   // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:148
            } catch (TypeError e2) {
                try { raw = Graphify.extract(codeFiles.map(String::of)); } catch (Exception e3) { return null; } // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:151
            } catch (Exception e4) {
                return null;                                                         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:157
            }
        } catch (Exception e) {
            return null;                                                             // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:160
        }
        String version = Graphify.version ?: "unknown";                              // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:162
        Map<String, Node> nodes = new Map();
        for (Node n : iterNormalizedGraphifyEntities(raw, root, θ)) nodes.put(n.id, n); // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:165
        List<Edge> edges = iterNormalizedGraphifyEdges(raw, θ);                      // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:167
        return new GraphDocument(Schema.schemaVersion(), version, now(), "ast", "high", contentHash, root.toString(), nodes, edges); // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:170
    }

    int parseSourceLocation(Object loc) {
        if (loc instanceof Integer) return loc;                                      // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:203
        if (!(loc instanceof String)) return 0;                                      // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:205
        try { return int(loc.lstrip("Ll").split(":")[0]); } catch (ValueError e) { return 0; } // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:209
    }

    List<Edge> iterNormalizedGraphifyEdges(Object raw, Theta θ) {
        List source = raw.edges;                                                     // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:216
        if (source == null) return List.of();                                        // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:221
        Map<String, String> relationMap = θ["code.vulnhunter_fix.graph.build.relation_map"]; // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:183
        List<Edge> out = new List();
        for (Object item : source) {                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:222
            if (!(item instanceof Map)) continue;                                    // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:223
            String src = item.source ?: item.from ?: item.src;                       // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:225
            String dst = item.target ?: item.to ?: item.dst;                         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:226
            if (src == null || dst == null) continue;                                // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:227
            String relation = (item.relation ?: item.kind ?: "calls").lower();       // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:229
            out.add(new Edge(src, dst, relationMap.getOrDefault(relation, relation))); // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:230
        }
        return out;
    }

    List<Node> iterNormalizedGraphifyEntities(Object raw, Path root, Theta θ) {
        List source = raw.nodes ?: raw.entities ?: (raw is iterable ? raw : List.of()); // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:247
        Set<String> nonCode = θ["code.vulnhunter_fix.graph.build.non_code_node_kinds"]; // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:196
        List<Node> out = new List();
        for (Object item : source) {                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:256
            if (!(item instanceof Map)) continue;                                    // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:257
            String label = item.label ?: "";                                         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:262
            String rawFile = item.source_file ?: item.file ?: item.path;             // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:263
            Object rawLine = item.source_location ?: item.line ?: item.lineno ?: 0;  // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:264
            String rawName = item.name ?: item.symbol ?: label.rstrip("()");         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:265
            String rawKind = item.kind ?: item.file_type ?: "function";              // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:266
            if (nonCode.contains(rawKind.lower())) continue;                         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:272
            if (rawFile == null) continue;                                           // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:275
            String name = rawName.strip();                                           // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:277
            if (name.isEmpty()) continue;                                            // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:278
            String relFile;
            try { relFile = Path(rawFile).resolve().relativeTo(root.resolve()); } catch (OSError | ValueError e) { relFile = rawFile; } // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:282
            String kind;
            if (rawKind == "code" || rawKind == "file") {                            // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:289
                if (label.endsWith("()")) kind = "function";                         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:290
                else if (label.endsWithAny(".py", ".go", ".ts", ".tsx", ".java")) kind = "module"; // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:292
                else kind = "function";                                              // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:295
            } else {
                kind = rawKind;                                                      // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:297
            }
            int line = parseSourceLocation(rawLine);                                 // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:299
            String language = item.language ?: GraphConfig.languageForPath(relFile, θ) ?: "unknown"; // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:300
            String finalId = item.id != null ? item.id : relFile + ":" + name;       // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:302
            out.add(new Node(finalId, kind, name, relFile, line, relFile + ":" + name, language)); // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:305
        }
        return out;
    }

    GraphDocument buildGraph(Path rootDir, Theta θ) {
        Path root = rootDir.resolve();                                               // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:318
        String hash = contentHash(root, θ);                                          // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:319
        GraphDocument doc = tryGraphifyBuild(root, hash, θ);                         // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:320
        if (doc != null) return doc;                                                 // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:321
        return Fallback.buildFallbackGraph(root, hash, θ);                           // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:323
    }

    GraphDocument buildOrLoad(Path rootDir, Path cachePath, Theta θ) {
        Path root = rootDir.resolve();                                               // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:328
        String hash = contentHash(root, θ);                                          // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:330
        GraphDocument cached = loadCacheIfValid(cachePath, hash, θ);                 // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:331
        if (cached != null) return cached;                                           // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:332
        GraphDocument doc = buildGraph(root, θ);                                     // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:334
        try { saveCache(cachePath, doc); } catch (OSError e) { /* warn only */ }     // src: vulnhunter-fix/vulnhunter_fix/graph/build.py:336
        return doc;
    }
}
