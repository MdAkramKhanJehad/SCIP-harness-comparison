  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"The typed scan result on disk, beside the rendered Markdown one, so a later process reads it instead of re-parsing Markdown and losing fields.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nfrom pydantic import ValidationError\n\nfrom vvaharness.models import FinalReport\nfrom vvaharness.orchestrator.artifacts import (\n    FINDINGS_JSON_NAME,\n    SCAN_DIR_NAME,\n    artifact_dir,\n)\nfrom vvaharness.report.redact import redact_tree\n\n__all__ = [\"InvalidFindingsJSON\", \"findings_json_path\", \"read_findings_json\",\n           \"write_findings_json\"]\n\n\nclass InvalidFindingsJSON(ValueError):\n    \"\"\"A findings.json exists but does not validate as a FinalReport.\"\"\"\n    # Distinct from absence on purpose: a corrupt contract file must not fall back to the Markdown\n\n\ndef findings_json_path(repo: Path | str) -> Path:\n    \"\"\"Where the typed result lives for a given checkout.\"\"\"\n    return Path(repo) / SCAN_DIR_NAME / FINDINGS_JSON_NAME\n\n\ndef write_findings_json(report: FinalReport, repo: Path | str) -> Path:\n    \"\"\"Persist *report* as JSON under ``<repo>/security-scan/`` and return the path, atomically so a reader in a...\"\"\"\n    out_dir = artifact_dir(repo, SCAN_DIR_NAME)\n    path = out_dir / FINDINGS_JSON_NAME\n    out_dir.mkdir(parents=True, exist_ok=True)\n    payload = json.dumps(redact_tree(report.model_dump(mode=\"json\")), indent=2) + \"\\n\"\n    tmp = path.with_suffix(f\"{path.suffix}.tmp\")\n    tmp.write_text(payload, encoding=\"utf-8\")\n    tmp.replace(path)\n    return path\n\n\ndef read_findings_json(repo: Path | str) -> FinalReport | None:\n    \"\"\"Load the typed result for *repo*.\"\"\"\n    # ``None`` when absent (older build); raises when present but invalid — never partially trusted\n    path = findings_json_path(repo)\n    if not path.is_file():\n        return None\n    return _validated(path)\n\n\ndef _validated(path: Path) -> FinalReport:\n    try:\n        return FinalReport.model_validate_json(path.read_text(encoding=\"utf-8\"))\n    except (OSError, ValidationError, ValueError) as exc:\n        raise InvalidFindingsJSON(\n            f\"{path} is not a readable scan result: {exc}\") from exc\n",
