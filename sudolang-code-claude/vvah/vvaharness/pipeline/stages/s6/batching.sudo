# vvaharness/pipeline/stages/s6/batching.py

Groups Stage 6 findings into verification sessions, packing each to full size after sorting by file, and computes the batch wall-clock ceiling the pool sweep enforces.

Source: `vvaharness/pipeline/stages/s6/batching.py` (lines 1-70)
Executor: code
Called from: `vvaharness/pipeline/stages/s6_verify.py` run, _reverify_discoveries; `ceiling_secs` also from `s6/session.py` _agentic_leg

// src: vvaharness/pipeline/stages/s6/batching.py:25
Item = (id, Finding)
// src: vvaharness/pipeline/stages/s6/batching.py:28-30
fn label(findings):executor=code {
  return [("f$i", f) for each index i, finding f]   // the short id the model echoes back
}

// src: vvaharness/pipeline/stages/s6/batching.py:33-38
fn plan_batches(items, size):executor=code {
  if (size <= 1) return each item as its own batch
  packed = items sorted by finding file (stable)
  return consecutive slices of `size` from packed   // sorted by file so co-located findings share a read; a slice may span files
}

// src: vvaharness/pipeline/stages/s6/batching.py:41-47
fn ceiling_secs(s6):executor=code {
  // one reader so the pool and the dispatch agree that <= 0 means off; deliberately NOT _cap_int, which would map -1 to 900
  try return max(0, knob("step6_verify.batch_wall_clock_ceiling", default=900) as integer);
  catch (TypeError, ValueError, OverflowError) => return 900
}

// src: vvaharness/pipeline/stages/s6/batching.py:50-52
fn sweep_effort(s6, via, cli_effort):executor=code {
  return knob("step6_verify.effort", default=null) or (if (via == "cli") cli_effort else null)
}

// src: vvaharness/pipeline/stages/s6/batching.py:55-62
fn sweep_ceiling_secs(s6, via, cli_effort):executor=code {
  raw = ceiling_secs(s6)
  if (raw == 0) return 0   // ceiling disabled
  // the sweep must be >= any backend clock armed for the same batch
  return effort_scaled_seconds(raw, sweep_effort(s6, via, cli_effort), kind=ClockKind.SESSION) + TIMEOUT_STOP_GRACE_SECONDS   // external to this batch: backends/llm/models
}

// src: vvaharness/pipeline/stages/s6/batching.py:65-70
fn filed_lines(items):executor=code {
  return file -> set of line_start for every item   // stage-wide: a batch-local map would double-count Stage 4's sibling findings
}
