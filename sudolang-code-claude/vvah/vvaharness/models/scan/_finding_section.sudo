# vvaharness/models/scan/_finding_section.py

Renders one finding's section of the Markdown report, tagging each line with whether it also enters the SARIF `description`. Includes the exploit verification block wording.

Source: `vvaharness/models/scan/_finding_section.py` (lines 1-235)
Executor: code
Called from: `vvaharness/models/scan/report.py` (FinalReport.to_markdown), the SARIF builder (finding_description_lines)

// src: vvaharness/models/scan/_finding_section.py:37-57
_EV_VERDICT_LABEL = {   // reader labels only; the wire ev_status is unchanged
  CONFIRMED: "CONFIRMED (beta)", NOT_CONFIRMED: "NOT CONFIRMED (beta)",
  INCONCLUSIVE: "REQUIRES REVIEW (beta)", NOT_TESTED: "SAST-ONLY (beta; not live-testable)"
}
_EV_REASON_TAG = { rule: "[rule] ", triage: "[triage] ", judge: "[judge] " }
_EV_NOT_A_FP_NOTE = "_Not a false positive: exploit verification only ever adds a live confirmation. This finding's verdict comes from static verification._"
_EV_POSITIVE_ONLY_NOTE = "Exploit verification is additive and positive-only: a finding it did not confirm live is not a false positive — the static verifier owns that verdict."

// src: vvaharness/models/scan/_finding_section.py:60-67
fn finding_section_lines(i, rf):executor=code { return every line of _finding_section(i, rf) }
fn finding_description_lines(i, rf):executor=code { return lines of _finding_section(i, rf) tagged in_sarif_description }

// src: vvaharness/models/scan/_finding_section.py:70-235 — returns (line, in_sarif_description) pairs
fn _finding_section(i, rf):executor=code {
  f = rf.finding
  // src: vvaharness/models/scan/_finding_section.py:73-82 — CVSS line
  cvss = match (f) {
    case cvss_score != null => (if (f.verdict == "FALSE_POSITIVE") "(scored against the claim, verdict FALSE_POSITIVE)" else "**<score to 1 decimal>**") + " ($cvss_rating) — " + _vector_span(cvss_vector)
    case cvss_vector => _vector_span(cvss_vector)
    default => "_not computed_"
  }
  _cwe = report.cwe.cwe_for(f.cwe, f.vuln_class); label = "$_cwe: <cwe_name>" when a name exists   // external to this batch: vvaharness/report/cwe.py
  emit "### $i. [<SEVERITY upper>] <_md_cell(title)>" (false), "**Class:** <label or vuln_class>" (false)
  if (_cwe) emit "**CWE:** $label - https://cwe.mitre.org/data/definitions/<number>.html" (false)
  emit "**File:** `<_md_cell(file), backticks => U+02CB>:<line_start[-line_end] (no range when line_end is 0)>`" (false)
  emit "**CVSS 3.1:** $cvss" (true only when cvss == "_not computed_")
  if (vsvs_score != null) emit "**VulContextSeverity:** ..." (false)
  if (offensive_priority) emit "**OffensivePriority:** **P?** - <OFFENSIVE_LABELS[P?]> | *<_md_cell(offensive_reason)>*" (false)
  if (duplicates) emit "**Also at:** <each duplicate file:line[-end]>" (false)
  // src: vvaharness/models/scan/_finding_section.py:122-162 — description body; every line below is true unless stated
  if (duplicates) emit "*N additional call site(s) collapsed during dedup — same root cause; each location needs the same fix applied.*"
  emit "#### Description", _demote_md_headings(description, escape_angles=true)
  if (impact) emit "#### Impact" + demoted impact
  if (exploit_scenario) emit "#### Exploit scenario" + demoted text
  if (preconditions) emit "#### Preconditions" + "- <_md_cell(p)>" each
  emit code_snippet fenced by _snippet_fence(code_snippet)   // raw snippet; the fence outruns any backtick run inside
  if (recommendation) emit "#### How to fix" + demoted text
  emit "**Exploitability:** <_one_line(rf.exploitability_notes)>"
  if (verdict) emit "#### Adversarial verification", "**Verdict:** $verdict (confidence: <_confidence_label>) — <_one_line(verdict_reason)>"

  // src: vvaharness/models/scan/_finding_section.py:171-234 — exploit verification block; skipped only when ev_status is not one of the four labels (for example null)
  if (ev_status in _EV_VERDICT_LABEL) {
    emit "#### Exploit Verification" (true)
    reason = _one_line(ev_evidence)
    if (ev_status == "CONFIRMED") {
      emit "**Exploit Verification:** CONFIRMED (beta)[ — reason]" (false); emit "**EV Confidence:** N/10" when scored (false)
      if (ev_method || ev_confidence) emit "**EV Method:** <ev_method or deterministic-backed> (<ev_confidence or medium>)" (false)
      if (ev_cvss_score != null) emit "**EV CVSS:** ..." (false)   // advisory only: static cvss_score owns ranking
      if (ev_repro) emit "**Repro:** <_code_span(ev_repro)>" (false)
      if (ev_repro_detail) emit each line of _render_repro_block(...)   // only blank lines outside <details> are tagged true
    } else {
      emit "**Exploit Verification:** <label>" (false); emit "**EV Confidence:** N/10" when scored (false)
      if (reason) emit "**Why:** <_EV_REASON_TAG[ev_reason_source]>$reason" (false)
      emit _EV_NOT_A_FP_NOTE (false)
    }
  }
  // abstracted: blank separator lines (tagged true) between blocks are omitted here
}
