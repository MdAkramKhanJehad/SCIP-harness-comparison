// file: vulnhunter-fix/scripts/check-severity-mask.py
// Gate 1, severity mask (REQ-GAT-002): scans artifact bodies for the word stem "critical" (after folding
// zero-width chars and homoglyphs) outside the safe-phrase list; any hit fails the gate.

@executedBy(CODE) @role(evaluation) @stage("fix")
class CheckSeverityMask {

    int run(List<String> argv, Theta θ) {
        return main(argv, θ);
    }

    String normalize(String text, Theta θ) {
        text = text.removeChars(θ["code.fix.scripts.check_severity_mask.zero_width_chars"]);              // src: vulnhunter-fix/scripts/check-severity-mask.py:41
        text = text.translate(θ["code.fix.scripts.check_severity_mask.confusables_map"]);                 // src: vulnhunter-fix/scripts/check-severity-mask.py:42
        return Unicode.normalize("NFKC", text);                                                           // src: vulnhunter-fix/scripts/check-severity-mask.py:43
    }

    boolean matchesSafePhrase(String text, int start, int end, Theta θ) {
        String textL = text.lower();
        for (String phrase : θ["p.severity-mask-rule.safe_phrase_list"]) {                                // src: vulnhunter-fix/scripts/check-severity-mask.py:46
            String phraseL = phrase.lower();
            int idx = 0;
            while (true) {
                int pStart = textL.find(phraseL, idx);                                                    // src: vulnhunter-fix/scripts/check-severity-mask.py:78
                if (pStart == -1) break;
                int pEnd = pStart + phraseL.length();
                // containment: the safe phrase's span must cover the match's span
                if (pStart <= start && end <= pEnd) return true;                                          // src: vulnhunter-fix/scripts/check-severity-mask.py:82
                idx = pStart + 1;
            }
        }
        return false;
    }

    List<String> scan(Path path, Theta θ) {
        if (!path.isFile()) return List.of("not a regular file");                                         // src: vulnhunter-fix/scripts/check-severity-mask.py:89
        String text = normalize(Files.readReplacingErrors(path), θ);                                      // src: vulnhunter-fix/scripts/check-severity-mask.py:91
        List<String> violations = List.of();
        for (Match m : Regex.finditerIgnoreCase(θ["code.fix.scripts.check_severity_mask.critical_regex"], text)) { // src: vulnhunter-fix/scripts/check-severity-mask.py:93
            if (matchesSafePhrase(text, m.start(), m.end(), θ)) continue;                                 // src: vulnhunter-fix/scripts/check-severity-mask.py:94
            violations.add(path + ": severity mask violation at line " + text.lineOf(m.start()));        // src: vulnhunter-fix/scripts/check-severity-mask.py:101
        }
        return violations;
    }

    int main(List<String> argv, Theta θ) {
        if (argv.size() < 2) return 64;                                                                   // src: vulnhunter-fix/scripts/check-severity-mask.py:106
        List<String> violations = List.of();
        for (String arg : argv.subList(1)) violations.addAll(scan(new Path(arg), θ));                    // src: vulnhunter-fix/scripts/check-severity-mask.py:110
        if (!violations.isEmpty()) return 1;                                                              // src: vulnhunter-fix/scripts/check-severity-mask.py:112
        return 0;
    }
}
