    /** Whether dispatchAgentic/dispatchPrompt will actually DELIVER a caller tool_builder; returns (carries, reason). The single truth table for every stage's tool gate. */
    @src("vvaharness/backends/llm/deepagents.py:1028")
    Pair routeCarriesTools(Object cfg, String via, boolean agentic, Theta θ) {
        if (!agentic && via != "deepagents") return Pair.of(false, "dispatch_prompt has no tool seam on this route"); // the one-shot leg has no tool seam on any route but deepagents // src: vvaharness/backends/llm/deepagents.py:1033
