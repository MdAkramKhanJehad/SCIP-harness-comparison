// file: vulnhunter-fix/prompts/verify.md
// Phase 4 (Verify & Repair) prompt for the vulnhunter-fix orchestrating session: stale-fix pre-check,
// three-step validation (security test / regression record / test-quality reviewer), repair loop,
// fork-mode escalation, then mandatory Steps 5-9 (tier re-classification, sweep, table, gates, validators).

@executedBy(MODEL) @role(prompt) @stage("Phase4")
class PromptsVerify {

    // ---------------------------------------------------------------- entry
    // Called by VulnhunterFixSkill.run after Phase 3 (implement). The orchestrating session carries this out.
    @executedBy(MIXED)
    Summary run(Mode mode, List<Unit> units, Theta θ) {
        assert θ["p.verify.phase_order_after_implement"];                                         // src: vulnhunter-fix/prompts/verify.md:5
        Prompt p = purpose(θ).include(executionModes(mode, θ)).include(agents(θ));
        List<FindingOutcome> outcomes = new List();
        for (Unit u : units) {                                                                       // unit = cluster branch (in-place) or per-finding branch (fork)
            for (Finding f : findingsInOrder(u, mode, θ)) {
                String secTest = locateSecurityTest(f, mode, θ);
                PreCheckOutcome pc = preCheck(f, secTest, mode, θ);                                  // Step 1
                if (pc != PreCheckOutcome.STILL_PRESENT) {
                    documentFixNotNeeded(f, pc, mode, θ);
                    outcomes.add(FindingOutcome.notNeeded(f));
                    continue;                                                                        // "Skip to the next finding."  // src: vulnhunter-fix/prompts/verify.md:151
                }
                ValidationResult v = validate(f, secTest, mode, θ);                                  // Step 2
                RepairOutcome r = v.allPass() ? RepairOutcome.verified(1) : repairLoop(f, secTest, v, mode, θ); // Step 3
                if (r.exhausted) {
                    escalate(f, r, mode, θ);                                                         // Step 4 (fork only)
                }
                outcomes.add(FindingOutcome.of(f, v, r));
            }
        }
        postFixTierReclassify(outcomes, mode, θ);                                                    // Step 5
        rootCauseSweep(outcomes, mode, θ);                                                           // Step 6
        verificationTable(outcomes, θ);                                                              // Step 7
        mechanicalGates(outcomes, mode, θ);                                                          // Step 8
        phaseExitValidators(outcomes, θ);                                                            // Step 9
        phaseExitCriteria(outcomes, θ);
        return finalSummary(outcomes, mode, θ);                                                      // Step 10 -> PromptsDeliver.run
    }

    // ---------------------------------------------------------------- Purpose / modes / agents
    Prompt purpose(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.verify.phase_order_after_implement"]);                                          // src: vulnhunter-fix/prompts/verify.md:5
        p.rule(θ["p.verify.fork_branch_masked_pattern"]);                                           // fix/code-quality-<descriptor>-<hash8>  // src: vulnhunter-fix/prompts/verify.md:7
        p.rule(θ["p.verify.in_place_branch_pattern"]);                                              // vulnfix/<cluster-slug>  // src: vulnhunter-fix/prompts/verify.md:7
        return p;
    }

    Prompt executionModes(Mode mode, Theta θ) {
        Prompt p = new Prompt();
        if (mode == Mode.IN_PLACE) {
            p.rule(θ["p.verify.in_place_unit_cluster_branch"]);                                     // src: vulnhunter-fix/prompts/verify.md:15
            p.rule(θ["p.verify.precheck_default_branch_from_intake"]);                              // src: vulnhunter-fix/prompts/verify.md:25
            p.rule(θ["p.verify.verifier_model_sonnet_review"]);                                     // src: vulnhunter-fix/prompts/verify.md:26
            p.rule(θ["p.verify.verifier_model_opus_diagnosis"]);                                    // src: vulnhunter-fix/prompts/verify.md:26
            p.forbid(θ["p.verify.no_haiku_for_test_review"]);                                       // src: vulnhunter-fix/prompts/verify.md:26
            p.rule(θ["p.verify.fix_agent_fresh_on_cluster_worktree"]);                              // src: vulnhunter-fix/prompts/verify.md:27
            p.rule(θ["p.verify.in_place_escalation_into_pr_body"]);                                 // src: vulnhunter-fix/prompts/verify.md:28
            p.rule(θ["p.verify.in_place_repair_uncapped"]);                                         // src: vulnhunter-fix/prompts/verify.md:29
            p.forbid(θ["p.verify.in_place_no_cap_at_3"]);                                           // src: vulnhunter-fix/prompts/verify.md:29
            p.format(θ["p.verify.in_place_summary_table_per_cluster"]);                             // src: vulnhunter-fix/prompts/verify.md:30
        } else {
            p.rule(θ["p.verify.fork_unit_per_finding_branch"]);                                     // src: vulnhunter-fix/prompts/verify.md:17
            p.rule(θ["p.verify.fork_verifier_inputs"]);                                             // src: vulnhunter-fix/prompts/verify.md:37
            p.rule(θ["p.verify.fork_fix_agent_inputs"]);                                            // src: vulnhunter-fix/prompts/verify.md:38
            p.rule(θ["p.verify.fork_escalation_store"]);                                            // src: vulnhunter-fix/prompts/verify.md:39
            p.rule(θ["p.verify.fork_result_json_per_finding"]);                                     // src: vulnhunter-fix/prompts/verify.md:40
            p.rule(θ["p.verify.fork_repair_capped"]);                                               // src: vulnhunter-fix/prompts/verify.md:41
        }
        p.must(θ["p.verify.committed_test_repo_convention"]);                                       // src: vulnhunter-fix/prompts/verify.md:19
        p.rule(θ["p.verify.locate_test_via_assertion_target"]);                                     // src: vulnhunter-fix/prompts/verify.md:19
        return p;
    }

    Prompt agents(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.verify.verifier_no_fix_context"]);                                              // src: vulnhunter-fix/prompts/verify.md:47
        p.rule(θ["p.verify.fix_agent_may_modify_fix_or_test"]);                                     // src: vulnhunter-fix/prompts/verify.md:48
        return p;
    }

    @executedBy(MODEL)
    List<Finding> findingsInOrder(Unit u, Mode mode, Theta θ) {
        if (mode == Mode.IN_PLACE) {
            return u.cluster.findingsInCommitOrder();                                               // θ["p.verify.in_place_unit_cluster_branch"]  // src: vulnhunter-fix/prompts/verify.md:15
        }
        return List.of(u.finding);                                                                  // θ["p.verify.fork_unit_per_finding_branch"]  // src: vulnhunter-fix/prompts/verify.md:17
    }

    @executedBy(MODEL)
    String locateSecurityTest(Finding f, Mode mode, Theta θ) {
        String evidence = (mode == Mode.IN_PLACE) ? ".vulnhunter-fix/discrimination/<vuln>.json" : ".work/<repo>/discrimination/<vuln>.json"; // src: vulnhunter-fix/prompts/verify.md:19
        String secTest = readJson(evidence).get(θ["p.verify.locate_test_via_assertion_target"]);   // src: vulnhunter-fix/prompts/verify.md:19
        if (θ["p.verify.committed_test_repo_convention"]) assert !secTest.matches("verify_VULN_NNN_*"); // src: vulnhunter-fix/prompts/verify.md:19
        return secTest;
    }

    // ---------------------------------------------------------------- Step 1: Pre-check
    @executedBy(MODEL)
    PreCheckOutcome preCheck(Finding f, String secTest, Mode mode, Theta θ) {
        if (!θ["p.verify.precheck_before_tests"]) return PreCheckOutcome.STILL_PRESENT;             // src: vulnhunter-fix/prompts/verify.md:52
        String base;
        if (mode == Mode.IN_PLACE) {
            if (θ["p.verify.in_place_no_main_tree_switch"]) base = worktreePinnedTo("origin/" + intake().default_branch); // src: vulnhunter-fix/prompts/verify.md:54
            Shell.run("git -C $WT_PATH fetch --quiet origin $DEFAULT_BRANCH");                       // src: vulnhunter-fix/prompts/verify.md:60
            Shell.run("git -C $WT_PATH show origin/<default_branch>:<FINDING_LOCATION> | grep -n <vulnerable_pattern>"); // src: vulnhunter-fix/prompts/verify.md:61
        } else {
            if (θ["p.verify.checkout_main_fork_only"]) {                                            // src: vulnhunter-fix/prompts/verify.md:65
                Shell.run("git fetch origin main");                                                  // src: vulnhunter-fix/prompts/verify.md:70
                Shell.run("git checkout main && git pull");                                          // src: vulnhunter-fix/prompts/verify.md:71
            }
            base = ".work/clone";
        }
        if (!exists(f.targetFiles, base) || substantiallyRewritten(f.targetFiles, base)) {
            return θ["p.verify.precheck_file_gone_diverged"];                                       // FIX_NOT_NEEDED (diverged)  // src: vulnhunter-fix/prompts/verify.md:85
        }
        if (rebaseConflict(f.branch, base)) {
            if (θ["p.verify.precheck_rebase_conflict"]) {                                           // src: vulnhunter-fix/prompts/verify.md:86
                boolean resolved = attemptResolution(f);                                             // counts as a repair attempt
                if (!resolved) return PreCheckOutcome.DIVERGED;
            }
        }
        TestRun t = Shell.run("python3 -m pytest $SEC_TEST -v || true", base);                       // src: vulnhunter-fix/prompts/verify.md:79
        if (t.passed) return θ["p.verify.precheck_test_passes_fix_not_needed"];                     // FIX_NOT_NEEDED  // src: vulnhunter-fix/prompts/verify.md:84
        if (θ["p.verify.precheck_test_fails_proceed"]) return PreCheckOutcome.STILL_PRESENT;        // src: vulnhunter-fix/prompts/verify.md:87
        return PreCheckOutcome.STILL_PRESENT;
    }

    @executedBy(MODEL)
    void documentFixNotNeeded(Finding f, PreCheckOutcome pc, Mode mode, Theta θ) {
        if (mode == Mode.IN_PLACE) {
            if (θ["p.verify.fix_not_needed_in_place_handling"]) {                                   // src: vulnhunter-fix/prompts/verify.md:91
                workJson().drop(f);
                Gh.run("gh issue comment $ISSUE_NUMBER --repo $OWNER_REPO --body <info: fix not needed, omitted from cluster PR>"); // src: vulnhunter-fix/prompts/verify.md:94
                clusterPrBody().addNote(f, "fix not needed");
            }
            if (θ["p.verify.fix_not_needed_no_md_in_place"]) return;                                // no FIX_NOT_NEEDED.md in-place  // src: vulnhunter-fix/prompts/verify.md:91
            return;
        }
        // Fork mode
        writeFile(θ["p.verify.fix_not_needed_fork_md"], fixNotNeededMd(f, pc));                     // Status, Evidence, Recommendation: close without merging  // src: vulnhunter-fix/prompts/verify.md:99
        ResultJson r = resultJson(f);
        r.status = θ["p.verify.fix_not_needed_result_status"];                                      // ALREADY_FIXED  // src: vulnhunter-fix/prompts/verify.md:122
        r.completeness_tier = "FULL";                                                                // literal from template, no knob  // src: vulnhunter-fix/prompts/verify.md:126
        r.pre_check.outcome = choose(θ["p.verify.precheck_outcome_values"], pc);                    // already_fixed | diverged  // src: vulnhunter-fix/prompts/verify.md:132
        writeResult(r);
        if (trackingIssueExists(f)) {
            String cmd = "gh issue comment <issue_number> --repo <fork_org>/<fork_repo> --body <info: fix not needed, branch can be deleted>"; // src: vulnhunter-fix/prompts/verify.md:142
            if (θ["p.verify.fix_not_needed_comment_no_label"]) { /* no needs-human-review label */ } // src: vulnhunter-fix/prompts/verify.md:139
            if (ghBlocked()) {
                appendJson(θ["p.verify.gh_blocked_store_pending_comments"], cmd);                    // post after PR creation  // src: vulnhunter-fix/prompts/verify.md:147
            } else {
                Gh.run(cmd);
            }
        }
    }

    // ---------------------------------------------------------------- Step 2: Validate
    @executedBy(MIXED)
    ValidationResult validate(Finding f, String secTest, Mode mode, Theta θ) {
        ValidationResult v = new ValidationResult();
        v.step2a = runSecurityTest(f, secTest, θ);
        v.step2b = regressionGate(f, θ);
        if (θ["p.verify.verifier_always_runs"]) {                                                  // regardless of test policy  // src: vulnhunter-fix/prompts/verify.md:183
            v.step2c = testQualityReview(f, secTest, mode, θ);
        }
        return v;
    }

    @executedBy(MODEL)
    StepResult runSecurityTest(Finding f, String secTest, Theta θ) {
        Shell.run("git checkout " + f.branch);                                                       // src: vulnhunter-fix/prompts/verify.md:160
        TestRun t = Shell.run("python3 -m pytest $SEC_TEST -v");                                     // src: vulnhunter-fix/prompts/verify.md:161
        return (t.status == θ["p.verify.security_test_must_pass"]) ? StepResult.PASS : StepResult.FAIL; // expected PASS  // src: vulnhunter-fix/prompts/verify.md:164
    }

    // 2b: the verify phase does not rerun the suite; it gates on the worker's recorded outcome.
    @executedBy(MODEL)
    StepResult regressionGate(Finding f, Theta θ) {
        if (!θ["p.verify.verify_no_regression_rerun"]) {                                           // src: vulnhunter-fix/prompts/verify.md:168
            // unclear: the prompt never says what to do if a rerun were wanted; the reference commands below are the worker's.
            regressionCommandsReference(θ);
        }
        ResultJson r = resultJson(f);
        String policy = choose(θ["p.verify.test_policy_values"], r.test_policy_applied);            // best-effort | must-pass | skip  // src: vulnhunter-fix/prompts/verify.md:168
        String rs = r.regression_status;
        if (policy == "best-effort") {
            if (rs == "NO_REGRESSIONS") return StepResult.PASS;                                      // src: vulnhunter-fix/prompts/verify.md:172
            if (rs == "REGRESSIONS_FOUND") return failTo(θ["p.verify.best_effort_regressions_fail"]); // enter repair loop  // src: vulnhunter-fix/prompts/verify.md:173
            if (rs == "ENV_ERROR") return passWithBanner(θ["p.verify.best_effort_env_error_pass"], "Human-in-the-Loop Validation Required"); // not gated  // src: vulnhunter-fix/prompts/verify.md:174
            if (rs == "SKIPPED") return StepResult.ANOMALOUS;                                        // should not happen  // src: vulnhunter-fix/prompts/verify.md:175
        }
        if (policy == "must-pass") {
            if (rs == "NO_REGRESSIONS") return StepResult.PASS;                                      // src: vulnhunter-fix/prompts/verify.md:176
            if (rs == "REGRESSIONS_FOUND") return StepResult.FAIL;                                   // src: vulnhunter-fix/prompts/verify.md:177
            if (rs == "ENV_ERROR") return failTo(θ["p.verify.must_pass_env_error_fail"]);           // escalate to manual review if exhausted  // src: vulnhunter-fix/prompts/verify.md:178
            if (rs == "SKIPPED") return failTo(θ["p.verify.must_pass_skipped_fail"]);               // anomalous -> failure  // src: vulnhunter-fix/prompts/verify.md:179
        }
        if (policy == "skip") {
            if (rs == "SKIPPED") return passWithBanner(θ["p.verify.skip_policy_pass_with_banner"], "Unverified — Manual Test Execution Required"); // src: vulnhunter-fix/prompts/verify.md:180
            return StepResult.ANOMALOUS;                                                             // workers should not run suite under skip  // src: vulnhunter-fix/prompts/verify.md:181
        }
        return StepResult.ANOMALOUS;                                                                 // unclear: anomalous rows have no stated action
    }

    // Reference only: the worker's regression-classification commands (stack-detected, output tailed).
    @executedBy(CODE)
    void regressionCommandsReference(Theta θ) {
        List<String> cmds = θ["p.verify.regression_commands_by_stack"];                             // pytest tests/ | behave tests/features | go test ./... | npm test  // src: vulnhunter-fix/prompts/verify.md:190
        for (String c : cmds) {
            if (stackDetected(c)) Shell.run(c + " 2>&1 | tail -" + θ["p.verify.regression_output_tail_lines"]); // src: vulnhunter-fix/prompts/verify.md:200
        }
    }

    // 2c: fresh reviewer subagent; canonical prompt is prompts/reviewer_test.md.
    @executedBy(MODEL)
    Review testQualityReview(Finding f, String secTest, Mode mode, Theta θ) {
        List<Object> inputs = θ["p.verify.verifier_input_set"];                                     // test file(s), source under test, finding (CWE, root cause) ONLY  // src: vulnhunter-fix/prompts/verify.md:213
        String model = θ["p.verify.verifier_model_sonnet_review"];                                  // src: vulnhunter-fix/prompts/verify.md:26
        Prompt reviewer = PromptsReviewerTest.build(θ["p.verify.reviewer_prompt_canonical"]);       // rubric_excerpt, poc_payload, discrimination_evidence  // src: vulnhunter-fix/prompts/verify.md:233
        Review rv = Runtime.subagent(reviewer.include(reviewQuestions(θ)), inputs);
        return rv;
    }

    Prompt reviewQuestions(Theta θ) {
        Prompt p = new Prompt();
        p.checklist(θ["p.verify.review_q_proves_fixed"]);                                           // attack vector blocked, not just code changed  // src: vulnhunter-fix/prompts/verify.md:220
        p.checklist(θ["p.verify.review_q_behavioral"]);                                             // AST/grep OK only for some classes  // src: vulnhunter-fix/prompts/verify.md:221
        p.checklist(θ["p.verify.review_q_bypasses"]);                                               // src: vulnhunter-fix/prompts/verify.md:222
        p.checklist(θ["p.verify.review_q_false_pass"]);                                             // src: vulnhunter-fix/prompts/verify.md:223
        p.must(θ["p.verify.review_q_imports_production"]);                                          // no production import -> WRONG  // src: vulnhunter-fix/prompts/verify.md:224
        p.choose(θ["p.verify.review_verdict_set"]);                                                 // GOOD | WEAK | WRONG  // src: vulnhunter-fix/prompts/verify.md:227
        p.must(θ["p.verify.fix_brief_on_weak_or_wrong"]);                                           // src: vulnhunter-fix/prompts/verify.md:231
        return p;
    }

    // The reviewer's own decision procedure as stated in Step 2c.
    @executedBy(MODEL)
    Verdict reviewerDecide(TestCode t, Theta θ) {
        if (θ["p.verify.review_q_imports_production"] != null && !t.importsProductionCode()) return Verdict.WRONG; // src: vulnhunter-fix/prompts/verify.md:224
        if (θ["p.verify.review_q_false_pass"] && t.wouldPassWithVulnPresent()) return Verdict.WRONG; // src: vulnhunter-fix/prompts/verify.md:223
        if (θ["p.verify.review_q_proves_fixed"] && !t.provesAttackBlocked()) return Verdict.WRONG;  // src: vulnhunter-fix/prompts/verify.md:220
        if (θ["p.verify.review_q_behavioral"] && t.superficialForClass()) return Verdict.WEAK;      // unclear: WEAK vs WRONG for superficial tests  // src: vulnhunter-fix/prompts/verify.md:221
        if (θ["p.verify.review_q_bypasses"] && t.hasObviousBypass()) return Verdict.WEAK;           // src: vulnhunter-fix/prompts/verify.md:222
        return Verdict.GOOD;
    }

    // ---------------------------------------------------------------- Step 3: Repair loop
    @executedBy(MIXED)
    RepairOutcome repairLoop(Finding f, String secTest, ValidationResult v, Mode mode, Theta θ) {
        if (!v.failedAnyOf(θ["p.verify.repair_loop_trigger"])) return RepairOutcome.verified(1);    // 2a | 2b | 2c  // src: vulnhunter-fix/prompts/verify.md:237
        Integer cap = null;
        if (mode == Mode.IN_PLACE) {
            cap = null;                                                                              // θ["p.verify.in_place_repair_uncapped"]: developer decides  // src: vulnhunter-fix/prompts/verify.md:241
        } else {
            cap = θ["p.verify.fork_max_repair_attempts"];                                           // config verification.max_repair_attempts  // src: vulnhunter-fix/prompts/verify.md:242
        }
        if (mode == Mode.FORK) return forkRepairLoop(f, secTest, v, cap, θ);
        int attempt = 0;
        while (true) {
            attempt++;
            if (mode == Mode.IN_PLACE && θ["p.verify.in_place_cap_routes_to_collab"] && attempt > θ["p.verify.fork_max_repair_attempts"]) { // src: vulnhunter-fix/prompts/verify.md:241
                Decision d = PromptsImplement.collaborationLoop(f);                                  // developer picks the next move
                if (d.stop) return RepairOutcome.stoppedByDeveloper(attempt);
            }
            if (θ["p.verify.worktree_reset_before_retry"]) Shell.run("python3 scripts/worktree-reset.py"); // src: vulnhunter-fix/prompts/verify.md:548
            FixBrief brief = diagnose(f, v, attempt, θ);
            applyFix(f, brief, attempt, mode, θ);
            if (θ["p.verify.revalidate_after_repair"]) v = validate(f, secTest, mode, θ);           // rerun 2a, 2b, 2c  // src: vulnhunter-fix/prompts/verify.md:277
            if (v.allPass()) return RepairOutcome.verified(attempt + 1);                             // src: vulnhunter-fix/prompts/verify.md:279
        }
    }

    // Per-attempt step 1: verification agent diagnoses and writes the fix brief.
    @executedBy(MODEL)
    FixBrief diagnose(Finding f, ValidationResult v, int attempt, Theta θ) {
        String model = θ["p.verify.verifier_model_opus_diagnosis"];                                 // src: vulnhunter-fix/prompts/verify.md:26
        Prompt p = new Prompt();
        p.format(θ["p.verify.fix_brief_fields"]);                                                   // Failed step | Symptom | Root cause | Instruction | Constraints  // src: vulnhunter-fix/prompts/verify.md:249
        return Runtime.subagent(p, List.of(f.testFile, f.sourceFiles, v.failureOutput));
    }

    // Per-attempt step 2: fix agent applies changes and commits.
    @executedBy(MODEL)
    void applyFix(Finding f, FixBrief brief, int attempt, Mode mode, Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.verify.fix_agent_may_modify_fix_or_test"]);                                     // fix code, or test if verifier says test is wrong  // src: vulnhunter-fix/prompts/verify.md:261
        p.forbid(θ["p.verify.no_test_weakening"]);                                                  // unless verifier agrees  // src: vulnhunter-fix/prompts/verify.md:263
        String wt = (mode == Mode.IN_PLACE) ? θ["p.verify.fix_agent_fresh_on_cluster_worktree"] : f.worktreePath; // src: vulnhunter-fix/prompts/verify.md:27
        Runtime.subagent(p, List.of(brief, wt));
        if (θ["p.verify.commit_each_repair_attempt"]) {                                            // src: vulnhunter-fix/prompts/verify.md:264
            Shell.run("git commit -m 'fix(security): VULN-NNN repair attempt " + attempt + "' " + θ["p.verify.repair_commit_trailers"]); // src: vulnhunter-fix/prompts/verify.md:272
        }
    }

    // Fork mode repair loop mechanics (orchestrator over the clone).
    @executedBy(MIXED)
    RepairOutcome forkRepairLoop(Finding f, String secTest, ValidationResult v, int cap, Theta θ) {
        ResultJson r = resultJson(f);                                                                // status FAILED  // src: vulnhunter-fix/prompts/verify.md:287
        List<Attempt> history = new List();
        for (int attempt = 1; attempt <= cap; attempt++) {                                           // src: vulnhunter-fix/prompts/verify.md:295
            if (θ["p.verify.worktree_reset_before_retry"]) Shell.run("python3 scripts/worktree-reset.py"); // src: vulnhunter-fix/prompts/verify.md:548
            FixBrief brief;
            if (θ["p.verify.fork_repair_fresh_agents"]) {                                          // src: vulnhunter-fix/prompts/verify.md:288
                brief = Runtime.subagent(new Prompt().format(θ["p.verify.fix_brief_fields"]), List.of(f.testFile, f.sourceFiles, f, r.errorOutput)); // diagnosis JSON  // src: vulnhunter-fix/prompts/verify.md:290
                PromptsAgentFix.run(brief, f.worktreePath, f.branch, brief.constraints);             // fresh fix agent  // src: vulnhunter-fix/prompts/verify.md:291
            }
            List<String> reran = θ["p.verify.fork_fix_agent_revalidates_2a_2b"];                    // fix agent reruns 2a+2b, commits, writes result JSON  // src: vulnhunter-fix/prompts/verify.md:293
            r = resultJson(f);                                                                       // src: vulnhunter-fix/prompts/verify.md:294
            history.add(new Attempt(attempt, brief, r));
            if (r.passing()) {
                r.status = θ["p.verify.fork_pass_status_verified"];                                 // VERIFIED  // src: vulnhunter-fix/prompts/verify.md:296
                writeResult(r);
                return RepairOutcome.verified(attempt);
            }
        }
        r.status = θ["p.verify.fork_exhausted_status"];                                             // NEEDS_MANUAL_REVIEW + attempt history  // src: vulnhunter-fix/prompts/verify.md:297
        r.repair_history = history;
        writeResult(r);
        return RepairOutcome.exhausted(history);
    }

    // ---------------------------------------------------------------- Step 4: Escalate (fork only)
    @executedBy(MODEL)
    void escalate(Finding f, RepairOutcome ro, Mode mode, Theta θ) {
        if (mode == Mode.IN_PLACE) {
            if (θ["p.verify.in_place_never_reaches_step4"]) {                                      // wrong turn: go back to collaboration loop  // src: vulnhunter-fix/prompts/verify.md:303
                PromptsImplement.collaborationLoop(f);
                return;
            }
        }
        // 4a
        writeFile(θ["p.verify.escalation_doc_written"], needsHumanReviewMd(f, ro));                  // attempts, current state, why failed, next steps  // src: vulnhunter-fix/prompts/verify.md:309
        // 4b
        if (trackingIssueExists(f)) {
            Gh.run("gh issue edit <issue_number> --repo <fork_org>/<fork_repo> --add-label " + θ["p.verify.escalation_label"]); // src: vulnhunter-fix/prompts/verify.md:356
            Gh.run("gh issue comment <issue_number> --repo <fork_org>/<fork_repo> --body-file .work/delivery/human-review-VULN-NNN.md"); // src: vulnhunter-fix/prompts/verify.md:359
        } else {
            appendJson(θ["p.verify.fork_escalation_store"], pendingReview(f, ro));                  // pending-human-reviews.json  // src: vulnhunter-fix/prompts/verify.md:394
            // Phase 5 later creates the PR as draft with these labels.
            List<String> labels = θ["p.verify.escalated_pr_draft_labels"];                          // security, vulnhunter-fix, needs-human-review  // src: vulnhunter-fix/prompts/verify.md:435
        }
        // 4c
        if (prExists(f)) {
            Gh.run("gh pr edit <pr_number> --repo <fork_org>/<fork_repo> --add-label needs-human-review"); // src: vulnhunter-fix/prompts/verify.md:444
            if (θ["p.verify.escalated_pr_stays_draft"]) Gh.runIgnoringErrors("gh pr ready <pr_number> --undo"); // src: vulnhunter-fix/prompts/verify.md:449
        }
        // 4d
        ResultJson r = resultJson(f);
        r.status = θ["p.verify.fork_exhausted_status"];                                             // NEEDS_MANUAL_REVIEW  // src: vulnhunter-fix/prompts/verify.md:463
        r.completeness_tier = θ["p.verify.escalated_result_tier_mitigation"];                       // MITIGATION + residual_vectors  // src: vulnhunter-fix/prompts/verify.md:468
        writeResult(r);
    }

    // ---------------------------------------------------------------- Steps 5-9 (mandatory, both modes)
    Prompt steps5to9Preamble(Mode mode, Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.verify.steps_5_9_mandatory"]);                                                  // src: vulnhunter-fix/prompts/verify.md:489
        if (mode == Mode.IN_PLACE) p.rule(θ["p.verify.in_place_path_substitution"]);                // .work/<repo>/ -> .vulnhunter-fix/  // src: vulnhunter-fix/prompts/verify.md:491
        return p;
    }

    // Step 5: post-fix completeness re-classification (REQ-HON-003)
    @executedBy(MIXED)
    void postFixTierReclassify(List<FindingOutcome> outs, Mode mode, Theta θ) {
        steps5to9Preamble(mode, θ);
        if (!θ["p.verify.postfix_tier_reclassify"]) return;                                         // src: vulnhunter-fix/prompts/verify.md:493
        for (FindingOutcome o : outs.verified()) {
            Shell.run("git diff main..HEAD -- <files-affected> > /tmp/applied.diff");                // src: vulnhunter-fix/prompts/verify.md:496
            Tier t = ComputeCompletenessTier.main("--diff", "/tmp/applied.diff", "--plan", o.planPath, "--result", o.resultPath, "--phase", "verify"); // src: vulnhunter-fix/prompts/verify.md:497
            if (t == Tier.LLM_REVIEW) {
                t = PromptsTierJudgment.run(o, θ["p.verify.llm_review_tier_judgment_settings"]);    // temp=0, max 2 attempts  // src: vulnhunter-fix/prompts/verify.md:504
                if (θ["p.verify.llm_review_never_terminal"]) assert t != Tier.LLM_REVIEW;           // src: vulnhunter-fix/prompts/verify.md:504
            }
            if (o.isCrypto() && o.cryptoTrustChain.containsFalse()) {
                t = θ["p.verify.crypto_trust_chain_forces_mitigation"];                             // MITIGATION + trust-chain: residual  // src: vulnhunter-fix/prompts/verify.md:504
                o.residualVectors.add("trust-chain: ...");
            }
            if (t != o.plannedTier && θ["p.verify.tier_mismatch_triggers_repair"]) {               // src: vulnhunter-fix/prompts/verify.md:504
                repairLoop(o.finding, o.secTest, ValidationResult.tierMismatch(o.plannedTier, t), mode, θ);
            }
            o.recordTier(t);
        }
    }

    // Step 6: root-cause sweep (REQ-SWP-001..009)
    @executedBy(MIXED)
    void rootCauseSweep(List<FindingOutcome> outs, Mode mode, Theta θ) {
        if (!θ["p.verify.sweep_every_verified_finding"]) return;                                    // src: vulnhunter-fix/prompts/verify.md:508
        SweepSummary s = SweepRootCauses.main("--repo-root", ".work/<repo>/clone", "--results-dir", ".work/<repo>/.vulnfix-manifests/", "--graph", ".work/<repo>/cache/graph.json", "--patterns", "references/sweep-patterns.md", "--triage-dir", ".work/<repo>/graph_context/", "--out", ".work/<repo>/sweep_summary.json"); // src: vulnhunter-fix/prompts/verify.md:511
        for (Sibling sib : s.siblings) {
            FindingOutcome o = outs.of(sib.vuln);
            if (o.result.files_modified.contains(sib.file)) {
                amendIntoPr(o, sib);                                                                 // θ["p.verify.sweep_path_a_amend"]  Path A  // src: vulnhunter-fix/prompts/verify.md:520
            } else {
                fileIssue(sib, θ["p.verify.sweep_path_b_issue"]);                                   // vulnfix-sweep-detected  // src: vulnhunter-fix/prompts/verify.md:520
            }
            if (o.tier == Tier.FULL) {
                o.status = θ["p.verify.sweep_downgrades_full"];                                     // VERIFIED_MITIGATION, sweep_revised=true  // src: vulnhunter-fix/prompts/verify.md:520
                o.result.sweep_revised = true;
            }
        }
        String pathA = θ["p.verify.sweep_path_a_amend"];                                            // src: vulnhunter-fix/prompts/verify.md:520
    }

    // Step 7: 9-column verification table (REQ-GRA-011)
    @executedBy(MIXED)
    Table verificationTable(List<FindingOutcome> outs, Theta θ) {
        Table t = DeliveryRenderVerificationTable.render(outs);                                      // vulnhunter_fix.delivery.render_verification_table, else composed verbatim
        t.columns = θ["p.verify.verification_table_columns"];                                       // #, VULN-NNN, ..., Verdict  // src: vulnhunter-fix/prompts/verify.md:524
        for (Cell c : t.cells()) {
            if (c.value == "yes" && θ["p.verify.verification_table_cite_yes"]) assert c.hasFileLineCitation(); // src: vulnhunter-fix/prompts/verify.md:524
            if (c.column == 7) {
                c.value = graph().callersOf(c.sinkSymbol);
                if (c.lowConfidence) c.annotate(θ["p.verify.col7_callers_enumeration"]);            // (grep_fallback)  // src: vulnhunter-fix/prompts/verify.md:524
            }
        }
        if (θ["p.verify.verification_table_headers_verbatim"]) assert t.headers.equals(θ["p.verify.verification_table_columns"]); // validate-verification.py refuses otherwise  // src: vulnhunter-fix/prompts/verify.md:524
        return t;
    }

    // Step 8: mechanical delivery gates (REQ-GAT-001..013)
    @executedBy(MIXED)
    void mechanicalGates(List<FindingOutcome> outs, Mode mode, Theta θ) {
        if (θ["p.verify.gates_before_any_gh"]) {                                                   // src: vulnhunter-fix/prompts/verify.md:528
            List<String> args = List.of("--pr-body", "--issue-body", "--result", "--sidecar", "--sidecars-dir", "--branch", "--repo-root"); // src: vulnhunter-fix/prompts/verify.md:531
            if (θ["p.verify.gate7_default_branch_arg"] && defaultBranchKnown()) args.add("--default-branch"); // omit only if base unknown  // src: vulnhunter-fix/prompts/verify.md:545
            GateResult g = RunGates.run(args, θ);
            if (!g.pass && θ["p.verify.failing_gate_halts_delivery"]) halt();                      // src: vulnhunter-fix/prompts/verify.md:548
        }
    }

    // Step 9: phase-exit validators (REQ-SCH-003)
    @executedBy(MIXED)
    void phaseExitValidators(List<FindingOutcome> outs, Theta θ) {
        for (FindingOutcome o : outs) {
            if (θ["p.verify.result_json_validator"]) {                                             // src: vulnhunter-fix/prompts/verify.md:552
                boolean ok = ValidateResult.main(o.resultPath);
                if (!ok && θ["p.verify.schema_repair_loop"]) schemaRepairLoop(o);                  // REQ-SCH-004  // src: vulnhunter-fix/prompts/verify.md:552
            }
        }
        if (θ["p.verify.gate6_sidecars_fail_closed"]) { /* Gate 6 inside run-gates.py gets --sidecars-dir; fails closed on unverifiable yes coverage cell */ } // src: vulnhunter-fix/prompts/verify.md:552
    }

    @executedBy(MODEL)
    void phaseExitCriteria(List<FindingOutcome> outs, Theta θ) {
        for (String criterion : θ["p.verify.phase_exit_checklist"]) {                               // tier recorded, sweep_summary.json, 9-col table, gates pass, validators pass  // src: vulnhunter-fix/prompts/verify.md:554
            if (!holds(criterion, outs)) halt();                                                     // do not proceed to Step 10 / Phase 5
        }
    }

    // ---------------------------------------------------------------- Step 10: Final summary
    @executedBy(MODEL)
    Summary finalSummary(List<FindingOutcome> outs, Mode mode, Theta θ) {
        Summary s = new Summary();
        s.table(θ["p.verify.final_summary_columns"], outs);                                         // VULN ID | Security Test | Full Suite | Quality | Attempts | Status  // src: vulnhunter-fix/prompts/verify.md:569
        for (FindingOutcome o : outs) {
            if (o.status == "VERIFIED" && θ["p.verify.only_verified_ready_prs"]) s.readyPrs.add(o);  // src: vulnhunter-fix/prompts/verify.md:581
            else if (o.status == "NEEDS_MANUAL_REVIEW" && θ["p.verify.manual_review_draft_prs"]) s.draftPrs.add(o); // labeled needs-human-review  // src: vulnhunter-fix/prompts/verify.md:582
            else if (θ["p.verify.not_needed_info_only"]) s.infoOnly.add(o);                          // ALREADY_FIXED / FIX_NOT_NEEDED  // src: vulnhunter-fix/prompts/verify.md:583
        }
        return s;                                                                                    // then PromptsDeliver.run(...)
    }

    // ---------------------------------------------------------------- Configuration
    @executedBy(CODE) @role(config)
    void configuration(Theta θ) {
        int maxRepair = θ["p.verify.fork_max_repair_attempts"];                                     // verification.max_repair_attempts = 3  // src: vulnhunter-fix/prompts/verify.md:592
        int testTimeout = θ["p.verify.test_timeout_seconds_doc"];                                   // verification.test_timeout_seconds = 120  // src: vulnhunter-fix/prompts/verify.md:593
    }
}
