// file: vvaharness/backends/harness/deepagents/options/graph_builder.py
// Graph-compilation helper shared by the streaming and one-shot graphs: _create_agent builds the model, the system
// prompt, the tool list, the middleware stack (order matters) and compiles it with create_deep_agent under a build
// lock. Also holds the middlewares defined here: LogToolCalls, CapOutputTokens (per-request output cap with one doubled
// retry on truncation) and LogInvalidRequestShape; plus the connection-retry middleware shared with every subagent spec.

@executedBy(CODE) @role(backend)
class GraphBuilder {

    // Serializes create_deep_agent so a suffix-stripped window cannot leak into a concurrent build
    Lock BUILD_LOCK = new Lock();                                                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:90

    // Module import: the langchain-anthropic warning about a forced tool_choice under thinking is shown once, message-anchored
    // (a module filter never matches with stacklevel 2). The drop itself is compensated by submitInstructedPrompt.
    void installWarningFilter() {
        warnings.filterwarnings("once", "tool_choice is forced but thinking is enabled", UserWarning);   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:76
    }

    // A dropped connection safe to retry per call, not a TLS or proxy failure. backends.llm.models is the single home of
    // the proxy/TLS failure signature.
    boolean connectionRetryable(Exception exc) {                                                         // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:105
        return ResponseQuality.isConnectionFailure(exc) && LlmModels.proxyDetail(exc) == null;           // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:107
    }

    // Shared verbatim with every subagent spec (options/subagents); never copied. Retries a model call on a dropped
    // connection; on_failure error re-raises after the last attempt.
    ModelRetryMiddleware connectionRetryMiddleware(Theta θ) {                                            // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:111
        return new ModelRetryMiddleware(
            θ["code.backends.harness.deepagents.options.graph_builder.connection_retry_max_retries"],    // 3   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:112
            θ["code.backends.harness.deepagents.options.graph_builder.connection_retry_initial_delay_s"], // 5  // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:112
            θ["code.backends.harness.deepagents.options.graph_builder.connection_retry_backoff_factor"], // 2   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:112
            θ["code.backends.harness.deepagents.options.graph_builder.connection_retry_max_delay_s"],    // 60  // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:112
            this::connectionRetryable, "error");                                                         // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:113
    }

    // Blank or stage-swap every harness-profile suffix for the build; the caller holds BUILD_LOCK. Only the suffix is
    // rewritten (no public opt-out for the model-keyed suffix in 0.7.x). The registry is restored in finally.
    void restagedHarnessProfiles(String stage, boolean blank, Theta θ) {                                 // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:148
        ensureHarnessProfilesLoaded();                                                                   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:151
        Map saved = copy(HARNESS_PROFILES);                                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:152
        for (key, profile : saved) {                                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:153
            String suffix = blank ? "" : DeepagentsProfiles.stageProfileSuffix(stage, key, θ);           // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:154
            if (suffix != null) HARNESS_PROFILES[key] = profile.withSystemPromptSuffix(suffix);          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:155
        }
        try {
            yield;                                                                                       // body: create_deep_agent runs here
        } finally {
            HARNESS_PROFILES.clear();                                                                    // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:160
            HARNESS_PROFILES.update(saved);
        }
    }

    // The BaseMessage list a wrap_model_call handler result carries, across all three ModelCallResult shapes.
    List<Message> resultMessages(Object result) {                                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:165
        if (result instanceof ExtendedModelResponse) result = result.modelResponse;                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:167
        if (result instanceof ModelResponse) return result.result;                                       // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:169
        return [result];                                                                                 // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:171
    }

    // Every BaseModel or Enum class reachable inside one field annotation (recurses through generic type arguments).
    List<Type> leafSerdeClasses(Object annotation) {                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:325
        if (annotation == null) return [];                                                               // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:327
        args = typeArgs(annotation);
        if (args.nonEmpty()) {                                                                           // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:330
            List out = [];
            for (arg : args) out.addAll(leafSerdeClasses(arg));
            return out;
        }
        if (isType(annotation) && (isSubclass(annotation, BaseModel) || isSubclass(annotation, Enum))) return [annotation]; // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:336
        return [];
    }

    // Walk the root pydantic schema for every nested BaseModel or Enum its fields can produce, as (module, name) pairs for
    // the checkpointer msgpack allow-list. Only Enums are keyed (model_dump flattens models); a missing key leaks the raw
    // enum VALUE. Iterative DFS with a seen set; returned in set order.
    List<Pair<String, String>> reachableSerdeClasses(Type root) {                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:340
        Set seen = new Set();
        List stack = [root];
        while (stack.nonEmpty()) {                                                                       // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:346
            cls = stack.pop();
            if (seen.contains(cls)) continue;                                                            // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:348
            seen.add(cls);
            if (isSubclass(cls, BaseModel)) {                                                            // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:351
                for (field : cls.modelFields.values()) {
                    for (nested : leafSerdeClasses(field.annotation)) {
                        if (!seen.contains(nested)) stack.add(nested);                                   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:355
                    }
                }
            }
        }
        return seen.map(cls -> pair(cls.module, cls.name));                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:357
    }

    // Graph builder shared by the streaming and one-shot graphs. Middleware order is the load-bearing output.
    CompiledStateGraph createAgent(String modelId, Env env, Prompt systemPrompt, List<Tool> tools, String name, List<String> skills, List<FilesystemPermission> permissions, String modelProvider, boolean redactReads, FilesystemBackend backend, Type responseModel, Object responseFormat, List<SubagentSpec> subagents, Set<String> extraExcludedTools, Integer maxOutputTokens, Integer outputCap, Set<String> permittedToolCalls, boolean stripHarnessSuffix, boolean cacheMarkers, boolean cacheTail, List<Middleware> parentMiddleware, String effort, Boolean useResponsesApi, boolean thinkInPrompt, Theta θ) { // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:360
        MemorySaver checkpointer;
        if (responseModel == null) {                                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:388
            checkpointer = new MemorySaver();
        } else {
            // every nested BaseModel or Enum the schema can reach, not just responseModel itself
            allowedModels = reachableSerdeClasses(responseModel);                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:392
            checkpointer = new MemorySaver(new JsonPlusSerializer(allowedModels));                       // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:393
        }
        // first build_model_cached call: the model object used only to decide the instructed-prompt compensation
        ChatModel model = ModelBuilding.buildModelCached(modelId, env, modelProvider, effort, useResponsesApi, false, θ); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:396
        // deliberate scoped exception to staying byte-identical on S10 and S11: langchain-anthropic drops a forced
        // tool_choice under thinking on EVERY Anthropic route, so structured calls get the same preventive fix
        systemPrompt = ResponseFormat.submitInstructedPrompt(systemPrompt, model, responseModel, responseFormat, θ); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:400
        DeepagentsProfiles.registerVvahHarnessProfiles(θ);                                               // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:401
        Map kwargs = new Map();
        // second build_model_cached call (separate cache key when thinkInPrompt differs)
        kwargs["model"] = ModelBuilding.buildModelCached(modelId, env, modelProvider, effort, useResponsesApi, thinkInPrompt, θ); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:404
        // same predicate as build_model native-reasoning drop, so no route loses both
        kwargs["system_prompt"] = (thinkInPrompt && ModelBuilding.reasonsInPrompt(modelId, modelProvider, θ))
            ? (systemPrompt or "") + REASON_IN_PROMPT : systemPrompt;                                    // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:410
        kwargs["tools"] = tools;
        kwargs["name"] = name;
        kwargs["permissions"] = permissions;
        kwargs["checkpointer"] = checkpointer;                                                           // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:416
        // OMITTED, not null or empty: SkillsMiddleware injects ~1.9k chars even with zero skills; do not tidy
        if (skills != null) kwargs["skills"] = skills;                                                   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:419
        // a flat fix agent cannot redact: edit_file needs byte-exact old_string; ONE ExcludeTools only
        Set<String> extra = extraExcludedTools != null && extraExcludedTools.nonEmpty() ? extraExcludedTools : emptySet(); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:421
        List<Middleware> middleware;
        if (redactReads) {                                                                               // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:424
            middleware = concat(Redaction.readOnlyMiddleware(extra, θ), parentMiddleware);               // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:425
        } else {
            middleware = concat([new ExcludeTools(union(Set.of(DELETE_TOOL_NAME), extra))], parentMiddleware); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:427
        }
        // both arms, both flavors: a no-op without an invalid call or a gateway 400
        middleware.add(new RepairInvalidToolArgs());                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:435
        middleware.add(new LogInvalidRequestShape(name));                                                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:436
        // per-call output cap; null keeps the model ceiling: 64k on Anthropic, uncapped on OpenAI
        if (maxOutputTokens != null) middleware.add(new CapOutputTokens(maxOutputTokens, name, outputCap)); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:438
        // ExcludeTools only un-advertises, so this is unreachable not absent; null = NO gate
        if (permittedToolCalls != null) middleware.add(new PermitTools(permittedToolCalls));             // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:441
        // shares the auto-attached caching middleware name, so deepagents replaces it in place
        middleware.add(new BlockMarkerPromptCaching(cacheMarkers, cacheTail));                           // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:444
        // stderr-only; adds no kwarg, prompt or tool-list surface, so safe on frozen S10 and S11 too
        middleware.add(new LogToolCalls(name));                                                          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:449
        // last of ours (deepagents splices its request-filter tail inside it): the outer budget claims once per call.
        // preflight probes must report an unreachable endpoint at once, not after the retry window
        if (!name.startsWith(θ["code.backends.harness.deepagents.options.graph_builder.no_retry_name_prefix"])) { // "preflight" // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:447
            middleware.add(connectionRetryMiddleware(θ));                                                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:454
        }
        kwargs["middleware"] = middleware;
        if (responseFormat != null) kwargs["response_format"] = responseFormat;                          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:455
        if (subagents != null) kwargs["subagents"] = subagents;
        if (backend != null) kwargs["backend"] = backend;
        // every build takes the lock so the strip window cannot bleed into a concurrent build
        BUILD_LOCK.acquire();
        try {
            restagedHarnessProfiles(name, stripHarnessSuffix, θ);                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:457
            return createDeepAgent(kwargs);                                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:458
        } finally {
            BUILD_LOCK.release();
        }
    }
}

// One stderr line per tool call: the deepagents route own version of the tool log line. NAME and SIZE only: ordering
// versus RedactToolResults varies, so raw content must never be logged.
@executedBy(CODE) @role(step)
class LogToolCalls {

    String tag;

    void init(String tag) {
        this.tag = tag;                                                                                  // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:125
    }

    Object log(ToolCallRequest request, Object result) {                                                 // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:125
        if (!ScanProgress.isStageOnly()) {                                                               // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:127
            String name = request.toolCall.get("name") != null ? request.toolCall.get("name") : "";
            content = result.content != null ? result.content : "";
            int n = content instanceof String ? content.length() : 0;                                    // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:130
            Console.write("tool " + name + " -> " + n + " chars" + (tag != null && tag != "" ? " [" + tag + "]" : "")); // display only
        }
        return result;                                                                                   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:133
    }

    Object wrapToolCall(ToolCallRequest request, Handler handler) {                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:135
        return log(request, handler.call(request));                                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:139
    }

    Object awrapToolCall(ToolCallRequest request, Handler handler) {                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:141
        return log(request, await handler.call(request));                                                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:146
    }
}

// Per-request output-token cap applied as a model_settings override (no cache churn). The truncated call is retried ONCE
// at a doubled cap resending THIS request; agentic() raises VVAH-E005 if the retry is clipped again.
@executedBy(CODE) @role(step)
class CapOutputTokens {

    int maxTokens;
    String tag;
    int capCeiling;

    void init(int maxTokens, String tag, Integer cap, Theta θ) {
        this.maxTokens = maxTokens;                                                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:180
        this.tag = tag;
        this.capCeiling = cap != null ? cap : θ["code.deepagents.model_max_output_tokens"];              // fallback MODEL_MAX_OUTPUT_TOKENS // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:182
    }

    ModelRequest cap(ModelRequest request, int maxTokens) {                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:186
        return request.override(merge(request.modelSettings, Map.of("max_tokens", maxTokens)));          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:187
    }

    // The doubled cap to resend at, or null when there is no headroom under the ceiling.
    Integer retryAt() {                                                                                  // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:191
        return LlmModels.truncationRetryMax(maxTokens, capCeiling);                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:192
    }

    // Count the discarded result spend: billed, but it never reaches graph state.
    SessionUsage bank(Object discarded) {                                                                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:194
        usage = Usage.aggregateUsageMetadata(resultMessages(discarded));                                 // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:196
        if (usage) TOKENS.add(usage, usage.get("turns"));                                                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:198
        return usage;
    }

    void logRetry(int retryAt, SessionUsage usage) {                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:201
        produced = usage ? usage.get("output_tokens") : null;
        Counters.bump(TRUNCATED_RETRY_ATTEMPTED_COUNTER);                                                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:204
        // log line plus an errlog row: VVAH-E005 warning, recovered=true, produced tokens
        Errlog.log(tag != null ? tag : "deepagents", "VVAH-E005 warning: model call truncated; retrying once at doubled cap", true, produced); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:207
    }

    // Doubled cap to resend a clipped result at; null if not clipped or no headroom.
    Integer truncationRetryAt(Object discarded) {                                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:213
        if (!DeepagentsTranslate.replyTruncated(resultMessages(discarded))) return null;                 // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:215
        Integer retryAt = retryAt();
        if (retryAt != null) logRetry(retryAt, bank(discarded));                                         // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:218
        return retryAt;
    }

    // Native structured output is parsed INSIDE the handler, so a final the cap cut off surfaces as a parse failure, never
    // as a clipped result; either way it was billed. Bank the rejected final, then the doubled cap if it was cut off.
    Integer rejected(StructuredOutputValidationError exc) {                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:222
        usage = bank(exc.aiMessage);                                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:226
        if (!DeepagentsTranslate.replyTruncated([exc.aiMessage])) return null;                           // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:227
        Integer retryAt = retryAt();
        if (retryAt != null) logRetry(retryAt, usage);                                                   // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:230
        return retryAt;
    }

    // Count the retried result as recovered unless it was clipped again (agentic then raises E005).
    Object accepted(Object retried) {                                                                    // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:235
        if (!DeepagentsTranslate.replyTruncated(resultMessages(retried))) Counters.bump(TRUNCATED_RETRY_RECOVERED_COUNTER); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:238
        return retried;
    }

    // Context manager: bank a doubled retry final that the parser rejects before re-raising.
    Object bankingRejectedFinal(Handler body) {                                                          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:242
        try {
            return body.run();
        } catch (StructuredOutputValidationError exc) {
            bank(exc.aiMessage);                                                                         // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:248
            throw exc;
        }
    }

    // Call the model at the output-token cap; retry once, doubled, if cut off.
    Object wrapModelCall(ModelRequest request, Handler handler) {                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:250
        Integer retryAt;
        try {
            result = handler.call(cap(request, maxTokens));                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:255
        } catch (StructuredOutputValidationError exc) {
            retryAt = rejected(exc);                                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:257
            if (retryAt == null) throw exc;                                                              // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:258
        } else {
            retryAt = truncationRetryAt(result);                                                         // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:261
            if (retryAt == null) return result;                                                          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:262
        }
        return bankingRejectedFinal(() -> accepted(handler.call(cap(request, retryAt))));                // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:264
    }

    // Async counterpart of wrapModelCall (identical decisions, awaited handler).
    Object awrapModelCall(ModelRequest request, Handler handler) {                                       // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:267
        Integer retryAt;
        try {
            result = await handler.call(cap(request, maxTokens));                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:274
        } catch (StructuredOutputValidationError exc) {
            retryAt = rejected(exc);                                                                     // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:276
            if (retryAt == null) throw exc;
        } else {
            retryAt = truncationRetryAt(result);                                                         // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:280
            if (retryAt == null) return result;
        }
        return bankingRejectedFinal(() -> accepted(await handler.call(cap(request, retryAt))));          // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:284
    }
}

// Diagnose a gateway invalid-request 400 with the request shape, then re-raise it.
@executedBy(CODE) @role(step)
class LogInvalidRequestShape {

    String tag;

    void init(String tag) {
        this.tag = tag;                                                                                  // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:292
    }

    // recovered=true: diagnostic only; the call own failure row records any loss
    void logShape(ModelRequest request, ModelInvalidRequestError exc) {                                  // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:295
        Errlog.log(tag != null ? tag : "deepagents", LlmOpenai.payloadShape(request.messages.map(m -> Map.of("content", m.content)), str(exc)), "deepagents_invalid_request_shape", true); // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:297
    }

    Object wrapModelCall(ModelRequest request, Handler handler) {                                        // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:302
        try {
            return handler.call(request);
        } catch (ModelInvalidRequestError exc) {
            logShape(request, exc);                                                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:309
            throw exc;
        }
    }

    Object awrapModelCall(ModelRequest request, Handler handler) {                                       // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:312
        try {
            return await handler.call(request);
        } catch (ModelInvalidRequestError exc) {
            logShape(request, exc);                                                                      // src: vvaharness/backends/harness/deepagents/options/graph_builder.py:320
            throw exc;
        }
    }
}
