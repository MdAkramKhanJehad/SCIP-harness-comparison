// file: vvaharness/pipeline/stages/s7/outcomes.py
// Step 7's output contract (field descriptions the model reads as instructions) and the
// parse that fails open (an unparseable reply collapses nothing).

@executedBy(MODEL) @role(prompt) @stage("S7")
class S7Outcomes {

    Schema schema(Theta θ) {
        // DedupDecisions: decisions: list<DedupDecision>
        Prompt p = new Prompt();
        p.must(θ["p.s7_outcomes.decisions_one_per_index_ascending"]);                           // src: vvaharness/pipeline/stages/s7/outcomes.py:57
        p.rule(θ["p.s7_outcomes.decisions_omitted_kept_separate"]);                             // src: vvaharness/pipeline/stages/s7/outcomes.py:58
        p.include(decision(θ));
        return Schema.of("DedupDecisions", p);
    }

    Prompt decision(Theta θ) {
        // DedupDecision fields: index, duplicate_of, reasoning, independent_sites (default false).
        Prompt p = new Prompt();
        p.format(θ["p.s7_outcomes.index_echo_verbatim"]);                                       // src: vvaharness/pipeline/stages/s7/outcomes.py:33
        p.must(θ["p.s7_outcomes.duplicate_of_always_lower_index"]);                             // src: vvaharness/pipeline/stages/s7/outcomes.py:35
        p.format(θ["p.s7_outcomes.duplicate_of_minus_one_not_duplicate"]);                      // src: vvaharness/pipeline/stages/s7/outcomes.py:36
        p.rule(θ["p.s7_outcomes.non_duplicate_is_common_answer"]);                              // src: vvaharness/pipeline/stages/s7/outcomes.py:37
        p.format(θ["p.s7_outcomes.reasoning_one_sentence_single_fix"]);                         // src: vvaharness/pipeline/stages/s7/outcomes.py:39
        p.rule(θ["p.s7_outcomes.reasoning_non_duplicate_unique_fix"]);                          // src: vvaharness/pipeline/stages/s7/outcomes.py:40
        p.rule(θ["p.s7_outcomes.independent_sites_true_rule"]);                                 // src: vvaharness/pipeline/stages/s7/outcomes.py:43
        p.rule(θ["p.s7_outcomes.independent_sites_false_rule"]);                                // src: vvaharness/pipeline/stages/s7/outcomes.py:46
        return p;
    }

    @executedBy(CODE)
    boolean coerceFlag(Object v) {
        // Any non-bool independent_sites is coerced so one bad value costs this field, not the whole model.
        return Coerce.flag(v);                                                                  // src: vvaharness/pipeline/stages/s7/outcomes.py:52
    }

    @executedBy(CODE)
    DedupDecisions decisions(String raw) {
        try { return DedupDecisions.validateJson(raw); } catch (ValueError e) { }              // src: vvaharness/pipeline/stages/s7/outcomes.py:64
        try { return DedupDecisions.validate(JsonExtract.extract(raw)); } catch (ValueError e) { return null; } // src: vvaharness/pipeline/stages/s7/outcomes.py:68
    }

    @executedBy(CODE)
    List<DedupRow> parseDecisions(String raw, int n, String label) {
        DedupDecisions parsed = decisions(raw);                                                 // src: vvaharness/pipeline/stages/s7/outcomes.py:76
        if (parsed == null) {
            // [] keeps every finding; the counter stops that miss reading as "no duplicates".
            if (!raw.isBlank()) Counters.bump("s7_dedup_parse_miss");                           // src: vvaharness/pipeline/stages/s7/outcomes.py:80
            return List.of();                                                                    // src: vvaharness/pipeline/stages/s7/outcomes.py:86
        }
        List<DedupRow> out = new List();
        for (DedupDecision d : parsed.decisions) {                                              // src: vvaharness/pipeline/stages/s7/outcomes.py:88
            // Code enforces the "always LOWER" rule: rows violating 0 <= duplicate_of < index < n are dropped.
            if (0 <= d.duplicateOf && d.duplicateOf < d.index && d.index < n) {                 // src: vvaharness/pipeline/stages/s7/outcomes.py:89
                out.add(new DedupRow(d.index, d.duplicateOf, d.reasoning.strip(), d.independentSites));
            }
        }
        int absent = n - parsed.decisions.size();
        if (absent > 0) Counters.bump("s7_dedup_index_omitted", absent);                        // src: vvaharness/pipeline/stages/s7/outcomes.py:94
        return out;
    }
}
