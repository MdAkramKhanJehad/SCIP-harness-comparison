// file: vvaharness/remediation_agent/runner.py, vvaharness/remediation_agent/plugin_runner/run.py, vvaharness/remediation_agent/policy/decide.py
// S10 per-finding loop: resume-or-run each finding sequentially, checkpoint the result, then augment the reports.
// apply_plugin wraps each session in the policy pre-gate, a file snapshot, and the harness post-gate/amend.

@executedBy(CODE) @role(types)
enum RemediationResult { FIXED, NOT_FIXED, FAILED }

@executedBy(CODE) @role(step) @stage("S10")
class Runner {

    RemediationResult resultForKind(String kind, Boolean diffCaptured, Theta θ) {
        if (diffCaptured != null && diffCaptured == false) return NOT_FIXED;                        // src: vvaharness/remediation_agent/runner.py:63  (proven no-diff is never fixed)
        return θ["code.remediation_agent.runner.fixed_kinds"].contains(kind) ? FIXED : NOT_FIXED;   // src: vvaharness/remediation_agent/runner.py:65  (edits_applied or pull_request count as fixed; kind may be a RemediationKind enum or its string value)
    }

    String modelBanner(Config cfg) {
        // One-line description of the model and backend doing remediation; best effort only.
        try {
            ModelSpec m = Registry.resolve(cfg.models.remediate);                                   // src: vvaharness/remediation_agent/runner.py:74
            return m.model + " [" + m.via + "]";                                                    // src: vvaharness/remediation_agent/runner.py:75
        } catch (Exception e) {
            return "unknown";                                                                       // src: vvaharness/remediation_agent/runner.py:77  (banner failure never breaks a run)
        }
    }

    String findingIdentity(RemediationTarget target) {
        // The identity recorded IN the checkpoint (the case id), so a hit can be checked against it before a skip proves WHICH finding it covers.
        return target.caseId;                                                                       // src: vvaharness/remediation_agent/runner.py:93
    }

    String stepKeyOf(RemediationTarget target, Config cfg) {
        ModelSpec m = PluginRunnerRun.engineModel(cfg);                                             // src: vvaharness/remediation_agent/runner.py:85
        return Checkpoints.stepKeyFor("remediate", ENGINE_ID, VERSION, target.caseId, m.model, m.via); // src: vvaharness/remediation_agent/runner.py:86
    }

    boolean remediateOne(RemediationTarget target, int idx, int total, Layout layout, Config cfg, String repo, RemediateOptions opts, PolicyContext policyCtx, List<RemediationResult> results, Theta θ) {
        String step = stepKeyOf(target, cfg);                                                       // src: vvaharness/remediation_agent/runner.py:101
        String fid = findingIdentity(target);                                                        // src: vvaharness/remediation_agent/runner.py:102
        if (opts.resume) {                                                                          // src: vvaharness/remediation_agent/runner.py:105
            Map cached = Checkpoints.loadCkpt(layout.ckptDir, layout.runId, step);                  // src: vvaharness/remediation_agent/runner.py:106
            // Skip only when the checkpoint exists AND its finding identity matches.
            if (cached instanceof Map && cached.get("finding_id").equals(fid)) {                    // src: vvaharness/remediation_agent/runner.py:107
                results.add(resultForKind(cached.get("kind"), cached.get("diff_captured"), θ));       // src: vvaharness/remediation_agent/runner.py:108
                return true;                                                                        // src: vvaharness/remediation_agent/runner.py:115
            }
        }
        // Raises UnsafeArtifactDir (uncaught) on a symlinked artefact dir: tampering evidence.
        Path outDir = Artifacts.artifactDir(layout.remDir, target.slug);                            // src: vvaharness/remediation_agent/runner.py:119
        try {
            Remediation rem = PluginRunnerRun.applyPlugin(target, outDir, cfg, repo, opts.mode, opts.verbose, policyCtx, θ); // src: vvaharness/remediation_agent/runner.py:125
            Checkpoints.saveCkpt(layout.ckptDir, layout.runId, step, PluginRunnerRun.checkpointRecord(target, outDir, rem).with("finding_id", fid)); // src: vvaharness/remediation_agent/runner.py:131
            results.add(resultForKind(rem.kind, rem.diff != null && !rem.diff.isEmpty(), θ));         // src: vvaharness/remediation_agent/runner.py:132
            return true;                                                                            // src: vvaharness/remediation_agent/runner.py:138
        } catch (Exception e) {
            // One bad finding never aborts the run.
            results.add(FAILED);                                                                    // src: vvaharness/remediation_agent/runner.py:142
            return false;                                                                           // src: vvaharness/remediation_agent/runner.py:143
        }
    }

    int processTargets(List<RemediationTarget> targets, Layout layout, Config cfg, String repo, RemediateOptions opts, Path report, Theta θ) {
        Map<String, Integer> progress = null;                                                       // src: vvaharness/remediation_agent/runner.py:149  (optional mutable mapping the caller passes; not threaded through by the pass-1 callers)
        int total = targets.size();                                                                 // src: vvaharness/remediation_agent/runner.py:151
        PolicyContext policyCtx = PolicyContextBuild.buildContext(cfg, repo, θ);                    // src: vvaharness/remediation_agent/runner.py:154  (no-op unless enforce_policy)
        List<RemediationResult> results = new List();
        int i = 1;
        for (RemediationTarget t : targets) {                                                       // src: vvaharness/remediation_agent/runner.py:159  (sequential)
            remediateOne(t, i, total, layout, cfg, repo, opts, policyCtx, results, θ);              // src: vvaharness/remediation_agent/runner.py:160
            i = i + 1;
        }
        int fixed = results.count(FIXED);                                                           // src: vvaharness/remediation_agent/runner.py:165
        int notFixed = results.count(NOT_FIXED);                                                    // src: vvaharness/remediation_agent/runner.py:166
        int failed = results.count(FAILED);                                                         // src: vvaharness/remediation_agent/runner.py:167
        if (progress != null) progress.update(total, fixed, total - fixed);                         // src: vvaharness/remediation_agent/runner.py:169  (failures count as not_fixed so attempted equals fixed plus not_fixed)
        String outcome = failed > 0 ? "fail" : (notFixed > 0 ? "warn" : "ok");                      // src: vvaharness/remediation_agent/runner.py:177
        ReportAugment.augmentReports(repo, report);                                                 // src: vvaharness/remediation_agent/runner.py:183  (best-effort)
        return failed == 0 ? 0 : 1;                                                                 // src: vvaharness/remediation_agent/runner.py:184
    }
}

@executedBy(CODE) @role(step) @stage("S10")
class PluginRunnerRun {

    ModelSpec engineModel(Config cfg) {
        return Registry.resolve(cfg.models.remediate);                                              // src: vvaharness/remediation_agent/plugin_runner/run.py:347
    }

    Remediation applyPlugin(RemediationTarget target, Path outDir, Config cfg, String repo, String mode, boolean verbose, PolicyContext policyCtx, Theta θ) {
        EngineRequest req = new EngineRequest(target, repo, mode, cfg, verbose, policyCtx);         // src: vvaharness/remediation_agent/plugin_runner/run.py:197
        GuardedCall g = callWithGuards(req, θ);                                                     // src: vvaharness/remediation_agent/plugin_runner/run.py:199
        Amended a = harnessAmend(g.verdict, g.snapshot, req, g.pre, θ);                                // src: vvaharness/remediation_agent/plugin_runner/run.py:200
        RemediationAgentArtifacts.writeCase(outDir, target, g.verdict, a.remediation, a.revertedPaths);                     // src: vvaharness/remediation_agent/plugin_runner/run.py:204
        return a.remediation;                                                                       // src: vvaharness/remediation_agent/plugin_runner/run.py:207
    }

    GuardedCall callWithGuards(EngineRequest req, Theta θ) {
        boolean enforce = req.policyCtx != null && req.policyCtx.enabled;                           // src: vvaharness/remediation_agent/plugin_runner/run.py:69
        PreResult pre = enforce ? preDecision(req.policyCtx, req.target) : null;                    // src: vvaharness/remediation_agent/plugin_runner/run.py:102
        if (pre != null && !pre.allowed) {                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:105
            // Policy-denied: no model call, no tokens; a plain DENIED verdict with the deny reason.
            return new GuardedCall(Decide.guidanceVerdict(req.policyCtx, req.target, pre), Map.of(), null); // src: vvaharness/remediation_agent/plugin_runner/run.py:106
        }
        List<String> preDirty = Gitcapture.changedFilesWholeTree(req.repo, θ);                          // src: vvaharness/remediation_agent/plugin_runner/run.py:109
        Snapshot snap = Snapshot.snapshotFiles(req.repo, snapshotTargets(req));                    // src: vvaharness/remediation_agent/plugin_runner/run.py:111
        try {
            Object raw = PluginRunnerInvoke.invoke(req.target, req.cfg, req.repo, req.mode, req.verbose, pre, req.policyCtx, θ); // src: vvaharness/remediation_agent/plugin_runner/run.py:113
            return new GuardedCall(coerceVerdict(raw, req.target), snap, pre);                      // src: vvaharness/remediation_agent/plugin_runner/run.py:117
        } catch (Exception e) {
            // Timeout/crash: revert in-flight edits since the pre-call snapshot, record Not Fixed.
            Policy.revertFiles(req.repo, Snapshot.changedSinceSnapshot(req.repo, preDirty));       // src: vvaharness/remediation_agent/plugin_runner/run.py:132
            return new GuardedCall(new RemediationVerdict(req.target.index, "Not Fixed"), snap, pre);                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:138
        }
    }

    List<String> snapshotTargets(EngineRequest req) {
        // Snapshot also covers workflow files and every worktree file matching forbid/deny globs.
        return Policy.workflowSnapshotPaths(req.repo).plus(Policy.worktreeForbiddenMatches(req.repo, req.policyCtx.gate.forbidPatchPaths.plus(req.policyCtx.gate.denyPaths))); // src: vvaharness/remediation_agent/plugin_runner/run.py:309
    }

    Verdict coerceVerdict(Object raw, RemediationTarget target) {
        if (raw instanceof RemediationVerdict) return raw;                                          // src: vvaharness/remediation_agent/plugin_runner/helpers.py:50
        if (raw instanceof Map) return ModelsVerdict.coerce(raw, target.index, θ);                // src: vvaharness/remediation_agent/plugin_runner/helpers.py:53
        Map data = Json.extract(raw);                                                               // src: vvaharness/remediation_agent/plugin_runner/helpers.py:56
        if (data == null) return new RemediationVerdict(target.index, "Needs Review");              // src: vvaharness/remediation_agent/plugin_runner/helpers.py:58
        return ModelsVerdict.coerce(data, target.index, θ);                                       // src: vvaharness/remediation_agent/plugin_runner/helpers.py:63
    }

    PreResult preDecision(PolicyContext ctx, RemediationTarget target) {
        Decision d = RemediationAgentPolicyGate.decide(ctx.gate, target.finding.cwe, target.finding.file); // src: vvaharness/remediation_agent/policy/decide.py:43
        Strategy s = null;
        if (d.mayGeneratePatch) {                                                                   // src: vvaharness/remediation_agent/policy/decide.py:45
            // Playbook is supplementary context, not a second gate.
            s = RemediationAgentPlaybook.resolve(ctx.playbook, target.finding.cwe, Frameworks.languageFor(target.finding.file), ctx.frameworks); // src: vvaharness/remediation_agent/policy/decide.py:48
        }
        return new PreResult(d, target.finding.cwe, s);                                             // src: vvaharness/remediation_agent/policy/decide.py:49
    }

    Amended harnessAmend(Verdict v, Snapshot snap, EngineRequest req, PreResult pre, Theta θ) {
        List<String> reverted = List.of();
        if (pre != null) {                                                                          // src: vvaharness/remediation_agent/plugin_runner/run.py:154
            // Post-gate: revert changed files hitting forbid_patch_paths/deny_paths, downgrade to guidance.
            PostResult post = RemediationAgentPolicyGate.enforcePost(req.policyCtx, req.target, v, pre, req.repo, snap); // src: vvaharness/remediation_agent/plugin_runner/run.py:155
            reverted = post.reverted;                                                               // src: vvaharness/remediation_agent/plugin_runner/run.py:157
        }
        // The harness, not the model, supplies the diff and files touched (whole working tree).
        String diff = DiffDerive.deriveDiff(req.repo, snap, v.changes.map(c -> c.file), θ);             // src: vvaharness/remediation_agent/plugin_runner/run.py:159
        Remediation contract = Remediation.finalize(v, req.mode, diff);                             // src: vvaharness/remediation_agent/plugin_runner/run.py:164
        return new Amended(contract, reverted);                                                     // src: vvaharness/remediation_agent/plugin_runner/run.py:168
    }

    Map checkpointRecord(RemediationTarget target, Path outDir, Remediation rem) {
        return Map.of("kind", rem.kind, "diff_captured", rem.diff != null);                         // src: vvaharness/remediation_agent/plugin_runner/run.py:210
    }
}
