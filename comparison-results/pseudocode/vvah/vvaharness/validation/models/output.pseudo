// file: vvaharness/validation/models/output.py
// Strict (frozen) structured-output schema of the S11 session: per-finding blocks and synthesized gates.
// Validators coerce/redact/truncate CSV fields, clamp raw_score, and redact narrative text on load.

@executedBy(CODE) @role(types) @stage("S11")
record GateEntry(String gateName, String status, String summary, List<EvidenceAnchor> evidence, String details) { }

@executedBy(CODE) @role(types) @stage("S11")
record SynthesizedGatesEntry(String trackingId, List<GateEntry> gates) { }

@executedBy(CODE) @role(types) @stage("S11")
record OutputFinding(String trackingId, String findingTitle, String findingDescription, String affectedFiles,
                     String severity, String fixStatus, double rawScore, String justification, String mergeReadiness,
                     Map gateScores, List<String> conditionsForFullFix, List<String> recommendations, String filesNeedingFixes) { }
// defaults: severity="Medium", fix_status="UNVERIFIABLE", raw_score=0.0 in [0,1], merge_readiness="Not Ready"

@executedBy(CODE) @role(types) @stage("S11")
record ValidationOutput(String targetJiraStatus, List<OutputFinding> findings, List<SynthesizedGatesEntry> synthesizedGates) { }

@executedBy(CODE) @role(types) @stage("S11")
record PersistedValidationReport(List<OutputFinding> findings) { }
// real name: ValidationReport (validation_report.json as the host persisted it, minus gates)

@executedBy(CODE) @role(evaluation) @stage("S11")
class Output {

    List<String> gateEntryStatuses(Theta θ) {
        return θ["code.validation.models.output.gate_entry_statuses"];                              // pass, partial, fail, skip  // src: vvaharness/validation/models/output.py:85
    }

    Object coerceCsv(Object v, String fieldName, Theta θ) {
        if (v instanceof List) v = String.join(",", v.map(x -> str(x)));                             // model emitted a JSON list  // src: vvaharness/validation/models/output.py:124
        if (!(v instanceof String)) return v;                                                        // src: vvaharness/validation/models/output.py:126
        String safe = Redact.redact(v);                                                              // redact before truncating  // src: vvaharness/validation/models/output.py:130
        int cap = θ["code.validation.models.output.csv_max_chars"];
        if (safe.length() <= cap) return safe;                                                       // src: vvaharness/validation/models/output.py:131
        Log.warning("validation output field exceeded cap; truncating");                             // src: vvaharness/validation/models/output.py:133
        return safe.substring(0, cap - "...[truncated]".length()) + "...[truncated]";               // src: vvaharness/validation/models/output.py:138
    }

    Object clampRawScore(Object v) {
        if (v instanceof Boolean || !(v instanceof Number)) return v;                                // src: vvaharness/validation/models/output.py:144
        double score = (double) v;
        double clamped = Math.min(1.0, Math.max(0.0, score));                                        // clamp instead of reject  // src: vvaharness/validation/models/output.py:147
        if (clamped != score) Log.warning("raw_score outside [0,1]; clamped");                       // src: vvaharness/validation/models/output.py:148
        return clamped;
    }

    PersistedValidationReport redactNarrative(PersistedValidationReport r, Theta θ) {
        for (OutputFinding f : r.findings) {                                                         // src: vvaharness/validation/models/output.py:193
            for (String name : θ["code.validation.models.output.redacted_narrative_fields"]) f.set(name, Redact.redact(f.get(name))); // text + list fields  // src: vvaharness/validation/models/output.py:174
        }
        return r;
    }

    PersistedValidationReport fromFile(Path path) {
        return Pydantic.modelValidate(PersistedValidationReport, readJson(path));                                       // src: vvaharness/validation/models/output.py:203
    }

    Object readJson(Path path) {
        try {
            return Json.loads(path.readText());                                                      // src: vvaharness/validation/models/output.py:209
        } catch (JSONDecodeError e) {
            throw new ValueError("malformed JSON in validation report " + path);                     // src: vvaharness/validation/models/output.py:212
        }
    }

    Decision decisionFor(String fixStatus, Theta θ) {
        String folded = fixStatus.strip().casefold();                                                // src: vvaharness/validation/models/output.py:217
        for (Entry e : θ["code.validation.models.output.fix_status_labels"].entries()) {             // Fixed/Partially Fixed/Not Fixed/UNVERIFIABLE  // src: vvaharness/validation/models/output.py:70
            if (e.key.casefold().equals(folded)) return e.value;                                     // src: vvaharness/validation/models/output.py:219
        }
        return Decision.INCONCLUSIVE;                                                                // unknown label closes  // src: vvaharness/validation/models/output.py:220
    }

    GateAssessment toGate(GateEntry e) {
        return new GateAssessment(e.gateName, GateStatus.valueOf(e.status), e.summary, e.details, e.evidence); // src: vvaharness/validation/models/output.py:226
    }

    Verdict toVerdict(OutputFinding f, SynthesizedGatesEntry gates, Provenance provenance, Theta θ) {
        Decision d = decisionFor(f.fixStatus, θ);                                                    // src: vvaharness/validation/models/output.py:242
        List<GateEntry> gs = gates != null ? gates.gates : List.of();                                // src: vvaharness/validation/models/output.py:243
        return new Verdict(d, f.justification, d == Decision.INCONCLUSIVE ? null : f.rawScore,       // src: vvaharness/validation/models/output.py:244
                           gs.map(e -> toGate(e)), f.conditionsForFullFix, f.recommendations, provenance); // src: vvaharness/validation/models/output.py:248
    }
}
