// file: vvaharness/validation/tools/diff_facts.py
// Deterministic, read-only diff fact tools: parse the staged diff.patch into per-file added line ranges,
// answer DiffTouched / ChangedLines, and build the DiffImpactMap (files + trust-boundary flag).

// Real name FileChange (dataclass): one file's added line ranges, as parsed out of a unified diff.
@executedBy(CODE) @role(types) @stage("S11")
record ValidationDiffFileChange(String path, List<Pair<Integer, Integer>> addedRanges) { }

@executedBy(CODE) @role(types) @stage("S11")
record DiffImpactMap(List<String> filesChanged, boolean trustBoundaryTouched) { }

@executedBy(CODE) @role(tool) @stage("S11")
class DiffParser {

    List<ValidationDiffFileChange> changes = new List();
    String currentPath = null;
    String oldPath = null;
    List<Pair<Integer, Integer>> addedRanges = new List();
    int newLineNumber = 0;
    Integer addedRunStart = null;
    int addedRunLength = 0;

    void closeAddedRun() {
        if (addedRunStart != null && addedRunLength > 0) addedRanges.add(Pair.of(addedRunStart, addedRunLength)); // (start, length)  // src: vvaharness/validation/tools/diff_facts.py:70
        addedRunStart = null;
        addedRunLength = 0;
    }

    void closeFile() {
        closeAddedRun();                                                                             // src: vvaharness/validation/tools/diff_facts.py:74
        if (currentPath != null) changes.add(new ValidationDiffFileChange(currentPath, addedRanges));              // src: vvaharness/validation/tools/diff_facts.py:76
        currentPath = null;
        oldPath = null;
        addedRanges = new List();
    }

    void consumeHunkLine(String line) {
        String prefix = line.prefix(1);                                                              // src: vvaharness/validation/tools/diff_facts.py:80
        if (prefix.equals("+")) {                                                                    // src: vvaharness/validation/tools/diff_facts.py:81
            if (addedRunStart == null) addedRunStart = newLineNumber;
            addedRunLength += 1;
            newLineNumber += 1;
        } else if (prefix.equals("-")) {
            closeAddedRun();                                                                         // src: vvaharness/validation/tools/diff_facts.py:87
        } else if (prefix.equals("\\")) {
            return;                                                                                  // no-newline note  // src: vvaharness/validation/tools/diff_facts.py:89
        } else {
            closeAddedRun();                                                                         // context line  // src: vvaharness/validation/tools/diff_facts.py:91
            newLineNumber += 1;
        }
    }

    void feed(String line) {
        if (line.startsWith("diff --git ")) {                                                        // src: vvaharness/validation/tools/diff_facts.py:95
            closeFile();
            List<String> tokens = line.split(" ");
            if (tokens.size() >= ConstantsDiff.GIT_HEADER_MIN_TOKENS) currentPath = withoutGitPrefix(tokens.last()); // rename/binary fallback  // src: vvaharness/validation/tools/diff_facts.py:99
        } else if (line.startsWith("--- ")) {
            closeAddedRun();
            oldPath = withoutGitPrefix(markerPath(line));                                            // src: vvaharness/validation/tools/diff_facts.py:103
        } else if (line.startsWith("+++ ")) {
            closeAddedRun();
            String newPath = withoutGitPrefix(markerPath(line));                                     // src: vvaharness/validation/tools/diff_facts.py:106
            currentPath = newPath.equals("/dev/null") ? oldPath : newPath;                           // deletion keeps old path  // src: vvaharness/validation/tools/diff_facts.py:108
            newLineNumber = 0;
        } else if (ConstantsDiff.HUNK_HEADER_RE.matches(line)) {                                     // src: vvaharness/validation/tools/diff_facts.py:110
            closeAddedRun();
            newLineNumber = int(ConstantsDiff.HUNK_HEADER_RE.match(line).group(1));                  // src: vvaharness/validation/tools/diff_facts.py:112
        } else if (newLineNumber != 0) {
            consumeHunkLine(line);                                                                   // src: vvaharness/validation/tools/diff_facts.py:114
        }
    }

    List<ValidationDiffFileChange> finish() {
        closeFile();                                                                                 // src: vvaharness/validation/tools/diff_facts.py:117
        return changes;
    }

    String withoutGitPrefix(String path) {
        return List.of("a/", "b/").contains(path.prefix(2)) ? path.substring(2) : path;              // src: vvaharness/validation/tools/diff_facts.py:41
    }

    String markerPath(String markerLine) {
        return markerLine.substring(4).split("\t")[0];                                               // src: vvaharness/validation/tools/diff_facts.py:45
    }
}

@executedBy(CODE) @role(tool) @stage("S11")
class DiffFacts {

    List<ValidationDiffFileChange> parseDiffPatch(Path workspace) {
        Path diffFile = workspace.resolve("diff.patch");                                             // src: vvaharness/validation/tools/diff_facts.py:123
        if (!diffFile.exists()) return List.of();                                                    // src: vvaharness/validation/tools/diff_facts.py:124
        DiffParser parser = new DiffParser();
        for (String line : diffFile.readText("replace").splitlines()) parser.feed(line);            // non-UTF-8 replaced  // src: vvaharness/validation/tools/diff_facts.py:127
        return parser.finish();                                                                      // src: vvaharness/validation/tools/diff_facts.py:129
    }

    Map diffTouched(Path workspace, String filePath) {
        for (ValidationDiffFileChange c : parseDiffPatch(workspace)) {                                             // src: vvaharness/validation/tools/diff_facts.py:134
            if (c.path.equals(filePath)) return Map.of("touched", true, "added_ranges", c.addedRanges); // exact path match  // src: vvaharness/validation/tools/diff_facts.py:135
        }
        return Map.of("touched", false, "added_ranges", List.of());                                  // src: vvaharness/validation/tools/diff_facts.py:137
    }

    List<Pair<Integer, Integer>> changedLines(Path workspace, String filePath) {
        return diffTouched(workspace, filePath).get("added_ranges");                                 // src: vvaharness/validation/tools/diff_facts.py:142
    }

    DiffImpactMap buildDiffImpactMap(Path workspace, Theta θ) {
        List<String> files = parseDiffPatch(workspace).map(c -> c.path);                             // src: vvaharness/validation/tools/diff_facts.py:155
        return new DiffImpactMap(Set.copyOf(files).sorted(),                                         // src: vvaharness/validation/tools/diff_facts.py:157
                                 files.any(p -> ConstantsDiff.trustBoundaryRe(θ).search(p)));        // src: vvaharness/validation/tools/diff_facts.py:158
    }
}
