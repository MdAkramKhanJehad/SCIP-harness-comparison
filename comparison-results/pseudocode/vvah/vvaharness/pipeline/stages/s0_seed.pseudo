// file: vvaharness/pipeline/stages/s0_seed.py, vvaharness/codegraph/build.py
// S0: deterministic source/sink text matching that seeds entry points and sinks (no model call).
// Also holds the degenerate-graph gate (codegraph/build.graph_is_degenerate) that step0.min_graph_nodes_for_gate drives.

@executedBy(CODE) @role(stage) @stage("S0")
class S0Seed {

    // ruleId/message tokens -> EntryPoint.kind; unmatched -> "other"
    Map<String, String> KIND_HINTS = Map.of("http", "network", "route", "network", "queue", "ipc", "argv", "cli", "env", "file", "deseriali", "deserialization"); // src: vvaharness/pipeline/stages/s0_seed.py:28

    SeedPackage run(String repoRoot, Config cfg, Path ckptDir, Theta θ) {
        // How entry points and sinks are found: only pattern rules ship; "llm" is a legacy mode probed only for credentials
        if (θ["step0.callgraph_detection"] != "rules") {                                   // src: vvaharness/orchestrator/config_paths.py:117
            // unclear: the legacy LLM annotator was deleted; run() always does the text-pattern scan below
        }
        Pair<List<String>, Map> walk = S1Preprocess.walkRepo(repoRoot, cfg, θ);            // src: vvaharness/pipeline/stages/s0_seed.py:62
        List<String> allFiles = walk.first;
        Map excluded = walk.second;
        Set<String> inScope = Set.copyOf(allFiles);                                         // src: vvaharness/pipeline/stages/s0_seed.py:63
        List<String> langs = filterStep0Languages(LangDetect.detectLanguages(allFiles), θ); // src: vvaharness/pipeline/stages/s0_seed.py:64
        // Match on source TEXT: graph-node sink matching misses library calls
        DetectResult result = DetectPatterns.scan(repoRoot, sorted(inScope), θ);           // src: vvaharness/pipeline/stages/s0_seed.py:69
        SeedPackage seed = new SeedPackage(result.entryPoints, result.unsafeSinks, langs, allFiles, excluded); // src: vvaharness/pipeline/stages/s0_seed.py:70
        return seed;                                                                        // src: vvaharness/pipeline/stages/s0_seed.py:79
    }

    List<String> filterStep0Languages(List<String> langs, Theta θ) {
        List<String> raw = θ["step0.languages"];                                            // src: vvaharness/pipeline/stages/s0_seed.py:43
        if (raw == null || raw.isEmpty()) return langs;                                     // src: vvaharness/pipeline/stages/s0_seed.py:44
        Set<String> allow = new Set();
        for (String x : raw) {                                                              // src: vvaharness/pipeline/stages/s0_seed.py:47
            if (x.strip().isEmpty()) continue;                                              // src: vvaharness/pipeline/stages/s0_seed.py:48
            String canon = LangDetect.canonicalLang(x);                                     // src: vvaharness/pipeline/stages/s0_seed.py:50
            allow.add(canon);
            // no-match typo is surfaced, never silent scope narrowing
            if (!VVAH_LANGUAGES.contains(canon)) Console.warn("step0.languages entry not recognized"); // src: vvaharness/pipeline/stages/s0_seed.py:53
        }
        return langs.filter(l -> allow.contains(l));                                       // src: vvaharness/pipeline/stages/s0_seed.py:56
    }
}

@executedBy(CODE) @role(rule_set) @stage("S0")
@src("vvaharness/codegraph/build.py:71")
class S0GraphGate {

    /** True when the scan's code graph cannot back a require_graph evidence demand (S2/S4/S6 gates stand down). */
    boolean graphIsDegenerate(Context ctx, Theta θ) {
        GraphHandle handle = ctx.graphHandle;                                               // src: vvaharness/codegraph/build.py:74
        if (handle == null) return true;                                                    // src: vvaharness/codegraph/build.py:75
        if (handle.edgeCount == 0) return true;                                             // src: vvaharness/codegraph/build.py:77
        if (handle.nodeCount == null) return false;                                         // src: vvaharness/codegraph/build.py:80
        int minNodes = θ["step0.min_graph_nodes_for_gate"];                                 // src: vvaharness/codegraph/build.py:82
        return handle.nodeCount < minNodes;                                                 // src: vvaharness/codegraph/build.py:83
    }
}
