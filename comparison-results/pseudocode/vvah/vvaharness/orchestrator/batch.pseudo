// file: vvaharness/orchestrator/batch.py
// Batch mode (--repo-file): parse the repo list (csv or 3-field text), drop skip-pattern repos, clone each (or each app group)
// and run one OrchestratorScan per repo or per application, resetting process-global state between them, then write batch_summary.md.

@executedBy(CODE) @role(pipeline)
class OrchestratorBatch {

    /** Last path segment of a ref with a trailing slash and a .git suffix stripped; "repo" when empty. */
    @src("vvaharness/orchestrator/batch.py:54")
    String moduleNameFrom(String ref) {
        String tail = ref.rstripSlash().split("/").last();                                                  // src: vvaharness/orchestrator/batch.py:55
        if (tail.lower().endsWith(".git")) tail = tail.substring(0, tail.length() - 4);                     // src: vvaharness/orchestrator/batch.py:56
        return tail.isEmpty() ? "repo" : tail;                                                              // src: vvaharness/orchestrator/batch.py:58
    }

    /** http, https, git@ or ssh refs, or anything ending in .git, are remote; everything else is a local path. */
    @src("vvaharness/orchestrator/batch.py:61")
    boolean isRemote(String ref) {
        return ref.startsWithAny("http://", "https://", "git@", "ssh://") || ref.endsWith(".git");          // src: vvaharness/orchestrator/batch.py:62
    }

    /** scheme://user:token@host becomes scheme://***@host so an inline credential never reaches stderr, an error string, or the summary. */
    @src("vvaharness/orchestrator/batch.py:69")
    String scrubUrlSecrets(String s) {
        if (s == null || s.isEmpty()) return s;                                                             // src: vvaharness/orchestrator/batch.py:70
        return Regex.sub("(\\w[\\w+.\\-]*://)[^/@\\s]+@", "$1***@", s);                     // src: vvaharness/orchestrator/batch.py:72
    }

    /** RepoName is the full repo slug: base/repoName.git with the base trailing slash trimmed. */
    @src("vvaharness/orchestrator/batch.py:75")
    String cloneUrlFor(String repoName, String base) {
        return base.rstripSlash() + "/" + repoName + ".git";                                                // src: vvaharness/orchestrator/batch.py:77
    }

    /** Operator-private state dir root; staged repos are bound to their ref via a marker kept here (a writer of only the shared workspace cannot forge reuse). */
    @src("vvaharness/orchestrator/batch.py:81")
    Path stateRoot(Theta θ) {
        return Store.stateRoot(θ);                                                                              // src: vvaharness/orchestrator/batch.py:82
    }

    /** Stable, token-free id for a repo ref: sha256 of the original csv URL or local path, first 32 hex chars. */
    @src("vvaharness/orchestrator/batch.py:85")
    String refId(String ref) {
        return Hash.sha256Hex(ref.utf8()).substring(0, 32);                                                 // src: vvaharness/orchestrator/batch.py:87
    }

    @src("vvaharness/orchestrator/batch.py:90")
    Path stageMarkerPath(Path dest, Theta θ) {
        String key = Hash.sha256Hex(dest.resolve().toString().utf8()).substring(0, 32);                     // src: vvaharness/orchestrator/batch.py:91
        return stateRoot(θ).resolve("stage-markers").resolve(key + ".json");                                 // src: vvaharness/orchestrator/batch.py:92
    }

    /** Record that dest was staged from ref. Best effort: a marker-write failure just means the next run re-stages. */
    @src("vvaharness/orchestrator/batch.py:95")
    void writeStageMarker(Path dest, String ref, String kind, Theta θ) {
        Path mp = stageMarkerPath(dest, θ);                                                                    // src: vvaharness/orchestrator/batch.py:97
        try {
            Store.ensureStateDir(List.of("stage-markers"), θ);                                                             // via the store so the dir is not umask-default (a readable marker is forgeable) // src: vvaharness/orchestrator/batch.py:100
            Files.writeText(mp, Json.dump(Map.of("v", 1, "kind", kind, "ref_id", refId(ref))));             // src: vvaharness/orchestrator/batch.py:101
        } catch (OSError e) {
            log.warning(Events.BATCH_MARKER_WRITE_FAILED, dest, e.message);                                 // src: vvaharness/orchestrator/batch.py:104
        }
    }

    /** True iff dest carries a state-dir marker proving it was staged from ref by a prior run; missing, mismatched or corrupt means re-stage. */
    @src("vvaharness/orchestrator/batch.py:107")
    boolean stageDirBound(Path dest, String ref, Theta θ) {
        Object data;
        try {
            data = Json.parse(Files.readText(stageMarkerPath(dest, θ)));                                       // src: vvaharness/orchestrator/batch.py:110
        } catch (OSError | ValueError e) {
            return false;                                                                                   // src: vvaharness/orchestrator/batch.py:112
        }
        return data instanceof Map && data.get("ref_id") == refId(ref);                                     // src: vvaharness/orchestrator/batch.py:113
    }

    /** Map each repo in an app group to a UNIQUE staging slug, so two repo names with the same tail do not collide and silently reuse one dir. */
    @src("vvaharness/orchestrator/batch.py:116")
    List<String> assignSlugs(List<Entry> repos) {
        List<String> slugs = new List(); Set<String> used = new Set();                                      // src: vvaharness/orchestrator/batch.py:118
        for (Entry r : repos) {                                                                             // src: vvaharness/orchestrator/batch.py:120
            String base = moduleNameFrom(r.repoName);                                                       // src: vvaharness/orchestrator/batch.py:121
            String slug = base;
            String salt = r.repoName;                                                                       // src: vvaharness/orchestrator/batch.py:123
            while (used.contains(slug)) {                                                                   // src: vvaharness/orchestrator/batch.py:124
                slug = base + "-" + Hash.sha1Hex(salt.utf8()).substring(0, 8);                              // src: vvaharness/orchestrator/batch.py:125
                salt = slug + r.repoName;                                                                   // src: vvaharness/orchestrator/batch.py:126
            }
            used.add(slug);                                                                                 // src: vvaharness/orchestrator/batch.py:127
            slugs.add(slug);                                                                                // src: vvaharness/orchestrator/batch.py:128
        }
        return slugs;                                                                                       // src: vvaharness/orchestrator/batch.py:129
    }

    /** Reject a manifest larger than the byte cap before it is decoded into memory; ValueError is caught by runBatch and becomes exit 2. */
    @src("vvaharness/orchestrator/batch.py:137")
    void checkManifestSize(Path listFile, Theta θ) {
        long size;
        try {
            size = listFile.stat().size;                                                                    // src: vvaharness/orchestrator/batch.py:140
        } catch (OSError e) {
            throw new ValueError(listFile + ": cannot stat manifest");                                      // src: vvaharness/orchestrator/batch.py:142
        }
        if (size > θ["code.orchestrator.batch.manifest_max_bytes"]) throw new ValueError(listFile + ": manifest over the MiB cap; split the batch into smaller manifests"); // 64 MiB // src: vvaharness/orchestrator/batch.py:143
    }

    /** Parse a .csv batch sheet with an AppID / RepoName [/ Path] header (case-insensitive aliases accepted). Streams the reader; validation errors are collected and raised together. */
    @src("vvaharness/orchestrator/batch.py:150")
    List<Entry> parseRepoCsv(Path listFile, String gitBaseUrl, Theta θ) {
        checkManifestSize(listFile, θ);                                                                     // src: vvaharness/orchestrator/batch.py:152
        Iterator<Row> rows = Csv.reader(listFile, "utf-8-sig");                                             // streamed, never list()-ed // src: vvaharness/orchestrator/batch.py:154
        if (!rows.hasNext()) throw new ValueError(listFile + ": empty file");                               // src: vvaharness/orchestrator/batch.py:159
        Row header = rows.next();                                                                           // src: vvaharness/orchestrator/batch.py:157
        Map<String, Integer> hdr = header.nonEmpty().indexByLowerStripped();                                // src: vvaharness/orchestrator/batch.py:161
        Map<String, List<String>> aliases = θ["code.orchestrator.batch.csv_header_aliases"];               // app, repo and path alias lists (case-insensitive) // src: vvaharness/orchestrator/batch.py:167
        Integer iApp = col(hdr, aliases.get("app"));                                                        // appid, application_id, app_id, applicationid // src: vvaharness/orchestrator/batch.py:167
        Integer iRepo = col(hdr, aliases.get("repo"));                                                      // reponame, repository_name, repo_name, repo // src: vvaharness/orchestrator/batch.py:168
        Integer iPath = col(hdr, aliases.get("path"));                                                      // path, url, repo_url, ref // src: vvaharness/orchestrator/batch.py:169
        if (iApp == null || iRepo == null) throw new ValueError(listFile + ": header must contain AppID and RepoName columns"); // src: vvaharness/orchestrator/batch.py:170
        if (iPath == null && (gitBaseUrl == null || gitBaseUrl.isEmpty())) throw new ValueError(listFile + ": no Path column and batch.git_base_url is not set"); // src: vvaharness/orchestrator/batch.py:174
        List<Entry> entries = new List(); List<String> errors = new List(); Set<String> seen = new Set();   // src: vvaharness/orchestrator/batch.py:179
        int lineno = 2;
        for (Row row : rows) {                                                                              // data rows number from 2 // src: vvaharness/orchestrator/batch.py:182
            if (lineno - 1 > θ["code.orchestrator.batch.manifest_max_rows"]) throw new ValueError(listFile + ": over the data-row cap; split the batch"); // 200000 // src: vvaharness/orchestrator/batch.py:183
            String appId = at(row, iApp); String repoName = at(row, iRepo); String ref = at(row, iPath);    // src: vvaharness/orchestrator/batch.py:191
            lineno += 1;
            if (appId.isEmpty() && repoName.isEmpty()) continue;                                            // wholly blank row // src: vvaharness/orchestrator/batch.py:192
            if (appId.isEmpty() || repoName.isEmpty()) { errors.add("row " + lineno + ": AppID and RepoName are both required"); continue; } // src: vvaharness/orchestrator/batch.py:194
            if (ref.isEmpty()) {                                                                            // src: vvaharness/orchestrator/batch.py:197
                // a blank Path resolves only when git_base_url is set; otherwise an up-front validation error
                if (gitBaseUrl == null || gitBaseUrl.isEmpty()) { errors.add("row " + lineno + ": Path is blank and batch.git_base_url is not set"); continue; } // src: vvaharness/orchestrator/batch.py:199
                ref = cloneUrlFor(repoName, gitBaseUrl);                                                    // src: vvaharness/orchestrator/batch.py:204
            }
            // a leading dash would be consumed by git clone as an option, not a URL operand
            if (ref.lstrip().startsWith("-")) { errors.add("row " + lineno + ": path may not start with a dash"); continue; } // src: vvaharness/orchestrator/batch.py:205
            if (!isRemote(ref) && !Path.of(ref).isDir()) { errors.add("row " + lineno + ": path is neither a git URL nor an existing local directory"); continue; } // src: vvaharness/orchestrator/batch.py:209
            if (seen.contains(ref)) { errors.add("row " + lineno + ": duplicate path"); continue; }         // src: vvaharness/orchestrator/batch.py:213
            seen.add(ref);                                                                                  // src: vvaharness/orchestrator/batch.py:216
            entries.add(new Entry(appId, repoName, ref));                                                   // src: vvaharness/orchestrator/batch.py:217
        }
        if (!errors.isEmpty()) throw new ValueError(listFile + ": " + errors.size() + " validation error(s)"); // all collected errors in one message // src: vvaharness/orchestrator/batch.py:221
        if (entries.isEmpty()) throw new ValueError(listFile + ": no repo entries found");                  // src: vvaharness/orchestrator/batch.py:224
        return entries;                                                                                     // src: vvaharness/orchestrator/batch.py:226
    }

    /** First header index among the alias names, else null. */
    @src("vvaharness/orchestrator/batch.py:162")
    Integer col(Map<String, Integer> hdr, List<String> names) {
        for (String n : names) {                                                                            // src: vvaharness/orchestrator/batch.py:163
            if (hdr.containsKey(n)) return hdr.get(n);                                                      // src: vvaharness/orchestrator/batch.py:164
        }
        return null;                                                                                        // src: vvaharness/orchestrator/batch.py:166
    }

    /** Stripped cell i of row, or empty when the column is absent or the row is short. */
    @src("vvaharness/orchestrator/batch.py:187")
    String at(Row row, Integer i) {
        if (i == null || i >= row.size()) return "";                                                        // src: vvaharness/orchestrator/batch.py:188
        return row.get(i).toString().strip();                                                               // src: vvaharness/orchestrator/batch.py:190
    }

    /** Parse the text manifest: each non-blank, non-comment line is applicationId,repositoryName,path, validated up-front so a bad line fails before any scan. */
    @src("vvaharness/orchestrator/batch.py:229")
    List<Entry> parseRepoFile(Path listFile, Theta θ) {
        checkManifestSize(listFile, θ);                                                                     // src: vvaharness/orchestrator/batch.py:231
        List<Entry> entries = new List(); List<String> errors = new List(); Set<String> seen = new Set();   // src: vvaharness/orchestrator/batch.py:232
        int lineno = 1;
        for (String raw : Files.lines(listFile)) {                                                          // streamed, never read_text().splitlines() // src: vvaharness/orchestrator/batch.py:238
            if (lineno > θ["code.orchestrator.batch.manifest_max_rows"]) throw new ValueError(listFile + ": over the line cap; split the batch"); // src: vvaharness/orchestrator/batch.py:239
            String line = raw.strip();                                                                      // src: vvaharness/orchestrator/batch.py:243
            int thisLine = lineno; lineno += 1;
            if (line.isEmpty() || line.startsWith("#")) continue;                                           // src: vvaharness/orchestrator/batch.py:244
            List<String> parts = line.split(",").map(p -> p.strip());                                       // exactly 3 fields, so a path with a comma is rejected // src: vvaharness/orchestrator/batch.py:247
            if (parts.size() != 3) { errors.add("line " + thisLine + ": expected 3 comma-separated fields"); continue; } // src: vvaharness/orchestrator/batch.py:248
            String appId = parts.get(0); String repoName = parts.get(1); String ref = parts.get(2);        // src: vvaharness/orchestrator/batch.py:253
            if (appId.isEmpty()) errors.add("line " + thisLine + ": application_id is empty");              // src: vvaharness/orchestrator/batch.py:254
            if (repoName.isEmpty()) errors.add("line " + thisLine + ": repository_name is empty");          // src: vvaharness/orchestrator/batch.py:256
            if (ref.isEmpty()) errors.add("line " + thisLine + ": path is empty");                          // src: vvaharness/orchestrator/batch.py:258
            if (appId.isEmpty() || repoName.isEmpty() || ref.isEmpty()) continue;                           // src: vvaharness/orchestrator/batch.py:260
            if (ref.lstrip().startsWith("-")) { errors.add("line " + thisLine + ": path may not start with a dash"); continue; } // src: vvaharness/orchestrator/batch.py:263
            if (!isRemote(ref) && !Path.of(ref).isDir()) { errors.add("line " + thisLine + ": path is neither a git URL nor an existing local directory"); continue; } // src: vvaharness/orchestrator/batch.py:267
            if (seen.contains(ref)) { errors.add("line " + thisLine + ": duplicate path"); continue; }      // src: vvaharness/orchestrator/batch.py:272
            seen.add(ref);                                                                                  // src: vvaharness/orchestrator/batch.py:275
            entries.add(new Entry(appId, repoName, ref));                                                   // src: vvaharness/orchestrator/batch.py:277
        }
        if (!errors.isEmpty()) throw new ValueError(listFile + ": " + errors.size() + " validation error(s)"); // src: vvaharness/orchestrator/batch.py:281
        if (entries.isEmpty()) throw new ValueError(listFile + ": no repo entries found");                  // src: vvaharness/orchestrator/batch.py:285
        return entries;                                                                                     // src: vvaharness/orchestrator/batch.py:287
    }

    /** Inject the token as x-access-token userinfo, only for http(s) URLs that carry no userinfo already. */
    @src("vvaharness/orchestrator/batch.py:290")
    String withToken(String url, String token) {
        if (token == null || token.isEmpty() || !url.startsWithAny("http://", "https://") || url.split("//", 2).get(1).contains("@")) return url; // src: vvaharness/orchestrator/batch.py:291
        Pair<String, String> sr = url.split("://", 2);                                                      // src: vvaharness/orchestrator/batch.py:293
        return sr.first + "://x-access-token:" + token + "@" + sr.second;                                   // src: vvaharness/orchestrator/batch.py:294
    }

    /** Return a local directory for ref, cloning into the workspace if remote. */
    @src("vvaharness/orchestrator/batch.py:297")
    Path acquireRepo(String ref, Path workspace, String gitToken, String destName, Theta θ) {
        if (!isRemote(ref)) {                                                                               // src: vvaharness/orchestrator/batch.py:300
            Path p = Path.of(ref);
            if (!p.isDir()) throw new RuntimeError("local path does not exist");                            // src: vvaharness/orchestrator/batch.py:302
            return p;                                                                                       // src: vvaharness/orchestrator/batch.py:304
        }
        workspace.mkdirs();                                                                                 // src: vvaharness/orchestrator/batch.py:306
        // per-char allowlist: alphanumerics plus dot, underscore, dash; anything else becomes an underscore
        String safe = (destName != null ? destName : moduleNameFrom(ref)).mapChars(c -> c.isAlnum() || "._-".contains(c) ? c : "_"); // src: vvaharness/orchestrator/batch.py:307
        // "." and ".." survive the allowlist and would escape the workspace, after which purgeClone deletes the PARENT
        if (safe == "." || safe == ".." || safe.strip(".").isEmpty()) throw new RuntimeError("refusing unsafe clone dest name"); // src: vvaharness/orchestrator/batch.py:310
        Path dest = workspace.resolve(safe);                                                                // src: vvaharness/orchestrator/batch.py:314
        if (dest.exists()) {                                                                                // src: vvaharness/orchestrator/batch.py:315
            boolean hasContent = dest.children().any(p -> p.name != ".git");                                // src: vvaharness/orchestrator/batch.py:316
            // reuse ONLY a dir that is both non-empty AND bound (by a state-dir marker) to THIS ref
            if (hasContent && stageDirBound(dest, ref, θ)) { Console.write("reusing verified checkout"); return dest; } // src: vvaharness/orchestrator/batch.py:318
            Console.write(hasContent ? "unverified dir: removing and re-cloning" : "empty dir: removing and re-cloning"); // src: vvaharness/orchestrator/batch.py:321
            Cleanup.rmtreeRw(dest);                                                                         // src: vvaharness/orchestrator/batch.py:325
            if (dest.exists()) { Console.write("could not remove; reusing as-is"); return dest; }           // src: vvaharness/orchestrator/batch.py:326
        }
        String cloneUrl = withToken(ref, gitToken);                                                         // src: vvaharness/orchestrator/batch.py:329
        Console.write("git clone " + scrubUrlSecrets(ref));                                                 // src: vvaharness/orchestrator/batch.py:330
        Map env = os.environ.copy().with("GIT_TERMINAL_PROMPT", "0");                                // suppresses interactive auth only, not stalls // src: vvaharness/orchestrator/batch.py:331
        Result r;
        try {
            // shallow clone, bounded so a network stall cannot hang the whole batch; the dash-dash separator keeps the URL an operand
            r = Process.run(List.of("git", "-c", "core.longpaths=true", "clone", "--depth", θ["code.orchestrator.batch.clone_depth"], "--", cloneUrl, dest.toString()), env, θ["code.orchestrator.batch.clone_timeout_s"]); // src: vvaharness/orchestrator/batch.py:334
        } catch (TimeoutExpired e) {
            throw new RuntimeError("git clone timed out: network stall or unresponsive remote");            // src: vvaharness/orchestrator/batch.py:339
        }
        if (r.returncode != 0) {                                                                            // src: vvaharness/orchestrator/batch.py:342
            String err = !r.stderr.strip().isEmpty() ? r.stderr.strip() : r.stdout.strip();                 // src: vvaharness/orchestrator/batch.py:343
            if (gitToken != null && !gitToken.isEmpty()) err = err.replace(gitToken, "***");                // src: vvaharness/orchestrator/batch.py:344
            err = scrubUrlSecrets(err);                                                                     // mask inline userinfo the remote echoed back // src: vvaharness/orchestrator/batch.py:347
            throw new RuntimeError("git clone failed: " + err);                                             // src: vvaharness/orchestrator/batch.py:348
        }
        writeStageMarker(dest, ref, "remote", θ);                                                              // src: vvaharness/orchestrator/batch.py:349
        return dest;                                                                                        // src: vvaharness/orchestrator/batch.py:350
    }

    /** Fold one repo's scan outcome into the summary row's status fields. A stage that exited non-zero is DEGRADED; a finished run that validated nothing it remediated is NOT_REMEDIATED. */
    @src("vvaharness/orchestrator/batch.py:353")
    Map<String, Object> outcomeStatus(ScanOutcome outcome) {
        String status; String error;
        if (outcome.exitCode == 0) { status = "OK"; error = ""; }                                           // src: vvaharness/orchestrator/batch.py:355
        else if (outcome.exitCode == CaseRollup.EXIT_NOT_REMEDIATED) {                                      // an outcome claim, not a health claim // src: vvaharness/orchestrator/batch.py:357
            status = "NOT_REMEDIATED";                                                                      // src: vvaharness/orchestrator/batch.py:359
            error = "the scan completed but nothing it remediated validated as fixed";                      // src: vvaharness/orchestrator/batch.py:360
        } else {
            status = "DEGRADED";                                                                            // src: vvaharness/orchestrator/batch.py:362
            error = "a scan stage exited non-zero; see the per-repo log";                                   // src: vvaharness/orchestrator/batch.py:363
        }
        return Map.of("status", status, "findings", outcome.findingCount, "report", outcome.reportPath != null ? outcome.reportPath.toString() : "", "error", error); // src: vvaharness/orchestrator/batch.py:364
    }

    /** Partition the non-OK rows into (unremediated, failures). Deny-list on purpose: an unknown status lands in failures. */
    @src("vvaharness/orchestrator/batch.py:372")
    Pair<List<Result>, List<Result>> splitNonOk(List<Result> results) {
        List<Result> unremediated = results.filter(r -> r.status == "NOT_REMEDIATED");                      // src: vvaharness/orchestrator/batch.py:375
        List<Result> failures = results.filter(r -> r.status != "OK" && r.status != "NOT_REMEDIATED");      // src: vvaharness/orchestrator/batch.py:376
        return Pair.of(unremediated, failures);                                                             // src: vvaharness/orchestrator/batch.py:377
    }

    @src("vvaharness/orchestrator/batch.py:380")
    int runBatch(Path listFile, Args args, Config cfg, Theta θ) {
        String gitToken = θ["batch.git_token"];                                                             // src: vvaharness/orchestrator/batch.py:382
        String gitBase = θ["batch.git_base_url"];                                                           // src: vvaharness/orchestrator/batch.py:383
        List<Entry> entries;
        try {
            // a .csv without a Path column derives the clone URL from batch.git_base_url
            entries = listFile.suffix().lower() == ".csv" ? parseRepoCsv(listFile, gitBase, θ) : parseRepoFile(listFile, θ); // src: vvaharness/orchestrator/batch.py:385
        } catch (ValueError e) {
            log.error(Events.BATCH_ROW_INVALID, e.message);                                                 // src: vvaharness/orchestrator/batch.py:390
            return 2;                                                                                       // src: vvaharness/orchestrator/batch.py:391
        }
        // case-insensitive fnmatch globs against RepoName, before cloning
        List<String> skipPats = (θ["batch.skip_repo_patterns"] == null ? List.of() : θ["batch.skip_repo_patterns"]).map(p -> p.lower()); // src: vvaharness/orchestrator/batch.py:394
        if (!skipPats.isEmpty()) {                                                                          // src: vvaharness/orchestrator/batch.py:396
            List<Entry> kept = new List();
            for (Entry e : entries) {                                                                       // src: vvaharness/orchestrator/batch.py:398
                String hit = skipPats.firstOrNull(p -> Fnmatch.match(e.repoName.lower(), p));               // first matching pattern // src: vvaharness/orchestrator/batch.py:400
                if (hit != null) Console.write("skipping " + e.repoName + ": matches batch.skip_repo_patterns"); // src: vvaharness/orchestrator/batch.py:403
                else kept.add(e);                                                                           // src: vvaharness/orchestrator/batch.py:406
            }
            entries = kept;                                                                                 // src: vvaharness/orchestrator/batch.py:410
            if (entries.isEmpty()) { log.error(Events.BATCH_ALL_ROWS_SKIPPED, listFile); return 2; }        // src: vvaharness/orchestrator/batch.py:411
        }
        Path workspace = Path.of(args.workspace);                                                           // src: vvaharness/orchestrator/batch.py:415
        if (args.groupByApp) return runBatchGrouped(entries, workspace, gitToken, args, cfg, listFile, θ);  // src: vvaharness/orchestrator/batch.py:417
        List<Result> results = new List();                                                                  // src: vvaharness/orchestrator/batch.py:421
        double batchT0 = Clock.now();                                                                       // src: vvaharness/orchestrator/batch.py:422
        for (Entry entry : entries) {                                                                       // sequential, fresh context each // src: vvaharness/orchestrator/batch.py:424
            resetProcessGlobals();                                                                          // tokens, stages, counters, cached provenance, quality counters, warn-once, redaction registry, guardrail abort // src: vvaharness/orchestrator/batch.py:430
            double t0 = Clock.now();                                                                        // src: vvaharness/orchestrator/batch.py:440
            Path cloned = null;                                                                             // src: vvaharness/orchestrator/batch.py:441
            try {
                Path local = acquireRepo(entry.ref, workspace, gitToken, entry.repoName, θ);                // src: vvaharness/orchestrator/batch.py:443
                if (isRemote(entry.ref)) cloned = local;                                                    // src: vvaharness/orchestrator/batch.py:445
                if (args.stopAfter == "clone") { results.add(Result.ok(entry, local, Clock.now() - t0)); continue; } // src: vvaharness/orchestrator/batch.py:447
                ScanOutcome outcome = OrchestratorScan.scanRepo(local, entry.repoName, entry.applicationId, args, cfg, entry.repoName, θ); // src: vvaharness/orchestrator/batch.py:454
                results.add(Result.of(entry, outcomeStatus(outcome), Clock.now() - t0));                    // src: vvaharness/orchestrator/batch.py:456
            } catch (KeyboardInterrupt e) {
                results.add(Result.aborted(entry, "interrupted by user"));                                  // src: vvaharness/orchestrator/batch.py:462
                throw e;                                                                                    // src: vvaharness/orchestrator/batch.py:466
            } catch (AuthenticationError | ProxyError | StoreError e) {
                throw e;                                                                                    // environment-wide: every remaining repo would fail identically // src: vvaharness/orchestrator/batch.py:469
            } catch (Exception e) {
                Errlog.log("batch", entry.repoName, e, false, Map.of("app_id", entry.applicationId, "ref", entry.ref)); // repo-scoped: record it and keep the batch moving // src: vvaharness/orchestrator/batch.py:473
                results.add(Result.failed(entry, e.message.truncate(500)));                                 // error text capped at 500 chars // src: vvaharness/orchestrator/batch.py:474
            } finally {
                if (cloned != null && !args.keepClones && args.stopAfter != "clone") Cleanup.purgeClone(cloned, Cleanup.preserveSet(θ)); // src: vvaharness/orchestrator/batch.py:478
            }
        }
        workspace.mkdirs();                                                                                 // src: vvaharness/orchestrator/batch.py:482
        Files.writeText(workspace.resolve("batch_summary.md"), renderBatchSummary(results, listFile, Clock.now() - batchT0)); // src: vvaharness/orchestrator/batch.py:483
        Pair<List<Result>, List<Result>> split = splitNonOk(results);                                       // src: vvaharness/orchestrator/batch.py:488
        if (split.first.isEmpty() && split.second.isEmpty()) return 0;                                      // src: vvaharness/orchestrator/batch.py:489
        if (!split.second.isEmpty()) return 1;                                                              // health outranks outcome, the same precedence the single-repo path applies // src: vvaharness/orchestrator/batch.py:503
        return CaseRollup.EXIT_NOT_REMEDIATED;                                                              // src: vvaharness/orchestrator/batch.py:504
    }

    /** Process-global state a later repo must not inherit from an earlier one. */
    @src("vvaharness/orchestrator/batch.py:430")
    void resetProcessGlobals() {
        TokenCounter.reset();                                                                               // src: vvaharness/orchestrator/batch.py:430
        StageTelemetry.reset();                                                                             // src: vvaharness/orchestrator/batch.py:431
        Counters.reset();                                                                                   // src: vvaharness/orchestrator/batch.py:432
        CachedProvenanceRecorder.reset();                                                                   // repo N greater than 1 must not inherit repo 1's cached-stage provenance // src: vvaharness/orchestrator/batch.py:433
        ResponseQuality.resetCounters();                                                                    // src: vvaharness/orchestrator/batch.py:434
        WarnOnce.resetWarnOnceRegistries();                                                                 // else repo N loses every warn-once // src: vvaharness/orchestrator/batch.py:436
        Redact.resetKnownValues();                                                                          // the value-carry registry is process-global: repo N-1's secrets would leak // src: vvaharness/orchestrator/batch.py:438
        Cancel.resetAbort();                                                                                // do not let a prior repo's guardrail abort poison this one // src: vvaharness/orchestrator/batch.py:439
    }

    /** Place repo ref at appDir/slug: clone if remote, copytree (symlinks preserved) if local. Reuse only a copy bound to THIS ref by a state-dir marker. */
    @src("vvaharness/orchestrator/batch.py:507")
    void stageRepo(String ref, Path appDir, String slug, String gitToken, Theta θ) {
        if (isRemote(ref)) { acquireRepo(ref, appDir, gitToken, slug, θ); return; }                         // src: vvaharness/orchestrator/batch.py:509
        Path src = Path.of(ref);                                                                            // src: vvaharness/orchestrator/batch.py:512
        if (!src.isDir()) throw new RuntimeError("local path does not exist");                              // src: vvaharness/orchestrator/batch.py:513
        Path dest = appDir.resolve(slug);                                                                   // src: vvaharness/orchestrator/batch.py:515
        if (dest.exists()) {                                                                                // src: vvaharness/orchestrator/batch.py:516
            if (stageDirBound(dest, ref, θ)) { Console.write("reusing verified local copy"); return; }         // src: vvaharness/orchestrator/batch.py:518
            Console.write("unverified local copy (stale, foreign, or pre-seeded): replacing");              // src: vvaharness/orchestrator/batch.py:521
            Cleanup.rmtreeRw(dest);                                                                         // src: vvaharness/orchestrator/batch.py:523
            if (dest.exists()) { Console.write("could not remove; reusing as-is"); return; }                // src: vvaharness/orchestrator/batch.py:524
        }
        appDir.mkdirs();                                                                                    // src: vvaharness/orchestrator/batch.py:527
        // SECURITY: the default copy DEREFERENCES symlinks (a key link to an ssh key would be copied in); symlinks=True keeps them as links, and .git is skipped
        Files.copytree(src, dest, true, List.of(".git"));                                                   // src: vvaharness/orchestrator/batch.py:530
        writeStageMarker(dest, ref, "local", θ);                                                               // src: vvaharness/orchestrator/batch.py:532
    }

    /** Module name for an app group: the CMDB profile name (sanitised), else the single repo's name, else app_ plus the id. */
    @src("vvaharness/orchestrator/batch.py:535")
    String appModuleName(String appId, List<Entry> repos) {
        Pair<AppProfile, AppInfo> pr = Cmdb.loadAppProfile(appId);                                          // src: vvaharness/orchestrator/batch.py:536
        if (pr.first != null && pr.first.name != null && !pr.first.name.isEmpty()) {                        // src: vvaharness/orchestrator/batch.py:537
            String safe = pr.first.name.mapChars(c -> c.isAlnum() || "._-".contains(c) ? c : "_");          // src: vvaharness/orchestrator/batch.py:538
            return safe.isEmpty() ? "app_" + appId : safe;                                                  // src: vvaharness/orchestrator/batch.py:539
        }
        if (repos.size() == 1) return moduleNameFrom(repos.get(0).repoName);                                // src: vvaharness/orchestrator/batch.py:540
        return "app_" + appId;                                                                              // src: vvaharness/orchestrator/batch.py:542
    }

    /** Sanitise an operator/CMDB-supplied app id for use as ONE path component: per-char allowlist, leading and trailing dots stripped, "app" if nothing is left. */
    @src("vvaharness/orchestrator/batch.py:558")
    String sanitize(String appId) {
        String s = appId.mapChars(c -> c.isAlnum() || "._-".contains(c) ? c : "_").strip(".");              // so "../x" or "." cannot escape the workspace root // src: vvaharness/orchestrator/batch.py:558
        return s.isEmpty() ? "app" : s;                                                                     // src: vvaharness/orchestrator/batch.py:559
    }

    /** --group-by-app: stage every repo sharing an AppID under workspace/app_id and run ONE scan over that directory. */
    @src("vvaharness/orchestrator/batch.py:545")
    int runBatchGrouped(List<Entry> entries, Path workspace, String gitToken, Args args, Config cfg, Path listFile, Theta θ) {
        Map<String, List<Entry>> groups = entries.groupBy(e -> e.applicationId);                            // src: vvaharness/orchestrator/batch.py:549
        List<Result> results = new List();                                                                  // src: vvaharness/orchestrator/batch.py:553
        double batchT0 = Clock.now();                                                                       // src: vvaharness/orchestrator/batch.py:554
        for (String appId : groups.sortedKeys()) {                                                          // sorted by app id // src: vvaharness/orchestrator/batch.py:556
            List<Entry> repos = groups.get(appId);
            Path appDir = workspace.resolve(sanitize(appId));                                               // src: vvaharness/orchestrator/batch.py:560
            List<String> slugs = assignSlugs(repos);                                                        // src: vvaharness/orchestrator/batch.py:561
            resetProcessGlobals();                                                                          // same per-repo reset as the other loop: no cross-app-group secret leakage // src: vvaharness/orchestrator/batch.py:565
            double t0 = Clock.now();                                                                        // src: vvaharness/orchestrator/batch.py:573
            try {
                List<String> staged = new List();                                                           // src: vvaharness/orchestrator/batch.py:575
                for (int k = 0; k < repos.size(); k++) {                                                    // src: vvaharness/orchestrator/batch.py:576
                    try {
                        stageRepo(repos.get(k).ref, appDir, slugs.get(k), gitToken, θ);                     // src: vvaharness/orchestrator/batch.py:578
                        staged.add(slugs.get(k));                                                           // src: vvaharness/orchestrator/batch.py:579
                    } catch (StoreError e) {
                        throw e;                                                                            // the state store is shared, so this is no per-repo clone failure // src: vvaharness/orchestrator/batch.py:581
                    } catch (Exception ce) {
                        log.warning(Events.BATCH_REPO_SKIPPED, slugs.get(k), ce.message);                   // one failed clone skips that repo only // src: vvaharness/orchestrator/batch.py:583
                        Errlog.log("batch.clone", slugs.get(k), ce, false, Map.of("app_id", appId));        // src: vvaharness/orchestrator/batch.py:584
                    }
                }
                if (staged.isEmpty()) throw new RuntimeError("all repos failed to stage for the app");      // src: vvaharness/orchestrator/batch.py:585
                if (staged.size() < repos.size()) Console.write("staged some repos; continuing scan");      // partial staging continues // src: vvaharness/orchestrator/batch.py:588
                String module = appModuleName(appId, repos);                                                // src: vvaharness/orchestrator/batch.py:591
                if (args.stopAfter == "clone") { results.add(Result.ok(appId, module, appDir, Clock.now() - t0)); continue; } // src: vvaharness/orchestrator/batch.py:592
                ScanOutcome outcome = OrchestratorScan.scanRepo(appDir, module, appId, args, cfg, null, θ); // no path prefix: the app directory is the scan root // src: vvaharness/orchestrator/batch.py:600
                results.add(Result.of(appId, module, outcomeStatus(outcome), Clock.now() - t0));            // src: vvaharness/orchestrator/batch.py:601
            } catch (KeyboardInterrupt e) {
                results.add(Result.aborted(appId, "interrupted by user"));                                  // src: vvaharness/orchestrator/batch.py:607
                throw e;                                                                                    // src: vvaharness/orchestrator/batch.py:611
            } catch (AuthenticationError | ProxyError | StoreError e) {
                throw e;                                                                                    // environment-wide: every remaining app would fail identically // src: vvaharness/orchestrator/batch.py:614
            } catch (Exception e) {
                Errlog.log("batch", "app_" + appId, e, false, Map.of("app_id", appId));                     // src: vvaharness/orchestrator/batch.py:617
                results.add(Result.failed(appId, e.message.truncate(500)));                                 // src: vvaharness/orchestrator/batch.py:618
            } finally {
                if (!args.keepClones && args.stopAfter != "clone") Cleanup.purgeClone(appDir, Cleanup.preserveSet(θ)); // src: vvaharness/orchestrator/batch.py:623
            }
        }
        workspace.mkdirs();                                                                                 // src: vvaharness/orchestrator/batch.py:627
        Files.writeText(workspace.resolve("batch_summary.md"), renderBatchSummary(results, listFile, Clock.now() - batchT0)); // src: vvaharness/orchestrator/batch.py:628
        Pair<List<Result>, List<Result>> split = splitNonOk(results);                                       // src: vvaharness/orchestrator/batch.py:633
        if (split.first.isEmpty() && split.second.isEmpty()) return 0;                                      // src: vvaharness/orchestrator/batch.py:634
        if (!split.second.isEmpty()) return 1;                                                              // src: vvaharness/orchestrator/batch.py:646
        return CaseRollup.EXIT_NOT_REMEDIATED;                                                              // src: vvaharness/orchestrator/batch.py:647
    }

    /** Write the summary and print it; kept as the one place the summary file is created (inline in both run loops in the source). */
    void writeSummary(Path workspace, List<Result> results, Path listFile, double elapsed) {
        workspace.mkdirs();                                                                                 // src: vvaharness/orchestrator/batch.py:482
        Files.writeText(workspace.resolve("batch_summary.md"), renderBatchSummary(results, listFile, elapsed)); // src: vvaharness/orchestrator/batch.py:483
    }

    /** Markdown summary table plus a Not remediated section and a Failures section. Every operator-supplied field goes through the single audited Markdown neutraliser, with URLs scrubbed first. */
    @src("vvaharness/orchestrator/batch.py:650")
    String renderBatchSummary(List<Result> results, Path listFile, double elapsed) {
        int ok = results.count(r -> r.status == "OK");                                                      // src: vvaharness/orchestrator/batch.py:651
        // same three-way split the exit code uses, else this report contradicts it on unremediated
        Pair<List<Result>, List<Result>> split = splitNonOk(results);                                       // src: vvaharness/orchestrator/batch.py:653
        StringBuilder out = new StringBuilder("# Agentic SAST batch summary");                              // src: vvaharness/orchestrator/batch.py:659
        // table columns: #, App ID, Repo, Status, Findings, Elapsed, Report, Source
        for (Result r : results) {                                                                          // src: vvaharness/orchestrator/batch.py:668
            // backtick becomes U+02CB because markdown escapes are inert inside a code span
            String rep = r.report.isEmpty() ? "" : ScanRender.mdCell(r.report).replace("`", "\u02CB");     // src: vvaharness/orchestrator/batch.py:670
            String src = ScanRender.mdCell(scrubUrlSecrets(r.ref));                                         // src: vvaharness/orchestrator/batch.py:672
            out.append(ScanRender.mdCell(r.appId) + ScanRender.mdCell(r.module) + ScanRender.mdCell(r.status) + r.findings + rep + src); // src: vvaharness/orchestrator/batch.py:673
        }
        // its own section, not under Failures: the table has no error column, so prose is the only place
        if (!split.first.isEmpty()) for (Result r : split.first) out.append(ScanRender.mdCell(r.module) + ScanRender.mdCell(scrubUrlSecrets(r.ref))); // src: vvaharness/orchestrator/batch.py:677
        if (!split.second.isEmpty()) for (Result r : split.second) out.append(ScanRender.mdCell(r.module) + ScanRender.mdCell(scrubUrlSecrets(r.ref)) + ScanRender.mdCell(scrubUrlSecrets(r.error))); // src: vvaharness/orchestrator/batch.py:686
        return out.toString();                                                                              // src: vvaharness/orchestrator/batch.py:693
    }
}
