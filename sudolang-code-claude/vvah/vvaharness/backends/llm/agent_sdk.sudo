# vvaharness/backends/llm/agent_sdk.py

The Claude Agent SDK leg of the `sdk` route, used when an agentic role on `via: sdk` asks for tools the raw read-only loop in `sdk.py` cannot run (the Remediation Agent's fix mode: Edit, Write and similar). A PreToolUse hook is the live permission gate: read-only tools pass, file-mutation tools are confined to the working directory (no symlinked target, never `.git`), and every other tool, Bash included, is denied by default. A PostToolUse hook redacts tool output. The session is bounded by a wall-clock budget with an interrupt and a grace period. It also provides `drain_until_result` and the hook helpers that `cli_mcp.py` reuses.

Source: `vvaharness/backends/llm/agent_sdk.py` (lines 1-358)
Executor: mixed (the code builds the session and enforces the gate; the model chooses the tool calls and writes the reply)
Called from: `vvaharness/backends/llm/sdk.py` `agentic` (when `tools.supported(allowed)` reports names the local loop cannot run); `cli_mcp.sudo` reuses `drain_until_result`, `_redact_tool_output` and the gate helpers

// src: vvaharness/backends/llm/agent_sdk.py:44-49
Constants {
  _WRITE_TOOLS = { "Edit", "Write", "MultiEdit", "NotebookEdit" }   // gated to the working directory
  _READ_TOOLS = { "Read", "Glob", "Grep", "LS", "NotebookRead" }    // always permitted; output is redaction-hooked
  _REDACT_TOOLS = _READ_TOOLS union { "Bash" }                       // masked by the PostToolUse hook
  // preserved: Bash is in the redaction set although the PreToolUse gate below denies it in this module
}

// src: vvaharness/backends/llm/agent_sdk.py:323-358
fn agentic(user_prompt, model, system_prompt?, allowed_tools?, cwd, max_budget_usd?, permission_mode = "auto", max_turns?, tag?, timeout?, effort?):executor=mixed {
  // permission_mode is accepted for parity and unused; the hook gate handles policy
  try import claude_agent_sdk   // external: claude_agent_sdk
  catch ImportError => throw RuntimeError("An agentic role is configured `via: sdk` and requests file-editing tools (Edit/Write/Bash), which require the Claude Agent SDK. Reinstall vvaharness to pull it in (pip install .), or set this role to `via: cli`.")
  allowed = if (allowed_tools == null) DEFAULT_READ_TOOLS else allowed_tools   // null = read-only default ("Read", "Glob", "Grep"); [] = no tools wanted
  opts = _build_options(model, system_prompt, allowed_tools=allowed, cwd, max_budget_usd, max_turns)
  return _run(user_prompt, opts, timeout, tag, effort)   // run to completion on a new event loop (asyncio.run)
}

// src: vvaharness/backends/llm/agent_sdk.py:139-236
fn _build_options(model, system_prompt?, allowed_tools, cwd, max_budget_usd?, max_turns?):executor=code {
  try import ClaudeAgentOptions, HookMatcher from claude_agent_sdk
  catch ImportError => throw RuntimeError("This Claude Agent SDK build has no PreToolUse hook support (HookMatcher), which is what enforces the cwd-confined write gate on `via: sdk` (see _pre_tool_use_gate's docstring) — reinstall vvaharness to pull in a newer SDK release.")
  root = resolved cwd

  // src: vvaharness/backends/llm/agent_sdk.py:158-205 — the PreToolUse gate (must stay PreToolUse, never can_use_tool: a bare allow entry would bypass it)
  _pre_tool_use_gate(tool_name, tool_input):executor=code {
    try {
      if (tool_name in _WRITE_TOOLS) {
        [raw, key_used] = first non-empty of tool_input.file_path, tool_input.path, tool_input.notebook_path
        resolved = _resolve_within_root(root, raw)
        require resolved != null => deny("$tool_name target $raw is outside the repository root, unresolvable, or a symlink — edits are confined to $root")
        require !is_git_metadata(resolved relative to root) => deny("$tool_name target $raw is version-control metadata (.git), which remediation never edits.")   // any path component equal to ".git", case-folded
        return allow with updatedInput = tool_input where [key_used] = resolved   // the SDK receives the resolved path, so an alias cannot redirect the write
      }
      if (tool_name in _READ_TOOLS) return no decision   // the allowed_tools entry covers them
      deny("$tool_name is not permitted in remediation fix mode — only Read/Glob/Grep and cwd-confined Edit/Write are allowed (Bash and other tools are denied by default).")   // deny by default, including Bash
    }
    catch any error => deny("the security gate could not evaluate this call (<ErrorType>) and denies it as a precaution.")   // fails closed
  }

  // src: vvaharness/backends/llm/agent_sdk.py:207-236
  hooks = { ..._build_redaction_hooks() || {}, PreToolUse: [HookMatcher(hooks=[_pre_tool_use_gate])] }
  opts = ClaudeAgentOptions {
    model
    cwd: root
    env: _sdk_env()
    permission_mode: "default"      // the PreToolUse hook is the live gate; permission_mode and allowed_tools only set availability
    setting_sources: ["user"]       // a scanned repository's own .claude/settings.json can never re-grant Bash or register a host hook (mirrors the cli route's --setting-sources user)
    strict_mcp_config: true         // the target repository's own .mcp.json server is never spawned (mirrors cli_mcp.py)
    allowed_tools                   // the tools offered
    hooks
    verbatim_prompts: true          // finding text and code snippets reach the prompt; they must not be parsed as an @path expansion or a slash command
  }
  if (system_prompt != null) opts.system_prompt = system_prompt
  if (max_turns != null) opts.max_turns = int(max_turns)
  if (max_budget_usd != null) opts.max_budget_usd = float(max_budget_usd)   // enforced by the Agent SDK on this leg, unlike the raw sdk loop
  return opts
}

// src: vvaharness/backends/llm/agent_sdk.py:52-70
fn _resolve_within_root(root, raw):executor=code {
  if (raw is not a non-empty string) return null
  candidate = if (raw is absolute) raw else root / raw
  if (candidate is a symlink) return null   // a symlinked final component is refused without following it
  target = resolve(candidate); return null on OSError or ValueError
  return if (target is inside root or equal to root) target else null
}
fn _within_root(root, raw):executor=code { return _resolve_within_root(root, raw) != null }

// src: vvaharness/backends/llm/agent_sdk.py:73-85
fn _sdk_env():executor=code {
  env = copy of the process environment
  if (!env.ANTHROPIC_API_KEY) env.ANTHROPIC_API_KEY = env.ANTHROPIC_AUTH_TOKEN || env.ANTHROPIC_SDK_API_KEY (when either is set)
  if (env.ANTHROPIC_SDK_BASE_URL && !env.ANTHROPIC_BASE_URL) env.ANTHROPIC_BASE_URL = env.ANTHROPIC_SDK_BASE_URL
  return env + _NO_REFUSAL_RESEND_ENV   // CLAUDE_CODE_DISABLE_REFUSAL_RETRY=1, CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK=1, set last so an ambient "0" cannot win (see cli/env.sudo)
}

// src: vvaharness/backends/llm/agent_sdk.py:88-136
_TOOL_PATH_KEYS = { "filePath", "file_path", "filenames", "path" }   // redacted with carry=false
fn _redact_tool_output(payload, carry = true):executor=code {
  match (payload) {
    case String => redact_counts(payload, carry).text
    case List => each item redacted recursively
    case Map => each value redacted, with carry turned off under a key in _TOOL_PATH_KEYS
    default => payload unchanged
  }
}
fn _build_redaction_hooks():executor=code {
  // best effort: null when HookMatcher cannot be imported or built
  _post_tool_use(tool_name, tool_response):executor=code {
    if (tool_name not in _REDACT_TOOLS || tool_response == null) return no change
    masked = _redact_tool_output(tool_response)
    if (masked == tool_response) return no change
    return { hookEventName: "PostToolUse", updatedToolOutput: masked }   // the only key the CLI honours
    // any error inside the hook: return no change
  }
  return { PostToolUse: [HookMatcher(hooks=[_post_tool_use])] }
}

// src: vvaharness/backends/llm/agent_sdk.py:284-320
fn _run(user_prompt, opts, timeout?, tag?, effort?):executor=mixed {
  budget = effort_scaled_seconds(timeout, effort, kind=SESSION)
  // the client's close must run with no cancellation in flight, or the SDK skips its own terminate/kill escalation
  with ClaudeSDKClient(options=opts) as client {   // external: claude_agent_sdk
    // the model call: client.query(user_prompt), then drain_until_result(client, on_message=collect text blocks of each AssistantMessage, timeout=budget, grace=TIMEOUT_STOP_GRACE_SECONDS = 20 seconds)
    drained = callModel({ role: tag, route: "sdk", system: opts.system_prompt, prompt: user_prompt, tools: opts.allowed_tools, limits: { max_turns: opts.max_turns, max_budget_usd: opts.max_budget_usd, session: budget, grace: 20 }, output: "text" })
  }
  if (drained.result && drained.result.usage) TOKENS.add(drained.result.usage)
  require !drained.timed_out => throw call_timeout_error(stage=tag, route="agent-sdk", budget_s=budget, effort, cause_text="agent-sdk session exceeded ${budget}s")
  note_budget_use(elapsed, budget, effort)
  return trim(drained.result.result || concatenated collected text)
}

// src: vvaharness/backends/llm/agent_sdk.py:239-281
DrainResult { result: ResultMessage | null; timed_out: Boolean }
fn _drain(client, on_message):executor=code {
  for each message in client.receive_response() { on_message(message); if (message is a ResultMessage) return message }
  return null
}
fn drain_until_result(client, on_message, timeout?, grace = TIMEOUT_STOP_GRACE_SECONDS):executor=code {
  if (timeout == null || timeout <= 0) return DrainResult(_drain(client, on_message), false)   // no deadline
  try return DrainResult(_drain(client, on_message), false) within timeout seconds
  catch TimeoutError => { if (the error was not this deadline expiring) throw it }
  try client.interrupt(); catch any => ignore
  // a second, fresh pass over receive_response(), bounded by the grace period
  try return DrainResult(_drain(client, on_message), true) within grace seconds
  catch TimeoutError => { if (the error was not the grace deadline expiring) throw it; return DrainResult(null, true) }
}
