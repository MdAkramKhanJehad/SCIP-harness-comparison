// file: vvaharness/orchestrator/checkpoints.py
// Checkpoint/resume: step-key derivation and JSON (never pickle) storage of each stage's output in the
// SQLite state store, schema-validated on load so a tampered or stale blob re-runs the step instead.

@executedBy(CODE) @role(types)
record S4Ckpt(List<Finding> findings, Map<String, String> outcomes, String inputKind) { }   // inputKind optional: deepdive | external // src: vvaharness/orchestrator/checkpoints.py:46

@executedBy(CODE) @role(types)
record S5Ckpt(List<Finding> findings, List<DroppedFinding> preDropped) { }                  // src: vvaharness/orchestrator/checkpoints.py:73

@executedBy(CODE) @role(types)
record S6Ckpt(List<Finding> verified, List<DroppedFinding> dropped) { }                     // src: vvaharness/orchestrator/checkpoints.py:78

@executedBy(CODE) @role(types)
record S7Ckpt(List<DroppedFinding> preDropped, List<Finding> verified, List<DroppedFinding> dropped,
              List<Finding> canonical, List<DroppedFinding> dupDropped, Integer s5OutCount) { }  // 6-tuple; legacy 5-tuple without s5OutCount // src: vvaharness/orchestrator/checkpoints.py:84

/** Model/via/config a detection stage's checkpoint was actually produced under, plus its token bucket. */
@executedBy(CODE) @role(types)
record StageProvenance(String model, String via, String configSha256, Map<String, Number> tokens) { } // src: vvaharness/orchestrator/checkpoints.py:100

@executedBy(CODE) @role(io)
class Checkpoints {

    String REPO_IDENTITY_STEP = "repo_identity";             // git HEAD at scan start // src: vvaharness/orchestrator/checkpoints.py:97
    String PROVENANCE_SUFFIX = "_prov";                       // src: vvaharness/orchestrator/checkpoints.py:124
    String REMEDIATE_PREFIX = "remediate_";                   // src: vvaharness/orchestrator/checkpoints.py:155
    String VALIDATE_PREFIX = "validate_";                     // src: vvaharness/orchestrator/checkpoints.py:156
    String EV_COLLECTION_STEP = "ev_collection";              // src: vvaharness/orchestrator/checkpoints.py:177
    int STEP_DIGEST_CHARS = 24;                               // 96 bits; names a row, not a directory // src: vvaharness/orchestrator/checkpoints.py:161
    Set<Pair<String, String>> PRUNED = new Set();             // one prune per (run_id, prefix) per process // src: vvaharness/orchestrator/checkpoints.py:221
    Map<String, TypeAdapter> STEP_SCHEMA = new Map();                                                       // src: vvaharness/orchestrator/checkpoints.py:133
    // Step -> schema: s0 SeedPackage, s1 ContextPackage, s2 ThreatModel, s3 TaskManifest, s4 S4Ckpt, s5 S5Ckpt,
    // s6 S6Ckpt, s7 S7Ckpt, s8 FinalReport, s9 str (SARIF path), ingest bool, repo_identity str. // src: vvaharness/orchestrator/checkpoints.py:133

    /** Whether the S4 checkpoint came from deep-dive or from external findings (legacy rows lack input_kind). */
    String s4InputKind(Map checkpoint) {
        if (checkpoint.containsKey("input_kind")) return checkpoint.get("input_kind");                // src: vvaharness/orchestrator/checkpoints.py:53
        List<Finding> findings = checkpoint.getOrDefault("findings", List.of());                      // src: vvaharness/orchestrator/checkpoints.py:55
        Map outcomes = checkpoint.getOrDefault("outcomes", Map.of());                                 // src: vvaharness/orchestrator/checkpoints.py:56
        Set<String> origins = findings.map(f -> f.origin != null ? f.origin : "external").toSet();   // src: vvaharness/orchestrator/checkpoints.py:57
        if (!findings.isEmpty() && outcomes == Map.fromKeys(origins, "confirmed")) return "external";  // src: vvaharness/orchestrator/checkpoints.py:58
        return "deepdive";                                                                             // src: vvaharness/orchestrator/checkpoints.py:60
    }

    /** False when any unit is still in an untrusted outcome: --resume must not reuse the S4 checkpoint. */
    boolean s4StageComplete(Map checkpoint, Theta θ) {
        Map<String, String> outcomes = checkpoint.getOrDefault("outcomes", Map.of());                 // src: vvaharness/orchestrator/checkpoints.py:69
        return !outcomes.values().anyMatch(o -> θ["code.orchestrator.checkpoints.s4_untrusted_outcomes"].contains(o)); // src: vvaharness/orchestrator/checkpoints.py:70
    }

    String provenanceStep(String step) {
        return step + PROVENANCE_SUFFIX;                                                               // src: vvaharness/orchestrator/checkpoints.py:130
    }

    TypeAdapter validateSchema() {
        return TypeAdapter.of("ValidationResult");                                                    // built lazily (import cycle) // src: vvaharness/orchestrator/checkpoints.py:171
    }

    TypeAdapter evCollectionSchema() {
        return TypeAdapter.of("NormalizedCollection");                                                // built lazily // src: vvaharness/orchestrator/checkpoints.py:186
    }

    /** Resolve the schema for a step, fixed or dynamic; an unknown step fails loud. */
    TypeAdapter schemaFor(String step) {
        if (STEP_SCHEMA.containsKey(step)) return STEP_SCHEMA.get(step);                              // src: vvaharness/orchestrator/checkpoints.py:195
        if (step.endsWith(PROVENANCE_SUFFIX) && STEP_SCHEMA.containsKey(step.removeSuffix(PROVENANCE_SUFFIX))) return TypeAdapter.of("StageProvenance"); // src: vvaharness/orchestrator/checkpoints.py:197
        if (step == EV_COLLECTION_STEP) return evCollectionSchema();                                   // src: vvaharness/orchestrator/checkpoints.py:200
        if (step.startsWith(REMEDIATE_PREFIX)) return TypeAdapter.of("dict");                        // src: vvaharness/orchestrator/checkpoints.py:202
        if (step.startsWith(VALIDATE_PREFIX)) return validateSchema();                                 // src: vvaharness/orchestrator/checkpoints.py:204
        throw new KeyError(step);                                                                      // caller bug // src: vvaharness/orchestrator/checkpoints.py:206
    }

    /** Dynamic key for one case under one engine/model/backend, so --resume never republishes another producer's result. */
    String stepKeyFor(String prefix, String engineId, String engineVersion, String caseId, String model, String backend) {
        if (!List.of(REMEDIATE_PREFIX, VALIDATE_PREFIX).contains(prefix)) throw new ValueError("unknown dynamic checkpoint prefix"); // src: vvaharness/orchestrator/checkpoints.py:212
        String material = String.join("\n", engineId, engineVersion, caseId, model, backend);         // src: vvaharness/orchestrator/checkpoints.py:216
        return prefix + Sha256.hex(material).substring(0, STEP_DIGEST_CHARS);                          // src: vvaharness/orchestrator/checkpoints.py:217
    }

    /** Delete this run's prefix rows that no live case claims, at most once per (run_id, prefix) per process. */
    List<String> pruneStaleSteps(String runId, String prefix, Iterable<String> liveKeys) {
        Pair<String, String> once = Pair.of(runId, prefix);                                           // src: vvaharness/orchestrator/checkpoints.py:226
        if (PRUNED.contains(once)) return List.of();                                                   // src: vvaharness/orchestrator/checkpoints.py:227
        PRUNED.add(once);                                                                              // src: vvaharness/orchestrator/checkpoints.py:229
        List<String> removed = Store.deleteSteps(runId, prefix, liveKeys.toSet());                    // src: vvaharness/orchestrator/checkpoints.py:230
        if (!removed.isEmpty()) Console.write("[ckpt] pruned stale checkpoint rows");                 // src: vvaharness/orchestrator/checkpoints.py:231
        return removed;                                                                                // src: vvaharness/orchestrator/checkpoints.py:234
    }

    /** Persist obj for (run_id, step); ckptDir is kept only for call-site compatibility. */
    void saveCkpt(Path ckptDir, String runId, String step, Object obj, Theta θ) {
        byte[] blob = schemaFor(step).dumpJson(obj);                                                   // JSON, never pickle (CWE-502) // src: vvaharness/orchestrator/checkpoints.py:244
        if (blob.length > θ["code.orchestrator.checkpoints.ckpt_max_bytes"]) {                         // src: vvaharness/orchestrator/checkpoints.py:245
            Log.warning("CKPT_TOO_LARGE");                                                             // oversized: not saved, the step re-runs on resume // src: vvaharness/orchestrator/checkpoints.py:246
            return;
        }
        Connection con = Store.connect();                                                              // src: vvaharness/orchestrator/checkpoints.py:248
        try {
            con.transaction(() -> {                                                                    // one transaction == atomic // src: vvaharness/orchestrator/checkpoints.py:250
                con.execute("INSERT OR IGNORE INTO runs(run_id, repo_root) VALUES (?, '')", runId);   // parent row for the FK cascade // src: vvaharness/orchestrator/checkpoints.py:252
                con.execute("UPDATE runs SET updated_at = now WHERE run_id = ?", runId);              // src: vvaharness/orchestrator/checkpoints.py:254
                con.execute("INSERT OR REPLACE INTO checkpoints(run_id, step, payload, size)", runId, step, blob, blob.length); // src: vvaharness/orchestrator/checkpoints.py:256
            });
        } finally { con.close(); }                                                                     // src: vvaharness/orchestrator/checkpoints.py:262
        Console.write("[ckpt] saved " + step);                                                         // src: vvaharness/orchestrator/checkpoints.py:263
    }

    /** Rehydrated checkpoint, or null if absent, oversized or schema-invalid (the caller re-runs the step). */
    Object loadCkpt(Path ckptDir, String runId, String step, Theta θ) {
        Connection con = Store.connect();                                                              // src: vvaharness/orchestrator/checkpoints.py:269
        Row row;
        try { row = con.query("SELECT payload, size FROM checkpoints WHERE run_id=? AND step=?", runId, step).fetchOne(); } // src: vvaharness/orchestrator/checkpoints.py:271
        finally { con.close(); }
        if (row == null) {
            if (step == "s1") Console.write("[ckpt] no checkpoints in " + Store.dbPath() + "; check $VVAHARNESS_STATE_DIR"); // src: vvaharness/orchestrator/checkpoints.py:278
            return null;                                                                               // src: vvaharness/orchestrator/checkpoints.py:282
        }
        if (row.size > θ["code.orchestrator.checkpoints.ckpt_max_bytes"]) {                            // belt-and-braces; DB CHECK already enforces // src: vvaharness/orchestrator/checkpoints.py:284
            Log.warning("CKPT_STORED_TOO_LARGE"); return null;                                         // src: vvaharness/orchestrator/checkpoints.py:285
        }
        Object obj;
        try { obj = schemaFor(step).validateJson(row.payload); }                                       // src: vvaharness/orchestrator/checkpoints.py:288
        catch (ValidationError e) {
            if (!Json.isWellFormed(row.payload)) Log.warning("CKPT_UNREADABLE");                     // truncated/corrupt/substituted blob // src: vvaharness/orchestrator/checkpoints.py:295
            else Log.warning("CKPT_SCHEMA_MISMATCH");                                                  // usually a different tool version // src: vvaharness/orchestrator/checkpoints.py:298
            return null;                                                                               // src: vvaharness/orchestrator/checkpoints.py:299
        }
        Console.write("[ckpt] resumed " + step + " from db");                                         // src: vvaharness/orchestrator/checkpoints.py:300
        return obj;
    }

    /** Second checkpoint row <step>_prov holding the model/via/config/tokens the stage ran under. */
    void saveStageProvenance(Path ckptDir, String runId, String step, String model, String via, String configSha256, Map tokens) {
        saveCkpt(ckptDir, runId, provenanceStep(step), new StageProvenance(model, via, configSha256, tokens)); // src: vvaharness/orchestrator/checkpoints.py:309
    }

    /** Null when never saved (legacy checkpoint): the manifest falls back to the current config. */
    StageProvenance loadStageProvenance(Path ckptDir, String runId, String step) {
        return loadCkpt(ckptDir, runId, provenanceStep(step));                                         // src: vvaharness/orchestrator/checkpoints.py:316
    }

    /** Stable non-reversible run id per repo path (sha256 of the resolved path, 32 hex chars). */
    String runIdFor(Path repo) {
        return Sha256.hex(repo.realPath().toString()).substring(0, 32);                                // src: vvaharness/orchestrator/checkpoints.py:321
    }

    /** Delete runs (and their checkpoints, via cascade) and graph workspaces older than max_age_days or beyond the keep_runs most recent. */
    Map pruneCheckpoints(int keepRuns, int maxAgeDays, boolean dryRun, Theta θ) {
        // defaults keep_runs / max_age_days                                                           // src: vvaharness/orchestrator/checkpoints.py:324
        if (keepRuns == null) keepRuns = θ["code.orchestrator.checkpoints.prune_keep_runs"];          // src: vvaharness/orchestrator/checkpoints.py:324
        if (maxAgeDays == null) maxAgeDays = θ["code.orchestrator.checkpoints.prune_max_age_days"];   // src: vvaharness/orchestrator/checkpoints.py:324
        Path db = Store.dbLocation();                                                                  // src: vvaharness/orchestrator/checkpoints.py:328
        if (!db.exists()) return Map.of("root", db, "kept", 0, "deleted", List.of());                 // no DB = nothing to prune, both modes // src: vvaharness/orchestrator/checkpoints.py:329
        Connection con = Store.connect();                                                              // src: vvaharness/orchestrator/checkpoints.py:331
        int total; List<String> victims;
        try {
            total = con.query("SELECT COUNT(*) FROM runs").scalar();                                  // src: vvaharness/orchestrator/checkpoints.py:333
            victims = con.query("runs older than maxAgeDays OR not in the keepRuns most recent by updated_at", maxAgeDays, keepRuns); // src: vvaharness/orchestrator/checkpoints.py:334
            if (!dryRun && !victims.isEmpty()) {                                                       // src: vvaharness/orchestrator/checkpoints.py:343
                con.transaction(() -> con.executeMany("DELETE FROM runs WHERE run_id = ?", victims));  // src: vvaharness/orchestrator/checkpoints.py:345
                con.execute("PRAGMA incremental_vacuum");                                              // src: vvaharness/orchestrator/checkpoints.py:349
                con.execute("PRAGMA wal_checkpoint(TRUNCATE)");                                        // src: vvaharness/orchestrator/checkpoints.py:350
                for (String v : victims) Store.deleteRunGraphs(v);                                    // src: vvaharness/orchestrator/checkpoints.py:352
            }
        } finally { con.close(); }
        return Map.of("root", db, "kept", total - victims.size(), "deleted", victims);                 // src: vvaharness/orchestrator/checkpoints.py:356
    }
}
