# vvaharness/remediation_agent/plugin_runner/__init__.py

The engine seam: `_invoke` makes the single remediation model session for one finding through the configured backend. Three routes differ in confinement. `deepagents` runs an orchestrator with read tools plus, in fix mode, a `fixer` subagent with an edit tool behind a dispatch guard; `cli` runs one agent with edit tools under `acceptEdits`; any other route (`sdk`, `openai`) relies on the tool list alone. Before any route, fix mode is refused (downgraded to report) when the repository holds escaping symlinks.

Source: `vvaharness/remediation_agent/plugin_runner/__init__.py` (lines 1-505)
Executor: mixed (code builds and bounds the session; the model investigates, edits and reports)
Called from: `plugin_runner/run.sudo` call_with_guards (as `fn`, through _call_engine)

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:461-505
fn _invoke(target, cfg, repo, mode, verbose=false, pre?, ctx?):executor=mixed {
  user = helpers._build_user(target, repo, mode, pre, ctx)   // built with the ORIGINAL mode, before the symlink downgrade below
  [model_id, via] = resolve_model(knob("models.remediate"))
  provider = knob("models.remediate.provider", default=null)

  // src: __init__.py:468 — symlink jail check, before any writer is handed to a model
  mode = _symlink_safe_mode(repo, mode)
  // preserved: the prompt text was already built, so after a downgrade it still says "MODE: fix" and "apply the minimal safe fix" while the session gets no writer (report mode)

  if (via == "deepagents") user = _virtualize_deepagents_prompt(user)
  if (verbose) trace.dump("PROMPT → finding <index> (<mode>)", user)

  // src: __init__.py:473-501 — token spend is attributed to phase "remediation-agent-remediate"
  match (via) {
    case "deepagents" => raw = _invoke_deepagents(user, model_id, repo, mode, sr=step_remediate, cfg, verbose, provider, use_responses_api=use_responses_api_of(knob("models.remediate")), primary_file=target.file)
    case "cli" => raw = _invoke_cli(user, cfg, repo, mode, sr=step_remediate, verbose, tag="Remediation Agent remediate #<index>")
    default => {
      // src: __init__.py:484-501 — sdk / openai: no permission-mode fallback, the tools list is the only gate
      tools = _tools(cfg) without "Edit" and "Write"
      if (mode == "fix") tools = unique(tools + ["Edit", "Write"])
      raw = callModel({
        role: "remediate", route: via,
        system: SYSTEM, prompt: user,
        tools,
        limits: { max_turns: knob("step_remediate.max_turns", default=40), max_budget_usd: knob("step_remediate.max_budget_usd", default=10.0), timeout_s: _timeout_of(step_remediate) },
        output: "free text; parsed afterwards by helpers._coerce_verdict"
      })   // external: vvaharness/backends/llm/registry.py agentic, cwd = repo
      // preserved: unlike the deepagents and cli routes, "Bash" is not removed from the tool list on this route; it is offered whenever step_remediate.allowed_tools contains it
      // preserved: no json_schema and no disallowed_tools are passed on this route
    }
  }
  if (verbose) trace.dump("FINAL VERDICT ← finding <index>", raw)
  return raw
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:435-458
fn _symlink_safe_mode(repo, mode):executor=code {
  if (mode != "fix") return mode
  escapes = policy.symlink_jail.escaping_symlinks(repo)
  if (!escapes) return mode
  warn once per process "[remediate] REFUSING fix mode: the repository contains <n> symlink(s) resolving outside the checkout (<up to 5 listed>) ... Running report-only instead — remove the link(s) or scan a clean copy to enable fix mode."
  return "report"
  // A write through an escaping link lands on the host, never changes the link object, and so is invisible to git status, changed_files_whole_tree and revert_files (CWE-59); refusing the writer is the only control
  // preserved: the downgraded value is "report", not "report-only" (VALID_MODES); downstream tests compare against "fix", so it behaves as report-only inside this call
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:322-327
fn _virtualize_deepagents_prompt(user):executor=code {
  if (first line starts with "REPOSITORY ROOT:") replace it with "REPOSITORY ROOT: / (DeepAgents virtual workspace root)"
  return user
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:330-388
fn _invoke_deepagents(user, model_id, repo, mode, sr, cfg, verbose, provider?, use_responses_api?, primary_file=""):executor=mixed {
  tools = _tools(cfg) without "Bash"
  fix_mode = mode == "fix"
  env = process environment + credential_env_overrides(model_id, provider, sdk_cfg, openai_cfg)   // external: backends/harness/provider_routing.py

  // src: __init__.py:345-359 — orchestrator reads REDACTED source; the fixer (having "Edit") reads unredacted
  agents = {}
  if (fix_mode) {
    agents.fixer = SubagentDefinition(
      name: "fixer",
      description: "Applies the security fix to the target file(s).",
      prompt: FIXER_SYSTEM,   // prompts.sudo
      tools: unique(tools + ["Edit"]),
      response_model: FixerResult,   // models/fixer.sudo
      max_model_calls: _max_model_calls_of(sr)   // the parent's cap, shared by the session's dispatches
    )
  }

  // src: __init__.py:360-386
  raw = callModel({
    role: "remediate", route: "deepagents",
    system: if (fix_mode) ORCHESTRATOR_SYSTEM else SYSTEM,
    prompt: user,
    tools,   // orchestrator: read/search tools only; subagent dispatch through the "task" tool when agents.fixer exists
    limits: {
      max_turns: knob("step_remediate.max_turns", default=40),   // recursion limit = max_turns + RECURSION_HEADROOM (external: backends/harness/deepagents/limits.py)
      max_budget_usd: knob("step_remediate.max_budget_usd", default=10.0),
      model_call_budget: _remediate_call_budget(sr),
      wall_clock_s: _timeout_of(sr)
    },
    output: RemediationVerdict   // force_verdict_only: the verdict tool is forced only to end the session
  })   // external: backends/harness deepagents run_streaming; consumed by _consume_deepagents_bounded
  require "Bash" is disallowed (ToolPolicy allowed_tools=tools, disallowed_tools=["Bash"])
  require writes allowed only when fix_mode, and only under resolved repo (writable_paths)   // external: enforced by the deepagents harness
  require every "task" dispatch passes FixerDispatchGuard(finding_context=user, primary_file) when fix_mode   // plugin_runner/handoff.sudo
  // cache_markers = markers_on(knob("sdk")); graph_name "remediation"
  return _run_sync(_consume_deepagents_bounded(user, options, verbose, timeout=_timeout_of(sr)))   // runs the coroutine on a fresh event loop, in a worker thread when a loop is already running
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:113-133
fn _timeout_of(sr) = integer(knob("step_remediate.timeout", default=3600)), with any falsy value treated as 3600
fn _max_model_calls_of(sr) = integer(knob("step_remediate.max_model_calls", default=0)), falsy -> 0   // <= 0 leaves the session and its fixer unmetered
fn _remediate_call_budget(sr):executor=code {
  limit = _max_model_calls_of(sr)
  if (limit <= 0) return null
  return ModelCallBudget(limit, outcome_tools={"RemediationVerdict"}, counter="s10_model_call_budget_final_turn", stage="s10")   // external: backends/harness/deepagents/model_call_budget.py (forces a final verdict turn at the cap)
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:304-319
fn _consume_deepagents_bounded(prompt, options, verbose, timeout):executor=code {
  try within a wall clock of $timeout seconds: return _consume_deepagents(prompt, options, verbose);
  catch TimeoutError => {
    if (our own deadline did not expire) throw   // a TimeoutError raised inside the session propagates unchanged
    throw call_timeout_error(stage="s10", route="deepagents", budget_s=timeout, cause_text="deepagents remediation session exceeded <timeout>s")   // VVAH-E008
  }
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:248-301
fn _consume_deepagents(prompt, options, verbose):executor=code {
  terminal = null; recursion_error = null; refusal = null
  try {
    stream = guard_repeats(deepagents harness run_streaming(prompt, options), stage="s10", route="deepagents")   // external: backends/harness/repeat_guard.py
    for each message in stream {
      if (message is HarnessResult) terminal = message
      // abstracted: __init__.py:261-273 — assistant text, tool uses and tool results go to the debug log and, under --verbose, to trace.dump; no decisions
    }
  } catch error => {
    // src: __init__.py:274-282
    refusal = model_refusal_from(error, route="deepagents", stage="s10")
    recursion = error is HarnessProcessError && (error.recursion_limited || "GraphRecursionError" in text of error)
    if (refusal == null && !(recursion && terminal != null)) throw error
    recursion_error = error
  }
  if (refusal != null) throw refusal   // a mid-stream provider block is never salvaged into extraction
  require terminal != null => throw RuntimeError("DeepAgents remediation ended without a terminal result")
  raise_if_refused(terminal, tag="s10")   // before extraction, which would re-send a refused conversation
  require !(terminal.is_error && recursion_error == null) => throw RuntimeError("DeepAgents remediation failed: <subtype or unknown error>")
  if (terminal.structured != null) return terminal.structured
  if (recursion_error != null) _report_recursion_limit(terminal, options)   // console advice: set step_remediate.max_model_calls (for example 20) to force a final verdict turn
  result = _attempt_extraction(terminal, options)
  if (result != null || recursion_error == null) return result
  throw recursion_error   // extraction failed after a recursion crash
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:227-245
fn _attempt_extraction(terminal, options):executor=mixed {
  console "[deepagents] <model> made <n> tool call(s) but did not emit a structured verdict — attempting post-hoc extraction from message history"
  extracted = _extract_verdict_from_history(terminal, options)
  if (extracted != null) return extracted
  console "post-hoc extraction failed ... recording as Needs Review"
  return terminal.result_text or ""   // becomes "Needs Review" in _coerce_verdict when no JSON is found
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:199-224
fn _extract_verdict_from_history(terminal, options):executor=mixed {
  messages = terminal.state.messages
  if (!messages) return null
  try {
    response = callModel({
      role: "remediate", route: "deepagents",
      prompt: messages + [_verdict_extraction_prompt],   // the same model, the whole session history, one extra human turn
      tools: [],
      output: "raw JSON object"
    })   // external: build_model_cached(...).invoke
    data = extract_json(response.content)
    return if (data is a dict) data else null
  } catch => return null
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:190-196
// prompt-src: vvaharness/remediation_agent/plugin_runner/__init__.py:192-196
_verdict_extraction_prompt {
  $schema = RemediationVerdict JSON schema (compact)
  Constraints {
    "You completed remediation work above but did not emit a structured verdict. Based solely on the work you did, return ONLY a JSON object — no prose, no markdown fences — matching exactly this JSON Schema:" followed by $schema
  }
}

// src: vvaharness/remediation_agent/plugin_runner/__init__.py:397-432
fn _invoke_cli(user, cfg, repo, mode, sr, verbose, tag):executor=mixed {
  // permission-engine scoping, NOT a path jail: symlinks escape, so run.py's git-status proof stays the check
  fix_mode = mode == "fix"
  tools = _tools(cfg) without "Bash"
  if (fix_mode) {
    tools = unique(tools + ["Edit", "Write"])
    warn once per process "[remediate] NOTE: via:cli runs the fix in ONE context that reads unredacted source. The orchestrator-reads-redacted / fixer-edits-unredacted split (and its dispatch guard) is via:deepagents-only ..."
  }
  return callModel({
    role: "remediate", route: "cli",
    system: SYSTEM, prompt: user,
    tools,
    limits: { max_turns: knob("step_remediate.max_turns", default=40), max_budget_usd: knob("step_remediate.max_budget_usd", default=10.0), timeout_s: _timeout_of(sr) },   // --max-turns is never forwarded: max_turns is the backend's turn watchdog; the timeout is the outer bound
    output: RemediationVerdict JSON schema
  })   // external: backends/llm/registry.py agentic, cwd = repo
  require "Bash" disallowed (disallowed_tools=["Bash"])
  require permission_mode == (if (fix_mode) "acceptEdits" else "default"), permission_prompts == "none"   // report mode ships no writer at all
}

// abstracted: __init__.py:89-110 (_run_sync thread bridge), 136-187 (_debug_log, _terminal_stats, _debug_terminal, _report_recursion_limit: diagnostics to VVAHARNESS_DEBUG_LOG and console), 391-394 (one-time warning sets). No decisions beyond those rendered above.
