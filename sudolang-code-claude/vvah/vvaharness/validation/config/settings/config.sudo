# vvaharness/validation/config/settings/config.py

The composed validation configuration and its loader. Tunables come from the profile overrides or a hard-coded default, never from the environment; only the Claude binary and the GitHub Enterprise tokens are read from the environment.

Source: `vvaharness/validation/config/settings/config.py` (lines 1-97)
Executor: code
Called from: `vvaharness/validation/cli/_run.sudo`, `vvaharness/validation/case_api.sudo` validate_case

// src: vvaharness/validation/config/settings/config.py:41-52
Config {   // extra fields forbidden
  paths: PathsConfig
  agent: AgentConfig = AgentConfig()
  ghe: GheConfig = GheConfig()
  max_findings: Number | null = 20   // DEFAULT_MAX_FINDINGS
  live: Boolean = false
  verbose: Boolean = false
  dry_run: Boolean = false
}

// src: vvaharness/validation/config/settings/config.py:55-58
fn _parse_tools(raw):executor=code = trimmed non-blank comma-separated items, or null when none (null keeps the .md default)

// src: vvaharness/validation/config/settings/config.py:61-97
fn load_config(project_root?, live=false, overrides?):executor=code {
  ov = overrides || {}
  env = _EnvScalars()   // reads VVAHARNESS_CLAUDE_BINARY, VVAHARNESS_GHE_TOKEN, VVAHARNESS_GHE_ARCHIVED_TOKEN
  root = project_root or, when absent, current working directory
  return Config {
    paths: _build_paths(root),
    agent: AgentConfig {
      binary: env.binary,
      model: ov.model or, when absent, "claude-opus-4-8[1m]",
      max_turns: ov.max_turns or, when absent, 50,
      max_budget_usd: ov.max_budget_usd or, when absent, 15.0,
      effort: ov.effort or, when absent, HIGH,
      timeout: (ov.timeout or, when absent, 3600) || 3600,   // a zero or empty timeout falls back to 3600
      max_model_calls: ov.max_model_calls or, when absent, 60,
      orchestrator_max_model_calls: ov.orchestrator_max_model_calls or, when absent, 40,
      via: ov.via or, when absent, "deepagents",
      provider: ov.provider or, when absent, null,
      use_responses_api: ov.use_responses_api or, when absent, null,
      security_architect_model: ov.security_architect_model or, when absent, null,
      penetration_tester_model: ov.penetration_tester_model or, when absent, null,
      cross_repo_analyzer_model: ov.cross_repo_analyzer_model or, when absent, null,
      validate_tools: _parse_tools(ov.validate_tools or, when absent, ""),
      cache_markers: ov.cache_markers or, when absent, true
    },
    ghe: GheConfig(token=env.ghe_token, archived_token=env.ghe_archived_token),
    max_findings: ov.max_findings or, when absent, 20,
    live
  }
  // "No mkdir: root defaults to Path.cwd() and neither ./targets nor ./outputs has a reader."
  // "or, when absent," here means "key absent from the overrides"; a key present with null keeps null (for example max_budget_usd: null means no budget cap is passed)
}
