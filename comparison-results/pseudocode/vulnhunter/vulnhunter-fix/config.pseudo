// file: vulnhunter-fix/config.json
// Static configuration of the vulnhunter-fix skill (github, git, verification, behavior, models, modes).
// Read by SKILL.md / prompts at run time; several keys are documented but inert (see notes).

@executedBy(CODE) @role(config)
class VulnhunterFixConfig {

    Config run(Theta θ) {
        Config c = new Config();
        c.github = github(θ);
        c.git = git();
        c.verification = verification(θ);
        c.behavior = behavior(θ);
        c.models = models(θ);
        c.modes = modes(θ);
        c.collaboratorsFile = "collaborators.json";                                   // src: vulnhunter-fix/config.json:51
        return c;
    }

    GithubConfig github(Theta θ) {
        GithubConfig g = new GithubConfig();
        g.host = "github.com";                                                         // src: vulnhunter-fix/config.json:3
        g.sslVerify = true;                                                            // src: vulnhunter-fix/config.json:4
        g.defaultBaseBranch = "main";                                                  // src: vulnhunter-fix/config.json:5
        g.defaultTargetOrg = "your-org";                                               // src: vulnhunter-fix/config.json:6
        g.forkOrg = "your-fork-org";                                                   // src: vulnhunter-fix/config.json:7
        g.forkPrefix = "vulnhunter-fix";                                               // src: vulnhunter-fix/config.json:8
        g.prDraft = θ["fix.github.pr_draft"];                                          // src: vulnhunter-fix/config.json:9
        g.prLabels = List.of("security", "vulnhunter-fix");                            // src: vulnhunter-fix/config.json:10
        return g;
    }

    GitConfig git() {
        GitConfig g = new GitConfig();
        g.branchPrefix = "vulnfix";                                                    // src: vulnhunter-fix/config.json:13
        return g;
    }

    VerificationConfig verification(Theta θ) {
        VerificationConfig v = new VerificationConfig();
        v.maxRetries = θ["fix.verification.max_retries"];                              // src: vulnhunter-fix/config.json:16
        // fork mode caps repair attempts; in-place mode is uncapped
        v.maxRepairAttempts = θ["fix.verification.max_repair_attempts"];               // src: vulnhunter-fix/config.json:17
        v.testTimeoutSeconds = θ["fix.verification.test_timeout_seconds"];             // src: vulnhunter-fix/config.json:18
        return v;
    }

    BehaviorConfig behavior(Theta θ) {
        BehaviorConfig b = new BehaviorConfig();
        b.autoForkOnNoAccess = true;                                                   // src: vulnhunter-fix/config.json:21
        b.forkVisibility = "private";                                                  // src: vulnhunter-fix/config.json:22
        b.deliverToForkOnly = true;                                                    // src: vulnhunter-fix/config.json:23
        b.fallbackToIssue = true;                                                      // src: vulnhunter-fix/config.json:24
        // unclear: SKILL.md documents the default as true; config.json says false
        b.confirmBeforePush = θ["fix.behavior.confirm_before_push"];                   // src: vulnhunter-fix/config.json:25
        b.workDir = "./work";                                                          // src: vulnhunter-fix/config.json:26
        return b;
    }

    ModelsConfig models(Theta θ) {
        ModelsConfig m = new ModelsConfig();
        m.override = null;                                                             // src: vulnhunter-fix/config.json:29
        m.defaultModel = θ["fix.models.default"];                                      // src: vulnhunter-fix/config.json:30
        // inert: no prompt or script reads the routing table; the skill insists on Opus
        m.routing = θ["fix.models.routing"];                                           // src: vulnhunter-fix/config.json:31
        return m;
    }

    String routeModel(Finding f, Theta θ) {
        // documented routing semantics of the (inert) table, for reference only
        Map routing = θ["fix.models.routing"];                                         // src: vulnhunter-fix/config.json:31
        if (f.severity == "Critical" || (f.cwe.startsWithAny(routing.opus.cwePrefixes) && f.severity.in("Critical", "High")) || f.multiFile) return "opus"; // src: vulnhunter-fix/config.json:32
        if (f.severity == "High" || f.cwe.startsWithAny(routing.sonnet.cwePrefixes)) return "sonnet"; // src: vulnhunter-fix/config.json:39
        if (f.severity.in("Low", "Medium")) return "haiku";                            // src: vulnhunter-fix/config.json:44
        return θ["fix.models.default"];                                                // src: vulnhunter-fix/config.json:30
    }

    ModesConfig modes(Theta θ) {
        ModesConfig m = new ModesConfig();
        // auto | in-place (one PR per cluster of issues) | fork (one PR per finding)
        m.defaultMode = θ["fix.modes.default"];                                        // src: vulnhunter-fix/config.json:53
        m.inPlace.publishRepoAliases = Map.of();                                       // src: vulnhunter-fix/config.json:56
        // deprecated key: in-place never closes source issues at delivery; PR "Closes #N" closes on merge
        m.inPlace.closeIssueOnDeliver = IGNORED;                                       // src: vulnhunter-fix/config.json:55
        return m;
    }
}
