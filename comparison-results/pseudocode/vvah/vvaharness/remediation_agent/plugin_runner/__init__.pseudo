        int limit = maxModelCallsOf(sr, θ);                                                         // src: vvaharness/remediation_agent/plugin_runner/__init__.py:125
        if (limit <= 0) return null;                                                                // src: vvaharness/remediation_agent/plugin_runner/__init__.py:126
