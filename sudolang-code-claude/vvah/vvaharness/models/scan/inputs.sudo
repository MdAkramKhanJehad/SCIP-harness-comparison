# vvaharness/models/scan/inputs.py

Externally injected contracts loaded once and threaded through every step: known CVEs, design-level controls, and the configuration-management database application profile.

Source: `vvaharness/models/scan/inputs.py` (lines 1-87)
Executor: code
Called from: `vvaharness/orchestrator/scan.py` (load_cves, load_controls, _load_app_profile); prompts in Stages 1, 2, 6 and 8

// src: vvaharness/models/scan/inputs.py:31-36
CVE {
  id: String                // for example CVE-2024-1234
  summary: String
  affected_files: String[] = []
  cvss: Number | null = null
  patched: Boolean = false
}

// src: vvaharness/models/scan/inputs.py:39-61
_CONTROL_KINDS = ["auth", "sandbox", "input-validation", "aslr", "cfi", "other"]
_CONTROL_KIND_ALIAS = {
  authn, authentication, authz, authorization, rbac, iam, sso => "auth";
  waf, validation, input_validation, sanitization, sanitisation, encoding => "input-validation";
  seccomp, container, isolation, chroot, jail => "sandbox"
}
Control {
  // a design-level mitigation the strategist and chain models use to downrank exploitability
  name: String
  kind: "auth" | "sandbox" | "input-validation" | "aslr" | "cfi" | "other"
  protects: String[] = []   // file globs or module names behind the control
  notes: String = ""
  // coercion (before validation): kind = _coerce_enum(kind, _CONTROL_KINDS, _CONTROL_KIND_ALIAS, default="other")
}

// src: vvaharness/models/scan/inputs.py:64-86
AppProfile {
  // shared by Stages 1, 2 and 6 so actor choice and CVSS scoring agree
  application_id: String
  name: String = ""
  externally_facing: Boolean = false
  pci_scoped: Boolean = false
  processes_pan: Boolean = false
  pii: Boolean = false
  source: String = ""       // "application" | "component->parent NNN" | ...
}

// src: vvaharness/models/scan/inputs.py:74-86 — text inserted into model prompts
fn AppProfile.to_prompt_block():executor=code {
  sens = ["PCI-scoped" if pci_scoped, "processes PAN" if processes_pan, "handles PII" if pii]
  return "CMDB APPLICATION PROFILE:
  - Application ID: $application_id
  - Name: ${ name || "(unnamed)" }
  - Externally facing: ${ if (externally_facing) "YES" else "NO" }
  - Data sensitivity: ${ join(sens, ", ") || "standard" }
  - Source: $source"
}
