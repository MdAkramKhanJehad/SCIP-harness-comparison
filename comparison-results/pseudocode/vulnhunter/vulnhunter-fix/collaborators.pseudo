// file: vulnhunter-fix/collaborators.json
// Fork-mode access whitelist: users added to the private fork created for delivery (deliver.md step 3).

@executedBy(CODE) @role(types)
record Collaborator(String username, String role) { }

@executedBy(CODE) @role(config) @stage("fix")
class Collaborators {

    List<Collaborator> collaborators(Theta θ) {
        // fork mode only; each entry is added to the private fork with its role
        if (!θ["p.skill_vulnhunter-fix.fork_private_collaborators"]) return List.of();
        return θ["code.collaborators.fork_collaborators"];                           // src: vulnhunter-fix/collaborators.json:2
    }
}
