// file: vvaharness/remediation_agent/target.py
// One finding queued for remediation: wraps a scan Finding with its run index and the interactive "done" flag.

@executedBy(CODE) @role(types) @stage("S10")
class Target {
    Finding finding;
    int index;
    boolean done = false;                                                                           // src: vvaharness/remediation_agent/target.py:33  (flipped by the interactive picker)

    String caseId() {
        // Stable identity across attempts: the minted case id, else derived from title + location.
        return finding.caseId != null ? finding.caseId : deriveCaseId(finding);                    // src: vvaharness/remediation_agent/target.py:38
    }

    String severity() {
        return finding.severity.value.upper();                                                      // src: vvaharness/remediation_agent/target.py:43
    }

    String title() {
        return finding.title;                                                                       // src: vvaharness/remediation_agent/target.py:48
    }

    String file() {
        return finding.file;                                                                        // src: vvaharness/remediation_agent/target.py:53
    }

    String label() {
        String loc = finding.file != null ? " (" + finding.file + ")" : "";                         // src: vvaharness/remediation_agent/target.py:58
        return "[" + severity() + "] " + finding.title + loc;                                       // src: vvaharness/remediation_agent/target.py:59
    }

    String slug() {
        String base = Regex.sub("[^a-z0-9]+", "-", finding.title.lower()).strip("-");               // src: vvaharness/remediation_agent/target.py:64
        base = base.substring(0, 60).rstrip("-");                                                   // src: vvaharness/remediation_agent/target.py:65  (60-char folder name cap; formatting only)
        if (base.isEmpty()) base = "finding";
        return String.format("%02d_%s", index, base);                                               // src: vvaharness/remediation_agent/target.py:66
    }

    String deriveCaseId(Finding f) {
        String seed = f.title + "|" + f.file + "|" + f.lineStart;                                   // src: vvaharness/remediation_agent/target.py:71
        String digest = Sha1.hex(seed).substring(0, 6);                                             // src: vvaharness/remediation_agent/target.py:72
        return digest + "-" + f.vulnClass.value + "-" + (f.file != null ? f.file : "unknown") + "-" + f.lineStart; // src: vvaharness/remediation_agent/target.py:73
    }
}
