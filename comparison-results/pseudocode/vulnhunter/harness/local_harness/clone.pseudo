// file: harness/local_harness/clone.py
// Clones benchmark repos at a pinned commit (fast depth-1 fetch, then full-clone fallback),
// and shallow-clones HEAD for ad-hoc batch scans.

@executedBy(CODE) @role(io) @stage("benchmark")
class LocalHarnessClone {

    Triple<String, String, String> parseSourceUrl(String sourceCodeUrl) {
        // format: https://github.com/<org>/<repo>/tree/<commit_hash>
        List<String> parts = sourceCodeUrl.rstrip("/").split("/");                   // src: harness/local_harness/clone.py:18
        return new Triple(parts.subList(0, 5).join("/"), parts[4], parts.last());    // src: harness/local_harness/clone.py:20
    }

    String targetDirName(String repoName, String commitHash) {
        return repoName + "_" + commitHash.substring(0, 8);                          // src: harness/local_harness/clone.py:28
    }

    boolean isAtCommit(String targetDir, String commitHash) {
        try {
            Process r = Shell.run("git rev-parse HEAD", targetDir, 10);              // src: harness/local_harness/clone.py:34
            return r.returncode == 0 && r.stdout.strip().startsWith(commitHash.substring(0, 8)); // src: harness/local_harness/clone.py:39 (8-char prefix match)
        } catch (TimeoutExpired | FileNotFoundError e) {
            return false;                                                            // src: harness/local_harness/clone.py:41
        }
    }

    Pair<String, String> cloneAtCommit(String repoUrl, String commitHash, String targetDir, Theta θ) {
        if (repoUrl.startsWith("-")) return new Pair(targetDir, "refusing repo URL that looks like a git option"); // src: harness/local_harness/clone.py:54
        if (commitHash.startsWith("-")) return new Pair(targetDir, "refusing commit hash that looks like a git option"); // src: harness/local_harness/clone.py:56
        if (!Regex.match(θ["code.local_harness.clone.commit_sha_regex"], commitHash)) return new Pair(targetDir, "commit must be a 7-40 char hex SHA"); // src: harness/local_harness/clone.py:58
        if (Fs.isdir(targetDir)) {                                                   // src: harness/local_harness/clone.py:61
            if (isAtCommit(targetDir, commitHash)) return new Pair(targetDir, null); // src: harness/local_harness/clone.py:62 (reuse)
            Fs.rmtree(targetDir);                                                    // src: harness/local_harness/clone.py:67 (wrong commit)
        }
        Fs.makedirs(LocalHarnessConfig.CLONE_BASE_DIR());                              // src: harness/local_harness/clone.py:69
        int timeout = θ["code.local_harness.clone.clone_timeout_seconds"];           // src: harness/local_harness/clone.py:86
        // fast path: init + remote add + fetch --depth=1 -- origin <hash> + checkout FETCH_HEAD
        try {
            Fs.makedirs(targetDir);                                                  // src: harness/local_harness/clone.py:74
            Process init = Shell.run("git init", targetDir, 10);                     // src: harness/local_harness/clone.py:75
            Process remote = Shell.run("git remote add origin " + repoUrl, targetDir, 10); // src: harness/local_harness/clone.py:79
            if (init.returncode == 0 && remote.returncode == 0) {                    // src: harness/local_harness/clone.py:83
                Process fetch = Shell.run("git fetch --depth=1 -- origin " + commitHash, targetDir, timeout); // src: harness/local_harness/clone.py:85
                if (fetch.returncode == 0) {                                         // src: harness/local_harness/clone.py:88
                    Process co = Shell.run("git checkout FETCH_HEAD", targetDir, 30); // src: harness/local_harness/clone.py:89
                    if (co.returncode == 0) return new Pair(targetDir, null);        // src: harness/local_harness/clone.py:93
                }
            }
        } catch (TimeoutExpired | OSError e) {
            // fall through to full clone                                            // src: harness/local_harness/clone.py:96
        }
        if (Fs.isdir(targetDir)) Fs.rmtree(targetDir);                               // src: harness/local_harness/clone.py:100
        try {
            Process clone = Shell.run("git clone -- " + repoUrl + " " + targetDir, null, timeout); // src: harness/local_harness/clone.py:105
            if (clone.returncode != 0) return new Pair(targetDir, clone.stderr.strip() ?: "git clone exited"); // src: harness/local_harness/clone.py:109
            Process co = Shell.run("git checkout " + commitHash + " --", targetDir, 30); // src: harness/local_harness/clone.py:113
            if (co.returncode != 0) return new Pair(targetDir, co.stderr.strip() ?: "git checkout exited"); // src: harness/local_harness/clone.py:117
            return new Pair(targetDir, null);                                        // src: harness/local_harness/clone.py:122
        } catch (TimeoutExpired e) {
            return new Pair(targetDir, "clone timed out");                           // src: harness/local_harness/clone.py:125
        } catch (OSError e) {
            return new Pair(targetDir, "git unavailable");                           // src: harness/local_harness/clone.py:127
        }
    }

    Pair<String, String> shallowClone(String url, String targetDir, boolean reClone, Theta θ) {
        if (Fs.isdir(targetDir)) {                                                   // src: harness/local_harness/clone.py:135
            if (!reClone) return new Pair(targetDir, null);                          // src: harness/local_harness/clone.py:136 (reuse whatever is there)
            Fs.rmtree(targetDir);                                                    // src: harness/local_harness/clone.py:140
        }
        Fs.makedirs(Fs.dirname(targetDir));                                          // src: harness/local_harness/clone.py:142
        Process r;
        try {
            r = Shell.run("git clone --depth 1 " + url + " " + targetDir, null, θ["code.local_harness.clone.shallow_clone_timeout_seconds"]); // src: harness/local_harness/clone.py:146
        } catch (TimeoutExpired e) {
            return new Pair(targetDir, "clone timed out after 120s");                // src: harness/local_harness/clone.py:151
        } catch (OSError e) {
            return new Pair(targetDir, "git unavailable");                           // src: harness/local_harness/clone.py:153
        }
        if (r.returncode != 0) return new Pair(targetDir, r.stderr.strip() ?: "git clone exited"); // src: harness/local_harness/clone.py:155
        return new Pair(targetDir, null);                                            // src: harness/local_harness/clone.py:159
    }
}
