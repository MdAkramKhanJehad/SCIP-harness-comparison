// file: vulnhunter-agent/agent/auth.py
// Anthropic auth providers behind one getValidToken() interface: API key (verbatim), Bedrock OAuth2
// client-credentials (cached, refreshed after a fraction of its lifetime), Bedrock SigV4 (empty token).

@executedBy(CODE) @role(types) @stage("infra")
interface TokenProvider {
    String getValidToken();                                                                         // src: vulnhunter-agent/agent/auth.py:46
}

@executedBy(CODE) @role(types) @stage("infra")
record AuthTokenError(String message) { }

@executedBy(CODE) @role(backend) @stage("infra")
class Auth {

    // make_token_manager: pick the provider for anthropic.auth_mode (anything else -> API key).
    TokenProvider makeTokenManager(Theta θ, String name) {
        if (θ["anthropic.auth_mode"] == "bedrock_oauth") return oauthTokenManager(θ["oauth.*"], θ["tls.ssl_cert_path"], name); // src: vulnhunter-agent/agent/auth.py:160
        if (θ["anthropic.auth_mode"] == "bedrock_sigv4") return sigV4TokenManager(name);            // src: vulnhunter-agent/agent/auth.py:162
        return apiKeyTokenManager(θ["anthropic.api_key"], name);                                    // src: vulnhunter-agent/agent/auth.py:164
    }

    TokenProvider oauthTokenManager(OAuthConfig oauth, String sslCertPath, String name) {
        return new OAuthTokenManager(oauth, sslCertPath, name);                                     // src: vulnhunter-agent/agent/auth.py:161
    }

    TokenProvider sigV4TokenManager(String name) {
        return new SigV4TokenManager(name);                                                         // src: vulnhunter-agent/agent/auth.py:163
    }

    TokenProvider apiKeyTokenManager(String apiKey, String name) {
        return new ApiKeyTokenManager(apiKey, name);                                                // src: vulnhunter-agent/agent/auth.py:164
    }

    // resolve_verify: TLS trust = tls.ssl_cert_path if set, else system trust.
    Object resolveVerify(Theta θ) {
        if (θ["tls.ssl_cert_path"] != "") return θ["tls.ssl_cert_path"];                           // src: vulnhunter-agent/agent/auth.py:55
        return true;                                                                                // src: vulnhunter-agent/agent/auth.py:58
    }
}

@executedBy(CODE) @role(backend) @stage("infra")
class ApiKeyTokenManager {
    String getValidToken(Theta θ) {
        return θ["anthropic.api_key"];                                                              // no network, no expiry // src: vulnhunter-agent/agent/auth.py:74
    }
}

@executedBy(CODE) @role(backend) @stage("infra")
class SigV4TokenManager {
    String getValidToken() {
        return "";                                                                                  // CLI signs with the AWS credential chain // src: vulnhunter-agent/agent/auth.py:93
    }
}

@executedBy(CODE) @role(backend) @stage("infra")
class OAuthTokenManager {
    String accessToken = null;
    double tokenExpiry = null;

    String getValidToken(Theta θ) {
        if (accessToken == null || tokenExpiry == null || time() >= tokenExpiry) return refresh(θ); // src: vulnhunter-agent/agent/auth.py:106
        return accessToken;                                                                         // src: vulnhunter-agent/agent/auth.py:113
    }

    String refresh(Theta θ) {
        Response response;
        try {
            response = Http.post(θ["oauth.*"].tokenEndpoint, Map.of("grant_type", "client_credentials", "client_id", θ["oauth.*"].clientId, "client_secret", θ["oauth.*"].clientSecret), Auth.resolveVerify(θ), θ["oauth.*"].httpTimeoutSeconds); // src: vulnhunter-agent/agent/auth.py:118
        } catch (TimeoutException exc) {
            throw new AuthTokenError("Token request timed out");                                    // src: vulnhunter-agent/agent/auth.py:129
        } catch (RequestError exc) {
            throw new AuthTokenError("Token request connection error");                             // src: vulnhunter-agent/agent/auth.py:131
        }
        if (response.statusCode != 200) throw new AuthTokenError("Token request failed");           // src: vulnhunter-agent/agent/auth.py:133
        Map body = response.json();
        if (!body.containsKey("access_token")) throw new AuthTokenError("No access_token in response"); // src: vulnhunter-agent/agent/auth.py:139
        int lifetime = body.getOrDefault("expires_in", θ["oauth.*"].defaultLifetimeSeconds);       // src: vulnhunter-agent/agent/auth.py:144
        accessToken = body.access_token;                                                            // src: vulnhunter-agent/agent/auth.py:145
        tokenExpiry = time() + lifetime * θ["oauth.*"].expirySafetyFactor;                          // refresh early // src: vulnhunter-agent/agent/auth.py:146
        return accessToken;
    }
}
