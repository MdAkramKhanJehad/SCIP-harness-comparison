// file: vvaharness/validation/scoring/_engine.py
// Deterministic scoring: fail closed before scoring; skipped gates leave the denominator.
// Conversion to GateStatus can raise. Parsing is not itself a catch-all validation boundary.

@executedBy(CODE) @role(step) @stage("S11")
class ValidationScoringEngine {
    @src("vvaharness/validation/scoring/_engine.py:38")
    String strFrom(Map entry, String key, String fallback = "") {
        Object value = entry.getOrDefault(key, fallback); return value instanceof String ? value : fallback;
    }
    @src("vvaharness/validation/scoring/_engine.py:44")
    Integer intOrNone(Object value) {
        if (value instanceof Boolean) return null;
        return value instanceof Integer ? value : null;
    }
    @src("vvaharness/validation/scoring/_engine.py:51")
    EvidenceAnchor parseEvidence(Map entry) {
        return new EvidenceAnchor(strFrom(entry, "file"), intOrNone(entry.get("line")), strFrom(entry, "snippet"));
    }
    @src("vvaharness/validation/scoring/_engine.py:60")
    RawCriterion parseRawCriterion(Map entry, String nameField) {
        Object raw = entry.getOrDefault("evidence", List.of());
        List<EvidenceAnchor> evidence = raw instanceof List ? raw.filter(e -> e instanceof Map).map(e -> parseEvidence(e)) : List.of();
        return new RawCriterion(strFrom(entry, nameField), gateStatus(strFrom(entry, "status")).value, strFrom(entry, "confidence"), strFrom(entry, "summary"), strFrom(entry, "details"), evidence);
    }
    @src("vvaharness/validation/scoring/_engine.py:81")
    ScoreResult inconclusive(String reason) {
        return new ScoreResult(0.0, Decision.INCONCLUSIVE, "INCONCLUSIVE: " + reason);
    }
    @src("vvaharness/validation/scoring/_engine.py:90")
    ScoreResult shapeError(ScoringConfig config, List<RawCriterion> criteria) {
        List names = criteria.map(c -> c.name); Set provided = Set.copyOf(names);
        if (provided != config.expectedCriteria) return inconclusive("criterion set differs: missing " + sorted(config.expectedCriteria.minus(provided)));
        if (names.size() != provided.size()) return inconclusive("duplicate criterion evaluations");
        return null;
    }
    @src("vvaharness/validation/scoring/_engine.py:103")
    Object renormalizedScore(ScoringConfig config, List<RawCriterion> criteria, Theta θ) {
        double earned = 0.0; double activeWeight = 0.0;
        for (RawCriterion c : criteria) {
            if (c.status == "skip") continue;
            activeWeight += config.weights.get(c.name);
            earned += config.weights.get(c.name) * config.statusMultiplier.getOrDefault(c.status, θ["code.validation.constants.scoring.score_floor"]); // src: vvaharness/validation/constants/scoring.py:62
        }
        if (activeWeight <= 0.0) return inconclusive("no gates evaluated");
        return round(min(earned / activeWeight, 1.0), θ["code.validation.constants.scoring.score_precision"]); // src: vvaharness/validation/constants/scoring.py:67
    }
    @src("vvaharness/validation/scoring/_engine.py:127")
    ScoreResult criticalGateError(ScoringConfig config, List<RawCriterion> criteria, Theta θ) {
        for (RawCriterion c : criteria) if (config.criticalCriteria.contains(c.name) && θ["code.validation.scoring.engine.unevaluated"].contains(c.status)) return inconclusive("critical gate unevaluated: " + c.name); // src: vvaharness/validation/scoring/_engine.py:122
        return null;
    }
    @src("vvaharness/validation/scoring/_engine.py:140")
    ScoreResult consensusError(List<RawCriterion> criteria) {
        List flagged = sorted(criteria.filter(c -> c.confidence == "FLAGGED").map(c -> c.name));
        return flagged.isEmpty() ? null : inconclusive("insufficient persona consensus: " + flagged);
    }
    @src("vvaharness/validation/scoring/_engine.py:154")
    Decision capCriticalFail(ScoringConfig config, List<RawCriterion> criteria, Decision decision, Theta θ) {
        if (config.verdicts.isEmpty() || decision != config.verdicts.get(0).decision) return decision;
        boolean dirty = criteria.anyMatch(c -> config.criticalCriteria.contains(c.name) && θ["code.validation.scoring.engine.critical_not_clean"].contains(c.status)); // src: vvaharness/validation/scoring/_engine.py:124
        return dirty && config.verdicts.size() > 1 ? config.verdicts.get(1).decision : decision;
    }
    @src("vvaharness/validation/scoring/_engine.py:167")
    ScoreResult precheck(ScoringConfig config, List<RawCriterion> criteria, Theta θ) {
        ScoreResult result = shapeError(config, criteria); if (result != null) return result;
        result = consensusError(criteria); return result != null ? result : criticalGateError(config, criteria, θ);
    }
    @src("vvaharness/validation/scoring/_engine.py:176")
    Decision applyVerdicts(ScoringConfig config, double score) {
        for (Object rule : config.verdicts) if (score >= rule.minScore) return rule.decision;
        return Decision.INCONCLUSIVE;
    }
    @src("vvaharness/validation/scoring/_engine.py:184")
    ScoreResult score(ScoringConfig config, List<RawCriterion> criteria, Map extra, Theta θ) {
        ScoreResult error = precheck(config, criteria, θ); if (error != null) return error;
        Object raw = renormalizedScore(config, criteria, θ); if (raw instanceof ScoreResult) return raw;
        Decision d = capCriticalFail(config, criteria, applyVerdicts(config, raw), θ);
        ScoreResult partial = new ScoreResult(raw, d, "");
        return new ScoreResult(raw, d, config.justify(partial, criteria, truthyOr(extra, Map.of())));
    }
}
