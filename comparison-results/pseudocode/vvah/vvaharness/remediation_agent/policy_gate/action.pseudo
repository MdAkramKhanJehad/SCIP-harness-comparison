// file: vvaharness/remediation_agent/policy_gate/action.py
// The gate decision value types: the binary Action and the immutable Decision, plus the fail-closed default decision.

@executedBy(CODE) @role(types) @stage("S10")
enum GateAction { PATCH, GUIDANCE_ONLY }                                                            // src: vvaharness/remediation_agent/policy_gate/action.py:22  (real name Action; binary by design, no auto or suggest autonomy mode)

// Real name Decision (frozen dataclass); named PolicyDecision here because another file already owns the name Decision.
@executedBy(CODE) @role(types) @stage("S10")
record PolicyDecision(GateAction action, String reason, String matchedRule) { }                    // src: vvaharness/remediation_agent/policy_gate/action.py:29  (matched_rule defaults to null)

@executedBy(CODE) @role(rule_set) @stage("S10")
class Action {

    boolean mayGeneratePatch(PolicyDecision d) {
        // The caller must not invoke the patch agent unless this is true.
        return d.action == PATCH;                                                                   // src: vvaharness/remediation_agent/policy_gate/action.py:36
    }

    PolicyDecision failClosed() {
        // Module constant _FAIL_CLOSED, returned whenever the policy failed to load.
        return new PolicyDecision(GUIDANCE_ONLY, "policy_unavailable_fail_closed", null);          // src: vvaharness/remediation_agent/policy_gate/action.py:39
    }
}
