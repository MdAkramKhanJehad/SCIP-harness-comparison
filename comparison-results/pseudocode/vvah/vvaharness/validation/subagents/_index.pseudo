// file: vvaharness/validation/subagents/_loader.py, vvaharness/validation/constants/paths.py
// Loads the three isolated validation personas from their bundled .md files (frontmatter + body prompt),
// applies the tool override, prompt suffix and per-persona model-call cap.

@executedBy(CODE) @role(agent) @stage("S11")
class SubagentsIndex {

    List<Subagent> loadAgents(List<String> toolsOverride, Object promptSuffix, int maxModelCalls, Theta θ) {
        List<String> wanted = θ["prompt.s11.personas"];                                             // src: vvaharness/validation/constants/paths.py:36
        List<Subagent> result = new List();
        for (Path md : Bundled.subagentMarkdownFiles()) {                                           // src: vvaharness/validation/subagents/_loader.py:93
            Subagent s = buildDefinition(Frontmatter.parse(md));                                    // src: vvaharness/validation/subagents/_loader.py:95
            if (!wanted.contains(s.name)) continue;                                                 // src: vvaharness/validation/subagents/_loader.py:97
            if (toolsOverride != null) {                                                            // src: vvaharness/validation/subagents/_loader.py:101
                // Narrow to the override, but never drop fact tools; the override cannot add a tool.
                s.tools = s.tools.filter(t -> toolsOverride.contains(t) || FACT_TOOLS.contains(t)); // src: vvaharness/validation/subagents/_loader.py:103
            }
            if (promptSuffix != null) s.prompt = s.prompt.plus(promptSuffix);                       // src: vvaharness/validation/subagents/_loader.py:109
            s.maxModelCalls = maxModelCalls > 0 ? maxModelCalls : null;                             // src: vvaharness/validation/subagents/_loader.py:114  (0 = unmetered)
            result.add(s);
        }
        if (result.size() < wanted.size()) throw new ValueError("requested subagents not found");   // src: vvaharness/validation/subagents/_loader.py:120
        return result;
    }

    Subagent buildDefinition(Frontmatter fm) {
        // name, description, model, allowedTools, deniedTools, skills; output schema PersonaReport.
        return new Subagent(fm.name, fm.description, fm.body, fm.allowedTools, fm.deniedTools, fm.model, fm.skills, "PersonaReport"); // src: vvaharness/validation/subagents/_loader.py:48
    }
}
