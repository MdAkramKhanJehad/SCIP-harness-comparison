// file: vulnhunter-fix/prompts/worker_agent_crypto.md
// CWE-class worker prompt for crypto findings (CWE-295/326/327/328/330/345/347); extends the common preamble with
// the canonical fix pattern, a mechanical four-boolean trust-chain gate for FULL, anti-patterns and never-do rules.

@executedBy(MODEL) @role(prompt) @stage("fix.implement.worker")
class WorkerAgentCrypto {

    WorkerResult run(Manifest manifest, Theta θ) {
        // extends worker_agent_common.md (read that file first)
        return WorkerAgentCommon.run(manifest, prompt(θ), θ);                                       // src: vulnhunter-fix/prompts/worker_agent_crypto.md:3
    }

    Prompt prompt(Theta θ) {
        Prompt p = new Prompt();
        p.include(canonicalFix(θ));
        p.include(trustChainGate(θ));
        p.include(discrimination(θ));
        p.include(antiPatterns(θ));
        p.include(neverDo(θ));
        p.format(θ["p.worker_agent_crypto.residual_prefix"]);                                       // src: vulnhunter-fix/prompts/worker_agent_crypto.md:69
        return p;
    }

    Prompt canonicalFix(Theta θ) {
        Prompt p = new Prompt();
        p.step(1, θ["p.worker_agent_crypto.fix_approved_algorithm"]);                               // src: vulnhunter-fix/prompts/worker_agent_crypto.md:7
        p.step(2, θ["p.worker_agent_crypto.fix_approved_key_source"]);                              // src: vulnhunter-fix/prompts/worker_agent_crypto.md:9
        p.step(3, θ["p.worker_agent_crypto.fix_rotation_same_commit"]);                             // src: vulnhunter-fix/prompts/worker_agent_crypto.md:11
        p.step(4, θ["p.worker_agent_crypto.fix_enforce_tls"]);                                      // src: vulnhunter-fix/prompts/worker_agent_crypto.md:12
        return p;
    }

    Prompt trustChainGate(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.worker_agent_crypto.full_iff_four_booleans"]);                                  // src: vulnhunter-fix/prompts/worker_agent_crypto.md:18
        p.forbid(θ["p.worker_agent_crypto.no_self_compute_trust_chain"]);                           // src: vulnhunter-fix/prompts/worker_agent_crypto.md:27
        p.must(θ["p.worker_agent_crypto.false_or_missing_mitigation"]);                             // src: vulnhunter-fix/prompts/worker_agent_crypto.md:30
        p.format(θ["p.worker_agent_crypto.trust_chain_residual_strings"]);                          // src: vulnhunter-fix/prompts/worker_agent_crypto.md:34
        p.rule(θ["p.worker_agent_crypto.one_residual_per_false"]);                                  // src: vulnhunter-fix/prompts/worker_agent_crypto.md:39
        return p;
    }

    Prompt discrimination(Theta θ) {
        Prompt p = new Prompt();
        p.must(θ["p.worker_agent_crypto.discrimination_forgery"]);                                  // src: vulnhunter-fix/prompts/worker_agent_crypto.md:43
        return p;
    }

    Prompt antiPatterns(Theta θ) {
        Prompt p = new Prompt();
        p.rule(θ["p.worker_agent_crypto.anti_key_size_only"]);                                      // src: vulnhunter-fix/prompts/worker_agent_crypto.md:50
        p.rule(θ["p.worker_agent_crypto.anti_optional_verification"]);                              // src: vulnhunter-fix/prompts/worker_agent_crypto.md:52
        p.rule(θ["p.worker_agent_crypto.anti_env_var_keys"]);                                       // src: vulnhunter-fix/prompts/worker_agent_crypto.md:54
        p.rule(θ["p.worker_agent_crypto.anti_filesystem_keys"]);                                    // src: vulnhunter-fix/prompts/worker_agent_crypto.md:56
        return p;
    }

    Prompt neverDo(Theta θ) {
        Prompt p = new Prompt();
        p.forbid(θ["p.worker_agent_crypto.never_mutate_trust_chain"]);                              // src: vulnhunter-fix/prompts/worker_agent_crypto.md:61
        p.forbid(θ["p.worker_agent_crypto.never_custom_crypto"]);                                   // src: vulnhunter-fix/prompts/worker_agent_crypto.md:64
        return p;
    }

    void applyCanonicalFix(Finding f, Theta θ) {
        replaceAlgorithm(f, approvedFrom(θ["p.worker_agent_crypto.fix_approved_algorithm"]));       // src: vulnhunter-fix/prompts/worker_agent_crypto.md:7
        sourceKeysFrom(f, θ["p.worker_agent_crypto.fix_approved_key_source"]);                      // src: vulnhunter-fix/prompts/worker_agent_crypto.md:9
        if (θ["p.worker_agent_crypto.fix_rotation_same_commit"]) addRotationMechanism(f);           // src: vulnhunter-fix/prompts/worker_agent_crypto.md:11
        if (θ["p.worker_agent_crypto.fix_enforce_tls"]) enforceTlsAtTransportBoundary(f);           // src: vulnhunter-fix/prompts/worker_agent_crypto.md:12
        // only cryptography / nacl / stdlib; never hand-rolled AES or hash chains
        useOnlyLibraries(θ["p.worker_agent_crypto.never_custom_crypto"]);                           // src: vulnhunter-fix/prompts/worker_agent_crypto.md:64
    }

    Discrimination discriminate(Finding f, Theta θ) {
        Discrimination d = new Discrimination();
        if (θ["p.worker_agent_crypto.discrimination_forgery"]) {                                    // src: vulnhunter-fix/prompts/worker_agent_crypto.md:43
            d.preFix = forgeReplayOrBruteForceSucceeds(f) ? "fail" : "pass";
            d.postFix = forgeReplayOrBruteForceSucceeds(f) ? "fail" : "pass";                       // src: vulnhunter-fix/prompts/worker_agent_crypto.md:45
        }
        return d;
    }

    String tierAndResiduals(Finding f, Diff diff, WorkerResult r, Theta θ) {
        // read the four booleans from the plan / triage sidecar; never compute them
        Map chain = θ["p.worker_agent_crypto.no_self_compute_trust_chain"] ? read(".work/<repo>/graph_context/<vuln>.json").cryptoTrustChain : null; // src: vulnhunter-fix/prompts/worker_agent_crypto.md:27
        if (chain.looksWrong()) return θ["p.worker_agent_crypto.never_mutate_trust_chain"];         // src: vulnhunter-fix/prompts/worker_agent_crypto.md:61
        List<String> keys = θ["p.worker_agent_crypto.full_iff_four_booleans"];                      // src: vulnhunter-fix/prompts/worker_agent_crypto.md:18
        List<String> msgs = θ["p.worker_agent_crypto.trust_chain_residual_strings"];                // src: vulnhunter-fix/prompts/worker_agent_crypto.md:34
        String t = "FULL";
        for (int i = 0; i < keys.size(); i++) {
            if (chain.get(keys.get(i)) != true) {
                t = θ["p.worker_agent_crypto.false_or_missing_mitigation"];                         // src: vulnhunter-fix/prompts/worker_agent_crypto.md:30
                if (θ["p.worker_agent_crypto.one_residual_per_false"]) r.residualVectors.add(θ["p.worker_agent_crypto.residual_prefix"] + msgs.get(i)); // src: vulnhunter-fix/prompts/worker_agent_crypto.md:39
            }
        }
        if (diff.keySizeBumpOnly()) t = θ["p.worker_agent_crypto.anti_key_size_only"];              // src: vulnhunter-fix/prompts/worker_agent_crypto.md:50
        if (diff.verificationOptionalBranchLive()) t = θ["p.worker_agent_crypto.anti_optional_verification"]; // src: vulnhunter-fix/prompts/worker_agent_crypto.md:52
        if (diff.keysFromUnannotatedEnvVars()) t = θ["p.worker_agent_crypto.anti_env_var_keys"];    // src: vulnhunter-fix/prompts/worker_agent_crypto.md:54
        if (diff.keysOnFilesystem()) t = θ["p.worker_agent_crypto.anti_filesystem_keys"];           // src: vulnhunter-fix/prompts/worker_agent_crypto.md:56
        return t;
    }
}
