// file: vulnhunter-agent/verify_disposition.schema.json
// Per-vulnerability verdict file written by /vulnhunt-fix-verify at <out>/verify_disposition.json.
// Four gates per finding, a comments-file evaluation block, closed objects throughout.

@executedBy(CODE) @role(types)
enum FixVerdict { FIXED, NOT_FIXED, PARTIAL, INCONCLUSIVE, INVALID_INPUT }

@executedBy(CODE) @role(types)
enum GateStatus { PASS, FAIL, SKIPPED, NA }

@executedBy(CODE) @role(types)
enum ClaimStatus { ACCEPTED, REJECTED_UNVERIFIABLE, REJECTED_FALSE }

@executedBy(CODE) @role(types)
enum EvidenceKind { SINK_INSPECTION, DATA_FLOW_TRACE, SWEEP_GREP, RULE_CHECK }

@executedBy(CODE) @role(types)
record TargetRepo(String path, String head_commit, String head_ref, List<String> additional_repos) { }

@executedBy(CODE) @role(types)
record VerifySchemaGates(GateStatus sink_mitigated, GateStatus reachability, GateStatus class_eliminated, GateStatus sweep_complete) { }

@executedBy(CODE) @role(types)
record VerifySchemaEvidence(EvidenceKind kind, String location, String detail) { }

@executedBy(CODE) @role(types)
record Disposition(String finding_id, FixVerdict verdict, String rationale, String issue_comment, VerifySchemaGates gates,
                   List<VerifySchemaEvidence> evidence, List<String> regressions) { }

@executedBy(CODE) @role(types)
record VerifySchemaClaim(String excerpt, ClaimStatus status, String rationale, String cited_location) { }

@executedBy(CODE) @role(types)
record CommentsEvaluation(boolean provided, List<VerifySchemaClaim> claims) { }

@executedBy(CODE) @role(types)
record VerifyDisposition(String schema_version, String scan_id, TargetRepo target_repo, String verified_at,
                         CommentsEvaluation comments_evaluation, List<Disposition> dispositions) { }

@executedBy(MIXED) @role(rule_set) @stage("verify")
class VerifyDispositionSchema {

    boolean validate(VerifyDisposition d, Theta θ) {
        if (d.schema_version != θ["p.phase4_emit.schema_version_value"]) return false; // src: vulnhunter-agent/verify_disposition.schema.json:19 (const "1", consumers fail closed)
        if (!Regex.match("^.+_VULNHUNT_RESULTS_.+$", d.scan_id)) return false;        // src: vulnhunter-agent/verify_disposition.schema.json:24
        if (!validTargetRepo(d.target_repo, θ)) return false;                         // src: vulnhunter-agent/verify_disposition.schema.json:30
        if (!isIsoDateTime(d.verified_at)) return false;                             // src: vulnhunter-agent/verify_disposition.schema.json:58
        if (!validComments(d.comments_evaluation, θ)) return false;                  // src: vulnhunter-agent/verify_disposition.schema.json:60 (always present)
        if (d.dispositions.size() < θ["code.verify_disposition_schema.dispositions_min_items"]) return false; // src: vulnhunter-agent/verify_disposition.schema.json:64
        for (Disposition x : d.dispositions) if (!validDisposition(x, θ)) return false; // src: vulnhunter-agent/verify_disposition.schema.json:65
        return true;
    }

    boolean validTargetRepo(TargetRepo t, Theta θ) {
        // keys exactly: θ["p.phase4_emit.target_repo_keys"]
        if (t.head_commit != "" && !Regex.match(θ["p.phase4_emit.head_commit_format"], t.head_commit)) return false; // src: vulnhunter-agent/verify_disposition.schema.json:40 (^[0-9a-f] 7-40 $ or empty)
        return true;                                                                 // additional_repos + path = trusted roots (audit)
    }

    boolean validDisposition(Disposition x, Theta θ) {
        if (!Regex.match("^VULN-\\d<3>$", x.finding_id)) return false;               // src: vulnhunter-agent/verify_disposition.schema.json:72
        if (!θ["p.phase4_emit.final_verdict_set"].contains(x.verdict)) return false;  // src: vulnhunter-agent/verify_disposition.schema.json:76
        if (θ["p.phase4_emit.issue_comment_non_empty"] && x.issue_comment.length() < 1) return false; // src: vulnhunter-agent/verify_disposition.schema.json:113
        // gates: exactly four keys (exploit_test_replay deferred) — θ["p.phase4_emit.gates_exact_keys"]
        for (GateStatus g : List.of(x.gates.sink_mitigated, x.gates.reachability, x.gates.class_eliminated, x.gates.sweep_complete)) {
            if (!θ["p.phase2_verify.gate_outcome_values"].contains(g)) return false;  // src: vulnhunter-agent/verify_disposition.schema.json:80
        }
        for (VerifySchemaEvidence e : x.evidence) {                                              // src: vulnhunter-agent/verify_disposition.schema.json:132 (empty allowed, intended for INVALID_INPUT)
            if (!θ["p.phase2_verify.evidence_kinds"].contains(e.kind)) return false;  // src: vulnhunter-agent/verify_disposition.schema.json:92
        }
        return true;                                                                 // regressions optional; populated when sweep_complete=fail
    }

    boolean validComments(CommentsEvaluation c, Theta θ) {
        for (VerifySchemaClaim cl : c.claims) {                                                  // src: vulnhunter-agent/verify_disposition.schema.json:169
            if (!θ["p.phase4_emit.claim_status_set"].contains(cl.status)) return false; // src: vulnhunter-agent/verify_disposition.schema.json:84
        }
        return true;                                                                 // claims empty when provided=false
    }
}
