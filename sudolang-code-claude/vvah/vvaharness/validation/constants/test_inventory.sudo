// src: vvaharness/validation/constants/test_inventory.py:19-25
TestFileNames {
  PY_TEST_EXACT_NAMES = { "conftest.py", "tests.py", "test.py" }
  PY_TEST_NAME_PREFIX = "test_"
  PY_TEST_NAME_SUFFIX = "_test.py"
  JS_TEST_SUFFIXES = [".test.js", ".test.jsx", ".test.ts", ".test.tsx", ".spec.js", ".spec.jsx", ".spec.ts", ".spec.tsx"]
}

// src: vvaharness/validation/constants/test_inventory.py:27-32
// Matched case-insensitively on word boundaries, so "mock" does not match inside "MagicMock".
NEGATIVE_TEST_MARKERS = [
  "pytest.raises", "assertRaises", "with raises", "expect_exception",
  "toThrow", "rejects", "should fail", "assert.throws",
  "malformed", "invalid", "fake", "mock", "exploit", "payload"
]
