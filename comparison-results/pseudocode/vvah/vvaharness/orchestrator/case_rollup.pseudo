// file: vvaharness/orchestrator/case_rollup.py
// Remediation/validation rollup for the run manifest: counts of case states and decisions only
// (cases live in the untrusted target, so no titles, paths or ids reach run_manifest).

@executedBy(CODE) @role(step) @stage("S11")
class CaseRollup {

    Map TOTALS = new Map();                                   // cumulative across repos in one invocation // src: vvaharness/orchestrator/case_rollup.py:56

    /** EXIT_NOT_REMEDIATED when the verdicts validated nothing and failed something; else 0. */
    int rcForVerdicts(List<Verdict> verdicts, Theta θ) {
        List<CaseState> states = verdicts.filter(v -> v != null).map(v -> Derive.verdictState(v));     // src: vvaharness/orchestrator/case_rollup.py:62
        if (states.contains(CaseState.VALIDATED) || !states.contains(CaseState.FAILED)) return 0;      // narrow AND-gate // src: vvaharness/orchestrator/case_rollup.py:63
        return θ["code.orchestrator.case_rollup.exit_not_remediated"];                                 // src: vvaharness/orchestrator/case_rollup.py:65
    }

    boolean inside(Path path, Path root) {
        try { return path.realPath().isRelativeTo(root.realPath()); }                                  // src: vvaharness/orchestrator/case_rollup.py:71
        catch (OSError e) { return false; }                                                            // src: vvaharness/orchestrator/case_rollup.py:73
    }

    Map shaped(int cases, Map states, Map decisions) {
        return Map.of("cases", cases, "states", states.sortedByKey(), "decisions", decisions.sortedByKey()); // src: vvaharness/orchestrator/case_rollup.py:78
    }

    /** Tally the case records under <repo>/security-remediation/ (on-disk cases; not used for exit codes). */
    Map rollupFor(Path repo, Theta θ) {
        int cases = 0; Map<String, Integer> states = new Map(); Map<String, Integer> decisions = new Map();
        Path caseRoot;
        try { caseRoot = Artifacts.artifactDir(repo, Artifacts.CASE_DIR_NAME); }                       // src: vvaharness/orchestrator/case_rollup.py:92
        catch (UnsafeArtifactDir e) { Log.warning("CASE_ROOT_UNSAFE"); return Map.of(); }              // warn and skip, never raise // src: vvaharness/orchestrator/case_rollup.py:95
        if (!caseRoot.isDir()) return Map.of();                                                        // src: vvaharness/orchestrator/case_rollup.py:97
        for (Path path : caseRoot.glob("*/" + Artifacts.CASE_FILE_NAME)) {                             // src: vvaharness/orchestrator/case_rollup.py:100
            String state; String decision;
            try {
                if (!path.isFile()) continue;                                                          // device node / FIFO skipped // src: vvaharness/orchestrator/case_rollup.py:103
                if (!inside(path, caseRoot)) { Log.warning("CASE_PATH_OUTSIDE_ROOT"); continue; }     // src: vvaharness/orchestrator/case_rollup.py:105
                long size = path.size();                                                               // src: vvaharness/orchestrator/case_rollup.py:108
                if (size > θ["code.orchestrator.case_rollup.max_case_bytes"]) throw new ValueError("exceeds case limit"); // src: vvaharness/orchestrator/case_rollup.py:109
                FindingCase c = FindingCase.read(path);                                                // src: vvaharness/orchestrator/case_rollup.py:112
                state = Derive.stateOf(c.attempts).value;                                              // src: vvaharness/orchestrator/case_rollup.py:113
                Verdict v = c.attempts.isEmpty() ? null : c.attempts.last().verdict;                   // src: vvaharness/orchestrator/case_rollup.py:115
                decision = v != null ? v.decision.value : null;                                        // src: vvaharness/orchestrator/case_rollup.py:116
            } catch (Exception e) {
                Log.warning("CASE_RECORD_UNREADABLE");                                                 // no case file may fail the tally // src: vvaharness/orchestrator/case_rollup.py:119
                continue;
            }
            cases += 1;                                                                                // src: vvaharness/orchestrator/case_rollup.py:121
            states.increment(state);                                                                   // src: vvaharness/orchestrator/case_rollup.py:122
            if (decision != null) decisions.increment(decision);                                       // src: vvaharness/orchestrator/case_rollup.py:124
        }
        if (cases == 0) return Map.of();                                                               // src: vvaharness/orchestrator/case_rollup.py:125
        return shaped(cases, states, decisions);                                                       // src: vvaharness/orchestrator/case_rollup.py:127
    }

    /** Compute the rollup for repo and fold it into the invocation-wide accumulator. */
    Map record(Path repo, Theta θ) {
        Map rollup = rollupFor(repo, θ);                                                               // src: vvaharness/orchestrator/case_rollup.py:132
        if (!rollup.isEmpty()) {
            TOTALS.put("cases", TOTALS.getOrDefault("cases", 0) + rollup.get("cases"));                // src: vvaharness/orchestrator/case_rollup.py:134
            for (String key : List.of("states", "decisions")) {
                for (String name : rollup.get(key).keys()) TOTALS.get(key).increment(name, rollup.get(key).get(name)); // src: vvaharness/orchestrator/case_rollup.py:138
            }
        }
        return rollup;                                                                                 // src: vvaharness/orchestrator/case_rollup.py:139
    }

    Map totals() {
        if (TOTALS.isEmpty()) return Map.of();                                                         // src: vvaharness/orchestrator/case_rollup.py:144
        return shaped(TOTALS.get("cases"), TOTALS.get("states"), TOTALS.get("decisions"));             // src: vvaharness/orchestrator/case_rollup.py:146
    }

    void reset() {
        TOTALS.clear();                                                                                // test isolation // src: vvaharness/orchestrator/case_rollup.py:151
    }
}
