// file: vvaharness/scope/configs.py
// S1 config dedup: collapses near-identical config files (same key-shape) to one representative per cluster,
// keeping any variant whose secret/insecure-value hits are not already in the representative.

@executedBy(CODE) @role(step) @stage("S1")
class ScopeConfigs {

    Regex kvLineRx(Theta θ) {
        return Regex.compile(θ["code.scope.configs.kv_line_rx"]); // src: vvaharness/scope/configs.py:44
    }
    Regex yamlKeyRx(Theta θ) {
        return Regex.compile(θ["code.scope.configs.yaml_key_rx"]); // src: vvaharness/scope/configs.py:45
    }
    Regex reasonKeyRx(Theta θ) {
        return Regex.compile(θ["code.scope.configs.reason_key_rx"]); // src: vvaharness/scope/configs.py:97
    }

    List<String> flattenKeys(Object obj, String prefix) {
        if (obj instanceof Map) {                                                              // src: vvaharness/scope/configs.py:31
            List<String> out = new List();
            for (String k : obj.keys()) out.addAll(flattenKeys(obj.get(k), prefix.isEmpty() ? k : prefix + "." + k)); // src: vvaharness/scope/configs.py:33
            return out.isEmpty() ? List.of(prefix) : out;                                      // src: vvaharness/scope/configs.py:35
        }
        if (obj instanceof List) {                                                             // src: vvaharness/scope/configs.py:36
            List<String> out = new List();
            for (Object it : obj) out.addAll(flattenKeys(it, prefix + "[]"));                  // src: vvaharness/scope/configs.py:38
            return out.isEmpty() ? List.of(prefix) : out;                                      // src: vvaharness/scope/configs.py:40
        }
        return List.of(prefix);                                                                // src: vvaharness/scope/configs.py:41
    }

    /** Hash of the sorted key-path set (values stripped); null if unparseable or keyless. */
    String shapeHash(String text, String ext, Theta θ) {
        List<String> keys = new List();
        try {
            if (ext == ".yml" || ext == ".yaml") {                                             // src: vvaharness/scope/configs.py:52
                // indentation stack over lines matching the YAML key regex; comments skipped
                Stack<Pair<Integer, String>> stack = new Stack();
                for (String ln : text.lines()) {                                               // src: vvaharness/scope/configs.py:54
                    if (ln.isEmpty() || ln.lstrip().startsWith("#")) continue;                 // src: vvaharness/scope/configs.py:55
                    Match m = yamlKeyRx(θ).match(ln);                                           // src: vvaharness/scope/configs.py:57
                    if (m == null) continue;
                    while (!stack.isEmpty() && stack.top().first >= m.indent) stack.pop();     // src: vvaharness/scope/configs.py:61
                    stack.push(new Pair(m.indent, m.name));                                    // src: vvaharness/scope/configs.py:63
                    keys.add(join(".", stack.names()));                                        // src: vvaharness/scope/configs.py:64
                }
            } else if (ext == ".json") {                                                       // src: vvaharness/scope/configs.py:65
                keys = flattenKeys(Json.parse(text), "");                                      // src: vvaharness/scope/configs.py:66
            } else if (ext == ".ini" || ext == ".cfg" || ext == ".conf") {                     // src: vvaharness/scope/configs.py:67
                ConfigParser cp = new ConfigParser(false, true);                               // src: vvaharness/scope/configs.py:68
                cp.readString(text);
                for (String sec : cp.sections()) for (String opt : cp.options(sec)) keys.add(sec + "." + opt); // src: vvaharness/scope/configs.py:70
            } else {
                for (String ln : text.lines()) { Match m = kvLineRx(θ).match(ln); if (m != null) keys.add(m.group(1)); } // src: vvaharness/scope/configs.py:74
            }
        } catch (Exception e) {
            return null;                                                                       // src: vvaharness/scope/configs.py:79
        }
        if (keys.isEmpty()) return null;                                                       // src: vvaharness/scope/configs.py:80
        return sha1(join("\n", sorted(Set.copyOf(keys))));                                     // src: vvaharness/scope/configs.py:82
    }

    /** Normalised set of secret/insecure regex hits, used to diff a variant against its representative. */
    Set<String> suspiciousSet(String text, boolean wantSecret, boolean wantInsecure, Theta θ) {
        Set<String> out = new Set();
        int n = θ["code.scope.configs.suspicious_hit_chars"];
        if (wantSecret) for (Match m : Walk.secretRx(θ).finditer(text)) out.add("secret:" + collapseWs(m.group(0)).substring(0, n)); // src: vvaharness/scope/configs.py:89
        if (wantInsecure) for (Match m : Walk.insecureRx(θ).finditer(text)) out.add("insecure:" + collapseWs(m.group(0)).substring(0, n)); // src: vvaharness/scope/configs.py:92
        return out;
    }

    /** Human "promoted because" reason; names only the key, never the secret value. */
    String promotionReason(String entry, Theta θ) {
        String label = entry.before(":"); String hit = entry.after(":");                       // src: vvaharness/scope/configs.py:103
        Match m = reasonKeyRx(θ).match(hit);                                                    // src: vvaharness/scope/configs.py:104
        if (m != null) return label + " key: " + m.group(0);                                   // src: vvaharness/scope/configs.py:105
        if (hit.startsWith("-----BEGIN")) return label + ": private-key block";                // src: vvaharness/scope/configs.py:107
        if (hit.startsWith("AKIA") || hit.startsWith("eyJ")) return label + ": bare credential token"; // src: vvaharness/scope/configs.py:109
        return label;                                                                          // src: vvaharness/scope/configs.py:111
    }

    /** Sort key choosing the most production-relevant variant: env tier, then larger size, then path. */
    Tuple repScore(String rel, int size, Theta θ) {
        String low = rel.lower();                                                              // src: vvaharness/scope/configs.py:116
        // tiers: 0 = /prod ; 1 = /cert /stag /stg ; 2 = /perf /qa ; 3 = anything else
        List<List<String>> tiers = θ["code.scope.configs.rep_env_tiers"];                      // src: vvaharness/scope/configs.py:117
        int env = tiers.size();
        for (int i = 0; i < tiers.size(); i++) { if (tiers.get(i).anyMatch(e -> low.contains(e))) { env = i; break; } } // src: vvaharness/scope/configs.py:117
        return new Tuple(env, -size, rel);                                                     // src: vvaharness/scope/configs.py:121
    }

    /** Pass-1 worker: (rel, size, shape hash or null when oversize/unreadable/unparseable). */
    Triple<String, Long, String> hash(Path repoRoot, String rel, long maxBytes, Theta θ) {
        Path p = repoRoot.resolve(rel);                                                        // src: vvaharness/scope/configs.py:155
        try {
            long sz = p.stat().size;                                                           // src: vvaharness/scope/configs.py:157
            if (sz > maxBytes) return new Triple(rel, sz, null);                               // src: vvaharness/scope/configs.py:158
            String text = p.readText("utf-8", "replace");                                      // src: vvaharness/scope/configs.py:160
            return new Triple(rel, sz, shapeHash(text, p.suffix().lower(), θ));                  // src: vvaharness/scope/configs.py:163
        } catch (OSError e) {
            return new Triple(rel, 0, null);                                                   // src: vvaharness/scope/configs.py:162
        }
    }

    /** Re-read worker for large clusters: (rel, suspicious set or null). */
    Pair<String, Set<String>> susload(Path repoRoot, String rel, long maxBytes, boolean wantSec, boolean wantIns, Theta θ) {
        Path p = repoRoot.resolve(rel);                                                        // src: vvaharness/scope/configs.py:186
        try {
            if (p.stat().size > maxBytes) return new Pair(rel, null);                          // src: vvaharness/scope/configs.py:188
            String text = p.readText("utf-8", "replace");                                      // src: vvaharness/scope/configs.py:190
            return new Pair(rel, suspiciousSet(text, wantSec, wantIns, θ));                    // src: vvaharness/scope/configs.py:193
        } catch (OSError e) {
            return new Pair(rel, null);                                                        // src: vvaharness/scope/configs.py:192
        }
    }

    Pair<List<String>, Map> dedupConfigs(List<String> files, Path repoRoot, Config cfg, Theta θ) {
        Map dd = Walk.dedupDefaults(θ);                                                        // src: vvaharness/scope/configs.py:125
        Object configDedup = getattr(cfg.step1, "config_dedup", null);
        if (truthy(configDedup)) {
            for (String key : dd.keys()) { Object value = getattr(configDedup, key, null); if (value != null) dd.put(key, value); }
        }
        // Non-null operator values override defaults, including optional exts/max_file_kb.           // src: vvaharness/scope/configs.py:126
        if (!truthy(dd.get("enabled"))) return new Pair(files, Map.of("enabled", false)); // src: vvaharness/scope/configs.py:131

        Set<String> exts = dd.get("exts").map(e -> e.lower());                                 // src: vvaharness/scope/configs.py:134
        int minCluster = toInt(dd.get("min_cluster_size"));                             // src: vvaharness/scope/configs.py:135
        long maxBytes = dd.get("max_file_kb") * 1024;                                          // src: vvaharness/scope/configs.py:136

        List<String> candidates = new List(); List<String> passthrough = new List();
        for (String rel : files) {                                                             // src: vvaharness/scope/configs.py:140
            if (exts.contains(suffix(rel).lower())) candidates.add(rel); else passthrough.add(rel); // src: vvaharness/scope/configs.py:141
        }
        if (candidates.size() < minCluster) {                                                  // src: vvaharness/scope/configs.py:146
            return new Pair(files, Map.of("enabled", true, "candidates", candidates.size(), "clusters", 0, "dropped", 0, "promoted", 0)); // src: vvaharness/scope/configs.py:147
        }
        boolean wantSec = truthy(dd.get("promote_on_secret_hit"));                       // src: vvaharness/scope/configs.py:150
        boolean wantIns = truthy(dd.get("promote_on_insecure_value"));                   // src: vvaharness/scope/configs.py:151

        // Pass 1: hash shapes in parallel, bodies discarded after hashing
        Map<String, List<Pair<String, Long>>> clusters = new Map();
        List<String> unclustered = new List();
        int workers = θ["code.scope.configs.io_workers"];                                      // src: vvaharness/scope/configs.py:168
        for (Triple<String, Long, String> r : Runtime.parallel(workers, candidates, rel -> hash(repoRoot, rel, maxBytes, θ))) { // src: vvaharness/scope/configs.py:170
            if (r.third == null) unclustered.add(r.first); else clusters.computeIfAbsent(r.third, new List()).add(new Pair(r.first, r.second)); // src: vvaharness/scope/configs.py:171
        }

        List<String> keep = concat(passthrough, unclustered);                                  // unparseable configs are always kept. src: vvaharness/scope/configs.py:176
        List<Pair<String, String>> promoted = new List();
        List<String> dropped = new List();
        List<Map> clusterReport = new List();

        // Only large clusters need a body re-read; retain only the suspicious set
        List<String> needSus = clusters.values().filter(ms -> ms.size() >= minCluster).flatMap(ms -> ms.map(m -> m.first)); // src: vvaharness/scope/configs.py:182
        Map<String, Set<String>> susByRel = new Map();
        if (!needSus.isEmpty()) {                                                              // src: vvaharness/scope/configs.py:196
            for (Pair<String, Set<String>> r : Runtime.parallel(workers, needSus, rel -> susload(repoRoot, rel, maxBytes, wantSec, wantIns, θ))) { // src: vvaharness/scope/configs.py:198
                if (r.second != null) susByRel.put(r.first, r.second);                         // src: vvaharness/scope/configs.py:199
            }
        }

        // Pass 2: pick reps per cluster, drop pure duplicates, promote variants with new suspicious hits
        for (String h : clusters.keys()) {                                                     // src: vvaharness/scope/configs.py:203
            List<Pair<String, Long>> members = clusters.get(h);
            if (members.size() < minCluster) { keep.addAll(members.map(m -> m.first)); continue; } // src: vvaharness/scope/configs.py:204
            members.sortBy(m -> repScore(m.first, m.second, θ));                               // src: vvaharness/scope/configs.py:207
            Map<String, String> reps = new Map();
            if (truthy(dd.get("keep_per_top_dir"))) {                                    // src: vvaharness/scope/configs.py:209
                for (Pair<String, Long> m : members) reps.putIfAbsent(m.first.splitFirst("/"), m.first); // one rep per top-level dir. src: vvaharness/scope/configs.py:211
            } else {
                reps.put("*", members.get(0).first);                                           // src: vvaharness/scope/configs.py:213
            }
            Set<String> repSet = Set.copyOf(reps.values());                                    // src: vvaharness/scope/configs.py:214
            Set<String> repSus = new Set();
            for (String r : repSet) repSus.addAll(susByRel.getOrDefault(r, Set.of()));         // src: vvaharness/scope/configs.py:216
            keep.addAll(repSet);                                                               // src: vvaharness/scope/configs.py:218

            List<String> cDropped = new List();
            for (Pair<String, Long> m : members) {                                             // src: vvaharness/scope/configs.py:221
                String rel = m.first;
                if (repSet.contains(rel)) continue;                                            // src: vvaharness/scope/configs.py:222
                if (!susByRel.containsKey(rel)) { keep.add(rel); continue; }                   // unreadable on re-read: keep. src: vvaharness/scope/configs.py:224
                Set<String> extra = susByRel.get(rel).minus(repSus);                           // src: vvaharness/scope/configs.py:229
                if (!extra.isEmpty()) {                                                        // src: vvaharness/scope/configs.py:230
                    keep.add(rel);                                                             // src: vvaharness/scope/configs.py:231
                    promoted.add(new Pair(rel, promotionReason(sorted(extra).get(0), θ)));        // src: vvaharness/scope/configs.py:232
                    repSus.addAll(susByRel.get(rel));                                          // later variants compare against the grown set. src: vvaharness/scope/configs.py:233
                } else {
                    cDropped.add(rel);                                                         // src: vvaharness/scope/configs.py:235
                }
            }
            dropped.addAll(cDropped);                                                          // src: vvaharness/scope/configs.py:236
            clusterReport.add(Map.of("shape", h.substring(0, 12), "size", members.size(), "reps", sorted(repSet), "dropped", cDropped.size(), "sample", members.get(0).first)); // src: vvaharness/scope/configs.py:237
        }

        clusterReport.sortBy(c -> -c.get("size"));                                             // src: vvaharness/scope/configs.py:245
        Map report = Map.of("enabled", true, "candidates", candidates.size(), "unparseable_kept", unclustered.size(), // src: vvaharness/scope/configs.py:246
            "clusters", clusterReport.filter(c -> c.get("size") >= minCluster).size(),
            "kept_reps", clusterReport.sum(c -> c.get("reps").size()), "promoted", promoted.size(),
            "promoted_files", promoted.head(50), "dropped", dropped.size(), "dropped_files", dropped, // report-only truncation
            "top_clusters", clusterReport.head(10));                                           // src: vvaharness/scope/configs.py:256
        if (!dropped.isEmpty()) {                                                              // src: vvaharness/scope/configs.py:259
            Console.write("[s1] config-dedup summary: clusters, reps, promoted, dropped");     // src: vvaharness/scope/configs.py:262
            if (!promoted.isEmpty()) Console.write("[s1] promoted (suspicious value not in rep)"); // src: vvaharness/scope/configs.py:267
        }
        return new Pair(sorted(keep), report);                                                 // src: vvaharness/scope/configs.py:271
    }
}
