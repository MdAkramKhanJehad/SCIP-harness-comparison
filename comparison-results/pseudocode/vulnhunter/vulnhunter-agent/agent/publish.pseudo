// file: vulnhunter-agent/agent/publish.py
// Publish stage: push the *_VULNHUNT_RESULTS_* dir into publish.destination_repo under
// <owner>/<name>/<timestamp>/<sha>/<results_dir>/, creating the destination as a private repo if missing.

@executedBy(CODE) @role(io) @stage("agent")
class Publish {

    // _parse_owner_repo: GitHubURLError -> PublishError.
    String[] parseOwnerRepo(String repoUrl) {
        try {
            return Github.parseOwnerRepo(repoUrl);                                                // src: vulnhunter-agent/agent/publish.py:55
        } catch (GitHubURLError exc) {
            throw new PublishError(exc.message);                                                  // src: vulnhunter-agent/agent/publish.py:57
        }
    }

    // ensure_destination_repo: true if created now, false if it already existed.
    boolean ensureDestinationRepo(PublishConfig publish, GithubConfig github) {
        if (TokenClient.getGithubToken("reports", github) == "") throw new PublishError("ensure_destination_repo requires reports_token"); // src: vulnhunter-agent/agent/publish.py:72
        (String owner, String name) = parseOwnerRepo(publish.destinationRepo);                    // src: vulnhunter-agent/agent/publish.py:76
        String api = Github.apiBase(github.host);                                                 // src: vulnhunter-agent/agent/publish.py:77
        HttpClient client = new HttpClient(Auth.resolveVerify(config.tls), θ["code.agent.publish.api_timeout_seconds"], new BrokerTokenAuth("reports", github)); // src: vulnhunter-agent/agent/publish.py:64
        Response resp = client.get(api + "/repos/" + owner + "/" + name);                         // src: vulnhunter-agent/agent/publish.py:91
        if (resp.statusCode == 200) return false;                                                 // src: vulnhunter-agent/agent/publish.py:92
        if (resp.statusCode != 404) throw new PublishError("unexpected status checking destination"); // src: vulnhunter-agent/agent/publish.py:95
        // 404: destination missing -> always create it (no opt-out in code)
        Response ownerResp = client.get(api + "/users/" + owner);                                 // src: vulnhunter-agent/agent/publish.py:102
        if (ownerResp.statusCode != 200) throw new PublishError("GitHub owner not found");        // src: vulnhunter-agent/agent/publish.py:103
        String ownerType = ownerResp.json().get("type");                                          // src: vulnhunter-agent/agent/publish.py:108
        Map body = Map.of("name", name, "private", θ["code.agent.publish.create_private"], "auto_init", true, "description", "VulnHunter scan results."); // src: vulnhunter-agent/agent/publish.py:110
        String createUrl;
        if (ownerType == "Organization") {                                                        // src: vulnhunter-agent/agent/publish.py:118
            createUrl = api + "/orgs/" + owner + "/repos";                                        // src: vulnhunter-agent/agent/publish.py:119
        } else if (ownerType == "User") {                                                         // src: vulnhunter-agent/agent/publish.py:120
            Response me = client.get(api + "/user");                                              // src: vulnhunter-agent/agent/publish.py:122
            if (me.statusCode != 200 || me.json().get("login") != owner) throw new PublishError("refusing to create repo in another user's namespace"); // src: vulnhunter-agent/agent/publish.py:123
            createUrl = api + "/user/repos";                                                      // src: vulnhunter-agent/agent/publish.py:128
        } else {
            throw new PublishError("unknown owner type");                                         // src: vulnhunter-agent/agent/publish.py:130
        }
        Response create = client.post(createUrl, body);                                           // src: vulnhunter-agent/agent/publish.py:135
        if (create.statusCode != 201) throw new PublishError("creating destination failed");      // src: vulnhunter-agent/agent/publish.py:136
        return true;                                                                              // src: vulnhunter-agent/agent/publish.py:146
    }

    // _run: git resolved to its absolute path; non-zero exit -> PublishError with redacted argv/stderr.
    Completed run(List<String> cmd, Path cwd, Map env, int timeout) {
        if (cmd.get(0) == "git") {                                                                // src: vulnhunter-agent/agent/publish.py:162
            if (GIT_EXECUTABLE == null) throw new PublishError("git not on PATH; cannot publish"); // src: vulnhunter-agent/agent/publish.py:164
            cmd = [GIT_EXECUTABLE] + cmd.drop(1);                                                 // src: vulnhunter-agent/agent/publish.py:165
        }
        Completed result = subprocess.run(cmd, cwd, env, timeout);                                // src: vulnhunter-agent/agent/publish.py:170
        if (result.returncode != 0) throw new PublishError("git command failed: " + Url.redact(cmd)); // src: vulnhunter-agent/agent/publish.py:178
        return result;
    }

    // _validate_token_compatibility: http(s) destination on the same host as github.host, reports token set.
    void validateTokenCompatibility(PublishConfig publish, GithubConfig github) {
        Url parsed = urlparse(publish.destinationRepo);                                           // src: vulnhunter-agent/agent/publish.py:192
        if (!List.of("http", "https").contains(parsed.scheme)) throw new PublishError("destination_repo must be an http(s) URL"); // src: vulnhunter-agent/agent/publish.py:193
        String configHost = (github.host != "") ? github.host.lower() : "";                       // src: vulnhunter-agent/agent/publish.py:199
        if (orElse(parsed.hostname, "") != configHost) throw new PublishError("destination host does not match github.host"); // src: vulnhunter-agent/agent/publish.py:200
        if (TokenClient.getGithubToken("reports", github) == "") throw new PublishError("publish requires reports_token"); // src: vulnhunter-agent/agent/publish.py:207
    }

    // publish_results: returns the pushed commit SHA.
    String publishResults(Path resultsDir, PublishConfig publish, GithubConfig github, String sourceRepoUrl, String sourceCommitHash) {
        int timeoutSeconds = θ["code.agent.publish.git_timeout_seconds"];                         // src: vulnhunter-agent/agent/publish.py:221
        if (!resultsDir.isDir()) throw new PublishError("results dir is not a directory");        // src: vulnhunter-agent/agent/publish.py:238
        validateTokenCompatibility(publish, github);                                              // src: vulnhunter-agent/agent/publish.py:241
        (String sourceOwner, String sourceName) = parseOwnerRepo(sourceRepoUrl);                  // src: vulnhunter-agent/agent/publish.py:242
        String commitSegment = orElse(sourceCommitHash, "unknown");                               // src: vulnhunter-agent/agent/publish.py:243
        String timestampSegment = Github.extractTimestamp(resultsDir.name);                       // src: vulnhunter-agent/agent/publish.py:244
        boolean created = ensureDestinationRepo(publish, github);                                 // src: vulnhunter-agent/agent/publish.py:246
        String authedUrl = Url.injectToken(publish.destinationRepo, TokenClient.getGithubToken("reports", github), github.host); // src: vulnhunter-agent/agent/publish.py:253
        Map env = os.environ.copy();
        env.put("GIT_TERMINAL_PROMPT", "0");                                                      // src: vulnhunter-agent/agent/publish.py:260
        env.put("GIT_AUTHOR_NAME", θ["publish.*"].commitAuthorName);                              // src: vulnhunter-agent/agent/publish.py:261
        env.put("GIT_AUTHOR_EMAIL", θ["publish.*"].commitAuthorEmail);                            // src: vulnhunter-agent/agent/publish.py:262
        env.put("GIT_COMMITTER_NAME", θ["publish.*"].commitAuthorName);
        env.put("GIT_COMMITTER_EMAIL", θ["publish.*"].commitAuthorEmail);                         // src: vulnhunter-agent/agent/publish.py:264
        Path workdir = mkdtemp("vulnhunt-publish-");                                              // src: vulnhunter-agent/agent/publish.py:266
        Path destClone = workdir.resolve("dest");
        try {
            destClone.mkdirs();
            run(List.of("git", "init", "--initial-branch", publish.branch), destClone, env, timeoutSeconds); // src: vulnhunter-agent/agent/publish.py:283
            run(List.of("git", "remote", "add", "origin", authedUrl), destClone, env, timeoutSeconds); // src: vulnhunter-agent/agent/publish.py:288
            if (GIT_EXECUTABLE == null) throw new PublishError("git not on PATH; cannot publish"); // src: vulnhunter-agent/agent/publish.py:296
            Completed fetch = subprocess.run(List.of(GIT_EXECUTABLE, "fetch", "--depth=1", "origin", publish.branch), destClone, env, timeoutSeconds); // src: vulnhunter-agent/agent/publish.py:298
            boolean creatingBranch = fetch.returncode != 0;                                       // src: vulnhunter-agent/agent/publish.py:306
            if (!creatingBranch) run(List.of("git", "reset", "--hard", "FETCH_HEAD"), destClone, env, timeoutSeconds); // src: vulnhunter-agent/agent/publish.py:315
            String relPath = θ["code.agent.publish.dest_layout"]
                    .format(sourceOwner, sourceName, timestampSegment, commitSegment, resultsDir.name); // src: vulnhunter-agent/agent/publish.py:327
            Path target = destClone.resolve(relPath);                                             // src: vulnhunter-agent/agent/publish.py:331
            if (target.exists()) rmtree(target);                                                  // src: vulnhunter-agent/agent/publish.py:339
            target.parent.mkdirs();                                                               // src: vulnhunter-agent/agent/publish.py:342
            copytree(resultsDir, target);                                                         // src: vulnhunter-agent/agent/publish.py:343
            run(List.of("git", "add", "--", relPath), destClone, env, timeoutSeconds);            // src: vulnhunter-agent/agent/publish.py:347
            String status = run(List.of("git", "status", "--porcelain"), destClone, env, timeoutSeconds).stdout.strip(); // src: vulnhunter-agent/agent/publish.py:348
            if (status == "" && θ["code.agent.publish.fail_on_no_changes"]) throw new PublishError("No changes to commit; destination already contains identical content."); // src: vulnhunter-agent/agent/publish.py:351
            run(List.of("git", "commit", "-m", "Add VulnHunt results: " + relPath), destClone, env, timeoutSeconds); // src: vulnhunter-agent/agent/publish.py:358
            String sha = run(List.of("git", "rev-parse", "HEAD"), destClone, env, timeoutSeconds).stdout.strip(); // src: vulnhunter-agent/agent/publish.py:364
            List<String> pushCmd = List.of("git", "push");                                        // src: vulnhunter-agent/agent/publish.py:370
            if (creatingBranch) pushCmd.add("--set-upstream");                                    // src: vulnhunter-agent/agent/publish.py:371
            pushCmd.addAll(List.of("origin", "HEAD:" + publish.branch));                          // src: vulnhunter-agent/agent/publish.py:373
            run(pushCmd, destClone, env, timeoutSeconds);                                         // src: vulnhunter-agent/agent/publish.py:374
            return sha;                                                                           // src: vulnhunter-agent/agent/publish.py:389
        } finally {
            rmtree(workdir);                                                                      // src: vulnhunter-agent/agent/publish.py:391
        }
    }
}

@executedBy(CODE) @role(types)
class PublishError extends RuntimeError { }
