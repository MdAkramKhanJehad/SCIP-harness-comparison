// file: vvaharness/pipeline/stages/s3_decompose.py
// S3: builds the risk-ranked TaskManifest deterministically from S2's ThreatModel, one InvestigationUnit per threat.
// No model call; no catch-all unit for files no threat named (they are reported as unreachable).

@executedBy(CODE) @role(stage) @stage("S3")
class S3Decompose {

    // impact and likelihood ordinals: knobs code.s3.impact_ordinal and code.s3.likelihood_ordinal; defaults are medium (2) and possible (3);
    // MAX_RISK_SCORE = max impact ordinal times max likelihood ordinal (25)
    Map<String, Integer> locCache = new Map();                                                 // _LOC_CACHE, memoised per absolute path string // src: vvaharness/pipeline/stages/s3_decompose.py:187

    TaskManifest run(ContextPackage ctx, Config cfg, Theta θ) {
        TaskManifest manifest = new TaskManifest();                                            // src: vvaharness/pipeline/stages/s3_decompose.py:47
        int nThreat = investigationUnits(manifest, ctx, θ);                                    // src: vvaharness/pipeline/stages/s3_decompose.py:49
        for (InvestigationUnit u : manifest.units) u.languages = LangDetect.detectLanguages(u.files); // src: vvaharness/pipeline/stages/s3_decompose.py:53
        manifest.unreachableFiles = coverageReport(manifest, ctx);                             // src: vvaharness/pipeline/stages/s3_decompose.py:55
        reportUnitLoc(manifest, Path.of(ctx.repoRoot), θ);                                     // src: vvaharness/pipeline/stages/s3_decompose.py:56
        if (cfg.scanProgress != null) for (InvestigationUnit unit : manifest.units) cfg.scanProgress.queued(unit); // tracker, display only // src: vvaharness/pipeline/stages/s3_decompose.py:59
        return manifest;                                                                       // src: vvaharness/pipeline/stages/s3_decompose.py:71
    }

    /** 1 (most urgent) .. 25 from impact x likelihood; unknown values default to medium / possible. */
    int threatRiskRank(Threat t, Theta θ) {
        Map<String, Integer> impact = θ["code.s3.impact_ordinal"]; Map<String, Integer> likelihood = θ["code.s3.likelihood_ordinal"]; // src: vvaharness/pipeline/stages/s3_decompose.py:35
        int maxRisk = impact.values().max() * likelihood.values().max();                      // src: vvaharness/pipeline/stages/s3_decompose.py:41
        int score = impact.getOrDefault(t.impact, impact.get("medium")) * likelihood.getOrDefault(t.likelihood, likelihood.get("possible")); // src: vvaharness/pipeline/stages/s3_decompose.py:76
        return maxRisk + 1 - score;                                                            // src: vvaharness/pipeline/stages/s3_decompose.py:78
    }

    /** file to community name from ctx.modules (first module wins per file): a reported annotation that nothing groups or splits files by. */
    @src("vvaharness/pipeline/stages/s3_decompose.py:81")
    Map<String, String> fileModuleIndex(ContextPackage ctx) {
        Map<String, String> fileCommunity = new Map();
        for (Module m : ctx.modules) for (String f : m.files) fileCommunity.putIfAbsent(f, m.name); // setdefault // src: vvaharness/pipeline/stages/s3_decompose.py:86
        return fileCommunity;                                                                  // src: vvaharness/pipeline/stages/s3_decompose.py:87
    }

    /** One unit per threat, carrying that threat's whole validated surface uncut; returns how many were added. */
    int investigationUnits(TaskManifest manifest, ContextPackage ctx, Theta θ) {
        Object rule = θ["code.s3.unit_rule"];                                                  // one unit per threat, ranked impact x likelihood  // src: vvaharness/pipeline/stages/s3_decompose.py:90
        ThreatModel tm = ctx.threatModel;
        if (tm == null || tm.threats.isEmpty()) return 0;                                      // src: vvaharness/pipeline/stages/s3_decompose.py:93
        Set<String> allFiles = Set.copyOf(ctx.allFiles);                                       // src: vvaharness/pipeline/stages/s3_decompose.py:96
        Map<String, String> fileCommunity = fileModuleIndex(ctx);                              // src: vvaharness/pipeline/stages/s3_decompose.py:97
        Path repoRoot = Path.of(ctx.repoRoot);
        int baseRank = manifest.units.map(u -> u.riskRank).max(0);                             // src: vvaharness/pipeline/stages/s3_decompose.py:99
        int added = 0; int withSurface = 0;
        Set<String> usedIds = Set.copyOf(manifest.units.map(u -> u.id));                       // src: vvaharness/pipeline/stages/s3_decompose.py:103
        for (Pair<String, Threat> it : zipStrict(tm.threatIds(), tm.threats)) {                // src: vvaharness/pipeline/stages/s3_decompose.py:104
            String threatId = it.first; Threat t = it.second;
            List<String> files = distinct(t.surfaceFiles).filter(f -> allFiles.contains(f));  // src: vvaharness/pipeline/stages/s3_decompose.py:105
            if (files.isEmpty()) {                                                             // src: vvaharness/pipeline/stages/s3_decompose.py:106
                manifest.threatsWithoutUnit.add(threatId);                                     // never reviewed  // src: vvaharness/pipeline/stages/s3_decompose.py:107
                Console.write(threatId + ": no validated surface file - never reviewed");      // src: vvaharness/pipeline/stages/s3_decompose.py:108
                continue;
            }
            withSurface += 1;                                                                  // src: vvaharness/pipeline/stages/s3_decompose.py:111
            String cid = Work.threatUnitId(threatId);                                          // src: vvaharness/pipeline/stages/s3_decompose.py:113
            if (usedIds.contains(cid)) {                                                       // src: vvaharness/pipeline/stages/s3_decompose.py:114
                int n = 2;
                while (usedIds.contains(cid + "-" + n)) n++;                                   // src: vvaharness/pipeline/stages/s3_decompose.py:116
                cid = cid + "-" + n;                                                           // src: vvaharness/pipeline/stages/s3_decompose.py:118
            }
            usedIds.add(cid);                                                                  // src: vvaharness/pipeline/stages/s3_decompose.py:119
            Set<String> fset = Set.copyOf(files);
            List<Sink> sinks = ctx.unsafeSinks.filter(s -> fset.contains(s.file));             // src: vvaharness/pipeline/stages/s3_decompose.py:122
            int loc = files.sum(f -> countLoc(repoRoot.resolve(f)));                           // src: vvaharness/pipeline/stages/s3_decompose.py:123
            manifest.units.add(new InvestigationUnit(cid, t.threat, t.surface, t.actor, t.asset, t.impact, t.likelihood, t.controls, t.evidence,
                files, sinks,
                ctx.entryPoints.filter(e -> fset.contains(e.file)),
                ctx.knownCves.filter(c -> c.affectedFiles.intersects(fset)).map(c -> c.id),
                files.map(f -> fileCommunity.getOrDefault(f, "file:" + f)).distinct().sorted(),   // communities
                sinks.flatMap(s -> s.cwe).distinct().sorted(),                                 // cwes
                baseRank + threatRiskRank(t, θ), sizeFor(loc, θ)));                            // src: vvaharness/pipeline/stages/s3_decompose.py:125
            added++;
        }
        Console.write(added + " unit(s) from " + withSurface + "/" + tm.threats.size() + " threat(s) with a validated surface"); // src: vvaharness/pipeline/stages/s3_decompose.py:146
        return added;                                                                          // src: vvaharness/pipeline/stages/s3_decompose.py:150
    }

    /** SMALL / MEDIUM / LARGE by LOC; LARGE units run alone in S4. */
    UnitSize sizeFor(int loc, Theta θ) {
        if (loc < θ["code.s3.small_unit_loc_max"]) return UnitSize.SMALL;                     // src: vvaharness/pipeline/stages/s3_decompose.py:154
        if (loc < θ["code.s3.medium_unit_loc_max"]) return UnitSize.MEDIUM;                   // src: vvaharness/pipeline/stages/s3_decompose.py:156
        return UnitSize.LARGE;                                                                 // src: vvaharness/pipeline/stages/s3_decompose.py:158
    }

    /** Prints the unit LOC distribution: n, min, p50, p90 (index min(n-1, int(n*0.9))) and max, with values of 1000 or more shown as one-decimal k. */
    @src("vvaharness/pipeline/stages/s3_decompose.py:173")
    void reportUnitLoc(TaskManifest manifest, Path repoRoot, Theta θ) {
        List<Integer> locs = manifest.units.map(u -> u.files.sum(f -> countLoc(repoRoot.resolve(f)))).sorted(); // src: vvaharness/pipeline/stages/s3_decompose.py:175
        if (locs.isEmpty()) return;                                                            // src: vvaharness/pipeline/stages/s3_decompose.py:177
        int n = locs.size();
        // display: a value of 1000 (_LOC_KILO) or more is shown as x/1000 with one decimal and a k suffix
        int p90 = locs.get(min(n - 1, (int) (n * 0.9)));                                       // _P90_FRACTION // src: vvaharness/pipeline/stages/s3_decompose.py:182
        Console.write("unit LOC: n=" + n + " min=" + locs.get(0) + " p50=" + locs.get(n / 2) + " p90=" + p90 + " max=" + locs.get(n - 1)); // src: vvaharness/pipeline/stages/s3_decompose.py:183
    }

    /** The file's line count, memoised on its absolute path string; an unreadable file counts 0 (and that 0 is cached). */
    @src("vvaharness/pipeline/stages/s3_decompose.py:190")
    int countLoc(Path p) {
        String k = p.toString();                                                               // src: vvaharness/pipeline/stages/s3_decompose.py:192
        Integer v = locCache.get(k);                                                           // src: vvaharness/pipeline/stages/s3_decompose.py:193
        if (v != null) return v;                                                               // src: vvaharness/pipeline/stages/s3_decompose.py:194
        try { v = p.lines("utf-8", "replace").count(); } catch (OSError e) { v = 0; }          // src: vvaharness/pipeline/stages/s3_decompose.py:198
        locCache.put(k, v);                                                                    // src: vvaharness/pipeline/stages/s3_decompose.py:201
        return v;
    }

    /** Files named by no unit; reported, never scanned. Prints the count when any. */
    List<String> coverageReport(TaskManifest manifest, ContextPackage ctx) {
        Set<String> covered = manifest.units.flatMap(u -> u.files);                            // src: vvaharness/pipeline/stages/s3_decompose.py:164
        return sorted(Set.copyOf(ctx.allFiles).minus(covered));                                // src: vvaharness/pipeline/stages/s3_decompose.py:166
    }
}
