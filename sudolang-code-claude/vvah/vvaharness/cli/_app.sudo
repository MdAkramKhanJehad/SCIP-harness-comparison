// src: vvaharness/cli/_app.py:45-53
fn _delegate(command, ctx):executor=code {
  try code = cli._dispatch([command, ...ctx.args]);   // extra and unknown options pass through; Typer's own help is disabled per command (_PASSTHROUGH, _app.py:29-30)
  catch KeyboardInterrupt => throw Interrupted   // so Typer does not swallow it
  exit with code
}

// src: vvaharness/cli/_app.py:126-137
fn run(args):executor=code {
  try return Typer command main(args, standalone_mode=false) || 0;
  catch error => match (error) {
    case typer.Exit => return error.exit_code
    case Interrupted | typer.Abort => throw KeyboardInterrupt   // cli.main maps it to 130
    case ClickException => { show error; return error.exit_code }
  }
}

