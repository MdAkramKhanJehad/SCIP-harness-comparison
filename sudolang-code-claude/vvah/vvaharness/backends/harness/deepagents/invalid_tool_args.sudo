# vvaharness/backends/harness/deepagents/invalid_tool_args.py

`RepairInvalidToolArgs`, a deepagents middleware that, before every model call, turns each tool call whose arguments langchain could not parse as JSON into a regular tool call with empty arguments, and adds a paired error tool result so the conversation stays well formed. Each bad call id is counted once.

Source: `vvaharness/backends/harness/deepagents/invalid_tool_args.py` (lines 1-136)
Executor: code
Called from: `vvaharness/backends/harness/deepagents/options/graph_builder.sudo` _create_agent (always installed)

// src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:35-40
fn _repair_block(block, repaired_ids):executor=code {
  // A Responses-API "function_call" content block whose call_id was repaired gets arguments "{}"
}

// src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:43-55
fn _record_invalid_call(invalid, call_id, existing_tool_message_ids, counted_ids):executor=code {
  if (call_id not in counted_ids) { counted_ids.add(call_id); COUNTERS.bump("deepagents_tool_args_invalid_json") }
  if (call_id in existing_tool_message_ids) return null   // a result already exists for this call
  error = invalid.error or "arguments were not valid JSON"
  return ToolMessage(content="ERROR: tool arguments were not valid JSON: $error", tool_call_id=call_id, name=invalid.name)
}

// src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:58-87
fn _repair_message(message, existing_tool_message_ids, counted_ids):executor=code {
  for each invalid in message.invalid_tool_calls {
    if (invalid.id == null) { keep it in invalid_tool_calls; continue }   // ToolMessage requires a tool_call_id; langchain skips the same case
    append { name: invalid.name or "", args: {}, id: invalid.id } to tool_calls
    extra = _record_invalid_call(invalid, invalid.id, existing_tool_message_ids, counted_ids)
    if (extra) append extra to extra_tool_messages
  }
  if (message.content is a list) content = each block |> _repair_block
  return [message with repaired tool_calls, remaining invalid calls, content; extra_tool_messages]
}

// src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:90-106
fn _repair(messages, counted_ids):executor=code {
  existing = ids of every ToolMessage in messages
  // Each AI message with invalid tool calls is replaced by its repaired copy followed by its new error ToolMessages
  return repaired list, or null when nothing changed
}

// src: vvaharness/backends/harness/deepagents/invalid_tool_args.py:109-133
RepairInvalidToolArgs {
  State { _counted_ids = {} }
  // src: invalid_tool_args.py:117-133 (async twin identical)
  fn wrap_model_call(request, handler):executor=code {
    repaired = _repair(request.messages, _counted_ids)
    return handler(if (repaired == null) request else request with messages = repaired)
    // preserved: the override changes only the outgoing request, not agent state, so the same unrepaired call recurs every later turn and is repaired again; the counter dedupes by call id (comment at 17-18)
  }
}
