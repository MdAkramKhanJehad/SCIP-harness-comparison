# vvaharness/detect/roles.py

Turns matcher hits into typed `Sink` and `EntryPoint` records, deduplicating them.

Source: `vvaharness/detect/roles.py` (lines 1-70)
Executor: code
Called from: `vvaharness/detect/__init__.py` (scan)

// src: vvaharness/detect/roles.py:23-28
_EP_KINDS = ["network", "ipc", "file", "cli", "deserialization", "framework", "other"]
fn _sink_function(hit):executor=code { return the part of hit.spec.rule_id after its last "-" }   // for example "detect-sink-command-system" => "system"

// src: vvaharness/detect/roles.py:31-50
fn hits_to_sinks(hits):executor=code {
  for each hit where hit.spec.role == "sink" {
    function = _sink_function(hit)
    if ((hit.file, hit.line, function) already seen) continue   // deduplicated by (file, line, function); first hit wins
    emit Sink({ file: hit.file, line: hit.line, function, snippet: hit.snippet, cwe: [hit.spec.cwe] })
  }
}

// src: vvaharness/detect/roles.py:53-70
fn hits_to_entry_points(hits):executor=code {
  for each hit where hit.spec.role == "source" {
    kind = if (hit.spec.kind in _EP_KINDS) hit.spec.kind else "other"
    if ((hit.file, kind) already seen) continue   // one entry point per (file, kind); later hits of the same kind in the file are dropped
    emit EntryPoint({ file: hit.file, function: hit.snippet, kind })   // preserved: the matched line snippet is stored as the function name
  }
}
