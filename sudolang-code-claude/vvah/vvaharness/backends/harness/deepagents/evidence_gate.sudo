# vvaharness/backends/harness/deepagents/evidence_gate.py

`EvidenceGate`, a deepagents middleware that rejects a session's structured verdict while the session's own todo plan has unfinished items, while none of a set of required tools (graph-reachability tools) has been called, or (optionally) while no tool at all has been called. Each rejection hands the model a "HOLD" message instead of recording the verdict. After `max_rejections` rejections the gate relents, counts the relent and warns once. An out-of-loop form (`hold_for_verdict`) serves the routes that have no model-call seam.

Source: `vvaharness/backends/harness/deepagents/evidence_gate.py` (lines 1-226)
Executor: code (it re-asks the model; the model does the outstanding work)
Called from: parent middleware built in `vvaharness/pipeline/stages/s2/session.py`, `vvaharness/pipeline/stages/s4/session.py` (max_rejections from knob "step4.evidence_gate_refusals", default 3), `vvaharness/pipeline/stages/s6/session.py`; installed by `options/graph_builder.sudo` _create_agent through parent_middleware

// src: vvaharness/backends/harness/deepagents/evidence_gate.py:35-37
_DONE = { "completed" }   // the only todo status that counts as done
_WARNED_RELENTED = {}     // process-wide set: one relent warning per counter

// src: vvaharness/backends/harness/deepagents/evidence_gate.py:40-48
fn _relent_warning(counter, max_rejections, required):executor=code {
  reason = if (required) "missing ${ sorted(required) joined by ", " }" else "an unfinished plan"
  return "WARN ${stage_label(counter)}: the evidence gate rejected a verdict $max_rejections time(s) for $reason, then relented -- this stage's output shipped without that evidence. Count in ${counter}_relented. Raise this stage's rejection limit in the scan config, or review this run's output by hand."
}

// src: vvaharness/backends/harness/deepagents/evidence_gate.py:51-62
fn _todos(state):executor=code {
  // The live todo list from agent state ("todos"), only dict entries; [] when planning is not in play or the read fails
}
fn _outstanding(todos):executor=code {
  return [ t.content or "?" for each t in todos where t.status not in _DONE ]   // in plan order
}

// src: vvaharness/backends/harness/deepagents/evidence_gate.py:65-77
// prompt-src: vvaharness/backends/harness/deepagents/evidence_gate.py:68-77
EvidenceGateNudge {
  // HumanMessage handed back in place of the premature verdict; $listed is one "  - <todo>" line per outstanding item
  Constraints {
    "HOLD. You tried to report a verdict, but ${count} todo(s) on your own plan are not completed:\n$listed\n\n"
    "That verdict is rejected and has not been recorded. Do the outstanding work now — read the code each todo names (to the END of the file; continue any paginated Read), load the skill it calls for, grep for the sibling sites, enumerate the places a missing control belongs. Then mark each todo completed with `write_todos` and report.\n\n"
    "If a todo genuinely does not apply, mark it completed and say why in your rationale. Do not resend the same verdict without new evidence."
  }
}

// src: vvaharness/backends/harness/deepagents/evidence_gate.py:80-223
EvidenceGate {
  // src: evidence_gate.py:83-97
  State {
    _max = max_rejections            // constructor default 3
    _counter = counter               // default "evidence_gate_rejected"
    _required = required_tools       // default empty set
    _require_tool_call = require_tool_call   // default false
    _ignored = ignored_tools         // default empty set; tool names that do not satisfy require_tool_call
    _called = {}                     // every tool name the session has called
    _rejected = 0
    _lock                            // threading lock around _rejected and out-of-loop _called updates
  }
  name = "EvidenceGate[$_counter]"   // src: evidence_gate.py:117-120; unique per agent

  // src: evidence_gate.py:99-115 (async twin identical)
  fn wrap_tool_call(request, handler):executor=code {
    _called.add(request.tool_call.name)   // preserved: added without the lock (the out-of-loop note_call takes it)
    return handler(request)
  }

  // src: evidence_gate.py:128-134
  fn _claim():executor=code {
    with _lock {
      if (_rejected >= _max) return false   // relent
      _rejected += 1; return true
    }
  }

  // src: evidence_gate.py:136-140 — sdk/openai/cli adapters must feed this, or hold_for_verdict refuses every submit
  fn note_call(name):executor=code { with _lock { _called.add(name) } }

  // src: evidence_gate.py:142-162 — out-of-loop rejection for routes without wrap_model_call (sdk, openai, cli)
  fn hold_for_verdict():executor=code {
    if (!_required || (_required intersection _called)) return null   // nothing required, or one required tool was used
    if (!_claim()) {
      COUNTERS.bump("${_counter}_relented")
      warn once per counter: _relent_warning(_counter, _max, _required)
      return null   // verdict accepted without the evidence
    }
    COUNTERS.bump(_counter)
    return HoldForVerdictRefusal   // returned to the model as the submit tool's result
  }

  // src: evidence_gate.py:164-168
  fn _tool_call_items():executor=code {
    if (_require_tool_call && (_called - _ignored) is empty) return ["read the code with a tool before you report"]
    return []
  }

  // src: evidence_gate.py:170-194 — the in-loop gate
  fn _premature(request, response):executor=code {
    if (response.structured_response == null) return []   // only a verdict is gated
    outstanding = _outstanding(_todos(request.state))
    if (_required && !(_required intersection _called)) outstanding += [ReachabilityItem]
    outstanding += _tool_call_items()
    if (outstanding is empty) return []
    if (!_claim()) {
      COUNTERS.bump("${_counter}_relented")
      warn once per counter: _relent_warning(_counter, _max, _required)
      return []
    }
    COUNTERS.bump(_counter)
    return outstanding
  }

  // src: evidence_gate.py:196-199
  fn _retry_request(request, outstanding):executor=code {
    // The rejected reply is deliberately dropped (Anthropic returns 400 on a tool_use with no tool_result)
    return request with messages = [...request.messages, EvidenceGateNudge(outstanding)]
  }

  // src: evidence_gate.py:201-223 (async twin 213-223 identical)
  fn wrap_model_call(request, handler):executor=mixed {
    response = handler(request)   // callModel through the rest of the middleware stack
    while (outstanding = _premature(request, response)) is non-empty {
      request = _retry_request(request, outstanding)
      response = handler(request)
    }
    // Terminates because _claim fails after _max rejections (shared across the instance, not per call)
    return response
  }
}

// prompt-src: vvaharness/backends/harness/deepagents/evidence_gate.py:152-162
HoldForVerdictRefusal {
  Constraints {
    "Rejected: you have not called any of ${sorted(_required) joined by ", "} to establish reachability from the call graph before submitting this verdict. Call one now: GraphImporters(file) for who imports a file, GraphNeighbors(file, function) for its callers and callees, GraphCommunityOf(file) for its module, GraphSinksInCommunity(community) for the other sinks near it. These are deterministic and answer in one call what a file sweep answers badly. Call one, then resend your verdict with that evidence."
  }
}

// prompt-src: vvaharness/backends/harness/deepagents/evidence_gate.py:176-184
ReachabilityItem {
  // One extra outstanding item listed inside EvidenceGateNudge
  Constraints {
    "establish reachability from the call graph — you have not called any of ${sorted(_required) joined by ", "}. Call one now: GraphImporters(file) for who imports a file, GraphNeighbors(file, function) for its callers and callees, GraphCommunityOf(file) for its module, GraphSinksInCommunity(community) for the other sinks near it. These are deterministic and answer in one call what a file sweep answers badly"
  }
}
