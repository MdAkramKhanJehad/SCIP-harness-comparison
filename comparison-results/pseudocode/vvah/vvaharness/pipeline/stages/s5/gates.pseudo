// file: vvaharness/pipeline/stages/s5/gates.py
// What S5 still refuses: a coordinate that does not exist, and test-path noise.
// The S5 location knobs (re-anchor switch/cap, line tolerance) are listed here as the gate
// parameters; their real read site is s5/__init__.py run().

@executedBy(CODE) @role(rule_set) @stage("S5")
class S5Gates {

    Verdict rejectPath(Finding f, Set<String> validFiles, Theta θ) {
        if (S5Rules.excludePath(f.file, θ) && !S5Rules.isSecretClass(f)) {                     // src: vvaharness/pipeline/stages/s5/gates.py:25
            return new Verdict("EXCLUDED", "test/mock/example path");                           // src: vvaharness/pipeline/stages/s5/gates.py:26
        }
        if (validFiles != null && !validFiles.contains(f.file)) {                               // src: vvaharness/pipeline/stages/s5/gates.py:27
            return new Verdict("EXCLUDED", "file not in repo inventory");                       // src: vvaharness/pipeline/stages/s5/gates.py:28
        }
        return null;
    }

    Verdict reject(Finding f, Set<String> validFiles, List<String> lines, Theta θ) {
        Verdict verdict = rejectPath(f, validFiles, θ);                                         // src: vvaharness/pipeline/stages/s5/gates.py:35
        if (verdict != null) return verdict;
        if (lines == null) return new Verdict("EXCLUDED", "file could not be read from the repo"); // src: vvaharness/pipeline/stages/s5/gates.py:39
        int line = f.lineStart;
        if (!(1 <= line && line <= lines.size())) {                                             // src: vvaharness/pipeline/stages/s5/gates.py:41
            return new Verdict("EXCLUDED", "line outside file");                                // src: vvaharness/pipeline/stages/s5/gates.py:42
        }
        // Only point both S4-born and detector rows pass through, so clamp line_end to EOF here.
        if (f.lineEnd > lines.size()) {                                                         // src: vvaharness/pipeline/stages/s5/gates.py:44
            f.lineEnd = lines.size();
            Counters.bump("s5_line_end_clamped_eof");                                           // src: vvaharness/pipeline/stages/s5/gates.py:46
        }
        return null;
    }

    @src("vvaharness/pipeline/stages/s5/__init__.py:40")
    Map<String, Object> locationParameters(Theta θ) {
        // Gate parameters consumed by S5.run (real reads: s5/__init__.py:45,70,73).
        boolean reanchor = θ["step5_prefilter.sink_reanchor"];                                  // src: vvaharness/pipeline/stages/s5/__init__.py:70
        int maxMove = reanchor ? θ["step5_prefilter.sink_reanchor_max_move_lines"] : 0;         // src: vvaharness/pipeline/stages/s5/__init__.py:73
        Integer tol = θ["step5_prefilter.line_tolerance"];                                      // src: vvaharness/pipeline/stages/s5/__init__.py:45
        if (tol == null) tol = θ["step7_dedup.line_tolerance"];                                  // src: vvaharness/pipeline/stages/s5/__init__.py:47
        return Map.of("reanchor", reanchor, "max_move", maxMove, "line_tolerance", tol);
    }
}
