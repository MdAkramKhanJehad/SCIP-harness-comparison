// file: vvaharness/plugins/semgrep/tools.py
// Four read-only closures over the Semgrep subgraph; Cypher failures return error rows.
// Query LIMITs are embedded in the queries, not enforced by the unused _MAX_ROWS/_MAX_TRACE_STEPS constants.

@executedBy(CODE) @role(tool)
class SemgrepTools {
    @src("vvaharness/plugins/semgrep/tools.py:61")
    List<Map> rows(GraphToolContext gtx, String query, Map params) {
        try { return gtx.handle.graph.cypher(query, params).rows.map(r -> r.toDict()); }
        catch (Exception e) { return List.of(Map.of("error", typeName(e) + ": " + e.message, "hint", "no Semgrep subgraph; enricher did not run")); }
    }
    @src("vvaharness/plugins/semgrep/tools.py:70")
    Tool semgrepFindingsTool(GraphToolContext gtx, Theta θ) {
        return Tool.define("GraphSemgrepFindings", file -> rows(gtx, θ["code.plugins.semgrep.tools.findings_for_file"], Map.of("file", file))); // src: vvaharness/plugins/semgrep/tools.py:25
    }
    @src("vvaharness/plugins/semgrep/tools.py:81")
    Tool semgrepTraceTool(GraphToolContext gtx, Theta θ) {
        return Tool.define("GraphSemgrepTaintTrace", ruleId -> rows(gtx, θ["code.plugins.semgrep.tools.trace_for_rule"], Map.of("rule_id", ruleId))); // src: vvaharness/plugins/semgrep/tools.py:35
    }
    @src("vvaharness/plugins/semgrep/tools.py:92")
    Tool semgrepSinkCallersTool(GraphToolContext gtx, Theta θ) {
        return Tool.define("GraphSemgrepSinkCallers", file -> rows(gtx, θ["code.plugins.semgrep.tools.callers_of_flagged_sinks"], Map.of("file", file))); // src: vvaharness/plugins/semgrep/tools.py:44
    }
    @src("vvaharness/plugins/semgrep/tools.py:103")
    Tool semgrepCoverageTool(GraphToolContext gtx, Theta θ) {
        return Tool.define("GraphSemgrepCoverage", () -> rows(gtx, θ["code.plugins.semgrep.tools.scan_coverage"], Map.of())); // src: vvaharness/plugins/semgrep/tools.py:53
    }
    @src("vvaharness/plugins/semgrep/tools.py:114")
    Map registry() {
        return Map.of("GraphSemgrepFindings", this::semgrepFindingsTool, "GraphSemgrepTaintTrace", this::semgrepTraceTool, "GraphSemgrepSinkCallers", this::semgrepSinkCallersTool, "GraphSemgrepCoverage", this::semgrepCoverageTool);
    }
    @src("vvaharness/plugins/semgrep/tools.py:121")
    List<String> names() {
        return registry().keys().toList();
    }
}
