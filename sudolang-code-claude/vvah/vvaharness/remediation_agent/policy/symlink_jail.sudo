# vvaharness/remediation_agent/policy/symlink_jail.py

Pre-dispatch detection of symbolic links that escape the scanned repository (CWE-59). Stage 10's write confinement is a permission scope, not a path jail: an edit made THROUGH an escaping link does not change the link itself, so no post-gate can see it. This module only reports; the caller refuses to hand the model a writer.

Source: `vvaharness/remediation_agent/policy/symlink_jail.py` (lines 1-127)
Executor: code
Called from: `plugin_runner/__init__.sudo` _symlink_safe_mode

// src: vvaharness/remediation_agent/policy/symlink_jail.py:28-36
_SCAN_FILE_MAX = 20000   // bounded like the post-gate's worktree scan
_SCAN_DIR_MAX = 20000
_SKIP_DIRS = [".git", "node_modules", ".venv", "venv", "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache", ".tox"]   // vendored trees hold many legitimate links and Stage 10 never patches them

// src: vvaharness/remediation_agent/policy/symlink_jail.py:39-75
fn escaping_symlinks(repo):executor=code {
  try root = resolved repo; catch OSError => return {}
  found = {}; files_seen = 0; dirs_seen = 0
  try {
    for each folder in walk(repo, follow links = false) {   // never descends THROUGH a link
      dirs_seen += 1
      if (dirs_seen > _SCAN_DIR_MAX) break
      for each sub-folder name {
        if (name in _SKIP_DIRS) { do not descend into it; continue }
        _record(root, repo, folder/name, found)   // a symlinked folder is itself a candidate
      }
      for each file name {
        files_seen += 1
        if (files_seen > _SCAN_FILE_MAX) return found
        _record(root, repo, folder/name, found)
      }
    }
  } catch => return found   // never raises; an unreadable subtree yields what was found so far
  return found   // { repository-relative link path: target description }
  // preserved: past either cap the scan stops silently and the result can look clean
}

// src: vvaharness/remediation_agent/policy/symlink_jail.py:78-107
fn _record(root, repo, path, out):executor=code {
  if (path is not a symbolic link (or the check fails)) return
  rel = path relative to repo (posix); return if not inside repo
  try target = path resolved (non-strict);
  catch (OSError | RuntimeError) => { out[rel] = _raw_target(path); return }   // a resolution loop cannot be proven in-tree
  if (target is not inside root) { out[rel] = target; return }
  if (target does not exist) out[rel] = "${_raw_target(path)} (dangling)"   // a dangling in-tree link is recorded too: a write would create its target, and the link can be swapped before that write
  // a link to an existing in-tree path is normal and is not recorded
}

// src: vvaharness/remediation_agent/policy/symlink_jail.py:110-115
fn _raw_target(path):executor=code { try return readlink(path); catch OSError => return "<unreadable>" }

// src: vvaharness/remediation_agent/policy/symlink_jail.py:118-124
fn describe_escapes(escapes, limit=5):executor=code {
  return the first `limit` entries of sorted escapes as "link -> target" joined by ", ", plus ", … (+N more)" when there are more
}
