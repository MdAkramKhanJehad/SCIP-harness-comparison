# vvaharness/sdk/handoff.py

Bringing your own findings. `inject_findings` writes a Stage 4 checkpoint holding findings supplied by the caller (and, by default, empty Stage 2 and Stage 3 checkpoints), so that a later `scan --resume` of the same checkout skips discovery and runs Stage 5 onward on those findings.

Source: `vvaharness/sdk/handoff.py` (lines 1-92)
Executor: code
Called from: library callers through `vvaharness/sdk/__init__.py`; the resumed run is `vvaharness/orchestrator/scan.py` scan_repo

// src: vvaharness/sdk/handoff.py:26-32
MAX_INJECTED_FINDINGS = 2000
DISCOVERY_STAGES = ["s2", "s3"]
// s2 and s3 are seeded because scan_repo gates each stage on its own checkpoint: seeding s4 alone would still run s2, which is agentic.
// s0 and s1 are deliberately not seeded: they are deterministic, and s1 builds the graph Stage 6 verification reads.

// src: vvaharness/sdk/handoff.py:35-51
HandoffError { kind: ValueError }
Handoff {
  run_id: String
  stage: String
  finding_count: Number
  skipped: String[] = []
  resume_argv = ["--resume"]   // the only flag a scan needs to pick the seeded checkpoint up
}

// src: vvaharness/sdk/handoff.py:54-75
fn inject_findings(repo, findings, skip_discovery=true):executor=code {
  require findings is not empty => throw HandoffError("no findings to inject")
  require length(findings) <= MAX_INJECTED_FINDINGS => throw HandoffError("<n> findings exceeds MAX_INJECTED_FINDINGS=2000")
  require every item is a Finding => throw HandoffError("every item must be a Finding; got <type>")
  repo_path = repo with "~" expanded, resolved
  require repo_path is a directory => throw HandoffError("repo is not a directory: <repo>")
  run_id = checkpoints.run_id_for(repo_path)   // the same path-keyed run id scan_repo computes
  ckpt_dir = store.state_root() + "/checkpoints/$run_id"
  store.register_run(run_id, repo_root=repo_path, repo_name=name of repo_path, app_id=null)
  checkpoints.save_ckpt(ckpt_dir, run_id, "s4", { findings, outcomes: _outcomes(findings), input_kind: "external" })
  // "external" makes scan_repo report that no deep dive ran (s4_input_kind)
  // preserved: save_ckpt skips a payload larger than _CKPT_MAX_BYTES (100 MiB) with only a warning (checkpoints.py:245-247); inject_findings still returns a Handoff
  skipped = if (skip_discovery) _seed_discovery(ckpt_dir, run_id) else []
  return Handoff { run_id, stage: "s4", finding_count: length(findings), skipped }
  // preserved: no checkpoint of s5 to s8 is cleared; a resume reuses any such rows already stored for the same run id (the README tells the caller to use an empty VVAHARNESS_STATE_DIR)
}

// src: vvaharness/sdk/handoff.py:78-82
fn _seed_discovery(ckpt_dir, run_id):executor=code {
  checkpoints.save_ckpt(ckpt_dir, run_id, "s2", empty ThreatModel)
  checkpoints.save_ckpt(ckpt_dir, run_id, "s3", TaskManifest { units: [] })
  // a resumed scan reports s2 and s3 as cached instead of running them
  return DISCOVERY_STAGES
}

// src: vvaharness/sdk/handoff.py:85-88
fn _outcomes(findings):executor=code {
  origins = set of (finding.origin || "external") for each finding
  return { origin: "injected" for each origin in sorted origins }
  // "injected" is not one of _S4_UNTRUSTED_OUTCOMES, so s4_stage_complete accepts the checkpoint on resume
}
