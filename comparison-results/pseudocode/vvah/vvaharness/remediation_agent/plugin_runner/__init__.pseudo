    Object consumeDeepagentsBounded(String prompt, StreamingOptions options, boolean verbose, int timeout, Theta θ) {
        // Bound one DeepAgents remediation session by a wall clock; raises the VVAH-E008 call timeout error on expiry. Runs inside runSync's own fresh loop, so the cancellation delivered on expiry reaches the in-flight LangGraph stream directly.
        Deadline deadline = EventLoop.timeout(timeout);                                             // src: vvaharness/remediation_agent/plugin_runner/__init__.py:309
        try {
            return deadline.run(() -> consumeDeepagents(prompt, options, verbose, θ));              // src: vvaharness/remediation_agent/plugin_runner/__init__.py:312
        } catch (TimeoutError exc) {
            // expired() tells OUR deadline apart from a TimeoutError raised inside the session.
            if (!deadline.expired()) throw exc;                                                     // src: vvaharness/remediation_agent/plugin_runner/__init__.py:315
            throw callTimeoutError("s10", "deepagents", timeout, null, "deepagents remediation session exceeded " + timeout + "s"); // src: vvaharness/remediation_agent/plugin_runner/__init__.py:317
        }
    }

    String virtualizeDeepagentsPrompt(String user, Theta θ) {
        // Present the repo using DeepAgents' virtual filesystem namespace so tools do not look for the host path inside the virtual root: only the first line, when it starts with REPOSITORY ROOT:, is rewritten.
        if (!θ["code.remediation_agent.plugin_runner.virtualize_repo_root"]) return user;           // src: vvaharness/remediation_agent/plugin_runner/__init__.py:322
        List<String> lines = user.splitlines();                                                     // src: vvaharness/remediation_agent/plugin_runner/__init__.py:324
        if (!lines.isEmpty() && lines.get(0).startsWith("REPOSITORY ROOT:")) {                      // src: vvaharness/remediation_agent/plugin_runner/__init__.py:325
            lines.set(0, "REPOSITORY ROOT: / (DeepAgents virtual workspace root)");                 // src: vvaharness/remediation_agent/plugin_runner/__init__.py:326
        }
        return lines.join("\n");                                                                    // src: vvaharness/remediation_agent/plugin_runner/__init__.py:327
    }

