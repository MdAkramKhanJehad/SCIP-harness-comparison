  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Built-in extraction capabilities and their single bounded execution path.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\n\nfrom context_graph_sdk.discovery.walker import RepositoryWalk\nfrom context_graph_sdk.extractors import ExtractionResult, extract_repository\nfrom context_graph_sdk.plugins import (\n    LanguageExtractor,\n    PluginMetadata,\n    PluginPhase,\n    ProjectExtractor,\n)\nfrom context_graph_sdk.project import ProjectConfig, load_project_config\n\n\n@dataclass(frozen=True)\nclass IngestionResult:\n    config: ProjectConfig\n    extraction: ExtractionResult\n\n\nclass BuiltinLanguageExtractor:\n    metadata = PluginMetadata(PluginPhase.EXTRACTION, 10, \"builtin-languages\", \"1\")\n\n    def __init__(self, on_progress: Callable[[int, int], None] | None = None) -> None:\n        self._on_progress = on_progress\n\n    @property\n    def languages(self) -> tuple[str, ...]:\n        from context_graph_sdk.extractors.runtime import SUPPORTED_LANGUAGES\n\n        return tuple(sorted(SUPPORTED_LANGUAGES))\n\n    def extract(self, repository: RepositoryWalk) -> ExtractionResult:\n        return extract_repository(\n            repository.root,\n            [(file.relative_path, file.language) for file in repository.files if file.language],\n            on_progress=self._on_progress,\n        )\n\n\nclass BuiltinProjectExtractor:\n    metadata = PluginMetadata(PluginPhase.EXTRACTION, 20, \"builtin-project\", \"1\")\n\n    def extract(self, repository: RepositoryWalk) -> ProjectConfig:\n        return load_project_config(\n            repository.root, [file.relative_path for file in repository.files]\n        )\n\n\nclass BuiltinExtractionRegistry:\n    \"\"\"The one bounded registry for built-in language/project capabilities.\"\"\"\n\n    def __init__(\n        self,\n        language_extractor: LanguageExtractor | None = None,\n        project_extractor: ProjectExtractor | None = None,\n    ) -> None:\n        language = language_extractor or BuiltinLanguageExtractor()\n        project = project_extractor or BuiltinProjectExtractor()\n        self.language: LanguageExtractor = language\n        self.project: ProjectExtractor = project\n\n    def run(self, walk: RepositoryWalk) -> IngestionResult:\n        return IngestionResult(self.project.extract(walk), self.language.extract(walk))\n\n\ndef run_builtin_ingestion(\n    walk: RepositoryWalk,\n    *,\n    on_language_start: Callable[[], None] | None = None,\n    on_file_progress: Callable[[int, int], None] | None = None,\n) -> IngestionResult:\n    registry = BuiltinExtractionRegistry(BuiltinLanguageExtractor(on_file_progress))\n    config = registry.project.extract(walk)\n    if on_language_start is not None:\n        on_language_start()\n    return IngestionResult(config, registry.language.extract(walk))\n",
