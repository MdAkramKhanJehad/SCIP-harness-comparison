# vvaharness/util/git_paths.py

The single answer to "is this path version-control metadata?" used by every write gate.

Source: `vvaharness/util/git_paths.py` (lines 1-36)
Executor: code
Called from: write gates in backends and the remediation and tool layers that refuse writes into `.git`

// src: vvaharness/util/git_paths.py:23
GIT_DIR = ".git"

// src: vvaharness/util/git_paths.py:26-29
fn is_git_metadata(path):executor=code {
  // backslashes are treated as separators
  return any path component, case-folded, == ".git"   // case-folded because macOS and Windows fold case
}

// src: vvaharness/util/git_paths.py:32-36
fn git_dir_spellings():executor=code {
  return every upper/lower-case spelling of ".git" (".git", ".GIT", ".Git", ...)   // for matchers that cannot fold case; cached
}
