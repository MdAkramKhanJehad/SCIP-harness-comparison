  "source_text": "# Copyright 2026 Visa, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Package.swift parsing.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\nfrom context_graph_sdk.project.config import (\n    DependencyRecord,\n    ManifestReader,\n    ManifestRecord,\n    ProjectConfig,\n    workspace_display_name,\n)\n\n_PACKAGE_NAME = re.compile(r'name:\\s*\"([^\"]+)\"')\n_PACKAGE_DEPENDENCY = re.compile(\n    r'\\.package\\s*\\(\\s*url:\\s*\"([^\"]+)\"\\s*,\\s*'\n    r'(?:from:\\s*\"([^\"]+)\"|exact:\\s*\"([^\"]+)\"'\n    r'|\\.upToNextMajor\\s*\\(\\s*from:\\s*\"([^\"]+)\"\\s*\\)'\n    r'|\\.upToNextMinor\\s*\\(\\s*from:\\s*\"([^\"]+)\"\\s*\\)'\n    r'|\"([^\"]+)\"\\s*\\.\\.[.<]\\s*\"[^\"]+\")'\n)\n\n\ndef _package_name_from_url(url: str) -> str:\n    name = url.removesuffix(\".git\").rsplit(\"/\", 1)[-1]\n    return name or url\n\n\ndef load_swift_package_dependencies(reader: ManifestReader, config: ProjectConfig) -> None:\n    for relative in reader.by_base_name(\"Package.swift\"):\n        if relative != \"Package.swift\":\n            continue\n        text = reader.read_text(relative)\n        if text is None:\n            continue\n        for match in _PACKAGE_DEPENDENCY.finditer(text):\n            version = next((group for group in match.groups()[1:] if group), \"\")\n            config.add_dependency(\n                DependencyRecord(_package_name_from_url(match.group(1)), version, relative)\n            )\n\n\ndef load_swift_package_manifests(reader: ManifestReader, config: ProjectConfig) -> None:\n    for relative in reader.by_base_name(\"Package.swift\"):\n        text = reader.read_text(relative)\n        if text is None:\n            continue\n        name_match = _PACKAGE_NAME.search(text)\n        name = name_match.group(1) if name_match else workspace_display_name(reader.root, relative)\n        config.add_manifest(ManifestRecord(name, relative, \"swift\"))\n",
