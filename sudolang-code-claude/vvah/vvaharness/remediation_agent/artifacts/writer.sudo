# vvaharness/remediation_agent/artifacts/writer.py

Persists one remediation attempt under the finding's artifact folder, with secrets redacted at persistence: `evidence/triage.json`, `evidence/summary.md`, `evidence/diff.patch`, and the canonical `finding_case.json` at the folder root.

Source: `vvaharness/remediation_agent/artifacts/writer.py` (lines 1-337)
Executor: code
Called from: `plugin_runner/run.sudo` (after each attempt, including denied and failed ones)

// src: vvaharness/remediation_agent/artifacts/writer.py:99-120
fn write_case(out_dir, verdict, remediation, meta, target?, reverted_paths=[]):executor=code {
  create out_dir and out_dir/EVIDENCE_DIR
  payload = verdict fields + meta + { diff_captured: remediation.diff is non-empty }
  // Secrets are redacted on string leaves BEFORE serializing, so a match cannot break JSON quoting
  write redact_tree(payload) as JSON to evidence/TRIAGE_JSON   // external: vvaharness/report/redact.py
  write redact(summary.render_summary(verdict, meta)) to evidence/SUMMARY_MD
  if (remediation.diff) write _redact_diff(remediation.diff) to evidence/DIFF_PATCH (line endings kept)
  if (target != null) {
    case = report.build_report(target, remediation, reverted_paths)
    _write_json(out_dir/FINDING_CASE_JSON, _redacted_case(case))   // written atomically (temporary file, then replace)
  }
  // the case file is only written when a target is supplied
}

// src: vvaharness/remediation_agent/artifacts/writer.py:123-128
fn _redacted_case(case):executor=code {
  payload = redact_tree(case as JSON)
  for each attempt: attempt.remediation.diff = _redact_diff(original attempt diff)   // diffs use the structure-preserving masker, not plain redaction
  return payload
}

// src: vvaharness/remediation_agent/artifacts/writer.py:38-96, 131-330
fn _redact_diff(diff):executor=code {
  // abstracted: writer.py:38-96 and 131-330 — a line-by-line diff masker. Diff framing lines (the _DIFF_STRUCTURE_PREFIXES such as "diff --git ", "index ", "--- ", "+++ ", mode, rename, copy and binary headers, and the synthesized-diff header) and hunk headers are kept exactly, with line endings preserved. Hunk payload lines go through report.redact, except that a secret-named assignment whose value is a read from a safe configuration source (os.environ[...], os.getenv(...), config[...], settings.X, process.env.X) is kept unmasked. PEM private-key material (BEGIN/END boundaries, header lines, base64 fragments, tracked separately for old and new sides across lines of a hunk, with pending short fragments masked retroactively once an END line appears) is replaced by "[REDACTED-PRIVATE-KEY]". Unknown in-hunk lines are treated as content and redacted, never passed through raw. This changes only what is persisted, not any decision.
}
