# vvaharness/models/scan/_coerce.py

Lenient coercion helpers used by the scan data types' validators. They repair off-schema model output (wrong case, a list where a string was expected, null, a bare number) instead of rejecting it; shapes they cannot recognise pass through so pydantic rejects them.

Source: `vvaharness/models/scan/_coerce.py` (lines 1-106)
Executor: code
Called from: validators in `vvaharness/models/scan/*.py`

// src: vvaharness/models/scan/_coerce.py:22-23
fn _norm(v):executor=code { return string of (v || "") stripped, lowercased, "-" and " " replaced by "_" }

// src: vvaharness/models/scan/_coerce.py:26-33
fn _coerce_enum(v, valid, alias, default):executor=code {
  raw = string of (v || "") stripped
  if (raw in valid) return raw            // exact, case-preserving hit
  k = _norm(v)
  if (k in valid) return k
  return alias[k] || default
  // preserved: _norm turns "-" into "_", so a hyphenated valid value such as "input-validation" is reached only through
  // an exact hit or an alias entry
}

// src: vvaharness/models/scan/_coerce.py:36-49
fn _coerce_int(v, default=0):executor=code {
  match (v) {
    case Boolean => default              // bool is a subclass of int in Python; rejected
    case Integer => v
    case Float => if (v is NaN or infinite) default else truncate(v)
    default => try integer(string of v stripped); catch => default
  }
}

// src: vvaharness/models/scan/_coerce.py:52-60
fn flag(v):executor=code {
  match (v) {
    case Boolean => v
    case String => lowercase(strip(v)) in ["true", "yes", "1"]
    case Number => v != 0
    default => false
  }
}

// src: vvaharness/models/scan/_coerce.py:63-65
fn text(v):executor=code { return if (v is a string) v else if (v == null) "" else string of v }

// src: vvaharness/models/scan/_coerce.py:68-88
fn _coerce_scalar_str(v, default, label):executor=code {
  match (v) {
    case String => v
    case List => {
      first = first element not null and not ""
      warn "LLM output coercion: $label was a N-element list; keeping the first element"   // the tail elements, and their file-to-threat association, are lost
      return _coerce_scalar_str(first, default, label)
    }
    case null => if (default == null) null else { warn "...was null; using default"; default }
    case Number (not Boolean) => { warn "...was a bare number; using its string form"; string of v }
    default => v   // unrecognisable: pydantic rejects it
  }
}

// src: vvaharness/models/scan/_coerce.py:91-106
fn _coerce_str_list(v, label):executor=code {
  match (v) {
    case List => v
    case null => { warn "...was null; using an empty list"; [] }
    case Tuple => list of v
    case String or Number (not Boolean) => { warn "...wrapping it in a list"; s = strip(string of v); if (s) [s] else [] }
    default => v   // unrecognisable: pydantic rejects it
  }
}
