// file: vulnhunter-fix/references/finding-schema.json
// One parsed VulnHunter finding as emitted by scripts/parse_results.py; input to Plan, Implement, Verify, Sweep, Deliver.
// Open object (extra keys allowed); five required fields.

@executedBy(CODE) @role(types)
enum FindingSeverity { CRITICAL, HIGH, MEDIUM, LOW, INFORMATIONAL }

@executedBy(CODE) @role(types)
enum ParserStatus { CONFIRMED, UNCONFIRMED, PENDING, REJECTED, ALREADY_FIXED }

@executedBy(CODE) @role(types)
record ProposedFix(String strategy, String files_to_change, String why) { }

@executedBy(CODE) @role(types)
record FixFinding(String id, String title, String cwe, FindingSeverity severity, String exploit_test, ParserStatus status,
                  String location, String root_cause, String entry_point, String data_flow, Object files, ProposedFix proposed_fix) { }

@executedBy(CODE) @role(rule_set) @stage("fix")
class FindingSchema {

    boolean validate(FixFinding f, Theta θ) {
        // required: id, title, cwe, severity, status
        if (!Regex.match("^VULN-\\d+$", f.id)) return false;                          // src: vulnhunter-fix/references/finding-schema.json:12 (any digit count)
        if (f.title == null || f.title.isEmpty()) return false;                       // src: vulnhunter-fix/references/finding-schema.json:14
        if (!Regex.match("^CWE-\\d+$", f.cwe)) return false;                          // src: vulnhunter-fix/references/finding-schema.json:17 (empty CWE not allowed here)
        if (!θ["code.references.finding_schema.severity_values"].contains(f.severity)) return false; // src: vulnhunter-fix/references/finding-schema.json:21
        // status is the parser status; later phases overwrite it with a worker status (result-schema workerStatus)
        if (!List.of("Confirmed", "Unconfirmed", "Pending", "Rejected", "AlreadyFixed").contains(f.status)) return false; // src: vulnhunter-fix/references/finding-schema.json:27
        // files: either a list of paths or a map keyed by role (poc / exploit_test); both accepted
        if (!(f.files == null || f.files instanceof List || f.files instanceof Map)) return false; // src: vulnhunter-fix/references/finding-schema.json:44
        return true;
    }
}
