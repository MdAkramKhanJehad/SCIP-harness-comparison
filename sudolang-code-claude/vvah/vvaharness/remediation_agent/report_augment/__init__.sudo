# vvaharness/remediation_agent/report_augment/__init__.py

After the remediation loop, copies the scan report pair (SARIF and Markdown) into `security-remediation/` and adds the remediation result of every finding to the copies. Best effort: any failure is logged and never fails the run.

Source: `vvaharness/remediation_agent/report_augment/__init__.py` (lines 1-66)
Executor: code
Called from: `runner.sudo` process_targets (after the loop)

// src: vvaharness/remediation_agent/report_augment/__init__.py:39-45
fn augment_reports(repo, report_md?):executor=code {
  try _augment(repo, report_md);
  catch => log "remediation report augmentation failed; results not written to combined report"   // never fails the remediation run
}

// src: vvaharness/remediation_agent/report_augment/__init__.py:48-66
fn _augment(repo, report_md?):executor=code {
  rem_dir = artifact_dir(repo, REMEDIATION_DIR_NAME)   // a symlinked folder raises UnsafeArtifactDir, turned into a logged skip above
  records = if (rem_dir is a folder) dto._load_cases(rem_dir) else []
  if (!records) { log "no remediation cases ... skipping report augmentation"; return }
  located = locate._locate_scan_report(repo, report_md)
  if (located == null) { warn "no scan report ... skipping report augmentation"; return }
  [sarif_dst, md_dst] = locate._ensure_combined(repo, located)
  ordinal_matches = sarif._augment_sarif(sarif_dst, records)
  markdown._augment_md(md_dst, records, ordinal_matches)   // the SARIF-side ordinal match is tried before title matching
  // records are ALL case files in security-remediation/, not only this run's (no provenance check here)
}
