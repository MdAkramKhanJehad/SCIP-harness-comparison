// file: vvaharness/validation/session/rules.py
// Reads the bundled validation rules as prompt text (licence comment stripped) for backends that do not
// load .claude/rules natively: the orchestrator gets both rules files, each persona the adversarial one.

@executedBy(CODE) @role(rule_set) @stage("S11")
class SessionRules {

    String rulesText(String filename) {
        Path path = ConfigInject.CLAUDE_CONFIG_SOURCE.resolve("rules").resolve(filename);            // src: vvaharness/validation/session/rules.py:35
        if (!path.isFile()) throw new FileNotFoundError("required claude_config rule missing");      // src: vvaharness/validation/session/rules.py:36
        return Regex.sub("^ws<!--...-->ws", "", path.readText()).strip();                            // licence comment never reaches the model  // src: vvaharness/validation/session/rules.py:38
    }

    String orchestratorRulesText(Theta θ) {
        List<String> parts = new List();
        for (String f : θ["code.validation.session.rules.orchestrator_rules_files"]) parts.add(rulesText(f)); // scoring-matrix.md, adversarial-review.md  // src: vvaharness/validation/session/rules.py:43
        return String.join("\n\n", parts);
    }

    String personaRulesText(Theta θ) {
        List<String> parts = new List();
        for (String f : θ["code.validation.session.rules.persona_rules_files"]) parts.add(rulesText(f)); // adversarial-review.md only  // src: vvaharness/validation/session/rules.py:48
        return String.join("\n\n", parts);
    }
}
